@* ============================================================
   Block: chat-roadmap-discussion
   Title: ChatRoadmapDiscussion
   Description: A collaborative product planning chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring feature cards, priority voting, and timeline discussions
   Source: original/blocks/chat/chat-roadmap-discussion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="map" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Roadmap Planning</h2>
                    <p class="text-xs text-muted-foreground">Q2 2026 Discussion</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                    <span class="text-xs">8 participants</span>
                </ButtonCn>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            @foreach (var message in _messages)
            {
                <div class="@Cn.Merge("flex", message.Type == "user" ? "justify-end" : "justify-start")">
                    <div class="@Cn.Merge("max-w-[85%] space-y-2", message.Type == "user" ? "items-end" : "items-start")">

                        @if (message.Author != null)
                        {
                            <div class="flex items-center gap-2">
                                <div class="flex size-6 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                    @message.Author.Avatar
                                </div>
                                <span class="text-xs font-medium">@message.Author.Name</span>
                            </div>
                        }

                        <div class="@Cn.Merge("rounded-lg px-3 py-2", message.Type == "user" ? "bg-foreground text-background" : "bg-muted")">
                            <p class="text-sm">@message.Content</p>
                        </div>

                        @if (message.Feature != null)
                        {
                            var feat = message.Feature;
                            <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0 flex-1">
                                        <h3 class="text-sm font-medium">@feat.Title</h3>
                                        <p class="mt-1 text-sm text-muted-foreground">@feat.Description</p>
                                    </div>
                                    <div class="@Cn.Merge("shrink-0 rounded-md px-2 py-0.5 text-xs font-medium capitalize", GetPriorityColor(feat.Priority))">
                                        @feat.Priority
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <div class="flex items-center gap-1.5 text-muted-foreground">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                        <span>@feat.Quarter</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-muted-foreground">
                                        <LucideIconCn Name="flag" Size="12" Class="size-3" />
                                        <span>@feat.Team</span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between border-t pt-2">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="thumbs-up" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="text-sm font-medium">@feat.Votes votes</span>
                                    </div>
                                    <ButtonCn Variant="@(feat.UserVoted ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                        <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                        @(feat.UserVoted ? "Voted" : "Vote")
                                    </ButtonCn>
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-3">
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0">
                    <LucideIconCn Name="trending-up" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input" Placeholder="Propose a feature or share feedback..." Class="border-0 bg-transparent shadow-none focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record AuthorInfo(string Name, string Avatar);

    private record FeatureInfo(
        string Title,
        string Description,
        string Priority,
        string Quarter,
        int Votes,
        bool UserVoted,
        string Team);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        AuthorInfo? Author = null,
        FeatureInfo? Feature = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Welcome to the Q2 2026 roadmap planning session! Let's discuss upcoming features and priorities. What would you like to add or discuss?",
            "2:00 PM"),
        new("2", "user",
            "I'd like to propose adding advanced analytics dashboards to the product",
            "2:01 PM",
            Author: new("Emily Chen", "EC")),
        new("3", "assistant",
            "Great idea! I've created a feature card for Advanced Analytics Dashboard. Here are the details based on our discussion:",
            "2:01 PM",
            Feature: new(
                "Advanced Analytics Dashboard",
                "Comprehensive analytics with custom reports, data export, and real-time metrics visualization",
                "high",
                "Q2 2026",
                12,
                false,
                "Product & Engineering")),
        new("4", "user",
            "This aligns well with customer feedback we've been getting. I'm voting for this.",
            "2:05 PM",
            Author: new("Marcus Liu", "ML")),
        new("5", "assistant",
            "Thanks Marcus! Your vote has been recorded. The analytics dashboard now has strong team support. Shall we discuss implementation timeline?",
            "2:05 PM"),
    ];

    private static string GetPriorityColor(string priority) => priority switch
    {
        "high" => "text-red-500 bg-red-500/10",
        "medium" => "text-amber-500 bg-amber-500/10",
        "low" => "text-blue-500 bg-blue-500/10",
        _ => "text-muted-foreground bg-muted",
    };

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"msg-{_messages.Count + 1}", "user", _input, "Just now"));
        _input = "";
    }
}
