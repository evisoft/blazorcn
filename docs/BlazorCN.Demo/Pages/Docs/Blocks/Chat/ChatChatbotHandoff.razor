@* ============================================================
   Block: chat-chatbot-handoff
   Title: ChatChatbotHandoff
   Description: React chatbot-to-human-agent handoff block for Next.js with bot messages, animated transfer indicator, agent join notification, and seamless conversation continuity using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-chatbot-handoff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-xs">MJ</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Maya Johnson</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Billing Specialist
                </p>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col gap-3 overflow-y-auto px-4 py-4">
            @foreach (var msg in _messages)
            {
                if (msg.Sender == "system")
                {
                    <div class="flex justify-center py-1">
                        <div class="flex items-center gap-2 rounded-full bg-muted/50 px-3 py-1.5">
                            @if (msg.IsTransfer)
                            {
                                <LucideIconCn Name="loader" Size="12" Class="size-3 animate-spin text-muted-foreground" />
                            }
                            <span class="text-muted-foreground text-xs">@msg.Content</span>
                        </div>
                    </div>
                }
                else
                {
                    var isUser = msg.Sender == "user";
                    <div class="@Cn.Merge("flex items-end gap-2", isUser ? "flex-row-reverse" : "flex-row")">
                        @if (!isUser)
                        {
                            if (msg.Sender == "bot")
                            {
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted">
                                    <LucideIconCn Name="bot" Size="14" Class="size-3.5 text-muted-foreground" />
                                </div>
                            }
                            else
                            {
                                var initials = GetInitials(msg.Name);
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="text-[10px]">@initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        }
                        <div class="@Cn.Merge("flex max-w-[75%] flex-col", isUser ? "items-end" : "items-start")">
                            @if (!isUser)
                            {
                                <span class="mb-0.5 flex items-center gap-1.5 px-1 text-muted-foreground text-[10px]">
                                    @msg.Name
                                    @if (msg.Sender == "bot")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-3.5 px-1 font-normal text-[9px]">Bot</BadgeCn>
                                    }
                                </span>
                            }
                            <div class="@Cn.Merge("rounded-2xl px-3 py-2 text-sm leading-relaxed", isUser ? "rounded-br-sm bg-foreground text-background" : "rounded-bl-sm bg-muted text-foreground")">
                                @msg.Content
                            </div>
                            <span class="mt-0.5 px-1 text-muted-foreground text-[10px]">@msg.Time</span>
                        </div>
                    </div>
                }
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault class="flex items-center gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Type a message..."
                    Class="h-9 flex-1 border-0 bg-muted/50 text-sm shadow-none focus-visible:ring-0" />
                <ButtonCn
                    Type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Name, string Content, string Time, bool IsTransfer = false);

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "bot",    "Support Bot",  "Hi! I'm the Acme support bot. How can I help you today?",                                                                                          "9:40 AM"),
        new("m2", "user",   "You",          "I'm having an issue with my billing. I was charged twice for my last invoice.",                                                                     "9:41 AM"),
        new("m3", "bot",    "Support Bot",  "I'm sorry to hear about the double charge. I can see your account has an active subscription. Let me check the recent transactions.",               "9:41 AM"),
        new("m4", "bot",    "Support Bot",  "I found two charges on March 15. This looks like a billing issue that needs human review. Let me connect you with a billing specialist.",           "9:42 AM"),
        new("m5", "system", "System",       "Transferring to a human agent...",                                                                                                                  "9:42 AM", IsTransfer: true),
        new("m6", "system", "System",       "Maya Johnson has joined the conversation.",                                                                                                         "9:43 AM"),
        new("m7", "agent",  "Maya Johnson", "Hi there! I'm Maya from the billing team. I can see the duplicate charge on your account. I'll process a refund for the extra payment right away.", "9:43 AM"),
        new("m8", "user",   "You",          "That would be great, thank you! How long will the refund take?",                                                                                    "9:44 AM"),
        new("m9", "agent",  "Maya Johnson", "The refund has been submitted. It typically takes 3-5 business days to appear on your statement. I've also added a credit to your account for the inconvenience.", "9:45 AM"),
    ];

    private string _input = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = string.Concat(parts.Select(p => p[0])).ToUpperInvariant();
        return initials.Length > 2 ? initials[..2] : initials;
    }
}
