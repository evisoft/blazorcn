@* ============================================================
   Block: chat-translation-relay
   Title: ChatTranslationRelay
   Description: A multi-party translation relay chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring original and translated message pairs
   Source: original/blocks/chat/chat-translation-relay.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="languages" Size="16" Class="size-4 text-blue-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Translation Relay</h2>
                    <p class="text-xs text-muted-foreground">Real-time multilingual chat</p>
                </div>
            </div>
            <div class="relative">
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          @onclick="@(() => _showLangPicker = !_showLangPicker)"
                          Class="h-7 gap-1.5 text-xs">
                    <span class="text-sm">@GetLangFlag(_userLang)</span>
                    @GetLangName(_userLang)
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
                @if (_showLangPicker)
                {
                    <div class="absolute right-0 top-full z-10 mt-1 w-48 rounded-md border bg-card p-1 shadow-lg">
                        @foreach (var lang in _languages)
                        {
                            var l = lang;
                            <button type="button"
                                    @onclick="@(() => { _userLang = l.Code; _showLangPicker = false; })"
                                    class="flex w-full items-center gap-2 rounded px-2 py-1.5 text-left text-sm transition-colors hover:bg-muted">
                                <span class="text-base">@l.Flag</span>
                                <span class="flex-1">@l.Name</span>
                                @if (_userLang == l.Code)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600" />
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @* Info Banner *@
        <div class="flex items-center gap-2 border-b bg-blue-500/5 px-4 py-2">
            <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-blue-600" />
            <p class="text-xs text-muted-foreground">
                Messages are automatically translated to your language (@GetLangName(_userLang))
            </p>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    var isOwn = message.Sender == "You";
                    var needsTranslation = message.OriginalLang != _userLang;
                    <div class="@Cn.Merge("flex gap-3", isOwn ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@GetInitials(message.Sender)</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@Cn.Merge("flex max-w-[80%] flex-col gap-1.5", isOwn ? "items-end" : "")">
                            <div class="flex items-center gap-2">
                                <p class="text-xs font-medium">@message.Sender</p>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 gap-1 px-1.5 text-[10px] font-normal">
                                    <span>@GetLangFlag(message.OriginalLang)</span>
                                    @GetLangName(message.OriginalLang)
                                </BadgeCn>
                            </div>
                            @if (needsTranslation)
                            {
                                <div class="rounded-lg border border-dashed bg-muted/30 px-3 py-2">
                                    <p class="text-xs italic text-muted-foreground">@message.OriginalText</p>
                                </div>
                            }
                            <div class="@Cn.Merge("rounded-lg px-3 py-2", isOwn ? "bg-blue-500/10 border border-blue-200" : "bg-muted/50")">
                                <p class="text-sm">@(needsTranslation ? message.TranslatedText : message.OriginalText)</p>
                            </div>
                            <div class="flex items-center gap-2">
                                @if (needsTranslation)
                                {
                                    <span class="text-[10px] text-muted-foreground">Translated to @GetLangName(_userLang)</span>
                                }
                                <span class="text-[10px] text-muted-foreground">@message.Timestamp</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Active Languages *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">Active languages:</span>
                <div class="flex gap-1">
                    @foreach (var code in _activeLangs)
                    {
                        var c = code;
                        <span class="text-sm" title="@GetLangName(c)">@GetLangFlag(c)</span>
                    }
                </div>
                <span class="ml-auto text-xs text-muted-foreground">4 participants</span>
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input"
                         Placeholder="@($"Type in {GetLangName(_userLang)}...")"
                         Class="flex-1" aria-label="@($"Type in {GetLangName(_userLang)}...")" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Sm"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="gap-1.5">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                    Send
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record LangOption(string Code, string Name, string Flag);

    private record ChatMessage(
        string Id,
        string Sender,
        string OriginalText,
        string OriginalLang,
        string TranslatedText,
        string TargetLang,
        string Timestamp);

    private string _input = "";
    private string _userLang = "en";
    private bool _showLangPicker = false;

    private static readonly LangOption[] _languages =
    [
        new("en", "English", "🇺🇸"),
        new("es", "Spanish", "🇪🇸"),
        new("fr", "French", "🇫🇷"),
        new("de", "German", "🇩🇪"),
        new("ja", "Japanese", "🇯🇵"),
        new("zh", "Chinese", "🇨🇳"),
    ];

    private static readonly string[] _activeLangs = ["es", "fr", "en", "ja"];

    private List<ChatMessage> _messages =
    [
        new("1", "Maria García",
            "¡Hola a todos! ¿Cómo están hoy?",
            "es",
            "Hello everyone! How are you today?",
            "en",
            "10:30 AM"),
        new("2", "Jean Dupont",
            "Bonjour! Je vais bien, merci. Et vous?",
            "fr",
            "Hello! I'm doing well, thank you. And you?",
            "en",
            "10:31 AM"),
        new("3", "You",
            "I'm great! Looking forward to our collaboration.",
            "en",
            "I'm great! Looking forward to our collaboration.",
            "en",
            "10:32 AM"),
        new("4", "田中太郎",
            "よろしくお願いします。一緒に働けることを楽しみにしています。",
            "ja",
            "Nice to meet you. I'm looking forward to working together.",
            "en",
            "10:33 AM"),
    ];

    private string GetLangName(string code)
    {
        var lang = Array.Find(_languages, l => l.Code == code);
        return lang?.Name ?? code.ToUpperInvariant();
    }

    private string GetLangFlag(string code)
    {
        var lang = Array.Find(_languages, l => l.Code == code);
        return lang?.Flag ?? "🌐";
    }

    private static string GetInitials(string sender)
    {
        var parts = sender.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new ChatMessage(
            Id: System.DateTime.Now.Ticks.ToString(),
            Sender: "You",
            OriginalText: _input,
            OriginalLang: _userLang,
            TranslatedText: _input,
            TargetLang: _userLang,
            Timestamp: "Just now");

        _messages.Add(newMessage);
        _input = "";
    }
}
