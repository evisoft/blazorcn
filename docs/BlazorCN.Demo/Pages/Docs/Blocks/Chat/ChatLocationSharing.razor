@* ============================================================
   Block: chat-location-sharing
   Title: ChatLocationSharing
   Description: React chat block with location sharing messages for Next.js featuring map placeholders, address text, and open-in-maps links using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-location-sharing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">DP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Daniel Park</span>
                <span class="ml-2 text-muted-foreground text-xs">Meeting Coordination</span>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                <span>3 locations</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            @foreach (var msg in _messages)
            {
                var message = msg;
                <div class="@Cn.Merge("flex gap-2.5", message.Role == "user" ? "flex-row-reverse" : "flex-row")">
                    <AvatarCn Class="mt-0.5 size-6 shrink-0">
                        <AvatarFallbackCn Class="text-[10px]">@message.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="@Cn.Merge("max-w-[75%] flex flex-col", message.Role == "user" ? "items-end" : "items-start")">
                        <div class="mb-0.5 flex items-center gap-2">
                            <span class="font-medium text-xs">@message.Sender</span>
                            <span class="text-muted-foreground text-[10px]">@message.Time</span>
                        </div>
                        @if (message.Content != null)
                        {
                            <div class="@Cn.Merge("rounded-lg px-3 py-2 text-sm", message.Role == "user" ? "bg-primary text-primary-foreground" : "bg-muted/50")">
                                @message.Content
                            </div>
                        }
                        @if (message.Location != null)
                        {
                            var loc = message.Location;
                            <div class="mt-1 w-full overflow-hidden rounded-md bg-muted/50">
                                <div class="relative flex aspect-video items-center justify-center bg-muted/80">
                                    <div class="flex flex-col items-center gap-2">
                                        <div class="flex size-10 items-center justify-center rounded-full bg-background">
                                            <LucideIconCn Name="map-pin" Size="20" Class="size-5 text-muted-foreground" />
                                        </div>
                                        <span class="font-medium text-muted-foreground text-xs">@loc.Label</span>
                                    </div>
                                    <div class="absolute right-2 bottom-2 rounded bg-background/80 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground backdrop-blur-sm">
                                        @loc.Lat, @loc.Lng
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 p-3">
                                    <LucideIconCn Name="navigation" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-sm">@loc.Address</p>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Sm"
                                              Class="h-7 shrink-0 gap-1.5 text-muted-foreground text-xs hover:text-foreground">
                                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                        Open in Maps
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true"
                  class="relative flex items-end gap-2">
                <ButtonCn Type="button"
                          Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Icon"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Location">
                    <LucideIconCn Name="map-pin" Size="16" Class="size-4" />
                </ButtonCn>
                <div class="relative flex-1">
                    <TextareaCn @bind-Value="_input"
                                Placeholder="Type a message..."
                                Rows="1"
                                Class="min-h-0 max-h-32 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Type a message..." />
                    <ButtonCn Type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@(!CanSend)"
                              Class="absolute top-1/2 right-0 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Send message">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>

    </div>
</section>

@code {
    private record LocationInfo(string Address, string Label, string Lat, string Lng);

    private record ChatMessage(string Id, string Role, string Sender, string Initials, string Time,
        string? Content = null, LocationInfo? Location = null);

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "other", "Daniel Park", "DP", "11:42 AM",
            Content: "Hey, I just got to the area. Sharing my location so you can find me."),
        new("m2", "other", "Daniel Park", "DP", "11:42 AM",
            Location: new("425 Market St, San Francisco, CA 94105", "Current Location", "37.7912", "-122.3980")),
        new("m3", "user", "You", "YO", "11:45 AM",
            Content: "Got it! I am about 10 minutes away. Let us meet at the coffee shop on the corner instead. Dropping the pin."),
        new("m4", "user", "You", "YO", "11:45 AM",
            Location: new("1 Ferry Building, San Francisco, CA 94111", "Blue Bottle Coffee", "37.7956", "-122.3935")),
        new("m5", "other", "Daniel Park", "DP", "11:48 AM",
            Content: "Blue Bottle sounds perfect. After coffee, we should head to the office for the 1 PM meeting."),
        new("m6", "other", "Daniel Park", "DP", "11:49 AM",
            Location: new("535 Mission St, 14th Floor, San Francisco, CA 94105", "Acme Corp Office", "37.7880", "-122.3975")),
        new("m7", "user", "You", "YO", "11:51 AM",
            Content: "Works for me. See you at Blue Bottle in 10!"),
    ];

    private string _input = "";

    private bool CanSend => !string.IsNullOrWhiteSpace(_input);

    private void HandleSubmit()
    {
        if (!CanSend) return;
        _input = "";
    }
}
