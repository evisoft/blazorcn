@* ============================================================
   Block: chat-startup-pitch
   Title: ChatStartupPitch
   Description: A startup pitch practice chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring slide cards, feedback scores, and investor Q&A simulation
   Source: original/blocks/chat/chat-startup-pitch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="presentation" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium">Pitch Practice</h3>
                    <p class="text-xs text-muted-foreground">AI investor simulation</p>
                </div>
                <div class="ml-auto">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="bg-blue-500/10 text-blue-600">
                        <LucideIconCn Name="sparkles" Size="12" Class="mr-1 size-3" />
                        Session 1
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4">
            <div class="space-y-4 py-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            @if (msg.Type == "assistant")
                            {
                                <AvatarFallbackCn Class="bg-primary/10">
                                    <LucideIconCn Name="presentation" Size="16" Class="size-4 text-primary" />
                                </AvatarFallbackCn>
                            }
                            else if (msg.Type == "investor")
                            {
                                <AvatarFallbackCn Class="bg-blue-500/10">
                                    <LucideIconCn Name="users" Size="16" Class="size-4 text-blue-600" />
                                </AvatarFallbackCn>
                            }
                            else
                            {
                                <AvatarImageCn Src="https://avatar.vercel.sh/user" />
                                <AvatarFallbackCn>U</AvatarFallbackCn>
                            }
                        </AvatarCn>

                        <div class="@Cn.Merge("flex-1 space-y-2", msg.Type == "user" ? "flex flex-col items-end" : "")">
                            @if (msg.Type == "investor")
                            {
                                <div class="mb-1 flex items-center gap-1.5">
                                    <span class="text-xs font-medium text-blue-600">Investor Question</span>
                                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-blue-600" />
                                </div>
                            }

                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", msg.Type == "assistant" ? "bg-muted" : msg.Type == "investor" ? "border border-blue-500/20 bg-blue-500/5" : "bg-primary text-primary-foreground")">
                                @msg.Content
                            </div>

                            @if (msg.ScoreCard != null)
                            {
                                <div class="w-full space-y-3 rounded-lg border bg-card p-4">
                                    <div class="flex items-start justify-between">
                                        <div class="space-y-1">
                                            <p class="text-sm font-medium">Pitch Score</p>
                                            <p class="text-xs text-muted-foreground">Based on your latest response</p>
                                        </div>
                                        <div class="text-right">
                                            <div class="@Cn.Merge("text-2xl font-semibold tabular-nums", GetScoreColor(msg.ScoreCard.Overall))">
                                                @msg.ScoreCard.Overall
                                            </div>
                                            <div class="text-xs text-muted-foreground">/ 100</div>
                                        </div>
                                    </div>

                                    <div class="space-y-2 border-t pt-3">
                                        <div class="space-y-2">
                                            <div class="flex items-center justify-between text-xs">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
                                                    <span>Clarity</span>
                                                </div>
                                                <span class="font-medium tabular-nums">@msg.ScoreCard.Clarity</span>
                                            </div>
                                            <ProgressCn Value="@msg.ScoreCard.Clarity" Class="h-1" />
                                        </div>

                                        <div class="space-y-2">
                                            <div class="flex items-center justify-between text-xs">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                                                    <span>Market Opportunity</span>
                                                </div>
                                                <span class="font-medium tabular-nums">@msg.ScoreCard.MarketOpportunity</span>
                                            </div>
                                            <ProgressCn Value="@msg.ScoreCard.MarketOpportunity" Class="h-1" />
                                        </div>

                                        <div class="space-y-2">
                                            <div class="flex items-center justify-between text-xs">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                                                    <span>Traction</span>
                                                </div>
                                                <span class="font-medium tabular-nums">@msg.ScoreCard.Traction</span>
                                            </div>
                                            <ProgressCn Value="@msg.ScoreCard.Traction" Class="h-1" />
                                        </div>

                                        <div class="space-y-2">
                                            <div class="flex items-center justify-between text-xs">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                                                    <span>Team</span>
                                                </div>
                                                <span class="font-medium tabular-nums">@msg.ScoreCard.Team</span>
                                            </div>
                                            <ProgressCn Value="@msg.ScoreCard.Team" Class="h-1" />
                                        </div>
                                    </div>

                                    <div class="space-y-2 border-t pt-3">
                                        <p class="text-xs font-medium">Feedback</p>
                                        @foreach (var fb in msg.ScoreCard.Feedback)
                                        {
                                            <div class="flex gap-2 text-xs text-muted-foreground">
                                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                                <span>@fb</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (msg.SlidePreview != null)
                            {
                                <div class="w-full overflow-hidden rounded-lg border bg-card">
                                    <img src="@msg.SlidePreview.ImageUrl" alt="@msg.SlidePreview.Title" class="h-32 w-full object-cover" />
                                    <div class="border-t px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                                Slide @msg.SlidePreview.SlideNumber
                                            </BadgeCn>
                                            <p class="text-xs font-medium">@msg.SlidePreview.Title</p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input"
                         Placeholder="Answer the investor's question..."
                         Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Icon">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ScoreBreakdown(int Overall, int Clarity, int MarketOpportunity, int Traction, int Team, string[] Feedback);
    private record SlidePreviewData(int SlideNumber, string Title, string ImageUrl);
    private record Message(string Id, string Type, string Content, string Timestamp, ScoreBreakdown? ScoreCard = null, SlidePreviewData? SlidePreview = null);

    private string _input = "";

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Welcome to pitch practice! I'll help you refine your startup pitch by simulating investor questions. Ready to start?",
            "3:00 PM"),
        new("2", "user",
            "Yes! We're building an AI-powered supply chain optimization platform for e-commerce companies.",
            "3:01 PM"),
        new("3", "investor",
            "Interesting. What's the market size you're targeting, and how are you different from existing solutions like Oracle or SAP?",
            "3:01 PM"),
        new("4", "user",
            "The global supply chain management market is $19B and growing 11% annually. Unlike Oracle or SAP which are built for enterprises, we're targeting mid-market e-commerce companies with 10-500 employees who can't afford $500k implementations. Our AI reduces inventory costs by 23% on average.",
            "3:02 PM"),
        new("5", "assistant",
            "Great response! Here's your pitch score for that answer:",
            "3:02 PM",
            ScoreCard: new ScoreBreakdown(
                87, 92, 88, 85, 82,
                [
                    "Excellent market sizing with specific numbers and growth rate",
                    "Clear competitive differentiation focused on target segment",
                    "Strong traction metric (23% cost reduction) - consider adding customer count",
                    "Consider mentioning team experience in supply chain or AI",
                ]
            )),
    ];

    private string GetScoreColor(int score)
    {
        if (score >= 80) return "text-emerald-600";
        if (score >= 60) return "text-blue-600";
        if (score >= 40) return "text-amber-600";
        return "text-red-600";
    }

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new(
            System.DateTime.Now.Ticks.ToString(),
            "user",
            _input,
            "Just now"
        ));
        _input = "";
    }
}
