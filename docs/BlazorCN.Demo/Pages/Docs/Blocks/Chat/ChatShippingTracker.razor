@* ============================================================
   Block: chat-shipping-tracker
   Title: ChatShippingTracker
   Description: A package shipping tracker chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring tracking cards, status timeline, and delivery estimates
   Source: original/blocks/chat/chat-shipping-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="truck" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium">Shipping Tracker</h3>
                    <p class="text-xs text-muted-foreground">Real-time package tracking</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4">
            <div class="space-y-4 py-4">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            @if (message.Type == "assistant")
                            {
                                <AvatarFallbackCn Class="bg-primary/10">
                                    <LucideIconCn Name="truck" Size="16" Class="size-4 text-primary" />
                                </AvatarFallbackCn>
                            }
                            else
                            {
                                <AvatarImageCn Src="https://avatar.vercel.sh/user" />
                                <AvatarFallbackCn>U</AvatarFallbackCn>
                            }
                        </AvatarCn>

                        <div class="@Cn.Merge("flex-1 space-y-2", message.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @message.Content
                            </div>

                            @if (message.Tracking != null)
                            {
                                var trk = message.Tracking;
                                <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                    <div class="flex items-start justify-between">
                                        <div class="space-y-1">
                                            <div class="flex items-center gap-2">
                                                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                                                <span class="font-mono text-xs text-muted-foreground">@trk.Number</span>
                                            </div>
                                            <p class="text-sm font-medium">@trk.Carrier</p>
                                        </div>
                                        <div class="rounded-full bg-emerald-500/10 px-2 py-1 text-xs font-medium text-emerald-600">
                                            @trk.Status
                                        </div>
                                    </div>

                                    <div class="grid gap-2 text-xs">
                                        <div class="flex items-center gap-2 text-muted-foreground">
                                            <LucideIconCn Name="map-pin" Size="14" Class="size-3.5" />
                                            <span>Current location: @trk.Location</span>
                                        </div>
                                        <div class="flex items-center gap-2 text-muted-foreground">
                                            <LucideIconCn Name="clock" Size="14" Class="size-3.5" />
                                            <span>Estimated delivery: @trk.EstimatedDelivery</span>
                                        </div>
                                    </div>

                                    <div class="space-y-2 border-t pt-3">
                                        @for (int si = 0; si < trk.Timeline.Length; si++)
                                        {
                                            var step = trk.Timeline[si];
                                            var notLast = si < trk.Timeline.Length - 1;
                                            <div class="flex gap-2">
                                                <div class="flex flex-col items-center">
                                                    <div class="@Cn.Merge("flex size-4 items-center justify-center rounded-full", step.Completed ? "bg-emerald-500" : "border-2 border-muted")">
                                                        @if (step.Completed)
                                                        {
                                                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-white" />
                                                        }
                                                    </div>
                                                    @if (notLast)
                                                    {
                                                        <div class="@Cn.Merge("h-6 w-px", step.Completed ? "bg-emerald-500" : "bg-muted")"></div>
                                                    }
                                                </div>
                                                <div class="flex-1 pb-2">
                                                    <p class="@Cn.Merge("text-xs font-medium", !step.Completed ? "text-muted-foreground" : "")">
                                                        @step.Stage
                                                    </p>
                                                    @if (step.Time != null)
                                                    {
                                                        <p class="text-xs text-muted-foreground">
                                                            @step.Time@(step.Location != null ? $" • {step.Location}" : "")
                                                        </p>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault>
                <InputCn @bind-Value="_input"
                         Placeholder="Enter tracking number or ask a question..."
                         Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Icon">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private record TrackingStep(string Stage, bool Completed, string? Time = null, string? Location = null);

    private record TrackingInfo(
        string Number,
        string Carrier,
        string Status,
        string Location,
        string EstimatedDelivery,
        TrackingStep[] Timeline);

    private record Message(string Id, string Type, string Content, string Timestamp, TrackingInfo? Tracking = null);

    private static readonly Message[] _initialMessages =
    [
        new("1", "assistant",
            "Hi! I'm your shipping assistant. Share a tracking number and I'll get you the latest updates on your package.",
            "10:00 AM"),
        new("2", "user",
            "Track package 1Z999AA10123456784",
            "10:01 AM"),
        new("3", "assistant",
            "I found your package! Here's the current status:",
            "10:01 AM",
            new TrackingInfo(
                "1Z999AA10123456784",
                "UPS",
                "Out for Delivery",
                "San Francisco, CA",
                "Today by 8:00 PM",
                [
                    new("Order Placed",        true,  "Mar 27, 9:00 AM",  "New York, NY"),
                    new("Picked Up",           true,  "Mar 27, 2:00 PM",  "New York, NY"),
                    new("In Transit",          true,  "Mar 28, 6:00 AM",  "Chicago, IL"),
                    new("Arrived at Facility", true,  "Mar 29, 10:00 AM", "San Francisco, CA"),
                    new("Out for Delivery",    true,  "Mar 30, 7:00 AM",  "San Francisco, CA"),
                    new("Delivered",           false),
                ])),
        new("4", "user",
            "When exactly will it arrive?",
            "10:02 AM"),
        new("5", "assistant",
            "Your package is currently out for delivery and should arrive by 8:00 PM today. You'll receive a notification once it's delivered to your doorstep.",
            "10:02 AM"),
    ];

    private List<Message> _messages = [.. _initialMessages];
    private string _input = "";

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new Message(
            DateTime.Now.Ticks.ToString(),
            "user",
            _input,
            "Just now");

        _messages = [.. _messages, newMessage];
        _input = "";
    }
}
