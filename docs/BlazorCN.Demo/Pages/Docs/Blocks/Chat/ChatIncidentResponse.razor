@* ============================================================
   Block: chat-incident-response
   Title: ChatIncidentResponse
   Description: React incident response chat block for Next.js with severity indicators, status timeline, role assignments, runbook links, and escalation controls using shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-incident-response.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Severity header *@
        <div class="@Cn.Merge("flex items-center gap-3 border-b px-4 py-3", _config.Bg)">
            <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_incidentTitle</span>
                </div>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="font-mono">@_incidentId</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                        @_startedAt
                    </span>
                    <span>·</span>
                    <span>@_duration</span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _config.Dot)"></span>
                    @_config.Label
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary"
                         Class="@Cn.Merge("font-normal text-xs", _statusConfig[_currentStatus].Color)">
                    @_statusConfig[_currentStatus].Label
                </BadgeCn>
            </div>
        </div>

        @* Responders bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
            <div class="flex flex-1 flex-wrap items-center gap-2">
                @foreach (var r in _responders.Values)
                {
                    <div class="flex items-center gap-1.5">
                        <AvatarCn Class="size-5">
                            <AvatarFallbackCn Class="@Cn.Merge("text-white text-[7px]", r.Color)">
                                @r.Initials
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <span class="text-muted-foreground text-xs">@r.Role</span>
                    </div>
                }
            </div>
        </div>

        @* Main content *@
        <div class="flex-1 overflow-y-auto">

            @* Timeline *@
            <div class="border-b px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Timeline</span>
                <div class="space-y-0">
                    @foreach (var entry in _timeline)
                    {
                        var isLast = entry.Id == _timeline[_timeline.Length - 1].Id;
                        var sConfig = _statusConfig[entry.Status];
                        <div class="flex gap-3">
                            <div class="flex flex-col items-center">
                                @if (entry.Status == "resolved")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="circle-dot" Size="16" Class="@Cn.Merge("size-4 shrink-0", sConfig.Color)" />
                                }
                                @if (!isLast)
                                {
                                    <div class="w-px flex-1 bg-border"></div>
                                }
                            </div>
                            <div class="@Cn.Merge("pb-3", isLast ? "pb-0" : "")">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                        @entry.Timestamp
                                    </span>
                                    <span class="@Cn.Merge("font-medium text-xs", sConfig.Color)">
                                        @sConfig.Label
                                    </span>
                                </div>
                                <p class="mt-0.5 text-sm leading-relaxed">@entry.Message</p>
                                <span class="text-muted-foreground text-xs">@entry.Author</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Runbooks *@
            <div class="border-b px-4 py-2.5">
                <div class="flex flex-wrap items-center gap-2">
                    <LucideIconCn Name="book-open" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Runbooks</span>
                    @foreach (var rb in _runbooks)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                            @rb.Label
                        </ButtonCn>
                    }
                    @if (!_escalated)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="ml-auto h-6 gap-1 px-2 text-xs text-red-600 hover:text-red-600 dark:text-red-400"
                                  OnClick="@(() => _escalated = true)">
                            <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                            Escalate
                        </ButtonCn>
                    }
                    @if (_escalated)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary"
                                 Class="ml-auto font-normal text-xs text-amber-600 dark:text-amber-400">
                            <LucideIconCn Name="alert-triangle" Size="12" Class="mr-1 size-3" />
                            Escalated
                        </BadgeCn>
                    }
                </div>
            </div>

            @* Chat messages *@
            <div class="px-4 py-3">
                <div class="flex flex-col gap-1">
                    @foreach (var msg in _messages)
                    {
                        @if (msg.Role == "system")
                        {
                            <div class="flex justify-center py-1.5">
                                <span class="text-muted-foreground text-xs">
                                    @msg.Content
                                    <span class="ml-2 text-muted-foreground/60">@msg.Timestamp</span>
                                </span>
                            </div>
                        }
                        else
                        {
                            var user = msg.UserId != null && _responders.ContainsKey(msg.UserId) ? _responders[msg.UserId] : null;
                            @if (user != null)
                            {
                                <div class="group flex gap-2 py-1.5 transition-colors hover:bg-accent rounded px-1">
                                    <AvatarCn Class="mt-0.5 size-6 shrink-0">
                                        <AvatarFallbackCn Class="@Cn.Merge("text-white text-[8px]", user.Color)">
                                            @user.Initials
                                        </AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-baseline gap-2">
                                            <span class="font-medium text-xs">@user.Name</span>
                                            <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                                @msg.Timestamp
                                            </span>
                                        </div>
                                        <p class="text-sm leading-relaxed">@msg.Content</p>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input"
                         Placeholder="Post an update..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private record SeverityInfo(string Label, string Dot, string Bg);
    private record StatusInfo(string Label, string Color);
    private record Responder(string Id, string Name, string Initials, string Role, string Color);
    private record TimelineEntry(string Id, string Timestamp, string Status, string Message, string Author);
    private record ChatMessage(string Id, string Role, string Content, string Timestamp, string? UserId = null);
    private record Runbook(string Label, string Id);

    private string _input = "";
    private bool _escalated = false;

    private const string _severity = "sev1";
    private const string _incidentTitle = "Payment service returning 503 errors";
    private const string _incidentId = "INC-4821";
    private const string _startedAt = "14:23 UTC";
    private const string _duration = "47 min";

    private static readonly Dictionary<string, SeverityInfo> _severityConfig = new()
    {
        ["sev1"] = new SeverityInfo("SEV-1", "bg-red-500", "bg-red-500/10"),
        ["sev2"] = new SeverityInfo("SEV-2", "bg-amber-500", "bg-amber-500/10"),
        ["sev3"] = new SeverityInfo("SEV-3", "bg-blue-500", "bg-blue-500/10"),
        ["sev4"] = new SeverityInfo("SEV-4", "bg-muted-foreground/40", "bg-muted/30"),
    };

    private static readonly Dictionary<string, StatusInfo> _statusConfig = new()
    {
        ["investigating"] = new StatusInfo("Investigating", "text-red-600 dark:text-red-400"),
        ["identified"]    = new StatusInfo("Identified",    "text-amber-600 dark:text-amber-400"),
        ["monitoring"]    = new StatusInfo("Monitoring",    "text-blue-600 dark:text-blue-400"),
        ["resolved"]      = new StatusInfo("Resolved",      "text-emerald-600 dark:text-emerald-400"),
    };

    private static readonly Dictionary<string, Responder> _responders = new()
    {
        ["r1"] = new Responder("r1", "Dana Kim",    "DK", "Incident Commander", "bg-red-600"),
        ["r2"] = new Responder("r2", "Ravi Patel",  "RP", "Backend Lead",       "bg-blue-600"),
        ["r3"] = new Responder("r3", "Lisa Chen",   "LC", "SRE On-Call",        "bg-emerald-600"),
        ["r4"] = new Responder("r4", "Marcus Hall", "MH", "Communications",     "bg-violet-600"),
    };

    private static readonly TimelineEntry[] _timeline =
    [
        new("t1", "14:23", "investigating", "Alerts triggered: payment-service error rate >5% across all regions", "System"),
        new("t2", "14:28", "investigating", "Confirmed 503 errors on /api/payments/charge endpoint. Upstream dependency check in progress.", "Lisa Chen"),
        new("t3", "14:35", "identified",    "Root cause identified: connection pool exhaustion on payment-db-primary. Max connections reached at 500/500.", "Ravi Patel"),
        new("t4", "14:42", "identified",    "Deploying hotfix to increase pool size to 750 and terminate idle connections. ETA 5 minutes.", "Ravi Patel"),
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "system", "Incident INC-4821 opened by automated alert", "14:23"),
        new("m2", "user",   "I'm seeing the alerts. Pulling up dashboards now. Error rate is climbing fast — 12% and rising.", "14:24", "r3"),
        new("m3", "user",   "Declaring SEV-1. All hands on deck. @@Ravi can you check the payment service pods and DB connections?", "14:25", "r1"),
        new("m4", "user",   "On it. Seeing high connection wait times on the primary DB. Looks like pool exhaustion. Checking max connections config now.", "14:27", "r2"),
        new("m5", "system", "Status updated to Identified", "14:35"),
        new("m6", "user",   "Confirmed. Pool is maxed at 500 connections. We had a spike from the batch job that started at 14:20. Preparing a config change to bump the limit and kill idle connections.", "14:36", "r2"),
        new("m7", "user",   "I'll draft the customer status page update. Ravi, what's the ETA for the fix?", "14:38", "r4"),
        new("m8", "user",   "5 minutes to deploy the config change. Should see recovery within 2 minutes after that.", "14:39", "r2"),
    ];

    private static readonly Runbook[] _runbooks =
    [
        new Runbook("Payment Service Restart",   "rb1"),
        new Runbook("DB Connection Pool Reset",  "rb2"),
        new Runbook("Failover to Secondary DB",  "rb3"),
    ];

    private SeverityInfo _config => _severityConfig[_severity];
    private string _currentStatus => _timeline[_timeline.Length - 1].Status;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
