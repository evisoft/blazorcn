@* ============================================================
   Block: chat-conversation-summary
   Title: ChatConversationSummary
   Description: React chat block with AI-generated conversation summary side panel for Next.js featuring key topics, action items, and sentiment analysis using TypeScript, shadcn/ui, Tailwind CSS
   Source: original/blocks/chat/chat-conversation-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Chat panel *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-[10px]">AT</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Ava Torres</span>
                    <p class="text-muted-foreground text-xs">Engineering Lead</p>
                </div>
                <ButtonCn Variant="@(_showSummary ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1.5 text-xs"
                          OnClick="@(() => _showSummary = !_showSummary)">
                    <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" />
                    Summary
                </ButtonCn>
            </div>

            @* Messages *@
            <div class="flex-1 overflow-y-auto px-4 py-3">
                <div class="flex flex-col gap-1">
                    @foreach (var msg in _messages)
                    {
                        var isMe = msg.Sender == "me";
                        <div class="@Cn.Merge("flex flex-col", isMe ? "items-end" : "items-start")">
                            <div class="mb-0.5 flex items-center gap-1.5">
                                @if (!isMe)
                                {
                                    <AvatarCn Class="size-5">
                                        <AvatarFallbackCn Class="text-[8px]">@msg.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                }
                                <span class="text-[10px] text-muted-foreground">
                                    @if (!isMe)
                                    {
                                        @($"{msg.Name} · ")
                                    }
                                    @msg.Time
                                </span>
                            </div>
                            <div class="@Cn.Merge("max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed", isMe ? "bg-foreground text-background" : "bg-muted text-foreground")">
                                @msg.Content
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Input *@
            <div class="border-t px-4 py-3">
                <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                    <InputCn @bind-Value="_input"
                             Placeholder="Type a message..."
                             Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                    <ButtonCn type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                </form>
            </div>
        </div>

        @* Summary panel *@
        @if (_showSummary)
        {
            <div class="flex w-80 flex-col overflow-hidden border-l">
                <div class="flex flex-1 flex-col overflow-y-auto">
                    @* Panel header *@
                    <div class="flex items-center justify-between border-b px-4 py-3">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="font-medium text-sm">Conversation Summary</span>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Icon"
                                  Class="size-6"
                                  OnClick="@(() => _showSummary = false)">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>

                    @* Stats *@
                    <div class="flex items-center gap-3 border-b px-4 py-3">
                        <span class="text-muted-foreground text-xs">@_summary.MessageCount messages</span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", _sentimentColor)" />
                            @_sentimentLabel
                        </span>
                    </div>

                    @* Highlights *@
                    <div class="border-b px-4 py-3">
                        <span class="font-medium text-muted-foreground text-xs">Key Highlights</span>
                        <ul class="mt-2 space-y-2">
                            @foreach (var item in _summary.Highlights)
                            {
                                <li class="flex gap-2 text-sm leading-relaxed">
                                    <span class="mt-2 size-1 shrink-0 rounded-full bg-foreground/40" />
                                    @item
                                </li>
                            }
                        </ul>
                    </div>

                    @* Topics *@
                    <div class="border-b px-4 py-3">
                        <span class="font-medium text-muted-foreground text-xs">Topics Discussed</span>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            @foreach (var topic in _summary.Topics)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@topic</BadgeCn>
                            }
                        </div>
                    </div>

                    @* Action items *@
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-muted-foreground text-xs">Action Items</span>
                            <span class="text-muted-foreground text-xs tabular-nums">@_summary.Actions.Length</span>
                        </div>
                        <div class="mt-2 space-y-2">
                            @foreach (var action in _summary.Actions)
                            {
                                <div class="flex items-start gap-2">
                                    @if (action.Done)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-emerald-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="circle-dot" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                    }
                                    <div class="min-w-0 flex-1">
                                        <p class="@Cn.Merge("text-sm leading-relaxed", action.Done ? "text-muted-foreground line-through" : "")">
                                            @action.Text
                                        </p>
                                        <span class="text-muted-foreground text-xs">@action.Assignee</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Name, string Initials, string Content, string Time);
    private record ActionItem(string Id, string Text, string Assignee, bool Done);
    private record ConversationSummary(string[] Highlights, string[] Topics, ActionItem[] Actions, string Sentiment, int MessageCount);

    private string _input = "";
    private bool _showSummary = true;

    private static readonly ChatMessage[] _messages =
    [
        new("1", "other", "Ava Torres", "AT",
            "The quarterly OKR review is tomorrow. I've drafted the engineering section — can you look it over?",
            "10:02 AM"),
        new("2", "me", "You", "YO",
            "Sure, send me the doc link. What's the overall progress looking like?",
            "10:03 AM"),
        new("3", "other", "Ava Torres", "AT",
            "We hit 85% on the platform reliability KR. The latency target is at 92%. The only miss is the documentation KR — we're at 60%.",
            "10:05 AM"),
        new("4", "me", "You", "YO",
            "That's solid for reliability. For docs, let's push a sprint to cover the top 20 API endpoints before the review.",
            "10:06 AM"),
        new("5", "other", "Ava Torres", "AT",
            "Good idea. I'll assign Jake and Priya to that. They've been wanting to improve the developer portal anyway.",
            "10:08 AM"),
        new("6", "me", "You", "YO",
            "Perfect. What about the hiring goal? We had a target of 3 senior engineers this quarter.",
            "10:09 AM"),
        new("7", "other", "Ava Torres", "AT",
            "We've extended 2 offers, both accepted. The third pipeline is in final rounds — should close by Friday.",
            "10:11 AM"),
        new("8", "me", "You", "YO",
            "Great. Let's present the hiring progress as on track. Include the onboarding timeline in the slides.",
            "10:12 AM"),
        new("9", "other", "Ava Torres", "AT",
            "Will do. I'll also add the budget utilization chart — we're under budget by 12% which looks good.",
            "10:14 AM"),
        new("10", "me", "You", "YO",
            "Nice. Send me the final deck by 6 PM today so I can review before tomorrow morning.",
            "10:15 AM"),
    ];

    private static readonly ConversationSummary _summary = new(
        Highlights:
        [
            "Platform reliability KR at 85%, latency target at 92% — both on track",
            "Documentation KR behind at 60%, sprint planned to cover top 20 API endpoints",
            "Hiring goal nearly met: 2 offers accepted, 3rd in final rounds closing Friday",
            "Engineering budget under by 12%, positive for the quarterly report",
        ],
        Topics:
        [
            "OKR quarterly review",
            "Platform reliability metrics",
            "API documentation sprint",
            "Senior engineering hiring",
            "Budget utilization",
        ],
        Actions:
        [
            new("a1", "Assign Jake and Priya to API docs sprint", "Ava", false),
            new("a2", "Close 3rd senior engineer hire by Friday", "Ava", false),
            new("a3", "Add onboarding timeline to presentation slides", "Ava", false),
            new("a4", "Add budget utilization chart to deck", "Ava", false),
            new("a5", "Send final deck by 6 PM for review", "Ava", false),
        ],
        Sentiment: "positive",
        MessageCount: 10
    );

    private string _sentimentLabel => _summary.Sentiment switch
    {
        "positive" => "Positive",
        "negative" => "Negative",
        _ => "Neutral",
    };

    private string _sentimentColor => _summary.Sentiment switch
    {
        "positive" => "bg-emerald-500",
        "negative" => "bg-red-500",
        _ => "bg-amber-500",
    };

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
