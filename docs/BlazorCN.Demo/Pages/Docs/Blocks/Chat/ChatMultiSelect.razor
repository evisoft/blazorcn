@* ============================================================
   Block: chat-multi-select
   Title: ChatMultiSelect
   Description: React chat block with multi-select mode for Next.js featuring message checkboxes, selection count, and bulk actions like forward, delete, and star using TypeScript, shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/chat/chat-multi-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-[10px]">EP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Ethan Park</span>
                <p class="text-muted-foreground text-xs">Product</p>
            </div>
            @if (_selectMode && _selected.Count > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          @onclick="@(() => { if (_selected.Count == _messages.Length) _selected.Clear(); else SelectAll(); })">
                    @(_selected.Count == _messages.Length ? "Deselect" : "Select All")
                </ButtonCn>
            }
            <ButtonCn Variant="@(_selectMode ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs"
                      @onclick="ToggleSelectMode">
                <LucideIconCn Name="check-square-2" Size="14" Class="size-3.5" />
                @(_selectMode ? "Cancel" : "Select")
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2" tabindex="0" role="group" aria-label="Messages">
            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var idx = i;
                var prev = idx > 0 ? _messages[idx - 1] : null;
                var showAvatar = prev == null || prev.Sender != msg.Sender;
                var isSelected = _selected.Contains(msg.Id);
                var msgId = msg.Id;
                var rowClass = Cn.Merge(
                    "group flex gap-2 px-3 py-1 transition-colors",
                    _selectMode ? "cursor-pointer" : "",
                    isSelected ? "border-l-2 border-l-blue-500 bg-accent/50" : "hover:bg-accent/50"
                );

                @* The row used to carry role="button" + its own @onclick alongside the checkbox,
                   so clicking the box toggled twice (net zero) and nested a control inside a
                   button role. The row is now the checkbox's <label>: one toggle either way. *@
                <label class="@rowClass"
                       for="@(_selectMode ? $"cms-msg-{msgId}" : null)">
                    @* Checkbox column *@
                    @if (_selectMode)
                    {
                        <div class="flex w-5 shrink-0 items-start pt-1.5">
                            <CheckboxCn Id="@($"cms-msg-{msgId}")" Checked="@isSelected" CheckedChanged="@(() => ToggleSelect(msgId))" aria-label="Select message" />
                        </div>
                    }

                    @* Avatar column *@
                    <div class="w-8 shrink-0 pt-0.5">
                        @if (showAvatar)
                        {
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        else
                        {
                            var shortTime = msg.Time.Replace(" PM", "").Replace(" AM", "");
                            <span class="hidden items-center justify-center text-[10px] text-muted-foreground group-hover:flex h-full">@shortTime</span>
                        }
                    </div>

                    @* Body *@
                    <div class="min-w-0 flex-1">
                        @if (showAvatar)
                        {
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-[10px] text-muted-foreground">@msg.Time</span>
                            </div>
                        }
                        <p class="text-sm leading-relaxed">@msg.Content</p>
                    </div>
                </label>
            }
        </div>

        @* Action bar — shown when messages are selected *@
        @if (_selectMode && _selected.Count > 0)
        {
            <div class="overflow-hidden border-t">
                <div class="flex items-center gap-2 px-4 py-2">
                    <span class="font-medium text-sm tabular-nums">@_selected.Count</span>
                    <span class="text-muted-foreground text-xs">
                        message@(_selected.Count != 1 ? "s" : "") selected
                    </span>
                    <div class="ml-auto flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                            <LucideIconCn Name="forward" Size="14" Class="size-3.5" />
                            Forward
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                            <LucideIconCn Name="star" Size="14" Class="size-3.5" />
                            Star
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1.5 text-xs text-red-600 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400">
                            <LucideIconCn Name="trash-2" Size="14" Class="size-3.5" />
                            Delete
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Toolbar *@
        <div class="border-t px-3 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-end gap-2 rounded-lg border bg-background px-3 py-2">
                <textarea @bind="_input" @bind:event="oninput"
                          placeholder="Type a message..."
                          rows="1"
                          class="min-h-0 max-h-32 flex-1 resize-none border-0 bg-transparent p-0 text-sm shadow-none outline-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Type a message..."></textarea>
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-7 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send message">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(
        string Id,
        string Sender,
        string Initials,
        string Content,
        string Time
    );

    private static readonly ChatMessage[] _messages =
    [
        new("1",  "Ethan Park", "EP", "The product spec is finalized. I'll send the link once it's published to Notion.", "1:40 PM"),
        new("2",  "You",        "YO", "Great. Did the stakeholders sign off on the timeline?", "1:41 PM"),
        new("3",  "Ethan Park", "EP", "Yes, everyone approved the 6-week sprint plan. Design starts Monday, engineering picks up in week 3.", "1:42 PM"),
        new("4",  "You",        "YO", "That gives us enough buffer for testing. What about the API contract?", "1:43 PM"),
        new("5",  "Ethan Park", "EP", "Backend team already drafted the OpenAPI spec. I'll share it in the #api-contracts channel.", "1:45 PM"),
        new("6",  "You",        "YO", "Perfect. Can you also loop in the mobile team? They need to start the SDK integration early.", "1:46 PM"),
        new("7",  "Ethan Park", "EP", "Already done. Raj from mobile is joining the kickoff. He had some questions about the auth flow.", "1:48 PM"),
        new("8",  "You",        "YO", "Tell him to check the auth middleware PR I merged yesterday. It covers the OAuth token refresh edge case.", "1:49 PM"),
        new("9",  "Ethan Park", "EP", "Will do. One more thing — the QA lead wants to set up test environments before sprint 2. Should I allocate infra budget for that?", "1:51 PM"),
        new("10", "You",        "YO", "Yes, go ahead. Spin up staging on the same cluster. Keep costs under the $200/month cap.", "1:52 PM"),
    ];

    private string _input = "";
    private bool _selectMode = true;
    private HashSet<string> _selected = ["3", "5", "7"];

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void SelectAll()
    {
        foreach (var m in _messages)
            _selected.Add(m.Id);
    }

    private void ToggleSelectMode()
    {
        if (_selectMode)
        {
            _selected.Clear();
            _selectMode = false;
        }
        else
        {
            _selectMode = true;
        }
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
