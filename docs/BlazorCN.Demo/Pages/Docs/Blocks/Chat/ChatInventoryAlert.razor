@* ============================================================
   Block: chat-inventory-alert
   Title: ChatInventoryAlert
   Description: React inventory alert notification chat block for Next.js with stock level warnings, reorder suggestions, product cards, threshold indicators, and batch action buttons using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-inventory-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="box" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Inventory Alerts</span>
                <p class="text-muted-foreground text-xs">Real-time stock monitoring</p>
            </div>
        </div>

        @* Alert summary bar *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="triangle-alert" Size="12" Class="size-3" />
                @_alertSummaryTotal alerts
            </span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_alertSummaryCritical critical
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_alertSummaryWarning warning
                </span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "manager" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "manager"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Alerts != null)
                            {
                                var alerts = msg.Alerts;
                                <div class="mt-2 rounded-md border bg-card">
                                    @for (int i = 0; i < alerts.Length; i++)
                                    {
                                        var alert = alerts[i];
                                        var isLast = i == alerts.Length - 1;
                                        var stockColor = alert.CurrentQty == 0
                                            ? "text-red-600 dark:text-red-400"
                                            : "text-amber-600 dark:text-amber-400";
                                        var dotColor = alert.Severity == "critical" ? "bg-red-500"
                                            : alert.Severity == "warning" ? "bg-amber-500"
                                            : "bg-blue-500";
                                        var severityText = alert.Severity == "critical" ? "Out of stock"
                                            : alert.Severity == "warning" ? "Low stock"
                                            : "Approaching threshold";
                                        <div class="@(isLast ? "px-3 py-2.5" : "px-3 py-2.5 border-b")">
                                            <div class="flex items-center gap-2.5">
                                                <span class="@($"size-2 shrink-0 rounded-full {dotColor}")"></span>
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center justify-between gap-2">
                                                        <span class="truncate font-medium text-sm">@alert.Product</span>
                                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                                                            @severityText
                                                        </BadgeCn>
                                                    </div>
                                                    <div class="mt-0.5 flex items-center gap-3">
                                                        <span class="font-mono text-muted-foreground text-xs">@alert.Sku</span>
                                                        <span class="text-muted-foreground text-xs">@alert.Warehouse</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mt-1.5 flex items-center gap-4 pl-4.5">
                                                <span class="text-xs">
                                                    <span class="text-muted-foreground">Stock: </span>
                                                    <span class="@($"font-medium tabular-nums {stockColor}")">@alert.CurrentQty</span>
                                                </span>
                                                <span class="text-xs">
                                                    <span class="text-muted-foreground">Threshold: </span>
                                                    <span class="tabular-nums">@alert.Threshold</span>
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (msg.Reorder != null)
                            {
                                var reorder = msg.Reorder;
                                var ordered = _orderedReorders.Contains(reorder.Sku);
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">Reorder Suggestion</span>
                                        </div>
                                        <span class="font-mono text-muted-foreground text-xs">@reorder.Sku</span>
                                    </div>
                                    <div class="space-y-1.5">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Product</span>
                                            <span class="text-sm">@reorder.Product</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Supplier</span>
                                            <span class="text-sm">@reorder.Supplier</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Quantity</span>
                                            <span class="font-medium text-sm tabular-nums">@reorder.Quantity units</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Unit cost</span>
                                            <span class="text-sm tabular-nums">@reorder.UnitCost</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Est. delivery</span>
                                            <span class="text-sm">@reorder.EstimatedDelivery</span>
                                        </div>
                                    </div>
                                    <div class="mt-2.5 border-t pt-2.5">
                                        @{
                                            var sku = reorder.Sku;
                                        }
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full gap-1.5 text-xs"
                                                  OnClick="@(() => PlaceReorder(sku))"
                                                  Disabled="@ordered">
                                            @if (ordered)
                                            {
                                                <LucideIconCn Name="package" Size="12" Class="size-3" />
                                                @("Order placed")
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="truck" Size="12" Class="size-3" />
                                                @("Place reorder")
                                            }
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            <span class="@(msg.Role == "manager"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Ask about inventory..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private readonly HashSet<string> _orderedReorders = [];

    private readonly int _alertSummaryTotal = 8;
    private readonly int _alertSummaryCritical = 3;
    private readonly int _alertSummaryWarning = 5;

    private record StockAlert(
        string Product,
        string Sku,
        int CurrentQty,
        int Threshold,
        string Severity,
        string Warehouse);

    private record ReorderSuggestion(
        string Product,
        string Sku,
        string Supplier,
        int Quantity,
        string UnitCost,
        string EstimatedDelivery);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        StockAlert[]? Alerts = null,
        ReorderSuggestion? Reorder = null);

    private readonly Message[] _messages =
    [
        new("1", "system",
            "Inventory scan completed. 8 products require attention across 2 warehouses.",
            "9:00 AM"),
        new("2", "system", "", "9:00 AM",
            Alerts:
            [
                new("Wireless Earbuds Pro", "WEP-2024-BLK", 0, 50, "critical", "Warehouse A"),
                new("USB-C Charging Cable 6ft", "UCC-6FT-WHT", 0, 200, "critical", "Warehouse A"),
                new("Laptop Stand Aluminum", "LSA-ADJ-SLV", 0, 30, "critical", "Warehouse B"),
            ]),
        new("3", "manager",
            "The earbuds are our top seller this month. We need to prioritize that reorder. What's the fastest supplier option?",
            "9:02 AM"),
        new("4", "system",
            "I found the best reorder option based on lead time and cost. TechParts Direct has stock available for express shipping.",
            "9:02 AM"),
        new("5", "system", "", "9:03 AM",
            Reorder: new("Wireless Earbuds Pro", "WEP-2024-BLK", "TechParts Direct", 200, "$18.50", "Apr 2, 2026")),
        new("6", "manager",
            "That price is good. Approve the earbuds PO. Also pull up the low stock warnings so I can review those next.",
            "9:05 AM"),
        new("7", "system",
            "Purchase order PO-4892 created for Wireless Earbuds Pro. Here are the low stock warnings:",
            "9:05 AM"),
        new("8", "system", "", "9:06 AM",
            Alerts:
            [
                new("Webcam HD 1080p", "WC-1080-BLK", 12, 40, "warning", "Warehouse A"),
                new("Mechanical Keyboard TKL", "MKB-TKL-RGB", 8, 25, "warning", "Warehouse B"),
            ]),
    ];

    private void PlaceReorder(string sku)
    {
        _orderedReorders.Add(sku);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
