@* ============================================================
   Block: chat-discord-style
   Title: ChatDiscordStyle
   Description: React Discord-inspired chat interface for Next.js with dark background, role-colored usernames, grouped messages, hover reaction button, and server channel header using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-discord-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border border-zinc-700 bg-zinc-800">
        @* Channel header *@
        <div class="flex items-center gap-2 border-zinc-700 border-b px-4 py-3">
            <LucideIconCn Name="hash" Size="16" Class="size-4 text-zinc-400" />
            <span class="font-medium text-sm text-zinc-100">@_server.Channel</span>
            <div class="mx-2 h-4 w-px bg-zinc-700"></div>
            <span class="truncate text-xs text-zinc-400">@_server.Name workspace</span>
            <div class="ml-auto flex items-center gap-3">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 text-zinc-400 hover:bg-zinc-700 hover:text-zinc-200">
                    <LucideIconCn Name="pin" Size="14" Class="size-3.5" />
                </ButtonCn>
                <div class="flex items-center gap-1 text-xs text-zinc-400">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                    <span class="tabular-nums">@_server.OnlineCount</span>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto pb-2">
            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var idx = i;
                var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                var grouped = IsGrouped(msg, prevMsg);
                var msgId = msg.Id;

                <div class="group relative transition-colors hover:bg-white/[0.02]"
                     @onmouseenter="@(() => _hoveredMsg = msgId)"
                     @onmouseleave="@(() => _hoveredMsg = null)">

                    @* Hover reaction bar *@
                    @if (_hoveredMsg == msg.Id)
                    {
                        <div class="absolute top-0 right-3 z-10 -translate-y-1/2">
                            <div class="flex items-center gap-0.5 rounded-md border border-zinc-600 bg-zinc-800 p-0.5 shadow-lg">
                                <button type="button"
                                        class="flex size-6 items-center justify-center rounded text-sm transition-colors hover:bg-zinc-700"
                                        aria-label="Thumbs up reaction">
                                    &#x1F44D;
                                </button>
                                <button type="button"
                                        class="flex size-6 items-center justify-center rounded text-sm transition-colors hover:bg-zinc-700"
                                        aria-label="Heart reaction">
                                    &#x2764;&#xFE0F;
                                </button>
                                <button type="button"
                                        class="flex size-6 items-center justify-center rounded text-zinc-400 transition-colors hover:bg-zinc-700 hover:text-zinc-200"
                                        aria-label="More reactions">
                                    <LucideIconCn Name="smile" Size="14" Class="size-3.5" />
                                </button>
                            </div>
                        </div>
                    }

                    @if (grouped)
                    {
                        @* Grouped follow-up (no avatar/name, indented) *@
                        <div class="py-0.5 pr-4 pl-[60px]">
                            <p class="text-sm leading-relaxed text-zinc-200">@msg.Content</p>
                        </div>
                    }
                    else
                    {
                        @* First message in group (avatar + role-colored name) *@
                        var rowClass = Cn.Merge("flex gap-3 px-4", idx > 0 ? "mt-3 pt-2" : "pt-3");
                        var nameClass = Cn.Merge("font-medium text-sm", GetRoleColorClass(msg.RoleColor));
                        <div class="@rowClass">
                            <AvatarCn Class="mt-0.5 size-9 shrink-0">
                                <AvatarFallbackCn Class="bg-zinc-700 text-[10px] text-zinc-300">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="@nameClass">@msg.Sender</span>
                                    <span class="text-[10px] text-zinc-500">@msg.Timestamp</span>
                                </div>
                                <p class="mt-0.5 text-sm leading-relaxed text-zinc-200">@msg.Content</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Input container *@
        <div class="px-4 pb-4">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2 rounded-lg bg-zinc-700 px-3">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-zinc-400 hover:bg-transparent hover:text-zinc-200">
                    <LucideIconCn Name="plus-circle" Size="20" Class="size-5" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="@($"Message #{ _server.Channel}")"
                         Class="h-10 flex-1 border-0 bg-transparent text-sm text-zinc-200 shadow-none placeholder:text-zinc-500 focus-visible:ring-0" />
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-zinc-400 hover:bg-transparent hover:text-zinc-200">
                    <LucideIconCn Name="smile" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-zinc-400 hover:bg-transparent hover:text-zinc-200 disabled:opacity-30">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ServerInfo(string Name, string Channel, int OnlineCount);

    private record Message(
        string Id,
        string Sender,
        string Initials,
        string RoleColor,
        string Content,
        string Timestamp
    );

    private static readonly ServerInfo _server = new("Acme Dev", "general", 8);

    private string? _hoveredMsg;
    private string _input = "";

    private static readonly Message[] _messages =
    [
        new("1", "Mia Chen", "MC", "red", "Just deployed v2.4 to production. All health checks are green.", "Today at 10:15 AM"),
        new("2", "Mia Chen", "MC", "red", "The new rate limiter is active on the API gateway. 1000 req/min per user.", "Today at 10:15 AM"),
        new("3", "Leo Park", "LP", "blue", "Nice, the dashboard latency already dropped. Seeing p99 at 120ms down from 340ms.", "Today at 10:18 AM"),
        new("4", "Sara Ahmed", "SA", "emerald", "The Sentry error rate is way down too. Only 2 errors in the last hour vs 47 yesterday.", "Today at 10:20 AM"),
        new("5", "Sara Ahmed", "SA", "emerald", "Both were timeout retries that resolved on the second attempt.", "Today at 10:20 AM"),
        new("6", "James Liu", "JL", "amber", "Can someone review my PR for the notification service? It adds WebSocket support for real-time alerts.", "Today at 10:24 AM"),
        new("7", "Mia Chen", "MC", "red", "I'll take a look after lunch. Is it based on the RFC we discussed last sprint?", "Today at 10:26 AM"),
        new("8", "James Liu", "JL", "amber", "Yep, follows the spec exactly. Added reconnection logic with exponential backoff and a heartbeat every 30s.", "Today at 10:27 AM"),
        new("9", "Priya Nair", "PN", "purple", "Heads up: I'm rotating the database credentials at 2 PM UTC. There will be a brief connection reset.", "Today at 10:32 AM"),
        new("10", "Priya Nair", "PN", "purple", "The connection pool should handle it automatically but keep an eye on your logs.", "Today at 10:32 AM"),
        new("11", "Leo Park", "LP", "blue", "Thanks for the heads up. I'll set a Grafana alert for connection errors during that window.", "Today at 10:35 AM"),
    ];

    private static bool IsGrouped(Message current, Message? previous)
    {
        if (previous is null) return false;
        return current.Sender == previous.Sender && current.Timestamp == previous.Timestamp;
    }

    private static string GetRoleColorClass(string roleColor) => roleColor switch
    {
        "red" => "text-red-400",
        "blue" => "text-blue-400",
        "emerald" => "text-emerald-400",
        "amber" => "text-amber-400",
        "purple" => "text-purple-400",
        _ => "text-zinc-300",
    };

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
