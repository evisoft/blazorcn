@* ============================================================
   Block: chat-real-estate-agent
   Title: ChatRealEstateAgent
   Description: React real estate inquiry chat block for Next.js with agent profile header, property listing cards, price and specs display, and quick action filters using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-real-estate-agent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Agent header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="relative">
                <AvatarCn Size="AvatarSize.Sm">
                    <AvatarFallbackCn Class="bg-muted text-xs">@_agent.Initials</AvatarFallbackCn>
                </AvatarCn>
                <span class="@($"absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full ring-2 ring-card {(_agent.Status == "online" ? "bg-emerald-500" : "bg-muted-foreground/40")}")" />
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_agent.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_agent.Title
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Westside Heights specialist</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "buyer" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "buyer"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">

                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }

                            @* Property card *@
                            @if (msg.Property != null)
                            {
                                var prop = msg.Property;
                                var statusStyle = prop.Status == "active"
                                    ? "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
                                    : prop.Status == "pending"
                                        ? "bg-amber-500/10 text-amber-700 dark:text-amber-400"
                                        : "bg-red-500/10 text-red-700 dark:text-red-400";
                                <div class="mt-2 overflow-hidden rounded-md border bg-card">
                                    @* Image placeholder *@
                                    <div class="flex h-32 items-center justify-center bg-muted/50">
                                        <LucideIconCn Name="home" Size="32" Class="size-8 text-muted-foreground/30" />
                                    </div>
                                    <div class="p-3">
                                        <div class="mb-1 flex items-center justify-between">
                                            <span class="font-semibold text-lg tabular-nums">@prop.Price</span>
                                            <span class="@($"rounded-full px-2 py-0.5 text-xs capitalize {statusStyle}")">
                                                @prop.Status
                                            </span>
                                        </div>
                                        <p class="font-medium text-sm">@prop.Address</p>
                                        <p class="text-muted-foreground text-xs">@prop.City</p>
                                        <div class="mt-2.5 flex items-center gap-3 border-t pt-2.5">
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="bed-double" Size="14" Class="size-3.5" />
                                                @prop.Beds bed
                                            </span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="bath" Size="14" Class="size-3.5" />
                                                @prop.Baths bath
                                            </span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="ruler" Size="14" Class="size-3.5" />
                                                @prop.Sqft sqft
                                            </span>
                                            <span class="ml-auto text-muted-foreground text-xs">@prop.Type</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Quick actions *@
                            @if (msg.ShowActions)
                            {
                                <div class="mt-2.5 flex flex-wrap gap-1.5">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 bg-card text-xs">
                                        <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                                        Similar
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 bg-card text-xs">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                        Schedule viewing
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 bg-card text-xs">
                                        Make offer
                                    </ButtonCn>
                                </div>
                            }

                            <span class="@(msg.Role == "buyer"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Ask about properties..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record AgentInfo(string Name, string Title, string Initials, string Status);

    private record Property(
        string Address,
        string City,
        string Price,
        int Beds,
        double Baths,
        string Sqft,
        string Type,
        string Status);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        Property? Property = null,
        bool ShowActions = false);

    private readonly AgentInfo _agent = new("Rachel Torres", "Licensed Agent", "RT", "online");

    private readonly Message[] _messages =
    [
        new("1", "agent",
            "Hi! I'm Rachel, your agent for the Westside district. I saw you were interested in 3-bedroom homes under $750K. I've pulled a few listings that match your criteria.",
            "11:00 AM"),
        new("2", "buyer",
            "Thanks Rachel. We're looking for something with a good school district and at least 2 bathrooms. Preferably move-in ready.",
            "11:02 AM"),
        new("3", "agent",
            "Perfect, here's the top pick in your range. It's in the Lincoln Elementary zone and was recently renovated:",
            "11:03 AM"),
        new("4", "agent", "", "11:03 AM",
            new Property("2847 Maple Grove Lane", "Westside Heights, CA 94102", "$725,000", 3, 2, "1,840", "Single Family", "active"),
            true),
        new("5", "buyer",
            "That looks promising. What year was it built? And how's the natural light situation?",
            "11:05 AM"),
        new("6", "agent",
            "Built in 2008 with a full kitchen and bathroom remodel in 2023. South-facing living room with floor-to-ceiling windows. The primary bedroom gets morning light. It has a 92 Walk Score too.",
            "11:06 AM"),
        new("7", "agent",
            "Here's another option just listed yesterday, slightly under budget:",
            "11:07 AM"),
        new("8", "agent", "", "11:07 AM",
            new Property("519 Cedar Park Drive", "Westside Heights, CA 94103", "$689,000", 3, 2.5, "1,720", "Townhouse", "active"),
            true),
        new("9", "buyer",
            "Both are great options. Can we schedule viewings for this weekend?",
            "11:09 AM"),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
