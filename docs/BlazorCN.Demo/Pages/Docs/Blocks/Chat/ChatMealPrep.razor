@* ============================================================
   Block: chat-meal-prep
   Title: ChatMealPrep
   Description: A meal prep planning chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring recipe cards, ingredient lists, and detailed nutritional information
   Source: original/blocks/chat/chat-meal-prep.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="chef-hat" Size="16" Class="size-4 text-emerald-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Meal Prep Assistant</h3>
                <p class="text-xs text-muted-foreground">2,500 cal/day • High Protein</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="shopping-cart" Size="12" Class="size-3" />
                View List
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                var msg = message;
                <div class="@Cn.Merge("mb-4 flex gap-3", msg.Sender == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(msg.Sender == "ai" ? "bg-emerald-500/10 text-emerald-600" : "bg-muted")">
                            @(msg.Sender == "ai" ? "AI" : "ME")
                        </AvatarFallbackCn>
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", msg.Sender == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2", msg.Sender == "ai" ? "bg-muted" : "bg-emerald-500/10 text-emerald-900 dark:text-emerald-100")">
                            <p class="text-sm">@msg.Content</p>
                        </div>

                        @* Recipe Card *@
                        @if (msg.Recipe != null)
                        {
                            var recipe = msg.Recipe;
                            <div class="mt-2 w-full max-w-sm overflow-hidden rounded-lg border bg-card">
                                <div class="border-b bg-muted/50 px-3 py-2">
                                    <h4 class="font-medium text-sm">@recipe.Name</h4>
                                    <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            @recipe.CookTime
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                                            @recipe.Servings servings
                                        </span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-4 gap-2 border-b px-3 py-2">
                                    <div class="space-y-0.5">
                                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                            <LucideIconCn Name="flame" Size="12" Class="size-3 text-orange-500" />
                                            Cal
                                        </div>
                                        <p class="font-semibold text-sm">@recipe.Calories</p>
                                    </div>
                                    <div class="space-y-0.5">
                                        <p class="text-xs text-muted-foreground">Protein</p>
                                        <p class="font-semibold text-sm">@(recipe.Protein)g</p>
                                    </div>
                                    <div class="space-y-0.5">
                                        <p class="text-xs text-muted-foreground">Carbs</p>
                                        <p class="font-semibold text-sm">@(recipe.Carbs)g</p>
                                    </div>
                                    <div class="space-y-0.5">
                                        <p class="text-xs text-muted-foreground">Fat</p>
                                        <p class="font-semibold text-sm">@(recipe.Fat)g</p>
                                    </div>
                                </div>

                                <div class="px-3 py-2">
                                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                                        Ingredients:
                                    </p>
                                    <ul class="space-y-1">
                                        @foreach (var ingredient in recipe.Ingredients)
                                        {
                                            <li class="flex items-start gap-2 text-xs">
                                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                                <span>@ingredient</span>
                                            </li>
                                        }
                                    </ul>
                                    <div class="mt-3 flex gap-2">
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1 text-xs">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            Schedule
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1 text-xs">
                                            <LucideIconCn Name="apple" Size="12" Class="size-3" />
                                            Add to List
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Ask for recipes, nutrition advice..."
                    Class="flex-1"
                    @onkeydown="@HandleKeyDown" aria-label="Ask for recipes, nutrition advice..." />
                <ButtonCn aria-label="Send message" Size="ButtonSize.Sm" Class="shrink-0" OnClick="@HandleSend">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                Try: "Show vegetarian options" or "What's for dinner?"
            </p>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Recipe(
        string Name,
        string CookTime,
        int Servings,
        int Calories,
        int Protein,
        int Carbs,
        int Fat,
        string[] Ingredients);

    private record Message(string Id, string Sender, string Content, string Timestamp, Recipe? Recipe = null);

    private List<Message> _messages =
    [
        new("1", "ai",
            "Hi! I'm your meal prep assistant. What are your goals for this week? Weight loss, muscle gain, or balanced nutrition?",
            "9:00 AM"),
        new("2", "user",
            "I want high-protein meals for muscle gain, around 2500 calories/day",
            "9:01 AM"),
        new("3", "ai",
            "Perfect! I'll suggest high-protein recipes. Here's a great chicken meal prep option for your week:",
            "9:01 AM",
            new Recipe(
                "Honey Garlic Chicken with Broccoli",
                "25 min",
                4,
                420,
                45,
                28,
                12,
                [
                    "1.5 lbs chicken breast",
                    "3 cups broccoli florets",
                    "3 tbsp honey",
                    "4 cloves garlic, minced",
                    "2 tbsp soy sauce",
                    "1 tbsp olive oil",
                ])),
        new("4", "user",
            "This looks great! Can you add more vegetarian options too?",
            "9:03 AM"),
        new("5", "ai",
            "Absolutely! Here's a high-protein vegetarian meal that fits your macros:",
            "9:03 AM",
            new Recipe(
                "Quinoa Buddha Bowl with Chickpeas",
                "30 min",
                4,
                385,
                18,
                52,
                14,
                [
                    "1 cup quinoa",
                    "1 can chickpeas",
                    "2 cups kale",
                    "1 avocado",
                    "2 tbsp tahini",
                    "1 lemon",
                ])),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new Message(
            Id: DateTime.UtcNow.Ticks.ToString(),
            Sender: "user",
            Content: _input,
            Timestamp: "Just now"
        );

        _messages = [.._messages, newMessage];
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSend();
    }
}
