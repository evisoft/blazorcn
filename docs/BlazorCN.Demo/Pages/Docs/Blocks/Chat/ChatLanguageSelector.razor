    private void ToggleOriginal(string msgId)
    {
        if (_showOriginal.ContainsKey(msgId))
            _showOriginal[msgId] = !_showOriginal[msgId];
        else
            _showOriginal[msgId] = true;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
