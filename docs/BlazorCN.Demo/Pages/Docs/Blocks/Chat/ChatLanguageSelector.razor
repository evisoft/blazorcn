@* ============================================================
   Block: chat-language-selector
   Title: ChatLanguageSelector
   Description: A language selector chat block for React and Next.js with multi-language support, locale switching, auto-translation indicators, and RTL-aware layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-language-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Global Engineering</span>
            </div>
            <SelectCn @bind-Value="_language">
                <SelectTriggerCn aria-label="Language" Class="h-7 w-[120px] text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var lang in _languages)
                    {
                        var l = lang;
                        <SelectItemCn Value="@l.Value" Class="text-xs">@l.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-3">
                @foreach (var msg in _messages)
                {
                    var m = msg;
                    <div class="flex gap-3">
                        <AvatarCn Class="mt-0.5 size-7 shrink-0">
                            <AvatarFallbackCn Class="@Cn.Merge("text-[10px]", m.Color)">
                                @m.Initials
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@m.Sender</span>
                                <span class="text-muted-foreground text-[10px]">@m.Timestamp</span>
                                @if (m.IsTranslated)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-[10px]">
                                        <LucideIconCn Name="languages" Size="10" Class="size-2.5" />
                                        @m.OriginalLang
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-sm leading-relaxed">
                                @(_showOriginal.ContainsKey(m.Id) && _showOriginal[m.Id] && m.OriginalContent != null
                                    ? m.OriginalContent
                                    : m.Content)
                            </p>
                            @if (m.IsTranslated)
                            {
                                <button type="button"
                                        @onclick="@(() => ToggleOriginal(m.Id))"
                                        class="mt-1 text-blue-600 text-xs transition-colors hover:underline dark:text-blue-400">
                                    @(_showOriginal.ContainsKey(m.Id) && _showOriginal[m.Id] ? "Show translation" : "Show original")
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                <InputCn @bind-Value="_input"
                         Placeholder="Type a message..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Language(string Value, string Label);

    private record ChatMessage(
        string Id,
        string Sender,
        string Initials,
        string Color,
        string Content,
        string? OriginalContent,
        string? OriginalLang,
        string Timestamp,
        bool IsTranslated);

    private string _input = "";
    private string _language = "en";
    private Dictionary<string, bool> _showOriginal = new();

    private static readonly Language[] _languages =
    [
        new("en", "English"),
        new("es", "Espanol"),
        new("fr", "Francais"),
        new("de", "Deutsch"),
        new("ja", "Japanese"),
        new("pt", "Portugues"),
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "Hiroshi Tanaka", "HT",
            "bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300",
            "The new authentication flow is working well in our staging environment.",
            "Shin'ninshouflow wa staging kankyo de umaku itteimasU.",
            "ja", "9:15 AM", true),
        new("m2", "Maria Garcia", "MG",
            "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300",
            "Great news! I found a minor issue with the password reset email template.",
            "Excelentes noticias! Encontre un problema menor con la plantilla de correo de restablecimiento de contrasena.",
            "es", "9:18 AM", true),
        new("m3", "Alex Chen", "AC",
            "bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300",
            "Can you share the error details? I'll patch it before the release.",
            null, null, "9:20 AM", false),
        new("m4", "Maria Garcia", "MG",
            "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300",
            "The reset link uses HTTP instead of HTTPS in the email body. The actual endpoint is correct, only the template string is wrong.",
            "El enlace de restablecimiento usa HTTP en lugar de HTTPS en el cuerpo del correo. El endpoint real es correcto, solo la cadena de la plantilla esta mal.",
            "es", "9:22 AM", true),
        new("m5", "Lucas Dupont", "LD",
