@* ============================================================
   Block: chat-conversation-list
   Title: ChatConversationList
   Description: React conversation inbox list for Next.js with avatars, message previews, unread badges, timestamps, filter tabs, pin indicators, search bar, hover actions, and active row highlight using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-conversation-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Messages</span>
                <span class="text-muted-foreground text-xs">
                    @(_conversations.Count(c => c.UnreadCount > 0)) unread
                </span>
            </div>
        </div>

        @* Filter tabs *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var tab in _tabs)
            {
                var t = tab;
                <button
                    type="button"
                    @onclick="@(() => _activeTab = t.Key)"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _activeTab == t.Key ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @t.Label
                </button>
            }
        </div>

        @* Search *@
        <div class="border-b px-4 py-2">
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn @bind-Value="_search" Placeholder="Search conversations..." Class="h-8 border-0 bg-muted/50 pl-8 text-sm shadow-none focus-visible:ring-0" />
            </div>
        </div>

        @* Conversation list *@
        <div class="flex-1 overflow-y-auto">
            @if (!_filtered.Any())
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No conversations found
                </div>
            }
            @{
                var filteredList = _filtered.ToArray();
            }
            @foreach (var conv in filteredList)
            {
                var item = conv;
                var idx = Array.IndexOf(filteredList, item);
                <button
                    type="button"
                    @onclick="@(() => _activeId = item.Id)"
                    class="@Cn.Merge("group flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", _activeId == item.Id ? "bg-accent" : "", idx < filteredList.Length - 1 ? "border-b" : "")">
                    <div class="relative shrink-0">
                        <AvatarCn>
                            <AvatarFallbackCn>
                                @if (item.IsGroup)
                                {
                                    <LucideIconCn Name="users" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    @item.Initials
                                }
                            </AvatarFallbackCn>
                        </AvatarCn>
                        @if (item.IsOnline)
                        {
                            <span class="absolute right-0 bottom-0 size-2.5 rounded-full border-2 border-card bg-emerald-500"></span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-1.5">
                                @if (item.Pinned)
                                {
                                    <LucideIconCn Name="pin" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                }
                                <span class="@Cn.Merge("truncate text-sm", item.UnreadCount > 0 ? "font-semibold" : "font-medium")">
                                    @item.Name
                                </span>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-[10px]">
                                @item.Timestamp
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <p class="@Cn.Merge("mt-0.5 truncate text-xs", item.UnreadCount > 0 ? "text-foreground" : "text-muted-foreground")">
                                @item.LastMessage
                            </p>
                            @if (item.UnreadCount > 0)
                            {
                                <BadgeCn Class="size-5 shrink-0 justify-center rounded-full px-0 text-[10px]">@item.UnreadCount</BadgeCn>
                            }
                        </div>
                    </div>

                    @* Hover actions *@
                    <div class="flex shrink-0 items-center gap-0.5 opacity-0 transition-opacity group-hover:opacity-100">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick:stopPropagation="true">
                            <LucideIconCn Name="bell-off" Size="14" Class="size-3.5" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick:stopPropagation="true">
                            <LucideIconCn Name="archive" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                </button>
            }
        </div>

    </div>
</section>

@code {
    private record Conversation(
        string Id,
        string Name,
        string Initials,
        string LastMessage,
        string Timestamp,
        int UnreadCount,
        bool IsOnline,
        bool Pinned,
        bool IsGroup
    );

    private record FilterTab(string Key, string Label);

    private static readonly Conversation[] _conversations =
    [
        new("1",  "Mara Chen",     "MC", "Chromatic should pick up the snapshots automatically once you push.",            "2 min ago",   3, true,  true,  false),
        new("2",  "Alex Rivera",   "AR", "I pushed the migration script. Can you run it against staging first?",           "15 min ago",  1, true,  true,  false),
        new("3",  "Design Team",   "DT", "Sounds good, I'll start on it after standup.",                                   "1 hr ago",    0, false, false, true),
        new("4",  "Priya Sharma",  "PS", "The A/B test results are in. Variant B outperformed by 23% on conversions.",     "2 hrs ago",   5, true,  false, false),
        new("5",  "Engineering",   "EN", "Deployed the hotfix to production. Monitoring now.",                             "3 hrs ago",   0, false, false, true),
        new("6",  "Taylor Kim",    "TK", "Can you review the updated brand guidelines before Friday?",                     "5 hrs ago",   2, false, false, false),
        new("7",  "Elena Volkov",  "EV", "The API rate limiter config looks correct. Ship it.",                            "Yesterday",   0, false, false, false),
        new("8",  "Marcus Wright", "MW", "Let me know when you want to pair on the auth refactor.",                        "Yesterday",   0, true,  false, false),
        new("9",  "Platform Team", "PT", "The onboarding flow redesign is ready for review.",                              "2 days ago",  0, false, false, true),
        new("10", "Oscar Mendez",  "OM", "Budget approved for the new monitoring tools. Proceed with setup.",              "3 days ago",  0, false, false, false),
    ];

    private static readonly FilterTab[] _tabs =
    [
        new("all",    "All"),
        new("unread", "Unread"),
        new("groups", "Groups"),
    ];

    private string _search = "";
    private string _activeId = "1";
    private string _activeTab = "all";

    private IEnumerable<Conversation> _filtered =>
        _conversations
            .Where(c =>
            {
                if (!c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) return false;
                if (_activeTab == "unread") return c.UnreadCount > 0;
                if (_activeTab == "groups") return c.IsGroup;
                return true;
            })
            .OrderByDescending(c => c.Pinned);
}
