@* ============================================================
   Block: chat-music-sharing
   Title: ChatMusicSharing
   Description: A music sharing chat block for React and Next.js with inline track cards, album art, play controls, and shared playlist building built with shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-music-sharing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">#music-recs</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-muted-foreground">
                <LucideIconCn Name="list-music" Size="12" Class="size-3" />
                Playlist (3)
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-3">
                @foreach (var msg in _messages)
                {
                    var msgId = msg.Id;
                    <div class="flex gap-3">
                        <AvatarCn Class="mt-0.5 size-7 shrink-0">
                            <AvatarFallbackCn Class="@Cn.Merge("text-[10px]", msg.SenderColor)">@msg.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                            </div>

                            @if (msg.Type == "text")
                            {
                                <p class="mt-0.5 text-sm leading-relaxed">@msg.Content</p>
                            }

                            @if (msg.Type == "track" && msg.Track != null)
                            {
                                var track = msg.Track;
                                <div class="mt-1.5 flex items-center gap-3 rounded-md border bg-muted/30 p-2.5">
                                    @* Album art placeholder *@
                                    <div class="@Cn.Merge("flex size-12 shrink-0 items-center justify-center rounded-md", track.Color)">
                                        <LucideIconCn Name="music" Size="20" Class="size-5 text-white/80" />
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <p class="truncate font-medium text-sm">@track.Title</p>
                                        <p class="truncate text-muted-foreground text-xs">@track.Artist · @track.Album</p>
                                        @* Mini progress bar *@
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                                @if (_playing == msgId)
                                                {
                                                    <div class="h-full w-[65%] rounded-full bg-foreground"></div>
                                                }
                                            </div>
                                            <span class="font-mono text-muted-foreground text-[10px]">@track.Duration</span>
                                        </div>
                                    </div>

                                    @* Play/pause button *@
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0" OnClick="@(() => TogglePlaying(msgId))">
                                        @if (_playing == msgId)
                                        {
                                            <LucideIconCn Name="pause" Size="16" Class="size-4" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="play" Size="16" Class="size-4" />
                                        }
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <InputCn @bind-Value="_input"
                         Placeholder="Share a song or message..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground"
                          OnClick="HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TrackData(string Title, string Artist, string Album, string Duration, string Color);
    private record ChatMessage(string Id, string Sender, string Initials, string SenderColor, string Timestamp, string Type, string? Content, TrackData? Track);

    private string _input = "";
    private string? _playing = null;

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "Jules Martin", "JM", "bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300", "8:30 PM", "text",
            "Working late tonight. Anyone have good focus music recommendations?", null),
        new("m2", "Noor Ali", "NA", "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300", "8:32 PM", "track",
            null, new("Midnight City", "M83", "Hurry Up, We're Dreaming", "4:03", "bg-indigo-500")),
        new("m3", "Noor Ali", "NA", "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300", "8:32 PM", "text",
            "This one always gets me in the zone. The synth buildup is incredible.", null),
        new("m4", "Tao Chen", "TC", "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300", "8:35 PM", "track",
            null, new("Intro", "The xx", "xx", "2:07", "bg-zinc-700")),
        new("m5", "Tao Chen", "TC", "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300", "8:35 PM", "text",
            "Minimal and calm. No lyrics to distract you.", null),
        new("m6", "Jules Martin", "JM", "bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300", "8:38 PM", "track",
            null, new("Dissolve", "Absofacto", "Thousand Peices", "3:26", "bg-rose-500")),
        new("m7", "Jules Martin", "JM", "bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300", "8:38 PM", "text",
            "Adding all of these to our shared playlist. Keep them coming!", null),
    ];

    private void TogglePlaying(string id)
    {
        _playing = _playing == id ? null : id;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
