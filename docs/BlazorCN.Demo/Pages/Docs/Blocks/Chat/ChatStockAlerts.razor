@* ============================================================
   Block: chat-stock-alerts
   Title: ChatStockAlerts
   Description: React stock price alert notification chat block for Next.js with real-time price cards, alert threshold triggers, portfolio summary, percentage change indicators, and watchlist management using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-stock-alerts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Stock Alerts</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Market
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">
                    Price alerts, portfolio, and watchlist
                </span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">Market open</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex", msg.Role == "user" ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[85%]", msg.Role == "user" ? "rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Alerts != null)
                            {
                                <div class="mt-2 space-y-2">
                                    @foreach (var alert in msg.Alerts)
                                    {
                                        <div class="rounded-md border bg-card p-3">
                                            <div class="mb-2 flex items-center justify-between">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-semibold text-sm">@alert.Ticker</span>
                                                    <span class="text-muted-foreground text-xs">@alert.Company</span>
                                                </div>
                                                <div class="flex items-center gap-1">
                                                    <LucideIconCn Name="bell-ring" Size="12" Class="size-3 text-amber-500" />
                                                    <span class="text-muted-foreground text-xs">Alert triggered</span>
                                                </div>
                                            </div>
                                            <div class="mb-2.5 flex items-center gap-3">
                                                <span class="font-semibold text-2xl tabular-nums">@alert.Price</span>
                                                <div class="@Cn.Merge("flex items-center gap-1", alert.Direction == "up" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                                    @if (alert.Direction == "up")
                                                    {
                                                        <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                                                    }
                                                    else
                                                    {
                                                        <LucideIconCn Name="arrow-down" Size="14" Class="size-3.5" />
                                                    }
                                                    <span class="font-medium text-sm tabular-nums">@alert.Change</span>
                                                    <span class="text-xs tabular-nums">(@alert.ChangePercent)</span>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                                                @if (alert.AlertDirection == "above")
                                                {
                                                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-500" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="trending-down" Size="14" Class="size-3.5 text-red-500" />
                                                }
                                                <span class="text-xs">
                                                    Price crossed @alert.AlertDirection
                                                    <span class="font-mono font-medium tabular-nums"> @alert.Threshold</span>
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (msg.Portfolio != null)
                            {
                                var portfolio = msg.Portfolio;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center justify-between">
                                        <span class="font-medium text-sm">Portfolio</span>
                                        <span class="text-muted-foreground text-xs">Today</span>
                                    </div>
                                    <div class="mb-3 flex items-center gap-3">
                                        <span class="font-semibold text-2xl tabular-nums">@portfolio.TotalValue</span>
                                        <div class="@Cn.Merge("flex items-center gap-1", portfolio.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                            @if (portfolio.IsPositive)
                                            {
                                                <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="arrow-down" Size="14" Class="size-3.5" />
                                            }
                                            <span class="font-medium text-sm tabular-nums">@portfolio.DayChange</span>
                                            <span class="text-xs tabular-nums">(@portfolio.DayChangePercent)</span>
                                        </div>
                                    </div>
                                    <div class="space-y-0">
                                        <div class="flex items-center gap-2 pb-1.5">
                                            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Position</span>
                                            <span class="w-20 text-right text-muted-foreground text-xs">Value</span>
                                            <span class="w-20 text-right text-muted-foreground text-xs">Day change</span>
                                        </div>
                                        @foreach (var pos in portfolio.Positions)
                                        {
                                            <div class="flex items-center gap-2 border-t py-1.5">
                                                <div class="min-w-0 flex-1">
                                                    <span class="font-medium text-sm">@pos.Ticker</span>
                                                    <p class="text-muted-foreground text-xs">@pos.Shares</p>
                                                </div>
                                                <span class="w-20 text-right font-mono text-sm tabular-nums">@pos.Value</span>
                                                <span class="@Cn.Merge("w-20 text-right font-mono text-sm tabular-nums", pos.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                                    @pos.Change
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (msg.Watchlist != null)
                            {
                                <div class="mt-2 rounded-md border bg-card">
                                    <div class="border-b px-3 py-2.5">
                                        <span class="font-medium text-sm">Watchlist</span>
                                    </div>
                                    @{
                                        int watchlistCount = msg.Watchlist.Length;
                                        int watchlistIdx = 0;
                                    }
                                    @foreach (var stock in msg.Watchlist)
                                    {
                                        var isLast = watchlistIdx == watchlistCount - 1;
                                        watchlistIdx++;
                                        <div class="@Cn.Merge("flex items-center gap-3 px-3 py-2.5", isLast ? "" : "border-b")">
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-1.5">
                                                    <span class="font-medium text-sm">@stock.Ticker</span>
                                                    <span class="text-muted-foreground text-xs">@stock.Company</span>
                                                </div>
                                            </div>
                                            <span class="font-mono text-sm tabular-nums">@stock.Price</span>
                                            <div class="@Cn.Merge("flex w-20 items-center justify-end gap-1", stock.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                                @if (stock.IsPositive)
                                                {
                                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                                }
                                                <span class="font-mono text-xs tabular-nums">@stock.ChangePercent</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            <span class="@Cn.Merge("mt-1 block text-right text-xs", msg.Role == "user" ? "text-primary-foreground/60" : "text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="relative" @onsubmit="HandleSubmit">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Ask about stocks or set a price alert..."
                            Rows="1"
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Ask about stocks or set a price alert..." />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private string _input = "";

    private record StockAlertData(
        string Ticker,
        string Company,
        string Price,
        string Change,
        string ChangePercent,
        string Direction,
        string Threshold,
        string AlertDirection
    );

    private record PortfolioPosition(
        string Ticker,
        string Value,
        string Shares,
        string Change,
        bool IsPositive
    );

    private record PortfolioSummaryData(
        string TotalValue,
        string DayChange,
        string DayChangePercent,
        bool IsPositive,
        PortfolioPosition[] Positions
    );

    private record WatchlistItemData(
        string Ticker,
        string Company,
        string Price,
        string Change,
        string ChangePercent,
        bool IsPositive
    );

    private record ChatMessage(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        StockAlertData[]? Alerts = null,
        PortfolioSummaryData? Portfolio = null,
        WatchlistItemData[]? Watchlist = null
    );

    private static readonly ChatMessage[] _messages =
    [
        new("1", "assistant",
            "Good morning. Markets are open. You have 2 price alerts that triggered in pre-market trading:",
            "9:31 AM"),
        new("2", "assistant", "", "9:31 AM",
            Alerts:
            [
                new("NVDA", "NVIDIA Corporation", "$892.40", "+$24.60", "+2.84%", "up", "$880.00", "above"),
                new("TSLA", "Tesla, Inc.", "$168.30", "-$7.20", "-4.10%", "down", "$170.00", "below"),
            ]),
        new("3", "user",
            "Thanks for the heads up. NVIDIA is running. What does my overall portfolio look like this morning?",
            "9:33 AM"),
        new("4", "assistant", "Here's your portfolio summary as of market open:", "9:34 AM"),
        new("5", "assistant", "", "9:34 AM",
            Portfolio: new(
                "$47,284.50", "+$812.30", "+1.75%", true,
                [
                    new("NVDA", "$17,848.00", "20 shares", "+$492.00", true),
                    new("AAPL", "$12,420.00", "60 shares", "+$186.00", true),
                    new("TSLA", "$8,415.00", "50 shares", "-$360.00", false),
                    new("MSFT", "$8,601.50", "22 shares", "+$494.30", true),
                ]
            )),
        new("6", "user",
            "TSLA is dragging things down. Can you show me my full watchlist? I want to see what else is moving.",
            "9:36 AM"),
        new("7", "assistant", "Here's your watchlist with current prices:", "9:37 AM"),
        new("8", "assistant", "", "9:37 AM",
            Watchlist:
            [
                new("NVDA", "NVIDIA", "$892.40", "+$24.60", "+2.84%", true),
                new("AAPL", "Apple", "$207.00", "+$3.10", "+1.52%", true),
                new("MSFT", "Microsoft", "$390.98", "+$22.47", "+6.10%", true),
                new("TSLA", "Tesla", "$168.30", "-$7.20", "-4.10%", false),
                new("META", "Meta Platforms", "$512.80", "+$8.40", "+1.66%", true),
                new("AMZN", "Amazon", "$186.42", "-$1.18", "-0.63%", false),
            ]),
        new("9", "assistant",
            "Microsoft is your biggest mover today at +6.10%, driven by their cloud earnings beat. NVIDIA continues its momentum. Tesla is under pressure after delivery numbers missed estimates. Want me to set any new price alerts?",
            "9:38 AM"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
