@* ============================================================
   Block: chat-tech-support
   Title: ChatTechSupport
   Description: A technical support chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring diagnostic cards, solution steps, and escalation options
   Source: original/blocks/chat/chat-tech-support.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="headphones" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium">Technical Support</h3>
                    <p class="text-xs text-muted-foreground">24/7 automated assistance</p>
                </div>
                <div class="ml-auto">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="bg-emerald-500/10 text-emerald-600">
                        <span class="mr-1.5 size-1.5 rounded-full bg-emerald-500"></span>
                        Online
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4">
            <div class="space-y-4 py-4">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    if (message.Type == "system")
                    {
                        <div class="flex justify-center">
                            <div class="max-w-sm rounded-lg border bg-muted/50 px-3 py-2 text-center text-xs text-muted-foreground">
                                @message.Content
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "flex-row-reverse" : "")">
                            <AvatarCn Class="size-8 shrink-0">
                                @if (message.Type == "assistant")
                                {
                                    <AvatarFallbackCn Class="bg-primary/10">
                                        <LucideIconCn Name="bot" Size="16" Class="size-4 text-primary" />
                                    </AvatarFallbackCn>
                                }
                                else
                                {
                                    <AvatarImageCn Src="https://avatar.vercel.sh/user" />
                                    <AvatarFallbackCn>
                                        <LucideIconCn Name="user" Size="16" Class="size-4" />
                                    </AvatarFallbackCn>
                                }
                            </AvatarCn>

                            <div class="@Cn.Merge("flex-1 space-y-2", message.Type == "user" ? "flex flex-col items-end" : "")">
                                <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                    @message.Content
                                </div>

                                @if (message.Diagnostic != null)
                                {
                                    var diag = message.Diagnostic;
                                    <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                        <div class="flex items-start justify-between">
                                            <div class="space-y-1">
                                                <p class="text-sm font-medium">Diagnostic Report</p>
                                                <p class="text-xs text-muted-foreground">@diag.Issue</p>
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("capitalize", GetSeverityColor(diag.Severity))">
                                                @diag.Severity
                                            </BadgeCn>
                                        </div>

                                        <div class="rounded-md bg-muted/50 px-3 py-2 text-xs">
                                            <span class="text-muted-foreground">Detected Platform: </span>
                                            <span class="font-medium">@diag.DetectedPlatform</span>
                                        </div>

                                        <div class="space-y-2 border-t pt-3">
                                            <p class="text-xs font-medium">Possible Causes</p>
                                            @foreach (var cause in diag.PossibleCauses)
                                            {
                                                <div class="flex gap-2 text-xs text-muted-foreground">
                                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                                    <span>@cause</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (message.SolutionSteps != null)
                                {
                                    var sol = message.SolutionSteps;
                                    <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                        <div class="flex items-start justify-between">
                                            <div class="space-y-1">
                                                <p class="text-sm font-medium">@sol.Title</p>
                                                <p class="text-xs text-muted-foreground">Est. time: @sol.EstimatedTime</p>
                                            </div>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                                Retry
                                            </ButtonCn>
                                        </div>

                                        <div class="space-y-2 border-t pt-3">
                                            @for (var i = 0; i < sol.Steps.Length; i++)
                                            {
                                                var idx = i;
                                                var step = sol.Steps[idx];
                                                <div class="flex items-start gap-3">
                                                    <div class="flex size-5 shrink-0 items-center justify-center rounded-full border bg-background">
                                                        @if (step.Completed)
                                                        {
                                                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600" />
                                                        }
                                                        else
                                                        {
                                                            <span class="text-xs font-medium text-muted-foreground">@(idx + 1)</span>
                                                        }
                                                    </div>
                                                    <div class="flex-1 space-y-0.5">
                                                        <div class="flex items-center gap-2">
                                                            <p class="@Cn.Merge("text-sm", step.Completed ? "line-through text-muted-foreground" : "")">
                                                                @step.Instruction
                                                            </p>
                                                            @if (step.Optional)
                                                            {
                                                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">Optional</BadgeCn>
                                                            }
                                                        </div>
                                                    </div>
                                                    @if (!step.Completed)
                                                    {
                                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">Mark Done</ButtonCn>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (message.EscalationOption != null)
                                {
                                    var esc = message.EscalationOption;
                                    <div class="w-full space-y-3 rounded-lg border border-amber-500/20 bg-amber-500/5 p-3">
                                        <div class="flex items-start gap-3">
                                            <LucideIconCn Name="alert-circle" Size="20" Class="mt-0.5 size-5 shrink-0 text-amber-600" />
                                            <div class="flex-1 space-y-2">
                                                <div>
                                                    <p class="text-sm font-medium">Escalated to Human Agent</p>
                                                    <p class="text-xs text-muted-foreground">@esc.Reason</p>
                                                </div>
                                                @if (esc.TicketId != null)
                                                {
                                                    <div class="flex items-center gap-2 text-xs">
                                                        <span class="text-muted-foreground">Ticket ID:</span>
                                                        <code class="rounded bg-background px-1.5 py-0.5 font-mono">@esc.TicketId</code>
                                                    </div>
                                                }
                                                @if (esc.EstimatedWait != null)
                                                {
                                                    <div class="flex items-center gap-2 text-xs">
                                                        <span class="text-muted-foreground">Estimated wait:</span>
                                                        <span class="font-medium">@esc.EstimatedWait</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="flex gap-2">
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs">
                                                <LucideIconCn Name="external-link" Size="12" Class="mr-1.5 size-3" />
                                                View Ticket
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs">
                                                Cancel Request
                                            </ButtonCn>
                                        </div>
                                    </div>
                                }

                                <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form @onsubmit="HandleSend" @onsubmit:preventDefault="true" class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Describe your issue or provide an update..."
                         Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" OnClick="HandleSend">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record DiagnosticInfo(
        string Issue,
        string Severity,
        string DetectedPlatform,
        string[] PossibleCauses);

    private record SolutionStep(string Instruction, bool Completed, bool Optional);

    private record SolutionStepsInfo(string Title, SolutionStep[] Steps, string EstimatedTime);

    private record EscalationOptionInfo(string Reason, string? TicketId, string? EstimatedWait);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        DiagnosticInfo? Diagnostic = null,
        SolutionStepsInfo? SolutionSteps = null,
        EscalationOptionInfo? EscalationOption = null);

    private List<Message> _messages = new(InitialMessages);

    private static readonly Message[] InitialMessages =
    [
        new("1", "assistant",
            "Hi! I'm your technical support assistant. I can help you troubleshoot issues and find solutions. What problem are you experiencing?",
            "11:00 AM"),
        new("2", "user",
            "My app keeps crashing when I try to upload images",
            "11:01 AM"),
        new("3", "assistant",
            "I've analyzed your issue. Here's what I found:",
            "11:01 AM",
            Diagnostic: new DiagnosticInfo(
                "App crash during image upload",
                "high",
                "iOS 17.4",
                [
                    "Image file size exceeds the 10MB limit",
                    "Insufficient storage space on device",
                    "Outdated app version (current: 2.3.1, latest: 2.4.0)",
                    "Network connectivity issues during upload",
                ])),
        new("4", "assistant",
            "Let's try these troubleshooting steps:",
            "11:02 AM",
            SolutionSteps: new SolutionStepsInfo(
                "Fix App Crashes on Image Upload",
                [
                    new("Update the app to version 2.4.0 from the App Store", false, false),
                    new("Check available storage: Settings > General > iPhone Storage", false, false),
                    new("Clear app cache: App Settings > Storage > Clear Cache", false, false),
                    new("Restart your device", false, true),
                    new("Try uploading a smaller image (under 5MB)", false, false),
                ],
                "5-10 minutes")),
        new("5", "user",
            "I updated the app and cleared the cache, but it's still crashing",
            "11:10 AM"),
        new("6", "system",
            "This issue requires additional assistance. Your case has been escalated to a senior support specialist.",
            "11:10 AM",
            EscalationOption: new EscalationOptionInfo(
                "Multiple failed troubleshooting attempts",
                "TKT-28475",
                "2-3 minutes")),
    ];

    private static string GetSeverityColor(string severity) => severity switch
    {
        "critical" => "bg-red-500/10 text-red-600",
        "high"     => "bg-orange-500/10 text-orange-600",
        "medium"   => "bg-amber-500/10 text-amber-600",
        "low"      => "bg-blue-500/10 text-blue-600",
        _          => "bg-muted text-muted-foreground",
    };

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new Message(
            System.DateTime.UtcNow.Ticks.ToString(),
            "user",
            _input,
            "Just now"));
        _input = "";
    }
}
