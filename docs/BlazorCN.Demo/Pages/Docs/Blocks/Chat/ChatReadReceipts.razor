@* ============================================================
   Block: chat-read-receipts
   Title: ChatReadReceipts
   Description: React group chat block with per-reader read receipts for Next.js showing tiny avatar rows with seen-by counts and expandable reader details using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-read-receipts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex -space-x-1.5">
                @foreach (var m in _groupMembers.Take(3))
                {
                    var gm = m;
                    <AvatarCn Class="size-6 ring-2 ring-card">
                        <AvatarFallbackCn Class="text-[8px]">@gm.Initials</AvatarFallbackCn>
                    </AvatarCn>
                }
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Engineering</span>
                <p class="text-muted-foreground text-xs">@(_groupMembers.Length + 1) members</p>
            </div>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_groupMembers.Length online
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var grp in _grouped)
            {
                var group = grp;
                var isMe = group.Sender == "You";
                <div class="px-2">
                    @* Primary message *@
                    <div class="flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent">
                        <AvatarCn Class="mt-0.5 size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@group.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@group.Sender</span>
                                <span class="text-muted-foreground text-xs">@group.Msgs[0].Time</span>
                            </div>
                            <p class="text-sm leading-relaxed">@group.Msgs[0].Content</p>
                            @if (isMe && group.Msgs[0].Readers != null)
                            {
                                var firstMsg = group.Msgs[0];
                                var firstExpanded = _expandedMessages.Contains(firstMsg.Id);
                                @if (firstMsg.Readers!.Length == 0)
                                {
                                    <span class="mt-1 text-muted-foreground/50 text-[10px]">Sent</span>
                                }
                                else
                                {
                                    <div class="mt-1">
                                        <button type="button" @onclick="@(() => ToggleExpanded(firstMsg.Id))"
                                            class="flex items-center gap-1.5 transition-colors hover:text-foreground">
                                            <div class="flex -space-x-1">
                                                @foreach (var r in firstMsg.Readers!.Take(4))
                                                {
                                                    var reader = r;
                                                    <AvatarCn Class="size-4 ring-1 ring-card">
                                                        <AvatarFallbackCn Class="text-[6px]">@reader.Initials</AvatarFallbackCn>
                                                    </AvatarCn>
                                                }
                                            </div>
                                            <span class="text-muted-foreground text-[10px]">
                                                Seen by @firstMsg.Readers!.Length
                                                @if (_groupMembers.Length > firstMsg.Readers!.Length)
                                                {
                                                    @(" of " + _groupMembers.Length)
                                                }
                                            </span>
                                            <LucideIconCn Name="chevron-down" Size="12" Class="@Cn.Merge("size-3 text-muted-foreground/60 transition-transform duration-200", firstExpanded ? "rotate-180" : "")" />
                                        </button>
                                        @if (firstExpanded)
                                        {
                                            <div class="mt-1.5 space-y-1 rounded-md bg-muted/50 p-2">
                                                @foreach (var r in firstMsg.Readers!)
                                                {
                                                    var reader = r;
                                                    <div class="flex items-center gap-2 text-xs">
                                                        <AvatarCn Class="size-4">
                                                            <AvatarFallbackCn Class="text-[6px]">@reader.Initials</AvatarFallbackCn>
                                                        </AvatarCn>
                                                        <span class="flex-1 text-sm">@reader.Name</span>
                                                        <span class="text-muted-foreground text-[10px]">@reader.Time</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    @* Additional messages in group *@
                    @foreach (var additionalMsg in group.Msgs.Skip(1))
                    {
                        var msg = additionalMsg;
                        var msgExpanded = _expandedMessages.Contains(msg.Id);
                        <div class="group flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent">
                            <div class="flex w-8 shrink-0 items-start justify-center">
                                <span class="hidden pt-1 text-muted-foreground text-[10px] group-hover:block">@msg.Time</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                                @if (isMe && msg.Readers != null)
                                {
                                    @if (msg.Readers!.Length == 0)
                                    {
                                        <span class="mt-1 text-muted-foreground/50 text-[10px]">Sent</span>
                                    }
                                    else
                                    {
                                        <div class="mt-1">
                                            <button type="button" @onclick="@(() => ToggleExpanded(msg.Id))"
                                                class="flex items-center gap-1.5 transition-colors hover:text-foreground">
                                                <div class="flex -space-x-1">
                                                    @foreach (var r in msg.Readers!.Take(4))
                                                    {
                                                        var reader = r;
                                                        <AvatarCn Class="size-4 ring-1 ring-card">
                                                            <AvatarFallbackCn Class="text-[6px]">@reader.Initials</AvatarFallbackCn>
                                                        </AvatarCn>
                                                    }
                                                </div>
                                                <span class="text-muted-foreground text-[10px]">
                                                    Seen by @msg.Readers!.Length
                                                    @if (_groupMembers.Length > msg.Readers!.Length)
                                                    {
                                                        @(" of " + _groupMembers.Length)
                                                    }
                                                </span>
                                                <LucideIconCn Name="chevron-down" Size="12" Class="@Cn.Merge("size-3 text-muted-foreground/60 transition-transform duration-200", msgExpanded ? "rotate-180" : "")" />
                                            </button>
                                            @if (msgExpanded)
                                            {
                                                <div class="mt-1.5 space-y-1 rounded-md bg-muted/50 p-2">
                                                    @foreach (var r in msg.Readers!)
                                                    {
                                                        var reader = r;
                                                        <div class="flex items-center gap-2 text-xs">
                                                            <AvatarCn Class="size-4">
                                                                <AvatarFallbackCn Class="text-[6px]">@reader.Initials</AvatarFallbackCn>
                                                            </AvatarCn>
                                                            <span class="flex-1 text-sm">@reader.Name</span>
                                                            <span class="text-muted-foreground text-[10px]">@reader.Time</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2 rounded-md border bg-muted/30 px-3">
                <input
                    value="@_input"
                    @oninput="@((e) => _input = e.Value?.ToString() ?? "")"
                    @onkeydown="@HandleKeyDown"
                    placeholder="Message Engineering..."
                    class="h-9 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground/50" />
                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    OnClick="@HandleSubmit"
                    Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private HashSet<string> _expandedMessages = [];

    private record GroupMemberInfo(string Name, string Initials);
    private record ReaderInfo(string Name, string Initials, string Time);
    private record ChatMessage(string Id, string Sender, string Initials, string Content, string Time, ReaderInfo[]? Readers = null);
    private record MessageGroup(string Sender, string Initials, List<ChatMessage> Msgs);

    private static readonly GroupMemberInfo[] _groupMembers =
    [
        new("Alex Rivera", "AR"),
        new("Jordan Park", "JP"),
        new("Sam Chen", "SC"),
        new("Morgan Wu", "MW"),
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("1", "Alex Rivera", "AR", "Hey team, are we still on track for the Friday release?", "2:10 PM"),
        new("2", "You", "ME", "Yes, all the critical PRs are merged. Just running final integration tests now.", "2:12 PM",
            [
                new("Alex Rivera", "AR", "2:12 PM"),
                new("Jordan Park", "JP", "2:13 PM"),
                new("Sam Chen", "SC", "2:15 PM"),
                new("Morgan Wu", "MW", "2:18 PM"),
            ]),
        new("3", "Jordan Park", "JP", "The staging deploy failed last night. Looks like the Docker build step is timing out on the new image layer.", "2:14 PM"),
        new("4", "You", "ME", "I saw that in the alerts. The base image we switched to last week is 800MB. We should use the slim variant.", "2:15 PM",
            [
                new("Alex Rivera", "AR", "2:15 PM"),
                new("Jordan Park", "JP", "2:16 PM"),
                new("Sam Chen", "SC", "2:20 PM"),
            ]),
        new("5", "Sam Chen", "SC", "Good call. Can you push that change today? I need staging working for the QA cycle tomorrow morning.", "2:17 PM"),
        new("6", "You", "ME", "Already on it. Switching to node:20-slim and updating the multi-stage build. Should cut image size to ~200MB.", "2:18 PM",
            [
                new("Alex Rivera", "AR", "2:18 PM"),
                new("Jordan Park", "JP", "2:19 PM"),
            ]),
        new("7", "You", "ME", "I'll also add a build cache layer so subsequent builds are faster.", "2:18 PM",
            [new ReaderInfo("Alex Rivera", "AR", "2:19 PM")]),
        new("8", "Morgan Wu", "MW", "Perfect. Let me know when it's pushed and I'll trigger a test deploy.", "2:20 PM"),
        new("9", "You", "ME", "Will do. Give me about 30 minutes to test locally first.", "2:22 PM", []),
    ];

    private static readonly MessageGroup[] _grouped = BuildGroups();

    private static MessageGroup[] BuildGroups()
    {
        var groups = new List<MessageGroup>();
        foreach (var msg in _messages)
        {
            if (groups.Count > 0 && groups[^1].Sender == msg.Sender)
            {
                groups[^1].Msgs.Add(msg);
            }
            else
            {
                groups.Add(new MessageGroup(msg.Sender, msg.Initials, [msg]));
            }
        }
        return [.. groups];
    }

    private void ToggleExpanded(string msgId)
    {
        if (!_expandedMessages.Add(msgId))
            _expandedMessages.Remove(msgId);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            HandleSubmit();
        }
    }
}
