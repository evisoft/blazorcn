@* ============================================================
   Block: chat-auction-bidding
   Title: ChatAuctionBidding
   Description: A real-time auction bidding chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring item cards, bid history, and countdown timers
   Source: original/blocks/chat/chat-auction-bidding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="gavel" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="font-medium text-sm">Live Auction</h2>
                <p class="text-muted-foreground text-xs">Real-time bidding assistant</p>
            </div>
            <span class="flex items-center gap-1.5 rounded-md bg-red-500/10 px-2 py-1 font-medium text-red-600 text-xs dark:text-red-400">
                <span class="size-1.5 animate-pulse rounded-full bg-red-500"></span>
                Live
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    <div class="@Cn.Merge("flex gap-3", msg.Role == "user" ? "flex-row-reverse" : "", msg.Role == "system" ? "justify-center" : "")">
                        @if (msg.Role != "system")
                        {
                            <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", msg.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                                @if (msg.Role == "assistant")
                                {
                                    <LucideIconCn Name="gavel" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span class="font-medium text-xs">You</span>
                                }
                            </div>
                        }
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", msg.Role == "user" ? "flex flex-col items-end" : "", msg.Role == "system" ? "flex flex-col items-center" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", msg.Role == "assistant" ? "bg-muted" : "", msg.Role == "user" ? "bg-foreground text-background" : "", msg.Role == "system" ? "bg-blue-500/10 text-blue-600 dark:text-blue-400" : "")">
                                @msg.Content
                            </div>
                            @if (msg.Item != null)
                            {
                                var item = msg.Item;
                                var statusClass = item.Status == "active"
                                    ? "bg-blue-500/10 text-blue-600 dark:text-blue-400"
                                    : item.Status == "ending-soon"
                                        ? "bg-red-500/10 text-red-600 dark:text-red-400"
                                        : "bg-muted text-muted-foreground";
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-mono text-muted-foreground text-xs">Lot #@item.Id</span>
                                                    <span class="@Cn.Merge("rounded-md px-2 py-0.5 text-xs", statusClass)">
                                                        @(item.Status == "ending-soon" ? "Ending Soon" : item.Status)
                                                    </span>
                                                </div>
                                                <h3 class="mt-1 font-medium text-sm">@item.Title</h3>
                                                <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="px-3 py-2">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <span class="block text-muted-foreground text-xs">Current Bid</span>
                                                <span class="mt-0.5 block font-semibold text-xl tabular-nums">
                                                    $@item.CurrentBid.ToString("N0")
                                                </span>
                                            </div>
                                            <div class="text-right">
                                                <span class="block text-muted-foreground text-xs">Time Left</span>
                                                <div class="mt-0.5 flex items-center gap-1">
                                                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-red-500" />
                                                    <span class="font-medium tabular-nums text-sm">@item.TimeRemaining</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mt-2 flex items-center justify-between border-t pt-2 text-xs">
                                            <span class="text-muted-foreground">
                                                Minimum bid: $@((item.CurrentBid + item.MinimumBid).ToString("N0"))
                                            </span>
                                            <span class="text-muted-foreground">@item.BidCount bids</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (msg.Bids != null)
                            {
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-xs">Bid History</span>
                                        </div>
                                    </div>
                                    <div class="divide-y">
                                        @for (var i = 0; i < msg.Bids.Length; i++)
                                        {
                                            var bid = msg.Bids[i];
                                            var isLast = i == msg.Bids.Length - 1;
                                            <div class="flex items-center justify-between px-3 py-2">
                                                <div class="flex items-center gap-2">
                                                    @if (bid.User == "You")
                                                    {
                                                        <div class="flex size-6 items-center justify-center rounded-full bg-foreground">
                                                            <span class="font-medium text-background text-xs">You</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="flex size-6 items-center justify-center rounded-full bg-muted">
                                                            <LucideIconCn Name="user" Size="14" Class="size-3.5" />
                                                        </div>
                                                    }
                                                    <span class="font-medium text-sm">@bid.User</span>
                                                    @if (isLast)
                                                    {
                                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                                    }
                                                </div>
                                                <div class="text-right">
                                                    <span class="block font-semibold text-sm tabular-nums">
                                                        $@bid.Amount.ToString("N0")
                                                    </span>
                                                    <span class="text-muted-foreground text-xs">@bid.Timestamp</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form @onsubmit="HandleSubmit" class="border-t p-3">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Place a bid or ask about items..." Class="flex-1" aria-label="Place a bid or ask about items..." />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>

    </div>
</section>

@code {
    private string _input = "";

    private record AuctionItem(
        string Id,
        string Title,
        string Description,
        int CurrentBid,
        int MinimumBid,
        int BidCount,
        string TimeRemaining,
        string Status);

    private record Bid(string User, int Amount, string Timestamp);

    private record Message(string Id, string Role, string Content, string Timestamp, AuctionItem? Item = null, Bid[]? Bids = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Welcome to the live auction! I'm your bidding assistant. Let me know which items interest you, and I'll help you place bids and track the action.",
            "2:00 PM"),
        new("2", "system",
            "Lot #247 is now open for bidding",
            "2:01 PM",
            Item: new AuctionItem("247", "Vintage Rolex Submariner (1972)", "Rare stainless steel diving watch in excellent condition",
                15000, 500, 12, "5m 23s", "ending-soon")),
        new("3", "user",
            "I'd like to bid $16,000 on the Rolex",
            "2:02 PM"),
        new("4", "assistant",
            "Your bid of $16,000 has been placed successfully! You're currently the highest bidder.",
            "2:02 PM",
            Bids:
            [
                new Bid("collector_92", 15000, "2:00 PM"),
                new Bid("You", 16000, "2:02 PM"),
            ]),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new Message(
            $"{_messages.Count + 1}",
            "user",
            _input,
            "2:05 PM"));

        _input = "";
    }
}
