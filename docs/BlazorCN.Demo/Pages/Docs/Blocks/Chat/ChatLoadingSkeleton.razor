@* ============================================================
   Block: chat-loading-skeleton
   Title: ChatLoadingSkeleton
   Description: React chat loading skeleton block for Next.js with animated pulse placeholders for header, alternating message bubbles, and input bar using TypeScript, shadcn/ui Skeleton, Tailwind CSS, and Framer Motion
   Source: original/blocks/chat/chat-loading-skeleton.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header skeleton *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <SkeletonCn Class="size-8 shrink-0 rounded-full" />
            <div class="flex flex-1 flex-col gap-1.5">
                <SkeletonCn Class="h-3.5 w-24 rounded" />
                <SkeletonCn Class="h-2.5 w-14 rounded" />
            </div>
        </div>

        @* Message skeletons — flat layout rows *@
        <div class="flex flex-1 flex-col gap-4 overflow-hidden px-4 py-4">
            @foreach (var row in _skeletonRows)
            {
                var flexDir = row.Align == "right" ? "flex-row-reverse" : "";
                var itemsAlign = row.Align == "right" ? "items-end" : "items-start";
                <div class="@($"flex gap-3 {flexDir}")">
                    <SkeletonCn Class="mt-0.5 size-7 shrink-0 rounded-full" />
                    <div class="@($"flex min-w-0 flex-col gap-1.5 {itemsAlign}")">
                        <div class="flex items-center gap-2">
                            <SkeletonCn Class="@($"h-2.5 {row.NameWidth} rounded")" />
                            <SkeletonCn Class="h-2 w-8 rounded" />
                        </div>
                        <SkeletonCn Class="@($"{row.ContentWidth} {row.ContentHeight} rounded-md")" />
                    </div>
                </div>
            }
        </div>

        @* Input skeleton *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <SkeletonCn Class="h-9 flex-1 rounded-md" />
                <SkeletonCn Class="size-9 shrink-0 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string Id, string Align, string NameWidth, string ContentWidth, string ContentHeight);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("s1", "left",  "w-16", "w-[55%]", "h-4"),
        new("s2", "right", "w-12", "w-[40%]", "h-4"),
        new("s3", "left",  "w-14", "w-[65%]", "h-8"),
        new("s4", "left",  "w-16", "w-[35%]", "h-4"),
        new("s5", "right", "w-10", "w-[50%]", "h-8"),
        new("s6", "left",  "w-14", "w-[45%]", "h-4"),
        new("s7", "right", "w-12", "w-[60%]", "h-4"),
        new("s8", "left",  "w-16", "w-[38%]", "h-8"),
    ];
}
