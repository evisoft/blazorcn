@* ============================================================
   Block: chat-messenger-style
   Title: ChatMessengerStyle
   Description: React Facebook Messenger-inspired chat interface for Next.js with gradient sent bubbles, circular avatars on message groups, quick-send thumbs up, and active status using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-messenger-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header with Active now green dot *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="relative">
                <AvatarCn>
                    <AvatarFallbackCn>@_contact.Initials</AvatarFallbackCn>
                </AvatarCn>
                <span class="absolute right-0 bottom-0 size-2.5 rounded-full border-2 border-card bg-emerald-500"></span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_contact.Name</span>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground text-xs">@_contact.Status</span>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col gap-0.5 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Messages">
            @for (int i = 0; i < _processed.Length; i++)
            {
                var msg = _processed[i];
                var isMe = msg.Sender == "me";

                var rowClass = Cn.Merge(
                    "flex items-end gap-2",
                    isMe ? "flex-row-reverse" : "flex-row",
                    msg.IsFirstInGroup ? "mt-3 first:mt-0" : ""
                );

                var bubbleClass = Cn.Merge(
                    "rounded-2xl px-3 py-2 text-sm leading-relaxed",
                    isMe
                        ? "bg-gradient-to-br from-blue-500 to-purple-600 text-white"
                        : "bg-muted text-foreground"
                );

                <div class="@rowClass">
                    @* Avatar placeholder - small circular avatar at bottom of received groups only *@
                    @if (!isMe)
                    {
                        <div class="w-7 shrink-0">
                            @if (msg.IsLastInGroup)
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="text-[10px]">@_contact.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                    }

                    <div class="@Cn.Merge("flex max-w-[75%] flex-col", isMe ? "items-end" : "items-start")">
                        @* Round bubble (rounded-2xl) with gradient sent *@
                        <div class="@bubbleClass">
                            @msg.Content
                        </div>

                        @* Timestamp on last message of group *@
                        @if (msg.IsLastInGroup)
                        {
                            <span class="mt-0.5 px-2 text-[10px] text-muted-foreground">@msg.Timestamp</span>
                        }
                    </div>
                </div>
            }

            @* Tiny seen-avatar (size-3.5) below last sent message *@
            <div class="mt-1 flex justify-end">
                <AvatarCn Class="size-3.5">
                    <AvatarFallbackCn Class="text-[6px]">@_contact.Initials</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </div>

        @* Input with thumbs-up quick-send when empty, SendIcon when typing *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-1">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-blue-500 hover:text-blue-600" aria-label="Attach image">
                    <LucideIconCn Name="image" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-blue-500 hover:text-blue-600" aria-label="Emoji">
                    <LucideIconCn Name="smile" Size="16" Class="size-4" />
                </ButtonCn>
                <input @bind="_input"
                       @bind:event="oninput"
                       placeholder="Aa"
                       class="h-9 flex-1 rounded-full border-0 bg-muted/50 px-4 shadow-none focus-visible:ring-0 text-sm outline-none" aria-label="Aa" />
                @if (!string.IsNullOrWhiteSpace(_input))
                {
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-blue-500 hover:text-blue-600" aria-label="Send">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-blue-500 hover:text-blue-600" OnClick="HandleThumbsUp" aria-label="Like">
                        <LucideIconCn Name="thumbs-up" Size="16" Class="size-4" />
                    </ButtonCn>
                }
            </form>
        </div>
    </div>
</section>

@code {
    private record Contact(string Name, string Initials, string Status);

    private record Message(string Id, string Content, string Sender, string SenderName, string Timestamp);

    private record ProcessedMessage(string Id, string Content, string Sender, string SenderName, string Timestamp, bool IsFirstInGroup, bool IsLastInGroup);

    private static readonly Contact _contact = new("Alex Rivera", "AR", "Active now");

    private static readonly Message[] _initialMessages =
    [
        new("1", "Hey Alex! Did you see the new component library dropped?", "me", "You", "4:12 PM"),
        new("2", "Yes! I've been playing with it all morning", "them", "Alex Rivera", "4:13 PM"),
        new("3", "The animation primitives are incredible. Way smoother than what we had before", "them", "Alex Rivera", "4:13 PM"),
        new("4", "Have you tried the new data table? It handles virtual scrolling out of the box", "them", "Alex Rivera", "4:14 PM"),
        new("5", "Not yet. Is it hard to set up?", "me", "You", "4:15 PM"),
        new("6", "Super easy. You pass your columns config and data array, and it just works. Sorting and filtering are built in.", "them", "Alex Rivera", "4:16 PM"),
        new("7", "That's going to save us so much time on the dashboard rebuild", "me", "You", "4:17 PM"),
        new("8", "I'll migrate the users table first as a proof of concept", "me", "You", "4:17 PM"),
        new("9", "Perfect. Send me the PR when it's ready and I'll review", "them", "Alex Rivera", "4:18 PM"),
        new("10", "Will do. Probably have it up by end of day", "me", "You", "4:19 PM"),
    ];

    private static readonly ProcessedMessage[] _processed = ProcessMessages(_initialMessages);

    private string _input = "";

    private static ProcessedMessage[] ProcessMessages(Message[] msgs)
    {
        var result = new ProcessedMessage[msgs.Length];
        for (int i = 0; i < msgs.Length; i++)
        {
            var msg = msgs[i];
            var prev = i > 0 ? msgs[i - 1] : null;
            var next = i < msgs.Length - 1 ? msgs[i + 1] : null;
            var isFirst = prev == null || prev.Sender != msg.Sender;
            var isLast = next == null || next.Sender != msg.Sender;
            result[i] = new(msg.Id, msg.Content, msg.Sender, msg.SenderName, msg.Timestamp, isFirst, isLast);
        }
        return result;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private void HandleThumbsUp()
    {
        // Send thumbs up reaction
    }
}
