@* ============================================================
   Block: chat-ticket-creation
   Title: ChatTicketCreation
   Description: React support ticket creation chat block for Next.js with inline ticket form, priority dropdown, description pre-filled from chat context, and success confirmation using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-ticket-creation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">

        @* Left: Chat *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <AvatarCn Class="size-8 shrink-0">
                    <AvatarFallbackCn Class="text-xs">SB</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Support Bot</span>
                    <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Online
                    </p>
                </div>
                <ButtonCn aria-label="Toggle ticket details panel" Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="size-7 p-0 text-muted-foreground"
                          OnClick="@(() => _showPanel = !_showPanel)">
                    @if (_showPanel)
                    {
                        <LucideIconCn Name="panel-right-close" Size="16" Class="size-4" />
                    }
                    else
                    {
                        <LucideIconCn Name="panel-right-open" Size="16" Class="size-4" />
                    }
                </ButtonCn>
            </div>

            @* Messages *@
            <div class="flex flex-1 flex-col overflow-y-auto py-2" tabindex="0" role="group" aria-label="Messages">
                @foreach (var msg in _messages)
                {
                    var idx = System.Array.IndexOf(_messages, msg);
                    var isUser = msg.Role == "user";
                    var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                    var showAvatar = prevMsg == null || prevMsg.Role != msg.Role;

                    if (isUser)
                    {
                        <div class="flex justify-end px-2 py-0.5">
                            <div class="max-w-[75%]">
                                <div class="rounded-2xl bg-foreground px-3 py-2 text-background text-sm leading-relaxed">
                                    @msg.Content
                                </div>
                                <span class="mt-0.5 block text-right text-muted-foreground text-[10px]">
                                    @msg.Timestamp
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex gap-2 rounded-md px-2 py-0.5 transition-colors hover:bg-accent">
                            <div class="w-8 shrink-0">
                                @if (showAvatar)
                                {
                                    <AvatarCn Class="size-8">
                                        <AvatarFallbackCn Class="text-xs">SB</AvatarFallbackCn>
                                    </AvatarCn>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                @if (showAvatar)
                                {
                                    <span class="mb-0.5 block text-muted-foreground text-[10px]">
                                        Support Bot
                                    </span>
                                }
                                <div class="max-w-[85%] rounded-2xl bg-muted px-3 py-2 text-sm leading-relaxed">
                                    @msg.Content
                                </div>
                                <span class="mt-0.5 block text-muted-foreground text-[10px]">
                                    @msg.Timestamp
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>

            @* Toolbar *@
            <div class="border-t px-4 py-3">
                <div class="flex items-center gap-2">
                    <InputCn @bind-Value="_input"
                             Placeholder="Type a message..."
                             Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                    <ButtonCn Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-9 shrink-0 text-muted-foreground hover:text-foreground"
                              OnClick="HandleSend" aria-label="Send">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Right: Ticket Panel *@
        @if (_showPanel)
        {
            <div class="flex w-80 shrink-0 flex-col border-l">
                @* Panel header *@
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <div>
                        <span class="font-medium text-sm">
                            @(_ticketCreated ? "Ticket created" : "New support ticket")
                        </span>
                        <p class="text-muted-foreground text-xs">
                            @(_ticketCreated ? "Submitted successfully" : "Pre-filled from chat")
                        </p>
                    </div>
                </div>

                @if (_ticketCreated)
                {
                    <div class="flex flex-1 flex-col items-center justify-center gap-3 px-4">
                        <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check-circle-2" Size="24" Class="size-6 text-emerald-500" />
                        </div>
                        <div class="text-center">
                            <span class="block font-medium text-sm">Ticket submitted</span>
                            <p class="mt-1 text-muted-foreground text-xs">
                                Assigned to the engineering team.
                            </p>
                        </div>
                        <div class="mt-2 w-full overflow-hidden rounded-lg border">
                            <div class="flex items-center justify-between border-b px-3 py-2">
                                <span class="text-muted-foreground text-xs">Ticket ID</span>
                                <div class="flex items-center gap-1.5">
                                    <span class="font-mono text-xs">TKT-4829</span>
                                    <ButtonCn aria-label="Copy ticket ID" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-5 p-0">
                                        <LucideIconCn Name="copy" Size="12" Class="size-3 text-muted-foreground" />
                                    </ButtonCn>
                                </div>
                            </div>
                            <div class="flex items-center justify-between border-b px-3 py-2">
                                <span class="text-muted-foreground text-xs">Priority</span>
                                <span class="flex items-center gap-1.5 text-xs">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    High
                                </span>
                            </div>
                            <div class="flex items-center justify-between px-3 py-2">
                                <span class="text-muted-foreground text-xs">Status</span>
                                <span class="text-xs">Open</span>
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="mt-2 text-xs"
                                  OnClick="@(() => { _ticketCreated = false; _showPanel = false; })">
                            Back to chat
                        </ButtonCn>
                    </div>
                }
                else
                {
                    <div class="flex-1 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Ticket form">
                        <div class="space-y-4">
                            @* Subject *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Subject
                                </span>
                                <InputCn @bind-Value="_formSubject"
                                         Placeholder="Brief description of the issue..."
                                         Class="h-9 text-sm" aria-label="Brief description of the issue..." />
                            </div>

                            @* Priority *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Priority
                                </span>
                                <SelectCn @bind-Value="_formPriority">
                                    <SelectTriggerCn aria-label="Priority" Class="h-9 text-sm">
                                        <SelectValueCn Placeholder="Select priority" />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="low">
                                            <span class="flex items-center gap-2">
                                                <span class="size-1.5 rounded-full bg-blue-500"></span>
                                                Low
                                            </span>
                                        </SelectItemCn>
                                        <SelectItemCn Value="medium">
                                            <span class="flex items-center gap-2">
                                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                                Medium
                                            </span>
                                        </SelectItemCn>
                                        <SelectItemCn Value="high">
                                            <span class="flex items-center gap-2">
                                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                High
                                            </span>
                                        </SelectItemCn>
                                        <SelectItemCn Value="critical">
                                            <span class="flex items-center gap-2">
                                                <span class="size-1.5 rounded-full bg-red-500"></span>
                                                Critical
                                            </span>
                                        </SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            @* Description *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Description
                                </span>
                                <TextareaCn @bind-Value="_formDescription"
                                            Placeholder="Detailed description..."
                                            rows="5"
                                            Class="resize-none text-sm" aria-label="Detailed description..." />
                                <p class="mt-1.5 text-muted-foreground text-[10px]">
                                    Pre-filled from your chat conversation
                                </p>
                            </div>

                            <ButtonCn Disabled="@string.IsNullOrWhiteSpace(_formSubject)"
                                      Size="ButtonSize.Sm"
                                      Class="w-full gap-1.5 text-xs"
                                      OnClick="HandleCreateTicket">
                                <LucideIconCn Name="ticket" Size="12" Class="size-3" />
                                Create ticket
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private string _input = "";
    private bool _showPanel = true;
    private bool _ticketCreated = false;
    private string _formSubject = "502 error on analytics dashboard after deploy v2.14.3";
    private string _formPriority = "high";
    private string _formDescription = "502 error on /dashboard/analytics after deploy v2.14.3 (started ~12:45 PM). Multiple users affected. Requires investigation of the deployment rollout and potential rollback.";

    private record Message(string Id, string Role, string Content, string Timestamp);

    private static readonly Message[] _messages =
    [
        new("1", "agent", "Welcome to Acme Support! How can I help you today?", "1:20 PM"),
        new("2", "user", "My dashboard keeps showing a 502 error after the latest deployment.", "1:21 PM"),
        new("3", "agent", "I'm sorry about that. Can you tell me which dashboard page and what time the errors started?", "1:21 PM"),
        new("4", "user", "The analytics page at /dashboard/analytics. Started around 12:45 PM today right after deploy v2.14.3 went out.", "1:22 PM"),
        new("5", "agent", "Thank you for the details. I can see the issue is affecting multiple users. Would you like me to create a support ticket to track the resolution?", "1:23 PM"),
        new("6", "user", "Yes please, that would be great.", "1:23 PM"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private void HandleCreateTicket()
    {
        if (string.IsNullOrWhiteSpace(_formSubject)) return;
        _ticketCreated = true;
    }
}
