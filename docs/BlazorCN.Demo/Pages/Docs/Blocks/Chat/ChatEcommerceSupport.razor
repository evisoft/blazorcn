@* ============================================================
   Block: chat-ecommerce-support
   Title: ChatEcommerceSupport
   Description: React e-commerce customer support chat block for Next.js with order reference cards, tracking status, quick action buttons, and agent header using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-ecommerce-support.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="relative">
                <AvatarCn Class="size-8">
                    <AvatarFallbackCn Class="bg-muted text-xs">@_agentInitials</AvatarFallbackCn>
                </AvatarCn>
                <span class="absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full bg-emerald-500 ring-2 ring-card"></span>
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_agentName</span>
                    <span class="text-muted-foreground text-xs">@_agentRole</span>
                </div>
                <span class="text-muted-foreground text-xs">Typically replies in under 2 min</span>
            </div>
        </div>

        @* Quick actions *@
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      OnClick="@(() => HandleQuickAction("Where's my order?"))">
                <LucideIconCn Name="truck" Size="12" Class="size-3" />
                Where's my order?
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      OnClick="@(() => HandleQuickAction("Return item"))">
                <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                Return item
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      OnClick="@(() => HandleQuickAction("Change address"))">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                Change address
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-3">
                @foreach (var msg in _messages)
                {
                    var isCustomer = msg.Role == "customer";
                    <div class="@Cn.Merge("flex", isCustomer ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[85%]", isCustomer ? "rounded-2xl rounded-br-sm bg-foreground px-3.5 py-2.5 text-background" : "")">

                            @* Order card *@
                            @if (msg.OrderCard)
                            {
                                <div class="rounded-lg border bg-muted/30 p-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <LucideIconCn Name="package" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-mono font-medium text-xs">@_order.Id</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto h-4 border-0 bg-blue-500/10 px-1.5 text-[10px] text-blue-600 dark:text-blue-400">
                                            @_order.Status
                                        </BadgeCn>
                                    </div>
                                    <div class="space-y-1">
                                        @foreach (var item in _order.Items)
                                        {
                                            <div class="flex items-center justify-between text-xs">
                                                <span class="text-muted-foreground">@item.Name x@(item.Qty)</span>
                                                <span class="shrink-0 font-medium tabular-nums">@item.Price</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="mt-2 flex items-center justify-between border-t pt-2">
                                        <span class="font-medium text-muted-foreground text-xs">Total</span>
                                        <span class="font-medium text-sm tabular-nums">@_order.Total</span>
                                    </div>
                                </div>
                            }

                            @* Tracking card *@
                            @if (msg.TrackingCard)
                            {
                                <div class="rounded-lg border bg-muted/30 p-3">
                                    <div class="mb-3 flex items-center gap-2">
                                        <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-xs">Tracking Status</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        @foreach (var step in _order.TrackingSteps)
                                        {
                                            var idx = System.Array.IndexOf(_order.TrackingSteps, step);
                                            <div class="flex flex-1 flex-col items-center gap-1.5">
                                                <div class="flex w-full items-center">
                                                    <div class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full", step.Completed ? "bg-emerald-500 text-white" : step.Current ? "border-2 border-blue-500 bg-blue-500/10" : "border border-muted-foreground/20 bg-muted")">
                                                        @if (step.Completed)
                                                        {
                                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                        }
                                                        @if (step.Current)
                                                        {
                                                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                                                        }
                                                    </div>
                                                    @if (idx < _order.TrackingSteps.Length - 1)
                                                    {
                                                        <div class="@Cn.Merge("h-0.5 flex-1", step.Completed ? "bg-emerald-500" : "bg-muted-foreground/20")"></div>
                                                    }
                                                </div>
                                                <span class="@Cn.Merge("text-center text-[10px]", step.Current ? "font-medium text-blue-600 dark:text-blue-400" : step.Completed ? "text-muted-foreground" : "text-muted-foreground/50")">
                                                    @step.Label
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @* Text content *@
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                var isAgentText = msg.Role == "agent" && !msg.OrderCard && !msg.TrackingCard;
                                <div class="@Cn.Merge("", isAgentText ? "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5" : "")">
                                    <p class="text-sm leading-relaxed">@msg.Content</p>
                                    <span class="@Cn.Merge("mt-1 block text-right text-[10px]", isCustomer ? "text-background/50" : "text-muted-foreground")">
                                        @msg.Timestamp
                                    </span>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Describe your issue..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground"
                          OnClick="HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _agentName = "Priya Sharma";
    private const string _agentInitials = "PS";
    private const string _agentRole = "Order Support";

    private string _input = "";

    private record OrderItem(string Name, int Qty, string Price);

    private record TrackingStep(string Label, bool Completed, bool Current);

    private record Order(string Id, OrderItem[] Items, string Total, string Status, TrackingStep[] TrackingSteps);

    private static readonly Order _order = new(
        "ORD-48291",
        [
            new("Wireless Noise-Cancelling Headphones", 1, "$249.00"),
            new("USB-C Charging Cable (2-pack)", 1, "$18.99"),
        ],
        "$267.99",
        "In Transit",
        [
            new("Confirmed", true, false),
            new("Shipped", true, false),
            new("In Transit", false, true),
            new("Delivered", false, false),
        ]
    );

    private record Message(string Id, string Role, string Content, string Timestamp, bool OrderCard = false, bool TrackingCard = false);

    private static readonly Message[] _messages =
    [
        new("1", "agent", "Hi there! I can see your recent order. Let me pull up the details.", "11:02 AM"),
        new("2", "agent", "", "11:02 AM", OrderCard: true),
        new("3", "customer", "Thanks. Where is the order right now? It was supposed to arrive yesterday.", "11:03 AM"),
        new("4", "agent", "Let me check the tracking for you. Here is the current status:", "11:04 AM"),
        new("5", "agent", "", "11:04 AM", TrackingCard: true),
        new("6", "agent", "The package left the regional hub this morning and is currently in transit. The updated delivery estimate is tomorrow by end of day. I apologize for the delay.", "11:04 AM"),
        new("7", "customer", "Alright, that is fine as long as it comes tomorrow. Can you send me an email when it is out for delivery?", "11:05 AM"),
        new("8", "agent", "Absolutely. I have enabled delivery notifications for this order. You will get an email and SMS when it is out for delivery. Is there anything else I can help with?", "11:06 AM"),
    ];

    private void HandleQuickAction(string label)
    {
        _input = label;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
