@* ============================================================
   Block: chat-image-messages
   Title: ChatImageMessages
   Description: React media-rich chat block for Next.js featuring Instagram DM-style image layouts with single full-width images, side-by-side grids, masonry-style multi-image layouts with plus-N overlays, and image captions using shadcn/ui, TypeScript, and Tailwind CSS
   Source: original/blocks/chat/chat-image-messages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="relative">
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-xs">AW</AvatarFallbackCn>
                </AvatarCn>
                <span class="absolute -right-0.5 -bottom-0.5 size-2 rounded-full border-2 border-card bg-emerald-500"></span>
            </div>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Ava Williams</p>
                <p class="text-muted-foreground text-xs">Photographer</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-muted-foreground text-xs">
                <LucideIconCn Name="image" Size="14" Class="size-3.5" />
                Media
            </ButtonCn>
        </div>

        @* Messages - flat layout *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var group in _grouped)
            {
                var groupKey = group[0].Id;
                <div key="@groupKey" class="mb-1">
                    @for (int i = 0; i < group.Count; i++)
                    {
                        var msg = group[i];
                        var isFirst = i == 0;
                        <div class="flex gap-2 px-4 py-0.5 hover:bg-accent">
                            <div class="flex w-8 shrink-0 items-start justify-center pt-0.5">
                                @if (isFirst)
                                {
                                    <AvatarCn Class="size-7">
                                        <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                }
                                else
                                {
                                    <span class="pt-1 text-muted-foreground text-[10px] opacity-0 group-hover:opacity-100">
                                        @msg.Time
                                    </span>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                @if (isFirst)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@msg.Sender</span>
                                        <span class="text-muted-foreground text-[10px]">@msg.Time</span>
                                    </div>
                                }
                                @if (msg.Content != null)
                                {
                                    <p class="text-sm leading-relaxed">@msg.Content</p>
                                }
                                @if (msg.Images != null)
                                {
                                    @RenderImageGrid(msg.Images, msg.Caption)
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2 rounded-md border px-3 py-1.5">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0 text-muted-foreground">
                    <LucideIconCn Name="plus" Size="16" Class="size-4" />
                </ButtonCn>
                <input @bind="_input" @bind:event="oninput"
                       placeholder="Message Ava Williams..."
                       class="h-7 flex-1 border-0 bg-transparent px-0 text-sm shadow-none outline-none focus-visible:ring-0 placeholder:text-muted-foreground" />
                <ButtonCn type="submit" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="@Cn.Merge("size-7 shrink-0 p-0", !string.IsNullOrWhiteSpace(_input) ? "text-foreground" : "text-muted-foreground")">
                    <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatImage(string Id, string Alt);

    private record ChatMessage(string Id, string Sender, string Initials, string Time, string? Content = null, ChatImage[]? Images = null, string? Caption = null);

    private static readonly ChatMessage[] _messages =
    [
        new("1", "Ava Williams", "AW", "2:10 PM", Content: "Just got back from the shoot!"),
        new("2", "Ava Williams", "AW", "2:10 PM", Images: [new("img-1", "Golden hour portrait on rooftop")], Caption: "Golden hour on the rooftop"),
        new("3", "You", "YO", "2:14 PM", Content: "These are incredible. The lighting is perfect."),
        new("4", "Ava Williams", "AW", "2:16 PM", Images: [new("img-2", "Wide angle city skyline at dusk"), new("img-3", "Close-up street light with bokeh")], Caption: "Skyline vs bokeh detail"),
        new("5", "You", "YO", "2:18 PM", Images: [new("img-4", "Moodboard screenshot from Figma")], Caption: "Here's the moodboard for reference"),
        new("6", "Ava Williams", "AW", "2:22 PM", Content: "Love the direction. Here are the rest from the set:"),
        new("7", "Ava Williams", "AW", "2:23 PM", Images: [new("img-5", "Model walking through alley"), new("img-6", "Neon reflection in puddle"), new("img-7", "Silhouette against sunset"), new("img-8", "Overhead flat lay of gear"), new("img-9", "Behind the scenes team photo")], Caption: "Full set from yesterday - 5 selects"),
        new("8", "You", "YO", "2:26 PM", Content: "The alley shot and neon puddle are my favorites. Can you send those in full res?"),
    ];

    private List<List<ChatMessage>> _grouped = [];

    private string _input = "";

    protected override void OnInitialized()
    {
        _grouped = GroupMessages(_messages);
    }

    private static List<List<ChatMessage>> GroupMessages(ChatMessage[] msgs)
    {
        var groups = new List<List<ChatMessage>>();
        foreach (var msg in msgs)
        {
            if (groups.Count > 0 && groups[^1][0].Sender == msg.Sender)
                groups[^1].Add(msg);
            else
                groups.Add([msg]);
        }
        return groups;
    }

    private RenderFragment RenderImageGrid(ChatImage[] images, string? caption) => __builder =>
    {
        const int maxVisible = 4;
        var overflow = images.Length - maxVisible;
        var visible = images.Length > maxVisible ? images[..maxVisible] : images;

        if (images.Length == 1)
        {
            <div class="mt-1">
                <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="image" Size="32" Class="size-8 text-muted-foreground/30" />
                </div>
                @if (caption != null)
                {
                    <p class="mt-1 text-muted-foreground text-xs">@caption</p>
                }
            </div>
        }
        else if (images.Length == 2)
        {
            <div class="mt-1">
                <div class="grid grid-cols-2 gap-1">
                    @foreach (var img in images)
                    {
                        <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/30" />
                        </div>
                    }
                </div>
                @if (caption != null)
                {
                    <p class="mt-1 text-muted-foreground text-xs">@caption</p>
                }
            </div>
        }
        else
        {
            <div class="mt-1">
                <div class="grid grid-cols-3 gap-1">
                    @for (int vi = 0; vi < visible.Length; vi++)
                    {
                        var img = visible[vi];
                        var isLast = vi == visible.Length - 1;
                        <div class="relative">
                            <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/30" />
                            </div>
                            @if (isLast && overflow > 0)
                            {
                                <div class="absolute inset-0 flex items-center justify-center rounded-md bg-black/50">
                                    <span class="font-semibold text-sm text-white">+@overflow</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (caption != null)
                {
                    <p class="mt-1 text-muted-foreground text-xs">@caption</p>
                }
            </div>
        }
    };

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
