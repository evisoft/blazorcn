@* ============================================================
   Block: chat-offline-banner
   Title: ChatOfflineBanner
   Description: React chat offline mode block for Next.js with amber warning banner, disabled input state, visible message history, and reconnection notice using TypeScript, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/chat/chat-offline-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <span class="font-medium text-muted-foreground text-xs">RK</span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Riley Kim</span>
                <p class="text-muted-foreground text-xs">@(_isOffline ? "Offline" : "Online")</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 px-2 text-muted-foreground text-xs"
                      @onclick="ToggleOffline">
                @if (_isOffline)
                {
                    <LucideIconCn Name="wifi" Size="12" Class="size-3" />
                    <text>Go online</text>
                }
                else
                {
                    <LucideIconCn Name="wifi-off" Size="12" Class="size-3" />
                    <text>Go offline</text>
                }
            </ButtonCn>
        </div>

        @* Offline banner *@
        @if (_isOffline)
        {
            <div class="flex items-center gap-2 border-b bg-amber-50 px-4 py-2 dark:bg-amber-950/30">
                <LucideIconCn Name="wifi-off" Size="14" Class="size-3.5 shrink-0 text-amber-600 dark:text-amber-500" />
                <p class="text-amber-700 text-xs dark:text-amber-400">
                    You're offline. Messages will be sent when you reconnect.
                </p>
            </div>
        }

        @* Messages *@
        <div class="flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            @foreach (var msg in _messages)
            {
                <div class="@Cn.Merge("flex flex-col", msg.Sender == "me" ? "items-end" : "items-start")">
                    <div class="@Cn.Merge("max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed", msg.Sender == "me" ? "bg-foreground text-background" : "bg-muted text-foreground")">
                        @msg.Content
                    </div>
                    <span class="mt-0.5 px-1 text-[10px] text-muted-foreground">@msg.Timestamp</span>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn Placeholder="@(_isOffline ? "Waiting for connection..." : "Type a message...")"
                         Disabled="@_isOffline"
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0 disabled:cursor-not-allowed disabled:opacity-50" aria-label="@(_isOffline ? "Waiting for connection..." : "Type a message...")" />
                <ButtonCn type="button"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@_isOffline"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Content, string Sender, string Timestamp);

    private bool _isOffline = true;

    private static readonly Message[] _messages =
    [
        new("m1", "Hey, I just deployed the hotfix to production.",                                                                "them", "11:02 AM"),
        new("m2", "Nice. Are the error rates dropping?",                                                                           "me",   "11:03 AM"),
        new("m3", "Down to 0.2% already. The timeout issue with the payment service is resolved.",                                 "them", "11:04 AM"),
        new("m4", "That's a relief. Should we keep the incident channel open?",                                                    "me",   "11:05 AM"),
        new("m5", "Let's keep it open for another hour to monitor. I'll post the postmortem draft by end of day.",                 "them", "11:06 AM"),
        new("m6", "Sounds good. I'll review it tonight.",                                                                          "me",   "11:07 AM"),
        new("m7", "Thanks. Also, the staging environment needs the same patch. Can you handle that?",                              "them", "11:08 AM"),
    ];

    private void ToggleOffline()
    {
        _isOffline = !_isOffline;
    }
}
