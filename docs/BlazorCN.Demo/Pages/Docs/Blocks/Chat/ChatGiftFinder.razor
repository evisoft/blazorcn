@* ============================================================
   Block: chat-gift-finder
   Title: ChatGiftFinder
   Description: A gift recommendation chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring gift cards, price ranges, occasion tags, and wishlist functionality
   Source: original/blocks/chat/chat-gift-finder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="gift" Size="20" Class="size-5 text-emerald-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Gift Finder</h3>
                <p class="text-xs text-muted-foreground">AI-powered recommendations</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1">
                <LucideIconCn Name="heart" Size="12" Class="size-3" />
                <span>@_wishlist.Count</span>
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            @foreach (var message in _messages)
            {
                <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8">
                        @if (message.Role == "assistant")
                        {
                            <AvatarFallbackCn Class="bg-emerald-500/10">
                                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-emerald-600" />
                            </AvatarFallbackCn>
                        }
                        else
                        {
                            <AvatarImageCn Src="/placeholder.svg" />
                            <AvatarFallbackCn>You</AvatarFallbackCn>
                        }
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", message.Role == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Role == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                            @message.Content
                        </div>

                        @if (message.Gifts != null && message.Gifts.Length > 0)
                        {
                            <div class="grid gap-3 pt-2">
                                @foreach (var gift in message.Gifts)
                                {
                                    var giftItem = gift;
                                    <div class="flex gap-3 rounded-lg border bg-card p-3">
                                        <div class="size-20 shrink-0 overflow-hidden rounded-md border bg-muted"></div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-start justify-between gap-2">
                                                <h4 class="text-sm font-medium">@giftItem.Name</h4>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0" OnClick="@(() => ToggleWishlist(giftItem.Id))">
                                                    <LucideIconCn Name="heart" Size="16" Class="@Cn.Merge("size-4", _wishlist.Contains(giftItem.Id) ? "fill-red-500 text-red-500" : "")" />
                                                </ButtonCn>
                                            </div>
                                            <p class="mt-1 text-xs text-muted-foreground">@giftItem.Description</p>
                                            <div class="mt-2 flex items-center gap-2">
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@giftItem.Occasion</BadgeCn>
                                                <span class="text-sm font-semibold tabular-nums text-emerald-600">$@giftItem.Price.ToString("F2")</span>
                                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="ml-auto h-7 text-xs">View Gift</ButtonCn>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Describe who you're shopping for..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private readonly HashSet<string> _wishlist = [];

    private record Gift(string Id, string Name, double Price, string Image, string Occasion, string Description);
    private record Message(string Id, string Role, string Content, string Timestamp, Gift[]? Gifts = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Hi! I'm your gift finder assistant. Tell me about the person you're shopping for and the occasion, and I'll help you find the perfect gift!",
            "10:00 AM"),
        new("2", "user",
            "I need a birthday gift for my mom who loves gardening",
            "10:01 AM"),
        new("3", "assistant",
            "Perfect! Here are some thoughtful gardening gifts for your mom's birthday:",
            "10:01 AM",
            [
                new("g1", "Premium Garden Tool Set", 89.99, "/placeholder.svg", "Birthday",
                    "Professional-grade stainless steel tools with ergonomic handles"),
                new("g2", "Herb Growing Kit", 45.00, "/placeholder.svg", "Birthday",
                    "Complete kit with seeds, pots, and organic soil"),
                new("g3", "Garden Kneeling Pad", 29.99, "/placeholder.svg", "Birthday",
                    "Extra-thick cushioned pad with carrying handle"),
            ]),
    ];

    private void ToggleWishlist(string giftId)
    {
        if (_wishlist.Contains(giftId))
            _wishlist.Remove(giftId);
        else
            _wishlist.Add(giftId);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"msg-{_messages.Count + 1}", "user", _input, "Just now"));
        _input = "";
    }
}
