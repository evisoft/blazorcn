@* ============================================================
   Block: chat-habit-tracker
   Title: ChatHabitTracker
   Description: Habit tracking chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS. Features daily check-ins, streak counters, progress visualization, and motivational feedback.
   Source: original/blocks/chat/chat-habit-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Habit Tracker</h2>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-orange-500" />
                        <span class="text-xs text-muted-foreground">
                            @(_habits.Max(h => h.CurrentStreak)) day streak
                        </span>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                        @(_habits.Count(h => h.CompletedToday))/@(_habits.Count) today
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Habit Cards *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                @foreach (var habit in _habits)
                {
                    var h = habit;
                    <div class="rounded-md border bg-card p-3 transition-colors hover:bg-muted/50">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        @onclick="@(() => QuickComplete(h.Id))"
                                        disabled="@(h.CompletedToday ? "disabled" : null)"
                                        class="@Cn.Merge("rounded-full transition-colors", h.CompletedToday ? "text-emerald-500" : "text-muted-foreground hover:text-emerald-500")"
                                        aria-label="Mark complete">
                                        @if (h.CompletedToday)
                                        {
                                            <LucideIconCn Name="check-circle-2" Size="20" Class="size-5" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="circle" Size="20" Class="size-5" />
                                        }
                                    </button>
                                    <div>
                                        <h3 class="text-sm font-medium">@h.Name</h3>
                                        <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="flame" Size="12" Class="size-3 text-orange-500" />
                                                @h.CurrentStreak days
                                            </span>
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="award" Size="12" Class="size-3" />
                                                Best: @h.LongestStreak
                                            </span>
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                                @h.TotalCompletions total
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                                        <span>Week progress</span>
                                        <span>@(h.WeekProgress)%</span>
                                    </div>
                                    <ProgressCn Value="@h.WeekProgress" Class="mt-1 h-1.5" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    @if (msg.Type == "user")
                    {
                        <div class="flex justify-end">
                            <div class="flex max-w-[85%] items-start gap-2">
                                <div class="rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                                    <p class="text-sm">@msg.Content</p>
                                    <span class="mt-1 block text-xs opacity-70">@msg.Timestamp</span>
                                </div>
                                <AvatarCn Class="size-8 shrink-0">
                                    <AvatarFallbackCn Class="bg-primary text-xs text-primary-foreground">U</AvatarFallbackCn>
                                </AvatarCn>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-start gap-2">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="@Cn.Merge("text-xs", msg.Type == "completion" ? "bg-emerald-500 text-white" : msg.Type == "streak" ? "bg-orange-500 text-white" : "bg-muted")">
                                    @if (msg.Type == "completion")
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="16" Class="size-4" />
                                    }
                                    else if (msg.Type == "streak")
                                    {
                                        <LucideIconCn Name="flame" Size="16" Class="size-4" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="target" Size="16" Class="size-4" />
                                    }
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class="max-w-[85%]">
                                <div class="@Cn.Merge("rounded-lg px-3 py-2", msg.Type == "completion" ? "bg-emerald-500/10" : msg.Type == "streak" ? "bg-orange-500/10" : "bg-muted")">
                                    <p class="text-sm">@msg.Content</p>
                                    <span class="mt-1 block text-xs text-muted-foreground">@msg.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="mb-2 flex gap-2">
                @foreach (var habit in _habits.Where(h => !h.CompletedToday).Take(3))
                {
                    var h = habit;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                        OnClick="@(() => QuickComplete(h.Id))"
                        Class="gap-1.5 text-xs">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                        @h.Name
                    </ButtonCn>
                }
            </div>
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Type a command..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private static readonly string[] _motivationalMessages =
    [
        "Great job! Keep the momentum going!",
        "Consistency is key. You're doing amazing!",
        "Another day, another step closer to your goal!",
        "Your dedication is inspiring!",
        "You're building something great here!",
    ];

    private sealed class Habit
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public int CurrentStreak { get; set; }
        public int LongestStreak { get; set; }
        public bool CompletedToday { get; set; }
        public int TotalCompletions { get; set; }
        public int WeekProgress { get; set; }

        public Habit(string id, string name, int currentStreak, int longestStreak, bool completedToday, int totalCompletions, int weekProgress)
        {
            Id = id;
            Name = name;
            CurrentStreak = currentStreak;
            LongestStreak = longestStreak;
            CompletedToday = completedToday;
            TotalCompletions = totalCompletions;
            WeekProgress = weekProgress;
        }
    }

    private record Message(string Id, string Type, string Content, string Timestamp);

    private List<Habit> _habits =
    [
        new("1", "Morning Exercise", 12, 15, false, 45, 71),
        new("2", "Read 30 Minutes", 7, 10, true, 32, 86),
        new("3", "Meditate", 5, 8, false, 28, 57),
    ];

    private List<Message> _messages =
    [
        new("1", "system",
            "Welcome to your habit tracker! Mark habits as complete or type 'add [habit name]' to track a new habit.",
            "6:00 AM"),
    ];

    private void AddMessage(string type, string content)
    {
        var now = DateTime.Now;
        var timestamp = now.ToString("h:mm tt");
        _messages.Add(new(DateTime.Now.Ticks.ToString(), type, content, timestamp));
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var cmd = _input.Trim();
        AddMessage("user", cmd);
        ProcessCommand(cmd.ToLowerInvariant());
        _input = "";
    }

    private void ProcessCommand(string command)
    {
        if (command.StartsWith("done ") || command.StartsWith("complete "))
        {
            var habitName = System.Text.RegularExpressions.Regex.Replace(command, @"^(done|complete)\s+", "").Trim();
            CompleteHabit(habitName);
        }
        else if (command.StartsWith("add ") || command.StartsWith("track "))
        {
            var habitName = System.Text.RegularExpressions.Regex.Replace(command, @"^(add|track)\s+", "").Trim();
            AddHabit(habitName);
        }
        else if (command.Contains("stats") || command.Contains("progress"))
        {
            ShowStats();
        }
        else
        {
            AddMessage("system", "I can help you track habits. Try 'done [habit]', 'add [habit]', or 'stats'.");
        }
    }

    private void CompleteHabit(string habitName)
    {
        var habit = _habits.FirstOrDefault(h => h.Name.ToLowerInvariant().Contains(habitName));

        if (habit == null)
        {
            AddMessage("system", $"Habit \"{habitName}\" not found. Add it first!");
            return;
        }

        if (habit.CompletedToday)
        {
            AddMessage("system", $"You already completed \"{habit.Name}\" today!");
            return;
        }

        var oldLongest = habit.LongestStreak;
        var newStreak = habit.CurrentStreak + 1;
        habit.CurrentStreak = newStreak;
        habit.LongestStreak = Math.Max(oldLongest, newStreak);
        habit.CompletedToday = true;
        habit.TotalCompletions = habit.TotalCompletions + 1;
        habit.WeekProgress = Math.Min(100, habit.WeekProgress + 14);

        var rng = new Random();
        var motivationalMsg = _motivationalMessages[rng.Next(_motivationalMessages.Length)];
        AddMessage("completion", $"Completed \"{habit.Name}\"! {motivationalMsg}");

        if (newStreak > oldLongest)
        {
            AddMessage("streak", $"New personal record! {newStreak} day streak for {habit.Name}!");
        }
    }

    private void AddHabit(string habitName)
    {
        _habits.Add(new(DateTime.Now.Ticks.ToString(), habitName, 0, 0, false, 0, 0));
        AddMessage("system", $"Added \"{habitName}\" to your habit tracker!");
    }

    private void ShowStats()
    {
        var totalCompletions = _habits.Sum(h => h.TotalCompletions);
        var activeStreaks = _habits.Count(h => h.CurrentStreak > 0);
        AddMessage("system", $"Total completions: {totalCompletions} | Active streaks: {activeStreaks}/{_habits.Count}");
    }

    private void QuickComplete(string habitId)
    {
        var habit = _habits.FirstOrDefault(h => h.Id == habitId);
        if (habit != null)
        {
            CompleteHabit(habit.Name.ToLowerInvariant());
        }
    }
}
