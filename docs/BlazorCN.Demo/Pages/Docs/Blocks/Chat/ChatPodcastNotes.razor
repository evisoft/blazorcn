@* ============================================================
   Block: chat-podcast-notes
   Title: ChatPodcastNotes
   Description: An interactive podcast listening assistant built with React, Next.js, shadcn/ui, and Tailwind CSS featuring episode cards, timestamp navigation, and collaborative note sharing
   Source: original/blocks/chat/chat-podcast-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="podcast" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Podcast Discussion</h2>
                    <p class="text-xs text-muted-foreground">3 team members listening</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2">
                    <LucideIconCn Name="bookmark" Size="14" Class="size-3.5" />
                    <span class="text-xs">Saved</span>
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-7 w-7" aria-label="Members">
                    <LucideIconCn Name="users" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var msg in _messages)
            {
                var message = msg;
                <div class="@Cn.Merge("flex", message.Type == "user" ? "justify-end" : "justify-start")">
                    <div class="@Cn.Merge("max-w-[85%] space-y-2", message.Type == "user" ? "items-end" : "items-start")">
                        @if (message.Author != null)
                        {
                            <div class="flex items-center gap-2">
                                <div class="flex size-6 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                    @message.Author.Avatar
                                </div>
                                <span class="text-xs text-muted-foreground">@message.Author.Name</span>
                            </div>
                        }

                        <div class="@Cn.Merge("rounded-lg px-3 py-2", message.Type == "user" ? "bg-foreground text-background" : "bg-muted")">
                            <p class="text-sm">@message.Content</p>
                        </div>

                        @if (message.Episode != null)
                        {
                            var ep = message.Episode;
                            <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                <div class="flex items-start justify-between">
                                    <div class="min-w-0 flex-1">
                                        <h3 class="text-sm font-medium">@ep.Title</h3>
                                        <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                            <span>@ep.Podcast</span>
                                            <span>•</span>
                                            <span>@ep.Duration</span>
                                        </div>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-7 w-7 shrink-0" aria-label="Play">
                                        <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                </div>

                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs font-medium">Key Moments</span>
                                    </div>
                                    <div class="space-y-1">
                                        @foreach (var km in ep.KeyMoments)
                                        {
                                            var moment = km;
                                            <button type="button"
                                                    class="flex w-full items-center gap-3 rounded-md p-2 text-left transition-colors hover:bg-muted/50">
                                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@moment.Time</span>
                                                <span class="min-w-0 flex-1 truncate text-xs">@moment.Topic</span>
                                                <LucideIconCn Name="play" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="flex items-center gap-2 pt-1">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 flex-1 gap-1 text-xs">
                                        <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                        Discuss
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 flex-1 gap-1 text-xs">
                                        <LucideIconCn Name="bookmark" Size="12" Class="size-3" />
                                        Save
                                    </ButtonCn>
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0" aria-label="Bookmark">
                    <LucideIconCn Name="bookmark" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="Share your thoughts..."
                         Class="border-0 bg-transparent shadow-none focus-visible:ring-0" aria-label="Share your thoughts..." />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="h-8 w-8 shrink-0" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record AuthorInfo(string Name, string Avatar);

    private record KeyMoment(string Time, string Topic);

    private record EpisodeInfo(string Title, string Podcast, string Duration, KeyMoment[] KeyMoments);

    private record PodcastMessage(string Id, string Type, string Content, string Timestamp, AuthorInfo? Author = null, EpisodeInfo? Episode = null);

    private string _input = "";

    private static readonly PodcastMessage[] _messages =
    [
        new("1", "assistant",
            "Welcome to the podcast discussion! I can help you take notes, find key moments, and discuss insights with your team.",
            "9:00 AM"),
        new("2", "user",
            "Let's discuss the latest episode about product strategy",
            "9:01 AM",
            Author: new AuthorInfo("Sarah Chen", "SC")),
        new("3", "assistant",
            "Great! Here's the episode summary with key moments I've identified:",
            "9:01 AM",
            Episode: new EpisodeInfo(
                "Building Product Strategy in 2026",
                "The Product Podcast",
                "42 min",
                [
                    new KeyMoment("3:45", "Market research frameworks"),
                    new KeyMoment("12:30", "User interview best practices"),
                    new KeyMoment("28:15", "Prioritization techniques"),
                    new KeyMoment("35:20", "Measuring product success"),
                ])),
        new("4", "user",
            "The part about prioritization at 28:15 was really insightful. They mentioned the RICE framework.",
            "9:15 AM",
            Author: new AuthorInfo("Marcus Lee", "ML")),
        new("5", "assistant",
            "Good catch! The RICE framework (Reach, Impact, Confidence, Effort) was explained with a real case study. Would you like me to create a note card for this moment?",
            "9:15 AM"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
