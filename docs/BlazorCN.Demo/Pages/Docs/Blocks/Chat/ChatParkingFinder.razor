@* ============================================================
   Block: chat-parking-finder
   Title: ChatParkingFinder
   Description: A parking spot finder chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring location cards, real-time availability status, and pricing information
   Source: original/blocks/chat/chat-parking-finder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10">
                    <LucideIconCn Name="car" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Parking Finder</h2>
                    <p class="text-xs text-muted-foreground">Find &amp; book parking spots</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 p-4">
                @foreach (var msg in _messages)
                {
                    @if (msg.Type == "spots" && msg.Spots != null)
                    {
                        <div class="space-y-3">
                            @foreach (var spot in msg.Spots)
                            {
                                var spotItem = spot;
                                <div class="overflow-hidden rounded-lg border bg-muted/30">
                                    <div class="border-b bg-card px-3 py-2.5">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <h3 class="text-sm font-medium">@spotItem.Name</h3>
                                                <div class="mt-1 flex items-center gap-1.5 text-xs text-muted-foreground">
                                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                                    <span class="truncate">@spotItem.Address</span>
                                                </div>
                                            </div>
                                            <span class="shrink-0 text-xs text-muted-foreground">
                                                @spotItem.Distance
                                            </span>
                                        </div>
                                    </div>

                                    <div class="p-3">
                                        <div class="mb-3 flex items-center justify-between">
                                            <div class="flex items-center gap-2">
                                                @if (spotItem.Available > 0)
                                                {
                                                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                                                    <span class="text-sm font-medium">@spotItem.Available available</span>
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                                                    <span class="text-sm font-medium text-muted-foreground">Full</span>
                                                }
                                                <span class="text-xs text-muted-foreground">/ @spotItem.Total total</span>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                                                <span class="text-sm font-medium">
                                                    @spotItem.PricingHourly<span class="text-muted-foreground">/hr</span>
                                                </span>
                                            </div>
                                        </div>

                                        <div class="mb-3 flex flex-wrap gap-1.5">
                                            @foreach (var feature in spotItem.Features)
                                            {
                                                var feat = feature;
                                                <div class="flex items-center gap-1 rounded-md bg-muted/50 px-2 py-1">
                                                    @if (feat == "EV Charging")
                                                    {
                                                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                                                    }
                                                    else if (feat == "Security")
                                                    {
                                                        <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-muted-foreground" />
                                                    }
                                                    else if (feat == "WiFi")
                                                    {
                                                        <LucideIconCn Name="wifi" Size="12" Class="size-3 text-muted-foreground" />
                                                    }
                                                    <span class="text-xs text-muted-foreground">@feat</span>
                                                </div>
                                            }
                                        </div>

                                        <ButtonCn
                                            OnClick="@(() => HandleBook(spotItem.Id))"
                                            Disabled="@(spotItem.Available == 0)"
                                            Size="ButtonSize.Sm"
                                            Variant="@(spotItem.Available > 0 ? ButtonVariant.Default : ButtonVariant.Outline)"
                                            Class="w-full">
                                            @(spotItem.Available > 0 ? "Book Now" : "Notify When Available")
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        var message = msg;
                        <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "justify-end" : "justify-start")">
                            @if (message.Type == "assistant")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-primary/10 text-xs">
                                        <LucideIconCn Name="car" Size="16" Class="size-4" />
                                    </AvatarFallbackCn>
                                </AvatarCn>
                            }
                            <div class="@Cn.Merge("max-w-[80%] rounded-lg px-3 py-2", message.Type == "user" ? "bg-primary text-primary-foreground" : "bg-muted")">
                                <p class="text-sm">@message.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", message.Type == "user" ? "text-primary-foreground/70" : "text-muted-foreground")">
                                    @message.Timestamp
                                </span>
                            </div>
                            @if (message.Type == "user")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-muted text-xs">U</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-3">
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Where do you need parking?"
                    Class="flex-1" aria-label="Where do you need parking?" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record PricingInfo(string Hourly, string Daily);

    private record ParkingSpot(
        string Id,
        string Name,
        string Address,
        int Available,
        int Total,
        string Distance,
        string PricingHourly,
        string PricingDaily,
        string[] Features);

    private record Message(string Id, string Type, string Content, string Timestamp, ParkingSpot[]? Spots = null);

    private static readonly ParkingSpot[] _parkingSpots =
    [
        new("p1", "Downtown Plaza Parking", "123 Main St, Downtown", 24, 120, "0.3 mi", "$4", "$28",
            ["EV Charging", "Covered", "24/7 Access"]),
        new("p2", "Central Station Garage", "456 Station Ave", 8, 200, "0.5 mi", "$3.50", "$24",
            ["Security", "WiFi", "Handicap"]),
        new("p3", "City Center Lot", "789 Center Blvd", 0, 80, "0.7 mi", "$5", "$32",
            ["Covered", "Valet"]),
    ];

    private List<Message> _messages =
    [
        new("m1", "assistant", "Hello! I'll help you find available parking spots nearby. Where are you heading?", "10:24 AM"),
        new("m2", "user", "I need parking near downtown for about 3 hours", "10:25 AM"),
        new("m3", "assistant", "I found 3 parking options near downtown. Here are the available spots:", "10:25 AM"),
        new("m4", "spots", "", "10:25 AM", _parkingSpots),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var userMessage = new Message($"m{_messages.Count + 1}", "user", _input, "10:26 AM");
        _messages.Add(userMessage);
        _input = "";
    }

    private void HandleBook(string spotId)
    {
        // Booking action — no-op in demo
    }
}
