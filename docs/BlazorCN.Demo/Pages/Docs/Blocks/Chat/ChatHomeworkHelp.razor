@* ============================================================
   Block: chat-homework-help
   Title: ChatHomeworkHelp
   Description: A homework assistance chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring math equation cards, step-by-step solutions, and subject badges
   Source: original/blocks/chat/chat-homework-help.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-blue-500/10">
                <LucideIconCn Name="book-open" Size="20" Class="size-5 text-blue-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Homework Helper</h3>
                <p class="text-xs text-muted-foreground">Step-by-step guidance</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />3 solved today
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            @foreach (var message in _messages)
            {
                <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8">
                        @if (message.Role == "assistant")
                        {
                            <AvatarFallbackCn Class="bg-blue-500/10">
                                <LucideIconCn Name="book-open" Size="16" Class="size-4 text-blue-600" />
                            </AvatarFallbackCn>
                        }
                        else
                        {
                            <AvatarImageCn Src="/placeholder.svg" />
                            <AvatarFallbackCn>You</AvatarFallbackCn>
                        }
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", message.Role == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Role == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                            @message.Content
                        </div>

                        @if (!string.IsNullOrEmpty(message.Subject))
                        {
                            var subjectClass = GetSubjectColor(message.Subject);
                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs", subjectClass)">
                                @message.Subject
                            </BadgeCn>
                        }

                        @if (message.Solution != null && message.Solution.Length > 0)
                        {
                            <div class="space-y-3 pt-2">
                                @foreach (var step in message.Solution)
                                {
                                    <div class="flex gap-3">
                                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-blue-500/10">
                                            <span class="text-xs font-medium text-blue-600">@step.Step</span>
                                        </div>
                                        <div class="min-w-0 flex-1 space-y-2">
                                            <p class="text-sm text-muted-foreground">@step.Description</p>
                                            @if (!string.IsNullOrEmpty(step.Equation))
                                            {
                                                <div class="rounded-md bg-muted/50 px-3 py-2">
                                                    <code class="font-mono text-sm">@step.Equation</code>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <form class="border-t p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask a homework question..."
                         Class="flex-1" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record SolutionStep(int Step, string Description, string? Equation);

    private record Message(string Id, string Role, string Content, string Timestamp, string? Subject = null, SolutionStep[]? Solution = null);

    private string _input = "";

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Hi! I'm your homework helper. Share a problem you're working on, and I'll guide you through it step-by-step!",
            "2:30 PM"),
        new("2", "user",
            "How do I solve: 2x + 5 = 13?",
            "2:31 PM"),
        new("3", "assistant",
            "Great question! Let's solve this linear equation together:",
            "2:31 PM",
            Subject: "Algebra",
            Solution:
            [
                new(1, "Start with the original equation", "2x + 5 = 13"),
                new(2, "Subtract 5 from both sides to isolate the term with x", "2x = 8"),
                new(3, "Divide both sides by 2 to solve for x", "x = 4"),
                new(4, "Verify by substituting x = 4 back into the original equation", "2(4) + 5 = 13 ✓"),
            ]),
    ];

    private static string GetSubjectColor(string subject) => subject switch
    {
        "Algebra"   => "bg-blue-500/10 text-blue-600",
        "Geometry"  => "bg-purple-500/10 text-purple-600",
        "Chemistry" => "bg-emerald-500/10 text-emerald-600",
        "Physics"   => "bg-orange-500/10 text-orange-600",
        _           => "bg-muted",
    };

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var userMessage = new Message(
            $"msg-{_messages.Count + 1}",
            "user",
            _input,
            "Just now");

        _messages.Add(userMessage);
        _input = "";

        var responseMessage = new Message(
            $"msg-{_messages.Count + 1}",
            "assistant",
            "Let me help you work through this problem...",
            "Just now");

        _messages.Add(responseMessage);
    }
}
