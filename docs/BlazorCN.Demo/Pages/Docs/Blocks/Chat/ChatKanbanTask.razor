@* ============================================================
   Block: chat-kanban-task
   Title: ChatKanbanTask
   Description: A kanban task chat block for React and Next.js with inline task cards, status updates, drag-to-assign mentions, and progress tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-kanban-task.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">#sprint-17</span>
            <span class="text-muted-foreground text-xs">· Task tracking enabled</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-3">
                @foreach (var msg in _messages)
                {
                    @if (msg.Type == "status-change" && msg.StatusChange != null)
                    {
                        var sc = msg.StatusChange;
                        <div class="flex items-center gap-2 py-1">
                            <div class="h-px flex-1 bg-border"></div>
                            <span class="shrink-0 text-muted-foreground text-[10px]">
                                @sc.By moved &ldquo;@sc.TaskTitle&rdquo; to @GetStatusLabel(sc.To)
                            </span>
                            <div class="h-px flex-1 bg-border"></div>
                        </div>
                    }
                    else
                    {
                        <div class="flex gap-3">
                            <AvatarCn Class="mt-0.5 size-7 shrink-0">
                                <AvatarFallbackCn Class="bg-muted text-[10px] text-muted-foreground">
                                    @msg.Initials
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="font-medium text-sm">@msg.Sender</span>
                                    <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                                </div>

                                @* Text content *@
                                @if (msg.Type == "text")
                                {
                                    <p class="mt-0.5 text-sm leading-relaxed">@msg.Content</p>
                                }

                                @* Task card *@
                                @if (msg.Type == "task-card" && msg.Task != null)
                                {
                                    var task = msg.Task;
                                    var priorityColor = GetPriorityColor(task.Priority);
                                    var statusColor = GetStatusColor(task.Status);
                                    var statusLabel = GetStatusLabel(task.Status);
                                    <div class="mt-1.5 rounded-md border bg-muted/30 p-3">
                                        <div class="flex items-start gap-2">
                                            <LucideIconCn Name="flag" Size="14" Class="@Cn.Merge("mt-0.5 size-3.5 shrink-0", priorityColor)" />
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-mono text-muted-foreground text-[10px]">@task.Id</span>
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", statusColor)">
                                                        @statusLabel
                                                    </BadgeCn>
                                                </div>
                                                <p class="mt-0.5 font-medium text-sm">@task.Title</p>
                                                <div class="mt-1.5 flex items-center gap-3 text-xs">
                                                    <div class="flex items-center gap-1">
                                                        <AvatarCn Class="size-4">
                                                            <AvatarFallbackCn Class="bg-muted text-[7px] text-muted-foreground">
                                                                @task.AssigneeInitials
                                                            </AvatarFallbackCn>
                                                        </AvatarCn>
                                                        <span class="text-muted-foreground">@task.Assignee</span>
                                                    </div>
                                                    <span class="text-muted-foreground">Due @task.DueDate</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_input" Placeholder="Message or /task to create..." Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn Type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Disabled="@(string.IsNullOrWhiteSpace(_input))" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _input = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "todo"        => "To Do",
        "in-progress" => "In Progress",
        "done"        => "Done",
        _             => status,
    };

    private static string GetStatusColor(string status) => status switch
    {
        "todo"        => "bg-muted text-muted-foreground border-0",
        "in-progress" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        "done"        => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        _             => "bg-muted text-muted-foreground border-0",
    };

    private static string GetPriorityColor(string priority) => priority switch
    {
        "urgent" => "text-red-500",
        "high"   => "text-amber-500",
        "medium" => "text-blue-500",
        "low"    => "text-muted-foreground",
        _        => "text-muted-foreground",
    };

    private record TaskCard(
        string Id,
        string Title,
        string Status,
        string Priority,
        string Assignee,
        string AssigneeInitials,
        string DueDate
    );

    private record StatusChange(
        string TaskTitle,
        string From,
        string To,
        string By
    );

    private record ChatMessage(
        string Id,
        string Sender,
        string Initials,
        string Timestamp,
        string Type,
        string? Content = null,
        TaskCard? Task = null,
        StatusChange? StatusChange = null
