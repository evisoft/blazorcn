@* ============================================================
   Block: chat-donation-tracker
   Title: ChatDonationTracker
   Description: React donation tracking chat block for Next.js with goal progress bar, donor acknowledgement cards, milestone celebrations, recent donation feed, and campaign summary using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-donation-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Campaign header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="heart" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_campaign.Name</span>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span>@_campaign.DonorCount donors</span>
                    <span>·</span>
                    <span>@_campaign.DaysLeft days left</span>
                </div>
            </div>
        </div>

        @* Goal progress *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    $@_campaign.Raised.ToString("N0")
                </span>
                <span class="text-muted-foreground text-xs">
                    / $@_campaign.Goal.ToString("N0")
                </span>
            </div>
            <ProgressCn Value="@_progressPercent" Class="h-1.5 flex-1" aria-label="Progress" />
            <span class="font-medium text-xs tabular-nums">@_progressPercent%</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex", msg.Role == "organizer" ? "justify-end" : "justify-start")">

                        @if (msg.Role == "system" && msg.Milestone == null && msg.Summary == null && !string.IsNullOrEmpty(msg.Content))
                        {
                            <div class="w-full text-center">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-muted/50 px-3 py-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                                    @msg.Content
                                </span>
                            </div>
                        }

                        @if (msg.Role == "system" && msg.Milestone != null)
                        {
                            var milestone = msg.Milestone;
                            <div class="w-full">
                                <div class="mt-2 rounded-md border border-amber-500/20 bg-amber-500/5 p-3">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="trophy" Size="16" Class="size-4 text-amber-500" />
                                        <span class="font-medium text-sm">@milestone.Label</span>
                                    </div>
                                    <div class="mt-1.5 flex items-center gap-2">
                                        <span class="font-semibold text-lg tabular-nums">@milestone.Amount</span>
                                        <span class="text-muted-foreground text-xs">raised</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (msg.Role == "system" && msg.Summary != null)
                        {
                            var summary = msg.Summary;
                            <div class="w-full">
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="target" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">Campaign Breakdown</span>
                                    </div>
                                    <div class="mb-3 flex items-center gap-4">
                                        <span class="flex items-center gap-1.5 text-xs">
                                            <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                                            @summary.TotalDonors donors
                                        </span>
                                        <span class="text-xs">
                                            <span class="text-muted-foreground">Avg: </span>
                                            <span class="tabular-nums">@summary.AverageDonation</span>
                                        </span>
                                        <span class="text-xs">
                                            <span class="text-muted-foreground">Top: </span>
                                            <span class="tabular-nums">@summary.TopDonation</span>
                                        </span>
                                    </div>
                                    <div class="space-y-0">
                                        <div class="flex items-center gap-2 border-b pb-1.5">
                                            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Source</span>
                                            <span class="w-20 text-right text-muted-foreground text-xs">Amount</span>
                                            <span class="w-10 text-right text-muted-foreground text-xs">%</span>
                                        </div>
                                        @foreach (var source in summary.Sources)
                                        {
                                            <div class="flex items-center gap-2 border-b py-1.5 last:border-b-0">
                                                <span class="min-w-0 flex-1 text-sm">@source.Name</span>
                                                <span class="w-20 text-right font-mono text-xs tabular-nums">@source.Amount</span>
                                                <span class="w-10 text-right font-mono text-muted-foreground text-xs tabular-nums">@source.Percentage%</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @if (msg.Role == "donation" && msg.Donation != null)
                        {
                            var donation = msg.Donation;
                            <div class="w-full">
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2 flex items-center gap-2.5">
                                        <AvatarCn Class="size-8">
                                            <AvatarFallbackCn Class="bg-muted text-xs">@donation.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <div class="min-w-0 flex-1">
                                            <span class="font-medium text-sm">@donation.Donor</span>
                                            <p class="text-muted-foreground text-xs">Donated</p>
                                        </div>
                                        <span class="font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                                            @donation.Amount
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(donation.Note))
                                    {
                                        <div class="rounded-md bg-muted/50 p-2.5">
                                            <p class="text-sm leading-relaxed italic">"@donation.Note"</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (msg.Role == "organizer")
                        {
                            <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground">
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                                <span class="mt-1 block text-right text-primary-foreground/60 text-xs">
                                    @msg.Timestamp
                                </span>
                            </div>
                        }

                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Post an update..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Post an update..." />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                          OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record DonationData(string Donor, string Initials, string Amount, string Note);
    private record MilestoneData(string Label, string Amount, int Percentage);
    private record DonationSource(string Name, string Amount, int Percentage);
    private record CampaignSummaryData(int TotalDonors, string AverageDonation, string TopDonation, DonationSource[] Sources);
    private record Message(string Id, string Role, string Content, string Timestamp,
        DonationData? Donation = null, MilestoneData? Milestone = null, CampaignSummaryData? Summary = null);
    private record CampaignData(string Name, int Goal, int Raised, int DonorCount, int DaysLeft);

    private static readonly CampaignData _campaign = new(
        Name: "Build a Community Library",
        Goal: 50000,
        Raised: 37250,
        DonorCount: 284,
        DaysLeft: 12
    );

    private int _progressPercent = (int)Math.Round((double)37250 / 50000 * 100);

    private List<Message> _messages =
    [
        new("1", "system", "Campaign update: 3 new donations received this morning.", "9:00 AM"),
        new("2", "donation", "", "8:45 AM",
            Donation: new DonationData("Rachel Green", "RG", "$250",
                "For the children's reading section. Books changed my life and I hope they change theirs too.")),
        new("3", "donation", "", "8:52 AM",
            Donation: new DonationData("Marcus Webb", "MW", "$100",
                "Happy to support. Every community deserves a great library.")),
        new("4", "donation", "", "8:58 AM",
            Donation: new DonationData("Anonymous", "A", "$500", "Keep up the great work.")),
        new("5", "system", "", "9:00 AM",
            Milestone: new MilestoneData("75% Goal Reached", "$37,250", 75)),
        new("6", "organizer",
            "Incredible progress! We just crossed 75% of our goal. Thank you to every single donor. Let's push for the finish line. Can someone pull up the campaign breakdown?",
            "9:05 AM"),
        new("7", "system", "", "9:06 AM",
            Summary: new CampaignSummaryData(284, "$131", "$2,500",
            [
                new DonationSource("Direct link", "$18,400", 49),
                new DonationSource("Social media", "$11,200", 30),
                new DonationSource("Email campaign", "$5,150", 14),
                new DonationSource("Partner referrals", "$2,500", 7),
            ])),
        new("8", "organizer",
            "Social media is performing well. Let's schedule another post this afternoon with the 75% milestone graphic. The email open rates have been strong too.",
            "9:08 AM"),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
