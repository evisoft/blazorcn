@* ============================================================
   Block: chat-vet-consultation
   Title: ChatVetConsultation
   Description: A veterinary consultation chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring pet profile cards, symptom checklist, and medical advice
   Source: original/blocks/chat/chat-vet-consultation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="paw-print" Size="16" Class="size-4 text-blue-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Vet Consultation</h2>
                    <p class="text-xs text-muted-foreground">Dr. Sarah Johnson, DVM</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="h-6 gap-1 text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Active
            </BadgeCn>
        </div>

        @* Pet Profile *@
        <div class="border-b p-4">
            <CardCn Class="p-3">
                <div class="flex items-start gap-3">
                    <AvatarCn Class="size-12 shrink-0">
                        <AvatarImageCn Src="@_petProfile.Photo" />
                        <AvatarFallbackCn Class="bg-blue-500/10 text-blue-700">
                            @(_petProfile.Name.Length > 0 ? _petProfile.Name[0].ToString() : "")
                        </AvatarFallbackCn>
                    </AvatarCn>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <h3 class="text-sm font-medium">@_petProfile.Name</h3>
                                <p class="text-xs text-muted-foreground">
                                    @_petProfile.Breed • @_petProfile.Age
                                </p>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-[10px]">
                                @_petProfile.Species
                            </BadgeCn>
                        </div>
                        <div class="mt-2 flex gap-4">
                            <div>
                                <p class="text-[10px] text-muted-foreground">Weight</p>
                                <p class="text-xs font-medium">@_petProfile.Weight</p>
                            </div>
                            <div>
                                <p class="text-[10px] text-muted-foreground">Last Visit</p>
                                <p class="text-xs font-medium">3 months ago</p>
                            </div>
                        </div>
                    </div>
                </div>
            </CardCn>
        </div>

        @* Symptom Checklist *@
        <div class="border-b p-4">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="clipboard-list" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Reported Symptoms</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var symptom in _symptoms.Take(4))
                {
                    <label class="flex items-center gap-2 rounded-md border bg-muted/30 px-2 py-1.5">
                        <CheckboxCn Checked="@symptom.Checked" Disabled="true" Class="size-3.5" />
                        <span class="text-xs">@symptom.Label</span>
                    </label>
                }
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    @if (message.Role == "system")
                    {
                        <div class="flex justify-center">
                            <div class="rounded-full bg-muted/50 px-3 py-1">
                                <p class="text-xs text-muted-foreground">@message.Content</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                            <AvatarCn Class="size-8 shrink-0">
                                @if (message.Role == "vet")
                                {
                                    <AvatarImageCn Src="/avatars/vet.jpg" />
                                    <AvatarFallbackCn Class="bg-blue-500/10 text-blue-700 text-xs">
                                        SJ
                                    </AvatarFallbackCn>
                                }
                                else
                                {
                                    <AvatarFallbackCn Class="bg-muted text-xs">You</AvatarFallbackCn>
                                }
                            </AvatarCn>
                            <div class="@Cn.Merge("flex max-w-[80%] flex-col gap-1.5", message.Role == "user" ? "items-end" : "")">
                                @if (message.MessageType == "advice")
                                {
                                    <div class="mb-1 flex items-center gap-1.5">
                                        <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-blue-600" />
                                        <span class="text-[10px] font-medium text-blue-600">
                                            Medical Advice
                                        </span>
                                    </div>
                                }
                                <div class="@(message.Role == "vet"
                                    ? (message.MessageType == "advice"
                                        ? "rounded-lg px-3 py-2 border border-blue-200 bg-blue-500/10"
                                        : "rounded-lg px-3 py-2 bg-muted/50")
                                    : "rounded-lg px-3 py-2 bg-blue-500/10 border border-blue-200")">
                                    <p class="text-sm leading-relaxed">@message.Content</p>
                                </div>
                                <p class="text-[10px] text-muted-foreground">@message.Timestamp</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Quick Actions *@
        <div class="border-t px-4 py-2">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1 text-xs">
                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                    Book Follow-up
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1 text-xs">
                    <LucideIconCn Name="clipboard-list" Size="12" Class="size-3" />
                    View Records
                </ButtonCn>
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input" Placeholder="Describe symptoms or ask questions..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Sm" Disabled="@(string.IsNullOrWhiteSpace(_input))" Class="gap-1.5" OnClick="HandleSend">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                    Send
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Pet(string Name, string Species, string Breed, string Age, string Weight, string Photo);

    private record Symptom(string Id, string Label, bool Checked);

    private record Message(string Id, string Role, string Content, string Timestamp, string? MessageType = null);

    private readonly Pet _petProfile = new("Max", "Dog", "Golden Retriever", "5 years", "32 kg", "/avatars/dog.jpg");

    private readonly Symptom[] _symptoms =
    [
        new("lethargy", "Lethargy or decreased energy", true),
        new("appetite", "Loss of appetite", true),
        new("vomiting", "Vomiting or nausea", false),
        new("diarrhea", "Diarrhea", false),
        new("coughing", "Coughing or sneezing", true),
        new("limping", "Limping or mobility issues", false),
    ];

    private List<Message> _messages =
    [
        new("1", "vet",
            "Hello! I'm Dr. Sarah Johnson. I see you're concerned about Max. Can you describe what symptoms you've noticed?",
            "3:00 PM"),
        new("2", "user",
            "Hi Dr. Johnson. Max has been really tired the past few days and isn't eating as much as usual. He also has a slight cough.",
            "3:02 PM"),
        new("3", "vet",
            "Thank you for that information. I've noted the symptoms in his chart. How long has the cough been present, and is it dry or does it produce mucus?",
            "3:03 PM"),
        new("4", "user",
            "The cough started about 3 days ago. It seems dry, mostly happens when he's active or excited.",
            "3:05 PM"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var userMsg = new Message(
            Id: DateTime.Now.Ticks.ToString(),
            Role: "user",
            Content: _input,
            Timestamp: "Just now");

        _messages = [.._messages, userMsg];
        _input = "";

        var vetResponse = new Message(
            Id: (DateTime.Now.Ticks + 1).ToString(),
            Role: "vet",
            Content: "Based on the symptoms, this could be kennel cough or a mild respiratory infection. I recommend bringing Max in for a physical examination to listen to his lungs.",
            Timestamp: "Just now",
            MessageType: "advice");

        _messages = [.._messages, vetResponse];
    }
}
