@* ============================================================
   Block: chat-channel-list
   Title: ChatChannelList
   Description: React channel browser and directory for Next.js with workspace header, collapsible sections, starred channels, direct messages with online status, unread indicators, create channel button, and search filter using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-channel-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Workspace header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <button type="button" class="flex items-center gap-1.5 transition-colors hover:text-muted-foreground">
                <span class="font-medium text-sm">Acme Inc</span>
                <LucideIconCn Name="chevron-down" Size="14" Class="size-3.5 text-muted-foreground" />
            </button>
            <div class="flex items-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3" />
                <span>48 members</span>
            </div>
        </div>

        @* Search *@
        <div class="border-b px-4 py-2">
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn @bind-Value="_search" Placeholder="Search channels..." Class="h-8 border-0 bg-muted/50 pl-8 text-sm shadow-none focus-visible:ring-0" aria-label="Search channels..." />
            </div>
        </div>

        @* Channel sections *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Channels">

            @* Starred *@
            @if (_filteredStarred.Length > 0)
            {
                <div>
                    <button type="button" @onclick="@(() => ToggleSection("starred"))"
                            class="flex w-full items-center gap-1.5 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", _expandedSections["starred"] ? "rotate-90" : "")" />
                        <LucideIconCn Name="star" Size="14" Class="size-3.5 text-amber-500" />
                        <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            Starred
                        </span>
                    </button>
                    @if (_expandedSections["starred"])
                    {
                        @foreach (var channel in _filteredStarred)
                        {
                            var ch = channel;
                            <button type="button" @onclick="@(() => _activeId = ch.Id)"
                                    class="@Cn.Merge("flex w-full items-center gap-2.5 py-1.5 pr-4 pl-9 text-left transition-colors hover:bg-muted/50", _activeId == ch.Id ? "bg-muted/50" : "")">
                                <LucideIconCn Name="hash" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                <span class="@Cn.Merge("flex-1 text-sm", ch.UnreadCount > 0 ? "font-semibold" : "font-normal")">
                                    @ch.Name
                                </span>
                                <span class="flex items-center gap-1 text-muted-foreground text-[10px]">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    @ch.Members
                                </span>
                                @if (ch.UnreadCount > 0)
                                {
                                    <BadgeCn Class="size-5 shrink-0 justify-center rounded-full px-0 text-[10px]">@ch.UnreadCount</BadgeCn>
                                }
                            </button>
                        }
                    }
                </div>
            }

            @* Channels *@
            @if (_filteredChannels.Length > 0)
            {
                <div class="mt-1">
                    <div class="flex items-center">
                        <button type="button" @onclick="@(() => ToggleSection("channels"))"
                                class="flex flex-1 items-center gap-1.5 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", _expandedSections["channels"] ? "rotate-90" : "")" />
                            <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                Channels
                            </span>
                            <span class="text-muted-foreground text-[10px]">@_filteredChannels.Length</span>
                        </button>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="mr-2 size-6" title="Create channel" aria-label="Add">
                            <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                    @if (_expandedSections["channels"])
                    {
                        @foreach (var channel in _filteredChannels)
                        {
                            var ch = channel;
                            <button type="button" @onclick="@(() => _activeId = ch.Id)"
                                    class="@Cn.Merge("flex w-full items-center gap-2.5 py-1.5 pr-4 pl-9 text-left transition-colors hover:bg-muted/50", _activeId == ch.Id ? "bg-muted/50" : "")">
                                <LucideIconCn Name="hash" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                <span class="@Cn.Merge("flex-1 text-sm", ch.UnreadCount > 0 ? "font-semibold" : "font-normal")">
                                    @ch.Name
                                </span>
                                @if (ch.UnreadCount > 0)
                                {
                                    <BadgeCn Class="size-5 shrink-0 justify-center rounded-full px-0 text-[10px]">@ch.UnreadCount</BadgeCn>
                                }
                            </button>
                        }
                    }
                </div>
            }

            @* Direct Messages *@
            @if (_filteredDms.Length > 0)
            {
                <div class="mt-1">
                    <button type="button" @onclick="@(() => ToggleSection("dms"))"
                            class="flex w-full items-center gap-1.5 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", _expandedSections["dms"] ? "rotate-90" : "")" />
                        <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            Direct Messages
                        </span>
                        <span class="text-muted-foreground text-[10px]">@_filteredDms.Length</span>
                    </button>
                    @if (_expandedSections["dms"])
                    {
                        @foreach (var message in _filteredDms)
                        {
                            var dm = message;
                            <button type="button" @onclick="@(() => _activeId = dm.Id)"
                                    class="@Cn.Merge("flex w-full items-center gap-2.5 py-1.5 pr-4 pl-9 text-left transition-colors hover:bg-muted/50", _activeId == dm.Id ? "bg-muted/50" : "")">
                                <div class="relative shrink-0">
                                    <AvatarCn>
                                        <AvatarFallbackCn Class="text-[10px]">@dm.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    @if (dm.IsOnline)
                                    {
                                        <span class="absolute right-0 bottom-0 size-2 rounded-full border border-card bg-emerald-500"></span>
                                    }
                                </div>
                                <span class="@Cn.Merge("flex-1 text-sm", dm.UnreadCount > 0 ? "font-semibold" : "font-normal")">
                                    @dm.Name
                                </span>
                                @if (dm.UnreadCount > 0)
                                {
                                    <BadgeCn Class="size-5 shrink-0 justify-center rounded-full px-0 text-[10px]">@dm.UnreadCount</BadgeCn>
                                }
                            </button>
                        }
                    }
                </div>
            }

            @if (_filteredStarred.Length == 0 && _filteredChannels.Length == 0 && _filteredDms.Length == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No channels found
                </div>
            }

        </div>
    </div>
</section>

@code {
    private record Channel(string Id, string Name, int Members, int UnreadCount);
    private record DirectMessage(string Id, string Name, string Initials, bool IsOnline, int UnreadCount);

    private string _search = "";
    private string _activeId = "s1";

    private Dictionary<string, bool> _expandedSections = new()
    {
        ["starred"] = true,
        ["channels"] = true,
        ["dms"] = true,
    };

    private static readonly Channel[] _starredChannels =
    [
        new("s1", "engineering",   42, 8),
        new("s2", "design-system", 18, 3),
        new("s3", "incidents",     56, 0),
    ];

    private static readonly Channel[] _channels =
    [
        new("c1", "general",       128, 12),
        new("c2", "frontend",       34,  0),
        new("c3", "backend",        29,  5),
        new("c4", "devops",         15,  0),
        new("c5", "product",        22,  0),
        new("c6", "random",         96,  2),
        new("c7", "announcements", 128,  1),
    ];

    private static readonly DirectMessage[] _directMessages =
    [
        new("d1", "Mara Chen",     "MC", true,  2),
        new("d2", "Alex Rivera",   "AR", true,  0),
        new("d3", "Jordan Davis",  "JD", false, 0),
        new("d4", "Priya Sharma",  "PS", true,  1),
        new("d5", "Sam Nguyen",    "SN", false, 0),
    ];

    private Channel[] _filteredStarred =>
        _starredChannels.Where(c => c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();

    private Channel[] _filteredChannels =>
        _channels.Where(c => c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();

    private DirectMessage[] _filteredDms =>
        _directMessages.Where(d => d.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();

    private void ToggleSection(string key)
    {
        _expandedSections[key] = !_expandedSections[key];
    }
}
