@* ============================================================
   Block: chat-wedding-planner
   Title: ChatWeddingPlanner
   Description: A wedding planning chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring vendor cards, budget tracker, and timeline management
   Source: original/blocks/chat/chat-wedding-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-pink-500/10">
                    <LucideIconCn Name="heart" Size="16" Class="size-4 text-pink-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Emma &amp; James Wedding</h2>
                    <p class="text-xs text-muted-foreground">Sarah Williams • Wedding Planner</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="h-6 gap-1 text-xs">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                Aug 15, 2026
            </BadgeCn>
        </div>

        @* Budget Overview *@
        <div class="border-b p-4">
            <div class="mb-2 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-emerald-600" />
                    <span class="text-xs font-medium">Budget Overview</span>
                </div>
                <span class="text-xs text-muted-foreground">
                    $@_totalSpent.ToString("N0") of $@_totalBudget.ToString("N0")
                </span>
            </div>
            <ProgressCn Value="@((double)_totalSpent / _totalBudget * 100)" Class="mb-3 h-2" aria-label="Progress" />
            <div class="grid grid-cols-2 gap-2">
                @foreach (var cat in _budgetCategories)
                {
                    var category = cat;
                    <div class="flex items-center gap-2 rounded-md bg-muted/30 px-2 py-1.5">
                        <div class="@Cn.Merge("size-2 shrink-0 rounded-full", category.Color)"></div>
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">@category.Name</p>
                            <p class="text-[10px] text-muted-foreground">
                                $@category.Spent.ToString("N0") / $@category.Allocated.ToString("N0")
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                var msg = message;
                @if (msg.Role == "system")
                {
                    <div class="flex justify-center">
                        <div class="rounded-full bg-muted/50 px-3 py-1">
                            <p class="text-xs text-muted-foreground">@msg.Content</p>
                        </div>
                    </div>
                }
                else
                {
                    <div>
                        <div class="@Cn.Merge("flex gap-3", msg.Role == "client" ? "flex-row-reverse" : "")">
                            <AvatarCn Class="size-8 shrink-0">
                                @if (msg.Role == "planner")
                                {
                                    <AvatarImageCn Src="@msg.SenderAvatar" Alt="" />
                                    <AvatarFallbackCn Class="bg-pink-500/10 text-pink-700 text-xs">SW</AvatarFallbackCn>
                                }
                                else
                                {
                                    <AvatarFallbackCn Class="bg-muted text-xs">You</AvatarFallbackCn>
                                }
                            </AvatarCn>
                            <div class="@Cn.Merge("flex max-w-[80%] flex-col gap-1.5", msg.Role == "client" ? "items-end" : "")">
                                <div class="flex items-center gap-2">
                                    <p class="text-xs font-medium">@msg.Sender</p>
                                    @if (msg.Role == "planner")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 text-[10px]">Planner</BadgeCn>
                                    }
                                </div>
                                <div class="@Cn.Merge("rounded-lg px-3 py-2", msg.Role == "planner" ? "bg-muted/50" : "bg-pink-500/10 border border-pink-200")">
                                    <p class="text-sm leading-relaxed">@msg.Content</p>
                                </div>
                                <p class="text-[10px] text-muted-foreground">@msg.Timestamp</p>
                            </div>
                        </div>

                        @* Vendor Cards *@
                        @if (msg.Type == "vendor")
                        {
                            <div class="ml-11 mt-3 space-y-2">
                                @foreach (var vendor in _vendors.Take(2))
                                {
                                    var v = vendor;
                                    <CardCn Class="p-3">
                                        <div class="flex items-start gap-3">
                                            <AvatarCn Class="size-10 shrink-0">
                                                <AvatarImageCn Src="@v.Avatar" Alt="" />
                                                <AvatarFallbackCn Class="text-xs">@v.Name.Substring(0, 2)</AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div>
                                                        <p class="text-sm font-medium">@v.Name</p>
                                                        <p class="text-xs text-muted-foreground">@v.Category</p>
                                                    </div>
                                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-5 text-[10px]", v.Status == "booked" ? "border-emerald-200 bg-emerald-500/10 text-emerald-700" : v.Status == "pending" ? "border-amber-200 bg-amber-500/10 text-amber-700" : "border-blue-200 bg-blue-500/10 text-blue-700")">
                                                        @if (v.Status == "booked")
                                                        {
                                                            <LucideIconCn Name="check-circle-2" Size="10" Class="mr-0.5 size-2.5" />
                                                        }
                                                        @(char.ToUpper(v.Status[0]) + v.Status.Substring(1))
                                                    </BadgeCn>
                                                </div>
                                                <div class="mt-2 flex items-center justify-between">
                                                    <span class="text-sm font-semibold">@v.Price</span>
                                                    @if (v.Status == "quoted")
                                                    {
                                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 text-xs">Book Now</ButtonCn>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </CardCn>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* Timeline Preview *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-2 overflow-x-auto">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 shrink-0 text-pink-600" />
                <span class="shrink-0 text-xs text-muted-foreground">Upcoming:</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 shrink-0 gap-1 text-[10px]">
                    <LucideIconCn Name="map-pin" Size="10" Class="size-2.5" />
                    Venue visit - Tomorrow
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 shrink-0 gap-1 text-[10px]">
                    <LucideIconCn Name="calendar" Size="10" Class="size-2.5" />
                    Cake tasting - Friday
                </BadgeCn>
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Ask about vendors, budget, or timeline..."
                    Class="flex-1"
                    @onkeydown="@HandleKeyDown" aria-label="Ask about vendors, budget, or timeline..." />
                <ButtonCn Size="ButtonSize.Sm" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSend" Class="gap-1.5">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                    Send
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Vendor(string Name, string Category, string Price, string Status, string Avatar);
    private record BudgetCategory(string Name, int Allocated, int Spent, string Color);
    private record Message(string Id, string Role, string? Sender, string? SenderAvatar, string Content, string Timestamp, string? Type = null);

    private static readonly Vendor[] _vendors =
    [
        new("Sunset Gardens",    "Venue",       "$8,500", "booked",  "https://i.pravatar.cc/150?img=50"),
        new("Bella Catering",    "Catering",    "$6,200", "booked",  "https://i.pravatar.cc/150?img=20"),
        new("Emma Photography",  "Photography", "$3,800", "pending", "https://i.pravatar.cc/150?img=66"),
        new("Harmony Strings",   "Music",       "$2,100", "quoted",  "https://i.pravatar.cc/150?img=40"),
    ];

    private static readonly BudgetCategory[] _budgetCategories =
    [
        new("Venue",       9000, 8500, "bg-purple-500"),
        new("Catering",    7000, 6200, "bg-blue-500"),
        new("Photography", 4000, 0,    "bg-emerald-500"),
        new("Music",       2500, 0,    "bg-amber-500"),
    ];

    private int _totalBudget => _budgetCategories.Sum(c => c.Allocated);
    private int _totalSpent  => _budgetCategories.Sum(c => c.Spent);

    private List<Message> _messages =
    [
        new("1", "planner", "Sarah Williams", "https://i.pravatar.cc/150?img=50",
            "Hi Emma and James! Congratulations on your engagement! I'm thrilled to help plan your special day. Shall we start by discussing your vision and budget?",
            "Yesterday"),
        new("2", "client", "Emma", null,
            "Thank you! We're thinking of a garden wedding in late summer, around 150 guests. Our budget is approximately $30,000.",
            "Yesterday"),
        new("3", "planner", "Sarah Williams", "https://i.pravatar.cc/150?img=50",
            "Perfect! I've created a budget breakdown and found some amazing vendors. Sunset Gardens has availability for August 15th - I've included the details below.",
            "2 hours ago", "vendor"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new Message(
            Id: DateTime.UtcNow.Ticks.ToString(),
            Role: "client",
            Sender: "You",
            SenderAvatar: null,
            Content: _input,
            Timestamp: "Just now"
        );

        _messages = [.._messages, newMessage];
        _input = "";

        var response = new Message(
            Id: (DateTime.UtcNow.Ticks + 1).ToString(),
            Role: "planner",
            Sender: "Sarah Williams",
            SenderAvatar: "https://i.pravatar.cc/150?img=50",
            Content: "Great choice! Let me reach out to them and get back to you with confirmation details.",
            Timestamp: "Just now"
        );
        _messages = [.._messages, response];
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSend();
    }
}
