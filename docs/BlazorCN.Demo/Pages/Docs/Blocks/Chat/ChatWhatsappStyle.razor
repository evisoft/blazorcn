@* ============================================================
   Block: chat-whatsapp-style
   Title: ChatWhatsappStyle
   Description: React WhatsApp-inspired chat interface for Next.js with green sent bubbles, white received bubbles, double-check read receipts, wallpaper background, and in-bubble timestamps using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-whatsapp-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header with green tint *@
        <div class="flex items-center gap-3 border-b bg-emerald-50 px-4 py-2.5 dark:bg-emerald-950/20">
            <AvatarCn Class="size-9">
                <AvatarFallbackCn Class="bg-emerald-200 text-emerald-700 text-xs dark:bg-emerald-800 dark:text-emerald-200">MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Mia Chen</span>
                <p class="text-muted-foreground text-xs">last seen today at 10:41 AM</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 text-muted-foreground hover:text-foreground" aria-label="Video">
                    <LucideIconCn Name="video" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 text-muted-foreground hover:text-foreground" aria-label="Call">
                    <LucideIconCn Name="phone" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Messages with wallpaper pattern *@
        <div class="flex flex-1 flex-col gap-1 overflow-y-auto px-3 py-3" tabindex="0" role="group" aria-label="Messages"
             style="background-image:radial-gradient(circle, rgb(0 0 0 / 0.04) 1px, transparent 1px);background-size:16px 16px;">
            @* Today date pill *@
            <div class="mb-2 flex justify-center">
                <span class="rounded-full bg-muted/80 px-3 py-1 text-muted-foreground text-[10px]">Today</span>
            </div>

            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var idx = i;
                var isMe = msg.Sender == "me";
                var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                var showGap = prevMsg != null && prevMsg.Sender != msg.Sender;

                var outerClass = Cn.Merge(
                    "flex",
                    isMe ? "justify-end" : "justify-start",
                    showGap ? "mt-2" : ""
                );

                var bubbleClass = Cn.Merge(
                    "relative max-w-[75%] rounded-lg px-2.5 pb-1 pt-1.5 shadow-sm",
                    isMe
                        ? "rounded-br-sm bg-emerald-100 dark:bg-emerald-900/30"
                        : "rounded-bl-sm bg-white dark:bg-zinc-800"
                );

                <div class="@outerClass">
                    <div class="@bubbleClass">
                        <span class="text-sm leading-relaxed">@msg.Content</span>
                        <span class="ml-3 inline-flex items-center gap-1 align-bottom">
                            <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                            @if (isMe)
                            {
                                @if (msg.Status == "sent")
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-muted-foreground/60" />
                                }
                                else if (msg.Status == "delivered")
                                {
                                    <LucideIconCn Name="check-check" Size="12" Class="size-3 text-muted-foreground/60" />
                                }
                                else if (msg.Status == "read")
                                {
                                    <LucideIconCn Name="check-check" Size="12" Class="size-3 text-blue-500" />
                                }
                            }
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Input with green tint *@
        <div class="border-t bg-emerald-50/50 px-3 py-2.5 dark:bg-emerald-950/10">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Emoji">
                    <LucideIconCn Name="smile" Size="20" Class="size-5" />
                </ButtonCn>
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Attach file">
                    <LucideIconCn Name="paperclip" Size="20" Class="size-5" />
                </ButtonCn>
                <input @bind="_input"
                       @bind:event="oninput"
                       placeholder="Type a message"
                       class="h-9 flex-1 rounded-full border-0 bg-white px-4 text-sm shadow-sm focus-visible:ring-0 dark:bg-zinc-800 outline-none" aria-label="Type a message" />
                @if (!string.IsNullOrWhiteSpace(_input))
                {
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Class="size-9 shrink-0 rounded-full bg-emerald-600 text-white hover:bg-emerald-700" aria-label="Send">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn type="button" Size="ButtonSize.Icon" Class="size-9 shrink-0 rounded-full bg-emerald-600 text-white hover:bg-emerald-700" aria-label="Microphone">
                        <LucideIconCn Name="mic" Size="16" Class="size-4" />
                    </ButtonCn>
                }
            </form>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Content, string Sender, string Timestamp, string? Status = null);

    private string _input = "";

    private static readonly Message[] _messages =
    [
        new("1", "Hey! Are we still meeting at 3 for the design review?", "them", "10:22 AM"),
        new("2", "Yes! I just finished updating the mockups. Want me to share my screen?", "me", "10:23 AM", "read"),
        new("3", "That would be great. I also invited Leo so he can give feedback on the interaction patterns.", "them", "10:24 AM"),
        new("4", "Perfect, the more eyes the better. I reworked the onboarding flow based on the usability test results.", "me", "10:25 AM", "read"),
        new("5", "Oh nice, what were the main findings?", "them", "10:26 AM"),
        new("6", "Users were getting confused at step 3 where they need to connect their workspace. The CTA wasn't clear enough.", "me", "10:27 AM", "read"),
        new("7", "Makes sense. The button label was pretty vague. Did you change the copy too?", "them", "10:28 AM"),
        new("8", "Yep, changed it from \"Continue\" to \"Connect Workspace\" with a small illustration. Completion rate went up 23% in our A/B test.", "me", "10:30 AM", "read"),
        new("9", "That's a huge improvement! Can't wait to see it.", "them", "10:31 AM"),
        new("10", "I'll have the Figma link ready in the meeting. See you at 3!", "me", "10:32 AM", "delivered"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
