@* ============================================================
   Block: chat-developer-console
   Title: ChatDeveloperConsole
   Description: React developer API debug chat block for Next.js with monospace font, JSON code blocks, request-response pairs, HTTP status codes, and ISO timestamps using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-developer-console.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950">
        @* Header *@
        <div class="flex items-center gap-2 border-zinc-800 border-b px-4 py-3">
            <LucideIconCn Name="terminal" Size="16" Class="size-4 text-zinc-500" />
            <span class="font-medium font-mono text-sm text-zinc-200">API Console</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="border-0 bg-zinc-800 font-mono text-[10px] text-zinc-400">
                @_entries.Length requests
            </BadgeCn>
            <div class="ml-auto flex items-center gap-2">
                <span class="flex items-center gap-1 text-xs text-zinc-500">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_entries.Count(e => e.Status < 300)
                </span>
                <span class="flex items-center gap-1 text-xs text-zinc-500">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_entries.Count(e => e.Status >= 400 && e.Status < 500)
                </span>
                <span class="flex items-center gap-1 text-xs text-zinc-500">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_entries.Count(e => e.Status >= 500)
                </span>
            </div>
        </div>

        @* Entries *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var index = i;
                <div class="@(index < _entries.Length - 1 ? "border-zinc-800/60 border-b" : "")">
                    @* Entry header *@
                    <div class="flex items-center gap-2 px-4 py-2.5">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("h-5 px-1.5 font-mono text-[10px]", MethodColor(entry.Method))">
                            @entry.Method
                        </BadgeCn>
                        <span class="min-w-0 flex-1 truncate font-mono text-xs text-zinc-400">
                            @entry.Endpoint
                        </span>
                        <span class="@Cn.Merge("shrink-0 font-medium font-mono text-xs tabular-nums", StatusColor(entry.Status))">
                            @entry.Status
                        </span>
                        <span class="shrink-0 font-mono text-[10px] text-zinc-600 tabular-nums">
                            @entry.Duration
                        </span>
                    </div>

                    @* Timestamp *@
                    <div class="px-4 pb-1">
                        <span class="font-mono text-[10px] text-zinc-700">@entry.Timestamp</span>
                    </div>

                    @* Request body *@
                    @if (entry.RequestBody != null)
                    {
                        <div class="px-4 pb-2">
                            <div class="overflow-hidden rounded-md bg-zinc-900">
                                <div class="flex items-center justify-between px-3 py-1.5">
                                    <span class="font-mono text-[10px] text-zinc-600">REQUEST</span>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                              Class="h-5 gap-1 px-1.5 text-[10px] text-zinc-600 hover:bg-zinc-800 hover:text-zinc-300"
                                              OnClick="@(() => CopyPayload($"req-{entry.Id}", entry.RequestBody))">
                                        @if (_copied == $"req-{entry.Id}")
                                        {
                                            <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                            <span>Copied</span>
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="copy" Size="10" Class="size-2.5" />
                                            <span>Copy</span>
                                        }
                                    </ButtonCn>
                                </div>
                                <pre class="overflow-x-auto px-3 pb-3 font-mono text-xs text-zinc-300 leading-relaxed"><code>@entry.RequestBody</code></pre>
                            </div>
                        </div>
                    }

                    @* Response body *@
                    <div class="px-4 pb-3">
                        <div class="overflow-hidden rounded-md bg-zinc-900">
                            <div class="flex items-center justify-between px-3 py-1.5">
                                <span class="font-mono text-[10px] text-zinc-600">RESPONSE</span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="h-5 gap-1 px-1.5 text-[10px] text-zinc-600 hover:bg-zinc-800 hover:text-zinc-300"
                                          OnClick="@(() => CopyPayload($"res-{entry.Id}", entry.ResponseBody))">
                                    @if (_copied == $"res-{entry.Id}")
                                    {
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                        <span>Copied</span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="10" Class="size-2.5" />
                                        <span>Copy</span>
                                    }
                                </ButtonCn>
                            </div>
                            <pre class="overflow-x-auto px-3 pb-3 font-mono text-xs text-zinc-300 leading-relaxed"><code>@entry.ResponseBody</code></pre>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-zinc-800 border-t px-4 py-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <span class="shrink-0 font-mono text-xs text-zinc-600">$</span>
                <InputCn @bind-Value="_input"
                         Placeholder="Enter API endpoint or command..."
                         Class="h-8 flex-1 border-0 bg-transparent font-mono text-xs text-zinc-300 shadow-none placeholder:text-zinc-700 focus-visible:ring-0" aria-label="Enter API endpoint or command..." />
                <ButtonCn Type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))"
                          Class="size-8 shrink-0 text-zinc-600 hover:text-zinc-300" aria-label="Send">
                    <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ApiEntry(
        string Id,
        string Method,
        string Endpoint,
        string Timestamp,
        int Status,
        string ResponseBody,
        string Duration,
        string? RequestBody = null
    );

    private static string MethodColor(string method) => method switch
    {
        "GET"    => "bg-blue-500/10 text-blue-400 border-0",
        "POST"   => "bg-emerald-500/10 text-emerald-400 border-0",
        "PUT"    => "bg-amber-500/10 text-amber-400 border-0",
        "DELETE" => "bg-red-500/10 text-red-400 border-0",
        _        => ""
    };

    private static string StatusColor(int code)
    {
        if (code >= 200 && code < 300) return "text-emerald-400";
        if (code >= 400 && code < 500) return "text-amber-400";
        return "text-red-400";
    }

    private static readonly ApiEntry[] _entries =
    [
        new(
            Id: "1",
            Method: "POST",
            Endpoint: "/api/auth/login",
            Timestamp: "2026-03-28T14:22:01Z",
            Status: 200,
            RequestBody: """
{
  "email": "dev@@acme.com",
  "password": "********"
}
""",
            ResponseBody: """
{
  "token": "eyJhbGciOiJIUzI1NiIs...",
  "user": {
    "id": "usr_7k2m",
    "role": "admin"
  },
  "expiresIn": 3600
}
""",
            Duration: "124ms"
        ),
        new(
            Id: "2",
            Method: "GET",
            Endpoint: "/api/users?limit=10&offset=0",
            Timestamp: "2026-03-28T14:22:05Z",
            Status: 200,
            ResponseBody: """
{
  "data": [
    {
      "id": "usr_7k2m",
      "name": "Alex Rivera",
      "status": "active"
    },
    {
      "id": "usr_9p4n",
      "name": "Jordan Kim",
      "status": "active"
    }
  ],
  "total": 47,
  "hasMore": true
}
""",
            Duration: "89ms"
        ),
        new(
            Id: "3",
            Method: "PUT",
            Endpoint: "/api/users/usr_9p4n",
            Timestamp: "2026-03-28T14:22:12Z",
            Status: 400,
            RequestBody: """
{
  "role": "superadmin"
}
""",
            ResponseBody: """
{
  "error": "INVALID_ROLE",
  "message": "Role 'superadmin' is not a valid role. Allowed: admin, member, viewer",
  "field": "role"
}
""",
            Duration: "34ms"
        ),
        new(
            Id: "4",
            Method: "DELETE",
            Endpoint: "/api/sessions/bulk",
            Timestamp: "2026-03-28T14:22:18Z",
            Status: 500,
            RequestBody: """
{
  "sessionIds": [
    "sess_a1",
    "sess_b2",
    "sess_c3"
  ]
}
""",
            ResponseBody: """
{
  "error": "INTERNAL_ERROR",
  "message": "Connection to session store timed out after 5000ms",
  "requestId": "req_x8f2k9"
}
""",
            Duration: "5012ms"
        ),
    ];

    private string _input = "";
    private string? _copied = null;

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private void CopyPayload(string id, string text)
    {
        // Clipboard write is intentionally omitted (no JS interop needed for static demo)
        _copied = id;
    }
}
