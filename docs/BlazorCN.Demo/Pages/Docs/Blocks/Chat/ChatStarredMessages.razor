@* ============================================================
   Block: chat-starred-messages
   Title: ChatStarredMessages
   Description: React chat block with starred and favorite messages for Next.js featuring star toggle on messages, yellow star indicators, starred messages panel, and filterable bookmarks using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-starred-messages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Left: Chat *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Header *@
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <span class="font-medium text-sm">Engineering</span>
                <span class="text-muted-foreground text-xs">Sprint Channel</span>
                <div class="ml-auto flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1.5 px-2 text-xs text-muted-foreground hover:text-foreground"
                              @onclick="@(() => _showStarredPanel = !_showStarredPanel)">
                        <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", StarredMessages.Any() ? "fill-amber-400 text-amber-400" : "")" />
                        <span>@StarredMessages.Count() starred</span>
                    </ButtonCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        3 members
                    </BadgeCn>
                </div>
            </div>

            @* Messages *@
            <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
                <div class="flex flex-col">
                    @{
                        var msgList = _messages.ToList();
                    }
                    @foreach (var msg in msgList)
                    {
                        var message = msg;
                        var msgIdx = msgList.IndexOf(message);
                        var isLast = msgIdx == msgList.Count - 1;
                        <div class="@Cn.Merge("group", !isLast ? "border-b" : "")">
                            <div class="px-4 py-3">
                                <div class="mb-1.5 flex items-center gap-2">
                                    <AvatarCn Class="size-5">
                                        <AvatarFallbackCn Class="font-medium text-[10px]">@message.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <span class="font-medium text-sm">@message.Sender</span>
                                    <span class="text-muted-foreground text-xs">@message.Time</span>
                                    <button type="button"
                                            @onclick="@(() => ToggleStar(message.Id))"
                                            class="@Cn.Merge("ml-auto transition-opacity", message.IsStarred ? "opacity-100" : "opacity-0 group-hover:opacity-100")" aria-label="Star message">
                                        <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5 transition-colors", message.IsStarred ? "fill-amber-400 text-amber-400" : "text-muted-foreground hover:text-amber-400")" />
                                    </button>
                                </div>
                                <div class="pl-7 text-sm leading-relaxed">@message.Content</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Input *@
            <div class="border-t px-4 py-3">
                <form class="relative" @onsubmit="HandleSubmit">
                    <TextareaCn @bind-Value="_input"
                                Placeholder="Type a message..."
                                Class="min-h-0 max-h-32 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Type a message..." />
                    <ButtonCn type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Send message">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </form>
            </div>
        </div>

        @* Right: Starred panel *@
        @if (_showStarredPanel)
        {
            <div class="w-72 shrink-0 border-l bg-card">
                <div class="flex h-full flex-col">
                    @* Panel header *@
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-400 text-amber-400" />
                        <span class="font-medium text-xs">Starred Messages</span>
                        <span class="text-muted-foreground text-[10px]">@StarredMessages.Count()</span>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Icon"
                                  Class="ml-auto size-6 text-muted-foreground hover:text-foreground"
                                  @onclick="@(() => _showStarredPanel = false)" aria-label="Close">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>

                    @* Starred list *@
                    <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Starred messages">
                        @{
                            var starredList = StarredMessages.ToList();
                        }
                        @if (starredList.Count == 0)
                        {
                            <div class="flex flex-col items-center justify-center px-4 py-8 text-center">
                                <LucideIconCn Name="star" Size="20" Class="mb-2 size-5 text-muted-foreground/40" />
                                <p class="text-muted-foreground text-xs">No starred messages yet</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var msg in starredList)
                            {
                                var starred = msg;
                                var starIdx = starredList.IndexOf(starred);
                                var starIsLast = starIdx == starredList.Count - 1;
                                <div class="@Cn.Merge("px-3 py-2.5 transition-colors hover:bg-muted/50", !starIsLast ? "border-b" : "")">
                                    <div class="mb-1 flex items-center gap-2">
                                        <AvatarCn Class="size-4">
                                            <AvatarFallbackCn Class="font-medium text-[8px]">@starred.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <span class="font-medium text-[11px]">@starred.Sender</span>
                                        <span class="text-muted-foreground text-[10px]">@starred.Time</span>
                                    </div>
                                    <p class="line-clamp-2 pl-6 text-muted-foreground text-xs leading-relaxed">@starred.Content</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private class ChatMsg
    {
        public string Id { get; init; } = "";
        public string Sender { get; init; } = "";
        public string Initials { get; init; } = "";
        public string Content { get; init; } = "";
        public string Time { get; init; } = "";
        public bool IsStarred { get; set; }
    }

    private string _input = "";
    private bool _showStarredPanel = false;

    private List<ChatMsg> _messages =
    [
        new() { Id = "m1",  Sender = "Priya Sharma",  Initials = "PS", Content = "Sprint retro notes: We are adopting trunk-based development starting next sprint. All feature branches must be short-lived, max 2 days.",                                                                Time = "9:00 AM",  IsStarred = true  },
        new() { Id = "m2",  Sender = "Alex Chen",     Initials = "AC", Content = "Sounds good. I will update the CI pipeline to enforce branch age limits. Any branches older than 48 hours will get a warning.",                                                                          Time = "9:04 AM"  },
        new() { Id = "m3",  Sender = "Jordan Ellis",  Initials = "JE", Content = "New staging URL: staging-v3.acmecorp.dev. Credentials are in the shared vault under 'Staging V3 March'. Please bookmark this.",                                                                          Time = "9:10 AM",  IsStarred = true  },
        new() { Id = "m4",  Sender = "Priya Sharma",  Initials = "PS", Content = "Thanks Jordan. Also, the design system tokens have been updated. New spacing scale is documented at design.acmecorp.dev/tokens.",                                                                        Time = "9:15 AM",  IsStarred = true  },
        new() { Id = "m5",  Sender = "Alex Chen",     Initials = "AC", Content = "Quick question: are we keeping the old 4px base unit or switching to the new 8px grid?",                                                                                                                Time = "9:18 AM"  },
        new() { Id = "m6",  Sender = "Jordan Ellis",  Initials = "JE", Content = "Switching to 8px grid. Migration guide is in the tokens page. Most components just need their padding values doubled.",                                                                                  Time = "9:20 AM"  },
        new() { Id = "m7",  Sender = "Priya Sharma",  Initials = "PS", Content = "Deadline reminder: API v3 migration must be complete by April 4th. Any endpoints still on v2 after that date will be deprecated without notice.",                                                        Time = "9:28 AM",  IsStarred = true  },
        new() { Id = "m8",  Sender = "Alex Chen",     Initials = "AC", Content = "I have 3 endpoints left to migrate. Should be done by Wednesday. Jordan, what is your status?",                                                                                                          Time = "9:32 AM"  },
        new() { Id = "m9",  Sender = "Jordan Ellis",  Initials = "JE", Content = "All my endpoints are migrated and tested. I can help review your PRs once they are up, Alex.",                                                                                                           Time = "9:35 AM"  },
        new() { Id = "m10", Sender = "Priya Sharma",  Initials = "PS", Content = "Great teamwork. Let us sync again Thursday morning to confirm everything is on track.",                                                                                                                  Time = "9:40 AM"  },
    ];

    private IEnumerable<ChatMsg> StarredMessages => _messages.Where(m => m.IsStarred);

    private void ToggleStar(string id)
    {
        var msg = _messages.FirstOrDefault(m => m.Id == id);
        if (msg is not null)
            msg.IsStarred = !msg.IsStarred;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
