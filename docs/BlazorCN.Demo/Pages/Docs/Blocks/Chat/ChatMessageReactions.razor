@* ============================================================
   Block: chat-message-reactions
   Title: ChatMessageReactions
   Description: React chat block with interactive emoji reactions for Next.js featuring clickable reaction pills with counts, quick-pick emoji bar on hover, and toggle-your-reaction state using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-message-reactions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">JP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Jordan Park</span>
                <p class="text-muted-foreground text-xs">6 participants in thread</p>
            </div>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Online
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var grp in _grouped)
            {
                var group = grp;
                <div class="px-2">
                    @* Primary message *@
                    @{
                        var firstMsg = group.Msgs[0];
                        var firstMsgId = firstMsg.Id;
                    }
                    <div class="relative"
                         @onmouseenter="@(() => _hoveredMsg = firstMsgId)"
                         @onmouseleave="@(() => { _hoveredMsg = null; if (_pickerOpen == firstMsgId) _pickerOpen = null; })">
                        <div class="@Cn.Merge("flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent")">
                            <AvatarCn Class="mt-0.5 size-8 shrink-0">
                                <AvatarFallbackCn Class="text-xs">@group.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="font-medium text-sm">@group.Sender</span>
                                    <span class="text-muted-foreground text-xs">@firstMsg.Time</span>
                                </div>
                                <p class="text-sm leading-relaxed">@firstMsg.Content</p>

                                @* Reaction pills *@
                                @if (firstMsg.Reactions.Count > 0)
                                {
                                    <div class="mt-1 flex flex-wrap items-center gap-1">
                                        @foreach (var reaction in firstMsg.Reactions)
                                        {
                                            var r = reaction;
                                            var capturedId = firstMsgId;
                                            <button type="button"
                                                    @onclick="@(() => ToggleReaction(capturedId, r.Emoji))"
                                                    class="@Cn.Merge("inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs transition-colors hover:bg-muted", r.Reacted ? "border-blue-500/30 bg-blue-500/10" : "")">
                                                <span class="text-sm leading-none">@r.Emoji</span>
                                                <span class="font-medium text-muted-foreground tabular-nums">@r.Count</span>
                                            </button>
                                        }
                                        @{
                                            var capturedId0 = firstMsgId;
                                        }
                                        <button type="button"
                                                @onclick="@(() => _pickerOpen = (_pickerOpen == capturedId0 ? null : capturedId0))"
                                                class="inline-flex size-6 items-center justify-center rounded-full border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                                            <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                        </button>
                                    </div>
                                }

                                @* Quick emoji bar on hover (when no reactions yet) *@
                                @if (firstMsg.Reactions.Count == 0 && _hoveredMsg == firstMsgId)
                                {
                                    var capturedId1 = firstMsgId;
                                    <div class="mt-1">
                                        <button type="button"
                                                @onclick="@(() => _pickerOpen = (_pickerOpen == capturedId1 ? null : capturedId1))"
                                                class="inline-flex size-6 items-center justify-center rounded-full border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                                            <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Emoji picker dropdown *@
                        @if (_pickerOpen == firstMsgId)
                        {
                            var capturedId2 = firstMsgId;
                            <div class="absolute right-4 z-10 mt-1 flex items-center gap-0.5 rounded-full border bg-card p-1 shadow-sm">
                                @foreach (var qe in _quickEmojis)
                                {
                                    var emoji = qe;
                                    <button type="button"
                                            @onclick="@(() => ToggleReaction(capturedId2, emoji))"
                                            class="flex size-7 items-center justify-center rounded-full text-sm transition-all hover:scale-125 hover:bg-muted">
                                        @emoji
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* Additional messages in the group *@
                    @for (var ai = 1; ai < group.Msgs.Count; ai++)
                    {
                        var addMsg = group.Msgs[ai];
                        var addMsgId = addMsg.Id;
                        <div class="relative"
                             @onmouseenter="@(() => _hoveredMsg = addMsgId)"
                             @onmouseleave="@(() => { _hoveredMsg = null; if (_pickerOpen == addMsgId) _pickerOpen = null; })">
                            <div class="group flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent">
                                <div class="flex w-8 shrink-0 items-start justify-center">
                                    <span class="hidden pt-1 text-muted-foreground text-[10px] group-hover:block">
                                        @addMsg.Time
                                    </span>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm leading-relaxed">@addMsg.Content</p>

                                    @* Reaction pills *@
                                    @if (addMsg.Reactions.Count > 0)
                                    {
                                        <div class="mt-1 flex flex-wrap items-center gap-1">
                                            @foreach (var reaction in addMsg.Reactions)
                                            {
                                                var r = reaction;
                                                var capturedAddId = addMsgId;
                                                <button type="button"
                                                        @onclick="@(() => ToggleReaction(capturedAddId, r.Emoji))"
                                                        class="@Cn.Merge("inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs transition-colors hover:bg-muted", r.Reacted ? "border-blue-500/30 bg-blue-500/10" : "")">
                                                    <span class="text-sm leading-none">@r.Emoji</span>
                                                    <span class="font-medium text-muted-foreground tabular-nums">@r.Count</span>
                                                </button>
                                            }
                                            @{
                                                var capturedAddId0 = addMsgId;
                                            }
                                            <button type="button"
                                                    @onclick="@(() => _pickerOpen = (_pickerOpen == capturedAddId0 ? null : capturedAddId0))"
                                                    class="inline-flex size-6 items-center justify-center rounded-full border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                            </button>
                                        </div>
                                    }

                                    @* Quick emoji bar on hover (when no reactions yet) *@
                                    @if (addMsg.Reactions.Count == 0 && _hoveredMsg == addMsgId)
                                    {
                                        var capturedAddId1 = addMsgId;
                                        <div class="mt-1">
                                            <button type="button"
                                                    @onclick="@(() => _pickerOpen = (_pickerOpen == capturedAddId1 ? null : capturedAddId1))"
                                                    class="inline-flex size-6 items-center justify-center rounded-full border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Emoji picker dropdown *@
                            @if (_pickerOpen == addMsgId)
                            {
                                var capturedAddId2 = addMsgId;
                                <div class="absolute right-4 z-10 mt-1 flex items-center gap-0.5 rounded-full border bg-card p-1 shadow-sm">
                                    @foreach (var qe in _quickEmojis)
                                    {
                                        var emoji = qe;
                                        <button type="button"
                                                @onclick="@(() => ToggleReaction(capturedAddId2, emoji))"
                                                class="flex size-7 items-center justify-center rounded-full text-sm transition-all hover:scale-125 hover:bg-muted">
                                            @emoji
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2 rounded-md border bg-muted/30 px-3">
                <input @bind="_input"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="Type a message..."
                       class="h-9 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground/50" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(!CanSubmit)"
                          Class="size-7 shrink-0 text-muted-foreground hover:text-foreground"
                          OnClick="HandleSubmit">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private class Reaction
    {
        public string Emoji { get; set; } = "";
        public int Count { get; set; }
        public bool Reacted { get; set; }
    }

    private class ChatMessage
    {
        public string Id { get; set; } = "";
        public string Sender { get; set; } = "";
        public string Initials { get; set; } = "";
        public string Content { get; set; } = "";
        public string Time { get; set; } = "";
        public List<Reaction> Reactions { get; set; } = new();
    }

    private class MessageGroup
    {
        public string Sender { get; set; } = "";
        public string Initials { get; set; } = "";
        public List<ChatMessage> Msgs { get; set; } = new();
    }

    private static readonly string[] _quickEmojis =
    [
        "\U0001F44D",
        "❤️",
        "\U0001F602",
        "\U0001F62E",
        "\U0001F389",
        "\U0001F525",
        "\U0001F4AF",
        "\U0001F44F",
    ];

    private List<ChatMessage> _msgs =
    [
        new() {
            Id = "1", Sender = "Jordan Park", Initials = "JP",
            Content = "I just deployed the new landing page. Check it out when you get a chance!",
            Time = "3:42 PM",
            Reactions =
            [
                new Reaction { Emoji = "\U0001F525", Count = 4, Reacted = true },
                new Reaction { Emoji = "\U0001F44D", Count = 3, Reacted = false },
                new Reaction { Emoji = "\U0001F389", Count = 2, Reacted = false },
            ]
        },
        new() {
            Id = "2", Sender = "You", Initials = "ME",
            Content = "Just looked at it — the hero section is really clean. Love the scroll animations you added.",
            Time = "3:44 PM",
            Reactions =
            [
                new Reaction { Emoji = "❤️", Count = 2, Reacted = false },
            ]
        },
        new() {
            Id = "3", Sender = "Jordan Park", Initials = "JP",
            Content = "Thanks! I spent a while getting the intersection observer timing right. The trick was staggering the fade-in by 100ms per element.",
            Time = "3:45 PM",
            Reactions =
            [
                new Reaction { Emoji = "\U0001F4AF", Count = 5, Reacted = true },
                new Reaction { Emoji = "\U0001F44F", Count = 3, Reacted = false },
            ]
        },
        new() {
            Id = "4", Sender = "You", Initials = "ME",
            Content = "Smart approach. Did you consider using framer-motion instead? The stagger API is built in.",
            Time = "3:46 PM",
            Reactions =
            [
                new Reaction { Emoji = "\U0001F44D", Count = 1, Reacted = false },
            ]
        },
        new() {
            Id = "5", Sender = "Jordan Park", Initials = "JP",
            Content = "I thought about it but wanted to keep the bundle small since this is a marketing page. The IO approach is zero-dependency.",
            Time = "3:48 PM",
            Reactions = []
        },
        new() {
            Id = "6", Sender = "You", Initials = "ME",
            Content = "Fair point. Bundle size matters there. The performance numbers look good too — Core Web Vitals are all green.",
            Time = "3:49 PM",
            Reactions =
            [
                new Reaction { Emoji = "\U0001F389", Count = 3, Reacted = true },
                new Reaction { Emoji = "\U0001F525", Count = 2, Reacted = false },
            ]
        },
        new() {
            Id = "7", Sender = "Jordan Park", Initials = "JP",
            Content = "That's the goal! LCP at 1.2s and CLS at 0. Lighthouse score is 98. Ready for the product launch on Monday.",
            Time = "3:50 PM",
            Reactions =
            [
                new Reaction { Emoji = "\U0001F525", Count = 6, Reacted = true },
                new Reaction { Emoji = "\U0001F44F", Count = 4, Reacted = true },
                new Reaction { Emoji = "\U0001F4AF", Count = 3, Reacted = false },
            ]
        },
    ];

    private string? _hoveredMsg = null;
    private string? _pickerOpen = null;
    private string _input = "";

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_input);

    private List<MessageGroup> _grouped => BuildGroups();

    private List<MessageGroup> BuildGroups()
    {
        var result = new List<MessageGroup>();
        foreach (var msg in _msgs)
        {
            if (result.Count > 0 && result[result.Count - 1].Sender == msg.Sender)
            {
                result[result.Count - 1].Msgs.Add(msg);
            }
            else
            {
                result.Add(new MessageGroup { Sender = msg.Sender, Initials = msg.Initials, Msgs = [msg] });
            }
        }
        return result;
    }

    private void ToggleReaction(string messageId, string emoji)
    {
        var msg = _msgs.Find(m => m.Id == messageId);
        if (msg == null) return;

        var existing = msg.Reactions.Find(r => r.Emoji == emoji);
        if (existing != null)
        {
            if (existing.Reacted)
            {
                if (existing.Count == 1)
                    msg.Reactions.Remove(existing);
                else
                {
                    existing.Count--;
                    existing.Reacted = false;
                }
            }
            else
            {
                existing.Count++;
                existing.Reacted = true;
            }
        }
        else
        {
            msg.Reactions.Add(new Reaction { Emoji = emoji, Count = 1, Reacted = true });
        }

        _pickerOpen = null;
    }

    private void HandleSubmit()
    {
        if (!CanSubmit) return;
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            HandleSubmit();
        }
    }
}
