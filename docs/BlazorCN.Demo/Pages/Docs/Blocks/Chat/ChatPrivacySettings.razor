@* ============================================================
   Block: chat-privacy-settings
   Title: ChatPrivacySettings
   Description: React chat privacy and blocking panel for Next.js with blocked users list, messaging permissions radio group, read receipts toggle, and online status visibility using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-privacy-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground">
                <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
            </ButtonCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Privacy</span>
            </div>
            <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Content *@
        <div class="flex-1 overflow-y-auto">
            @* Blocked Users *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="user-x" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                        Blocked users
                    </span>
                    <span class="ml-auto font-mono text-muted-foreground text-xs">
                        @_blockedUsers.Count
                    </span>
                </div>
                @if (_blockedUsers.Count == 0)
                {
                    <p class="mt-3 text-center text-muted-foreground text-xs">No blocked users</p>
                }
                else
                {
                    <div class="mt-3 flex flex-col gap-0.5">
                        @foreach (var u in _blockedUsers)
                        {
                            var user = u;
                            <div class="flex items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/30">
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted">
                                    <span class="font-medium text-muted-foreground text-[10px]">
                                        @user.Initials
                                    </span>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm">@user.Name</span>
                                    <p class="text-muted-foreground text-xs">Blocked @user.BlockedAt</p>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          OnClick="@(() => UnblockUser(user.Id))"
                                          Class="h-7 gap-1 px-2 text-muted-foreground text-xs hover:text-foreground">
                                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                                    Unblock
                                </ButtonCn>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Who can message me *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Who can message me
                </span>
                <RadioGroupCn Value="@_messagePermission" ValueChanged="@((string val) => _messagePermission = val)" Class="mt-3">
                    @foreach (var o in _permissionOptions)
                    {
                        var opt = o;
                        <div role="button"
                             tabindex="0"
                             @onclick="@(() => _messagePermission = opt.Value)"
                             class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors", _messagePermission == opt.Value ? "bg-muted/50" : "hover:bg-muted/30")">
                            <RadioGroupItemCn Value="@opt.Value" />
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@opt.Label</span>
                                <p class="text-muted-foreground text-xs">@opt.Description</p>
                            </div>
                        </div>
                    }
                </RadioGroupCn>
            </div>

            @* Visibility Toggles *@
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Visibility
                </span>
                <div class="mt-3 flex flex-col gap-1">
                    <div class="flex items-center justify-between rounded-md px-3 py-2.5">
                        <div class="flex items-center gap-3">
                            @if (_readReceipts)
                            {
                                <LucideIconCn Name="eye" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="eye-off" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            <div>
                                <span class="font-medium text-sm">Read receipts</span>
                                <p class="text-muted-foreground text-xs">
                                    Let others know when you've read their messages
                                </p>
                            </div>
                        </div>
                        <SwitchCn Checked="@_readReceipts" CheckedChanged="@((bool val) => _readReceipts = val)" />
                    </div>
                    <div class="flex items-center justify-between rounded-md px-3 py-2.5">
                        <div class="flex items-center gap-3">
                            <span class="@Cn.Merge("size-2 rounded-full transition-colors", _onlineStatus ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                            <div>
                                <span class="font-medium text-sm">Show online status</span>
                                <p class="text-muted-foreground text-xs">
                                    Display when you're active to other users
                                </p>
                            </div>
                        </div>
                        <SwitchCn Checked="@_onlineStatus" CheckedChanged="@((bool val) => _onlineStatus = val)" />
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @(_messagePermission == "nobody"
                        ? "All incoming messages blocked"
                        : $"Accepting messages from {(_messagePermission == "everyone" ? "everyone" : "contacts only")}")
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record BlockedUser(string Id, string Name, string Initials, string BlockedAt);
    private record PermissionOption(string Value, string Label, string Description);

    private List<BlockedUser> _blockedUsers =
    [
        new("1", "Alex Thompson", "AT", "Mar 12"),
        new("2", "Casey Morgan", "CM", "Feb 28"),
        new("3", "Riley Parker", "RP", "Jan 15"),
    ];

    private static readonly PermissionOption[] _permissionOptions =
    [
        new("everyone", "Everyone", "Anyone can send you messages"),
        new("contacts", "Contacts only", "Only people in your contacts"),
        new("nobody", "Nobody", "Block all incoming messages"),
    ];

    private string _messagePermission = "everyone";
    private bool _readReceipts = true;
    private bool _onlineStatus = true;

    private void UnblockUser(string userId)
    {
        _blockedUsers = _blockedUsers.Where(u => u.Id != userId).ToList();
    }
}
