@* ============================================================
   Block: chat-direct-message
   Title: ChatDirectMessage
   Description: React one-on-one direct message chat interface for Next.js with rich profile header, video and phone call buttons, date separators, time-grouped messages, and seen indicators using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-direct-message.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Rich profile header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="relative">
                <AvatarCn Class="size-10">
                    <AvatarFallbackCn Class="text-sm">@_contact.Initials</AvatarFallbackCn>
                </AvatarCn>
                <span class="absolute right-0 bottom-0 size-2.5 rounded-full border-2 border-card bg-emerald-500"></span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_contact.Name</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_contact.Status
                </p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Class="size-8 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="phone" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Class="size-8 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="video" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Class="size-8 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Messages — flat layout with grouping *@
        <div class="flex flex-1 flex-col overflow-y-auto py-2">
            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var idx = i;
                var prev = idx > 0 ? _messages[idx - 1] : null;
                var showDateSeparator = prev == null || prev.Date != msg.Date;
                var isFirstInGroup = prev == null || prev.Sender != msg.Sender || showDateSeparator;
                var isMe = msg.Sender == "me";
                var rowClass = Cn.Merge(
                    "group flex gap-2 px-4 py-0.5 hover:bg-accent/50",
                    isFirstInGroup ? "mt-3" : ""
                );

                <div>
                    @* Date separator *@
                    @if (showDateSeparator)
                    {
                        <div class="my-4 flex items-center gap-2 px-4">
                            <div class="h-px flex-1 bg-border"></div>
                            <span class="text-muted-foreground text-[10px] font-medium">@msg.Date</span>
                            <div class="h-px flex-1 bg-border"></div>
                        </div>
                    }

                    @* Message row *@
                    <div class="@rowClass">
                        @* Avatar column *@
                        <div class="flex w-10 shrink-0 items-start justify-center pt-0.5">
                            @if (isFirstInGroup)
                            {
                                <AvatarCn Class="size-8">
                                    <AvatarFallbackCn Class="text-[10px]">@(isMe ? "You" : _contact.Initials)</AvatarFallbackCn>
                                </AvatarCn>
                            }
                            else
                            {
                                <span class="invisible text-muted-foreground text-[10px] group-hover:visible">@msg.Timestamp</span>
                            }
                        </div>

                        @* Body *@
                        <div class="min-w-0 flex-1">
                            @if (isFirstInGroup)
                            {
                                <div class="mb-0.5 flex items-center gap-2">
                                    <span class="font-medium text-sm">@(isMe ? "You" : _contact.Name)</span>
                                    <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                                </div>
                            }
                            <p class="text-sm leading-relaxed">@msg.Content</p>
                            @* Seen indicator *@
                            @if (isMe && msg.Seen)
                            {
                                <div class="mt-0.5 flex items-center gap-1 text-blue-500">
                                    <LucideIconCn Name="check-check" Size="12" Class="size-3" />
                                    <span class="text-[10px]">Seen</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2 rounded-lg border bg-muted/30 px-3 py-1.5">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="plus" Size="16" Class="size-4" />
                </ButtonCn>
                <input @bind="_input" @bind:event="oninput"
                       placeholder="@($"Message {_contact.Name}...")"
                       class="h-8 min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                <div class="flex items-center gap-1">
                    <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="smile" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record Contact(string Name, string Initials, string Avatar, string Status);

    private record Message(
        string Id,
        string Content,
        string Sender,
        string Timestamp,
        string Date,
        bool Seen = false
    );

    private static readonly Contact _contact = new("Mara Chen", "MC", "", "Active now");

    private static readonly Message[] _messages =
    [
        new("1",  "Hey, did the design tokens get merged into main?",                                               "me",   "9:58 AM",  "Yesterday"),
        new("2",  "Yes! Merged about an hour ago. The color system is fully tokenized now.",                        "them", "10:04 AM", "Yesterday"),
        new("3",  "Any breaking changes I should know about?",                                                      "me",   "10:05 AM", "Yesterday"),
        new("4",  "A few renames in the spacing scale. I documented everything in the migration guide.",             "them", "10:06 AM", "Yesterday"),
        new("5",  "The old --color-primary tokens are deprecated. Use --color-brand-* instead. Lint will catch the old ones.", "them", "10:06 AM", "Yesterday"),
        new("6",  "Perfect. I updated the dashboard components.",                                                   "me",   "3:42 PM",  "Yesterday"),
        new("7",  "Let me know if the dark mode overrides look weird. I rewired how surface colors cascade.",       "them", "10:09 AM", "Today"),
        new("8",  "Will do. Want me to run the visual regression suite?",                                          "me",   "10:10 AM", "Today"),
        new("9",  "That would be great. Chromatic should pick up the snapshots automatically once you push.",       "them", "10:11 AM", "Today"),
        new("10", "On it. I'll ping you when the run finishes.",                                                   "me",   "10:12 AM", "Today", true),
    ];

    private string _input = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
