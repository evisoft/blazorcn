@* ============================================================
   Block: chat-budget-planner
   Title: ChatBudgetPlanner
   Description: Collaborative budget planning chat with expense categories, shared totals, and real-time updates built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-budget-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-foreground" />
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium">March Budget</h3>
                    <p class="text-xs text-muted-foreground">Alex &amp; Sarah • Shared planning</p>
                </div>
            </div>
        </div>

        @* Budget Summary *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-end justify-between">
                <div>
                    <span class="text-xs text-muted-foreground">Total Spent</span>
                    <div class="flex items-baseline gap-2">
                        <span class="font-semibold tabular-nums text-2xl">
                            $@TotalSpent.ToString("F2")
                        </span>
                        <span class="text-xs text-muted-foreground">of $@BudgetLimit.ToString("F2")</span>
                    </div>
                </div>
                <div class="flex items-center gap-1 text-xs">
                    @if (PercentUsed > 90)
                    {
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-red-500" />
                        <span class="text-red-500">@PercentUsed.ToString("F0")% used</span>
                    }
                    else
                    {
                        <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-emerald-500" />
                        <span class="text-emerald-500">@PercentUsed.ToString("F0")% used</span>
                    }
                </div>
            </div>
            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="@Cn.Merge("h-full transition-all", PercentUsed > 90 ? "bg-red-500" : "bg-emerald-500")"
                     style="@($"width:{Math.Min(PercentUsed, 100).ToString("F1")}%")">
                </div>
            </div>
            <div class="mt-2 flex flex-wrap gap-2">
                @foreach (var entry in CategoryTotals)
                {
                    var cat = entry.Key;
                    var amt = entry.Value;
                    var iconName = GetCategoryIcon(cat);
                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                        <LucideIconCn Name="@iconName" Size="12" Class="size-3" />
                        @cat: $@amt.ToString("F0")
                    </BadgeCn>
                }
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-3 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                <div class="@Cn.Merge("flex gap-2", message.UserId == "current" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-6 shrink-0">
                        <AvatarFallbackCn Class="text-xs">@message.UserName[0]</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="@Cn.Merge("flex-1", message.UserId == "current" ? "flex flex-col items-end" : "")">
                        @if (message.Type == "expense" && message.Expense != null)
                        {
                            var expense = message.Expense;
                            <div class="max-w-sm rounded-lg border bg-muted/50 p-3">
                                <div class="mb-2 flex items-start justify-between gap-3">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="@GetCategoryIcon(expense.Category)" Size="16" Class="size-4 text-muted-foreground" />
                                        <div>
                                            <span class="text-xs font-medium capitalize text-muted-foreground">
                                                @expense.Category
                                            </span>
                                            <p class="text-sm">@expense.Description</p>
                                        </div>
                                    </div>
                                    <span class="font-semibold tabular-nums text-lg">
                                        $@expense.Amount.ToString("F2")
                                    </span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-muted-foreground">
                                    <span>Added by @expense.AddedBy</span>
                                    <span>@message.Timestamp</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="mb-1 flex items-baseline gap-2">
                                    <span class="text-sm font-medium">@message.UserName</span>
                                    <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                                </div>
                                <div class="@Cn.Merge("max-w-sm rounded-lg px-3 py-2", message.UserId == "current" ? "bg-blue-500 text-white" : "bg-muted")">
                                    <p class="text-sm">@message.Content</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="mb-2 flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Expense
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5" />
                    View Report
                </ButtonCn>
            </div>
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Discuss budget or add notes..."
                    Class="flex-1"
                    @onkeydown="@HandleKeyDown" aria-label="Discuss budget or add notes..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSend" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Expense(string Id, string Category, double Amount, string Description, string AddedBy, string Timestamp);
    private record Message(string Id, string UserId, string UserName, string Type, string Content, string Timestamp, Expense? Expense = null);

    private List<Message> _messages =
    [
        new("1", "1", "Alex", "text", "Starting our March budget planning!", "Yesterday"),
        new("2", "2", "Sarah", "expense", "Added expense", "Yesterday",
            new Expense("e1", "groceries", 285.5, "Weekly grocery shopping", "Sarah", "Yesterday")),
        new("3", "1", "Alex", "expense", "Added expense", "Yesterday",
            new Expense("e2", "housing", 1850, "Rent payment", "Alex", "Yesterday")),
        new("4", "2", "Sarah", "text", "We're tracking well so far. Let's keep it under $3,500 this month.", "5 hours ago"),
        new("5", "1", "Alex", "expense", "Added expense", "2 hours ago",
            new Expense("e3", "transport", 120, "Gas and metro pass", "Alex", "2 hours ago")),
    ];

    private double BudgetLimit => 3500;

    private double TotalSpent =>
        _messages
            .Where(m => m.Type == "expense" && m.Expense != null)
            .Sum(m => m.Expense!.Amount);

    private double PercentUsed => (TotalSpent / BudgetLimit) * 100;

    private Dictionary<string, double> CategoryTotals =>
        _messages
            .Where(m => m.Type == "expense" && m.Expense != null)
            .Select(m => m.Expense!)
            .GroupBy(e => e.Category)
            .ToDictionary(g => g.Key, g => g.Sum(e => e.Amount));

    private static string GetCategoryIcon(string category) => category switch
    {
        "groceries" => "shopping-cart",
        "housing"   => "home",
        "transport" => "car",
        "dining"    => "utensils",
        _           => "shopping-cart",
    };

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new Message(
            Id: DateTime.UtcNow.Ticks.ToString(),
            UserId: "current",
            UserName: "You",
            Type: "text",
            Content: _input,
            Timestamp: "Just now"
        );

        _messages = [.._messages, newMessage];
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSend();
    }
}
