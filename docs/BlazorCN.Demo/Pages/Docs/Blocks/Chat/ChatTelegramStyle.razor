@* ============================================================
   Block: chat-telegram-style
   Title: ChatTelegramStyle
   Description: React Telegram-inspired chat interface for Next.js with green-tinted sent bubbles, reply previews, pinned messages, edited labels, and grouped timestamps using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-telegram-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-blue-500/10">
                <span class="font-semibold text-blue-600 text-sm dark:text-blue-400">V</span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Viktor Petrov</span>
                <p class="text-muted-foreground text-xs">last seen 1 min ago</p>
            </div>
        </div>

        @* Pinned message banner *@
        <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <LucideIconCn Name="pin" Size="14" Class="size-3.5 shrink-0 rotate-45 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-xs">@_pinnedMessage.SenderName</span>
                <p class="truncate text-muted-foreground text-xs">@_pinnedMessage.Content</p>
            </div>
        </div>

        @* Messages with subtle tinted background *@
        <div class="flex flex-1 flex-col gap-0.5 overflow-y-auto bg-muted/20 px-4 py-4" tabindex="0" role="group" aria-label="Messages">
            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var idx = i;
                var isMe = msg.Sender == "me";
                var prev = idx > 0 ? _messages[idx - 1] : null;
                var showGap = prev != null && prev.Sender != msg.Sender;

                var outerClass = Cn.Merge(
                    "flex flex-col",
                    isMe ? "items-end" : "items-start",
                    showGap ? "mt-3" : ""
                );

                var bubbleClass = Cn.Merge(
                    "max-w-[75%] rounded-lg px-3 py-1.5",
                    isMe ? "bg-emerald-500/10" : "bg-card"
                );

                <div class="@outerClass">
                    <div class="@bubbleClass">
                        @* Reply-to preview *@
                        @if (msg.ReplyTo != null)
                        {
                            <div class="mb-1.5 border-blue-500 border-l-2 pl-2">
                                <span class="font-medium text-blue-600 text-xs dark:text-blue-400">@msg.ReplyTo.SenderName</span>
                                <p class="truncate text-muted-foreground text-xs">@msg.ReplyTo.Content</p>
                            </div>
                        }

                        @* Content *@
                        <p class="text-sm leading-relaxed">@msg.Content</p>

                        @* Timestamp + edited + double-check read receipts *@
                        <div class="mt-0.5 flex items-center justify-end gap-1">
                            @if (msg.Edited)
                            {
                                <span class="text-[10px] text-muted-foreground">edited</span>
                            }
                            <span class="text-[10px] text-muted-foreground">@msg.Timestamp</span>
                            @if (isMe && msg.Status != null)
                            {
                                <LucideIconCn Name="check-check" Size="12" Class="@Cn.Merge("size-3", msg.Status == "read" ? "text-blue-500" : "text-muted-foreground/60")" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Emoji">
                    <LucideIconCn Name="smile" Size="16" Class="size-4" />
                </ButtonCn>
                <input @bind="_input"
                       @bind:event="oninput"
                       placeholder="Write a message..."
                       class="h-9 flex-1 border-0 bg-transparent shadow-none focus-visible:ring-0 text-sm outline-none placeholder:text-muted-foreground" aria-label="Write a message..." />
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Attach file">
                    <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-blue-500 hover:text-blue-600 disabled:text-muted-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ReplyTo(string SenderName, string Content);
    private record Message(string Id, string Content, string Sender, string SenderName, string Timestamp, bool Edited = false, ReplyTo? ReplyTo = null, string? Status = null);
    private record PinnedMessage(string SenderName, string Content);

    private string _input = "";

    private static readonly PinnedMessage _pinnedMessage = new(
        "Viktor",
        "Meeting moved to Thursday at 2 PM. Please update your calendars."
    );

    private static readonly Message[] _messages =
    [
        new("1", "Meeting moved to Thursday at 2 PM. Please update your calendars.", "them", "Viktor", "2:15 PM"),
        new("2", "Got it. I'll reschedule the design review.", "me", "You", "2:16 PM", Status: "read"),
        new("3", "Should we still do the async standup tomorrow or skip it?", "them", "Viktor", "2:17 PM"),
        new("4", "Let's keep it. We need to sync on the API changes before Thursday.", "me", "You", "2:18 PM", Status: "read",
            ReplyTo: new("Viktor", "Should we still do the async standup tomorrow or skip it?")),
        new("5", "Fair point. I'll prepare the migration notes tonight and share them in the channel.", "them", "Viktor", "2:19 PM"),
        new("6", "Also, the staging deploy is broken. CI is failing on the new auth middleware.", "them", "Viktor", "2:19 PM"),
        new("7", "I saw that. It's a config issue — the JWT_SECRET env var is missing from the staging profile.", "me", "You", "2:20 PM", Edited: true, Status: "read"),
        new("8", "Ah, that explains it. Can you push the fix or should I handle it?", "them", "Viktor", "2:21 PM"),
        new("9", "Already pushed. Give it 5 minutes to redeploy.", "me", "You", "2:22 PM", Status: "delivered"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
