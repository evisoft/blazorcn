@* ============================================================
   Block: chat-tax-assistant
   Title: ChatTaxAssistant
   Description: A tax filing assistant chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring deduction cards, document checklist, and tax calculations
   Source: original/blocks/chat/chat-tax-assistant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="calculator" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium">Tax Assistant</h3>
                    <p class="text-xs text-muted-foreground">2026 Tax Year Filing</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4">
            <div class="space-y-4 py-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            @if (msg.Type == "assistant")
                            {
                                <AvatarFallbackCn Class="bg-primary/10">
                                    <LucideIconCn Name="calculator" Size="16" Class="size-4 text-primary" />
                                </AvatarFallbackCn>
                            }
                            else
                            {
                                <AvatarImageCn Src="https://avatar.vercel.sh/user" />
                                <AvatarFallbackCn>U</AvatarFallbackCn>
                            }
                        </AvatarCn>

                        <div class="@Cn.Merge("flex-1 space-y-2", msg.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", msg.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @msg.Content
                            </div>

                            @if (msg.TaxCalculation != null)
                            {
                                var calc = msg.TaxCalculation;
                                <div class="w-full space-y-3 rounded-lg border bg-card p-4">
                                    <div class="flex items-start justify-between">
                                        <div class="space-y-1">
                                            <p class="text-sm font-medium">Tax Estimate</p>
                                            <p class="text-xs text-muted-foreground">Based on current information</p>
                                        </div>
                                        @if (calc.RefundEstimate.HasValue)
                                        {
                                            <div class="text-right">
                                                <div class="text-2xl font-semibold tabular-nums text-emerald-600">
                                                    $@calc.RefundEstimate.Value.ToString("N0")
                                                </div>
                                                <div class="text-xs text-muted-foreground">Est. Refund</div>
                                            </div>
                                        }
                                    </div>

                                    <div class="grid gap-3 border-t pt-3 text-sm">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Total Income</span>
                                            <span class="font-medium tabular-nums">$@calc.TotalIncome.ToString("N0")</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Standard Deduction</span>
                                            <span class="font-medium tabular-nums text-emerald-600">-$@calc.StandardDeduction.ToString("N0")</span>
                                        </div>
                                        <div class="flex items-center justify-between border-t pt-2">
                                            <span class="text-muted-foreground">Taxable Income</span>
                                            <span class="font-semibold tabular-nums">$@calc.TaxableIncome.ToString("N0")</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Estimated Tax</span>
                                            <span class="font-medium tabular-nums">$@calc.EstimatedTax.ToString("N0")</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Effective Rate</span>
                                            <span class="font-medium tabular-nums">@calc.EffectiveRate%</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (msg.DeductionCard != null)
                            {
                                var ded = msg.DeductionCard;
                                <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                    <div class="flex items-start justify-between">
                                        <div class="space-y-1">
                                            <p class="text-sm font-medium">@ded.Category</p>
                                            <p class="text-xs text-muted-foreground">@ded.Description</p>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("capitalize", GetEligibilityColor(ded.Eligibility))">
                                            @(ded.Eligibility == "eligible" ? "Eligible" : ded.Eligibility == "maybe" ? "Needs Review" : "Not Eligible")
                                        </BadgeCn>
                                    </div>

                                    <div class="flex items-center gap-2 rounded-md bg-emerald-500/10 px-3 py-2">
                                        <LucideIconCn Name="trending-down" Size="16" Class="size-4 text-emerald-600" />
                                        <span class="text-sm font-medium text-emerald-600">$@ded.Amount.ToString("N0") deduction</span>
                                    </div>

                                    <div class="space-y-2 border-t pt-3">
                                        <div class="flex items-center gap-2 text-xs font-medium">
                                            <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span>Required Documentation</span>
                                        </div>
                                        @foreach (var doc in ded.Documentation)
                                        {
                                            <div class="flex gap-2 text-xs text-muted-foreground">
                                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                                <span>@doc</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (msg.DocumentChecklist != null)
                            {
                                var checklist = msg.DocumentChecklist;
                                <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                    <div class="space-y-2">
                                        <div class="flex items-center justify-between">
                                            <p class="text-sm font-medium">Document Checklist</p>
                                            <span class="text-xs text-muted-foreground">@checklist.CompletionRate% complete</span>
                                        </div>
                                        <ProgressCn Value="@checklist.CompletionRate" Class="h-1.5" />
                                    </div>

                                    <div class="space-y-2 border-t pt-3">
                                        @foreach (var chkItem in checklist.Items)
                                        {
                                            var ci = chkItem;
                                            <div class="flex items-start gap-3">
                                                @if (ci.Completed)
                                                {
                                                    <LucideIconCn Name="check-circle-2" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-600" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                                                }
                                                <div class="flex-1 space-y-0.5">
                                                    <div class="flex items-center gap-2">
                                                        <p class="@Cn.Merge("text-sm font-medium", ci.Completed ? "line-through" : "")">@ci.Name</p>
                                                        @if (ci.Required && !ci.Completed)
                                                        {
                                                            <BadgeCn Variant="BadgeVariant.Outline" Class="bg-red-500/10 text-xs text-red-600">Required</BadgeCn>
                                                        }
                                                    </div>
                                                    <p class="text-xs text-muted-foreground">@ci.Description</p>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="flex items-start gap-2 rounded-md bg-amber-500/10 px-3 py-2 text-xs">
                                        <LucideIconCn Name="alert-circle" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-amber-600" />
                                        <span class="text-amber-600">Upload all required documents to finalize your tax return</span>
                                    </div>
                                </div>
                            }

                            <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Ask about deductions, upload documents, or get tax advice..."
                    Class="flex-1"
                    @onkeydown="@HandleKeyDown" />
                <ButtonCn Size="ButtonSize.Icon" OnClick="@HandleSend">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record TaxCalculation(
        int TotalIncome,
        int StandardDeduction,
        int TaxableIncome,
        int EstimatedTax,
        double EffectiveRate,
        int? RefundEstimate = null);

    private record DeductionCard(
        string Category,
        int Amount,
        string Description,
        string Eligibility,
        string[] Documentation);

    private record ChecklistItem(string Name, bool Required, bool Completed, string Description);

    private record DocumentChecklist(ChecklistItem[] Items, int CompletionRate);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        TaxCalculation? TaxCalculation = null,
        DeductionCard? DeductionCard = null,
        DocumentChecklist? DocumentChecklist = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Hi! I'm your tax assistant. I'll help you prepare your tax return, maximize deductions, and estimate your refund. Let's start with your income information.",
            "9:00 AM"),
        new("2", "user",
            "I earned $85,000 in salary this year. I'm filing as single.",
            "9:01 AM"),
        new("3", "assistant",
            "Great! Here's your preliminary tax calculation:",
            "9:01 AM",
            TaxCalculation: new TaxCalculation(85000, 14600, 70400, 12244, 14.4, 1850)),
        new("4", "user",
            "I also donated $3,500 to charity and paid $12,000 in mortgage interest. Can I deduct those?",
            "9:03 AM"),
        new("5", "assistant",
            "Yes! Let me check your deduction eligibility:",
            "9:03 AM",
            DeductionCard: new DeductionCard(
                "Charitable Contributions",
                3500,
                "Cash donations to qualified organizations",
                "eligible",
                ["Donation receipts", "Form 1098-C (if over $500)", "Bank statements"])),
        new("6", "assistant",
            "Here's what you still need to provide:",
            "9:04 AM",
            DocumentChecklist: new DocumentChecklist(
                [
                    new ChecklistItem("W-2 Form", true, true, "Wage and tax statement from employer"),
                    new ChecklistItem("1099-INT", false, false, "Interest income from bank accounts"),
                    new ChecklistItem("Mortgage Interest Statement (1098)", true, false, "From your mortgage lender"),
                    new ChecklistItem("Charitable Donation Receipts", true, false, "For all contributions over $250"),
                    new ChecklistItem("State Tax Return (Prior Year)", false, true, "For state tax deduction"),
                ],
                40)),
    ];

    private static string GetEligibilityColor(string eligibility) => eligibility switch
    {
        "eligible"     => "bg-emerald-500/10 text-emerald-600",
        "maybe"        => "bg-amber-500/10 text-amber-600",
        "not-eligible" => "bg-red-500/10 text-red-600",
        _              => "bg-muted text-muted-foreground",
    };

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new Message(
            Id: DateTime.UtcNow.Ticks.ToString(),
            Type: "user",
            Content: _input,
            Timestamp: "Just now"
        );

        _messages = [.._messages, newMessage];
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSend();
    }
}
