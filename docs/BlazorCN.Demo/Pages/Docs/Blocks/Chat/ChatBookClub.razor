@* ============================================================
   Block: chat-book-club
   Title: ChatBookClub
   Description: React book club discussion chat block for Next.js with book detail cards, reading progress tracker, discussion question prompts, member avatars, and chapter notes using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-book-club.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Club header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="book-open" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_club.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_club.CurrentBook
                    </BadgeCn>
                </div>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    @_club.MemberCount members
                </span>
            </div>
        </div>

        @* Reading progress *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Reading progress</span>
            <ProgressCn Value="@_progressPercent" Class="h-1.5 flex-1" />
            <span class="font-medium text-xs tabular-nums">
                Ch. @_club.CurrentChapter/@_club.TotalChapters
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="flex justify-start gap-2.5">
                        <AvatarCn Class="mt-0.5 shrink-0 size-7">
                            <AvatarFallbackCn Class="bg-muted text-xs">@msg.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 max-w-[85%]">
                            <div class="mb-0.5 flex items-center gap-2">
                                <span class="font-medium text-sm">@msg.Author</span>
                                @if (msg.Role == "host")
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Host
                                    </BadgeCn>
                                }
                                <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                            </div>

                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }

                            @* Book card *@
                            @if (msg.Book != null)
                            {
                                var book = msg.Book;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="flex gap-3">
                                        <div class="@($"flex size-16 shrink-0 items-center justify-center rounded-md {book.CoverColor}")">
                                            <LucideIconCn Name="book-open" Size="24" Class="size-6 text-white" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-start justify-between gap-2">
                                                <div>
                                                    <span class="font-medium text-sm">@book.Title</span>
                                                    <p class="text-muted-foreground text-xs">@book.Author</p>
                                                </div>
                                                <ButtonCn
                                                    Variant="ButtonVariant.Ghost"
                                                    Size="ButtonSize.Sm"
                                                    Class="size-7 shrink-0 p-0"
                                                    OnClick="@ToggleBookmark">
                                                    <LucideIconCn Name="bookmark" Size="14" Class="@($"size-3.5{(_bookmarked ? " fill-current" : "")}")" />
                                                </ButtonCn>
                                            </div>
                                            <div class="mt-1.5 flex items-center gap-2">
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                                    @book.Genre
                                                </BadgeCn>
                                                <span class="text-muted-foreground text-xs tabular-nums">
                                                    @book.Pages pages
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Discussion prompt card *@
                            @if (msg.Prompt != null)
                            {
                                var prompt = msg.Prompt;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="message-circle" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-xs text-muted-foreground">
                                                Discussion Prompt
                                            </span>
                                        </div>
                                        <span class="text-muted-foreground text-xs">@prompt.Chapter</span>
                                    </div>
                                    <p class="mb-2.5 text-sm leading-relaxed">@prompt.Question</p>
                                    <div class="flex items-center justify-between border-t pt-2.5">
                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                                            @prompt.RespondedCount responses
                                        </span>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Reply to prompt
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Share your thoughts..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private bool _bookmarked = false;

    private record BookInfo(string Title, string Author, int Pages, string Genre, string CoverColor);
    private record DiscussionPrompt(string Chapter, string Question, int RespondedCount);
    private record ClubInfo(string Name, string CurrentBook, int MemberCount, int CurrentChapter, int TotalChapters);
    private record Message(string Id, string Role, string Author, string Initials, string Content, string Timestamp, BookInfo? Book = null, DiscussionPrompt? Prompt = null);

    private readonly ClubInfo _club = new("Page Turners", "Project Hail Mary", 14, 18, 32);

    private int _progressPercent => (int)Math.Round((_club.CurrentChapter / (double)_club.TotalChapters) * 100);

    private readonly Message[] _messages =
    [
        new("1", "host", "Sarah Chen", "SC",
            "Welcome to this week's discussion! We just finished Part 2. Before we dive in, here's a refresher on the book for anyone who needs it.",
            "7:00 PM"),
        new("2", "host", "Sarah Chen", "SC", "", "7:00 PM",
            Book: new BookInfo("Project Hail Mary", "Andy Weir", 496, "Science Fiction", "bg-blue-600")),
        new("3", "member", "James Park", "JP",
            "Such a great choice. I couldn't put it down after the Rocky reveal. The language barrier scenes are some of the most creative writing I've read.",
            "7:02 PM"),
        new("4", "host", "Sarah Chen", "SC",
            "Let's start with our first discussion question for this week.",
            "7:03 PM"),
        new("5", "host", "Sarah Chen", "SC", "", "7:03 PM",
            Prompt: new DiscussionPrompt("Chapters 14-18",
                "How does Grace's relationship with Rocky challenge or reinforce your assumptions about communication across radically different species?",
                6)),
        new("6", "member", "Mia Torres", "MT",
            "I love how they build a shared vocabulary from first principles. Starting with math and working up to abstract concepts feels really plausible. The music-based communication is brilliant.",
            "7:05 PM"),
        new("7", "member", "David Lin", "DL",
            "It reminded me of Arrival but more grounded. The trial and error of learning each other's needs through shared scientific problems felt earned, not convenient.",
            "7:07 PM"),
        new("8", "host", "Sarah Chen", "SC",
            "Great points. Next week we'll cover chapters 19-24. The pace really picks up. No spoilers past chapter 18!",
            "7:10 PM"),
    ];

    private void ToggleBookmark()
    {
        _bookmarked = !_bookmarked;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
