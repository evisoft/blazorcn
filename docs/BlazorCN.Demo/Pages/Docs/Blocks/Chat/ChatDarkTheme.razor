@* ============================================================
   Block: chat-dark-theme
   Title: ChatDarkTheme
   Description: React dark-themed chat interface block for Next.js with zinc-950 background, indigo sent bubbles, zinc-800 received bubbles, glowing send button, and subtle borders using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-dark-theme.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950">
        @* Header *@
        <div class="sticky top-0 z-10 flex items-center gap-2 border-b border-zinc-800 bg-zinc-900 p-2">
            <div class="relative">
                <AvatarCn Class="size-8 rounded-full border border-zinc-700 bg-zinc-800">
                    <AvatarFallbackCn Class="bg-zinc-800 text-xs text-zinc-300">K</AvatarFallbackCn>
                </AvatarCn>
                <span class="absolute right-0 bottom-0 size-2 rounded-full border border-zinc-900 bg-emerald-400"></span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm text-zinc-100">Kai Nakamura</span>
                <p class="flex items-center gap-1.5 text-xs text-zinc-500">
                    <span class="size-1.5 rounded-full bg-emerald-400"></span>
                    Online
                </p>
            </div>
            <div class="flex items-center gap-2 rounded-md border border-zinc-800 bg-zinc-900/50 px-2 py-1">
                <LucideIconCn Name="lock" Size="12" Class="size-3 text-emerald-400/70" />
                <span class="text-[10px] text-zinc-500">Encrypted</span>
            </div>
        </div>

        @* Messages -- flat layout with dark custom palette *@
        <div class="flex-1 overflow-y-auto bg-zinc-950 py-2" tabindex="0" role="group" aria-label="Messages">
            @* Date separator *@
            <div class="my-4 flex items-center gap-2 px-2">
                <div class="h-px flex-1 bg-zinc-800/60"></div>
                <span class="min-w-max text-xs font-semibold text-zinc-600">Today</span>
                <div class="h-px flex-1 bg-zinc-800/60"></div>
            </div>

            @foreach (var msg in _messages)
            {
                var isMe = msg.Sender.Id == "me";
                var idx = Array.IndexOf(_messages, msg);
                var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                var isFirstInGroup = prevMsg == null || prevMsg.Sender.Id != msg.Sender.Id;

                if (isFirstInGroup)
                {
                    <div class="@Cn.Merge("flex gap-2 px-2 transition-colors hover:bg-zinc-900/50", isMe ? "border-l-2 border-indigo-600" : "")">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            @if (!isMe)
                            {
                                <AvatarCn Class="size-8 rounded-full border border-zinc-700/50 bg-zinc-800">
                                    <AvatarFallbackCn Class="bg-zinc-800 text-xs text-zinc-400">@msg.Sender.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="flex items-center gap-2 text-sm">
                                <span class="font-medium text-zinc-100">@msg.Sender.Name</span>
                                <span class="text-xs text-zinc-600">@msg.Timestamp</span>
                            </div>
                            <div class="text-sm text-zinc-300">@msg.Content</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="@Cn.Merge("group flex gap-2 px-2 transition-colors hover:bg-zinc-900/50", isMe ? "border-l-2 border-indigo-600" : "")">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            <span class="invisible text-right text-[10px] text-zinc-600 group-hover:visible">@msg.Timestamp</span>
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="text-sm text-zinc-300">@msg.Content</div>
                        </div>
                    </div>
                }
            }
        </div>

        @* Toolbar *@
        <div class="sticky bottom-0 border-t border-zinc-800 bg-zinc-900 p-2 pt-2">
            <form class="flex flex-wrap items-start gap-x-2 rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2"
                  @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <div class="order-1 flex h-10 items-center gap-1.5">
                    <button type="button"
                            class="flex size-8 items-center justify-center rounded-md text-zinc-500 transition-colors hover:bg-zinc-800 hover:text-zinc-300" aria-label="Attach file">
                        <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                    </button>
                    <button type="button"
                            class="flex size-8 items-center justify-center rounded-md text-zinc-500 transition-colors hover:bg-zinc-800 hover:text-zinc-300" aria-label="Insert emoji">
                        <LucideIconCn Name="smile" Size="16" Class="size-4" />
                    </button>
                </div>
                <div class="order-2 grid min-w-0 flex-1">
                    <textarea @bind="_input" @bind:event="oninput"
                              placeholder="Type a message..."
                              class="h-fit min-h-10 resize-none border-none bg-transparent px-1 text-sm text-zinc-100 shadow-none outline-none placeholder:text-zinc-600"
                              rows="1" aria-label="Type a message..."></textarea>
                </div>
                <div class="order-3 flex h-10 items-center gap-1.5">
                    <button type="submit"
                            disabled="@(string.IsNullOrWhiteSpace(_input))"
                            class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-lg transition-all", !string.IsNullOrWhiteSpace(_input) ? "bg-indigo-600 text-white shadow-lg shadow-indigo-500/25 hover:bg-indigo-500 hover:shadow-indigo-500/40" : "bg-zinc-800 text-zinc-600")" aria-label="Send message">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record Sender(string Id, string Name, string Initials);
    private record Message(string Id, Sender Sender, string Content, string Timestamp);

    private static readonly Sender _kai = new("kai", "Kai Nakamura", "K");
    private static readonly Sender _me = new("me", "You", "Y");

    private static readonly Message[] _messages =
    [
        new("m1", new("kai", "Kai Nakamura", "K"), "Hey, have you tried the new GraphQL subscriptions endpoint?", "10:30 PM"),
        new("m2", new("me", "You", "Y"), "Not yet. Is it stable enough for production?", "10:31 PM"),
        new("m3", new("kai", "Kai Nakamura", "K"), "I've been running it for two weeks with zero downtime. Handles about 12k concurrent connections on a single instance.", "10:32 PM"),
        new("m4", new("me", "You", "Y"), "That's impressive. What's the memory footprint like under that load?", "10:33 PM"),
        new("m5", new("kai", "Kai Nakamura", "K"), "Around 480MB for the subscription server. The main bottleneck is the Redis pub/sub layer — you'll want to shard if you go above 50k connections.", "10:34 PM"),
        new("m6", new("me", "You", "Y"), "Good to know. We're expecting about 20k peak so that should be fine. I'll spin up a staging instance tomorrow.", "10:35 PM"),
        new("m7", new("kai", "Kai Nakamura", "K"), "Nice. One tip — set the heartbeat interval to 30s instead of the default 15s. Cuts bandwidth in half with no noticeable latency increase.", "10:36 PM"),
        new("m8", new("me", "You", "Y"), "Will do. Thanks for the heads up.", "10:37 PM"),
    ];

    private string _input = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
