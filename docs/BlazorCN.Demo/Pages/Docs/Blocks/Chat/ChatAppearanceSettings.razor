@* ============================================================
   Block: chat-appearance-settings
   Title: ChatAppearanceSettings
   Description: React chat appearance and theme settings panel for Next.js with font size slider, message density toggle, bubble style picker, and live preview section using TypeScript, shadcn/ui Slider, and Tailwind CSS
   Source: original/blocks/chat/chat-appearance-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground" aria-label="Back">
                <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
            </ButtonCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Appearance</span>
            </div>
            <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Settings *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            @* Font Size *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Font size
                </span>
                <div class="mt-3 px-3">
                    <SliderCn aria-label="Font size" Value="@((double)SliderFromFontSize(_fontSize))"
                              ValueChanged="@HandleSliderChange"
                              Min="0"
                              Max="100"
                              Step="50" />
                    <div class="mt-2 flex items-center justify-between">
                        @foreach (var size in _fontSizes)
                        {
                            var s = size;
                            <button type="button"
                                    @onclick="@(() => _fontSize = s)"
                                    class="@Cn.Merge("rounded px-2 py-0.5 text-xs transition-colors", _fontSize == s ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                                @_fontSizeMap[s].Label
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Message Density *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Message density
                </span>
                <div class="mt-3 flex gap-2">
                    @foreach (var d in _densities)
                    {
                        var density = d;
                        <button type="button"
                                @onclick="@(() => _density = density)"
                                class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-center text-sm capitalize transition-colors", _density == density ? "border-foreground bg-foreground text-background" : "border-muted-foreground/20 text-muted-foreground hover:border-muted-foreground/40")">
                            @density
                        </button>
                    }
                </div>
            </div>

            @* Bubble Style *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Message style
                </span>
                <div class="mt-3 flex gap-2">
                    @foreach (var st in _bubbleStyles)
                    {
                        var style = st;
                        <button type="button"
                                @onclick="@(() => _bubbleStyle = style)"
                                class="@Cn.Merge("flex flex-1 flex-col items-center gap-2 rounded-md border px-3 py-3 transition-colors", _bubbleStyle == style ? "border-foreground bg-muted/50" : "border-muted-foreground/20 hover:border-muted-foreground/40")">
                            <LucideIconCn Name="message-circle"
                                          Size="20"
                                          Class="@Cn.Merge("size-5", _bubbleStyle == style ? "text-foreground" : "text-muted-foreground")" />
                            <span class="@Cn.Merge("text-xs capitalize", _bubbleStyle == style ? "font-medium text-foreground" : "text-muted-foreground")">
                                @style
                            </span>
                        </button>
                    }
                </div>
            </div>

            @* Live Preview *@
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Preview
                </span>
                <div class="mt-3 rounded-md bg-muted/30 p-3">
                    <div class="@Cn.Merge("flex flex-col", DensityGap)">
                        @foreach (var msg in _previewMessages)
                        {
                            var isMe = msg.Sender == "me";
                            if (_bubbleStyle == "bubble")
                            {
                                <div class="@Cn.Merge("flex", isMe ? "justify-end" : "justify-start")">
                                    <div class="@Cn.Merge("max-w-[80%] rounded-2xl", DensityPadding, "leading-relaxed", TextClass, isMe ? "rounded-br-sm bg-foreground text-background" : "rounded-bl-sm bg-muted text-foreground")">
                                        @msg.Content
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="@Cn.Merge(_density == "compact" ? "px-2 py-0.5" : "px-2 py-1", "rounded transition-colors hover:bg-muted/50")">
                                    <div class="flex items-baseline gap-2">
                                        <span class="font-medium text-xs">@msg.Name</span>
                                        <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                                    </div>
                                    <p class="@Cn.Merge(TextClass, "text-foreground leading-relaxed")">
                                        @msg.Content
                                    </p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @_fontSizeMap[_fontSize].Label &middot; @(_density == "compact" ? "Compact" : "Comfortable") &middot; @(_bubbleStyle == "bubble" ? "Bubbles" : "Flat")
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record FontSizeEntry(string Label, string Class);
    private record PreviewMessage(string Id, string Content, string Sender, string Name, string Timestamp);

    private string _fontSize = "medium";
    private string _density = "comfortable";
    private string _bubbleStyle = "bubble";

    private static readonly string[] _fontSizes = ["small", "medium", "large"];
    private static readonly string[] _densities = ["compact", "comfortable"];
    private static readonly string[] _bubbleStyles = ["bubble", "flat"];

    private static readonly Dictionary<string, FontSizeEntry> _fontSizeMap = new()
    {
        ["small"] = new FontSizeEntry("Small", "text-xs"),
        ["medium"] = new FontSizeEntry("Medium", "text-sm"),
        ["large"] = new FontSizeEntry("Large", "text-base"),
    };

    private static readonly PreviewMessage[] _previewMessages =
    [
        new("p1", "The new dashboard design looks great!", "them", "Mara", "2:30 PM"),
        new("p2", "Thanks! I'm finishing up the responsive styles now.", "me", "You", "2:31 PM"),
        new("p3", "Can you share the Figma link when you're done?", "them", "Mara", "2:32 PM"),
    ];

    private string DensityPadding => _density == "compact" ? "px-3 py-1" : "px-3 py-2";
    private string DensityGap => _density == "compact" ? "gap-1" : "gap-3";
    private string TextClass => _fontSizeMap[_fontSize].Class;

    private static int SliderFromFontSize(string size) => size switch
    {
        "small" => 0,
        "medium" => 50,
        _ => 100,
    };

    private static string FontSizeFromSlider(double val)
    {
        if (val <= 33) return "small";
        if (val <= 66) return "medium";
        return "large";
    }

    private void HandleSliderChange(double val)
    {
        _fontSize = FontSizeFromSlider(val);
    }
}
