@* ============================================================
   Block: chat-warehouse-ops
   Title: ChatWarehouseOps
   Description: A warehouse management chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring inventory alerts, pick lists, shipment tracking, and operational updates
   Source: original/blocks/chat/chat-warehouse-ops.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10">
                    <LucideIconCn Name="warehouse" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Warehouse Operations</h2>
                    <p class="text-xs text-muted-foreground">Real-time ops management</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            <div class="space-y-4 p-4">
                @foreach (var msg in _messages)
                {
                    @if (msg.Type == "alerts" && msg.Alerts != null)
                    {
                        <div class="space-y-3">
                            @foreach (var alert in msg.Alerts)
                            {
                                var priorityCfg = GetPriorityConfig(alert.Priority);
                                var typIconName = GetTypeIconName(alert.Type);
                                var statusCfg = GetStatusConfig(alert.Status);
                                <div class="overflow-hidden rounded-lg border bg-muted/30">
                                    <div class="border-b bg-card px-3 py-2.5">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="flex items-start gap-2.5">
                                                <div class="@Cn.Merge("mt-0.5 flex size-8 items-center justify-center rounded-lg", priorityCfg.Bg)">
                                                    <LucideIconCn Name="@typIconName" Size="16" Class="@Cn.Merge("size-4", priorityCfg.Color)" />
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-2">
                                                        <h3 class="text-sm font-medium">@alert.Title</h3>
                                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", priorityCfg.Dot)"></span>
                                                    </div>
                                                    <p class="mt-0.5 text-xs text-muted-foreground">@alert.Description</p>
                                                </div>
                                            </div>
                                            <span class="shrink-0 text-xs text-muted-foreground">@alert.Timestamp</span>
                                        </div>
                                    </div>

                                    <div class="p-3">
                                        <div class="mb-3 flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">@alert.Location</span>
                                            <div class="flex items-center gap-1.5">
                                                <LucideIconCn Name="@statusCfg.IconName" Size="14" Class="@Cn.Merge("size-3.5", statusCfg.Color)" />
                                                <span class="@Cn.Merge("font-medium", statusCfg.Color)">@statusCfg.Label</span>
                                            </div>
                                        </div>

                                        @if (alert.Metadata != null)
                                        {
                                            var meta = alert.Metadata;
                                            <div class="mb-3 rounded-md bg-muted/50 p-2.5">
                                                <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs">
                                                    @if (!string.IsNullOrEmpty(meta.OrderId))
                                                    {
                                                        <div>
                                                            <span class="text-muted-foreground">Order: </span>
                                                            <span class="font-medium">@meta.OrderId</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(meta.Sku))
                                                    {
                                                        <div>
                                                            <span class="text-muted-foreground">SKU: </span>
                                                            <span class="font-medium">@meta.Sku</span>
                                                        </div>
                                                    }
                                                    @if (meta.Items.HasValue)
                                                    {
                                                        <div>
                                                            <span class="text-muted-foreground">Items: </span>
                                                            <span class="font-medium">@meta.Items.Value</span>
                                                        </div>
                                                    }
                                                    @if (meta.Quantity.HasValue)
                                                    {
                                                        var qtyClass = meta.Quantity.Value < 10 ? "font-medium text-red-500" : "font-medium";
                                                        <div>
                                                            <span class="text-muted-foreground">Stock: </span>
                                                            <span class="@qtyClass">@meta.Quantity.Value</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <div class="flex gap-2">
                                            @if (alert.Status == "pending")
                                            {
                                                var alertId = alert.Id;
                                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => HandleAssign(alertId))">Assign</ButtonCn>
                                                <ButtonCn Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => HandleComplete(alertId))">Start</ButtonCn>
                                            }
                                            @if (alert.Status == "in-progress")
                                            {
                                                var alertId = alert.Id;
                                                <ButtonCn Size="ButtonSize.Sm" Class="w-full gap-1.5" OnClick="@(() => HandleComplete(alertId))">
                                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                                                    Mark Complete
                                                </ButtonCn>
                                            }
                                            @if (alert.Status == "completed")
                                            {
                                                <div class="flex w-full items-center justify-center gap-1.5 rounded-md bg-emerald-500/10 py-1.5 text-emerald-600">
                                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                                                    <span class="text-xs font-medium">Completed</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "justify-end" : "justify-start")">
                            @if (msg.Type == "assistant")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-primary/10 text-xs">
                                        <LucideIconCn Name="warehouse" Size="16" Class="size-4" />
                                    </AvatarFallbackCn>
                                </AvatarCn>
                            }
                            <div class="@Cn.Merge("max-w-[80%] rounded-lg px-3 py-2", msg.Type == "user" ? "bg-primary text-primary-foreground" : "bg-muted")">
                                <p class="text-sm">@msg.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", msg.Type == "user" ? "text-primary-foreground/70" : "text-muted-foreground")">
                                    @msg.Timestamp
                                </span>
                            </div>
                            @if (msg.Type == "user")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-muted text-xs">U</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-3">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about inventory, shipments, or tasks..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record AlertMetadata(string? OrderId, string? Sku, int? Items, int? Quantity);

    private record Alert(
        string Id,
        string Type,
        string Priority,
        string Title,
        string Description,
        string Location,
        string Status,
        string Timestamp,
        AlertMetadata? Metadata = null);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        Alert[]? Alerts = null);

    private record PriorityConfig(string Color, string Bg, string Dot);
    private record StatusConfig(string IconName, string Label, string Color);

    private static PriorityConfig GetPriorityConfig(string priority) => priority switch
    {
        "low" => new("text-muted-foreground", "bg-muted", "bg-muted-foreground"),
        "medium" => new("text-blue-500", "bg-blue-500/10", "bg-blue-500"),
        "high" => new("text-amber-500", "bg-amber-500/10", "bg-amber-500"),
        "critical" => new("text-red-500", "bg-red-500/10", "bg-red-500"),
        _ => new("text-muted-foreground", "bg-muted", "bg-muted-foreground"),
    };

    private static string GetTypeIconName(string type) => type switch
    {
        "inventory" => "boxes",
        "shipment" => "truck",
        "picklist" => "package",
        _ => "box",
    };

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "pending" => new("clock", "Pending", "text-amber-500"),
        "in-progress" => new("triangle-alert", "In Progress", "text-blue-500"),
        "completed" => new("check-circle-2", "Completed", "text-emerald-500"),
        _ => new("clock", "Pending", "text-amber-500"),
    };

    private static readonly Alert[] _alerts =
    [
        new("a1", "inventory", "critical", "Low Stock Alert",
            "SKU-2847 inventory below minimum threshold",
            "Zone A, Aisle 12", "pending", "5 min ago",
            new(null, "SKU-2847", null, 8)),
        new("a2", "picklist", "high", "Urgent Pick Required",
            "Express order #ORD-5823 needs immediate picking",
            "Zone C, Multiple Aisles", "in-progress", "12 min ago",
            new("#ORD-5823", null, 15, null)),
        new("a3", "shipment", "medium", "Shipment Ready",
            "Pallet 847 packed and ready for truck loading",
            "Dock 3", "completed", "28 min ago",
            new("#ORD-5801", null, 42, null)),
    ];

    private List<Message> _messages =
    [
        new("m1", "assistant",
            "Warehouse Operations Command Center online. I'll keep you updated on inventory, picks, and shipments. What would you like to check?",
            "8:00 AM"),
        new("m2", "user", "Show me all active alerts and urgent tasks", "8:01 AM"),
        new("m3", "assistant", "Here are the current operational alerts requiring attention:", "8:01 AM"),
        new("m4", "alerts", "", "8:01 AM", _alerts),
    ];

    private void HandleAssign(string alertId)
    {
        // no-op: mirrors console.log in source
    }

    private void HandleComplete(string alertId)
    {
        // no-op: mirrors console.log in source
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var newMessage = new Message(
            $"m{_messages.Count + 1}",
            "user",
            _input,
            "8:02 AM");
        _messages.Add(newMessage);
        _input = "";
    }
}
