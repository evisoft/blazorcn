@* ============================================================
   Block: chat-community-room
   Title: ChatCommunityRoom
   Description: React public community chat room block for Next.js with room name, member count, live indicator, role badges, and collapsible rules section using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-community-room.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                <span class="font-medium text-muted-foreground text-xs">#</span>
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">General</span>
                    <span class="flex items-center gap-1.5">
                        <span class="relative flex size-1.5">
                            <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
                        </span>
                        <span class="text-emerald-600 text-xs dark:text-emerald-400">Live</span>
                    </span>
                </div>
                <span class="text-muted-foreground text-xs">1,247 members · 89 online</span>
            </div>
        </div>

        @* Collapsible rules *@
        <div class="border-b">
            <button type="button"
                    @onclick="@(() => _rulesOpen = !_rulesOpen)"
                    class="flex w-full items-center gap-2 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Community Guidelines</span>
                <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("ml-auto size-3.5 text-muted-foreground/60 transition-transform duration-200", _rulesOpen ? "rotate-90" : "")" />
            </button>
            @if (_rulesOpen)
            {
                <div class="px-4 pb-3">
                    <ul class="space-y-1.5 pl-5">
                        @foreach (var rule in _rules)
                        {
                            <li class="list-disc text-muted-foreground text-xs leading-relaxed">@rule</li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="flex flex-col gap-3">
                @foreach (var msg in _chatMessages)
                {
                    @if (msg.Type == "system")
                    {
                        <div class="flex items-center justify-center py-0.5">
                            <span class="text-muted-foreground/60 text-[10px]">@msg.Content</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-start gap-2.5">
                            <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted">
                                <span class="font-medium text-muted-foreground text-[10px]">@msg.User.Initials</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-medium text-sm">@msg.User.Name</span>
                                    @if (msg.User.Role != "member")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("h-4 px-1 text-[10px]", _roleBadgeClass[msg.User.Role])">
                                            @_roleBadgeLabel[msg.User.Role]
                                        </BadgeCn>
                                    }
                                    <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-sm leading-relaxed">@msg.Content</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="flex items-center gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Message #General..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record User(string Name, string Initials, string Role);
    private record ChatMessage(string Id, User User, string Content, string Timestamp, string Type);

    private bool _rulesOpen = false;
    private string _input = "";

    private static readonly string[] _rules =
    [
        "Be respectful and constructive in all interactions",
        "No spam, self-promotion, or off-topic content",
        "Keep discussions in English for moderation",
        "Report violations using the flag button on any message",
    ];

    private static readonly Dictionary<string, string> _roleBadgeClass = new()
    {
        ["admin"]  = "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        ["mod"]    = "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0",
        ["member"] = "",
    };

    private static readonly Dictionary<string, string> _roleBadgeLabel = new()
    {
        ["admin"]  = "Admin",
        ["mod"]    = "Mod",
        ["member"] = "Member",
    };

    private static readonly ChatMessage[] _chatMessages =
    [
        new("s1", new("", "", "member"),          "Riley Kim joined the room",                                                                                          "2:58 PM", "system"),
        new("1",  new("Elena Torres", "ET", "admin"),  "Welcome to the community! We just shipped v3.2 with the new plugin API. Check the changelog for details.",       "3:01 PM", "message"),
        new("2",  new("Marcus Webb",  "MW", "mod"),    "Pinned the release notes in #announcements. Feel free to ask questions here.",                                   "3:02 PM", "message"),
        new("3",  new("Ava Patel",    "AP", "member"), "The plugin API looks great. Is there a migration guide from the old extensions system?",                         "3:04 PM", "message"),
        new("4",  new("Elena Torres", "ET", "admin"),  "Yes, there is a step-by-step migration guide in the docs under /guides/plugin-migration. Most extensions port over with minimal changes.", "3:05 PM", "message"),
        new("5",  new("Jordan Liu",   "JL", "member"), "Has anyone tested the new webhook triggers? I need to fire events on form submission.",                          "3:07 PM", "message"),
        new("6",  new("Sam Ortiz",    "SO", "mod"),    "I set up webhook triggers last week. The form.submit event works perfectly. Make sure you enable it in Settings > Integrations first.", "3:08 PM", "message"),
        new("s2", new("", "", "member"),          "Nadia Chen left the room",                                                                                           "3:09 PM", "system"),
        new("7",  new("Riley Kim",    "RK", "member"), "Is the community call still happening Thursday at 4 PM UTC?",                                                   "3:10 PM", "message"),
        new("8",  new("Marcus Webb",  "MW", "mod"),    "Confirmed. Thursday 4 PM UTC. We will demo the new dashboard builder and take live questions.",                  "3:11 PM", "message"),
        new("9",  new("Ava Patel",    "AP", "member"), "Looking forward to it. Will there be a recording for those who cannot join live?",                               "3:12 PM", "message"),
        new("10", new("Elena Torres", "ET", "admin"),  "Absolutely. Recordings are always posted in #recordings within 24 hours.",                                       "3:13 PM", "message"),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
