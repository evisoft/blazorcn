@* ============================================================
   Block: chat-pre-chat-form
   Title: ChatPreChatForm
   Description: React pre-chat form block for Next.js with name, email, department select, and message textarea that transitions into a live chat interface using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-pre-chat-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="headset" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Acme Support</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(_chatStarted ? "Alex Rivera" : "Start a conversation")
                </p>
            </div>
        </div>

        @if (!_chatStarted)
        {
            <div class="flex flex-1 flex-col overflow-hidden">
                @* Form content *@
                <div class="flex flex-1 flex-col overflow-y-auto px-4 py-5" tabindex="0" role="group" aria-label="Pre-chat form">

                    @* Step 0: Name + Email *@
                    @if (_step == 0)
                    {
                        <div class="flex flex-1 flex-col gap-4">
                            <div class="mb-1">
                                <span class="font-medium text-sm">Tell us about yourself</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    We'll use this to personalize your experience.
                                </p>
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <span class="font-medium text-muted-foreground text-xs">Name</span>
                                <InputCn @bind-Value="_formName"
                                         Placeholder="Your full name"
                                         Class="h-9 text-sm" aria-label="Your full name" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <span class="font-medium text-muted-foreground text-xs">Email</span>
                                <InputCn @bind-Value="_formEmail"
                                         Placeholder="@("you@company.com")"
                                         Class="h-9 text-sm" aria-label="@("you@company.com")" />
                            </div>
                        </div>
                    }

                    @* Step 1: Department selection cards *@
                    @if (_step == 1)
                    {
                        <div class="flex flex-1 flex-col gap-4">
                            <div class="mb-1">
                                <span class="font-medium text-sm">Choose a department</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    Select the team best suited to help you.
                                </p>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                @foreach (var dept in _departments)
                                {
                                    var d = dept;
                                    var isSelected = _formDepartment == d.Value;
                                    <button type="button"
                                            @onclick="@(() => _formDepartment = d.Value)"
                                            class="@Cn.Merge("flex flex-col items-center gap-2 rounded-md border p-4 text-center transition-colors hover:bg-muted/50", isSelected ? "border-foreground bg-muted/50" : "")">
                                        <LucideIconCn Name="@d.IconName" Size="20" Class="@Cn.Merge("size-5", isSelected ? "text-foreground" : "text-muted-foreground")" />
                                        <span class="@Cn.Merge("font-medium text-xs", isSelected ? "text-foreground" : "text-muted-foreground")">
                                            @d.Label
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @* Step 2: Message textarea *@
                    @if (_step == 2)
                    {
                        <div class="flex flex-1 flex-col gap-4">
                            <div class="mb-1">
                                <span class="font-medium text-sm">How can we help?</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    Describe your issue or question below.
                                </p>
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <span class="font-medium text-muted-foreground text-xs">Message</span>
                                <TextareaCn @bind-Value="_formMessage"
                                            Placeholder="Describe your issue or question..."
                                            Rows="5"
                                            Class="resize-none text-sm" aria-label="Describe your issue or question..." />
                            </div>
                        </div>
                    }

                </div>

                @* Footer with stepper + nav *@
                <div class="border-t px-4 py-3">
                    <div class="mb-3 flex items-center justify-center gap-1.5">
                        @foreach (var i in new[] { 0, 1, 2 })
                        {
                            var idx = i;
                            <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", idx == _step ? "bg-foreground" : idx < _step ? "bg-foreground/40" : "bg-muted-foreground/30")"></span>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        @if (_step > 0)
                        {
                            <ButtonCn Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Sm"
                                      Class="flex-1"
                                      OnClick="@(() => _step--)">
                                Back
                            </ButtonCn>
                        }
                        @if (_step < 2)
                        {
                            <ButtonCn Size="ButtonSize.Sm"
                                      Class="flex-1"
                                      Disabled="@(_step == 0 ? !CanProceedStep0 : !CanProceedStep1)"
                                      OnClick="@(() => _step++)">
                                Continue
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Size="ButtonSize.Sm"
                                      Class="flex-1"
                                      Disabled="@(!CanProceedStep2)"
                                      OnClick="HandleStartChat">
                                Start conversation
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-1 flex-col overflow-hidden">
                @* Messages *@
                <div class="flex flex-1 flex-col gap-3 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Messages">
                    @foreach (var msg in _chatMessages)
                    {
                        var m = msg;
                        var isUser = m.Sender == "user";
                        <div class="@Cn.Merge("flex items-end gap-2", isUser ? "flex-row-reverse" : "flex-row")">
                            @if (!isUser)
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="text-[10px]">@m.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                            <div class="@Cn.Merge("flex max-w-[75%] flex-col", isUser ? "items-end" : "items-start")">
                                <div class="@Cn.Merge("rounded-2xl px-3 py-2 text-sm leading-relaxed", isUser ? "rounded-br-sm bg-foreground text-background" : "rounded-bl-sm bg-muted text-foreground")">
                                    @m.Content
                                </div>
                                <span class="mt-0.5 px-1 text-muted-foreground text-[10px]">@m.Time</span>
                            </div>
                        </div>
                    }
                </div>

                @* Input *@
                <div class="border-t px-4 py-3">
                    <div class="flex items-center gap-2">
                        <InputCn @bind-Value="_input"
                                 Placeholder="Type a message..."
                                 Class="h-9 flex-1 border-0 bg-muted/50 text-sm shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                        <ButtonCn Size="ButtonSize.Icon"
                                  Variant="ButtonVariant.Ghost"
                                  Disabled="@(string.IsNullOrWhiteSpace(_input))"
                                  Class="size-9 shrink-0 text-muted-foreground hover:text-foreground"
                                  OnClick="HandleSend" aria-label="Send message">
                            <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Department(string Value, string Label, string IconName);

    private record ChatMessage(string Id, string Sender, string Name, string Initials, string Content, string Time);

    private static readonly Department[] _departments =
    [
        new("sales",   "Sales",             "shopping-bag"),
        new("support", "Technical Support", "settings"),
        new("billing", "Billing",           "credit-card"),
        new("general", "General Inquiry",   "help-circle"),
    ];

    private static readonly ChatMessage[] _agentReplies =
    [
        new("a1", "agent", "Alex Rivera", "AR",
            "Hi there! Thanks for reaching out. I can see you're contacting our Technical Support team.",
            "3:01 PM"),
        new("a2", "agent", "Alex Rivera", "AR",
            "I've reviewed your message. Let me pull up your account details and I'll have an answer for you shortly.",
            "3:02 PM"),
    ];

    private int _step = 0;
    private bool _chatStarted = false;

    private string _formName = "";
    private string _formEmail = "";
    private string _formDepartment = "";
    private string _formMessage = "";

    private List<ChatMessage> _chatMessages = [];
    private string _input = "";

    private bool CanProceedStep0 => !string.IsNullOrWhiteSpace(_formName) && !string.IsNullOrWhiteSpace(_formEmail);
    private bool CanProceedStep1 => _formDepartment != "";
    private bool CanProceedStep2 => !string.IsNullOrWhiteSpace(_formMessage);

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = string.Concat(parts.Select(p => p[0])).ToUpperInvariant();
        return initials.Length > 2 ? initials[..2] : initials;
    }

    private void HandleStartChat()
    {
        if (!CanProceedStep2) return;
        var userMsg = new ChatMessage("u1", "user", _formName, GetInitials(_formName), _formMessage, "3:00 PM");
        _chatMessages = [userMsg, .._agentReplies];
        _chatStarted = true;
    }

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
