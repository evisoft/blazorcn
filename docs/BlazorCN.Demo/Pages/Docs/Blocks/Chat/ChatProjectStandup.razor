@* ============================================================
   Block: chat-project-standup
   Title: ChatProjectStandup
   Description: A structured daily standup assistant built with React, Next.js, shadcn/ui, and Tailwind CSS featuring yesterday/today/blockers format and team update tracking
   Source: original/blocks/chat/chat-project-standup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Daily Standup</h2>
                    <p class="text-xs text-muted-foreground">Monday, March 30</p>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                <span>2 of 5 completed</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            @foreach (var msg in _messages)
            {
                var message = msg;
                <div class="@Cn.Merge("flex", message.Type == "user" ? "justify-end" : "justify-start")">
                    <div class="@Cn.Merge("max-w-[85%] space-y-2", message.Type == "user" ? "items-end" : "items-start")">
                        @if (message.Author != null)
                        {
                            <div class="flex items-center gap-2">
                                <div class="flex size-6 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                    @message.Author.Avatar
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <span class="font-medium">@message.Author.Name</span>
                                    <span class="text-muted-foreground">•</span>
                                    <span class="text-muted-foreground">@message.Author.Role</span>
                                </div>
                            </div>
                        }

                        <div class="@Cn.Merge("rounded-lg px-3 py-2", message.Type == "user" ? "bg-foreground text-background" : "bg-muted")">
                            <p class="text-sm">@message.Content</p>
                        </div>

                        @if (message.Standup != null)
                        {
                            <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                @* Yesterday *@
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                        <span class="text-xs font-medium">Yesterday</span>
                                    </div>
                                    <ul class="space-y-1 pl-5">
                                        @foreach (var item in message.Standup.Yesterday)
                                        {
                                            <li class="text-sm">@item</li>
                                        }
                                    </ul>
                                </div>

                                @* Today *@
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-blue-500" />
                                        <span class="text-xs font-medium">Today</span>
                                    </div>
                                    <ul class="space-y-1 pl-5">
                                        @foreach (var item in message.Standup.Today)
                                        {
                                            <li class="text-sm">@item</li>
                                        }
                                    </ul>
                                </div>

                                @* Blockers *@
                                @if (message.Standup.Blockers.Length > 0)
                                {
                                    <div class="space-y-2 rounded-md bg-red-500/10 p-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-red-500" />
                                            <span class="text-xs font-medium text-red-500">Blockers</span>
                                        </div>
                                        <ul class="space-y-1 pl-5">
                                            @foreach (var item in message.Standup.Blockers)
                                            {
                                                <li class="text-sm text-red-600">@item</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (message.Standup.Blockers.Length == 0)
                                {
                                    <div class="flex items-center gap-2 rounded-md bg-emerald-500/10 px-2 py-1.5">
                                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                                        <span class="text-xs text-emerald-600">No blockers</span>
                                    </div>
                                }
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0">
                    <LucideIconCn Name="clock" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="Share your standup update..."
                         Class="border-0 bg-transparent shadow-none focus-visible:ring-0" />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0" Disabled="@string.IsNullOrWhiteSpace(_input)">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record MessageAuthor(string Name, string Avatar, string Role);
    private record StandupData(string[] Yesterday, string[] Today, string[] Blockers);
    private record Message(string Id, string Type, string Content, string Timestamp, MessageAuthor? Author = null, StandupData? Standup = null);

    private string _input = "";

    private static readonly Message[] _messages =
    [
        new("1", "assistant",
            "Good morning! Ready for today's standup? Share what you accomplished yesterday, what you're working on today, and any blockers.",
            "9:00 AM"),
        new("2", "user",
            "Here's my update for today:",
            "9:05 AM",
            new MessageAuthor("Alex Rivera", "AR", "Frontend Developer"),
            new StandupData(
                ["Completed user authentication flow", "Fixed navigation bugs on mobile", "Reviewed 3 PRs from the team"],
                ["Implement dashboard analytics charts", "Start work on notification system"],
                ["Waiting for API endpoint documentation from backend team"]
            )),
        new("3", "assistant",
            "Thanks Alex! I've noted your blocker about the API docs. I'll flag this for the backend team. Great progress on the auth flow!",
            "9:06 AM"),
        new("4", "user",
            "Standup update:",
            "9:12 AM",
            new MessageAuthor("Jordan Kim", "JK", "Backend Engineer"),
            new StandupData(
                ["Deployed payment webhook handler to production", "Optimized database queries for user dashboard"],
                ["Finish API documentation for analytics endpoints", "Review and merge pending database migration"],
                []
            )),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
