@* ============================================================
   Block: chat-broadcast-channel
   Title: ChatBroadcastChannel
   Description: React broadcast channel block for Next.js with admin badge, read-only layout, view counts, subscribe toggle, and one-to-many messaging using shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-broadcast-channel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="megaphone" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_channelName</span>
                <span class="ml-2 text-muted-foreground text-xs">
                    @_subscriberCount subscribers
                </span>
            </div>
            <ButtonCn Variant="@(_subscribed ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs"
                      OnClick="@(() => _subscribed = !_subscribed)">
                @if (_subscribed)
                {
                    <LucideIconCn Name="bell" Size="12" Class="size-3" />
                    @("Subscribed")
                }
                else
                {
                    <LucideIconCn Name="bell-off" Size="12" Class="size-3" />
                    @("Subscribe")
                }
            </ButtonCn>
        </div>

        @* Messages (read-only post-style) *@
        <div class="flex-1 overflow-y-auto">
            @foreach (var msg in _messages)
            {
                var isLast = msg.Id == _messages[_messages.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-4">
                        @* Author row *@
                        <div class="mb-2 flex items-center gap-2">
                            <AvatarCn Class="size-7">
                                <AvatarFallbackCn Class="text-xs">@msg.AuthorInitials</AvatarFallbackCn>
                            </AvatarCn>
                            <span class="font-medium text-sm">@msg.AuthorName</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                Admin
                            </BadgeCn>
                            <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                        </div>

                        @* Title *@
                        <p class="mb-1 font-medium text-sm">@msg.Title</p>

                        @* Content *@
                        <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@msg.Content</p>

                        @* Footer: view count + reactions *@
                        <div class="flex items-center gap-4">
                            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                <span class="tabular-nums">@msg.Views</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                <span class="tabular-nums">@msg.ThumbsUp</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                <span class="tabular-nums">@msg.Heart</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Read-only footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Only admins can post to this channel
            </p>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string AuthorName, string AuthorInitials, string Title, string Content, string Timestamp, string Views, int ThumbsUp, int Heart);

    private const string _channelName = "Product Updates";
    private const string _subscriberCount = "2,847";

    private bool _subscribed = true;

    private static readonly Message[] _messages =
    [
