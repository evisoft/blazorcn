@* ============================================================
   Block: chat-karaoke-party
   Title: ChatKaraokeParty
   Description: A karaoke party chat block for React and Next.js with song queue, lyrics display, audience reactions, and duet requests built with shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-karaoke-party.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Karaoke Night</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                    4 in queue
                </BadgeCn>
            </div>
            <div class="flex items-center gap-1 text-muted-foreground text-xs">
                <span class="size-1.5 animate-pulse rounded-full bg-red-500"></span>
                <span>Live</span>
            </div>
        </div>

        @* Queue bar *@
        <div class="flex items-center gap-2 overflow-x-auto border-b px-4 py-2">
            <LucideIconCn Name="list-music" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            @foreach (var song in _queueSongs)
            {
                var songItem = song;
                <div class="@Cn.Merge("flex shrink-0 items-center gap-1.5 rounded-md px-2 py-1", songItem.Status == "singing" ? "bg-foreground/10" : "bg-muted/50")">
                    @if (songItem.Status == "singing")
                    {
                        <LucideIconCn Name="music-2" Size="12" Class="size-3 text-foreground" />
                    }
                    <span class="text-[10px] font-medium whitespace-nowrap">@songItem.Title</span>
                    <span class="text-[10px] text-muted-foreground">· @songItem.Singer</span>
                </div>
            }
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-3">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    <div class="flex gap-3">
                        <AvatarCn Class="mt-0.5 size-7 shrink-0">
                            <AvatarFallbackCn Class="@Cn.Merge("text-[10px]", message.Color)">@message.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@message.Sender</span>
                                <span class="text-muted-foreground text-[10px]">@message.Timestamp</span>
                            </div>

                            @if (message.Type == "text")
                            {
                                <p class="mt-0.5 text-sm leading-relaxed">@message.Content</p>
                            }

                            @if (message.Type == "now-playing" && message.Song != null)
                            {
                                <div class="mt-1.5 flex items-center gap-3 rounded-md border bg-muted/30 p-2.5">
                                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-foreground/10">
                                        <LucideIconCn Name="mic" Size="16" Class="size-4 text-foreground" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-medium text-sm">Now Playing</p>
                                        <p class="text-muted-foreground text-xs">
                                            @message.Song.Title · @message.Song.Artist
                                        </p>
                                        <p class="mt-0.5 text-muted-foreground text-[10px]">
                                            Performing: @message.Song.Singer
                                        </p>
                                    </div>
                                    <LucideIconCn Name="star" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                </div>
                            }

                            @if (message.Type == "queue-add" && message.Song != null)
                            {
                                <div class="mt-1 rounded-md bg-muted/50 p-2">
                                    <p class="text-xs">
                                        <span class="text-muted-foreground">Added to queue: </span>
                                        <span class="font-medium">@message.Song.Title</span>
                                        <span class="text-muted-foreground"> by @message.Song.Artist</span>
                                    </p>
                                </div>
                            }

                            @if (message.Type == "reaction-burst" && message.Reactions != null)
                            {
                                <div class="mt-1 flex items-center gap-2">
                                    @foreach (var r in message.Reactions)
                                    {
                                        var reaction = r;
                                        <span class="inline-flex items-center gap-1 rounded-full bg-muted/50 px-2 py-0.5 text-xs">
                                            @reaction.Emoji @reaction.Count
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <InputCn @bind-Value="_input"
                         Placeholder="Cheer, request a song, or find a duet partner..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground"
                          OnClick="HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SongInfo(string Title, string Artist, string Singer, string SingerInitials);
    private record Reaction(string Emoji, int Count);
    private record ChatMessage(string Id, string Sender, string Initials, string Color, string Timestamp, string Type, string? Content, SongInfo? Song, Reaction[]? Reactions);
    private record QueueSong(int Position, string Title, string Artist, string Singer, string Status);

    private string _input = "";

    private static readonly QueueSong[] _queueSongs =
    [
        new(1, "Bohemian Rhapsody",    "Queen",       "Alex",  "singing"),
        new(2, "Don't Stop Believin'", "Journey",     "Priya", "next"),
        new(3, "Sweet Caroline",       "Neil Diamond", "Marco", "queued"),
        new(4, "Livin' on a Prayer",   "Bon Jovi",    "Yuki",  "queued"),
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "System",        "DJ", "bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300", "9:15 PM", "now-playing",    null,                                                                                          new SongInfo("Bohemian Rhapsody",  "Queen",    "Alex", "AK"), null),
        new("m2", "Priya Sharma",  "PS", "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300", "9:16 PM", "text",        "Let's gooo! This is going to be epic 🎤",                                                    null,                                                         null),
        new("m3", "Marco Rivera",  "MR", "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300",    "9:16 PM", "reaction-burst",  null,                                                                                          null,                                                         [new("🔥", 5), new("🎵", 3), new("👏", 8)]),
        new("m4", "Yuki Tanaka",   "YT", "bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300",        "9:17 PM", "queue-add",       null,                                                                                          new SongInfo("Livin' on a Prayer", "Bon Jovi", "Yuki", "YT"), null),
        new("m5", "Alex Kim",      "AK", "bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300",        "9:18 PM", "text",            "Is this the real life? Is this just fantasy? Nailing the high notes tonight!",                null,                                                         null),
        new("m6", "Priya Sharma",  "PS", "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300", "9:19 PM", "text",        "Someone duet with me on Don't Stop Believin'! It's better with two.",                       null,                                                         null),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
