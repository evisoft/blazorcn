@* ============================================================
   Block: chat-queue-position
   Title: ChatQueuePosition
   Description: React queue position waiting screen chat block for Next.js with animated position counter, circular progress ring, estimated wait time, agent availability count, rotating tips, and leave-a-message fallback using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-queue-position.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Support Queue</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 animate-pulse rounded-full bg-amber-500"></span>
                    Waiting for agent
                </p>
            </div>
            <span class="text-muted-foreground text-xs">@_queue.AgentsOnline agents online</span>
        </div>

        @* Content *@
        <div class="flex flex-1 flex-col items-center justify-center px-4 py-6">
            @if (_view == QueueView.Waiting)
            {
                <div class="flex w-full max-w-sm flex-col items-center gap-6">
                    @* Queue position circle *@
                    <div class="relative flex size-32 items-center justify-center">
                        <svg
                            class="-rotate-90 absolute inset-0 size-full"
                            viewBox="0 0 128 128"
                            aria-hidden="true">
                            <title>Queue progress</title>
                            <circle
                                cx="64"
                                cy="64"
                                r="56"
                                fill="none"
                                stroke-width="4"
                                class="stroke-muted" />
                            <circle
                                cx="64"
                                cy="64"
                                r="56"
                                fill="none"
                                stroke-width="4"
                                stroke-linecap="round"
                                class="stroke-foreground transition-all duration-600 ease-in-out"
                                stroke-dasharray="@_circumference.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@_strokeDashoffset.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)" />
                        </svg>
                        <div class="flex flex-col items-center">
                            <span class="font-semibold text-4xl tabular-nums">#@_queue.Position</span>
                            <span class="text-muted-foreground text-xs">in queue</span>
                        </div>
                    </div>

                    @* Wait time & agents *@
                    <div class="flex items-center gap-4">
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            Est. wait: @_queue.EstimatedWait
                        </span>
                        <span class="text-muted-foreground/40 text-xs">&middot;</span>
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                            @_queue.AgentsBusy/@_queue.AgentsOnline agents busy
                        </span>
                    </div>

                    @* Tip *@
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-center text-muted-foreground text-xs leading-relaxed">
                            @_tips[_tipIndex]
                        </p>
                    </div>

                    @* Actions *@
                    <div class="flex w-full flex-col gap-2">
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="w-full text-xs"
                            OnClick="AdvanceQueue"
                            Disabled="@(_queueIndex >= _queueStates.Length - 1)">
                            Simulate position update
                        </ButtonCn>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="w-full gap-1.5 text-muted-foreground text-xs hover:text-foreground"
                            OnClick="@(() => _view = QueueView.Message)">
                            <LucideIconCn Name="mail" Size="12" Class="size-3" />
                            Leave a message instead
                        </ButtonCn>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="w-full gap-1.5 text-muted-foreground text-xs hover:text-foreground"
                            OnClick="@(() => _view = QueueView.Cancelled)">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                            Cancel
                        </ButtonCn>
                    </div>
                </div>
            }

            @if (_view == QueueView.Message)
            {
                <div class="flex w-full max-w-sm flex-col gap-4">
                    <div>
                        <span class="block font-medium text-sm">Leave a message</span>
                        <p class="mt-1 text-muted-foreground text-xs">
                            We'll respond within 2 hours via email. You won't lose your queue position.
                        </p>
                    </div>
                    <form @onsubmit="HandleSendMessage" @onsubmit:preventDefault class="flex flex-col gap-3">
                        <TextareaCn
                            @bind-Value="_message"
                            Placeholder="Describe your issue..."
                            Rows="4"
                            Class="resize-none text-sm" />
                        <div class="flex gap-2">
                            <ButtonCn
                                Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.Sm"
                                Type="button"
                                Class="flex-1 text-xs"
                                OnClick="@(() => _view = QueueView.Waiting)">
                                Cancel
                            </ButtonCn>
                            <ButtonCn
                                Type="submit"
                                Size="ButtonSize.Sm"
                                Disabled="@(string.IsNullOrWhiteSpace(_message))"
                                Class="flex-1 gap-1.5 text-xs">
                                <LucideIconCn Name="send" Size="12" Class="size-3" />
                                Send message
                            </ButtonCn>
                        </div>
                    </form>
                </div>
            }

            @if (_view == QueueView.Sent)
            {
                <div class="flex flex-col items-center gap-3 py-8">
                    <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="mail" Size="24" Class="size-6 text-emerald-500" />
                    </div>
                    <span class="font-medium text-sm">Message sent</span>
                    <p class="text-center text-muted-foreground text-xs">
                        We received your message and will get back to you within 2 hours via email.
                    </p>
                    <ButtonCn
                        Variant="ButtonVariant.Outline"
                        Size="ButtonSize.Sm"
                        Class="mt-2 text-xs"
                        OnClick="BackToQueue">
                        Back to queue
                    </ButtonCn>
                </div>
            }

            @if (_view == QueueView.Cancelled)
            {
                <div class="flex flex-col items-center gap-3 py-8">
                    <div class="flex size-12 items-center justify-center rounded-full bg-muted">
                        <LucideIconCn Name="x" Size="24" Class="size-6 text-muted-foreground" />
                    </div>
                    <span class="font-medium text-sm">Queue cancelled</span>
                    <p class="text-center text-muted-foreground text-xs">
                        You've left the queue. You can rejoin anytime or leave us a message.
                    </p>
                    <div class="mt-2 flex gap-2">
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="text-xs"
                            OnClick="RejoinQueue">
                            Rejoin queue
                        </ButtonCn>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="text-xs"
                            OnClick="@(() => _view = QueueView.Message)">
                            Leave a message
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer status bar *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-2">
                <span class="@Cn.Merge("size-1.5 rounded-full", _view == QueueView.Waiting ? "animate-pulse bg-amber-500" : "bg-muted-foreground/40")"></span>
                <span class="text-muted-foreground text-xs">
                    @if (_view == QueueView.Waiting)
                    {
                        @($"Position {_queue.Position} · {_queue.EstimatedWait} estimated")
                    }
                    else if (_view == QueueView.Cancelled)
                    {
                        @:You've left the queue
                    }
                    else
                    {
                        @:You're still in the queue
                    }
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum QueueView { Waiting, Message, Sent, Cancelled }

    private record QueueStatus(int Position, string EstimatedWait, int AgentsOnline, int AgentsBusy);

    private static readonly QueueStatus[] _queueStates =
    [
        new(5, "~8 min", 4, 4),
        new(4, "~6 min", 4, 4),
        new(3, "~4 min", 4, 3),
        new(2, "~3 min", 4, 3),
        new(1, "~1 min", 4, 2),
    ];

    private static readonly string[] _tips =
    [
        "While you wait: check our help center for instant answers to common questions.",
        "Tip: Having your account email and order number ready will help us resolve your issue faster.",
        "Did you know? You can manage billing, update your profile, and view invoices from your dashboard.",
    ];

    private static readonly double _circumference = 2 * Math.PI * 56;

    private int _queueIndex = 0;
    private QueueView _view = QueueView.Waiting;
    private string _message = "";

    private QueueStatus _queue => _queueStates[_queueIndex];
    private int _tipIndex => _queueIndex % _tips.Length;
    private double _progress => 1.0 - (double)_queue.Position / _queueStates[0].Position;
    private double _strokeDashoffset => _circumference * (1 - _progress);

    private void AdvanceQueue()
    {
        if (_queueIndex < _queueStates.Length - 1)
        {
            _queueIndex++;
        }
    }

    private void HandleSendMessage()
    {
        if (string.IsNullOrWhiteSpace(_message)) return;
        _view = QueueView.Sent;
    }

    private void BackToQueue()
    {
        _view = QueueView.Waiting;
        _message = "";
    }

    private void RejoinQueue()
    {
        _queueIndex = 0;
        _view = QueueView.Waiting;
    }
}
