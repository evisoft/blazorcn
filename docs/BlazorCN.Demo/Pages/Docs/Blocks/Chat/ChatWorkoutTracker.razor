@* ============================================================
   Block: chat-workout-tracker
   Title: ChatWorkoutTracker
   Description: React workout tracking chat block for Next.js with exercise cards, set logging, rest timers, muscle group tags, and progress indicators using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-workout-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="dumbbell" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Workout Tracker</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Upper Body
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">AI Training Assistant</span>
            </div>
        </div>

        @* Session stats *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="dumbbell" Size="12" Class="size-3" />
                @_sessionStats.SetsCompleted/@_sessionStats.SetsTotal sets
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="flame" Size="12" Class="size-3" />
                @_sessionStats.TotalVolume
            </span>
            <span class="ml-auto flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="timer" Size="12" Class="size-3" />
                @_sessionStats.Elapsed
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "user" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "user"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">

                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }

                            @* Exercise cards *@
                            @if (msg.Exercises != null)
                            {
                                @foreach (var exercise in msg.Exercises)
                                {
                                    var completedSets = exercise.Sets.Count(s => s.Completed);
                                    <div class="mt-2 rounded-md border bg-card p-3">
                                        <div class="mb-2 flex items-center justify-between">
                                            <div class="flex items-center gap-1.5">
                                                <LucideIconCn Name="dumbbell" Size="14" Class="size-3.5 text-muted-foreground" />
                                                <span class="font-medium text-sm">@exercise.Name</span>
                                            </div>
                                            <div class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                                <span class="tabular-nums">@(exercise.RestSeconds)s rest</span>
                                            </div>
                                        </div>

                                        <div class="mb-2.5 flex flex-wrap gap-1">
                                            @foreach (var grp in exercise.MuscleGroups)
                                            {
                                                var colorClass = _muscleGroupColor.TryGetValue(grp, out var c) ? c : "bg-muted/50 text-muted-foreground";
                                                <span class="@($"rounded-full px-2 py-0.5 text-xs {colorClass}")">@grp</span>
                                            }
                                        </div>

                                        <div class="space-y-0">
                                            <div class="flex items-center gap-2 px-1 pb-1.5">
                                                <span class="w-8 text-muted-foreground text-xs">Set</span>
                                                <span class="flex-1 text-muted-foreground text-xs">Target</span>
                                                <span class="w-16 text-right text-muted-foreground text-xs">Weight</span>
                                                <span class="w-6"></span>
                                            </div>
                                            @foreach (var set in exercise.Sets)
                                            {
                                                <div class="flex items-center gap-2 border-t px-1 py-1.5">
                                                    <span class="w-8 font-mono text-xs tabular-nums">@set.SetNumber</span>
                                                    <span class="flex-1 text-sm tabular-nums">@(set.Reps) reps</span>
                                                    <span class="w-16 text-right font-mono text-xs tabular-nums">@set.Weight</span>
                                                    <span class="flex w-6 justify-center">
                                                        @if (set.Completed)
                                                        {
                                                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                                                        }
                                                        else
                                                        {
                                                            <LucideIconCn Name="circle" Size="16" Class="size-4 text-muted-foreground/30" />
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>

                                        <div class="mt-2.5 flex items-center justify-between border-t pt-2.5">
                                            <span class="text-muted-foreground text-xs">
                                                @completedSets/@(exercise.Sets.Length) sets logged
                                            </span>
                                            @if (!string.IsNullOrEmpty(exercise.Notes))
                                            {
                                                <span class="max-w-[60%] truncate text-muted-foreground text-xs italic">@exercise.Notes</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }

                            <span class="@(msg.Role == "user"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Log a set or ask for adjustments..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record SessionStats(string TotalVolume, int SetsCompleted, int SetsTotal, string Elapsed);

    private record ExerciseSet(int SetNumber, int Reps, string Weight, bool Completed);

    private record Exercise(string Name, string[] MuscleGroups, ExerciseSet[] Sets, int RestSeconds, string? Notes = null);

    private record Message(string Id, string Role, string Content, string Timestamp, Exercise[]? Exercises = null);

    private readonly SessionStats _sessionStats = new("12,480 lbs", 14, 20, "38 min");

    private readonly Dictionary<string, string> _muscleGroupColor = new()
    {
        ["Chest"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["Triceps"] = "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        ["Shoulders"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["Back"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["Core"] = "bg-red-500/10 text-red-600 dark:text-red-400",
    };

    private readonly Message[] _messages =
    [
        new("1", "trainer",
            "Let's hit upper body today. I've adjusted the weight based on your last session — you hit a PR on bench press, so we're keeping that weight and adding a rep.",
            "6:15 AM"),
        new("2", "user",
            "Feeling strong today. Let's go heavier on the incline press too.",
            "6:16 AM"),
        new("3", "trainer",
            "Done. Here's your first two exercises. Log each set as you finish:",
            "6:17 AM"),
        new("4", "trainer", "", "6:17 AM",
            Exercises:
            [
                new("Flat Barbell Bench Press", ["Chest", "Triceps"],
                [
                    new(1, 8, "185 lbs", true),
                    new(2, 8, "185 lbs", true),
                    new(3, 7, "185 lbs", true),
                    new(4, 6, "185 lbs", false),
                ], 90, "Keep shoulder blades retracted. Pause at the bottom."),
                new("Incline Dumbbell Press", ["Chest", "Shoulders"],
                [
                    new(1, 10, "65 lbs", true),
                    new(2, 10, "65 lbs", true),
                    new(3, 8, "65 lbs", false),
                ], 75, "30-degree incline. Control the negative for 3 seconds."),
            ]),
        new("5", "user",
            "Bench felt solid. Missed the last rep on set 4 though — had to grind it out. Incline feels heavier today.",
            "6:34 AM"),
        new("6", "trainer",
            "That's expected after 3 heavy sets. Drop the incline to 60 lbs for the last set if you need to. Here's the next superset for triceps and core:",
            "6:35 AM"),
        new("7", "trainer", "", "6:35 AM",
            Exercises:
            [
                new("Cable Tricep Pushdown", ["Triceps"],
                [
                    new(1, 15, "40 lbs", true),
                    new(2, 15, "40 lbs", true),
                    new(3, 12, "40 lbs", false),
                ], 45),
                new("Hanging Leg Raise", ["Core"],
                [
                    new(1, 12, "BW", true),
                    new(2, 12, "BW", false),
                    new(3, 10, "BW", false),
                ], 45),
            ]),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
