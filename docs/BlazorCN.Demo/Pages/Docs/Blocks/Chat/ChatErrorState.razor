@* ============================================================
   Block: chat-error-state
   Title: ChatErrorState
   Description: React chat error and disconnected state block for Next.js with AlertTriangle icon, reconnection spinner, retry button, and grayed-out messages using TypeScript, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/chat/chat-error-state.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <span class="font-medium text-muted-foreground text-xs">MP</span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Morgan Park</span>
                <p class="text-muted-foreground text-xs">
                    @(_isDisconnected ? "Disconnected" : "Online")
                </p>
            </div>
            @if (!_isDisconnected)
            {
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2 text-muted-foreground text-xs"
                          @onclick="HandleDisconnect">
                    Simulate error
                </ButtonCn>
            }
        </div>

        @* Messages area with overlay *@
        <div class="relative flex flex-1 flex-col overflow-y-auto">
            @* Messages -- reduced opacity when disconnected *@
            <div class="@Cn.Merge("flex flex-1 flex-col gap-1 px-4 py-3 transition-opacity duration-300", _isDisconnected ? "opacity-40" : "opacity-100")">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex flex-col", msg.Sender == "me" ? "items-end" : "items-start")">
                        <div class="@Cn.Merge("max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed", msg.Sender == "me" ? "bg-foreground text-background" : "bg-muted text-foreground")">
                            @msg.Content
                        </div>
                        <span class="mt-0.5 px-1 text-[10px] text-muted-foreground">@msg.Timestamp</span>
                    </div>
                }
            </div>

            @* Error overlay *@
            @if (_isDisconnected)
            {
                <div class="absolute inset-0 flex items-center justify-center bg-background/80 backdrop-blur-sm">
                    <div class="flex flex-col items-center gap-3 px-6 py-5">
                        <div class="flex size-10 items-center justify-center rounded-full bg-red-500/10">
                            <LucideIconCn Name="alert-triangle" Size="20" Class="size-5 text-red-500" />
                        </div>
                        <div class="text-center">
                            <p class="font-medium text-sm">Connection lost</p>
                            <div class="mt-1.5 flex items-center justify-center gap-1.5 text-muted-foreground text-xs">
                                @if (_isRetrying)
                                {
                                    <LucideIconCn Name="loader" Size="12" Class="size-3 animate-spin" />
                                    <span>Attempting to reconnect...</span>
                                }
                                else
                                {
                                    <span>Unable to reach the server</span>
                                }
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Disabled="@_isRetrying"
                                  Class="mt-1 h-7 gap-1.5 px-3 text-xs"
                                  @onclick="HandleRetry">
                            <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                            Retry
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn Placeholder="@(_isDisconnected ? "Cannot send while disconnected..." : "Type a message...")"
                         Disabled="@_isDisconnected"
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0 disabled:cursor-not-allowed disabled:opacity-50" />
                <ButtonCn type="button"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@_isDisconnected"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Content, string Sender, string Timestamp);

    private bool _isDisconnected = true;
    private bool _isRetrying = false;

    private static readonly Message[] _messages =
    [
        new("m1", "Did you push the migration script to staging?",                                               "them", "3:41 PM"),
        new("m2", "Yes, it ran successfully. Zero downtime.",                                                    "me",   "3:42 PM"),
        new("m3", "Great. Can you also update the seed data? The QA team needs fresh records for their test suite.", "them", "3:43 PM"),
        new("m4", "On it. I'll regenerate the fixtures and push in about 10 minutes.",                           "me",   "3:44 PM"),
        new("m5", "Perfect, ping me when it's ready.",                                                           "them", "3:45 PM"),
    ];

    private async Task HandleRetry()
    {
        _isRetrying = true;
        await Task.Delay(2000);
        _isRetrying = false;
        _isDisconnected = false;
    }

    private void HandleDisconnect()
    {
        _isDisconnected = true;
    }
}
