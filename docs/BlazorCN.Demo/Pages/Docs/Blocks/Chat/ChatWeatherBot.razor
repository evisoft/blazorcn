@* ============================================================
   Block: chat-weather-bot
   Title: ChatWeatherBot
   Description: React weather forecast bot chat interface for Next.js with temperature cards, hourly forecasts, condition icons, and natural language queries using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-weather-bot.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="bg-foreground text-background">
                    <LucideIconCn Name="cloud-sun" Size="16" Class="size-4" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Weather Bot</span>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground text-xs">Online</span>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="flex flex-col gap-3">
                @foreach (var msg in _messages)
                {
                    var isUser = msg.Role == "user";
                    <div class="@Cn.Merge("flex flex-col", isUser ? "items-end" : "items-start")">
                        <div class="mb-0.5 flex items-center gap-1.5 px-1">
                            <span class="font-medium text-xs">@(isUser ? "You" : "Weather Bot")</span>
                            <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                        </div>
                        @if (msg.Content != null)
                        {
                            <div class="@Cn.Merge("max-w-[80%] rounded-2xl px-3 py-2 text-sm leading-relaxed", isUser ? "bg-foreground text-background" : "bg-muted text-foreground")">
                                @msg.Content
                            </div>
                        }
                        @if (msg.Forecast != null)
                        {
                            var forecast = msg.Forecast;
                            var tempColor = forecast.CurrentTemp >= 80
                                ? "text-red-600 dark:text-red-400"
                                : forecast.CurrentTemp >= 60
                                    ? "text-amber-600 dark:text-amber-400"
                                    : "text-blue-600 dark:text-blue-400";
                            <div class="mt-1.5 w-full max-w-sm overflow-hidden rounded-md border">
                                @* City + condition *@
                                <div class="flex items-center justify-between border-b px-3 py-2">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="thermometer" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">@forecast.City</span>
                                    </div>
                                    <span class="text-muted-foreground text-xs">@GetConditionLabel(forecast.Condition)</span>
                                </div>

                                @* Current temperature *@
                                <div class="flex items-center gap-4 border-b px-3 py-3">
                                    <div class="flex items-center gap-2">
                                        @RenderConditionIcon(forecast.Condition, false)
                                        <span class="@Cn.Merge("font-semibold text-3xl tabular-nums", tempColor)">@forecast.CurrentTemp°</span>
                                    </div>
                                    <div class="flex flex-col gap-0.5">
                                        <span class="text-muted-foreground text-xs">H: @forecast.High° · L: @forecast.Low°</span>
                                        <div class="flex items-center gap-3">
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="droplet" Size="12" Class="size-3" />
                                                @forecast.Humidity%
                                            </span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="wind" Size="12" Class="size-3" />
                                                @forecast.WindSpeed
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                @* Hourly forecast *@
                                <div class="flex items-center gap-0 overflow-x-auto">
                                    @foreach (var hour in forecast.Hourly)
                                    {
                                        <div class="flex min-w-[60px] flex-1 flex-col items-center gap-1 border-r px-2 py-2 last:border-r-0">
                                            <span class="text-muted-foreground text-[10px]">@hour.Time</span>
                                            @RenderConditionIcon(hour.Condition, true)
                                            <span class="font-mono text-xs tabular-nums">@hour.Temp°</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Quick city buttons *@
        <div class="border-t px-4 py-2">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var city in _quickCities)
                {
                    var cityCapture = city;
                    <button type="button" @onclick="@(() => _input = $"Weather in {cityCapture}")"
                            class="rounded-md border bg-muted/30 px-2.5 py-1 text-muted-foreground text-xs transition-colors hover:bg-muted/60 hover:text-foreground">
                        @city
                    </button>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="flex items-center gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Type a city name..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn Type="submit"
                           Size="ButtonSize.Icon"
                           Variant="ButtonVariant.Ghost"
                           Disabled="@(string.IsNullOrWhiteSpace(_input))"
                           Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private string _input = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private static string GetConditionLabel(string condition) => condition switch
    {
        "sunny"         => "Sunny",
        "partly_cloudy" => "Partly Cloudy",
        "cloudy"        => "Cloudy",
        "rain"          => "Rain",
        _               => condition,
    };

    private static RenderFragment RenderConditionIcon(string condition, bool small) => condition switch
    {
        "sunny"         => small
            ? @<LucideIconCn Name="sun" Size="14" Class="size-3.5 text-amber-500" />
            : @<LucideIconCn Name="sun" Size="20" Class="size-5 text-amber-500" />,
        "partly_cloudy" => small
            ? @<LucideIconCn Name="cloud-sun" Size="14" Class="size-3.5 text-amber-400" />
            : @<LucideIconCn Name="cloud-sun" Size="20" Class="size-5 text-amber-400" />,
        "cloudy"        => small
            ? @<LucideIconCn Name="cloud" Size="14" Class="size-3.5 text-muted-foreground" />
            : @<LucideIconCn Name="cloud" Size="20" Class="size-5 text-muted-foreground" />,
        "rain"          => small
            ? @<LucideIconCn Name="cloud-rain" Size="14" Class="size-3.5 text-blue-400" />
            : @<LucideIconCn Name="cloud-rain" Size="20" Class="size-5 text-blue-400" />,
        _               => small
            ? @<LucideIconCn Name="cloud" Size="14" Class="size-3.5 text-muted-foreground" />
            : @<LucideIconCn Name="cloud" Size="20" Class="size-5 text-muted-foreground" />,
    };

    private record HourlyForecast(string Time, int Temp, string Condition);

    private record Forecast(
        string City,
        int CurrentTemp,
        int High,
        int Low,
        string Condition,
        int Humidity,
        string WindSpeed,
        HourlyForecast[] Hourly
    );

    private record ChatMessage(
        string Id,
        string Role,
        string? Content,
        string Timestamp,
        Forecast? Forecast
    );

    private static readonly string[] _quickCities = ["New York", "London", "Tokyo", "Sydney"];

    private static readonly ChatMessage[] _messages =
    [
