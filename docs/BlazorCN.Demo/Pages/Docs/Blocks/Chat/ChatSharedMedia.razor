@* ============================================================
   Block: chat-shared-media
   Title: ChatSharedMedia
   Description: React shared media gallery panel for Next.js chat apps with tabbed Photos, Files, and Links views, sender attribution, date stamps, and grid layout using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-shared-media.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Back">
                <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
            </ButtonCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Shared Media</span>
                <p class="text-muted-foreground text-xs">Design Team Chat</p>
            </div>
        </div>

        @* Tabs *@
        <div class="flex border-b">
            @foreach (var tab in _tabs)
            {
                var t = tab;
                <button type="button"
                        @onclick="@(() => _activeTab = t.Id)"
                        class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 px-3 py-2.5 text-xs transition-colors", _activeTab == t.Id ? "border-b-2 border-foreground font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @t.Label
                    <span class="@Cn.Merge("rounded-full px-1.5 py-0.5 text-[10px] tabular-nums", _activeTab == t.Id ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                        @t.Count
                    </span>
                </button>
            }
        </div>

        @* Content *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Shared media">
            @if (_activeTab == "photos")
            {
                <div class="p-3">
                    <div class="grid grid-cols-3 gap-1.5">
                        @foreach (var photo in _photos)
                        {
                            var p = photo;
                            <div class="group relative">
                                <div class="@Cn.Merge("flex aspect-square items-center justify-center rounded-md", p.Color)">
                                    <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                                </div>
                                <div class="pointer-events-none absolute inset-0 flex flex-col justify-end rounded-md bg-black/0 p-2 opacity-0 transition-all group-hover:bg-black/40 group-hover:opacity-100">
                                    <span class="truncate font-medium text-[10px] text-white">@p.Sender</span>
                                    <span class="text-[10px] text-white/70">@p.Date</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_activeTab == "files")
            {
                <div>
                    @foreach (var file in _files)
                    {
                        var f = file;
                        var isLast = Array.IndexOf(_files, f) == _files.Length - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                            <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="@FileTypeIcon(f.Type)" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block truncate font-medium text-sm">@f.Name</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@f.Size &middot; @f.Sender &middot; @f.Date</p>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Download">
                                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }

            @if (_activeTab == "links")
            {
                <div>
                    @foreach (var link in _links)
                    {
                        var lnk = link;
                        var isLast = Array.IndexOf(_links, lnk) == _links.Length - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                            <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block truncate font-medium text-sm">@lnk.Title</span>
                                <p class="mt-0.5 truncate text-muted-foreground text-xs">@lnk.Domain &middot; @lnk.Sender &middot; @lnk.Date</p>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Open in new tab">
                                <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @if (_activeTab == "photos") { @($"{_photos.Length} photos") }
                @if (_activeTab == "files") { @($"{_files.Length} files") }
                @if (_activeTab == "links") { @($"{_links.Length} links") }
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                View all
            </ButtonCn>
        </div>
    </div>
</section>

