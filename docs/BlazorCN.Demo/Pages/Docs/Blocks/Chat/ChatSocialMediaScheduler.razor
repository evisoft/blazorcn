@* ============================================================
   Block: chat-social-media-scheduler
   Title: ChatSocialMediaScheduler
   Description: A social media scheduling chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring post previews, platform badges, and calendar integration
   Source: original/blocks/chat/chat-social-media-scheduler.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="calendar" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium">Social Media Scheduler</h3>
                    <p class="text-xs text-muted-foreground">Schedule posts across platforms</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4">
            <div class="space-y-4 py-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            @if (msg.Type == "assistant")
                            {
                                <AvatarFallbackCn Class="bg-primary/10">
                                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-primary" />
                                </AvatarFallbackCn>
                            }
                            else
                            {
                                <AvatarImageCn Src="https://avatar.vercel.sh/user" />
                                <AvatarFallbackCn>U</AvatarFallbackCn>
                            }
                        </AvatarCn>

                        <div class="@Cn.Merge("flex-1 space-y-2", msg.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", msg.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @msg.Content
                            </div>

                            @if (msg.ScheduledPost != null)
                            {
                                var post = msg.ScheduledPost;
                                <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                    <div class="flex items-start justify-between">
                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var platform in post.Platforms)
                                            {
                                                var plat = platform;
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("gap-1", GetPlatformColor(plat))">
                                                    <LucideIconCn Name="@GetPlatformIcon(plat)" Size="12" Class="size-3" />
                                                    <span class="capitalize">@plat</span>
                                                </BadgeCn>
                                            }
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("capitalize", GetStatusColor(post.Status))">
                                            @post.Status
                                        </BadgeCn>
                                    </div>

                                    @if (!string.IsNullOrEmpty(post.MediaUrl))
                                    {
                                        <div class="overflow-hidden rounded-md border">
                                            <img src="@post.MediaUrl" alt="Post preview" class="h-32 w-full object-cover" />
                                        </div>
                                    }

                                    <div class="space-y-2 rounded-md bg-muted/50 p-3">
                                        <p class="text-sm">@post.Content</p>
                                    </div>

                                    <div class="flex items-center gap-4 border-t pt-3 text-xs text-muted-foreground">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="clock" Size="14" Class="size-3.5" />
                                            <span>@post.ScheduledTime</span>
                                        </div>
                                        @if (post.Status == "scheduled")
                                        {
                                            <div class="flex items-center gap-1.5 text-emerald-600">
                                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                                                <span>Ready to publish</span>
                                            </div>
                                        }
                                    </div>

                                    @if (post.Engagement != null)
                                    {
                                        var eng = post.Engagement;
                                        <div class="flex gap-4 border-t pt-3 text-xs">
                                            <div class="flex items-center gap-1">
                                                <span class="text-muted-foreground">Likes:</span>
                                                <span class="font-medium tabular-nums">@eng.Likes</span>
                                            </div>
                                            <div class="flex items-center gap-1">
                                                <span class="text-muted-foreground">Shares:</span>
                                                <span class="font-medium tabular-nums">@eng.Shares</span>
                                            </div>
                                            <div class="flex items-center gap-1">
                                                <span class="text-muted-foreground">Comments:</span>
                                                <span class="font-medium tabular-nums">@eng.Comments</span>
                                            </div>
                                        </div>
                                    }

                                    <div class="flex gap-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs">
                                            <LucideIconCn Name="image" Size="12" Class="mr-1.5 size-3" />
                                            Edit Media
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs">
                                            Reschedule
                                        </ButtonCn>
                                    </div>
                                </div>
                            }

                            <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input"
                         Placeholder="Describe your post or ask for scheduling tips..."
                         Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Icon">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record EngagementData(int Likes, int Shares, int Comments);

    private record ScheduledPost(
        string Content,
        string[] Platforms,
        string ScheduledTime,
        string Status,
        string? MediaUrl = null,
        EngagementData? Engagement = null);

    private record Message(string Id, string Type, string Content, string Timestamp, ScheduledPost? ScheduledPost = null);

    private string _input = "";

    private List<Message> _messages = new()
    {
        new("1", "assistant",
            "Hi! I'm your social media scheduler. I can help you create and schedule posts across Twitter, LinkedIn, and Facebook. What would you like to post?",
            "2:00 PM"),
        new("2", "user",
            "Schedule a post about our new product launch for tomorrow at 10 AM on all platforms",
            "2:01 PM"),
        new("3", "assistant",
            "Great! I've scheduled your product launch announcement. Here's the preview:",
            "2:01 PM",
            new ScheduledPost(
                "Excited to announce our latest product innovation! \U0001F680 Built with cutting-edge technology to solve real problems. Learn more at our website. #ProductLaunch #Innovation",
                ["twitter", "linkedin", "facebook"],
                "Tomorrow at 10:00 AM",
                "scheduled",
                "https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?w=400&h=200&fit=crop"
            )),
        new("4", "user",
            "Can you suggest the best time to post for maximum engagement?",
            "2:03 PM"),
        new("5", "assistant",
            "Based on your audience analytics:\n\n• Twitter: Weekdays 12-1 PM and 5-6 PM\n• LinkedIn: Tuesday-Thursday 7-8 AM and 12 PM\n• Facebook: Wednesday-Friday 1-3 PM\n\nYour current scheduled time (10 AM) is good for LinkedIn. Would you like me to optimize for other platforms?",
            "2:03 PM"),
    };

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new Message(
            System.DateTime.Now.Ticks.ToString(),
            "user",
            _input,
            "Just now"
        ));
        _input = "";
    }

    private static string GetStatusColor(string status) => status switch
    {
        "published" => "bg-emerald-500/10 text-emerald-600",
        "scheduled"  => "bg-blue-500/10 text-blue-600",
        "draft"      => "bg-amber-500/10 text-amber-600",
        _            => "bg-muted text-muted-foreground",
    };

    private static string GetPlatformColor(string platform) => platform switch
    {
        "twitter"  => "bg-blue-500/10 text-blue-600",
        "linkedin" => "bg-blue-700/10 text-blue-700",
        "facebook" => "bg-blue-600/10 text-blue-600",
        _          => "",
    };

    private static string GetPlatformIcon(string platform) => platform switch
    {
        "twitter"  => "twitter",
        "linkedin" => "linkedin",
        "facebook" => "facebook",
        _          => "globe",
    };
}
