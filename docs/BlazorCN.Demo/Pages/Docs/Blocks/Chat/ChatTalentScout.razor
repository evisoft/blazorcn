@* ============================================================
   Block: chat-talent-scout
   Title: ChatTalentScout
   Description: A recruitment talent scouting chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring candidate profile cards, skill ratings, interview scheduling, and hiring pipeline management
   Source: original/blocks/chat/chat-talent-scout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10">
                    <LucideIconCn Name="users" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Talent Scout</h2>
                    <p class="text-xs text-muted-foreground">Find your next great hire</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            <div class="space-y-4 p-4">
                @foreach (var msg in _messages)
                {
                    @if (msg.Type == "candidates" && msg.Candidates != null)
                    {
                        <div class="space-y-3">
                            @foreach (var candidate in msg.Candidates)
                            {
                                var avail = _availabilityConfig[candidate.Availability];
                                <div class="overflow-hidden rounded-lg border bg-muted/30">
                                    <div class="border-b bg-card px-3 py-2.5">
                                        <div class="flex items-start gap-3">
                                            <AvatarCn Class="size-10 shrink-0">
                                                <AvatarImageCn Src="@candidate.Avatar" Alt="@candidate.Name" />
                                                <AvatarFallbackCn>@GetInitials(candidate.Name)</AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div>
                                                        <h3 class="text-sm font-medium">@candidate.Name</h3>
                                                        <p class="text-xs text-muted-foreground">@candidate.Role</p>
                                                    </div>
                                                    <div class="flex items-center gap-1 shrink-0">
                                                        <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-500" />
                                                        <span class="text-sm font-medium text-emerald-500">@(candidate.MatchScore)%</span>
                                                    </div>
                                                </div>
                                                <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                                    <div class="flex items-center gap-1">
                                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                                        <span>@candidate.Location</span>
                                                    </div>
                                                    <span>•</span>
                                                    <div class="flex items-center gap-1">
                                                        <LucideIconCn Name="briefcase" Size="12" Class="size-3" />
                                                        <span>@candidate.Experience</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-3">
                                        <p class="mb-3 text-sm text-muted-foreground">@candidate.Summary</p>

                                        <div class="mb-3 space-y-1.5">
                                            <h4 class="text-xs font-medium text-muted-foreground">Top Skills:</h4>
                                            <div class="space-y-1">
                                                @foreach (var skill in candidate.Skills.Take(3))
                                                {
                                                    <div class="space-y-1">
                                                        <div class="flex items-center justify-between text-xs">
                                                            <span class="font-medium">@skill.Name</span>
                                                            <span class="text-muted-foreground">@(skill.Level)%</span>
                                                        </div>
                                                        <div class="h-1 overflow-hidden rounded-full bg-muted">
                                                            <div class="h-full bg-primary" style="@($"width:{skill.Level}%")"></div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="mb-3 flex items-center gap-2">
                                            <div class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2.5 py-1.5", avail.Bg)">
                                                <LucideIconCn Name="clock" Size="14" Class="size-3.5" />
                                                <span class="@Cn.Merge("text-xs font-medium", avail.Color)">@avail.Label</span>
                                            </div>
                                        </div>

                                        <div class="flex gap-2">
                                            @{ var cid = candidate.Id; }
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 gap-1.5"
                                                      @onclick="@(() => HandleShortlist(cid))">
                                                <LucideIconCn Name="star" Size="14" Class="size-3.5" />
                                                Shortlist
                                            </ButtonCn>
                                            <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-1.5"
                                                      @onclick="@(() => HandleSchedule(cid))">
                                                <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                                                Schedule
                                            </ButtonCn>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "justify-end" : "justify-start")">
                            @if (msg.Type == "assistant")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-primary/10 text-xs">
                                        <LucideIconCn Name="users" Size="16" Class="size-4" />
                                    </AvatarFallbackCn>
                                </AvatarCn>
                            }
                            <div class="@Cn.Merge("max-w-[80%] rounded-lg px-3 py-2", msg.Type == "user" ? "bg-primary text-primary-foreground" : "bg-muted")">
                                <p class="text-sm">@msg.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", msg.Type == "user" ? "text-primary-foreground/70" : "text-muted-foreground")">
                                    @msg.Timestamp
                                </span>
                            </div>
                            @if (msg.Type == "user")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-muted text-xs">U</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-3">
            <form class="flex gap-2" @onsubmit="HandleSubmit">
                <InputCn @bind-Value="_input"
                         Placeholder="Describe the role you're hiring for..."
                         Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Disabled="@string.IsNullOrWhiteSpace(_input)">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Skill(string Name, int Level);

    private record Candidate(
        string Id,
        string Name,
        string Role,
        string Location,
        string Experience,
        int MatchScore,
        string Availability,
        Skill[] Skills,
        string Summary,
        string? Avatar = null
    );

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        Candidate[]? Candidates = null
    );

    private record AvailabilityConfig(string Label, string Color, string Bg);

    private static readonly Dictionary<string, AvailabilityConfig> _availabilityConfig = new()
    {
        ["immediate"] = new("Available Now", "text-emerald-500", "bg-emerald-500/10"),
        ["2-weeks"]   = new("2 Weeks Notice", "text-blue-500", "bg-blue-500/10"),
        ["1-month"]   = new("1 Month Notice", "text-amber-500", "bg-amber-500/10"),
    };

    private static readonly Candidate[] _candidates =
    [
        new("c1", "Sarah Chen", "Senior Full-Stack Engineer", "San Francisco, CA", "8 years", 94, "2-weeks",
            [
                new("React", 95),
                new("Node.js", 90),
                new("TypeScript", 92),
                new("System Design", 85),
            ],
            "Led engineering teams at Series B startups. Expert in scalable web applications and microservices architecture."),
        new("c2", "Marcus Johnson", "Product Designer", "New York, NY", "6 years", 88, "immediate",
            [
                new("Figma", 98),
                new("UX Research", 88),
                new("Design Systems", 92),
                new("Prototyping", 90),
            ],
            "Created design systems for Fortune 500 companies. Strong background in user research and data-driven design."),
        new("c3", "Priya Sharma", "DevOps Engineer", "Austin, TX", "5 years", 82, "1-month",
            [
                new("AWS", 90),
                new("Kubernetes", 85),
                new("CI/CD", 88),
                new("Terraform", 80),
            ],
            "Built cloud infrastructure for high-traffic SaaS platforms. Passionate about automation and security."),
    ];

    private List<Message> _messages =
    [
        new("m1", "assistant",
            "Welcome! I'll help you find top talent for your team. What type of role are you looking to fill?",
            "1:45 PM"),
        new("m2", "user",
            "Looking for senior engineers with React and Node.js experience",
            "1:46 PM"),
        new("m3", "assistant",
            "I found 3 highly qualified candidates matching your requirements:",
            "1:46 PM"),
        new("m4", "candidates", "", "1:46 PM",
            [
                new("c1", "Sarah Chen", "Senior Full-Stack Engineer", "San Francisco, CA", "8 years", 94, "2-weeks",
                    [
                        new("React", 95),
                        new("Node.js", 90),
                        new("TypeScript", 92),
                        new("System Design", 85),
                    ],
                    "Led engineering teams at Series B startups. Expert in scalable web applications and microservices architecture."),
                new("c2", "Marcus Johnson", "Product Designer", "New York, NY", "6 years", 88, "immediate",
                    [
                        new("Figma", 98),
                        new("UX Research", 88),
                        new("Design Systems", 92),
                        new("Prototyping", 90),
                    ],
                    "Created design systems for Fortune 500 companies. Strong background in user research and data-driven design."),
                new("c3", "Priya Sharma", "DevOps Engineer", "Austin, TX", "5 years", 82, "1-month",
                    [
                        new("AWS", 90),
                        new("Kubernetes", 85),
                        new("CI/CD", 88),
                        new("Terraform", 80),
                    ],
                    "Built cloud infrastructure for high-traffic SaaS platforms. Passionate about automation and security."),
            ]),
    ];

    private string _input = "";

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => p[0]));
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new Message(
            $"m{_messages.Count + 1}",
            "user",
            _input,
            "1:47 PM"
        ));
        _input = "";
    }

    private void HandleShortlist(string candidateId)
    {
        // shortlist action
    }

    private void HandleSchedule(string candidateId)
    {
        // schedule action
    }
}
