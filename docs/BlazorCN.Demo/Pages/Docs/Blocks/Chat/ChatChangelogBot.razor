@* ============================================================
   Block: chat-changelog-bot
   Title: ChatChangelogBot
   Description: Automated changelog bot that posts release summaries and deploy notifications built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-changelog-bot.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="rocket" Size="16" Class="size-4 text-foreground" />
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium">Changelog Bot</h3>
                    <p class="text-xs text-muted-foreground">Automated release notifications</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="file-text" Size="14" Class="size-3.5" />
                    Full Changelog
                </ButtonCn>
            </div>
        </div>

        @* Entries *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var entry in _entries)
            {
                <div class="flex gap-3">
                    @* Bot Avatar *@
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="bg-muted">
                            <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                        </AvatarFallbackCn>
                    </AvatarCn>

                    @* Entry Card *@
                    <div class="flex-1 space-y-2">
                        @* Header *@
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">Changelog Bot</span>
                            <BadgeCn Variant="@(entry.Type == "hotfix" ? BadgeVariant.Destructive : BadgeVariant.Default)" Class="h-5 text-xs">
                                @entry.Type
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@entry.Timestamp</span>
                        </div>

                        @* Card *@
                        <div class="overflow-hidden rounded-lg border bg-muted/50">
                            @* Title *@
                            <div class="flex items-center justify-between border-b bg-muted/50 px-3 py-2">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-sm font-medium">@entry.Version</span>
                                    @if (entry.Commit != null)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 gap-1 text-xs">
                                            <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                                            @entry.Commit
                                        </BadgeCn>
                                    }
                                    @if (entry.Environment != null)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-xs">
                                            @entry.Environment
                                        </BadgeCn>
                                    }
                                </div>
                                @if (entry.Status == "success")
                                {
                                    <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-amber-500" />
                                }
                            </div>

                            @* Changes *@
                            <div class="space-y-3 p-3">
                                @foreach (var changeGroup in entry.Changes)
                                {
                                    var config = GetCategoryConfig(changeGroup.Category);
                                    <div class="space-y-1.5">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="@config.IconName" Size="14" Class="@Cn.Merge("size-3.5", config.Color)" />
                                            <span class="text-xs font-medium text-muted-foreground">@config.Label</span>
                                        </div>
                                        <ul class="space-y-1 pl-5">
                                            @foreach (var item in changeGroup.Items)
                                            {
                                                <li class="text-sm text-muted-foreground">• @item</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>

                            @* Footer *@
                            <div class="flex items-center gap-2 border-t px-3 py-2">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 text-xs">
                                    View Details
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 text-xs">
                                    <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                                    Compare
                                </ButtonCn>
                                <div class="ml-auto flex items-center gap-1 text-xs text-muted-foreground">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @entry.Timestamp
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="rocket" Size="12" Class="size-3" />
                <span>Subscribe to changelog updates</span>
                <ButtonCn Variant="ButtonVariant.Link" Class="h-auto p-0 text-xs">
                    Configure
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChangeGroup(string Category, string[] Items);

    private record ChangelogEntry(
        string Id,
        string Version,
        string Type,
        string Status,
        ChangeGroup[] Changes,
        string Timestamp,
        string? Environment,
        string? Commit
    );

    private record CategoryConfig(string IconName, string Label, string Color);

    private static CategoryConfig GetCategoryConfig(string category) => category switch
    {
        "feature"     => new("sparkles",  "Features",      "text-blue-500"),
        "fix"         => new("wrench",    "Bug Fixes",      "text-red-500"),
        "improvement" => new("rocket",    "Improvements",  "text-emerald-500"),
        "docs"        => new("file-text", "Documentation", "text-amber-500"),
        _             => new("circle",    category,        "text-muted-foreground"),
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new(
            Id: "1",
            Version: "v2.4.0",
            Type: "release",
            Status: "success",
            Changes:
            [
                new("feature",
                [
                    "Added dark mode support across all components",
                    "Introduced collaborative editing for documents",
                    "New export to PDF functionality",
                ]),
                new("improvement",
                [
                    "Improved loading performance by 40%",
                    "Enhanced mobile responsiveness",
                ]),
                new("fix",
                [
                    "Fixed authentication timeout issues",
                    "Resolved image upload errors in Safari",
                ]),
            ],
            Timestamp: "2 hours ago",
            Environment: null,
            Commit: "a3f5d2c"
        ),
        new(
            Id: "2",
            Version: "Production",
            Type: "deployment",
            Status: "success",
            Changes:
            [
                new("feature",
                [
                    "Deployed v2.4.0 to production environment",
                ]),
            ],
            Timestamp: "1 hour ago",
            Environment: "production",
            Commit: "a3f5d2c"
        ),
        new(
            Id: "3",
            Version: "v2.3.2",
            Type: "hotfix",
            Status: "success",
            Changes:
            [
                new("fix",
                [
                    "Critical: Fixed payment processing webhook failures",
                    "Patched security vulnerability in authentication",
                ]),
            ],
            Timestamp: "Yesterday",
            Environment: null,
            Commit: "b8e1f4a"
        ),
    ];
}
