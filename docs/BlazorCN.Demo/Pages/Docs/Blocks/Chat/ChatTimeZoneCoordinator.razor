@* ============================================================
   Block: chat-time-zone-coordinator
   Title: ChatTimeZoneCoordinator
   Description: A time zone coordination chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring world clock cards and optimal meeting time suggestions
   Source: original/blocks/chat/chat-time-zone-coordinator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="globe" Size="16" Class="size-4 text-blue-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Time Zone Coordinator</h2>
                    <p class="text-xs text-muted-foreground">
                        Schedule across @_teamMembers.Length time zones
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="h-6 gap-1 text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                UTC
            </BadgeCn>
        </div>

        @* Team Clocks *@
        <div class="border-b p-4">
            <div class="grid grid-cols-2 gap-2">
                @foreach (var member in _teamMembers)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                        <AvatarCn Class="size-7">
                            <AvatarImageCn Src="@member.Avatar" />
                            <AvatarFallbackCn Class="text-xs">@member.Name.Substring(0, 2)</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-xs font-medium">@member.Name</p>
                            <p class="text-[10px] text-muted-foreground">@member.Location</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-medium tabular-nums">
                                @(member.UtcOffset >= 0 ? "+" : "")@(member.UtcOffset)h
                            </p>
                            <p class="text-[10px] text-muted-foreground">@member.Timezone</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    @if (msg.Type == "suggestion")
                    {
                        <div class="space-y-3">
                            <div class="flex gap-3">
                                <AvatarCn Class="size-8 shrink-0">
                                    <AvatarFallbackCn Class="bg-blue-500/10 text-blue-700 text-xs">AI</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="flex-1">
                                    <div class="rounded-lg bg-muted/50 px-3 py-2">
                                        <p class="text-sm">@msg.Content</p>
                                    </div>
                                    <p class="mt-1 text-[10px] text-muted-foreground">@msg.Timestamp</p>
                                </div>
                            </div>
                            <div class="ml-11 space-y-2">
                                @foreach (var slot in _suggestedTimes)
                                {
                                    var timeSlot = slot;
                                    <CardCn Class="p-3">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="flex-1">
                                                <div class="flex items-center gap-2">
                                                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-blue-600" />
                                                    <p class="text-sm font-medium">@slot.Time</p>
                                                </div>
                                                <p class="mt-1 font-mono text-muted-foreground text-xs">@slot.Conversions</p>
                                            </div>
                                            <ButtonCn Size="ButtonSize.Sm"
                                                      Variant="ButtonVariant.Outline"
                                                      Class="h-7 text-xs"
                                                      OnClick="@(() => HandleScheduleMeeting(timeSlot.Time))">
                                                Schedule
                                            </ButtonCn>
                                        </div>
                                    </CardCn>
                                }
                            </div>
                        </div>
                    }
                    else if (msg.Type == "confirmation")
                    {
                        <div class="rounded-lg border border-emerald-200 bg-emerald-500/10 px-3 py-2">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600" />
                                <p class="text-sm text-emerald-900">@msg.Content</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", msg.Role == "user" ? "flex-row-reverse" : "")">
                            <AvatarCn Class="size-8 shrink-0">
                                @if (msg.Role == "assistant")
                                {
                                    <AvatarFallbackCn Class="bg-blue-500/10 text-blue-700 text-xs">AI</AvatarFallbackCn>
                                }
                                else
                                {
                                    <AvatarFallbackCn Class="bg-muted text-xs">You</AvatarFallbackCn>
                                }
                            </AvatarCn>
                            <div class="@Cn.Merge("flex max-w-[80%] flex-col gap-1", msg.Role == "user" ? "items-end" : "")">
                                <div class="@Cn.Merge("rounded-lg px-3 py-2", msg.Role == "assistant" ? "bg-muted/50" : "bg-blue-500/10 border border-blue-200")">
                                    <p class="text-sm">@msg.Content</p>
                                </div>
                                <p class="text-[10px] text-muted-foreground">@msg.Timestamp</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input"
                         Placeholder="When do you need to meet?"
                         Class="flex-1" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Sm"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="gap-1.5">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                    Send
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Location, string Timezone, double UtcOffset, string Avatar);
    private record ChatMessage(string Id, string Role, string Content, string Timestamp, string? Type = null);
    private record TimeSlot(string Time, string Conversions);

    private string _input = "";

    private static readonly TeamMember[] _teamMembers =
    [
        new("Alex Chen", "San Francisco", "PST", -8, "/avatars/alex.jpg"),
        new("Priya Sharma", "Mumbai", "IST", 5.5, "/avatars/priya.jpg"),
        new("Emma Wilson", "London", "GMT", 0, "/avatars/emma.jpg"),
        new("Carlos Silva", "São Paulo", "BRT", -3, "/avatars/carlos.jpg"),
    ];

    private static readonly TimeSlot[] _suggestedTimes =
    [
        new("Tuesday 2:00 PM PST", "10:30 PM IST • 10:00 PM GMT • 6:00 PM BRT"),
        new("Wednesday 9:00 AM PST", "9:30 PM IST • 5:00 PM GMT • 1:00 PM BRT"),
        new("Thursday 11:00 AM PST", "11:30 PM IST • 7:00 PM GMT • 3:00 PM BRT"),
    ];

    private List<ChatMessage> _messages =
    [
        new("1", "assistant",
            "Hi! I can help coordinate meeting times across your global team. Who would you like to schedule with?",
            "9:00 AM PST"),
        new("2", "user",
            "I need to schedule a 1-hour meeting with the entire team this week",
            "9:01 AM PST"),
        new("3", "assistant",
            "I've analyzed everyone's time zones. Here are the best meeting times that work for all 4 team members:",
            "9:01 AM PST",
            "suggestion"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new(Guid.NewGuid().ToString(), "user", _input, "Just now"));
        _input = "";
    }

    private void HandleScheduleMeeting(string timeSlot)
    {
        _messages.Add(new(
            Guid.NewGuid().ToString(),
            "system",
            $"Meeting scheduled for {timeSlot}. Calendar invites sent to all participants.",
            "Just now",
            "confirmation"
        ));
    }
}
