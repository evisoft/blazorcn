@* ============================================================
   Block: chat-document-review
   Title: ChatDocumentReview
   Description: Document review chat with inline annotations, comment threads, and collaborative editing built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-document-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-medium">Q1 Marketing Strategy.docx</h3>
                    <p class="text-xs text-muted-foreground">
                        @_openAnnotations.Length open comments • @_resolvedAnnotations.Length resolved
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="more-horizontal" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-amber-500"></span>
                    <span class="text-xs text-muted-foreground">
                        @(_annotations.Count(a => a.Type == "suggestion")) suggestions
                    </span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-blue-500"></span>
                    <span class="text-xs text-muted-foreground">
                        @(_annotations.Count(a => a.Type == "question")) questions
                    </span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">
                        @_resolvedAnnotations.Length resolved
                    </span>
                </div>
            </div>
        </div>

        @* Annotations *@
        <div class="flex-1 overflow-y-auto">
            <div class="divide-y">
                @foreach (var annotation in _annotations)
                {
                    var ann = annotation;
                    <div>
                        <button type="button"
                                @onclick="@(() => ToggleAnnotation(ann.Id))"
                                class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                                @if (ann.Type == "suggestion")
                                {
                                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-amber-500" />
                                }
                                else if (ann.Type == "question")
                                {
                                    <LucideIconCn Name="message-square" Size="12" Class="size-3 text-blue-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="message-square" Size="12" Class="size-3 text-muted-foreground" />
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="mb-1 flex items-center gap-2">
                                    <span class="text-sm font-medium">Line @ann.LineNumber</span>
                                    <BadgeCn Variant="BadgeVariant.Outline"
                                             Class="@Cn.Merge("h-4 text-xs", ann.Type == "suggestion" ? "border-amber-500 text-amber-500" : ann.Type == "question" ? "border-blue-500 text-blue-500" : "")">
                                        @ann.Type
                                    </BadgeCn>
                                    @if (ann.Status == "resolved")
                                    {
                                        <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                                    }
                                </div>
                                <p class="text-sm text-muted-foreground">
                                    @ann.Comments[0].Content
                                </p>
                                <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@ann.Author</span>
                                    <span>•</span>
                                    <span>@ann.Comments.Length replies</span>
                                    <span>•</span>
                                    <span>@ann.Timestamp</span>
                                </div>
                            </div>
                        </button>

                        @* Thread *@
                        @if (_selectedAnnotation == ann.Id)
                        {
                            <div class="border-t bg-muted/30 px-4 py-3">
                                <div class="space-y-3">
                                    @foreach (var comment in ann.Comments)
                                    {
                                        <div class="flex gap-2">
                                            <AvatarCn Class="size-6 shrink-0">
                                                <AvatarFallbackCn Class="text-xs">@comment.Author[0]</AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="min-w-0 flex-1">
                                                <div class="mb-1 flex items-baseline gap-2">
                                                    <span class="text-sm font-medium">@comment.Author</span>
                                                    <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                                </div>
                                                <p class="text-sm text-muted-foreground">@comment.Content</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="mt-3 flex gap-2">
                                    @if (ann.Status == "open")
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                            <LucideIconCn Name="check-circle" Size="12" Class="size-3" />
                                            Resolve
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Reply
                                        </ButtonCn>
                                    }
                                    else
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs text-emerald-500">
                                            <LucideIconCn Name="check-circle" Size="12" Class="size-3" />
                                            Resolved
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="mb-2 text-xs text-muted-foreground">
                Add a general comment or reply to a thread above
            </div>
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Write a comment..."
                         Class="flex-1" />
                <ButtonCn @onclick="HandleSend"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Size="ButtonSize.Icon">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record AnnotationComment(string Id, string Author, string Content, string Timestamp);
    private record Annotation(string Id, int LineNumber, string Type, string Status, string Author, string Timestamp, AnnotationComment[] Comments);
    private record Message(string Id, string Type, string Content, string Timestamp);

    private string _input = "";
    private string? _selectedAnnotation = null;

    private static readonly Annotation[] _annotations =
    [
        new("a1", 3, "suggestion", "open", "Sarah Kim", "2 hours ago",
        [
            new("c1", "Sarah Kim", "Consider rephrasing this section for clarity", "2 hours ago"),
            new("c2", "Alex Chen", "Good point. I'll revise this paragraph.", "1 hour ago"),
        ]),
        new("a2", 7, "question", "open", "Mike Johnson", "1 hour ago",
        [
            new("c3", "Mike Johnson", "Do we have data to support this claim?", "1 hour ago"),
        ]),
        new("a3", 12, "comment", "resolved", "Emma Davis", "3 hours ago",
        [
            new("c4", "Emma Davis", "This reference needs updating", "3 hours ago"),
            new("c5", "Alex Chen", "Updated to latest source", "2 hours ago"),
        ]),
    ];

    private Annotation[] _openAnnotations => _annotations.Where(a => a.Status == "open").ToArray();
    private Annotation[] _resolvedAnnotations => _annotations.Where(a => a.Status == "resolved").ToArray();

    private void ToggleAnnotation(string id)
    {
        _selectedAnnotation = _selectedAnnotation == id ? null : id;
    }

    private void HandleSend()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
