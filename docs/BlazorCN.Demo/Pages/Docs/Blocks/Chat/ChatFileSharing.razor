@* ============================================================
   Block: chat-file-sharing
   Title: ChatFileSharing
   Description: React chat block with file attachment messages for Next.js featuring file cards with icons, filenames, sizes, and download buttons using shadcn/ui, TypeScript, and Tailwind CSS
   Source: original/blocks/chat/chat-file-sharing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">AR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Alex Rivera</p>
                <p class="text-muted-foreground text-xs">Product</p>
            </div>
            <span class="text-muted-foreground text-xs">4 files shared</span>
        </div>

        @* Messages — flat layout *@
        <div class="flex-1 overflow-y-auto py-2" tabindex="0" role="group" aria-label="Messages">
            @foreach (var group in _grouped)
            {
                var groupKey = group[0].Id;
                <div key="@groupKey" class="mb-1">
                    @for (var i = 0; i < group.Count; i++)
                    {
                        var msg = group[i];
                        var isFirst = i == 0;
                        var fileIconName = msg.File != null ? GetFileIconName(msg.File.Type) : "file";
                        <div class="flex gap-2 px-4 py-0.5 hover:bg-accent">
                            <div class="flex w-8 shrink-0 items-start justify-center pt-0.5">
                                @if (isFirst)
                                {
                                    <AvatarCn Class="size-7">
                                        <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                }
                                else
                                {
                                    <span class="pt-1 text-muted-foreground text-[10px] opacity-0 group-hover:opacity-100">
                                        @msg.Time
                                    </span>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                @if (isFirst)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@msg.Sender</span>
                                        <span class="text-muted-foreground text-[10px]">@msg.Time</span>
                                    </div>
                                }
                                @if (msg.Content != null)
                                {
                                    <p class="text-sm leading-relaxed">@msg.Content</p>
                                }
                                @if (msg.File != null)
                                {
                                    var file = msg.File;
                                    <div class="mt-1 flex items-center gap-3 rounded-md bg-muted/50 p-3">
                                        <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-background">
                                            <LucideIconCn Name="@fileIconName" Size="16" Class="size-4 text-muted-foreground" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <p class="truncate font-medium text-sm">@file.Name</p>
                                            <p class="text-muted-foreground text-xs">@file.Size</p>
                                        </div>
                                        <ButtonCn aria-label="@($"Download {file.Name}")" Variant="ButtonVariant.Ghost"
                                                  Size="ButtonSize.Sm"
                                                  Class="size-7 shrink-0 p-0 text-muted-foreground hover:text-foreground">
                                            <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true"
                  class="flex items-center gap-2 rounded-md border px-3 py-1.5">
                <ButtonCn aria-label="Attach file" Type="button"
                          Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="size-7 shrink-0 p-0 text-muted-foreground">
                    <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="Type a message..."
                         Class="h-7 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                <ButtonCn aria-label="Send message" Type="submit"
                          Size="ButtonSize.Sm"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(!CanSend)"
                          Class="@Cn.Merge("size-7 shrink-0 p-0", CanSend ? "text-foreground" : "text-muted-foreground")">
                    <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private record FileAttachment(string Name, string Size, string Type);

    private record ChatMessage(string Id, string Sender, string Initials, string Time,
        string? Content = null, FileAttachment? File = null);

    private static readonly ChatMessage[] _messages =
    [
        new("1",  "Alex Rivera", "AR", "2:15 PM", Content: "I've finished the Q4 report. Attaching the PDF and the raw data spreadsheet so you can cross-reference the numbers."),
        new("2",  "Alex Rivera", "AR", "2:15 PM", File: new("Q4-2025-Report.pdf",       "2.4 MB",  "pdf")),
        new("3",  "Alex Rivera", "AR", "2:16 PM", File: new("revenue-data-q4.xlsx",      "847 KB",  "spreadsheet")),
        new("4",  "You",         "YO", "2:22 PM", Content: "Thanks! I'll review these tonight. Here's the updated brand guidelines we discussed."),
        new("5",  "You",         "YO", "2:22 PM", File: new("brand-guidelines-v4.pdf",   "5.1 MB",  "pdf")),
        new("6",  "Alex Rivera", "AR", "2:30 PM", Content: "Great. Also sharing the hero video asset for the landing page."),
        new("7",  "Alex Rivera", "AR", "2:30 PM", File: new("hero-intro-final.mp4",       "18.3 MB", "video")),
        new("8",  "You",         "YO", "2:34 PM", Content: "Looks good. The file size is a bit large -- can you compress it to under 10 MB?"),
        new("9",  "Alex Rivera", "AR", "2:41 PM", Content: "Done. Here's the compressed version."),
        new("10", "Alex Rivera", "AR", "2:41 PM", File: new("hero-intro-compressed.mp4",  "8.7 MB",  "video")),
    ];

    private static List<List<ChatMessage>> GroupMessages(IEnumerable<ChatMessage> msgs)
    {
        var groups = new List<List<ChatMessage>>();
        foreach (var msg in msgs)
        {
            if (groups.Count > 0 && groups[^1][0].Sender == msg.Sender)
                groups[^1].Add(msg);
            else
                groups.Add([msg]);
        }
        return groups;
    }

    private static readonly List<List<ChatMessage>> _grouped = GroupMessages(_messages);

    private string _input = "";

    private bool CanSend => !string.IsNullOrWhiteSpace(_input);

    private static string GetFileIconName(string type) => type switch
    {
        "pdf"         => "file-text",
        "image"       => "image",
        "spreadsheet" => "file-spreadsheet",
        "video"       => "video",
        _             => "file",
    };

    private void HandleSubmit()
    {
        if (!CanSend) return;
        _input = "";
    }
}
