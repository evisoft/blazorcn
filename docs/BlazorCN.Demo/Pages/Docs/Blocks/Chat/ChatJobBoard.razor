@* ============================================================
   Block: chat-job-board
   Title: ChatJobBoard
   Description: A job board chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring job listing cards, salary ranges, and quick-apply functionality
   Source: original/blocks/chat/chat-job-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-blue-500/10">
                <LucideIconCn Name="briefcase" Size="20" Class="size-5 text-blue-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Job Search</h3>
                <p class="text-xs text-muted-foreground">AI-powered matching</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1">
                <LucideIconCn Name="bookmark" Size="12" Class="size-3" />
                <span>@_saved.Count</span>
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            @foreach (var message in _messages)
            {
                <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8">
                        @if (message.Role == "assistant")
                        {
                            <AvatarFallbackCn Class="bg-blue-500/10">
                                <LucideIconCn Name="briefcase" Size="16" Class="size-4 text-blue-600" />
                            </AvatarFallbackCn>
                        }
                        else
                        {
                            <AvatarImageCn Src="/placeholder.svg" />
                            <AvatarFallbackCn>You</AvatarFallbackCn>
                        }
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", message.Role == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Role == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                            @message.Content
                        </div>

                        @if (message.Jobs != null && message.Jobs.Length > 0)
                        {
                            <div class="grid gap-3 pt-2">
                                @foreach (var job in message.Jobs)
                                {
                                    var jobItem = job;
                                    <div class="rounded-lg border bg-card p-4">
                                        <div class="space-y-3">
                                            @* Job Header *@
                                            <div class="flex items-start justify-between gap-2">
                                                <div class="min-w-0 flex-1">
                                                    <h4 class="text-sm font-medium">@jobItem.Title</h4>
                                                    <p class="mt-1 text-sm text-muted-foreground">@jobItem.Company</p>
                                                </div>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0" OnClick="@(() => ToggleSaved(jobItem.Id))">
                                                    <LucideIconCn Name="bookmark" Size="16" Class="@Cn.Merge("size-4", _saved.Contains(jobItem.Id) ? "fill-blue-500 text-blue-500" : "")" />
                                                </ButtonCn>
                                            </div>

                                            @* Job Meta *@
                                            <div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
                                                <span class="flex items-center gap-1">
                                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                                    @jobItem.Location
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <LucideIconCn Name="dollar-sign" Size="12" Class="size-3" />
                                                    @jobItem.Salary
                                                </span>
                                                <span>•</span>
                                                <span>@jobItem.Type</span>
                                                <span>•</span>
                                                <span>@jobItem.Posted</span>
                                            </div>

                                            @* Description *@
                                            <p class="text-sm text-muted-foreground">@jobItem.Description</p>

                                            @* Skills *@
                                            <div class="flex flex-wrap gap-1.5">
                                                @foreach (var skill in jobItem.Skills)
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@skill</BadgeCn>
                                                }
                                            </div>

                                            @* Actions *@
                                            <div class="flex gap-2">
                                                <ButtonCn Size="ButtonSize.Sm" Class="flex-1 text-xs">Quick Apply</ButtonCn>
                                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs">View Details</ButtonCn>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Describe your ideal job..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private readonly HashSet<string> _saved = [];

    private record JobListing(
        string Id,
        string Title,
        string Company,
        string Location,
        string Type,
        string Salary,
        string Posted,
        string Description,
        string[] Skills);

    private record Message(string Id, string Role, string Content, string Timestamp, JobListing[]? Jobs = null);

    private readonly List<Message> _messages =
    [
        new("1", "assistant",
            "Hi! I'm your job search assistant. Tell me what kind of role you're looking for, and I'll find the best matches for you.",
            "11:00 AM"),
        new("2", "user",
            "Looking for remote senior frontend developer positions",
            "11:01 AM"),
        new("3", "assistant",
            "Great! Here are some senior frontend roles that match your criteria:",
            "11:01 AM",
            [
                new("j1", "Senior Frontend Engineer", "TechCorp", "Remote", "Full-time", "$140k - $180k", "2 days ago",
                    "Leading frontend development for our SaaS platform using React and TypeScript",
                    ["React", "TypeScript", "Next.js"]),
                new("j2", "Lead Frontend Developer", "StartupXYZ", "Remote (US)", "Full-time", "$150k - $190k", "5 days ago",
                    "Build and scale our design system and component library",
                    ["React", "Design Systems", "Tailwind"]),
                new("j3", "Senior React Developer", "InnovateLabs", "Remote (Global)", "Contract", "$120/hr - $150/hr", "1 week ago",
                    "Develop high-performance web applications for enterprise clients",
                    ["React", "GraphQL", "Node.js"]),
            ]),
    ];

    private void ToggleSaved(string jobId)
    {
        if (_saved.Contains(jobId))
            _saved.Remove(jobId);
        else
            _saved.Add(jobId);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var userMsg = new Message($"msg-{_messages.Count + 1}", "user", _input, "Just now");
        _messages.Add(userMsg);
        _input = "";
        _messages.Add(new Message($"msg-{_messages.Count + 1}", "assistant", "Searching for jobs that match your criteria...", "Just now"));
    }
}
