@* ============================================================
   Block: chat-movie-night
   Title: ChatMovieNight
   Description: React movie night voting chat block for Next.js with movie suggestion cards, vote buttons, genre badges, rating display, and group decision making using shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-movie-night.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="film" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Friday Movie Night</span>
                <p class="text-muted-foreground text-xs">@_movies.Length suggestions · 4 voters</p>
            </div>
            <div class="flex -space-x-1.5">
                @foreach (var p in _participants)
                {
                    <AvatarCn Class="size-6 ring-2 ring-card">
                        <AvatarFallbackCn Class="@Cn.Merge("text-white text-[8px]", p.Color)">
                            @p.Initials
                        </AvatarFallbackCn>
                    </AvatarCn>
                }
            </div>
        </div>

        @* Leading movie banner *@
        @{
            var leadingMovie = _movies.OrderByDescending(m => m.Upvotes - m.Downvotes).FirstOrDefault();
        }
        @if (leadingMovie != null)
        {
            <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
                <LucideIconCn Name="trophy" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                <span class="text-xs">
                    <span class="font-medium">@leadingMovie.Title</span>
                    <span class="text-muted-foreground"> is leading with @(leadingMovie.Upvotes - leadingMovie.Downvotes) net votes</span>
                </span>
            </div>
        }

        @* Content *@
        <div class="flex-1 overflow-y-auto px-4 py-3">

            @* Movie cards *@
            <div class="flex flex-col gap-2.5">
                @foreach (var movie in _movies)
                {
                    var contributor = _participants.FirstOrDefault(p => p.Key == movie.SuggestedBy);
                    var isLeading = leadingMovie != null && movie.Id == leadingMovie.Id;
                    var netVotes = movie.Upvotes - movie.Downvotes;
                    var userVote = _voted.TryGetValue(movie.Id, out var v) ? v : "";
                    var capturedMovie = movie;
                    <div class="@Cn.Merge("overflow-hidden rounded-lg border p-3 transition-colors", isLeading ? "border-amber-500/40 bg-amber-500/5" : "bg-card")">
                        <div class="flex items-start gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@movie.Title</span>
                                    <span class="text-muted-foreground text-xs">@movie.Year</span>
                                </div>
                                <div class="mt-1 flex flex-wrap items-center gap-1.5">
                                    @foreach (var genre in movie.Genres)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                            @genre
                                        </BadgeCn>
                                    }
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                        @movie.Runtime
                                    </span>
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="flex items-center gap-1 text-xs">
                                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                                        <span class="tabular-nums">@movie.Rating</span>
                                    </span>
                                </div>
                                @if (contributor != null)
                                {
                                    <div class="mt-1.5 flex items-center gap-1.5">
                                        <AvatarCn Class="size-4">
                                            <AvatarFallbackCn Class="@Cn.Merge("text-white text-[6px]", contributor.Color)">
                                                @contributor.Initials
                                            </AvatarFallbackCn>
                                        </AvatarCn>
                                        <span class="text-muted-foreground text-xs">@contributor.Name</span>
                                    </div>
                                }
                            </div>

                            @* Vote buttons *@
                            <div class="flex shrink-0 flex-col items-center gap-0.5">
                                <ButtonCn
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.Icon"
                                    Class="@Cn.Merge("size-7", userVote == "up" ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")"
                                    OnClick="@(() => HandleVote(capturedMovie.Id, "up"))">
                                    <LucideIconCn Name="thumbs-up" Size="14" Class="size-3.5" />
                                </ButtonCn>
                                <span class="@Cn.Merge("font-medium text-xs tabular-nums", netVotes > 0 ? "text-emerald-600 dark:text-emerald-400" : netVotes < 0 ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                                    @(netVotes > 0 ? $"+{netVotes}" : netVotes.ToString())
                                </span>
                                <ButtonCn
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.Icon"
                                    Class="@Cn.Merge("size-7", userVote == "down" ? "text-red-600 dark:text-red-400" : "text-muted-foreground")"
                                    OnClick="@(() => HandleVote(capturedMovie.Id, "down"))">
                                    <LucideIconCn Name="thumbs-down" Size="14" Class="size-3.5" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Chat messages *@
            <div class="mt-4 border-t pt-3">
                <span class="mb-2 block text-muted-foreground text-xs font-medium">Discussion</span>
                <div class="flex flex-col gap-3">
                    @foreach (var msg in _chatMessages)
                    {
                        var isMe = msg.Sender == "me";
                        <div class="@($"flex flex-col {(isMe ? "items-end" : "items-start")}")">
                            <div class="mb-0.5 flex items-center gap-1.5 px-1">
                                <span class="font-medium text-xs">@msg.SenderName</span>
                                <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                            </div>
                            <div class="@Cn.Merge("max-w-[80%] rounded-2xl px-3.5 py-2.5 text-sm leading-relaxed", isMe ? "rounded-br-sm bg-primary text-primary-foreground" : "rounded-bl-sm bg-muted/50")">
                                @msg.Content
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Suggest a movie or chat..."
                    Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="size-9 shrink-0 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private Dictionary<string, string> _voted = new();

    private record Participant(string Key, string Name, string Initials, string Color);
    private record Movie(string Id, string Title, int Year, string[] Genres, string Runtime, double Rating, string SuggestedBy, int Upvotes, int Downvotes);
    private record ChatMessage(string Id, string Sender, string SenderName, string Content, string Timestamp);

    private readonly Participant[] _participants =
    [
        new("you", "You", "YO", "bg-blue-600"),
        new("mara", "Mara", "MK", "bg-rose-600"),
        new("jordan", "Jordan", "JL", "bg-emerald-600"),
        new("taylor", "Taylor", "TW", "bg-amber-600"),
    ];

    private Movie[] _movies =
    [
        new("m1", "Dune: Part Two", 2024, ["Sci-Fi", "Action"], "2h 46m", 8.5, "mara", 3, 0),
        new("m2", "The Grand Budapest Hotel", 2014, ["Comedy", "Drama"], "1h 39m", 8.1, "jordan", 2, 1),
        new("m3", "Parasite", 2019, ["Thriller", "Drama"], "2h 12m", 8.5, "you", 2, 0),
        new("m4", "Everything Everywhere All at Once", 2022, ["Sci-Fi", "Comedy"], "2h 19m", 7.8, "taylor", 1, 2),
    ];

    private readonly ChatMessage[] _chatMessages =
    [
        new("c1", "them", "Mara", "Friday night movie? I'm suggesting Dune: Part Two — the visuals are insane on the big TV.", "6:10 PM"),
        new("c2", "them", "Jordan", "I'm in. Adding Grand Budapest Hotel as a lighter option in case people want comedy.", "6:12 PM"),
        new("c3", "me", "You", "Both great picks. Throwing in Parasite — it's been on my list forever.", "6:15 PM"),
        new("c4", "them", "Taylor", "Everything Everywhere is my pick. Let's vote and decide by 8 PM!", "6:18 PM"),
    ];

    private void HandleVote(string movieId, string type)
    {
        var previous = _voted.TryGetValue(movieId, out var pv) ? pv : "";

        _movies = _movies.Select(movie =>
        {
            if (movie.Id != movieId) return movie;
            var upvotes = movie.Upvotes;
            var downvotes = movie.Downvotes;

            // Remove previous vote
            if (previous == "up") upvotes -= 1;
            if (previous == "down") downvotes -= 1;

            // Apply new vote (or toggle off)
            if (previous != type)
            {
                if (type == "up") upvotes += 1;
                if (type == "down") downvotes += 1;
            }

            return movie with { Upvotes = upvotes, Downvotes = downvotes };
        }).ToArray();

        if (previous == type)
        {
            _voted.Remove(movieId);
        }
        else
        {
            _voted[movieId] = type;
        }
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
