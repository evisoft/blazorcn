@* ============================================================
   Block: chat-dating-messages
   Title: ChatDatingMessages
   Description: React dating app chat interface for Next.js with heart reactions, match header, compatibility badge, ice-breaker prompts, and profile preview using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-dating-messages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Profile header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-rose-500/10">
                <span class="font-medium text-rose-600 text-sm dark:text-rose-400">
                    @_match.Initials
                </span>
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">
                        @_match.Name, @_match.Age
                    </span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 border-0 bg-emerald-500/10 px-1.5 text-[10px] text-emerald-600 dark:text-emerald-400">
                        @_match.Compatibility% match
                    </BadgeCn>
                </div>
                <p class="truncate text-muted-foreground text-xs">@_match.Bio</p>
            </div>
        </div>

        @* Match timestamp *@
        <div class="flex items-center justify-center gap-2 border-b px-4 py-2">
            <LucideIconCn Name="heart" Size="12" Class="size-3 fill-rose-400 text-rose-400" />
            <span class="text-muted-foreground text-xs">@_match.MatchedAgo</span>
            <LucideIconCn Name="heart" Size="12" Class="size-3 fill-rose-400 text-rose-400" />
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-2">

                @* Ice-breaker prompts *@
                <div class="mb-3 space-y-1.5">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-muted-foreground text-[10px] uppercase tracking-wider">
                            Ice breakers
                        </span>
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var prompt in _iceBreakers)
                        {
                            var capturedPrompt = prompt;
                            <button
                                type="button"
                                @onclick="@(() => _input = capturedPrompt)"
                                class="rounded-full bg-rose-500/5 px-3 py-1.5 text-xs text-rose-600 transition-colors hover:bg-rose-500/10 dark:text-rose-400">
                                @prompt
                            </button>
                        }
                    </div>
                </div>

                @foreach (var msg in _messages)
                {
                    var isMe = msg.Sender == "me";
                    <div class="@($"group flex items-end gap-1.5{(isMe ? " flex-row-reverse" : "")}")">
                        <div class="@($"max-w-[75%] rounded-2xl px-3.5 py-2.5{(isMe ? " rounded-br-sm bg-rose-500/10 text-foreground" : " rounded-bl-sm bg-muted/50")}")">
                            <p class="text-sm leading-relaxed">@msg.Content</p>
                            <span class="mt-1 block text-right text-muted-foreground text-[10px]">
                                @msg.Timestamp
                            </span>
                        </div>
                        <button
                            type="button"
                            @onclick="@(() => ToggleHeart(msg.Id))"
                            class="mb-2 shrink-0 rounded-full p-0.5 opacity-0 transition-opacity group-hover:opacity-100" aria-label="Like message">
                            <LucideIconCn Name="heart" Size="14" Class="@($"size-3.5 transition-colors{(msg.Hearted ? " fill-rose-500 text-rose-500" : " text-muted-foreground/40 hover:text-rose-400")}")" />
                        </button>
                    </div>
                }

            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault class="flex items-center gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="@($"Message {_match.Name}...")"
                    Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" aria-label="@($"Message {_match.Name}...")" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="size-9 shrink-0 text-muted-foreground hover:text-rose-500" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record MatchProfile(string Name, int Age, string Initials, int Compatibility, string Bio, string MatchedAgo);

    private record Message(string Id, string Sender, string Content, string Timestamp, bool Hearted);

    private readonly MatchProfile _match = new(
        "Sophie", 28, "S", 94,
        "Coffee enthusiast, trail runner, amateur photographer",
        "Matched 3 days ago");

    private readonly string[] _iceBreakers =
    [
        "What is your go-to coffee order?",
        "Best trail you have hiked recently?",
        "Favorite photo you have ever taken?",
    ];

    private List<Message> _messages =
    [
        new("1", "them", "Hey! I noticed you are into photography too. What do you usually shoot?", "Tue 6:12 PM", false),
        new("2", "me", "Mostly landscape and street photography. I just got back from a trip to the coast and got some great sunset shots.", "Tue 6:15 PM", false),
        new("3", "them", "That sounds amazing! I have been wanting to try more landscape stuff. I mostly do candid portraits right now.", "Tue 6:17 PM", true),
        new("4", "me", "Candid portraits are so hard to get right though. Do you use natural light or bring gear?", "Tue 6:20 PM", false),
        new("5", "them", "Always natural light. I carry a reflector sometimes but that is about it. Less gear, more spontaneity.", "Tue 6:22 PM", false),
        new("6", "me", "Same philosophy. We should go on a photo walk sometime. There is a great spot by the river market on weekends.", "Tue 6:25 PM", false),
        new("7", "them", "I would love that! Saturday morning works for me if the weather holds up.", "Tue 6:27 PM", false),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private void ToggleHeart(string id)
    {
        _messages = _messages.Select(msg =>
            msg.Id == id ? msg with { Hearted = !msg.Hearted } : msg
        ).ToList();
    }
}
