@* ============================================================
   Block: chat-audio-rooms
   Title: ChatAudioRooms
   Description: Audio room chat interface with speaker indicators, hand raise queue, and room controls built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-audio-rooms.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="volume-2" Size="16" Class="size-4 text-foreground" />
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium">Product Roadmap Discussion</h3>
                    <p class="text-xs text-muted-foreground">@_participants.Length participants</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-red-500 hover:text-red-600">
                    <LucideIconCn Name="phone-off" Size="14" Class="size-3.5" />
                    Leave
                </ButtonCn>
            </div>
        </div>

        @* Speakers *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Speakers</span>
                @if (_raisedHands.Length > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs">
                        <LucideIconCn Name="hand" Size="12" Class="size-3" />
                        @_raisedHands.Length waiting
                    </BadgeCn>
                }
            </div>
            <div class="flex flex-wrap gap-3">
                @foreach (var participant in _speakers)
                {
                    <div class="flex flex-col items-center gap-1.5">
                        <div class="relative">
                            <AvatarCn Class="size-12">
                                <AvatarImageCn Src="@participant.Avatar" Alt="" />
                                <AvatarFallbackCn Class="text-xs">@participant.Name[0]</AvatarFallbackCn>
                            </AvatarCn>
                            @if (participant.IsSpeaking)
                            {
                                <div class="absolute inset-0 rounded-full border-2 border-emerald-500 animate-pulse"></div>
                            }
                            <div class="absolute -bottom-1 -right-1 flex size-5 items-center justify-center rounded-full border-2 border-background bg-muted">
                                @if (participant.IsMuted)
                                {
                                    <LucideIconCn Name="mic-off" Size="10" Class="size-2.5 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="mic" Size="10" Class="size-2.5 text-foreground" />
                                }
                            </div>
                        </div>
                        <span class="max-w-[60px] truncate text-xs text-muted-foreground">
                            @participant.Name.Split(' ')[0]
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-3 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                <div class="flex gap-2">
                    <AvatarCn Class="size-6 shrink-0">
                        <AvatarFallbackCn Class="text-xs">@message.UserName[0]</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@message.UserName</span>
                            <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                        </div>
                        <p class="text-sm text-muted-foreground">@message.Content</p>
                    </div>
                </div>
            }
        </div>

        @* Listeners *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="users" Size="12" Class="size-3" />
                <span>Listeners:</span>
                @foreach (var listener in _listeners)
                {
                    var isLast = listener == _listeners[_listeners.Length - 1];
                    <span class="flex items-center gap-1">
                        @listener.Name.Split(' ')[0]
                        @if (listener.HandRaised)
                        {
                            <LucideIconCn Name="hand" Size="12" Class="size-3" />
                        }
                        @if (!isLast)
                        {
                            @(",")
                        }
                    </span>
                }
            </div>
        </div>

        @* Controls *@
        <div class="border-t p-4">
            <div class="mb-3 flex items-center justify-center gap-3">
                <ButtonCn aria-label="@(_isMuted ? "Unmute microphone" : "Mute microphone")" Variant="@(_isMuted ? ButtonVariant.Destructive : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-10 w-10 rounded-full p-0"
                          OnClick="@(() => _isMuted = !_isMuted)">
                    @if (_isMuted)
                    {
                        <LucideIconCn Name="mic-off" Size="16" Class="size-4" />
                    }
                    else
                    {
                        <LucideIconCn Name="mic" Size="16" Class="size-4" />
                    }
                </ButtonCn>
                <ButtonCn aria-label="@(_handRaised ? "Lower hand" : "Raise hand")" Variant="@(_handRaised ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-10 w-10 rounded-full p-0"
                          OnClick="@(() => _handRaised = !_handRaised)">
                    <LucideIconCn Name="hand" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Send a message..."
                         Class="flex-1" aria-label="Send a message..." />
                <ButtonCn Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          OnClick="HandleSend" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Participant(string Id, string Name, string? Avatar, string Role, bool IsSpeaking, bool IsMuted, bool HandRaised);
    private record Message(string Id, string UserId, string UserName, string Content, string Timestamp);

    private bool _isMuted = false;
    private bool _handRaised = false;
    private string _input = "";

    private static readonly Participant[] _participants =
    [
        new("1", "Alex Chen",    null, "speaker",  true,  false, false),
        new("2", "Sarah Kim",    null, "speaker",  false, false, false),
        new("3", "Mike Johnson", null, "speaker",  false, true,  false),
        new("4", "Emma Davis",   null, "listener", false, true,  true),
        new("5", "Tom Wilson",   null, "listener", false, true,  false),
    ];

    private Participant[] _speakers   => _participants.Where(p => p.Role == "speaker").ToArray();
    private Participant[] _listeners  => _participants.Where(p => p.Role == "listener").ToArray();
    private Participant[] _raisedHands => _participants.Where(p => p.Role == "listener" && p.HandRaised).ToArray();

    private List<Message> _messages =
    [
        new("1", "1", "Alex Chen",  "Welcome everyone! Let's discuss the product roadmap.", "10 min ago"),
        new("2", "2", "Sarah Kim",  "Thanks for hosting! Looking forward to this discussion.", "9 min ago"),
        new("3", "4", "Emma Davis", "Can we talk about the Q2 timeline?",                   "5 min ago"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new(DateTime.Now.Ticks.ToString(), "current", "You", _input, "Just now"));
        _input = "";
    }
}
