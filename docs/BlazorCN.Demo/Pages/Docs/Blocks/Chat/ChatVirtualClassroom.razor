@* ============================================================
   Block: chat-virtual-classroom
   Title: ChatVirtualClassroom
   Description: A virtual classroom chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring lesson cards, assignment submissions, and Q&A discussions
   Source: original/blocks/chat/chat-virtual-classroom.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-purple-500/10">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-purple-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">CS 301: Advanced React</h2>
                    <p class="text-xs text-muted-foreground">Prof. Anderson • Section A</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="h-6 gap-1 text-xs">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    24 students
                </BadgeCn>
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
            </div>
        </div>

        @* Lesson Materials *@
        <div class="border-b p-4">
            <CardCn Class="border-purple-200 bg-purple-500/5 p-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-purple-600" />
                    <span class="text-sm font-medium">@_currentLesson.Title</span>
                </div>
                <p class="mb-3 text-xs text-muted-foreground">@_currentLesson.Description</p>
                <div class="space-y-1.5">
                    @foreach (var resource in _currentLesson.Resources)
                    {
                        var res = resource;
                        <div class="flex items-center justify-between rounded-md bg-background/80 px-2 py-1.5">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-xs">@res.Name</span>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1.5 text-[10px]">
                                <LucideIconCn Name="download" Size="12" Class="size-3" />
                                @(res.Type == "assignment" ? "View" : "Download")
                            </ButtonCn>
                        </div>
                    }
                </div>
            </CardCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    @if (msg.Role == "system")
                    {
                        <div class="flex justify-center">
                            <div class="@Cn.Merge("rounded-full px-3 py-1", msg.IsRaisedHand ? "bg-amber-500/10" : "bg-muted/50")">
                                <p class="@Cn.Merge("text-xs", msg.IsRaisedHand ? "font-medium text-amber-700" : "text-muted-foreground")">
                                    @if (msg.IsRaisedHand)
                                    {
                                        <LucideIconCn Name="hand" Size="12" Class="mr-1 inline size-3" />
                                    }
                                    @msg.Content
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", msg.Role == "student" && msg.Sender == "You" ? "flex-row-reverse" : "")">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarImageCn Src="@msg.SenderAvatar" />
                                <AvatarFallbackCn Class="@Cn.Merge("text-xs", msg.Role == "teacher" ? "bg-purple-500/10 text-purple-700" : "bg-muted")">
                                    @(msg.Sender != null && msg.Sender.Length >= 2 ? msg.Sender.Substring(0, 2) : msg.Sender)
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class="@Cn.Merge("flex max-w-[80%] flex-col gap-1.5", msg.Role == "student" && msg.Sender == "You" ? "items-end" : "")">
                                <div class="flex items-center gap-2">
                                    <p class="text-xs font-medium">@msg.Sender</p>
                                    @if (msg.Role == "teacher")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 text-[10px]">
                                            Teacher
                                        </BadgeCn>
                                    }
                                    @if (msg.Type == "question")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 bg-blue-500/10 text-blue-700 text-[10px]">
                                            Question
                                        </BadgeCn>
                                    }
                                    @if (msg.Type == "assignment")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 bg-emerald-500/10 text-emerald-700 text-[10px]">
                                            <LucideIconCn Name="check-circle-2" Size="10" Class="mr-0.5 size-2.5" />
                                            Submitted
                                        </BadgeCn>
                                    }
                                </div>
                                <div class="@Cn.Merge("rounded-lg px-3 py-2", msg.Role == "teacher" ? "bg-muted/50" : msg.Sender == "You" ? "bg-purple-500/10 border border-purple-200" : "bg-muted/30")">
                                    <p class="text-sm leading-relaxed">@msg.Content</p>
                                </div>
                                <p class="text-[10px] text-muted-foreground">@msg.Timestamp</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Quick Actions *@
        <div class="border-t px-4 py-2">
            <div class="flex gap-2">
                <ButtonCn Variant="@(_isHandRaised ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 flex-1 gap-1 text-xs", _isHandRaised ? "bg-amber-600 hover:bg-amber-700" : "")"
                          @onclick="HandleRaiseHand">
                    <LucideIconCn Name="hand" Size="12" Class="size-3" />
                    @(_isHandRaised ? "Hand Raised" : "Raise Hand")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1 text-xs">
                    <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                    Submit Work
                </ButtonCn>
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask a question or share a thought..."
                         Class="flex-1" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Sm"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="gap-1.5">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                    Send
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private record Resource(string Name, string Type);

    private record Lesson(string Title, string Description, Resource[] Resources);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        string? Sender = null,
        string? SenderAvatar = null,
        string? Type = null,
        bool IsRaisedHand = false);

    private static readonly Lesson _currentLesson = new(
        "Introduction to React Hooks",
        "Learn about useState, useEffect, and custom hooks",
        [
            new("Lesson Slides.pdf", "pdf"),
            new("Code Examples.zip", "zip"),
            new("Practice Assignment", "assignment"),
        ]);

    private List<Message> _messages =
    [
        new("1", "system", "Class started. 24 students present.", "10:00 AM"),
        new("2", "teacher",
            "Good morning everyone! Today we'll dive into React Hooks. I've shared the lesson materials below. Please download the slides and follow along.",
            "10:01 AM", Sender: "Prof. Anderson", SenderAvatar: "/avatars/teacher.jpg", Type: "lesson"),
        new("3", "student",
            "Good morning! Quick question - will we cover useContext today as well?",
            "10:03 AM", Sender: "Emma Watson", SenderAvatar: "/avatars/emma.jpg", Type: "question"),
        new("4", "teacher",
            "Great question, Emma! We'll touch on useContext briefly, but we'll have a dedicated session on Context API next week.",
            "10:04 AM", Sender: "Prof. Anderson", SenderAvatar: "/avatars/teacher.jpg"),
        new("5", "student",
            "Just submitted the practice assignment from last week!",
            "10:05 AM", Sender: "Alex Chen", SenderAvatar: "/avatars/alex.jpg", Type: "assignment"),
    ];

    private string _input = "";
    private bool _isHandRaised = false;

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new Message(
            Id: DateTime.Now.Ticks.ToString(),
            Role: "student",
            Content: _input,
            Timestamp: "Just now",
            Sender: "You");

        _messages = [.. _messages, newMessage];
        _input = "";
    }

    private void HandleRaiseHand()
    {
        _isHandRaised = !_isHandRaised;
        if (_isHandRaised)
        {
            var handRaiseMessage = new Message(
                Id: DateTime.Now.Ticks.ToString(),
                Role: "system",
                Content: "You raised your hand",
                Timestamp: "Just now",
                IsRaisedHand: true);
            _messages = [.. _messages, handRaiseMessage];
        }
    }
}
