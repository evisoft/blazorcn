@* ============================================================
   Block: chat-medical-consultation
   Title: ChatMedicalConsultation
   Description: React healthcare telemedicine chat block for Next.js with doctor profile header, medical disclaimer banner, prescription cards, and follow-up booking using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-medical-consultation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Doctor header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="relative">
                <AvatarCn Class="size-8">
                    <AvatarFallbackCn Class="bg-muted text-xs">@_doctor.Initials</AvatarFallbackCn>
                </AvatarCn>
                <span class="@Cn.Merge("absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full ring-2 ring-card", StatusDot(_doctor.Status))"></span>
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_doctor.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_doctor.Specialty</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@StatusLabel(_doctor.Status)</span>
            </div>
        </div>

        @* Medical disclaimer *@
        <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <LucideIconCn Name="shield" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <p class="text-muted-foreground text-xs">
                This consultation is for informational purposes. In an emergency, call 911 or visit your
                nearest ER.
            </p>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    <div class="@Cn.Merge("flex", message.Role == "patient" ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[80%]", message.Role == "patient" ? "rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(message.Content))
                            {
                                <p class="text-sm leading-relaxed">@message.Content</p>
                            }

                            @* Prescription card *@
                            @if (message.Prescription != null)
                            {
                                var rx = message.Prescription;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2 flex items-center gap-1.5">
                                        <LucideIconCn Name="pill" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-xs">Prescription</span>
                                    </div>
                                    <div class="space-y-1.5">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Medication</span>
                                            <span class="font-medium text-sm">@rx.Medication</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Dosage</span>
                                            <span class="text-sm">@rx.Dosage</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Frequency</span>
                                            <span class="text-sm">@rx.Frequency</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Duration</span>
                                            <span class="text-sm">@rx.Duration</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <span class="@Cn.Merge("mt-1 block text-right text-xs", message.Role == "patient" ? "text-primary-foreground/60" : "text-muted-foreground")">
                                @message.Timestamp
                            </span>
                        </div>
                    </div>
                }

                @* Follow-up booking *@
                <div class="flex justify-center">
                    <div class="rounded-xl bg-muted/50 px-5 py-3.5 text-center">
                        <p class="mb-2 text-muted-foreground text-xs">
                            @(_followUpBooked
                                ? "Follow-up scheduled for 4 weeks from today"
                                : "Dr. Mitchell recommends a follow-up visit")
                        </p>
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1.5 text-xs"
                                  Disabled="@_followUpBooked"
                                  @onclick="@(() => _followUpBooked = true)">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                            @(_followUpBooked ? "Booked" : "Book follow-up")
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="relative" @onsubmit="HandleSubmit">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Describe your symptoms..."
                            Rows="1"
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Prescription(string Medication, string Dosage, string Frequency, string Duration);

    private record Message(string Id, string Role, string Content, string Timestamp, Prescription? Prescription = null);

    private record Doctor(string Name, string Specialty, string Initials, string Status);

    private static readonly Doctor _doctor = new("Dr. Sarah Mitchell", "Internal Medicine", "SM", "available");

    private static string StatusLabel(string status) => status switch
    {
        "available" => "Available",
        "in-session" => "In session",
        "offline" => "Offline",
        _ => status,
    };

    private static string StatusDot(string status) => status switch
    {
        "available" => "bg-emerald-500",
        "in-session" => "bg-amber-500",
        _ => "bg-muted-foreground/40",
    };

    private static readonly Message[] _messages =
    [
        new("1", "doctor",
            "Good morning. I've reviewed your recent lab results. Your blood pressure is slightly elevated at 138/88. How have you been feeling lately?",
            "9:00 AM"),
        new("2", "patient",
            "Hi Dr. Mitchell. I've been having occasional headaches in the afternoon and feeling a bit fatigued. It's been going on for about two weeks.",
            "9:02 AM"),
        new("3", "doctor",
            "Those symptoms are consistent with the elevated blood pressure reading. Have you been monitoring your sodium intake and getting regular exercise?",
            "9:03 AM"),
        new("4", "patient",
            "I've been busy with work and eating out more than usual. I haven't exercised much in the last month.",
            "9:04 AM"),
        new("5", "doctor",
            "That likely contributed to the reading. I'm going to start you on a low-dose medication to manage this, along with some lifestyle adjustments. Here's the prescription:",
            "9:05 AM"),
        new("6", "doctor", "", "9:05 AM",
            new Prescription("Lisinopril", "10mg", "Once daily, morning", "90 days")),
        new("7", "doctor",
            "Take it with water in the morning. I'd also recommend limiting sodium to under 2,300mg daily and aiming for 30 minutes of walking at least 5 days a week. Let's check in again in 4 weeks.",
            "9:06 AM"),
        new("8", "patient",
            "Understood. I'll start on that right away. Should I get a home blood pressure monitor?",
            "9:07 AM"),
        new("9", "doctor",
            "Yes, that would be very helpful. Take a reading each morning before the medication and log it. Bring the log to our follow-up visit.",
            "9:08 AM"),
    ];

    private bool _followUpBooked = false;
    private string _input = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
