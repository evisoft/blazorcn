@* ============================================================
   Block: chat-carbon-footprint
   Title: ChatCarbonFootprint
   Description: A carbon footprint tracking chat interface with emission cards, offset suggestions, monthly reports, and sustainability insights built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/chat/chat-carbon-footprint.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <AvatarCn Class="size-8">
                    <AvatarImageCn Src="" />
                    <AvatarFallbackCn Class="bg-emerald-500/10 text-emerald-600 text-xs">CF</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Carbon Footprint Tracker</h2>
                    <p class="text-muted-foreground text-xs">Monitor and reduce your impact</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4">
            <div class="space-y-4 py-4">
                @foreach (var message in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="" />
                            <AvatarFallbackCn Class="@Cn.Merge("text-xs", message.Type == "assistant" ? "bg-emerald-500/10 text-emerald-600" : "bg-muted")">
                                @(message.Type == "assistant" ? "CF" : "You")
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", message.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @message.Content
                            </div>
                            <span class="text-muted-foreground text-xs">@message.Timestamp</span>

                            @* Monthly Report *@
                            @if (message.MonthlyReport != null)
                            {
                                <div class="mt-3 overflow-hidden rounded-lg border bg-card p-3">
                                    <div class="flex items-baseline gap-2">
                                        <span class="font-semibold text-2xl tabular-nums">@message.MonthlyReport.Total</span>
                                        <span class="text-muted-foreground text-xs">kg CO₂e total</span>
                                        <div class="ml-auto flex items-center gap-1">
                                            <LucideIconCn Name="trending-down" Size="14" Class="size-3.5 text-emerald-600" />
                                            <span class="font-medium text-emerald-600 text-xs tabular-nums">@(Math.Abs(message.MonthlyReport.Change))% less</span>
                                        </div>
                                    </div>
                                    <div class="mt-3 space-y-1.5">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Progress to goal</span>
                                            <span class="font-medium tabular-nums">@message.MonthlyReport.Goal kg CO₂e</span>
                                        </div>
                                        <ProgressCn Value="@((double)message.MonthlyReport.Goal / message.MonthlyReport.Total * 100)" Class="h-1.5" />
                                    </div>
                                </div>
                            }

                            @* Emission Cards *@
                            @if (message.Emissions != null && message.Emissions.Length > 0)
                            {
                                <div class="mt-3 space-y-2">
                                    @foreach (var emission in message.Emissions)
                                    {
                                        var iconName = GetEmissionIconName(emission.Icon);
                                        <div class="flex items-center gap-3 rounded-lg border bg-card px-3 py-2.5">
                                            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                                <LucideIconCn Name="@iconName" Size="16" Class="size-4 text-muted-foreground" />
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-baseline gap-2">
                                                    <span class="font-medium text-sm">@emission.Category</span>
                                                    <span class="text-muted-foreground text-xs">@(emission.Percentage)%</span>
                                                </div>
                                                <div class="mt-1 flex items-center gap-2">
                                                    <ProgressCn Value="@((double)emission.Percentage)" Class="h-1 flex-1" />
                                                    <span class="shrink-0 font-medium text-xs tabular-nums">@emission.Amount @emission.Unit</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* Offset Suggestions *@
                            @if (message.Offsets != null && message.Offsets.Length > 0)
                            {
                                <div class="mt-3 space-y-2">
                                    @foreach (var offset in message.Offsets)
                                    {
                                        var difficultyClass = GetDifficultyColor(offset.Difficulty);
                                        <div class="overflow-hidden rounded-lg border bg-card">
                                            <div class="space-y-2 p-3">
                                                <div class="flex items-start gap-2">
                                                    <div class="min-w-0 flex-1">
                                                        <p class="text-sm">@offset.Action</p>
                                                    </div>
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-xs capitalize", difficultyClass)">
                                                        @offset.Difficulty
                                                    </BadgeCn>
                                                </div>
                                                <div class="flex items-center gap-2 text-xs">
                                                    <span class="text-muted-foreground">Potential reduction:</span>
                                                    <span class="font-medium text-emerald-600 tabular-nums">-@(offset.Impact) kg CO₂e/month</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t bg-muted/50 p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about your carbon footprint..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record MonthlyReportData(int Total, int Change, int Goal);

    private record EmissionCard(string Id, string Category, int Amount, string Unit, int Percentage, string Icon);

    private record OffsetSuggestion(string Id, string Action, int Impact, string Difficulty);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        EmissionCard[]? Emissions = null,
        OffsetSuggestion[]? Offsets = null,
        MonthlyReportData? MonthlyReport = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Welcome to your carbon footprint tracker! I'll help you monitor and reduce your environmental impact. What would you like to track today?",
            "9:00 AM"),
        new("2", "user",
            "Show me my emissions for this month",
            "9:01 AM"),
        new("3", "assistant",
            "Here's your carbon footprint breakdown for March 2026:",
            "9:01 AM",
            Emissions:
            [
                new("e1", "Transportation", 285, "kg CO₂e", 42, "car"),
                new("e2", "Home Energy", 210, "kg CO₂e", 31, "home"),
                new("e3", "Shopping", 135, "kg CO₂e", 20, "shopping-bag"),
                new("e4", "Food", 48, "kg CO₂e", 7, "leaf"),
            ],
            MonthlyReport: new(678, -12, 500)),
        new("4", "user",
            "How can I reduce my transportation emissions?",
            "9:03 AM"),
        new("5", "assistant",
            "Based on your transportation patterns, here are personalized reduction strategies:",
            "9:03 AM",
            Offsets:
            [
                new("o1", "Switch to public transit 2 days per week", 45, "easy"),
                new("o2", "Carpool with coworkers for commute", 62, "moderate"),
                new("o3", "Transition to an electric vehicle", 185, "hard"),
            ]),
    ];

    private static string GetEmissionIconName(string icon) => icon switch
    {
        "car" => "car",
        "home" => "home",
        "shopping" => "shopping-bag",
        "leaf" => "leaf",
        _ => "circle"
    };

    private static string GetDifficultyColor(string difficulty) => difficulty switch
    {
        "easy" => "bg-emerald-500/10 text-emerald-600",
        "moderate" => "bg-amber-500/10 text-amber-600",
        "hard" => "bg-red-500/10 text-red-600",
        _ => "bg-muted"
    };

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"msg-{_messages.Count + 1}", "user", _input, "Just now"));
        _input = "";
    }
}
