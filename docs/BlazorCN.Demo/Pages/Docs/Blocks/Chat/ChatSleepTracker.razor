@* ============================================================
   Block: chat-sleep-tracker
   Title: ChatSleepTracker
   Description: A sleep tracking chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring sleep score cards, duration charts, and improvement tips
   Source: original/blocks/chat/chat-sleep-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="moon" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium">Sleep Tracker</h3>
                    <p class="text-xs text-muted-foreground">AI-powered sleep coach</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 py-4">
                @foreach (var message in _messages)
                {
                    <div class="@(message.Type == "user" ? "flex gap-3 flex-row-reverse" : "flex gap-3")">

                        @* Avatar *@
                        <AvatarCn Class="size-8 shrink-0">
                            @if (message.Type == "assistant")
                            {
                                <AvatarFallbackCn Class="bg-primary/10">
                                    <LucideIconCn Name="moon" Size="16" Class="size-4 text-primary" />
                                </AvatarFallbackCn>
                            }
                            else
                            {
                                <AvatarImageCn Src="https://avatar.vercel.sh/user" Alt="User" />
                                <AvatarFallbackCn>U</AvatarFallbackCn>
                            }
                        </AvatarCn>

                        @* Message body *@
                        <div class="@(message.Type == "user" ? "flex-1 space-y-2 flex flex-col items-end" : "flex-1 space-y-2")">
                            <div class="@(message.Type == "assistant" ? "inline-block rounded-lg px-3 py-2 text-sm bg-muted" : "inline-block rounded-lg px-3 py-2 text-sm bg-primary text-primary-foreground")">
                                @message.Content
                            </div>

                            @* Sleep data card *@
                            @if (message.SleepData != null)
                            {
                                var sd = message.SleepData;
                                <div class="w-full space-y-3 rounded-lg border bg-card p-4">
                                    <div class="flex items-start justify-between">
                                        <div class="space-y-1">
                                            <p class="text-sm font-medium">@sd.Date</p>
                                            <p class="text-xs text-muted-foreground">Total sleep: @sd.Duration</p>
                                        </div>
                                        <div class="text-right">
                                            <div class="text-2xl font-semibold tabular-nums">@sd.Score</div>
                                            <div class="text-xs text-muted-foreground">Sleep Score</div>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2">
                                        <ProgressCn Value="@sd.Score" Class="flex-1" aria-label="Progress" />
                                        <span class="@Cn.Merge("rounded-full px-2 py-1 text-xs font-medium capitalize", GetQualityColor(sd.Quality))">
                                            @sd.Quality
                                        </span>
                                    </div>

                                    <div class="grid grid-cols-4 gap-2 border-t pt-3">
                                        <div class="space-y-1">
                                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="moon" Size="12" Class="size-3" />
                                                <span>Deep</span>
                                            </div>
                                            <p class="text-sm font-medium tabular-nums">@(sd.Stages.Deep)m</p>
                                        </div>
                                        <div class="space-y-1">
                                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="zap" Size="12" Class="size-3" />
                                                <span>Light</span>
                                            </div>
                                            <p class="text-sm font-medium tabular-nums">@(sd.Stages.Light)m</p>
                                        </div>
                                        <div class="space-y-1">
                                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                                                <span>REM</span>
                                            </div>
                                            <p class="text-sm font-medium tabular-nums">@(sd.Stages.Rem)m</p>
                                        </div>
                                        <div class="space-y-1">
                                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="sunrise" Size="12" Class="size-3" />
                                                <span>Awake</span>
                                            </div>
                                            <p class="text-sm font-medium tabular-nums">@(sd.Stages.Awake)m</p>
                                        </div>
                                    </div>

                                    <div class="space-y-2 border-t pt-3">
                                        <div class="flex items-center gap-2 text-xs font-medium">
                                            <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span>Insights</span>
                                        </div>
                                        @foreach (var insight in sd.Insights)
                                        {
                                            <div class="flex gap-2 text-xs text-muted-foreground">
                                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                                <span>@insight</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                        </div>

                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask about your sleep or get tips..."
                         Class="flex-1" aria-label="Ask about your sleep or get tips..." />
                <ButtonCn Size="ButtonSize.Icon" OnClick="@HandleSend" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record SleepStages(int Deep, int Light, int Rem, int Awake);

    private record SleepData(
        string Date,
        int Score,
        string Duration,
        string Quality,
        SleepStages Stages,
        string[] Insights);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        SleepData? SleepData = null);

    private string GetQualityColor(string quality) => quality switch
    {
        "excellent" => "text-emerald-600 bg-emerald-500/10",
        "good"      => "text-blue-600 bg-blue-500/10",
        "fair"      => "text-amber-600 bg-amber-500/10",
        "poor"      => "text-red-600 bg-red-500/10",
        _           => "text-muted-foreground bg-muted",
    };

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Good morning! I'm your sleep coach. Let me analyze your sleep from last night.",
            "7:00 AM"),
        new("2", "assistant",
            "Here's your sleep summary for last night:",
            "7:00 AM",
            SleepData: new(
                "March 29, 2026",
                82,
                "7h 32m",
                "good",
                new SleepStages(95, 185, 110, 22),
                [
                    "You got 1h 35m of deep sleep, which is excellent for recovery",
                    "Your REM sleep was slightly below average - try to sleep 30 minutes longer",
                    "You woke up 3 times during the night - consider reducing screen time before bed",
                ])),
        new("3", "user",
            "How can I improve my REM sleep?",
            "7:05 AM"),
        new("4", "assistant",
            "Great question! Here are 3 proven ways to increase REM sleep:\n\n1. Stick to a consistent sleep schedule - go to bed and wake up at the same time daily\n2. Avoid alcohol 3-4 hours before bed - it suppresses REM cycles\n3. Keep your bedroom cool (65-68°F) - REM sleep is temperature-sensitive\n\nI'll check your progress tomorrow!",
            "7:05 AM"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new(
            DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString(),
            "user",
            _input,
            "Just now"));
        _input = "";
    }
}
