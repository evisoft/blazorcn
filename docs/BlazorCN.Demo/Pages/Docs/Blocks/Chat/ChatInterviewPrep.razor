@* ============================================================
   Block: chat-interview-prep
   Title: ChatInterviewPrep
   Description: React interview preparation chat block for Next.js with question cards, difficulty badges, topic tags, sample answer reveals, self-rating buttons, and session progress using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-interview-prep.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8 shrink-0">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="clipboard-check" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Interview Coach</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Sr. Frontend</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Mock interview session</span>
            </div>
        </div>

        @* Session progress *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Session progress</span>
            <ProgressCn Value="@_progressPercent" Class="h-1.5 flex-1" />
            <span class="font-medium text-xs tabular-nums">@_completedQuestions/@_totalQuestions</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    var msgId = msg.Id;
                    var showAnswer = _showAnswers.Contains(msgId);
                    var rating = _ratings.TryGetValue(msgId, out var r) ? (int?)r : null;

                    <div class="@Cn.Merge("flex", msg.Role == "candidate" ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[85%]", msg.Role == "candidate" ? "rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">

                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }

                            @* Question card *@
                            @if (msg.InterviewQuestion != null)
                            {
                                var q = msg.InterviewQuestion;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <LucideIconCn Name="lightbulb" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <BadgeCn Class="@Cn.Merge("border-0 font-normal text-xs", DifficultyColor(q.Difficulty))">@q.Difficulty</BadgeCn>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@q.Topic</BadgeCn>
                                    </div>
                                    <p class="mb-3 font-medium text-sm leading-relaxed">@q.Question</p>

                                    @* Talking points *@
                                    <div class="mb-3 space-y-1">
                                        <span class="font-medium text-muted-foreground text-xs">Key points to cover</span>
                                        @foreach (var point in q.TalkingPoints)
                                        {
                                            <div class="flex items-start gap-2 text-muted-foreground text-xs">
                                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                                @point
                                            </div>
                                        }
                                    </div>

                                    @* Sample answer toggle *@
                                    <button type="button"
                                            class="flex w-full items-center justify-between rounded-md bg-muted/50 px-3 py-2 text-left transition-colors hover:bg-muted"
                                            @onclick="@(() => ToggleAnswer(msgId))">
                                        <span class="flex items-center gap-1.5 text-xs">
                                            <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="font-medium text-muted-foreground">Sample answer</span>
                                        </span>
                                        <LucideIconCn Name="chevron-down" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", showAnswer ? "rotate-180" : "")" />
                                    </button>
                                    @if (showAnswer)
                                    {
                                        <div class="mt-2 rounded-md bg-muted/50 p-3">
                                            <p class="text-sm leading-relaxed">@q.SampleAnswer</p>
                                        </div>
                                    }

                                    @* Self-rating *@
                                    <div class="mt-3 flex items-center justify-between border-t pt-2.5">
                                        <span class="text-muted-foreground text-xs">Rate your confidence</span>
                                        <div class="flex items-center gap-1">
                                            @foreach (var ratingVal in new[] { 1, 2, 3 })
                                            {
                                                var rv = ratingVal;
                                                <ButtonCn Variant="@(rating == rv ? ButtonVariant.Default : ButtonVariant.Outline)"
                                                          Size="ButtonSize.Sm"
                                                          Class="h-7 w-8 text-xs"
                                                          @onclick="@(() => SetRating(msgId, rv))">
                                                    @(rv == 1 ? "Low" : rv == 2 ? "Mid" : "High")
                                                </ButtonCn>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            <span class="@Cn.Merge("mt-1 block text-right text-xs", msg.Role == "candidate" ? "text-primary-foreground/60" : "text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="relative" @onsubmit="HandleSubmit">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Practice your answer..."
                            Rows="1"
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private record InterviewQuestion(
        string Question,
        string Difficulty,
        string Topic,
        string[] TalkingPoints,
        string SampleAnswer);

    private record Message(string Id, string Role, string Content, string Timestamp, InterviewQuestion? InterviewQuestion = null);

    private const int _totalQuestions = 10;
    private const int _completedQuestions = 4;
    private int _progressPercent => (int)Math.Round((double)_completedQuestions / _totalQuestions * 100);

    private string _input = "";
    private HashSet<string> _showAnswers = new();
    private Dictionary<string, int> _ratings = new();

    private static string DifficultyColor(string difficulty) => difficulty switch
    {
        "easy" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "medium" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "hard" => "bg-red-500/10 text-red-700 dark:text-red-400",
        _ => ""
    };

    private static readonly List<Message> _messages =
    [
        new("1", "coach",
            "Welcome to your mock interview session. Today we're focusing on behavioral and system design questions for senior frontend roles. Take your time with each answer.",
            "10:00 AM"),
        new("2", "candidate",
            "Sounds good. I'm preparing for interviews at a few mid-stage startups. Let's focus on leadership and technical decision-making.",
            "10:01 AM"),
        new("3", "coach",
            "Great focus areas. Let's start with a behavioral question.",
            "10:02 AM"),
        new("4", "coach", "", "10:02 AM",
            new InterviewQuestion(
                "Tell me about a time you had to make a technical decision that your team disagreed with. How did you handle it?",
                "medium",
                "Leadership",
                [
                    "Set context: team size, project, and stakes",
                    "Explain your reasoning and the data behind it",
                    "Describe how you addressed concerns and built consensus",
                    "Share the outcome and what you learned",
                ],
                "At my previous company, I proposed migrating our monolith to a micro-frontend architecture. The team was skeptical about the added complexity. I organized a spike where two engineers built a proof-of-concept for one module. I presented the results showing 40% faster build times and independent deployments. We agreed to migrate incrementally, starting with the least-coupled module. Within 3 months, deployment frequency doubled and team autonomy improved significantly."
            )),
        new("5", "candidate",
            "I'd talk about the time I pushed for TypeScript adoption. The team was resistant because of the learning curve, but I created a gradual migration plan starting with new files only. After a month, bug reports dropped noticeably and the team bought in.",
            "10:06 AM"),
        new("6", "coach",
            "Good structure. You hit the situation, action, and result. Try to include a specific metric next time, like percentage reduction in bugs. Quantified outcomes make a much stronger impression.",
            "10:07 AM"),
        new("7", "coach",
            "Let's move to a system design question.",
            "10:08 AM"),
        new("8", "coach", "", "10:08 AM",
            new InterviewQuestion(
                "How would you design a real-time collaborative text editor for a team of 50 users?",
                "hard",
                "System Design",
                [
                    "Discuss conflict resolution: OT vs CRDT",
                    "Address network latency and offline support",
                    "Explain cursor presence and awareness",
                    "Cover persistence, history, and undo/redo",
                ],
                "I'd use CRDTs for conflict-free real-time merging. The architecture would have a WebSocket server broadcasting operations to connected clients, with each client maintaining a local CRDT document. For persistence, operations would be batched and stored in a PostgreSQL database with periodic snapshots. Cursor presence would use a lightweight pub/sub channel separate from document operations. Offline support would queue local operations and sync on reconnect using vector clocks for ordering."
            )),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private void ToggleAnswer(string messageId)
    {
        if (!_showAnswers.Add(messageId))
            _showAnswers.Remove(messageId);
    }

    private void SetRating(string messageId, int ratingValue)
    {
        _ratings[messageId] = ratingValue;
    }
}
