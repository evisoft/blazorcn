@* ============================================================
   Block: chat-intercom-style
   Title: ChatIntercomStyle
   Description: React Intercom-inspired support widget chat for Next.js with agent avatar, quick reply buttons, gradient header, powered-by footer, and typing indicator using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-intercom-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Gradient header *@
        <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="relative">
                    <AvatarCn Class="size-10 border-2 border-white/20">
                        <AvatarFallbackCn Class="bg-white/20 text-sm text-white">@_agent.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <span class="absolute right-0 bottom-0 size-2.5 rounded-full border-2 border-blue-600 bg-emerald-400"></span>
                </div>
                <div>
                    <span class="font-medium text-sm text-white">@_agent.Name</span>
                    <p class="text-white/70 text-xs">@_agent.Role · Typically replies in minutes</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col gap-0.5 overflow-y-auto px-4 py-4">
            @for (int i = 0; i < _processed.Length; i++)
            {
                var msg = _processed[i];
                var isAgent = msg.Sender == "agent";

                <div>
                    <div class="@Cn.Merge("flex flex-col", isAgent ? "items-start" : "items-end", msg.IsFirstInGroup ? "mt-3 first:mt-0" : "")">
                        @* Agent avatar + name on first message in group *@
                        @if (isAgent && msg.IsFirstInGroup)
                        {
                            <div class="mb-1 flex items-center gap-2">
                                <AvatarCn Class="size-6">
                                    <AvatarFallbackCn Class="text-[9px]">@_agent.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="font-medium text-xs">@msg.SenderName</span>
                                <span class="text-[10px] text-muted-foreground">@msg.Timestamp</span>
                            </div>
                        }

                        @* Bubble *@
                        <div class="@Cn.Merge("max-w-[80%] rounded-2xl px-3.5 py-2 text-sm leading-relaxed", isAgent ? "ml-8 bg-muted text-foreground" : "bg-blue-600 text-white")">
                            @msg.Content
                        </div>

                        @* User timestamp *@
                        @if (!isAgent && msg.IsLastInGroup)
                        {
                            <span class="mt-0.5 px-1 text-[10px] text-muted-foreground">@msg.Timestamp</span>
                        }
                    </div>

                    @* Quick reply buttons (rounded-full outline) below last agent message *@
                    @if (msg.ShowQuickReplies && msg.QuickReplies != null)
                    {
                        <div class="ml-8 mt-2 flex flex-wrap gap-1.5">
                            @foreach (var reply in msg.QuickReplies)
                            {
                                var capturedReply = reply;
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                          Class="h-7 rounded-full px-3 text-xs text-blue-600 hover:bg-blue-50 hover:text-blue-700 dark:text-blue-400 dark:hover:bg-blue-500/10"
                                          OnClick="@(() => HandleQuickReply(capturedReply))">
                                    @reply
                                </ButtonCn>
                            }
                        </div>
                    }
                </div>
            }

            @* Typing dots indicator *@
            @if (_showTyping)
            {
                <div class="mt-3 flex items-start gap-2">
                    <AvatarCn Class="size-6">
                        <AvatarFallbackCn Class="text-[9px]">@_agent.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="rounded-2xl bg-muted">
                        <div class="flex items-center gap-1 px-3 py-2">
                            <span class="size-1.5 animate-pulse rounded-full bg-muted-foreground/50 [animation-delay:0ms]"></span>
                            <span class="size-1.5 animate-pulse rounded-full bg-muted-foreground/50 [animation-delay:200ms]"></span>
                            <span class="size-1.5 animate-pulse rounded-full bg-muted-foreground/50 [animation-delay:400ms]"></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Input + Powered by footer *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="smile" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="Type your message..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-blue-600 hover:text-blue-700 disabled:text-muted-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>

            @* Powered by Acme Chat footer *@
            <p class="mt-2 text-center text-[10px] text-muted-foreground">
                Powered by <span class="font-medium">Acme Chat</span>
            </p>
        </div>
    </div>
</section>

@code {
    private record AgentInfo(string Name, string Role, string Initials);

    private record Message(
        string Id,
        string Content,
        string Sender,
        string? SenderName,
        string Timestamp,
        string[]? QuickReplies = null
    );

    private record ProcessedMessage(
        string Id,
        string Content,
        string Sender,
        string? SenderName,
        string Timestamp,
        string[]? QuickReplies,
        bool IsFirstInGroup,
        bool IsLastInGroup,
        bool ShowQuickReplies
    );

    private static readonly AgentInfo _agent = new("Emma", "Support Engineer", "EM");

    private static readonly Message[] _initialMessages =
    [
        new("1", "Hi there! I'm Emma from the support team. How can I help you today?", "agent", "Emma", "Just now",
            ["Billing question", "Technical issue", "Feature request"]),
        new("2", "Technical issue", "user", null, "Just now"),
        new("3", "I'm sorry to hear you're having a technical issue. Can you describe what's happening?", "agent", "Emma", "Just now",
            ["App is crashing", "Can't log in", "Data not syncing", "Other"]),
        new("4", "Data not syncing", "user", null, "1 min ago"),
        new("5", "I see. Sync issues are usually caused by one of two things: a stale session token or a network configuration problem.", "agent", "Emma", "1 min ago"),
        new("6", "Can you try logging out and back in first? That refreshes your session token and resolves most sync issues.", "agent", "Emma", "1 min ago"),
        new("7", "I tried that already. Still not syncing.", "user", null, "1 min ago"),
        new("8", "Okay, let me check your account. One moment...", "agent", "Emma", "Just now"),
        new("9", "I found the issue. Your workspace hit the 10GB storage limit, which pauses sync. I've temporarily increased your limit. You should see data flowing again within a minute.", "agent", "Emma", "Just now",
            ["That fixed it!", "Still not working", "How do I upgrade?"]),
    ];

    private string _input = "";
    private bool _showTyping = false;

    private ProcessedMessage[] _processed = ProcessMessages(_initialMessages);

    private static ProcessedMessage[] ProcessMessages(Message[] msgs)
    {
        var result = new ProcessedMessage[msgs.Length];
        for (int i = 0; i < msgs.Length; i++)
        {
            var msg = msgs[i];
            var prev = i > 0 ? msgs[i - 1] : null;
            var next = i < msgs.Length - 1 ? msgs[i + 1] : null;
            var isLast = i == msgs.Length - 1;
            result[i] = new ProcessedMessage(
                msg.Id,
                msg.Content,
                msg.Sender,
                msg.SenderName,
                msg.Timestamp,
                msg.QuickReplies,
                IsFirstInGroup: prev == null || prev.Sender != msg.Sender,
                IsLastInGroup: next == null || next.Sender != msg.Sender,
                ShowQuickReplies: isLast && msg.QuickReplies?.Length > 0
            );
        }
        return result;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
        _showTyping = true;
        // In a real app a timer would clear _showTyping after 2s; for a static demo we leave it visible
    }

    private void HandleQuickReply(string text)
    {
        // Handle quick reply selection
    }
}
