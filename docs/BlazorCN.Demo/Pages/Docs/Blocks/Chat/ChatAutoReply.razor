@* ============================================================
   Block: chat-auto-reply
   Title: ChatAutoReply
   Description: React auto-reply chat block for Next.js with away status indicator, automatic response message, business hours info card, and estimated response time using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-auto-reply.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-xs">AS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Acme Support</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Away
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideIconCn Name="moon" Size="12" Class="size-3" />
                After hours
            </BadgeCn>
        </div>

        @* Business hours info *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-2 flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Business hours</span>
                </div>
                <div class="flex flex-col gap-1">
                    @foreach (var bh in _businessHours)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">@bh.Day</span>
                            <span class="text-xs">@bh.Hours</span>
                        </div>
                    }
                </div>
                <div class="mt-2 flex items-center gap-1.5 border-t pt-2">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-muted-foreground text-xs">
                        Estimated response: within 2 hours
                    </span>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col gap-3 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var msg in _messages)
            {
                var isUser = msg.Sender == "user";
                <div class="@Cn.Merge("flex items-end gap-2", isUser ? "flex-row-reverse" : "flex-row")">
                    @if (!isUser)
                    {
                        <AvatarCn Class="size-7">
                            <AvatarFallbackCn Class="text-[10px]">AS</AvatarFallbackCn>
                        </AvatarCn>
                    }
                    <div class="@Cn.Merge("flex max-w-[75%] flex-col", isUser ? "items-end" : "items-start")">
                        @if (msg.IsAutoReply)
                        {
                            <span class="mb-0.5 px-1 text-amber-600 text-[10px] dark:text-amber-400">
                                Auto-reply
                            </span>
                        }
                        <div class="@Cn.Merge("rounded-2xl px-3 py-2 text-sm leading-relaxed", isUser ? "rounded-br-sm bg-foreground text-background" : "rounded-bl-sm bg-muted text-foreground")">
                            @msg.Content
                        </div>
                        <span class="mt-0.5 px-1 text-muted-foreground text-[10px]">@msg.Time</span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault class="flex items-center gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Leave a message..."
                    Class="h-9 flex-1 border-0 bg-muted/50 text-sm shadow-none focus-visible:ring-0" aria-label="Leave a message..." />
                <ButtonCn
                    Type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send message">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
            <p class="mt-1.5 text-center text-muted-foreground text-[10px]">
                You'll receive an email when an agent responds
            </p>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Content, string Time, bool IsAutoReply = false);

    private record BusinessHours(string Day, string Hours);

    private static readonly BusinessHours[] _businessHours =
    [
        new("Mon - Fri", "9:00 AM - 5:00 PM EST"),
        new("Saturday", "10:00 AM - 2:00 PM EST"),
        new("Sunday", "Closed"),
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "user",
            "Hi, I need help upgrading my plan. The checkout page is showing an error when I try to switch from the Team plan to Organization.",
            "8:47 PM"),
        new("m2", "support",
            "Thanks for reaching out! Our team is currently offline but we received your message. We typically respond within 2 hours during business hours.",
            "8:47 PM", IsAutoReply: true),
        new("m3", "user",
            "When will someone be available? This is kind of urgent for our team.",
            "8:49 PM"),
        new("m4", "support",
            "We understand this is important. A support agent will follow up with you first thing tomorrow morning. If this is critical, you can email urgent@@acme.com for priority handling.",
            "8:49 PM", IsAutoReply: true),
    ];

    private string _input = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
