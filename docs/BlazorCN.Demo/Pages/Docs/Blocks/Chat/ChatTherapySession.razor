@* ============================================================
   Block: chat-therapy-session
   Title: ChatTherapySession
   Description: A therapy-style reflective chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring guided prompts, emotion tagging, and session notes
   Source: original/blocks/chat/chat-therapy-session.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-purple-500/10">
                    <LucideIconCn Name="heart" Size="16" Class="size-4 text-purple-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Therapy Session</h2>
                    <p class="text-xs text-muted-foreground">Safe space for reflection</p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="HandleExportNotes">
                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                Export Notes
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            <div class="space-y-4">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    var emotionEntry = _emotions.FirstOrDefault(e => e.Label == message.Emotion);
                    <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            @if (message.Role == "assistant")
                            {
                                <AvatarImageCn Src="/avatars/therapist.jpg" />
                                <AvatarFallbackCn Class="bg-purple-500/10 text-purple-700 text-xs">TH</AvatarFallbackCn>
                            }
                            else
                            {
                                <AvatarImageCn Src="/avatars/user.jpg" />
                                <AvatarFallbackCn Class="bg-muted text-xs">You</AvatarFallbackCn>
                            }
                        </AvatarCn>
                        <div class="@Cn.Merge("flex max-w-[80%] flex-col gap-1.5", message.Role == "user" ? "items-end" : "")">
                            <div class="@Cn.Merge("rounded-lg px-3 py-2", message.Role == "assistant" ? "bg-muted/50" : "bg-purple-500/10 border border-purple-200")">
                                <p class="text-sm leading-relaxed">@message.Content</p>
                            </div>
                            <div class="flex items-center gap-2">
                                @if (!string.IsNullOrEmpty(message.Emotion))
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-5 text-[10px] font-medium", emotionEntry?.Color ?? "")">
                                        @message.Emotion
                                    </BadgeCn>
                                }
                                <span class="text-[10px] text-muted-foreground">@message.Timestamp</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Guided Prompts *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-2 overflow-x-auto">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 shrink-0 text-purple-600" />
                <span class="shrink-0 text-xs text-muted-foreground">Guided prompts:</span>
                @foreach (var p in _guidedPrompts)
                {
                    var prompt = p;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 text-xs" @onclick="@(() => HandlePromptClick(prompt))">
                        @p
                    </ButtonCn>
                }
            </div>
        </div>

        @* Emotion Tags *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">Tag emotion:</span>
                @foreach (var emo in _emotions)
                {
                    var emotion = emo;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 text-[10px] font-medium transition-colors", _selectedEmotion == emotion.Label ? emotion.Color : "hover:bg-muted/50")"
                              @onclick="@(() => ToggleEmotion(emotion.Label))">
                        @emotion.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input" Placeholder="Share your thoughts and feelings..." Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Sm" Disabled="@string.IsNullOrWhiteSpace(_input)" Class="gap-1.5">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                    Send
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record EmotionTag(string Label, string Color);

    private record Message(string Id, string Role, string Content, string Timestamp, string? Emotion = null);

    private static readonly EmotionTag[] _emotions =
    [
        new("Joy",       "bg-emerald-500/10 text-emerald-700 border-emerald-200"),
        new("Sadness",   "bg-blue-500/10 text-blue-700 border-blue-200"),
        new("Anxiety",   "bg-amber-500/10 text-amber-700 border-amber-200"),
        new("Anger",     "bg-red-500/10 text-red-700 border-red-200"),
        new("Peace",     "bg-purple-500/10 text-purple-700 border-purple-200"),
        new("Gratitude", "bg-pink-500/10 text-pink-700 border-pink-200"),
    ];

    private static readonly string[] _guidedPrompts =
    [
        "What's been on your mind lately?",
        "Tell me about a challenging moment today",
        "What are you grateful for right now?",
        "How are you really feeling?",
    ];

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Hello, I'm here to listen and support you. This is a safe space to share your thoughts and feelings. How are you doing today?",
            "2:30 PM"),
        new("2", "user",
            "I've been feeling overwhelmed with work lately. There's so much pressure to perform and I feel like I'm falling behind.",
            "2:31 PM", "Anxiety"),
        new("3", "assistant",
            "Thank you for sharing that. Feeling overwhelmed is a very real and valid experience. Can you tell me more about what specific aspects of work are creating the most pressure for you?",
            "2:31 PM"),
        new("4", "user",
            "It's the constant deadlines and the feeling that I'm never doing enough. Even when I complete tasks, I don't feel satisfied.",
            "2:33 PM", "Sadness"),
        new("5", "assistant",
            "It sounds like you're dealing with perfectionism and perhaps some unrealistic expectations. These feelings of never being 'enough' can be exhausting. Have you been able to acknowledge your accomplishments, even small ones?",
            "2:34 PM"),
    ];

    private string _input = "";
    private string _selectedEmotion = "";

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var userMsg = new Message(
            Guid.NewGuid().ToString(),
            "user",
            _input,
            "Just now",
            string.IsNullOrEmpty(_selectedEmotion) ? null : _selectedEmotion
        );

        _messages.Add(userMsg);
        _input = "";
        _selectedEmotion = "";

        // Simulate therapist response
        _messages.Add(new Message(
            Guid.NewGuid().ToString(),
            "assistant",
            "I hear what you're saying. That sounds really challenging. Tell me more about how that makes you feel.",
            "Just now"
        ));
    }

    private void HandlePromptClick(string prompt)
    {
        _input = prompt;
    }

    private void ToggleEmotion(string label)
    {
        _selectedEmotion = _selectedEmotion == label ? "" : label;
    }

    private void HandleExportNotes()
    {
        // Export is a browser-side download; no-op in static demo
    }
}
