@* ============================================================
   Block: chat-satisfaction-rating
   Title: ChatSatisfactionRating
   Description: React post-chat satisfaction survey block for Next.js with star rating, what-went-well tags, free-text feedback, NPS slider, and animated submit confirmation using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-satisfaction-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8 shrink-0">
                <AvatarFallbackCn Class="text-xs">RK</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Rachel Kim</span>
                <p class="text-muted-foreground text-xs">Billing &amp; Accounts</p>
            </div>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                Ended
            </span>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col py-2">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    var msgIndex = _messages.IndexOf(message);
                    if (message.Role == "system")
                    {
                        <div class="flex justify-center py-3">
                            <span class="rounded-full bg-muted/50 px-3 py-1 text-muted-foreground text-xs">
                                @message.Content &middot; @message.Timestamp
                            </span>
                        </div>
                    }
                    else if (message.Role == "user")
                    {
                        <div class="flex justify-end px-2 py-0.5">
                            <div class="max-w-[75%]">
                                <div class="rounded-2xl bg-foreground px-3 py-2 text-background text-sm leading-relaxed">
                                    @message.Content
                                </div>
                                <span class="mt-0.5 block text-right text-muted-foreground text-[10px]">
                                    @message.Timestamp
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        var prevMsg = msgIndex > 0 ? _messages[msgIndex - 1] : null;
                        var showAvatar = prevMsg == null || prevMsg.Role != message.Role;
                        <div class="flex gap-2 rounded-md px-2 py-0.5 transition-colors hover:bg-accent">
                            <div class="w-8 shrink-0">
                                @if (showAvatar)
                                {
                                    <AvatarCn Class="size-8">
                                        <AvatarFallbackCn Class="text-xs">RK</AvatarFallbackCn>
                                    </AvatarCn>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                @if (showAvatar)
                                {
                                    <span class="mb-0.5 block text-muted-foreground text-[10px]">
                                        Rachel Kim
                                    </span>
                                }
                                <div class="max-w-[85%] rounded-2xl bg-muted px-3 py-2 text-sm leading-relaxed">
                                    @message.Content
                                </div>
                                <span class="mt-0.5 block text-muted-foreground text-[10px]">
                                    @message.Timestamp
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>

            @* Rating Card *@
            <div class="mx-4 mb-4 mt-auto">
                <div class="overflow-hidden rounded-lg border">
                    @* Agent info *@
                    <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-3">
                        <AvatarCn Class="size-9">
                            <AvatarFallbackCn Class="font-medium text-xs">RK</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <span class="block font-medium text-sm">Rachel Kim</span>
                            <span class="text-muted-foreground text-xs">Senior Support Specialist</span>
                        </div>
                    </div>

                    @if (_submitted)
                    {
                        <div class="flex flex-col items-center gap-2 px-4 py-8">
                            <LucideIconCn Name="check-circle-2" Size="32" Class="size-8 text-emerald-500" />
                            <span class="font-medium text-sm">Thank you for your feedback</span>
                            <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-muted-foreground text-xs">
                                <span>Rating: @_rating/5</span>
                                <span class="text-muted-foreground/30">&middot;</span>
                                <span>@_ratingLabels[_rating]</span>
                                @if (_selectedTags.Count > 0)
                                {
                                    <span class="text-muted-foreground/30">&middot;</span>
                                    <span>@_selectedTags.Count tags</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="px-4 py-4">
                            @* Star rating *@
                            <span class="block text-center font-medium text-sm">
                                How was your experience?
                            </span>
                            <p class="mt-1 text-center text-muted-foreground text-xs">
                                Rate your conversation with Rachel Kim
                            </p>

                            <div class="mt-3 flex items-center justify-center gap-1">
                                @foreach (var star in _stars)
                                {
                                    var s = star;
                                    <button type="button"
                                            @onclick="@(() => SetRating(s))"
                                            @onmouseenter="@(() => SetHoveredStar(s))"
                                            @onmouseleave="@(() => SetHoveredStar(0))"
                                            class="rounded-md p-1 transition-colors hover:bg-muted/50" aria-label="@($"Rate {s} out of 5")">
                                        <LucideIconCn Name="star" Size="28" Class="@Cn.Merge("size-7 transition-colors", s <= _activeRating ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                                    </button>
                                }
                            </div>
                            @if (_activeRating > 0)
                            {
                                <p class="mt-1 text-center text-muted-foreground text-xs">
                                    @_ratingLabels[_activeRating]
                                </p>
                            }

                            @* Tags *@
                            @if (_rating > 0)
                            {
                                <div class="mt-4">
                                    <span class="block text-center text-muted-foreground text-xs">
                                        What went well?
                                    </span>
                                    <div class="mt-2 flex flex-wrap justify-center gap-1.5">
                                        @foreach (var tag in _tagOptions)
                                        {
                                            var t = tag;
                                            <button type="button"
                                                    @onclick="@(() => ToggleTag(t))"
                                                    class="@Cn.Merge("rounded-full border px-2.5 py-1 text-xs transition-colors", _selectedTags.Contains(t) ? "border-foreground bg-foreground text-background" : "border-border text-muted-foreground hover:border-foreground/30 hover:text-foreground")">
                                                @t
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            @* Feedback textarea *@
                            @if (_rating > 0)
                            {
                                <div class="mt-4">
                                    <TextareaCn @bind-Value="_feedback"
                                                Placeholder="Any additional comments? (optional)"
                                                Rows="2"
                                                Class="min-h-0 resize-none text-sm" aria-label="Any additional comments? (optional)" />
                                </div>
                            }

                            @* Submit *@
                            <ButtonCn OnClick="HandleSubmit"
                                      Disabled="@(_rating == 0)"
                                      Size="ButtonSize.Sm"
                                      Class="mt-4 w-full text-xs">
                                Submit feedback
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* No toolbar -- chat is ended *@
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content, string Timestamp);

    private static readonly ChatMessage[] _messages =
    [
        new("1", "agent", "Hi! I can see your account. Let me look into the billing discrepancy you mentioned.", "3:04 PM"),
        new("2", "user", "Thanks. I was charged twice for the March invoice, order #INV-2847.", "3:05 PM"),
        new("3", "agent", "I found it. There was a duplicate charge of $49.00 on March 12. I've initiated a refund that will appear in 3-5 business days.", "3:07 PM"),
        new("4", "user", "That's exactly what I needed. Thank you for the quick resolution!", "3:08 PM"),
        new("5", "system", "Chat ended", "3:09 PM"),
    ];

    private static readonly Dictionary<int, string> _ratingLabels = new()
    {
        { 1, "Very poor" },
        { 2, "Poor" },
        { 3, "Average" },
        { 4, "Good" },
        { 5, "Excellent" },
    };

    private static readonly string[] _tagOptions =
    [
        "Quick resolution",
        "Friendly agent",
        "Clear explanation",
        "Knowledgeable",
        "Patient",
        "Followed up",
    ];

    private static readonly int[] _stars = [1, 2, 3, 4, 5];

    private int _rating = 0;
    private int _hoveredStar = 0;
    private HashSet<string> _selectedTags = [];
    private string _feedback = "";
    private bool _submitted = false;

    private int _activeRating => _hoveredStar != 0 ? _hoveredStar : _rating;

    private void SetRating(int star) => _rating = star;
    private void SetHoveredStar(int star) => _hoveredStar = star;

    private void ToggleTag(string tag)
    {
        if (_selectedTags.Contains(tag))
            _selectedTags.Remove(tag);
        else
            _selectedTags.Add(tag);
    }

    private void HandleSubmit()
    {
        if (_rating == 0) return;
        _submitted = true;
    }
}
