@* ============================================================
   Block: chat-pinned-messages
   Title: ChatPinnedMessages
   Description: React chat block with pinned messages banner for Next.js featuring collapsible pinned section, pin indicators, and expandable message list using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-pinned-messages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Main chat panel *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Header *@
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <span class="font-medium text-sm">Engineering</span>
                <span class="text-muted-foreground text-xs">Sprint Planning</span>
                <div class="ml-auto flex items-center gap-1">
                    <ButtonCn Variant="@(_sidebarOpen ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                              Size="ButtonSize.Icon"
                              Class="size-7"
                              @onclick="@(() => _sidebarOpen = !_sidebarOpen)">
                        <LucideIconCn Name="pin" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>

            @* Messages *@
            <div class="flex-1 overflow-y-auto py-2">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    var idx = _messages.IndexOf(message);
                    var grouped = idx > 0 && _messages[idx - 1].Sender == message.Sender;
                    <div class="@Cn.Merge("group flex gap-2 px-4 transition-colors hover:bg-accent", grouped ? "py-0.5" : "mt-3 first:mt-0")">
                        @* Avatar column *@
                        <div class="w-8 shrink-0 pt-0.5">
                            @if (!grouped)
                            {
                                <AvatarCn Class="size-8">
                                    <AvatarFallbackCn Class="text-xs font-medium">@message.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                            @if (grouped)
                            {
                                <span class="hidden text-[10px] text-muted-foreground group-hover:inline">@message.Timestamp</span>
                            }
                        </div>

                        @* Body *@
                        <div class="min-w-0 flex-1">
                            @if (!grouped)
                            {
                                <div class="flex items-baseline gap-2">
                                    <span class="font-medium text-sm">@message.Sender</span>
                                    <span class="text-muted-foreground text-xs">@message.Timestamp</span>
                                    @if (message.IsPinned)
                                    {
                                        <LucideIconCn Name="pin" Size="12" Class="size-3 text-amber-500" />
                                    }
                                </div>
                            }
                            <div class="text-sm leading-relaxed">@message.Content</div>
                        </div>
                    </div>
                }
            </div>

            @* Toolbar *@
            <div class="border-t px-4 py-3">
                <form class="relative" @onsubmit="HandleSubmit">
                    <div class="rounded-md border bg-background">
                        <TextareaCn @bind-Value="_input"
                                    Placeholder="Type a message..."
                                    Class="min-h-0 max-h-32 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                        <ButtonCn type="submit"
                                  Size="ButtonSize.Icon"
                                  Variant="ButtonVariant.Ghost"
                                  Disabled="@string.IsNullOrWhiteSpace(_input)"
                                  Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                            <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>
                </form>
            </div>
        </div>

        @* Pinned messages sidebar *@
        @if (_sidebarOpen)
        {
            <div class="flex w-72 shrink-0 flex-col border-l">
                <div class="flex items-center gap-2 border-b px-4 py-3">
                    <LucideIconCn Name="pin" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Pinned</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto h-5 font-normal text-[10px]">
                        @PinnedMessages.Count()
                    </BadgeCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Icon"
                              Class="size-6"
                              @onclick="@(() => _sidebarOpen = false)">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                    </ButtonCn>
                </div>

                <div class="flex-1 overflow-y-auto">
                    @{
                        var pinned = PinnedMessages.ToList();
                    }
                    @if (pinned.Count == 0)
                    {
                        <div class="flex flex-col items-center justify-center px-4 py-12 text-center">
                            <LucideIconCn Name="pin" Size="20" Class="mb-2 size-5 text-muted-foreground/40" />
                            <span class="text-muted-foreground text-xs">No pinned messages</span>
                        </div>
                    }
                    @foreach (var msg in pinned)
                    {
                        var pm = msg;
                        <div class="border-b px-4 py-3">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-medium text-xs">@pm.Sender</span>
                                    @if (!string.IsNullOrEmpty(pm.PinnedDate))
                                    {
                                        <span class="text-muted-foreground text-[10px]">@pm.PinnedDate</span>
                                    }
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Icon"
                                          Class="size-5 shrink-0 text-muted-foreground hover:text-foreground"
                                          @onclick="@(() => Unpin(pm.Id))">
                                    <LucideIconCn Name="pin-off" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                            <p class="mt-1 line-clamp-3 text-muted-foreground text-xs leading-relaxed">@pm.Content</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Initials, string Content, string Timestamp, bool IsPinned = false, string PinnedDate = "");

    private bool _sidebarOpen = true;
    private string _input = "";

    private List<ChatMessage> _messages =
    [
        new("m1",  "Sarah Park",   "SP", "Team standup: We are switching to bi-weekly releases starting next sprint. All PRs must be merged by Thursday EOD.",                                                                            "9:00 AM",  true,  "Mar 25"),
        new("m2",  "Marcus Reed",  "MR", "Staging environment credentials have been rotated. New values are in 1Password under 'Staging Q1 2026'. Please update your local env files.",                                                  "9:15 AM",  true,  "Mar 25"),
        new("m3",  "Li Wei",       "LW", "Design review for the checkout flow is scheduled for Wednesday at 2 PM EST. Figma link: figma.com/file/checkout-v3. Please review before the meeting.",                                        "9:22 AM",  true,  "Mar 26"),
        new("m4",  "Sarah Park",   "SP", "Good morning everyone. Who is picking up the auth token refresh bug? It is blocking QA.",                                                                                                      "9:30 AM"),
        new("m5",  "Marcus Reed",  "MR", "I can take the token refresh issue. Looks like the refresh interval is too aggressive and causing rate limits on the auth server.",                                                            "9:33 AM"),
        new("m6",  "Li Wei",       "LW", "Thanks Marcus. I pushed the updated Figma frames for the mobile checkout. Can someone review the payment step animations?",                                                                    "9:40 AM"),
        new("m7",  "Nina Torres",  "NT", "I will review the Figma frames. Also, the accessibility audit flagged 3 contrast issues on the cart summary. I have tickets created for each.",                                                "9:45 AM"),
        new("m8",  "Sarah Park",   "SP", "Great catch Nina. Let us make sure those contrast fixes go in before the Wednesday review. Marcus, how is the token fix looking?",                                                             "9:52 AM"),
        new("m9",  "Marcus Reed",  "MR", "Found the issue. The retry logic was missing exponential backoff. I have a fix ready, running tests now. Should have a PR up within the hour.",                                               "10:01 AM"),
        new("m10", "Li Wei",       "LW", "Quick heads up: the CDN cache invalidation from last night is still propagating. Some assets might load slowly until noon.",                                                                   "10:08 AM"),
    ];

    private IEnumerable<ChatMessage> PinnedMessages => _messages.Where(m => m.IsPinned);

    private void Unpin(string id)
    {
        var idx = _messages.FindIndex(m => m.Id == id);
        if (idx >= 0)
            _messages[idx] = _messages[idx] with { IsPinned = false };
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
