@* ============================================================
   Block: chat-contract-negotiation
   Title: ChatContractNegotiation
   Description: React contract negotiation chat block for Next.js with clause cards, version comparison, approval buttons, redline indicators, and party-specific message styling using shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-contract-negotiation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="gavel" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_contractTitle</span>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span>@_contractDate</span>
                    <span>·</span>
                    <span>@_clauses.Count clauses under review</span>
                </div>
            </div>
            <div class="flex -space-x-1.5">
                @foreach (var p in _parties.Values)
                {
                    var party = p;
                    <AvatarCn Class="size-6 ring-2 ring-card">
                        <AvatarFallbackCn Class="@Cn.Merge("text-white text-[8px]", party.Color)">
                            @party.Initials
                        </AvatarFallbackCn>
                    </AvatarCn>
                }
            </div>
        </div>

        @* Progress bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground transition-[width] duration-300"
                     style="@($"width:{Progress}%")">
                </div>
            </div>
            <div class="flex items-center gap-3 text-xs">
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums text-muted-foreground">@Accepted</span>
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="tabular-nums text-muted-foreground">@Rejected</span>
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="tabular-nums text-muted-foreground">@Pending</span>
                </span>
            </div>
        </div>

        @* Messages + clause cards *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="flex flex-col gap-3">
                @foreach (var msg in _chatMessages)
                {
                    var message = msg;
                    if (message.Party == "system")
                    {
                        <div class="flex justify-center py-1">
                            <span class="text-muted-foreground text-xs">@message.Content</span>
                        </div>
                    }
                    else
                    {
                        var party = _parties[message.Party];
                        var isBuyer = message.Party == "buyer";
                        var linkedClause = message.ClauseId != null ? GetClause(message.ClauseId) : null;

                        <div class="@Cn.Merge("flex flex-col", isBuyer ? "items-end" : "items-start")">
                            <div class="mb-0.5 flex items-center gap-1.5 px-1">
                                <AvatarCn Class="size-4">
                                    <AvatarFallbackCn Class="@Cn.Merge("text-white text-[6px]", party.Color)">
                                        @party.Initials
                                    </AvatarFallbackCn>
                                </AvatarCn>
                                <span class="font-medium text-xs">@party.Name</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@party.Company</span>
                                <span class="text-muted-foreground text-[10px]">@message.Timestamp</span>
                            </div>
                            <div class="@Cn.Merge("max-w-[85%] rounded-2xl px-3.5 py-2.5 text-sm leading-relaxed", isBuyer ? "rounded-br-sm bg-primary text-primary-foreground" : "rounded-bl-sm bg-muted/50")">
                                @message.Content
                            </div>

                            @* Clause card *@
                            @if (linkedClause != null)
                            {
                                var clause = linkedClause;
                                var statusCfg = _statusBadge[clause.Status];
                                <div class="mt-1.5 w-full max-w-[85%] overflow-hidden rounded-lg border bg-card">
                                    <div class="flex items-center justify-between border-b px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-mono text-muted-foreground text-xs">
                                                Clause @clause.Number
                                            </span>
                                            <span class="font-medium text-sm">@clause.Title</span>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Secondary"
                                                 Class="@Cn.Merge("font-normal text-[10px]", statusCfg.ClassName)">
                                            @statusCfg.Label
                                        </BadgeCn>
                                    </div>
                                    <div class="px-3 py-2.5">
                                        <div class="mb-2">
                                            <span class="mb-0.5 block font-medium text-muted-foreground text-[10px] uppercase tracking-wider">
                                                Original
                                            </span>
                                            <p class="text-muted-foreground text-xs line-through leading-relaxed">
                                                @clause.OriginalText
                                            </p>
                                        </div>
                                        <div>
                                            <span class="mb-0.5 block font-medium text-[10px] uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                                                Proposed
                                            </span>
                                            <p class="text-sm leading-relaxed">@clause.ProposedText</p>
                                        </div>
                                    </div>
                                    @if (clause.Status == "pending")
                                    {
                                        var clauseId = clause.Id;
                                        <div class="flex items-center gap-2 border-t px-3 py-2">
                                            <ButtonCn Variant="ButtonVariant.Outline"
                                                      Size="ButtonSize.Sm"
                                                      Class="h-6 gap-1 px-2 text-xs text-emerald-600 hover:text-emerald-600 dark:text-emerald-400"
                                                      OnClick="@(() => HandleClauseAction(clauseId, "accepted"))">
                                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                Accept
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Outline"
                                                      Size="ButtonSize.Sm"
                                                      Class="h-6 gap-1 px-2 text-xs text-red-600 hover:text-red-600 dark:text-red-400"
                                                      OnClick="@(() => HandleClauseAction(clauseId, "rejected"))">
                                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                                                Reject
                                            </ButtonCn>
                                            <span class="ml-auto text-muted-foreground text-xs">
                                                Proposed by @_parties[clause.ProposedBy].Company
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                <InputCn @bind-Value="_input"
                         Placeholder="Discuss a clause..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record PartyInfo(string Name, string Company, string Initials, string Color);
    private record Clause(string Id, string Number, string Title, string OriginalText, string ProposedText, string ProposedBy, string Status);
    private record Message(string Id, string Party, string SenderName, string Content, string Timestamp, string? ClauseId);
    private record StatusBadgeCfg(string Label, string ClassName);

    private const string _contractTitle = "SaaS License Agreement v3.2";
    private const string _contractDate = "March 2026";

    private string _input = "";

    private static readonly Dictionary<string, PartyInfo> _parties = new()
    {
        ["buyer"] = new PartyInfo("Rachel Torres", "Acme Corp", "RT", "bg-blue-600"),
        ["seller"] = new PartyInfo("James Wright", "Vertex Solutions", "JW", "bg-violet-600"),
    };

    private static readonly Dictionary<string, StatusBadgeCfg> _statusBadge = new()
    {
        ["pending"] = new StatusBadgeCfg("Pending", "text-muted-foreground"),
        ["accepted"] = new StatusBadgeCfg("Accepted", "text-emerald-600 dark:text-emerald-400"),
        ["rejected"] = new StatusBadgeCfg("Rejected", "text-red-600 dark:text-red-400"),
    };

    private static readonly Message[] _chatMessages =
    [
        new("m1", "system", "System", "Contract negotiation started for SaaS License Agreement v3.2", "9:00 AM", null),
        new("m2", "buyer", "Rachel Torres", "James, we've reviewed the draft. We have redlines on four clauses. Starting with payment terms — our standard is net 45 with a grace period.", "9:15 AM", "cl1"),
        new("m3", "seller", "James Wright", "Understood. We can accept the 12-month liability cap in clause 7.1. That's reasonable given the contract value.", "9:22 AM", "cl2"),
        new("m4", "buyer", "Rachel Torres", "Great, thank you. On termination — we need the shorter notice period and pro-rata refund for prepaid annual fees. Non-negotiable on our end.", "9:28 AM", "cl3"),
        new("m5", "seller", "James Wright", "We proposed limiting data processing to US and EU in clause 11.2, but I see you rejected it. Can we discuss?", "9:35 AM", "cl4"),
        new("m6", "buyer", "Rachel Torres", "Our legal team needs broader processing flexibility for our APAC offices. Let's find a middle ground — perhaps an approved regions list?", "9:38 AM", null),
    ];

    private List<Clause> _clauses =
    [
        new Clause("cl1", "4.2", "Payment Terms",
            "Payment is due within 30 days of invoice date. Late payments accrue interest at 1.5% per month.",
            "Payment is due within 45 days of invoice date. Late payments accrue interest at 1.0% per month after a 10-day grace period.",
            "buyer", "pending"),
        new Clause("cl2", "7.1", "Limitation of Liability",
            "Total aggregate liability shall not exceed the fees paid in the preceding 6-month period.",
            "Total aggregate liability shall not exceed the fees paid in the preceding 12-month period.",
            "buyer", "accepted"),
        new Clause("cl3", "9.3", "Termination for Convenience",
            "Either party may terminate with 90 days written notice.",
            "Either party may terminate with 60 days written notice. Seller shall provide pro-rata refund of prepaid fees.",
            "buyer", "pending"),
        new Clause("cl4", "11.2", "Data Processing",
            "Vendor may process customer data in any region where it maintains infrastructure.",
            "Vendor shall process customer data only within the United States and European Union, unless otherwise agreed in writing.",
            "seller", "rejected"),
    ];

    private int Accepted => _clauses.Count(c => c.Status == "accepted");
    private int Rejected => _clauses.Count(c => c.Status == "rejected");
    private int Pending => _clauses.Count(c => c.Status == "pending");
    private int Progress => _clauses.Count > 0 ? (int)Math.Round(((double)(Accepted + Rejected) / _clauses.Count) * 100) : 0;

    private Clause? GetClause(string id) => _clauses.FirstOrDefault(c => c.Id == id);

    private void HandleClauseAction(string clauseId, string action)
    {
        _clauses = _clauses.Select(cl => cl.Id == clauseId ? cl with { Status = action } : cl).ToList();
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
