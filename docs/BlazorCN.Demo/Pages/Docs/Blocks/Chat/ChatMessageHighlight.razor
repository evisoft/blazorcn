@* ============================================================
   Block: chat-message-highlight
   Title: ChatMessageHighlight
   Description: React chat block with text annotation and highlighting for Next.js that lets users select text ranges in messages and add notes, showing highlighted spans with expandable annotation cards using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-message-highlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8 shrink-0">
                <AvatarFallbackCn Class="text-[10px]">LC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Liam Carter</span>
                <p class="text-muted-foreground text-xs">Online</p>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground">
                <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
                <span class="text-xs">@_annotations.Length annotations</span>
            </div>
        </div>

        @* Messages + annotation panel *@
        <div class="flex flex-1 overflow-hidden">
            @* Messages *@
            <div class="flex flex-1 flex-col overflow-y-auto py-2">
                <div class="flex flex-1 flex-col justify-end">
                    @for (int i = 0; i < _allMessages.Length; i++)
                    {
                        var msg = _allMessages[i];
                        var idx = i;
                        var prevMsg = idx > 0 ? _allMessages[idx - 1] : null;
                        var isConsecutive = prevMsg?.Sender == msg.Sender;
                        var msgAnnotations = _annotations.Where(a => a.MessageId == msg.Id).ToArray();
                        var hasAnnotations = msgAnnotations.Length > 0;
                        var rowClass = Cn.Merge("group flex gap-2 px-4 transition-colors hover:bg-accent", isConsecutive ? "pt-0.5" : "pt-3");

                        <div class="@rowClass">
                            @if (!isConsecutive)
                            {
                                <AvatarCn Class="mt-0.5 size-8 shrink-0">
                                    <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                            else
                            {
                                <div class="size-8 shrink-0"></div>
                            }
                            <div class="min-w-0 flex-1">
                                @if (!isConsecutive)
                                {
                                    <div class="flex items-baseline gap-2">
                                        <span class="font-medium text-sm">@msg.Sender</span>
                                        <span class="text-muted-foreground text-xs">@msg.Time</span>
                                    </div>
                                }
                                <p class="text-sm leading-relaxed">
                                    @foreach (var seg in BuildSegments(msg.Content, msgAnnotations))
                                    {
                                        var segment = seg;
                                        @if (segment.AnnotationId != null)
                                        {
                                            var annId = segment.AnnotationId;
                                            var spanClass = Cn.Merge(
                                                "cursor-pointer rounded-sm border-b-2 border-amber-400/60 transition-colors",
                                                _activeAnnotationId == annId
                                                    ? "bg-amber-200/50 dark:bg-amber-500/25"
                                                    : "bg-amber-200/40 dark:bg-amber-500/15 hover:bg-amber-200/60 dark:hover:bg-amber-500/30"
                                            );
                                            <span role="button"
                                                  tabindex="0"
                                                  class="@spanClass"
                                                  @onclick="@(() => ToggleAnnotation(annId))"
                                                  @onkeydown="@((e) => HandleAnnotationKey(e, annId))">@segment.Text</span>
                                        }
                                        else
                                        {
                                            @segment.Text
                                        }
                                    }
                                </p>
                            </div>
                            @if (hasAnnotations)
                            {
                                <div class="flex shrink-0 items-start pt-1">
                                    <span class="flex size-5 items-center justify-center rounded-full bg-amber-100 text-amber-700 text-[10px] dark:bg-amber-900/30 dark:text-amber-400">
                                        @msgAnnotations.Length
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    <div class="h-2"></div>
                </div>
            </div>

            @* Annotation detail panel *@
            @if (_activeAnnotation != null)
            {
                var ann = _activeAnnotation;
                var annotatedMsg = _allMessages.FirstOrDefault(m => m.Id == ann.MessageId);
                var excerpt = annotatedMsg != null ? annotatedMsg.Content.Substring(ann.Start, ann.End - ann.Start) : "";
                <div class="w-64 shrink-0 border-l">
                    <div class="flex items-center justify-between border-b px-3 py-2">
                        <span class="font-medium text-xs">Annotation</span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6" @onclick="@(() => _activeAnnotationId = null)">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                    <div class="p-3">
                        <div class="rounded-md bg-amber-50 p-2 dark:bg-amber-900/20">
                            <p class="font-mono text-xs leading-relaxed text-amber-800 dark:text-amber-300">
                                &ldquo;@excerpt&rdquo;
                            </p>
                        </div>
                        <div class="mt-3 flex items-start gap-2">
                            <AvatarCn Class="mt-0.5 size-6 shrink-0">
                                <AvatarFallbackCn Class="text-[8px]">@ann.AuthorInitials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0">
                                <div class="flex items-baseline gap-1.5">
                                    <span class="font-medium text-xs">@ann.Author</span>
                                    <span class="text-muted-foreground text-[10px]">@ann.Time</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@ann.Note</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <div class="flex flex-1 items-center rounded-md border bg-muted/50">
                    <InputCn @bind-Value="_input"
                             Placeholder="Type a message..."
                             Class="h-9 flex-1 border-0 bg-transparent text-sm shadow-none focus-visible:ring-0" />
                    <ButtonCn type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="mr-1 size-7 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Initials, string Content, string Time, bool IsMe);

    private record Annotation(string Id, string MessageId, int Start, int End, string Note, string Author, string AuthorInitials, string Time);

    private record TextSegment(string Text, string? AnnotationId);

    private static readonly ChatMessage[] _allMessages =
    [
        new("1", "Liam Carter", "LC", "I finished migrating the database to the new cluster last night.", "11:02 AM", false),
        new("2", "You", "YO", "How did the migration go? Any data loss?", "11:03 AM", true),
        new("3", "Liam Carter", "LC", "Zero data loss. The migration script handled all 2.4 million rows cleanly. Took about 40 minutes with the batch inserts.", "11:04 AM", false),
        new("4", "You", "YO", "That's great. Did you run the validation queries against the new database?", "11:05 AM", true),
        new("5", "Liam Carter", "LC", "Yes, all checksums match. I also ran the migration rollback test to make sure we can revert if needed.", "11:07 AM", false),
        new("6", "You", "YO", "Smart. What about the connection pooling on the new database?", "11:08 AM", true),
        new("7", "Liam Carter", "LC", "PgBouncer is configured with a max of 200 connections. The database handles it well under load testing.", "11:10 AM", false),
        new("8", "You", "YO", "Nice. Let's schedule the production migration for this weekend. Can you draft the runbook?", "11:12 AM", true),
        new("9", "Liam Carter", "LC", "Already started. I'll include the migration steps, rollback procedure, and monitoring checklist.", "11:13 AM", false),
        new("10", "You", "YO", "Perfect. Share it in the #database channel when it's ready for review.", "11:14 AM", true),
    ];

    private static readonly Annotation[] _annotations =
    [
        new("a1", "3", 0, 14, "Impressive — should we document this for future migrations?", "You", "YO", "11:06 AM"),
        new("a2", "5", 25, 55, "Make sure the rollback was tested on staging too, not just local.", "You", "YO", "11:09 AM"),
        new("a3", "7", 0, 9, "We should switch to PgCat eventually — better multi-tenant support.", "Liam Carter", "LC", "11:11 AM"),
    ];

    private string _input = "";
    private string? _activeAnnotationId = null;

    private Annotation? _activeAnnotation => _activeAnnotationId != null
        ? _annotations.FirstOrDefault(a => a.Id == _activeAnnotationId)
        : null;

    private void ToggleAnnotation(string id)
    {
        _activeAnnotationId = _activeAnnotationId == id ? null : id;
    }

    private void HandleAnnotationKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ")
            ToggleAnnotation(id);
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private static TextSegment[] BuildSegments(string content, Annotation[] annotations)
    {
        if (annotations.Length == 0)
            return [new TextSegment(content, null)];

        var sorted = annotations.OrderBy(a => a.Start).ToArray();
        var segments = new System.Collections.Generic.List<TextSegment>();
        int cursor = 0;

        foreach (var ann in sorted)
        {
            if (ann.Start > cursor)
                segments.Add(new TextSegment(content.Substring(cursor, ann.Start - cursor), null));
            var endIdx = Math.Min(ann.End, content.Length);
            segments.Add(new TextSegment(content.Substring(ann.Start, endIdx - ann.Start), ann.Id));
            cursor = endIdx;
        }

        if (cursor < content.Length)
            segments.Add(new TextSegment(content.Substring(cursor), null));

        return segments.ToArray();
    }
}
