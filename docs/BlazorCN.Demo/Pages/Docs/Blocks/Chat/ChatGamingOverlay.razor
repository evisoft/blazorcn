@* ============================================================
   Block: chat-gaming-overlay
   Title: ChatGamingOverlay
   Description: React in-game chat overlay block for Next.js with semi-transparent dark background, colored usernames, fade-out on older messages, and compact input using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-gaming-overlay.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border border-white/10 bg-zinc-950/90">
        @* Header *@
        <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium text-white/80 text-xs">TEAM CHAT</span>
            <span class="text-white/30 text-xs">·</span>
            <span class="text-white/30 text-xs">5 online</span>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="font-mono text-white/20 text-[10px]">ROUND 14</span>
                <span class="text-white/20 text-[10px]">·</span>
                <span class="font-mono text-white/20 text-[10px]">de_dust2</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col justify-end overflow-y-auto px-4 py-2">
            <div class="flex flex-col gap-0.5">
                @foreach (var msg in _messages)
                {
                    var idx = Array.IndexOf(_messages, msg);
                    var fadeOpacity = Math.Max(0.25, (double)(idx + 1) / _messages.Length);
                    <div class="flex items-baseline gap-1.5 py-0.5" style="@($"opacity:{fadeOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}")">
                        <span class="shrink-0 font-mono text-white/20 text-[10px]">@msg.Timestamp</span>
                        @if (msg.Type == "system")
                        {
                            <span class="text-white/40 text-xs italic">@msg.Content</span>
                        }
                        else
                        {
                            <span class="@Cn.Merge("shrink-0 font-medium text-xs", msg.Player.Color)">@msg.Player.Name</span>
                            <span class="text-white/70 text-xs">@msg.Content</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t border-white/10 px-4 py-2">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <span class="shrink-0 text-white/30 text-xs">Say:</span>
                <InputCn @bind-Value="_input"
                         Placeholder="Press Enter to send..."
                         Class="h-7 flex-1 border-0 bg-transparent text-white/80 text-xs shadow-none placeholder:text-white/20 focus-visible:ring-0" />
                <ButtonCn Type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))"
                          Class="size-7 shrink-0 text-white/30 hover:bg-white/10 hover:text-white/60">
                    <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Player(string Name, string Color);
    private record Message(string Id, Player Player, string Content, string Timestamp, string Type);

    private static readonly Message[] _messages =
    [
        new("1",  new("xNova",       "text-cyan-400"),           "anyone pushing B site?",                              "12:41", "chat"),
        new("2",  new("SYSTEM",      "text-muted-foreground"),   "Round 14 starting in 5 seconds",                     "12:41", "system"),
        new("3",  new("fr0stbyte",   "text-rose-400"),           "i'll smoke mid, you flash in",                       "12:41", "chat"),
        new("4",  new("ShadowKnight","text-amber-400"),          "holding long with AWP",                              "12:42", "chat"),
        new("5",  new("xNova",       "text-cyan-400"),           "nice, lets do a split push",                         "12:42", "chat"),
        new("6",  new("SYSTEM",      "text-muted-foreground"),   "fr0stbyte eliminated ShadowKnight with headshot",    "12:43", "system"),
        new("7",  new("pxlDemon",    "text-emerald-400"),        "3 on A, rotating now",                               "12:43", "chat"),
        new("8",  new("fr0stbyte",   "text-rose-400"),           "bomb down B, cover me",                              "12:43", "chat"),
        new("9",  new("ShadowKnight","text-amber-400"),          "gg nice clutch frost",                               "12:44", "chat"),
        new("10", new("voidWalker",  "text-violet-400"),         "eco next round, save up",                            "12:44", "chat"),
        new("11", new("xNova",       "text-cyan-400"),           "agreed, stack B on defense",                         "12:44", "chat"),
        new("12", new("pxlDemon",    "text-emerald-400"),        "i got utility for retake if they push A",            "12:45", "chat"),
    ];

    private string _input = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
