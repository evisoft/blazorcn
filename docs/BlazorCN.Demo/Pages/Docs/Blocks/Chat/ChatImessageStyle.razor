@* ============================================================
   Block: chat-imessage-style
   Title: ChatImessageStyle
   Description: React iMessage-inspired chat interface for Next.js with blue sent bubbles, gray received bubbles, tail effects, delivery status, and typing indicator using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-imessage-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Centered header with avatar *@
        <div class="flex flex-col items-center gap-0.5 border-b px-4 py-3">
            <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                <span class="font-semibold text-muted-foreground text-sm">S</span>
            </div>
            <span class="font-medium text-sm">Sarah</span>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col gap-0.5 overflow-y-auto px-4 py-4">
            @for (int i = 0; i < _processed.Length; i++)
            {
                var msg = _processed[i];
                var idx = i;
                var isMe = msg.Sender == "me";
                var prev = idx > 0 ? _processed[idx - 1] : null;
                var showGap = prev != null && prev.Sender != msg.Sender;
                var isLast = msg.IsLastInGroup;
                var isLastOverall = idx == _processed.Length - 1;

                var outerClass = Cn.Merge(
                    "flex flex-col",
                    isMe ? "items-end" : "items-start",
                    showGap ? "mt-3" : ""
                );

                var bubbleClass = Cn.Merge(
                    "max-w-[75%] px-3 py-2 text-sm leading-relaxed",
                    isMe
                        ? (isLast ? "bg-blue-500 text-white rounded-2xl rounded-br-sm" : "bg-blue-500 text-white rounded-2xl")
                        : (isLast ? "bg-muted text-foreground rounded-2xl rounded-bl-sm" : "bg-muted text-foreground rounded-2xl")
                );

                <div>
                    <div class="@outerClass">
                        @* Bubble with tail on last message in group *@
                        <div class="@bubbleClass">
                            @msg.Content
                        </div>

                        @* Timestamp on last message of group *@
                        @if (isLast)
                        {
                            <span class="mt-0.5 px-1 text-[10px] text-muted-foreground">
                                @msg.Timestamp
                            </span>
                        }

                        @* Delivered label on last sent message *@
                        @if (isMe && isLastOverall)
                        {
                            <span class="mt-0.5 px-1 font-medium text-[10px] text-muted-foreground">
                                Delivered
                            </span>
                        }
                    </div>
                </div>
            }

            @* Typing indicator (3 bouncing dots in a bubble) *@
            <div class="mt-3">
                <div class="flex items-end gap-2">
                    <div class="rounded-2xl rounded-bl-sm bg-muted px-4 py-2.5">
                        <div class="flex items-center gap-1">
                            <span class="size-1.5 animate-bounce rounded-full bg-muted-foreground/60 [animation-delay:0ms]"></span>
                            <span class="size-1.5 animate-bounce rounded-full bg-muted-foreground/60 [animation-delay:150ms]"></span>
                            <span class="size-1.5 animate-bounce rounded-full bg-muted-foreground/60 [animation-delay:300ms]"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="camera" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="iMessage"
                         Class="h-9 flex-1 rounded-full border-0 bg-muted/50 px-4 shadow-none focus-visible:ring-0" />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-blue-500 hover:text-blue-600 disabled:text-muted-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Content, string Sender, string Timestamp, bool IsLastInGroup = false);

    private string _input = "";

    private static readonly Message[] _initialMessages =
    [
        new("1", "Hey! Are you coming to the launch event tonight?", "them", "3:42 PM"),
        new("2", "Wouldn't miss it. What time does it start?", "me", "3:43 PM"),
        new("3", "Doors open at 7, keynote at 8", "them", "3:43 PM"),
        new("4", "The demo stations will be set up in the main hall", "them", "3:43 PM"),
        new("5", "There's a VIP section too if you want early access", "them", "3:44 PM"),
        new("6", "VIP sounds great. Do I need a separate pass?", "me", "3:45 PM"),
        new("7", "Nope, I already added you to the list", "them", "3:45 PM"),
        new("8", "You're the best. See you at 7!", "me", "3:46 PM"),
        new("9", "Can you bring your laptop? We might need to debug something on stage", "them", "3:47 PM"),
        new("10", "Sure thing. I'll have the staging environment pulled up and ready", "me", "3:48 PM"),
    ];

    private static readonly Message[] _processed = ProcessMessages(_initialMessages);

    private static Message[] ProcessMessages(Message[] msgs)
    {
        var result = new Message[msgs.Length];
        for (int i = 0; i < msgs.Length; i++)
        {
            var msg = msgs[i];
            var next = i + 1 < msgs.Length ? msgs[i + 1] : null;
            var isLastInGroup = next == null || next.Sender != msg.Sender;
            result[i] = msg with { IsLastInGroup = isLastInGroup };
        }
        return result;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
