@* ============================================================
   Block: chat-diy-project
   Title: ChatDiyProject
   Description: A DIY project planning chat interface with step-by-step instruction cards, tool lists, material requirements, difficulty ratings, and time estimates built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/chat/chat-diy-project.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <AvatarCn Class="size-8">
                    <AvatarImageCn Src="" Alt="" />
                    <AvatarFallbackCn Class="bg-orange-500/10 text-orange-600 text-xs">
                        DIY
                    </AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">DIY Project Assistant</h2>
                    <p class="text-muted-foreground text-xs">Step-by-step project guidance</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 py-4">
                @foreach (var message in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="" Alt="" />
                            <AvatarFallbackCn Class="@Cn.Merge("text-xs", message.Type == "assistant" ? "bg-orange-500/10 text-orange-600" : "bg-muted")">
                                @(message.Type == "assistant" ? "DIY" : "You")
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", message.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @message.Content
                            </div>
                            <span class="text-muted-foreground text-xs">@message.Timestamp</span>

                            @* Project Info *@
                            @if (message.ProjectInfo != null)
                            {
                                var info = message.ProjectInfo;
                                <div class="mt-3 overflow-hidden rounded-lg border bg-card">
                                    <div class="space-y-3 p-3">
                                        <div class="flex items-start justify-between gap-3">
                                            <div>
                                                <h3 class="font-medium text-sm">@info.Name</h3>
                                                <div class="mt-1.5 flex items-center gap-2">
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs capitalize", GetDifficultyColor(info.Difficulty))">
                                                        @info.Difficulty
                                                    </BadgeCn>
                                                    <div class="flex items-center gap-1 text-muted-foreground text-xs">
                                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                        <span>@info.TotalTime</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="space-y-2">
                                            <div>
                                                <div class="mb-1.5 flex items-center gap-1.5">
                                                    <LucideIconCn Name="wrench" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="font-medium text-xs">Required Tools</span>
                                                </div>
                                                <div class="flex flex-wrap gap-1.5">
                                                    @foreach (var tool in info.Tools)
                                                    {
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@tool</BadgeCn>
                                                    }
                                                </div>
                                            </div>

                                            <div>
                                                <div class="mb-1.5 flex items-center gap-1.5">
                                                    <LucideIconCn Name="hammer" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="font-medium text-xs">Materials Needed</span>
                                                </div>
                                                <div class="flex flex-wrap gap-1.5">
                                                    @foreach (var material in info.Materials)
                                                    {
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@material</BadgeCn>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Project Steps *@
                            @if (message.Steps != null && message.Steps.Length > 0)
                            {
                                <div class="mt-3 space-y-2">
                                    @foreach (var step in message.Steps)
                                    {
                                        <div class="overflow-hidden rounded-lg border bg-card">
                                            <div class="space-y-2 p-3">
                                                <div class="flex items-start gap-3">
                                                    <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-md text-xs font-medium", step.Completed ? "bg-emerald-500/10 text-emerald-600" : "bg-muted text-muted-foreground")">
                                                        @if (step.Completed)
                                                        {
                                                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                                                        }
                                                        else
                                                        {
                                                            @step.Number
                                                        }
                                                    </div>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="flex items-baseline gap-2">
                                                            <h4 class="font-medium text-sm">@step.Title</h4>
                                                            <span class="text-muted-foreground text-xs">@step.Duration</span>
                                                        </div>
                                                        <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@step.Description</p>
                                                        @if (!string.IsNullOrEmpty(step.Warning))
                                                        {
                                                            <div class="mt-2 flex items-start gap-2 rounded-md bg-amber-500/10 px-2 py-1.5">
                                                                <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 shrink-0 text-amber-600" />
                                                                <span class="text-amber-600 text-xs">@step.Warning</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault class="border-t bg-muted/50 p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about your project..." Class="flex-1" aria-label="Ask about your project..." />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>

    </div>
</section>

@code {
    private string _input = "";

    private static string GetDifficultyColor(string difficulty) => difficulty switch
    {
        "beginner" => "bg-emerald-500/10 text-emerald-600",
        "intermediate" => "bg-amber-500/10 text-amber-600",
        "advanced" => "bg-red-500/10 text-red-600",
        _ => "bg-muted",
    };

    private record ProjectStep(
        string Id,
        int Number,
        string Title,
        string Description,
        string Duration,
        bool Completed = false,
        string? Warning = null);

    private record ProjectInfo(
        string Name,
        string Difficulty,
        string TotalTime,
        string[] Tools,
        string[] Materials);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        ProjectInfo? ProjectInfo = null,
        ProjectStep[]? Steps = null);

    private Message[] _messages =
    [
        new("1", "assistant",
            "Welcome to your DIY project assistant! I'll guide you through home improvement projects step by step. What would you like to build today?",
            "10:15 AM"),
        new("2", "user",
            "I want to build a floating shelf for my living room",
            "10:16 AM"),
        new("3", "assistant",
            "Great choice! Here's your floating shelf project plan:",
            "10:16 AM",
            ProjectInfo: new(
                "Modern Floating Shelf",
                "intermediate",
                "3-4 hours",
                ["Drill with bits", "Level", "Stud finder", "Measuring tape", "Pencil", "Safety glasses"],
                ["Wood board (48\" x 10\" x 2\")", "Floating shelf brackets (2)", "Wood screws (12)", "Wall anchors (4)", "Wood stain", "Polyurethane finish"]
            ),
            Steps:
            [
                new("s1", 1, "Locate wall studs",
                    "Use a stud finder to locate studs where you want to mount the shelf. Mark the stud locations with a pencil. Ensure they're level and spaced correctly for your brackets.",
                    "15 min", Completed: true),
                new("s2", 2, "Mark bracket positions",
                    "Hold the first bracket against the wall at your desired height. Use a level to ensure it's straight. Mark the screw hole positions with a pencil.",
                    "10 min", Completed: true),
                new("s3", 3, "Drill pilot holes",
                    "Drill pilot holes at the marked positions. If mounting into studs, use a bit slightly smaller than your screws. For drywall anchors, follow the anchor size specifications.",
                    "15 min", Warning: "Wear safety glasses when drilling"),
                new("s4", 4, "Install brackets",
                    "Secure the floating shelf brackets to the wall using appropriate screws or wall anchors. Ensure they're firmly attached and level with each other.",
                    "20 min"),
                new("s5", 5, "Prepare wood surface",
                    "Sand the wood board smooth with 120-grit sandpaper. Wipe clean with a damp cloth and let dry completely before staining.",
                    "30 min"),
                new("s6", 6, "Apply finish",
                    "Apply wood stain following manufacturer directions. Let dry completely, then apply 2-3 coats of polyurethane, sanding lightly between coats.",
                    "2 hours (including dry time)"),
                new("s7", 7, "Mount shelf",
                    "Once the finish is completely dry, slide the shelf onto the mounted brackets. Ensure it sits flush against the wall and is secure.",
                    "10 min"),
            ]),
        new("4", "user",
            "What if I don't have a stud finder?",
            "10:18 AM"),
        new("5", "assistant",
            "No problem! You can find studs by tapping the wall and listening for a solid sound instead of hollow. Studs are typically spaced 16 inches apart. Alternatively, use heavy-duty drywall anchors rated for the shelf weight plus items you'll place on it.",
            "10:18 AM"),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var newMessage = new Message(
            $"diy-project-msg-{_messages.Length + 1}",
            "user",
            _input.Trim(),
            "Just now");
        _messages = [.._messages, newMessage];
        _input = "";
    }
}
