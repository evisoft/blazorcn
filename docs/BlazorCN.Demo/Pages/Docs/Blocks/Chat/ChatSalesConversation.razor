@* ============================================================
   Block: chat-sales-conversation
   Title: ChatSalesConversation
   Description: React sales conversation chat block for Next.js with agent photo, product card messages, quick reply chips, and CRM-style layout using shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-sales-conversation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Chat area *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="relative">
                    <AvatarCn Class="size-8">
                        <AvatarFallbackCn Class="text-xs">@_agentInitials</AvatarFallbackCn>
                    </AvatarCn>
                    <span class="absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full bg-emerald-500 ring-2 ring-card"></span>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@_agentName</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                            Sales
                        </BadgeCn>
                    </div>
                    <span class="text-muted-foreground text-xs">
                        Typically replies in under 5 min
                    </span>
                </div>
            </div>

            @* Messages — flat layout with grouping *@
            <div class="flex flex-1 flex-col overflow-y-auto">
                @for (var idx = 0; idx < _initialMessages.Length; idx++)
                {
                    var msg = _initialMessages[idx];
                    var isAgent = msg.Role == "agent";
                    var prevMsg = idx > 0 ? _initialMessages[idx - 1] : null;
                    var showHeader = prevMsg == null || prevMsg.Role != msg.Role;

                    <div>
                        <div class="@Cn.Merge("group flex gap-2 px-4 transition-colors hover:bg-accent", showHeader ? "pt-2.5 pb-0.5" : "py-0.5")">
                            @* Avatar column *@
                            <div class="w-10 shrink-0">
                                @if (showHeader)
                                {
                                    <AvatarCn Class="size-8">
                                        <AvatarFallbackCn Class="text-[10px]">
                                            @(isAgent ? _agentInitials : "YO")
                                        </AvatarFallbackCn>
                                    </AvatarCn>
                                }
                            </div>
                            @* Body *@
                            <div class="min-w-0 flex-1">
                                @if (showHeader)
                                {
                                    <div class="flex items-baseline gap-2">
                                        <span class="font-medium text-sm">@(isAgent ? _agentName : "You")</span>
                                        <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                                    </div>
                                }
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                                @if (!showHeader)
                                {
                                    <span class="hidden text-muted-foreground text-[10px] group-hover:inline">
                                        @msg.Timestamp
                                    </span>
                                }
                            </div>
                        </div>
                        @* Product card embedded in message *@
                        @if (msg.ProductCard != null)
                        {
                            var card = msg.ProductCard;
                            <div class="py-1 pr-4 pl-14">
                                <div class="overflow-hidden rounded-lg border">
                                    <div class="flex h-20 items-center justify-center bg-muted/30">
                                        <span class="text-muted-foreground text-xs">Product Preview</span>
                                    </div>
                                    <div class="px-3.5 py-3">
                                        <div class="flex items-baseline justify-between">
                                            <span class="font-medium text-sm">@card.Name</span>
                                            <span class="font-semibold text-sm tabular-nums">@card.Price</span>
                                        </div>
                                        <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                            @card.Description
                                        </p>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 gap-1.5 text-xs">
                                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                            View details
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Toolbar *@
            <div class="border-t px-4 py-3">
                <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                    <InputCn @bind-Value="_input"
                             Placeholder="Type a message..."
                             Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                    <ButtonCn type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                </form>
            </div>
        </div>

        @* Right panel — CRM Sidebar *@
        <div class="flex w-72 shrink-0 flex-col border-l">
            @* Deal stage header *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-sm">Deal Progress</span>
            </div>

            @* Stage stepper *@
            <div class="border-b px-4 py-3">
                <div class="flex flex-col gap-2">
                    @foreach (var stg in _dealStages)
                    {
                        var stage = stg;
                        <div class="flex items-center gap-2.5">
                            @if (stage.Done)
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                            }
                            else if (stage.Active)
                            {
                                <LucideIconCn Name="circle-dot" Size="16" Class="size-4 shrink-0 text-blue-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle" Size="16" Class="size-4 shrink-0 text-muted-foreground/30" />
                            }
                            <span class="@Cn.Merge("text-xs", stage.Done ? "text-muted-foreground line-through" : "", stage.Active ? "font-medium text-foreground" : "", !stage.Done && !stage.Active ? "text-muted-foreground" : "")">
                                @stage.Label
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* Deal value *@
            <div class="border-b px-4 py-3">
                <span class="text-muted-foreground text-xs">Deal value</span>
                <p class="mt-0.5 font-semibold text-2xl tabular-nums">@_contactInfo.DealValue</p>
            </div>

            @* Contact info *@
            <div class="border-b px-4 py-3">
                <span class="mb-2 block text-muted-foreground text-xs">Contact</span>
                <div class="flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="building" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-sm">@_contactInfo.Company</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-sm">@_contactInfo.Name</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-mono text-xs text-muted-foreground">@_contactInfo.Email</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="phone" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-mono text-xs text-muted-foreground">@_contactInfo.Phone</span>
                    </div>
                </div>
            </div>

            @* Schedule demo CTA *@
            <div class="mt-auto border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 w-full gap-2 text-xs">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                    Schedule demo
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ProductCard(string Name, string Price, string Description);
    private record Message(string Id, string Role, string Content, string Timestamp, ProductCard? ProductCard = null);
    private record DealStage(string Id, string Label, bool Done, bool Active = false);
    private record ContactInfo(string Company, string Name, string Email, string Phone, string DealValue);

    private const string _agentName = "David Park";
    private const string _agentInitials = "DP";

    private string _input = "";

    private static readonly DealStage[] _dealStages =
    [
        new("lead", "Lead", Done: true),
        new("qualified", "Qualified", Done: true),
        new("proposal", "Proposal", Done: false, Active: true),
        new("closed", "Closed", Done: false),
    ];

    private static readonly ContactInfo _contactInfo = new(
        Company: "Meridian Technologies",
        Name: "Rachel Torres",
        Email: "rachel@meridian.io",
        Phone: "+1 (415) 555-0187",
        DealValue: "$23,400/yr"
    );

    private static readonly Message[] _initialMessages =
    [
        new("1", "agent",
            "Welcome! I'm David from the sales team. I noticed you've been exploring our enterprise plan. Can I help answer any questions?",
            "2:15 PM"),
        new("2", "customer",
            "Hi David, yes — we're evaluating tools for our 50-person engineering team. What's included in the enterprise tier?",
            "2:16 PM"),
        new("3", "agent",
            "Great timing. The enterprise plan includes SSO, audit logs, dedicated support, and custom integrations. Let me share our most popular package for teams your size:",
            "2:17 PM",
            new ProductCard(
                "Enterprise Suite",
                "$49/seat/month",
                "SSO, audit logs, 99.99% SLA, dedicated CSM, custom integrations, priority support"
            )),
        new("4", "customer",
            "That looks solid. Do you offer annual billing discounts?",
            "2:19 PM"),
        new("5", "agent",
            "Absolutely. Annual billing saves 20%, bringing it to $39/seat/month. For a 50-seat team, that's $23,400/year instead of $29,400. I can also put together a custom proposal if you need specific features.",
            "2:20 PM"),
        new("6", "customer",
            "The annual pricing works. Can we set up a demo with our CTO this week?",
            "2:22 PM"),
        new("7", "agent",
            "Of course! I have availability Thursday at 2 PM or Friday at 10 AM ET. Which works better? I'll send a calendar invite with a personalized demo agenda.",
            "2:23 PM"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
