@* ============================================================
   Block: chat-photo-editor
   Title: ChatPhotoEditor
   Description: An AI-powered photo editing chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring filter previews, crop suggestions, and before/after comparisons
   Source: original/blocks/chat/chat-photo-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="image" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Photo Editor</h2>
                    <p class="text-xs text-muted-foreground">AI-powered editing assistant</p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2">
                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                <span class="text-xs">Export</span>
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            @foreach (var msg in _messages)
            {
                var isUser = msg.Type == "user";
                <div class="@Cn.Merge("flex", isUser ? "justify-end" : "justify-start")">
                    <div class="@Cn.Merge("max-w-[85%] space-y-2", isUser ? "items-end" : "items-start")">
                        <div class="@Cn.Merge("rounded-lg px-3 py-2", isUser ? "bg-foreground text-background" : "bg-muted")">
                            <p class="text-sm">@msg.Content</p>
                        </div>

                        @if (msg.Filters != null)
                        {
                            <div class="w-full space-y-2 rounded-lg border bg-card p-3">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-xs font-medium">Suggested Filters</span>
                                </div>
                                <div class="grid grid-cols-4 gap-2">
                                    @foreach (var filter in msg.Filters)
                                    {
                                        var f = filter;
                                        <button type="button" class="group flex flex-col items-center gap-1.5 rounded-md p-2 transition-colors hover:bg-muted/50">
                                            <div class="size-12 rounded-md border" style="@($"background-color:{f.Preview}")"></div>
                                            <span class="text-xs text-muted-foreground group-hover:text-foreground">@f.Name</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (msg.BeforeAfter != null)
                        {
                            var ba = msg.BeforeAfter;
                            <div class="w-full space-y-2 rounded-lg border bg-card p-3">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="maximize-2" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="text-xs font-medium">Before &amp; After</span>
                                    </div>
                                    <div class="flex items-center gap-1 rounded-md bg-muted p-0.5">
                                        <button type="button"
                                                class="@Cn.Merge("rounded-sm px-2 py-1 text-xs transition-colors", _selectedComparison == "before" ? "bg-background text-foreground" : "text-muted-foreground hover:text-foreground")"
                                                @onclick="@(() => _selectedComparison = "before")">
                                            Before
                                        </button>
                                        <button type="button"
                                                class="@Cn.Merge("rounded-sm px-2 py-1 text-xs transition-colors", _selectedComparison == "after" ? "bg-background text-foreground" : "text-muted-foreground hover:text-foreground")"
                                                @onclick="@(() => _selectedComparison = "after")">
                                            After
                                        </button>
                                    </div>
                                </div>
                                <div class="relative aspect-video overflow-hidden rounded-md border bg-muted">
                                    <div class="flex h-full items-center justify-center">
                                        <LucideIconCn Name="image" Size="32" Class="size-8 text-muted-foreground/20" />
                                    </div>
                                    <div class="absolute bottom-2 left-2 rounded-md bg-background/90 px-2 py-1 backdrop-blur-sm">
                                        <span class="text-xs font-medium">
                                            @(_selectedComparison == "before" ? ba.Before : ba.After)
                                        </span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1.5 text-xs">
                                        <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                                        Reset
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1.5 text-xs">
                                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                                        Save
                                    </ButtonCn>
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-3">
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0">
                    <LucideIconCn Name="image" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="Describe your edits..."
                         Class="border-0 bg-transparent shadow-none focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0" Disabled="@(string.IsNullOrWhiteSpace(_input))" @onclick="HandleSend">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record FilterOption(string Name, string Preview);
    private record BeforeAfterOption(string Before, string After);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        FilterOption[]? Filters = null,
        BeforeAfterOption? BeforeAfter = null);

    private static readonly Message[] _sampleMessages =
    [
        new("1", "assistant",
            "Hi! I'm your photo editing assistant. Upload an image or describe the edits you'd like to make.",
            "2:15 PM"),
        new("2", "user",
            "I want to enhance this landscape photo and make it more vibrant",
            "2:16 PM"),
        new("3", "assistant",
            "I've analyzed your landscape photo. Here are some filter suggestions that will enhance the vibrancy while maintaining natural tones:",
            "2:16 PM",
            Filters:
            [
                new("Vivid", "#10b981"),
                new("Warm Glow", "#f59e0b"),
                new("Enhanced", "#3b82f6"),
                new("Natural+", "#22c55e"),
            ]),
        new("4", "user",
            "Apply the Vivid filter",
            "2:17 PM"),
        new("5", "assistant",
            "Great choice! I've applied the Vivid filter. Here's a before and after comparison. The colors are now more saturated while preserving detail.",
            "2:17 PM",
            BeforeAfter: new("Original", "Vivid Applied")),
    ];

    private List<Message> _messages = [.._sampleMessages];
    private string _input = "";
    private string _selectedComparison = "after";

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var userMessage = new Message(
            Id: DateTime.Now.Ticks.ToString(),
            Type: "user",
            Content: _input,
            Timestamp: "Just now");
        _messages = [.._messages, userMessage];
        _input = "";
    }
}
