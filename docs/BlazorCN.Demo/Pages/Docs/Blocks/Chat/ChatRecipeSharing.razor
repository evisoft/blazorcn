@* ============================================================
   Block: chat-recipe-sharing
   Title: ChatRecipeSharing
   Description: React recipe sharing chat interface for Next.js with ingredient cards, step-by-step instructions, serving size badges, and cook time indicators using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-recipe-sharing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="chef-hat" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Recipe Exchange</span>
                <p class="text-muted-foreground text-xs">Maria Chen</p>
            </div>
            <span class="text-muted-foreground text-xs">2 recipes shared</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-3">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    var msgIndex = _messages.IndexOf(message);
                    var isMe = message.Sender == "me";
                    var showHeader = IsFirstInGroup(_messages, msgIndex);

                    <div class="@Cn.Merge("flex flex-col", isMe ? "items-end" : "items-start")">
                        @if (showHeader)
                        {
                            <div class="mb-0.5 flex items-center gap-1.5 px-1">
                                <span class="font-medium text-xs">@message.SenderName</span>
                                <span class="text-muted-foreground text-[10px]">@message.Timestamp</span>
                            </div>
                        }
                        @if (message.Type == "text" && message.Content != null)
                        {
                            <div class="@Cn.Merge("max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed", isMe ? "bg-foreground text-background" : "bg-muted text-foreground")">
                                @message.Content
                            </div>
                        }
                        @if (message.Type == "recipe" && message.Recipe != null)
                        {
                            var recipe = message.Recipe;
                            var recipeId = message.Id;
                            var isExpanded = _expanded.Contains(recipeId);

                            <div class="mt-1.5 w-full max-w-sm overflow-hidden rounded-md border">
                                <div class="flex items-center gap-2 border-b px-3 py-2">
                                    <LucideIconCn Name="utensils" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="font-medium text-sm">Recipe</span>
                                </div>

                                <div class="px-3 py-2.5">
                                    <p class="font-medium text-sm">@recipe.Name</p>
                                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            @recipe.CookTime
                                        </span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                                            @recipe.Servings servings
                                        </span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-[10px]", GetDifficultyColor(recipe.Difficulty))">
                                            @recipe.Difficulty
                                        </BadgeCn>
                                    </div>
                                </div>

                                @* Ingredients *@
                                <div class="border-t px-3 py-2.5">
                                    <span class="font-medium text-muted-foreground text-xs">Ingredients</span>
                                    <div class="mt-1.5 flex flex-col gap-1">
                                        @foreach (var ing in recipe.Ingredients)
                                        {
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm">@ing.Name</span>
                                                <span class="font-mono text-muted-foreground text-xs">@ing.Amount</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* Steps toggle *@
                                <div class="border-t">
                                    <button type="button" @onclick="@(() => ToggleExpanded(recipeId))" class="flex w-full items-center gap-2 px-3 py-2 text-left transition-colors hover:bg-muted/50">
                                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                        <span class="font-medium text-muted-foreground text-xs">@recipe.Steps.Length steps</span>
                                    </button>
                                    @if (isExpanded)
                                    {
                                        <div class="flex flex-col gap-2 px-3 pb-3">
                                            @for (int i = 0; i < recipe.Steps.Length; i++)
                                            {
                                                var stepIndex = i;
                                                var step = recipe.Steps[stepIndex];
                                                <div class="flex gap-2">
                                                    <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                                        @(stepIndex + 1)
                                                    </span>
                                                    <p class="text-sm leading-relaxed">@step</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Utensils">
                    <LucideIconCn Name="utensils" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input" Placeholder="Type a message..." Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                <ButtonCn Type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Disabled="@(string.IsNullOrWhiteSpace(_input))" Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private HashSet<string> _expanded = [];

    private record Ingredient(string Name, string Amount);

    private record Recipe(
        string Name,
        string CookTime,
        int Servings,
        string Difficulty,
        Ingredient[] Ingredients,
        string[] Steps);

    private record ChatMessage(
        string Id,
        string Type,
        string Sender,
        string SenderName,
        string Initials,
        string Timestamp,
        string? Content = null,
        Recipe? Recipe = null);

    private static readonly Dictionary<string, string> _difficultyColors = new()
    {
        ["Easy"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["Medium"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["Hard"] = "bg-red-500/10 text-red-600 dark:text-red-400",
    };

    private string GetDifficultyColor(string difficulty) =>
        _difficultyColors.TryGetValue(difficulty, out var cls) ? cls : "";

    private static bool IsFirstInGroup(List<ChatMessage> msgs, int index)
    {
        if (index == 0) return true;
        return msgs[index - 1].SenderName != msgs[index].SenderName;
    }

    private void ToggleExpanded(string id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private List<ChatMessage> _messages =
    [
        new("1", "text", "me", "You", "YO", "6:12 PM",
            Content: "Hey! You mentioned your pasta recipe last week. Can you share it?"),
        new("2", "text", "them", "Maria Chen", "MC", "6:14 PM",
            Content: "Of course! Here's the one I made on Saturday."),
        new("3", "recipe", "them", "Maria Chen", "MC", "6:14 PM",
            Recipe: new(
                "Lemon Garlic Shrimp Pasta",
                "25 min",
                4,
                "Easy",
                [
                    new("Linguine", "400g"),
                    new("Large shrimp, peeled", "450g"),
                    new("Garlic cloves, minced", "4"),
                    new("Lemon, juiced and zested", "1"),
                    new("Olive oil", "3 tbsp"),
                    new("Red pepper flakes", "1/2 tsp"),
                    new("Fresh parsley, chopped", "1/4 cup"),
                    new("Parmesan cheese, grated", "1/2 cup"),
                ],
                [
                    "Cook linguine in salted boiling water until al dente. Reserve 1 cup pasta water before draining.",
                    "Heat olive oil in a large skillet over medium-high heat. Add shrimp and cook 2 minutes per side until pink. Remove and set aside.",
                    "In the same skillet, sauté garlic and red pepper flakes for 30 seconds until fragrant.",
                    "Add lemon juice, zest, and 1/2 cup reserved pasta water. Simmer for 2 minutes.",
                    "Toss in the drained pasta and shrimp. Add more pasta water if needed for consistency.",
                    "Serve topped with parsley and parmesan.",
                ]
            )),
        new("4", "text", "me", "You", "YO", "6:16 PM",
            Content: "This looks amazing. What kind of shrimp do you usually use?"),
        new("5", "text", "them", "Maria Chen", "MC", "6:18 PM",
            Content: "I go with 21/25 count wild-caught Gulf shrimp. The larger size holds up well with the pasta. Frozen works great too, just thaw them under cold water first."),
        new("6", "text", "me", "You", "YO", "6:20 PM",
            Content: "Got it. I'll try making it this weekend. Here's the dessert I promised in return."),
        new("7", "recipe", "me", "You", "YO", "6:20 PM",
            Recipe: new(
                "Dark Chocolate Sea Salt Brownies",
                "35 min",
                12,
                "Easy",
                [
                    new("Dark chocolate (70%)", "200g"),
                    new("Unsalted butter", "150g"),
                    new("Granulated sugar", "1 cup"),
                    new("Eggs", "3"),
