@* ============================================================
   Block: chat-collaborative-notes
   Title: ChatCollaborativeNotes
   Description: React chat block with shared notes and document cards for Next.js featuring edit-together buttons, active editor indicators, and last-edited timestamps using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-collaborative-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">MZ</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Mia Zhang</span>
                <span class="ml-2 text-muted-foreground text-xs">Engineering</span>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                <span>3 shared notes</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @for (var i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var showHeader = IsFirstInGroup(i);

                <div class="flex gap-2 px-2 transition-colors hover:bg-accent">
                    <div class="w-10 shrink-0 pt-1">
                        @if (showHeader)
                        {
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-xs">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                    </div>
                    <div class="min-w-0 flex-1 py-1">
                        @if (showHeader)
                        {
                            <div class="mb-0.5 flex items-center gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-muted-foreground text-xs">@msg.Time</span>
                            </div>
                        }
                        @if (msg.Content != null)
                        {
                            <p class="text-sm">@msg.Content</p>
                        }
                        @if (msg.Note != null)
                        {
                            var note = msg.Note;
                            var hasActiveEditors = note.ActiveEditors > 0;
                            <div class="mt-1.5 rounded-md border p-3">
                                <div class="mb-2 flex items-start gap-2.5">
                                    <LucideIconCn Name="file-text" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <span class="font-medium text-sm leading-tight">@note.Title</span>
                                        <p class="mt-0.5 line-clamp-2 text-muted-foreground text-xs leading-relaxed">@note.Preview</p>
                                    </div>
                                </div>

                                <div class="mb-3 flex items-center gap-3">
                                    @if (hasActiveEditors)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                            <span class="text-muted-foreground text-xs">
                                                @note.ActiveEditors @(note.ActiveEditors == 1 ? "person" : "people") editing
                                            </span>
                                        </div>
                                    }
                                    <span class="text-muted-foreground text-xs">
                                        @if (hasActiveEditors)
                                        {
                                            <span class="mr-1.5">·</span>
                                        }
                                        Edited @note.LastEdited by @note.EditedBy
                                    </span>
                                </div>

                                <div class="flex gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1.5 text-xs">
                                        <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                                        Edit together
                                    </ButtonCn>
                                    @if (hasActiveEditors)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="flex h-7 items-center gap-1 px-2 font-normal text-xs">
                                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                                            @note.ActiveEditors live
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="relative flex items-end gap-2" @onsubmit="HandleSubmit">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4" />
                </ButtonCn>
                <div class="relative flex-1">
                    <TextareaCn @bind-Value="_input"
                                Placeholder="Type a message..."
                                Rows="1"
                                Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                    <ButtonCn type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="absolute top-1/2 right-0 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record SharedNote(string Title, string Preview, int ActiveEditors, string LastEdited, string EditedBy);

    private record ChatMessage(string Id, string Role, string Sender, string Initials, string? Content, SharedNote? Note, string Time);

    private string _input = "";

    private static readonly ChatMessage[] _messages =
    [
        new("1", "other", "Mia Zhang", "MZ",
            "I started drafting the technical spec for the new API. Take a look and add your sections.",
            null, "11:05 AM"),
        new("2", "other", "Mia Zhang", "MZ",
            null,
            new SharedNote(
                "API v3 Technical Specification",
                "This document outlines the architecture, endpoint design, authentication flow, and rate limiting strategy for the v3 REST API migration...",
                2, "3 min ago", "Mia Zhang"),
            "11:05 AM"),
        new("3", "user", "You", "YO",
            "This looks solid. I'll add the database schema section and the error handling patterns.",
            null, "11:12 AM"),
        new("4", "other", "Mia Zhang", "MZ",
            "Perfect. Also, here's the meeting notes from the architecture review. I captured the key decisions.",
            null, "11:15 AM"),
        new("5", "other", "Mia Zhang", "MZ",
            null,
            new SharedNote(
                "Architecture Review Notes — March 2026",
                "Decisions: 1) Migrate to event-driven architecture for async workflows. 2) Use PostgreSQL with read replicas for the query layer. 3) Redis for session cache with 24h TTL...",
                0, "Yesterday", "Mia Zhang"),
            "11:15 AM"),
        new("6", "user", "You", "YO",
            "Great notes. I put together the deployment runbook. Can you review the rollback procedure?",
            null, "11:22 AM"),
        new("7", "user", "You", "YO",
            null,
            new SharedNote(
                "Deployment Runbook — v3 Migration",
                "Pre-deployment checklist, blue-green deployment steps, health check validation, rollback triggers, and post-deployment monitoring setup...",
                1, "Just now", "You"),
            "11:22 AM"),
        new("8", "other", "Mia Zhang", "MZ",
            "On it. I'll jump in and review the rollback section right now.",
            null, "11:24 AM"),
    ];

    private bool IsFirstInGroup(int index)
    {
        if (index == 0) return true;
        var prev = _messages[index - 1];
        var curr = _messages[index];
        return prev.Sender != curr.Sender || prev.Role != curr.Role;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
