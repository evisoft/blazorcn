@* ============================================================
   Block: chat-link-previews
   Title: ChatLinkPreviews
   Description: React chat block with URL link preview cards for Next.js featuring rich previews with title, description, domain, and external link icons using shadcn/ui, TypeScript, and Tailwind CSS
   Source: original/blocks/chat/chat-link-previews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">NT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Nina Torres</span>
                <span class="ml-2 text-muted-foreground text-xs">Frontend</span>
            </div>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Online
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var grp in _grouped)
            {
                var group = grp;
                <div class="px-2">
                    @* Primary message with avatar *@
                    <div class="flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent">
                        <AvatarCn Class="mt-0.5 size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@group.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@group.Sender</span>
                                <span class="text-muted-foreground text-xs">@group.Msgs[0].Time</span>
                            </div>
                            <p class="text-sm leading-relaxed">@group.Msgs[0].Content</p>
                            @if (group.Msgs[0].Link != null)
                            {
                                @RenderLinkCard(group.Msgs[0].Link!)
                            }
                        </div>
                    </div>

                    @* Additional messages — hover-time only *@
                    @foreach (var additionalMsg in group.Msgs.Skip(1))
                    {
                        var msg = additionalMsg;
                        <div class="group flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent">
                            <div class="flex w-8 shrink-0 items-start justify-center">
                                <span class="hidden pt-1 text-muted-foreground text-[10px] group-hover:block">@msg.Time</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                                @if (msg.Link != null)
                                {
                                    @RenderLinkCard(msg.Link!)
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2 rounded-md border bg-muted/30 px-3">
                <input @bind="_input" @bind:event="oninput"
                       placeholder="Share a link or message..."
                       class="h-9 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground/50" />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private enum LinkType { Og, GitHub, YouTube }

    private record LinkMeta(string? Stars, string? Forks, string? Language, string? LanguageColor);

    private record LinkPreview(
        LinkType Type,
        string Url,
        string Domain,
        string Title,
        string Description,
        LinkMeta? Meta = null
    );

    private record ChatMessage(
        string Id,
        string Sender,
        string Initials,
        string Content,
        string Time,
        LinkPreview? Link = null
    );

    private record MessageGroup(string Sender, string Initials, List<ChatMessage> Msgs);

    private static readonly ChatMessage[] _messages =
    [
        new("1", "Nina Torres", "NT",
            "Found this great article on React Server Components. Really clarifies the mental model.",
            "11:02 AM",
            new LinkPreview(LinkType.Og,
                "https://react.dev/blog/2024/12/server-components",
                "react.dev",
                "Understanding React Server Components",
                "A deep dive into the architecture of Server Components, how they differ from Client Components, and when to use each pattern in your Next.js applications.")),
        new("2", "You", "ME",
            "Have you seen the shadcn/ui repo? Their component patterns are solid.",
            "11:06 AM",
            new LinkPreview(LinkType.GitHub,
                "https://github.com/shadcn-ui/ui",
                "github.com",
                "shadcn-ui/ui",
                "Beautifully designed components that you can copy and paste into your apps.",
                new LinkMeta("82.4k", "5.1k", "TypeScript", "bg-blue-500"))),
        new("3", "Nina Torres", "NT",
            "Of course, we use it everywhere. On a different note, this conference talk on partial prerendering is worth watching.",
            "11:10 AM",
            new LinkPreview(LinkType.YouTube,
                "https://youtube.com/watch?v=example",
                "youtube.com",
                "Next.js Conf: Partial Prerendering Deep Dive",
                "Learn how PPR combines static and dynamic rendering in a single route for instant loads.")),
        new("4", "You", "ME",
            "Bookmarked. Also, the Biome blog post about v2 covers improvements relevant to our toolchain migration.",
            "11:14 AM",
            new LinkPreview(LinkType.Og,
                "https://biomejs.dev/blog/biome-v2",
                "biomejs.dev",
                "Biome v2: Faster Linting and Formatting",
                "Biome v2 delivers 10x faster linting than ESLint, built-in CSS support, improved TypeScript analysis, and a new plugin system.")),
        new("5", "Nina Torres", "NT",
            "We should migrate to Biome. Bookmarking this database comparison for our infra discussion too.",
            "11:18 AM",
            new LinkPreview(LinkType.GitHub,
                "https://github.com/planetscale/database-comparison",
                "github.com",
                "planetscale/database-comparison",
                "A detailed comparison of PostgreSQL, MySQL, SQLite, and distributed databases for modern web apps.",
                new LinkMeta("12.3k", "890", "Markdown", "bg-zinc-500"))),
        new("6", "You", "ME",
            "Perfect timing. I'll review it before the meeting.",
            "11:20 AM"),
    ];

    private List<MessageGroup> _grouped = [];

    protected override void OnInitialized()
    {
        _grouped = [];
        foreach (var msg in _messages)
        {
            var last = _grouped.Count > 0 ? _grouped[_grouped.Count - 1] : null;
            if (last != null && last.Sender == msg.Sender)
                last.Msgs.Add(msg);
            else
                _grouped.Add(new MessageGroup(msg.Sender, msg.Initials, [msg]));
        }
    }

    private string _input = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private RenderFragment RenderLinkCard(LinkPreview link) => link.Type switch
    {
        LinkType.GitHub => RenderGitHubCard(link),
        LinkType.YouTube => RenderYouTubeCard(link),
        _ => RenderOgCard(link),
    };

    private RenderFragment RenderOgCard(LinkPreview link) => @<div class="mt-1.5 overflow-hidden rounded-md border bg-muted/30">
        <div class="aspect-[2/1] bg-muted/50"></div>
        <div class="p-3">
            <div class="mb-1.5 flex items-center gap-1.5">
                <LucideIconCn Name="globe" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                <span class="truncate font-mono text-muted-foreground text-[11px]">@link.Domain</span>
                <LucideIconCn Name="external-link" Size="12" Class="ml-auto size-3 shrink-0 text-muted-foreground/60" />
            </div>
            <p class="mb-0.5 font-medium text-sm leading-snug">@link.Title</p>
            <p class="line-clamp-2 text-muted-foreground text-xs leading-relaxed">@link.Description</p>
        </div>
    </div>;

    private RenderFragment RenderGitHubCard(LinkPreview link) => @<div class="mt-1.5 overflow-hidden rounded-md border bg-muted/30 p-3">
        <div class="mb-1.5 flex items-center gap-1.5">
            <svg viewBox="0 0 16 16" class="size-3.5 shrink-0 fill-current text-muted-foreground" aria-label="GitHub repository">
                <title>GitHub</title>
                <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z" />
            </svg>
            <span class="truncate font-medium text-sm text-blue-600 dark:text-blue-400">@link.Title</span>
        </div>
        <p class="mb-2 line-clamp-2 text-muted-foreground text-xs leading-relaxed">@link.Description</p>
        @if (link.Meta != null)
        {
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                @if (link.Meta.Language != null)
                {
                    <span class="flex items-center gap-1">
                        <span class="@Cn.Merge("size-2 rounded-full", link.Meta.LanguageColor ?? "")"></span>
                        @link.Meta.Language
                    </span>
                }
                @if (link.Meta.Stars != null)
                {
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="star" Size="12" Class="size-3" />
                        @link.Meta.Stars
                    </span>
                }
                @if (link.Meta.Forks != null)
                {
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="git-fork" Size="12" Class="size-3" />
                        @link.Meta.Forks
                    </span>
                }
            </div>
        }
    </div>;

    private RenderFragment RenderYouTubeCard(LinkPreview link) => @<div class="mt-1.5 overflow-hidden rounded-md border bg-muted/30">
        <div class="relative aspect-video bg-zinc-900">
            <div class="absolute inset-0 flex items-center justify-center">
                <div class="flex size-10 items-center justify-center rounded-full bg-red-600">
                    <LucideIconCn Name="play" Size="16" Class="size-4 fill-white text-white" />
                </div>
            </div>
        </div>
        <div class="p-3">
            <div class="mb-1.5 flex items-center gap-1.5">
                <LucideIconCn Name="globe" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                <span class="truncate font-mono text-muted-foreground text-[11px]">@link.Domain</span>
                <LucideIconCn Name="external-link" Size="12" Class="ml-auto size-3 shrink-0 text-muted-foreground/60" />
            </div>
            <p class="mb-0.5 font-medium text-sm leading-snug">@link.Title</p>
            <p class="line-clamp-1 text-muted-foreground text-xs">@link.Description</p>
        </div>
    </div>;
}
