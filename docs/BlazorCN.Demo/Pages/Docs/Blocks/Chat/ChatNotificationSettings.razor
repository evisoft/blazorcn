@* ============================================================
   Block: chat-notification-settings
   Title: ChatNotificationSettings
   Description: React chat notification preferences panel for Next.js with per-channel mute toggles, push notification controls, sound settings, and mention filters using TypeScript, shadcn/ui Switch, and Tailwind CSS
   Source: original/blocks/chat/chat-notification-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground" aria-label="Back">
                <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
            </ButtonCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Content *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            @* Notification Level *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Notify me about
                </span>
                <div class="mt-3 flex flex-col gap-1">
                    @foreach (var opt in _levelOptions)
                    {
                        var option = opt;
                        <button type="button"
                                @onclick="@(() => _level = option.Value)"
                                class="@Cn.Merge("flex items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors", _level == option.Value ? "bg-muted/50" : "hover:bg-muted/30")">
                            <LucideIconCn Name="@option.IconName" Size="16" Class="@Cn.Merge("size-4 shrink-0", _level == option.Value ? "text-foreground" : "text-muted-foreground")" />
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@option.Label</span>
                                <p class="text-muted-foreground text-xs">@option.Description</p>
                            </div>
                            <div class="@Cn.Merge("flex size-4 items-center justify-center rounded-full border", _level == option.Value ? "border-foreground bg-foreground" : "border-muted-foreground/40")">
                                @if (_level == option.Value)
                                {
                                    <span class="size-1.5 rounded-full bg-background"></span>
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* Sound & Push *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Delivery
                </span>
                <div class="mt-3 flex flex-col gap-1">
                    <div class="flex items-center justify-between rounded-md px-3 py-2.5">
                        <div class="flex items-center gap-3">
                            @if (_soundEnabled)
                            {
                                <LucideIconCn Name="volume-2" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="volume-x" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            <div>
                                <span class="font-medium text-sm">Sound</span>
                                <p class="text-muted-foreground text-xs">Play a sound for new messages</p>
                            </div>
                        </div>
                        <SwitchCn Checked="@_soundEnabled" CheckedChanged="@((v) => _soundEnabled = v)" aria-label="Sound" />
                    </div>
                    <div class="flex items-center justify-between rounded-md px-3 py-2.5">
                        <div class="flex items-center gap-3">
                            @if (_pushEnabled)
                            {
                                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="bell-off" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            <div>
                                <span class="font-medium text-sm">Push notifications</span>
                                <p class="text-muted-foreground text-xs">Receive alerts on your device</p>
                            </div>
                        </div>
                        <SwitchCn Checked="@_pushEnabled" CheckedChanged="@((v) => _pushEnabled = v)" aria-label="Push notifications" />
                    </div>
                </div>
            </div>

            @* Per-channel Mute *@
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Channel overrides
                </span>
                <p class="mt-1 text-muted-foreground text-xs">
                    Mute specific channels or conversations
                </p>
                <div class="mt-3 flex flex-col gap-0.5">
                    @foreach (var ch in _channels)
                    {
                        var channel = ch;
                        <div class="flex items-center justify-between rounded-md px-3 py-2 transition-colors hover:bg-muted/30">
                            <div class="flex items-center gap-3">
                                @if (channel.Type == "channel")
                                {
                                    <LucideIconCn Name="hash" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                                <span class="text-sm">@channel.Name</span>
                            </div>
                            <div class="flex items-center gap-2">
                                @if (channel.Muted)
                                {
                                    <span class="text-muted-foreground text-xs">Muted</span>
                                }
                                <SwitchCn Checked="@(!channel.Muted)" CheckedChanged="@((v) => ToggleChannelMute(channel.Id))" aria-label="@($"Notifications for {channel.Name}")" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @(_level == "nothing" ? "All notifications are muted" : $"Receiving {(_level == "all" ? "all messages" : "mentions only")}")
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Save preferences
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record LevelOption(string Value, string Label, string Description, string IconName);
    private record Channel(string Id, string Name, string Type, bool Muted);

    private string _level = "all";
    private bool _soundEnabled = true;
    private bool _pushEnabled = true;

    private static readonly LevelOption[] _levelOptions =
    [
        new("all", "All messages", "Get notified for every new message", "bell"),
        new("mentions", "Mentions only", "Only when someone mentions you", "message-square"),
        new("nothing", "Nothing", "Mute all chat notifications", "bell-off"),
    ];

    private List<Channel> _channels =
    [
        new("1", "general", "channel", false),
        new("2", "engineering", "channel", false),
        new("3", "design-reviews", "channel", true),
        new("4", "random", "channel", true),
        new("5", "Jordan Davis", "dm", false),
        new("6", "Mara Chen", "dm", false),
    ];

    private void ToggleChannelMute(string channelId)
    {
        _channels = _channels.Select(ch => ch.Id == channelId ? ch with { Muted = !ch.Muted } : ch).ToList();
    }
}
