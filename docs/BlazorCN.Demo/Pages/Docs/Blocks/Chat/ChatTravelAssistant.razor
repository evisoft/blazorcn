@* ============================================================
   Block: chat-travel-assistant
   Title: ChatTravelAssistant
   Description: React travel booking assistant chat block for Next.js with flight cards, hotel listings, itinerary summary, departure and arrival times, and book now buttons using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-travel-assistant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">
                    <LucideIconCn Name="plane" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Travel Assistant</span>
                <p class="text-muted-foreground text-xs">Flights, hotels, and itineraries</p>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex", msg.Role == "traveler" ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[85%]", msg.Role == "traveler" ? "rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Flight != null)
                            {
                                var flight = msg.Flight;
                                @* Flight Card *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="plane" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@flight.Airline</span>
                                            <span class="font-mono text-muted-foreground text-xs">@flight.FlightNo</span>
                                        </div>
                                        <span class="font-semibold text-sm tabular-nums">@flight.Price</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <div class="text-center">
                                            <p class="font-semibold text-lg tabular-nums">@flight.Departure.Code</p>
                                            <p class="text-muted-foreground text-xs">@flight.Departure.Time</p>
                                        </div>
                                        <div class="flex flex-1 flex-col items-center gap-0.5">
                                            <span class="text-muted-foreground text-xs">@flight.Duration</span>
                                            <div class="flex w-full items-center gap-1">
                                                <div class="size-1.5 rounded-full bg-muted-foreground/40"></div>
                                                <div class="h-px flex-1 border-t border-dashed border-muted-foreground/30"></div>
                                                <div class="size-1.5 rounded-full bg-muted-foreground/40"></div>
                                            </div>
                                            <span class="text-muted-foreground text-xs">
                                                @(flight.Stops == 0 ? "Direct" : $"{flight.Stops} stop")
                                            </span>
                                        </div>
                                        <div class="text-center">
                                            <p class="font-semibold text-lg tabular-nums">@flight.Arrival.Code</p>
                                            <p class="text-muted-foreground text-xs">@flight.Arrival.Time</p>
                                        </div>
                                    </div>
                                    <div class="mt-2.5 flex items-center justify-between border-t pt-2.5">
                                        <span class="text-muted-foreground text-xs">@flight.Departure.City to @flight.Arrival.City</span>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Book now</ButtonCn>
                                    </div>
                                </div>
                            }
                            @if (msg.Hotel != null)
                            {
                                var hotel = msg.Hotel;
                                @* Hotel Card *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-1 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="hotel" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@hotel.Name</span>
                                        </div>
                                        <div class="flex items-center gap-0.5">
                                            @for (int si = 0; si < hotel.Stars; si++)
                                            {
                                                <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                                            }
                                        </div>
                                    </div>
                                    <p class="mb-2 text-muted-foreground text-xs">@hotel.Location</p>
                                    <div class="mb-2.5 flex items-center gap-2">
                                        <span class="flex items-center gap-1 text-xs">
                                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                            @hotel.Rating
                                        </span>
                                        <span class="text-muted-foreground text-xs">(@hotel.Reviews.ToString("N0") reviews)</span>
                                    </div>
                                    <div class="mb-2.5 flex flex-wrap gap-1">
                                        @foreach (var amenity in hotel.Amenities)
                                        {
                                            <span class="rounded-full bg-muted/50 px-2 py-0.5 text-muted-foreground text-xs">@amenity</span>
                                        }
                                    </div>
                                    <div class="flex items-center justify-between border-t pt-2.5">
                                        <div>
                                            <span class="font-semibold text-sm tabular-nums">@hotel.PricePerNight</span>
                                            <span class="text-muted-foreground text-xs"> / night</span>
                                        </div>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Book now</ButtonCn>
                                    </div>
                                </div>
                            }
                            @if (msg.Itinerary != null)
                            {
                                var itin = msg.Itinerary;
                                @* Itinerary Card *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="plane" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">Trip to @itin.TripName</span>
                                    </div>
                                    <div class="space-y-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Dates</span>
                                            <span class="text-sm">@itin.Dates</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Flight</span>
                                            <span class="text-sm">@itin.Flight</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Hotel</span>
                                            <span class="text-sm">@itin.Hotel</span>
                                        </div>
                                    </div>
                                    <div class="mt-2.5 flex items-center justify-between border-t pt-2.5">
                                        <div>
                                            <span class="text-muted-foreground text-xs">Total</span>
                                            <span class="ml-2 font-semibold text-lg tabular-nums">@itin.TotalPrice</span>
                                        </div>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Book now</ButtonCn>
                                    </div>
                                </div>
                            }
                            <span class="@Cn.Merge("mt-1 block text-right text-xs", msg.Role == "traveler" ? "text-primary-foreground/60" : "text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Where would you like to go?"
                            Rows="1"
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Where would you like to go?" />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))"
                          OnClick="@HandleSubmit"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private record FlightEndpoint(string Code, string City, string Time);

    private record FlightData(
        string Airline,
        string FlightNo,
        FlightEndpoint Departure,
        FlightEndpoint Arrival,
        string Duration,
        int Stops,
        string Price);

    private record HotelData(
        string Name,
        int Stars,
        string PricePerNight,
        string Location,
        string[] Amenities,
        string Rating,
        int Reviews);

    private record ItineraryData(
        string TripName,
        string Dates,
        string Flight,
        string Hotel,
        string TotalPrice);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        FlightData? Flight = null,
        HotelData? Hotel = null,
        ItineraryData? Itinerary = null);

    private static readonly Message[] _messages =
    [
        new("1", "assistant",
            "Hi! I'm your travel assistant. I found some great options for your Tokyo trip in April. Let me show you the best flights first.",
            "2:00 PM"),
        new("2", "traveler",
            "Great! I'm looking for something with a reasonable layover. Direct flights preferred but open to one stop if it saves a lot.",
            "2:01 PM"),
        new("3", "assistant",
            "Here's the best direct option I found:",
