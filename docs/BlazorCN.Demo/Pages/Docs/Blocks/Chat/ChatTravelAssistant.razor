        new("4", "assistant", "", "2:02 PM",
            Flight: new(
                "ANA", "NH 105",
                new("SFO", "San Francisco", "11:30 AM"),
                new("NRT", "Tokyo Narita", "3:45 PM +1"),
                "11h 15m", 0, "$892")),
        new("5", "assistant",
            "And here's a one-stop option that saves $200:",
            "2:03 PM"),
        new("6", "assistant", "", "2:03 PM",
            Flight: new(
                "United", "UA 837",
                new("SFO", "San Francisco", "9:15 AM"),
                new("NRT", "Tokyo Narita", "4:20 PM +1"),
                "14h 05m", 1, "$694")),
        new("7", "traveler",
            "I'll go with the ANA direct flight. What about hotels near Shinjuku station?",
            "2:05 PM"),
        new("8", "assistant",
            "Excellent choice. Here's a top-rated hotel right by the station:",
            "2:06 PM"),
        new("9", "assistant", "", "2:06 PM",
            Hotel: new(
                "Hyatt Regency Tokyo", 5, "$185",
                "2 min walk from Shinjuku Station",
                ["Free WiFi", "Fitness center", "Rooftop bar", "Airport shuttle"],
                "4.7", 3842)),
        new("10", "traveler",
            "That looks perfect. Can you put together the full itinerary?",
            "2:08 PM"),
        new("11", "assistant",
            "Here's your complete trip summary:",
            "2:09 PM"),
        new("12", "assistant", "", "2:09 PM",
            Itinerary: new(
                "Tokyo, Japan",
                "Apr 12 - Apr 19 (7 nights)",
