@* ============================================================
   Block: chat-book-recommendation
   Title: ChatBookRecommendation
   Description: A book recommendation chat interface with book cards, genre tags, star ratings, and reading list management built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/chat/chat-book-recommendation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <AvatarCn Class="size-8">
                    <AvatarImageCn Src="" Alt="" />
                    <AvatarFallbackCn Class="bg-blue-500/10 text-blue-600 text-xs">BR</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Book Recommendations</h2>
                    <p class="text-muted-foreground text-xs">Personalized literary suggestions</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 py-4">
                @foreach (var message in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="" Alt="" />
                            <AvatarFallbackCn Class="@Cn.Merge("text-xs", message.Type == "assistant" ? "bg-blue-500/10 text-blue-600" : "bg-muted")">
                                @(message.Type == "assistant" ? "BR" : "You")
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", message.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @message.Content
                            </div>
                            <span class="text-muted-foreground text-xs">@message.Timestamp</span>

                            @* Book Cards *@
                            @if (message.Books != null && message.Books.Length > 0)
                            {
                                <div class="mt-3 space-y-3">
                                    @foreach (var book in message.Books)
                                    {
                                        <div class="overflow-hidden rounded-lg border bg-card">
                                            <div class="space-y-3 p-3">
                                                @* Book Header *@
                                                <div class="flex items-start justify-between gap-3">
                                                    <div class="min-w-0 flex-1">
                                                        <h3 class="font-medium text-sm">@book.Title</h3>
                                                        <p class="mt-0.5 text-muted-foreground text-xs">by @book.Author</p>
                                                    </div>
                                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 shrink-0 gap-1.5 px-2">
                                                        <LucideIconCn Name="bookmark" Size="14" Class="size-3.5" />
                                                        <span class="text-xs">Save</span>
                                                    </ButtonCn>
                                                </div>

                                                @* Genres *@
                                                <div class="flex flex-wrap gap-1.5">
                                                    @foreach (var genre in book.Genres)
                                                    {
                                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@genre</BadgeCn>
                                                    }
                                                </div>

                                                @* Rating *@
                                                <div class="flex items-center gap-2">
                                                    <div class="flex items-center gap-0.5">
                                                        @for (int i = 0; i < 5; i++)
                                                        {
                                                            var starIndex = i;
                                                            <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", starIndex < (int)Math.Floor(book.Rating) ? "fill-yellow-500 text-yellow-500" : "text-muted-foreground/30")" />
                                                        }
                                                    </div>
                                                    <span class="font-medium text-sm tabular-nums">@book.Rating</span>
                                                    <span class="text-muted-foreground text-xs">(@book.Reviews.ToString("N0") reviews)</span>
                                                </div>

                                                @* Description *@
                                                <p class="text-muted-foreground text-xs leading-relaxed">@book.Description</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t bg-muted/50 p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Describe your reading preferences..." Class="flex-1" aria-label="Describe your reading preferences..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Book(
        string Id,
        string Title,
        string Author,
        string[] Genres,
        double Rating,
        int Reviews,
        string Description);

    private record Message(string Id, string Type, string Content, string Timestamp, Book[]? Books = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Hello! I'm your book recommendation assistant. Tell me what kind of books you enjoy, and I'll suggest some titles you might love.",
            "10:30 AM"),
        new("2", "user",
            "I'm looking for science fiction with strong character development, similar to The Expanse series.",
            "10:31 AM"),
        new("3", "assistant",
            "Great choice! Based on your preference for character-driven sci-fi, here are three recommendations:",
            "10:31 AM",
            [
                new("b1", "Project Hail Mary", "Andy Weir",
                    ["Science Fiction", "Adventure", "Hard Sci-Fi"],
                    4.7, 12843,
                    "A lone astronaut must save humanity with science and wit in this thrilling space adventure."),
                new("b2", "The Long Way to a Small, Angry Planet", "Becky Chambers",
                    ["Science Fiction", "Space Opera", "Character-Driven"],
                    4.5, 8932,
                    "A ragtag crew travels through space, focusing on relationships and diverse alien cultures."),
                new("b3", "Children of Time", "Adrian Tchaikovsky",
                    ["Science Fiction", "Hard Sci-Fi", "Evolution"],
                    4.4, 6721,
                    "An epic tale of humanity's last survivors and an evolving spider civilization."),
            ]),
        new("4", "user",
            "These look great! Do you have anything with more mystery elements?",
            "10:33 AM"),
        new("5", "assistant",
            "Absolutely! Here are some sci-fi mysteries with strong character arcs:",
            "10:33 AM",
            [
                new("b4", "The Ferryman", "Justin Cronin",
                    ["Science Fiction", "Mystery", "Dystopian"],
                    4.3, 4512,
                    "A utopian society's enforcer uncovers dark secrets that challenge reality itself."),
            ]),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"book-recommendation-msg-{_messages.Count + 1}", "user", _input, "Just now"));
        _input = "";
    }
}
