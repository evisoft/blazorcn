            }
        </div>

        @* Search *@
        <div class=""border-b px-4 py-2"">
            <div class=""relative"">
                <LucideIconCn Name=""search"" Size=""14"" Class=""absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted-foreground"" />
                <InputCn @bind-Value=""_search"" Placeholder=""Search conversations..."" Class=""h-8 border-0 bg-muted/50 pl-8 text-sm shadow-none focus-visible:ring-0"" aria-label=""Search conversations..."" />
            </div>
        </div>

        @* Conversation list *@
        <div class=""flex-1 overflow-y-auto"" tabindex=""0"" role=""group"" aria-label=""Conversations"">
            @if (!_filtered.Any())
            {
                <div class=""px-4 py-8 text-center text-muted-foreground text-sm"">
