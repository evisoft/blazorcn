                </div>
            }
            @{
                var filteredList = _filtered.ToArray();
            }
            @foreach (var conv in filteredList)
            {
                var item = conv;
                var idx = Array.IndexOf(filteredList, item);
                @* The row used to be one big <button> wrapping the two hover-action buttons —
                   invalid HTML, and the outer button swallowed their clicks (hence the
                   stop-propagation workaround that is now gone). Opening the conversation is a
                   stretched overlay button: it covers the row for pointer users while the
                   mute/archive controls stay real siblings above it. *@
                <div class=""@Cn.Merge(""group relative flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"", _activeId == item.Id ? ""bg-accent"" : """", idx < filteredList.Length - 1 ? ""border-b"" : """")"">
                    <button type=""button""
                            @onclick=""@(() => _activeId = item.Id)""
                            class=""absolute inset-0 z-10 rounded-md focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring""
