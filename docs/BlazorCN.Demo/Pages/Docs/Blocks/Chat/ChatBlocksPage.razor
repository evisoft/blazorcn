                    </div>

                    @* Hover actions — sit above the stretched open-conversation overlay *@
                    <div class=""relative z-20 flex shrink-0 items-center gap-0.5 opacity-0 transition-opacity group-hover:opacity-100"">
                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Icon"" Class=""size-7"" aria-label=""Bell off"">
