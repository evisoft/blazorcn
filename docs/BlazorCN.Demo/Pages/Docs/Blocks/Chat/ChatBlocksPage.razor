                                  Variant=""ButtonVariant.Ghost""
                                  Disabled=""@string.IsNullOrWhiteSpace(_input)""
                                  Class=""absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"" aria-label=""Send message"">
                            <LucideIconCn Name=""arrow-up"" Size=""16"" Class=""size-4"" />
                        </ButtonCn>
                    </div>
                </form>
            </div>
        </div>

        @* Pinned messages sidebar *@
        @if (_sidebarOpen)
        {
            <div class=""flex w-72 shrink-0 flex-col border-l"">
                <div class=""flex items-center gap-2 border-b px-4 py-3"">
                    <LucideIconCn Name=""pin"" Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                    <span class=""font-medium text-sm"">Pinned</span>
