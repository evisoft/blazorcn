@* ============================================================
   Block: chat-rental-management
   Title: ChatRentalManagement
   Description: A property rental management chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring tenant requests, maintenance tickets, payment tracking, and lease management
   Source: original/blocks/chat/chat-rental-management.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10">
                    <LucideIconCn Name="house" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Rental Management</h2>
                    <p class="text-xs text-muted-foreground">Manage requests &amp; tenants</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 p-4">
                @foreach (var msg in _messages)
                {
                    @if (msg.Type == "requests" && msg.Requests != null)
                    {
                        <div class="space-y-3">
                            @foreach (var req in msg.Requests)
                            {
                                var statusCfg = _statusConfig[req.Status];
                                var typeIconName = _typeIcons[req.Type];
                                var priorityCss = _priorityColors[req.Priority];
                                <div class="overflow-hidden rounded-lg border bg-muted/30">
                                    <div class="border-b bg-card px-3 py-2.5">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="flex items-start gap-2">
                                                <div class="mt-0.5 flex size-7 items-center justify-center rounded-md bg-muted">
                                                    <LucideIconCn Name="@typeIconName" Size="16" Class="size-4 text-muted-foreground" />
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <h3 class="text-sm font-medium">@req.Title</h3>
                                                    <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                                        <div class="flex items-center gap-1">
                                                            <LucideIconCn Name="user" Size="12" Class="size-3" />
                                                            <span>@req.Tenant</span>
                                                        </div>
                                                        <span>•</span>
                                                        <span>@req.Unit</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <span class="@Cn.Merge("shrink-0 rounded-md px-2 py-0.5 text-xs font-medium capitalize", priorityCss)">
                                                @req.Priority
                                            </span>
                                        </div>
                                    </div>

                                    <div class="p-3">
                                        <p class="mb-3 text-sm text-muted-foreground">
                                            @req.Description
                                        </p>

                                        <div class="mb-3 flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">@req.SubmittedDate</span>
                                            @if (!string.IsNullOrEmpty(req.Amount))
                                            {
                                                <span class="font-medium">@req.Amount</span>
                                            }
                                        </div>

                                        <div class="flex items-center gap-2">
                                            <div class="@Cn.Merge("flex flex-1 items-center gap-1.5 rounded-md px-2.5 py-1.5", statusCfg.Bg)">
                                                <LucideIconCn Name="@statusCfg.IconName" Size="14" Class="size-3.5" />
                                                <span class="@Cn.Merge("text-xs font-medium", statusCfg.Color)">
                                                    @statusCfg.Label
                                                </span>
                                            </div>
                                            @if (req.Status == "pending")
                                            {
                                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7" OnClick="@(() => HandleUpdateStatus(req.Id, "in-progress"))">
                                                    Start
                                                </ButtonCn>
                                            }
                                            @if (req.Status == "in-progress")
                                            {
                                                <ButtonCn Size="ButtonSize.Sm" Class="h-7" OnClick="@(() => HandleUpdateStatus(req.Id, "completed"))">
                                                    Complete
                                                </ButtonCn>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "justify-end" : "justify-start")">
                            @if (msg.Type == "assistant")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-primary/10 text-xs">
                                        <LucideIconCn Name="house" Size="16" Class="size-4" />
                                    </AvatarFallbackCn>
                                </AvatarCn>
                            }
                            <div class="@Cn.Merge("max-w-[80%] rounded-lg px-3 py-2", msg.Type == "user" ? "bg-primary text-primary-foreground" : "bg-muted")">
                                <p class="text-sm">@msg.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", msg.Type == "user" ? "text-primary-foreground/70" : "text-muted-foreground")">
                                    @msg.Timestamp
                                </span>
                            </div>
                            @if (msg.Type == "user")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-muted text-xs">U</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-3">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about requests or tenants..." Class="flex-1" aria-label="Ask about requests or tenants..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Request(
        string Id,
        string Type,
        string Title,
        string Tenant,
        string Unit,
        string Status,
        string Priority,
        string Description,
        string SubmittedDate,
        string? Amount = null);

    private record Message(string Id, string Type, string Content, string Timestamp, Request[]? Requests = null);

    private record StatusConfig(string IconName, string Label, string Color, string Bg);

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["pending"]     = new("clock",         "Pending",     "text-amber-500",   "bg-amber-500/10"),
        ["in-progress"] = new("alert-circle",  "In Progress", "text-blue-500",    "bg-blue-500/10"),
        ["completed"]   = new("check-circle-2","Completed",   "text-emerald-500", "bg-emerald-500/10"),
    };

    private readonly Dictionary<string, string> _priorityColors = new()
    {
        ["low"]    = "bg-muted",
        ["medium"] = "bg-amber-500/10 text-amber-700",
        ["high"]   = "bg-red-500/10 text-red-700",
    };

    private readonly Dictionary<string, string> _typeIcons = new()
    {
        ["maintenance"] = "wrench",
        ["payment"]     = "dollar-sign",
        ["lease"]       = "calendar",
    };

    private static readonly Request[] _requests =
    [
        new("req1", "maintenance", "Kitchen Faucet Leak",    "Sarah Johnson", "Apt 3B", "pending",     "high",   "Water leaking from kitchen faucet base. Needs immediate attention.", "2 hours ago"),
        new("req2", "payment",     "Rent Payment - March",   "Mike Chen",     "Apt 5A", "completed",   "medium", "Monthly rent payment for March 2026",                                 "Yesterday",    "$1,850"),
        new("req3", "lease",       "Lease Renewal Request",  "Emma Davis",    "Apt 2C", "in-progress", "medium", "Request to renew lease for another 12 months starting May 1st",       "3 days ago"),
    ];

    private List<Message> _messages =
    [
        new("m1", "assistant", "Welcome to your rental management dashboard. I'll help you manage tenant requests, maintenance tickets, and payments. What would you like to review?", "9:30 AM"),
        new("m2", "user",      "Show me all pending requests from today",                                                                                                               "9:31 AM"),
        new("m3", "assistant", "Here are the recent requests requiring your attention:",                                                                                                "9:31 AM"),
        new("m4", "requests",  "",                                                                                                                                                      "9:31 AM", _requests),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"m{_messages.Count + 1}", "user", _input, "9:32 AM"));
        _input = "";
    }

    private void HandleUpdateStatus(string requestId, string newStatus)
    {
        // presentational only — no-op like the TSX console.log
    }
}
