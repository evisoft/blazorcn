@* ============================================================
   Block: chat-astrology-reading
   Title: ChatAstrologyReading
   Description: A personalized astrology chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring birth chart cards, daily horoscope, and compatibility analysis
   Source: original/blocks/chat/chat-astrology-reading.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="sparkles" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="font-medium text-sm">Astrology Reading</h2>
                <p class="text-muted-foreground text-xs">Your cosmic guide</p>
            </div>
            <LucideIconCn Name="moon" Size="20" Class="size-5 text-muted-foreground/60" />
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    <div class="@Cn.Merge("flex gap-3", msg.Role == "user" ? "flex-row-reverse" : "")">
                        @* Avatar *@
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", msg.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                            @if (msg.Role == "assistant")
                            {
                                <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <span class="font-medium text-xs">You</span>
                            }
                        </div>

                        @* Bubble + cards *@
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", msg.Role == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", msg.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                                @msg.Content
                            </div>

                            @* Birth Chart Card *@
                            @if (msg.BirthChart != null)
                            {
                                var chart = msg.BirthChart;
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="star" Size="14" Class="size-3.5 text-foreground" />
                                            <span class="font-medium text-sm">Your Birth Chart</span>
                                        </div>
                                    </div>
                                    <div class="space-y-2 px-3 py-2">
                                        <div class="flex items-center justify-between">
                                            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                                <LucideIconCn Name="sun" Size="14" Class="size-3.5" />
                                                Sun Sign
                                            </span>
                                            <span class="font-medium text-sm">@chart.SunSign</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                                <LucideIconCn Name="moon" Size="14" Class="size-3.5" />
                                                Moon Sign
                                            </span>
                                            <span class="font-medium text-sm">@chart.MoonSign</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" />
                                                Rising Sign
                                            </span>
                                            <span class="font-medium text-sm">@chart.RisingSign</span>
                                        </div>
                                        <div class="mt-2 flex gap-2 border-t pt-2">
                                            <span class="rounded-md bg-muted px-2 py-1 text-xs">Element: @chart.Element</span>
                                            <span class="rounded-md bg-muted px-2 py-1 text-xs">Modality: @chart.Modality</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Daily Reading Card *@
                            @if (msg.DailyReading != null)
                            {
                                var reading = msg.DailyReading;
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-500" />
                                            <span class="font-medium text-sm">Daily Guidance</span>
                                            <span class="ml-auto text-muted-foreground text-xs">@reading.Date</span>
                                        </div>
                                    </div>
                                    <div class="space-y-3 px-3 py-2">
                                        <p class="text-sm">@reading.Prediction</p>
                                        <div class="grid grid-cols-3 gap-2">
                                            <div class="rounded-md bg-muted p-2 text-center">
                                                <span class="block text-muted-foreground text-xs">Lucky Number</span>
                                                <span class="mt-0.5 block font-semibold text-lg">@reading.LuckyNumber</span>
                                            </div>
                                            <div class="rounded-md bg-muted p-2 text-center">
                                                <span class="block text-muted-foreground text-xs">Lucky Color</span>
                                                <span class="mt-0.5 block font-medium text-sm">@reading.LuckyColor</span>
                                            </div>
                                            <div class="rounded-md bg-muted p-2 text-center">
                                                <span class="block text-muted-foreground text-xs">Mood</span>
                                                <span class="mt-0.5 block font-medium text-sm">@reading.Mood</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Compatibility Card *@
                            @if (msg.Compatibility != null)
                            {
                                var compat = msg.Compatibility;
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="flex items-center justify-between bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-red-500" />
                                            <span class="font-medium text-sm">Compatibility</span>
                                        </div>
                                        <span class="font-semibold text-sm">@(compat.Score)%</span>
                                    </div>
                                    <div class="px-3 py-2">
                                        <p class="text-sm">@compat.Description</p>
                                    </div>
                                </div>
                            }

                            <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form class="border-t p-3" @onsubmit="HandleSubmit">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask about your chart, compatibility, or guidance..."
                         Class="flex-1" aria-label="Ask about your chart, compatibility, or guidance..." />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>

    </div>
</section>

@code {
    private record BirthChart(string SunSign, string MoonSign, string RisingSign, string Element, string Modality);

    private record DailyReading(string Date, string Prediction, int LuckyNumber, string LuckyColor, string Mood);

    private record Compatibility(string Sign, int Score, string Description);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        BirthChart? BirthChart = null,
        DailyReading? DailyReading = null,
        Compatibility? Compatibility = null);

    private string _input = "";

    private readonly List<Message> _messages =
    [
        new("1", "assistant",
            "Welcome to your cosmic journey! I'm your personal astrologer. Share your birth details (date, time, location), and I'll reveal insights about your astrological profile.",
            "9:00 AM"),
        new("2", "user",
            "I was born on March 15, 1990 at 3:30 PM in New York City",
            "9:02 AM"),
        new("3", "assistant",
            "Beautiful! I've calculated your birth chart. You're a Pisces Sun with fascinating placements that reveal your cosmic blueprint:",
            "9:02 AM",
            BirthChart: new("Pisces", "Cancer", "Leo", "Water", "Mutable"),
            DailyReading: new("Today",
                "Creative energy flows strongly today. Your intuition is heightened - trust those inner nudges. A collaborative opportunity may present itself in the afternoon.",
                7, "Sea Green", "Inspired")),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input))
            return;

        _messages.Add(new Message(
            $"{_messages.Count + 1}",
            "user",
            _input,
            "9:05 AM"));
        _input = "";
    }
}
