@* ============================================================
   Block: chat-typing-indicator
   Title: ChatTypingIndicator
   Description: React chat block with animated bouncing dot typing indicator for Next.js showing who is typing with staggered CSS animation using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-typing-indicator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">#payments</span>
                <p class="text-muted-foreground text-xs">
                    @(_initialParticipants.Count(p => p.Status == "online")) online
                </p>
            </div>
            <ButtonCn Variant="@(_typingUserId != null ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 px-2 text-xs"
                      @onclick="@(() => _typingUserId = _typingUserId != null ? null : "u1")">
                @(_typingUserId != null ? "Typing on" : "Typing off")
            </ButtonCn>
        </div>

        @* Participants bar *@
        <div class="flex items-center gap-1 overflow-x-auto border-b px-4 py-2">
            @foreach (var p in _initialParticipants)
            {
                var participant = p;
                <div class="flex shrink-0 items-center gap-1.5 rounded-md px-2 py-1 transition-colors hover:bg-muted/50">
                    <div class="relative">
                        <AvatarCn Class="size-5">
                            <AvatarFallbackCn Class="text-[8px]">@participant.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <span class="@Cn.Merge("absolute -right-0.5 -bottom-0.5 size-2 rounded-full ring-2 ring-card", _statusColors.GetValueOrDefault(participant.Status, "bg-zinc-400"))"></span>
                    </div>
                    <span class="text-xs">@(participant.Name.Split(' ')[0])</span>
                    @if (participant.IsViewingChannel)
                    {
                        <LucideIconCn Name="eye" Size="12" Class="size-3 text-muted-foreground/50" />
                    }
                    @if (_typingUserId == participant.Id)
                    {
                        <span class="flex items-center gap-1">
                            <span class="inline-flex items-center gap-0.5">
                                <span class="size-1 animate-bounce rounded-full bg-muted-foreground/60" style="animation-delay:0ms"></span>
                                <span class="size-1 animate-bounce rounded-full bg-muted-foreground/60" style="animation-delay:150ms"></span>
                                <span class="size-1 animate-bounce rounded-full bg-muted-foreground/60" style="animation-delay:300ms"></span>
                            </span>
                        </span>
                    }
                </div>
            }
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var grp in _grouped)
            {
                var group = grp;
                <div class="px-2">
                    @* Primary message *@
                    <div class="flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent">
                        <AvatarCn Class="mt-0.5 size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@group.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@group.Sender</span>
                                <span class="text-muted-foreground text-xs">@group.Msgs[0].Time</span>
                            </div>
                            <p class="text-sm leading-relaxed">@group.Msgs[0].Content</p>
                        </div>
                    </div>

                    @* Additional messages *@
                    @foreach (var msg in group.Msgs.Skip(1))
                    {
                        var m = msg;
                        <div class="group flex gap-2 rounded-md px-2 py-1 transition-colors hover:bg-accent">
                            <div class="flex w-8 shrink-0 items-start justify-center">
                                <span class="hidden pt-1 text-muted-foreground text-[10px] group-hover:block">@m.Time</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm leading-relaxed">@m.Content</p>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Typing indicator at bottom of messages *@
            @{
                var typingUser = _typingUserId != null ? _initialParticipants.FirstOrDefault(p => p.Id == _typingUserId) : null;
                var typingLabel = typingUser != null ? $"{typingUser.Name.Split(' ')[0]} is typing" : null;
            }
            @if (typingUser != null)
            {
                <div class="px-2">
                    <div class="flex gap-2 px-2 py-1">
                        <AvatarCn Class="mt-0.5 size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@typingUser.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@typingUser.Name</span>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span class="inline-flex items-center gap-0.5">
                                    <span class="size-1 animate-bounce rounded-full bg-muted-foreground/60" style="animation-delay:0ms"></span>
                                    <span class="size-1 animate-bounce rounded-full bg-muted-foreground/60" style="animation-delay:150ms"></span>
                                    <span class="size-1 animate-bounce rounded-full bg-muted-foreground/60" style="animation-delay:300ms"></span>
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@typingLabel...</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2 rounded-md border bg-muted/30 px-3">
                <input @bind="_input"
                       @bind:event="oninput"
                       placeholder="Message #payments..."
                       class="h-9 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground/50" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Initials, string Content, string Time);
    private record Participant(string Id, string Name, string Initials, string Status, string LastSeen, bool IsViewingChannel);
    private record MessageGroup(string Sender, string Initials, List<ChatMessage> Msgs);

    private string? _typingUserId = "u1";
    private string _input = "";

    private static readonly ChatMessage[] _chatMessages =
    [
        new("m1", "Marcus Reid", "MR", "I finished the API integration for the payments module. Ready for review.", "10:15 AM"),
        new("m2", "You", "ME", "Nice work. I'll pull it down after standup.", "10:18 AM"),
        new("m3", "Sarah Chen", "SC", "I noticed the webhook handler doesn't retry on 5xx errors. Should we add exponential backoff?", "10:22 AM"),
        new("m4", "Marcus Reid", "MR", "Good point. I'll add it with a max of 3 retries and 2s base delay.", "10:24 AM"),
        new("m5", "You", "ME", "Also make sure we log each retry attempt with the status code for debugging.", "10:25 AM"),
        new("m6", "Dana Kim", "DK", "The Stripe test keys are rotated. New ones are in the vault.", "10:30 AM"),
        new("m7", "Priya Sharma", "PS", "I updated the env template with the new variable names.", "10:32 AM"),
        new("m8", "You", "ME", "Perfect. Let's sync after lunch to go over the full payment flow end to end.", "10:35 AM"),
    ];

    private static readonly Participant[] _initialParticipants =
    [
        new("u1", "Sarah Chen", "SC", "online", "Active now", true),
        new("u2", "Marcus Reid", "MR", "online", "Active now", true),
        new("u3", "Priya Sharma", "PS", "online", "Active now", false),
        new("u4", "Jake Torres", "JT", "idle", "2m ago", false),
        new("u5", "Lin Wei", "LW", "offline", "1h ago", false),
        new("u6", "Dana Kim", "DK", "online", "Active now", true),
    ];

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["online"] = "bg-emerald-500",
        ["idle"] = "bg-amber-500",
        ["offline"] = "bg-zinc-400",
    };

    private static readonly List<MessageGroup> _grouped = BuildGroups();

    private static List<MessageGroup> BuildGroups()
    {
        var result = new List<MessageGroup>();
        foreach (var msg in _chatMessages)
        {
            if (result.Count > 0 && result[^1].Sender == msg.Sender)
            {
                result[^1].Msgs.Add(msg);
            }
            else
            {
                result.Add(new MessageGroup(msg.Sender, msg.Initials, new List<ChatMessage> { msg }));
            }
        }
        return result;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
