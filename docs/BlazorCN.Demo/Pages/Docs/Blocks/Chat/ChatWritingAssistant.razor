@* ============================================================
   Block: chat-writing-assistant
   Title: ChatWritingAssistant
   Description: A professional writing assistant chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring draft suggestions, tone analysis, and revision tracking
   Source: original/blocks/chat/chat-writing-assistant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="pen-tool" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="font-medium text-sm">Writing Assistant</h2>
                <p class="text-muted-foreground text-xs">Refine your writing with AI</p>
            </div>
            <span class="rounded-md bg-emerald-500/10 px-2 py-1 font-medium text-emerald-600 text-xs dark:text-emerald-400">
                Active
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", msg.Role == "user" ? "flex-row-reverse" : "")">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", msg.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                            @if (msg.Role == "assistant")
                            {
                                <LucideIconCn Name="pen-tool" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <span class="font-medium text-xs">You</span>
                            }
                        </div>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", msg.Role == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", msg.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                                @msg.Content
                            </div>
                            @if (msg.ToneAnalysis != null)
                            {
                                var ta = msg.ToneAnalysis;
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <span class="font-medium text-xs">Tone Analysis</span>
                                    </div>
                                    <div class="space-y-2 px-3 py-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Detected Tone</span>
                                            <span class="font-medium text-sm">@ta.Tone</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Confidence</span>
                                            <span class="text-sm">@ta.Confidence</span>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground text-xs">Tags</span>
                                            <div class="mt-1 flex flex-wrap gap-1">
                                                @foreach (var tag in ta.Tags)
                                                {
                                                    <span class="rounded-md bg-muted px-2 py-0.5 text-xs">@tag</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (msg.Suggestions != null && msg.Suggestions.Length > 0)
                            {
                                <div class="mt-2 space-y-2">
                                    @foreach (var sug in msg.Suggestions)
                                    {
                                        var suggestion = sug;
                                        <div class="overflow-hidden rounded-md border bg-muted/50">
                                            <div class="flex items-center justify-between border-b bg-card px-3 py-2">
                                                <div class="flex items-center gap-2">
                                                    @if (suggestion.Type == "improvement")
                                                    {
                                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                                    }
                                                    else if (suggestion.Type == "alternative")
                                                    {
                                                        <LucideIconCn Name="lightbulb" Size="14" Class="size-3.5 text-amber-500" />
                                                    }
                                                    else if (suggestion.Type == "tone")
                                                    {
                                                        <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-blue-500" />
                                                    }
                                                    <span class="font-medium text-xs">@suggestion.Label</span>
                                                </div>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6"
                                                          @onclick="@(() => CopySuggestion(suggestion.Id))">
                                                    @if (_copiedId == suggestion.Id)
                                                    {
                                                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                                                    }
                                                    else
                                                    {
                                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                                    }
                                                </ButtonCn>
                                            </div>
                                            <div class="px-3 py-2">
                                                <p class="whitespace-pre-wrap text-sm">@suggestion.Content</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form class="border-t p-3" @onsubmit="HandleSubmit">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Paste your text for analysis..."
                         Class="flex-1" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>

    </div>
</section>

@code {
    private record ToneAnalysisData(string Tone, string Confidence, string[] Tags);

    private record Suggestion(string Id, string Type, string Label, string Content);

    private record ChatMessage(string Id, string Role, string Content, string Timestamp,
        Suggestion[]? Suggestions = null, ToneAnalysisData? ToneAnalysis = null);

    private string _input = "";
    private string? _copiedId = null;

    private readonly List<ChatMessage> _messages = new List<ChatMessage>
    {
        new("1", "assistant",
            "Hello! I'm your writing assistant. Share your text with me, and I'll help you refine it with suggestions for clarity, tone, and style.",
            "9:00 AM"),
        new("2", "user",
            "I need help with this email: 'Hey team, we need to talk about the project deadline. It's not looking good and we might miss it.'",
            "9:05 AM"),
        new("3", "assistant",
            "I've analyzed your email. The current tone is quite informal and slightly negative. Here are some suggestions to make it more professional and constructive:",
            "9:05 AM",
            Suggestions: new[]
            {
                new Suggestion("s1", "improvement", "Professional Opening",
                    "Dear Team,\n\nI wanted to discuss our project timeline and share an important update regarding our deadline."),
                new Suggestion("s2", "alternative", "Constructive Approach",
                    "We're currently facing some challenges with our project timeline. I'd like to schedule a brief meeting to discuss potential solutions and timeline adjustments."),
            },
            ToneAnalysis: new ToneAnalysisData("Informal & Concerning", "High",
                ["Casual", "Direct", "Slightly negative"])),
    };

    private void CopySuggestion(string id)
    {
        _copiedId = id;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
        {
            _messages.Add(new ChatMessage(
                $"{_messages.Count + 1}",
                "user",
                _input,
                "9:10 AM"
            ));
            _input = "";
        }
    }
}
