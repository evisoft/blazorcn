@* ============================================================
   Block: chat-sports-live
   Title: ChatSportsLive
   Description: A live sports chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring score cards, play-by-play updates, and reaction emojis
   Source: original/blocks/chat/chat-sports-live.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="trophy" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium">Live Game Chat</h3>
                    <p class="text-xs text-muted-foreground">Lakers vs Warriors • Q1 10:45</p>
                </div>
                <div class="ml-auto">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="bg-red-500/10 text-red-600">
                        <span class="mr-1.5 size-1.5 animate-pulse rounded-full bg-red-500"></span>
                        LIVE
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 py-4">
                @foreach (var msg in _messages)
                {
                    @* Score update card *@
                    @if (msg.ScoreUpdate != null)
                    {
                        <div class="rounded-lg border bg-card p-4">
                            <div class="mb-3 flex items-center justify-between">
                                <span class="text-xs font-medium text-muted-foreground">Current Score</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@msg.ScoreUpdate.Status</BadgeCn>
                            </div>
                            <div class="grid grid-cols-3 items-center gap-4">
                                <div class="text-center">
                                    <p class="mb-1 text-xs text-muted-foreground">@msg.ScoreUpdate.HomeTeam</p>
                                    <p class="text-3xl font-semibold tabular-nums">@msg.ScoreUpdate.HomeScore</p>
                                </div>
                                <div class="text-center text-xs text-muted-foreground">vs</div>
                                <div class="text-center">
                                    <p class="mb-1 text-xs text-muted-foreground">@msg.ScoreUpdate.AwayTeam</p>
                                    <p class="text-3xl font-semibold tabular-nums">@msg.ScoreUpdate.AwayScore</p>
                                </div>
                            </div>
                        </div>
                    }

                    @* Play-by-play *@
                    @if (msg.Type == "play-by-play")
                    {
                        <div class="space-y-2">
                            <div class="@Cn.Merge("rounded-lg border p-3", (msg.PlayData?.Highlight == true) ? "border-amber-500/50 bg-amber-500/5" : "")">
                                <div class="mb-2 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">Q@(msg.PlayData?.Quarter) @msg.PlayData?.Time</BadgeCn>
                                    @if (msg.PlayData?.Highlight == true)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="bg-amber-500/10 text-xs text-amber-600">Highlight</BadgeCn>
                                    }
                                </div>
                                <p class="text-sm">@msg.Content</p>
                                @if (msg.Reactions != null)
                                {
                                    <div class="mt-3 flex items-center gap-3">
                                        <button type="button" class="flex items-center gap-1 rounded-full bg-muted/50 px-2 py-1 text-xs transition-colors hover:bg-muted">
                                            <LucideIconCn Name="flame" Size="12" Class="size-3" />
                                            <span class="font-medium tabular-nums">@msg.Reactions.Fire</span>
                                        </button>
                                        <button type="button" class="flex items-center gap-1 rounded-full bg-muted/50 px-2 py-1 text-xs transition-colors hover:bg-muted">
                                            <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                            <span class="font-medium tabular-nums">@msg.Reactions.ThumbsUp</span>
                                        </button>
                                        <button type="button" class="flex items-center gap-1 rounded-full bg-muted/50 px-2 py-1 text-xs transition-colors hover:bg-muted">
                                            <LucideIconCn Name="party-popper" Size="12" Class="size-3" />
                                            <span class="font-medium tabular-nums">@msg.Reactions.Party</span>
                                        </button>
                                        <button type="button" class="flex items-center gap-1 rounded-full bg-muted/50 px-2 py-1 text-xs transition-colors hover:bg-muted">
                                            <LucideIconCn Name="zap" Size="12" Class="size-3" />
                                            <span class="font-medium tabular-nums">@msg.Reactions.Lightning</span>
                                        </button>
                                    </div>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                        </div>
                    }

                    @* User message *@
                    @if (msg.Type == "user")
                    {
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarImageCn Src="@msg.Author?.Avatar" Alt="" />
                                <AvatarFallbackCn>@(msg.Author?.Name?.Length > 0 ? msg.Author.Name[0].ToString() : "U")</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex-1 space-y-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="text-sm font-medium">@msg.Author?.Name</span>
                                    <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                                </div>
                                <div class="inline-block rounded-lg bg-muted px-3 py-2 text-sm">@msg.Content</div>
                            </div>
                        </div>
                    }

                    @* Assistant message *@
                    @if (msg.Type == "assistant")
                    {
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="bg-primary/10">
                                    <LucideIconCn Name="trophy" Size="16" Class="size-4 text-primary" />
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex-1 space-y-1">
                                <div class="inline-block rounded-lg bg-muted px-3 py-2 text-sm">@msg.Content</div>
                                <div class="text-xs text-muted-foreground">@msg.Timestamp</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend">
                <InputCn @bind-Value="_input" Placeholder="Join the conversation..." Class="flex-1" aria-label="Join the conversation..." />
                <ButtonCn type="submit" Size="ButtonSize.Icon" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ScoreUpdateData(string HomeTeam, string AwayTeam, int HomeScore, int AwayScore, string Status);
    private record PlayData(int Quarter, string Time, string Team, bool Highlight);
    private record ReactionData(int Fire, int ThumbsUp, int Party, int Lightning);
    private record AuthorData(string Name, string? Avatar);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        AuthorData? Author = null,
        PlayData? PlayData = null,
        ReactionData? Reactions = null,
        ScoreUpdateData? ScoreUpdate = null
    );

    private string _input = "";

    private List<Message> _messages =
    [
        new("1", "assistant", "Welcome to live game coverage! Lakers vs Warriors starting soon.", "7:00 PM",
            ScoreUpdate: new("Lakers", "Warriors", 0, 0, "Starting Soon")),
        new("2", "play-by-play", "Game is underway! Warriors win the tip-off.", "7:05 PM",
            PlayData: new(1, "12:00", "away", false)),
        new("3", "play-by-play",
            "Stephen Curry drains a three-pointer from downtown! Warriors take the early lead 3-0.",
            "7:06 PM",
            PlayData: new(1, "11:23", "away", true),
            Reactions: new(142, 89, 56, 203)),
        new("4", "user", "What a shot! Curry is on fire tonight! 🔥", "7:06 PM",
            Author: new("SportsJoe42", "https://avatar.vercel.sh/joe")),
        new("5", "play-by-play",
            "LeBron James drives to the basket and scores! Lakers on the board 3-2.",
            "7:07 PM",
            PlayData: new(1, "10:45", "home", true),
            Reactions: new(98, 124, 67, 145)),
        new("6", "user", "LeBron still got it! Let's go Lakers!", "7:07 PM",
            Author: new("PurpleGoldFan", "https://avatar.vercel.sh/lakers")),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new(
            DateTime.Now.Ticks.ToString(),
            "user",
            _input,
            "Just now",
            Author: new("You", "https://avatar.vercel.sh/user")
        ));
        _input = "";
    }
}
