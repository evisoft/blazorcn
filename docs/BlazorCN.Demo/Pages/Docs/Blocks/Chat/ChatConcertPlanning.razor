@* ============================================================
   Block: chat-concert-planning
   Title: ChatConcertPlanning
   Description: A concert and event planning chat interface with lineup cards, ticket tier pricing, RSVP tracking, and venue information built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/chat/chat-concert-planning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <AvatarCn Class="size-8">
                    <AvatarImageCn Src="" />
                    <AvatarFallbackCn Class="bg-purple-500/10 text-purple-600 text-xs">
                        CP
                    </AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Concert Planning</h2>
                    <p class="text-muted-foreground text-xs">Event coordination assistant</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4">
            <div class="space-y-4 py-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    <div class="@(msg.Type == "user" ? "flex gap-3 flex-row-reverse" : "flex gap-3")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="" />
                            <AvatarFallbackCn Class="@(msg.Type == "assistant" ? "text-xs bg-purple-500/10 text-purple-600" : "text-xs bg-muted")">
                                @(msg.Type == "assistant" ? "CP" : "You")
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@(msg.Type == "user" ? "min-w-0 flex-1 space-y-1 flex flex-col items-end" : "min-w-0 flex-1 space-y-1")">
                            <div class="@(msg.Type == "assistant" ? "inline-block rounded-lg px-3 py-2 text-sm bg-muted" : "inline-block rounded-lg px-3 py-2 text-sm bg-primary text-primary-foreground")">
                                @msg.Content
                            </div>
                            <span class="text-muted-foreground text-xs">@msg.Timestamp</span>

                            @* Event Details *@
                            @if (msg.EventDetails != null)
                            {
                                var ed = msg.EventDetails;
                                <div class="mt-3 overflow-hidden rounded-lg border bg-card">
                                    <div class="space-y-3 p-3">
                                        <div>
                                            <h3 class="font-medium text-sm">@ed.Name</h3>
                                            <div class="mt-2 space-y-1.5">
                                                <div class="flex items-center gap-2 text-xs">
                                                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="text-muted-foreground">@ed.Date</span>
                                                </div>
                                                <div class="flex items-center gap-2 text-xs">
                                                    <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <div class="flex flex-col">
                                                        <span class="text-muted-foreground">@ed.Venue</span>
                                                        <span class="text-muted-foreground">@ed.Address</span>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-2 text-xs">
                                                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="text-muted-foreground">@($"{ed.Rsvps:N0}") / @($"{ed.Capacity:N0}") attending</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Artist Lineup *@
                            @if (msg.Artists != null && msg.Artists.Length > 0)
                            {
                                <div class="mt-3 space-y-2">
                                    @foreach (var artist in msg.Artists)
                                    {
                                        var a = artist;
                                        <div class="flex items-center gap-3 rounded-lg border bg-card px-3 py-2.5">
                                            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-purple-500/10">
                                                <LucideIconCn Name="music" Size="16" Class="size-4 text-purple-600" />
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-baseline gap-2">
                                                    <span class="font-medium text-sm">@a.Name</span>
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@a.Genre</BadgeCn>
                                                </div>
                                                <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                                                    <div class="flex items-center gap-1">
                                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                        <span>@a.SetTime</span>
                                                    </div>
                                                    <span>@a.Duration</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* Ticket Tiers *@
                            @if (msg.Tickets != null && msg.Tickets.Length > 0)
                            {
                                <div class="mt-3 space-y-3">
                                    @foreach (var ticket in msg.Tickets)
                                    {
                                        var t = ticket;
                                        <div class="overflow-hidden rounded-lg border bg-card">
                                            <div class="space-y-3 p-3">
                                                <div class="flex items-start justify-between gap-3">
                                                    <div class="min-w-0 flex-1">
                                                        <h3 class="font-medium text-sm">@t.Name</h3>
                                                        <div class="mt-0.5 flex items-baseline gap-1">
                                                            <span class="font-semibold text-lg tabular-nums">$@t.Price</span>
                                                            <span class="text-muted-foreground text-xs">per ticket</span>
                                                        </div>
                                                    </div>
                                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 px-3">
                                                        <LucideIconCn Name="ticket" Size="14" Class="size-3.5" />
                                                        <span class="text-xs">Reserve</span>
                                                    </ButtonCn>
                                                </div>

                                                <div class="space-y-1.5 rounded-md bg-muted/50 p-2">
                                                    @foreach (var benefit in t.Benefits)
                                                    {
                                                        <div class="flex items-center gap-2 text-xs">
                                                            <span class="size-1 shrink-0 rounded-full bg-purple-600"></span>
                                                            <span class="text-muted-foreground">@benefit</span>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="flex items-center justify-between text-xs">
                                                    <span class="text-muted-foreground">Availability</span>
                                                    <span class="@(t.Available < 100 ? "font-medium tabular-nums text-amber-600" : "font-medium tabular-nums text-muted-foreground")">
                                                        @($"{t.Available:N0}") / @($"{t.Total:N0}") remaining
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t bg-muted/50 p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about the event..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Artist(string Id, string Name, string Genre, string SetTime, string Duration);

    private record TicketTier(string Id, string Name, int Price, int Available, int Total, string[] Benefits);

    private record EventDetails(string Name, string Date, string Venue, string Address, int Capacity, int Rsvps);

    private record Message(string Id, string Type, string Content, string Timestamp, Artist[]? Artists = null, TicketTier[]? Tickets = null, EventDetails? EventDetails = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Welcome to the concert planning assistant! I'll help you organize your event. What would you like to know?",
            "2:00 PM"),
        new("2", "user",
            "Show me the lineup for Summer Sounds Festival",
            "2:01 PM"),
        new("3", "assistant",
            "Here's the complete lineup for Summer Sounds Festival:",
            "2:01 PM",
            Artists:
            [
                new("a1", "The Midnight Riders", "Rock", "9:00 PM", "90 min"),
                new("a2", "Electric Dreams", "Electronic", "7:15 PM", "75 min"),
                new("a3", "Luna & The Satellites", "Indie Pop", "5:45 PM", "60 min"),
                new("a4", "Jazz Collective", "Jazz Fusion", "4:00 PM", "60 min"),
            ],
            EventDetails: new("Summer Sounds Festival", "Saturday, July 15, 2026", "Riverside Amphitheater", "1250 Waterfront Drive", 5000, 3842)),
        new("4", "user",
            "What ticket options are available?",
            "2:03 PM"),
        new("5", "assistant",
            "Here are the available ticket tiers:",
            "2:03 PM",
            Tickets:
            [
                new("t1", "VIP Experience", 199, 42, 200, ["Front row seating", "Meet & greet", "Premium bar access"]),
                new("t2", "Premium", 99, 186, 500, ["Reserved seating", "Fast track entry", "Exclusive merch"]),
                new("t3", "General Admission", 49, 1274, 3000, ["Standing area access", "Food court access"]),
            ]),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var newMessage = new Message($"msg-{_messages.Count + 1}", "user", _input, "Just now");
        _messages.Add(newMessage);
        _input = "";
    }
}
