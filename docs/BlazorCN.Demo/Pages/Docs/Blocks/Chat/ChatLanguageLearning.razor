@* ============================================================
   Block: chat-language-learning
   Title: ChatLanguageLearning
   Description: A language learning chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring vocabulary cards, pronunciation tips, and interactive quiz questions
   Source: original/blocks/chat/chat-language-learning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-blue-500/10">
                <LucideIconCn Name="book-open" Size="16" Class="size-4 text-blue-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Spanish Tutor</h3>
                <p class="text-xs text-muted-foreground">Intermediate • Food Vocabulary</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                Lesson 12
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            @foreach (var message in _messages)
            {
                var msg = message;
                <div class="@Cn.Merge("mb-4 flex gap-3", msg.Sender == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(msg.Sender == "ai" ? "bg-blue-500/10 text-blue-600" : "bg-muted")">
                            @(msg.Sender == "ai" ? "AI" : "ME")
                        </AvatarFallbackCn>
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", msg.Sender == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2", msg.Sender == "ai" ? "bg-muted" : "bg-blue-500/10 text-blue-900 dark:text-blue-100")">
                            <p class="text-sm">@msg.Content</p>
                        </div>

                        @* Vocabulary Card *@
                        @if (msg.Vocabulary != null)
                        {
                            var vocab = msg.Vocabulary;
                            <div class="mt-2 w-full max-w-sm space-y-2 rounded-lg border bg-card p-3">
                                <div class="flex items-start justify-between">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2">
                                            <h4 class="font-medium text-sm">@vocab.Word</h4>
                                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 w-6 p-0">
                                                <LucideIconCn Name="volume-2" Size="12" Class="size-3" />
                                            </ButtonCn>
                                        </div>
                                        <p class="text-xs text-muted-foreground">@vocab.Pronunciation</p>
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                        Noun
                                    </BadgeCn>
                                </div>
                                <div class="space-y-1">
                                    <p class="text-xs text-muted-foreground">Translation: @vocab.Translation</p>
                                    <div class="rounded-md bg-muted/50 p-2">
                                        <p class="font-medium text-xs">Example:</p>
                                        <p class="text-xs text-muted-foreground">@vocab.Example</p>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Quiz Question *@
                        @if (msg.Quiz != null)
                        {
                            var quiz = msg.Quiz;
                            var msgId = msg.Id;
                            <div class="mt-2 w-full max-w-sm space-y-2 rounded-lg border bg-card p-3">
                                <div class="flex items-start gap-2">
                                    <LucideIconCn Name="message-square" Size="16" Class="mt-0.5 size-4 text-blue-500" />
                                    <div class="flex-1">
                                        <p class="font-medium text-sm">@quiz.Question</p>
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    @for (int i = 0; i < quiz.Options.Length; i++)
                                    {
                                        var idx = i;
                                        var option = quiz.Options[idx];
                                        var isCorrect = idx == quiz.Correct;
                                        var isSelected = _selectedAnswer == idx;
                                        <button type="button"
                                                @onclick="@(() => HandleQuizAnswer(msgId, idx))"
                                                class="@Cn.Merge("flex w-full items-center justify-between rounded-md border px-3 py-2 text-left text-sm transition-colors", isSelected && isCorrect ? "border-emerald-500 bg-emerald-500/10" : "", isSelected && !isCorrect ? "border-red-500 bg-red-500/10" : "", !isSelected ? "hover:bg-muted/50" : "")">
                                            <span>@option</span>
                                            @if (isSelected)
                                            {
                                                @if (isCorrect)
                                                {
                                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="x" Size="16" Class="size-4 text-red-600" />
                                                }
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend">
                <InputCn @bind-Value="_input" Placeholder="Type your answer..." Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Sm" Class="shrink-0">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
            <p class="mt-2 text-xs text-muted-foreground">
                Press Enter to send • Use voice commands with "speak:"
            </p>
        </div>

    </div>
</section>

@code {
    private record VocabularyCard(string Word, string Translation, string Pronunciation, string Example);

    private record QuizQuestion(string Id, string Question, string[] Options, int Correct);

    private record Message(string Id, string Sender, string Content, string Timestamp, VocabularyCard? Vocabulary = null, QuizQuestion? Quiz = null);

    private string _input = "";
    private int? _selectedAnswer = null;

    private List<Message> _messages =
    [
        new("1", "ai",
            "¡Hola! Welcome to your Spanish learning session. Today we'll practice food vocabulary. Ready to begin?",
            "10:00 AM"),
        new("2", "user",
            "Yes, I'm ready!",
            "10:01 AM"),
        new("3", "ai",
            "Great! Let's start with a common word. How would you say \"apple\" in Spanish?",
            "10:01 AM",
            Vocabulary: new VocabularyCard(
                "manzana",
                "apple",
                "mahn-SAH-nah",
                "Me gusta comer una manzana cada día"
            )),
        new("4", "user",
            "Manzana?",
            "10:02 AM"),
        new("5", "ai",
            "¡Perfecto! You're correct. The word is 'manzana'. Let me test your understanding with a quick quiz.",
            "10:02 AM",
            Quiz: new QuizQuestion(
                "q1",
                "Which sentence correctly uses 'manzana'?",
                ["El manzana es rojo", "La manzana es roja", "Los manzana son rojos", "Las manzanas es roja"],
                1
            )),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new Message(
            $"msg-{_messages.Count + 1}",
            "user",
            _input,
            "Just now"
        ));
        _input = "";
    }

    private void HandleQuizAnswer(string messageId, int optionIndex)
    {
        _selectedAnswer = optionIndex;
    }
}
