@* ============================================================
   Block: chat-contact-cards
   Title: ChatContactCards
   Description: React chat block with contact card sharing for Next.js featuring vCard-style messages with avatar initials, name, phone, email, and action buttons using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-contact-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">RK</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Rachel Kim</span>
                <span class="ml-2 text-muted-foreground text-xs">Networking</span>
            </div>
            <span class="text-muted-foreground text-xs">3 contacts shared</span>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            @foreach (var msg in _messages)
            {
                <div class="@(msg.Role == "user" ? "flex gap-2.5 flex-row-reverse" : "flex gap-2.5 flex-row")">
                    <AvatarCn Class="mt-0.5 size-6 shrink-0">
                        <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="@(msg.Role == "user" ? "max-w-[75%] items-end flex flex-col" : "max-w-[75%] items-start flex flex-col")">
                        <div class="mb-0.5 flex items-center gap-2">
                            <span class="font-medium text-xs">@msg.Sender</span>
                            <span class="text-muted-foreground text-[10px]">@msg.Time</span>
                        </div>
                        @if (!string.IsNullOrEmpty(msg.Content))
                        {
                            <div class="@(msg.Role == "user" ? "rounded-lg px-3 py-2 text-sm bg-primary text-primary-foreground" : "rounded-lg px-3 py-2 text-sm bg-muted/50")">
                                @msg.Content
                            </div>
                        }
                        @if (msg.Contact != null)
                        {
                            var contact = msg.Contact;
                            var contactId = msg.Id;
                            <div class="mt-1 w-full rounded-md bg-muted/50 p-3">
                                <div class="flex items-center gap-3">
                                    <AvatarCn Class="size-9 shrink-0">
                                        <AvatarFallbackCn Class="font-medium text-xs">@contact.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-medium text-sm">@contact.Name</p>
                                        <div class="mt-1 flex flex-col gap-0.5">
                                            <div class="flex items-center gap-1.5">
                                                <LucideIconCn Name="phone" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                                <span class="truncate text-muted-foreground text-xs">@contact.Phone</span>
                                            </div>
                                            <div class="flex items-center gap-1.5">
                                                <LucideIconCn Name="mail" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                                <span class="truncate text-muted-foreground text-xs">@contact.Email</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3 flex items-center gap-2">
                                    <ButtonCn
                                        Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Sm"
                                        Disabled="@(_addedContacts.Contains(contactId))"
                                        OnClick="@(() => AddContact(contactId))"
                                        Class="h-7 flex-1 gap-1.5 text-xs">
                                        @if (_addedContacts.Contains(contactId))
                                        {
                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                            @("Added")
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="user-plus" Size="12" Class="size-3" />
                                            @("Add Contact")
                                        }
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1.5 text-xs">
                                        <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                        Message
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Type a message..."
                    Rows="1"
                    Class="min-h-0 max-h-32 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Type a message..." />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    OnClick="@HandleSubmit"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Send message">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private readonly HashSet<string> _addedContacts = [];

    private record ContactInfo(string Name, string Initials, string Phone, string Email);

    private record ChatMessage(string Id, string Role, string Sender, string Initials, string Time, string? Content = null, ContactInfo? Contact = null);

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "other", "Rachel Kim", "RK", "3:10 PM",
            Content: "Hey, I just met the new design lead at the conference. Sending you her contact info."),
        new("m2", "other", "Rachel Kim", "RK", "3:10 PM",
            Contact: new ContactInfo("Mia Chen", "MC", "+1 (415) 555-0192", "mia.chen@@designstudio.co")),
        new("m3", "user", "You", "YO", "3:14 PM",
            Content: "Thanks! I have been looking to connect with someone on their team. Here is our project manager's contact in case she needs it."),
        new("m4", "user", "You", "YO", "3:14 PM",
            Contact: new ContactInfo("James Okafor", "JO", "+1 (628) 555-0347", "j.okafor@@acmecorp.com")),
        new("m5", "other", "Rachel Kim", "RK", "3:18 PM",
            Content: "Perfect. Also, the freelance developer we discussed last week wants to chat about the API integration."),
        new("m6", "other", "Rachel Kim", "RK", "3:19 PM",
            Contact: new ContactInfo("Tomas Herrera", "TH", "+1 (310) 555-0821", "tomas@@herreradev.io")),
        new("m7", "user", "You", "YO", "3:22 PM",
            Content: "Great, I will reach out to him this afternoon. Thanks for connecting us!"),
    ];

    private void AddContact(string id)
    {
        _addedContacts.Add(id);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
