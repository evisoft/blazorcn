@* ============================================================
   Block: chat-forwarded-message
   Title: ChatForwardedMessage
   Description: React chat block with forwarded message indicators for Next.js featuring forward labels, original sender attribution, corner arrow icons, and message origin display using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-forwarded-message.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="corner-up-right" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Product Team</span>
            <span class="text-muted-foreground text-xs">Launch Planning</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                3 members
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var idx = i;
                var grouped = !IsNewGroup(idx);
                var rowClass = Cn.Merge(
                    "group flex gap-2 px-4 transition-colors hover:bg-accent",
                    grouped ? "py-0.5" : "mt-3 first:mt-0"
                );

                <div class="@rowClass">
                    @* Avatar column *@
                    <div class="w-8 shrink-0 pt-0.5">
                        @if (!grouped)
                        {
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-xs font-medium">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        else
                        {
                            <span class="hidden text-[10px] text-muted-foreground group-hover:inline">@msg.Timestamp</span>
                        }
                    </div>

                    @* Body *@
                    <div class="min-w-0 flex-1">
                        @if (!grouped)
                        {
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-muted-foreground text-xs">@msg.Timestamp</span>

                                @* Forward hover action *@
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                          Class="ml-auto size-6 shrink-0 opacity-0 transition-opacity group-hover:opacity-100">
                                    <LucideIconCn Name="corner-up-right" Size="12" Class="size-3 text-muted-foreground" />
                                </ButtonCn>
                            </div>
                        }

                        @* Forwarded label + content *@
                        @if (msg.IsForwarded)
                        {
                            <div class="mt-0.5">
                                <div class="mb-1 flex items-center gap-1.5">
                                    <LucideIconCn Name="corner-up-right" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-muted-foreground text-xs">Forwarded from @msg.OriginalChannel</span>
                                </div>
                                <div class="border-l-2 border-muted-foreground/20 pl-3">
                                    <div class="text-sm leading-relaxed">@msg.Content</div>
                                    @if (!string.IsNullOrEmpty(msg.OriginalSender))
                                    {
                                        <div class="mt-1.5 flex items-center gap-1">
                                            <span class="text-muted-foreground text-xs">Originally by</span>
                                            <span class="font-medium text-xs">@msg.OriginalSender</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-sm leading-relaxed">@msg.Content</div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="relative">
                <div class="rounded-md border bg-background">
                    <TextareaCn @bind-Value="_input"
                                Placeholder="Type a message..."
                                Class="min-h-0 max-h-32 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(
        string Id,
        string Sender,
        string Initials,
        string Content,
        string Timestamp,
        bool IsForwarded = false,
        string OriginalSender = "",
        string OriginalChannel = ""
    );

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "Hannah Brooks", "HB",
            "Hey team, sharing some important context from the leadership sync that is relevant to our sprint planning.",
            "3:00 PM"),
        new("m2", "Hannah Brooks", "HB",
            "We are moving the product launch date from March 15 to April 1. This gives us two extra weeks for QA and localization. All feature work must be code-complete by March 20.",
            "3:01 PM",
            IsForwarded: true,
            OriginalSender: "VP of Product, Claire Dawson",
            OriginalChannel: "#leadership-sync"),
        new("m3", "Leo Grant", "LG",
            "That is great news. Two extra weeks is exactly what we needed for the edge cases in the payment flow. I will update the sprint board.",
            "3:04 PM"),
        new("m4", "Hannah Brooks", "HB",
            "The localization vendor confirmed all 12 languages will be ready by March 25. Japanese and Korean need extra review for character truncation in compact UI elements. Please flag any strings longer than 40 characters.",
            "3:06 PM",
            IsForwarded: true,
            OriginalSender: "Localization Lead, Yuki Tanaka",
            OriginalChannel: "#localization"),
        new("m5", "Amara Osei", "AO",
            "Good to know about the character limits. I already have a list of long strings from the notification system. Will share a spreadsheet by end of day.",
            "3:09 PM"),
        new("m6", "Leo Grant", "LG",
            "Also forwarding the updated performance benchmarks from the infrastructure team. Important for our optimization targets.",
            "3:12 PM"),
        new("m7", "Leo Grant", "LG",
            "Performance targets for launch: p95 page load under 2.5s, API response under 200ms, Lighthouse score above 90. Current metrics: 3.1s page load, 180ms API, Lighthouse 84. The page load is the critical gap. Main culprit is the product image carousel loading all variants upfront.",
            "3:13 PM",
            IsForwarded: true,
            OriginalSender: "SRE Lead, Derek Pham",
            OriginalChannel: "#infrastructure"),
        new("m8", "Amara Osei", "AO",
            "The carousel issue is on my radar. I have a lazy loading implementation ready that should drop us below 2.5s. Will open the PR today.",
            "3:16 PM"),
        new("m9", "Hannah Brooks", "HB",
            "Perfect. Let us aim to have all critical fixes merged by this Friday so we can run a full regression next week. I will send a summary to the leadership channel.",
            "3:20 PM"),
    ];

    private string _input = "";

    private bool IsNewGroup(int idx)
    {
        if (idx == 0) return true;
        var curr = _messages[idx];
        var prev = _messages[idx - 1];
        if (curr.Sender != prev.Sender) return true;
        if (curr.IsForwarded) return true;
        return false;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
