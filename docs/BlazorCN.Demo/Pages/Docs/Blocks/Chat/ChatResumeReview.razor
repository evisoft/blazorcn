@* ============================================================
   Block: chat-resume-review
   Title: ChatResumeReview
   Description: React resume review feedback chat block for Next.js with section scores, improvement suggestions, keyword analysis, ATS compatibility check, and actionable rewrite tips using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-resume-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="file-text" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Resume Reviewer</span>
                <p class="text-muted-foreground text-xs">AI-powered resume feedback</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Senior Frontend Engineer
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    var m = msg;
                    <div class="@(m.Role == "user" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(m.Role == "user" ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(m.Content))
                            {
                                <p class="text-sm leading-relaxed">@m.Content</p>
                            }
                            @if (m.Review != null)
                            {
                                var review = m.Review;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    @* Overall score *@
                                    <div class="mb-3 flex items-center gap-3 border-b pb-3">
                                        <div class="flex items-baseline gap-1">
                                            <span class="@($"font-semibold text-2xl tabular-nums {ScoreColor(review.OverallScore / 10.0)}")">
                                                @review.OverallScore
                                            </span>
                                            <span class="text-muted-foreground text-xs">/100</span>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            @(review.OverallScore >= 80 ? "Strong" : review.OverallScore >= 60 ? "Needs work" : "Weak")
                                        </BadgeCn>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="text-muted-foreground text-xs">
                                            @review.Sections.Length sections reviewed
                                        </span>
                                    </div>

                                    @* Section scores *@
                                    <div class="mb-3 space-y-0">
                                        @for (var i = 0; i < review.Sections.Length; i++)
                                        {
                                            var sec = review.Sections[i];
                                            var idx = i;
                                            var isLast = idx == review.Sections.Length - 1;
                                            <div>
                                                <div class="@($"px-1 py-2.5 {(isLast ? "" : "border-b")}")">
                                                    <div class="mb-1.5 flex items-center gap-2">
                                                        <span class="@($"size-1.5 shrink-0 rounded-full {ScoreDot(sec.Score)}")"></span>
                                                        <span class="flex-1 font-medium text-sm">@sec.Section</span>
                                                        <span class="@($"font-semibold text-sm tabular-nums {ScoreColor(sec.Score)}")">
                                                            @sec.Score/10
                                                        </span>
                                                    </div>
                                                    <p class="mb-1.5 pl-3.5 text-muted-foreground text-xs">@sec.Assessment</p>
                                                    @if (sec.Issues.Length > 0)
                                                    {
                                                        <div class="space-y-1 pl-3.5">
                                                            @foreach (var issue in sec.Issues)
                                                            {
                                                                <div class="flex items-start gap-1.5 text-xs">
                                                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                                                    <span class="text-muted-foreground">@issue</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    @if (sec.Rewrite != null)
                                                    {
                                                        var rw = sec.Rewrite;
                                                        var sectionName = sec.Section;
                                                        <div class="mt-2.5 ml-3.5 rounded-md bg-muted/50 p-3">
                                                            <div class="mb-1.5 flex items-center justify-between">
                                                                <span class="font-medium text-muted-foreground text-xs">
                                                                    Suggested rewrite
                                                                </span>
                                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                                          Class="h-6 gap-1 px-2 text-xs"
                                                                          @onclick="@(() => CopyText(sectionName, rw.Improved))">
                                                                    @if (_copied == sectionName)
                                                                    {
                                                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                                        @("Copied")
                                                                    }
                                                                    else
                                                                    {
                                                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                                                        @("Copy")
                                                                    }
                                                                </ButtonCn>
                                                            </div>
                                                            <p class="mb-2 text-muted-foreground text-xs line-through">
                                                                @rw.Original
                                                            </p>
                                                            <p class="text-sm leading-relaxed">@rw.Improved</p>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @* Keyword analysis *@
                                    @if (review.Keywords != null)
                                    {
                                        var kw = review.Keywords;
                                        <div class="mb-3 border-t pt-3">
                                            <div class="mb-2 flex items-center justify-between">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="target" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="font-medium text-sm">Keyword Match</span>
                                                </div>
                                                <span class="@($"font-semibold text-sm tabular-nums {ScoreColor(kw.MatchPercent / 10.0)}")">
                                                    @kw.MatchPercent%
                                                </span>
                                            </div>
                                            <div class="mb-2 flex flex-wrap gap-1">
                                                @foreach (var matched in kw.Matched)
                                                {
                                                    <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                                                        @matched
                                                    </span>
                                                }
                                            </div>
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var missing in kw.Missing)
                                                {
                                                    <span class="rounded-full bg-red-500/10 px-2 py-0.5 text-red-600 text-xs dark:text-red-400">
                                                        @missing
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* ATS issues *@
                                    @if (review.AtsIssues != null && review.AtsIssues.Length > 0)
                                    {
                                        var ats = review.AtsIssues;
                                        <div class="border-t pt-3">
                                            <div class="mb-2 flex items-center gap-1.5">
                                                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                                                <span class="font-medium text-sm">ATS Compatibility</span>
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                                                    @ats.Length issues
                                                </BadgeCn>
                                            </div>
                                            <div class="space-y-1.5">
                                                @foreach (var atsIssue in ats)
                                                {
                                                    <div class="flex items-start gap-1.5 text-xs">
                                                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                                                        <span class="text-muted-foreground">@atsIssue</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            <span class="@($"mt-1 block text-right text-xs {(m.Role == "user" ? "text-primary-foreground/60" : "text-muted-foreground")}")">
                                @m.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Ask about your resume or paste a section to review..."
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                          @onclick="HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record RewriteEntry(string Original, string Improved);
    private record SectionScore(string Section, int Score, string Assessment, string[] Issues, RewriteEntry? Rewrite = null);
    private record KeywordAnalysis(string[] Matched, string[] Missing, int MatchPercent);
    private record ReviewCard(int OverallScore, SectionScore[] Sections, KeywordAnalysis? Keywords = null, string[]? AtsIssues = null);
    private record Message(string Id, string Role, string Content, string Timestamp, ReviewCard? Review = null);

    private string _input = "";
    private string? _copied = null;

    private static string ScoreColor(double score)
    {
        if (score >= 8) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 5) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string ScoreDot(int score)
    {
        if (score >= 8) return "bg-emerald-500";
        if (score >= 5) return "bg-amber-500";
        return "bg-red-500";
    }

    private void CopyText(string id, string text)
    {
        _copied = id;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private static readonly Message[] _messages =
    [
        new("1", "user",
            "I'm applying for a Senior Frontend Engineer role at a Series B startup. Can you review my resume and check it against the job description I shared?",
            "11:00 AM"),
        new("2", "reviewer",
            "I've analyzed your resume against the Senior Frontend Engineer job description. Here's the detailed breakdown:",
            "11:01 AM"),
        new("3", "reviewer",
            "",
            "11:01 AM",
            new ReviewCard(
                68,
                [
                    new SectionScore(
                        "Professional Summary",
                        5,
                        "Too generic. Doesn't mention the specific tech stack or quantifiable impact.",
                        ["No mention of React, TypeScript, or Next.js", "Missing years of experience", "No measurable achievements"],
                        new RewriteEntry(
                            "Experienced frontend developer passionate about building great user experiences with modern web technologies.",
                            "Senior Frontend Engineer with 6+ years building production React and Next.js applications. Led a 4-person team that reduced page load times by 40% and increased conversion by 12% at a Series B fintech startup."
                        )
                    ),
                    new SectionScore(
                        "Work Experience",
                        7,
                        "Good structure but bullet points lack metrics. Action verbs could be stronger.",
                        ["Only 2 of 8 bullets include numbers", "Weak verbs: 'Helped with', 'Worked on'", "Missing context on team size and project scope"],
                        new RewriteEntry(
                            "Helped with migrating the frontend from JavaScript to TypeScript.",
                            "Led the migration of 120K LOC frontend codebase from JavaScript to TypeScript over 3 months, reducing runtime errors by 34% and onboarding time for new engineers from 2 weeks to 4 days."
                        )
                    ),
                    new SectionScore(
                        "Skills",
                        8,
                        "Well-organized with relevant technologies. Could add proficiency levels.",
                        ["Missing testing frameworks mentioned in job description", "Consider grouping by category"]
                    ),
                    new SectionScore(
                        "Education",
                        9,
                        "Clean and complete. GPA and relevant coursework included.",
                        []
                    ),
                ],
                new KeywordAnalysis(
                    ["React", "TypeScript", "Next.js", "REST APIs", "Git", "Agile", "CI/CD"],
                    ["Playwright", "Storybook", "Design Systems", "GraphQL", "Accessibility"],
                    58
                ),
                ["Section heading 'What I Do' should be 'Professional Summary'", "Skills listed in a 3-column table — use a simple comma-separated list", "PDF contains images in the header that ATS cannot parse"]
            )
        ),
        new("4", "user",
            "The summary rewrite is great. Should I tailor the skills section specifically for this role or keep it general?",
            "11:04 AM"),
        new("5", "reviewer",
            "Always tailor for the specific role. Move the 5 missing keywords — Playwright, Storybook, Design Systems, GraphQL, and Accessibility — to the top of your skills section if you have experience with them. Even basic familiarity is worth listing. The ATS scans for exact keyword matches, so having them present significantly increases your chances of passing the automated screening.",
            "11:05 AM"),
        new("6", "user",
            "I have experience with all of them except GraphQL. Should I still list it?",
            "11:06 AM"),
        new("7", "reviewer",
            "Only list skills you can speak to in an interview. Skip GraphQL but add a line in your cover letter expressing interest in learning it. Focus on the 4 you know and make sure your work experience bullets demonstrate them in context — for example, mention Playwright in a testing bullet, not just in the skills list.",
            "11:07 AM"),
    ];
}
