@* ============================================================
   Block: chat-password-manager
   Title: ChatPasswordManager
   Description: A secure password manager chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring credential cards, security score tracking, and password generation suggestions
   Source: original/blocks/chat/chat-password-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="shield" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Password Manager</h2>
                    <p class="text-xs text-muted-foreground">Security Score: 73/100</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">Active</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var msg in _messages)
            {
                var message = msg;
                <div class="@Cn.Merge("flex", message.Type == "user" ? "justify-end" : "justify-start")">
                    <div class="@Cn.Merge("max-w-[85%] space-y-2", message.Type == "user" ? "items-end" : "items-start")">
                        <div class="@Cn.Merge("rounded-lg px-3 py-2", message.Type == "user" ? "bg-foreground text-background" : "bg-muted")">
                            <p class="text-sm">@message.Content</p>
                        </div>

                        @if (message.Credential != null)
                        {
                            var cred = message.Credential;
                            <div class="w-full rounded-lg border bg-card p-3">
                                <div class="mb-3 flex items-start justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="key-round" Size="16" Class="size-4 text-muted-foreground" />
                                        <span class="text-sm font-medium">@cred.Service</span>
                                    </div>
                                    @if (cred.Breached)
                                    {
                                        <div class="flex items-center gap-1 rounded-md bg-red-500/10 px-2 py-0.5">
                                            <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-red-500" />
                                            <span class="text-xs text-red-500">Breached</span>
                                        </div>
                                    }
                                </div>

                                <div class="space-y-2">
                                    <div>
                                        <span class="text-xs text-muted-foreground">Username</span>
                                        <div class="mt-1 flex items-center justify-between rounded-md bg-muted/50 px-2 py-1.5">
                                            <span class="font-mono text-xs">@cred.Username</span>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-5 w-5" aria-label="Copy">
                                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                            </ButtonCn>
                                        </div>
                                    </div>

                                    <div>
                                        <span class="text-xs text-muted-foreground">Password</span>
                                        <div class="mt-1 flex items-center justify-between rounded-md bg-muted/50 px-2 py-1.5">
                                            <span class="font-mono text-xs">
                                                @(_visiblePasswords.Contains(message.Id) ? cred.Password : "••••••••••")
                                            </span>
                                            <div class="flex items-center gap-1">
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-5 w-5"
                                                          @onclick="@(() => TogglePasswordVisibility(message.Id))" aria-label="Hide">
                                                    @if (_visiblePasswords.Contains(message.Id))
                                                    {
                                                        <LucideIconCn Name="eye-off" Size="12" Class="size-3" />
                                                    }
                                                    else
                                                    {
                                                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                                    }
                                                </ButtonCn>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-5 w-5" aria-label="Copy">
                                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                                </ButtonCn>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex items-center justify-between pt-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs text-muted-foreground">Strength:</span>
                                            <span class="@Cn.Merge("text-xs font-medium capitalize", GetStrengthColor(cred.Strength))">
                                                @cred.Strength
                                            </span>
                                        </div>
                                        <span class="text-xs text-muted-foreground">Updated @cred.LastUpdated</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0" aria-label="AI suggestions">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="Ask about your passwords..."
                         Class="border-0 bg-transparent shadow-none focus-visible:ring-0" aria-label="Ask about your passwords..." />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0" Disabled="@string.IsNullOrWhiteSpace(_input)" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Credential(
        string Service,
        string Username,
        string Password,
        string Strength,
        string LastUpdated,
        bool Breached
    );

    private record ChatMessage(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        Credential? Credential = null
    );

    private string _input = "";
    private HashSet<string> _visiblePasswords = new();

    private static readonly ChatMessage[] _messages =
    [
        new("1", "assistant",
            "Hello! I'm your password security assistant. How can I help you today?",
            "10:30 AM"),
        new("2", "user",
            "What's my overall security score?",
            "10:31 AM"),
        new("3", "assistant",
            "Your current security score is 73/100. You have 3 weak passwords and 2 credentials that may be compromised. I recommend updating your GitHub and Netflix passwords immediately.",
            "10:31 AM"),
        new("4", "user",
            "Show me my GitHub credentials",
            "10:32 AM"),
        new("5", "assistant",
            "Here are your GitHub credentials. This password was found in a data breach and should be changed immediately.",
            "10:32 AM",
            new Credential("GitHub", "john.developer@email.com", "Summer2023!", "weak", "8 months ago", true)),
    ];

    private void TogglePasswordVisibility(string id)
    {
        if (_visiblePasswords.Contains(id))
            _visiblePasswords.Remove(id);
        else
            _visiblePasswords.Add(id);
    }

    private static string GetStrengthColor(string strength) => strength switch
    {
        "weak"   => "text-red-500",
        "medium" => "text-amber-500",
        "strong" => "text-emerald-500",
        _        => "text-muted-foreground",
    };

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
