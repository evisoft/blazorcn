@* ============================================================
   Block: chat-news-digest
   Title: ChatNewsDigest
   Description: A news digest chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring article cards, source badges, and AI-generated summaries
   Source: original/blocks/chat/chat-news-digest.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-orange-500/10">
                <LucideIconCn Name="newspaper" Size="16" Class="size-4 text-orange-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">News Digest</h3>
                <p class="text-xs text-muted-foreground">Personalized daily briefing</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                12 new
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                var msg = message;
                <div class="@Cn.Merge("mb-4 flex gap-3", msg.Sender == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarImageCn Src="" Alt="" />
                        <AvatarFallbackCn Class="@Cn.Merge(msg.Sender == "ai" ? "bg-orange-500/10 text-orange-600" : "bg-muted")">
                            @(msg.Sender == "ai" ? "AI" : "ME")
                        </AvatarFallbackCn>
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", msg.Sender == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2", msg.Sender == "ai" ? "bg-muted" : "bg-orange-500/10 text-orange-900 dark:text-orange-100")">
                            <p class="text-sm">@msg.Content</p>
                        </div>

                        @* Article Cards *@
                        @if (msg.Articles != null && msg.Articles.Length > 0)
                        {
                            <div class="mt-2 w-full max-w-sm space-y-3">
                                @foreach (var article in msg.Articles)
                                {
                                    var art = article;
                                    <div class="overflow-hidden rounded-lg border bg-card">
                                        <div class="border-b bg-muted/50 px-3 py-2">
                                            <div class="mb-2 flex items-start justify-between gap-2">
                                                <h4 class="flex-1 font-medium text-sm leading-tight">@art.Title</h4>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-xs">@art.Source</BadgeCn>
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-xs">@art.Category</BadgeCn>
                                                @if (art.Credibility == "high")
                                                {
                                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                                }
                                            </div>
                                        </div>

                                        <div class="p-3">
                                            <p class="mb-3 text-xs leading-relaxed text-muted-foreground">@art.Summary</p>

                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                    @art.PublishedAt
                                                </div>
                                                <div class="flex gap-1">
                                                    <ButtonCn aria-label="@($"Bookmark {art.Title}")" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 w-6 p-0">
                                                        <LucideIconCn Name="bookmark" Size="12" Class="size-3" />
                                                    </ButtonCn>
                                                    <ButtonCn aria-label="@($"Share {art.Title}")" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 w-6 p-0">
                                                        <LucideIconCn Name="share-2" Size="12" Class="size-3" />
                                                    </ButtonCn>
                                                    <a aria-label="@($"Open {art.Title}")" href="@art.Url" target="_blank" rel="noopener noreferrer"
                                                       class="inline-flex h-6 w-6 items-center justify-center rounded-md p-0 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                                                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form @onsubmit="HandleSend" @onsubmit:preventDefault="true" class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about any topic..." Class="flex-1" aria-label="Ask about any topic..." />
                <ButtonCn aria-label="Send message" Size="ButtonSize.Sm" Class="shrink-0" OnClick="HandleSend">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
            <p class="mt-2 text-xs text-muted-foreground">
                Try: "Technology news" or "What's happening in AI?"
            </p>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Article(
        string Title,
        string Source,
        string Category,
        string PublishedAt,
        string Summary,
        string Url,
        string Credibility);

    private record Message(string Id, string Sender, string Content, string Timestamp, Article[]? Articles = null);

    private List<Message> _messages =
    [
        new("1", "ai",
            "Good morning! Here's your personalized news digest for today. What topics are you interested in?",
            "8:00 AM"),
        new("2", "user",
            "Show me the latest tech news",
            "8:01 AM"),
        new("3", "ai",
            "Here are the top tech stories from the past 24 hours. I've highlighted the most relevant articles for you:",
            "8:01 AM",
            [
                new("AI Startup Raises $100M in Series B Funding",
                    "TechCrunch",
                    "AI & ML",
                    "2 hours ago",
                    "VectorAI secures significant funding round led by Sequoia Capital to expand its AI code review platform. The company plans to triple its engineering team and launch new developer tools by Q3.",
                    "#",
                    "high"),
                new("New Framework Promises 10x Performance Boost",
                    "The Verge",
                    "Web Development",
                    "4 hours ago",
                    "Open-source framework TurboStack claims dramatic performance improvements for React applications. Early benchmarks show impressive results, though developers urge caution before production adoption.",
                    "#",
                    "high"),
            ]),
        new("4", "user",
            "Tell me more about the AI startup",
            "8:03 AM"),
        new("5", "ai",
            "VectorAI is an AI-powered code review platform founded in 2024. Their Series B brings total funding to $150M. The platform uses machine learning to automatically detect bugs, security vulnerabilities, and code quality issues. Over 500 companies currently use their tools.",
            "8:03 AM"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"news-digest-msg-{_messages.Count + 1}", "user", _input, "Just now"));
        _input = "";
    }
}
