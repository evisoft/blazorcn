@* ============================================================
   Block: chat-ai-image-generation
   Title: ChatAiImageGeneration
   Description: AI-powered image generation chat with prompt input, generation progress indicators, and inline image results built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-ai-image-generation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-lg bg-muted">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-foreground" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">AI Image Generator</h3>
                <p class="text-xs text-muted-foreground">Powered by AI • Create stunning visuals</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="wand" Size="14" Class="size-3.5" />
                Templates
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                var isUser = message.Type == "user";
                <div class="@Cn.Merge("flex gap-3", isUser ? "flex-row-reverse" : "")">

                    @* Avatar *@
                    <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", isUser ? "bg-blue-500 text-white" : "bg-muted")">
                        @if (isUser)
                        {
                            <span class="text-xs font-medium">You</span>
                        }
                        else
                        {
                            <LucideIconCn Name="image" Size="16" Class="size-4" />
                        }
                    </div>

                    @* Message Content *@
                    <div class="@Cn.Merge("flex-1 space-y-2", isUser ? "flex flex-col items-end" : "")">
                        @if (message.Type == "image")
                        {
                            <div class="max-w-md space-y-2">
                                @if (message.Generating)
                                {
                                    <div class="space-y-3 rounded-lg border bg-muted/50 p-4">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="sparkles" Size="16" Class="size-4 animate-pulse text-blue-500" />
                                            <span class="text-sm font-medium">Generating image...</span>
                                        </div>
                                        <ProgressCn Value="@(message.Progress)" Class="h-1" aria-label="Progress" />
                                        <p class="text-xs text-muted-foreground">This may take 10-30 seconds</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="overflow-hidden rounded-lg border">
                                        <img src="@message.ImageUrl" alt="Generated" class="h-auto w-full" />
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                                            Download
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                            <LucideIconCn Name="wand" Size="12" Class="size-3" />
                                            Refine
                                        </ButtonCn>
                                        <span class="ml-auto text-xs text-muted-foreground">@message.Timestamp</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="@Cn.Merge("max-w-md rounded-lg px-3 py-2", isUser ? "bg-blue-500 text-white" : "bg-muted")">
                                <p class="text-sm">@message.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", isUser ? "text-blue-100" : "text-muted-foreground")">
                                    @message.Timestamp
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         @onkeydown="HandleKeyDown"
                         Placeholder="Describe the image you want to generate..."
                         Class="flex-1" aria-label="Describe the image you want to generate..." />
                <ButtonCn @onclick="HandleSend" Disabled="@(!_input.Trim().Any())" Class="gap-1.5">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                    Generate
                </ButtonCn>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                Try: "A futuristic city with flying cars" or "Abstract art in blue and gold"
            </p>
        </div>

    </div>
</section>

@code {
    private record Message(string Id, string Type, string Content, string Timestamp,
        string? ImageUrl = null, bool Generating = false, int Progress = 0);

    private List<Message> _messages =
    [
        new("1", "assistant", "Welcome to AI Image Generation! Describe the image you'd like to create.", "2 hours ago"),
        new("2", "user", "A serene mountain landscape at sunset with a lake reflection", "2 hours ago"),
        new("3", "image", "Generated your image", "2 hours ago", "https://images.unsplash.com/photo-1506905925346-21bda4d32df4"),
        new("4", "user", "Make it more vibrant with autumn colors", "1 hour ago"),
        new("5", "image", "Generated your image", "1 hour ago", "https://images.unsplash.com/photo-1511593358241-7eea1f3c84e5"),
    ];

    private string _input = "";

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var userMessage = new Message(
            Id: DateTime.Now.Ticks.ToString(),
            Type: "user",
            Content: _input,
            Timestamp: "Just now");

        var generatingMessage = new Message(
            Id: (DateTime.Now.Ticks + 1).ToString(),
            Type: "image",
            Content: "Generating image...",
            Timestamp: "Just now",
            Generating: true,
            Progress: 0);

        _messages = [.._messages, userMessage, generatingMessage];
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSend();
    }
}
