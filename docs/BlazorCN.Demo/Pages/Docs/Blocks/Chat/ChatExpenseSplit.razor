@* ============================================================
   Block: chat-expense-split
   Title: ChatExpenseSplit
   Description: React expense splitting chat interface for Next.js with payment cards, participant breakdowns, settlement status indicators, and balance summaries using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-expense-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Saturday Night Out</span>
                <p class="text-muted-foreground text-xs">4 members</p>
            </div>
            <div class="text-right">
                <span class="font-medium text-sm tabular-nums">$220.40</span>
                <p class="text-muted-foreground text-xs">total</p>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-3">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    var msgIndex = System.Array.IndexOf(_messages, message);

                    @if (message.Type == "settlement" && message.Settlement != null)
                    {
                        @* Settlement banner *@
                        <div class="mx-auto my-1 max-w-sm px-2">
                            <div class="rounded-md border border-emerald-500/20 bg-emerald-500/5 px-3 py-2">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm">
                                            <span class="font-medium">@message.Settlement.From</span> paid
                                            <span class="font-medium">@message.Settlement.To</span>
                                        </span>
                                        <span class="ml-1.5 font-semibold text-sm tabular-nums">@message.Settlement.Amount</span>
                                    </div>
                                    <span class="shrink-0 text-muted-foreground text-[10px]">@message.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        var isMe = message.Sender == "me";
                        var showHeader = IsFirstInGroup(msgIndex);

                        <div class="@Cn.Merge("flex flex-col", isMe ? "items-end" : "items-start")">
                            @if (showHeader)
                            {
                                <div class="mb-0.5 flex items-center gap-1.5 px-1">
                                    <span class="font-medium text-xs">@message.SenderName</span>
                                    <span class="text-muted-foreground text-[10px]">@message.Timestamp</span>
                                </div>
                            }
                            @if (message.Type == "text" && !string.IsNullOrEmpty(message.Content))
                            {
                                <div class="@Cn.Merge("max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed", isMe ? "bg-foreground text-background" : "bg-muted text-foreground")">
                                    @message.Content
                                </div>
                            }
                            @if (message.Type == "expense" && message.Expense != null)
                            {
                                var expense = message.Expense;
                                var paidCount = System.Linq.Enumerable.Count(expense.Participants, p => p.Status == "paid");
                                var totalCount = expense.Participants.Length;
                                var hasYouPending = System.Linq.Enumerable.Any(expense.Participants, p => p.Name == "You" && p.Status == "pending");

                                @* Expense card *@
                                <div class="mt-1.5 w-full max-w-sm overflow-hidden rounded-md border">
                                    @* Header *@
                                    <div class="flex items-center gap-2 border-b px-3 py-2">
                                        <LucideIconCn Name="receipt" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">Expense</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-[10px]">
                                            @expense.Category
                                        </BadgeCn>
                                    </div>

                                    @* Amount + description *@
                                    <div class="border-b px-3 py-2.5">
                                        <p class="font-medium text-sm">@expense.Description</p>
                                        <div class="mt-1 flex items-baseline gap-2">
                                            <span class="font-semibold text-xl tabular-nums">@expense.TotalAmount</span>
                                            <span class="text-muted-foreground text-xs">paid by @expense.PaidBy</span>
                                        </div>
                                    </div>

                                    @* Participants *@
                                    <div class="px-3 py-2">
                                        <div class="mb-1.5 flex items-center justify-between">
                                            <span class="font-medium text-muted-foreground text-xs">
                                                Split (@totalCount people)
                                            </span>
                                            <span class="text-muted-foreground text-xs">
                                                @paidCount/@totalCount settled
                                            </span>
                                        </div>
                                        <div class="flex flex-col gap-1.5">
                                            @foreach (var p in expense.Participants)
                                            {
                                                var participant = p;
                                                <div class="flex items-center gap-2">
                                                    <AvatarCn Class="size-5">
                                                        <AvatarFallbackCn Class="text-[8px]">@participant.Initials</AvatarFallbackCn>
                                                    </AvatarCn>
                                                    <span class="min-w-0 flex-1 text-sm">@participant.Name</span>
                                                    <span class="font-mono text-xs tabular-nums">@participant.Share</span>
                                                    @if (participant.Status == "paid")
                                                    {
                                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                                    }
                                                    else
                                                    {
                                                        <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @* Settle action *@
                                    @if (hasYouPending)
                                    {
                                        <div class="border-t px-3 py-2">
                                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 w-full gap-1.5 text-xs">
                                                <LucideIconCn Name="circle-dollar-sign" Size="12" Class="size-3" />
                                                Settle up your share
                                            </ButtonCn>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="flex items-center gap-2">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Receipt">
                    <LucideIconCn Name="receipt" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input" Placeholder="Type a message..." Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Disabled="@(string.IsNullOrWhiteSpace(_input))" Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Participant(string Name, string Initials, string Share, string Status);

    private record Expense(string Description, string TotalAmount, string PaidBy, string Category, Participant[] Participants);

    private record Settlement(string From, string To, string Amount);

    private record ChatMessage(string Id, string Type, string Sender, string SenderName, string Initials, string Timestamp, string? Content = null, Expense? Expense = null, Settlement? Settlement = null);

    private readonly ChatMessage[] _messages =
    [
        new("1", "text", "them", "Jake Ortiz", "JO", "9:42 PM", Content: "Had a great dinner tonight! Let me log the bill."),
        new("2", "expense", "them", "Jake Ortiz", "JO", "9:43 PM", Expense: new Expense(
            "Dinner at Osteria Mozza", "$186.40", "Jake Ortiz", "Dining",
            [
                new Participant("Jake Ortiz", "JO", "$46.60", "paid"),
                new Participant("You", "YO", "$46.60", "pending"),
                new Participant("Priya Shah", "PS", "$46.60", "paid"),
                new Participant("Leo Nguyen", "LN", "$46.60", "pending"),
            ]
        )),
        new("3", "settlement", "system", "System", "", "9:48 PM", Settlement: new Settlement("Priya Shah", "Jake Ortiz", "$46.60")),
        new("4", "text", "me", "You", "YO", "9:50 PM", Content: "Priya already settled up, nice! I'll send mine tomorrow morning."),
        new("5", "text", "them", "Jake Ortiz", "JO", "9:52 PM", Content: "No rush. Also, here's the Uber we split on the way there."),
        new("6", "expense", "them", "Jake Ortiz", "JO", "9:52 PM", Expense: new Expense(
            "Uber XL to restaurant", "$34.00", "Jake Ortiz", "Transport",
            [
                new Participant("Jake Ortiz", "JO", "$8.50", "paid"),
                new Participant("You", "YO", "$8.50", "pending"),
                new Participant("Priya Shah", "PS", "$8.50", "pending"),
                new Participant("Leo Nguyen", "LN", "$8.50", "pending"),
            ]
        )),
        new("7", "text", "me", "You", "YO", "9:55 PM", Content: "Got it. I owe you $55.10 total then. Will Venmo you in the morning."),
    ];

    private bool IsFirstInGroup(int index)
    {
        if (index == 0) return true;
        var prev = _messages[index - 1];
        var curr = _messages[index];
        return prev.SenderName != curr.SenderName || prev.Type == "settlement";
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
