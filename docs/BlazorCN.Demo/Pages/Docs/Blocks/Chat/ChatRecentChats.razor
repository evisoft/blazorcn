@* ============================================================
   Block: chat-recent-chats
   Title: ChatRecentChats
   Description: React recent conversations compact widget for Next.js with small avatars, online status dots, message previews, unread indicators, and view-all link using TypeScript, shadcn/ui, Tailwind CSS, and Lucide React icons
   Source: original/blocks/chat/chat-recent-chats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <div class="flex h-[500px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
            <span class="flex-1 font-medium text-sm">Recent Chats</span>
            <span class="text-muted-foreground text-xs">
                @(_recentChats.Count(c => c.Unread)) new
            </span>
        </div>

        @* Chat list *@
        <div class="flex-1">
            @foreach (var chat in _recentChats)
            {
                var item = chat;
                var idx = Array.IndexOf(_recentChats, item);
                <button type="button"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", idx < _recentChats.Length - 1 ? "border-b" : "")">
                    <div class="relative shrink-0">
                        <AvatarCn Class="size-8">
                            <AvatarFallbackCn Class="text-[10px]">@item.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        @if (item.IsOnline)
                        {
                            <span class="absolute right-0 bottom-0 size-2 rounded-full border border-card bg-emerald-500"></span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <span class="@Cn.Merge("truncate text-sm", item.Unread ? "font-semibold" : "font-medium")">
                                @item.Name
                            </span>
                            <span class="shrink-0 text-muted-foreground text-[10px]">
                                @item.Timestamp
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <p class="@Cn.Merge("mt-0.5 truncate text-xs", item.Unread ? "text-foreground" : "text-muted-foreground")">
                                @item.Preview
                            </p>
                            @if (item.Unread)
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                            }
                        </div>
                    </div>
                </button>
            }
        </div>

        @* View all *@
        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 w-full gap-2 text-muted-foreground text-xs hover:text-foreground">
                View all conversations
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record RecentChat(string Id, string Name, string Initials, string Preview, string Timestamp, bool IsOnline, bool Unread);

    private static readonly RecentChat[] _recentChats =
    [
        new("1", "Mara Chen",     "MC", "Chromatic should pick up the snapshots automatically", "2 min ago",  true,  true),
        new("2", "Alex Rivera",   "AR", "I pushed the migration script to staging",              "15 min ago", true,  true),
        new("3", "Jordan Davis",  "JD", "Sounds good, starting after standup",                  "1 hr ago",   false, false),
        new("4", "Priya Sharma",  "PS", "Variant B outperformed by 23% on conversions",         "2 hrs ago",  true,  false),
        new("5", "Sam Nguyen",    "SN", "Deployed the hotfix to production",                    "3 hrs ago",  false, false),
    ];
}
