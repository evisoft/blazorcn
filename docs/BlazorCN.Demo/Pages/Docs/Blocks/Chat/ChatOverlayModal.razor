@* ============================================================
   Block: chat-overlay-modal
   Title: ChatOverlayModal
   Description: React centered modal chat overlay block for Next.js with semi-transparent backdrop, animated dialog window, message thread, and inline input using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-overlay-modal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Background placeholder content *@
        <div class="flex h-full flex-col items-center justify-center gap-6 p-8">
            <div class="space-y-2 text-center">
                <p class="font-medium text-sm">Your Application</p>
                <p class="text-muted-foreground text-xs">
                    Dashboard content is visible behind the chat overlay
                </p>
            </div>
            <div class="grid w-full max-w-sm grid-cols-2 gap-3">
                <div class="rounded-md bg-muted/50 p-4">
                    <p class="font-mono text-muted-foreground text-xs">Revenue</p>
                    <p class="mt-1 font-semibold text-lg tabular-nums">$12,480</p>
                </div>
                <div class="rounded-md bg-muted/50 p-4">
                    <p class="font-mono text-muted-foreground text-xs">Users</p>
                    <p class="mt-1 font-semibold text-lg tabular-nums">1,204</p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                      Class="h-8 gap-2 text-xs"
                      OnClick="@(() => _isOpen = true)">
                <LucideIconCn Name="message-circle" Size="14" Class="size-3.5" />
                Open Chat
            </ButtonCn>
        </div>

        @* Modal overlay *@
        @if (_isOpen)
        {
            @* Backdrop *@
            <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"
                 role="button"
                 tabindex="-1"
                 aria-label="Close chat overlay"
                 @onclick="@(() => _isOpen = false)"
                 @onkeydown="HandleBackdropKeyDown">
            </div>

            @* Chat modal *@
            <div class="absolute inset-x-6 top-1/2 flex h-[540px] -translate-y-1/2 flex-col overflow-hidden rounded-xl border bg-card shadow-lg">
                @* Header *@
                <div class="flex items-center gap-3 border-b px-4 py-3">
                    <AvatarCn Class="size-7">
                        <AvatarFallbackCn Class="text-xs">AC</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-sm">Alex Chen</p>
                        <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            Typically replies in minutes
                        </p>
                    </div>
                    <ButtonCn aria-label="Close chat" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="size-7 p-0"
                              OnClick="@(() => _isOpen = false)">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>

                @* Messages - flat layout *@
                <div class="flex-1 overflow-y-auto py-2" tabindex="0" role="group" aria-label="Messages">
                    @foreach (var grp in _grouped)
                    {
                        var group = grp;
                        <div class="mb-1">
                            @for (int gi = 0; gi < group.Length; gi++)
                            {
                                var msg = group[gi];
                                var isFirst = gi == 0;
                                <div class="flex gap-2 px-4 py-0.5 hover:bg-accent">
                                    <div class="flex w-8 shrink-0 items-start justify-center pt-0.5">
                                        @if (isFirst)
                                        {
                                            <AvatarCn Class="size-7">
                                                <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                        }
                                        else
                                        {
                                            <span class="pt-1 text-muted-foreground text-[10px] opacity-0 group-hover:opacity-100">
                                                @msg.Time
                                            </span>
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        @if (isFirst)
                                        {
                                            <div class="flex items-center gap-2">
                                                <span class="font-medium text-sm">@msg.Sender</span>
                                                <span class="text-muted-foreground text-[10px]">@msg.Time</span>
                                            </div>
                                        }
                                        <p class="text-sm leading-relaxed">@msg.Content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Input *@
                <div class="border-t px-4 py-3">
                    <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                        <input @bind="_input"
                               @bind:event="oninput"
                               placeholder="Type your message..."
                               class="h-8 min-w-0 flex-1 border-0 bg-transparent px-0 text-sm shadow-none outline-none focus-visible:ring-0 placeholder:text-muted-foreground" aria-label="Type your message..." />
                        <ButtonCn aria-label="Send message" type="submit" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                                  Disabled="@string.IsNullOrWhiteSpace(_input)"
                                  Class="size-8 shrink-0 p-0">
                            <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </form>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Initials, string Content, string Time);

    private bool _isOpen = true;
    private string _input = "";

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "Alex Chen", "AC", "Welcome to Acme Support! I'm Alex. How can I assist you today?", "3:00 PM"),
        new("m2", "Alex Chen", "AC", "I can see your account is on the Starter plan. Were you looking to make changes?", "3:00 PM"),
        new("m3", "You", "YO", "I need to upgrade my plan from Starter to Pro but I want to keep my current billing cycle.", "3:01 PM"),
        new("m4", "Alex Chen", "AC", "Of course! I can upgrade you right away. You'll be prorated for the remaining days in your current cycle, so you only pay the difference.", "3:01 PM"),
        new("m5", "You", "YO", "That sounds great. Will I lose any data during the transition?", "3:02 PM"),
        new("m6", "Alex Chen", "AC", "No data loss at all. Your workspace, projects, and team members stay exactly as they are. You'll immediately get access to Pro features like advanced analytics and priority support.", "3:03 PM"),
        new("m7", "You", "YO", "Perfect. Please go ahead with the upgrade.", "3:03 PM"),
        new("m8", "Alex Chen", "AC", "Done! Your account has been upgraded to Pro. You should see the new features available in your dashboard now. Is there anything else I can help with?", "3:04 PM"),
    ];

    private ChatMessage[][] _grouped = [];

    protected override void OnInitialized()
    {
        _grouped = GroupMessages(_messages);
    }

    private static ChatMessage[][] GroupMessages(ChatMessage[] msgs)
    {
        var groups = new System.Collections.Generic.List<System.Collections.Generic.List<ChatMessage>>();
        foreach (var msg in msgs)
        {
            if (groups.Count > 0 && groups[^1][0].Sender == msg.Sender)
                groups[^1].Add(msg);
            else
                groups.Add([msg]);
        }
        return groups.Select(g => g.ToArray()).ToArray();
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private void HandleBackdropKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _isOpen = false;
    }
}
