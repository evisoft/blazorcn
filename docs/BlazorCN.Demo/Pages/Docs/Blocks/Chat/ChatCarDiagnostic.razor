@* ============================================================
   Block: chat-car-diagnostic
   Title: ChatCarDiagnostic
   Description: React car diagnostic assistant chat block for Next.js with vehicle issue cards, severity indicators, repair cost estimates, part lists, and maintenance timeline using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-car-diagnostic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="car" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Car Diagnostic Assistant</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Automotive
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">
                    Diagnostics, repairs, and maintenance
                </span>
            </div>
        </div>

        @* Vehicle info bar *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2">
            <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
            <span class="text-muted-foreground text-xs">
                @_vehicleInfo.Year @_vehicleInfo.Make @_vehicleInfo.Model
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="font-mono text-muted-foreground text-xs">@_vehicleInfo.Mileage</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "user" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "user"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Issues != null)
                            {
                                var issues = msg.Issues;
                                <div class="mt-2 rounded-md border bg-card">
                                    @foreach (var (issue, index) in issues.Select((iss, i) => (iss, i)))
                                    {
                                        var isLast = index == issues.Length - 1;
                                        var isExpanded = _expandedIssue == issue.Id;
                                        var issueId = issue.Id;
                                        var urgencyDotClass = issue.Urgency == "urgent" ? "bg-red-500"
                                            : issue.Urgency == "soon" ? "bg-amber-500"
                                            : "bg-emerald-500";
                                        var urgencyLabelText = issue.Urgency == "urgent" ? "Urgent"
                                            : issue.Urgency == "soon" ? "Service soon"
                                            : "Routine";
                                        <div class="@(isLast ? "" : "border-b")">
                                            <button
                                                type="button"
                                                @onclick="@(() => ToggleIssue(issueId))"
                                                class="flex w-full items-center gap-3 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                                <span class="@($"size-2 shrink-0 rounded-full {urgencyDotClass}")" />
                                                <div class="min-w-0 flex-1">
                                                    <span class="font-medium text-sm">@issue.Title</span>
                                                    <p class="mt-0.5 font-mono text-muted-foreground text-xs">@issue.Code</p>
                                                </div>
                                                <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                                            </button>
                                            @if (isExpanded)
                                            {
                                                <div class="px-3 pb-3 pl-8">
                                                    <div class="mb-2 flex items-center gap-2">
                                                        <span class="text-muted-foreground text-xs">@urgencyLabelText</span>
                                                        <span class="text-muted-foreground text-xs">·</span>
                                                        <span class="font-medium text-sm tabular-nums">@issue.EstimatedCost</span>
                                                    </div>
                                                    <p class="text-muted-foreground text-sm leading-relaxed">@issue.Description</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (msg.Estimate != null)
                            {
                                var est = msg.Estimate;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="wrench" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">@est.Title</span>
                                    </div>
                                    <div class="space-y-0">
                                        <div class="pb-1.5">
                                            <span class="text-muted-foreground text-xs">Parts</span>
                                        </div>
                                        @foreach (var part in est.Parts)
                                        {
                                            <div class="flex items-center justify-between border-t py-1.5">
                                                <div class="min-w-0 flex-1">
                                                    <span class="text-sm">@part.Name</span>
                                                    <p class="font-mono text-muted-foreground text-xs">@part.PartNo</p>
                                                </div>
                                                <span class="shrink-0 font-mono text-sm tabular-nums">@part.Price</span>
                                            </div>
                                        }
                                        <div class="flex items-center justify-between border-t py-1.5">
                                            <div>
                                                <span class="text-sm">Labor</span>
                                                <p class="text-muted-foreground text-xs">
                                                    @est.LaborHours at @est.LaborRate
                                                </p>
                                            </div>
                                            <span class="font-mono text-sm tabular-nums">$180</span>
                                        </div>
                                    </div>
                                    <div class="mt-2 flex items-center justify-between border-t pt-2.5">
                                        <span class="text-muted-foreground text-xs">Estimated total</span>
                                        <span class="font-semibold text-lg tabular-nums">@est.Total</span>
                                    </div>
                                </div>
                            }
                            @if (msg.Maintenance != null)
                            {
                                var maintenance = msg.Maintenance;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="gauge" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">Upcoming Maintenance</span>
                                    </div>
                                    <div class="space-y-0">
                                        @foreach (var (item, idx) in maintenance.Select((m, i) => (m, i)))
                                        {
                                            var dotClass = idx == 0 ? "bg-red-500" : "bg-muted-foreground/30";
                                            <div class="@($"flex items-center gap-3 py-2{(idx > 0 ? " border-t" : "")}")">
                                                <span class="@($"size-2 shrink-0 rounded-full {dotClass}")" />
                                                <div class="min-w-0 flex-1">
                                                    <span class="text-sm">@item.Service</span>
                                                    <p class="text-muted-foreground text-xs">@item.Mileage</p>
                                                </div>
                                                <span class="shrink-0 text-muted-foreground text-xs">@item.Timeframe</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <span class="@(msg.Role == "user"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Describe the issue with your vehicle..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private string? _expandedIssue = "d1";

    private record VehicleInfo(string Make, string Model, string Year, string Mileage);

    private record DiagnosticIssue(
        string Id,
        string Title,
        string Code,
        string Urgency,
        string Description,
        string EstimatedCost);

    private record Part(string Name, string PartNo, string Price);

    private record RepairEstimate(
        string Title,
        Part[] Parts,
        string LaborHours,
        string LaborRate,
        string Total);

    private record MaintenanceItem(string Service, string Mileage, string Timeframe);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        DiagnosticIssue[]? Issues = null,
        RepairEstimate? Estimate = null,
        MaintenanceItem[]? Maintenance = null);

    private readonly VehicleInfo _vehicleInfo = new("Honda", "Civic", "2021", "47,200 mi");

    private readonly Message[] _messages =
    [
        new("1", "user",
            "My 2021 Honda Civic is making a grinding noise when I brake, and the check engine light came on yesterday. The car has about 47,000 miles on it.",
            "11:30 AM"),
        new("2", "assistant",
            "I've run a diagnostic analysis based on your symptoms. Here's what I found for your 2021 Honda Civic:",
            "11:31 AM"),
        new("3", "assistant", "", "11:31 AM",
            Issues:
            [
                new("d1",
                    "Front brake pads critically worn",
                    "BRAKE-FP-001",
                    "urgent",
                    "The grinding noise during braking indicates the front brake pads have worn past the minimum thickness. Continued driving risks scoring the rotors, which significantly increases repair cost. The wear sensors may have triggered the dashboard warning.",
                    "$280 - $420"),
                new("d2",
                    "Catalytic converter efficiency below threshold",
                    "P0420",
                    "soon",
                    "The P0420 code indicates the catalytic converter is operating below the expected efficiency threshold. This is common around 45-50k miles and often starts with intermittent check engine light activation. Not immediately dangerous but will fail an emissions test.",
                    "$800 - $1,400"),
                new("d3",
                    "Rear brake pads at 40% life remaining",
                    "BRAKE-RP-002",
                    "routine",
                    "Rear brake pads still have approximately 40% pad life. No immediate action needed, but plan to replace them within the next 15,000-20,000 miles to avoid rotor damage.",
                    "$220 - $340"),
            ]),
        new("4", "user",
            "The front brakes sound like the priority. Can you give me a detailed repair estimate for those?",
            "11:33 AM"),
        new("5", "assistant", "Here's the full breakdown for the front brake job:", "11:34 AM"),
        new("6", "assistant", "", "11:34 AM",
            Estimate: new(
                "Front Brake Pad Replacement",
                [
                    new("Front ceramic brake pads (set)", "HN-BP-2021C", "$68"),
                    new("Front brake rotors (pair)", "HN-RT-2021F", "$124"),
                    new("Brake hardware kit", "HN-BH-UNIV", "$18"),
                    new("Brake cleaner & lubricant", "MISC-BC-01", "$12"),
                ],
                "1.5 hours",
                "$120 / hour",
                "$402")),
        new("7", "user",
            "What about my upcoming maintenance schedule? I want to stay ahead of things.",
            "11:36 AM"),
        new("8", "assistant",
            "Based on your current mileage and Honda's maintenance schedule, here's what's coming up:",
            "11:37 AM"),
        new("9", "assistant", "", "11:37 AM",
            Maintenance:
            [
                new("Front brake pad replacement", "Now (47,200 mi)", "Immediately"),
                new("Transmission fluid change", "50,000 mi", "About 2 months"),
                new("Spark plug replacement", "60,000 mi", "About 8 months"),
                new("Coolant flush", "60,000 mi", "About 8 months"),
                new("Rear brake pad replacement", "65,000 mi", "About 12 months"),
            ]),
        new("10", "assistant",
            "I'd recommend scheduling the front brake job this week. For the catalytic converter, monitor the check engine light. If it stays on solid, get it checked. If it blinks, pull over and have the car towed.",
            "11:38 AM"),
    ];

    private void ToggleIssue(string issueId)
    {
        _expandedIssue = _expandedIssue == issueId ? null : issueId;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
