@* ============================================================
   Block: chat-fitness-coach
   Title: ChatFitnessCoach
   Description: React fitness coaching chat block for Next.js with workout plan cards, exercise sets and reps, meal plan suggestions, progress tracking, and workout logging using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-fitness-coach.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Coach header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="bg-muted text-xs">@_coach.Initials</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_coach.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_coach.Specialty
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Coach</span>
            </div>
        </div>

        @* Weekly stats *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="dumbbell" Size="12" Class="size-3" />
                @_weeklyStats.WorkoutsCompleted/@_weeklyStats.WorkoutsTarget this week
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="flame" Size="12" Class="size-3" />
                @_weeklyStats.CaloriesBurned cal
            </span>
            <span class="ml-auto flex items-center gap-1 text-xs">
                <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                <span class="font-medium tabular-nums">@_weeklyStats.StreakDays day streak</span>
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "client" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "client"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">

                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }

                            @* Workout card *@
                            @if (msg.Workout != null)
                            {
                                var workout = msg.Workout;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="clipboard-list" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@workout.Name</span>
                                        </div>
                                        <span class="text-muted-foreground text-xs">@workout.Duration</span>
                                    </div>
                                    <div class="space-y-0">
                                        @* Column headers *@
                                        <div class="flex items-center gap-2 px-1 pb-1.5">
                                            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Exercise</span>
                                            <span class="w-10 text-center text-muted-foreground text-xs">Sets</span>
                                            <span class="w-12 text-center text-muted-foreground text-xs">Reps</span>
                                            <span class="w-10 text-center text-muted-foreground text-xs">Rest</span>
                                        </div>
                                        @foreach (var exercise in workout.Exercises)
                                        {
                                            <div class="flex items-center gap-2 border-t px-1 py-1.5">
                                                <span class="min-w-0 flex-1 truncate text-sm">@exercise.Name</span>
                                                <span class="w-10 text-center font-mono text-xs tabular-nums">@exercise.Sets</span>
                                                <span class="w-12 text-center font-mono text-xs tabular-nums">@exercise.Reps</span>
                                                <span class="w-10 text-center font-mono text-muted-foreground text-xs tabular-nums">@exercise.Rest</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="mt-2.5 border-t pt-2.5">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                            Class="h-7 w-full gap-1.5 text-xs"
                                            OnClick="@(() => _workoutLogged = true)"
                                            Disabled="@_workoutLogged">
                                            @if (_workoutLogged)
                                            {
                                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                <text>Workout logged</text>
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="dumbbell" Size="12" Class="size-3" />
                                                <text>Log workout</text>
                                            }
                                        </ButtonCn>
                                    </div>
                                </div>
                            }

                            @* Meal plan card *@
                            @if (msg.MealPlan != null)
                            {
                                var meal = msg.MealPlan;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="utensils" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@meal.Meal</span>
                                        </div>
                                        <span class="font-medium text-sm tabular-nums">@meal.Calories cal</span>
                                    </div>
                                    <div class="mb-2.5 flex items-center gap-3">
                                        <span class="flex items-center gap-1 text-xs">
                                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                                            P: @meal.Protein
                                        </span>
                                        <span class="flex items-center gap-1 text-xs">
                                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                                            C: @meal.Carbs
                                        </span>
                                        <span class="flex items-center gap-1 text-xs">
                                            <span class="size-1.5 rounded-full bg-red-500"></span>
                                            F: @meal.Fat
                                        </span>
                                    </div>
                                    <div class="space-y-1">
                                        @foreach (var item in meal.Items)
                                        {
                                            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                                @item
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <span class="@(msg.Role == "client"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Ask your coach..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private bool _workoutLogged = false;

    private record Coach(string Name, string Specialty, string Initials);

    private record WeeklyStats(int WorkoutsCompleted, int WorkoutsTarget, string CaloriesBurned, int StreakDays);

    private record Exercise(string Name, int Sets, string Reps, string Rest);

    private record Workout(string Name, string Duration, Exercise[] Exercises);

    private record MealPlan(string Meal, int Calories, string Protein, string Carbs, string Fat, string[] Items);

    private record Message(string Id, string Role, string Content, string Timestamp, Workout? Workout = null, MealPlan? MealPlan = null);

    private readonly Coach _coach = new("Marcus Dean", "Strength & Conditioning", "MD");

    private readonly WeeklyStats _weeklyStats = new(4, 5, "2,180", 12);

    private readonly Message[] _messages =
    [
        new("1", "coach",
            "Morning! Great session yesterday. Your squat form looked solid on the last set. Ready for today's push day?",
            "7:30 AM"),
        new("2", "client",
            "Thanks! Feeling a little sore in my shoulders from Monday but otherwise good to go. What's the plan?",
            "7:32 AM"),
        new("3", "coach",
            "Since your shoulders are a bit fatigued, I've adjusted the volume on overhead movements. Here's today's workout:",
            "7:33 AM"),
        new("4", "coach", "", "7:33 AM",
            Workout: new("Push Day — Upper Body", "55 min",
            [
                new("Flat Barbell Bench Press", 4, "6-8", "90s"),
                new("Incline Dumbbell Press", 3, "8-10", "75s"),
                new("Seated Dumbbell Shoulder Press", 3, "10-12", "60s"),
                new("Cable Lateral Raises", 3, "12-15", "45s"),
                new("Tricep Rope Pushdown", 3, "12-15", "45s"),
                new("Overhead Tricep Extension", 2, "15", "45s"),
            ])),
        new("5", "client",
            "Looks good. I'll drop the shoulder press weight by 10% since they're sore. What should I eat after?",
            "7:35 AM"),
        new("6", "coach",
            "Smart call on the deload. Here's your post-workout meal plan to hit your protein target:",
            "7:36 AM"),
        new("7", "coach", "", "7:36 AM",
            MealPlan: new("Post-Workout Meal", 620, "42g", "68g", "18g",
            [
                "Grilled chicken breast (6oz)",
                "Brown rice (1 cup cooked)",
                "Steamed broccoli (1 cup)",
                "Olive oil drizzle (1 tsp)",
            ])),
        new("8", "coach",
            "Eat within 45 minutes of finishing. The protein and carb ratio will help with recovery, especially with the shoulder soreness. Hydrate well too.",
            "7:37 AM"),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
