@* ============================================================
   Block: chat-anonymous-chat
   Title: ChatAnonymousChat
   Description: React anonymous chat interface for Next.js with randomized animal avatars, ephemeral message styling, privacy shield banner, session info, and input identity display using TypeScript, shadcn/ui, Tailwind CSS, and Lucide React icons
   Source: original/blocks/chat/chat-anonymous-chat.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Anonymous Chat</span>
                <span class="ml-2 text-muted-foreground text-xs">@_users.Length participants</span>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var u in _users.Take(5))
                {
                    var user = u;
                    <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full", user.BgColor)" title="@user.Name">
                        <span class="scale-75">
                            <LucideIconCn Name="@user.IconName" Size="16" Class="size-4" />
                        </span>
                    </div>
                }
                @if (_users.Length > 5)
                {
                    <span class="text-muted-foreground text-xs">+@(_users.Length - 5)</span>
                }
            </div>
        </div>

        @* Privacy banner *@
        <div class="flex items-center gap-2 border-b bg-muted/50 px-4 py-2">
            <LucideIconCn Name="shield" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                Identities are randomized. Messages are not stored.
            </span>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            @for (var idx = 0; idx < _messages.Count; idx++)
            {
                var msg = _messages[idx];
                var user = GetUser(msg.UserId);
                if (user == null) { continue; }
                var isMe = msg.UserId == CurrentUserId;
                var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                var showAuthor = prevMsg == null || prevMsg.UserId != msg.UserId;
                var isLast = idx == _messages.Count - 1;
                <div style="opacity:@msg.Opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     class="@Cn.Merge("group flex gap-2 px-4 transition-colors hover:bg-accent", showAuthor ? "pt-3" : "pt-0.5", isLast ? "pb-3" : "")">

                    @* Avatar column *@
                    <div class="w-8 shrink-0">
                        @if (showAuthor)
                        {
                            <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-full", user.BgColor)">
                                <LucideIconCn Name="@user.IconName" Size="16" Class="size-4" />
                            </div>
                        }
                    </div>

                    @* Body *@
                    <div class="min-w-0 flex-1">
                        @if (showAuthor)
                        {
                            <div class="mb-0.5 flex items-center gap-2">
                                <span class="font-medium text-sm">@user.Name</span>
                                @if (isMe)
                                {
                                    <span class="text-muted-foreground text-[10px]">(you)</span>
                                }
                                <span class="text-muted-foreground text-xs opacity-0 transition-opacity group-hover:opacity-100">
                                    @msg.Timestamp
                                </span>
                            </div>
                        }
                        <p class="text-sm leading-relaxed">@msg.Content</p>
                    </div>

                    @* Hover time for grouped messages *@
                    @if (!showAuthor)
                    {
                        <span class="shrink-0 self-center text-muted-foreground text-[10px] opacity-0 transition-opacity group-hover:opacity-100">
                            @msg.Timestamp
                        </span>
                    }
                </div>
            }
        </div>

        @* Input with identity display *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                @{
                    var currentUser = GetUser(CurrentUserId);
                }
                <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", currentUser?.BgColor ?? "")">
                    @if (currentUser != null)
                    {
                        <LucideIconCn Name="@currentUser.IconName" Size="16" Class="size-4" />
                    }
                </div>
                <InputCn @bind-Value="_input"
                         Placeholder="@($"Message as {currentUser?.Name}...")"
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" aria-label="@($"Message as {currentUser?.Name}...")" />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))"
                          Class="size-9 shrink-0"
                          OnClick="HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string CurrentUserId = "fox";

    private record AnonymousUser(string Id, string Name, string IconName, string BgColor);

    private record Message(string Id, string Content, string UserId, string Timestamp, double Opacity);

    private static readonly AnonymousUser[] _users =
    [
        new("fox",    "Anonymous Fox",    "squirrel", "bg-amber-500/10 text-amber-600"),
        new("bear",   "Anonymous Bear",   "cat",      "bg-rose-500/10 text-rose-600"),
        new("owl",    "Anonymous Owl",    "bird",     "bg-violet-500/10 text-violet-600"),
        new("turtle", "Anonymous Turtle", "turtle",   "bg-emerald-500/10 text-emerald-600"),
        new("rabbit", "Anonymous Rabbit", "rabbit",   "bg-blue-500/10 text-blue-600"),
        new("fish",   "Anonymous Fish",   "fish",     "bg-cyan-500/10 text-cyan-600"),
        new("snail",  "Anonymous Snail",  "snail",    "bg-pink-500/10 text-pink-600"),
    ];

    private List<Message> _messages =
    [
        new("1", "Has anyone tried the new container queries in production?",                                                                           "owl",    "3:42 PM", 0.5),
        new("2", "We shipped them last week. Works great for card layouts that need to adapt to sidebar vs main content width.",                        "bear",   "3:43 PM", 0.6),
        new("3", "Nice. What about browser support?",                                                                                                  "fox",    "3:44 PM", 0.7),
        new("4", "Around 92% global support now. We use a fallback with media queries for the rest.",                                                  "bear",   "3:45 PM", 0.75),
        new("5", "I tried them for a dashboard project. The @@container syntax feels natural if you already know media queries.",                       "turtle", "3:47 PM", 0.8),
        new("6", "The tricky part is naming containers. We ended up with a convention: component-name as the container name.",                         "rabbit", "3:48 PM", 0.85),
        new("7", "That makes sense. Do you scope them per component or globally?",                                                                     "fox",    "3:49 PM", 0.9),
        new("8", "Per component. Global container names get messy fast in a large codebase.",                                                          "rabbit", "3:50 PM", 1.0),
    ];

    private string _input = "";

    private AnonymousUser? GetUser(string id) =>
        Array.Find(_users, u => u.Id == id);

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new Message(
            Id: $"new-{_messages.Count}",
            Content: _input.Trim(),
            UserId: CurrentUserId,
            Timestamp: "Now",
            Opacity: 1.0
        ));
        _input = "";
    }
}
