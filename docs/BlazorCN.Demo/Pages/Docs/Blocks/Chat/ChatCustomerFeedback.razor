@* ============================================================
   Block: chat-customer-feedback
   Title: ChatCustomerFeedback
   Description: Customer feedback collection chat with rating cards, sentiment tags, and follow-up prompts built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-customer-feedback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="message-square" Size="16" Class="size-4 text-foreground" />
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium">Customer Feedback</h3>
                    <p class="text-xs text-muted-foreground">Help us improve your experience</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    Anonymous
                </BadgeCn>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                var msg = message;
                <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "flex-row-reverse" : "")">
                    @* Avatar *@
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(msg.Type == "user" ? "bg-blue-500 text-white" : "bg-muted")">
                            @if (msg.Type == "user")
                            {
                                <span class="text-xs">You</span>
                            }
                            else
                            {
                                <LucideIconCn Name="message-square" Size="16" Class="size-4" />
                            }
                        </AvatarFallbackCn>
                    </AvatarCn>

                    @* Message Content *@
                    <div class="@Cn.Merge("flex-1 space-y-2", msg.Type == "user" ? "flex flex-col items-end" : "")">
                        @if (msg.Type == "rating")
                        {
                            <div class="max-w-sm rounded-lg border bg-muted/50 p-3">
                                <div class="mb-2 flex items-center gap-1">
                                    @for (int idx = 0; idx < 5; idx++)
                                    {
                                        var i = idx;
                                        <LucideIconCn Name="star" Size="20" Class="@Cn.Merge("size-5", i < (msg.Rating ?? 0) ? "fill-amber-500 text-amber-500" : "text-muted-foreground")" />
                                    }
                                </div>
                                <p class="text-sm text-muted-foreground">@msg.Content</p>
                                <span class="mt-1 block text-xs text-muted-foreground">@msg.Timestamp</span>
                            </div>
                        }
                        else if (msg.Type == "sentiment")
                        {
                            <div class="max-w-sm rounded-lg border bg-muted/50 p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    @if (msg.Sentiment == "positive")
                                    {
                                        <LucideIconCn Name="smile" Size="20" Class="size-5 text-emerald-500" />
                                    }
                                    @if (msg.Sentiment == "negative")
                                    {
                                        <LucideIconCn Name="frown" Size="20" Class="size-5 text-red-500" />
                                    }
                                    @if (msg.Sentiment == "neutral")
                                    {
                                        <LucideIconCn Name="meh" Size="20" Class="size-5 text-amber-500" />
                                    }
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs", msg.Sentiment == "positive" ? "border-emerald-500 text-emerald-500" : msg.Sentiment == "negative" ? "border-red-500 text-red-500" : "border-amber-500 text-amber-500")">
                                        @msg.Sentiment
                                    </BadgeCn>
                                </div>
                                <span class="block text-xs text-muted-foreground">@msg.Timestamp</span>
                            </div>
                        }
                        else
                        {
                            <div class="@Cn.Merge("max-w-sm rounded-lg px-3 py-2", msg.Type == "user" ? "bg-blue-500 text-white" : "bg-muted")">
                                <p class="text-sm">@msg.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", msg.Type == "user" ? "text-blue-100" : "text-muted-foreground")">
                                    @msg.Timestamp
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Rating Prompt *@
            @if (_selectedRating == null && _messages.Count == 2)
            {
                <div class="flex justify-center">
                    <div class="rounded-lg border bg-muted/50 p-4">
                        <p class="mb-3 text-center text-sm font-medium">Rate your experience</p>
                        <div class="flex gap-2">
                            @for (int idx = 0; idx < 5; idx++)
                            {
                                var starIdx = idx;
                                <button type="button"
                                        class="transition-transform hover:scale-110"
                                        @onclick="@(() => HandleRating(starIdx + 1))" aria-label="@($"Rate {starIdx + 1} out of 5")">
                                    <LucideIconCn Name="star" Size="32" Class="size-8 text-amber-500 hover:fill-amber-500" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Sentiment Prompt *@
            @if (_messages.Count == 4 && !_messages.Any(m => m.Type == "sentiment"))
            {
                <div class="flex justify-center">
                    <div class="rounded-lg border bg-muted/50 p-4">
                        <p class="mb-3 text-center text-sm font-medium">How are you feeling?</p>
                        <div class="flex gap-3">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2" OnClick="@(() => HandleSentiment("positive"))">
                                <LucideIconCn Name="smile" Size="16" Class="size-4 text-emerald-500" />
                                Happy
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2" OnClick="@(() => HandleSentiment("neutral"))">
                                <LucideIconCn Name="meh" Size="16" Class="size-4 text-amber-500" />
                                Okay
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2" OnClick="@(() => HandleSentiment("negative"))">
                                <LucideIconCn Name="frown" Size="16" Class="size-4 text-red-500" />
                                Frustrated
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Share your feedback..."
                         Class="flex-1" aria-label="Share your feedback..." />
                <ButtonCn Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          OnClick="HandleSend" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                Your feedback helps us improve. Thank you for taking the time!
            </p>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Type, string Content, string Timestamp, int? Rating = null, string? Sentiment = null);

    private int? _selectedRating = null;
    private string _input = "";

    private List<Message> _messages =
    [
        new("1", "bot", "Thanks for contacting us! We'd love to hear about your experience.", "Just now"),
        new("2", "bot", "How would you rate your overall experience with our product?", "Just now"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var userMessage = new Message(
            Id: DateTime.Now.Ticks.ToString(),
            Type: "user",
            Content: _input,
            Timestamp: "Just now"
        );

        var botResponse = new Message(
            Id: (DateTime.Now.Ticks + 1).ToString(),
            Type: "bot",
            Content: "Thank you for your detailed feedback! Is there anything specific we could improve?",
            Timestamp: "Just now"
        );

        _messages = [.. _messages, userMessage, botResponse];
        _input = "";
    }

    private void HandleRating(int rating)
    {
        _selectedRating = rating;

        var ratingMessage = new Message(
            Id: DateTime.Now.Ticks.ToString(),
            Type: "rating",
            Content: $"Rated {rating} stars",
            Timestamp: "Just now",
            Rating: rating
        );

        var followUp = new Message(
            Id: (DateTime.Now.Ticks + 1).ToString(),
            Type: "bot",
            Content: rating >= 4
                ? "We're thrilled you had a great experience! What did you enjoy most?"
                : "We're sorry to hear that. Could you tell us what went wrong?",
            Timestamp: "Just now"
        );

        _messages = [.. _messages, ratingMessage, followUp];
    }

    private void HandleSentiment(string sentiment)
    {
        var sentimentMessage = new Message(
            Id: DateTime.Now.Ticks.ToString(),
            Type: "sentiment",
            Content: $"Feeling {sentiment}",
            Timestamp: "Just now",
            Sentiment: sentiment
        );

        var followUp = new Message(
            Id: (DateTime.Now.Ticks + 1).ToString(),
            Type: "bot",
            Content: "Thanks for sharing! Could you elaborate on your experience?",
            Timestamp: "Just now"
        );

        _messages = [.. _messages, sentimentMessage, followUp];
    }
}
