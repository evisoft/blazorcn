@* ============================================================
   Block: chat-connection-status
   Title: ChatConnectionStatus
   Description: React chat connection quality indicator block for Next.js with green, amber, and red status dots, animated state transitions, and live status text using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-connection-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header with connection indicator *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <span class="font-medium text-muted-foreground text-xs">TN</span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Taylor Nguyen</span>
                <div class="flex items-center gap-1.5">
                    <span class="relative flex size-2">
                        @if (_status == "reconnecting")
                        {
                            <span class="@Cn.Merge("absolute inset-0 animate-ping rounded-full opacity-40", _currentDotColor)" />
                        }
                        <span class="@Cn.Merge("relative inline-flex size-2 rounded-full transition-colors duration-300", _currentDotColor)" />
                    </span>
                    <span class="text-muted-foreground text-xs">@_currentLabel</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Sm"
                      Class="h-7 px-2 text-muted-foreground text-xs"
                      @onclick="CycleStatus">
                Toggle status
            </ButtonCn>
        </div>

        @* Slow connection notice *@
        @if (_status == "slow")
        {
            <div class="border-b bg-amber-500/10 px-4 py-1.5">
                <p class="text-amber-700 text-xs dark:text-amber-400">
                    Messages may be delayed due to slow connection
                </p>
            </div>
        }

        @* Messages *@
        <div class="@Cn.Merge("relative flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-3", _status == "reconnecting" ? "opacity-60" : "")">
            @foreach (var msg in _messages)
            {
                <div class="@Cn.Merge("flex flex-col", msg.Sender == "me" ? "items-end" : "items-start")">
                    <div class="@Cn.Merge("max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed", msg.Sender == "me" ? "bg-foreground text-background" : "bg-muted text-foreground")">
                        @msg.Content
                    </div>
                    <span class="mt-0.5 px-1 text-[10px] text-muted-foreground">@msg.Timestamp</span>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                <InputCn @bind-Value="_input"
                         Placeholder="@(_status == "reconnecting" ? "Reconnecting..." : "Type a message...")"
                         Disabled="@(_status == "reconnecting")"
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0 disabled:cursor-not-allowed disabled:opacity-50" aria-label="@(_status == "reconnecting" ? "Reconnecting..." : "Type a message...")" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input) || _status == "reconnecting")"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Content, string Sender, string Timestamp);

    private record StatusConfig(string Label, string DotColor);

    private string _status = "connected";

    private static readonly string[] _statusOrder = ["connected", "slow", "reconnecting"];

    private static readonly Dictionary<string, StatusConfig> _statusMap = new()
    {
        ["connected"]    = new("Connected",           "bg-emerald-500"),
        ["slow"]         = new("Slow connection",     "bg-amber-500"),
        ["reconnecting"] = new("Reconnecting...",     "bg-red-500"),
    };

    private string _currentLabel   => _statusMap[_status].Label;
    private string _currentDotColor => _statusMap[_status].DotColor;

    private string _input = "";

    private static readonly Message[] _messages =
    [
        new("m1", "Can you check if the CDN cache is warming up properly?",                                                               "them", "4:10 PM"),
        new("m2", "Checking now. The hit ratio looks low, only around 62% on the edge nodes.",                                           "me",   "4:11 PM"),
        new("m3", "That explains the latency spikes. We should bump the TTL on static assets to at least 24 hours.",                     "them", "4:12 PM"),
        new("m4", "Agreed. I'll update the cache headers in the middleware config.",                                                      "me",   "4:13 PM"),
        new("m5", "Also check the origin shield. It might be bypassed for some routes with query params.",                               "them", "4:14 PM"),
        new("m6", "Good catch. I see three routes stripping the cache key on query strings. Fixing that now.",                           "me",   "4:15 PM"),
        new("m7", "Let me know when it's deployed. I'll run the load test again.",                                                       "them", "4:16 PM"),
        new("m8", "Should be out in about five minutes. I'll tag you on the PR.",                                                        "me",   "4:17 PM"),
    ];

    private void CycleStatus()
    {
        var currentIndex = Array.IndexOf(_statusOrder, _status);
        var nextIndex = (currentIndex + 1) % _statusOrder.Length;
        _status = _statusOrder[nextIndex];
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input) || _status == "reconnecting") return;
        _input = "";
    }
}
