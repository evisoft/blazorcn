@* ============================================================
   Block: chat-encryption-indicator
   Title: ChatEncryptionIndicator
   Description: React end-to-end encrypted chat interface for Next.js with lock icon header, per-message encryption badges, expandable encryption details panel, and secure messaging using TypeScript, shadcn/ui Tooltip, and Tailwind CSS
   Source: original/blocks/chat/chat-encryption-indicator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <span class="font-medium text-muted-foreground text-xs">@_contact.Initials</span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_contact.Name</span>
                <p class="text-muted-foreground text-xs">@_contact.Status</p>
            </div>
            <TooltipProviderCn>
                <TooltipCn>
                    <TooltipTriggerCn Tabbable="false">
                        <button type="button" @onclick="@(() => _showDetails = !_showDetails)"
                                class="flex items-center gap-1.5 rounded-md px-2 py-1 text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                            <LucideIconCn Name="lock" Size="14" Class="size-3.5" />
                            <span class="text-xs">Encrypted</span>
                        </button>
                    </TooltipTriggerCn>
                    <TooltipContentCn>End-to-end encrypted</TooltipContentCn>
                </TooltipCn>
            </TooltipProviderCn>
        </div>

        @* Encryption Details Panel *@
        <div class="@Cn.Merge("grid overflow-hidden border-b transition-[grid-template-rows] duration-200 ease-out", _showDetails ? "grid-rows-[1fr]" : "grid-rows-[0fr]")">
            <div class="overflow-hidden">
                <div class="bg-muted/30 px-4 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-500" />
                        <span class="font-medium text-sm">Encryption Details</span>
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-2">
                        <div class="rounded-md bg-muted/50 p-2">
                            <span class="text-muted-foreground text-[10px] uppercase tracking-wide">
                                Cipher
                            </span>
                            <p class="font-mono text-xs">@_encryptionDetails.Cipher</p>
                        </div>
                        <div class="rounded-md bg-muted/50 p-2">
                            <span class="text-muted-foreground text-[10px] uppercase tracking-wide">
                                Protocol
                            </span>
                            <p class="font-mono text-xs">@_encryptionDetails.Protocol</p>
                        </div>
                        <div class="rounded-md bg-muted/50 p-2">
                            <span class="text-muted-foreground text-[10px] uppercase tracking-wide">
                                Key exchange
                            </span>
                            <p class="font-mono text-xs">@_encryptionDetails.KeyExchange</p>
                        </div>
                        <div class="rounded-md bg-muted/50 p-2">
                            <span class="text-muted-foreground text-[10px] uppercase tracking-wide">
                                Verified
                            </span>
                            <p class="font-mono text-xs">@_encryptionDetails.VerifiedAt</p>
                        </div>
                    </div>
                    <div class="mt-2 rounded-md bg-muted/50 p-2">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="key" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-muted-foreground text-[10px] uppercase tracking-wide">
                                    Key fingerprint
                                </span>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      @onclick="HandleCopy"
                                      Class="h-5 gap-1 px-1.5 text-muted-foreground text-xs">
                                @if (_copied)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                }
                                @(_copied ? "Copied" : "Copy")
                            </ButtonCn>
                        </div>
                        <p class="mt-1 font-mono text-xs tracking-wider">
                            @_encryptionDetails.Fingerprint
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            @* Encryption banner *@
            <div class="mb-2 flex items-center justify-center gap-1.5 rounded-md bg-muted/30 px-3 py-1.5">
                <LucideIconCn Name="lock" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Messages are end-to-end encrypted</span>
            </div>

            @foreach (var msg in _initialMessages)
            {
                var isMe = msg.Sender == "me";
                <div class="@Cn.Merge("flex flex-col", isMe ? "items-end" : "items-start")">
                    <div class="@Cn.Merge("max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed", isMe ? "bg-foreground text-background" : "bg-muted text-foreground")">
                        @msg.Content
                    </div>
                    <div class="mt-0.5 flex items-center gap-1 px-1">
                        <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                        @if (msg.Encrypted)
                        {
                            <LucideIconCn Name="lock" Size="10" Class="size-2.5 text-muted-foreground/60" />
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <div class="flex flex-1 items-center gap-2 rounded-md bg-muted/50 px-3">
                    <LucideIconCn Name="lock" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                    <input @bind="_input" @bind:event="oninput"
                           placeholder="Encrypted message..."
                           class="h-9 flex-1 border-0 bg-transparent px-0 text-sm shadow-none outline-none placeholder:text-muted-foreground focus-visible:ring-0" aria-label="Encrypted message..." />
                </div>
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Contact(string Name, string Initials, string Status);

    private record EncryptionDetails(
        string Cipher,
        string Protocol,
        string KeyExchange,
        string Fingerprint,
        string VerifiedAt
    );

    private record Message(
        string Id,
        string Content,
        string Sender,
        string Timestamp,
        bool Encrypted
    );

    private static readonly Contact _contact = new("Lena Petrova", "LP", "Online");

    private static readonly EncryptionDetails _encryptionDetails = new(
        Cipher: "AES-256-GCM",
        Protocol: "Signal Protocol v3",
        KeyExchange: "X25519",
        Fingerprint: "a4f8 9c2e 71b3 d056 8e4a 3f17 c9b2 0d65",
        VerifiedAt: "Mar 15, 2026"
    );

    private static readonly Message[] _initialMessages =
    [
        new("1", "Hey, I sent over the contract draft. Can you take a look?",                          "them", "3:40 PM", true),
        new("2", "Got it. Opening now. Is the NDA section finalized?",                                 "me",   "3:41 PM", true),
        new("3", "Yes, legal signed off on it yesterday. The IP assignment clause was updated too.",   "them", "3:42 PM", true),
        new("4", "Perfect. I'll review the payment terms and get back to you by end of day.",          "me",   "3:43 PM", true),
        new("5", "Sounds good. Let me know if the indemnification language needs adjustment.",         "them", "3:44 PM", true),
        new("6", "Will do. Also, should we add a data processing addendum?",                           "me",   "3:45 PM", true),
        new("7", "Definitely. I'll draft one and attach it to the next revision.",                     "them", "3:46 PM", true),
    ];

    private bool _showDetails;
    private bool _copied;
    private string _input = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
