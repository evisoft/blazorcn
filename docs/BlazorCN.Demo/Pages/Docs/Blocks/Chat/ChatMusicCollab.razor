@* ============================================================
   Block: chat-music-collab
   Title: ChatMusicCollab
   Description: A music collaboration chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring track stems, BPM tags, and threaded feedback discussions
   Source: original/blocks/chat/chat-music-collab.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-purple-500/10">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-purple-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Midnight Drive Project</h3>
                <p class="text-xs text-muted-foreground">3 collaborators • 8 versions</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                128 BPM
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                var isUser = message.Sender == "user";
                <div class="@Cn.Merge("mb-4 flex gap-3", isUser ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(message.Sender == "other" ? "bg-purple-500/10 text-purple-600" : "bg-muted")">
                            @message.SenderName.Substring(0, Math.Min(2, message.SenderName.Length)).ToUpper()
                        </AvatarFallbackCn>
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", isUser ? "flex flex-col items-end" : "")">
                        <div class="flex items-baseline gap-2">
                            <span class="text-xs font-medium">@message.SenderName</span>
                            <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                        </div>

                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2", message.Sender == "other" ? "bg-muted" : "bg-purple-500/10 text-purple-900 dark:text-purple-100")">
                            <p class="text-sm">@message.Content</p>
                        </div>

                        @* Track Player *@
                        @if (message.Track != null)
                        {
                            var track = message.Track;
                            <div class="mt-2 w-full max-w-sm overflow-hidden rounded-lg border bg-card">
                                <div class="border-b bg-muted/50 px-3 py-2">
                                    <div class="flex items-start justify-between">
                                        <div class="flex-1">
                                            <h4 class="font-medium text-sm">@track.Name</h4>
                                            <p class="text-xs text-muted-foreground">@track.Artist</p>
                                        </div>
                                        <div class="flex gap-1">
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-xs">
                                                @track.Bpm BPM
                                            </BadgeCn>
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-xs">
                                                @track.Key
                                            </BadgeCn>
                                        </div>
                                    </div>
                                </div>

                                <div class="border-b px-3 py-2">
                                    <div class="mb-2 flex items-center justify-between">
                                        <ButtonCn aria-label="@($"Play or pause {track.Name}")" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 w-8 p-0" OnClick="@(() => _isPlaying = !_isPlaying)">
                                            @if (_isPlaying)
                                            {
                                                <LucideIconCn Name="pause" Size="16" Class="size-4" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="play" Size="16" Class="size-4" />
                                            }
                                        </ButtonCn>
                                        <span class="text-xs text-muted-foreground">
                                            1:32 / @track.Duration
                                        </span>
                                    </div>
                                    <ProgressCn Value="@_playProgress" Class="h-1.5" aria-label="Progress" />
                                </div>

                                <div class="border-b px-3 py-2">
                                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                                        Available Stems:
                                    </p>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var stem in track.Stems)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-6 gap-1 text-xs">
                                                <LucideIconCn Name="file-audio" Size="12" Class="size-3" />
                                                @stem
                                            </BadgeCn>
                                        }
                                    </div>
                                </div>

                                <div class="flex gap-1 p-2">
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1 text-xs">
                                        <LucideIconCn Name="volume-2" Size="12" Class="size-3" />
                                        Listen
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1 text-xs">
                                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                                        Download
                                    </ButtonCn>
                                </div>
                            </div>
                        }

                        @* Comments Thread *@
                        @if (message.Comments != null && message.Comments.Length > 0)
                        {
                            <div class="mt-2 w-full max-w-sm space-y-2 rounded-lg border bg-muted/30 p-3">
                                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                    <span>@message.Comments.Length replies</span>
                                </div>
                                @foreach (var comment in message.Comments)
                                {
                                    <div class="flex gap-2">
                                        <AvatarCn Class="size-6 shrink-0">
                                            <AvatarFallbackCn Class="bg-muted text-xs">
                                                @comment.User.Substring(0, Math.Min(2, comment.User.Length)).ToUpper()
                                            </AvatarFallbackCn>
                                        </AvatarCn>
                                        <div class="flex-1">
                                            <div class="flex items-baseline gap-2">
                                                <span class="text-xs font-medium">@comment.User</span>
                                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                            </div>
                                            <p class="mt-0.5 text-xs text-muted-foreground">@comment.Text</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Share feedback or upload stems..."
                         Class="flex-1" aria-label="Share feedback or upload stems..." />
                <ButtonCn aria-label="Send message" Size="ButtonSize.Sm" Class="shrink-0" OnClick="HandleSend">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                Use @@timestamp to add timestamped comments
            </p>
        </div>
    </div>
</section>

@code {
    private record TrackData(string Name, string Artist, int Bpm, string Key, string Duration, string[] Stems);
    private record CommentData(string User, string Text, string Timestamp);
    private record MessageData(string Id, string Sender, string SenderName, string Content, string Timestamp, TrackData? Track = null, CommentData[]? Comments = null);

    private bool _isPlaying = false;
    private int _playProgress = 42;
    private string _input = "";

    private List<MessageData> _messages =
    [
        new(
            Id: "1",
            Sender: "other",
            SenderName: "Marcus",
            Content: "Hey! I just finished the initial mix. Check out the latest version 👇",
            Timestamp: "3:45 PM",
            Track: new TrackData(
                Name: "Midnight Drive v3",
                Artist: "Marcus & Co.",
                Bpm: 128,
                Key: "Am",
                Duration: "3:42",
                Stems: ["Drums", "Bass", "Synth", "Vocals"]
            )
        ),
        new(
            Id: "2",
            Sender: "user",
            SenderName: "You",
            Content: "Love the vibe! The synth at 1:24 could be a bit brighter though",
            Timestamp: "3:48 PM"
        ),
        new(
            Id: "3",
            Sender: "other",
            SenderName: "Sarah",
            Content: "Agreed! Also the bass feels a bit muddy around 2:10. Maybe cut some low-mids?",
            Timestamp: "3:50 PM"
        ),
        new(
            Id: "4",
            Sender: "other",
            SenderName: "Marcus",
            Content: "Good catches! Let me make those adjustments. Will push v4 in 20 min",
            Timestamp: "3:52 PM",
            Comments:
            [
                new("Sarah",  "Can you also boost the vocals a bit?", "3:53 PM"),
                new("Marcus", "Yep, on it!",                          "3:54 PM"),
            ]
        ),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new MessageData(
            Id: $"music-collab-msg-{DateTime.Now.Ticks}",
            Sender: "user",
            SenderName: "You",
            Content: _input,
            Timestamp: "Just now"
        ));
        _input = "";
    }
}
