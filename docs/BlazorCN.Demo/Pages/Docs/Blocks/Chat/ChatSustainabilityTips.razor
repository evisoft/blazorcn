@* ============================================================
   Block: chat-sustainability-tips
   Title: ChatSustainabilityTips
   Description: An eco-friendly tips chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring action cards, environmental impact scores, and sustainability challenges
   Source: original/blocks/chat/chat-sustainability-tips.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10">
                    <LucideIconCn Name="leaf" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Sustainability Tips</h2>
                    <p class="text-xs text-muted-foreground">Live greener every day</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            <div class="space-y-4 p-4">
                @foreach (var message in _messages)
                {
                    @if (message.Type == "actions" && message.Actions != null)
                    {
                        <div class="space-y-3">
                            @foreach (var action in message.Actions)
                            {
                                var catConfig = GetCategoryConfig(action.Category);
                                var diffClass = GetDifficultyColor(action.Difficulty);
                                var isExpanded = _expandedActions.Contains(action.Id);
                                var capturedAction = action;
                                <div class="overflow-hidden rounded-lg border bg-muted/30">
                                    <div class="border-b bg-card px-3 py-2.5">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="flex items-start gap-2.5">
                                                <div class="@Cn.Merge("mt-0.5 flex size-8 items-center justify-center rounded-lg", catConfig.Bg)">
                                                    <LucideIconCn Name="@catConfig.IconName" Size="16" Class="@Cn.Merge("size-4", catConfig.Color)" />
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <h3 class="text-sm font-medium">@action.Title</h3>
                                                    <p class="mt-0.5 text-xs text-muted-foreground">@action.Description</p>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-1 shrink-0">
                                                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-500" />
                                                <span class="text-sm font-medium text-emerald-500">@action.Impact</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-3">
                                        <div class="mb-3 flex items-center gap-2">
                                            <span class="@Cn.Merge("rounded-md px-2 py-0.5 text-xs font-medium", diffClass)">
                                                @action.Difficulty
                                            </span>
                                            <span class="rounded-md bg-muted px-2 py-0.5 text-xs font-medium">
                                                @catConfig.Label
                                            </span>
                                            <div class="ml-auto flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="star" Size="12" Class="size-3 fill-muted-foreground" />
                                                <span>@action.Participants.ToString("N0") joined</span>
                                            </div>
                                        </div>

                                        <div class="mb-3 rounded-md bg-emerald-500/10 px-3 py-2">
                                            <div class="flex items-center gap-2">
                                                <LucideIconCn Name="leaf" Size="16" Class="size-4 text-emerald-600" />
                                                <div>
                                                    <span class="text-sm font-medium text-emerald-700">@action.CarbonSaved</span>
                                                    <p class="text-xs text-emerald-600/80">Estimated savings per year</p>
                                                </div>
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <div class="mb-3 space-y-1.5">
                                                <h4 class="text-xs font-medium text-muted-foreground">Steps to get started:</h4>
                                                @for (var i = 0; i < action.Steps.Length; i++)
                                                {
                                                    var stepIndex = i;
                                                    <div class="flex items-start gap-2">
                                                        <div class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                                                            @(stepIndex + 1)
                                                        </div>
                                                        <span class="text-xs text-muted-foreground">@action.Steps[stepIndex]</span>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="flex gap-2">
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => ToggleExpanded(capturedAction.Id))">
                                                @(isExpanded ? "Hide Steps" : "Show Steps")
                                            </ButtonCn>
                                            <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-1.5" OnClick="@(() => HandleCommit(capturedAction.Id))">
                                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                                                Commit
                                            </ButtonCn>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "justify-end" : "justify-start")">
                            @if (message.Type == "assistant")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-primary/10 text-xs">
                                        <LucideIconCn Name="leaf" Size="16" Class="size-4" />
                                    </AvatarFallbackCn>
                                </AvatarCn>
                            }
                            <div class="@Cn.Merge("max-w-[80%] rounded-lg px-3 py-2", message.Type == "user" ? "bg-primary text-primary-foreground" : "bg-muted")">
                                <p class="text-sm">@message.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", message.Type == "user" ? "text-primary-foreground/70" : "text-muted-foreground")">
                                    @message.Timestamp
                                </span>
                            </div>
                            @if (message.Type == "user")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-muted text-xs">U</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-3">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about sustainability tips..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private readonly HashSet<string> _expandedActions = [];

    private record SusAction(
        string Id,
        string Title,
        string Category,
        int Impact,
        string Difficulty,
        string CarbonSaved,
        string Description,
        string[] Steps,
        int Participants);

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        SusAction[]? Actions = null);

    private record CategoryConfig(string IconName, string Label, string Color, string Bg);

    private static readonly SusAction[] _actions =
    [
        new("a1", "Switch to LED Bulbs", "energy", 85, "Easy", "200 kg CO₂/year",
            "Replace traditional bulbs with energy-efficient LED lighting throughout your home",
            [
                "Audit all light fixtures in your home",
                "Purchase LED equivalents for each bulb type",
                "Replace bulbs starting with most-used rooms",
                "Dispose of old bulbs at recycling center",
            ],
            12847),
        new("a2", "Start Composting", "waste", 72, "Medium", "150 kg CO₂/year",
            "Turn food scraps and yard waste into nutrient-rich soil for your garden",
            [
                "Choose a composting method (bin, tumbler, or pile)",
                "Set up compost area in yard or balcony",
                "Separate green and brown materials",
                "Maintain moisture and turn regularly",
            ],
            8934),
        new("a3", "Reduce Shower Time", "water", 68, "Easy", "90 kg CO₂/year",
            "Cut shower time to 5 minutes to save water and energy used for heating",
            [
                "Install a shower timer or use phone alarm",
                "Reduce shower temperature by 2°C",
                "Turn off water while soaping",
                "Track water bill for savings",
            ],
            15623),
    ];

    private List<Message> _messages =
    [
        new("m1", "assistant",
            "Welcome! I'm here to help you live more sustainably. Small changes make a big impact. What area would you like to improve?",
            "11:00 AM"),
        new("m2", "user",
            "I want to reduce my carbon footprint at home",
            "11:01 AM"),
        new("m3", "assistant",
            "Great goal! Here are high-impact actions you can take at home:",
            "11:01 AM"),
        new("m4", "actions", "", "11:01 AM", Actions: _actions),
    ];

    private static CategoryConfig GetCategoryConfig(string category) => category switch
    {
        "energy"    => new("zap",       "Energy",    "text-amber-500",   "bg-amber-500/10"),
        "waste"     => new("recycle",   "Waste",     "text-emerald-500", "bg-emerald-500/10"),
        "water"     => new("droplet",   "Water",     "text-blue-500",    "bg-blue-500/10"),
        "transport" => new("tree-pine", "Transport", "text-green-500",   "bg-green-500/10"),
        _           => new("circle",    "Other",     "text-muted-foreground", "bg-muted"),
    };

    private static string GetDifficultyColor(string difficulty) => difficulty switch
    {
        "Easy"   => "bg-emerald-500/10 text-emerald-700",
        "Medium" => "bg-amber-500/10 text-amber-700",
        "Hard"   => "bg-red-500/10 text-red-700",
        _        => "bg-muted",
    };

    private void ToggleExpanded(string actionId)
    {
        if (_expandedActions.Contains(actionId))
            _expandedActions.Remove(actionId);
        else
            _expandedActions.Add(actionId);
    }

    private void HandleCommit(string actionId)
    {
        // Commit action - no-op in demo
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"m{_messages.Count + 1}", "user", _input, "11:02 AM"));
        _input = "";
    }
}
