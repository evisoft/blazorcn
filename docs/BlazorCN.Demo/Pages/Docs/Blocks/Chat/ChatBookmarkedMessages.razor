@* ============================================================
   Block: chat-bookmarked-messages
   Title: ChatBookmarkedMessages
   Description: React bookmarked messages chat block for Next.js with hover bookmark icons, filled bookmark state, saved messages side panel, and message save management using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-bookmarked-messages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Left: Chat *@
        <div class="flex flex-1 flex-col overflow-hidden">
            @* Header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <AvatarCn Class="size-8">
                    <AvatarFallbackCn Class="text-xs">LZ</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Leo Zhang</span>
                    <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Online
                    </p>
                </div>
                <ButtonCn Variant="@(_showPanel ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs"
                          @onclick="@(() => _showPanel = !_showPanel)">
                    <LucideIconCn Name="bookmark" Size="12" Class="@Cn.Merge("size-3", _showPanel ? "fill-current" : "")" />
                    Saved
                    @if (_bookmarks.Count > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-0.5 h-4 min-w-4 px-1 font-normal text-[10px]">
                            @_bookmarks.Count
                        </BadgeCn>
                    }
                </ButtonCn>
            </div>

            @* Messages *@
            <div class="flex flex-1 flex-col gap-3 overflow-y-auto px-4 py-4">
                @foreach (var msg in _messages)
                {
                    var message = msg;
                    var isMe = message.Sender == "me";
                    var isBookmarked = _bookmarks.Contains(message.Id);
                    var isHovered = _hoveredMsg == message.Id;
                    <div class="@Cn.Merge("group relative flex items-end gap-2", isMe ? "flex-row-reverse" : "flex-row")"
                         @onmouseenter="@(() => _hoveredMsg = message.Id)"
                         @onmouseleave="@(() => _hoveredMsg = null)">
                        @if (!isMe)
                        {
                            <AvatarCn Class="size-7">
                                <AvatarFallbackCn Class="text-[10px]">@message.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        <div class="@Cn.Merge("flex max-w-[70%] flex-col", isMe ? "items-end" : "items-start")">
                            <div class="relative">
                                <div class="@Cn.Merge("rounded-2xl px-3 py-2 text-sm leading-relaxed", isMe ? "rounded-br-sm bg-foreground text-background" : "rounded-bl-sm bg-muted text-foreground")">
                                    @message.Content
                                </div>
                                @if (isHovered || isBookmarked)
                                {
                                    <button type="button"
                                            @onclick="@(() => ToggleBookmark(message.Id))"
                                            class="@Cn.Merge("absolute -top-2 rounded-full border bg-card p-1 shadow-sm transition-colors hover:bg-muted/50", isMe ? "-left-2" : "-right-2")">
                                        <LucideIconCn Name="bookmark" Size="12" Class="@Cn.Merge("size-3", isBookmarked ? "fill-amber-500 text-amber-500" : "text-muted-foreground")" />
                                    </button>
                                }
                            </div>
                            <span class="mt-0.5 px-1 text-muted-foreground text-[10px]">@message.Time</span>
                        </div>
                    </div>
                }
            </div>

            @* Input *@
            <div class="border-t px-4 py-3">
                <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                    <InputCn @bind-Value="_input"
                             Placeholder="Type a message..."
                             Class="h-9 flex-1 border-0 bg-muted/50 text-sm shadow-none focus-visible:ring-0" />
                    <ButtonCn type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </form>
            </div>
        </div>

        @* Right: Bookmarks panel *@
        @if (_showPanel)
        {
            <div class="flex w-72 flex-col overflow-hidden border-l">
                @* Panel header *@
                <div class="flex items-center justify-between border-b px-3 py-3">
                    <span class="font-medium text-xs">
                        Saved messages (@BookmarkedMessages.Count())
                    </span>
                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="size-6 p-0"
                                  @onclick="@(() => _sortNewest = !_sortNewest)">
                            <LucideIconCn Name="arrow-down-up" Size="12" Class="size-3" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="size-6 p-0"
                                  @onclick="@(() => _showPanel = false)">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                </div>

                @* Panel search *@
                <div class="border-b px-3 py-2">
                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2">
                        <LucideIconCn Name="search" Size="12" Class="size-3 text-muted-foreground" />
                        <input type="text"
                               value="@_panelSearch"
                               @oninput="@((e) => _panelSearch = e.Value?.ToString() ?? "")"
                               placeholder="Search bookmarks..."
                               class="h-7 flex-1 bg-transparent text-xs outline-none placeholder:text-muted-foreground" />
                    </div>
                </div>

                @* Panel sort indicator *@
                <div class="border-b px-3 py-1.5">
                    <span class="text-muted-foreground text-[10px]">
                        @(_sortNewest ? "Newest first" : "Oldest first")
                    </span>
                </div>

                @* Bookmarked items *@
                <div class="flex-1 overflow-y-auto">
                    @{
                        var bmMessages = BookmarkedMessages.ToList();
                    }
                    @if (bmMessages.Count == 0)
                    {
                        <div class="flex flex-col items-center justify-center gap-1 p-4 text-center">
                            <LucideIconCn Name="bookmark" Size="20" Class="size-5 text-muted-foreground/40" />
                            <span class="text-muted-foreground text-xs">No saved messages</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in bmMessages)
                        {
                            var bm = msg;
                            <div class="group/item border-b px-3 py-2.5 transition-colors last:border-b-0 hover:bg-muted/50">
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="font-medium text-[10px]">@bm.Name</span>
                                    <div class="flex items-center gap-1">
                                        <span class="text-muted-foreground text-[10px]">@bm.Time</span>
                                        <button type="button"
                                                @onclick="@(() => ToggleBookmark(bm.Id))"
                                                class="opacity-0 transition-opacity group-hover/item:opacity-100">
                                            <LucideIconCn Name="bookmark" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                                        </button>
                                    </div>
                                </div>
                                <p class="line-clamp-3 text-muted-foreground text-[11px] leading-relaxed">@bm.Content</p>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Sender, string Name, string Initials, string Content, string Time);

    private string _input = "";
    private bool _showPanel = true;
    private string? _hoveredMsg = null;
    private bool _sortNewest = true;
    private string _panelSearch = "";

    private HashSet<string> _bookmarks = ["m3", "m5", "m7"];

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "them", "Leo Zhang", "LZ", "I finished the API documentation for the v2 endpoints. Want me to share the link?", "11:05 AM"),
        new("m2", "me", "You", "ME", "Yes please! I need it for the integration guide I'm writing.", "11:06 AM"),
        new("m3", "them", "Leo Zhang", "LZ", "Here it is: docs.acme.com/api/v2. The auth section has the new OAuth2 PKCE flow documented with code samples for React and Node.", "11:07 AM"),
        new("m4", "me", "You", "ME", "Bookmarking that. Also, what's the rate limit for the new search endpoint?", "11:08 AM"),
        new("m5", "them", "Leo Zhang", "LZ", "Rate limit is 100 requests per minute per API key for search. For batch operations it's 20 per minute. Both are documented in the rate limits section.", "11:09 AM"),
        new("m6", "me", "You", "ME", "That's helpful. And the webhook payload format - did that change from v1?", "11:10 AM"),
        new("m7", "them", "Leo Zhang", "LZ", "Yes, v2 webhooks use a standardized envelope: { event, timestamp, data, signature }. The signature uses HMAC-SHA256 now instead of the old MD5 hash. Migration guide is at docs.acme.com/api/v2/webhooks/migration.", "11:12 AM"),
        new("m8", "me", "You", "ME", "Great. I'll save these references and work them into the guide. Should have a draft by end of day.", "11:14 AM"),
    ];

    private IEnumerable<ChatMessage> BookmarkedMessages
    {
        get
        {
            var filtered = _messages.Where(m => _bookmarks.Contains(m.Id));
            if (!string.IsNullOrWhiteSpace(_panelSearch))
            {
                var q = _panelSearch.ToLowerInvariant();
                filtered = filtered.Where(m =>
                    m.Content.ToLowerInvariant().Contains(q) ||
                    m.Name.ToLowerInvariant().Contains(q));
            }
            if (!_sortNewest)
                filtered = filtered.Reverse();
            return filtered;
        }
    }

    private void ToggleBookmark(string id)
    {
        if (_bookmarks.Contains(id))
            _bookmarks.Remove(id);
        else
            _bookmarks.Add(id);
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
