@* ============================================================
   Block: chat-knowledge-base
   Title: ChatKnowledgeBase
   Description: React knowledge base chat block for Next.js with bot-suggested help articles as card messages, thumbs up and down feedback, article title and snippet preview, and read-more links using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-knowledge-base.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8 shrink-0">
                <AvatarFallbackCn Class="text-xs">
                    <LucideIconCn Name="book-open" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Help Center</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    AI-assisted support
                </p>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col overflow-y-auto py-2">
            @foreach (var msg in _messages)
            {
                var isUser = msg.Role == "user";
                var idx = System.Array.IndexOf(_messages, msg);
                var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                var showAvatar = prevMsg == null || prevMsg.Role != msg.Role;

                if (isUser)
                {
                    <div class="flex justify-end px-2 py-0.5">
                        <div class="max-w-[75%]">
                            <div class="rounded-2xl bg-foreground px-3 py-2 text-background text-sm leading-relaxed">
                                @msg.Content
                            </div>
                            <span class="mt-0.5 block text-right text-muted-foreground text-[10px]">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="px-2 py-0.5">
                        <div class="flex gap-2 rounded-md transition-colors hover:bg-accent">
                            <div class="w-8 shrink-0">
                                @if (showAvatar)
                                {
                                    <AvatarCn Class="size-8">
                                        <AvatarFallbackCn Class="text-xs">
                                            <LucideIconCn Name="book-open" Size="14" Class="size-3.5" />
                                        </AvatarFallbackCn>
                                    </AvatarCn>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                @if (showAvatar)
                                {
                                    <span class="mb-0.5 block text-muted-foreground text-[10px]">
                                        Help Center
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(msg.Content))
                                {
                                    <div class="max-w-[85%] rounded-2xl bg-muted px-3 py-2 text-sm leading-relaxed">
                                        @msg.Content
                                    </div>
                                }
                                <span class="mt-0.5 block text-muted-foreground text-[10px]">
                                    @msg.Timestamp
                                </span>
                            </div>
                        </div>

                        @* Article cards *@
                        @if (msg.Articles != null && msg.Articles.Length > 0)
                        {
                            <div class="ml-10 mt-1 flex flex-col gap-2 pr-2">
                                @foreach (var article in msg.Articles)
                                {
                                    var art = article;
                                    <div class="overflow-hidden rounded-md border p-3">
                                        <div class="flex items-start gap-2.5">
                                            <LucideIconCn Name="book-open" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="font-medium text-sm leading-tight">
                                                    @art.Title
                                                </span>
                                                <p class="mt-1 line-clamp-2 text-muted-foreground text-xs leading-relaxed">
                                                    @art.Snippet
                                                </p>
                                                <div class="mt-2 flex items-center gap-2">
                                                    <a href="@art.Url"
                                                       class="inline-flex h-6 items-center gap-1 rounded-md px-2 text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
                                                        Read article &rarr;
                                                    </a>
                                                    <div class="ml-auto flex items-center gap-1">
                                                        <button type="button"
                                                                @onclick="@(() => HandleFeedback(art.Id, "up"))"
                                                                class="@Cn.Merge("rounded-md p-1 transition-colors", _articleFeedback.TryGetValue(art.Id, out var fbUp) && fbUp == "up" ? "text-emerald-500" : "text-muted-foreground/40 hover:text-muted-foreground")">
                                                            <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                                        </button>
                                                        <button type="button"
                                                                @onclick="@(() => HandleFeedback(art.Id, "down"))"
                                                                class="@Cn.Merge("rounded-md p-1 transition-colors", _articleFeedback.TryGetValue(art.Id, out var fbDown) && fbDown == "down" ? "text-red-500" : "text-muted-foreground/40 hover:text-muted-foreground")">
                                                            <LucideIconCn Name="thumbs-down" Size="12" Class="size-3" />
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="@("Ask a question or type \"talk to agent\"...")"
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn Type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          OnClick="HandleSubmit"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private Dictionary<string, string> _articleFeedback = new();

    private record Article(string Id, string Title, string Snippet, string Url);
    private record ChatMessage(string Id, string Role, string? Content, Article[]? Articles, string Timestamp);

    private static readonly ChatMessage[] _messages =
    [
        new("1", "bot",
            "Hi! I'm the Acme support assistant. I can help answer your questions or find relevant articles from our help center.",
            null,
            "9:00 AM"),
        new("2", "user",
            "How do I set up two-factor authentication on my account?",
            null,
            "9:01 AM"),
        new("3", "bot",
            "Here are some articles that should help with two-factor authentication:",
            [
                new("a1",
                    "Enable Two-Factor Authentication (2FA)",
                    "Step-by-step guide to enabling 2FA on your Acme account using an authenticator app or SMS verification. Covers Google Authenticator, Authy, and 1Password.",
                    "/help/enable-2fa"),
                new("a2",
                    "Recover Your Account After Losing 2FA Access",
                    "If you've lost access to your authenticator app or phone, follow these steps to regain access using backup codes or identity verification.",
                    "/help/2fa-recovery"),
            ],
            "9:01 AM"),
        new("4", "bot",
            "Was this helpful? You can also type \"talk to agent\" to connect with a person.",
            null,
            "9:02 AM"),
        new("5", "user",
            "What about setting up SSO for my team?",
            null,
            "9:03 AM"),
        new("6", "bot",
            "Here are the relevant articles for SSO configuration:",
            [
                new("a3",
                    "Configure SAML SSO for Your Organization",
                    "Set up SAML-based single sign-on with your identity provider (Okta, Azure AD, Google Workspace). Includes metadata XML configuration and attribute mapping.",
                    "/help/saml-sso-setup"),
                new("a4",
                    "SSO Troubleshooting Guide",
                    "Common SSO issues and their solutions, including certificate errors, redirect loops, attribute mapping failures, and session timeout configuration.",
                    "/help/sso-troubleshooting"),
            ],
            "9:03 AM"),
        new("7", "bot",
            "Was this helpful?",
            null,
            "9:04 AM"),
    ];

    private void HandleFeedback(string articleId, string type)
    {
        if (_articleFeedback.TryGetValue(articleId, out var current) && current == type)
            _articleFeedback.Remove(articleId);
        else
            _articleFeedback[articleId] = type;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
