@* ============================================================
   Block: chat-plant-care
   Title: ChatPlantCare
   Description: React plant care advice chat block for Next.js with plant diagnosis cards, care schedule displays, watering reminders, and health status indicators using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-plant-care.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="leaf" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Plant Care Assistant</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Botanist
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">
                    Diagnosis, care schedules, and tips
                </span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "user" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "user"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Diagnosis != null)
                            {
                                var diag = msg.Diagnosis;
                                <div class="mt-2 rounded-md border bg-card">
                                    <div class="flex items-center justify-between border-b px-3 py-2.5">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="leaf" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@diag.PlantName</span>
                                        </div>
                                        <span class="font-mono text-muted-foreground text-xs">@diag.Species</span>
                                    </div>
                                    @foreach (var (diagItem, diagIndex) in diag.Items.Select((it, i) => (it, i)))
                                    {
                                        var isLast = diagIndex == diag.Items.Length - 1;
                                        var isExpanded = _expandedDiagItem == diagItem.Issue;
                                        var itemIssue = diagItem.Issue;
                                        var dotClass = diagItem.Status == "critical" ? "bg-red-500"
                                            : diagItem.Status == "attention" ? "bg-amber-500"
                                            : "bg-emerald-500";
                                        var statusLabelText = diagItem.Status == "critical" ? "Critical"
                                            : diagItem.Status == "attention" ? "Needs attention"
                                            : "Healthy";
                                        <div class="@(isLast ? "" : "border-b")">
                                            <button
                                                type="button"
                                                @onclick="@(() => ToggleDiagItem(itemIssue))"
                                                class="flex w-full items-center gap-3 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                                <span class="@($"size-2 shrink-0 rounded-full {dotClass}")" />
                                                <div class="min-w-0 flex-1">
                                                    <span class="font-medium text-sm">@diagItem.Issue</span>
                                                </div>
                                                <span class="shrink-0 text-muted-foreground text-xs">@statusLabelText</span>
                                            </button>
                                            @if (isExpanded)
                                            {
                                                <div class="px-3 pb-3 pl-8">
                                                    <p class="mb-2 text-muted-foreground text-sm leading-relaxed">@diagItem.Description</p>
                                                    <div class="rounded-md bg-muted/50 p-3">
                                                        <span class="mb-1 block font-medium text-muted-foreground text-xs">Treatment</span>
                                                        <p class="text-sm leading-relaxed">@diagItem.Treatment</p>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (msg.CareSchedule != null)
                            {
                                var sched = msg.CareSchedule;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="leaf" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">@sched.PlantName Care Guide</span>
                                    </div>
                                    <div class="space-y-0">
                                        <div class="flex items-start gap-2.5 py-2">
                                            <LucideIconCn Name="droplet" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="text-muted-foreground text-xs">Watering</span>
                                                <p class="text-sm">@sched.Watering</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2.5 border-t py-2">
                                            <LucideIconCn Name="sun" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="text-muted-foreground text-xs">Light</span>
                                                <p class="text-sm">@sched.Light</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2.5 border-t py-2">
                                            <LucideIconCn Name="cloud-rain" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="text-muted-foreground text-xs">Humidity</span>
                                                <p class="text-sm">@sched.Humidity</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2.5 border-t py-2">
                                            <LucideIconCn Name="leaf" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="text-muted-foreground text-xs">Soil</span>
                                                <p class="text-sm">@sched.Soil</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2.5 border-t py-2">
                                            <LucideIconCn Name="leaf" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="text-muted-foreground text-xs">Fertilizer</span>
                                                <p class="text-sm">@sched.Fertilizer</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2.5 border-t py-2">
                                            <LucideIconCn Name="thermometer" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="text-muted-foreground text-xs">Temperature</span>
                                                <p class="text-sm">@sched.Temperature</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            <span class="@(msg.Role == "user"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Describe your plant's symptoms..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private string? _expandedDiagItem = "Root moisture stress";

    private record DiagnosisItem(
        string Issue,
        string Status,
        string Description,
        string Treatment);

    private record PlantDiagnosis(
        string PlantName,
        string Species,
        DiagnosisItem[] Items);

    private record CareSchedule(
        string PlantName,
        string Watering,
        string Light,
        string Humidity,
        string Soil,
        string Fertilizer,
        string Temperature);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        PlantDiagnosis? Diagnosis = null,
        CareSchedule? CareSchedule = null);

    private readonly Message[] _messages =
    [
        new("1", "user",
            "My Monstera deliciosa has been developing yellow leaves on the lower stems and some brown crispy edges on the newer leaves. I water it once a week. What's going on?",
            "3:12 PM"),
        new("2", "assistant",
            "Based on your description, I can identify a couple of issues with your Monstera. Here's my diagnosis:",
            "3:13 PM"),
        new("3", "assistant", "", "3:13 PM",
            Diagnosis: new(
                "Monstera deliciosa",
                "Swiss Cheese Plant",
                [
                    new("Root moisture stress",
                        "attention",
                        "Yellowing lower leaves typically indicate inconsistent watering. The soil may be staying too wet between waterings, causing early-stage root stress.",
                        "Check that the top 2 inches of soil are dry before watering. Ensure the pot has drainage holes. Reduce watering to every 10-14 days in lower light conditions."),
                    new("Low humidity damage",
                        "attention",
                        "Brown crispy edges on newer leaves suggest the ambient humidity is below the 50-60% range this species prefers, especially common during winter with indoor heating.",
                        "Place a pebble tray with water beneath the pot, or group it with other plants. A small humidifier nearby set to 55-60% is the most effective solution."),
                    new("Overall root health",
                        "healthy",
                        "Since the yellowing is limited to lower leaves and new growth is still emerging, the root system is likely intact. No signs of root rot based on your description.",
                        "Monitor new leaf unfurling over the next 2-3 weeks. If yellowing spreads upward or new leaves emerge deformed, consider repotting to inspect roots directly."),
                ])),
        new("4", "user",
            "That makes sense, the humidity in my apartment is probably around 35% right now. Can you give me the full care schedule for this plant?",
            "3:15 PM"),
        new("5", "assistant",
            "Here's the optimal care schedule for your Monstera:",
            "3:16 PM"),
        new("6", "assistant", "", "3:16 PM",
            CareSchedule: new(
                "Monstera deliciosa",
                "Every 10-14 days (let top 2\" dry)",
                "Bright indirect (avoid direct sun)",
                "55-65% (currently too low)",
                "Well-draining aroid mix (perlite + bark)",
                "Balanced 20-20-20, monthly in spring/summer",
                "65-85°F (18-29°C)")),
        new("7", "assistant",
            "Since it's late March, your Monstera is entering its active growing season. This is the best time to address the humidity issue and start fertilizing. You should see improvement in new growth within 3-4 weeks of adjusting humidity levels.",
            "3:17 PM"),
    ];

    private void ToggleDiagItem(string issue)
    {
        _expandedDiagItem = _expandedDiagItem == issue ? null : issue;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
