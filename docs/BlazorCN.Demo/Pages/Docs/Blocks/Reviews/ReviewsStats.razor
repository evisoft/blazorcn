@* ========================================
   Block: reviews-stats
   Title: Reviews Stats
   Description: Review analytics dashboard with metrics, trends, and sentiment breakdown for admin panels
   Dependencies: CardCn, CardContentCn, CardHeaderCn, CardTitleCn, ProgressCn, LucideArrowDownCn, LucideArrowUpCn
   Source: original/blocks/reviews/reviews-stats.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Review Analytics</h1>
    </div>

    <div class="mx-auto w-[900px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Stats Grid *@
                <div class="grid grid-cols-2 gap-x-8 gap-y-6 lg:grid-cols-4">
                    @foreach (var stat in _stats)
                    {
                        <div>
                            <p class="text-sm text-muted-foreground">@stat.Label</p>
                            <div class="mt-1 flex items-baseline gap-2">
                                <span class="text-2xl font-semibold tabular-nums">@stat.Value</span>
                                <span class="@($"inline-flex items-center text-xs font-medium {(stat.Change >= 0 ? "text-primary" : "text-destructive")}")">
                                    @if (stat.Change >= 0)
                                    {
                                        <LucideArrowUpCn Size="12" />
                                    }
                                    else
                                    {
                                        <LucideArrowDownCn Size="12" />
                                    }
                                    @Math.Abs(stat.Change)@stat.Suffix
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </CardContentCn>
        </CardCn>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
            @* Sentiment *@
            <CardCn>
                <CardHeaderCn>
                    <CardTitleCn Class="text-base">Sentiment Breakdown</CardTitleCn>
                </CardHeaderCn>
                <CardContentCn Class="space-y-4">
                    @foreach (var item in _sentiment)
                    {
                        <div class="space-y-2">
                            <div class="flex items-center justify-between text-sm">
                                <span>@item.Label</span>
                                <span class="font-medium tabular-nums">@(item.Value)%</span>
                            </div>
                            <ProgressCn Class="h-1.5" Value="@item.Value" />
                        </div>
                    }
                </CardContentCn>
            </CardCn>

            @* Activity *@
            <CardCn>
                <CardHeaderCn>
                    <CardTitleCn Class="text-base">Recent Activity</CardTitleCn>
                </CardHeaderCn>
                <CardContentCn>
                    <div class="space-y-4">
                        @foreach (var item in _activity)
                        {
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-muted-foreground">@item.Label</span>
                                <span class="text-sm font-medium tabular-nums">@item.Value</span>
                            </div>
                        }
                    </div>
                </CardContentCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Value, double Change, string Suffix);
    private record SentimentItem(string Label, int Value);
    private record ActivityItem(string Label, string Value);

    private readonly StatItem[] _stats =
    [
        new("Total Reviews", "2,847", 12, "%"),
        new("Average Rating", "4.7", 0.2, ""),
        new("Response Rate", "94%", 3, "%"),
        new("Would Recommend", "89%", -1, "%"),
    ];

    private readonly SentimentItem[] _sentiment =
    [
        new("Positive", 72),
        new("Neutral", 21),
        new("Negative", 7),
    ];

    private readonly ActivityItem[] _activity =
    [
        new("New reviews today", "23"),
        new("Awaiting response", "5"),
        new("Responded this week", "67"),
    ];
}
