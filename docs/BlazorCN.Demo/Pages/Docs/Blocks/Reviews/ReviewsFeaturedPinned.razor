@* ============================================================
   Block: reviews-featured-pinned
   Title: ReviewsFeaturedPinned
   Description: A featured pinned reviews management block for React and Next.js with pin/unpin toggle actions, drag-to-reorder visual, priority ordering, and admin controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-featured-pinned.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="pin" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-sm font-medium">Pinned Reviews</span>
            </div>
            <span class="text-xs text-muted-foreground">
                @_pinnedCount/@MaxPinned slots used
            </span>
        </div>

        @* Pinned section *@
        <div class="border-b">
            @if (_pinnedCount == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-xs text-muted-foreground">
                        No pinned reviews yet. Pin reviews below to feature them.
                    </p>
                </div>
            }
            @{ var pinnedList = _reviews.Where(r => r.Pinned).ToList(); }
            @for (var pi = 0; pi < pinnedList.Count; pi++)
            {
                var review = pinnedList[pi];
                var index = pi;
                var isLastPinned = index == pinnedList.Count - 1;
                <div class="@Cn.Merge("flex", isLastPinned ? "" : "border-b")">
                    @* Position indicator rail *@
                    <div class="flex w-10 shrink-0 flex-col items-center justify-center border-r bg-muted/30">
                        <span class="text-xs font-medium text-muted-foreground">@(index + 1)</span>
                    </div>

                    @* Review content *@
                    <div class="flex-1 px-4 py-3">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-2.5">
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="text-[10px]">@review.Author.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@review.Author.Name</span>
                                        @if (review.Verified)
                                        {
                                            <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">
                                        @review.Author.Role at @review.Author.Company
                                    </p>
                                </div>
                            </div>
                            <div class="flex shrink-0 items-center gap-1">
                                @{ var capturedIndex = index; var capturedId = review.Id; }
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" Disabled="@(index == 0)" @onclick="@(() => MovePinned(capturedId, true))">
                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" Disabled="@(index == pinnedList.Count - 1)" @onclick="@(() => MovePinned(capturedId, false))">
                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0 text-amber-600 hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300" @onclick="@(() => TogglePin(capturedId))">
                                    <LucideIconCn Name="pin-off" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>

                        <div class="mt-2 flex items-center gap-2">
                            @RenderStars(review.Rating)
                            <span class="text-xs text-muted-foreground">@review.Date</span>
                        </div>

                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                            @review.Text
                        </p>

                        <div class="mt-2 flex items-center gap-3">
                            <span class="text-[10px] text-muted-foreground">
                                @review.HelpfulCount helpful
                            </span>
                            @if (review.PinnedAt != null)
                            {
                                <span class="text-[10px] text-muted-foreground">@review.PinnedAt</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Unpinned section header *@
        @{ var unpinnedList = _reviews.Where(r => !r.Pinned).ToList(); }
        <div class="flex items-center justify-between border-b bg-muted/20 px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Available Reviews</span>
            <span class="text-xs text-muted-foreground">@unpinnedList.Count reviews</span>
        </div>

        @* Unpinned reviews *@
        @for (var ui = 0; ui < unpinnedList.Count; ui++)
        {
            var review = unpinnedList[ui];
            var isLastUnpinned = ui == unpinnedList.Count - 1;
            var capturedId2 = review.Id;
            <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLastUnpinned ? "" : "border-b")">
                <AvatarCn Class="size-7 shrink-0">
                    <AvatarFallbackCn Class="text-[10px]">@review.Author.Initials</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@review.Author.Name</span>
                        @if (review.Verified)
                        {
                            <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                        }
                        @RenderStars(review.Rating)
                    </div>
                    <p class="text-xs text-muted-foreground">
                        @review.Author.Role at @review.Author.Company
                    </p>
                    <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                        @review.Text
                    </p>
                    <div class="mt-1.5 flex items-center gap-2">
                        <span class="text-[10px] text-muted-foreground">
                            @review.HelpfulCount helpful
                        </span>
                        <span class="text-[10px] text-muted-foreground">@review.Date</span>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2.5 text-xs" Disabled="@(!_canPinMore)" @onclick="@(() => TogglePin(capturedId2))">
                    <LucideIconCn Name="pin" Size="12" Class="size-3" />
                    Pin
                </ButtonCn>
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/20 px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_pinnedCount pinned
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    @unpinnedList.Count available
                </span>
            </div>
            @if (!_canPinMore)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                    Pin limit reached
                </BadgeCn>
            }
        </div>
    </div>
</section>

@code {
    private const int MaxPinned = 5;

    private int _pinnedCount => _reviews.Count(r => r.Pinned);
    private bool _canPinMore => _pinnedCount < MaxPinned;

    private List<PinnableReview> _reviews = new List<PinnableReview>
    {
        new PinnableReview { Id = "pr-1", Author = new ReviewAuthor { Name = "Christine Alvarez", Initials = "CA", Role = "VP of Engineering", Company = "Vercel" }, Rating = 5, Text = "We evaluated a dozen tools before committing to this one. The developer experience is unmatched. Our team velocity increased by 40% in the first quarter and the API design is the cleanest we have worked with.", Date = "1 week ago", Verified = true, HelpfulCount = 89, Pinned = true, PinnedAt = "Pinned 3 days ago" },
        new PinnableReview { Id = "pr-2", Author = new ReviewAuthor { Name = "Nathan Brooks", Initials = "NB", Role = "Senior Developer", Company = "Stripe" }, Rating = 5, Text = "Clean API, excellent TypeScript support. Integration with our Next.js app took about two hours. The SDK handles edge cases we did not even think about including retry logic and rate limiting.", Date = "3 days ago", Verified = true, HelpfulCount = 56, Pinned = true, PinnedAt = "Pinned 2 days ago" },
        new PinnableReview { Id = "pr-3", Author = new ReviewAuthor { Name = "Alex Rivera", Initials = "AR", Role = "CTO", Company = "Acme Corp" }, Rating = 5, Text = "Replaced our entire homegrown solution. Cut our infrastructure costs by 60% and eliminated two full days of maintenance per sprint. The migration guide was flawless and support was responsive.", Date = "1 week ago", Verified = true, HelpfulCount = 72, Pinned = true, PinnedAt = "Pinned 1 day ago" },
        new PinnableReview { Id = "pr-4", Author = new ReviewAuthor { Name = "Maya Patel", Initials = "MP", Role = "Product Manager", Company = "Linear" }, Rating = 4, Text = "Our team adopted this across three projects. The learning curve is gentle and the results are consistent. Would love to see better Figma integration for our design team but otherwise excellent.", Date = "5 days ago", Verified = true, HelpfulCount = 34, Pinned = false, PinnedAt = null },
        new PinnableReview { Id = "pr-5", Author = new ReviewAuthor { Name = "Ingrid Svensson", Initials = "IS", Role = "Full Stack Developer", Company = "Resend" }, Rating = 4, Text = "Solid product that does what it promises. The dashboard is intuitive and the real-time features work reliably. The documentation could use more advanced examples for complex use cases.", Date = "2 weeks ago", Verified = false, HelpfulCount = 21, Pinned = false, PinnedAt = null },
        new PinnableReview { Id = "pr-6", Author = new ReviewAuthor { Name = "David Kim", Initials = "DK", Role = "Engineering Manager", Company = "Dub" }, Rating = 5, Text = "Shipped our public dashboard two weeks ahead of schedule. The chart components alone saved 80 hours of development. Our design team was thrilled with how close the output matched their Figma files.", Date = "3 weeks ago", Verified = true, HelpfulCount = 45, Pinned = false, PinnedAt = null },
    };

    private void TogglePin(string id)
    {
        var review = _reviews.FirstOrDefault(r => r.Id == id);
        if (review == null) return;
        review.Pinned = !review.Pinned;
        review.PinnedAt = review.Pinned ? "Just now" : null;
    }

    private void MovePinned(string id, bool moveUp)
    {
        var pinned = _reviews.Where(r => r.Pinned).ToList();
        var idx = pinned.FindIndex(r => r.Id == id);
        if (idx == -1) return;
        var swapIdx = moveUp ? idx - 1 : idx + 1;
        if (swapIdx < 0 || swapIdx >= pinned.Count) return;
        // Swap in pinned list
        var temp = pinned[idx];
        pinned[idx] = pinned[swapIdx];
        pinned[swapIdx] = temp;
        // Rebuild full list: pinned first, then unpinned
        var unpinned = _reviews.Where(r => !r.Pinned).ToList();
        _reviews = pinned.Concat(unpinned).ToList();
    }

    private RenderFragment RenderStars(int rating) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "role", "img");
        __builder.AddAttribute(2, "class", "flex items-center gap-0.5");
        __builder.AddAttribute(3, "aria-label", $"{rating} out of 5 stars");
        for (var i = 0; i < 5; i++)
        {
            var starClass = i < rating ? "size-3 fill-amber-500 text-amber-500" : "size-3 text-muted-foreground/30";
            __builder.OpenComponent<LucideIconCn>(4 + i);
            __builder.AddAttribute(5 + i, "Name", "star");
            __builder.AddAttribute(6 + i, "Size", 12);
            __builder.AddAttribute(7 + i, "Class", starClass);
            __builder.CloseComponent();
        }
        __builder.CloseElement();
    };

    private class ReviewAuthor
    {
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
        public string Role { get; set; } = "";
        public string Company { get; set; } = "";
    }

    private class PinnableReview
    {
        public string Id { get; set; } = "";
        public ReviewAuthor Author { get; set; } = new();
        public int Rating { get; set; }
        public string Text { get; set; } = "";
        public string Date { get; set; } = "";
        public bool Verified { get; set; }
        public int HelpfulCount { get; set; }
        public bool Pinned { get; set; }
        public string? PinnedAt { get; set; }
    }
}
