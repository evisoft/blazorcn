@* ============================================================
   Block: reviews-write-form
   Title: ReviewsWriteForm
   Description: A rich review writing form for React and Next.js with interactive star rating, pros and cons inputs, photo upload with preview, character counter, and submit validation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-write-form.tsx
   ============================================================ *@

@if (_submitted)
{
  <section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
      <div class="flex flex-col items-center justify-center px-4 py-12">
        <LucideIconCn Name="check-circle-2" Size="40" Class="size-10 text-emerald-600 dark:text-emerald-400" />
        <p class="mt-3 text-sm font-medium">Review submitted successfully</p>
        <p class="mt-1 text-xs text-muted-foreground">Your review will be visible after moderation</p>
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-8 text-xs" OnClick="ResetForm">
          Write another review
        </ButtonCn>
      </div>
    </div>
  </section>
}
else
{
  <section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

      @* Header with progress *@
      <div class="border-b px-4 py-3">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-sm font-medium">Write a Review</span>
            <p class="mt-0.5 text-xs text-muted-foreground">
              Share your honest experience to help others decide
            </p>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[10px] text-muted-foreground tabular-nums">
              @_completionPercent%
            </span>
            <ProgressCn Value="@((double)_completionPercent)" Class="h-1.5 w-16" />
          </div>
        </div>
      </div>

      @* Star rating section *@
      <div class="border-b px-4 py-4">
        <span class="mb-2 block text-xs font-medium text-muted-foreground">
          Overall rating *
        </span>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-0.5" @onmouseleave="@(() => _hoveredRating = 0)">
            @foreach (var star in Enumerable.Range(1, 5))
            {
              var s = star;
              var isActive = s <= _activeRating;
              <button type="button"
                      aria-label="@($"Rate {s} out of 5: {_ratingLabels[s]}")"
                      @onmouseenter="@(() => _hoveredRating = s)"
                      @onclick="@(() => _rating = s)"
                      class="rounded-sm p-0.5 transition-colors hover:bg-muted/50">
                <LucideIconCn Name="star" Size="28" Class="@Cn.Merge("size-7 transition-colors duration-150", isActive ? "fill-amber-500 text-amber-500" : "text-muted-foreground/25")" />
              </button>
            }
          </div>
          @if (_activeRating > 0)
          {
            <span class="text-sm text-muted-foreground">
              @_ratingLabels[_activeRating]
            </span>
          }
        </div>
      </div>

      @* Title input *@
      <div class="border-b px-4 py-3">
        <div class="flex items-center justify-between">
          <label for="review-title" class="mb-1.5 block text-xs font-medium text-muted-foreground">
            Review title *
          </label>
          <span class="text-[10px] tabular-nums text-muted-foreground">
            @_title.Length/@MaxTitleChars
          </span>
        </div>
        <InputCn @bind-Value="_title" id="review-title" Placeholder="Summarize your experience in a sentence..." Class="h-9 border-0 bg-muted/30 shadow-none focus-visible:ring-1" />
      </div>

      @* Review body *@
      <div class="border-b px-4 py-3">
        <div class="flex items-center justify-between">
          <label for="review-body" class="mb-1.5 block text-xs font-medium text-muted-foreground">
            Your review *
          </label>
          <span class="@Cn.Merge("text-[10px] tabular-nums", _body.Length > MaxBodyChars * 0.9 ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground")">
            @_body.Length/@MaxBodyChars
          </span>
        </div>
        <TextareaCn @bind-Value="_body" id="review-body" Placeholder="What did you like or dislike? How did you use this product? Would you recommend it?" Class="resize-none border-0 bg-muted/30 shadow-none focus-visible:ring-1" rows="5" />
        @if (_body.Length > 0 && _body.Length < MinBodyChars)
        {
          <p class="mt-1 text-[10px] text-red-500">
            Minimum @MinBodyChars characters (@(MinBodyChars - _body.Length) more needed)
          </p>
        }
      </div>

      @* Pros and Cons *@
      <div class="border-b px-4 py-3">
        <span class="mb-2.5 block text-xs font-medium text-muted-foreground">
          Pros and Cons (optional)
        </span>

        <div class="grid gap-4 sm:grid-cols-2">

          @* Pros *@
          <div>
            <span class="mb-1.5 flex items-center gap-1 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
              PROS
            </span>
            <div class="space-y-1.5">
              @foreach (var entry in _pros.Select((p, i) => new { Value = p, Index = i }))
              {
                var proItem = entry.Value;
                var proIdx = entry.Index;
                <div class="flex items-center gap-1.5">
                  <span class="size-1 rounded-full bg-emerald-500"></span>
                  <span class="flex-1 text-xs">@proItem</span>
                  <button type="button"
                          @onclick="@(() => RemovePro(proIdx))"
                          class="rounded p-0.5 text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                  </button>
                </div>
              }
              @if (_pros.Count < MaxPros)
              {
                <div class="flex items-center gap-1.5">
                  <InputCn @bind-Value="_proInput" Placeholder="Add a pro..." Class="h-7 flex-1 border-0 bg-muted/30 text-xs shadow-none focus-visible:ring-1" />
                  <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" OnClick="AddPro" Disabled="@(string.IsNullOrWhiteSpace(_proInput))">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                  </ButtonCn>
                </div>
              }
            </div>
          </div>

          @* Cons *@
          <div>
            <span class="mb-1.5 flex items-center gap-1 text-[10px] font-medium text-red-600 dark:text-red-400">
              CONS
            </span>
            <div class="space-y-1.5">
              @foreach (var entry in _cons.Select((c, i) => new { Value = c, Index = i }))
              {
                var conItem = entry.Value;
                var conIdx = entry.Index;
                <div class="flex items-center gap-1.5">
                  <span class="size-1 rounded-full bg-red-500"></span>
                  <span class="flex-1 text-xs">@conItem</span>
                  <button type="button"
                          @onclick="@(() => RemoveCon(conIdx))"
                          class="rounded p-0.5 text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                  </button>
                </div>
              }
              @if (_cons.Count < MaxCons)
              {
                <div class="flex items-center gap-1.5">
                  <InputCn @bind-Value="_conInput" Placeholder="Add a con..." Class="h-7 flex-1 border-0 bg-muted/30 text-xs shadow-none focus-visible:ring-1" />
                  <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" OnClick="AddCon" Disabled="@(string.IsNullOrWhiteSpace(_conInput))">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                  </ButtonCn>
                </div>
              }
            </div>
          </div>

        </div>
      </div>

      @* Photo upload *@
      <div class="border-b px-4 py-3">
        <div class="flex items-center justify-between">
          <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
            Photos (optional)
          </span>
          @if (_photos.Count > 0)
          {
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
              @_photos.Count/@MaxPhotos
            </BadgeCn>
          }
        </div>

        @if (_photos.Count > 0)
        {
          <div class="mb-2 flex flex-wrap gap-2">
            @foreach (var entry in _photos.Select((p, i) => new { Name = p, Index = i }))
            {
              var photoName = entry.Name;
              var photoIdx = entry.Index;
              <div class="group relative flex h-16 w-20 items-center justify-center rounded-md bg-muted/50">
                <LucideIconCn Name="image-plus" Size="16" Class="size-4 text-muted-foreground/50" />
                <span class="absolute bottom-0.5 left-0 right-0 truncate px-1 text-center text-[8px] text-muted-foreground">
                  @photoName
                </span>
                <button type="button"
                        @onclick="@(() => RemovePhoto(photoIdx))"
                        class="absolute -right-1 -top-1 flex size-4 items-center justify-center rounded-full bg-foreground text-background opacity-0 transition-opacity group-hover:opacity-100">
                  <LucideIconCn Name="x" Size="10" Class="size-2.5" />
                </button>
              </div>
            }
          </div>
        }

        @if (_photos.Count < MaxPhotos)
        {
          <label for="review-photos"
                 class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-md border border-dashed bg-muted/20 px-4 py-4 transition-colors hover:bg-muted/40">
            <LucideIconCn Name="image-plus" Size="20" Class="size-5 text-muted-foreground" />
            <span class="text-xs text-muted-foreground">
              Click to upload or drag and drop
            </span>
            <span class="text-[10px] text-muted-foreground/60">
              PNG, JPG, WebP up to 5MB each &middot; @(MaxPhotos - _photos.Count) remaining
            </span>
            <input id="review-photos"
                   type="file"
                   accept="image/png,image/jpeg,image/webp"
                   multiple
                   class="hidden"
                   @onchange="HandlePhotoUpload" />
          </label>
        }
      </div>

      @* Submit footer *@
      <div class="flex items-center justify-between px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="text-[10px] text-muted-foreground">
            @(_isValid ? "Ready to submit" : "Complete required fields to submit")
          </span>
          @if (!_isValid)
          {
            <div class="flex items-center gap-1">
              @if (_rating == 0)
              {
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal text-muted-foreground">
                  Rating
                </BadgeCn>
              }
              @if (string.IsNullOrWhiteSpace(_title))
              {
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal text-muted-foreground">
                  Title
                </BadgeCn>
              }
              @if (_body.Trim().Length < MinBodyChars)
              {
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal text-muted-foreground">
                  Review
                </BadgeCn>
              }
            </div>
          }
        </div>
        <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@(!_isValid)" OnClick="HandleSubmit">
          Submit Review
        </ButtonCn>
      </div>

    </div>
  </section>
}

@code {
    private const int MaxBodyChars = 2000;
    private const int MaxTitleChars = 120;
    private const int MinBodyChars = 20;
    private const int MaxPhotos = 6;
    private const int MaxPros = 5;
    private const int MaxCons = 5;

    private static readonly Dictionary<int, string> _ratingLabels = new()
    {
        [1] = "Poor",
        [2] = "Fair",
        [3] = "Good",
        [4] = "Very good",
        [5] = "Excellent",
    };

    private int _rating = 0;
    private int _hoveredRating = 0;
    private string _title = "";
    private string _body = "";
    private readonly List<string> _pros = new();
    private readonly List<string> _cons = new();
    private string _proInput = "";
    private string _conInput = "";
    private readonly List<string> _photos = new();
    private bool _submitted = false;

    private int _activeRating => _hoveredRating > 0 ? _hoveredRating : _rating;

    private int _completionPercent
    {
        get
        {
            var steps = new[]
            {
                _rating > 0,
                _title.Trim().Length > 0,
                _body.Trim().Length >= MinBodyChars,
                _pros.Count > 0 || _cons.Count > 0,
            };
            return (int)Math.Round((double)steps.Count(x => x) / steps.Length * 100);
        }
    }

    private bool _isValid => _rating > 0 && _title.Trim().Length > 0 && _body.Trim().Length >= MinBodyChars;

    private void AddPro()
    {
        var trimmed = _proInput.Trim();
        if (!string.IsNullOrEmpty(trimmed) && _pros.Count < MaxPros)
        {
            _pros.Add(trimmed);
            _proInput = "";
        }
    }

    private void AddCon()
    {
        var trimmed = _conInput.Trim();
        if (!string.IsNullOrEmpty(trimmed) && _cons.Count < MaxCons)
        {
            _cons.Add(trimmed);
            _conInput = "";
        }
    }

    private void RemovePro(int idx)
    {
        if (idx >= 0 && idx < _pros.Count)
            _pros.RemoveAt(idx);
    }

    private void RemoveCon(int idx)
    {
        if (idx >= 0 && idx < _cons.Count)
            _cons.RemoveAt(idx);
    }

    private void RemovePhoto(int idx)
    {
        if (idx >= 0 && idx < _photos.Count)
            _photos.RemoveAt(idx);
    }

    private void HandlePhotoUpload(ChangeEventArgs e)
    {
        @* Photo preview via file names not possible in Blazor without JSInterop;
           the upload zone is rendered faithfully but file name capture is omitted. *@
    }

    private void HandleSubmit()
    {
        if (_isValid)
            _submitted = true;
    }

    private void ResetForm()
    {
        _submitted = false;
        _rating = 0;
        _hoveredRating = 0;
        _title = "";
        _body = "";
        _pros.Clear();
        _cons.Clear();
        _proInput = "";
        _conInput = "";
        _photos.Clear();
    }
}
