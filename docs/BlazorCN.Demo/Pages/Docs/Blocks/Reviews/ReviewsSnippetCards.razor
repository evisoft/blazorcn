@* ============================================================
   Block: reviews-snippet-cards
   Title: ReviewsSnippetCards
   Description: A responsive review snippet card grid for React and Next.js with featured highlight card, star ratings, verified badges, product tags, helpful counts, and staggered entrance animations built with shadcn/ui Badge and Avatar components, motion/react, and Tailwind CSS
   Source: original/blocks/reviews/reviews-snippet-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with filter *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Customer Reviews</span>
                <span class="ml-2 text-xs text-muted-foreground tabular-nums">
                    @_filtered.Length of @_snippets.Length
                </span>
            </div>
            <div class="flex items-center gap-1">
                @foreach (var option in _filterOptions[..4])
                {
                    var opt = option;
                    <button type="button" @onclick="@(() => SetFilter(opt))"
                            class="@Cn.Merge("rounded-md px-2 py-1 text-[10px] font-medium transition-colors", _activeFilter == opt ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        @opt
                    </button>
                }
            </div>
        </div>

        @* Cards grid *@
        <div class="p-3">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                @* Featured card - full width *@
                @if (_featured != null)
                {
                    var feat = _featured;
                    <div class="col-span-full rounded-md border bg-muted/30 p-4">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <AvatarCn Class="size-9">
                                    <AvatarFallbackCn Class="text-xs font-medium">
                                        @feat.Author.Initials
                                    </AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@feat.Author.Name</span>
                                        @if (feat.Verified)
                                        {
                                            <LucideIconCn Name="circle-check-2" Size="14" Class="size-3.5 text-emerald-500" />
                                        }
                                    </div>
                                    <span class="text-xs text-muted-foreground">
                                        @feat.Author.Title at @feat.Author.Company
                                    </span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                                    @feat.Product
                                </BadgeCn>
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var idx = i;
                                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < feat.Rating ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                                    }
                                </div>
                            </div>
                        </div>
                        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                            &ldquo;@feat.Excerpt&rdquo;
                        </p>
                        <div class="mt-3 flex items-center gap-3">
                            <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                <span class="tabular-nums">@feat.Helpful</span> found helpful
                            </span>
                            <span class="text-[10px] text-muted-foreground">@feat.TimeAgo</span>
                        </div>
                    </div>
                }

                @* Regular cards *@
                @foreach (var snippet in _regular)
                {
                    <div class="group rounded-md border p-3 transition-colors hover:bg-muted/30">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-0.5">
                                @for (int j = 0; j < 5; j++)
                                {
                                    var jdx = j;
                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", jdx < snippet.Rating ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                                }
                            </div>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                                @snippet.Product
                            </BadgeCn>
                        </div>
                        <p class="mt-2 line-clamp-3 text-sm leading-relaxed">
                            &ldquo;@snippet.Excerpt&rdquo;
                        </p>
                        <div class="mt-3 flex items-center gap-2">
                            <AvatarCn Class="size-5">
                                <AvatarFallbackCn Class="text-[8px]">
                                    @snippet.Author.Initials
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex items-center gap-1.5 min-w-0">
                                <span class="truncate text-xs font-medium">@snippet.Author.Name</span>
                                @if (snippet.Verified)
                                {
                                    <LucideIconCn Name="circle-check-2" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                                }
                            </div>
                            <span class="ml-auto shrink-0 flex items-center gap-1 text-[10px] text-muted-foreground">
                                <LucideIconCn Name="thumbs-up" Size="10" Class="size-2.5" />
                                <span class="tabular-nums">@snippet.Helpful</span>
                            </span>
                        </div>
                        <span class="mt-1 block text-[10px] text-muted-foreground">
                            @snippet.Author.Title, @snippet.Author.Company
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <span class="text-[10px] text-muted-foreground">
                    Showing @_filtered.Length reviews
                </span>
                <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="circle-check-2" Size="12" Class="size-3 text-emerald-500" />
                        @_snippets.Count(s => s.Verified) verified
                    </span>
                    <span class="tabular-nums">
                        @((_snippets.Sum(s => s.Rating) / (double)_snippets.Length).ToString("F1")) avg
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record AuthorInfo(string Name, string Initials, string Title, string Company);
    private record ReviewSnippet(string Id, AuthorInfo Author, int Rating, string Excerpt, string Product, bool Verified, int Helpful, bool Featured, string TimeAgo);

    private static readonly ReviewSnippet[] _snippets =
    [
        new("rs-1", new("Mariana Costa", "MC", "VP of Engineering", "Tessera Inc"), 5,
            "Migrated our entire design system to these components in under a week. The TypeScript types are rock-solid, accessibility is built in from the ground up, and the Tailwind integration means our designers can prototype directly in code. This cut our component development time by 60 percent.",
            "Component Library", true, 89, true, "3d ago"),
        new("rs-2", new("Jordan Ellis", "JE", "Senior Frontend Dev", "Quantix"), 5,
            "The dashboard blocks alone were worth the subscription. Wired up to our GraphQL API in an afternoon.",
            "Dashboard Blocks", true, 47, false, "1w ago"),
        new("rs-3", new("Rina Watanabe", "RW", "Product Designer", "Luminary"), 4,
            "Beautiful defaults that match our brand with minimal customization. Wish there were more animation presets.",
            "UI Components", true, 31, false, "1w ago"),
        new("rs-4", new("Tobias Engel", "TE", "Tech Lead", "Meridian Labs"), 5,
            "Replaced three internal libraries with this single registry. Bundle size dropped, DX improved, and junior devs ramp up faster.",
            "Component Library", true, 56, false, "2w ago"),
        new("rs-5", new("Priya Mehta", "PM", "Fullstack Engineer", "Cascade"), 5,
            "The form blocks with built-in validation patterns saved us from writing hundreds of lines of boilerplate.",
            "Form Blocks", false, 22, false, "2w ago"),
        new("rs-6", new("Samuel Osei", "SO", "CTO", "Vectrix"), 4,
            "Our agency ships two to three client projects a month using these blocks. Consistent quality across every delivery.",
            "Pro Subscription", true, 38, false, "3w ago"),
    ];

    private static readonly string[] _filterOptions =
    [
        "All",
        "Component Library",
        "Dashboard Blocks",
        "UI Components",
        "Form Blocks",
        "Pro Subscription",
    ];

    private string _activeFilter = "All";

    private ReviewSnippet[] _filtered => _activeFilter == "All"
        ? _snippets
        : _snippets.Where(s => s.Product == _activeFilter).ToArray();

    private ReviewSnippet? _featured => _filtered.FirstOrDefault(s => s.Featured);

    private ReviewSnippet[] _regular => _filtered.Where(s => !s.Featured).ToArray();

    private void SetFilter(string option)
    {
        _activeFilter = option;
    }
}
