@* ============================================================
   Block: reviews-community-aggregate
   Title: ReviewsCommunityAggregate
   Description: A multi-source community aggregate review block for React and Next.js with platform score cards, weighted average calculation, and distribution breakdown built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-community-aggregate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground/60" />
                    <span class="text-sm font-medium">Community Consensus</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal tabular-nums">
                        @_platforms.Length sources
                    </BadgeCn>
                </div>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-xs text-muted-foreground">Independently verified</span>
                </div>
            </div>
        </div>

        @* Main content: Split panel *@
        <div class="grid grid-cols-1 divide-y sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            @* Left: Overall score *@
            <div class="flex flex-col items-center justify-center px-4 py-6">
                <div class="text-center">
                    <span class="text-4xl font-semibold tabular-nums">@_roundedAverage</span>
                    <span class="ml-0.5 text-sm text-muted-foreground">/5</span>
                </div>
                <div class="mt-1.5 flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="16" Class="@(idx < (int)Math.Round(_roundedAverage) ? "size-4 fill-foreground text-foreground" : "size-4 text-muted-foreground/20")" />
                    }
                </div>
                <p class="mt-2 text-xs tabular-nums text-muted-foreground">
                    @_totalReviews.ToString("N0") total reviews
                </p>
                <div class="mt-1 flex items-center gap-1">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                    <span class="text-[10px] text-emerald-600">+0.2 this quarter</span>
                </div>
            </div>

            @* Right: Distribution + platform cards *@
            <div class="col-span-2">
                @* Star distribution *@
                <div class="border-b px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Rating distribution</span>
                    <div class="mt-2 space-y-1.5">
                        @foreach (var d in _distribution)
                        {
                            <div class="flex items-center gap-2">
                                <span class="w-3 text-right text-xs tabular-nums text-muted-foreground">
                                    @d.Stars
                                </span>
                                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground/40" />
                                <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                    <div class="h-full rounded-full bg-foreground/60" style="@($"width:{d.Percentage}%")"></div>
                                </div>
                                <span class="w-10 text-right text-[10px] tabular-nums text-muted-foreground">
                                    @d.Percentage%
                                </span>
                            </div>
                        }
                    </div>
                </div>

                @* Platform cards *@
                <div class="px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Scores by platform</span>
                    <div class="mt-2 space-y-1.5">
                        @foreach (var platform in _platforms)
                        {
                            var p = platform;
                            <div class="group flex cursor-default items-center gap-3 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/40"
                                 title="@($"{p.Name}: {p.Score}/{p.MaxScore} from {p.ReviewCount.ToString("N0")} reviews")"
                                 @onmouseenter="@(() => _hoveredPlatform = p.Id)"
                                 @onmouseleave="@(() => _hoveredPlatform = null)">
                                @* Platform color indicator *@
                                <div class="@($"size-2 shrink-0 rounded-full {p.Color}")"></div>

                                @* Platform name + verification *@
                                <div class="flex min-w-0 flex-1 items-center gap-1.5">
                                    <span class="text-xs font-medium">@p.ShortName</span>
                                    @if (p.Verified)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-blue-500" />
                                    }
                                </div>

                                @* Score bar *@
                                <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted/50">
                                    <div class="@($"h-full rounded-full {p.Color}")" style="@($"width:{(p.Score / p.MaxScore) * 100:F0}%;opacity:0.7")"></div>
                                </div>

                                @* Score + count *@
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-medium tabular-nums">@p.Score</span>
                                    <span class="text-[10px] tabular-nums text-muted-foreground">@p.ReviewCount.ToString("N0")</span>
                                </div>

                                @* Trend *@
                                @if (p.Trend == "up")
                                {
                                    <LucideIconCn Name="trending-up" Size="12" Class="@($"size-3 transition-opacity {(_hoveredPlatform == p.Id ? "text-emerald-500 opacity-100" : "opacity-0")}")" />
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/20 px-4 py-2">
            <span class="text-[10px] text-muted-foreground">
                Weighted average across all verified platforms
            </span>
            <span class="text-[10px] tabular-nums text-muted-foreground">
                Last synced Mar 28, 2026
            </span>
        </div>
    </div>
</section>

@code {
    private record ReviewPlatform(string Id, string Name, string ShortName, double Score, double MaxScore, int ReviewCount, bool Verified, string Trend, string Color);
    private record StarDistribution(int Stars, int Count, int Percentage);

    private static readonly ReviewPlatform[] _platforms =
    [
        new("greviews",    "Google Reviews",     "Google",     4.6, 5, 3842, true,  "up",     "bg-blue-500"),
        new("trustpilot",  "Trustpilot",         "Trustpilot", 4.4, 5, 2156, true,  "up",     "bg-emerald-500"),
        new("g2",          "G2 Software Reviews","G2",         4.5, 5,  892, true,  "stable", "bg-red-500"),
        new("capterra",    "Capterra Reviews",   "Capterra",   4.3, 5,  614, false, "up",     "bg-amber-500"),
        new("producthunt", "Product Hunt",       "PH",         4.7, 5,  328, true,  "up",     "bg-orange-500"),
    ];

    private static readonly StarDistribution[] _distribution =
    [
        new(5, 4187, 53),
        new(4, 2341, 30),
        new(3,  842, 11),
        new(2,  312,  4),
        new(1,  150,  2),
    ];

    private static readonly int _totalReviews = _platforms.Sum(p => p.ReviewCount);

    private static readonly double _weightedAverage =
        _platforms.Sum(p => p.Score * p.ReviewCount) / _totalReviews;

    private static readonly double _roundedAverage =
        Math.Round(_weightedAverage * 10) / 10;

    private string? _hoveredPlatform;
}
