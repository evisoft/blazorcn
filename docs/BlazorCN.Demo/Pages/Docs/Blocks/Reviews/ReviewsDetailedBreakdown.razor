@* ============================================================
   Block: reviews-detailed-breakdown
   Title: ReviewsDetailedBreakdown
   Description: A detailed rating breakdown block for React and Next.js with category scores, expandable criteria sections, trend sparklines, keyword analysis, and overall verdict built with shadcn/ui Badge, Button, Separator components and Tailwind CSS
   Source: original/blocks/reviews/reviews-detailed-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with overall verdict *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Rating Breakdown</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_totalReviews.ToString("N0") reviews @_periodLabel
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <div class="text-right">
                        <span class="block text-2xl font-semibold tabular-nums">
                            @_weightedOverall.ToString("F1")
                        </span>
                        <span class="text-[10px] text-muted-foreground">weighted avg</span>
                    </div>
                </div>
            </div>
        </div>

        @* Category accordion *@
        <div>
            @foreach (var category in _categories)
            {
                var cat = category;
                var isExpanded = _expandedCategories.Contains(cat.Id);
                var isLast = cat.Id == _categories[_categories.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    @* Category header row *@
                    <button type="button"
                            @onclick="@(() => ToggleCategory(cat.Id))"
                            class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="w-32 shrink-0 truncate text-sm">@cat.Name</span>

                        @* Mini bar *@
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-foreground/10">
                            <div class="h-full rounded-full @BarColor(cat.Score)"
                                 style="@(FormattableString.Invariant($"width:{(cat.Score / 5.0 * 100):F1}%"))">
                            </div>
                        </div>

                        <span class="w-8 shrink-0 text-right text-sm font-medium tabular-nums @ScoreColor(cat.Score)">
                            @cat.Score
                        </span>

                        <div class="w-12 shrink-0">
                            @TrendBadgeMarkup(cat.Change)
                        </div>

                        <BadgeCn Variant="BadgeVariant.Secondary"
                                 Class="w-10 shrink-0 justify-center text-[10px] font-normal tabular-nums">
                            @cat.Weight%
                        </BadgeCn>

                        <LucideIconCn Name="chevron-down" Size="14"
                                      Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/50 transition-transform duration-200", isExpanded ? "rotate-180" : "")" />
                    </button>

                    @* Expanded sub-criteria *@
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="bg-muted/30 px-4 py-2">
                                @foreach (var sub in cat.SubCriteria)
                                {
                                    var subPercent = sub.Score / sub.MaxScore * 100.0;
                                    <div class="flex items-center gap-3 py-1.5">
                                        <span class="w-40 shrink-0 truncate pl-4 text-xs text-muted-foreground">
                                            @sub.Name
                                        </span>
                                        <div class="h-1 flex-1 overflow-hidden rounded-full bg-foreground/5">
                                            <div class="h-full rounded-full bg-foreground/40"
                                                 style="@(FormattableString.Invariant($"width:{subPercent:F1}%"))">
                                            </div>
                                        </div>
                                        <span class="w-7 shrink-0 text-right text-xs tabular-nums text-muted-foreground">
                                            @sub.Score
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <SeparatorCn />

        @* Keywords section *@
        <div class="px-4 py-3">
            <div class="mb-2 flex items-center gap-1.5">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">
                    Top mentioned keywords
                </span>
            </div>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var kw in _topKeywords)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 text-xs font-normal">
                        @if (kw.Sentiment == "negative")
                        {
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                        }
                        @if (kw.Sentiment == "positive")
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                        @if (kw.Sentiment == "neutral")
                        {
                            <span class="size-1.5 rounded-full bg-foreground/30"></span>
                        }
                        @kw.Word
                        <span class="tabular-nums text-muted-foreground">@kw.Count</span>
                    </BadgeCn>
                }
            </div>
        </div>

        <SeparatorCn />

        @* Verdict footer *@
        <div class="flex items-center gap-3 px-4 py-3">
            <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
            <div class="flex-1">
                <span class="text-xs font-medium">Overall Verdict</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Highest rated in Design Quality (4.9) and Ease of Use (4.8). Biggest improvement this
                    quarter in Customer Support (+0.4).
                </p>
            </div>
            <div class="shrink-0 rounded-md bg-emerald-500/10 px-2.5 py-1">
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    Highly Rated
                </span>
            </div>
        </div>

    </div>
</section>

@code {
    private record SubCriterion(string Id, string Name, double Score, double MaxScore);

    private record RatingCategory(string Id, string Name, double Score, double Change, int Weight, SubCriterion[] SubCriteria);

    private record TopKeyword(string Id, string Word, int Count, string Sentiment);

    private const int _totalReviews = 2384;
    private const string _periodLabel = "vs last quarter";

    private static readonly RatingCategory[] _categories =
    [
        new("c1", "Ease of Use", 4.8, 0.2, 25,
        [
            new("c1s1", "Onboarding experience", 4.9, 5),
            new("c1s2", "Learning curve", 4.7, 5),
            new("c1s3", "UI intuitiveness", 4.8, 5),
            new("c1s4", "Workflow efficiency", 4.6, 5),
        ]),
        new("c2", "Documentation", 4.7, 0.5, 15,
        [
            new("c2s1", "API reference completeness", 4.8, 5),
            new("c2s2", "Tutorial quality", 4.6, 5),
            new("c2s3", "Code examples", 4.9, 5),
            new("c2s4", "Changelog clarity", 4.5, 5),
        ]),
        new("c3", "Performance", 4.5, -0.1, 20,
        [
            new("c3s1", "Load time", 4.6, 5),
            new("c3s2", "Bundle size", 4.3, 5),
            new("c3s3", "Runtime efficiency", 4.5, 5),
            new("c3s4", "Memory usage", 4.4, 5),
        ]),
        new("c4", "Design Quality", 4.9, 0.1, 20,
        [
            new("c4s1", "Visual consistency", 4.9, 5),
            new("c4s2", "Responsive behavior", 4.8, 5),
            new("c4s3", "Dark mode support", 4.9, 5),
            new("c4s4", "Animation polish", 4.8, 5),
        ]),
        new("c5", "Customer Support", 4.3, 0.4, 10,
        [
            new("c5s1", "Response time", 4.1, 5),
            new("c5s2", "Issue resolution", 4.4, 5),
            new("c5s3", "Community forums", 4.5, 5),
            new("c5s4", "Live chat quality", 4.2, 5),
        ]),
        new("c6", "Value for Money", 4.4, 0.0, 10,
        [
            new("c6s1", "Pricing transparency", 4.5, 5),
            new("c6s2", "Feature-to-price ratio", 4.3, 5),
            new("c6s3", "Free tier generosity", 4.6, 5),
            new("c6s4", "Upgrade value", 4.2, 5),
        ]),
    ];

    private static readonly TopKeyword[] _topKeywords =
    [
        new("k1", "intuitive", 412, "positive"),
        new("k2", "fast", 356, "positive"),
        new("k3", "well-documented", 289, "positive"),
        new("k4", "clean design", 267, "positive"),
        new("k5", "steep learning curve", 78, "negative"),
        new("k6", "bundle size", 64, "neutral"),
    ];

    private static readonly double _weightedOverall =
        _categories.Sum(c => c.Score * c.Weight) / _categories.Sum(c => c.Weight);

    private HashSet<string> _expandedCategories = ["c1"];

    private void ToggleCategory(string id)
    {
        if (_expandedCategories.Contains(id))
            _expandedCategories.Remove(id);
        else
            _expandedCategories.Add(id);
    }

    private static string ScoreColor(double score)
    {
        if (score >= 4.7) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 4.3) return "text-foreground";
        return "text-amber-600 dark:text-amber-400";
    }

    private static string BarColor(double score)
    {
        if (score >= 4.7) return "bg-emerald-500/70";
        if (score >= 4.3) return "bg-foreground/60";
        return "bg-amber-500/70";
    }

    private RenderFragment TrendBadgeMarkup(double change) => __builder =>
    {
        if (change > 0)
        {
            <span class="flex items-center gap-0.5 text-xs text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />+@change.ToString("F1")
            </span>
        }
        else if (change < 0)
        {
            <span class="flex items-center gap-0.5 text-xs text-red-600 dark:text-red-400">
                <LucideIconCn Name="arrow-down-right" Size="12" Class="size-3" />@change.ToString("F1")
            </span>
        }
        else
        {
            <span class="flex items-center gap-0.5 text-xs text-muted-foreground">
                <LucideIconCn Name="minus" Size="12" Class="size-3" />0.0
            </span>
        }
    };
}
