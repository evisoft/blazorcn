@* ============================================================
   Block: reviews-distribution-bars
   Title: ReviewsDistributionBars
   Description: A rating distribution bars block for React and Next.js with animated bar fills, star-level percentages, satisfaction labels, hover interaction, and aggregate statistics built with shadcn/ui Badge, Button components and Tailwind CSS
   Source: original/blocks/reviews/reviews-distribution-bars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with large score display *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-sm font-medium">Rating Distribution</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_total.ToString("N0") total reviews
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="text-right">
                        <div class="flex items-baseline gap-1">
                            <span class="text-2xl font-semibold tabular-nums">@_average.ToString("F1")</span>
                            <span class="text-xs text-muted-foreground">/ 5</span>
                        </div>
                        <div class="mt-0.5 flex items-center justify-end gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var idx = i;
                                <LucideStarCn Size="10" Class="@(idx < (int)Math.Round(_average) ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Recommendation rate *@
            <div class="mt-3 flex items-center gap-2 rounded-md bg-emerald-500/10 px-3 py-2">
                <LucideTrendingUpCn Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    @_positiveRate% positive
                </span>
                <span class="text-xs text-emerald-600/60 dark:text-emerald-400/60">
                    (@(_positiveCount.ToString("N0")) reviews rated 4+ stars)
                </span>
            </div>
        </div>

        @* Distribution bars *@
        <div>
            @foreach (var rating in _ratings)
            {
                var r = rating;
                var percentage = (int)Math.Round((double)r.Count / _total * 100);
                var isLast = r.Stars == _ratings[_ratings.Length - 1].Stars;
                var isHovered = _hoveredStar == r.Stars;
                <button
                    type="button"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors", isHovered ? "bg-muted/50" : "", isLast ? "" : "border-b")"
                    @onmouseenter="@(() => _hoveredStar = r.Stars)"
                    @onmouseleave="@(() => _hoveredStar = null)">

                    @* Star label with dot *@
                    <div class="flex w-14 shrink-0 items-center gap-1.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", GetDotColor(r.Stars))"></span>
                        <span class="text-xs tabular-nums">@r.Stars</span>
                        <LucideStarCn Size="10" Class="size-2.5 fill-foreground/40 text-foreground/40" />
                    </div>

                    @* Bar (no framer-motion; use CSS transition via inline style width) *@
                    <div class="h-3 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="@Cn.Merge("h-full rounded-full transition-opacity", GetBarColor(r.Stars), (_hoveredStar != null && !isHovered) ? "opacity-40" : "opacity-100")"
                             style="@($"width:{percentage}%")">
                        </div>
                    </div>

                    @* Percentage *@
                    <span class="w-10 shrink-0 text-right font-mono text-xs tabular-nums text-muted-foreground">
                        @(percentage)%
                    </span>

                    @* Count *@
                    <span class="w-12 shrink-0 text-right text-xs tabular-nums text-muted-foreground">
                        @r.Count.ToString("N0")
                    </span>

                    @* Satisfaction label *@
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="w-[72px] shrink-0 justify-center text-[10px] font-normal">
                        @SatisfactionTier(r.Stars)
                    </BadgeCn>
                </button>
            }
        </div>

        @* Footer statistics *@
        <div class="border-t px-4 py-3">
            <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
                <div class="flex items-center gap-1.5">
                    <span class="text-xs font-medium">Average</span>
                    <span class="text-xs tabular-nums text-muted-foreground">@_average.ToString("F1")</span>
                </div>
                <span class="text-muted-foreground/30">|</span>
                <div class="flex items-center gap-1.5">
                    <span class="text-xs font-medium">Median</span>
                    <span class="text-xs tabular-nums text-muted-foreground">@_median</span>
                </div>
                <span class="text-muted-foreground/30">|</span>
                <div class="flex items-center gap-1.5">
                    <span class="text-xs font-medium">5-star rate</span>
                    <span class="text-xs tabular-nums text-muted-foreground">@((int)Math.Round((double)_ratings[0].Count / _total * 100))%</span>
                </div>
                <span class="text-muted-foreground/30">|</span>
                <div class="flex items-center gap-1.5">
                    <span class="text-xs font-medium">1-star rate</span>
                    <span class="text-xs tabular-nums text-muted-foreground">@((int)Math.Round((double)_ratings[4].Count / _total * 100))%</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record RatingLevel(int Stars, int Count);

    private static readonly RatingLevel[] _ratings =
    [
        new(5, 1856),
        new(4, 943),
        new(3, 312),
        new(2, 127),
        new(1, 58),
    ];

    private static readonly int _total = _ratings.Sum(r => r.Count);
    private static readonly double _average = (double)_ratings.Sum(r => r.Stars * r.Count) / _total;
    private static readonly int _positiveCount = _ratings.Where(r => r.Stars >= 4).Sum(r => r.Count);
    private static readonly int _positiveRate = (int)Math.Round((double)_positiveCount / _total * 100);
    private static readonly int _median = ComputeMedian();

    private int? _hoveredStar;

    private static int ComputeMedian()
    {
        // Build sorted list and find middle element
        var sorted = _ratings
            .SelectMany(r => Enumerable.Repeat(r.Stars, r.Count))
            .OrderBy(x => x)
            .ToArray();
        return sorted[sorted.Length / 2];
    }

    private static string GetBarColor(int stars) => stars switch
    {
        5 => "bg-emerald-500",
        4 => "bg-emerald-500/60",
        3 => "bg-amber-500/70",
        2 => "bg-amber-500/50",
        _ => "bg-red-500/60",
    };

    private static string GetDotColor(int stars) => stars switch
    {
        5 => "bg-emerald-500",
        4 => "bg-emerald-500",
        3 => "bg-amber-500",
        2 => "bg-amber-500",
        _ => "bg-red-500",
    };

    private static string SatisfactionTier(int stars) => stars switch
    {
        5 => "Excellent",
        4 => "Good",
        3 => "Average",
        2 => "Below avg",
        _ => "Poor",
    };
}
