@* ============================================================
   Block: reviews-reply-thread
   Title: ReviewsReplyThread
   Description: A React threaded review conversation block for Next.js with nested merchant replies, inline reply composer, helpful vote counters, and animated message threads built with shadcn/ui Avatar, Button, Textarea components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-reply-thread.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Reviews & Responses</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_threads.Length reviews, @_totalReplied with merchant replies
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs tabular-nums text-muted-foreground">
                    @_totalMessages messages
                </span>
            </div>
        </div>

        @* Thread list *@
        <div class="divide-y">
            @foreach (var thread in _threads)
            {
                var tid = thread.Id;
                <div class="px-4 py-4">
                    @* Review author row *@
                    <div class="flex items-start gap-3">
                        <AvatarCn Class="mt-0.5 size-8 shrink-0">
                            <AvatarFallbackCn Class="text-[11px]">@thread.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@thread.Author</span>
                                @if (thread.PurchaseVerified)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        Verified
                                    </BadgeCn>
                                }
                                <span class="text-xs text-muted-foreground">@thread.Date</span>
                            </div>
                            @* Stars *@
                            <div class="mt-1 flex items-center gap-0.5">
                                @for (var i = 0; i < 5; i++)
                                {
                                    var starIndex = i;
                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < thread.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                                }
                            </div>
                            @* Review content *@
                            <p class="mt-1.5 text-sm font-medium">@thread.Title</p>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                @thread.Body
                            </p>
                            @* Actions *@
                            <div class="mt-2.5 flex items-center gap-3">
                                <button
                                    type="button"
                                    @onclick="@(() => HandleHelpful(tid))"
                                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors", _helpfulVoted.Contains(tid) ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                    <span class="tabular-nums">@thread.HelpfulCount</span>
                                </button>
                                <button
                                    type="button"
                                    @onclick="@(() => HandleToggleReply(tid))"
                                    class="flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                                    <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                    Reply
                                </button>
                                @if (_submittedReply == tid)
                                {
                                    <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        Reply posted
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    @* Nested replies *@
                    @if (thread.Replies.Length > 0)
                    {
                        <div class="ml-11 mt-3 space-y-0 border-l-2 border-muted">
                            @foreach (var reply in thread.Replies)
                            {
                                var isMerchant = reply.Role != "Customer";
                                <div class="py-2.5 pl-4">
                                    <div class="flex items-start gap-2.5">
                                        <AvatarCn Class="@Cn.Merge("mt-0.5 size-6 shrink-0", isMerchant ? "ring-1 ring-blue-500/30" : "")">
                                            <AvatarFallbackCn Class="text-[10px]">@reply.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="text-xs font-medium">@reply.Author</span>
                                                @if (isMerchant)
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                                        @reply.Role
                                                    </BadgeCn>
                                                }
                                                <span class="text-[10px] text-muted-foreground">@reply.Date</span>
                                            </div>
                                            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                                @reply.Body
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* Inline reply composer *@
                    @if (_replyingTo == tid)
                    {
                        <div class="ml-11 mt-3 overflow-hidden">
                            <div class="rounded-md border bg-muted/30 p-3">
                                <TextareaCn
                                    aria-label="Write a reply"
                                    Placeholder="Write a reply..."
                                    @bind-Value="_replyText"
                                    Class="min-h-[72px] resize-none border-0 bg-transparent p-0 text-sm shadow-none focus-visible:ring-0" />
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="text-[10px] tabular-nums text-muted-foreground">
                                        @_replyText.Length/@MaxReplyLength
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <ButtonCn
                                            Type="button"
                                            Size="ButtonSize.Sm"
                                            Variant="ButtonVariant.Ghost"
                                            Class="h-7 text-xs"
                                            @onclick="@(() => { _replyingTo = null; _replyText = ""; })">
                                            Cancel
                                        </ButtonCn>
                                        <ButtonCn
                                            Type="button"
                                            Size="ButtonSize.Sm"
                                            Class="h-7 gap-1.5 text-xs"
                                            Disabled="@(string.IsNullOrWhiteSpace(_replyText))"
                                            @onclick="@(() => HandleSubmitReply(tid))">
                                            <LucideIconCn Name="send" Size="12" Class="size-3" />
                                            Reply
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const int MaxReplyLength = 500;

    private record MerchantReply(string Id, string Author, string Initials, string Role, string Date, string Body);

    private sealed class ReviewThread
    {
        public string Id { get; init; } = "";
        public string Author { get; init; } = "";
        public string Initials { get; init; } = "";
        public int Rating { get; init; }
        public string Date { get; init; } = "";
        public string Title { get; init; } = "";
        public string Body { get; init; } = "";
        public int HelpfulCount { get; set; }
        public bool PurchaseVerified { get; init; }
        public MerchantReply[] Replies { get; set; } = [];
    }

    private ReviewThread[] _threads =
    [
        new ReviewThread
        {
            Id = "t1",
            Author = "Angela Torres",
            Initials = "AT",
            Rating = 5,
            Date = "Mar 14, 2026",
            Title = "Outstanding support and fast delivery",
            Body = "Ordered on Monday, arrived Wednesday. The packaging was secure and the product exceeded my expectations. The noise cancellation is noticeably better than my previous pair and the battery easily lasts through a full work day of meetings and music.",
            HelpfulCount = 24,
            PurchaseVerified = true,
            Replies =
            [
                new MerchantReply("t1r1", "James", "JM", "Customer Success Lead", "Mar 15, 2026",
                    "Thank you Angela! We pride ourselves on fast shipping and secure packaging. The Gen 3 noise cancellation chip was a major R&D focus this year. Glad you are enjoying the upgrade."),
                new MerchantReply("t1r2", "Angela Torres", "AT", "Customer", "Mar 15, 2026",
                    "Thanks for the quick reply! One follow up - is there an EQ preset specifically optimized for voice calls? The default sounds great for music but voices are slightly bass-heavy on Zoom."),
                new MerchantReply("t1r3", "James", "JM", "Customer Success Lead", "Mar 16, 2026",
                    "Great question. Go to Settings then Audio Profiles and select the Voice Clarity preset. It boosts the 2-4kHz range for clearer speech. We are also adding an auto-detect mode in the April firmware update."),
            ],
        },
        new ReviewThread
        {
            Id = "t2",
            Author = "Robert Chen",
            Initials = "RC",
            Rating = 2,
            Date = "Mar 10, 2026",
            Title = "Product arrived with a minor defect",
            Body = "The left ear cup had a small scratch on the surface that was visible under direct light. It does not affect functionality but was disappointing for a premium product at this price point. Customer service took 3 days to respond to my initial email.",
            HelpfulCount = 18,
            PurchaseVerified = true,
            Replies =
            [
                new MerchantReply("t2r1", "Sarah", "SR", "Support Manager", "Mar 11, 2026",
                    "Hi Robert, we sincerely apologize for the defect and the delayed response. We have shipped a replacement at no cost via express delivery and added a 15% discount code SORRY15 to your account. We have also escalated the response time issue internally to prevent future delays."),
            ],
        },
        new ReviewThread
        {
            Id = "t3",
            Author = "Nina Kowalski",
            Initials = "NK",
            Rating = 4,
            Date = "Mar 6, 2026",
            Title = "Great quality, wish there were more color options",
            Body = "The build quality is excellent and the matte finish feels premium on my desk. Sound quality rivals headphones at twice the price. My only feedback is that I would love to see more color variants beyond black, white, and navy.",
            HelpfulCount = 9,
            PurchaseVerified = true,
            Replies = [],
        },
    ];

    private string? _replyingTo;
    private string _replyText = "";
    private HashSet<string> _helpfulVoted = [];
    private string? _submittedReply;

    private int _totalReplied => _threads.Count(t => t.Replies.Length > 0);
    private int _totalMessages => _threads.Sum(t => t.Replies.Length);

    private void HandleToggleReply(string threadId)
    {
        if (_replyingTo == threadId)
        {
            _replyingTo = null;
            _replyText = "";
        }
        else
        {
            _replyingTo = threadId;
            _replyText = "";
        }
    }

    private void HandleSubmitReply(string threadId)
    {
        if (string.IsNullOrWhiteSpace(_replyText)) return;

        var newReply = new MerchantReply($"{threadId}-new", "You", "YO", "Customer", "Just now", _replyText.Trim());

        for (var i = 0; i < _threads.Length; i++)
        {
            if (_threads[i].Id == threadId)
            {
                var updated = _threads[i].Replies.Append(newReply).ToArray();
                _threads[i].Replies = updated;
                break;
            }
        }

        _replyText = "";
        _replyingTo = null;
        _submittedReply = threadId;
    }

    private void HandleHelpful(string threadId)
    {
        if (_helpfulVoted.Contains(threadId))
        {
            _helpfulVoted.Remove(threadId);
            for (var i = 0; i < _threads.Length; i++)
            {
                if (_threads[i].Id == threadId)
                {
                    _threads[i].HelpfulCount--;
                    break;
                }
            }
        }
        else
        {
            _helpfulVoted.Add(threadId);
            for (var i = 0; i < _threads.Length; i++)
            {
                if (_threads[i].Id == threadId)
                {
                    _threads[i].HelpfulCount++;
                    break;
                }
            }
        }
    }
}
