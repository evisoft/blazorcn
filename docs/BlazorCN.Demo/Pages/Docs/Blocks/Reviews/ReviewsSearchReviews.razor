@* ============================================================
   Block: reviews-search-reviews
   Title: ReviewsSearchReviews
   Description: A full-text review search block for React and Next.js with live filtering, text highlighting, faceted sidebar filters, and result stats using shadcn/ui Input, Badge, Checkbox, and Tailwind CSS.
   Source: original/blocks/reviews/reviews-search-reviews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn Value="@_query" ValueChanged="@((string v) => _query = v)"
                     Placeholder="Search reviews by keyword..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            @if (_query != "" || _hasActiveFilters)
            {
                <div class="flex shrink-0 items-center gap-2">
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @FilteredResults.Count of @_reviews.Length
                    </span>
                    <button type="button" @onclick="ClearAll"
                            class="rounded-sm p-0.5 text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </button>
                </div>
            }
        </div>

        @* Split panel: sidebar + results *@
        <div class="grid grid-cols-1 md:grid-cols-4">
            @* Sidebar filters *@
            <div class="border-b border-r-0 p-4 md:border-b-0 md:border-r">
                <span class="text-xs font-medium text-muted-foreground">Filters</span>

                @* Rating filter *@
                <div class="mt-3">
                    <span class="text-xs font-medium">Rating</span>
                    <div class="mt-2 space-y-2">
                        @foreach (var ratingVal in new[] { 5, 4, 3, 2, 1 })
                        {
                            var rv = ratingVal;
                            var cnt = _reviews.Count(r => r.Rating == rv);
                            <span class="flex cursor-pointer items-center gap-2" @onclick="@(() => ToggleRating(rv))">
                                <CheckboxCn Checked="@_ratingFilters.Contains(rv)"
                                            CheckedChanged="@((bool _) => ToggleRating(rv))" />
                                <span class="flex items-center gap-0.5">
                                    @for (var si = 0; si < 5; si++)
                                    {
                                        var starIdx = si;
                                        <LucideIconCn Name="star" Size="12"
                                                      Class="@Cn.Merge("size-3", starIdx < rv ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                    }
                                </span>
                                <span class="text-[10px] text-muted-foreground tabular-nums">(@cnt)</span>
                            </span>
                        }
                    </div>
                </div>

                <SeparatorCn Class="my-3" />

                @* Verified filter *@
                <span class="flex cursor-pointer items-center gap-2"
                      @onclick="@(() => _verifiedOnly = !_verifiedOnly)">
                    <CheckboxCn Checked="@_verifiedOnly"
                                CheckedChanged="@((bool v) => _verifiedOnly = v)" />
                    <span class="text-xs font-medium">Verified only</span>
                </span>

                <SeparatorCn Class="my-3" />

                @* Tag filter *@
                <span class="text-xs font-medium">Topics</span>
                <div class="mt-2 space-y-2">
                    @foreach (var tag in _allTags)
                    {
                        var tagSlug = tag.Slug;
                        <span class="flex cursor-pointer items-center gap-2"
                              @onclick="@(() => ToggleTag(tagSlug))">
                            <CheckboxCn Checked="@_selectedTags.Contains(tagSlug)"
                                        CheckedChanged="@((bool _) => ToggleTag(tagSlug))" />
                            <span class="text-xs">@tag.Label</span>
                        </span>
                    }
                </div>
            </div>

            @* Results panel *@
            <div class="col-span-1 md:col-span-3">
                @{
                    var results = FilteredResults;
                }
                @if (results.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center px-4 py-16">
                        <LucideIconCn Name="search" Size="32" Class="size-8 text-muted-foreground/30" />
                        <p class="mt-3 text-sm text-muted-foreground">No reviews match your search</p>
                        <p class="mt-1 text-xs text-muted-foreground">Try adjusting your filters or search terms</p>
                    </div>
                }
                else
                {
                    @for (var idx = 0; idx < results.Count; idx++)
                    {
                        var review = results[idx];
                        var isLast = idx == results.Count - 1;
                        <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                            <div class="px-4 py-3">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                                @review.Author.Initials
                                            </div>
                                            <span class="text-xs font-medium">@review.Author.Name</span>
                                            @if (review.Author.Verified)
                                            {
                                                <LucideIconCn Name="badge-check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                            }
                                            <span class="text-xs text-muted-foreground">@review.Date</span>
                                        </div>
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <div class="flex items-center gap-0.5">
                                                @for (var si2 = 0; si2 < 5; si2++)
                                                {
                                                    var starIdx2 = si2;
                                                    <LucideIconCn Name="star" Size="12"
                                                                  Class="@Cn.Merge("size-3", starIdx2 < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                                }
                                            </div>
                                            <span class="text-sm font-medium">@((MarkupString)HighlightText(review.Title, _query))</span>
                                        </div>
                                    </div>
                                    <span class="shrink-0 text-[10px] text-muted-foreground tabular-nums">
                                        @review.HelpfulCount helpful
                                    </span>
                                </div>
                                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                    @((MarkupString)HighlightText(review.Body, _query))
                                </p>
                                <div class="mt-2 flex flex-wrap gap-1">
                                    @foreach (var tag in review.Tags)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                            @tag.Label
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewAuthor(string Name, string Initials, bool Verified);
    private record ReviewTag(string Label, string Slug);
    private record Review(string Id, ReviewAuthor Author, int Rating, string Date, string Title, string Body, ReviewTag[] Tags, int HelpfulCount);

    private static readonly Review[] _reviews =
    [
        new("sr-1", new("Alex Rivera", "AR", true), 5, "3 days ago",
            "TypeScript support is outstanding",
            "Every component is fully typed with generics where it matters. IntelliSense works perfectly and catches errors at compile time. The type exports are clean and well-documented. We migrated our entire design system from MUI in under a week.",
            [new("TypeScript", "typescript"), new("DX", "dx")], 24),
        new("sr-2", new("Jordan Lee", "JL", true), 4, "1 week ago",
            "Great theming system with CSS variables",
            "The CSS variable approach makes theming incredibly flexible. We created a custom dark mode and brand theme in under an hour. Only wish there were more preset themes included out of the box for rapid prototyping.",
            [new("Theming", "theming"), new("CSS", "css")], 18),
        new("sr-3", new("Sam Patel", "SP", false), 5, "2 weeks ago",
            "Accessibility is built in from the start",
            "ARIA attributes, keyboard navigation, and focus management all work correctly out of the box. We passed our WCAG 2.1 AA audit without any component modifications. The Radix primitives underneath are rock-solid.",
            [new("Accessibility", "a11y"), new("WCAG", "wcag")], 31),
        new("sr-4", new("Casey Morgan", "CM", true), 3, "3 weeks ago",
            "Documentation could be more comprehensive",
            "The basic examples are clear but advanced use cases like server components integration and streaming need more coverage. Had to dig through source code for some patterns. Community Discord was helpful though.",
            [new("Documentation", "docs"), new("DX", "dx")], 12),
        new("sr-5", new("Taylor Brooks", "TB", true), 5, "1 month ago",
            "Perfect for building design systems",
            "We used this as the foundation for our company design system. The unstyled primitives plus Tailwind CSS approach gives us full control over the visual layer while keeping behavior consistent across 40+ components.",
            [new("Design Systems", "design-systems"), new("Tailwind", "tailwind")], 42),
        new("sr-6", new("Riley Chen", "RC", true), 4, "1 month ago",
            "Performance is excellent with tree shaking",
            "Bundle size stayed small even after adding 20+ components. Tree shaking works correctly and the copy-paste model means no runtime dependency overhead. Load times stayed under 100ms on our production app.",
            [new("Performance", "performance"), new("Bundle Size", "bundle")], 27),
        new("sr-7", new("Priya Sharma", "PS", true), 2, "5 weeks ago",
            "Animation integration needs work",
            "Getting motion/react to play nicely with some of the dialog and sheet components required workarounds. The exit animations sometimes conflict with Radix portal behavior. Spent a full day debugging z-index stacking issues.",
            [new("Animations", "animations"), new("Bug", "bug")], 9),
        new("sr-8", new("Marcus Johnson", "MJ", false), 5, "6 weeks ago",
            "Best component library for Next.js App Router",
            "Server components and client components work seamlessly. The use client directive is only needed where it makes sense. RSC support is first-class and data fetching patterns are well thought out for the new Next.js paradigm.",
            [new("Next.js", "nextjs"), new("RSC", "rsc")], 36),
    ];

    private static readonly ReviewTag[] _allTags = _reviews
        .SelectMany(r => r.Tags)
        .GroupBy(t => t.Slug)
        .Select(g => g.First())
        .ToArray();

    private string _query = "";
    private List<int> _ratingFilters = new();
    private bool _verifiedOnly;
    private List<string> _selectedTags = new();

    private bool _hasActiveFilters => _ratingFilters.Count > 0 || _verifiedOnly || _selectedTags.Count > 0;

    private List<Review> FilteredResults
    {
        get
        {
            var q = _query.Trim().ToLowerInvariant();
            return _reviews.Where(review =>
            {
                if (q.Length > 0)
                {
                    if (!review.Title.ToLowerInvariant().Contains(q) &&
                        !review.Body.ToLowerInvariant().Contains(q))
                        return false;
                }
                if (_ratingFilters.Count > 0 && !_ratingFilters.Contains(review.Rating))
                    return false;
                if (_verifiedOnly && !review.Author.Verified)
                    return false;
                if (_selectedTags.Count > 0 && !review.Tags.Any(t => _selectedTags.Contains(t.Slug)))
                    return false;
                return true;
            }).ToList();
        }
    }

    private void ToggleRating(int rating)
    {
        if (_ratingFilters.Contains(rating))
            _ratingFilters.Remove(rating);
        else
            _ratingFilters.Add(rating);
    }

    private void ToggleTag(string slug)
    {
        if (_selectedTags.Contains(slug))
            _selectedTags.Remove(slug);
        else
            _selectedTags.Add(slug);
    }

    private void ClearAll()
    {
        _query = "";
        _ratingFilters.Clear();
        _verifiedOnly = false;
        _selectedTags.Clear();
    }

    private static string HighlightText(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return System.Web.HttpUtility.HtmlEncode(text);

        var q = query.Trim();
        var result = new System.Text.StringBuilder();
        var remaining = text;
        while (remaining.Length > 0)
        {
            var idx = remaining.IndexOf(q, System.StringComparison.OrdinalIgnoreCase);
            if (idx < 0)
            {
                result.Append(System.Web.HttpUtility.HtmlEncode(remaining));
                break;
            }
            result.Append(System.Web.HttpUtility.HtmlEncode(remaining.Substring(0, idx)));
            result.Append("<mark class=\"rounded-sm bg-yellow-200/60 px-0.5 dark:bg-yellow-500/30\">");
            result.Append(System.Web.HttpUtility.HtmlEncode(remaining.Substring(idx, q.Length)));
            result.Append("</mark>");
            remaining = remaining.Substring(idx + q.Length);
        }
        return result.ToString();
    }
}
