@* ============================================================
   Block: reviews-sidebar-summary
   Title: ReviewsSidebarSummary
   Description: A compact sidebar review summary widget for React and Next.js with overall score, star distribution mini-bars, keyword highlights, recent review preview, and write review CTA built with shadcn/ui Button and Progress components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-sidebar-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Score header *@
        <div class="px-4 py-4">
            <div class="flex items-start gap-3">
                <div class="flex flex-col items-center">
                    <span class="text-3xl font-semibold tabular-nums leading-none">@_overallRating</span>
                    <div class="mt-1.5">
                        @* StarDisplay sm *@
                        <div class="flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                int idx = i;
                                <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", idx < (int)Math.Round(_overallRating) ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                            }
                        </div>
                    </div>
                    <span class="mt-1 text-[10px] text-muted-foreground">@_totalReviews.ToString("N0") reviews</span>
                </div>
                <div class="flex-1 space-y-1.5 pt-0.5">
                    @foreach (var level in _ratingDistribution)
                    {
                        <div class="flex items-center gap-2">
                            <span class="w-3 text-right text-[10px] tabular-nums text-muted-foreground">@level.Stars</span>
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground" style="@($"width:{level.Percentage}%")"></div>
                            </div>
                            <span class="w-7 text-right text-[10px] tabular-nums text-muted-foreground">@(level.Percentage)%</span>
                        </div>
                    }
                </div>
            </div>
            <div class="mt-3 flex items-center gap-1.5 rounded-md bg-emerald-500/10 px-2.5 py-1.5">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                <span class="text-xs text-emerald-600 dark:text-emerald-400">
                    <span class="font-medium tabular-nums">@(_recommendRate)%</span> would recommend
                </span>
            </div>
        </div>

        @* Keywords *@
        <div class="border-t px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Top mentions</span>
            <div class="mt-2 flex flex-wrap gap-1.5">
                @foreach (var keyword in _keywords)
                {
                    <span class="@Cn.Merge("inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[10px]", keyword.Sentiment == "positive" ? "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400" : keyword.Sentiment == "neutral" ? "bg-amber-500/10 text-amber-700 dark:text-amber-400" : "bg-red-500/10 text-red-700 dark:text-red-400")">
                        @keyword.Label
                        <span class="tabular-nums opacity-70">@keyword.Count</span>
                    </span>
                }
            </div>
        </div>

        @* Recent review *@
        <div class="border-t px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Latest review</span>
            <div class="mt-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium">@_recentReview.Author</span>
                    <span class="text-[10px] text-muted-foreground">@_recentReview.TimeAgo</span>
                </div>
                <div class="mt-1">
                    @* StarDisplay xs *@
                    <div class="flex items-center gap-0.5">
                        @for (int i = 0; i < 5; i++)
                        {
                            int idx = i;
                            <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < _recentReview.Rating ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                        }
                    </div>
                </div>
                <p class="mt-1.5 line-clamp-3 text-xs text-muted-foreground leading-relaxed">@_recentReview.Excerpt</p>
                <span class="mt-1 block text-[10px] text-muted-foreground">@(_recentReview.Helpful) found this helpful</span>
            </div>
        </div>

        @* CTA *@
        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs">
                <LucideIconCn Name="pen-line" Size="12" Class="size-3" />
                Write a review
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record RatingLevel(int Stars, int Percentage, int Count);
    private record Keyword(string Label, int Count, string Sentiment);
    private record RecentReview(string Author, int Rating, string Excerpt, string TimeAgo, int Helpful);

    private const double _overallRating = 4.7;
    private const int _totalReviews = 2847;
    private const int _recommendRate = 94;

    private static readonly RatingLevel[] _ratingDistribution =
    [
        new(5, 68, 1936),
        new(4, 19, 541),
        new(3, 8, 228),
        new(2, 3, 85),
        new(1, 2, 57),
    ];

    private static readonly Keyword[] _keywords =
    [
        new("easy to use", 412, "positive"),
        new("great quality", 387, "positive"),
        new("fast delivery", 291, "positive"),
        new("good value", 264, "positive"),
        new("minor issues", 78, "neutral"),
        new("slow support", 34, "negative"),
    ];

    private static readonly RecentReview _recentReview = new(
        "Alex Chen",
        5,
        "Exceeded my expectations in every way. The build quality is exceptional and setup was incredibly straightforward. Already recommended to three colleagues.",
        "4h ago",
        12
    );
}
