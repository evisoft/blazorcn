@* ============================================================
   Block: reviews-aggregate-score
   Title: ReviewsAggregateScore
   Description: A premium bento-style aggregate review score block for React and Next.js featuring a prominent score display, star visualization, five-tier rating distribution bars with animated fill widths, recent sentiment breakdown with progress indicators, and category sub-ratings. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/reviews/reviews-aggregate-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Top: Score hero + Distribution side by side *@
        <div class="grid grid-cols-5">
            @* Left: Score hero (2 cols) *@
            <div class="col-span-2 flex flex-col items-center justify-center border-r px-6 py-8">
                <span class="@($"text-5xl font-semibold tabular-nums {_scoreColor}")">@_score</span>
                <div class="mt-2 flex items-center gap-0.5" role="img" aria-label="@($"{_score} out of 5 stars")">
                    @for (int i = 0; i < 5; i++)
                    {
                        var starIdx = i;
                        <LucideIconCn Name="star" Size="16" Class="@(starIdx < (int)Math.Round(_score) ? "size-4 fill-foreground text-foreground" : "size-4 text-muted-foreground/30")" />
                    }
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-2 text-xs font-normal">@_label</BadgeCn>
                <span class="mt-1.5 text-xs text-muted-foreground">@_totalReviews.ToString("N0") reviews</span>
                <div class="mt-3 flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    <span class="tabular-nums">@_recommendRate%</span>
                    <span>would recommend</span>
                </div>
            </div>

            @* Right: Rating distribution (3 cols) *@
            <div class="col-span-3 px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Rating distribution</span>
                <div class="mt-3 space-y-2.5">
                    @foreach (var tier in _ratingDistribution)
                    {
                        var percent = (int)Math.Round((double)tier.Count / _maxCount * 100);
                        var barCssColor = BarColor(tier.Stars);
                        <div class="flex items-center gap-3">
                            <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">
                                @tier.Stars<LucideIconCn Name="star" Size="10" Class="mb-0.5 ml-0.5 inline size-2.5 fill-current" />
                            </span>
                            <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="@($"h-full rounded-full {barCssColor}")" style="@($"width:{percent}%")"></div>
                            </div>
                            <span class="w-12 text-right text-xs tabular-nums text-muted-foreground">@tier.Count.ToString("N0")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Bottom: Category ratings + Recent sentiment *@
        <div class="grid grid-cols-5 border-t">
            @* Left: Category sub-ratings (3 cols) *@
            <div class="col-span-3 border-r px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Category ratings</span>
                <div class="mt-2.5 space-y-2">
                    @foreach (var cat in _categoryRatings)
                    {
                        var catWidth = $"{(cat.Score / 5.0) * 100:F0}%";
                        var catColor = CategoryScoreColor(cat.Score);
                        <div class="flex items-center gap-3">
                            <span class="w-28 text-xs text-muted-foreground">@cat.Label</span>
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/20" style="@($"width:{catWidth}")"></div>
                            </div>
                            <span class="@($"w-8 text-right text-xs font-medium tabular-nums {catColor}")">@cat.Score</span>
                        </div>
                    }
                </div>
            </div>

            @* Right: Recent sentiment (2 cols) *@
            <div class="col-span-2 px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Last 30 days</span>
                </div>
                <div class="mt-3 flex items-center gap-3">
                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-emerald-500/70" style="@($"width:{_positivePercent}%")"></div>
                    </div>
                    <span class="shrink-0 text-xs tabular-nums text-muted-foreground">@_positivePercent%</span>
                </div>
                <div class="mt-3 space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            Positive
                        </span>
                        <span class="text-xs tabular-nums text-muted-foreground">@_recentSentimentPositive</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                            Neutral
                        </span>
                        <span class="text-xs tabular-nums text-muted-foreground">@_recentSentimentNeutral</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            Negative
                        </span>
                        <span class="text-xs tabular-nums text-muted-foreground">@_recentSentimentNegative</span>
                    </div>
                </div>
                <div class="mt-3 rounded-md bg-muted/50 px-2.5 py-2">
                    <span class="text-[10px] text-muted-foreground">@_recentTotal reviews in the last 30 days</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record RatingTier(int Stars, int Count);
    private record CategoryRating(string Label, double Score);

    private const double _score = 4.7;
    private const int _totalReviews = 3842;
    private const string _label = "Excellent";
    private const int _recommendRate = 94;

    private const int _recentSentimentPositive = 312;
    private const int _recentSentimentNeutral = 28;
    private const int _recentSentimentNegative = 9;

    private static readonly RatingTier[] _ratingDistribution =
    [
        new(5, 2486),
        new(4, 845),
        new(3, 312),
        new(2, 127),
        new(1, 72),
    ];

    private static readonly CategoryRating[] _categoryRatings =
    [
        new("Ease of use", 4.8),
        new("Performance", 4.6),
        new("Documentation", 4.5),
        new("Value for money", 4.7),
        new("Customer support", 4.4),
    ];

    private int _maxCount => _ratingDistribution.Max(r => r.Count);
    private int _recentTotal => _recentSentimentPositive + _recentSentimentNeutral + _recentSentimentNegative;
    private int _positivePercent => (int)Math.Round((double)_recentSentimentPositive / _recentTotal * 100);

    private string _scoreColor =>
        _score >= 4.5
            ? "text-emerald-600 dark:text-emerald-400"
            : _score >= 3.5
                ? "text-amber-600 dark:text-amber-400"
                : "text-red-600 dark:text-red-400";

    private static string BarColor(int stars)
    {
        if (stars >= 4) return "bg-emerald-500/70";
        if (stars == 3) return "bg-amber-500/70";
        return "bg-red-500/70";
    }

    private static string CategoryScoreColor(double s)
    {
        if (s >= 4.5) return "text-emerald-600 dark:text-emerald-400";
        if (s >= 4.0) return "text-foreground";
        return "text-amber-600 dark:text-amber-400";
    }
}
