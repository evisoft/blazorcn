@* ========================================
   Block: reviews-cards-grid
   Title: Reviews Cards Grid
   Description: Customer review cards grid with photos, star ratings, and helpful votes for React storefronts
   Long Description: Review analytics dashboard component with rating trends for React seller portals and business tools
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, LucideStarCn, LucideThumbsUpCn
   Source: original/blocks/reviews/reviews-cards-grid.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Customer Reviews</h1>
    </div>

    <div class="mx-auto w-[900px] max-w-full">
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var review in _reviews)
            {
                <CardCn>
                    <CardContentCn Class="p-4">
                        @* Header *@
                        <div class="mb-3 flex items-start gap-3">
                            <AvatarCn Class="h-10 w-10">
                                @if (!string.IsNullOrEmpty(review.Avatar))
                                {
                                    <AvatarImageCn Src="@review.Avatar" Alt="" />
                                }
                                <AvatarFallbackCn>
                                    @GetInitials(review.Author)
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium">@review.Author</span>
                                    @if (review.Verified)
                                    {
                                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                            Verified
                                        </BadgeCn>
                                    }
                                </div>
                                <div class="flex items-center gap-0.5">
                                    @for (int star = 1; star <= 5; star++)
                                    {
                                        <LucideStarCn Size="12" Class="@(star <= review.Rating ? "fill-primary text-primary" : "fill-muted text-muted")" />
                                    }
                                    <span class="ml-1.5 text-xs text-muted-foreground">@review.Date</span>
                                </div>
                            </div>
                        </div>

                        @* Content *@
                        <h2 class="mb-1 font-medium">@review.Title</h2>
                        <p class="mb-3 text-sm text-muted-foreground">@review.Content</p>

                        @* Images *@
                        @if (review.Images is { Length: > 0 })
                        {
                            <div class="mb-3 flex gap-2">
                                @foreach (var image in review.Images)
                                {
                                    <div class="h-16 w-16 overflow-hidden rounded-md border">
                                        <img alt="Review attachment" class="h-full w-full object-cover" height="64" src="@image" width="64" />
                                    </div>
                                }
                            </div>
                        }

                        @* Footer *@
                        <ButtonCn Class="h-8 text-xs" Disabled="@(_helpedReviews.Contains(review.Id))" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => HandleHelpful(review.Id)">
                            <LucideThumbsUpCn Size="12" Class="mr-1" />
                            Helpful (@(review.Helpful + (_helpedReviews.Contains(review.Id) ? 1 : 0)))
                        </ButtonCn>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        <div class="mt-6 text-center">
            <ButtonCn Variant="ButtonVariant.Outline">Load More Reviews</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReviewItem(int Id, string Author, int Rating, string Date, string Title, string Content, bool Verified, int Helpful, string? Avatar = null, string[]? Images = null);

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private readonly HashSet<int> _helpedReviews = [];

    private void HandleHelpful(int reviewId)
    {
        _helpedReviews.Add(reviewId);
    }

    private readonly ReviewItem[] _reviews =
    [
        new(1, "Alexandra Chen", 5, "Dec 2, 2024", "Exceeded all expectations!", "The quality is outstanding. I've been using this daily for two weeks and it still looks brand new. The attention to detail is impressive and customer service was incredibly helpful when I had questions.", true, 47, Images: ["https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&w=200&q=80", "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&w=200&q=80"]),
        new(2, "Marcus Johnson", 4, "Nov 28, 2024", "Great product, minor issues", "Overall very satisfied with my purchase. Build quality is solid and it works as advertised. Took off one star because shipping was slower than expected, but the product itself is excellent.", true, 23),
        new(3, "Sophie Williams", 5, "Nov 25, 2024", "Perfect gift!", "Bought this as a gift and the recipient absolutely loved it. Packaging was beautiful and the product quality matched the photos exactly. Will definitely order again.", true, 31, Images: ["https://images.unsplash.com/photo-1491553895911-0055uj6/652?auto=format&w=200&q=80"]),
        new(4, "David Park", 5, "Nov 20, 2024", "Worth every penny", "I researched extensively before buying and this was the right choice. Premium feel, works flawlessly, and looks even better in person. Highly recommend.", false, 18),
    ];
}
