@* ============================================================
   Block: reviews-photo-grid-gallery
   Title: ReviewsPhotoGridGallery
   Description: A React photo gallery component for Next.js displaying customer review images in a responsive grid with click-to-expand detail overlay, star ratings, and category filters built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-photo-grid-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <span class="font-medium text-sm">Customer Photos</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    @_totalPhotos photos
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">
                @_photoReviews.Length reviews with photos
            </span>
        </div>

        @* Category filter *@
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            @foreach (var cat in _categories)
            {
                var catName = cat;
                <button
                    type="button"
                    @onclick="@(() => { _activeCategory = catName; _selectedId = null; })"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _activeCategory == catName ? "bg-foreground text-background font-medium" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                    @cat
                    @if (cat != "All")
                    {
                        <span class="ml-1 tabular-nums">(@(_photoReviews.Count(r => r.Category == cat)))</span>
                    }
                </button>
            }
        </div>

        @* Photo grid - masonry via columns *@
        <div class="columns-2 gap-0 sm:columns-3">
            @foreach (var photo in FilteredReviews)
            {
                var p = photo;
                <div class="break-inside-avoid">
                    <button
                        type="button"
                        @onclick="@(() => _selectedId = _selectedId == p.Id ? null : p.Id)"
                        class="@Cn.Merge("group relative block w-full border-b border-r transition-all", _selectedId == p.Id ? "ring-2 ring-inset ring-foreground" : "")">
                        @* Photo placeholder *@
                        <div class="@Cn.Merge(p.AspectClass, p.BgShade, "flex items-center justify-center")">
                            <div class="flex flex-col items-center gap-1.5 px-3 text-center">
                                <LucideIconCn Name="camera" Size="20" Class="size-5 text-muted-foreground/30" />
                                <span class="text-muted-foreground/50 text-[10px]">
                                    @p.PhotoLabel
                                </span>
                            </div>
                        </div>

                        @* Hover overlay *@
                        <div class="absolute inset-0 flex flex-col justify-end bg-black/0 p-2.5 pt-8 transition-colors group-hover:bg-black/40">
                            <div class="translate-y-1 opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100">
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var idx = i;
                                        <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", idx < p.Rating ? "fill-white text-white" : "text-white/30")" />
                                    }
                                </div>
                                <span class="mt-0.5 block truncate font-medium text-white text-xs">
                                    @p.Author
                                </span>
                            </div>
                        </div>

                        @* Photo count badge *@
                        @if (p.PhotoCount > 1)
                        {
                            <div class="absolute top-2 right-2">
                                <span class="rounded bg-black/50 px-1.5 py-0.5 font-medium text-[10px] text-white tabular-nums">
                                    @p.PhotoCount
                                </span>
                            </div>
                        }

                        @* Category pill *@
                        <div class="absolute top-2 left-2 opacity-0 transition-opacity group-hover:opacity-100">
                            <span class="rounded bg-black/50 px-1.5 py-0.5 text-[10px] text-white">
                                @p.Category
                            </span>
                        </div>
                    </button>
                </div>
            }
        </div>

        @* Selected review detail panel *@
        @if (_selectedReview is not null)
        {
            var sel = _selectedReview;
            <div class="overflow-hidden border-t">
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted font-medium text-[10px]">
                                    @sel.Initials
                                </div>
                                <span class="font-medium text-sm">@sel.Author</span>
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var idx = i;
                                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < sel.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                    }
                                </div>
                                <span class="text-muted-foreground text-xs">@sel.Date</span>
                            </div>
                            <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                                @sel.FullText
                            </p>
                            <div class="mt-2 flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                    @sel.Category
                                </BadgeCn>
                                <span class="text-muted-foreground text-[10px] tabular-nums">
                                    @sel.PhotoCount @(sel.PhotoCount == 1 ? "photo" : "photos")
                                </span>
                            </div>
                        </div>
                        <button
                            type="button"
                            @onclick="@(() => _selectedId = null)"
                            class="mt-0.5 rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ReviewPhoto(
        string Id,
        string Author,
        string Initials,
        int Rating,
        string Snippet,
        string FullText,
        string PhotoLabel,
        string Category,
        int PhotoCount,
        string Date,
        string AspectClass,
        string BgShade
    );

    private static readonly string[] _categories = ["All", "Product", "Workspace", "Unboxing", "Comparison"];

    private static readonly ReviewPhoto[] _photoReviews =
    [
        new("pg-1", "Sarah Mitchell", "SM", 5, "The color is exactly as shown on the website.", "The color is exactly as shown on the website. Super happy with this purchase. The matte finish feels premium and looks great under both natural and artificial light. No fingerprints either.", "Product on desk", "Product", 3, "Mar 22, 2026", "aspect-[4/5]", "bg-muted/25"),
        new("pg-2", "James Park", "JP", 4, "Build quality is impressive after 6 months.", "Build quality is impressive even after 6 months of daily use. Minor scuff on one corner from a drop but otherwise looks brand new. The materials they chose really hold up over time.", "6-month wear test", "Product", 2, "Mar 20, 2026", "aspect-square", "bg-muted/35"),
        new("pg-3", "Elena Rodriguez", "ER", 5, "Fits perfectly between my dual monitors.", "Perfect size for my workspace. Fits right between my dual monitors without crowding anything. The cable management clips on the back are a thoughtful touch that keeps my desk clean.", "Workspace overview", "Workspace", 1, "Mar 18, 2026", "aspect-[3/4]", "bg-muted/20"),
        new("pg-4", "Marcus Thompson", "MT", 4, "Unboxing was a premium experience.", "Unboxing experience was top-tier. Minimal eco-friendly packaging, no plastic wrap, and a magnetic closure on the box. The product was secured with molded pulp inserts. Great first impression.", "Unboxing photo", "Unboxing", 4, "Mar 15, 2026", "aspect-[4/5]", "bg-muted/30"),
        new("pg-5", "Lisa Chen", "LC", 5, "New vs. old model side by side. Major upgrade.", "Side-by-side comparison with the v2 model. The v3 is noticeably thinner, lighter, and the screen bezels are almost invisible. Port selection improved too with two additional USB-C connections.", "v2 vs v3 comparison", "Comparison", 3, "Mar 12, 2026", "aspect-square", "bg-muted/25"),
        new("pg-6", "David Kim", "DK", 3, "Good product but cable management needs work.", "The product itself looks great from the front. However, the back panel where cables connect is poorly designed. Cables stick out at awkward angles and the included cable clips do not stay in place.", "Rear cable routing", "Product", 2, "Mar 10, 2026", "aspect-[3/4]", "bg-muted/40"),
        new("pg-7", "Priya Sharma", "PS", 5, "My home office setup is complete.", "This was the final piece for my home office setup. Paired with the matching desk mat and monitor arm, everything looks cohesive. Multiple coworkers have asked me for the product link.", "Complete office setup", "Workspace", 5, "Mar 8, 2026", "aspect-square", "bg-muted/20"),
        new("pg-8", "Ryan Foster", "RF", 4, "Packaging sustainability is a plus.", "Ordered as a gift and the unboxing experience made it feel premium. Everything was wrapped in recyclable paper, no foam or plastic anywhere. The quick-start card inside was a nice touch.", "Gift unboxing", "Unboxing", 2, "Mar 5, 2026", "aspect-[4/5]", "bg-muted/35"),
        new("pg-9", "Nina Kowalski", "NK", 5, "Compared three brands, this one wins easily.", "I bought three competing products to compare. This one wins on build quality, design, and value. Returning the other two. The attention to detail on edge finishing and material choice is clearly a tier above.", "3-brand comparison", "Comparison", 6, "Mar 2, 2026", "aspect-[3/4]", "bg-muted/25"),
    ];

    private static readonly int _totalPhotos = _photoReviews.Sum(r => r.PhotoCount);

    private string _activeCategory = "All";
    private string? _selectedId;

    private IEnumerable<ReviewPhoto> FilteredReviews =>
        _activeCategory == "All"
            ? _photoReviews
            : _photoReviews.Where(r => r.Category == _activeCategory);

    private ReviewPhoto? _selectedReview => _photoReviews.FirstOrDefault(r => r.Id == _selectedId);
}
