@* ============================================================
   Block: reviews-quick-rating
   Title: ReviewsQuickRating
   Description: A compact one-tap quick rating widget for React and Next.js with animated star selector, emoji sentiment feedback, optional comment input, and submission confirmation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-quick-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (!_submitted)
        {
            @* Header *@
            <div class="border-b px-4 py-3">
                <span class="text-sm font-medium">Rate your experience</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Your feedback helps us improve
                </p>
            </div>

            @* Star selector with emoji feedback *@
            <div class="px-4 py-5">
                <div class="flex flex-col items-center gap-3">
                    @* Stars *@
                    <div class="flex items-center gap-1">
                        @foreach (var star in new[] { 1, 2, 3, 4, 5 })
                        {
                            var s = star;
                            var isFilled = _activeStar.HasValue && s <= _activeStar.Value;
                            <button type="button"
                                    class="rounded-md p-1 transition-colors hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                    @onmouseenter="@(() => _hoveredStar = s)"
                                    @onmouseleave="@(() => _hoveredStar = null)"
                                    @onclick="@(() => _selectedRating = s)"
                                    aria-label="@($"Rate {s} out of 5")">
                                <LucideIconCn Name="star" Size="28" Class="@Cn.Merge("size-7 transition-colors duration-150", isFilled ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                            </button>
                        }
                    </div>

                    @* Sentiment label *@
                    <div class="flex h-7 items-center">
                        @if (_activeSentiment != null)
                        {
                            <div class="flex items-center gap-1.5">
                                <span class="text-lg">@_activeSentiment.Emoji</span>
                                <span class="@Cn.Merge("text-sm font-medium", _activeSentiment.Color)">@_activeSentiment.Label</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-xs text-muted-foreground">Select a rating</span>
                        }
                    </div>
                </div>

                @* Optional comment *@
                @if (_selectedRating.HasValue)
                {
                    <div class="mt-4">
                        @if (!_showComment)
                        {
                            <button type="button"
                                    class="w-full rounded-md border border-dashed px-3 py-2 text-left text-xs text-muted-foreground transition-colors hover:border-foreground/20 hover:bg-muted/50"
                                    @onclick="@(() => _showComment = true)">
                                Add a comment (optional)
                            </button>
                        }
                        else
                        {
                            <TextareaCn aria-label="Tell us more about your experience" @bind-Value="_comment"
                                        Placeholder="Tell us more about your experience..."
                                        Class="min-h-[72px] resize-none text-sm"
                                        Rows="3" />
                        }
                    </div>
                }
            </div>

            @* Footer *@
            @if (_selectedRating.HasValue)
            {
                <div class="border-t px-4 py-3">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs" OnClick="HandleSubmit">Submit rating</ButtonCn>
                </div>
            }
        }
        else
        {
            <div class="flex flex-col items-center gap-3 px-4 py-8">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div class="text-center">
                    <p class="text-sm font-medium">Thank you for your feedback</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        You rated @_selectedRating out of 5 stars@(_comment.Length > 0 ? " with a comment" : "")
                    </p>
                </div>
                <button type="button"
                        class="mt-1 text-xs text-muted-foreground underline-offset-4 hover:underline"
                        @onclick="ResetForm">
                    Change rating
                </button>
            </div>
        }
    </div>
</section>

@code {
    private record SentimentOption(string Emoji, string Label, string Color);

    private static readonly Dictionary<int, SentimentOption> _sentimentMap = new()
    {
        { 1, new("\U0001F61E", "Poor", "text-red-500") },
        { 2, new("\U0001F615", "Below average", "text-amber-500") },
        { 3, new("\U0001F610", "Average", "text-amber-500") },
        { 4, new("\U0001F60A", "Good", "text-emerald-500") },
        { 5, new("\U0001F929", "Excellent", "text-emerald-500") },
    };

    private int? _hoveredStar;
    private int? _selectedRating;
    private string _comment = "";
    private bool _showComment;
    private bool _submitted;

    private int? _activeStar => _hoveredStar ?? _selectedRating;
    private SentimentOption? _activeSentiment => _activeStar.HasValue ? _sentimentMap[_activeStar.Value] : null;

    private void HandleSubmit()
    {
        if (!_selectedRating.HasValue) return;
        _submitted = true;
    }

    private void ResetForm()
    {
        _submitted = false;
        _selectedRating = null;
        _comment = "";
        _showComment = false;
    }
}
