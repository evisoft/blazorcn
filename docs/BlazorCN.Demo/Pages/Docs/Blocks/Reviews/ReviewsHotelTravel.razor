            ["Premium pricing for the minibar"]
        ),
        new(
            "r2", "Thomas Bergman", "TB", "Sweden", "Mar 10, 2026", 4,
            "Business", "2 nights", "Executive Room", "Mar 8", "Mar 10",
            [
                new("Cleanliness", 5),
                new("Location",    5),
                new("Service",     4),
                new("Rooms",       4),
                new("Value",       3),
            ],
            "Excellent business stay near Bahnhofstrasse",
            "Great location for meetings in the financial district. The executive lounge was quiet and well-stocked. WiFi was fast and reliable. Room was comfortable but the desk lamp could be brighter for late-night work.",
            ["Walking distance to Paradeplatz", "Quiet executive lounge", "Reliable high-speed WiFi"],
            ["Desk lighting insufficient", "Expensive room service"]
        ),
        new(
            "r3", "Lina Vasquez", "LV", "Spain", "Feb 28, 2026", 4,
            "Family", "6 nights", "Family Suite", "Feb 22", "Feb 28",
            [
                new("Cleanliness", 4),
                new("Location",    4),
                new("Service",     5),
                new("Rooms",       4),
                new("Value",       4),
            ],
            "Kids loved the pool and kids club",
            "Traveled with two kids and the hotel made it seamless. The family suite was spacious with a connecting room. Kids club kept them entertained while we visited the old town. Breakfast buffet had great options for picky eaters.",
            ["Supervised kids club included", "Spacious connecting rooms", "Family-friendly breakfast"],
            ["Pool area crowded on weekends"]
        ),
        new(
            "r4", "Rajesh Mehta", "RM", "India", "Feb 15, 2026", 5,
            "Solo", "3 nights", "Superior Room", "Feb 12", "Feb 15",
            [
                new("Cleanliness", 5),
                new("Location",    5),
