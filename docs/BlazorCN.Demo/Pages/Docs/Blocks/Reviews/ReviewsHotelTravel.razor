@* ============================================================
   Block: reviews-hotel-travel
   Title: ReviewsHotelTravel
   Description: A split-panel hotel review block for React and Next.js with category bar ratings, trip metadata badges, room type indicators, and expandable guest comments. Built with shadcn/ui Badge, Progress, Tabs, and Tailwind CSS.
   Source: original/blocks/reviews/reviews-hotel-travel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid overflow-hidden rounded-lg border bg-card md:grid-cols-[280px_1fr]">

        @* Left panel - Hotel summary *@
        <div class="border-b border-r-0 bg-muted/30 md:border-b-0 md:border-r">
            <div class="p-4">
                <div>
                    <span class="text-sm font-medium">@_hotelName</span>
                    <div class="mt-1 flex items-center gap-1.5 text-xs text-muted-foreground">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_hotelLocation
                    </div>
                </div>

                @* Overall score *@
                <div class="mt-4 flex items-baseline gap-1.5">
                    <span class="text-2xl font-semibold tabular-nums">@_overallScore</span>
                    <span class="text-xs text-muted-foreground">/5</span>
                    <span class="ml-1 text-xs text-muted-foreground">
                        from @_totalReviews.ToString("N0") reviews
                    </span>
                </div>

                @* Stars *@
                <div class="mt-1 flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", idx < (int)Math.Round(_overallScore) ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                    }
                </div>
            </div>

            @* Category breakdown *@
            <div class="border-t px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Category ratings</span>
                <div class="mt-2.5 space-y-3">
                    @foreach (var category in _hotelCategories)
                    {
                        var cat = category;
                        <div class="space-y-1">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="@cat.IconName" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">@cat.Name</span>
                                </div>
                                <span class="@Cn.Merge("text-xs font-medium tabular-nums", ScoreColor(cat.Score))">
                                    @cat.Score.ToString("F1")
                                </span>
                            </div>
                            <ProgressCn Value="@((cat.Score / 5.0) * 100.0)" Class="h-1" aria-label="Progress" />
                        </div>
                    }
                </div>
            </div>

            @* Traveler breakdown *@
            <div class="border-t px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Traveler types</span>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var travelerType in _travelerTypes)
                    {
                        var tt = travelerType;
                        var cnt = _reviews.Count(r => r.TravelerType == tt);
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal tabular-nums">
                            @tt (@cnt)
                        </BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Right panel - Reviews *@
        <div class="flex flex-col">
            <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)" Class="flex flex-1 flex-col">
                <div class="border-b px-4 py-2">
                    <TabsListCn Class="h-8 w-full justify-start bg-transparent p-0">
                        <TabsTriggerCn Value="all" Class="h-7 rounded-md px-2.5 text-xs data-[state=active]:bg-muted">
                            All
                        </TabsTriggerCn>
                        @foreach (var travelerType in _travelerTypes.Where(t => _reviews.Any(r => r.TravelerType == t)))
                        {
                            var tt = travelerType;
                            <TabsTriggerCn Value="@tt.ToLower()" Class="h-7 rounded-md px-2.5 text-xs data-[state=active]:bg-muted">
                                @tt
                            </TabsTriggerCn>
                        }
                    </TabsListCn>
                </div>

                <TabsContentCn Value="@_activeTab" Class="mt-0 flex-1">
                    @{
                        var filteredReviews = _activeTab == "all"
                            ? _reviews
                            : _reviews.Where(r => r.TravelerType.ToLower() == _activeTab).ToArray();
                    }
                    @if (filteredReviews.Length == 0)
                    {
                        <div class="flex items-center justify-center py-12 text-sm text-muted-foreground">
                            No reviews for this traveler type
                        </div>
                    }
                    else
                    {
                        @foreach (var review in filteredReviews.Select((r, i) => new { Review = r, Index = i }))
                        {
                            var rv = review.Review;
                            var idx = review.Index;
                            var isLast = idx == filteredReviews.Length - 1;
                            var isExpanded = _expandedId == rv.Id;
                            <div class="@(isLast ? "" : "border-b")">
                                <button type="button"
                                        class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50"
                                        @onclick="@(() => _expandedId = (_expandedId == rv.Id ? null : rv.Id))">
                                    <div class="flex items-start gap-3">
                                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                            @rv.Initials
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium">@rv.Author</span>
                                                <span class="text-[10px] text-muted-foreground">@rv.Country</span>
                                            </div>
                                            <div class="mt-0.5 flex items-center gap-2">
                                                <div class="flex items-center gap-0.5">
                                                    @for (int si = 0; si < 5; si++)
                                                    {
                                                        var starIdx = si;
                                                        <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIdx < rv.Overall ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                                                    }
                                                </div>
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                                    @rv.TravelerType
                                                </BadgeCn>
                                                <span class="text-[10px] text-muted-foreground">@rv.Date</span>
                                            </div>
                                            <p class="mt-1.5 text-sm font-medium">@rv.Title</p>
                                            <p class="mt-0.5 line-clamp-2 text-xs text-muted-foreground leading-relaxed">
                                                @rv.Comment
                                            </p>
                                        </div>
                                    </div>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="overflow-hidden">
                                        <div class="px-4 pb-3 pl-[3.25rem]">
                                            @* Stay details *@
                                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                                <span class="flex items-center gap-1">
                                                    <LucideIconCn Name="bed-double" Size="12" Class="size-3" />
                                                    @rv.RoomType
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <LucideIconCn Name="calendar-days" Size="12" Class="size-3" />
                                                    @rv.CheckIn - @rv.CheckOut (@rv.StayDuration)
                                                </span>
                                            </div>

                                            @* Full comment *@
                                            <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                                                @rv.Comment
                                            </p>

                                            @* Pros and Cons *@
                                            <div class="mt-3 grid gap-2 sm:grid-cols-2">
                                                @if (rv.Positives.Length > 0)
                                                {
                                                    <div class="rounded-md bg-emerald-500/5 p-2.5">
                                                        <span class="text-[10px] font-medium text-emerald-600">
                                                            What guests liked
                                                        </span>
                                                        <ul class="mt-1 space-y-0.5">
                                                            @foreach (var pos in rv.Positives)
                                                            {
                                                                var p = pos;
                                                                <li class="flex items-start gap-1.5 text-xs text-muted-foreground">
                                                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-emerald-500"></span>
                                                                    @p
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                                @if (rv.Negatives.Length > 0)
                                                {
                                                    <div class="rounded-md bg-amber-500/5 p-2.5">
                                                        <span class="text-[10px] font-medium text-amber-600">
                                                            Could improve
                                                        </span>
                                                        <ul class="mt-1 space-y-0.5">
                                                            @foreach (var neg in rv.Negatives)
                                                            {
                                                                var n = neg;
                                                                <li class="flex items-start gap-1.5 text-xs text-muted-foreground">
                                                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-amber-500"></span>
                                                                    @n
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                            </div>

                                            @* Per-review category scores *@
                                            <div class="mt-3 rounded-md bg-muted/50 p-2.5">
                                                <span class="text-[10px] font-medium text-muted-foreground">
                                                    Category scores
                                                </span>
                                                <div class="mt-1.5 grid grid-cols-5 gap-2">
                                                    @foreach (var catScore in rv.Categories)
                                                    {
                                                        var cs = catScore;
                                                        <div class="text-center">
                                                            <span class="@Cn.Merge("text-sm font-medium tabular-nums", ScoreColor(cs.Score))">
                                                                @cs.Score
                                                            </span>
                                                            <p class="mt-0.5 text-[10px] text-muted-foreground">
                                                                @cs.Name
                                                            </p>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private string _activeTab = "all";
    private string? _expandedId;

    private const string _hotelName = "The Linden Grand Hotel & Spa";
    private const string _hotelLocation = "Zurich, Switzerland";
    private const int _totalReviews = 1247;

    private record CategoryScore(string Name, double Score, string IconName);
    private record ReviewCategoryScore(string Name, int Score);
    private record Review(
        string Id,
        string Author,
        string Initials,
        string Country,
        string Date,
        int Overall,
        string TravelerType,
        string StayDuration,
        string RoomType,
        string CheckIn,
        string CheckOut,
        ReviewCategoryScore[] Categories,
        string Title,
        string Comment,
        string[] Positives,
        string[] Negatives
    );

    private static readonly CategoryScore[] _hotelCategories =
    [
        new("Cleanliness", 4.7, "star"),
        new("Location",    4.9, "map-pin"),
        new("Service",     4.5, "users"),
        new("Rooms",       4.3, "bed-double"),
        new("Value",       4.0, "star"),
    ];

    private static readonly double _overallScore =
        Math.Round(_hotelCategories.Sum(c => c.Score) / _hotelCategories.Length * 10.0) / 10.0;

    private static readonly Review[] _reviews =
    [
        new(
            "r1", "Emily Nakamura", "EN", "Japan", "Mar 18, 2026", 5,
            "Couple", "4 nights", "Deluxe Suite", "Mar 14", "Mar 18",
            [
