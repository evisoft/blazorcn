@* ========================================
   Block: reviews-request
   Title: Reviews Request
   Description: Review request card component with rating selector for post-purchase flows
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, CardHeaderCn, SeparatorCn, LucideStarCn
   Source: original/blocks/reviews/reviews-request.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Review Request</h1>
    </div>

    <div class="mx-auto w-[420px] max-w-full">
        <CardCn>
            <CardHeaderCn Class="pb-4 text-center">
                <h2 class="text-lg font-semibold">How was your purchase?</h2>
                <p class="text-sm text-muted-foreground">Your feedback helps other shoppers</p>
            </CardHeaderCn>

            <CardContentCn Class="space-y-6">
                @* Product *@
                <div class="flex items-center gap-4">
                    <img alt="@_productName" class="h-16 w-16 rounded-lg border object-cover" height="64" src="@_productImage" width="64" />
                    <div class="flex-1 space-y-1">
                        <p class="font-medium leading-tight">@_productName</p>
                        <p class="text-sm text-muted-foreground">@_productVariant</p>
                    </div>
                </div>

                <SeparatorCn />

                @* Rating *@
                <div class="space-y-3">
                    <div class="flex justify-center gap-1">
                        @for (int rating = 1; rating <= 5; rating++)
                        {
                            var r = rating;
                            <button aria-label="@($"Rate {r} stars")" class="rounded-md p-1.5 transition-transform hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" type="button" @onclick="() => _selectedRating = r" @onmouseenter="() => _hoveredRating = r" @onmouseleave="() => _hoveredRating = null">
                                <LucideStarCn Size="32" Class="@(DisplayRating.HasValue && r <= DisplayRating.Value ? "fill-primary text-primary" : "fill-muted text-muted-foreground")" />
                            </button>
                        }
                    </div>
                    <p class="h-5 text-center text-sm text-muted-foreground">
                        @(DisplayRating.HasValue ? _ratingLabels[DisplayRating.Value] : "Select a rating")
                    </p>
                </div>

                @* Incentive *@
                <div class="flex justify-center">
                    <BadgeCn Class="font-normal" Variant="BadgeVariant.Secondary">
                        Get 10% off your next order
                    </BadgeCn>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2">
                <ButtonCn Class="w-full" Disabled="@(!_selectedRating.HasValue)">
                    Write Review
                </ButtonCn>
                <ButtonCn Class="w-full" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                    Maybe Later
                </ButtonCn>
                <p class="mt-2 text-xs text-muted-foreground">
                    Order @_orderNumber &#183; @_orderDate
                </p>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private int? _selectedRating;
    private int? _hoveredRating;
    private int? DisplayRating => _hoveredRating ?? _selectedRating;

    private const string _productName = "Premium Wireless Headphones";
    private const string _productImage = "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&w=200&q=80";
    private const string _productVariant = "Matte Black";
    private const string _orderDate = "November 28, 2024";
    private const string _orderNumber = "ORD-2024-8847";

    private readonly Dictionary<int, string> _ratingLabels = new()
    {
        [1] = "Poor",
        [2] = "Fair",
        [3] = "Good",
        [4] = "Very Good",
        [5] = "Excellent",
    };
}
