@* ============================================================
   Block: reviews-infinite-scroll
   Title: ReviewsInfiniteScroll
   Description: A fixed-height scrollable review list for React and Next.js with load-more simulation, skeleton loading placeholders, smooth entrance animations, and helpful vote interactions. Built with shadcn/ui Button, Badge, Skeleton, and Tailwind CSS.
   Source: original/blocks/reviews/reviews-infinite-scroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex shrink-0 items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Customer Reviews</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal tabular-nums">
                    @TotalReviews reviews
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground tabular-nums">
                    @_loadedDisplay loaded
                </span>
                <div class="h-1 w-16 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground/60 transition-all duration-300 ease-out"
                         style="@($"width:{_progressPercent:F1}%")">
                    </div>
                </div>
            </div>
        </div>

        @* Scrollable review list *@
        <div class="flex-1 overflow-y-auto overscroll-contain">
            @foreach (var rev in _visibleReviews)
            {
                var review = rev;
                var isHelpful = _helpfulSet.Contains(review.Id);
                <div class="border-b">
                    <div class="px-4 py-3">
                        @* Author row *@
                        <div class="flex items-center gap-2.5">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                @review.Author.Initials
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@review.Author.Name</span>
                                    @if (review.Author.Verified)
                                    {
                                        <LucideIconCn Name="circle-check-big" Size="12" Class="size-3 text-emerald-500" />
                                    }
                                    <span class="text-[10px] text-muted-foreground tabular-nums">
                                        @review.Author.ReviewCount reviews
                                    </span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <div class="flex items-center gap-0.5">
                                        @for (var si = 0; si < 5; si++)
                                        {
                                            var starIndex = si;
                                            <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIndex < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                                        }
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">@review.Date</span>
                                    <span class="text-[10px] text-muted-foreground">@review.Product</span>
                                </div>
                            </div>
                        </div>

                        @* Review content *@
                        <div class="mt-2 pl-[2.625rem]">
                            <p class="text-sm font-medium">@review.Title</p>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@review.Body</p>

                            @* Helpful vote *@
                            <button type="button"
                                    class="@Cn.Merge("mt-2 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors", isHelpful ? "bg-foreground/5 text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")"
                                    @onclick="@(() => ToggleHelpful(review.Id))">
                                <LucideIconCn Name="thumbs-up" Size="12" Class="@Cn.Merge("size-3", isHelpful ? "fill-foreground" : "")" />
                                <span class="tabular-nums">@(review.Helpful + (isHelpful ? 1 : 0))</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* Loading skeletons *@
            @if (_loading)
            {
                <div class="space-y-0 border-b">
                    @for (var si = 0; si < 2; si++)
                    {
                        <div class="border-b px-4 py-3 last:border-b-0">
                            <div class="flex items-center gap-2.5">
                                <SkeletonCn Class="size-8 rounded-full" />
                                <div class="flex-1 space-y-1.5">
                                    <SkeletonCn Class="h-3 w-32" />
                                    <SkeletonCn Class="h-2.5 w-20" />
                                </div>
                            </div>
                            <div class="mt-2 space-y-1.5 pl-[2.625rem]">
                                <SkeletonCn Class="h-3.5 w-48" />
                                <SkeletonCn Class="h-3 w-full" />
                                <SkeletonCn Class="h-3 w-3/4" />
                            </div>
                        </div>
                    }
                </div>
            }

            @* Load more *@
            @if (_hasMore && !_loading)
            {
                <div class="flex flex-col items-center gap-2 px-4 py-4">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" @onclick="LoadMore">
                        <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                        Load more reviews
                    </ButtonCn>
                    <span class="text-[10px] text-muted-foreground tabular-nums">
                        @(TotalReviews - _loadedDisplay) more available
                    </span>
                </div>
            }

            @* All loaded *@
            @if (!_hasMore)
            {
                <div class="flex items-center justify-center py-4">
                    <span class="text-xs text-muted-foreground">All @TotalReviews reviews loaded</span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex shrink-0 items-center justify-between border-t px-4 py-2">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span class="tabular-nums">4.4 avg rating</span>
                <span>-</span>
                <span class="tabular-nums">87% recommend</span>
            </div>
            @if (_loading)
            {
                <LucideIconCn Name="loader" Size="12" Class="size-3 animate-spin text-muted-foreground" />
            }
        </div>
    </div>
</section>

@code {
    private const int TotalReviews = 184;
    private const int BatchSize = 4;

    private int _loadedCount = BatchSize;
    private bool _loading;
    private readonly HashSet<string> _helpfulSet = [];

    private int _loadedDisplay => Math.Min(_loadedCount, TotalReviews);
    private bool _hasMore => _loadedCount < TotalReviews;
    private double _progressPercent => (_loadedDisplay / (double)TotalReviews) * 100.0;
    private ReviewItem[] _visibleReviews => _allReviews[..Math.Min(_loadedCount, _allReviews.Length)];

    private void ToggleHelpful(string id)
    {
        if (!_helpfulSet.Add(id))
            _helpfulSet.Remove(id);
    }

    private async Task LoadMore()
    {
        _loading = true;
        await Task.Delay(900);
        _loadedCount = Math.Min(_loadedCount + BatchSize, TotalReviews);
        _loading = false;
    }

    private record ReviewAuthorInfo(string Name, string Initials, int ReviewCount, bool Verified);
    private record ReviewItem(string Id, ReviewAuthorInfo Author, int Rating, string Date, string Title, string Body, int Helpful, string Product);

