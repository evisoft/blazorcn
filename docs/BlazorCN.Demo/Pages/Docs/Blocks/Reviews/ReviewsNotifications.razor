@* ========================================
   Block: reviews-notifications
   Title: Reviews Notifications
   Description: Review notification feed component with real-time activity for seller dashboards
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, CardHeaderCn, CardTitleCn, SeparatorCn, LucideCheckCn, LucideMessageSquareCn, LucideStarCn, LucideThumbsDownCn, LucideThumbsUpCn, LucideTrash2Cn
   Source: original/blocks/reviews/reviews-notifications.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Notifications</h1>
        <p class="mt-2 text-muted-foreground">Recent review activity</p>
    </div>

    <div class="mx-auto w-[500px] max-w-full">
        <CardCn>
            <CardHeaderCn Class="pb-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <CardTitleCn Class="text-base font-medium">Activity</CardTitleCn>
                        @if (UnreadCount > 0)
                        {
                            <BadgeCn Class="tabular-nums" Variant="BadgeVariant.Secondary">
                                @UnreadCount new
                            </BadgeCn>
                        }
                    </div>
                    @if (UnreadCount > 0)
                    {
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="MarkAllAsRead">
                            <LucideCheckCn Size="14" Class="mr-1.5" />
                            Mark all read
                        </ButtonCn>
                    }
                </div>
            </CardHeaderCn>
            <CardContentCn Class="p-0">
                @for (int i = 0; i < _notifications.Count; i++)
                {
                    var notification = _notifications[i];
                    var index = i;
                    <div>
                        <button type="button" class="@Cn.Merge("flex w-full gap-3 p-4 text-left transition-colors hover:bg-muted/50", notification.IsRead ? "" : "bg-muted/30")" @onclick="() => MarkAsRead(notification.Id)">
                            @if (!string.IsNullOrEmpty(notification.AuthorAvatar))
                            {
                                <AvatarCn Class="h-9 w-9">
                                    <AvatarImageCn Alt="@notification.AuthorName" Src="@notification.AuthorAvatar" />
                                    <AvatarFallbackCn>@GetInitials(notification.AuthorName)</AvatarFallbackCn>
                                </AvatarCn>
                            }
                            else
                            {
                                <div class="flex h-9 w-9 items-center justify-center rounded-full border">
                                    @if (notification.Type == "new_review")
                                    {
                                        <LucideStarCn Size="16" />
                                    }
                                    else if (notification.Type == "reply")
                                    {
                                        <LucideMessageSquareCn Size="16" />
                                    }
                                    else if (notification.Type == "helpful")
                                    {
                                        <LucideThumbsUpCn Size="16" />
                                    }
                                    else if (notification.Type == "unhelpful")
                                    {
                                        <LucideThumbsDownCn Size="16" />
                                    }
                                    else
                                    {
                                        <LucideTrash2Cn Size="16" />
                                    }
                                </div>
                            }

                            <div class="flex-1 space-y-1">
                                <div class="flex items-start justify-between gap-2">
                                    <p class="text-sm">
                                        <span class="font-medium">@notification.AuthorName</span>
                                        @if (notification.Type == "new_review")
                                        {
                                            <span class="text-muted-foreground">
                                                @(" left a ")@if (notification.Rating.HasValue){<span class="font-medium">@(notification.Rating)-star</span>}@(" review")
                                            </span>
                                        }
                                        @if (notification.Type == "reply")
                                        {
                                            <span class="text-muted-foreground"> replied to your response</span>
                                        }
                                        @if (notification.Type == "helpful")
                                        {
                                            <span class="text-muted-foreground"> found your response helpful</span>
                                        }
                                    </p>
                                    @if (!notification.IsRead)
                                    {
                                        <div class="h-2 w-2 shrink-0 rounded-full bg-primary"></div>
                                    }
                                </div>
                                <p class="text-sm text-muted-foreground line-clamp-1">@notification.Content</p>
                                <p class="text-xs text-muted-foreground">@notification.Product &#183; @notification.Time</p>
                            </div>
                        </button>
                        @if (index < _notifications.Count - 1)
                        {
                            <SeparatorCn />
                        }
                    </div>
                }
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private class NotificationItem
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "";
        public string AuthorName { get; set; } = "";
        public string AuthorAvatar { get; set; } = "";
        public string Content { get; set; } = "";
        public string Product { get; set; } = "";
        public int? Rating { get; set; }
        public string Time { get; set; } = "";
        public bool IsRead { get; set; }
    }

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private int UnreadCount => _notifications.Count(n => !n.IsRead);

    private void MarkAsRead(string id)
    {
        var n = _notifications.FirstOrDefault(x => x.Id == id);
        if (n != null) n.IsRead = true;
    }

    private void MarkAllAsRead()
    {
        foreach (var n in _notifications) n.IsRead = true;
    }

    private readonly List<NotificationItem> _notifications =
    [
        new() { Id = "1", Type = "new_review", AuthorName = "Emily Parker", AuthorAvatar = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80", Content = "Excellent quality and fast shipping. Very impressed!", Product = "Wireless Mouse", Rating = 5, Time = "5 min ago", IsRead = false },
        new() { Id = "2", Type = "helpful", AuthorName = "David Kim", AuthorAvatar = "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80", Content = "Your response was marked as helpful", Product = "USB-C Hub", Time = "1 hour ago", IsRead = false },
        new() { Id = "3", Type = "reply", AuthorName = "Sarah Mitchell", AuthorAvatar = "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&w=100&q=80", Content = "Thank you for the quick response! Issue resolved.", Product = "Desk Lamp", Time = "3 hours ago", IsRead = true },
        new() { Id = "4", Type = "new_review", AuthorName = "Michael Chen", AuthorAvatar = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&w=100&q=80", Content = "Product arrived damaged. Waiting for replacement.", Product = "Monitor Stand", Rating = 2, Time = "5 hours ago", IsRead = true },
        new() { Id = "5", Type = "removed", AuthorName = "System", AuthorAvatar = "", Content = "A review was removed for violating guidelines", Product = "Keyboard", Time = "1 day ago", IsRead = true },
    ];
}
