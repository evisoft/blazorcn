@* ============================================================
   Block: reviews-insight-metrics
   Title: ReviewsInsightMetrics
   Description: A bento grid analytics dashboard for React and Next.js with sentiment gauge, NPS score, response time tracking, review volume sparklines, and period comparison built with shadcn/ui Tabs and Badge components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-insight-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium">Review Insights</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_data.Volume.Total.ToString("N0") reviews
                </BadgeCn>
            </div>
            <TabsCn Value="@_period" ValueChanged="@((string v) => SetPeriod(v))" Class="h-auto">
                <TabsListCn Class="h-7">
                    <TabsTriggerCn Value="7d" Class="h-5 px-2 text-xs">7d</TabsTriggerCn>
                    <TabsTriggerCn Value="30d" Class="h-5 px-2 text-xs">30d</TabsTriggerCn>
                    <TabsTriggerCn Value="90d" Class="h-5 px-2 text-xs">90d</TabsTriggerCn>
                </TabsListCn>
            </TabsCn>
        </div>

        @* Bento grid - top row *@
        <div class="grid grid-cols-3 border-b">

            @* Sentiment Score *@
            <div class="border-r p-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="smile" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Sentiment Score</span>
                </div>
                <div class="mt-3 flex items-baseline gap-2">
                    <span class="@Cn.Merge("text-3xl font-semibold tabular-nums", SentimentColor(_data.Sentiment.Score))">
                        @_data.Sentiment.Score
                    </span>
                    <span class="text-xs text-muted-foreground">/100</span>
                    @TrendIndicator(_data.Sentiment.Trend)
                </div>
                @* Sentiment bar *@
                <div class="mt-3 flex h-1.5 overflow-hidden rounded-full bg-muted">
                    <div class="bg-emerald-500 transition-all duration-500"
                         style="@($"width:{_data.Sentiment.Breakdown.Positive}%")"></div>
                    <div class="bg-amber-500 transition-all duration-500"
                         style="@($"width:{_data.Sentiment.Breakdown.Neutral}%")"></div>
                    <div class="bg-red-500 transition-all duration-500"
                         style="@($"width:{_data.Sentiment.Breakdown.Negative}%")"></div>
                </div>
                <div class="mt-2 flex items-center gap-3">
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        @(_data.Sentiment.Breakdown.Positive)% pos
                    </span>
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @(_data.Sentiment.Breakdown.Neutral)% neu
                    </span>
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @(_data.Sentiment.Breakdown.Negative)% neg
                    </span>
                </div>
            </div>

            @* NPS *@
            <div class="border-r p-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Net Promoter Score</span>
                </div>
                <div class="mt-3 flex items-baseline gap-2">
                    <span class="text-3xl font-semibold tabular-nums">
                        @(_data.Nps.Score > 0 ? "+" : "")@_data.Nps.Score
                    </span>
                    @TrendIndicator(_data.Nps.Trend)
                </div>
                @* NPS breakdown bar *@
                <div class="mt-3 flex h-1.5 overflow-hidden rounded-full bg-muted">
                    <div class="bg-emerald-500 transition-all duration-500"
                         style="@($"width:{_data.Nps.Breakdown.Promoters}%")"></div>
                    <div class="bg-muted-foreground/20 transition-all duration-500"
                         style="@($"width:{_data.Nps.Breakdown.Passives}%")"></div>
                    <div class="bg-red-500 transition-all duration-500"
                         style="@($"width:{_data.Nps.Breakdown.Detractors}%")"></div>
                </div>
                <div class="mt-2 flex items-center gap-3">
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        @(_data.Nps.Breakdown.Promoters)% promoters
                    </span>
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                        @(_data.Nps.Breakdown.Passives)% passive
                    </span>
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @(_data.Nps.Breakdown.Detractors)% detract
                    </span>
                </div>
            </div>

            @* Response Time *@
            <div class="p-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Median Response Time</span>
                </div>
                <div class="mt-3 flex items-baseline gap-2">
                    <span class="text-3xl font-semibold tabular-nums">
                        @_data.ResponseTime.MedianHours
                    </span>
                    <span class="text-xs text-muted-foreground">hours</span>
                    @TrendIndicator(_data.ResponseTime.Trend)
                </div>
                @* SLA compliance *@
                <div class="mt-3">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] text-muted-foreground">
                            SLA compliance (@(_data.ResponseTime.Sla.TargetHours)h target)
                        </span>
                        <span class="text-[10px] font-medium tabular-nums">@_slaPercent%</span>
                    </div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="@Cn.Merge("h-full rounded-full transition-all duration-500", _slaPercent >= 90 ? "bg-emerald-500" : _slaPercent >= 75 ? "bg-amber-500" : "bg-red-500")"
                             style="@($"width:{_slaPercent}%")"></div>
                    </div>
                    <span class="mt-1 block text-[10px] text-muted-foreground tabular-nums">
                        @(_data.ResponseTime.Sla.WithinTarget)/@(_data.ResponseTime.Sla.Total) within target
                    </span>
                </div>
            </div>
        </div>

        @* Bottom row: Volume sparkline + top categories *@
        <div class="grid grid-cols-3">

            @* Volume with sparkline — spans 2 cols *@
            <div class="col-span-2 border-r p-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Review Volume</span>
                    </div>
                    @TrendIndicator(_data.Volume.Trend)
                </div>
                <div class="mt-2 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        @_data.Volume.Total.ToString("N0")
                    </span>
                    <span class="text-xs text-muted-foreground">@_data.Volume.Trend.Label</span>
                </div>
                @* Sparkline bars *@
                <div class="mt-3 flex items-end gap-1" aria-hidden="true">
                    @foreach (var pt in _data.Volume.Sparkline)
                    {
                        var barH = Math.Max((double)pt.Value / _maxSparkline * 48, 4);
                        <div class="flex flex-1 flex-col items-center gap-1">
                            <div class="w-full origin-bottom rounded-sm bg-foreground/15"
                                 style="@($"height:{barH:F0}px")"></div>
                            <span class="text-[10px] text-muted-foreground">@pt.Label</span>
                        </div>
                    }
                </div>
            </div>

            @* Top categories — spans 1 col *@
            <div class="p-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Top Categories</span>
                </div>
                <div class="mt-3 space-y-2.5">
                    @foreach (var cat in _data.TopCategories)
                    {
                        <div class="flex items-center justify-between">
                            <span class="truncate text-xs">@cat.Name</span>
                            <div class="flex items-center gap-2">
                                <span class="text-xs tabular-nums text-muted-foreground">@cat.Count</span>
                                <span class="@Cn.Merge("text-[10px] tabular-nums", cat.Change >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                    @(cat.Change > 0 ? "+" : "")@(cat.Change)%
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private string _period = "30d";

    private record MetricTrend(string Direction, string Value, string Label);
    private record SentimentBreakdown(int Positive, int Neutral, int Negative);
    private record NpsBreakdown(int Promoters, int Passives, int Detractors);
    private record SlaCompliance(int WithinTarget, int Total, int TargetHours);
    private record SparklinePoint(string Label, int Value);

    private record SentimentMetric(int Score, MetricTrend Trend, SentimentBreakdown Breakdown);
    private record NpsMetric(int Score, MetricTrend Trend, NpsBreakdown Breakdown);
    private record ResponseTimeMetric(double MedianHours, MetricTrend Trend, SlaCompliance Sla);
    private record VolumeMetric(int Total, MetricTrend Trend, SparklinePoint[] Sparkline);
    private record CategoryEntry(string Name, int Count, int Change);
    private record PeriodMetrics(SentimentMetric Sentiment, NpsMetric Nps, ResponseTimeMetric ResponseTime, VolumeMetric Volume, CategoryEntry[] TopCategories);

    private static readonly Dictionary<string, PeriodMetrics> _periods = new()
    {
        ["7d"] = new(
            Sentiment: new(82, new("up", "+3.1", "vs prior week"), new(68, 19, 13)),
            Nps: new(47, new("up", "+5", "vs prior week"), new(62, 23, 15)),
            ResponseTime: new(4.2, new("down", "-1.8h", "vs prior week"), new(89, 94, 8)),
            Volume: new(847, new("up", "+12%", "vs prior week"), [
                new("Mon", 98), new("Tue", 134), new("Wed", 112),
                new("Thu", 145), new("Fri", 128), new("Sat", 87), new("Sun", 143),
            ]),
            TopCategories: [
                new("Onboarding UX", 142, 18),
                new("API reliability", 98, -4),
                new("Billing clarity", 87, 12),
                new("Mobile experience", 64, 7),
            ]
        ),
        ["30d"] = new(
            Sentiment: new(78, new("up", "+2.4", "vs prior month"), new(64, 21, 15)),
            Nps: new(42, new("up", "+3", "vs prior month"), new(58, 26, 16)),
            ResponseTime: new(5.1, new("down", "-2.3h", "vs prior month"), new(312, 364, 8)),
            Volume: new(3241, new("up", "+8%", "vs prior month"), [
                new("Wk 1", 724), new("Wk 2", 812), new("Wk 3", 798), new("Wk 4", 907),
            ]),
            TopCategories: [
                new("Onboarding UX", 512, 14),
                new("API reliability", 389, -2),
                new("Pricing transparency", 334, 9),
                new("Documentation gaps", 278, -6),
            ]
        ),
        ["90d"] = new(
            Sentiment: new(74, new("up", "+4.8", "vs prior quarter"), new(61, 22, 17)),
            Nps: new(38, new("up", "+7", "vs prior quarter"), new(54, 28, 18)),
            ResponseTime: new(6.4, new("down", "-3.1h", "vs prior quarter"), new(891, 1047, 8)),
            Volume: new(9847, new("up", "+22%", "vs prior quarter"), [
                new("M1", 2841), new("M2", 3198), new("M3", 3808),
            ]),
            TopCategories: [
                new("Onboarding UX", 1423, 21),
                new("API reliability", 1187, 3),
                new("Support quality", 967, 15),
                new("Feature requests", 842, 8),
            ]
        ),
    };

    private PeriodMetrics _data = _periods["30d"];
    private int _slaPercent = 0;
    private int _maxSparkline = 1;

    protected override void OnInitialized()
    {
        RecalcDerived();
    }

    private void SetPeriod(string v)
    {
        _period = v;
        _data = _periods[v];
        RecalcDerived();
    }

    private void RecalcDerived()
    {
        _slaPercent = (int)Math.Round((double)_data.ResponseTime.Sla.WithinTarget / _data.ResponseTime.Sla.Total * 100);
        _maxSparkline = _data.Volume.Sparkline.Max(p => p.Value);
        if (_maxSparkline == 0) _maxSparkline = 1;
    }

    private static string SentimentColor(int score)
    {
        if (score >= 75) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 50) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private RenderFragment TrendIndicator(MetricTrend trend) => __builder =>
    {
        var isPositive = trend.Direction == "up";
        var colorClass = isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400";
        <span class="@Cn.Merge("flex items-center gap-0.5 text-xs", colorClass)">
            @if (isPositive)
            {
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
            }
            else
            {
                <LucideIconCn Name="arrow-down-right" Size="12" Class="size-3" />
            }
            @trend.Value
        </span>
    };
}
