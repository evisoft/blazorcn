@* ============================================================
   Block: reviews-category-ratings
   Title: ReviewsCategoryRatings
   Description: A multi-category rating breakdown block for React and Next.js with animated horizontal bars, weighted score calculations, trend indicators, and reviewer highlights built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-category-ratings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with overall score *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Guest Ratings</span>
                    <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                            <span class="tabular-nums">@_totalReviews.ToString("N0")</span> verified reviews
                        </span>
                    </div>
                </div>
                <div class="text-right">
                    <div class="flex items-center gap-1.5">
                        <span class="text-2xl font-semibold tabular-nums">@_overallScore</span>
                        <div class="flex flex-col items-start">
                            <div class="flex items-center gap-0.5">
                                @for (int i = 0; i < 5; i++)
                                {
                                    var idx = i;
                                    <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", idx < (int)Math.Round(_overallScore) ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                                }
                            </div>
                            <span class="text-[10px] text-muted-foreground">Weighted average</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Quick insights bar *@
        <div class="flex items-center justify-between border-b bg-muted/20 px-4 py-2">
            <div class="flex items-center gap-1">
                <span class="text-[10px] text-muted-foreground">Highest:</span>
                <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
                    @_highestCategory.Label (@_highestCategory.Score)
                </span>
            </div>
            <div class="flex items-center gap-1">
                <span class="text-[10px] text-muted-foreground">Needs attention:</span>
                <span class="text-[10px] font-medium text-amber-600 dark:text-amber-400">
                    @_lowestCategory.Label (@_lowestCategory.Score)
                </span>
            </div>
        </div>

        @* Category bars *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                @foreach (var category in _categories)
                {
                    var cat = category;
                    var barPercent = (cat.Score / 5.0) * 100.0;
                    var isHovered = _hoveredCategory == cat.Id;
                    var scoreDiff = cat.Score - cat.PreviousScore;
                    var tooltipText = scoreDiff > 0
                        ? $"+{scoreDiff:F1} vs last quarter"
                        : scoreDiff == 0.0
                            ? "No change vs last quarter"
                            : $"{scoreDiff:F1} vs last quarter";

                    <div class="group"
                         @onmouseenter="@(() => _hoveredCategory = cat.Id)"
                         @onmouseleave="@(() => _hoveredCategory = null)">

                        @* Label row *@
                        <div class="mb-1 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm">@cat.Label</span>
                                <TooltipProviderCn>
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <span class="cursor-help">
                                                @if (cat.Trend == "up")
                                                {
                                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-emerald-500" />
                                                }
                                                else if (cat.Trend == "down")
                                                {
                                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-red-500" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="minus" Size="12" Class="size-3 text-muted-foreground" />
                                                }
                                            </span>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="text-xs">
                                            @tooltipText
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TooltipProviderCn>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] text-muted-foreground tabular-nums">@cat.ReviewCount reviews</span>
                                <span class="@Cn.Merge("text-sm font-medium tabular-nums", GetScoreColor(cat.Score))">@cat.Score</span>
                            </div>
                        </div>

                        @* Bar *@
                        <div class="relative h-2 w-full overflow-hidden rounded-full bg-muted/50">
                            <div class="@Cn.Merge("h-full rounded-full transition-opacity", GetBarColor(cat.Score), isHovered ? "opacity-100" : "opacity-80")"
                                 style="@(FormattableString.Invariant($"width:{barPercent:F1}%"))">
                            </div>
                        </div>

                        @* Hover detail *@
                        @if (isHovered)
                        {
                            <div class="mt-1 overflow-hidden">
                                <span class="text-[10px] text-muted-foreground italic">
                                    Most mentioned: "@(cat.TopMention)"
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Recent reviews with category highlights *@
        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Recent highlights</span>
            <div class="mt-2.5 space-y-3">
                @foreach (var review in _recentReviews)
                {
                    var rv = review;
                    <div class="flex items-start gap-2.5">
                        <AvatarCn Class="size-6 shrink-0">
                            <AvatarFallbackCn Class="text-[9px]">@rv.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="text-xs font-medium">@rv.Author</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[9px] font-normal">@rv.StayType</BadgeCn>
                                <span class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var idx = i;
                                        <LucideIconCn Name="star" Size="8" Class="@Cn.Merge("size-2", idx < rv.OverallScore ? "fill-amber-500 text-amber-500" : "text-muted-foreground/20")" />
                                    }
                                </span>
                                <span class="text-[10px] text-muted-foreground">@rv.Date</span>
                            </div>
                            <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@rv.Comment</p>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="text-[9px] text-emerald-600 dark:text-emerald-400">Best: @rv.BestCategory</span>
                                <span class="text-[9px] text-muted-foreground/40">|</span>
                                <span class="text-[9px] text-amber-600 dark:text-amber-400">Lowest: @rv.WorstCategory</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private string? _hoveredCategory;

    private record RatingCategory(
        string Id,
        string Label,
        double Score,
        double PreviousScore,
        string Trend,
        int ReviewCount,
        double Weight,
        string TopMention
    );

    private record CategoryReview(
        string Id,
        string Author,
        string Initials,
        string BestCategory,
        string WorstCategory,
        int OverallScore,
        string Comment,
        string Date,
        string StayType
    );

    private static readonly RatingCategory[] _categories =
    [
        new("cat-1", "Room Quality",  4.7, 4.5, "up",     892,  1.3, "Spacious and modern"),
        new("cat-2", "Service",       4.9, 4.8, "up",    1034,  1.2, "Exceptionally attentive"),
        new("cat-3", "Location",      4.8, 4.8, "stable",  967,  1.1, "Walking distance to everything"),
        new("cat-4", "Cleanliness",   4.6, 4.7, "down",  1102,  1.0, "Spotless rooms"),
        new("cat-5", "Value",         4.2, 4.0, "up",     856,  0.9, "Fair for the quality"),
        new("cat-6", "Dining",        4.5, 4.3, "up",     743,  0.8, "Excellent breakfast buffet"),
        new("cat-7", "Amenities",     4.4, 4.4, "stable",  612,  0.7, "Great pool and spa"),
    ];

    private static readonly CategoryReview[] _recentReviews =
    [
        new("cr-1", "Katherine Wells", "KW", "Service",   "Value",        5, "Staff arranged a private dinner on the terrace for our anniversary. The concierge knew every local restaurant worth trying.",                                          "3 days ago",  "Couple"),
        new("cr-2", "Robert Huang",    "RH", "Location",  "Room Quality", 4, "Prime location on the waterfront with easy access to transit. Room was slightly smaller than photos suggested but very clean.",                                       "1 week ago",  "Business"),
        new("cr-3", "Amara Osei",      "AO", "Amenities", "Dining",       5, "The kids loved the pool and activity center. Breakfast was good but dinner options were limited for families with young children.",                                   "2 weeks ago", "Family"),
    ];

    private static readonly int _totalReviews = _categories.Select(c => c.ReviewCount).Sum();

    private static readonly double _overallScore = Math.Round(
        _categories.Sum(c => c.Score * c.Weight) / _categories.Sum(c => c.Weight),
        1);

    private static readonly RatingCategory _highestCategory = _categories.OrderByDescending(c => c.Score).First();
    private static readonly RatingCategory _lowestCategory  = _categories.OrderBy(c => c.Score).First();

    private static string GetScoreColor(double score)
    {
        if (score >= 4.7) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 4.3) return "text-foreground";
        return "text-amber-600 dark:text-amber-400";
    }

    private static string GetBarColor(double score)
    {
        if (score >= 4.7) return "bg-emerald-500";
        if (score >= 4.3) return "bg-foreground";
        return "bg-amber-500";
    }
}
