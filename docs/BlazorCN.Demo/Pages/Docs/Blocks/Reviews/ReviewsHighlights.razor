@* ========================================
   Block: reviews-highlights
   Title: Reviews Highlights
   Description: Review highlights component with pros, cons, themes, and verified buyer stats for React stores
   Long Description: Review submission form with star rating selector and validation for Next.js ecommerce apps
   Dependencies: LucideCheckCn, LucideMinusCn, LucideShieldCheckCn, LucideStarCn, LucideThumbsUpCn, LucideUsersCn
   Source: original/blocks/reviews/reviews-highlights.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Review Highlights</h1>
        <p class="mt-2 text-sm text-muted-foreground">What customers are saying most</p>
    </div>

    <div class="mx-auto w-[900px] max-w-full space-y-6">
        @* Stats Cards *@
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <CardCn>
                <CardContentCn Class="p-4">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                            <LucideStarCn Class="h-5 w-5 text-primary" Size="20" />
                        </div>
                        <div>
                            <p class="text-2xl font-semibold tabular-nums">@_highlights.AverageRating</p>
                            <p class="text-xs text-muted-foreground">Average rating</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>

            <CardCn>
                <CardContentCn Class="p-4">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                            <LucideUsersCn Class="h-5 w-5 text-primary" Size="20" />
                        </div>
                        <div>
                            <p class="text-2xl font-semibold tabular-nums">@_highlights.TotalReviews.ToString("N0")</p>
                            <p class="text-xs text-muted-foreground">Total reviews</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>

            <CardCn>
                <CardContentCn Class="p-4">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                            <LucideShieldCheckCn Class="h-5 w-5 text-primary" Size="20" />
                        </div>
                        <div>
                            <p class="text-2xl font-semibold tabular-nums">@_verifiedPercent%</p>
                            <p class="text-xs text-muted-foreground">Verified buyers</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>

            <CardCn>
                <CardContentCn Class="p-4">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                            <LucideThumbsUpCn Class="h-5 w-5 text-primary" Size="20" />
                        </div>
                        <div>
                            <p class="text-2xl font-semibold tabular-nums">@_highlights.RecommendationRate%</p>
                            <p class="text-xs text-muted-foreground">Would recommend</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>
        </div>

        @* Themes *@
        <CardCn>
            <CardHeaderCn Class="pb-3">
                <CardTitleCn Class="text-base">Common Themes</CardTitleCn>
            </CardHeaderCn>
            <CardContentCn>
                <div class="flex flex-wrap gap-2">
                    @foreach (var theme in _highlights.Themes)
                    {
                        <button type="button" class="focus:outline-none"
                                @onclick="@(() => _selectedTheme = _selectedTheme == theme.Name ? null : theme.Name)">
                            <BadgeCn Class="cursor-pointer px-3 py-1.5 text-sm"
                                     Variant="@(_selectedTheme == theme.Name ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                @theme.Name
                                <span class="ml-1.5 text-xs opacity-70">(@theme.Count)</span>
                            </BadgeCn>
                        </button>
                    }
                </div>
            </CardContentCn>
        </CardCn>

        @* Pros and Cons *@
        <CardCn>
            <TabsCn Class="w-full" DefaultValue="pros">
                <CardHeaderCn Class="pb-0">
                    <TabsListCn Class="w-full justify-start">
                        <TabsTriggerCn Class="gap-1.5" Value="pros">
                            <LucideCheckCn Class="h-4 w-4" Size="16" />
                            What customers liked
                        </TabsTriggerCn>
                        <TabsTriggerCn Class="gap-1.5" Value="cons">
                            <LucideMinusCn Class="h-4 w-4" Size="16" />
                            Room for improvement
                        </TabsTriggerCn>
                    </TabsListCn>
                </CardHeaderCn>

                <CardContentCn Class="pt-4">
                    <TabsContentCn Class="mt-0 space-y-3" Value="pros">
                        @foreach (var pro in _highlights.Pros)
                        {
                            <div class="flex items-center justify-between rounded-lg border p-3">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10">
                                        <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                                    </div>
                                    <span class="text-sm font-medium">@pro.Text</span>
                                </div>
                                <BadgeCn Class="tabular-nums" Variant="BadgeVariant.Secondary">
                                    @pro.Count mentions
                                </BadgeCn>
                            </div>
                        }
                    </TabsContentCn>

                    <TabsContentCn Class="mt-0 space-y-3" Value="cons">
                        @foreach (var con in _highlights.Cons)
                        {
                            <div class="flex items-center justify-between rounded-lg border p-3">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-muted">
                                        <LucideMinusCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                    </div>
                                    <span class="text-sm font-medium">@con.Text</span>
                                </div>
                                <BadgeCn Class="tabular-nums" Variant="BadgeVariant.Secondary">
                                    @con.Count mentions
                                </BadgeCn>
                            </div>
                        }
                    </TabsContentCn>
                </CardContentCn>
            </TabsCn>
        </CardCn>
    </div>
</section>

@code {
    private record Highlight(string Text, int Count);
    private record Theme(string Name, int Count);
    private record ReviewHighlightsData(int TotalReviews, double AverageRating, int VerifiedPurchases, int RecommendationRate, Highlight[] Pros, Highlight[] Cons, Theme[] Themes);

    private static readonly ReviewHighlightsData _highlights = new(
        1284,
        4.6,
        1156,
        94,
        [
            new("Excellent build quality", 847),
            new("Fast shipping", 623),
            new("Great value for money", 589),
            new("Easy to use", 445),
            new("Responsive customer service", 312),
        ],
        [
            new("Limited color options", 124),
            new("Instructions could be clearer", 89),
            new("Packaging could be improved", 67),
        ],
        [
            new("Quality", 892),
            new("Value", 654),
            new("Shipping", 543),
            new("Design", 421),
            new("Support", 312),
        ]
    );

    private static readonly int _verifiedPercent = (int)Math.Round((double)_highlights.VerifiedPurchases / _highlights.TotalReviews * 100);
    private string? _selectedTheme;
}
