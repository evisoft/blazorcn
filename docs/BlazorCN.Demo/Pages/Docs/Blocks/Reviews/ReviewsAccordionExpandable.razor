@* ============================================================
   Block: reviews-accordion-expandable
   Title: ReviewsAccordionExpandable
   Description: A premium expandable review accordion block for React and Next.js with smooth AnimatePresence height animations, staggered entrance transitions, star ratings with author avatars, chevron rotation, and helpful vote interactions. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/reviews/reviews-accordion-expandable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Customer Reviews</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_reviews.Length reviews
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < (int)Math.Round(_averageRating) ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                    }
                </div>
                <span class="text-xs font-medium tabular-nums">@_averageRating.ToString("F1")</span>
                <span class="text-xs text-muted-foreground">@_verifiedCount verified</span>
            </div>
        </div>

        @* Accordion rows *@
        <div>
            @for (var ri = 0; ri < _reviews.Length; ri++)
            {
                var review = _reviews[ri];
                var index = ri;
                var isExpanded = _expandedId == review.Id;
                var isLast = index == _reviews.Length - 1;
                var isHelpful = _helpfulSet.Contains(review.Id);

                <div class="@((!isLast || isExpanded) ? "border-b" : "")">
                    @* Collapsed trigger *@
                    <button type="button"
                            aria-expanded="@isExpanded.ToString().ToLower()"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleExpanded(review.Id))">
                        <AvatarCn Class="size-7 shrink-0">
                            <AvatarFallbackCn Class="text-[10px]">@review.Author.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-sm font-medium">@review.Title</span>
                                @if (review.Verified)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <div class="flex items-center gap-0.5">
                                    @for (var si = 0; si < 5; si++)
                                    {
                                        var starIdx = si;
                                        <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIdx < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                    }
                                </div>
                                <span class="text-xs text-muted-foreground">@review.Author.Name</span>
                                <span class="text-xs text-muted-foreground/60">@review.Date</span>
                            </div>
                        </div>
                        <div class="@(isExpanded ? "rotate-180" : "") transition-transform duration-200">
                            <LucideIconCn Name="chevron-down" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        </div>
                    </button>

                    @* Expanded content *@
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4">
                                @* Author detail *@
                                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                    <span class="font-medium text-foreground">@review.Author.Name</span>
                                    <span>@review.Author.Role</span>
                                    <span class="text-muted-foreground/40">@review.Author.ReviewCount reviews</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        @review.PurchaseTier
                                    </BadgeCn>
                                </div>

                                @* Body *@
                                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                                    @review.Body
                                </p>

                                @* Pros and Cons *@
                                <div class="mt-3 grid grid-cols-2 gap-3">
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Pros</span>
                                        <ul class="mt-1.5 space-y-1">
                                            @foreach (var pro in review.Pros)
                                            {
                                                <li class="text-xs leading-snug text-muted-foreground">+ @pro</li>
                                            }
                                        </ul>
                                    </div>
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <span class="text-xs font-medium text-red-600 dark:text-red-400">Cons</span>
                                        <ul class="mt-1.5 space-y-1">
                                            @foreach (var con in review.Cons)
                                            {
                                                <li class="text-xs leading-snug text-muted-foreground">- @con</li>
                                            }
                                        </ul>
                                    </div>
                                </div>

                                @* Actions *@
                                <div class="mt-3 flex items-center gap-3">
                                    <div @onclick:stopPropagation @onclick="@(() => ToggleHelpful(review.Id))">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                  Class="@Cn.Merge("h-7 gap-1.5 px-2.5 text-xs", isHelpful ? "text-foreground" : "text-muted-foreground")">
                                            <LucideIconCn Name="thumbs-up" Size="12" Class="@Cn.Merge("size-3", isHelpful ? "fill-current" : "")" />
                                            Helpful (@(review.Helpful + (isHelpful ? 1 : 0)))
                                        </ButtonCn>
                                    </div>
                                    <span class="text-xs text-muted-foreground/60">@review.Date</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_averageRating.ToString("F1") avg across @_reviews.Length reviews
            </span>
            <span class="text-xs text-muted-foreground">
                @_verifiedCount of @_reviews.Length verified purchases
            </span>
        </div>
    </div>
</section>

@code {
    private record ReviewAuthor(string Name, string Initials, string Role, int ReviewCount);

    private record Review(
        string Id,
        ReviewAuthor Author,
        int Rating,
        string Date,
        string Title,
        string Body,
        int Helpful,
        bool Verified,
        string PurchaseTier,
        string[] Pros,
        string[] Cons
    );

    private static readonly Review[] _reviews =
    [
        new Review(
            "r1",
            new ReviewAuthor("Sarah Chen", "SC", "Engineering Lead", 12),
            5,
            "2 days ago",
            "Transformed our entire development workflow",
            "We adopted this across three teams and the impact was immediate. Build times dropped by 40%, onboarding new developers went from two weeks to two days, and the consistency across our codebase improved dramatically. The TypeScript support is exceptional and the component API is intuitive enough that junior developers can contribute from day one.",
            47,
            true,
            "Pro Plan",
            ["TypeScript types are thorough and well-documented", "Reduced onboarding time from weeks to days", "Consistent API patterns across all components"],
            ["Some advanced patterns need more examples"]
        ),
        new Review(
            "r2",
            new ReviewAuthor("Marcus Johnson", "MJ", "Frontend Developer", 5),
            4,
            "1 week ago",
            "Solid foundation with room to grow",
            "The core component set covers 90% of our use cases. We had to build a few custom components for our niche requirements, but the design system made that straightforward. Documentation is thorough and the examples are practical rather than trivial.",
            23,
            true,
            "Team Plan",
            ["Covers most standard UI patterns out of the box", "Design tokens make custom components easy"],
            ["Missing some niche components for our industry", "Could use more real-world examples in docs"]
        ),
        new Review(
            "r3",
            new ReviewAuthor("Elena Petrov", "EP", "Design Systems Lead", 8),
            5,
            "2 weeks ago",
            "Best investment for our design system",
            "After evaluating five competing solutions, this was the clear winner. The theming system is flexible enough for our brand requirements, accessibility is built in rather than bolted on, and the bundle size is remarkably small. We saved three months of engineering effort.",
            38,
            true,
            "Organization Plan",
            ["Theming system handles complex brand requirements", "Accessibility is built-in from the ground up", "Smallest bundle size of any solution we evaluated"],
            ["Initial learning curve for the theming API"]
        ),
        new Review(
            "r4",
            new ReviewAuthor("David Kim", "DK", "Senior Developer", 3),
            3,
            "3 weeks ago",
            "Good for simple projects, limited for complex ones",
            "Works well for standard marketing sites and dashboards. However, the data table component struggles with our 50k+ row datasets and the virtualization story needs improvement. We ended up building a custom solution for our heaviest views.",
            31,
            false,
            "Pro Plan",
            ["Great for marketing sites and standard dashboards"],
            ["Data table chokes on 50k+ rows", "No built-in virtualization support", "Had to build custom solution for heavy data views"]
        ),
        new Review(
            "r5",
            new ReviewAuthor("Priya Sharma", "PS", "Tech Lead", 15),
            5,
            "1 month ago",
            "Eliminated our dependency hell completely",
            "The copy-paste model eliminates dependency hell. We have full control over every component and can customize without fighting upstream opinions. The migration guide from our previous library was accurate and comprehensive. Our team velocity increased by roughly 30%.",
            52,
            true,
            "Team Plan",
            ["Copy-paste model gives full ownership of code", "Migration guide was accurate and thorough", "30% increase in team development velocity"],
            ["Manual updates when upstream changes ship"]
        ),
    ];

    private static readonly double _averageRating = _reviews.Sum(r => r.Rating) / (double)_reviews.Length;
    private static readonly int _verifiedCount = _reviews.Count(r => r.Verified);

    private string? _expandedId = "r1";
    private readonly HashSet<string> _helpfulSet = [];

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private void ToggleHelpful(string id)
    {
        if (_helpfulSet.Contains(id))
            _helpfulSet.Remove(id);
        else
            _helpfulSet.Add(id);
    }
}
