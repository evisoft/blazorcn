@* ============================================================
   Block: reviews-location-based
   Title: ReviewsLocationBased
   Description: A geographic review aggregation component for React and Next.js with region cards showing average ratings, review counts, sentiment indicators, top reviewer highlights, and expandable review lists per location built with shadcn/ui Avatar, Badge, and Collapsible components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-location-based.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="text-sm font-medium">Reviews by Location</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_totalReviews reviews across @_locations.Length regions
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                    <span class="text-sm font-semibold tabular-nums">@_overallAvg.ToString("F1")</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    Global avg
                </BadgeCn>
            </div>
        </div>

        @* Location cards *@
        <div class="divide-y">
            @foreach (var loc in _locations)
            {
                var location = loc;
                var isExpanded = _expandedLocations.Contains(location.CountryCode);
                var avg = ComputeAvgRating(location.Reviews);
                var avgStr = avg.ToString("F1");
                var verifiedCount = location.Reviews.Count(r => r.IsVerified);

                <div>
                    @* Location summary row *@
                    <button type="button"
                            class="flex w-full items-center gap-4 px-4 py-3 text-left transition-colors hover:bg-muted/30"
                            @onclick="@(() => ToggleLocation(location.CountryCode))">
                        @* Flag + name *@
                        <div class="flex items-center gap-3 min-w-0 flex-1">
                            <span class="text-lg" aria-hidden="true">@location.Flag</span>
                            <div class="min-w-0">
                                <span class="text-sm font-medium">@location.Name</span>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideIconCn Name="users" Size="12" Class="size-3" />
                                        @location.Reviews.Length reviews
                                    </span>
                                    @if (verifiedCount > 0)
                                    {
                                        <span class="text-[10px] text-muted-foreground">@verifiedCount verified</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @* Metrics cluster *@
                        <div class="flex items-center gap-4 shrink-0">
                            @* Avg rating *@
                            <div class="flex items-center gap-1.5">
                                <div class="flex items-center gap-0.5">
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        var idx = i;
                                        <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", idx < (int)Math.Round(avg) ? "fill-foreground text-foreground" : "text-muted-foreground/25")" />
                                    }
                                </div>
                                <span class="@Cn.Merge("text-sm font-semibold tabular-nums", RatingColor(avg))">@avgStr</span>
                            </div>

                            @* Sentiment trend *@
                            <div class="flex items-center gap-1">
                                @if (location.SentimentTrend == "improving")
                                {
                                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                }
                                else if (location.SentimentTrend == "declining")
                                {
                                    <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-red-500" />
                                }
                                else
                                {
                                    <span class="size-3 flex items-center justify-center text-[10px] text-muted-foreground">--</span>
                                }
                            </div>

                            @* Response rate *@
                            <div class="w-14 text-right">
                                <span class="@Cn.Merge("text-xs tabular-nums", ResponseRateColor(location.ResponseRate))">
                                    @location.ResponseRate%
                                </span>
                                <span class="block text-[10px] text-muted-foreground">response</span>
                            </div>

                            @* Expand chevron *@
                            <div class="@(isExpanded ? "rotate-180" : "") transition-transform duration-200">
                                <LucideIconCn Name="chevron-down" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                        </div>
                    </button>

                    @* Expandable reviews *@
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="border-t bg-muted/20">
                                @for (var ri = 0; ri < location.Reviews.Length; ri++)
                                {
                                    var review = location.Reviews[ri];
                                    var revIdx = ri;
                                    var isLast = revIdx == location.Reviews.Length - 1;

                                    <div class="@Cn.Merge("flex gap-3 px-4 py-3", !isLast ? "border-b border-border/50" : "")">
                                        <AvatarCn Class="size-7 shrink-0">
                                            <AvatarFallbackCn Class="text-[10px]">@review.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium">@review.Author</span>
                                                @if (review.IsVerified)
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                                        Verified
                                                    </BadgeCn>
                                                }
                                                <span class="ml-auto text-xs text-muted-foreground">@review.Date</span>
                                            </div>
                                            <div class="mt-1 flex items-center gap-2">
                                                <div class="flex items-center gap-0.5"
                                                     role="img"
                                                     aria-label="@($"{review.Rating} out of 5 stars")">
                                                    @for (var si = 0; si < 5; si++)
                                                    {
                                                        var starIdx = si;
                                                        <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIdx < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/25")" />
                                                    }
                                                </div>
                                                <span class="text-xs font-medium">@review.Title</span>
                                            </div>
                                            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@review.Snippet</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer summary *@
        <div class="flex items-center justify-between border-t bg-muted/20 px-4 py-2.5">
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    @_locations.Length regions
                </span>
                <span class="text-xs text-muted-foreground">@_totalReviews reviews</span>
            </div>
            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="trending-up" Size="10" Class="size-2.5 text-emerald-500" />
                    Improving
                </span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="trending-down" Size="10" Class="size-2.5 text-red-500" />
                    Declining
                </span>
                <span>-- Stable</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewEntry(
        string Id,
        string Author,
        string Initials,
        int Rating,
        string Title,
        string Snippet,
        string Date,
        bool IsVerified
    );

    private record Location(
        string Name,
        string CountryCode,
        string Flag,
        ReviewEntry[] Reviews,
        string SentimentTrend,
        int ResponseRate
    );

    private static readonly Location[] _locations =
    [
        new Location(
            "United States", "US", "\U0001F1FA\U0001F1F8",
            [
                new ReviewEntry("us-1", "Sarah Mitchell", "SM", 5, "Seamless enterprise onboarding",
                    "Had our 200-person team fully migrated in under 48 hours. The SSO integration with Okta was plug-and-play. Support resolved our one edge case in 20 minutes.",
                    "Mar 28, 2026", true),
                new ReviewEntry("us-2", "Marcus Johnson", "MJ", 4, "Strong API, documentation gaps",
                    "REST API is fast and well-designed. Found a few endpoints missing from the docs -- the /webhooks/batch route had no examples. Filed an issue and it was added within the week.",
                    "Mar 24, 2026", true),
                new ReviewEntry("us-3", "Emily Chen", "EC", 5, "Best analytics dashboard we have used",
                    "Real-time dashboards replaced three separate tools for us. The custom report builder saved our data team 10+ hours per week. Export to BigQuery works flawlessly.",
                    "Mar 20, 2026", false),
            ],
            "improving", 94
        ),
        new Location(
            "Germany", "DE", "\U0001F1E9\U0001F1EA",
            [
                new ReviewEntry("de-1", "Anna Mueller", "AM", 5, "GDPR compliance built in correctly",
                    "Finally a platform that handles data residency properly. EU data stays in Frankfurt. The consent management integrates with our existing CMP without custom code.",
                    "Mar 26, 2026", true),
                new ReviewEntry("de-2", "Lucas Weber", "LW", 4, "Solid localization, minor timezone edge cases",
                    "German locale support is thorough. Found one issue with DST transitions in scheduled reports -- times shifted by an hour during the spring change. Workaround documented in their forum.",
                    "Mar 18, 2026", true),
            ],
            "stable", 91
        ),
        new Location(
            "Japan", "JP", "\U0001F1EF\U0001F1F5",
            [
                new ReviewEntry("jp-1", "Yuki Tanaka", "YT", 4, "Fast Tokyo region latency",
                    "API response times from ap-northeast-1 average 12ms. Integration with our existing AWS infrastructure was straightforward. Would appreciate native SDK documentation in Japanese.",
                    "Mar 25, 2026", true),
                new ReviewEntry("jp-2", "Kenji Sato", "KS", 5, "Enterprise support exceeded expectations",
                    "Priority support queue resolved our production incident in under 30 minutes at 2 AM JST. The post-mortem report was thorough and included preventive measures.",
                    "Mar 19, 2026", true),
            ],
            "improving", 88
        ),
        new Location(
            "Brazil", "BR", "\U0001F1E7\U0001F1F7",
            [
                new ReviewEntry("br-1", "Carlos Silva", "CS", 3, "Good product, payment integration issues",
                    "Core platform is excellent but the Brazilian payment gateway integration has reliability issues. Pix payments fail about 5% of the time. Boleto generation is slow.",
                    "Mar 27, 2026", true),
                new ReviewEntry("br-2", "Ana Oliveira", "AO", 3, "Latency concerns from Sao Paulo",
                    "No South American data center means 180ms+ latency for real-time features. Acceptable for dashboards but noticeable in the live collaboration tools. Hoping for a GRU region soon.",
                    "Mar 15, 2026", false),
            ],
            "declining", 72
        ),
        new Location(
            "United Kingdom", "GB", "\U0001F1EC\U0001F1E7",
            [
                new ReviewEntry("gb-1", "Oliver Wright", "OW", 5, "Replaced three legacy tools",
                    "Consolidated our monitoring, alerting, and incident management into one platform. The London data center provides sub-10ms latency. Migration support was hands-on and thorough.",
                    "Mar 23, 2026", true),
                new ReviewEntry("gb-2", "Sophie Evans", "SE", 4, "Great for distributed UK teams",
                    "Our offices in London, Edinburgh, and Manchester all see consistent performance. The team collaboration features work well across time zones within the UK.",
                    "Mar 14, 2026", true),
            ],
            "stable", 96
        ),
    ];

    private static readonly int _totalReviews = _locations.Sum(l => l.Reviews.Length);
    private static readonly double _overallAvg =
        _locations.Sum(l => l.Reviews.Sum(r => r.Rating)) / (double)_totalReviews;

    private readonly HashSet<string> _expandedLocations = ["US"];

    private static double ComputeAvgRating(ReviewEntry[] reviews)
    {
        return reviews.Sum(r => r.Rating) / (double)reviews.Length;
    }

    private static string RatingColor(double avg)
    {
        if (avg >= 4.5) return "text-emerald-600 dark:text-emerald-400";
        if (avg >= 3.5) return "text-foreground";
        return "text-amber-600 dark:text-amber-400";
    }

    private static string ResponseRateColor(int rate)
    {
        if (rate >= 90) return "text-emerald-600 dark:text-emerald-400";
        if (rate >= 80) return "text-muted-foreground";
        return "text-amber-600 dark:text-amber-400";
    }

    private void ToggleLocation(string code)
    {
        if (_expandedLocations.Contains(code))
            _expandedLocations.Remove(code);
        else
            _expandedLocations.Add(code);
    }
}
