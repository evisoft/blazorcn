@* ========================================
   Block: reviews-translated
   Title: Reviews Translated
   Description: Translated review card with language toggle and host response for React global marketplaces
   Long Description: Chronological review timeline component with date grouping for React admin dashboards
   Dependencies: LucideGlobeCn, LucideStarCn, LucideThumbsUpCn
   Source: original/blocks/reviews/reviews-translated.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Guest Review</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Header *@
                <div class="mb-4 flex items-center gap-3">
                    <AvatarCn Class="h-12 w-12">
                        <AvatarImageCn Alt="Nicole Arnaud" Src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&w=100&q=80" />
                        <AvatarFallbackCn>NA</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <div class="flex flex-col sm:flex-row sm:items-center sm:gap-2">
                            <span class="font-semibold">Nicole Arnaud</span>
                            <span class="text-sm text-muted-foreground">· 5 years on Platform</span>
                        </div>
                        <p class="text-sm text-muted-foreground">August 2024</p>
                    </div>
                </div>

                @* Rating *@
                <div class="mb-3">
                    <div class="flex items-center gap-0.5">
                        @for (var star = 1; star <= 5; star++)
                        {
                            <LucideStarCn Class="@Cn.Merge("h-4 w-4", star <= 5 ? "fill-primary text-primary" : "fill-muted text-muted")" Size="16" />
                        }
                    </div>
                </div>

                @* Translation Toggle *@
                <div class="mb-3 flex items-center gap-2 text-sm text-muted-foreground">
                    <LucideGlobeCn Class="h-3 w-3" Size="12" />
                    <span>Translated from French</span>
                    <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link"
                              @onclick="@(() => _showOriginal = !_showOriginal)">
                        @(_showOriginal ? "Show translation" : "Show original")
                    </ButtonCn>
                </div>

                @* Content *@
                <p class="@(_isExpanded ? "" : "line-clamp-4")">@_displayContent</p>

                @if (_displayContent.Length > 300)
                {
                    <ButtonCn Class="mt-2 h-auto p-0" Variant="ButtonVariant.Link"
                              @onclick="@(() => _isExpanded = !_isExpanded)">
                        @(_isExpanded ? "Show less" : "Show more")
                    </ButtonCn>
                }

                @* Helpful Button *@
                <div class="mt-4">
                    <ButtonCn Class="h-8 gap-1.5" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              @onclick="HandleHelpful">
                        <LucideThumbsUpCn Class="@Cn.Merge("h-3.5 w-3.5", _hasMarkedHelpful ? "fill-current" : "")" Size="14" />
                        Helpful
                        @if (_helpful > 0)
                        {
                            <span class="text-muted-foreground">(@_helpful)</span>
                        }
                    </ButtonCn>
                </div>

                @* Host Response *@
                <SeparatorCn Class="my-4" />
                <div class="ml-4 rounded-lg border p-4">
                    <p class="mb-1 text-sm font-medium">Response from host</p>
                    <p class="mb-2 text-xs text-muted-foreground">August 2024</p>
                    <p class="text-sm text-muted-foreground">Thank you so much for your kind words, Nicole! It was a pleasure hosting you and I'm thrilled you enjoyed the apartment and location. The patio is my favorite spot too! I hope to welcome you back soon.</p>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private const string _translatedContent = "This place was absolutely perfect for our weekend getaway. The location is ideal - just a short walk to great restaurants and shops. The apartment was spotlessly clean, beautifully decorated, and had all the amenities we needed. The bed was incredibly comfortable and the neighborhood was quiet at night. Our host was responsive and provided excellent recommendations for local activities. We especially loved the private patio for morning coffee. Would definitely stay here again!";
    private const string _originalContent = "Cet endroit \u00e9tait absolument parfait pour notre escapade de week-end. L'emplacement est id\u00e9al - \u00e0 quelques pas de bons restaurants et boutiques. L'appartement \u00e9tait impeccablement propre, joliment d\u00e9cor\u00e9 et disposait de tous les \u00e9quipements dont nous avions besoin. Le lit \u00e9tait incroyablement confortable et le quartier \u00e9tait calme la nuit. Notre h\u00f4te \u00e9tait r\u00e9actif et nous a fourni d'excellentes recommandations pour les activit\u00e9s locales. Nous avons particuli\u00e8rement aim\u00e9 le patio priv\u00e9 pour le caf\u00e9 du matin. Nous y retournerions sans h\u00e9siter!";

    private bool _isExpanded;
    private bool _showOriginal;
    private int _helpful = 3;
    private bool _hasMarkedHelpful;

    private string _displayContent => _showOriginal ? _originalContent : _translatedContent;

    private void HandleHelpful()
    {
        if (_hasMarkedHelpful)
        {
            _helpful--;
            _hasMarkedHelpful = false;
        }
        else
        {
            _helpful++;
            _hasMarkedHelpful = true;
        }
    }
}
