@* ============================================================
   Block: reviews-email-request
   Title: ReviewsEmailRequest
   Description: A post-purchase review request email template builder for React and Next.js with subject line editing, timing controls, star rating CTA, and live email preview built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-email-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Review Request Campaign</span>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    Post-purchase
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">
                    42% open rate
                </BadgeCn>
            </div>
        </div>

        <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)">
            <div class="border-b px-4">
                <TabsListCn Class="h-9 bg-transparent p-0">
                    <TabsTriggerCn Value="compose" Class="rounded-none border-b-2 border-transparent px-3 pb-2 pt-1.5 text-xs data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Compose
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="activity" Class="rounded-none border-b-2 border-transparent px-3 pb-2 pt-1.5 text-xs data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Recent Activity
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="compose" Class="mt-0">
                <div class="grid grid-cols-5">
                    @* Config sidebar *@
                    <div class="col-span-2 border-r">
                        @* Subject line *@
                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Subject line</span>
                            <InputCn @bind-Value="_subject" Class="mt-1.5 h-8 text-xs" />
                            <p class="mt-1 text-[10px] text-muted-foreground">
                                @_subject.Length/80 characters
                            </p>
                        </div>

                        @* Send timing *@
                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Send timing</span>
                            <div class="mt-2 space-y-1">
                                @foreach (var preset in _timingPresets)
                                {
                                    var p = preset;
                                    <button type="button"
                                            class="@Cn.Merge("flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left transition-colors", _selectedTiming == p.Id ? "bg-muted/50" : "hover:bg-muted/30")"
                                            @onclick="@(() => _selectedTiming = p.Id)">
                                        <LucideIconCn Name="clock" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                        <div class="min-w-0 flex-1">
                                            <span class="block text-xs font-medium">@p.Label</span>
                                            <span class="block text-[10px] text-muted-foreground">@p.Description</span>
                                        </div>
                                        @if (_selectedTiming == p.Id)
                                        {
                                            <LucideIconCn Name="check" Size="12" Class="size-3 shrink-0 text-foreground" />
                                        }
                                    </button>
                                }
                            </div>
                        </div>

                        @* Send button *@
                        <div class="px-4 py-3">
                            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs" OnClick="HandleSend">
                                @if (_sent)
                                {
                                    <span class="flex items-center gap-1.5">
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                        Queued
                                    </span>
                                }
                                else
                                {
                                    <span class="flex items-center gap-1.5">
                                        <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                                        Queue Campaign
                                    </span>
                                }
                            </ButtonCn>
                            <p class="mt-1.5 text-center text-[10px] text-muted-foreground">
                                Sends @(GetSelectedTimingDelay()) after delivery
                            </p>
                        </div>
                    </div>

                    @* Email preview *@
                    <div class="col-span-3 bg-muted/20">
                        <div class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                    Preview
                                </span>
                                <span class="h-px flex-1 bg-border" />
                            </div>
                        </div>

                        <div class="px-4 pb-4">
                            <div class="overflow-hidden rounded-md border bg-card">
                                @* Email subject *@
                                <div class="border-b px-3 py-2.5">
                                    <p class="text-xs font-medium">@_subject</p>
                                    <div class="mt-1 flex items-center gap-2 text-[10px] text-muted-foreground">
                                        <span>From: Acme Store &lt;reviews@@acmestore.com&gt;</span>
                                    </div>
                                </div>

                                @* Email body *@
                                <div class="border-b px-3 py-3">
                                    <p class="text-xs">@_template.Greeting</p>
                                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                        @_template.Body
                                    </p>
                                </div>

                                @* Product card *@
                                <div class="flex items-center gap-3 border-b px-3 py-2.5">
                                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                        <span class="text-base">@_template.Product.Emoji</span>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-medium">@_template.Product.Name</p>
                                        <p class="mt-0.5 text-[10px] text-muted-foreground">
                                            @_template.Product.Variant
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-xs font-medium">@_template.Product.Price</p>
                                        <p class="font-mono text-[10px] text-muted-foreground">
                                            @_template.Product.OrderNumber
                                        </p>
                                    </div>
                                </div>

                                @* Star rating CTA *@
                                <div class="border-b px-3 py-3">
                                    <p class="text-center text-[10px] text-muted-foreground">
                                        How would you rate this product?
                                    </p>
                                    <div class="mt-2 flex items-center justify-center gap-0.5">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            var starValue = i + 1;
                                            var isFilled = ActiveStar.HasValue && starValue <= ActiveStar.Value;
                                            <button type="button"
                                                    class="rounded p-1 transition-colors hover:bg-muted/50"
                                                    @onmouseenter="@(() => _hoveredStar = starValue)"
                                                    @onmouseleave="@(() => _hoveredStar = null)"
                                                    @onclick="@(() => _selectedStar = starValue)">
                                                <LucideIconCn Name="star" Size="20" Class="@Cn.Merge("size-5 transition-colors", isFilled ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                            </button>
                                        }
                                    </div>
                                    @if (_selectedStar.HasValue)
                                    {
                                        <p class="mt-1.5 text-center text-[10px] text-muted-foreground">
                                            @_selectedStar @(_selectedStar != 1 ? "stars" : "star") selected
                                        </p>
                                    }
                                </div>

                                @* Footer *@
                                <div class="px-3 py-2">
                                    <p class="text-center text-[10px] text-muted-foreground">
                                        Or write a detailed review
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </TabsContentCn>

            <TabsContentCn Value="activity" Class="mt-0">
                <div class="divide-y">
                    @foreach (var send in _recentSends)
                    {
                        <div class="flex items-center gap-3 px-4 py-2.5">
                            <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted">
                                <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-medium">@send.Customer</span>
                                    <span class="text-[10px] text-muted-foreground">@send.Product</span>
                                </div>
                                <span class="text-[10px] text-muted-foreground">@send.SentAt</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotColor(send.Status))" />
                                <span class="@Cn.Merge("text-[10px] capitalize", StatusColor(send.Status))">
                                    @send.Status
                                </span>
                            </div>
                        </div>
                    }
                </div>
                @* Activity footer *@
                <div class="border-t px-4 py-2.5">
                    <div class="flex items-center justify-between text-[10px] text-muted-foreground">
                        <span>Showing last 5 sends</span>
                        <span class="flex items-center gap-3">
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-emerald-500" />
                                Reviewed
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-blue-500" />
                                Clicked
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-amber-500" />
                                Opened
                            </span>
                        </span>
                    </div>
                </div>
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private string _activeTab = "compose";
    private string _subject = "How are you enjoying your new purchase?";
    private string _selectedTiming = "3-day";
    private int? _hoveredStar;
    private int? _selectedStar;
    private bool _sent;

    private int? ActiveStar => _hoveredStar ?? _selectedStar;

    private void HandleSend()
    {
        _sent = true;
        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            _sent = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private string GetSelectedTimingDelay()
    {
        foreach (var t in _timingPresets)
        {
            if (t.Id == _selectedTiming) return t.Delay;
        }
        return "";
    }

    private static string StatusColor(string status) => status switch
    {
        "reviewed" => "text-emerald-600 dark:text-emerald-400",
        "clicked"  => "text-blue-600 dark:text-blue-400",
        "opened"   => "text-amber-600 dark:text-amber-400",
        _          => "text-muted-foreground",
    };

    private static string StatusDotColor(string status) => status switch
    {
        "reviewed" => "bg-emerald-500",
        "clicked"  => "bg-blue-500",
        "opened"   => "bg-amber-500",
        _          => "bg-muted-foreground/50",
    };

    private record TimingPreset(string Id, string Label, string Delay, string Description);

    private record OrderProduct(string Name, string Variant, string Emoji, string OrderNumber, string DeliveredDate, string Price);

    private record EmailTemplate(string Id, string Subject, string Greeting, string Body, OrderProduct Product);

    private record RecentSend(string Customer, string Product, string SentAt, string Status);

    private static readonly TimingPreset[] _timingPresets =
    [
        new("immediate", "Immediate", "0 days",  "Send right after delivery confirmation"),
        new("3-day",     "3 Days",    "3 days",  "Allow time to try the product"),
        new("7-day",     "7 Days",    "7 days",  "Best for complex products"),
        new("14-day",    "14 Days",   "14 days", "Extended evaluation period"),
    ];

    private static readonly EmailTemplate _template = new(
        Id: "tmpl-001",
        Subject: "How are you enjoying your new purchase?",
        Greeting: "Hi Jordan,",
        Body: "Your order was delivered on March 12, 2026. We hope you are enjoying your purchase. Would you take a moment to share your experience? Your feedback helps other customers make informed decisions.",
        Product: new OrderProduct(
            Name: "Ergonomic Mesh Office Chair",
            Variant: "Graphite / Adjustable Arms",
            Emoji: "\U0001FA91",
            OrderNumber: "ORD-2847391",
            DeliveredDate: "March 12, 2026",
            Price: "$489.00"
        )
    );

    private static readonly RecentSend[] _recentSends =
    [
        new("Sarah M.",  "Standing Desk Pro",  "2 hours ago", "opened"),
        new("Marcus T.", "Wireless Keyboard",  "5 hours ago", "clicked"),
        new("Elena K.",  "Monitor Light Bar",  "1 day ago",   "reviewed"),
        new("James P.",  "Desk Organizer Set", "1 day ago",   "delivered"),
        new("Priya S.",  "Ergonomic Mouse",    "2 days ago",  "opened"),
    ];
}
