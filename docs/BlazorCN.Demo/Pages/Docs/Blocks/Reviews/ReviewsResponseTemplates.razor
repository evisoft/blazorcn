@* ============================================================
   Block: reviews-response-templates
   Title: ReviewsResponseTemplates
   Description: A split-panel response template manager for React and Next.js with category sidebar, template preview, variable placeholders, copy-to-clipboard, and usage stats built with shadcn/ui Badge, Button, Input, and Textarea components and Tailwind CSS
   Source: original/blocks/reviews/reviews-response-templates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Response Templates</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @(_templates.Length) templates across @(_categories.Length) categories
                </p>
            </div>
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="tabular-nums">
                    @(_templates.Sum(t => t.UsageCount).ToString("N0"))
                </span>
                <span>total uses</span>
            </div>
        </div>

        <div class="grid md:grid-cols-[200px_1fr]">
            @* Sidebar - Categories *@
            <div class="border-b border-r-0 md:border-b-0 md:border-r">
                <div class="p-2">
                    @foreach (var cat in _categories)
                    {
                        var catId = cat.Id;
                        var isActive = _activeCategory == cat.Id;
                        <button
                            type="button"
                            @onclick="@(() => SelectCategory(catId))"
                            class="@Cn.Merge("flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm transition-colors", isActive ? "bg-muted/80 font-medium" : "text-muted-foreground hover:bg-muted/40 hover:text-foreground")">
                            <span class="@($"size-1.5 shrink-0 rounded-full {cat.Color}")" />
                            <LucideIconCn Name="@cat.Icon" Size="14" Class="size-3.5 shrink-0" />
                            <span class="flex-1 truncate">@cat.Label</span>
                            <span class="tabular-nums text-xs text-muted-foreground">
                                @cat.Count
                            </span>
                        </button>
                    }
                </div>
            </div>

            @* Main content *@
            <div class="flex flex-col">
                @* Search *@
                <div class="border-b px-3 py-2">
                    <div class="relative">
                        <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                        <InputCn
                            Placeholder="@($"Search {ActiveCategoryLabel} templates...")"
                            Value="@_searchQuery"
                            ValueChanged="@((string? v) => _searchQuery = v ?? "")"
                            Class="h-8 border-0 bg-transparent pl-8 text-sm shadow-none focus-visible:ring-0" />
                    </div>
                </div>

                @* Template list or preview *@
                @if (_selectedTemplate != null)
                {
                    <div class="flex flex-1 flex-col">
                        @* Template preview header *@
                        <div class="flex items-center justify-between border-b px-4 py-2.5">
                            <div class="flex items-center gap-2">
                                <button
                                    type="button"
                                    @onclick="HandleClear"
                                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                    Back
                                </button>
                                <span class="text-muted-foreground">/</span>
                                <span class="text-sm font-medium">@_selectedTemplate.Title</span>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal capitalize">
                                <span class="@GetToneColor(_selectedTemplate.Tone)">
                                    @_selectedTemplate.Tone
                                </span>
                            </BadgeCn>
                        </div>

                        @* Variables *@
                        @if (_selectedTemplate.Variables.Length > 0)
                        {
                            <div class="border-b px-4 py-2.5">
                                <span class="text-xs font-medium text-muted-foreground">
                                    Variables (@(_selectedTemplate.Variables.Length))
                                </span>
                                <div class="mt-1.5 flex flex-wrap gap-1.5">
                                    @foreach (var v in _selectedTemplate.Variables)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded bg-blue-500/10 px-2 py-0.5 font-mono text-xs text-blue-600 dark:text-blue-400">
                                            <LucideIconCn Name="hash" Size="10" Class="size-2.5" />
                                            @v.Label
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        @* Editor *@
                        <div class="flex-1 px-4 py-3">
                            <TextareaCn
                                Value="@_replyText"
                                ValueChanged="@((string? v) => _replyText = v ?? "")"
                                Class="resize-none text-sm leading-relaxed"
                                rows="7" />
                        </div>

                        @* Actions *@
                        <div class="flex items-center justify-between border-t px-4 py-2.5">
                            <span class="text-xs text-muted-foreground">
                                Used @_selectedTemplate.UsageCount times
                                <span class="mx-1.5 text-muted-foreground/40">|</span>
                                Last used @_selectedTemplate.LastUsed
                            </span>
                            <div class="flex items-center gap-1.5">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs" @onclick="HandleCopy">
                                    @if (_copied)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        <span>Copied</span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                        <span>Copy</span>
                                    }
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs">
                                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                                    Send reply
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="divide-y">
                        @{
                            var filtered = Filtered;
                        }
                        @if (filtered.Length == 0)
                        {
                            <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                                No templates match your search
                            </div>
                        }
                        else
                        {
                            @foreach (var tmpl in filtered)
                            {
                                var item = tmpl;
                                <button
                                    type="button"
                                    @onclick="@(() => HandleSelect(item))"
                                    class="flex w-full flex-col gap-1.5 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium">@item.Title</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal capitalize">
                                                <span class="@GetToneColor(item.Tone)">@item.Tone</span>
                                            </BadgeCn>
                                        </div>
                                        <span class="tabular-nums text-xs text-muted-foreground">
                                            @item.UsageCount uses
                                        </span>
                                    </div>
                                    <p class="line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                                        @item.Body
                                    </p>
                                    @if (item.Variables.Length > 0)
                                    {
                                        <div class="flex items-center gap-1 pt-0.5">
                                            @foreach (var v in item.Variables)
                                            {
                                                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                                                    @v.Token
                                                </span>
                                            }
                                        </div>
                                    }
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TemplateVariable(string Token, string Label, string Example);

    private record Template(
        string Id,
        string CategoryId,
        string Title,
        string Body,
        TemplateVariable[] Variables,
        int UsageCount,
        string LastUsed,
        string Tone);

    private record Category(string Id, string Label, string Icon, string Color, int Count);

    private string _activeCategory = "positive";
    private string? _selectedId = null;
    private string _replyText = "";
    private string _searchQuery = "";
    private bool _copied = false;

    private Template? _selectedTemplate => _templates.FirstOrDefault(t => t.Id == _selectedId);

    private string ActiveCategoryLabel => _categories.FirstOrDefault(c => c.Id == _activeCategory)?.Label ?? "";

    private Template[] Filtered => _templates
        .Where(t => t.CategoryId == _activeCategory)
        .Where(t => string.IsNullOrEmpty(_searchQuery)
            || t.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
            || t.Body.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private void SelectCategory(string catId)
    {
        _activeCategory = catId;
        _selectedId = null;
        _replyText = "";
    }

    private void HandleSelect(Template template)
    {
        _selectedId = template.Id;
        _replyText = template.Body;
    }

    private async Task HandleCopy()
    {
        if (string.IsNullOrEmpty(_replyText)) return;
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }

    private void HandleClear()
    {
        _selectedId = null;
        _replyText = "";
    }

    private static string GetToneColor(string tone) => tone switch
    {
        "warm" => "text-emerald-600 dark:text-emerald-400",
        "formal" => "text-blue-600 dark:text-blue-400",
        "empathetic" => "text-amber-600 dark:text-amber-400",
        _ => "text-foreground",
    };

