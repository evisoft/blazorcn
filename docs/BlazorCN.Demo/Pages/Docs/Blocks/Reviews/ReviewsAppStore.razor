@* ============================================================
   Block: reviews-app-store
   Title: ReviewsAppStore
   Description: A mobile app store review display for React and Next.js with large rating number, star histogram, version filtering, developer responses, and helpful voting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-app-store.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Rating summary header - split layout *@
        <div class="border-b px-4 py-4">
            <div class="flex gap-6">
                @* Left: big rating number *@
                <div class="flex shrink-0 flex-col items-center justify-center">
                    <span class="text-5xl font-semibold tabular-nums leading-none">
                        @_stats.AverageRating
                    </span>
                    <div class="mt-1.5 flex items-center gap-0.5">
                        @for (int i = 0; i < 5; i++)
                        {
                            var starIdx = i;
                            <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", starIdx < (int)Math.Round(_stats.AverageRating) ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                        }
                    </div>
                    <span class="mt-1 text-[10px] text-muted-foreground tabular-nums">
                        @_stats.TotalReviews.ToString("N0") ratings
                    </span>
                </div>

                @* Right: histogram *@
                <div class="flex flex-1 flex-col justify-center gap-1">
                    @foreach (var row in _stats.Distribution)
                    {
                        var pct = (row.Count / (double)_stats.TotalReviews) * 100;
                        <div class="flex items-center gap-2">
                            <span class="flex w-5 items-center justify-end gap-0.5 text-xs tabular-nums text-muted-foreground">
                                @row.Stars
                                <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-muted-foreground/40 text-muted-foreground/40" />
                            </span>
                            <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                <div class="h-full rounded-full bg-foreground/20" style="@($"width:{pct:F1}%")"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Version filter bar *@
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_filteredReviews.Length review@(_filteredReviews.Length != 1 ? "s" : "")
            </span>
            <SelectCn TValue="string" Value="@_versionFilter" ValueChanged="@((string v) => SetVersionFilter(v))">
                <SelectTriggerCn Class="h-7 w-auto gap-1.5 border-0 bg-transparent px-2 text-xs shadow-none">
                    <SelectValueCn Placeholder="All Versions" />
                </SelectTriggerCn>
                <SelectContentCn Align="FloatingAlign.End">
                    @foreach (var ver in _stats.Versions)
                    {
                        var v = ver;
                        <SelectItemCn Value="@v" Class="text-xs">@v</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Reviews list *@
        <div>
            @if (_filteredReviews.Length == 0)
            {
                <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                    No reviews for this version
                </div>
            }
            else
            {
                @for (int idx = 0; idx < _filteredReviews.Length; idx++)
                {
                    var review = _filteredReviews[idx];
                    var isLast = idx == _filteredReviews.Length - 1;
                    var isHelpful = _helpfulVotes.ContainsKey(review.Id) && _helpfulVotes[review.Id];
                    var helpfulCount = review.Helpful + (isHelpful ? 1 : 0);

                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <div class="px-4 py-3">
                            @* Author row with stars *@
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <AvatarCn Class="size-7 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@review.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div>
                                        <span class="text-sm font-medium">@review.Author</span>
                                        <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                                            <span>@review.Date</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-0.5">
                                    @for (int si = 0; si < 5; si++)
                                    {
                                        var starI = si;
                                        var ratingVal = review.Rating;
                                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starI < ratingVal ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                                    }
                                </div>
                            </div>

                            @* Review content *@
                            <div class="mt-2">
                                <p class="text-sm font-medium">@review.Title</p>
                                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                    @review.Body
                                </p>
                            </div>

                            @* Version + device metadata *@
                            <div class="mt-2 flex flex-wrap items-center gap-1.5">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">v@(review.AppVersion)</BadgeCn>
                                <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                                    <LucideIconCn Name="smartphone" Size="10" Class="size-2.5" />
                                    @review.Device
                                </span>
                                <span class="text-[10px] text-muted-foreground">@review.Os</span>
                            </div>

                            @* Developer response *@
                            @if (review.DeveloperResponse != null)
                            {
                                <div class="mt-3 rounded-md bg-muted/50 px-3 py-2.5">
                                    <div class="mb-1 flex items-center gap-2">
                                        <span class="text-[10px] font-medium text-muted-foreground">
                                            Developer Response
                                        </span>
                                        <span class="text-[10px] text-muted-foreground">
                                            @review.DeveloperResponse.Date
                                        </span>
                                    </div>
                                    <p class="text-sm leading-relaxed">@review.DeveloperResponse.Text</p>
                                </div>
                            }

                            @* Helpful *@
                            <div class="mt-2.5 flex items-center gap-2">
                                <span class="text-[10px] text-muted-foreground">Helpful?</span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="@Cn.Merge("h-6 gap-1 px-2 text-xs", isHelpful ? "text-emerald-600 dark:text-emerald-400" : "")"
                                          OnClick="@(() => ToggleHelpful(review.Id))">
                                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                    <span class="tabular-nums">@helpfulCount</span>
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record DevResponse(string Text, string Date);

    private record AppReview(
        string Id,
        string Author,
        string Initials,
        string Date,
        int Rating,
        string Title,
        string Body,
        string AppVersion,
        string Device,
        string Os,
        int Helpful,
        DevResponse? DeveloperResponse = null
    );

    private record StarDist(int Stars, int Count);

    private record ReviewStatsData(
        int TotalReviews,
        double AverageRating,
        StarDist[] Distribution,
        string[] Versions
    );

    private static readonly ReviewStatsData _stats = new(
        TotalReviews: 12847,
        AverageRating: 4.6,
        Distribution:
        [
            new(5, 7842),
            new(4, 2891),
            new(3, 1243),
            new(2, 512),
            new(1, 359),
        ],
        Versions: ["All Versions", "3.4.2", "3.4.1", "3.4.0", "3.3.x"]
    );

    private static readonly AppReview[] _allReviews =
    [
        new(
            Id: "r1",
            Author: "Alex Mercer",
            Initials: "AM",
            Date: "Mar 20, 2026",
            Rating: 5,
            Title: "Finally an app that gets it right",
