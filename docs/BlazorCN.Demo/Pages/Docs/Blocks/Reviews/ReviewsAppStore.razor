            AppVersion: "3.4.2",
            Device: "iPhone 15",
            Os: "iOS 19.2",
            Helpful: 126,
            DeveloperResponse: new("Hi Jordan, thanks for flagging this. We identified the background sync issue and a fix is included in version 3.4.3 rolling out this week. Please update and let us know if the battery drain improves.", "Mar 16, 2026")
        ),
        new(
            Id: "r3",
            Author: "Priya Sharma",
            Initials: "PS",
            Date: "Mar 6, 2026",
            Rating: 5,
            Title: "Clean design and reliable performance",
            Body: "I have been using this app daily for six months and it has never crashed. The widget support is excellent and the shortcuts integration saves me time every morning. Worth the subscription.",
            AppVersion: "3.4.1",
            Device: "iPad Air M2",
            Os: "iPadOS 19.3",
            Helpful: 43
