            Helpful: 67
        ),
    ];

    private Dictionary<string, bool> _helpfulVotes = new();
    private string _versionFilter = "All Versions";
    private AppReview[] _filteredReviews = _allReviews;

    private void SetVersionFilter(string ver)
    {
        _versionFilter = ver;
        _filteredReviews = ver == "All Versions"
            ? _allReviews
            : _allReviews.Where(r => r.AppVersion == ver).ToArray();
    }

    private void ToggleHelpful(string reviewId)
    {
        if (_helpfulVotes.ContainsKey(reviewId))
            _helpfulVotes[reviewId] = !_helpfulVotes[reviewId];
        else
            _helpfulVotes[reviewId] = true;
    }
}
