@* ============================================================
   Block: reviews-checkout-prompt
   Title: ReviewsCheckoutPrompt
   Description: A conversion-focused review prompt block for React and Next.js with social proof counter, star rating selector, mini featured quote, and urgency indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-checkout-prompt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_submitted)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex flex-col items-center gap-3 px-4 py-10">
                <LucideIconCn Name="circle-check-2" Size="40" Class="size-10 text-emerald-500" />
                <div class="text-center">
                    <span class="text-sm font-medium">Thank you for your review</span>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your @_rating-star review helps other shoppers make better decisions.
                    </p>
                </div>
                <div class="mt-1 flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="16" Class="@($"size-4 {(idx < _rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/20")}")" />
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Order confirmed header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="circle-check-2" Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm font-medium">Order confirmed</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@_orderNumber</BadgeCn>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Thank you for your purchase. How would you rate this product?
                </p>
            </div>

            @* Product row *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="package" Size="20" Class="size-5 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@_productName</span>
                    <p class="text-xs text-muted-foreground">@_productVariant</p>
                </div>
                <span class="shrink-0 text-sm font-medium tabular-nums">@_productPrice</span>
            </div>

            @* Social proof bar *@
            <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground/60" />
                <span class="text-xs text-muted-foreground">@_recentBuyers people bought this recently</span>
                <span class="text-xs text-muted-foreground/40">|</span>
                <span class="text-xs text-muted-foreground">@_reviewRate left a review</span>
            </div>

            @* Star selector *@
            <div class="border-b px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Your rating</span>
                <div class="mt-2.5 flex items-center gap-1.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var starValue = i + 1;
                        var isFilled = starValue <= _displayRating;
                        <button type="button"
                                class="rounded-md p-1 transition-colors hover:bg-muted/50"
                                @onmouseenter="@(() => _hovered = starValue)"
                                @onmouseleave="@(() => _hovered = 0)"
                                @onclick="@(() => HandleStarClick(starValue))">
                            <LucideIconCn Name="star" Size="28" Class="@($"size-7 transition-colors duration-150 {(isFilled ? "fill-amber-500 text-amber-500" : "text-muted-foreground/25")}")" />
                        </button>
                    }
                    @if (_displayRating > 0)
                    {
                        <span class="ml-2 text-xs font-medium text-muted-foreground">@_ratingLabels[_displayRating]</span>
                    }
                </div>
            </div>

            @* Comment field - revealed after star selection *@
            @if (_showCommentField)
            {
                <div class="overflow-hidden border-b px-4 py-3">
                    <TextareaCn @bind-Value="_comment"
                                Placeholder="Tell us what you liked or how we can improve (optional)"
                                Class="min-h-[72px] resize-none border-0 bg-transparent p-0 text-sm shadow-none focus-visible:ring-0" />
                    <div class="mt-1 flex items-center justify-between">
                        <span class="text-[10px] text-muted-foreground/60 tabular-nums">@_comment.Length/@_maxCommentLength</span>
                    </div>
                </div>
            }

            @* Featured quote *@
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/30 px-3 py-2.5">
                    <div class="flex items-center gap-2">
                        <AvatarCn Class="size-5">
                            <AvatarFallbackCn Class="text-[10px]">@_quoteInitials</AvatarFallbackCn>
                        </AvatarCn>
                        <span class="text-xs font-medium">@_quoteAuthor</span>
                        <div class="flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var qi = i;
                                <LucideIconCn Name="star" Size="10" Class="@($"size-2.5 {(qi < _quoteRating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/20")}")" />
                            }
                        </div>
                    </div>
                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                        &ldquo;@_quoteText&rdquo;
                    </p>
                </div>
            </div>

            @* Actions *@
            <div class="flex items-center justify-between px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                    Skip for now
                </ButtonCn>
                <div class="flex items-center gap-2">
                    @if (_rating > 0)
                    {
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="shopping-bag" Size="12" Class="size-3 text-muted-foreground/50" />
                            <span class="text-[10px] text-muted-foreground">Earn 50 points</span>
                        </div>
                    }
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                              Disabled="@(_rating == 0)"
                              OnClick="HandleSubmit">
                        Submit review
                    </ButtonCn>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private int _rating = 0;
    private int _hovered = 0;
    private string _comment = "";
    private bool _submitted = false;
    private bool _showCommentField = false;

    private const int _maxCommentLength = 500;

    private int _displayRating => _hovered > 0 ? _hovered : _rating;

    private static readonly string[] _ratingLabels = ["", "Poor", "Fair", "Good", "Great", "Excellent"];

    // Order data
    private const string _productName = "Ergonomic Standing Desk Pro";
    private const string _productVariant = "Walnut / 60-inch / Motorized";
    private const string _productPrice = "$549.00";
    private const string _orderNumber = "ORD-2847";

    // Social proof
    private const int _recentBuyers = 127;
    private const string _reviewRate = "82%";

    // Featured quote
    private const string _quoteAuthor = "Sarah K.";
    private const string _quoteInitials = "SK";
    private const int _quoteRating = 5;
    private const string _quoteText = "The height memory presets changed my workflow completely. Best desk investment I have made.";

    private void HandleStarClick(int value)
    {
        _rating = value;
        if (!_showCommentField)
        {
            _showCommentField = true;
        }
    }

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
