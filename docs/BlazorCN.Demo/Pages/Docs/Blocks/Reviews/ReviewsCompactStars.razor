@* ============================================================
   Block: reviews-compact-stars
   Title: ReviewsCompactStars
   Description: An ultra-compact star rating widget built with React, Next.js, shadcn/ui, and Tailwind CSS. Features animated star fill on mount, inline rating summary, review count breakdown, and embeddable snippet layout with motion/react transitions.
   Source: original/blocks/reviews/reviews-compact-stars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <TooltipProviderCn Delay="200">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-3 py-2.5">
                <span class="text-xs font-medium text-muted-foreground">Top rated products</span>
            </div>

            <div>
                @foreach (var product in _products)
                {
                    var isLast = product.Id == _products[^1].Id;
                    var verifiedPercent = (int)Math.Round((double)product.VerifiedPurchases / product.ReviewCount * 100);
                    var filled = (int)Math.Floor(product.Rating);
                    var partial = product.Rating - filled;

                    <TooltipCn>
                        <TooltipTriggerCn>
                            <div class="@Cn.Merge("flex items-center gap-3 px-3 py-2 transition-colors hover:bg-muted/50", isLast ? "" : "border-b border-border/50")">
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@product.Name</span>
                                </div>
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var isFull = i < filled;
                                        var isPartial = i == filled && partial > 0;
                                        <LucideStarCn Size="14" Class="@Cn.Merge("size-3.5", isFull ? "fill-amber-400 text-amber-400" : isPartial ? "fill-amber-400/50 text-amber-400" : "text-muted-foreground/20")" />
                                    }
                                </div>
                                <span class="w-7 text-right text-sm font-medium tabular-nums">@product.Rating</span>
                                <span class="w-12 text-right text-xs tabular-nums text-muted-foreground">(@product.ReviewCount.ToString("N0"))</span>
                            </div>
                        </TooltipTriggerCn>
                        <TooltipContentCn Align="FloatingAlign.Center" Class="w-48 p-3">
                            <div class="mb-2 flex items-center justify-between">
                                <span class="text-xs font-medium">@product.Name</span>
                                <span class="text-[10px] text-muted-foreground">@product.LastReviewDate</span>
                            </div>
                            <div class="space-y-1">
                                @{
                                    var total = product.RecentDistribution.Sum(d => d.Count);
                                    var maxCount = product.RecentDistribution.Max(d => d.Count);
                                }
                                @foreach (var dist in product.RecentDistribution)
                                {
                                    var barPct = (int)Math.Round((double)dist.Count / maxCount * 100);
                                    var labelPct = (int)Math.Round((double)dist.Count / total * 100);
                                    <div class="flex items-center gap-1.5">
                                        <span class="w-2 text-right text-[10px] tabular-nums text-muted-foreground">@dist.Stars</span>
                                        <div class="h-1 w-20 overflow-hidden rounded-full bg-muted">
                                            <div class="h-full rounded-full bg-foreground/60" style="@($"width:{barPct}%")"></div>
                                        </div>
                                        <span class="text-[10px] tabular-nums text-muted-foreground">@(labelPct)%</span>
                                    </div>
                                }
                            </div>
                            <div class="mt-2 text-[10px] text-muted-foreground">
                                @(verifiedPercent)% verified purchases
                            </div>
                        </TooltipContentCn>
                    </TooltipCn>
                }
            </div>
        </div>
    </TooltipProviderCn>
</section>

@code {
