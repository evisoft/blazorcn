@* ============================================================
   Block: reviews-timeline-feed
   Title: ReviewsTimelineFeed
   Description: A chronological review timeline for React and Next.js with vertical date markers, animated review cards, verified badges, star ratings, helpful vote counts, and expandable replies built with shadcn/ui Avatar, Badge, and Button components and Tailwind CSS.
   Source: original/blocks/reviews/reviews-timeline-feed.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Review timeline</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_totalReviews reviews &middot; Newest first
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                Live
            </BadgeCn>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            @foreach (var grp in _timeGroups)
            {
                var groupIndex = Array.IndexOf(_timeGroups, grp);
                <div class="relative">
                    @* Date node *@
                    <div class="mb-3 flex items-center gap-3">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full border bg-card">
                            <div class="@(groupIndex == 0 ? "size-2 rounded-full bg-emerald-500" : "size-2 rounded-full bg-muted-foreground/30")"></div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium">@grp.Label</span>
                            <span class="text-[10px] text-muted-foreground">@grp.Date</span>
                        </div>
                    </div>

                    @* Reviews in group *@
                    <div class="relative ml-3 border-l pl-6 pb-2">
                        @foreach (var review in grp.Reviews)
                        {
                            var reviewIndex = Array.IndexOf(grp.Reviews, review);
                            var isVoted = _votedReviews.Contains(review.Id);
                            var isRepliesExpanded = _expandedReplies.Contains(review.Id);
                            var helpfulCount = isVoted ? review.Helpful + 1 : review.Helpful;
                            var cardClass = (reviewIndex == 0 && groupIndex == 0)
                                ? "relative mb-4 rounded-md border p-3 border-foreground/10 bg-muted/20"
                                : "relative mb-4 rounded-md border p-3 bg-card";
                            var reviewId = review.Id;
                            <div class="@cardClass">
                                @* Timeline connector dot *@
                                <div class="absolute -left-[30.5px] top-4 size-2 rounded-full border bg-card"></div>

                                @* Review header *@
                                <div class="flex items-start gap-2.5">
                                    <AvatarCn Class="size-7 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@review.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium">@review.Author</span>
                                            @if (review.Verified)
                                            {
                                                <LucideIconCn Name="circle-check-2" Size="12" Class="size-3 text-emerald-500" />
                                            }
                                        </div>
                                        <div class="mt-0.5 flex items-center gap-2">
                                            <div class="flex items-center gap-0.5">
                                                @for (var i = 0; i < 5; i++)
                                                {
                                                    var starIndex = i;
                                                    var starClass = starIndex < review.Rating
                                                        ? "size-2.5 fill-foreground text-foreground"
                                                        : "size-2.5 text-muted-foreground/20";
                                                    <LucideIconCn Name="star" Size="10" Class="@starClass" />
                                                }
                                            </div>
                                            <span class="text-[10px] text-muted-foreground">@review.TimeElapsed</span>
                                            <span class="text-[10px] text-muted-foreground">&middot; @review.Product</span>
                                        </div>
                                    </div>
                                </div>

                                @* Review content *@
                                <div class="mt-2 pl-[34px]">
                                    <span class="text-sm font-medium">@review.Title</span>
                                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@review.Comment</p>

                                    @* Actions *@
                                    <div class="mt-2.5 flex items-center gap-3">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                  Class="@(isVoted ? "h-6 gap-1 px-2 text-xs text-foreground" : "h-6 gap-1 px-2 text-xs text-muted-foreground")"
                                                  @onclick="@(() => ToggleVote(reviewId))">
                                            <LucideIconCn Name="thumbs-up" Size="12" Class="@(isVoted ? "size-3 fill-foreground" : "size-3")" />
                                            <span class="tabular-nums">@helpfulCount</span>
                                        </ButtonCn>
                                        @if (review.Replies.Length > 0)
                                        {
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                      Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                                                      @onclick="@(() => ToggleReplies(reviewId))">
                                                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                                @review.Replies.Length @(review.Replies.Length == 1 ? "reply" : "replies")
                                            </ButtonCn>
                                        }
                                    </div>

                                    @* Replies *@
                                    @if (isRepliesExpanded && review.Replies.Length > 0)
                                    {
                                        <div class="mt-2.5 space-y-2">
                                            @foreach (var reply in review.Replies)
                                            {
                                                <div class="rounded-md bg-muted/50 p-2.5">
                                                    <div class="flex items-center gap-2">
                                                        <AvatarCn Class="size-5">
                                                            <AvatarFallbackCn Class="text-[8px]">@reply.Initials</AvatarFallbackCn>
                                                        </AvatarCn>
                                                        <span class="text-xs font-medium">@reply.Author</span>
                                                        @if (!string.IsNullOrEmpty(reply.Role))
                                                        {
                                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[9px] font-normal px-1.5 py-0">
                                                                @reply.Role
                                                            </BadgeCn>
                                                        }
                                                        <span class="text-[10px] text-muted-foreground">@reply.TimeElapsed</span>
                                                    </div>
                                                    <p class="mt-1.5 pl-7 text-xs text-muted-foreground leading-relaxed">@reply.Text</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-[10px] text-muted-foreground">
                @_totalReviews reviews across @_timeGroups.Length time periods
            </span>
            <span class="text-[10px] text-muted-foreground">Updated in real-time</span>
        </div>
    </div>
</section>

@code {
    private record ReviewReply(string Author, string Initials, string Role, string Text, string TimeElapsed);

    private record Review(string Id, string Author, string Initials, int Rating, string TimeElapsed, string Title, string Comment, int Helpful, bool Verified, string Product, ReviewReply[] Replies);

    private record TimeGroup(string Label, string Date, Review[] Reviews);

    private static readonly TimeGroup[] _timeGroups =
    [
        new("Today", "Apr 5, 2026",
        [
            new("r1", "Emma Rodriguez", "ER", 5, "2 hours ago",
                "Seamless integration with our existing stack",
                "Setup took under five minutes. The attention to detail is remarkable and it integrates perfectly into our Next.js project. Every component respects our existing Tailwind config without overrides.",
                8, true, "Pro Components",
            [
                new("Support Team", "ST", "Official",
                    "Thrilled to hear the integration was smooth, Emma. Let us know if you need help with the advanced chart components.",
                    "1 hour ago"),
            ]),
            new("r2", "David Kim", "DK", 4, "6 hours ago",
                "Great performance, docs could improve",
                "Solid product with great runtime performance. The only thing I would improve is the onboarding documentation for the data table component. Took me a bit to find the right column configuration options.",
                3, true, "Data Table", []),
        ]),
        new("This Week", "Mar 31 - Apr 4",
        [
            new("r3", "Lisa Thompson", "LT", 5, "2 days ago",
                "Support team is incredibly responsive",
                "This exceeded my expectations. Fast, reliable, and the customer support team responded within an hour when I had a question about custom theme tokens. They even provided a working code example.",
                15, false, "Theme System", []),
            new("r4", "Marcus Johnson", "MJ", 3, "4 days ago",
                "Good foundation, advanced features need polish",
                "Works well for standard use cases. The advanced data grid features like virtual scrolling and column pinning need more polish. Hoping to see improvements in the next quarterly update.",
                6, true, "Data Grid",
            [
                new("Product Team", "PT", "Official",
                    "Thanks for the specific feedback, Marcus. Virtual scrolling improvements are on our Q2 roadmap. We will reach out when the beta is ready.",
                    "3 days ago"),
            ]),
        ]),
        new("Earlier", "Mar 2026",
        [
            new("r5", "Anna Kowalski", "AK", 5, "2 weeks ago",
                "Replaced three tools in our stack",
                "Been using this for two weeks and it has completely replaced our charting library, form builder, and notification system. The all-in-one approach actually works here because every piece is individually composable.",
                32, true, "Full Suite", []),
        ]),
    ];

    private static readonly int _totalReviews = _timeGroups.Sum(g => g.Reviews.Length);

    private readonly HashSet<string> _votedReviews = [];
    private readonly HashSet<string> _expandedReplies = ["r1"];

    private void ToggleVote(string reviewId)
    {
        if (_votedReviews.Contains(reviewId))
            _votedReviews.Remove(reviewId);
        else
            _votedReviews.Add(reviewId);
    }

    private void ToggleReplies(string reviewId)
    {
        if (_expandedReplies.Contains(reviewId))
            _expandedReplies.Remove(reviewId);
        else
            _expandedReplies.Add(reviewId);
    }
}
