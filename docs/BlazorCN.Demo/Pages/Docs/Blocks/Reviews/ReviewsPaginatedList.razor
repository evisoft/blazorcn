@* ============================================================
   Block: reviews-paginated-list
   Title: ReviewsPaginatedList
   Description: A React paginated reviews component for Next.js with animated page transitions, star ratings, verified badges, per-page selector, and keyboard-navigable pagination controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-paginated-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with summary *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <span class="font-medium text-sm">Customer Reviews</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    @_totalReviews
                </BadgeCn>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < (int)Math.Round(double.Parse(_avgRating)) ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                    }
                </div>
                <span class="font-medium text-xs tabular-nums">@_avgRating</span>
            </div>
        </div>

        @* Showing range *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs tabular-nums">
                Showing @(_startIndex + 1)–@_endIndex of @_totalReviews
            </span>
            <div class="flex items-center gap-1.5">
                <span class="text-muted-foreground text-xs">Per page:</span>
                @foreach (var opt in _perPageOptions)
                {
                    var option = opt;
                    <button
                        type="button"
                        @onclick="@(() => HandlePerPageChange(option))"
                        class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs tabular-nums transition-colors", _perPage == option ? "bg-foreground text-background font-medium" : "text-muted-foreground hover:text-foreground")">
                        @option
                    </button>
                }
            </div>
        </div>

        @* Reviews list *@
        <div>
            @foreach (var (review, index) in _visibleReviews.Select((r, i) => (r, i)))
            {
                var rev = review;
                var isLast = index >= _visibleReviews.Length - 1;
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        @* Review header *@
                        <div class="flex items-start gap-2.5">
                            <AvatarCn Class="mt-0.5 size-8">
                                <AvatarFallbackCn Class="text-[10px]">@rev.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@rev.Author</span>
                                    @if (rev.Verified)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Verified</BadgeCn>
                                    }
                                </div>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <div class="flex items-center gap-0.5">
                                        @for (var i = 0; i < 5; i++)
                                        {
                                            var starIdx = i;
                                            <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < rev.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                        }
                                    </div>
                                    <span class="text-muted-foreground text-[10px]">@rev.Product</span>
                                </div>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">@rev.Date</span>
                        </div>

                        @* Review content *@
                        <div class="mt-2 pl-[42px]">
                            <p class="font-medium text-sm">@rev.Title</p>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                                @rev.Body
                            </p>
                            <div class="mt-2 flex items-center gap-1">
                                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3 text-muted-foreground/50" />
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @rev.Helpful
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Pagination controls *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                      OnClick="@(() => SetPage(Math.Max(1, _page - 1)))"
                      Disabled="@(_page == 1)">
                <LucideIconCn Name="chevron-left" Size="12" Class="size-3" />
                Previous
            </ButtonCn>

            <div class="flex items-center gap-0.5">
                @foreach (var pageNum in GetPageNumbers())
                {
                    if (pageNum < 0)
                    {
                        @* ellipsis marker: negative = ellipsis-start (-1) or ellipsis-end (-2) *@
                        <span class="px-1.5 text-muted-foreground text-xs">...</span>
                    }
                    else
                    {
                        var pn = pageNum;
                        <ButtonCn Variant="@(_page == pn ? ButtonVariant.Default : ButtonVariant.Ghost)"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 w-7 px-0 text-xs tabular-nums"
                                  OnClick="@(() => SetPage(pn))">
                            @pn
                        </ButtonCn>
                    }
                }
            </div>

            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                      OnClick="@(() => SetPage(Math.Min(_totalPages, _page + 1)))"
                      Disabled="@(_page == _totalPages)">
                Next
                <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Review(string Id, string Author, string Initials, int Rating, string Date, bool Verified, string Title, string Body, int Helpful, string Product);

    private static readonly Review[] _allReviews =
    [
        new("r1", "Sarah Chen", "SC", 5, "Mar 20, 2026", true, "Exactly what our team needed", "Clean API, comprehensive TypeScript types, and the component library saved us weeks of development. Already deployed to production with zero issues.", 42, "Pro Plan"),
        new("r2", "Marcus Johnson", "MJ", 4, "Mar 18, 2026", true, "Great components with solid defaults", "The blocks are production-ready out of the box. A few advanced features needed minor customization but the foundation is excellent.", 28, "Team Plan"),
        new("r3", "Elena Rodriguez", "ER", 5, "Mar 15, 2026", false, "Best React component library available", "We migrated from a custom system and the transition was seamless. Accessibility is handled well and everything composes naturally.", 35, "Pro Plan"),
        new("r4", "David Kim", "DK", 3, "Mar 12, 2026", true, "Solid foundation with room to grow", "Standard layouts work perfectly. Would appreciate more complex data table patterns and better documentation for advanced theming.", 14, "Starter Plan"),
        new("r5", "Priya Patel", "PP", 5, "Mar 10, 2026", true, "Shipped our landing page in a day", "Combined hero, features, and pricing blocks for a complete page in hours. The code quality meant zero cleanup was needed after integration.", 51, "Pro Plan"),
        new("r6", "James O'Brien", "JO", 4, "Mar 8, 2026", true, "Excellent developer experience", "The copy-paste model is refreshing. No dependency bloat and full control over styling. Documentation could use more real-world examples though.", 19, "Team Plan"),
        new("r7", "Aisha Mohammed", "AM", 5, "Mar 5, 2026", true, "Outstanding component quality", "Every component follows consistent patterns and the TypeScript integration is first-class. Saved our startup months of design system work.", 37, "Pro Plan"),
        new("r8", "Thomas Weber", "TW", 4, "Mar 3, 2026", false, "Very polished UI blocks", "The attention to detail is impressive. Spacing, typography, and color usage are consistent throughout. Minor accessibility improvements would make it perfect.", 22, "Starter Plan"),
        new("r9", "Lisa Nakamura", "LN", 5, "Feb 28, 2026", true, "Worth every penny of the pro plan", "The premium blocks alone justify the subscription. We built an entire SaaS dashboard using these components and clients love the result.", 44, "Pro Plan"),
        new("r10", "Carlos Rivera", "CR", 3, "Feb 25, 2026", true, "Good but customization can be tricky", "Works great with default styles. Overriding theme tokens took some trial and error. A theming guide or config reference would help a lot.", 11, "Starter Plan"),
        new("r11", "Nina Kowalski", "NK", 5, "Feb 22, 2026", true, "Transformed our development workflow", "Our team velocity increased significantly after adopting these components. Consistent API design means onboarding new developers takes minutes, not days.", 33, "Team Plan"),
        new("r12", "Ryan Foster", "RF", 4, "Feb 19, 2026", false, "Clean, maintainable code", "Compared to other libraries, the code here is exceptionally clean. Easy to read, extend, and maintain. Wish there were more chart variations.", 16, "Pro Plan"),
    ];

    private static readonly int _totalReviews = 247;
    private static readonly int[] _perPageOptions = [5, 10, 20];
    private static readonly string _avgRating = (_allReviews.Sum(r => r.Rating) / (double)_allReviews.Length).ToString("F1");

    private int _page = 1;
    private int _perPage = 5;

    private int _totalPages => (int)Math.Ceiling(_totalReviews / (double)_perPage);
    private int _startIndex => (_page - 1) * _perPage;
    private int _endIndex => Math.Min(_startIndex + _perPage, _totalReviews);
    private Review[] _visibleReviews => _allReviews[..Math.Min(_perPage, _allReviews.Length)];

    private int[] GetPageNumbers()
    {
        if (_totalPages <= 7)
        {
            return Enumerable.Range(1, _totalPages).ToArray();
        }
        var pages = new List<int> { 1 };
        if (_page > 3)
        {
            pages.Add(-1); // ellipsis-start
        }
        var start = Math.Max(2, _page - 1);
        var end = Math.Min(_totalPages - 1, _page + 1);
        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }
        if (_page < _totalPages - 2)
        {
            pages.Add(-2); // ellipsis-end
        }
        pages.Add(_totalPages);
        return pages.ToArray();
    }

    private void HandlePerPageChange(int newPerPage)
    {
        _perPage = newPerPage;
        _page = 1;
    }

    private void SetPage(int newPage) => _page = newPage;
}
