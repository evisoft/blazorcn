@* ============================================================
   Block: reviews-benchmark-compare
   Title: ReviewsBenchmarkCompare
   Description: A side-by-side product review benchmark comparison block for React and Next.js with split-panel layout, criteria ratings, win/loss indicators, and animated bar charts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-benchmark-compare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-sm font-medium">Benchmark Comparison</span>
                <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                    <button type="button"
                            @onclick="@(() => _view = "criteria")"
                            class="@Cn.Merge("rounded px-2.5 py-1 text-[10px] font-medium transition-colors", _view == "criteria" ? "bg-card text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        Criteria
                    </button>
                    <button type="button"
                            @onclick="@(() => _view = "summary")"
                            class="@Cn.Merge("rounded px-2.5 py-1 text-[10px] font-medium transition-colors", _view == "summary" ? "bg-card text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        Summary
                    </button>
                </div>
            </div>
        </div>

        @* Product headers - split panel *@
        <div class="grid grid-cols-2 divide-x border-b">
            <div class="px-4 py-3">
                <div class="flex items-center gap-2">
                    <div class="flex size-7 items-center justify-center rounded-md bg-foreground/5">
                        <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5 text-foreground" />
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-medium">@_productA.Name</span>
                            <span class="text-[10px] text-muted-foreground">@_productA.Version</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="flex items-center gap-0.5">
                                <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-500 text-amber-500" />
                                <span class="text-xs font-medium tabular-nums">@_productA.OverallScore</span>
                            </div>
                            <span class="text-[10px] text-muted-foreground">
                                @_productA.ReviewCount.ToString("N0") reviews
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-2">
                    <div class="flex size-7 items-center justify-center rounded-md bg-foreground/5">
                        <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-medium">@_productB.Name</span>
                            <span class="text-[10px] text-muted-foreground">@_productB.Version</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="flex items-center gap-0.5">
                                <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-500 text-amber-500" />
                                <span class="text-xs font-medium tabular-nums">@_productB.OverallScore</span>
                            </div>
                            <span class="text-[10px] text-muted-foreground">
                                @_productB.ReviewCount.ToString("N0") reviews
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Win/Loss summary bar *@
        <div class="flex items-center justify-between border-b bg-muted/20 px-4 py-2">
            <div class="flex items-center gap-1.5">
                <span class="size-2 rounded-full bg-foreground"></span>
                <span class="text-[10px] font-medium">@_productA.Name</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                    @_winsA wins
                </BadgeCn>
            </div>
            @if (_ties > 0)
            {
                <span class="text-[10px] text-muted-foreground">@_ties tied</span>
            }
            <div class="flex items-center gap-1.5">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                    @_winsB wins
                </BadgeCn>
                <span class="text-[10px] font-medium">@_productB.Name</span>
                <span class="size-2 rounded-full bg-muted-foreground/40"></span>
            </div>
        </div>

        @* Criteria comparison view *@
        @if (_view == "criteria")
        {
            <div>
                @foreach (var item in _criteriaWithIndex)
                {
                    var criterion = item.Criterion;
                    var idx = item.Index;
                    var isLast = idx == _criteria.Length - 1;
                    var aLeads = criterion.ScoreA > criterion.ScoreB;
                    var bLeads = criterion.ScoreB > criterion.ScoreA;
                    var pctA = criterion.ScoreA / criterion.Max * 100.0;
                    var pctB = criterion.ScoreB / criterion.Max * 100.0;
                    var diff = criterion.ScoreA - criterion.ScoreB;

                    <div class="@(isLast ? "" : "border-b")">
                        <div class="px-4 py-3">
                            @* Criterion label *@
                            <div class="mb-2 flex items-center justify-between">
                                <div>
                                    <span class="text-sm font-medium">@criterion.Label</span>
                                    <span class="ml-2 text-[10px] text-muted-foreground">
                                        @criterion.Description
                                    </span>
                                </div>
                                @if (Math.Abs(diff) < 0.05)
                                {
                                    <LucideIconCn Name="minus" Size="12" Class="size-3 text-muted-foreground" />
                                }
                                else if (diff > 0)
                                {
                                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-red-500" />
                                }
                            </div>

                            @* Side-by-side bars *@
                            <div class="grid grid-cols-2 gap-4">
                                @* Product A *@
                                <div class="flex items-center gap-2">
                                    <span class="@Cn.Merge("w-8 text-right text-xs font-medium tabular-nums", aLeads ? "text-emerald-600 dark:text-emerald-400" : "")">
                                        @criterion.ScoreA
                                    </span>
                                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                        <div class="h-full rounded-full bg-foreground" style="@(FormattableString.Invariant($"width:{pctA:F1}%"))"></div>
                                    </div>
                                </div>

                                @* Product B *@
                                <div class="flex items-center gap-2">
                                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                        <div class="h-full rounded-full bg-muted-foreground/40" style="@(FormattableString.Invariant($"width:{pctB:F1}%"))"></div>
                                    </div>
                                    <span class="@Cn.Merge("w-8 text-xs font-medium tabular-nums", bLeads ? "text-emerald-600 dark:text-emerald-400" : "")">
                                        @criterion.ScoreB
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Summary view *@
        @if (_view == "summary")
        {
            <div>
                @foreach (var item in _summaryWithIndex)
                {
                    var insight = item.Insight;
                    var idx = item.Index;
                    var isLast = idx == _summaryInsights.Length - 1;

                    <div class="@(isLast ? "" : "border-b")">
                        <div class="grid grid-cols-3 items-center px-4 py-3">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("text-sm font-medium tabular-nums", insight.Winner == "a" ? "text-emerald-600 dark:text-emerald-400" : "")">
                                    @insight.ProductAValue
                                </span>
                                @if (insight.Winner == "a")
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                            </div>
                            <span class="text-center text-xs text-muted-foreground">
                                @insight.Label
                            </span>
                            <div class="flex items-center justify-end gap-2">
                                @if (insight.Winner == "b")
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                                <span class="@Cn.Merge("text-sm font-medium tabular-nums", insight.Winner == "b" ? "text-emerald-600 dark:text-emerald-400" : "")">
                                    @insight.ProductBValue
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record Product(string Id, string Name, string Version, int ReviewCount, double OverallScore);

    private record Criterion(string Id, string Label, string Description, double ScoreA, double ScoreB, double Max, double Weight);

    private record SummaryInsight(string Label, string ProductAValue, string ProductBValue, string Winner);

    private record IndexedCriterion(int Index, Criterion Criterion);

    private record IndexedInsight(int Index, SummaryInsight Insight);

    private string _view = "criteria";

    private static readonly Product _productA = new("prod-a", "FormKit Pro", "v3.2", 1847, 4.6);
    private static readonly Product _productB = new("prod-b", "InputMaster", "v2.8", 1203, 4.1);

    private static readonly Criterion[] _criteria =
    [
        new("c1", "Ease of Use", "Setup complexity and learning curve", 4.7, 3.9, 5, 1.2),
        new("c2", "Documentation", "API reference, guides, and examples", 4.4, 4.5, 5, 1.0),
        new("c3", "Performance", "Bundle size and runtime speed", 4.8, 4.2, 5, 1.1),
        new("c4", "Customization", "Theming, styling, and extensibility", 4.3, 4.6, 5, 1.0),
        new("c5", "Support", "Response time and issue resolution", 4.5, 3.8, 5, 0.9),
        new("c6", "Value for Price", "Feature-to-cost ratio", 4.2, 4.4, 5, 0.8),
    ];

    private static readonly SummaryInsight[] _summaryInsights =
    [
        new("Recommendation Rate", "94%", "87%", "a"),
        new("Avg Response Time", "2.1 hrs", "6.4 hrs", "a"),
        new("5-Star Percentage", "62%", "48%", "a"),
        new("Update Frequency", "Biweekly", "Weekly", "b"),
    ];

    private static readonly int _winsA = _criteria.Count(c => c.ScoreA > c.ScoreB);
    private static readonly int _winsB = _criteria.Count(c => c.ScoreB > c.ScoreA);
    private static readonly int _ties = _criteria.Count(c => c.ScoreA == c.ScoreB);

    private IEnumerable<IndexedCriterion> _criteriaWithIndex =>
        _criteria.Select((c, i) => new IndexedCriterion(i, c));

    private IEnumerable<IndexedInsight> _summaryWithIndex =>
        _summaryInsights.Select((s, i) => new IndexedInsight(i, s));
}
