@* ============================================================
   Block: reviews-course-education
   Title: ReviewsCourseEducation
   Description: A course review display for education platforms built with React, Next.js, shadcn/ui, and Tailwind CSS. Features sidebar curriculum navigation, instructor rating, skill progression bars, student reviews with difficulty badges, and learning outcome indicators with motion/react animations.
   Source: original/blocks/reviews/reviews-course-education.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-sm font-medium">@_course.Title</span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_course.Subtitle</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-400 text-amber-400" />
                        <span class="text-sm font-semibold tabular-nums">@_course.OverallRating</span>
                        <span class="text-xs text-muted-foreground">(@_course.TotalReviews.ToString("N0"))</span>
                    </div>
                </div>
            </div>

            @* Summary stats row *@
            <div class="mt-2.5 flex items-center gap-4">
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                    <span class="tabular-nums">@_course.RecommendRate%</span>
                    <span>recommend</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                    <span class="tabular-nums">@_course.CompletionRate%</span>
                    <span>complete</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_course.AverageDifficulty
                </BadgeCn>
            </div>
        </div>

        @* Sidebar + Content layout *@
        <div class="flex divide-x">
            @* Sidebar *@
            <div class="w-56 shrink-0">
                @* Instructor card *@
                <div class="border-b p-3">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Instructor
                    </span>
                    <div class="mt-2 flex items-center gap-2">
                        <AvatarCn Class="size-8">
                            <AvatarFallbackCn Class="text-xs">@_course.Instructor.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <span class="text-xs font-medium">@_course.Instructor.Name</span>
                            <p class="text-[10px] text-muted-foreground">@_course.Instructor.Title</p>
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-3 text-[10px] text-muted-foreground">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-400 text-amber-400" />
                            <span class="tabular-nums">@_course.Instructor.Rating</span>
                        </div>
                        <span>@_course.Instructor.TotalCourses courses</span>
                        <span>@((_course.Instructor.TotalStudents / 1000.0).ToString("F1"))k students</span>
                    </div>
                </div>

                @* Curriculum nav *@
                <div class="p-3">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Modules
                    </span>
                    <div class="mt-2 space-y-0.5">
                        <button type="button"
                                @onclick="@(() => _selectedModule = "all")"
                                class="@Cn.Merge("flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-xs transition-colors", _selectedModule == "all" ? "bg-muted font-medium" : "hover:bg-muted/50")">
                            <LucideIconCn Name="book-open" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                            <span class="flex-1">All reviews</span>
                            <span class="text-[10px] tabular-nums text-muted-foreground">@_course.TotalReviews</span>
                        </button>
                        @foreach (var mod in _course.Curriculum)
                        {
                            var modId = mod.Id;
                            <button type="button"
                                    @onclick="@(() => _selectedModule = modId)"
                                    class="@Cn.Merge("flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-xs transition-colors", _selectedModule == modId ? "bg-muted font-medium" : "hover:bg-muted/50")">
                                @if (mod.Completed)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="play-circle" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                }
                                <div class="min-w-0 flex-1">
                                    <span class="block truncate">@mod.Title</span>
                                    <span class="text-[10px] text-muted-foreground">@mod.Duration &middot; @mod.Lessons lessons</span>
                                </div>
                                <span class="text-[10px] tabular-nums text-muted-foreground">@mod.ReviewCount</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Main content *@
            <div class="min-w-0 flex-1">
                @* Skill progressions *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="trophy" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">
                            Average skill progression (self-reported)
                        </span>
                    </div>
                    <div class="mt-2.5 space-y-2">
                        @foreach (var sp in _course.SkillProgressions)
                        {
                            var improvement = sp.After - sp.Before;
                            <div class="flex items-center gap-3">
                                <span class="w-36 shrink-0 text-xs text-muted-foreground">@sp.Skill</span>
                                <div class="relative h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="absolute left-0 top-0 h-full rounded-full bg-muted-foreground/30" style="@($"width:{sp.Before}%")"></div>
                                    <div class="absolute left-0 top-0 h-full rounded-full bg-emerald-500" style="@($"width:{sp.After}%")"></div>
                                </div>
                                <span class="w-16 text-right text-[10px] tabular-nums text-muted-foreground">@sp.Before% &rarr; @sp.After%</span>
                                <span class="w-10 text-right text-[10px] font-medium tabular-nums text-emerald-600 dark:text-emerald-400">+@improvement</span>
                            </div>
                        }
                    </div>
                </div>

                @* Reviews section header *@
                <div class="border-b px-4 py-2.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium">
                            @if (_selectedModule == "all")
                            {
                                <text>All student reviews</text>
                            }
                            else
                            {
                                var modTitle = _course.Curriculum.FirstOrDefault(m => m.Id == _selectedModule)?.Title ?? "module";
                                <text>Reviews for @modTitle</text>
                            }
                        </span>
                        <span class="text-[10px] text-muted-foreground">
                            @FilteredReviews.Length review@(FilteredReviews.Length != 1 ? "s" : "")
                        </span>
                    </div>
                </div>

                @* Review list *@
                <div>
                    @{
                        var filtered = FilteredReviews;
                    }
                    @if (filtered.Length == 0)
                    {
                        <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                            No reviews for this module yet
                        </div>
                    }
                    else
                    {
                        @for (var ri = 0; ri < filtered.Length; ri++)
                        {
                            var review = filtered[ri];
                            var index = ri;
                            var isExpanded = _expandedReview == review.Id;
                            var isLast = index == filtered.Length - 1;

                            <div class="@(isLast ? "" : "border-b")">
                                <button type="button"
                                        @onclick="@(() => ToggleReview(review.Id))"
                                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                    <AvatarCn Class="size-7 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@review.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium">@review.Author</span>
                                            <span class="text-[10px] text-muted-foreground">@review.Date</span>
                                        </div>
                                        <div class="mt-0.5 flex items-center gap-2">
                                            <div class="flex items-center gap-0.5">
                                                @for (var si = 0; si < 5; si++)
                                                {
                                                    var starIdx = si;
                                                    <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIdx < review.Rating ? "fill-amber-400 text-amber-400" : "text-muted-foreground/20")" />
                                                }
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@review.Difficulty</BadgeCn>
                                            <div class="flex items-center gap-1 text-[10px] text-muted-foreground">
                                                <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                                <span class="tabular-nums">@review.CompletionPercent%</span>
                                            </div>
                                            @if (review.Recommends)
                                            {
                                                <span class="flex items-center gap-0.5 text-[10px] text-emerald-600 dark:text-emerald-400">
                                                    <LucideIconCn Name="thumbs-up" Size="10" Class="size-2.5" />
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/40 transition-transform duration-200", isExpanded ? "rotate-90" : "")">
                                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                                    </div>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="overflow-hidden">
                                        <div class="px-4 pb-3 pl-14">
                                            <p class="text-xs leading-relaxed text-muted-foreground">@review.Comment</p>
                                            @if (review.Skills.Length > 0)
                                            {
                                                <div class="mt-2 flex flex-wrap gap-1">
                                                    @foreach (var skill in review.Skills)
                                                    {
                                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@skill</BadgeCn>
                                                    }
                                                </div>
                                            }
                                            <div class="mt-2 flex items-center gap-1 text-[10px] text-muted-foreground">
                                                <LucideIconCn Name="thumbs-up" Size="10" Class="size-2.5" />
                                                <span class="tabular-nums">@review.HelpfulCount</span>
                                                <span>found helpful</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2">
            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    <span class="tabular-nums">@_course.TotalReviews.ToString("N0")</span>
                    <span>reviews</span>
                </div>
                <span>&middot;</span>
                <span>@_course.Curriculum.Sum(m => m.Lessons) lessons</span>
                <span>&middot;</span>
                <span>@_course.Curriculum.Length modules</span>
            </div>
            <span class="text-[10px] text-muted-foreground">Last reviewed Mar 28, 2026</span>
        </div>
    </div>
</section>

@code {
    private record InstructorInfo(
        string Name,
        string Initials,
        string Title,
        double Rating,
        int TotalCourses,
        int TotalStudents
    );

    private record CurriculumModule(
        string Id,
        string Title,
        string Duration,
        int Lessons,
        bool Completed,
        int ReviewCount
    );

    private record SkillProgression(string Skill, int Before, int After);

    private record StudentReview(
        string Id,
        string Author,
        string Initials,
        string Date,
        int Rating,
        string Difficulty,
        int CompletionPercent,
        string ModuleId,
        bool Recommends,
        string Comment,
        int HelpfulCount,
        string[] Skills
    );

    private record CourseData(
        string Title,
        string Subtitle,
        double OverallRating,
        int TotalReviews,
        int RecommendRate,
        int CompletionRate,
        string AverageDifficulty,
        InstructorInfo Instructor,
        CurriculumModule[] Curriculum,
        SkillProgression[] SkillProgressions,
        StudentReview[] Reviews
    );

    private static readonly CourseData _course = new CourseData(
        Title: "Advanced React Patterns",
        Subtitle: "Master compound components, render props, and server component architecture",
        OverallRating: 4.7,
        TotalReviews: 1284,
        RecommendRate: 96,
        CompletionRate: 82,
        AverageDifficulty: "Intermediate",
        Instructor: new InstructorInfo(
            Name: "Elena Vasquez",
            Initials: "EV",
            Title: "Principal Engineer, ex-Vercel",
            Rating: 4.9,
            TotalCourses: 12,
            TotalStudents: 34200
        ),
        Curriculum:
        [
            new CurriculumModule("m1", "Compound Components", "2h 15m", 8, true, 312),
            new CurriculumModule("m2", "Render Props & HOCs", "1h 45m", 6, true, 287),
            new CurriculumModule("m3", "Custom Hook Patterns", "2h 30m", 9, true, 341),
            new CurriculumModule("m4", "Server Components", "3h 10m", 11, false, 189),
            new CurriculumModule("m5", "Performance Patterns", "2h 50m", 10, false, 155),
        ],
        SkillProgressions:
        [
            new SkillProgression("Component Architecture", 35, 88),
            new SkillProgression("TypeScript Patterns", 42, 79),
            new SkillProgression("State Management", 50, 91),
            new SkillProgression("Server Components", 15, 72),
            new SkillProgression("Performance", 28, 81),
        ],
        Reviews:
        [
            new StudentReview(
                Id: "r1",
                Author: "Daniel Park",
                Initials: "DP",
                Date: "Mar 28, 2026",
                Rating: 5,
                Difficulty: "Intermediate",
                CompletionPercent: 100,
                ModuleId: "m3",
                Recommends: true,
                Comment: "The custom hooks module completely changed how I structure shared logic. Elena's approach to building composable hooks that handle race conditions and cleanup is something I have not seen in any other course. Already refactored three production components using these patterns.",
                HelpfulCount: 42,
                Skills: ["Custom Hooks", "React Composition", "Error Boundaries"]
            ),
            new StudentReview(
                Id: "r2",
                Author: "Priya Sharma",
                Initials: "PS",
                Date: "Mar 22, 2026",
                Rating: 5,
                Difficulty: "Advanced",
                CompletionPercent: 100,
                ModuleId: "m4",
                Recommends: true,
                Comment: "The server components module is the most thorough treatment of RSC I have found anywhere. The mental model Elena builds for understanding the server/client boundary finally made it click. The exercises force you to think about data flow in ways that transfer directly to real projects.",
                HelpfulCount: 38,
                Skills: ["Server Components", "Data Fetching", "Streaming SSR"]
            ),
            new StudentReview(
                Id: "r3",
                Author: "James O'Brien",
                Initials: "JO",
                Date: "Mar 15, 2026",
                Rating: 4,
                Difficulty: "Intermediate",
                CompletionPercent: 68,
                ModuleId: "m2",
                Recommends: true,
                Comment: "Good depth on render props and higher-order components. The historical context helps understand why these patterns evolved. I would have liked more exercises in the HOC section since the concept is harder to internalize without hands-on practice. Still working through the rest.",
                HelpfulCount: 15,
                Skills: ["Render Props", "Higher-Order Components"]
            ),
            new StudentReview(
                Id: "r4",
                Author: "Mei-Lin Wu",
                Initials: "MW",
                Date: "Mar 8, 2026",
                Rating: 3,
                Difficulty: "Advanced",
                CompletionPercent: 45,
                ModuleId: "m1",
                Recommends: false,
                Comment: "The content quality is high but the pacing assumes significant prior React experience. The jump from compound components to the advanced patterns in later modules is steep. I found myself pausing often to read supplementary material. Could benefit from intermediate checkpoints.",
                HelpfulCount: 22,
                Skills: ["Compound Components"]
            ),
        ]
    );

    private string _selectedModule = "all";
    private string? _expandedReview = null;

    private StudentReview[] FilteredReviews =>
        _selectedModule == "all"
            ? _course.Reviews
            : _course.Reviews.Where(r => r.ModuleId == _selectedModule).ToArray();

    private void ToggleReview(string id)
    {
        _expandedReview = _expandedReview == id ? null : id;
    }
}
