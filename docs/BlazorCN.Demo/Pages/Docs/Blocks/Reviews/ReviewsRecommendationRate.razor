@* ============================================================
   Block: reviews-recommendation-rate
   Title: ReviewsRecommendationRate
   Description: A React recommendation rate visualization for Next.js with animated percentage ring, yes/no split bar, monthly trend sparkline, and segment breakdown built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/reviews/reviews-recommendation-rate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-[280px_1fr] md:divide-x">
            @* Left: Ring visualization *@
            <div class="flex flex-col items-center justify-center border-b px-6 py-8 md:border-b-0">
                <div class="relative">
                    <svg
                        width="140"
                        height="140"
                        viewBox="0 0 120 120"
                        class="-rotate-90"
                        role="img"
                        aria-label="@($"{_summary.OverallRate} percent would recommend")">
                        <circle
                            cx="60"
                            cy="60"
                            r="52"
                            fill="none"
                            stroke-width="8"
                            class="stroke-muted" />
                        <circle
                            cx="60"
                            cy="60"
                            r="52"
                            fill="none"
                            stroke-width="8"
                            stroke-linecap="round"
                            class="@StrokeColor(_summary.OverallRate)"
                            stroke-dasharray="@_ringCircumference.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                            stroke-dashoffset="@_rateOffset.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="@($"font-semibold text-3xl tabular-nums {RateColor(_summary.OverallRate)}")">
                            @(_summary.OverallRate)%
                        </span>
                        <span class="text-muted-foreground text-xs">would recommend</span>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-3 text-xs">
                    <span class="flex items-center gap-1.5 text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        @(_summary.YesCount.ToString("N0")) yes
                    </span>
                    <span class="size-0.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="flex items-center gap-1.5 text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @(_summary.NoCount.ToString("N0")) no
                    </span>
                </div>

                @* Yes/No split bar *@
                <div class="mt-3 w-full origin-left px-4">
                    <div class="flex h-2 w-full overflow-hidden rounded-full">
                        <div
                            class="h-full bg-emerald-500"
                            style="@($"width:{_summary.OverallRate}%")" />
                        <div
                            class="h-full bg-red-500"
                            style="@($"width:{100 - _summary.OverallRate}%")" />
                    </div>
                    <div class="mt-1 flex justify-between text-[10px] text-muted-foreground">
                        <span>@(_summary.TotalResponses.ToString("N0")) responses</span>
                        <span class="@(_rateDelta >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @(_rateDelta >= 0 ? "+" : "")@(_rateDelta)% vs last period
                        </span>
                    </div>
                </div>
            </div>

            @* Right: Trend and segments *@
            <div class="flex flex-col">
                @* Sparkline trend *@
                <div class="border-b px-5 py-4">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">6-Month Trend</span>
                        @if (_hoveredMonth != null)
                        {
                            <span class="text-xs text-muted-foreground tabular-nums">
                                @(_monthlyTrend[_hoveredMonth.Value].Month): @(_monthlyTrend[_hoveredMonth.Value].Rate)% (@(_monthlyTrend[_hoveredMonth.Value].Responses) responses)
                            </span>
                        }
                    </div>

                    <div class="relative mt-3">
                        <svg
                            viewBox="@($"-4 -4 {_sparklineWidth + 8} {_sparklineHeight + 8}")"
                            class="h-14 w-full"
                            preserveAspectRatio="none">
                            <title>Recommendation rate trend over 6 months</title>
                            @* Grid lines *@
                            @foreach (var pct in _gridLines)
                            {
                                var gridY = _sparklineHeight - ((pct - _minRate + 5.0) / (_maxRate - _minRate)) * _sparklineHeight;
                                <line
                                    x1="0"
                                    y1="@gridY.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    x2="@_sparklineWidth"
                                    y2="@gridY.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    class="stroke-muted"
                                    stroke-width="0.5"
                                    stroke-dasharray="4 4" />
                            }
                            <polyline
                                fill="none"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="stroke-emerald-500"
                                points="@_sparklinePoints" />
                            @foreach (var entry in _sparklineEntries)
                            {
                                var idx = entry.Index;
                                <circle
                                    cx="@entry.X.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    cy="@entry.Y.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    r="@(_hoveredMonth == idx ? "4" : "2.5")"
                                    class="@(_hoveredMonth == idx ? "fill-emerald-500" : "fill-card stroke-emerald-500")"
                                    stroke-width="1.5"
                                    style="cursor:pointer"
                                    @onmouseenter="@(() => _hoveredMonth = idx)"
                                    @onmouseleave="@(() => _hoveredMonth = null)" />
                            }
                        </svg>

                        @* Month labels *@
                        <div class="mt-1 flex justify-between px-0.5">
                            @foreach (var m in _monthlyTrend)
                            {
                                <span class="text-[10px] text-muted-foreground">@m.Month</span>
                            }
                        </div>
                    </div>
                </div>

                @* Segment breakdown *@
                <div class="flex-1 px-5 py-4">
                    <span class="text-sm font-medium">By Buyer Segment</span>
                    <div class="mt-3 space-y-3">
                        @foreach (var seg in _segments)
                        {
                            var segment = seg;
                            <div>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-muted-foreground">@segment.Label</span>
                                    <span class="@($"text-xs font-medium tabular-nums {RateColor(segment.Rate)}")">
                                        @(segment.Rate)%
                                    </span>
                                </div>
                                <TooltipProviderCn Delay="200">
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                                <div
                                                    class="@($"h-full rounded-full {BarColor(segment.Rate)}")"
                                                    style="@($"width:{segment.Rate}%")" />
                                            </div>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="text-xs">
                                            @(segment.YesCount.ToString("N0")) of @(segment.TotalCount.ToString("N0")) would recommend
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TooltipProviderCn>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record MonthlyRate(string Month, int Rate, int Responses);
    private record BuyerSegment(string Label, int YesCount, int TotalCount, int Rate);
    private record RecommendationSummary(int TotalResponses, int YesCount, int NoCount, int OverallRate, int PreviousRate);

    private readonly RecommendationSummary _summary = new(2847, 2562, 285, 90, 87);

    private readonly MonthlyRate[] _monthlyTrend =
    [
        new("Oct", 84, 412),
        new("Nov", 86, 478),
        new("Dec", 87, 523),
        new("Jan", 89, 491),
        new("Feb", 88, 456),
        new("Mar", 90, 487),
    ];

    private readonly BuyerSegment[] _segments =
    [
        new("First-time buyers",    1024, 1189, 86),
        new("Repeat purchasers",     892,  934, 96),
        new("Gift recipients",       341,  378, 90),
        new("Enterprise accounts",   305,  346, 88),
    ];

    private readonly int[] _gridLines = [25, 50, 75];

    private const double _ringRadius = 52;
    private readonly double _ringCircumference = 2 * Math.PI * 52;
    private double _rateOffset => _ringCircumference - (90.0 / 100.0) * _ringCircumference;

    private const int _maxRate = 100;
    private const int _sparklineHeight = 48;
    private const int _sparklineWidth = 200;

    private int _minRate => _monthlyTrend.Min(m => m.Rate) - 5;
    private int _rateDelta => _summary.OverallRate - _summary.PreviousRate;

    private double StepX => (double)_sparklineWidth / (_monthlyTrend.Length - 1);

    private string _sparklinePoints
    {
        get
        {
            var parts = new System.Text.StringBuilder();
            for (int i = 0; i < _monthlyTrend.Length; i++)
            {
                var m = _monthlyTrend[i];
                double x = i * StepX;
                double y = _sparklineHeight - ((m.Rate - _minRate) / (double)(_maxRate - _minRate)) * _sparklineHeight;
                if (i > 0) parts.Append(' ');
                parts.Append(FormattableString.Invariant($"{x:F4},{y:F4}"));
            }
            return parts.ToString();
        }
    }

    private record SparklineEntry(int Index, double X, double Y);

    private SparklineEntry[] _sparklineEntries
    {
        get
        {
            var entries = new SparklineEntry[_monthlyTrend.Length];
            for (int i = 0; i < _monthlyTrend.Length; i++)
            {
                double x = i * StepX;
                double y = _sparklineHeight - ((_monthlyTrend[i].Rate - _minRate) / (double)(_maxRate - _minRate)) * _sparklineHeight;
                entries[i] = new SparklineEntry(i, x, y);
            }
            return entries;
        }
    }

    private int? _hoveredMonth;

    private static string RateColor(int rate)
    {
        if (rate >= 90) return "text-emerald-600 dark:text-emerald-400";
        if (rate >= 75) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string StrokeColor(int rate)
    {
        if (rate >= 90) return "stroke-emerald-500";
        if (rate >= 75) return "stroke-amber-500";
        return "stroke-red-500";
    }

    private static string BarColor(int rate)
    {
        if (rate >= 90) return "bg-emerald-500";
        if (rate >= 75) return "bg-amber-500";
        return "bg-red-500";
    }
}
