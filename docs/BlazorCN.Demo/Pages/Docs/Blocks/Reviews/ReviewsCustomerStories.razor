@* ============================================================
   Block: reviews-customer-stories
   Title: ReviewsCustomerStories
   Description: A customer stories block for React and Next.js with before-after metrics, quote highlights, company logos, and staggered card stack layout built with shadcn/ui Avatar, Badge, Button components and Tailwind CSS
   Source: original/blocks/reviews/reviews-customer-stories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-3">
        @foreach (var story in _stories)
        {
            var isExpanded = _expandedId == story.Id;

            <div class="overflow-hidden rounded-lg border bg-card">
                @* Pull quote highlight *@
                <div class="border-b bg-muted/30 px-4 py-3">
                    <div class="flex gap-2">
                        <LucideIconCn Name="quote" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/50" />
                        <p class="text-sm italic leading-relaxed text-foreground/80">
                            @story.PullQuote
                        </p>
                    </div>
                </div>

                @* Author and company row *@
                <button type="button"
                        @onclick="@(() => ToggleExpanded(story.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <AvatarCn Class="size-9 shrink-0">
                        <AvatarFallbackCn Class="text-xs">@story.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@story.Author</span>
                            <div class="flex items-center gap-0.5">
                                @for (var si = 0; si < 5; si++)
                                {
                                    var i = si;
                                    <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", i < story.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                }
                            </div>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span>@story.Role, @story.Company</span>
                        </div>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <div class="hidden items-center gap-1 text-xs text-muted-foreground sm:flex">
                            <LucideIconCn Name="building" Size="12" Class="size-3" />
                            <span>@story.Industry</span>
                        </div>
                        <div class="@(isExpanded ? "rotate-180" : "") transition-transform duration-200">
                            <LucideIconCn Name="chevron-down" Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                    </div>
                </button>

                @* Expanded content *@
                @if (isExpanded)
                {
                    <div class="overflow-hidden">
                        <div class="border-t px-4 pb-4 pt-3">
                            @* Company context *@
                            <div class="mb-3 flex items-center gap-3">
                                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    <span>@story.CompanySize</span>
                                </div>
                                <span class="text-muted-foreground/30">|</span>
                                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <LucideIconCn Name="building" Size="12" Class="size-3" />
                                    <span>@story.Industry</span>
                                </div>
                                <span class="ml-auto text-xs text-muted-foreground">@story.Date</span>
                            </div>

                            @* Narrative *@
                            <p class="mb-4 text-sm leading-relaxed text-muted-foreground">
                                @story.Narrative
                            </p>

                            @* Before/After metrics *@
                            <div class="mb-3 grid grid-cols-3 gap-2">
                                @foreach (var metric in story.Metrics)
                                {
                                    <div class="rounded-md border bg-muted/30 p-2.5">
                                        <span class="block text-[10px] font-medium uppercase tracking-wide text-muted-foreground">
                                            @metric.Label
                                        </span>
                                        <div class="mt-1.5 flex items-center gap-1">
                                            <span class="text-xs text-muted-foreground line-through">
                                                @metric.Before
                                            </span>
                                            @if (metric.Improved)
                                            {
                                                <LucideIconCn Name="arrow-down" Size="10" Class="size-2.5 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="arrow-up" Size="10" Class="size-2.5 text-red-500" />
                                            }
                                        </div>
                                        <span class="mt-0.5 block text-sm font-semibold tabular-nums">
                                            @metric.After
                                            @if (!string.IsNullOrEmpty(metric.Unit))
                                            {
                                                <span class="ml-0.5 text-xs font-normal text-muted-foreground">@metric.Unit</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>

                            @* Tags *@
                            <div class="flex items-center gap-1.5">
                                @foreach (var tag in story.Tags)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@tag</BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Metric(string Label, string Before, string After, string Unit, bool Improved);

    private record CustomerStory(
        string Id,
        string Author,
        string Initials,
        string Role,
        string Company,
        string CompanySize,
        string Industry,
        int Rating,
        string Date,
        string PullQuote,
        string Narrative,
        Metric[] Metrics,
        string[] Tags
    );

    private static readonly CustomerStory[] _stories =
    [
        new CustomerStory(
            "s1",
            "Sarah Chen",
            "SC",
            "VP of Engineering",
            "Veritas Labs",
            "120 employees",
            "Developer Tools",
            5,
            "Mar 15, 2026",
            "We went from 6-week sprints to 3-day launches. The ROI was measurable within the first month.",
            "Our team of eight engineers was spending 40% of each sprint building internal UI components. After migrating in stages over two weeks, the TypeScript types caught integration issues early and the Tailwind theming matched our brand tokens without modification. Engineering now focuses entirely on business logic.",
            [
                new Metric("Sprint cycle", "6 weeks", "3 days", "", true),
                new Metric("Design consistency", "62%", "94%", "", true),
                new Metric("Dev time on UI", "40%", "8%", "", true),
            ],
            ["Enterprise", "Migration", "Engineering"]
        ),
        new CustomerStory(
            "s2",
            "Marcus Johnson",
            "MJ",
            "Founder & CEO",
            "Relay",
            "3 employees",
            "SaaS",
            5,
            "Mar 8, 2026",
            "Shipped our MVP in a weekend and had paying customers within 48 hours.",
            "As a solo founder with a backend background, frontend was my bottleneck. I combined hero, pricing, and dashboard blocks with my API. The code was clean enough to customize without understanding the full design system, and the professional look gave instant credibility.",
            [
                new Metric("Time to MVP", "3-4 weeks", "1 weekend", "", true),
                new Metric("First revenue", "45 days", "2 days", "", true),
                new Metric("Frontend cost", "$12,000", "$0", "", true),
            ],
            ["Startup", "Solo founder", "MVP"]
        ),
        new CustomerStory(
            "s3",
            "Priya Patel",
            "PP",
            "Design Lead",
            "Forma Studio",
            "28 employees",
            "Design Agency",
            4,
            "Feb 28, 2026",
            "The component library became our shared language between design and development.",
            "Our design team created pixel-perfect mockups that developers struggled to implement accurately. Every handoff introduced visual regressions. Now designers reference available blocks when creating mockups and developers implement using matching components. The built-in responsive behavior eliminated most mobile-specific bugs.",
            [
                new Metric("Design QA time", "16 hrs/week", "5 hrs/week", "", true),
                new Metric("Visual bugs", "23/sprint", "3/sprint", "", true),
                new Metric("Handoff cycles", "4 rounds", "1 round", "", true),
            ],
            ["Design team", "Agency", "Collaboration"]
        ),
        new CustomerStory(
            "s4",
            "David Kim",
            "DK",
            "CTO",
            "Arclight",
            "340 employees",
            "Enterprise Platform",
            5,
            "Feb 20, 2026",
            "Standardized UI across 12 microservices in 8 weeks instead of the estimated 6 months.",
            "Our platform had 12 separate frontends built by different teams with different component choices. Users noticed the inconsistency and NPS reflected it. The copy-paste model meant no shared dependency version conflicts between services. Each team owned their components while maintaining visual consistency.",
            [
                new Metric("NPS score", "+18", "+41", "pts", true),
                new Metric("Migration time", "6 months est.", "8 weeks", "", true),
                new Metric("UI consistency", "4/12 services", "12/12 services", "", true),
            ],
            ["Enterprise", "Platform", "Microservices"]
        ),
    ];

    private string? _expandedId = "s1";

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }
}
