@* ========================================
   Block: reviews-rating-summary
   Title: Reviews Rating Summary
   Description: Star rating summary component with breakdown bars and review stats for ecommerce product pages
   Dependencies: CardCn, CardContentCn, ProgressCn, LucideStarCn, LucideThumbsUpCn, LucideUsersCn
   Source: original/blocks/reviews/reviews-rating-summary.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Customer Ratings</h1>
    </div>

    <div class="mx-auto w-[600px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Main Score *@
                <div class="mb-6 flex flex-col items-center text-center">
                    <div class="text-6xl font-bold">@_average</div>
                    <div class="mt-2 flex items-center gap-0.5">
                        @for (int star = 1; star <= 5; star++)
                        {
                            <LucideStarCn Size="20" Class="@(star <= (int)Math.Round(_average) ? "fill-primary text-primary" : "fill-muted text-muted")" />
                        }
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground">
                        @_total.ToString("N0") reviews
                    </p>
                </div>

                @* Rating Breakdown *@
                <div class="mb-6 space-y-2">
                    @foreach (var item in _breakdown)
                    {
                        <button type="button" class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-muted", _selectedRating == item.Stars ? "bg-muted" : "")" @onclick="() => _selectedRating = _selectedRating == item.Stars ? null : item.Stars">
                            <div class="flex w-16 items-center gap-1">
                                <span>@item.Stars</span>
                                <LucideStarCn Size="12" Class="fill-primary text-primary" />
                            </div>
                            <ProgressCn Class="h-2 flex-1" Value="@item.Percentage" />
                            <span class="w-12 text-right text-muted-foreground">@(item.Percentage)%</span>
                        </button>
                    }
                </div>

                @* Stats *@
                <div class="grid grid-cols-2 gap-4 border-t pt-4">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full border">
                            <LucideThumbsUpCn Size="16" />
                        </div>
                        <div>
                            <p class="text-lg font-semibold">@(_recommendation)%</p>
                            <p class="text-xs text-muted-foreground">Recommend</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full border">
                            <LucideUsersCn Size="16" />
                        </div>
                        <div>
                            <p class="text-lg font-semibold">@_total.ToString("N0")</p>
                            <p class="text-xs text-muted-foreground">Reviewers</p>
                        </div>
                    </div>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record BreakdownItem(int Stars, int Count, int Percentage);

    private int? _selectedRating;
    private const double _average = 4.7;
    private const int _total = 2847;
    private const int _recommendation = 94;

    private readonly BreakdownItem[] _breakdown =
    [
        new(5, 1892, 66),
        new(4, 626, 22),
        new(3, 199, 7),
        new(2, 85, 3),
        new(1, 45, 2),
    ];
}
