@* ============================================================
   Block: reviews-testimonial-slider
   Title: ReviewsTestimonialSlider
   Description: A premium testimonial slider for React and Next.js with animated slide transitions, large quote typography, author photos, company branding, star ratings, and keyboard-navigable arrows built with shadcn/ui Button and Tailwind CSS.
   Source: original/blocks/reviews/reviews-testimonial-slider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card" @onkeydown="HandleKeyDown" tabindex="0">
        @* Quote area *@
        <div class="relative min-h-[280px] px-6 pt-8 pb-6">
            <LucideIconCn Name="quote" Size="32" Class="absolute top-6 left-6 size-8 text-muted-foreground/10" />

            <div class="relative z-10">
                <p class="text-sm leading-[1.8] tracking-wide">@_current.Quote</p>

                @* Stars *@
                <div class="mt-5 flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", idx < _current.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                    }
                    <span class="ml-2 text-[10px] text-muted-foreground">@_current.Industry</span>
                </div>
            </div>
        </div>

        @* Author + navigation *@
        <div class="flex items-center justify-between border-t px-6 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @_current.Initials
                </div>
                <div>
                    <span class="text-sm font-medium">@_current.Author</span>
                    <p class="text-xs text-muted-foreground">
                        @_current.Role, @_current.Company
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-1.5">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0" aria-label="Previous testimonial" @onclick="@(() => Navigate(-1))">
                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0" aria-label="Next testimonial" @onclick="@(() => Navigate(1))">
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Dot navigation + counter *@
        <div class="flex items-center justify-between border-t px-6 py-3">
            <div class="flex items-center gap-0.5">
                @for (int i = 0; i < _testimonials.Length; i++)
                {
                    var dotIndex = i;
                    <button
                        type="button"
                        @onclick="@(() => GoToSlide(dotIndex))"
                        aria-label="@($"Go to slide {dotIndex + 1}")"
                        class="inline-flex size-6 items-center justify-center">
                        <span class="@Cn.Merge("h-1 rounded-full transition-all duration-300", dotIndex == _activeIndex ? "w-6 bg-foreground" : "w-1.5 bg-foreground/15 hover:bg-foreground/30")"></span>
                    </button>
                }
            </div>
            <span class="text-xs text-muted-foreground tabular-nums">
                @(_activeIndex + 1) of @_testimonials.Length
            </span>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Quote, string Author, string Role, string Company, string Initials, int Rating, string Industry);

    private int _activeIndex = 0;
    private Testimonial _current => _testimonials[_activeIndex];

    private void Navigate(int direction)
    {
        if (direction > 0)
            _activeIndex = _activeIndex == _testimonials.Length - 1 ? 0 : _activeIndex + 1;
        else
            _activeIndex = _activeIndex == 0 ? _testimonials.Length - 1 : _activeIndex - 1;
    }

    private void GoToSlide(int index) => _activeIndex = index;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft") Navigate(-1);
        if (e.Key == "ArrowRight") Navigate(1);
    }

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "We migrated our entire design system in under a week. The TypeScript types caught three integration bugs during the transition that would have shipped to production. Our frontend velocity increased measurably within the first sprint.", "Sarah Chen", "VP of Engineering", "Nextera Labs", "SC", 5, "Developer Tools"),
        new("t2", "The accessibility defaults alone justified the investment. We passed two SOC 2 compliance audits without writing a single aria attribute manually. Our design team prototypes in hours instead of days now.", "Marcus Rivera", "Head of Product", "Cloudwise", "MR", 5, "Cloud Infrastructure"),
        new("t3", "I benchmarked six component libraries against our performance budget. This was the only one that stayed under 45kb gzipped while providing the full component set. The tree-shaking is genuinely excellent.", "Priya Sharma", "Senior Developer", "Stackline", "PS", 5, "SaaS Platform"),
        new("t4", "Our enterprise clients started complimenting the UI polish unprompted. The spacing system and color tokens produce consistent results across twelve different product surfaces without any custom overrides.", "David Park", "Design Lead", "Forge Studio", "DP", 4, "Design Agency"),
        new("t5", "From patient onboarding flows to real-time monitoring dashboards, every use case we implemented was handled without workarounds. The composable API meant our domain-specific components inherited all the accessibility work for free.", "Elena Vasquez", "CTO", "Meridian Health", "EV", 5, "Healthcare Technology"),
    ];
}
