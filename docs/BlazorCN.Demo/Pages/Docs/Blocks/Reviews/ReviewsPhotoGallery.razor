@* ========================================
   Block: reviews-photo-gallery
   Title: Reviews Photo Gallery
   Description: Photo review gallery with lightbox viewer and customer images for ecommerce product pages
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, LucideChevronLeftCn, LucideChevronRightCn, LucideStarCn
   Source: original/blocks/reviews/reviews-photo-gallery.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Photo Reviews</h1>
        <p class="mt-2 text-sm text-muted-foreground">See how customers use our products</p>
    </div>

    <div class="mx-auto w-[900px] max-w-full">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            @for (int i = 0; i < _reviews.Length; i++)
            {
                var review = _reviews[i];
                var index = i;
                <button type="button" class="group relative aspect-square overflow-hidden rounded-lg" @onclick="() => _selectedIndex = index">
                    <img alt="@($"Review by {review.AuthorName}")" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" height="600" src="@review.Image" width="600" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
                    <div class="absolute inset-x-0 bottom-0 p-3 opacity-0 transition-opacity group-hover:opacity-100">
                        <div class="flex items-center gap-1">
                            @for (int star = 1; star <= 5; star++)
                            {
                                <LucideStarCn Size="12" Class="@(star <= review.Rating ? "fill-white text-white" : "fill-white/30 text-white/30")" />
                            }
                        </div>
                        <p class="mt-1 text-left text-sm font-medium text-white line-clamp-1">@review.Snippet</p>
                    </div>
                </button>
            }
        </div>
    </div>

    <DialogCn Open="@(_selectedIndex.HasValue)" OpenChanged="v => { if (!v) _selectedIndex = null; }">
        <DialogContentCn Class="max-w-3xl gap-0 overflow-hidden p-0">
            <DialogHeaderCn Class="sr-only">
                <DialogTitleCn>Photo Review</DialogTitleCn>
                <DialogDescriptionCn>Customer photo review details</DialogDescriptionCn>
            </DialogHeaderCn>

            @if (SelectedReview is not null)
            {
                <div class="grid md:grid-cols-2">
                    <div class="relative aspect-square bg-muted">
                        <img alt="@($"Review by {SelectedReview.AuthorName}")" class="h-full w-full object-cover" height="800" src="@SelectedReview.Image" width="800" />
                        <ButtonCn Class="absolute left-3 top-1/2 h-8 w-8 -translate-y-1/2" Size="ButtonSize.Icon" Variant="ButtonVariant.Secondary" @onclick="() => Navigate(-1)">
                            <LucideChevronLeftCn Size="16" />
                        </ButtonCn>
                        <ButtonCn Class="absolute right-3 top-1/2 h-8 w-8 -translate-y-1/2" Size="ButtonSize.Icon" Variant="ButtonVariant.Secondary" @onclick="() => Navigate(1)">
                            <LucideChevronRightCn Size="16" />
                        </ButtonCn>
                    </div>

                    <div class="flex flex-col p-6">
                        <div class="flex items-center gap-3">
                            <AvatarCn Class="h-10 w-10">
                                <AvatarImageCn Alt="@SelectedReview.AuthorName" Src="@SelectedReview.AuthorAvatar" />
                                <AvatarFallbackCn>@GetInitials(SelectedReview.AuthorName)</AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class="font-medium">@SelectedReview.AuthorName</p>
                                <p class="text-sm text-muted-foreground">@SelectedReview.Date</p>
                            </div>
                        </div>

                        <div class="mt-4 flex items-center gap-1">
                            @for (int star = 1; star <= 5; star++)
                            {
                                <LucideStarCn Size="16" Class="@(star <= SelectedReview.Rating ? "fill-primary text-primary" : "fill-muted text-muted-foreground")" />
                            }
                        </div>

                        <p class="mt-4 text-sm text-muted-foreground">@SelectedReview.FullReview</p>
                    </div>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private record PhotoReview(int Id, string Image, string AuthorName, string AuthorAvatar, int Rating, string Snippet, string FullReview, string Date);

    private int? _selectedIndex;

    private PhotoReview? SelectedReview => _selectedIndex.HasValue ? _reviews[_selectedIndex.Value] : null;

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private void Navigate(int direction)
    {
        if (!_selectedIndex.HasValue) return;
        _selectedIndex = ((_selectedIndex.Value + direction) % _reviews.Length + _reviews.Length) % _reviews.Length;
    }

    private readonly PhotoReview[] _reviews =
    [
        new(1, "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&w=400&q=80", "Emma Wilson", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80", 5, "Perfect for everyday use!", "Perfect for everyday use! The quality exceeded my expectations. The materials feel premium and the design is both functional and stylish.", "Dec 4, 2024"),
        new(2, "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&w=400&q=80", "James Chen", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80", 5, "Amazing sound quality", "Amazing sound quality and the noise cancellation is incredible. Battery life lasts all day. Best headphones I've ever owned.", "Dec 3, 2024"),
        new(3, "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&w=400&q=80", "Sophie Brown", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&w=100&q=80", 4, "Great backpack for travel", "Great backpack for travel. Fits my laptop perfectly and has plenty of pockets for organization. Wish it had a water bottle holder.", "Dec 2, 2024"),
        new(4, "https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&w=400&q=80", "Michael Park", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&w=100&q=80", 5, "Love the minimalist design", "Love the minimalist design and the health tracking features are accurate. The battery lasts almost a week. Great value!", "Dec 1, 2024"),
        new(5, "https://images.unsplash.com/photo-1585386959984-a4155224a1ad?auto=format&w=400&q=80", "Olivia Davis", "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&w=100&q=80", 5, "Beautiful and functional", "Beautiful and functional! These products look exactly like the photos. The quality is restaurant-grade. Will be ordering more.", "Nov 30, 2024"),
        new(6, "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&w=400&q=80", "David Kim", "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&w=100&q=80", 4, "Solid build quality", "Solid build quality and the color is exactly as shown. Shipping was fast. Very happy with this purchase overall.", "Nov 29, 2024"),
    ];
}
