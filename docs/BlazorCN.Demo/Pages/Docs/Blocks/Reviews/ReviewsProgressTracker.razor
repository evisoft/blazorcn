@* ============================================================
   Block: reviews-progress-tracker
   Title: ReviewsProgressTracker
   Description: A React review collection progress dashboard for Next.js with animated goal tracking, milestone timeline, weekly velocity chart, and gamified badges using shadcn/ui Progress, Badge, Button and Tailwind CSS
   Source: original/blocks/reviews/reviews-progress-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Review Collection</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_progressPercent% to goal
                </BadgeCn>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="mail" Size="12" Class="size-3" />
                Send Requests
            </ButtonCn>
        </div>

        @* Two-column body *@
        <div class="grid grid-cols-1 sm:grid-cols-2 sm:divide-x">
            @* Left column: Progress + Stats *@
            <div>
                @* Main progress *@
                <div class="border-b px-4 py-4">
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-2xl font-semibold tabular-nums">@_currentCount</span>
                        <span class="text-sm text-muted-foreground">/ @_goalCount reviews</span>
                    </div>
                    <ProgressCn Value="@_progressPercent" Class="mt-3 h-2" aria-label="Progress" />
                    <div class="mt-2 flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">
                            @_remaining more to reach your goal
                        </span>
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                            <span class="tabular-nums">@_weeklyAvg/wk</span>
                        </div>
                    </div>
                </div>

                @* Stats grid *@
                <div class="grid grid-cols-3 divide-x border-b">
                    <div class="px-3 py-3 text-center">
                        <div class="flex items-center justify-center gap-1">
                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                            <span class="text-sm font-semibold tabular-nums">@_avgRating</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground">Avg Rating</span>
                    </div>
                    <div class="px-3 py-3 text-center">
                        <span class="text-sm font-semibold tabular-nums">@_responseRate%</span>
                        <span class="block text-[10px] text-muted-foreground">Response Rate</span>
                    </div>
                    <div class="px-3 py-3 text-center">
                        <span class="text-sm font-semibold tabular-nums">@_weeklyAvg</span>
                        <span class="block text-[10px] text-muted-foreground">Weekly Avg</span>
                    </div>
                </div>

                @* Achievement Badges *@
                <div class="px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Achievements</span>
                    <div class="mt-2 flex gap-2">
                        @foreach (var badge in _badges)
                        {
                            <div class="@Cn.Merge("flex flex-col items-center gap-1 rounded-md px-2.5 py-2", badge.Earned ? "bg-muted/50" : "bg-muted/20 opacity-40")">
                                <LucideIconCn Name="@badge.IconName" Size="16" Class="@Cn.Merge("size-4", badge.Earned ? "text-foreground" : "text-muted-foreground")" />
                                <span class="text-[10px] text-muted-foreground">@badge.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Right column: Milestones or Velocity *@
            <div>
                @* Tab switcher *@
                <div class="flex border-b">
                    <button type="button"
                            @onclick="@(() => _activeTab = "milestones")"
                            class="@Cn.Merge("flex-1 px-3 py-2.5 text-xs font-medium transition-colors", _activeTab == "milestones" ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground")">
                        Milestones
                    </button>
                    <button type="button"
                            @onclick="@(() => _activeTab = "velocity")"
                            class="@Cn.Merge("flex-1 px-3 py-2.5 text-xs font-medium transition-colors", _activeTab == "velocity" ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground")">
                        Velocity
                    </button>
                </div>

                @* Tab content *@
                @if (_activeTab == "milestones")
                {
                    <div class="px-4 py-3">
                        @* Timeline *@
                        <div class="relative ml-2">
                            @* Vertical line *@
                            <div class="absolute left-[7px] top-2 h-[calc(100%-16px)] w-px bg-border"></div>

                            <div class="space-y-3">
                                @for (var i = 0; i < _milestones.Length; i++)
                                {
                                    var idx = i;
                                    var milestone = _milestones[idx];
                                    var isCurrent = !milestone.Reached && (idx == 0 || _milestones[idx - 1].Reached);
                                    <div class="relative flex items-start gap-3 pl-6">
                                        @* Node *@
                                        <div class="absolute left-0 top-0.5">
                                            @if (milestone.Reached)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                                            }
                                            else if (isCurrent)
                                            {
                                                <div class="flex size-4 items-center justify-center">
                                                    <span class="size-2.5 rounded-full border-2 border-blue-500 bg-blue-500/20"></span>
                                                </div>
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="circle" Size="16" Class="size-4 text-muted-foreground/30" />
                                            }
                                        </div>

                                        <div class="flex flex-1 items-center justify-between">
                                            <div>
                                                <span class="@Cn.Merge("text-sm", (milestone.Reached || isCurrent) ? "font-medium text-foreground" : "text-muted-foreground")">
                                                    @milestone.Label
                                                </span>
                                                <span class="ml-1.5 text-xs tabular-nums text-muted-foreground">
                                                    @milestone.Target reviews
                                                </span>
                                            </div>
                                            @if (milestone.Reached)
                                            {
                                                <span class="text-[10px] text-emerald-600">@milestone.Reward</span>
                                            }
                                            @if (isCurrent)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">In progress</BadgeCn>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="px-4 py-3">
                        <span class="text-xs text-muted-foreground">Reviews collected per week</span>
                        <div class="mt-3 flex items-end gap-1.5">
                            @for (var i = 0; i < _weeklyData.Length; i++)
                            {
                                var idx = i;
                                var week = _weeklyData[idx];
                                var barHeight = (int)Math.Round((double)week.Count / _maxWeekly * 100);
                                var isLast = idx == _weeklyData.Length - 1;
                                <div class="flex flex-1 flex-col items-center gap-1">
                                    <span class="text-[10px] tabular-nums text-muted-foreground">@week.Count</span>
                                    <div style="@($"height:{barHeight}px")"
                                         class="@Cn.Merge("w-full rounded-sm", isLast ? "bg-foreground" : "bg-muted-foreground/20")">
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">@week.Label</span>
                                </div>
                            }
                        </div>

                        @* Velocity summary *@
                        <div class="mt-3 flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                            <span class="text-xs text-muted-foreground">Best week</span>
                            <span class="text-xs font-medium tabular-nums">15 reviews (W8)</span>
                        </div>
                        <div class="mt-1.5 flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                            <span class="text-xs text-muted-foreground">Avg per week</span>
                            <span class="text-xs font-medium tabular-nums">@_weeklyAvg reviews</span>
                        </div>
                        <div class="mt-1.5 flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                            <span class="text-xs text-muted-foreground">Est. goal date</span>
                            <span class="text-xs font-medium">~10 weeks</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MilestoneItem(string Id, string Label, int Target, bool Reached, string Reward);
    private record WeeklyItem(string Label, int Count);
    private record BadgeItem(string Id, string IconName, string Label, bool Earned, string Description);

    private const int _currentCount = 73;
    private const int _goalCount = 150;
    private int _progressPercent => (int)Math.Round((double)_currentCount / _goalCount * 100);
    private int _remaining => _goalCount - _currentCount;
    private const double _avgRating = 4.6;
    private const int _responseRate = 34;
    private const int _weeklyAvg = 8;

    private static readonly MilestoneItem[] _milestones =
    [
        new("m1", "Getting Started",    10,  true,  "Bronze Badge"),
        new("m2", "Building Momentum",  25,  true,  "Review Widget"),
        new("m3", "Social Proof",       50,  true,  "Silver Badge"),
        new("m4", "Trusted Brand",      100, false, "Gold Badge"),
        new("m5", "Market Leader",      150, false, "Platinum Badge"),
    ];

    private static readonly WeeklyItem[] _weeklyData =
    [
        new("W1", 5),
        new("W2", 9),
        new("W3", 7),
        new("W4", 12),
        new("W5", 8),
        new("W6", 11),
        new("W7", 6),
        new("W8", 15),
    ];

    private int _maxWeekly => _weeklyData.Max(w => w.Count);

    private static readonly BadgeItem[] _badges =
    [
        new("b1", "star",     "First Review", true,  "Collected your first review"),
        new("b2", "zap",      "Quick Start",  true,  "10 reviews in first week"),
        new("b3", "award",    "High Rated",   true,  "Average rating above 4.5"),
        new("b4", "sparkles", "Century Club", false, "Reach 100 reviews"),
    ];

    private string _activeTab = "milestones";
}
