@* ============================================================
   Block: reviews-verified-purchases
   Title: ReviewsVerifiedPurchases
   Description: A verified purchase review timeline for React and Next.js with order details, trust scores, purchase receipts, and authenticity badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-verified-purchases.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">Verified Purchase Reviews</span>
                <p class="text-xs text-muted-foreground">
                    Every review linked to a confirmed order
                </p>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <span class="block text-xs text-muted-foreground">Avg trust</span>
                    <span class="text-sm font-semibold tabular-nums">@_avgTrust%</span>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div class="text-right">
                    <span class="block text-xs text-muted-foreground">Avg rating</span>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                        <span class="text-sm font-semibold tabular-nums">@_avgRating.ToString("F1")</span>
                    </div>
                </div>
            </div>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
            <span class="text-xs text-muted-foreground">
                @_reviews.Length verified purchases
            </span>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">
                All reviews matched to order records
            </span>
        </div>

        @* Review timeline *@
        <div class="relative">
            @* Timeline line *@
            <div class="absolute left-[29px] top-0 bottom-0 w-px bg-border"></div>

            @foreach (var review in _reviews)
            {
                var tier = GetTierConfig(review.TrustTier);
                var isExpanded = _expandedId == review.Id;
                var isHelped = _helpedIds.Contains(review.Id);
                var isLast = review.Id == _reviews[^1].Id;

                <div class="@Cn.Merge("relative pl-14 pr-4 py-3", isLast ? "" : "border-b")">

                    @* Timeline node *@
                    <div class="absolute left-4 top-4">
                        <AvatarCn Class="relative z-10 size-7 border-2 border-card">
                            <AvatarFallbackCn Class="text-[10px]">@review.AuthorInitials</AvatarFallbackCn>
                        </AvatarCn>
                    </div>

                    @* Review content *@
                    <div>
                        @* Author row *@
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@review.AuthorName</span>
                            <TooltipProviderCn>
                                <TooltipCn>
                                    <TooltipTriggerCn>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("gap-1 text-[10px] font-normal border-0", tier.Bg, tier.Color)">
                                            <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                                            @tier.Label
                                        </BadgeCn>
                                    </TooltipTriggerCn>
                                    <TooltipContentCn Class="max-w-[200px]">
                                        <p class="text-xs font-medium">
                                            Trust score: @review.TrustScore/100
                                        </p>
                                        <ul class="mt-1 space-y-0.5">
                                            @foreach (var factor in review.TrustFactors)
                                            {
                                                <li class="flex items-center gap-1 text-xs text-muted-foreground">
                                                    <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5 text-emerald-500" />
                                                    @factor
                                                </li>
                                            }
                                        </ul>
                                    </TooltipContentCn>
                                </TooltipCn>
                            </TooltipProviderCn>
                            <span class="ml-auto text-xs text-muted-foreground">@review.Date</span>
                        </div>

                        @* Rating + title *@
                        <div class="mt-1.5 flex items-center gap-2">
                            <div class="flex items-center gap-0.5" role="img" aria-label="@($"{review.Rating} out of 5 stars")">
                                @for (int i = 0; i < 5; i++)
                                {
                                    var starIndex = i;
                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < review.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                                }
                            </div>
                            <span class="text-sm font-medium">@review.Title</span>
                        </div>

                        @* Body *@
                        <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                            @review.Body
                        </p>

                        @* Trust score bar *@
                        <div class="mt-2.5 flex items-center gap-2.5">
                            <span class="text-[10px] text-muted-foreground">Trust</span>
                            <ProgressCn Value="@review.TrustScore" Class="h-1 flex-1 max-w-[120px]" />
                            <span class="text-[10px] tabular-nums text-muted-foreground">
                                @review.TrustScore%
                            </span>
                        </div>

                        @* Expandable purchase details *@
                        <div class="mt-2">
                            <button
                                type="button"
                                @onclick="@(() => ToggleExpand(review.Id))"
                                class="flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                                <LucideIconCn Name="package" Size="12" Class="size-3" />
                                <span>Order @review.OrderNumber</span>
                                <LucideIconCn Name="chevron-down" Size="12" Class="@Cn.Merge("size-3 transition-transform duration-200", isExpanded ? "rotate-180" : "")" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="overflow-hidden">
                                    <div class="mt-1.5 rounded-md bg-muted/30 p-3">
                                        <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                                            <div>
                                                <span class="text-[10px] text-muted-foreground">
                                                    Order Number
                                                </span>
                                                <p class="text-xs font-mono">@review.OrderNumber</p>
                                            </div>
                                            <div>
                                                <span class="text-[10px] text-muted-foreground">
                                                    Purchase Date
                                                </span>
                                                <p class="text-xs">@review.PurchaseDate</p>
                                            </div>
                                            <div>
                                                <span class="text-[10px] text-muted-foreground">
                                                    Product Variant
                                                </span>
                                                <p class="text-xs">@review.Variant</p>
                                            </div>
                                            <div>
                                                <span class="text-[10px] text-muted-foreground">
                                                    Payment Method
                                                </span>
                                                <p class="text-xs">@review.PaymentMethod</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Footer actions *@
                        <div class="mt-2 flex items-center gap-3">
                            <button
                                type="button"
                                @onclick="@(() => ToggleHelpful(review.Id))"
                                class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors", isHelped ? "bg-foreground/5 text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                                <LucideIconCn Name="thumbs-up" Size="12" Class="@Cn.Merge("size-3", isHelped ? "fill-current" : "")" />
                                <span class="tabular-nums">
                                    Helpful (@(review.HelpfulCount + (isHelped ? 1 : 0)))
                                </span>
                            </button>
                            @if (review.PhotoCount > 0)
                            {
                                <span class="text-[10px] text-muted-foreground">
                                    @review.PhotoCount photos attached
                                </span>
                            }
                            <span class="text-[10px] text-muted-foreground">
                                @review.ReviewCount reviews &middot; Member since @review.MemberSince
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expandedId = null;
    private readonly HashSet<string> _helpedIds = new();

    private void ToggleExpand(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private void ToggleHelpful(string id)
    {
        if (!_helpedIds.Add(id))
            _helpedIds.Remove(id);
    }

    private record TierConfig(string Label, string Color, string Bg);

    private static TierConfig GetTierConfig(string tier) => tier switch
    {
        "gold" => new TierConfig("Gold Verified", "text-amber-600 dark:text-amber-400", "bg-amber-500/10"),
        "silver" => new TierConfig("Silver Verified", "text-foreground/70", "bg-muted/50"),
        _ => new TierConfig("Verified", "text-muted-foreground", "bg-muted/30"),
    };

    private record VerifiedReview(
        string Id,
        string AuthorName,
        string AuthorInitials,
        int ReviewCount,
        string MemberSince,
        int Rating,
        string Title,
        string Body,
        string Date,
        string OrderNumber,
        string PurchaseDate,
        string Variant,
        string PaymentMethod,
        int TrustScore,
        string TrustTier,
        string[] TrustFactors,
        int HelpfulCount,
        int PhotoCount
    );

    private static readonly VerifiedReview[] _reviews =
    [
        new(
            "vp-1", "Hannah Fischer", "HF", 34, "Sep 2023",
            5, "Exceeded all expectations for daily use",
            "I researched for weeks before committing and this was the right call. Build quality is premium with tight tolerances and no flex. Battery exceeds the claimed 40-hour mark by about 3 hours in my testing. The ANC handles open-office chatter and airplane cabin noise equally well. Setup with my MacBook, iPhone, and Windows desktop was seamless multipoint.",
            "2 days ago",
            "ORD-2026-18472", "Jan 15, 2026", "Midnight Black / Over-Ear", "Visa ending 4821",
            97, "gold",
            ["Verified purchase", "Detailed review", "Active reviewer", "Photo included"],
            42, 3
        ),
        new(
            "vp-2", "Liam Chen", "LC", 12, "Mar 2024",
            4, "Great sound, slightly tight fit initially",
            "Audio quality is superb for the price point. Clarity in the mids is outstanding and bass response is tight without being boomy. My only complaint is clamping force out of the box was a bit much for longer sessions. After a week of wear they loosened up and now they are comfortable for 6+ hours. EQ app works well on both iOS and Android.",
            "5 days ago",
            "ORD-2026-17893", "Jan 8, 2026", "Silver Frost / Over-Ear", "Mastercard ending 7156",
            82, "silver",
            ["Verified purchase", "Detailed review", "Returning customer"],
            18, 0
        ),
        new(
            "vp-3", "Sofia Ruiz", "SR", 67, "Jan 2022",
            5, "Perfect upgrade for remote work setup",
            "Rolled these out to our 12-person distributed team and adoption was instant. The microphone quality on calls is crystal clear with the AI noise removal. Transparency mode sounds natural enough to hold a quick conversation without removing them. We run 4-5 hours of video calls daily and zero complaints from anyone. The carrying case is rigid and travel-friendly.",
            "1 week ago",
            "ORD-2026-16204", "Dec 28, 2025", "Midnight Black / Over-Ear", "Corporate Amex ending 3392",
            95, "gold",
            ["Verified purchase", "Top reviewer", "Detailed review", "Bulk order"],
            63, 5
        ),
        new(
            "vp-4", "Marcus Grant", "MG", 8, "Nov 2024",
            3, "Decent ANC but connectivity needs work",
            "Sound quality and noise cancellation are genuinely good for the price. The problem is Bluetooth stability. Keeps dropping connection with my ThinkPad when I walk more than 3 meters away. Works perfectly with my phone though. Had to use the included 3.5mm cable at my desk which defeats the wireless purpose. Hoping a firmware update addresses this.",
            "2 weeks ago",
            "ORD-2026-15781", "Dec 12, 2025", "Silver Frost / Over-Ear", "PayPal",
            68, "bronze",
            ["Verified purchase", "New reviewer"],
            31, 0
        ),
        new(
            "vp-5", "Yuki Tanaka", "YT", 89, "Jul 2021",
            5, "Best in class after testing five competitors",
            "Tried Sony XM5, Bose QC Ultra, Apple AirPods Max, Sennheiser Momentum 4, and these. Nothing else comes close in the combination of sound signature, ANC effectiveness, comfort, and build quality at this price. The multipoint connection handles switching between laptop and phone without the manual reconnect dance other brands require. Transparent charging case is a nice touch.",
            "3 weeks ago",
            "ORD-2026-14952", "Nov 30, 2025", "Midnight Black / Over-Ear", "Visa ending 9034",
            99, "gold",
            ["Verified purchase", "Top reviewer", "Comparison review", "Photo included"],
            127, 7
        ),
    ];

    private static readonly double _avgRating = _reviews.Sum(r => r.Rating) / (double)_reviews.Length;
    private static readonly int _avgTrust = (int)Math.Round(_reviews.Sum(r => r.TrustScore) / (double)_reviews.Length);
}
