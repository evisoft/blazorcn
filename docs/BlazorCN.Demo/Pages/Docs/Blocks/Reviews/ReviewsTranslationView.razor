@* ============================================================
   Block: reviews-translation-view
   Title: ReviewsTranslationView
   Description: A multilingual review translation view for React and Next.js with split-panel original and translated text, language detection badges, and animated toggle transitions built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/reviews/reviews-translation-view.tsx
   ============================================================ *@

<TooltipProviderCn>
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header with language selector *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    <div class="flex size-7 items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="languages" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div>
                        <span class="text-sm font-medium">Translated Reviews</span>
                        <p class="text-xs text-muted-foreground">
                            @_translatedCount of @_reviews.Length translated to @_langLabels[_targetLang]
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                    <SelectCn Value="@_targetLang" ValueChanged="@((string? v) => SetTargetLang(v))">
                        <SelectTriggerCn Class="h-7 w-[130px] text-xs">
                            <SelectValueCn Placeholder="@_langLabels[_targetLang]" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var lang in _languages)
                            {
                                var langItem = lang;
                                <SelectItemCn Value="@langItem.Code">
                                    <span class="flex items-center gap-2">
                                        <span class="font-mono text-[10px] text-muted-foreground">@langItem.Flag</span>
                                        @langItem.Label
                                    </span>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            @* Reviews list *@
            <div>
                @for (var idx = 0; idx < _reviews.Length; idx++)
                {
                    var review = _reviews[idx];
                    var isLast = idx == _reviews.Length - 1;
                    var isOriginalLang = review.OriginalLang == _targetLang;
                    _expandedOriginals.TryGetValue(review.Id, out var showOriginal);
                    var translation = review.Translations.TryGetValue(_targetLang, out var t) ? t : null;
                    var origFlag = GetFlag(review.OriginalLang);
                    var targetFlag = GetFlag(_targetLang);

                    <div class="@Cn.Merge("px-4 py-4", !isLast ? "border-b" : "")">
                        @* Author row *@
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                    @review.Author.Avatar
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@review.Author.Name</span>
                                        @if (review.Verified)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-0.5 px-1 text-[10px] font-normal">
                                                <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                                Verified
                                            </BadgeCn>
                                        }
                                    </div>
                                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                        <span>@review.Author.Location</span>
                                        <span>-</span>
                                        <span>@review.Date</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-0.5">
                                @for (var si = 0; si < 5; si++)
                                {
                                    var starIdx = si;
                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < review.Rating ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                                }
                            </div>
                        </div>

                        @* Translation panel *@
                        <div class="mt-3">
                            @if (isOriginalLang)
                            {
                                @* Original language matches target -- show single panel *@
                                <div class="rounded-md bg-muted/30 p-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] font-normal">
                                            Original (@_langLabels[review.OriginalLang])
                                        </BadgeCn>
                                    </div>
                                    <p class="text-sm leading-relaxed">@review.OriginalText</p>
                                </div>
                            }
                            else
                            {
                                @* Split panel: translated + original toggle *@
                                var rid = review.Id;
                                <div class="space-y-2">
                                    <div class="rounded-md border p-3">
                                        <div class="mb-2 flex items-center justify-between">
                                            <div class="flex items-center gap-2">
                                                @if (showOriginal)
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] font-normal">
                                                        <span class="mr-1 font-mono text-[9px]">@origFlag</span>
                                                        Original (@_langLabels[review.OriginalLang])
                                                    </BadgeCn>
                                                }
                                                else
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] font-normal">
                                                        <span class="mr-1 font-mono text-[9px]">@origFlag</span>
                                                        @_langLabels[review.OriginalLang]
                                                        <span class="mx-1 text-muted-foreground">-&gt;</span>
                                                        <span class="font-mono text-[9px]">@targetFlag</span>
                                                        @_langLabels[_targetLang]
                                                    </BadgeCn>
                                                    @if (translation != null)
                                                    {
                                                        var conf = translation.Confidence;
                                                        <TooltipCn>
                                                            <TooltipTriggerCn>
                                                                <span class="@Cn.Merge("cursor-default text-[10px] tabular-nums", ConfidenceColor(conf))">
                                                                    @conf% confidence
                                                                </span>
                                                            </TooltipTriggerCn>
                                                            <TooltipContentCn>
                                                                <p class="text-xs">Machine translation confidence score</p>
                                                            </TooltipContentCn>
                                                        </TooltipCn>
                                                    }
                                                }
                                            </div>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 px-1.5 text-[10px] text-muted-foreground" @onclick="@(() => ToggleOriginal(rid))">
                                                @(showOriginal ? "Show Translation" : "Show Original")
                                            </ButtonCn>
                                        </div>
                                        <p class="text-sm leading-relaxed">
                                            @if (showOriginal)
                                            {
                                                @review.OriginalText
                                            }
                                            else
                                            {
                                                @(translation?.Text ?? "")
                                            }
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Footer *@
                        <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                            <span>@review.HelpfulCount found helpful</span>
                            <span>-</span>
                            <span>@review.Author.ReviewCount reviews by this author</span>
                        </div>
                    </div>
                }
            </div>

            @* Footer summary *@
            <div class="flex items-center justify-between border-t px-4 py-2.5">
                <span class="text-xs text-muted-foreground">Translations powered by machine learning</span>
                <div class="flex items-center gap-3">
                    @foreach (var item in _confidenceItems)
                    {
                        <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                            <span class="@Cn.Merge("size-1.5 rounded-full", item.Color)"></span>
                            @item.Label
                        </span>
                    }
                </div>
            </div>
        </div>
    </section>
</TooltipProviderCn>

@code {
    private record ReviewAuthor(string Name, string Avatar, string Location, int ReviewCount);
    private record TranslationData(string Text, int Confidence);
    private record ReviewItem(string Id, ReviewAuthor Author, int Rating, string Date, string OriginalLang, string OriginalText, Dictionary<string, TranslationData> Translations, bool Verified, int HelpfulCount);
    private record LanguageItem(string Code, string Label, string Flag, string NativeName);
    private record ConfidenceItem(string Label, string Color);

