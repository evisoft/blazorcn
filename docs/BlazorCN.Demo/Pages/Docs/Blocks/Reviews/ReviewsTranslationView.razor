    private static readonly ConfidenceItem[] _confidenceItems =
    [
        new("High confidence", "bg-emerald-500"),
        new("Medium confidence", "bg-blue-500"),
        new("Low confidence", "bg-amber-500"),
    ];

    private string _targetLang = "en";
    private readonly Dictionary<string, bool> _expandedOriginals = new();

    private int _translatedCount => Array.FindAll(_reviews, r => r.OriginalLang != _targetLang).Length;

    private void SetTargetLang(string? lang)
    {
        if (lang is not null) _targetLang = lang;
    }

    private void ToggleOriginal(string id)
    {
        _expandedOriginals.TryGetValue(id, out var current);
        _expandedOriginals[id] = !current;
    }

    private string GetFlag(string code)
    {
        foreach (var lang in _languages)
        {
            if (lang.Code == code) return lang.Flag;
        }
        return code.ToUpperInvariant();
    }

    private static string ConfidenceColor(int score)
    {
        if (score >= 95) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 85) return "text-blue-600 dark:text-blue-400";
        return "text-amber-600 dark:text-amber-400";
    }
}
