@* ============================================================
   Block: reviews-compact-list
   Title: ReviewsCompactList
   Description: A dense scannable review list block for React and Next.js with inline ratings, helpful vote counts, verified badges, and sort controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-compact-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with stats + sort *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                    <span class="text-sm font-medium tabular-nums">@_avgRating</span>
                </div>
                <span class="text-xs text-muted-foreground/40">|</span>
                <span class="text-xs tabular-nums text-muted-foreground">
                    @_reviews.Length reviews
                </span>
                <span class="text-xs text-muted-foreground/40">|</span>
                <span class="text-xs tabular-nums text-muted-foreground">
                    @_verifiedCount verified
                </span>
            </div>
            <SelectCn Value="@_sortBy" ValueChanged="@((string v) => SetSort(v))">
                <SelectTriggerCn Class="h-7 w-[140px] border-0 bg-transparent text-xs shadow-none">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var opt in _sortOptions)
                    {
                        <SelectItemCn Value="@opt.Value" Class="text-xs">@opt.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Review rows *@
        <div class="divide-y">
            @foreach (var review in SortedReviews)
            {
                var hasVoted = _votedReviews.Contains(review.Id);
                var reviewId = review.Id;
                <article class="px-4 py-3">
                    @* Row 1: Meta line *@
                    <div class="flex items-center gap-2">
                        @* Stars *@
                        <div class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                var starIndex = i;
                                <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < review.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/20")" />
                            }
                        </div>

                        <span class="text-xs font-medium">@review.Author</span>

                        @if (review.Verified)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">Verified</BadgeCn>
                        }

                        <span class="text-[10px] text-muted-foreground">@review.PurchaseType</span>

                        <span class="ml-auto text-[10px] tabular-nums text-muted-foreground">
                            @review.Date
                        </span>
                    </div>

                    @* Row 2: Review text *@
                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                        @review.Text
                    </p>

                    @* Row 3: Helpful vote *@
                    <div class="mt-2 flex items-center gap-1">
                        <button
                            type="button"
                            @onclick="@(() => HandleVote(reviewId))"
                            class="@Cn.Merge("flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] transition-colors", hasVoted ? "bg-foreground/5 text-foreground" : "text-muted-foreground/60 hover:bg-muted/50 hover:text-muted-foreground")">
                            <LucideIconCn Name="thumbs-up" Size="10" Class="@Cn.Merge("size-2.5", hasVoted ? "fill-current" : "")" />
                            <span class="tabular-nums">@(review.Helpful + (hasVoted ? 1 : 0))</span>
                        </button>
                        <span class="text-[10px] text-muted-foreground/40">found this helpful</span>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    private record Review(string Id, string Author, int Rating, string Date, string Text, int Helpful, bool Verified, string PurchaseType);
    private record SortOption(string Value, string Label);

    private static readonly Review[] _reviews =
    [
        new("r1", "Alex Morgan", 5, "Mar 28, 2026", "Best developer tool I have used this year. Incredible performance and the API design is exactly what you would expect from a mature product. Integration with our CI pipeline took less than an hour.", 41, true, "Team Plan"),
        new("r2", "Sophie Laurent", 5, "Mar 22, 2026", "Replaced three separate tools in our stack. The unified approach eliminates context switching and the consistent API makes onboarding new team members straightforward. Productivity improvements within the first week.", 28, true, "Enterprise"),
        new("r3", "Daniel Reeves", 4, "Mar 15, 2026", "Solid product with regular updates. The core features work flawlessly. Would love better custom plugin support and a community marketplace for extensions. Existing plugin system works but could be more flexible.", 15, false, "Pro Plan"),
        new("r4", "Nina Patel", 5, "Mar 8, 2026", "Customer support alone justifies the price. Got a response within thirty minutes on a complex configuration issue. The engineer clearly understood the product and provided a solution that improved our overall setup.", 33, true, "Team Plan"),
        new("r5", "Ethan Brooks", 3, "Feb 28, 2026", "Good for standard use cases but limited for our niche industry requirements. Needed significant workarounds. The team was responsive to feature requests though, so I am optimistic about future updates.", 9, true, "Pro Plan"),
        new("r6", "Mia Chang", 4, "Feb 20, 2026", "Clean interface and thoughtful defaults saved us hours of configuration. Migration from our previous solution was accurate and the import tool handled our dataset of fifty thousand records without issues.", 22, false, "Enterprise"),
        new("r7", "Oliver Grant", 5, "Feb 12, 2026", "Running in production serving ten million requests per day with zero downtime in six months. Performance characteristics are outstanding and the monitoring dashboard gives full visibility into system health.", 56, true, "Enterprise"),
        new("r8", "Lena Kowalski", 4, "Feb 5, 2026", "Great documentation and the TypeScript types are comprehensive. Every edge case we ran into was covered in the docs. The only gap is the webhook configuration section which could use more examples.", 18, true, "Team Plan"),
    ];

    private static readonly SortOption[] _sortOptions =
    [
        new("helpful", "Most helpful"),
        new("recent", "Most recent"),
        new("highest", "Highest rated"),
        new("lowest", "Lowest rated"),
    ];

    private static readonly string _avgRating = (_reviews.Sum(r => r.Rating) / (double)_reviews.Length).ToString("F1");
    private static readonly int _verifiedCount = _reviews.Count(r => r.Verified);

    private string _sortBy = "helpful";
    private readonly HashSet<string> _votedReviews = new();

    private Review[] SortedReviews => _sortBy switch
    {
        "helpful" => _reviews.OrderByDescending(r => r.Helpful).ToArray(),
        "recent" => _reviews.ToArray(),
        "highest" => _reviews.OrderByDescending(r => r.Rating).ThenByDescending(r => r.Helpful).ToArray(),
        "lowest" => _reviews.OrderBy(r => r.Rating).ThenByDescending(r => r.Helpful).ToArray(),
        _ => _reviews.ToArray(),
    };

    private void SetSort(string value) => _sortBy = value;

    private void HandleVote(string reviewId)
    {
        if (_votedReviews.Contains(reviewId))
            _votedReviews.Remove(reviewId);
        else
            _votedReviews.Add(reviewId);
    }
}
