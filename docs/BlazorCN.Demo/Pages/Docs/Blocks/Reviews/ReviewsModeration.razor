@* ========================================
   Block: reviews-moderation
   Title: Reviews Moderation
   Description: Review moderation queue component with bulk actions for React admin dashboards and seller portals
   Long Description: Compact review list component with filtering and sorting for React admin dashboards
   Dependencies: LucideCheckCn, LucideFlagCn, LucideMoreHorizontalCn, LucideStarCn, LucideTrash2Cn, LucideXCn
   Source: original/blocks/reviews/reviews-moderation.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Review Moderation</h1>
        <p class="mt-2 text-muted-foreground">@_reviews.Count reviews pending approval</p>
    </div>

    <div class="mx-auto w-[700px] max-w-full space-y-4">
        @* Bulk Actions Bar *@
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <CheckboxCn aria-label="Select all reviews"
                            Checked="@(_selected.Count == _reviews.Count && _reviews.Count > 0)"
                            CheckedChanged="@((bool _) => ToggleSelectAll())" />
                <span class="text-sm text-muted-foreground">
                    @(_selected.Count > 0 ? $"{_selected.Count} selected" : "Select reviews")
                </span>
            </div>
            @if (_selected.Count > 0)
            {
                <div class="flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                              @onclick="@(() => HandleBulkAction("approve"))">
                        <LucideCheckCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                        Approve
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                              @onclick="@(() => HandleBulkAction("reject"))">
                        <LucideXCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                        Reject
                    </ButtonCn>
                </div>
            }
        </div>

        <SeparatorCn />

        @* Review List *@
        @if (_reviews.Count == 0)
        {
            <CardCn>
                <CardContentCn Class="flex flex-col items-center justify-center py-12 text-center">
                    <LucideCheckCn Class="h-10 w-10 text-muted-foreground" Size="40" />
                    <h3 class="mt-4 font-medium">All caught up</h3>
                    <p class="mt-1 text-sm text-muted-foreground">No reviews pending moderation</p>
                </CardContentCn>
            </CardCn>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var review in _reviews)
                {
                    <CardCn>
                        <CardContentCn Class="p-4">
                            <div class="flex gap-4">
                                @* Checkbox *@
                                <div class="flex items-start pt-1">
                                    <CheckboxCn aria-label="@($"Select review by {review.AuthorName}")"
                                                Checked="@_selected.Contains(review.Id)"
                                                CheckedChanged="@((bool _) => ToggleSelect(review.Id))" />
                                </div>

                                @* Content *@
                                <div class="flex-1 space-y-3">
                                    @* Header *@
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="flex items-center gap-3">
                                            <AvatarCn Class="h-9 w-9">
                                                <AvatarImageCn Alt="@review.AuthorName" Src="@review.AuthorAvatar" />
                                                <AvatarFallbackCn>@review.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <span class="font-medium">@review.AuthorName</span>
                                                    @if (review.IsVerified)
                                                    {
                                                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Verified</BadgeCn>
                                                    }
                                                </div>
                                                <p class="text-xs text-muted-foreground">@review.AuthorEmail</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1 text-sm">
                                            <LucideStarCn Class="h-4 w-4 fill-primary text-primary" Size="16" />
                                            <span class="font-medium">@review.Rating</span>
                                        </div>
                                    </div>

                                    @* Review Content *@
                                    <div>
                                        <p class="font-medium">@review.Title</p>
                                        <p class="mt-1 text-sm text-muted-foreground line-clamp-2">
                                            @review.Content
                                        </p>
                                    </div>

                                    @* Footer *@
                                    <div class="flex items-center justify-between">
                                        <p class="text-xs text-muted-foreground">
                                            @review.Product · @review.SubmittedAt
                                        </p>
                                        <div class="flex items-center gap-1">
                                            <ButtonCn Class="h-8 px-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                                      @onclick="@(() => HandleAction(review.Id, "approve"))">
                                                <LucideCheckCn Class="mr-1 h-3.5 w-3.5" Size="14" />
                                                Approve
                                            </ButtonCn>
                                            <ButtonCn Class="h-8 px-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                                      @onclick="@(() => HandleAction(review.Id, "reject"))">
                                                <LucideXCn Class="mr-1 h-3.5 w-3.5" Size="14" />
                                                Reject
                                            </ButtonCn>
                                            <DropdownMenuCn>
                                                <DropdownMenuTriggerCn>
                                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                                        <LucideMoreHorizontalCn Class="h-4 w-4" Size="16" />
                                                        <span class="sr-only">More options</span>
                                                    </ButtonCn>
                                                </DropdownMenuTriggerCn>
                                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                                    <DropdownMenuItemCn OnClick="@(() => HandleAction(review.Id, "flag"))">
                                                        <LucideFlagCn Class="mr-2 h-4 w-4" Size="16" />
                                                        Flag for review
                                                    </DropdownMenuItemCn>
                                                    <DropdownMenuSeparatorCn />
                                                    <DropdownMenuItemCn Class="text-destructive">
                                                        <LucideTrash2Cn Class="mr-2 h-4 w-4" Size="16" />
                                                        Delete permanently
                                                    </DropdownMenuItemCn>
                                                </DropdownMenuContentCn>
                                            </DropdownMenuCn>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </CardContentCn>
                    </CardCn>
                }
            </div>
        }
    </div>
</section>

@code {
    private class PendingReview
    {
        public string Id { get; set; } = "";
        public string AuthorName { get; set; } = "";
        public string AuthorEmail { get; set; } = "";
        public string AuthorAvatar { get; set; } = "";
        public string Initials { get; set; } = "";
        public bool IsVerified { get; set; }
        public int Rating { get; set; }
        public string Title { get; set; } = "";
        public string Content { get; set; } = "";
        public string Product { get; set; } = "";
        public string SubmittedAt { get; set; } = "";
    }

    private List<PendingReview> _reviews = new()
    {
        new() { Id = "1", AuthorName = "Sarah Chen", AuthorEmail = "sarah.chen@@email.com", AuthorAvatar = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80", Initials = "SC", IsVerified = true, Rating = 5, Title = "Exceeded my expectations", Content = "I've been using this for two weeks now and I'm impressed with the build quality. The attention to detail is remarkable. Shipping was fast and the packaging was secure.", Product = "Wireless Earbuds Pro", SubmittedAt = "2 hours ago" },
        new() { Id = "2", AuthorName = "Mike Johnson", AuthorEmail = "m.johnson@@email.com", AuthorAvatar = "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80", Initials = "MJ", IsVerified = false, Rating = 2, Title = "Not worth the price", Content = "Product arrived late and was damaged. Customer support took forever to respond. Very disappointed with this purchase. Would not recommend to anyone looking for quality.", Product = "Smart Watch Elite", SubmittedAt = "5 hours ago" },
        new() { Id = "3", AuthorName = "Emma Wilson", AuthorEmail = "emma.w@@email.com", AuthorAvatar = "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&w=100&q=80", Initials = "EW", IsVerified = true, Rating = 4, Title = "Great product, minor issues", Content = "Love the design and functionality. Only complaint is the battery life could be better. Otherwise, it's exactly what I was looking for. Will buy again.", Product = "Portable Charger", SubmittedAt = "1 day ago" },
    };

    private HashSet<string> _selected = new();

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleSelectAll()
    {
        if (_selected.Count == _reviews.Count)
            _selected.Clear();
        else
            _selected = new HashSet<string>(_reviews.Select(r => r.Id));
    }

    private void HandleAction(string id, string action)
    {
        _reviews.RemoveAll(r => r.Id == id);
        _selected.Remove(id);
    }

    private void HandleBulkAction(string action)
    {
        _reviews.RemoveAll(r => _selected.Contains(r.Id));
        _selected.Clear();
    }
}
