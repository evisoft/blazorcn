@* ============================================================
   Block: reviews-social-proof-banner
   Title: ReviewsSocialProofBanner
   Description: A compact horizontal social proof banner strip for React and Next.js with avatar stack, animated review counter, star rating, trust badges, recent activity ticker, and embeddable strip layout built with shadcn/ui Avatar and Badge components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-social-proof-banner.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card"
         @onmouseenter="PauseRotation"
         @onmouseleave="ResumeRotation">

        @* Main banner row *@
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3">

            @* Avatar stack + count *@
            <div class="flex items-center gap-3">
                <div class="flex items-center -space-x-2"
                     role="group"
                     aria-label="@($"{_totalReviews} reviewers")">
                    @foreach (var reviewer in _recentReviewers)
                    {
                        <AvatarCn Class="size-7 border-2 border-card">
                            <AvatarFallbackCn Class="@Cn.Merge("text-[9px] font-medium", reviewer.Color)">@reviewer.Initials</AvatarFallbackCn>
                        </AvatarCn>
                    }
                    <div class="flex size-7 items-center justify-center rounded-full border-2 border-card bg-muted">
                        <span class="text-[8px] font-medium text-muted-foreground">
                            +@((_totalReviews - _recentReviewers.Length).ToString("N0"))
                        </span>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="text-sm font-semibold tabular-nums leading-none">
                        @_totalReviews.ToString("N0")
                    </span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">verified reviews</span>
                </div>
            </div>

            @* Divider *@
            <div class="hidden h-8 w-px bg-border sm:block"></div>

            @* Rating *@
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="14"
                                      Class="@Cn.Merge("size-3.5", idx < (int)Math.Round(_averageRating) ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                    }
                </div>
                <span class="text-sm font-semibold tabular-nums">@_averageRating</span>
                <span class="text-xs text-muted-foreground">average</span>
            </div>

            @* Divider *@
            <div class="hidden h-8 w-px bg-border sm:block"></div>

            @* Recommend rate *@
            <div class="flex items-center gap-1.5">
                <span class="text-sm font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_recommendPercent%
                </span>
                <span class="text-xs text-muted-foreground">recommend</span>
            </div>

            @* Divider *@
            <div class="hidden h-8 w-px bg-border sm:block"></div>

            @* Trust badges *@
            <div class="flex items-center gap-2">
                @foreach (var badge in _trustBadges)
                {
                    var b = badge;
                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                        @if (b.Icon == "shield")
                        {
                            <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-blue-500" />
                        }
                        @b.Label
                    </BadgeCn>
                }
            </div>
        </div>

        @* Activity ticker *@
        <div class="border-t bg-muted/30 px-4 py-2" aria-live="polite">
            @{
                var current = _activityFeed[_activeActivity];
            }
            <div class="flex items-center gap-2">
                <span class="size-1.5 shrink-0 animate-pulse rounded-full bg-emerald-500"></span>
                <span class="truncate text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">@current.Name</span>
                    @(" ")@current.Action@(" ")
                    <span class="font-medium text-foreground">@current.Product</span>
                </span>
                <span class="ml-auto shrink-0 text-[10px] text-muted-foreground tabular-nums">
                    @current.TimeAgo
                </span>
                <div class="flex items-center gap-0.5 shrink-0">
                    @for (int i = 0; i < current.Rating; i++)
                    {
                        <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-foreground text-foreground" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record RecentReviewer(string Id, string Initials, string Color);
    private record ActivityItem(string Id, string Name, string Action, string Product, string TimeAgo, int Rating);
    private record TrustBadge(string Label, string Icon);

    private const int _totalReviews = 12847;
    private const double _averageRating = 4.8;
    private const int _recommendPercent = 96;

    private static readonly RecentReviewer[] _recentReviewers =
    [
        new("rv-1", "AK", "bg-blue-500/15 text-blue-700 dark:text-blue-300"),
        new("rv-2", "SM", "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300"),
        new("rv-3", "LT", "bg-amber-500/15 text-amber-700 dark:text-amber-300"),
        new("rv-4", "RJ", "bg-red-500/15 text-red-700 dark:text-red-300"),
        new("rv-5", "NP", "bg-blue-500/15 text-blue-700 dark:text-blue-300"),
    ];

    private static readonly TrustBadge[] _trustBadges =
    [
        new("Verified Reviews", "shield"),
        new("Secure Checkout", "check"),
    ];

    private static readonly ActivityItem[] _activityFeed =
    [
        new("a1", "Maya T.", "left a 5-star review for", "Pro Plan", "2m ago", 5),
        new("a2", "James R.", "left a 5-star review for", "Component Library", "5m ago", 5),
        new("a3", "Elena K.", "left a 4-star review for", "Dashboard Blocks", "8m ago", 4),
        new("a4", "Carlos M.", "left a 5-star review for", "Form Blocks", "12m ago", 5),
        new("a5", "Priya S.", "left a 5-star review for", "Pro Plan", "18m ago", 5),
    ];

    private int _activeActivity = 0;
    private bool _isPaused = false;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (!_isPaused)
            {
                _activeActivity = (_activeActivity + 1) % _activityFeed.Length;
                InvokeAsync(StateHasChanged);
            }
        }, null, 3500, 3500);
    }

    private void PauseRotation()
    {
        _isPaused = true;
    }

    private void ResumeRotation()
    {
        _isPaused = false;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
