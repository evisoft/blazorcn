@* ============================================================
   Block: reviews-restaurant-food
   Title: ReviewsRestaurantFood
   Description: A bento grid restaurant review block for React and Next.js with cuisine tags, dish photo cards, multi-criteria radar-style scores, price tier indicator, and atmosphere badges built with shadcn/ui Avatar, Badge, and Progress components and Tailwind CSS
   Source: original/blocks/reviews/reviews-restaurant-food.tsx
   ============================================================ *@

@{
    var activeReview = _reviews.FirstOrDefault(r => r.Id == _selectedReview) ?? _reviews[0];
}

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Venue header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="utensils" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm font-medium">Osteria del Mercato</span>
                </div>
                <div class="flex items-center gap-2">
                    @* Price indicator inline *@
                    <span class="flex items-center gap-0.5 text-xs font-medium">
                        @for (int pi = 0; pi < 4; pi++) { var idx = pi; <span class="@(idx < 3 ? "text-foreground" : "text-muted-foreground/30")">@("$")</span> }
                    </span>
                    <span class="text-muted-foreground/30">|</span>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                        <span class="text-sm font-semibold tabular-nums">@_venueOverall.ToString("F1")</span>
                        <span class="text-xs text-muted-foreground">(@_reviews.Length)</span>
                    </div>
                </div>
            </div>
            <div class="mt-2 flex items-center gap-1.5">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">147 Market Street, San Francisco</span>
                <span class="mx-1 text-muted-foreground/30">|</span>
                <div class="flex items-center gap-1">
                    @foreach (var tag in _cuisineTags)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="px-1.5 py-0 text-[10px] font-normal">@tag</BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Bento grid: venue scores + review selector *@
        <div class="grid gap-px border-b bg-border md:grid-cols-[280px_1fr]">

            @* Venue category scores *@
            <div class="space-y-3 bg-card p-4">
                <span class="text-xs font-medium text-muted-foreground">Venue Ratings</span>
                @foreach (var cat in _venueCategories)
                {
                    <div class="space-y-1">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">@cat.Name</span>
                            <span class="text-xs font-medium tabular-nums">@cat.Score.ToString("F1")</span>
                        </div>
                        <ProgressCn Class="h-1" Value="@((int)(cat.Score / cat.MaxScore * 100))" />
                    </div>
                }
            </div>

            @* Review selector tabs *@
            <div class="bg-card">
                <div class="flex items-center gap-1 border-b px-3 py-2">
                    @foreach (var review in _reviews)
                    {
                        var rev = review;
                        var isActive = _selectedReview == rev.Id;
                        <button
                            type="button"
                            @onclick="@(() => _selectedReview = rev.Id)"
                            class="@Cn.Merge("flex items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-xs transition-colors", isActive ? "bg-muted/80 font-medium" : "text-muted-foreground hover:bg-muted/40 hover:text-foreground")">
                            <AvatarCn Class="size-5">
                                <AvatarFallbackCn Class="text-[10px]">@rev.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <span>@rev.Author.Split(' ')[0]</span>
                            @* Star rating inline *@
                            <div class="flex items-center gap-0.5">
                                @for (int si = 0; si < 5; si++) { var sidx = si; <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", sidx < rev.Overall ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" /> }
                            </div>
                        </button>
                    }
                </div>

                @* Active review content *@
                <div class="p-4">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <span>@activeReview.MealType</span>
                        <span class="text-muted-foreground/30">|</span>
                        <span>@activeReview.VisitDate</span>
                        <span class="text-muted-foreground/30">|</span>
                        @* Price indicator for active review *@
                        <span class="flex items-center gap-0.5 text-xs font-medium">
                            @for (int pi = 0; pi < 4; pi++) { var idx = pi; var prng = activeReview.PriceRange; <span class="@(idx < prng ? "text-foreground" : "text-muted-foreground/30")">@("$")</span> }
                        </span>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        @activeReview.Comment
                    </p>
                </div>
            </div>
        </div>

        @* Dish cards + atmosphere + review scores bento *@
        <div class="grid gap-px bg-border md:grid-cols-2">

            @* Dish cards *@
            <div class="bg-card p-4">
                <span class="text-xs font-medium text-muted-foreground">Dishes Mentioned</span>
                <div class="mt-2.5 space-y-2">
                    @foreach (var dish in activeReview.Dishes)
                    {
                        var d = dish;
                        var tagConf = GetDishTagConfig(d.Tag);
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="@tagConf.IconName" Size="12" Class="@Cn.Merge("size-3", tagConf.Class)" />
                                <span class="text-sm">@d.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] capitalize text-muted-foreground">@d.Tag</span>
                            </div>
                            @* Star rating for dish *@
                            <div class="flex items-center gap-0.5">
                                @for (int si = 0; si < 5; si++) { var sidx = si; var drat = d.Rating; <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", sidx < drat ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" /> }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Atmosphere + review breakdown *@
            <div class="bg-card p-4">
                @* Atmosphere tags *@
                <span class="text-xs font-medium text-muted-foreground">Atmosphere</span>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var atm in activeReview.Atmosphere)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@atm</BadgeCn>
                    }
                </div>

                @* Review-specific scores *@
                <div class="mt-4">
                    <span class="text-xs font-medium text-muted-foreground">Review Scores</span>
                    <div class="mt-2 space-y-2">
                        @foreach (var cat in activeReview.Categories)
                        {
                            var c = cat;
                            var barColor = c.Score >= 4.5 ? "bg-emerald-500" : c.Score >= 3.5 ? "bg-blue-500" : c.Score >= 2.5 ? "bg-amber-500" : "bg-red-500";
                            var widthPct = (int)(c.Score / c.MaxScore * 100);
                            <div class="flex items-center gap-3">
                                <span class="w-20 shrink-0 text-xs text-muted-foreground">@c.Name</span>
                                <div class="flex-1">
                                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                                        <div class="@Cn.Merge("h-full rounded-full", barColor)" style="@($"width:{widthPct}%")"></div>
                                    </div>
                                </div>
                                <span class="w-6 text-right text-xs font-medium tabular-nums">@c.Score</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private string _selectedReview = "r1";

    private record CategoryScore(string Name, double Score, double MaxScore);
    private record Dish(string Name, int Rating, string Tag);
    private record Review(string Id, string Author, string Initials, string VisitDate, int Overall, int PriceRange, string MealType, string[] Atmosphere, CategoryScore[] Categories, Dish[] Dishes, string Comment);
    private record DishTagConfig(string IconName, string Class);

    private static DishTagConfig GetDishTagConfig(string tag) => tag switch
    {
        "signature"  => new DishTagConfig("star",  "text-amber-600 dark:text-amber-400"),
        "seasonal"   => new DishTagConfig("leaf",  "text-emerald-600 dark:text-emerald-400"),
        "vegetarian" => new DishTagConfig("leaf",  "text-emerald-600 dark:text-emerald-400"),
        "spicy"      => new DishTagConfig("flame", "text-red-600 dark:text-red-400"),
        _            => new DishTagConfig("star",  "text-muted-foreground"),
    };

    private static readonly string[] _cuisineTags = ["Italian-Fusion", "Farm-to-Table", "Seafood", "Seasonal Tasting"];

    private static readonly CategoryScore[] _venueCategories =
    [
        new("Food Quality", 4.6, 5),
        new("Service",      4.3, 5),
        new("Atmosphere",   4.7, 5),
        new("Value",        4.1, 5),
    ];

    private static readonly double _venueOverall = Math.Round(
        _venueCategories.Average(c => c.Score), 1);

    private static readonly Review[] _reviews =
