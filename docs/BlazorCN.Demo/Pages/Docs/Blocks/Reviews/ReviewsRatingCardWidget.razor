@* ============================================================
   Block: reviews-rating-card-widget
   Title: ReviewsRatingCardWidget
   Description: An embeddable compact rating card widget for React and Next.js with circular score indicator, star display, review highlights, mini distribution bars, and call-to-action button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-rating-card-widget.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Score hero section *@
        <div class="flex items-center gap-5 px-5 py-5">
            @* Circular score indicator *@
            <div class="relative flex size-20 shrink-0 items-center justify-center">
                <svg class="-rotate-90" width="80" height="80" viewBox="0 0 80 80" aria-hidden="true">
                    <circle cx="40" cy="40" r="@_radius" fill="none" stroke="currentColor" stroke-width="4" class="text-muted/50" />
                    <circle cx="40" cy="40" r="@_radius" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"
                            class="text-foreground"
                            style="@($"stroke-dasharray:{_circumference:F4};stroke-dashoffset:{_strokeDashoffset:F4}")" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-xl font-semibold tabular-nums">@_productRating.Average</span>
                    <span class="text-[10px] text-muted-foreground">/5</span>
                </div>
            </div>

            @* Stars and count *@
            <div class="flex flex-col gap-1.5">
                <div class="flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideStarCn Size="16" Class="@Cn.Merge("size-4", idx < _filledStars ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                    }
                </div>
                <span class="text-xs text-muted-foreground">
                    @_productRating.Total.ToString("N0") verified reviews
                </span>
                <span class="text-xs font-medium">@_productRating.Name</span>
            </div>
        </div>

        <SeparatorCn />

        @* Mini distribution *@
        <div class="px-5 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Distribution</span>
            <div class="space-y-1">
                @foreach (var level in _productRating.Distribution)
                {
                    var barPercent = _maxCount > 0 ? (int)Math.Round((double)level.Count / _maxCount * 100) : 0;
                    <div class="flex items-center gap-2">
                        <span class="w-3 text-right text-[10px] tabular-nums text-muted-foreground">@level.Stars</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/60" style="@($"width:{barPercent}%")"></div>
                        </div>
                        <span class="w-10 text-right text-[10px] tabular-nums text-muted-foreground">@level.Count.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>

        <SeparatorCn />

        @* Review highlights *@
        <div class="px-5 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Highlights</span>
            <div class="space-y-2">
                @foreach (var highlight in _productRating.Highlights)
                {
                    var hl = highlight;
                    <div class="@Cn.Merge("rounded-md px-3 py-2 transition-colors", _hoveredHighlight == hl.Id ? "bg-muted/50" : "")"
                         @onmouseenter="@(() => _hoveredHighlight = hl.Id)"
                         @onmouseleave="@(() => _hoveredHighlight = null)">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-medium">@hl.Author</span>
                            <div class="flex items-center gap-0.5">
                                @for (int i = 0; i < 5; i++)
                                {
                                    var idx = i;
                                    <LucideStarCn Size="10" Class="@Cn.Merge("size-2.5", idx < hl.Rating ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                                }
                            </div>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                            @("“")@hl.Text@("”")
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Footer CTA *@
        <div class="border-t px-5 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @_positivePercent% positive ratings
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Write a review</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewHighlight(string Id, string Author, string Text, int Rating);
    private record DistributionLevel(int Stars, int Count);
    private record ProductRating(string Name, double Average, int Total, DistributionLevel[] Distribution, ReviewHighlight[] Highlights);

    private string? _hoveredHighlight;

    private static readonly ProductRating _productRating = new(
        Name: "Wireless Noise-Canceling Headphones",
        Average: 4.7,
        Total: 2491,
        Distribution:
        [
            new(5, 1619),
            new(4, 523),
            new(3, 224),
            new(2, 87),
            new(1, 38),
        ],
        Highlights:
        [
            new("h1", "Alex M.", "Best noise cancellation I have ever used. Battery lasts all week.", 5),
            new("h2", "Jordan K.", "Comfortable for long flights. Sound quality rivals wired headphones.", 5),
            new("h3", "Sam R.", "Great build quality but the app could use some work.", 4),
        ]
    );

    private static readonly int _maxCount = _productRating.Distribution.Max(d => d.Count);
    private static readonly int _filledStars = (int)Math.Round(_productRating.Average);
    private static readonly double _scorePercent = (_productRating.Average / 5.0) * 100.0;
    private const int _radius = 36;
    private static readonly double _circumference = 2.0 * Math.PI * _radius;
    private static readonly double _strokeDashoffset = _circumference - (_scorePercent / 100.0) * _circumference;
    private static readonly int _positivePercent = (int)Math.Round(
        ((double)(_productRating.Distribution[0].Count + _productRating.Distribution[1].Count) / _productRating.Total) * 100.0
    );
}
