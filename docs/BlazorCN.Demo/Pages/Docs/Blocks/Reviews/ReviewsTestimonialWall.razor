@* ============================================================
   Block: reviews-testimonial-wall
   Title: ReviewsTestimonialWall
   Description: A masonry testimonial wall for React and Next.js with staggered entrance animations, varied card sizes, hover-to-reveal author details, star ratings, and industry badges built with shadcn/ui Badge and Avatar components and Tailwind CSS.
   Source: original/blocks/reviews/reviews-testimonial-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Customer testimonials</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_testimonials.Length voices &middot; @_averageRating.ToString("F1") avg rating
                </p>
            </div>
            <div class="flex items-center gap-1">
                @for (int i = 0; i < 5; i++)
                {
                    var idx = i;
                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < (int)Math.Round(_averageRating) ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                }
            </div>
        </div>

        @* Masonry grid *@
        <div class="grid grid-cols-1 gap-3 p-3 sm:grid-cols-2 lg:grid-cols-3">
            <div class="flex flex-col gap-3">
                @foreach (var t in _col1)
                {
                    var testimonial = t;
                    var isHovered = _hoveredId == testimonial.Id;
                    <div class="@Cn.Merge("group relative rounded-md border p-4 transition-colors duration-200", testimonial.Featured ? "border-l-2 border-l-foreground/20 bg-muted/30" : "bg-card hover:bg-muted/20")"
                         @onmouseenter="@(() => _hoveredId = testimonial.Id)"
                         @onmouseleave="@(() => _hoveredId = null)">
                        <LucideIconCn Name="quote" Size="14" Class="mb-2 size-3.5 text-muted-foreground/25" />
                        <p class="text-sm leading-relaxed">@testimonial.Quote</p>
                        <div class="mt-3 flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var starIdx = i;
                                <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < testimonial.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                            }
                        </div>
                        <div class="mt-3 flex items-center gap-2.5">
                            <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-[10px] font-medium transition-colors duration-200", isHovered ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @testimonial.Initials
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block text-sm font-medium">@testimonial.Author</span>
                                <span class="block text-xs text-muted-foreground">@testimonial.Role, @testimonial.Company</span>
                            </div>
                        </div>
                        <div class="@Cn.Merge("mt-2 overflow-hidden transition-all duration-200", isHovered ? "max-h-8 opacity-100" : "max-h-0 opacity-0")">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@testimonial.Industry</BadgeCn>
                        </div>
                    </div>
                }
            </div>
            <div class="flex flex-col gap-3">
                @foreach (var t in _col2)
                {
                    var testimonial = t;
                    var isHovered = _hoveredId == testimonial.Id;
                    <div class="@Cn.Merge("group relative rounded-md border p-4 transition-colors duration-200", testimonial.Featured ? "border-l-2 border-l-foreground/20 bg-muted/30" : "bg-card hover:bg-muted/20")"
                         @onmouseenter="@(() => _hoveredId = testimonial.Id)"
                         @onmouseleave="@(() => _hoveredId = null)">
                        <LucideIconCn Name="quote" Size="14" Class="mb-2 size-3.5 text-muted-foreground/25" />
                        <p class="text-sm leading-relaxed">@testimonial.Quote</p>
                        <div class="mt-3 flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var starIdx = i;
                                <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < testimonial.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                            }
                        </div>
                        <div class="mt-3 flex items-center gap-2.5">
                            <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-[10px] font-medium transition-colors duration-200", isHovered ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @testimonial.Initials
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block text-sm font-medium">@testimonial.Author</span>
                                <span class="block text-xs text-muted-foreground">@testimonial.Role, @testimonial.Company</span>
                            </div>
                        </div>
                        <div class="@Cn.Merge("mt-2 overflow-hidden transition-all duration-200", isHovered ? "max-h-8 opacity-100" : "max-h-0 opacity-0")">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@testimonial.Industry</BadgeCn>
                        </div>
                    </div>
                }
            </div>
            <div class="flex flex-col gap-3 max-lg:hidden">
                @foreach (var t in _col3)
                {
                    var testimonial = t;
                    var isHovered = _hoveredId == testimonial.Id;
                    <div class="@Cn.Merge("group relative rounded-md border p-4 transition-colors duration-200", testimonial.Featured ? "border-l-2 border-l-foreground/20 bg-muted/30" : "bg-card hover:bg-muted/20")"
                         @onmouseenter="@(() => _hoveredId = testimonial.Id)"
                         @onmouseleave="@(() => _hoveredId = null)">
                        <LucideIconCn Name="quote" Size="14" Class="mb-2 size-3.5 text-muted-foreground/25" />
                        <p class="text-sm leading-relaxed">@testimonial.Quote</p>
                        <div class="mt-3 flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var starIdx = i;
                                <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < testimonial.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                            }
                        </div>
                        <div class="mt-3 flex items-center gap-2.5">
                            <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-[10px] font-medium transition-colors duration-200", isHovered ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @testimonial.Initials
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block text-sm font-medium">@testimonial.Author</span>
                                <span class="block text-xs text-muted-foreground">@testimonial.Role, @testimonial.Company</span>
                            </div>
                        </div>
                        <div class="@Cn.Merge("mt-2 overflow-hidden transition-all duration-200", isHovered ? "max-h-8 opacity-100" : "max-h-0 opacity-0")">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@testimonial.Industry</BadgeCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-[10px] text-muted-foreground">
                Showing @_testimonials.Length of @_testimonials.Length testimonials &middot; All verified customers
            </span>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Quote, string Author, string Initials, string Role, string Company, int Rating, string Industry, bool Featured);

    private string? _hoveredId;

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "We migrated our entire design system in under a week. The TypeScript types caught three integration bugs that would have shipped to production. Our frontend velocity increased measurably within the first sprint.", "Sarah Chen", "SC", "VP of Engineering", "Veritas Labs", 5, "Developer Tools", true),
        new("t2", "Saved us months of building our own component library. The ROI was obvious within the first project.", "Marcus Johnson", "MJ", "CTO", "Relay", 5, "SaaS Platform", false),
        new("t3", "We shipped our SaaS landing page in two days. The blocks are production-ready and the TypeScript types are impeccable. Our designer was impressed with the default aesthetics and our engineers loved the composable API.", "Elena Rodriguez", "ER", "Founder", "Synthwave", 5, "Fintech", true),
        new("t4", "Clean, accessible, composable. Everything you want from a component library and nothing you do not.", "David Kim", "DK", "Senior Developer", "Arclight", 4, "E-Commerce", false),
        new("t5", "Our team uses these blocks daily. Onboarding new developers takes hours instead of weeks. The Tailwind integration is seamless and the responsive behavior works without any configuration.", "Priya Patel", "PP", "Engineering Manager", "Stackpoint", 5, "Cloud Services", false),
        new("t6", "No vendor lock-in, no dependency hell. Copy, paste, own your code. The philosophy is as strong as the implementation.", "James Park", "JP", "Lead Developer", "Nimbus", 5, "Infrastructure", false),
        new("t7", "The premium blocks paid for themselves within the first project. Dashboard and chart components alone are worth the subscription. We used to spend days building what now takes minutes, and the output is more polished than what we were shipping before.", "Anna Weber", "AW", "Product Designer", "Helix", 5, "Analytics", true),
        new("t8", "Accessibility built in from day one. Our compliance audits pass without extra work now.", "Carlos Mendez", "CM", "Frontend Architect", "Baseform", 5, "Healthcare", false),
        new("t9", "We evaluated six libraries before choosing this one. The attention to detail in animations, spacing, and responsive behavior set it apart. Clients keep asking how we build interfaces so fast.", "Lisa Chang", "LC", "Design Lead", "Forma Studio", 5, "Design Agency", false),
    ];

    private static readonly double _averageRating = _testimonials.Sum(t => t.Rating) / (double)_testimonials.Length;

    private static readonly Testimonial[] _col1 = _testimonials.Where((_, i) => i % 3 == 0).ToArray();
    private static readonly Testimonial[] _col2 = _testimonials.Where((_, i) => i % 3 == 1).ToArray();
    private static readonly Testimonial[] _col3 = _testimonials.Where((_, i) => i % 3 == 2).ToArray();
}
