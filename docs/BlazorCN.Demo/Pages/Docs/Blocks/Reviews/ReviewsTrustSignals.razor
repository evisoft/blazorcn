@* ============================================================
   Block: reviews-trust-signals
   Title: ReviewsTrustSignals
   Description: A review trust and authenticity signals panel for React and Next.js with verification scores, fraud detection metrics, platform certifications, and animated progress indicators built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/reviews/reviews-trust-signals.tsx
   ============================================================ *@

<TooltipProviderCn>
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">

            @* Header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    <div class="flex size-7 items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div>
                        <span class="text-sm font-medium">Trust Signals</span>
                        <p class="text-xs text-muted-foreground">
                            Review integrity and verification metrics
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <span class="tabular-nums">@_totalReviews.ToString("N0") reviews</span>
                    <span>-</span>
                    <div class="flex items-center gap-0.5">
                        @for (int i = 0; i < 5; i++)
                        {
                            var idx = i;
                            <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < (int)Math.Round(_averageRating) ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                        }
                        <span class="ml-1 tabular-nums">@_averageRating</span>
                    </div>
                </div>
            </div>

            @* Bento layout: Trust score + metrics grid *@
            <div class="grid grid-cols-1 border-b sm:grid-cols-3">

                @* Trust score circle *@
                <div class="flex flex-col items-center justify-center border-b px-4 py-6 sm:border-b-0 sm:border-r">
                    <div class="relative">
                        <svg aria-hidden="true" width="88" height="88" class="-rotate-90">
                            <circle cx="44" cy="44" r="36" fill="none" stroke-width="6" class="stroke-muted" />
                            <circle cx="44" cy="44" r="36" fill="none" stroke-width="6" stroke-linecap="round"
                                    class="@GetScoreStroke(_compositeTrustScore)"
                                    stroke-dasharray="@_circumference.ToString("F2")"
                                    stroke-dashoffset="@_dashOffset.ToString("F2")" />
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                            <span class="@Cn.Merge("text-xl font-semibold tabular-nums", GetScoreColor(_compositeTrustScore))">
                                @_compositeTrustScore
                            </span>
                            <span class="text-[10px] text-muted-foreground">Trust Score</span>
                        </div>
                    </div>
                    <p class="mt-2 text-center text-[10px] text-muted-foreground">
                        Composite weighted score
                    </p>
                </div>

                @* Metrics grid 2x3 *@
                <div class="col-span-2 grid grid-cols-2 gap-px bg-border sm:grid-cols-3">
                    @foreach (var metric in _trustMetrics)
                    {
                        var m = metric;
                        var pct = (int)Math.Round((double)m.Value / m.MaxValue * 100);
                        <TooltipCn>
                            <TooltipTriggerCn AsChild="true">
                                <div class="bg-card px-3 py-3">
                                    <div class="flex items-center gap-1.5 text-muted-foreground">
                                        <LucideIconCn Name="@m.IconName" Size="16" Class="size-4" />
                                        <span class="text-[10px] font-medium">@m.Label</span>
                                    </div>
                                    <div class="mt-1.5 flex items-baseline gap-1">
                                        <span class="text-lg font-semibold tabular-nums">@m.Value</span>
                                        <span class="text-[10px] text-muted-foreground">
                                            / @m.MaxValue
                                        </span>
                                    </div>
                                    @* Mini progress bar *@
                                    <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-muted">
                                        <div class="@Cn.Merge("h-full rounded-full", pct >= 90 ? "bg-emerald-500" : pct >= 75 ? "bg-blue-500" : "bg-amber-500")"
                                             style="@($"width:{pct}%")"></div>
                                    </div>
                                </div>
                            </TooltipTriggerCn>
                            <TooltipContentCn>
                                <p class="text-xs">@m.Description</p>
                                <p class="mt-0.5 text-[10px] text-muted-foreground">
                                    Weight: @((m.Weight * 100).ToString("F0"))% of trust score
                                </p>
                            </TooltipContentCn>
                        </TooltipCn>
                    }
                </div>
            </div>

            @* Two-column bottom: certifications + integrity checks *@
            <div class="grid grid-cols-1 divide-y sm:grid-cols-2 sm:divide-x sm:divide-y-0">

                @* Platform certifications *@
                <div class="px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">
                        Platform Certifications
                    </span>
                    <div class="mt-2.5 space-y-2">
                        @foreach (var cert in _certifications)
                        {
                            var c = cert;
                            <div class="@Cn.Merge("flex items-center justify-between rounded-md px-2.5 py-2", c.Earned ? "bg-muted/30" : "opacity-50")">
                                <div class="flex items-center gap-2">
                                    @if (c.Earned)
                                    {
                                        <LucideIconCn Name="badge-check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="badge-check" Size="14" Class="size-3.5 text-muted-foreground" />
                                    }
                                    <div>
                                        <span class="text-xs font-medium">@c.Name</span>
                                        <p class="text-[10px] text-muted-foreground">@c.Issuer</p>
                                    </div>
                                </div>
                                @if (c.Earned)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] font-normal">
                                        @c.EarnedDate
                                    </BadgeCn>
                                }
                                else
                                {
                                    <span class="text-[10px] text-muted-foreground">Pending</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Integrity checks *@
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-muted-foreground">Integrity Checks</span>
                        <span class="text-[10px] text-muted-foreground">
                            @(_integrityChecks.Count(ch => ch.Status == "pass"))/@(_integrityChecks.Length) passing
                        </span>
                    </div>
                    <div class="mt-2.5 space-y-1.5">
                        @foreach (var check in _integrityChecks)
                        {
                            var chk = check;
                            var indicator = GetStatusIndicator(chk.Status);
                            <div class="flex items-start gap-2 py-1.5">
                                <span class="@Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", indicator.Color)" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs font-medium">@chk.Label</span>
                                        @if (chk.Status == "warning")
                                        {
                                            <LucideIconCn Name="triangle-alert" Size="12" Class="size-3 text-amber-500" />
                                        }
                                    </div>
                                    <p class="text-[10px] text-muted-foreground">@chk.Detail</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </section>
</TooltipProviderCn>

@code {
    private record TrustMetric(string Id, string Label, int Value, int MaxValue, string Description, string IconName, double Weight);
    private record PlatformCertification(string Id, string Name, string Issuer, bool Earned, string EarnedDate);
    private record IntegrityCheck(string Id, string Label, string Status, string Detail);
    private record StatusIndicator(string Color, string Bg, string Label);

    private static readonly TrustMetric[] _trustMetrics =
    [
        new("verified-purchase", "Verified Purchases", 94, 100, "Percentage of reviews from confirmed buyers", "badge-check", 0.3),
        new("identity-verified", "Identity Verified", 87, 100, "Reviewers with confirmed identity via email or SSO", "scan", 0.2),
        new("response-rate", "Seller Response", 98, 100, "Seller responds to reviews within 24 hours", "message-square-text", 0.15),
        new("email-verified", "Email Verified", 99, 100, "Reviewers with confirmed email addresses", "mail-check", 0.1),
        new("repeat-buyers", "Repeat Buyers", 67, 100, "Customers who purchased more than once", "user-check", 0.15),
        new("fraud-score", "Fraud Detection", 96, 100, "Reviews passing automated fraud screening", "shield-check", 0.1),
    ];

    private static readonly PlatformCertification[] _certifications =
    [
        new("google-seller", "Google Seller Ratings", "Google", true, "Jan 2026"),
        new("trustpilot", "Trustpilot Verified", "Trustpilot", true, "Nov 2025"),
        new("bbb-accredited", "BBB Accredited", "Better Business Bureau", true, "Mar 2025"),
        new("iso-27001", "ISO 27001", "ISO", false, ""),
    ];

    private static readonly IntegrityCheck[] _integrityChecks =
    [
        new("duplicate-detection", "Duplicate Detection", "pass", "0 duplicate reviews detected in last 90 days"),
        new("velocity-check", "Review Velocity", "pass", "Normal submission rate, no suspicious spikes"),
        new("sentiment-consistency", "Sentiment Consistency", "pass", "Rating-text alignment score 94%"),
        new("ip-analysis", "IP Address Analysis", "warning", "3 reviews from shared IP ranges flagged for review"),
        new("account-age", "Account Age Check", "pass", "Average reviewer account age 14 months"),
    ];

    private static readonly int _totalReviews = 3842;
    private static readonly double _averageRating = 4.6;

    private static readonly int _compositeTrustScore =
        (int)Math.Round(_trustMetrics.Sum(m => m.Value * m.Weight));

    private static readonly double _circumference = 2 * Math.PI * 36;
    private static readonly double _dashOffset = _circumference - (_compositeTrustScore / 100.0) * _circumference;

    private static string GetScoreColor(int score)
    {
        if (score >= 90) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 75) return "text-blue-600 dark:text-blue-400";
        if (score >= 50) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string GetScoreStroke(int score)
    {
        if (score >= 90) return "stroke-emerald-500";
        if (score >= 75) return "stroke-blue-500";
        if (score >= 50) return "stroke-amber-500";
        return "stroke-red-500";
    }

    private static StatusIndicator GetStatusIndicator(string status)
    {
        if (status == "pass")
            return new("bg-emerald-500", "bg-emerald-500/10", "Pass");
        if (status == "warning")
            return new("bg-amber-500", "bg-amber-500/10", "Review");
        return new("bg-red-500", "bg-red-500/10", "Fail");
    }
}
