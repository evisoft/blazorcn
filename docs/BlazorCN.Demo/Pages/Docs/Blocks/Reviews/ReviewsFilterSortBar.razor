@* ============================================================
   Block: reviews-filter-sort-bar
   Title: ReviewsFilterSortBar
   Description: A reviews filter and sort toolbar block for React and Next.js with rating dropdowns, verified toggle, date range select, sort options, active filter badges, and live result counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-filter-sort-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="filter" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-sm font-medium">Filter Reviews</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">
                    @_filtered.Count of @_reviews.Length reviews
                </span>
                @if (_filtered.Count > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                        Avg @_averageRating
                    </BadgeCn>
                }
            </div>
        </div>

        @* Filter toolbar *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-2.5">
            @* Rating filter dropdown *@
            <div class="relative">
                <ButtonCn Variant="@(_ratingFilter.HasValue ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2.5 text-xs"
                          OnClick="@(() => ToggleDropdown("rating"))">
                    <LucideIconCn Name="star" Size="12" Class="size-3" />
                    @(_ratingFilter.HasValue ? $"{_ratingFilter.Value}+ stars" : "Rating")
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
                @if (_openDropdown == "rating")
                {
                    <div class="absolute left-0 z-20 mt-1 w-32 overflow-hidden rounded-md border bg-card shadow-md">
                        <button type="button"
                                @onclick="@(() => { _ratingFilter = null; _openDropdown = null; UpdateFiltered(); })"
                                class="@Cn.Merge("flex w-full items-center px-3 py-2 text-left text-xs transition-colors hover:bg-muted/50", !_ratingFilter.HasValue ? "font-medium" : "text-muted-foreground")">
                            All ratings
                        </button>
                        @foreach (var r in new[] { 5, 4, 3, 2 })
                        {
                            var rating = r;
                            <button type="button"
                                    @onclick="@(() => { _ratingFilter = rating; _openDropdown = null; UpdateFiltered(); })"
                                    class="@Cn.Merge("flex w-full items-center gap-1.5 px-3 py-2 text-left text-xs transition-colors hover:bg-muted/50", _ratingFilter == rating ? "font-medium" : "text-muted-foreground")">
                                @rating+ stars
                                <span class="ml-auto text-[10px] text-muted-foreground">
                                    @_reviews.Count(rv => rv.Rating >= rating)
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>

            @* Date filter dropdown *@
            <div class="relative">
                <ButtonCn Variant="@(_dateFilter != "all" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2.5 text-xs"
                          OnClick="@(() => ToggleDropdown("date"))">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    @(_dateFilter != "all" ? GetDateLabel(_dateFilter) : "Date")
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
                @if (_openDropdown == "date")
                {
                    <div class="absolute left-0 z-20 mt-1 w-36 overflow-hidden rounded-md border bg-card shadow-md">
                        @foreach (var entry in _dateLabels)
                        {
                            var key = entry.Key;
                            <button type="button"
                                    @onclick="@(() => { _dateFilter = key; _openDropdown = null; UpdateFiltered(); })"
                                    class="@Cn.Merge("flex w-full items-center px-3 py-2 text-left text-xs transition-colors hover:bg-muted/50", _dateFilter == key ? "font-medium" : "text-muted-foreground")">
                                @entry.Value
                            </button>
                        }
                    </div>
                }
            </div>

            @* Verified toggle *@
            <ButtonCn Variant="@(_verifiedOnly ? ButtonVariant.Default : ButtonVariant.Outline)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1 px-2.5 text-xs"
                      OnClick="@(() => { _verifiedOnly = !_verifiedOnly; _openDropdown = null; UpdateFiltered(); })">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                Verified
            </ButtonCn>

            @* Sort dropdown *@
            <div class="relative ml-auto">
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2.5 text-xs text-muted-foreground"
                          OnClick="@(() => ToggleDropdown("sort"))">
                    @GetSortLabel(_sort)
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
                @if (_openDropdown == "sort")
                {
                    <div class="absolute right-0 z-20 mt-1 w-36 overflow-hidden rounded-md border bg-card shadow-md">
                        @foreach (var entry in _sortLabels)
                        {
                            var key = entry.Key;
                            <button type="button"
                                    @onclick="@(() => { _sort = key; _openDropdown = null; UpdateFiltered(); })"
                                    class="@Cn.Merge("flex w-full items-center px-3 py-2 text-left text-xs transition-colors hover:bg-muted/50", _sort == key ? "font-medium" : "text-muted-foreground")">
                                @entry.Value
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @* Active filter badges *@
        @if (_activeFilters.Count > 0)
        {
            <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2">
                @foreach (var filter in _activeFilters)
                {
                    var f = filter;
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 pr-1 text-xs">
                        @f.Label
                        <button type="button"
                                @onclick="@(() => RemoveFilter(f.Key))"
                                aria-label="@($"Remove {f.Label} filter")"
                                class="ml-0.5 rounded-sm p-0.5 transition-colors hover:bg-muted">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </button>
                    </BadgeCn>
                }
                <button type="button"
                        @onclick="ClearAll"
                        class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    Clear all
                </button>
            </div>
        }

        @* Filtered review list *@
        <div>
            @if (_filtered.Count == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-sm text-muted-foreground">No reviews match your filters</p>
                    <button type="button"
                            @onclick="ClearAll"
                            class="mt-1.5 text-xs text-muted-foreground underline transition-colors hover:text-foreground">
                        Clear all filters
                    </button>
                </div>
            }
            else
            {
                @for (var i = 0; i < _filtered.Count; i++)
                {
                    var review = _filtered[i];
                    var isLast = i == _filtered.Count - 1;
                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <div class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <div class="flex items-center gap-0.5">
                                    @for (var si = 0; si < 5; si++)
                                    {
                                        var starIndex = si;
                                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < review.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                                    }
                                </div>
                                <span class="text-xs font-medium">@review.Author</span>
                                @if (review.Verified)
                                {
                                    <span class="flex items-center gap-0.5 text-[10px] text-emerald-600 dark:text-emerald-400">
                                        <LucideIconCn Name="shield-check" Size="10" Class="size-2.5" />
                                        Verified
                                    </span>
                                }
                                <span class="ml-auto text-xs text-muted-foreground">@review.Date</span>
                            </div>
                            <p class="mt-1.5 text-sm font-medium">@review.Title</p>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@review.Body</p>
                            <div class="mt-2 flex items-center gap-3">
                                <button type="button"
                                        class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                    Helpful (@review.HelpfulCount)
                                </button>
                                <span class="text-[10px] text-muted-foreground">
                                    via @review.Platform
                                </span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record Review(string Id, string Author, int Rating, string Date, int DaysAgo, string Platform, bool Verified, string Title, string Body, int HelpfulCount);
    private record ActiveFilter(string Key, string Label);

    private static readonly Dictionary<string, string> _sortLabels = new()
    {
        ["newest"] = "Newest first",
        ["oldest"] = "Oldest first",
        ["highest"] = "Highest rated",
        ["lowest"] = "Lowest rated",
        ["helpful"] = "Most helpful",
    };

    private static readonly Dictionary<string, string> _dateLabels = new()
    {
        ["all"] = "All time",
        ["week"] = "Past week",
        ["month"] = "Past month",
        ["quarter"] = "Past 3 months",
        ["year"] = "Past year",
    };

    private static readonly Dictionary<string, int> _dateDaysMap = new()
    {
        ["all"] = 9999,
        ["week"] = 7,
        ["month"] = 30,
        ["quarter"] = 90,
        ["year"] = 365,
    };

    private static readonly Review[] _reviews =
    [
        new("fs-1", "Sarah Chen", 5, "2 days ago", 2, "Direct", true,
            "Exactly what our dashboard needed",
            "Clean API, great documentation, and the component library saved us weeks of development time. Already recommended to three other engineering teams.",
            24),
        new("fs-2", "Marcus Johnson", 4, "1 week ago", 7, "G2", true,
            "Solid library with minor rough edges",
            "The core components are excellent. A few edge cases with complex form validation needed workarounds, but overall a strong choice for production applications.",
            18),
        new("fs-3", "Elena Petrov", 5, "2 weeks ago", 14, "Product Hunt", false,
            "Best component library for React projects",
            "We migrated from a custom design system and the transition was seamless. TypeScript support is first-class and the theming system is genuinely flexible.",
            31),
        new("fs-4", "David Kim", 3, "3 weeks ago", 21, "Direct", true,
            "Good but missing some advanced features",
            "Works well for standard use cases. Would love to see more complex data table patterns and better virtualization support for large datasets out of the box.",
            12),
        new("fs-5", "Priya Sharma", 4, "1 month ago", 32, "Capterra", true,
            "Great developer experience overall",
            "The copy-paste model is refreshing. No dependency bloat, full control over styling. The docs could use more real-world examples for edge cases though.",
            9),
        new("fs-6", "James Wu", 5, "2 months ago", 58, "Direct", true,
            "Transformed our frontend workflow",
            "Reduced our design-to-code gap from days to hours. The components are consistent, accessible by default, and the Tailwind integration is seamless.",
            42),
        new("fs-7", "Anna Kowalski", 2, "3 months ago", 88, "G2", false,
            "Steep learning curve for custom theming",
            "Components are well-built individually but getting a cohesive custom theme across all of them took more effort than expected. Documentation assumes familiarity with Radix primitives.",
            7),
    ];

    private string _sort = "newest";
    private int? _ratingFilter = null;
    private bool _verifiedOnly = false;
    private string _dateFilter = "all";
    private string? _openDropdown = null;
    private List<Review> _filtered = new();
    private List<ActiveFilter> _activeFilters = new();
    private string _averageRating = "0.0";

    protected override void OnInitialized()
    {
        UpdateFiltered();
    }

    private void ToggleDropdown(string key)
    {
        _openDropdown = _openDropdown == key ? null : key;
    }

    private void UpdateFiltered()
    {
        var result = _reviews.AsEnumerable();

        if (_ratingFilter.HasValue)
            result = result.Where(r => r.Rating >= _ratingFilter.Value);
        if (_verifiedOnly)
            result = result.Where(r => r.Verified);
        if (_dateFilter != "all")
        {
            var maxDays = _dateDaysMap[_dateFilter];
            result = result.Where(r => r.DaysAgo <= maxDays);
        }

        result = _sort switch
        {
            "newest"  => result.OrderBy(r => r.DaysAgo),
            "oldest"  => result.OrderByDescending(r => r.DaysAgo),
            "highest" => result.OrderByDescending(r => r.Rating),
            "lowest"  => result.OrderBy(r => r.Rating),
            "helpful" => result.OrderByDescending(r => r.HelpfulCount),
            _         => result,
        };

        _filtered = result.ToList();

        _averageRating = _filtered.Count > 0
            ? (_filtered.Sum(r => r.Rating) / (double)_filtered.Count).ToString("F1")
            : "0.0";

        _activeFilters = new List<ActiveFilter>();
        if (_ratingFilter.HasValue)
            _activeFilters.Add(new("rating", $"{_ratingFilter.Value}+ stars"));
        if (_verifiedOnly)
            _activeFilters.Add(new("verified", "Verified only"));
        if (_dateFilter != "all")
            _activeFilters.Add(new("date", GetDateLabel(_dateFilter)));
    }

    private void RemoveFilter(string key)
    {
        if (key == "rating") _ratingFilter = null;
        if (key == "verified") _verifiedOnly = false;
        if (key == "date") _dateFilter = "all";
        UpdateFiltered();
    }

    private void ClearAll()
    {
        _ratingFilter = null;
        _verifiedOnly = false;
        _dateFilter = "all";
        UpdateFiltered();
    }

    private string GetSortLabel(string sort) =>
        _sortLabels.TryGetValue(sort, out var label) ? label : sort;

    private string GetDateLabel(string date) =>
        _dateLabels.TryGetValue(date, out var label) ? label : date;
}
