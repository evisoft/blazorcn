@* ============================================================
   Block: reviews-detailed-card
   Title: ReviewsDetailedCard
   Description: A detailed review card block for React and Next.js with author profile, verified purchase badge, star ratings, photo gallery, pros and cons, helpful voting with animation, and merchant reply thread built with shadcn/ui Avatar, Badge, Button components and Tailwind CSS
   Source: original/blocks/reviews/reviews-detailed-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Author profile header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <AvatarCn Class="size-10 shrink-0">
                    <AvatarFallbackCn Class="@Cn.Merge("text-sm font-medium", _review.AvatarColor)">@_review.Initials</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@_review.Author</span>
                        @if (_review.Verified)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                                Verified
                            </BadgeCn>
                        }
                    </div>
                    <div class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span>@_review.ReviewCount reviews</span>
                        <span class="text-muted-foreground/40">·</span>
                        <span>Member since @_review.MemberSince</span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <div class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                var idx = i;
                                <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", idx < _review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                            }
                        </div>
                        <span class="text-xs text-muted-foreground">@_review.Date</span>
                    </div>
                </div>
                <div class="flex shrink-0 items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-muted-foreground" OnClick="CopyReview">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="flag" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Purchase context *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                <span>@_review.PurchaseType</span>
            </div>
            <span class="text-muted-foreground/30">|</span>
            <span class="text-xs text-muted-foreground">Used for @_review.UsageDuration</span>
        </div>

        @* Category scores *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var cat in _review.CategoryScores)
            {
                var catItem = cat;
                <div class="flex flex-col items-center bg-card px-3 py-2.5">
                    <span class="text-[10px] text-muted-foreground">@catItem.Label</span>
                    <div class="mt-1 flex items-center gap-0.5">
                        @for (var si = 0; si < 5; si++)
                        {
                            var scoreIdx = si;
                            <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", scoreIdx < catItem.Score ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                        }
                    </div>
                </div>
            }
        </div>

        @* Review title and text *@
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">@_review.Title</h3>
            <div class="mt-2 space-y-2">
                @foreach (var para in _review.Text.Split("\n\n"))
                {
                    var paragraph = para;
                    <p class="text-sm leading-relaxed text-muted-foreground">@paragraph</p>
                }
            </div>
        </div>

        @* Pros and cons *@
        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="mb-2 flex items-center gap-1.5">
                    <LucideIconCn Name="circle-plus" Size="12" Class="size-3 text-emerald-500" />
                    <span class="text-xs font-medium">Pros</span>
                </div>
                <ul class="space-y-1.5">
                    @foreach (var pro in _review.Pros)
                    {
                        var proItem = pro;
                        <li class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
                            <span class="mt-1.5 size-1 shrink-0 rounded-full bg-emerald-500"></span>
                            @proItem
                        </li>
                    }
                </ul>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="mb-2 flex items-center gap-1.5">
                    <LucideIconCn Name="circle-minus" Size="12" Class="size-3 text-red-500" />
                    <span class="text-xs font-medium">Cons</span>
                </div>
                <ul class="space-y-1.5">
                    @foreach (var con in _review.Cons)
                    {
                        var conItem = con;
                        <li class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
                            <span class="mt-1.5 size-1 shrink-0 rounded-full bg-red-500"></span>
                            @conItem
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Photos *@
        <div class="border-b px-4 py-3">
            <button type="button" @onclick="@(() => _showPhotos = !_showPhotos)"
                class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                <LucideIconCn Name="image" Size="12" Class="size-3" />
                @_review.Photos.Length photos attached
                <span class="ml-0.5">
                    <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none" class="text-current"
                        style="@(_showPhotos ? "transform:rotate(180deg)" : "")">
                        <path d="M2.5 3.75L5 6.25L7.5 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
            </button>
            @if (_showPhotos)
            {
                <div class="flex gap-2 pt-2.5">
                    @foreach (var photo in _review.Photos)
                    {
                        var photoItem = photo;
                        <div class="flex h-20 w-24 flex-col items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/30" />
                            <span class="mt-1 text-[10px] text-muted-foreground/50">@photoItem.AspectLabel</span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Helpful voting *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-xs text-muted-foreground">Helpful?</span>
            <ButtonCn Variant="@(_helpfulState == "up" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm"
                Class="h-6 gap-1 px-2 text-xs"
                OnClick="@(() => _helpfulState = _helpfulState == "up" ? "none" : "up")">
                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                <span class="tabular-nums">@HelpfulCount</span>
            </ButtonCn>
            <ButtonCn Variant="@(_helpfulState == "down" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm"
                Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                OnClick="@(() => _helpfulState = _helpfulState == "down" ? "none" : "down")">
                <LucideIconCn Name="thumbs-down" Size="12" Class="size-3" />
                <span class="tabular-nums">@NotHelpfulCount</span>
            </ButtonCn>
        </div>

        @* Merchant reply thread *@
        @if (_review.Reply != null)
        {
            <div class="px-4 py-3">
                <div class="rounded-md border border-dashed bg-muted/20 p-3">
                    <div class="mb-2 flex items-center gap-2">
                        <LucideIconCn Name="message-square" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium">@_review.Reply.Author</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@_review.Reply.Role</BadgeCn>
                        <span class="ml-auto text-xs text-muted-foreground">@_review.Reply.TimeAgo</span>
                    </div>
                    <p class="text-xs leading-relaxed text-muted-foreground">@_review.Reply.Text</p>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record ReviewPhoto(string Id, string Alt, string AspectLabel);

    private record CategoryScore(string Label, int Score);

    private record MerchantReply(string Author, string Role, string TimeAgo, string Text);

    private record Review(
        string Id,
        string Author,
        string Initials,
        string AvatarColor,
        int ReviewCount,
        string MemberSince,
        int Rating,
        string Title,
        string Date,
        bool Verified,
        string PurchaseType,
        string UsageDuration,
        string Text,
        string[] Pros,
        string[] Cons,
        CategoryScore[] CategoryScores,
        ReviewPhoto[] Photos,
        int Helpful,
        int NotHelpful,
        MerchantReply? Reply
    );

    private static readonly Review _review = new(
        Id: "r1",
        Author: "Rachel Kim",
        Initials: "RK",
        AvatarColor: "bg-violet-100 text-violet-700 dark:bg-violet-900 dark:text-violet-300",
        ReviewCount: 23,
        MemberSince: "Jan 2024",
        Rating: 5,
        Title: "Exceeded every expectation — this is the real deal",
        Date: "March 12, 2026",
        Verified: true,
        PurchaseType: "Pro Plan - Annual",
        UsageDuration: "3 months",
        Text: "I have been using this product daily for the past three months and it has fundamentally changed how our team operates. The performance is consistently fast even under heavy load, and the API is designed with real-world use cases in mind rather than theoretical perfection.\n\nThe onboarding experience deserves special mention. Most tools in this space require days of configuration. We were up and running in under two hours with a production-ready setup. The migration tool imported our existing data without a single error across fifty thousand records.\n\nThe only minor critique is that the mobile dashboard could use some refinement — a few of the more complex views are hard to navigate on smaller screens. But the team has already acknowledged this and it is on their public roadmap.",
        Pros:
        [
            "Migration tool handled 50k records flawlessly",
            "Production-ready setup in under 2 hours",
            "API designed for real-world use cases",
            "Consistently fast under heavy load",
        ],
        Cons:
        [
            "Mobile dashboard needs refinement on complex views",
            "Some advanced filters only available on Enterprise plan",
        ],
        CategoryScores:
        [
            new("Ease of Use", 5),
            new("Performance", 5),
            new("Documentation", 4),
            new("Value", 5),
        ],
        Photos:
        [
            new("p1", "Dashboard overview showing analytics", "Dashboard"),
            new("p2", "API response time metrics", "API Metrics"),
            new("p3", "Team collaboration view", "Team View"),
        ],
        Helpful: 47,
        NotHelpful: 2,
        Reply: new MerchantReply(
            Author: "Jordan Lee",
            Role: "Customer Success Lead",
            TimeAgo: "2 days ago",
            Text: "Thank you for the detailed review, Rachel. We are thrilled to hear about the smooth migration experience. Regarding the mobile dashboard — you are right, and we are actively working on a responsive overhaul planned for the Q2 release. We will keep you posted on progress."
        )
    );

    private string _helpfulState = "none";
    private bool _copied = false;
    private bool _showPhotos = false;

    private int HelpfulCount => _review.Helpful + (_helpfulState == "up" ? 1 : 0);
    private int NotHelpfulCount => _review.NotHelpful + (_helpfulState == "down" ? 1 : 0);

    private void CopyReview()
    {
        _copied = true;
        // In a real implementation: await JS.InvokeVoidAsync("navigator.clipboard.writeText", _review.Text);
    }
}
