@* ============================================================
   Block: reviews-reviewer-profile
   Title: ReviewsReviewerProfile
   Description: A sidebar-and-content reviewer profile page for React and Next.js with avatar, expertise badges, review stats, activity timeline, and top reviews list built with shadcn/ui Avatar, Badge, and Progress components and Tailwind CSS
   Source: original/blocks/reviews/reviews-reviewer-profile.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-[260px_1fr]">
            @* Left sidebar - profile *@
            <div class="border-b p-4 md:border-b-0 md:border-r">
                @* Avatar + name *@
                <div class="flex items-center gap-3 md:flex-col md:items-start md:gap-2">
                    <AvatarCn Class="size-12 md:size-14">
                        <AvatarFallbackCn Class="text-base font-medium">@_reviewer.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <span class="text-sm font-medium">@_reviewer.Name</span>
                        <p class="text-xs text-muted-foreground">@_reviewer.Handle</p>
                    </div>
                </div>

                <p class="mt-3 text-xs leading-relaxed text-muted-foreground">@_reviewer.Bio</p>

                <div class="mt-2 flex items-center gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Member since @_reviewer.MemberSince
                </div>

                @* Stats grid *@
                <div class="mt-4 grid grid-cols-2 gap-2">
                    <div class="rounded-md bg-muted/50 px-3 py-2">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="message-square" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-lg font-semibold tabular-nums">@_reviewer.ReviewCount</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground">Reviews</span>
                    </div>
                    <div class="rounded-md bg-muted/50 px-3 py-2">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-lg font-semibold tabular-nums">@_reviewer.AverageRating</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground">Avg rating</span>
                    </div>
                    <div class="rounded-md bg-muted/50 px-3 py-2">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="thumbs-up" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-lg font-semibold tabular-nums">@((_reviewer.HelpfulVotes / 1000.0).ToString("F1"))k</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground">Helpful</span>
                    </div>
                    <div class="rounded-md bg-muted/50 px-3 py-2">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-lg font-semibold tabular-nums">@_reviewer.PercentileRank%</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground">Percentile</span>
                    </div>
                </div>

                @* Achievements *@
                <div class="mt-4">
                    <span class="text-xs font-medium text-muted-foreground">Achievements</span>
                    <div class="mt-2 space-y-1.5">
                        @foreach (var ach in _reviewer.Achievements)
                        {
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="@GetAchievementIcon(ach.Icon)" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                <span class="flex-1 truncate text-xs">@ach.Label</span>
                                <span class="text-[10px] text-muted-foreground">@ach.EarnedDate</span>
                            </div>
                        }
                    </div>
                </div>

                @* Expertise areas *@
                <div class="mt-4">
                    <span class="text-xs font-medium text-muted-foreground">Expertise</span>
                    <div class="mt-2 space-y-2">
                        @foreach (var exp in _reviewer.Expertise)
                        {
                            <div class="space-y-1">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-muted-foreground">@exp.Category</span>
                                    <span class="text-[10px] tabular-nums text-muted-foreground">@exp.ReviewCount</span>
                                </div>
                                <ProgressCn Value="@((double)exp.ReviewCount / _maxExpertiseReviews * 100)" Class="h-1" aria-label="Progress" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Right content *@
            <div class="flex flex-col">
                @* Tab switcher *@
                <div class="flex items-center gap-1 border-b px-4 py-2">
                    <button
                        type="button"
                        @onclick="@(() => _activeTab = "reviews")"
                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs transition-colors", _activeTab == "reviews" ? "bg-muted/80 font-medium" : "text-muted-foreground hover:bg-muted/40 hover:text-foreground")">
                        Top Reviews
                    </button>
                    <button
                        type="button"
                        @onclick="@(() => _activeTab = "activity")"
                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs transition-colors", _activeTab == "activity" ? "bg-muted/80 font-medium" : "text-muted-foreground hover:bg-muted/40 hover:text-foreground")">
                        Activity
                    </button>
                </div>

                @* Content area *@
                @if (_activeTab == "reviews")
                {
                    <div class="divide-y">
                        @foreach (var review in _reviewer.TopReviews)
                        {
                            <div class="px-4 py-3.5">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium">@review.Product</span>
                                            @if (review.Verified)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                                            }
                                        </div>
                                        <div class="mt-1 flex items-center gap-2">
                                            <div class="flex items-center gap-0.5">
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    var starIndex = i;
                                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < review.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" aria-hidden="true" />
                                                }
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="px-1.5 py-0 text-[10px] font-normal">
                                                @review.Category
                                            </BadgeCn>
                                        </div>
                                    </div>
                                    <span class="shrink-0 text-xs text-muted-foreground">@review.Date</span>
                                </div>
                                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">@review.Excerpt</p>
                                <div class="mt-2 flex items-center gap-1 text-xs text-muted-foreground">
                                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                    <span class="tabular-nums">@review.HelpfulVotes</span>
                                    <span>found helpful</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="relative px-4 py-3">
                        @* Timeline line *@
                        <div class="absolute bottom-0 left-[29px] top-3 w-px bg-border"></div>

                        <div class="space-y-4">
                            @foreach (var evt in _reviewer.RecentActivity)
                            {
                                <div class="relative flex gap-3 pl-4">
                                    <span class="@Cn.Merge("relative z-10 mt-1.5 size-2 shrink-0 rounded-full", GetActivityColor(evt.Type))"></span>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-sm font-medium">@evt.Title</span>
                                            <span class="shrink-0 text-[10px] text-muted-foreground">@evt.Date</span>
                                        </div>
                                        <p class="mt-0.5 text-xs text-muted-foreground">@evt.Description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string _activeTab = "reviews";

    private static string GetAchievementIcon(string iconKey) => iconKey switch
    {
        "award" => "award",
        "shield" => "shield-check",
        "trending" => "trending-up",
        "check" => "check-circle-2",
        _ => "award"
    };

    private static string GetActivityColor(string activityType) => activityType switch
    {
        "review" => "bg-blue-500",
        "milestone" => "bg-emerald-500",
        "badge" => "bg-amber-500",
        _ => "bg-muted"
    };

    private record ExpertiseArea(string Category, int ReviewCount, double AvgRating);
    private record Achievement(string Id, string Label, string Icon, string EarnedDate);
    private record ReviewItem(string Id, string Product, string Category, int Rating, string Excerpt, int HelpfulVotes, string Date, bool Verified);
    private record ActivityEvent(string Id, string Type, string Title, string Description, string Date);
    private record Reviewer(
        string Name, string Initials, string Handle, string MemberSince, string Bio,
        int ReviewCount, double AverageRating, int HelpfulVotes, int PercentileRank,
        ExpertiseArea[] Expertise, Achievement[] Achievements,
        ActivityEvent[] RecentActivity, ReviewItem[] TopReviews);

    private static readonly Reviewer _reviewer = new(
        Name: "Morgan Chen",
        Initials: "MC",
        Handle: "@morganreviews",
        MemberSince: "January 2023",
        Bio: "Product enthusiast specializing in audio equipment, peripherals, and home office setups. I test everything for at least 2 weeks before reviewing.",
        ReviewCount: 147,
        AverageRating: 4.2,
        HelpfulVotes: 2847,
        PercentileRank: 97,
        Expertise:
        [
            new("Audio Equipment", 38, 4.3),
            new("Peripherals", 31, 4.1),
            new("Home Office", 27, 4.4),
            new("Monitors", 22, 4.0),
            new("Keyboards", 18, 4.5),
            new("Webcams", 11, 3.9),
        ],
        Achievements:
        [
            new("a1", "Top 3% Reviewer", "award", "Mar 2026"),
            new("a2", "Verified Expert", "shield", "Jan 2026"),
            new("a3", "100+ Reviews", "trending", "Nov 2025"),
            new("a4", "Trusted Voice", "check", "Aug 2025"),
        ],
        RecentActivity:
        [
            new("e1", "review", "Reviewed Sennheiser HD 660S2", "Rated 5 stars with detailed audio frequency analysis", "2 days ago"),
            new("e2", "milestone", "Reached 2,800 helpful votes", "Crossed the 2,800 helpful vote milestone", "4 days ago"),
            new("e3", "review", "Reviewed Logitech MX Master 3S", "Rated 4 stars with ergonomic breakdown", "1 week ago"),
            new("e4", "badge", "Earned Top 3% Reviewer badge", "Recognized as a top contributor", "2 weeks ago"),
            new("e5", "review", "Reviewed LG 27GP950-B Monitor", "Rated 4 stars with color accuracy measurements", "3 weeks ago"),
        ],
        TopReviews:
        [
            new("tr1", "Sony WH-1000XM5 Headphones", "Audio Equipment", 5,
                "The noise cancellation is a genuine leap forward. I tested these in a busy cafe, on a commuter train, and in an open office. In every scenario they created a near-silent bubble. The multipoint Bluetooth is seamless between laptop and phone.",
                234, "Jan 15, 2026", true),
            new("tr2", "Ultrawide Monitor 34\" QHD", "Monitors", 5,
                "Exceptional color accuracy and the curved panel reduces eye strain during long work sessions. The USB-C hub with 90W charging replaced my entire dock setup. Build quality is solid with minimal backlight bleed.",
                189, "Feb 8, 2026", true),
            new("tr3", "Keychron Q1 Pro Keyboard", "Keyboards", 4,
                "Excellent build quality with a satisfying typing feel out of the box. The gasket mount noticeably reduces ping compared to tray mount keyboards at this price. QMK/VIA support is a huge bonus for customization.",
                156, "Mar 2, 2026", true),
        ]
    );

    private static readonly int _maxExpertiseReviews = _reviewer.Expertise.Max(e => e.ReviewCount);
}
