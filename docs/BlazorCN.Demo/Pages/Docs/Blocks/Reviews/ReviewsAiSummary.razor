@* ============================================================
   Block: reviews-ai-summary
   Title: ReviewsAiSummary
   Description: A premium AI-generated review summary block for React and Next.js with sentiment score analysis, extracted key themes with mention counts, pros and cons split panel, confidence indicators, and supporting review quotes with staggered entrance animations. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/reviews/reviews-ai-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="brain-circuit" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">AI Review Analysis</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                @_totalAnalyzed reviews analyzed
            </BadgeCn>
            <span class="ml-auto text-[10px] text-muted-foreground">
                Last updated @_analysisDate
            </span>
        </div>

        @* Sentiment Score + Themes side-by-side *@
        <div class="grid grid-cols-5 border-b">
            @* Left: Sentiment score (2 cols) *@
            <div class="col-span-2 flex flex-col items-center justify-center border-r px-4 py-6">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Sentiment
                </span>
                <span class="@($"mt-1 text-4xl font-semibold tabular-nums {_sentimentColor}")">
                    @_sentimentScore
                </span>
                <span class="text-xs text-muted-foreground">/100</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-2 text-xs font-normal">
                    @_sentimentLabel
                </BadgeCn>
                <div class="mt-3 flex items-center gap-1.5">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">
                        @_confidenceLevel% confidence
                    </span>
                </div>
            </div>

            @* Right: Key themes (3 cols) *@
            <div class="col-span-3 px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Key themes</span>
                <div class="mt-3 space-y-2">
                    @foreach (var thm in _themes)
                    {
                        <div class="flex items-center gap-2.5">
                            <span class="@($"size-1.5 shrink-0 rounded-full {ThemeSentimentDot(thm.Sentiment)}")"></span>
                            <span class="min-w-0 flex-1 text-xs">@thm.Label</span>
                            <div class="h-1 w-16 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/20"
                                     style="@($"width:{(int)((double)thm.Mentions / _themes[0].Mentions * 100)}%")">
                                </div>
                            </div>
                            <span class="w-8 text-right text-[10px] tabular-nums text-muted-foreground">
                                @thm.Mentions
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Pros and Cons split panel *@
        <div class="grid grid-cols-2 border-b">
            @* Pros *@
            <div class="border-r px-4 py-3">
                <div class="mb-2.5 flex items-center gap-1.5">
                    <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                    <span class="text-xs font-medium text-muted-foreground">Common praise</span>
                </div>
                <ul class="space-y-2">
                    @foreach (var item in _praise)
                    {
                        <li class="flex items-start gap-2">
                            <span class="min-w-0 flex-1 text-sm leading-snug">@item.Text</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                                @item.Frequency%
                            </BadgeCn>
                        </li>
                    }
                </ul>
            </div>

            @* Cons *@
            <div class="px-4 py-3">
                <div class="mb-2.5 flex items-center gap-1.5">
                    <LucideIconCn Name="minus-circle" Size="12" Class="size-3 text-red-500" />
                    <span class="text-xs font-medium text-muted-foreground">Common complaints</span>
                </div>
                <ul class="space-y-2">
                    @foreach (var item in _complaints)
                    {
                        <li class="flex items-start gap-2">
                            <span class="min-w-0 flex-1 text-sm leading-snug">@item.Text</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                                @item.Frequency%
                            </BadgeCn>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Supporting quotes expandable *@
        <div>
            <button type="button"
                    @onclick="@(() => _quotesExpanded = !_quotesExpanded)"
                    class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <LucideIconCn Name="quote" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium">Supporting quotes</span>
                <span class="text-xs text-muted-foreground">
                    @_supportingQuotes.Length selected
                </span>
                <div class="ml-auto @(_quotesExpanded ? "rotate-180" : "") transition-transform duration-200">
                    <LucideIconCn Name="chevron-down" Size="14" Class="size-3.5 text-muted-foreground/60" />
                </div>
            </button>

            @if (_quotesExpanded)
            {
                <div class="overflow-hidden border-t">
                    <div class="space-y-0">
                        @for (var qi = 0; qi < _supportingQuotes.Length; qi++)
                        {
                            var quote = _supportingQuotes[qi];
                            var isLast = qi == _supportingQuotes.Length - 1;
                            <div class="@(isLast ? "px-4 py-3" : "border-b px-4 py-3")">
                                <div class="flex items-start gap-3">
                                    <AvatarCn Class="size-6 shrink-0">
                                        <AvatarFallbackCn Class="text-[9px]">@quote.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-medium">@quote.Author</span>
                                            <div class="flex items-center gap-0.5">
                                                @for (var di = 0; di < 5; di++)
                                                {
                                                    var dotIdx = di;
                                                    <span class="@($"size-1 rounded-full {(dotIdx < quote.Rating ? "bg-foreground" : "bg-muted-foreground/30")}")"></span>
                                                }
                                            </div>
                                        </div>
                                        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                            @quote.Text
                                        </p>
                                        <span class="mt-1.5 inline-block rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">
                                            Key phrase: &ldquo;@quote.HighlightedPhrase&rdquo;
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-[10px] text-muted-foreground">
                    AI analysis of @_totalAnalyzed reviews
                </span>
            </div>
            <span class="text-[10px] text-muted-foreground">
                @_confidenceLevel% confidence score
            </span>
        </div>
    </div>
</section>

@code {
    private record Theme(string Label, int Mentions, string Sentiment);
    private record InsightItem(string Text, int Frequency);
    private record SupportingQuote(string Id, string Author, string Initials, int Rating, string Text, string HighlightedPhrase);

    private const int _sentimentScore = 87;
    private const int _confidenceLevel = 94;
    private const int _totalAnalyzed = 142;
    private const string _analysisDate = "Apr 3, 2026";

    private const string _sentimentColor =
        "text-emerald-600 dark:text-emerald-400"; // sentimentScore >= 80

    private const string _sentimentLabel = "Positive"; // sentimentScore >= 80

    private static string ThemeSentimentDot(string sentiment) => sentiment switch
    {
        "positive" => "bg-emerald-500",
        "neutral"  => "bg-amber-500",
        _          => "bg-red-500",
    };

    private static readonly Theme[] _themes =
    [
        new("Ease of use",       34, "positive"),
        new("Performance",       28, "positive"),
        new("Customer support",  22, "positive"),
        new("Documentation",     18, "neutral"),
        new("Value for money",   15, "positive"),
        new("Mobile experience", 11, "negative"),
    ];

    private static readonly InsightItem[] _praise =
    [
        new("Intuitive interface with minimal learning curve", 78),
        new("Fast response times even under heavy load",       65),
        new("Support team resolves issues within hours",       52),
        new("TypeScript types are thorough and helpful",       44),
    ];

    private static readonly InsightItem[] _complaints =
    [
        new("Mobile app lacks some desktop features",            31),
        new("Advanced reporting requires manual CSV export",     24),
        new("Onboarding emails could be more targeted",          18),
        new("Data table struggles with very large datasets",     12),
    ];

    private static readonly SupportingQuote[] _supportingQuotes =
    [
        new("sq1", "Marcus Cole",  "MC", 5,
            "Switched from a competitor six months ago and haven't looked back. The interface is clean, fast, and everything just works.",
            "everything just works"),
        new("sq2", "Rachel Kim",   "RK", 4,
            "The dashboard gives us exactly the metrics we need. Only wish the mobile app had feature parity with the desktop version.",
            "exactly the metrics we need"),
        new("sq3", "David Okoye",  "DO", 5,
            "The API documentation is excellent. We had our integration running in production within two days with zero issues.",
            "running in production within two days"),
    ];

    private bool _quotesExpanded = false;
}
