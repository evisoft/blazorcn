@* ========================================
   Block: reviews-reactions
   Title: Reviews Reactions
   Description: Review card with multiple reaction buttons and report functionality for React community platforms
   Long Description: Star rating summary component with breakdown bars and review stats for React ecommerce product pages
   Dependencies: LucideCheckCn, LucideFlagCn, LucideStarCn
   Source: original/blocks/reviews/reviews-reactions.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Customer Review</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Header *@
                <div class="mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="h-12 w-12">
                            <AvatarImageCn Alt="@_authorName" Src="@_authorAvatar" />
                            <AvatarFallbackCn>@GetInitials(_authorName)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold">@_authorName</span>
                                @if (_verified)
                                {
                                    <BadgeCn Class="gap-1" Variant="BadgeVariant.Secondary">
                                        <LucideCheckCn Size="12" Class="h-3 w-3" />
                                        Verified
                                    </BadgeCn>
                                }
                            </div>
                            <p class="text-sm text-muted-foreground">@_authorTitle</p>
                        </div>
                    </div>
                    <time class="text-sm text-muted-foreground">@_reviewDate</time>
                </div>

                @* Rating and Title *@
                <div class="mb-4">
                    <div class="mb-2 flex items-center gap-2">
                        <div class="flex items-center gap-0.5">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var star = i;
                                <LucideStarCn Size="16" Class="@($"h-4 w-4 {(star <= _rating ? "fill-primary text-primary" : "fill-muted text-muted")}")" />
                            }
                        </div>
                        <span class="text-sm font-medium">@_rating/5</span>
                    </div>
                    <h2 class="text-lg font-semibold">@_reviewTitle</h2>
                </div>

                @* Content *@
                <p class="@Cn.Merge("text-muted-foreground", _isExpanded ? "" : "line-clamp-3")">
                    @_reviewContent
                </p>

                <ButtonCn Class="mt-2 h-auto p-0" Variant="ButtonVariant.Link" @onclick="() => _isExpanded = !_isExpanded">
                    @(_isExpanded ? "Show less" : "Read more")
                </ButtonCn>

                <SeparatorCn Class="my-4" />

                @* Reactions *@
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex flex-wrap gap-2">
                        @foreach (var reaction in _reactionTypes)
                        {
                            var type = reaction;
                            <ButtonCn Class="h-8 gap-1 rounded-full text-xs capitalize"
                                      Size="ButtonSize.Sm"
                                      Variant="@(_activeReactions.Contains(type) ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      @onclick="() => ToggleReaction(type)">
                                @type
                                <span class="font-normal">(@GetReactionCount(type))</span>
                            </ButtonCn>
                        }
                    </div>

                    <ButtonCn Class="@Cn.Merge("h-8 gap-1 text-xs", _isReported ? "text-destructive" : "text-muted-foreground")"
                              Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Ghost"
                              @onclick="() => _isReported = !_isReported">
                        <LucideFlagCn Size="12" Class="h-3 w-3" />
                        @(_isReported ? "Reported" : "Report")
                    </ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isExpanded;
    private bool _isReported;
    private readonly HashSet<string> _activeReactions = new();

    private int _usefulCount = 24;
    private int _helpfulCount = 17;
    private int _insightfulCount = 9;

    private static readonly string[] _reactionTypes = ["useful", "helpful", "insightful"];

    private const string _authorName = "Adam Smith";
    private const string _authorTitle = "Verified Customer";
    private const string _authorAvatar = "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80";
    private const string _reviewDate = "August 15, 2024";
    private const int _rating = 5;
    private const bool _verified = true;
    private const string _reviewTitle = "Exceeded my expectations in every way";
    private const string _reviewContent = "I've been using this product daily for about a month now, and I can honestly say it has transformed my routine. The quality is exceptional compared to similar items I've tried before. It's durable, well-designed, and the attention to detail is evident. The customer service experience was also outstanding when I had a question about maintenance. Highly recommend to anyone looking for a reliable solution that actually delivers on its promises. The packaging was also eco-friendly which I appreciated.";

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private int GetReactionCount(string type) => type switch
    {
        "useful" => _usefulCount,
        "helpful" => _helpfulCount,
        "insightful" => _insightfulCount,
        _ => 0
    };

    private void ToggleReaction(string type)
    {
        if (_activeReactions.Contains(type))
        {
            _activeReactions.Remove(type);
            AdjustCount(type, -1);
        }
        else
        {
            _activeReactions.Add(type);
            AdjustCount(type, 1);
        }
    }

    private void AdjustCount(string type, int delta)
    {
        switch (type)
        {
            case "useful": _usefulCount += delta; break;
            case "helpful": _helpfulCount += delta; break;
            case "insightful": _insightfulCount += delta; break;
        }
    }
}
