@* ============================================================
   Block: reviews-service-provider
   Title: ReviewsServiceProvider
   Description: A service provider review block for React and Next.js with provider profile sidebar, multi-criteria ratings, verified hire badges, service tags, and response time stats using shadcn/ui Avatar, Progress, Badge, and Tailwind CSS.
   Source: original/blocks/reviews/reviews-service-provider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Provider Reviews</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-foreground text-foreground" />
                <span class="text-sm font-semibold tabular-nums">@_provider.OverallRating</span>
                <span class="text-xs text-muted-foreground">(@(_provider.TotalReviews) reviews)</span>
            </div>
        </div>

        @* Sidebar + Content *@
        <div class="grid grid-cols-1 md:grid-cols-5">
            @* Provider sidebar *@
            <div class="border-b p-4 md:col-span-2 md:border-b-0 md:border-r">
                @* Provider identity *@
                <div class="flex items-center gap-3">
                    <AvatarCn Class="size-10">
                        <AvatarFallbackCn Class="text-sm font-medium">@_provider.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <span class="text-sm font-medium">@_provider.Name</span>
                        <span class="block text-xs text-muted-foreground">@_provider.Trade</span>
                    </div>
                </div>

                @* Quick stats *@
                <div class="mt-4 grid grid-cols-2 gap-2">
                    <div class="rounded-md bg-muted/50 px-2.5 py-2">
                        <span class="text-lg font-semibold tabular-nums">@_provider.CompletedJobs</span>
                        <span class="block text-[10px] text-muted-foreground">Jobs completed</span>
                    </div>
                    <div class="rounded-md bg-muted/50 px-2.5 py-2">
                        <span class="text-lg font-semibold tabular-nums">@_provider.MemberSince</span>
                        <span class="block text-[10px] text-muted-foreground">Member since</span>
                    </div>
                </div>

                @* Info rows *@
                <div class="mt-4 space-y-2.5">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">
                            Response: @_provider.ResponseTime
                        </span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">@_provider.ServiceArea</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="phone" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">@_provider.Availability</span>
                    </div>
                </div>

                <hr class="my-4 border-border" />

                @* Category breakdown *@
                <span class="text-xs font-medium text-muted-foreground">Rating breakdown</span>
                <div class="mt-2.5 space-y-2">
                    @foreach (var cat in _provider.Categories)
                    {
                        <div class="flex items-center gap-2">
                            <span class="w-24 shrink-0 text-xs text-muted-foreground">@cat.Name</span>
                            <ProgressCn Value="@((int)((cat.Score / 5.0) * 100))" Class="h-1 flex-1" />
                            <span class="w-7 text-right text-xs font-medium tabular-nums">@cat.Score.ToString("F1")</span>
                        </div>
                    }
                </div>
            </div>

            @* Reviews content *@
            <div class="md:col-span-3">
                @foreach (var review in _reviews)
                {
                    var reviewId = review.Id;
                    var isExpanded = _expandedId == reviewId;
                    var isLast = reviewId == _reviews[_reviews.Length - 1].Id;
                    <div class="@(isLast ? "" : "border-b")">
                        <button type="button"
                                @onclick="@(() => SetExpanded(reviewId, isExpanded))"
                                class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            @* Author + meta *@
                            <div class="flex items-center gap-2">
                                <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                    @review.Author.Initials
                                </div>
                                <span class="text-xs font-medium">@review.Author.Name</span>
                                @if (review.VerifiedHire)
                                {
                                    <span class="flex items-center gap-0.5 text-[10px] text-emerald-600 dark:text-emerald-400">
                                        <LucideIconCn Name="badge-check" Size="12" Class="size-3" />
                                        Verified hire
                                    </span>
                                }
                                <span class="text-xs text-muted-foreground">@review.Date</span>
                            </div>

                            @* Stars + cost *@
                            <div class="mt-1.5 flex items-center gap-2">
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var starIndex = i;
                                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                    }
                                </div>
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @review.ProjectCost
                                </span>
                            </div>

                            @* Service tags *@
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var service in review.Services)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        <LucideIconCn Name="wrench" Size="10" Class="mr-0.5 size-2.5" />
                                        @service
                                    </BadgeCn>
                                }
                            </div>

                            @* Comment preview *@
                            <p class="@Cn.Merge("mt-2 text-sm leading-relaxed text-muted-foreground", isExpanded ? "" : "line-clamp-2")">
                                @review.Comment
                            </p>
                        </button>

                        @* Expanded details *@
                        @if (isExpanded)
                        {
                            <div class="px-4 pb-4">
                                @* Per-review category scores *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Detailed ratings
                                    </span>
                                    <div class="mt-2 space-y-1.5">
                                        @foreach (var cat in review.Categories)
                                        {
                                            <div class="flex items-center gap-2">
                                                <span class="w-24 shrink-0 text-xs text-muted-foreground">@cat.Name</span>
                                                <ProgressCn Value="@((int)((cat.Score / 5.0) * 100))" Class="h-1 flex-1" />
                                                <span class="w-4 text-right text-xs tabular-nums text-muted-foreground">@cat.Score</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* Provider response *@
                                @if (review.ProviderResponse != null)
                                {
                                    <div class="mt-2 rounded-md border-l-2 border-l-blue-500 bg-muted/30 p-3">
                                        <span class="text-[10px] font-medium text-muted-foreground">
                                            Provider response
                                        </span>
                                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                            @review.ProviderResponse
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CategoryScore(string Name, double Score);

    private record AuthorInfo(string Name, string Initials);

    private record ProviderProfile(
        string Name,
        string Initials,
        string Trade,
        double OverallRating,
        int TotalReviews,
        string ResponseTime,
        string ServiceArea,
        string Availability,
        string MemberSince,
        int CompletedJobs,
        CategoryScore[] Categories
    );

    private record ServiceReview(
        string Id,
        AuthorInfo Author,
        string Date,
        int Rating,
        bool VerifiedHire,
        string[] Services,
        string ProjectCost,
        string Comment,
        CategoryScore[] Categories,
        string? ProviderResponse
    );

    private string? _expandedId = null;

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expandedId = isCurrentlyExpanded ? null : id;
    }

