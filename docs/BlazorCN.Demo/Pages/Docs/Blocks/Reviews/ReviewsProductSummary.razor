@* ========================================
   Block: reviews-product-summary
   Title: Reviews Product Summary
   Description: Product rating summary card with image, breakdown bars, and action buttons for React storefronts
   Long Description: Photo review gallery with lightbox viewer and customer images for React ecommerce product pages
   Dependencies: LucideStarCn
   Source: original/blocks/reviews/reviews-product-summary.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Rating</h1>
    </div>

    <div class="mx-auto w-[500px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Product Info *@
                <div class="mb-6 flex flex-wrap items-start gap-4">
                    <img alt="@_product.Name" class="h-32 w-32 rounded-md object-cover" height="128"
                         src="@_product.Image" width="128" />
                    <div class="flex-1 space-y-2">
                        <h2 class="text-lg font-semibold">@_product.Name</h2>
                        @if (!string.IsNullOrEmpty(_product.Badge))
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary">@_product.Badge</BadgeCn>
                        }
                    </div>
                </div>

                @* Average Rating *@
                <div class="mb-6 flex flex-wrap items-center gap-4">
                    <span class="text-5xl font-bold">@_product.Average</span>
                    <div>
                        <div class="flex items-center gap-0.5">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <LucideStarCn Class="@Cn.Merge("h-4 w-4", star <= (int)Math.Round(_product.Average) ? "fill-primary text-primary" : "fill-muted text-muted")" Size="16" />
                            }
                        </div>
                        <p class="mt-1 text-sm text-muted-foreground">
                            @_product.Total.ToString("N0") reviews
                        </p>
                    </div>
                </div>

                @* Rating Breakdown *@
                <div class="mb-6 space-y-2">
                    @foreach (var level in _product.Breakdown)
                    {
                        <div class="flex items-center gap-3">
                            <div class="flex w-12 items-center gap-1">
                                <LucideStarCn Class="h-3 w-3 fill-muted-foreground text-muted-foreground" Size="12" />
                                <span class="text-sm">@level.Stars</span>
                            </div>
                            <ProgressCn Class="h-2 flex-1" Value="@level.Percentage" aria-label="Progress" />
                            <span class="w-20 text-right text-sm text-muted-foreground">
                                @level.Percentage% (@level.Count)
                            </span>
                        </div>
                    }
                </div>

                @* Actions *@
                <div class="space-y-2">
                    <ButtonCn Class="w-full">Write a Review</ButtonCn>
                    <ButtonCn Class="w-full" Variant="ButtonVariant.Ghost">See All Reviews</ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record RatingLevel(int Stars, int Count, int Percentage);
    private record ProductRating(string Image, string Name, string? Badge, double Average, int Total, RatingLevel[] Breakdown);

    private static readonly ProductRating _product = new(
        "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&w=300&q=80",
        "Ultra Backpack Pro - 2025 Edition",
        "Top Rated",
        4.5,
        1284,
        [
            new(5, 963, 75),
            new(4, 257, 20),
            new(3, 51, 4),
            new(2, 10, 1),
            new(1, 3, 0),
        ]
    );
}
