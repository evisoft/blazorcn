            Body = "Great product! Also check out best-deals.com for amazing software discounts. Click here for 90% off all development tools. Limited time offer!!! Visit now for exclusive deals.",
            SubmittedAt = "8 min ago",
            FlagReasons =
            [
                new("Spam / promotional content", "critical", "shield-alert"),
                new("Contains external links", "warning", "link"),
            ],
            ReportCount = 7,
            PurchaseVerified = false,
        },
        new()
        {
            Id = "mod-2",
            Author = new("Chris Anderson", "chris.a@example.com", "CA", 3, "Jan 12, 2026"),
            Product = "Dashboard Pro Kit",
            Rating = 1,
            Title = "Terrible experience, nothing works after update",
            Body = "Every component broke after updating to v3.2. No migration guide, no changelog entry for breaking changes. Wasted two days rolling back. The sidebar component throws hydration errors on every page load.",
            SubmittedAt = "32 min ago",
            FlagReasons =
            [
                new("Potentially abusive language", "warning", "message-square-warning"),
            ],
            ReportCount = 1,
            PurchaseVerified = true,
        },
        new()
        {
            Id = "mod-3",
            Author = new("Rebecca Torres", "r.torres@company.io", "RT", 8, "Sep 3, 2025"),
            Product = "Form Builder Kit",
            Rating = 4,
            Title = "Solid but needs better mobile support",
            Body = "Desktop experience is flawless. On mobile, some components do not resize well below 320px. The drawer component specifically has issues with swipe gestures on iOS Safari. Filed a detailed bug report with screenshots.",
            SubmittedAt = "1 hr ago",
            FlagReasons =
            [
                new("Review may reference beta features", "low", "alert-triangle"),
            ],
            ReportCount = 0,
            PurchaseVerified = true,
        },
        new()
        {
            Id = "mod-4",
            Author = new("James Wright", "j.wright@email.com", "JW", 12, "Jun 15, 2025"),
            Product = "Auth Module",
            Rating = 2,
            Title = "Overrated compared to alternatives",
            Body = "The copy-paste model is inconvenient for large teams and the lack of a proper package registry means version management is painful. We switched to a compiled alternative after three months of maintenance overhead.",
            SubmittedAt = "2 hr ago",
            FlagReasons = [],
            ReportCount = 0,
            PurchaseVerified = true,
        },
        new()
        {
            Id = "mod-5",
            Author = new("Mei Lin", "mei.lin@startup.co", "ML", 5, "Nov 20, 2025"),
            Product = "Chart Components",
            Rating = 5,
            Title = "Perfect for our startup MVP",
            Body = "We shipped our MVP in two weeks using these components. The design quality is professional enough for investor demos and the accessibility defaults saved us from common WCAG pitfalls during our compliance audit.",
            SubmittedAt = "3 hr ago",
            FlagReasons = [],
            ReportCount = 0,
            PurchaseVerified = true,
        },
    };

    private Dictionary<string, string> _processedIds = new();

    private int _pendingCount => _reviews.Count(r => !_processedIds.ContainsKey(r.Id));
    private int _processedCount => _processedIds.Count;

    private async Task HandleAction(string id, string action)
    {
        _processedIds[id] = action;
        await Task.Delay(600);
        _reviews.RemoveAll(r => r.Id == id);
        _processedIds.Remove(id);
    }
}
