@* ============================================================
   Block: reviews-social-feed
   Title: ReviewsSocialFeed
   Description: An interactive social media-style review feed for React and Next.js with like toggle, comment thread expansion, bookmark save, share action, reply input, image attachments, and engagement metrics built with shadcn/ui Avatar, Button, and Input components, motion/react AnimatePresence animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-social-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 shrink-0">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Review Feed</span>
                <span class="rounded-full bg-foreground px-1.5 py-0.5 text-[10px] font-medium text-background tabular-nums">
                    @_reviews.Length
                </span>
            </div>
            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                <span class="tabular-nums">@(_reviews.Sum(r => r.Likes)) likes</span>
                <span class="tabular-nums">@(_reviews.Sum(r => r.Comments.Length)) comments</span>
            </div>
        </div>

        @* Scrollable feed *@
        <div class="flex-1 overflow-y-auto">
            @foreach (var review in _reviews)
            {
                var reviewId = review.Id;
                var isLikedByUser = _liked.ContainsKey(reviewId) && _liked[reviewId];
                var isBookmarkedByUser = _bookmarked.ContainsKey(reviewId) && _bookmarked[reviewId];
                var isCommentsExpanded = _expandedComments.ContainsKey(reviewId) && _expandedComments[reviewId];
                var isLast = reviewId == _reviews[_reviews.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        @* Author header *@
                        <div class="flex items-center gap-2.5">
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-xs font-medium">@review.Author.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@review.Author.Name</span>
                                    <span class="rounded-full bg-muted px-1.5 py-0.5 text-[10px] text-muted-foreground">
                                        @review.Author.Badge
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 text-[10px] text-muted-foreground">
                                    <span>@review.TimeAgo</span>
                                    <span>reviewed @review.Product</span>
                                    <span class="tabular-nums">@review.Author.ReviewCount reviews</span>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0 text-muted-foreground" aria-label="More options">
                                <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                            </ButtonCn>
                        </div>

                        @* Rating and title *@
                        <div class="mt-2.5 flex items-center gap-2">
                            <div class="flex items-center gap-0.5">
                                @for (var i = 0; i < 5; i++)
                                {
                                    var starIndex = i;
                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < review.Rating ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
                                }
                            </div>
                            <span class="text-sm font-medium">@review.Title</span>
                        </div>

                        @* Body *@
                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">@review.Body</p>

                        @* Image indicator *@
                        @if (review.Images > 0)
                        {
                            <div class="mt-2 flex items-center gap-1.5 text-xs text-muted-foreground">
                                <LucideIconCn Name="image" Size="14" Class="size-3.5" />
                                <span class="tabular-nums">@review.Images photos attached</span>
                            </div>
                        }

                        @* Action bar *@
                        <div class="mt-2.5 flex items-center justify-between">
                            <div class="flex items-center gap-1">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="@Cn.Merge("h-7 gap-1 px-2 text-xs", isLikedByUser ? "text-red-600 dark:text-red-400" : "text-muted-foreground")"
                                          @onclick="@(() => HandleLike(reviewId))">
                                    <LucideIconCn Name="heart" Size="14" Class="@Cn.Merge("size-3.5", isLikedByUser ? "fill-current" : "")" />
                                    <span class="tabular-nums">@review.Likes</span>
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="@Cn.Merge("h-7 gap-1 px-2 text-xs", isCommentsExpanded ? "text-foreground" : "text-muted-foreground")"
                                          @onclick="@(() => ToggleComments(reviewId))">
                                    <LucideIconCn Name="message-circle" Size="14" Class="@Cn.Merge("size-3.5", isCommentsExpanded ? "fill-current" : "")" />
                                    <span class="tabular-nums">@review.Comments.Length</span>
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="h-7 gap-1 px-2 text-xs text-muted-foreground">
                                    <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                                    <span class="tabular-nums">@review.Shares</span>
                                </ButtonCn>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="@Cn.Merge("size-7 p-0", isBookmarkedByUser ? "text-foreground" : "text-muted-foreground")"
                                      aria-label="@(isBookmarkedByUser ? "Remove bookmark" : "Bookmark review")"
                                      @onclick="@(() => HandleBookmark(reviewId))">
                                <LucideIconCn Name="bookmark" Size="14" Class="@Cn.Merge("size-3.5", isBookmarkedByUser ? "fill-current" : "")" />
                            </ButtonCn>
                        </div>

                        @* Comment thread *@
                        @if (isCommentsExpanded)
                        {
                            <div class="overflow-hidden">
                                <div class="mt-2 border-t pt-2">
                                    @if (review.Comments.Length > 0)
                                    {
                                        <div class="space-y-2">
                                            @foreach (var comment in review.Comments)
                                            {
                                                <div class="flex items-start gap-2">
                                                    <AvatarCn Class="size-5 shrink-0">
                                                        <AvatarFallbackCn Class="text-[8px]">@comment.Initials</AvatarFallbackCn>
                                                    </AvatarCn>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="rounded-md bg-muted/50 px-2.5 py-1.5">
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="text-xs font-medium">@comment.Author</span>
                                                                @if (comment.IsAuthor)
                                                                {
                                                                    <span class="rounded bg-foreground/10 px-1 py-0.5 text-[8px] font-medium">Author</span>
                                                                }
                                                                <span class="text-[10px] text-muted-foreground">@comment.TimeAgo</span>
                                                            </div>
                                                            <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">@comment.Text</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="py-1 text-xs text-muted-foreground">No comments yet. Be the first to reply.</p>
                                    }
                                    @* Reply input *@
                                    <div class="mt-2 flex items-center gap-2">
                                        <InputCn aria-label="Write a reply" Placeholder="Write a reply..."
                                                 Class="h-7 text-xs"
                                                 Value="@(_replyTexts.ContainsKey(reviewId) ? _replyTexts[reviewId] : "")"
                                                 ValueChanged="@((string v) => SetReplyText(reviewId, v))" />
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                  Class="size-7 shrink-0 p-0"
                                                  aria-label="Send reply"
                                                  @onclick="@(() => HandleReply(reviewId))"
                                                  Disabled="@(!HasReplyText(reviewId))">
                                            <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ReviewAuthor(string Name, string Initials, string Badge, int ReviewCount);

    private record ReviewComment(string Id, string Author, string Initials, string Text, string TimeAgo, bool IsAuthor);

    private class ReviewPost
    {
        public string Id { get; init; } = "";
        public ReviewAuthor Author { get; init; } = new ReviewAuthor("", "", "", 0);
        public int Rating { get; init; }
        public string Title { get; init; } = "";
        public string Body { get; init; } = "";
        public int Images { get; init; }
        public string TimeAgo { get; init; } = "";
        public string Product { get; init; } = "";
        public int Likes { get; set; }
        public ReviewComment[] Comments { get; set; } = [];
        public int Shares { get; init; }

        public ReviewPost() { }
        public ReviewPost(string id, ReviewAuthor author, int rating, string title, string body, int images, string timeAgo, string product, int likes, ReviewComment[] comments, int shares)
        {
            Id = id; Author = author; Rating = rating; Title = title; Body = body;
            Images = images; TimeAgo = timeAgo; Product = product; Likes = likes;
            Comments = comments; Shares = shares;
        }
    }

    private static readonly ReviewPost[] _initialReviews =
    [
        new ReviewPost(
            "rf-1",
            new ReviewAuthor("Ava Nakamura", "AN", "Top Reviewer", 147),
            5,
            "Best investment for our engineering team",
            "Purchased the pro plan for our agency. We have shipped three client projects using these blocks in the last month. The code quality is consistent and every component follows accessibility best practices. Our junior developers ramp up twice as fast because the patterns are so well established.",
            3,
            "2h ago",
            "Pro Plan",
            63,
            [
                new ReviewComment("c1", "Jordan Ellis", "JE", "Same experience here. The consistency across components is what sold us.", "1h ago", false),
                new ReviewComment("c2", "Ava Nakamura", "AN", "Exactly! It makes code reviews so much faster when everyone uses the same patterns.", "45m ago", true),
            ],
            8
        ),
        new ReviewPost(
            "rf-2",
            new ReviewAuthor("Marcus Chen", "MC", "Verified Buyer", 23),
            4,
            "Great dashboard components, want more chart types",
            "Rebuilt our entire analytics page using five blocks and barely had to modify anything. The data table component handles sorting, filtering, and pagination out of the box. The only thing missing is more chart variants beyond bar and line charts.",
            0,
            "6h ago",
            "Dashboard Blocks",
            28,
            [
                new ReviewComment("c3", "Team Support", "TS", "Thanks for the feedback! More chart types are on our Q3 roadmap. Stay tuned.", "4h ago", false),
            ],
            1
        ),
        new ReviewPost(
            "rf-3",
            new ReviewAuthor("Sofia Petrov", "SP", "Power User", 89),
            5,
            "Replaced our custom component library entirely",
            "We maintained an internal component library for three years. Switching to these blocks cut our bundle size by 30 percent and eliminated an entire maintenance burden. Dark mode support works flawlessly and the tree-shaking means we only ship what we use.",
            2,
            "1d ago",
            "Component Library",
            91,
            [],
            12
        ),
        new ReviewPost(
            "rf-4",
            new ReviewAuthor("Daniel Okafor", "DO", "Verified Buyer", 12),
            5,
            "Form blocks with built-in validation are a game changer",
            "The multi-step form block alone saved us two weeks of development. Proper validation patterns, accessible error messages, and keyboard navigation all built in. Connected to our Zod schemas in under an hour.",
            0,
            "2d ago",
            "Form Blocks",
            37,
            [
                new ReviewComment("c4", "Priya Mehta", "PM", "The Zod integration is seamless. We use it across all our forms now.", "1d ago", false),
                new ReviewComment("c5", "Daniel Okafor", "DO", "Right? And the error boundary handling means forms never crash the page.", "1d ago", true),
            ],
            4
        ),
    ];

    private ReviewPost[] _reviews = _initialReviews.Select(r => new ReviewPost(r.Id, r.Author, r.Rating, r.Title, r.Body, r.Images, r.TimeAgo, r.Product, r.Likes, r.Comments.ToArray(), r.Shares)).ToArray();
    private Dictionary<string, bool> _liked = new();
    private Dictionary<string, bool> _bookmarked = new();
    private Dictionary<string, bool> _expandedComments = new();
    private Dictionary<string, string> _replyTexts = new();

    private void HandleLike(string reviewId)
    {
        var isLiked = _liked.ContainsKey(reviewId) && _liked[reviewId];
        _liked[reviewId] = !isLiked;
        for (var i = 0; i < _reviews.Length; i++)
        {
            if (_reviews[i].Id == reviewId)
            {
                _reviews[i].Likes += isLiked ? -1 : 1;
                break;
            }
        }
    }

    private void HandleBookmark(string reviewId)
    {
        var current = _bookmarked.ContainsKey(reviewId) && _bookmarked[reviewId];
        _bookmarked[reviewId] = !current;
    }

    private void ToggleComments(string reviewId)
    {
        var current = _expandedComments.ContainsKey(reviewId) && _expandedComments[reviewId];
        _expandedComments[reviewId] = !current;
    }

    private void SetReplyText(string reviewId, string value)
    {
        _replyTexts[reviewId] = value;
    }

    private bool HasReplyText(string reviewId)
    {
        return _replyTexts.ContainsKey(reviewId) && !string.IsNullOrWhiteSpace(_replyTexts[reviewId]);
    }

    private void HandleReply(string reviewId)
    {
        if (!HasReplyText(reviewId)) return;
        var text = _replyTexts[reviewId].Trim();
        var review = System.Array.Find(_reviews, r => r.Id == reviewId);
        if (review == null) return;
        var newComment = new ReviewComment(
            $"c-new-{reviewId}-{review.Comments.Length}",
            "You",
            "YO",
            text,
            "Just now",
            false
        );
        var newComments = new ReviewComment[review.Comments.Length + 1];
        review.Comments.CopyTo(newComments, 0);
        newComments[review.Comments.Length] = newComment;
        review.Comments = newComments;
        _replyTexts[reviewId] = "";
    }
}
