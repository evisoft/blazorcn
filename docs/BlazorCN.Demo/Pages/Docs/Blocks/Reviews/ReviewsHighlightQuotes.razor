@* ============================================================
   Block: reviews-highlight-quotes
   Title: ReviewsHighlightQuotes
   Description: A pull-quote showcase block for React and Next.js with large typography featured quotes, animated carousel navigation, source attribution, star ratings, and a compact quote selector panel built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-highlight-quotes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Split panel: Quote | Selector *@
        <div class="flex flex-col md:flex-row">
            @* Left: Featured quote area *@
            <div class="flex flex-1 flex-col border-b md:border-r md:border-b-0">
                @* Quote header *@
                <div class="flex items-center justify-between border-b px-5 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="quote" Size="16" Class="size-4 text-muted-foreground/40" />
                        <span class="font-medium text-sm">Customer Highlights</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <button type="button"
                                @onclick="GoPrev"
                                class="flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                aria-label="Previous quote">
                            <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                        </button>
                        <button type="button"
                                @onclick="GoNext"
                                class="flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                aria-label="Next quote">
                            <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
                        </button>
                    </div>
                </div>

                @* Quote content *@
                <div class="relative flex-1 px-5 py-6">
                    @{
                        var active = _highlights[_activeIndex];
                    }
                    @* Large quote *@
                    <p class="text-base leading-relaxed tracking-tight">
                        &ldquo;@active.Quote&rdquo;
                    </p>

                    @* Attribution *@
                    <div class="mt-5 flex items-center gap-3">
                        <AvatarCn Class="size-9">
                            <AvatarFallbackCn Class="text-xs font-medium">@active.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@active.Author</span>
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var idx = i;
                                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", idx < active.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                                    }
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span>@active.Role at @active.Company</span>
                                <span class="text-muted-foreground/30">&middot;</span>
                                <span>via @active.Source</span>
                            </div>
                        </div>
                    </div>

                    @* Position indicator *@
                    <div class="mt-5 flex items-center gap-1.5">
                        @for (int i = 0; i < _highlights.Length; i++)
                        {
                            var idx = i;
                            <button type="button"
                                    @onclick="@(() => Navigate(idx))"
                                    aria-label="@($"Go to quote {idx + 1}")"
                                    class="group flex items-center">
                                <div class="@Cn.Merge("h-1 rounded-full transition-colors", idx == _activeIndex ? "bg-foreground w-5" : "bg-muted-foreground/20 group-hover:bg-muted-foreground/40 w-1.5")"></div>
                            </button>
                        }
                        <span class="ml-2 text-muted-foreground text-[10px] tabular-nums">
                            @(_activeIndex + 1) / @_highlights.Length
                        </span>
                    </div>
                </div>
            </div>

            @* Right: Quote selector sidebar *@
            <div class="flex w-full flex-col md:w-56">
                <div class="border-b px-4 py-3 md:border-b">
                    <span class="font-medium text-xs text-muted-foreground">All Highlights</span>
                </div>
                <div class="flex flex-row gap-0 overflow-x-auto md:flex-col">
                    @for (int i = 0; i < _highlights.Length; i++)
                    {
                        var idx = i;
                        var h = _highlights[i];
                        <button type="button"
                                @onclick="@(() => Navigate(idx))"
                                class="@Cn.Merge("flex min-w-[180px] flex-col gap-1 px-4 py-3 text-left transition-colors md:min-w-0", idx == _activeIndex ? "bg-muted/50" : "hover:bg-muted/30", idx < _highlights.Length - 1 ? "border-r md:border-r-0 md:border-b" : "")">
                            <div class="flex items-center gap-2">
                                <AvatarCn Class="size-5">
                                    <AvatarFallbackCn Class="text-[8px]">@h.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="@Cn.Merge("font-medium text-xs", idx == _activeIndex ? "text-foreground" : "text-muted-foreground")">
                                    @h.Author
                                </span>
                            </div>
                            <p class="line-clamp-2 text-[11px] leading-tight text-muted-foreground">
                                &ldquo;@h.PullPhrase&rdquo;
                            </p>
                            <div class="flex items-center gap-1.5">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 font-normal text-[9px]">
                                    @h.Industry
                                </BadgeCn>
                                <span class="text-muted-foreground/50 text-[9px]">@h.Source</span>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record HighlightQuote(
        string Id,
        string Quote,
        string PullPhrase,
        string Author,
        string Initials,
        string Role,
        string Company,
        int Rating,
        string Source,
        string Industry
    );

    private static readonly HighlightQuote[] _highlights =
    [
        new("hq-1",
            "This completely transformed our development workflow. What used to take our team days now takes hours. The API is intuitive, the TypeScript types are comprehensive, and the documentation is the best I have seen in any developer tool we have adopted.",
            "What used to take days now takes hours",
            "Katherine Nguyen", "KN", "CTO", "Streamline", 5, "Product Hunt", "Developer Tools"),
        new("hq-2",
            "We evaluated twelve different solutions before choosing this one. Six months in, it has become the backbone of our entire analytics platform. Reliability at ninety-nine point nine percent uptime and sub-hundred-millisecond latency even during our peak Black Friday traffic.",
            "The backbone of our entire analytics platform",
            "Thomas Andersen", "TA", "Lead Engineer", "Nordvik", 5, "G2", "E-Commerce"),
        new("hq-3",
            "The attention to detail sets this apart from every competitor we tested. Every edge case we threw at it was already handled. Our customer support tickets dropped by forty percent after integrating this into our stack, and our engineering team can now focus on product features instead of infrastructure.",
            "Support tickets dropped by forty percent",
            "Priya Sharma", "PS", "VP of Engineering", "Zephyr", 5, "Trustpilot", "SaaS"),
        new("hq-4",
            "Simple to set up, powerful in production. Our team of twenty-five engineers adopted it in under a week. The migration tooling handled our legacy system perfectly and we saw performance gains on day one. Best infrastructure investment we made this year.",
            "Twenty-five engineers adopted it in under a week",
            "Michael Torres", "MT", "Founder and CEO", "Launchpad", 5, "Twitter", "Startup"),
        new("hq-5",
            "After three failed attempts with other solutions, this finally solved our real-time data synchronization challenge. The event-driven architecture handles our scale of two million daily events without breaking a sweat. Customer churn dropped and NPS jumped from thirty-two to sixty-seven.",
            "NPS jumped from thirty-two to sixty-seven",
            "Anika Johansson", "AJ", "Head of Product", "Clarity Analytics", 5, "Capterra", "Analytics"),
    ];

    private int _activeIndex = 0;

    private void Navigate(int newIndex)
    {
        _activeIndex = newIndex;
    }

    private void GoNext()
    {
        var next = _activeIndex < _highlights.Length - 1 ? _activeIndex + 1 : 0;
        Navigate(next);
    }

    private void GoPrev()
    {
        var prev = _activeIndex > 0 ? _activeIndex - 1 : _highlights.Length - 1;
        Navigate(prev);
    }
}
