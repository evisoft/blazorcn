@* ========================================
   Block: reviews-upvote
   Title: Reviews Upvote
   Description: Product Hunt style review card with upvote/downvote voting for product directories
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, SeparatorCn, LucideChevronDownCn, LucideChevronUpCn, LucideClockCn, LucideFlagCn, LucideShare2Cn, LucideTrophyCn
   Source: original/blocks/reviews/reviews-upvote.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Review</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Header *@
                <div class="mb-6 flex items-start justify-between">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="h-12 w-12">
                            <AvatarImageCn Alt="@_authorName" Src="@_authorAvatar" />
                            <AvatarFallbackCn>@GetInitials(_authorName)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold">@_authorName</span>
                                <BadgeCn Class="gap-1 bg-amber-500 hover:bg-amber-600">
                                    <LucideTrophyCn Size="12" />
                                    Hunter
                                </BadgeCn>
                            </div>
                            <p class="text-sm text-muted-foreground">@_authorTitle</p>
                        </div>
                    </div>

                    @* Product Info *@
                    <div class="flex items-center gap-2">
                        <img alt="@_productName" class="h-8 w-8 rounded-lg object-cover" height="32" src="@_productIcon" width="32" />
                        <span class="text-sm font-medium">@_productName</span>
                    </div>
                </div>

                @* Content *@
                <div class="mb-6">
                    <h2 class="mb-4 text-xl font-semibold">@_reviewTitle</h2>
                    <div class="space-y-4 text-muted-foreground">
                        @foreach (var paragraph in DisplayContent)
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                    @if (_paragraphs.Length > 1)
                    {
                        <ButtonCn Class="mt-2 h-auto p-0" Variant="ButtonVariant.Link" @onclick="() => _isExpanded = !_isExpanded">
                            @(_isExpanded ? "Show less" : "Read more")
                        </ButtonCn>
                    }
                </div>

                <SeparatorCn Class="mb-4" />

                @* Actions *@
                <div class="flex flex-wrap items-center justify-between gap-4">
                    @* Voting *@
                    <div class="flex items-center gap-1 rounded-full border">
                        <ButtonCn Class="@Cn.Merge("h-9 rounded-full", _userVote == "up" ? "text-primary" : "")" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick='() => HandleVote("up")'>
                            <LucideChevronUpCn Size="20" />
                        </ButtonCn>
                        <span class="@($"min-w-[2rem] text-center text-sm font-semibold {(NetVotes > 0 ? "text-primary" : NetVotes < 0 ? "text-destructive" : "")}")">
                            @NetVotes
                        </span>
                        <ButtonCn Class="@Cn.Merge("h-9 rounded-full", _userVote == "down" ? "text-destructive" : "")" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick='() => HandleVote("down")'>
                            <LucideChevronDownCn Size="20" />
                        </ButtonCn>
                    </div>

                    @* Other Actions *@
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="h-8 gap-1.5 text-muted-foreground" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                            <LucideShare2Cn Size="16" />
                            Share
                        </ButtonCn>
                        <ButtonCn Class="@Cn.Merge("h-8 gap-1.5", _isReported ? "text-destructive" : "text-muted-foreground")" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _isReported = !_isReported">
                            <LucideFlagCn Size="16" />
                            @(_isReported ? "Reported" : "Report")
                        </ButtonCn>
                        <span class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideClockCn Size="12" />
                            @_reviewDate
                        </span>
                    </div>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isExpanded;
    private int _upvotes = 128;
    private int _downvotes = 7;
    private string? _userVote;
    private bool _isReported;

    private int NetVotes => _upvotes - _downvotes;
    private string[] DisplayContent => _isExpanded ? _paragraphs : [_paragraphs[0]];

    private const string _authorName = "Ryan Hoover";
    private const string _authorTitle = "Product Enthusiast";
    private const string _authorAvatar = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&w=100&q=80";
    private const string _productName = "TaskMaster Pro";
    private const string _productIcon = "https://images.unsplash.com/photo-1611532736597-de2d4265fba3?auto=format&w=100&q=80";
    private const string _reviewTitle = "The productivity app that finally clicked for me";
    private const string _reviewDate = "3 days ago";

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private readonly string[] _paragraphs =
    [
        "I've tried countless productivity apps over the years, but TaskMaster has quickly become my default. What sets it apart is its perfect balance of simplicity and functionality. The UI is clean, focused, and doesn't overwhelm you with unnecessary features.",
        "The standout feature is the 'Priority Matrix' that helps you sort tasks based on importance and urgency - a simple implementation of the Eisenhower matrix. The daily focus view shows only what you need to accomplish today, which reduces anxiety and increases productivity.",
        "Sync works flawlessly across devices, and the offline mode has saved me multiple times. The developers are responsive and push updates regularly based on user feedback. If you're looking for a productivity app that stays out of your way while actually helping you get things done, this is it.",
    ];

    private void HandleVote(string type)
    {
        if (type == "up")
        {
            if (_userVote == "up") { _upvotes--; _userVote = null; }
            else { _upvotes++; if (_userVote == "down") _downvotes--; _userVote = "up"; }
        }
        else
        {
            if (_userVote == "down") { _downvotes--; _userVote = null; }
            else { _downvotes++; if (_userVote == "up") _upvotes--; _userVote = "down"; }
        }
    }
}
