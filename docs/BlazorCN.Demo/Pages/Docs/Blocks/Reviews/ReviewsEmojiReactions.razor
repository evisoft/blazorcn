@* ============================================================
   Block: reviews-emoji-reactions
   Title: ReviewsEmojiReactions
   Description: A social-media inspired review list with toggleable emoji reaction buttons for React and Next.js featuring animated counts, reaction summaries, and author avatars built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-emoji-reactions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with global reaction summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Customer Reviews</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_reviews.Length reviews</p>
                </div>
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1 rounded-full bg-muted/50 px-2.5 py-1">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-[10px] tabular-nums text-muted-foreground">
                            @TotalReactions() reactions
                        </span>
                    </div>
                </div>
            </div>
            @* Reaction summary bar *@
            <div class="mt-2.5 flex items-center gap-3">
                @foreach (var entry in SortedEmojiTotals())
                {
                    var emoji = entry.Key;
                    var count = entry.Value;
                    <div class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="text-xs">@emoji</span>
                        <span class="tabular-nums">@count</span>
                    </div>
                }
            </div>
        </div>

        @* Reviews list *@
        <div>
            @for (int idx = 0; idx < _reviews.Length; idx++)
            {
                var index = idx;
                var review = _reviews[index];
                var isLast = index == _reviews.Length - 1;
                var reviewToggled = _toggled.ContainsKey(review.Id) ? _toggled[review.Id] : new HashSet<string>();

                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3.5">
                        @* Author row *@
                        <div class="flex items-center gap-2.5">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                @review.Author.Initials
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs font-medium">@review.Author.Name</span>
                                    @if (review.Author.Verified)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1 text-[9px] font-normal">
                                            Verified
                                        </BadgeCn>
                                    }
                                    <span class="text-[10px] text-muted-foreground">
                                        @review.Author.ReviewCount reviews
                                    </span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-1.5">
                                    <div class="flex items-center gap-px">
                                        @for (int si = 0; si < 5; si++)
                                        {
                                            var starIndex = si;
                                            <LucideIconCn Name="star" Size="10" Class="@($"size-2.5 {(starIndex < review.Rating ? "fill-foreground text-foreground" : "fill-muted text-muted")}")" />
                                        }
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">
                                        @review.TimeAgo
                                    </span>
                                </div>
                            </div>
                        </div>

                        @* Review title and content *@
                        <div class="mt-2.5">
                            <p class="text-sm font-medium">@review.Title</p>
                            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                @review.Content
                            </p>
                        </div>

                        @* Reaction bar *@
                        <div class="mt-3 flex items-center gap-1.5">
                            @foreach (var reaction in review.Reactions)
                            {
                                var rxn = reaction;
                                var reviewId = review.Id;
                                var isActive = reviewToggled.Contains(rxn.Emoji);
                                var showCount = rxn.Count > 0 || isActive;
                                <button type="button"
                                        class="@Cn.Merge("inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs transition-colors", isActive ? "border-foreground/20 bg-foreground/5" : "border-transparent hover:border-border hover:bg-muted/50", !showCount ? "opacity-50" : "")"
                                        aria-label="@($"{rxn.Label} {rxn.Count}")"
                                        @onclick="@(() => ToggleReaction(reviewId, rxn.Emoji))">
                                    <span>@rxn.Emoji</span>
                                    <span class="tabular-nums text-muted-foreground">@rxn.Count</span>
                                </button>
                            }

                            @* Reply count *@
                            @if (review.ReplyCount > 0)
                            {
                                <span class="ml-auto flex items-center gap-1 text-[10px] text-muted-foreground">
                                    <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                    @review.ReplyCount @(review.ReplyCount == 1 ? "reply" : "replies")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <span class="text-[10px] text-muted-foreground">
                    Reactions help others find useful reviews
                </span>
                <span class="text-[10px] text-muted-foreground">Sorted by most reactions</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewReaction(string Emoji, string Label, int Count)
    {
        public int Count { get; set; } = Count;
    }

    private record ReviewAuthorData(string Name, string Initials, bool Verified, int ReviewCount);

    private class ReviewData
    {
        public string Id { get; init; } = "";
        public ReviewAuthorData Author { get; init; } = null!;
        public int Rating { get; init; }
        public string TimeAgo { get; init; } = "";
        public string Title { get; init; } = "";
        public string Content { get; init; } = "";
        public ReviewReaction[] Reactions { get; init; } = [];
        public int ReplyCount { get; init; }
    }

    private readonly ReviewData[] _reviews =
    [
        new ReviewData
        {
            Id = "r1",
            Author = new ReviewAuthorData("Jamie Thornton", "JT", true, 47),
            Rating = 5,
            TimeAgo = "2 days ago",
            Title = "Exceeded every expectation",
            Content = "The build quality is outstanding and the attention to detail shows in every interaction. Setup took under 5 minutes and the onboarding flow walked me through every feature. Already recommended it to three colleagues.",
            Reactions =
            [
                new ReviewReaction("\U0001F44D", "Helpful", 24),
                new ReviewReaction("❤️", "Love it", 12),
                new ReviewReaction("\U0001F602", "Funny", 3),
                new ReviewReaction("\U0001F914", "Hmm", 1),
            ],
            ReplyCount = 4,
        },
        new ReviewData
        {
            Id = "r2",
            Author = new ReviewAuthorData("Nadia Petrova", "NP", true, 12),
            Rating = 4,
            TimeAgo = "1 week ago",
            Title = "Solid product, documentation needs work",
            Content = "Great product overall. The documentation could use some improvement but the core experience is solid. Customer support responded within an hour when I had questions about the API integration. The TypeScript SDK is well-typed.",
            Reactions =
            [
                new ReviewReaction("\U0001F44D", "Helpful", 18),
                new ReviewReaction("❤️", "Love it", 5),
                new ReviewReaction("\U0001F602", "Funny", 0),
                new ReviewReaction("\U0001F914", "Hmm", 7),
            ],
            ReplyCount = 2,
        },
        new ReviewData
        {
            Id = "r3",
            Author = new ReviewAuthorData("Carlos Mendez", "CM", false, 89),
            Rating = 5,
            TimeAgo = "2 weeks ago",
            Title = "Third purchase, quality keeps improving",
            Content = "This is my third purchase from this team and the quality keeps improving. The latest update added exactly the features I requested in my previous review. That level of responsiveness to customer feedback is rare.",
            Reactions =
            [
                new ReviewReaction("\U0001F44D", "Helpful", 31),
                new ReviewReaction("❤️", "Love it", 19),
                new ReviewReaction("\U0001F602", "Funny", 2),
                new ReviewReaction("\U0001F914", "Hmm", 0),
            ],
            ReplyCount = 7,
        },
        new ReviewData
        {
            Id = "r4",
            Author = new ReviewAuthorData("Aisha Rahman", "AR", true, 23),
            Rating = 4,
            TimeAgo = "3 weeks ago",
            Title = "Great for teams, missing a few integrations",
            Content = "We rolled this out to our 15-person engineering team and adoption was immediate. The collaboration features are intuitive. Only missing Jira and Linear integrations which would make it perfect for our workflow.",
            Reactions =
            [
                new ReviewReaction("\U0001F44D", "Helpful", 14),
                new ReviewReaction("❤️", "Love it", 8),
                new ReviewReaction("\U0001F602", "Funny", 1),
                new ReviewReaction("\U0001F914", "Hmm", 3),
            ],
            ReplyCount = 1,
        },
    ];

    private readonly Dictionary<string, HashSet<string>> _toggled = new();

    private void ToggleReaction(string reviewId, string emoji)
    {
        if (!_toggled.ContainsKey(reviewId))
            _toggled[reviewId] = new HashSet<string>();

        var set = _toggled[reviewId];
        var isCurrentlyToggled = set.Contains(emoji);

        if (isCurrentlyToggled)
            set.Remove(emoji);
        else
            set.Add(emoji);

        var review = _reviews.FirstOrDefault(r => r.Id == reviewId);
        if (review is null) return;

        var rxn = review.Reactions.FirstOrDefault(r => r.Emoji == emoji);
        if (rxn is null) return;

        rxn.Count += isCurrentlyToggled ? -1 : 1;
    }

    private int TotalReactions() =>
        _reviews.Sum(r => r.Reactions.Sum(rx => rx.Count));

    private List<KeyValuePair<string, int>> SortedEmojiTotals()
    {
        var dict = new Dictionary<string, int>();
        foreach (var review in _reviews)
        {
            foreach (var rxn in review.Reactions)
            {
                if (!dict.ContainsKey(rxn.Emoji))
                    dict[rxn.Emoji] = 0;
                dict[rxn.Emoji] += rxn.Count;
            }
        }
        return dict.OrderByDescending(kv => kv.Value).Take(4).ToList();
    }
}
