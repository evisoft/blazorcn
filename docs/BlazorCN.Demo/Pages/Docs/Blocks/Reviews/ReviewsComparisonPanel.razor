@* ============================================================
   Block: reviews-comparison-panel
   Title: ReviewsComparisonPanel
   Description: A side-by-side product review comparison panel built with React, Next.js, shadcn/ui, and Tailwind CSS. Features split-panel layout with per-category winner highlighting, animated distribution bars, pros/cons lists, and customer review excerpts with motion/react transitions.
   Source: original/blocks/reviews/reviews-comparison-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Title bar *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Review Comparison</span>
                <span class="ml-2 text-xs text-muted-foreground">
                    @_productA.Name vs @_productB.Name
                </span>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span class="tabular-nums">@_productA.Name: @_winsA wins</span>
                <LucideIconCn Name="minus" Size="12" Class="size-3" />
                <span class="tabular-nums">@_productB.Name: @_winsB wins</span>
            </div>
        </div>

        @* Category comparison bar *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Head-to-head by category</span>
            <div class="mt-2 space-y-1.5">
                @foreach (var cat in _comparisonCategories)
                {
                    var catLabel = cat.Label;
                    var winnerSide = cat.ScoreA > cat.ScoreB ? "A" : (cat.ScoreB > cat.ScoreA ? "B" : "tie");
                    var isHovered = _activeCategory == catLabel;
                    var barWidthA = (int)Math.Round((cat.ScoreA / 10.0) * 100);
                    var barWidthB = (int)Math.Round((cat.ScoreB / 10.0) * 100);

                    <div class="@Cn.Merge("flex items-center gap-2 rounded px-2 py-1 transition-colors", isHovered ? "bg-muted/50" : "")"
                         @onmouseenter="@(() => _activeCategory = catLabel)"
                         @onmouseleave="@(() => _activeCategory = null)">
                        <span class="w-24 shrink-0 text-xs text-muted-foreground">@cat.Label</span>
                        <span class="@Cn.Merge("w-7 text-right text-xs font-medium tabular-nums", winnerSide == "A" ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                            @cat.ScoreA
                        </span>
                        <div class="flex h-1.5 flex-1 items-center gap-0.5">
                            <div class="h-full flex-1 overflow-hidden rounded-l-full bg-muted">
                                <div class="@Cn.Merge("ml-auto h-full rounded-l-full", winnerSide == "A" ? "bg-emerald-500" : "bg-foreground/40")"
                                     style="@($"width:{barWidthA}%")">
                                </div>
                            </div>
                            <div class="h-full flex-1 overflow-hidden rounded-r-full bg-muted">
                                <div class="@Cn.Merge("h-full rounded-r-full", winnerSide == "B" ? "bg-emerald-500" : "bg-foreground/40")"
                                     style="@($"width:{barWidthB}%")">
                                </div>
                            </div>
                        </div>
                        <span class="@Cn.Merge("w-7 text-left text-xs font-medium tabular-nums", winnerSide == "B" ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                            @cat.ScoreB
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Two-panel layout *@
        <div class="flex divide-x">
            @* Product A Panel *@
            <div class="flex-1">
                @{ var ratingColorA = _productA.AverageRating >= 4.5 ? "text-emerald-600 dark:text-emerald-400" : "text-foreground"; }
                @{ var verifiedPercentA = (int)Math.Round((_productA.VerifiedReviews / (double)_productA.TotalReviews) * 100); }

                @* Product A header *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@_productA.Name</span>
                        @if (_overallWinner == "A")
                        {
                            <LucideIconCn Name="crown" Size="12" Class="size-3 text-amber-500" />
                        }
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_productA.Tagline</p>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", ratingColorA)">@_productA.AverageRating</span>
                        <div>
                            <div class="flex items-center gap-0.5">
                                @{ var filledA = (int)Math.Round(_productA.AverageRating); }
                                @for (int i = 0; i < 5; i++)
                                {
                                    var starIdx = i;
                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < filledA ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                                }
                            </div>
                            <span class="text-[10px] text-muted-foreground">
                                @_productA.TotalReviews.ToString("N0") reviews
                                <span class="mx-1">&middot;</span>
                                @verifiedPercentA% verified
                            </span>
                        </div>
                    </div>
                </div>

                @* Product A Distribution *@
                <div class="border-b px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Distribution</span>
                    <div class="mt-2 space-y-1">
                        @foreach (var d in _productA.Distribution)
                        {
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 text-right text-[10px] tabular-nums text-muted-foreground">@d.Stars</span>
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/60" style="@($"width:{d.Percentage}%")"></div>
                                </div>
                                <span class="w-6 text-right text-[10px] tabular-nums text-muted-foreground">@(d.Percentage)%</span>
                            </div>
                        }
                    </div>
                </div>

                @* Product A Pros / Cons *@
                <div class="border-b px-4 py-3">
                    <div class="space-y-2">
                        @foreach (var pro in _productA.Pros)
                        {
                            <div class="flex items-start gap-2">
                                <LucideIconCn Name="check" Size="12" Class="mt-0.5 size-3 shrink-0 text-emerald-500" />
                                <span class="text-xs leading-relaxed">@pro</span>
                            </div>
                        }
                        @foreach (var con in _productA.Cons)
                        {
                            <div class="flex items-start gap-2">
                                <LucideIconCn Name="x" Size="12" Class="mt-0.5 size-3 shrink-0 text-red-500" />
                                <span class="text-xs leading-relaxed text-muted-foreground">@con</span>
                            </div>
                        }
                    </div>
                </div>

                @* Product A Top quotes *@
                <div class="px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Top reviews</span>
                    <div class="mt-2 space-y-2">
                        @foreach (var quote in _productA.Quotes)
                        {
                            <div class="rounded-md bg-muted/50 p-2.5">
                                <p class="text-xs leading-relaxed">&ldquo;@quote.Text&rdquo;</p>
                                <div class="mt-1.5 flex items-center justify-between">
                                    <div>
                                        <span class="text-xs font-medium">@quote.Author</span>
                                        <span class="mx-1.5 text-muted-foreground">&middot;</span>
                                        <span class="text-[10px] text-muted-foreground">@quote.Role</span>
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">@quote.HelpfulCount found helpful</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Product B Panel *@
            <div class="flex-1">
                @{ var ratingColorB = _productB.AverageRating >= 4.5 ? "text-emerald-600 dark:text-emerald-400" : "text-foreground"; }
                @{ var verifiedPercentB = (int)Math.Round((_productB.VerifiedReviews / (double)_productB.TotalReviews) * 100); }

                @* Product B header *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@_productB.Name</span>
                        @if (_overallWinner == "B")
                        {
                            <LucideIconCn Name="crown" Size="12" Class="size-3 text-amber-500" />
                        }
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_productB.Tagline</p>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", ratingColorB)">@_productB.AverageRating</span>
                        <div>
                            <div class="flex items-center gap-0.5">
                                @{ var filledB = (int)Math.Round(_productB.AverageRating); }
                                @for (int i = 0; i < 5; i++)
                                {
                                    var starIdx = i;
                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < filledB ? "fill-foreground text-foreground" : "text-muted-foreground/20")" />
                                }
                            </div>
                            <span class="text-[10px] text-muted-foreground">
                                @_productB.TotalReviews.ToString("N0") reviews
                                <span class="mx-1">&middot;</span>
                                @verifiedPercentB% verified
                            </span>
                        </div>
                    </div>
                </div>

                @* Product B Distribution *@
                <div class="border-b px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Distribution</span>
                    <div class="mt-2 space-y-1">
                        @foreach (var d in _productB.Distribution)
                        {
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 text-right text-[10px] tabular-nums text-muted-foreground">@d.Stars</span>
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/60" style="@($"width:{d.Percentage}%")"></div>
                                </div>
                                <span class="w-6 text-right text-[10px] tabular-nums text-muted-foreground">@(d.Percentage)%</span>
                            </div>
                        }
                    </div>
                </div>

                @* Product B Pros / Cons *@
                <div class="border-b px-4 py-3">
                    <div class="space-y-2">
                        @foreach (var pro in _productB.Pros)
                        {
                            <div class="flex items-start gap-2">
                                <LucideIconCn Name="check" Size="12" Class="mt-0.5 size-3 shrink-0 text-emerald-500" />
                                <span class="text-xs leading-relaxed">@pro</span>
                            </div>
                        }
                        @foreach (var con in _productB.Cons)
                        {
                            <div class="flex items-start gap-2">
                                <LucideIconCn Name="x" Size="12" Class="mt-0.5 size-3 shrink-0 text-red-500" />
                                <span class="text-xs leading-relaxed text-muted-foreground">@con</span>
                            </div>
                        }
                    </div>
                </div>

                @* Product B Top quotes *@
                <div class="px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Top reviews</span>
                    <div class="mt-2 space-y-2">
                        @foreach (var quote in _productB.Quotes)
                        {
                            <div class="rounded-md bg-muted/50 p-2.5">
                                <p class="text-xs leading-relaxed">&ldquo;@quote.Text&rdquo;</p>
                                <div class="mt-1.5 flex items-center justify-between">
                                    <div>
                                        <span class="text-xs font-medium">@quote.Author</span>
                                        <span class="mx-1.5 text-muted-foreground">&middot;</span>
                                        <span class="text-[10px] text-muted-foreground">@quote.Role</span>
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">@quote.HelpfulCount found helpful</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Footer verdict *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    Based on @((_productA.TotalReviews + _productB.TotalReviews).ToString("N0")) reviews
                </BadgeCn>
            </div>
            <span class="text-[10px] text-muted-foreground">Scores aggregated from verified purchasers only</span>
        </div>
    </div>
</section>

@code {
    private record ReviewQuote(string Id, string Author, string Role, string Text, int Rating, int HelpfulCount);
    private record Distribution(int Stars, int Count, int Percentage);
    private record ComparisonCategory(string Label, double ScoreA, double ScoreB);
    private record ProductData(string Name, string Tagline, double AverageRating, int TotalReviews, int VerifiedReviews, Distribution[] Distribution, string[] Pros, string[] Cons, ReviewQuote[] Quotes);

    private string? _activeCategory = null;

    private static readonly ComparisonCategory[] _comparisonCategories =
    [
        new("Performance",   9.2, 8.4),
        new("Ease of Use",   8.5, 9.1),
        new("Documentation", 9.0, 7.8),
        new("Pricing",       7.3, 8.7),
        new("Support",       8.8, 8.2),
        new("Integrations",  9.1, 7.5),
    ];

    private static readonly ProductData _productA = new(
        Name: "Neon Postgres",
        Tagline: "Serverless Postgres with branching",
        AverageRating: 4.7,
        TotalReviews: 2341,
        VerifiedReviews: 2089,
        Distribution:
        [
            new(5, 1404, 60),
            new(4,  538, 23),
            new(3,  234, 10),
            new(2,  117,  5),
            new(1,   48,  2),
        ],
        Pros:
        [
            "Branch-based development workflow",
            "Autoscaling with zero cold starts",
            "Generous free tier for hobby projects",
        ],
        Cons:
        [
            "Connection pooling limits on lower tiers",
            "Limited extension support vs self-hosted",
        ],
        Quotes:
        [
            new("qa1", "Sarah Chen", "Staff Engineer at Linear",
                "Database branching changed our development workflow completely. Every PR gets its own database branch now, and the team catches schema issues before they hit staging.",
                5, 47),
            new("qa2", "Marcus Webb", "CTO at Synthflow",
                "Autoscaling works exactly as advertised. We went from managing RDS instances to just writing queries. The scale-to-zero feature alone saves us thousands monthly on dev environments.",
                5, 31),
        ]
    );

    private static readonly ProductData _productB = new(
        Name: "Turso LibSQL",
        Tagline: "Edge-native SQLite for modern apps",
        AverageRating: 4.4,
        TotalReviews: 1567,
        VerifiedReviews: 1398,
        Distribution:
        [
            new(5, 658, 42),
            new(4, 470, 30),
            new(3, 251, 16),
            new(2, 125,  8),
            new(1,  63,  4),
        ],
        Pros:
        [
            "Embedded replicas for ultra-low latency reads",
            "Simple SQLite-compatible query interface",
            "Minimal setup for edge deployments",
        ],
        Cons:
        [
            "No full Postgres feature parity",
            "Smaller ecosystem of tools and ORMs",
            "Write throughput lower than dedicated Postgres",
        ],
        Quotes:
        [
            new("qb1", "Ava Kowalski", "Founder at Meadow",
                "For our use case, embedded replicas are a game changer. Reads from the edge are sub-millisecond and the DX of working with SQLite syntax keeps the team productive.",
                5, 28),
            new("qb2", "Kai Nakamura", "Lead Developer at Portside",
                "Perfect for read-heavy workloads. We migrated from Postgres and our P99 latency dropped by 60%. The tradeoff is learning a slightly different ecosystem, but worth it for edge-first apps.",
                4, 19),
        ]
    );

    private int _winsA => _comparisonCategories.Count(c => c.ScoreA > c.ScoreB);
    private int _winsB => _comparisonCategories.Count(c => c.ScoreB > c.ScoreA);
    private string _overallWinner => _winsA >= _winsB ? "A" : "B";
}
