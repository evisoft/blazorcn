@* ============================================================
   Block: reviews-star-histogram
   Title: ReviewsStarHistogram
   Description: An interactive star rating histogram block for React and Next.js with animated distribution bars, click-to-filter reviews, sentiment breakdown, and review preview list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-star-histogram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Overall score header *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@_overallScore</span>
                <span class="text-muted-foreground text-xs">/ 5</span>
            </div>
            <div class="flex items-center gap-0.5">
                @for (int i = 0; i < 5; i++)
                {
                    int idx = i;
                    <LucideStarCn Size="14" Class="@Cn.Merge("size-3.5", idx < _overallRounded ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                }
            </div>
            <div class="w-px h-4 bg-border"></div>
            <span class="text-muted-foreground text-xs">@_total.ToString("N0") reviews</span>
            @if (_activeFilter != null)
            {
                <button
                    type="button"
                    class="ml-auto flex h-6 items-center gap-1 rounded-md px-2 text-xs transition-colors hover:bg-accent hover:text-accent-foreground"
                    @onclick="@(() => _activeFilter = null)">
                    <LucideXCn Size="12" Class="size-3" />
                    Clear
                </button>
            }
        </div>

        @* Histogram bars *@
        <div class="border-b">
            @foreach (var rating in _ratings)
            {
                var r = rating;
                var barPercent = (int)Math.Round((double)r.Count / _maxCount * 100);
                var sharePercent = (int)Math.Round((double)r.Count / _total * 100);
                var isActive = _activeFilter == r.Stars;
                var isLast = r.Stars == _ratings[_ratings.Length - 1].Stars;
                <button
                    type="button"
                    @onclick="@(() => HandleFilter(r.Stars))"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2 text-left transition-colors hover:bg-muted/50", isActive ? "bg-muted/50" : "", !isLast ? "border-b" : "")">
                    @* Star label *@
                    <span class="flex w-10 shrink-0 items-center gap-1 text-xs tabular-nums">
                        @r.Stars
                        <LucideStarCn Size="12" Class="size-3 fill-foreground text-foreground" />
                    </span>

                    @* Bar *@
                    <div class="relative h-2.5 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground/70" style="@($"width:{barPercent}%")"></div>
                    </div>

                    @* Percentage *@
                    <span class="w-9 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @(sharePercent)%
                    </span>

                    @* Count *@
                    <span class="w-12 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                        @r.Count.ToString("N0")
                    </span>
                </button>
            }
        </div>

        @* Sentiment breakdown for active filter *@
        @if (_activeRating != null)
        {
            <div class="overflow-hidden border-b">
                <div class="flex items-center gap-3 px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">
                        Sentiment for @(_activeFilter)-star reviews
                    </span>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="flex items-center gap-1">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            @((int)Math.Round((double)_activeRating.Sentiment.Positive / _activeRating.Count * 100))%
                            positive
                        </span>
                        <span class="flex items-center gap-1">
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                            @((int)Math.Round((double)_activeRating.Sentiment.Neutral / _activeRating.Count * 100))%
                            neutral
                        </span>
                        <span class="flex items-center gap-1">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            @((int)Math.Round((double)_activeRating.Sentiment.Negative / _activeRating.Count * 100))%
                            negative
                        </span>
                    </div>
                </div>
            </div>
        }

        @* Filtered review previews *@
        <div>
            <div class="flex items-center justify-between border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">
                    @(_activeFilter.HasValue ? $"{_activeFilter}-star reviews" : "Recent reviews")
                </span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_filteredReviews.Length shown
                </span>
            </div>
            <div class="max-h-[280px] overflow-y-auto">
                @if (_filteredReviews.Length == 0)
                {
                    <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                        No reviews at this rating level
                    </div>
                }
                else
                {
                    @for (int ri = 0; ri < _filteredReviews.Length; ri++)
                    {
                        var review = _filteredReviews[ri];
                        var notLast = ri < _filteredReviews.Length - 1;
                        <div class="@(notLast ? "border-b" : "")">
                            <div class="px-4 py-2.5">
                                <div class="flex items-center gap-2">
                                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted font-medium text-[10px]">
                                        @review.Initials
                                    </div>
                                    <span class="font-medium text-xs">@review.Author</span>
                                    <div class="flex items-center gap-0.5">
                                        @for (int si = 0; si < 5; si++)
                                        {
                                            int sidx = si;
                                            <LucideStarCn Size="10" Class="@Cn.Merge("size-2.5", sidx < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                        }
                                    </div>
                                    @if (review.Verified)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Verified</BadgeCn>
                                    }
                                    <span class="ml-auto text-muted-foreground text-[10px]">
                                        @review.Date
                                    </span>
                                </div>
                                <p class="mt-1 font-medium text-xs">@review.Title</p>
                                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                    @review.Snippet
                                </p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Sentiment(int Positive, int Neutral, int Negative);
    private record RatingLevel(int Stars, int Count, Sentiment Sentiment);
    private record ReviewPreview(string Id, string Author, string Initials, int Rating, string Title, string Snippet, string Date, bool Verified, int Helpful);

    private static readonly RatingLevel[] _ratings =
    [
        new(5, 1243, new(1180, 58, 5)),
        new(4, 856,  new(712, 127, 17)),
        new(3, 234,  new(89, 108, 37)),
        new(2, 89,   new(8, 31, 50)),
        new(1, 42,   new(2, 5, 35)),
    ];

    private static readonly ReviewPreview[] _reviewPreviews =
    [
        new("rp1", "Sarah Chen",       "SC", 5, "Exceptional quality throughout",
            "Every component follows consistent patterns. TypeScript types are thorough and Tailwind integration is seamless.",
            "Mar 22, 2026", true, 47),
        new("rp2", "Marcus Johnson",   "MJ", 5, "Perfect for rapid prototyping",
            "From concept to deployed product in two weeks. The consistency across components means everything works together.",
            "Mar 20, 2026", true, 41),
        new("rp3", "Elena Rodriguez",  "ER", 4, "Solid defaults with easy customization",
            "Components work perfectly out of the box. Minor theming adjustments were straightforward with the token system.",
            "Mar 18, 2026", true, 31),
        new("rp4", "David Kim",        "DK", 4, "Clean code, great developer experience",
            "The copy-paste model gives full ownership. No dependency bloat and full control over styling decisions.",
            "Mar 15, 2026", false, 23),
        new("rp5", "Priya Patel",      "PP", 3, "Good foundation needs more patterns",
            "Standard layouts are great. Would appreciate more complex data table variations with built-in sorting.",
            "Mar 12, 2026", true, 14),
        new("rp6", "Thomas Weber",     "TW", 2, "Missing enterprise features",
            "Works for simple use cases but our enterprise dashboard needed significant custom work on top of base components.",
            "Mar 9, 2026", true, 8),
        new("rp7", "Aisha Mohammed",   "AM", 1, "Not suited for our workflow",
            "Our team needed a different paradigm entirely. The component model did not align with our design system approach.",
            "Mar 5, 2026", false, 3),
        new("rp8", "James Park",       "JP", 5, "Best investment this quarter",
            "Cut our frontend development time by 40 percent. The design system consistency and dark mode support are flawless.",
            "Mar 2, 2026", true, 52),
    ];

    private static readonly int _total = 1243 + 856 + 234 + 89 + 42;
    private static readonly int _maxCount = 1243;

    private int? _activeFilter = null;

    private string _overallScore
    {
        get
        {
            var weightedSum = 0.0;
            foreach (var r in _ratings) weightedSum += r.Stars * r.Count;
            return (weightedSum / _total).ToString("F1");
        }
    }

    private int _overallRounded => (int)Math.Round(double.Parse(_overallScore));

    private RatingLevel? _activeRating => _activeFilter.HasValue
        ? System.Array.Find(_ratings, r => r.Stars == _activeFilter.Value)
        : null;

    private ReviewPreview[] _filteredReviews => _activeFilter.HasValue
        ? System.Array.FindAll(_reviewPreviews, r => r.Rating == _activeFilter.Value)
        : _reviewPreviews;

    private void HandleFilter(int stars)
    {
        _activeFilter = _activeFilter == stars ? null : stars;
    }
}
