@* ============================================================
   Block: reviews-multi-step-form
   Title: ReviewsMultiStepForm
   Description: A React multi-step review submission wizard for Next.js with animated step transitions, star rating with hover preview, title and body text inputs, photo upload slots, tag selection, and a summary confirmation step built with shadcn/ui Button, Input, Textarea, Badge components, motion/react AnimatePresence transitions, and Tailwind CSS
   Source: original/blocks/reviews/reviews-multi-step-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Header *@
    <div class="border-b px-4 py-3">
      <span class="text-sm font-medium">Write a Review</span>
      @if (!_submitted)
      {
        <p class="mt-0.5 text-xs text-muted-foreground">
          Step @(_currentStep + 1) of @_steps.Length -- @_steps[_currentStep].Description
        </p>
      }
    </div>

    @* Step indicator *@
    @if (!_submitted)
    {
      <div class="border-b px-4 py-3">
        <div class="flex items-center gap-1">
          @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
          {
            var idx = entry.Index;
            var isComplete = idx < _currentStep;
            var isCurrent = idx == _currentStep;
            <div class="flex flex-1 items-center gap-1">
              <div class="flex w-full flex-col items-center gap-1.5">
                <div class="flex w-full items-center gap-1">
                  @* Step circle *@
                  <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full text-[10px] font-medium transition-colors", isComplete ? "bg-foreground text-background" : isCurrent ? "border-2 border-foreground text-foreground" : "border border-muted-foreground/30 text-muted-foreground/50")">
                    @if (isComplete)
                    {
                      <LucideIconCn Name="check" Size="12" Class="size-3" />
                    }
                    else
                    {
                      @(idx + 1)
                    }
                  </div>
                  @* Connector line *@
                  @if (idx < _steps.Length - 1)
                  {
                    <div class="h-px flex-1 bg-muted-foreground/20">
                      <div class="h-full bg-foreground transition-all duration-300" style="@($"width:{(isComplete ? "100%" : "0%")}")"></div>
                    </div>
                  }
                </div>
                <span class="@Cn.Merge("text-[10px]", isCurrent ? "font-medium text-foreground" : "text-muted-foreground")">
                  @entry.Step.Label
                </span>
              </div>
            </div>
          }
        </div>
      </div>
    }

    @* Step content *@
    <div class="relative min-h-[280px] overflow-hidden">
      @if (!_submitted)
      {
        <div class="px-4 py-6">

          @* Step 0: Rating *@
          @if (_currentStep == 0)
          {
            <div class="flex flex-col items-center gap-5">
              <span class="text-sm text-muted-foreground">
                How would you rate your experience?
              </span>
              <div class="flex items-center gap-1.5">
                @foreach (var starEntry in Enumerable.Range(1, 5).Select((v, i) => new { StarValue = v, Index = i }))
                {
                  var starVal = starEntry.StarValue;
                  var isActive = starVal <= _activeRating;
                  <button type="button"
                          @onclick="@(() => _rating = starVal)"
                          @onmouseenter="@(() => _hoveredStar = starVal)"
                          @onmouseleave="@(() => _hoveredStar = 0)"
                          class="rounded-md p-1.5 transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="star" Size="32" Class="@Cn.Merge("size-8 transition-colors", isActive ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                  </button>
                }
              </div>
              @if (_activeRating > 0)
              {
                <span class="text-xs text-muted-foreground">
                  @_ratingLabels[_activeRating]
                </span>
              }
            </div>
          }

          @* Step 1: Write *@
          @if (_currentStep == 1)
          {
            <div class="flex flex-col gap-4">
              <div>
                <span class="text-xs font-medium text-muted-foreground">Review title</span>
                <InputCn @bind-Value="_title" Placeholder="Summarize your experience in one line..." Class="mt-1.5 h-9" />
                <span class="mt-1 block text-[10px] text-muted-foreground">
                  @_title.Length/100 characters
                </span>
              </div>
              <div>
                <span class="text-xs font-medium text-muted-foreground">Your review</span>
                <TextareaCn @bind-Value="_body" Placeholder="What did you like or dislike? What did you use the product for?" Class="mt-1.5 min-h-[120px] resize-none" />
                <span class="mt-1 block text-[10px] text-muted-foreground">
                  @_body.Length/2000 characters
                </span>
              </div>
            </div>
          }

          @* Step 2: Details (photos + tags) *@
          @if (_currentStep == 2)
          {
            <div class="flex flex-col gap-5">
              <div>
                <span class="text-xs font-medium text-muted-foreground">Add photos (optional)</span>
                <div class="mt-2 grid grid-cols-4 gap-2">
                  @foreach (var i in Enumerable.Range(0, 4))
                  {
                    <div class="flex aspect-square items-center justify-center rounded-md border border-dashed transition-colors hover:bg-muted/50">
                      <LucideIconCn Name="image-plus" Size="20" Class="size-5 text-muted-foreground/40" />
                    </div>
                  }
                </div>
                <span class="mt-1.5 block text-[10px] text-muted-foreground">
                  JPG, PNG, or WebP up to 5MB each
                </span>
              </div>

              <div>
                <span class="text-xs font-medium text-muted-foreground">What stood out? (optional)</span>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  @foreach (var tag in _availableTags)
                  {
                    var t = tag;
                    var isSelected = _selectedTags.Contains(t);
                    <button type="button" @onclick="@(() => ToggleTag(t))" class="inline-flex items-center">
                      <BadgeCn Variant="@(isSelected ? BadgeVariant.Default : BadgeVariant.Secondary)" Class="cursor-pointer gap-1 text-xs font-normal">
                        @if (isSelected)
                        {
                          <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                        @t
                      </BadgeCn>
                    </button>
                  }
                </div>
              </div>
            </div>
          }

          @* Step 3: Confirm *@
          @if (_currentStep == 3)
          {
            <div class="flex flex-col gap-4">
              <span class="text-xs font-medium text-muted-foreground">Review summary</span>

              @* Rating summary *@
              <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                  <div class="flex items-center gap-0.5">
                    @foreach (var i in Enumerable.Range(0, 5))
                    {
                      <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", i < _rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                    }
                  </div>
                  <span class="text-xs text-muted-foreground">
                    @_ratingLabels[_rating]
                  </span>
                </div>
              </div>

              @* Title and body preview *@
              <div class="rounded-md border p-3">
                <span class="text-sm font-medium">@_title</span>
                @if (!string.IsNullOrEmpty(_body))
                {
                  <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                    @(_body.Length > 200 ? _body.Substring(0, 200) + "..." : _body)
                  </p>
                }
              </div>

              @* Tags *@
              @if (_selectedTags.Count > 0)
              {
                <div class="flex flex-wrap gap-1.5">
                  @foreach (var tag in _selectedTags)
                  {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@tag</BadgeCn>
                  }
                </div>
              }

              <span class="text-[10px] text-muted-foreground">
                By submitting, you agree to our review guidelines. Your review may take up to 24 hours to appear.
              </span>
            </div>
          }

        </div>
      }

      @* Success state *@
      @if (_submitted)
      {
        <div class="flex flex-col items-center gap-3 px-4 py-12">
          <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
            <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
          </div>
          <span class="text-sm font-medium">Review submitted</span>
          <span class="text-xs text-muted-foreground">
            Thank you for your feedback. Your review will be visible after moderation.
          </span>
        </div>
      }
    </div>

    @* Navigation footer *@
    @if (!_submitted)
    {
      <div class="flex items-center justify-between border-t px-4 py-3">
        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" OnClick="GoBack" Disabled="@(_currentStep == 0)">
          <LucideIconCn Name="chevron-left" Size="12" Class="size-3" />
          Back
        </ButtonCn>

        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
          @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
          {
            var idx2 = entry.Index;
            <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", idx2 == _currentStep ? "bg-foreground" : idx2 < _currentStep ? "bg-foreground/40" : "bg-foreground/10")"></span>
          }
        </div>

        @if (_currentStep < _steps.Length - 1)
        {
          <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" OnClick="GoNext" Disabled="@(!_canAdvance)">
            Next
            <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
          </ButtonCn>
        }
        else
        {
          <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="HandleSubmit">
            Submit review
          </ButtonCn>
        }
      </div>
    }

  </div>
</section>

@code {
    private record StepConfig(string Label, string Description);

    private static readonly StepConfig[] _steps =
    [
        new("Rate", "Overall rating"),
        new("Write", "Your review"),
        new("Details", "Photos and tags"),
        new("Confirm", "Review and submit"),
    ];

    private static readonly Dictionary<int, string> _ratingLabels = new()
    {
        [1] = "Terrible -- would not recommend",
        [2] = "Poor -- below expectations",
        [3] = "Average -- meets basic needs",
        [4] = "Good -- exceeds expectations",
        [5] = "Excellent -- outstanding experience",
    };

    private static readonly string[] _availableTags =
    [
        "Easy to use",
        "Great design",
        "Fast performance",
        "Good documentation",
        "Responsive support",
        "Value for money",
        "Reliable",
        "Customizable",
        "Accessible",
        "Well maintained",
    ];

    private int _currentStep = 0;
    private int _rating = 0;
    private int _hoveredStar = 0;
    private string _title = "";
    private string _body = "";
    private readonly List<string> _selectedTags = new();
    private bool _submitted = false;

    private int _activeRating => _hoveredStar > 0 ? _hoveredStar : _rating;

    private bool _canAdvance =>
        (_currentStep == 0 && _rating > 0) ||
        (_currentStep == 1 && _title.Trim().Length > 0) ||
        _currentStep == 2 ||
        _currentStep == 3;

    private void GoNext()
    {
        if (_currentStep < _steps.Length - 1 && _canAdvance)
            _currentStep++;
    }

    private void GoBack()
    {
        if (_currentStep > 0)
            _currentStep--;
    }

    private void ToggleTag(string tag)
    {
        if (_selectedTags.Contains(tag))
            _selectedTags.Remove(tag);
        else
            _selectedTags.Add(tag);
    }

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
