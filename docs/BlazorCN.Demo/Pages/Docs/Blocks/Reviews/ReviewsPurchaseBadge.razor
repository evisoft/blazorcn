@* ========================================
   Block: reviews-purchase-badge
   Title: Reviews Purchase Badge
   Description: Verified purchase review card with order details and trust badges for React ecommerce platforms
   Long Description: Product rating summary card with image, breakdown bars, and action buttons for React storefronts
   Dependencies: LucideBadgeCheckCn, LucidePackageCn, LucideShoppingBagCn, LucideStarCn, LucideThumbsUpCn
   Source: original/blocks/reviews/reviews-purchase-badge.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Verified Review</h1>
    </div>

    <div class="mx-auto w-[650px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Verified Purchase Banner *@
                <div class="mb-4 flex items-center gap-3 rounded-lg border border-primary/20 bg-primary/5 p-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                        <LucideBadgeCheckCn Class="h-5 w-5 text-primary" Size="20" />
                    </div>
                    <div class="flex-1">
                        <p class="font-medium text-primary">Verified Purchase</p>
                        <p class="text-sm text-muted-foreground">
                            This reviewer bought this item from our store
                        </p>
                    </div>
                </div>

                @* Author *@
                <div class="mb-4 flex items-center gap-3">
                    <AvatarCn Class="h-10 w-10">
                        <AvatarImageCn Alt="Sarah Mitchell" Src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80" />
                        <AvatarFallbackCn>SM</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-medium">Sarah Mitchell</span>
                            <BadgeCn Class="gap-1" Variant="BadgeVariant.Secondary">
                                <LucideBadgeCheckCn Class="h-3 w-3" Size="12" />
                                Verified Buyer
                            </BadgeCn>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-0.5">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <LucideStarCn Class="h-4 w-4 fill-primary text-primary" Size="16" />
                                }
                            </div>
                            <span class="text-sm text-muted-foreground">December 2, 2024</span>
                        </div>
                    </div>
                </div>

                @* Content *@
                <div class="mb-4">
                    <h2 class="mb-2 font-semibold">Perfect fit and amazing quality!</h2>
                    <p class="text-muted-foreground">I was hesitant to buy clothes online, but this exceeded my expectations. The material is soft yet durable, and the fit is exactly as described in the size guide. I ordered my usual size and it fits perfectly. The color is true to the photos. Already planning to buy more colors!</p>
                </div>

                <SeparatorCn Class="mb-4" />

                @* Purchase Details *@
                <div class="mb-4 rounded-lg border p-4">
                    <p class="mb-3 text-sm font-medium">Purchase Details</p>
                    <div class="space-y-2 text-sm">
                        <div class="flex items-center gap-2">
                            <LucideShoppingBagCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span class="text-muted-foreground">Product:</span>
                            <span class="font-medium">Premium Cotton Henley</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <LucidePackageCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span class="text-muted-foreground">Variant:</span>
                            <span class="font-medium">Navy Blue / Size M</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <LucideBadgeCheckCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span class="text-muted-foreground">Ordered:</span>
                            <span class="font-medium">November 15, 2024</span>
                        </div>
                    </div>
                </div>

                @* Helpful *@
                <div class="flex items-center justify-between">
                    <ButtonCn Class="gap-2" Disabled="@_hasVoted" Size="ButtonSize.Sm"
                              Variant="@(_hasVoted ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                              @onclick="HandleHelpful">
                        <LucideThumbsUpCn Class="@Cn.Merge("h-4 w-4", _hasVoted ? "fill-current" : "")" Size="16" />
                        Helpful (@_helpful)
                    </ButtonCn>
                    <span class="text-sm text-muted-foreground">
                        @_helpful people found this helpful
                    </span>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private int _helpful = 24;
    private bool _hasVoted;

    private void HandleHelpful()
    {
        if (!_hasVoted)
        {
            _helpful++;
            _hasVoted = true;
        }
    }
}
