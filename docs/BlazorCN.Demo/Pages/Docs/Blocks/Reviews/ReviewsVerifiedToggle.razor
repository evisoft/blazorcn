@* ============================================================
   Block: reviews-verified-toggle
   Title: ReviewsVerifiedToggle
   Description: A split-panel verified review filter for React and Next.js with real-time metric comparison, animated stat transitions, and rating distribution shifts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-verified-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with toggle *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">Review Authenticity</span>
                <p class="text-xs text-muted-foreground">
                    See how metrics shift when filtering to verified purchases
                </p>
            </div>
            <div class="flex items-center gap-3">
                <BadgeCn Variant="BadgeVariant.Secondary"
                         Class="@Cn.Merge("gap-1 text-xs font-normal transition-colors", _verifiedOnly ? "border-emerald-500/20 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400" : "")">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                    @(_verifiedOnly ? "Verified only" : "All reviews")
                </BadgeCn>
                <SwitchCn Checked="@_verifiedOnly" CheckedChanged="@((bool v) => _verifiedOnly = v)" aria-label="Verified only" />
            </div>
        </div>

        @* Split panel: metrics left, distribution right *@
        <div class="grid sm:grid-cols-2 sm:divide-x">
            @* Left panel: Key metrics *@
            <div class="p-4">
                <span class="text-xs font-medium text-muted-foreground">Key Metrics</span>

                <div class="mt-3 space-y-3">
                    @* Average Rating *@
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Average rating</span>
                        <div class="flex items-center gap-2">
                            @if (_verifiedOnly)
                            {
                                @DeltaIndicatorMarkup(_stats.AverageRating, _allStats.AverageRating, "")
                            }
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                                <span class="text-sm font-semibold tabular-nums">
                                    @_stats.AverageRating.ToString("F1")
                                </span>
                            </div>
                        </div>
                    </div>

                    @* Total reviews *@
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Reviews</span>
                        <span class="text-sm font-semibold tabular-nums">
                            @_stats.TotalReviews.ToString("N0")
                        </span>
                    </div>

                    @* Recommend rate *@
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Recommend rate</span>
                        <div class="flex items-center gap-2">
                            @if (_verifiedOnly)
                            {
                                @DeltaIndicatorMarkup(_stats.RecommendRate, _allStats.RecommendRate, "%")
                            }
                            <span class="text-sm font-semibold tabular-nums">
                                @_stats.RecommendRate%
                            </span>
                        </div>
                    </div>

                    @* Avg word count *@
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Avg review length</span>
                        <div class="flex items-center gap-2">
                            @if (_verifiedOnly)
                            {
                                @DeltaIndicatorMarkup(_stats.AvgWordCount, _allStats.AvgWordCount, "")
                            }
                            <span class="text-sm tabular-nums">
                                @_stats.AvgWordCount words
                            </span>
                        </div>
                    </div>

                    @* With photos *@
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">With photos</span>
                        <span class="text-sm tabular-nums">
                            @_stats.WithPhotos
                        </span>
                    </div>

                    @* Repeat buyer rate *@
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Repeat buyer rate</span>
                        <div class="flex items-center gap-2">
                            @if (_verifiedOnly)
                            {
                                @DeltaIndicatorMarkup(_stats.RepeatBuyerRate, _allStats.RepeatBuyerRate, "%")
                            }
                            <span class="text-sm font-semibold tabular-nums">
                                @_stats.RepeatBuyerRate%
                            </span>
                        </div>
                    </div>
                </div>

                @* Top mention *@
                <div class="mt-4 rounded-md bg-muted/30 p-3">
                    <span class="text-[10px] text-muted-foreground">Most mentioned feature</span>
                    <p class="mt-0.5 text-sm font-medium capitalize">
                        &ldquo;@_stats.TopMention&rdquo;
                    </p>
                </div>
            </div>

            @* Right panel: Distribution + Sentiment *@
            <div class="border-t p-4 sm:border-t-0">
                <span class="text-xs font-medium text-muted-foreground">Rating Distribution</span>

                <div class="mt-3 space-y-2">
                    @foreach (var dist in _stats.Distribution)
                    {
                        var barClass = dist.Stars >= 4
                            ? "bg-foreground/70"
                            : dist.Stars == 3
                                ? "bg-foreground/40"
                                : "bg-foreground/20";
                        <div class="flex items-center gap-2">
                            <div class="flex w-10 items-center justify-end gap-0.5">
                                <span class="text-xs tabular-nums">@dist.Stars</span>
                                <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                            </div>
                            <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="@Cn.Merge("absolute inset-y-0 left-0 rounded-full", barClass)"
                                     style="@($"width:{dist.Percentage}%")"></div>
                            </div>
                            <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">
                                @dist.Percentage%
                            </span>
                        </div>
                    }
                </div>

                @* Sentiment breakdown *@
                <div class="mt-6">
                    <span class="text-xs font-medium text-muted-foreground">Sentiment Breakdown</span>

                    <div class="mt-3">
                        @* Stacked bar *@
                        <div class="flex h-2.5 overflow-hidden rounded-full">
                            <div class="bg-emerald-500/70"
                                 style="@($"width:{_stats.Sentiment.Positive}%")"></div>
                            <div class="bg-foreground/20"
                                 style="@($"width:{_stats.Sentiment.Neutral}%")"></div>
                            <div class="bg-red-500/50"
                                 style="@($"width:{_stats.Sentiment.Negative}%")"></div>
                        </div>

                        @* Labels *@
                        <div class="mt-2 flex items-center gap-4">
                            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="size-2 rounded-full bg-emerald-500/70"></span>
                                Positive @_stats.Sentiment.Positive%
                            </span>
                            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="size-2 rounded-full bg-foreground/20"></span>
                                Neutral @_stats.Sentiment.Neutral%
                            </span>
                            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="size-2 rounded-full bg-red-500/50"></span>
                                Negative @_stats.Sentiment.Negative%
                            </span>
                        </div>

                        @* Delta callout when verified *@
                        @if (_verifiedOnly)
                        {
                            <div class="mt-3 rounded-md bg-emerald-500/5 p-2.5">
                                <p class="text-xs text-emerald-700 dark:text-emerald-400">
                                    Verified reviews show @(_verifiedStats.Sentiment.Positive - _allStats.Sentiment.Positive)% higher positive sentiment and @(_allStats.Sentiment.Negative - _verifiedStats.Sentiment.Negative)% lower negative sentiment
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SentimentData(int Positive, int Neutral, int Negative);
    private record RatingDist(int Stars, int Count, int Percentage);
    private record ReviewStats(
        int TotalReviews,
        double AverageRating,
        int RecommendRate,
        int AvgWordCount,
        int WithPhotos,
        RatingDist[] Distribution,
        SentimentData Sentiment,
        string TopMention,
        int RepeatBuyerRate
    );

    private static readonly ReviewStats _allStats = new(
        TotalReviews: 1247,
        AverageRating: 4.1,
        RecommendRate: 82,
        AvgWordCount: 67,
        WithPhotos: 312,
        Distribution:
        [
            new(5, 524, 42),
            new(4, 337, 27),
            new(3, 187, 15),
            new(2, 112, 9),
            new(1, 87, 7),
        ],
        Sentiment: new(69, 18, 13),
        TopMention: "noise cancellation",
        RepeatBuyerRate: 34
    );

    private static readonly ReviewStats _verifiedStats = new(
        TotalReviews: 891,
        AverageRating: 4.4,
        RecommendRate: 91,
        AvgWordCount: 94,
        WithPhotos: 267,
        Distribution:
        [
            new(5, 418, 47),
            new(4, 258, 29),
            new(3, 125, 14),
            new(2, 58, 7),
            new(1, 32, 3),
        ],
        Sentiment: new(76, 16, 8),
        TopMention: "build quality",
        RepeatBuyerRate: 52
    );

    private bool _verifiedOnly = false;
    private ReviewStats _stats => _verifiedOnly ? _verifiedStats : _allStats;

    private RenderFragment DeltaIndicatorMarkup(double current, double previous, string suffix)
    {
        var delta = current - previous;
        if (delta == 0)
        {
            return @<span class="flex items-center gap-0.5 text-xs text-muted-foreground">
                <LucideIconCn Name="minus" Size="12" Class="size-3" />0@suffix
            </span>;
        }
        var isPositive = delta > 0;
        var colorClass = isPositive
            ? "text-emerald-600 dark:text-emerald-400"
            : "text-red-600 dark:text-red-400";
        var iconName = delta > 0 ? "arrow-up" : "arrow-down";
        var sign = delta > 0 ? "+" : "";
        var formatted = suffix == "%" ? ((int)Math.Round(delta)).ToString() : delta.ToString("F1");
        return @<span class="@Cn.Merge("flex items-center gap-0.5 text-xs", colorClass)">
            <LucideIconCn Name="@iconName" Size="12" Class="size-3" />@sign@formatted@suffix
        </span>;
    }
}
