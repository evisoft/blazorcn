@* ========================================
   Block: reviews-timeline
   Title: Reviews Timeline
   Description: Chronological review timeline component with date grouping for React admin dashboards
   Long Description: Review thread component with seller reply and official response badge for React marketplaces
   Dependencies: LucideStarCn
   Source: original/blocks/reviews/reviews-timeline.tsx
   ======================================== *@
<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Review Timeline</h1>
        <p class="mt-2 text-muted-foreground">Recent customer feedback</p>
    </div>

    <div class="mx-auto w-[600px] max-w-full">
        @foreach (var dateGroup in _dateGroups)
        {
            <div class="relative">
                @* Date Header *@
                <div class="mb-4 flex items-center gap-4">
                    <div class="h-px flex-1 bg-border"></div>
                    <span class="text-sm font-medium text-muted-foreground">@dateGroup</span>
                    <div class="h-px flex-1 bg-border"></div>
                </div>

                @* Reviews *@
                <div class="relative space-y-4 pb-6">
                    @* Timeline Line *@
                    <div class="absolute bottom-0 left-5 top-0 w-px bg-border"></div>

                    @foreach (var review in _reviews.Where(r => r.DateGroup == dateGroup))
                    {
                        <div class="relative flex gap-4">
                            @* Timeline Dot *@
                            <div class="relative z-10">
                                <AvatarCn Class="h-10 w-10 border-2 border-background">
                                    <AvatarImageCn Alt="@review.AuthorName" Src="@review.AuthorAvatar" />
                                    <AvatarFallbackCn>@GetInitials(review.AuthorName)</AvatarFallbackCn>
                                </AvatarCn>
                            </div>

                            @* Review Card *@
                            <CardCn Class="flex-1">
                                <CardContentCn Class="p-4">
                                    <div class="mb-2 flex items-start justify-between gap-2">
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="font-medium">@review.AuthorName</span>
                                                <BadgeCn Class="@($"gap-0.5 @(GetRatingColor(review.Rating))")">
                                                    <LucideStarCn Size="12" Class="fill-current" />
                                                    @review.Rating
                                                </BadgeCn>
                                            </div>
                                            <p class="text-xs text-muted-foreground">
                                                @review.Product &middot; @review.Date
                                            </p>
                                        </div>
                                    </div>
                                    <h3 class="mb-1 font-medium">@review.Title</h3>
                                    <p class="text-sm text-muted-foreground line-clamp-2">@review.Snippet</p>
                                </CardContentCn>
                            </CardCn>
                        </div>
                    }
                </div>
            </div>
        }

        @* Load More *@
        <div class="mt-4 text-center">
            <button type="button" class="text-sm text-primary hover:underline">
                Load earlier reviews
            </button>
        </div>
    </div>
</section>

@code {
    private readonly int _year = DateTime.Now.Year;

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private static string GetRatingColor(int rating) =>
        rating >= 4 ? "bg-primary text-primary-foreground"
        : rating >= 3 ? "bg-muted text-muted-foreground"
        : "bg-destructive text-destructive-foreground";

    private string[] _dateGroups => _reviews.Select(r => r.DateGroup).Distinct().ToArray();

    private record TimelineReview(string AuthorName, string AuthorAvatar, int Rating, string Title, string Snippet, string Product, string Date, string DateGroup);

    private readonly TimelineReview[] _reviews =
    [
        new("Emma Wilson", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80", 5, "Absolutely love it!", "This exceeded all my expectations. Quality is outstanding and delivery was fast.", "Wireless Earbuds Pro", "2:34 PM", "Today"),
        new("James Chen", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80", 4, "Great product, minor issues", "Overall very satisfied. The only issue was the packaging was slightly damaged.", "Smart Watch Elite", "11:20 AM", "Today"),
        new("Sophie Brown", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&w=100&q=80", 5, "Perfect gift choice", "Bought this for my husband and he loves it. Will definitely buy again.", "Leather Wallet Premium", "4:15 PM", "Yesterday"),
        new("Michael Park", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&w=100&q=80", 3, "Decent but expected more", "Product is okay but not as described. Customer service was helpful though.", "Bluetooth Speaker", "9:45 AM", "Yesterday"),
        new("Olivia Davis", "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&w=100&q=80", 5, "Best purchase this year", "Incredible quality and the color is exactly as shown. Highly recommend!", "Yoga Mat Premium", "Dec 3", "This Week"),
