@* ============================================================
   Block: reviews-settings-config
   Title: ReviewsSettingsConfig
   Description: A review system admin settings panel for React and Next.js with sidebar navigation, toggle switches for moderation, auto-publish, email notifications, display preferences, and spam filter configuration using shadcn/ui Switch, Select, and Tailwind CSS.
   Source: original/blocks/reviews/reviews-settings-config.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-sm font-medium">Review Settings</span>
                @if (_hasChanges)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                        Unsaved changes
                    </BadgeCn>
                }
                @if (_saveState == "saved" && !_hasChanges)
                {
                    <span class="flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        Saved
                    </span>
                }
            </div>
            <div class="flex items-center gap-1.5">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="HandleReset">
                    Reset defaults
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="HandleSave" disabled="@(!_hasChanges)">
                    Save changes
                </ButtonCn>
            </div>
        </div>

        @* Sidebar + Content *@
        <div class="grid grid-cols-1 md:grid-cols-4">
            @* Sidebar nav *@
            <div class="border-b p-2 md:border-b-0 md:border-r md:p-3">
                <div class="flex gap-1 overflow-x-auto md:flex-col">
                    @foreach (var navItem in _navItems)
                    {
                        var item = navItem;
                        var isActive = _activeSection == item.Id;
                        <button type="button"
                                @onclick="@(() => _activeSection = item.Id)"
                                class="@Cn.Merge("flex shrink-0 items-center gap-2 rounded-md px-3 py-2 text-left text-xs transition-colors md:w-full", isActive ? "bg-muted/50 font-medium" : "text-muted-foreground hover:bg-muted/30 hover:text-foreground")">
                            <span class="@(isActive ? "text-foreground" : "text-muted-foreground")">
                                <LucideIconCn Name="@item.IconName" Size="14" Class="size-3.5" />
                            </span>
                            <span class="hidden md:inline">@item.Label</span>
                            <span class="md:hidden">@item.Label</span>
                        </button>
                    }
                </div>
            </div>

            @* Content area *@
            <div class="col-span-1 md:col-span-3">
                <div class="p-4">
                    @* Section header *@
                    <div class="mb-3">
                        <span class="text-sm font-medium">
                            @(_navItems.FirstOrDefault(n => n.Id == _activeSection)?.Label)
                        </span>
                        <p class="text-xs text-muted-foreground">
                            @(_navItems.FirstOrDefault(n => n.Id == _activeSection)?.Description)
                        </p>
                    </div>

                    <SeparatorCn Class="mb-2" />

                    @* Dynamic content *@
                    @if (_activeSection == "publishing")
                    {
                        <div class="space-y-0 divide-y">
                            @RenderToggleRow("autoPublish", "Auto-publish reviews", "Publish new reviews without manual approval")
                            @RenderToggleRow("requireVerifiedPurchase", "Require verified purchase", "Only allow reviews from verified buyers")
                            @RenderToggleRow("allowMediaUploads", "Allow photo and video uploads", "Let reviewers attach images and videos")
                            <div class="flex items-center justify-between py-2.5">
                                <div class="pr-4">
                                    <span class="text-sm">Minimum word count</span>
                                    <p class="text-xs text-muted-foreground">
                                        Require a minimum number of words per review
                                    </p>
                                </div>
                                <SelectCn Value="@_settings.MinWordCount" ValueChanged="@((string? v) => UpdateMinWordCount(v))">
                                    <SelectTriggerCn Class="h-8 w-24 text-xs">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="none">None</SelectItemCn>
                                        <SelectItemCn Value="10">10 words</SelectItemCn>
                                        <SelectItemCn Value="20">20 words</SelectItemCn>
                                        <SelectItemCn Value="50">50 words</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                        </div>
                    }
                    else if (_activeSection == "moderation")
                    {
                        <div class="space-y-0">
                            <div class="pb-3">
                                <span class="text-xs font-medium text-muted-foreground">Moderation level</span>
                                <div class="mt-2 flex flex-col gap-1">
                                    @foreach (var lvl in _moderationLevels)
                                    {
                                        var level = lvl;
                                        var isLevelActive = _settings.ModerationLevel == level.Key;
                                        <button type="button"
                                                @onclick="@(() => UpdateModerationLevel(level.Key))"
                                                class="@Cn.Merge("flex items-center gap-3 rounded-md px-3 py-2 text-left transition-colors", isLevelActive ? "bg-muted/50" : "hover:bg-muted/30")">
                                            <span class="@Cn.Merge("size-3 shrink-0 rounded-full border-2 transition-colors", isLevelActive ? "border-foreground bg-foreground" : "border-muted-foreground/40")">
                                                @if (isLevelActive)
                                                {
                                                    <span class="flex size-full items-center justify-center">
                                                        <span class="size-1.5 rounded-full bg-card"></span>
                                                    </span>
                                                }
                                            </span>
                                            <div>
                                                <span class="text-sm font-medium">@level.Label</span>
                                                <span class="block text-xs text-muted-foreground">@level.Desc</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                            </div>
                            <SeparatorCn />
                            <div class="divide-y pt-1">
                                @RenderToggleRow("autoFlagLowRatings", "Auto-flag low ratings", "Flag reviews with 1-2 stars for manual review")
                                @RenderToggleRow("profanityFilter", "Profanity filter", "Automatically censor profanity in review text")
                                @RenderToggleRow("requireApprovalForEdits", "Require approval for edits", "Re-moderate reviews when customers edit them")
                            </div>
                        </div>
                    }
                    else if (_activeSection == "notifications")
                    {
                        <div class="space-y-0 divide-y">
                            @RenderToggleRow("emailOnNewReview", "New review submitted", "Get notified when a customer leaves a review")
                            @RenderToggleRow("emailOnReply", "Reply to your response", "Get notified when someone replies to your response")
                            @RenderToggleRow("emailOnFlag", "Review flagged", "Get notified when a review is flagged for moderation")
                            <div class="flex items-center justify-between py-2.5">
                                <div class="pr-4">
                                    <span class="text-sm">Email digest</span>
                                    <p class="text-xs text-muted-foreground">
                                        Receive a periodic summary of review activity
                                    </p>
                                </div>
                                <SelectCn Value="@_settings.DigestFrequency" ValueChanged="@((string? v) => UpdateDigestFrequency(v))">
                                    <SelectTriggerCn Class="h-8 w-24 text-xs">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="off">Off</SelectItemCn>
                                        <SelectItemCn Value="daily">Daily</SelectItemCn>
                                        <SelectItemCn Value="weekly">Weekly</SelectItemCn>
                                        <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                        </div>
                    }
                    else if (_activeSection == "display")
                    {
                        <div class="space-y-0 divide-y">
                            @RenderToggleRow("showStarRatings", "Show star ratings", "Display star ratings on published reviews")
                            @RenderToggleRow("showReviewerBadges", "Show reviewer badges", "Display verified purchase and top reviewer badges")
                            @RenderToggleRow("showHelpfulVotes", "Show helpful votes", "Allow users to vote on review helpfulness")
                            @RenderToggleRow("showReviewDates", "Show review dates", "Display the date each review was submitted")
                        </div>
                    }
                    else if (_activeSection == "spam")
                    {
                        <div class="space-y-0 divide-y">
                            @RenderToggleRow("enableCaptcha", "Enable CAPTCHA verification", "Require CAPTCHA before submitting a review")
                            @RenderToggleRow("blockDisposableEmails", "Block disposable emails", "Reject reviews from temporary email addresses")
                            @RenderToggleRow("rateLimitReviews", "Rate limit submissions", "Limit each user to one review per product per day")
                            @RenderToggleRow("requireAccountAge", "Require account age", "Only allow reviews from accounts older than 7 days")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _activeSection = "publishing";
    private string _saveState = "idle";

    private class SettingsModel
    {
        public bool AutoPublish { get; set; } = false;
        public bool RequireVerifiedPurchase { get; set; } = false;
        public string MinWordCount { get; set; } = "20";
        public bool AllowMediaUploads { get; set; } = true;
        public string ModerationLevel { get; set; } = "standard";
        public bool AutoFlagLowRatings { get; set; } = true;
        public bool ProfanityFilter { get; set; } = true;
        public bool RequireApprovalForEdits { get; set; } = false;
        public bool EmailOnNewReview { get; set; } = true;
        public bool EmailOnReply { get; set; } = true;
        public bool EmailOnFlag { get; set; } = true;
        public string DigestFrequency { get; set; } = "weekly";
        public bool ShowStarRatings { get; set; } = true;
        public bool ShowReviewerBadges { get; set; } = true;
        public bool ShowHelpfulVotes { get; set; } = true;
        public bool ShowReviewDates { get; set; } = true;
        public bool EnableCaptcha { get; set; } = true;
        public bool BlockDisposableEmails { get; set; } = false;
        public bool RateLimitReviews { get; set; } = true;
        public bool RequireAccountAge { get; set; } = false;

        public SettingsModel Clone() => (SettingsModel)MemberwiseClone();
        public bool Equals(SettingsModel other) =>
            AutoPublish == other.AutoPublish &&
            RequireVerifiedPurchase == other.RequireVerifiedPurchase &&
            MinWordCount == other.MinWordCount &&
            AllowMediaUploads == other.AllowMediaUploads &&
            ModerationLevel == other.ModerationLevel &&
            AutoFlagLowRatings == other.AutoFlagLowRatings &&
            ProfanityFilter == other.ProfanityFilter &&
            RequireApprovalForEdits == other.RequireApprovalForEdits &&
            EmailOnNewReview == other.EmailOnNewReview &&
            EmailOnReply == other.EmailOnReply &&
            EmailOnFlag == other.EmailOnFlag &&
            DigestFrequency == other.DigestFrequency &&
            ShowStarRatings == other.ShowStarRatings &&
            ShowReviewerBadges == other.ShowReviewerBadges &&
            ShowHelpfulVotes == other.ShowHelpfulVotes &&
            ShowReviewDates == other.ShowReviewDates &&
            EnableCaptcha == other.EnableCaptcha &&
            BlockDisposableEmails == other.BlockDisposableEmails &&
            RateLimitReviews == other.RateLimitReviews &&
            RequireAccountAge == other.RequireAccountAge;
    }

    private class NavItem
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string IconName { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private class ModerationLevel
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public string Desc { get; set; } = "";
    }

    private static readonly NavItem[] _navItems =
    [
        new() { Id = "publishing", Label = "Publishing", IconName = "globe", Description = "Control how reviews are published" },
        new() { Id = "moderation", Label = "Moderation", IconName = "shield", Description = "Review moderation and filtering rules" },
        new() { Id = "notifications", Label = "Notifications", IconName = "bell", Description = "Email and alert preferences" },
        new() { Id = "display", Label = "Display", IconName = "eye", Description = "Public-facing review display options" },
        new() { Id = "spam", Label = "Spam Protection", IconName = "shield", Description = "Automated spam prevention settings" },
    ];

    private static readonly ModerationLevel[] _moderationLevels =
    [
        new() { Key = "relaxed", Label = "Relaxed", Desc = "Auto-publish most reviews, flag only obvious spam" },
        new() { Key = "standard", Label = "Standard", Desc = "Flag reviews with keywords, low ratings require approval" },
        new() { Key = "strict", Label = "Strict", Desc = "All reviews require manual approval before publishing" },
    ];

    private SettingsModel _settings = new();
    private SettingsModel _savedSettings = new();

    private bool _hasChanges => !_settings.Equals(_savedSettings);

    private void HandleSave()
    {
        _savedSettings = _settings.Clone();
        _saveState = "saved";
    }

    private void HandleReset()
    {
        _settings = new SettingsModel();
        _savedSettings = new SettingsModel();
        _saveState = "idle";
    }

    private void UpdateModerationLevel(string key)
    {
        _settings.ModerationLevel = key;
        _saveState = "idle";
    }

    private void UpdateMinWordCount(string? v)
    {
        _settings.MinWordCount = v ?? "none";
        _saveState = "idle";
    }

    private void UpdateDigestFrequency(string? v)
    {
        _settings.DigestFrequency = v ?? "off";
        _saveState = "idle";
    }

    private void SetBoolSetting(string key, bool value)
    {
        switch (key)
        {
            case "autoPublish": _settings.AutoPublish = value; break;
            case "requireVerifiedPurchase": _settings.RequireVerifiedPurchase = value; break;
            case "allowMediaUploads": _settings.AllowMediaUploads = value; break;
            case "autoFlagLowRatings": _settings.AutoFlagLowRatings = value; break;
            case "profanityFilter": _settings.ProfanityFilter = value; break;
            case "requireApprovalForEdits": _settings.RequireApprovalForEdits = value; break;
            case "emailOnNewReview": _settings.EmailOnNewReview = value; break;
            case "emailOnReply": _settings.EmailOnReply = value; break;
            case "emailOnFlag": _settings.EmailOnFlag = value; break;
            case "showStarRatings": _settings.ShowStarRatings = value; break;
            case "showReviewerBadges": _settings.ShowReviewerBadges = value; break;
            case "showHelpfulVotes": _settings.ShowHelpfulVotes = value; break;
            case "showReviewDates": _settings.ShowReviewDates = value; break;
            case "enableCaptcha": _settings.EnableCaptcha = value; break;
            case "blockDisposableEmails": _settings.BlockDisposableEmails = value; break;
            case "rateLimitReviews": _settings.RateLimitReviews = value; break;
            case "requireAccountAge": _settings.RequireAccountAge = value; break;
        }
        _saveState = "idle";
    }

    private bool GetBoolSetting(string key) => key switch
    {
        "autoPublish" => _settings.AutoPublish,
        "requireVerifiedPurchase" => _settings.RequireVerifiedPurchase,
        "allowMediaUploads" => _settings.AllowMediaUploads,
        "autoFlagLowRatings" => _settings.AutoFlagLowRatings,
        "profanityFilter" => _settings.ProfanityFilter,
        "requireApprovalForEdits" => _settings.RequireApprovalForEdits,
        "emailOnNewReview" => _settings.EmailOnNewReview,
        "emailOnReply" => _settings.EmailOnReply,
        "emailOnFlag" => _settings.EmailOnFlag,
        "showStarRatings" => _settings.ShowStarRatings,
        "showReviewerBadges" => _settings.ShowReviewerBadges,
        "showHelpfulVotes" => _settings.ShowHelpfulVotes,
        "showReviewDates" => _settings.ShowReviewDates,
        "enableCaptcha" => _settings.EnableCaptcha,
        "blockDisposableEmails" => _settings.BlockDisposableEmails,
        "rateLimitReviews" => _settings.RateLimitReviews,
        "requireAccountAge" => _settings.RequireAccountAge,
        _ => false,
    };

    private RenderFragment RenderToggleRow(string key, string title, string description) =>
        @<div class="flex items-center justify-between py-2.5">
            <div class="pr-4">
                <span class="text-sm">@title</span>
                <p class="text-xs text-muted-foreground">@description</p>
            </div>
            <SwitchCn Checked="@GetBoolSetting(key)" CheckedChanged="@((bool v) => SetBoolSetting(key, v))" />
        </div>;
}
