@* ============================================================
   Block: reviews-request-prompt
   Title: ReviewsRequestPrompt
   Description: A React review request prompt for Next.js with interactive star rating selector, quick feedback tags, optional text area, animated submission flow, and delivery confirmation built with shadcn/ui Button, Badge, Textarea components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-request-prompt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_step == "submitted")
        {
            <div class="flex flex-col items-center px-6 py-12 text-center">
                <LucideIconCn Name="check-circle-2" Size="48" Class="size-12 text-emerald-500" />
                <p class="mt-4 text-sm font-medium">
                    Thank you for your feedback!
                </p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Your @(_ratingLabels[_rating].ToLower()) rating and
                    @(_selectedTags.Count > 0 ? $"{_selectedTags.Count} feedback tags" : "review") help other
                    shoppers make informed decisions.
                </p>
                <div class="mt-4 flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="16" Class="@($"size-4 {(idx < _rating ? "fill-amber-400 text-amber-400" : "text-muted-foreground/20")}")" />
                    }
                </div>
            </div>
        }
        else
        {
            @* Product context header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="package-check" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@_productName</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_productVariant</p>
                </div>
                <div class="text-right">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                        Delivered @(_productDaysAgo)d ago
                    </BadgeCn>
                </div>
            </div>

            @* Rating step *@
            <div class="px-4 py-5">
                <div class="text-center">
                    <span class="text-sm font-medium">How was your experience?</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Your feedback helps other shoppers decide
                    </p>
                </div>

                @* Star selector *@
                <div class="mt-5 flex flex-col items-center">
                    <div class="flex items-center gap-1.5">
                        @foreach (var starVal in _starValues)
                        {
                            var star = starVal;
                            var isActive = star <= _activeRating;
                            <button type="button"
                                    class="rounded-md p-1 transition-colors hover:bg-muted/50"
                                    @onmouseenter="@(() => _hoveredStar = star)"
                                    @onmouseleave="@(() => _hoveredStar = 0)"
                                    @onclick="@(() => HandleRatingSelect(star))">
                                <LucideIconCn Name="star" Size="32" Class="@($"size-8 transition-colors duration-150 {(isActive ? "fill-amber-400 text-amber-400" : "text-muted-foreground/25")}")" />
                            </button>
                        }
                    </div>
                    @if (_activeRating > 0)
                    {
                        <span class="mt-2 text-xs font-medium text-muted-foreground">@_ratingLabels[_activeRating]</span>
                    }
                </div>
            </div>

            @* Details step - quick tags and optional text *@
            @if (_step == "details")
            {
                <div class="overflow-hidden">
                    <div class="border-t px-4 py-4">
                        @* Quick feedback tags *@
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="tag" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-xs font-medium text-muted-foreground">
                                What stood out? (optional)
                            </span>
                        </div>
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                            @foreach (var tagVal in _feedbackTags)
                            {
                                var tag = tagVal;
                                var isSelected = _selectedTags.Contains(tag);
                                <button type="button"
                                        class="@($"rounded-full border px-2.5 py-1 text-xs transition-colors {(isSelected ? "border-foreground/20 bg-foreground/5 font-medium text-foreground" : "border-transparent bg-muted/50 text-muted-foreground hover:bg-muted")}")"
                                        @onclick="@(() => HandleTagToggle(tag))">
                                    @tag
                                </button>
                            }
                        </div>

                        @* Toggle textarea *@
                        @if (!_showTextarea)
                        {
                            <button type="button"
                                    class="mt-3 text-xs text-muted-foreground underline decoration-muted-foreground/40 underline-offset-2 transition-colors hover:text-foreground"
                                    @onclick="@(() => _showTextarea = true)">
                                Add a written review (optional)
                            </button>
                        }
                        else
                        {
                            <div class="mt-3 overflow-hidden">
                                <TextareaCn @bind-Value="_reviewText"
                                            Placeholder="Tell others about your experience..."
                                            Class="min-h-[80px] resize-none text-sm" />
                                <span class="mt-1 block text-right text-[10px] tabular-nums text-muted-foreground">
                                    @_reviewText.Length characters
                                </span>
                            </div>
                        }
                    </div>

                    @* Submit footer *@
                    <div class="flex items-center justify-between border-t px-4 py-3">
                        <span class="text-[10px] text-muted-foreground">
                            Order @_orderNumber
                        </span>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleSubmit">
                            Submit Review
                        </ButtonCn>
                    </div>
                </div>
            }

            @* Pre-rating footer hint *@
            @if (_step == "rating")
            {
                <div class="border-t px-4 py-2.5">
                    <span class="text-[10px] text-muted-foreground">
                        Order @_orderNumber delivered @_deliveredDate
                    </span>
                </div>
            }
        }
    </div>
</section>

@code {
    private string _step = "rating";
    private int _rating = 0;
    private int _hoveredStar = 0;
    private readonly HashSet<string> _selectedTags = new();
    private string _reviewText = "";
    private bool _showTextarea = false;

    private int _activeRating => _hoveredStar > 0 ? _hoveredStar : _rating;

    private static readonly int[] _starValues = [1, 2, 3, 4, 5];

    // Index 0 unused; 1-5 map to labels
    private static readonly string[] _ratingLabels = ["", "Poor", "Fair", "Good", "Great", "Excellent"];

    private static readonly string[] _feedbackTags =
    [
        "Build Quality",
        "Sound Quality",
        "Comfort",
        "Battery Life",
        "Noise Cancellation",
        "Value for Money",
        "Fast Shipping",
        "Great Packaging",
    ];

    // Product data
    private const string _productName = "Wireless Noise-Cancelling Headphones";
    private const string _productVariant = "Matte Black / Over-Ear";
    private const string _orderNumber = "ORD-48291";
    private const string _deliveredDate = "Mar 18, 2026";
    private const int _productDaysAgo = 5;

    private void HandleTagToggle(string tag)
    {
        if (_selectedTags.Contains(tag))
            _selectedTags.Remove(tag);
        else
            _selectedTags.Add(tag);
    }

    private void HandleRatingSelect(int star)
    {
        _rating = star;
        _step = "details";
    }

    private void HandleSubmit()
    {
        _step = "submitted";
    }
}
