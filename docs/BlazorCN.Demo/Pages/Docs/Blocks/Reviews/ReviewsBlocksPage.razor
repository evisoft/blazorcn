    private record ReviewItem(int Id, string Author, string Initials, int Rating, string Date, string Content, string Product, string Status);
    private record SortOption(string Value, string Label);

    private static readonly ReviewItem[] _reviews =
    [
        new(1, ""Emma Richardson"", ""ER"", 5, ""Dec 5, 2024"", ""Absolutely love this product! The quality exceeded my expectations and shipping was incredibly fast."", ""Wireless Earbuds Pro"", ""published""),
        new(2, ""James Cooper"", ""JC"", 4, ""Dec 4, 2024"", ""Great value for the price. Minor issue with packaging but the product itself works perfectly."", ""Smart Watch Elite"", ""published""),
        new(3, ""Olivia Martinez"", ""OM"", 5, ""Dec 3, 2024"", ""This is exactly what I was looking for. Premium feel and excellent build quality."", ""Laptop Stand Adjustable"", ""pending""),
        new(4, ""William Chen"", ""WC"", 3, ""Dec 2, 2024"", ""Decent product but took longer to arrive than expected. Works as described but nothing extraordinary."", ""USB-C Hub 7-in-1"", ""published""),
        new(5, ""Sophia Taylor"", ""ST"", 5, ""Dec 1, 2024"", ""Perfect gift for my husband! He uses it daily and loves it. The design is sleek and modern."", ""Wireless Earbuds Pro"", ""published""),
    ];

    private static readonly SortOption[] _sortOptions =
    [
        new(""newest"", ""Newest first""),
        new(""oldest"", ""Oldest first""),
        new(""highest"", ""Highest rated""),
        new(""lowest"", ""Lowest rated""),
    ];

    private string _filter = ""all"";
    private string _sort = ""newest"";

    private ReviewItem[] _filteredReviews
    {
        get
        {
            var filtered = _filter == ""all""
                ? _reviews
                : _reviews.Where(r => r.Rating == int.Parse(_filter)).ToArray();

            return _sort switch
            {
                ""oldest"" => filtered.OrderBy(r => r.Id).ToArray(),
                ""highest"" => filtered.OrderByDescending(r => r.Rating).ToArray(),
                ""lowest"" => filtered.OrderBy(r => r.Rating).ToArray(),
                _ => filtered.OrderByDescending(r => r.Id).ToArray(),
            };
        }
    }
}";
