    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (!_isPaused)
            {
                _activeActivity = (_activeActivity + 1) % _activityFeed.Length;
                InvokeAsync(StateHasChanged);
            }
        }, null, 3500, 3500);
