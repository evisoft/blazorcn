                            stroke-width=""8""
                            stroke-linecap=""round""
                            class=""@StrokeColor(_summary.OverallRate)""
                            stroke-dasharray=""@_ringCircumference.ToString(""F4"")""
                            stroke-dashoffset=""@_rateOffset.ToString(""F4"")"" />
                    </svg>
                    <div class=""absolute inset-0 flex flex-col items-center justify-center"">
                        <span class=""@($""font-semibold text-3xl tabular-nums {RateColor(_summary.OverallRate)}"")"">
                            @(_summary.OverallRate)%
                        </span>
