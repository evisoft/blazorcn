@code {
    private bool _isExpanded;
    private int _likes = 47;
    private int _dislikes = 3;
    private string? _userVote;

    private const string _authorName = ""Adam Smith"";
    private const string _authorTitle = ""CEO at ACME Inc."";
    private const string _authorAvatar = ""https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80"";
    private const int _rating = 5;
    private const string _reviewTitle = ""Wished I bought this thing sooner!"";
    private const string _reviewContent = ""I recently got my hands on this amazing bag, and after using it for a while, I can confidently say it is a solid choice for travelling. The build quality is exceptional, with reinforced stitching and premium materials throughout. The organization options are fantastic - multiple compartments for laptop, tablet, and all your accessories. The ergonomic design makes it comfortable even when fully loaded. Verdict: If you are looking for an amazing backpack that balances comfort, organization, and durability, this is a great investment. Would definitely recommend it to anyone in need of a reliable bag!"";

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private void HandleVote(string vote)
    {
        if (_userVote == vote)
        {
            // Remove vote
            if (vote == ""like"") _likes--;
            else _dislikes--;
            _userVote = null;
        }
        else
        {
            // Remove previous vote if any
            if (_userVote == ""like"") _likes--;
            if (_userVote == ""dislike"") _dislikes--;
            // Add new vote
            if (vote == ""like"") _likes++;
            else _dislikes++;
            _userVote = vote;
        }
    }
}";
}
