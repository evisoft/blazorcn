@code {
    private const string ReviewsAnalyticsCode = @"<section class=""container mx-auto px-4 py-6"">
    <div class=""mb-6 text-center"">
        <h1 class=""text-3xl font-bold tracking-tight"">Review Analytics</h1>
        <p class=""mt-2 text-muted-foreground"">Performance overview and trends</p>
    </div>

    <div class=""mx-auto w-[700px] max-w-full space-y-6"">
        @* Period Selector *@
        <div class=""flex justify-end"">
            <SelectCn Value=""@_period"" ValueChanged=""@((string v) => _period = v)"">
                <SelectTriggerCn Class=""w-[140px]"">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value=""7d"">Last 7 days</SelectItemCn>
                    <SelectItemCn Value=""30d"">Last 30 days</SelectItemCn>
                    <SelectItemCn Value=""90d"">Last 90 days</SelectItemCn>
                    <SelectItemCn Value=""1y"">Last year</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Stats Grid *@
        <div class=""grid gap-4 sm:grid-cols-3"">
            <CardCn>
                <CardContentCn Class=""p-6"">
                    <p class=""text-sm text-muted-foreground"">Average Rating</p>
                    <div class=""mt-2 flex items-baseline gap-2"">
                        <span class=""text-3xl font-bold tabular-nums"">
                            @_data.AverageRating.ToString(""F1"")
                        </span>
                        <LucideStarCn Class=""h-5 w-5 fill-primary text-primary"" Size=""20"" />
                    </div>
                    <div class=""mt-2"">
                        <BadgeCn Class=""gap-1"" Variant=""BadgeVariant.Secondary"">
                            @if (_data.Trend > 0)
                            {
                                <LucideArrowUpCn Class=""h-3.5 w-3.5"" Size=""14"" />
                            }
                            else if (_data.Trend < 0)
                            {
                                <LucideArrowDownCn Class=""h-3.5 w-3.5"" Size=""14"" />
                            }
                            else
                            {
                                <LucideMinusCn Class=""h-3.5 w-3.5"" Size=""14"" />
                            }
                            <span class=""tabular-nums"">
                                @(_data.Trend > 0 ? ""+"" : """")@_data.Trend.ToString(""F1"")
                            </span>
                        </BadgeCn>
                    </div>
                </CardContentCn>
            </CardCn>

            <CardCn>
                <CardContentCn Class=""p-6"">
                    <p class=""text-sm text-muted-foreground"">Total Reviews</p>
                    <p class=""mt-2 text-3xl font-bold tabular-nums"">
                        @_data.TotalReviews.ToString(""N0"")
                    </p>
                    <p class=""mt-2 text-sm text-muted-foreground"">this period</p>
                </CardContentCn>
            </CardCn>

            <CardCn>
                <CardContentCn Class=""p-6"">
                    <p class=""text-sm text-muted-foreground"">Response Rate</p>
                    <p class=""mt-2 text-3xl font-bold tabular-nums"">@_data.ResponseRate%</p>
                    <p class=""mt-2 text-sm text-muted-foreground"">of reviews answered</p>
                </CardContentCn>
            </CardCn>
        </div>

        @* Distribution *@
        <CardCn>
            <CardHeaderCn Class=""pb-2"">
                <CardTitleCn Class=""text-base font-medium"">Rating Distribution</CardTitleCn>
            </CardHeaderCn>
            <CardContentCn>
                <div class=""space-y-3"">
                    @for (var rating = 5; rating >= 1; rating--)
                    {
                        var r = rating;
                        <div class=""flex items-center gap-3"">
                            <div class=""flex w-12 items-center gap-1"">
                                <span class=""text-sm tabular-nums"">@r</span>
                                <LucideStarCn Class=""h-3.5 w-3.5 fill-primary text-primary"" Size=""14"" />
                            </div>
                            <ProgressCn Class=""h-2 flex-1"" Value=""@_data.Distribution[r - 1]"" />
                            <span class=""w-12 text-right text-sm tabular-nums text-muted-foreground"">
                                @_data.Distribution[r - 1]%
                            </span>
                        </div>
                    }
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record PeriodData(double AverageRating, int TotalReviews, double Trend, int[] Distribution, int ResponseRate);

    private static readonly Dictionary<string, PeriodData> _analytics = new()
    {
        [""7d""] = new(4.6, 47, 0.3, [2, 3, 8, 12, 75], 92),
        [""30d""] = new(4.4, 186, 0.1, [3, 5, 10, 18, 64], 88),
        [""90d""] = new(4.3, 524, -0.2, [4, 6, 12, 20, 58], 85),
        [""1y""] = new(4.2, 2847, 0, [5, 7, 14, 22, 52], 82),
    };

    private string _period = ""30d"";
    private PeriodData _data => _analytics[_period];
}";
    private const string ReviewsCardsGridCode = @"<section class=""container mx-auto px-4 py-6"">
    <div class=""mb-6 text-center"">
        <h1 class=""text-3xl font-bold tracking-tight"">Customer Reviews</h1>
    </div>

    <div class=""mx-auto w-[900px] max-w-full"">
        <div class=""grid gap-4 md:grid-cols-2"">
            @foreach (var review in _reviews)
            {
                <CardCn>
                    <CardContentCn Class=""p-4"">
                        @* Header *@
                        <div class=""mb-3 flex items-start gap-3"">
                            <AvatarCn Class=""h-10 w-10"">
                                @if (!string.IsNullOrEmpty(review.Avatar))
                                {
                                    <AvatarImageCn Src=""@review.Avatar"" />
                                }
                                <AvatarFallbackCn>
                                    @GetInitials(review.Author)
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class=""flex-1"">
                                <div class=""flex items-center gap-2"">
                                    <span class=""font-medium"">@review.Author</span>
                                    @if (review.Verified)
                                    {
                                        <BadgeCn Class=""text-xs"" Variant=""BadgeVariant.Secondary"">
                                            Verified
                                        </BadgeCn>
                                    }
                                </div>
                                <div class=""flex items-center gap-0.5"">
                                    @for (int star = 1; star <= 5; star++)
                                    {
                                        <LucideStarCn Size=""12"" Class=""@(star <= review.Rating ? ""fill-primary text-primary"" : ""fill-muted text-muted"")"" />
                                    }
                                    <span class=""ml-1.5 text-xs text-muted-foreground"">@review.Date</span>
                                </div>
                            </div>
                        </div>

                        @* Content *@
                        <h3 class=""mb-1 font-medium"">@review.Title</h3>
                        <p class=""mb-3 text-sm text-muted-foreground"">@review.Content</p>

                        @* Images *@
                        @if (review.Images is { Length: > 0 })
                        {
                            <div class=""mb-3 flex gap-2"">
                                @foreach (var image in review.Images)
                                {
                                    <div class=""h-16 w-16 overflow-hidden rounded-md border"">
                                        <img alt=""Review attachment"" class=""h-full w-full object-cover"" height=""64"" src=""@image"" width=""64"" />
                                    </div>
                                }
                            </div>
                        }

                        @* Footer *@
                        <ButtonCn Class=""h-8 text-xs"" Disabled=""@(_helpedReviews.Contains(review.Id))"" Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Ghost"" @onclick=""() => HandleHelpful(review.Id)"">
                            <LucideThumbsUpCn Size=""12"" Class=""mr-1"" />
                            Helpful (@(review.Helpful + (_helpedReviews.Contains(review.Id) ? 1 : 0)))
                        </ButtonCn>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        <div class=""mt-6 text-center"">
            <ButtonCn Variant=""ButtonVariant.Outline"">Load More Reviews</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReviewItem(int Id, string Author, int Rating, string Date, string Title, string Content, bool Verified, int Helpful, string? Avatar = null, string[]? Images = null);

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private readonly HashSet<int> _helpedReviews = [];

    private void HandleHelpful(int reviewId)
    {
        _helpedReviews.Add(reviewId);
    }

    private readonly ReviewItem[] _reviews =
    [
        new(1, ""Alexandra Chen"", 5, ""Dec 2, 2024"", ""Exceeded all expectations!"", ""The quality is outstanding. I've been using this daily for two weeks and it still looks brand new. The attention to detail is impressive and customer service was incredibly helpful when I had questions."", true, 47, Images: [""https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&w=200&q=80"", ""https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&w=200&q=80""]),
        new(2, ""Marcus Johnson"", 4, ""Nov 28, 2024"", ""Great product, minor issues"", ""Overall very satisfied with my purchase. Build quality is solid and it works as advertised. Took off one star because shipping was slower than expected, but the product itself is excellent."", true, 23),
        new(3, ""Sophie Williams"", 5, ""Nov 25, 2024"", ""Perfect gift!"", ""Bought this as a gift and the recipient absolutely loved it. Packaging was beautiful and the product quality matched the photos exactly. Will definitely order again."", true, 31, Images: [""https://images.unsplash.com/photo-1491553895911-0055uj6/652?auto=format&w=200&q=80""]),
        new(4, ""David Park"", 5, ""Nov 20, 2024"", ""Worth every penny"", ""I researched extensively before buying and this was the right choice. Premium feel, works flawlessly, and looks even better in person. Highly recommend."", false, 18),
    ];
}";
    private const string ReviewsCenteredSummaryCode = @"<section class=""container mx-auto px-4 py-6"">
    <div class=""mb-6 text-center"">
        <h1 class=""text-3xl font-bold tracking-tight"">Customer Reviews</h1>
        <p class=""mt-2 text-muted-foreground"">What our customers are saying</p>
    </div>

    <div class=""mx-auto w-[500px] max-w-full"">
        <CardCn>
            <CardContentCn Class=""p-6"">
                @* Overall Rating *@
                <div class=""mb-6 flex flex-col items-center text-center"">
                    <span class=""mb-2 text-5xl font-bold"">@_summary.OverallRating</span>
                    <div class=""flex items-center gap-0.5"">
                        @for (var star = 1; star <= 5; star++)
                        {
                            <LucideStarCn Class=""@Cn.Merge(""h-5 w-5"", star <= (int)Math.Round(_summary.OverallRating) ? ""fill-primary text-primary"" : ""fill-muted text-muted"")"" Size=""20"" />
                        }
                    </div>
                    <p class=""mt-2 text-sm text-muted-foreground"">
                        Based on @_summary.TotalReviews.ToString(""N0"") reviews
                    </p>
                </div>

                @* Verified Purchases *@
                <div class=""mb-6 rounded-lg border p-3 text-center"">
                    <p class=""text-sm"">
                        <span class=""font-medium"">@_verifiedPercentage%</span> of reviews from
                        <span class=""font-medium text-primary"">verified purchases</span>
                    </p>
                </div>

                @* Rating Breakdown *@
                <div class=""mb-6 space-y-2"">
                    @foreach (var stat in _summary.Stats)
                    {
                        <div class=""flex items-center gap-3"">
                            <span class=""w-16 text-right text-sm"">@stat.Stars stars</span>
                            <ProgressCn Class=""h-2 flex-1"" Value=""@stat.Percentage"" />
                            <span class=""w-10 text-left text-sm text-muted-foreground"">@stat.Count</span>
                        </div>
                    }
                </div>

                @* Keywords *@
                <div class=""mb-6 text-center"">
                    <p class=""mb-2 text-sm font-medium"">Top Keywords</p>
                    <div class=""flex flex-wrap justify-center gap-2"">
                        @foreach (var keyword in _summary.Keywords)
                        {
                            <BadgeCn Variant=""BadgeVariant.Secondary"">@keyword</BadgeCn>
                        }
                    </div>
                </div>

                @* CTA *@
                <ButtonCn Class=""w-full"">Write a Review</ButtonCn>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record ReviewStat(int Stars, int Count, int Percentage);
    private record SummaryData(double OverallRating, int TotalReviews, int VerifiedPurchases, ReviewStat[] Stats, string[] Keywords);

    private static readonly SummaryData _summary = new(
        4.7,
        827,
        756,
        [
            new(5, 629, 76),
            new(4, 116, 14),
            new(3, 50, 6),
            new(2, 24, 3),
            new(1, 8, 1),
        ],
        [""quality"", ""easy to use"", ""value"", ""fast shipping"", ""comfortable""]
    );

    private static readonly int _verifiedPercentage = (int)Math.Round((double)_summary.VerifiedPurchases / _summary.TotalReviews * 100);
}";
    private const string ReviewsComparisonCode = @"<section class=""container mx-auto px-4 py-6"">
    <div class=""mb-6 text-center"">
        <h1 class=""text-3xl font-bold tracking-tight"">Compare Reviews</h1>
        <p class=""mt-2 text-muted-foreground"">See how these products stack up</p>
    </div>

    <div class=""mx-auto w-[900px] max-w-full"">
        <div class=""grid gap-4 md:grid-cols-2"">
            @for (int i = 0; i < _products.Length; i++)
            {
                var product = _products[i];
                var index = i;
                <CardCn>
                    <CardContentCn Class=""p-6"">
                        @* Product Header *@
                        <div class=""mb-4 flex items-center gap-4"">
                            <img alt=""@product.Name"" class=""h-20 w-20 rounded-lg object-cover"" height=""80"" src=""@product.Image"" width=""80"" />
                            <div>
                                <h2 class=""font-semibold"">@product.Name</h2>
                                <div class=""mt-1 flex items-center gap-2"">
                                    <div class=""flex items-center gap-0.5"">
                                        @for (int star = 1; star <= 5; star++)
                                        {
                                            <LucideStarCn Size=""16"" Class=""@(star <= (int)Math.Round(product.Rating) ? ""fill-primary text-primary"" : ""fill-muted text-muted"")"" />
                                        }
                                    </div>
                                    <span class=""text-sm font-medium"">@product.Rating</span>
                                </div>
                                <p class=""text-sm text-muted-foreground"">
                                    @product.ReviewCount.ToString(""N0"") reviews
                                </p>
                            </div>
                        </div>

                        <SeparatorCn Class=""mb-4"" />

                        @* Metrics *@
                        <div class=""mb-4 space-y-3"">
                            <div class=""flex items-center justify-between"">
                                <span class=""text-sm text-muted-foreground"">Average Rating</span>
                                <div class=""flex items-center gap-2"">
                                    <span class=""font-semibold"">@product.Rating/5</span>
                                    @if (GetBetterValue(_products[0].Rating, _products[1].Rating, index))
                                    {
                                        <BadgeCn Class=""h-5 gap-1 px-1.5 text-xs"" Variant=""BadgeVariant.Secondary"">
                                            <LucideCheckCn Size=""12"" />
                                            Best
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                            <div class=""flex items-center justify-between"">
                                <span class=""text-sm text-muted-foreground"">Total Reviews</span>
                                <div class=""flex items-center gap-2"">
                                    <span class=""font-semibold"">@product.ReviewCount.ToString(""N0"")</span>
                                    @if (GetBetterValue(_products[0].ReviewCount, _products[1].ReviewCount, index))
                                    {
                                        <BadgeCn Class=""h-5 gap-1 px-1.5 text-xs"" Variant=""BadgeVariant.Secondary"">
                                            <LucideCheckCn Size=""12"" />
                                            Best
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                            <div class=""flex items-center justify-between"">
                                <span class=""text-sm text-muted-foreground"">Would Recommend</span>
                                <div class=""flex items-center gap-2"">
                                    <span class=""font-semibold"">@(product.RecommendPercent)%</span>
                                    @if (GetBetterValue(_products[0].RecommendPercent, _products[1].RecommendPercent, index))
                                    {
                                        <BadgeCn Class=""h-5 gap-1 px-1.5 text-xs"" Variant=""BadgeVariant.Secondary"">
                                            <LucideCheckCn Size=""12"" />
                                            Best
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                        </div>

                        <SeparatorCn Class=""mb-4"" />

                        @* Pros *@
                        <div class=""mb-4"">
                            <p class=""mb-2 text-sm font-medium"">Pros</p>
                            <ul class=""space-y-1"">
                                @foreach (var pro in product.Pros)
                                {
                                    <li class=""flex items-start gap-2 text-sm text-muted-foreground"">
                                        <LucideCheckCn Size=""12"" Class=""mt-0.5 shrink-0 text-primary"" />
                                        @pro
                                    </li>
                                }
                            </ul>
                        </div>

                        @* Cons *@
                        <div class=""mb-4"">
                            <p class=""mb-2 text-sm font-medium"">Cons</p>
                            <ul class=""space-y-1"">
                                @foreach (var con in product.Cons)
                                {
                                    <li class=""flex items-start gap-2 text-sm text-muted-foreground"">
                                        <LucideMinusCn Size=""12"" Class=""mt-0.5 shrink-0"" />
                                        @con
                                    </li>
                                }
                            </ul>
                        </div>

                        <ButtonCn Class=""w-full"">View All Reviews</ButtonCn>
                    </CardContentCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private record ProductReview(string Name, string Image, double Rating, int ReviewCount, int RecommendPercent, string[] Pros, string[] Cons);

    private static bool GetBetterValue(double val1, double val2, int index) =>
        index == 0 ? val1 >= val2 : val2 > val1;

    private readonly ProductReview[] _products =
    [
        new(""Pro Wireless Headphones"", ""https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&w=200&q=80"", 4.7, 2847, 94,
            [""Excellent sound quality"", ""30-hour battery life"", ""Comfortable for long use""],
            [""Premium price point"", ""No wired option""]),
        new(""Studio Wireless Elite"", ""https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&w=200&q=80"", 4.5, 1923, 89,
            [""Great noise cancellation"", ""Foldable design"", ""Multi-device pairing""],
            [""20-hour battery"", ""Heavier weight"", ""Touch controls finicky""]),
    ];
}";
    private const string ReviewsFilterPanelCode = @"<section class=""container mx-auto px-4 py-6"">
    <div class=""mb-6 text-center"">
        <h1 class=""text-3xl font-bold tracking-tight"">Filter Reviews</h1>
    </div>

    <div class=""mx-auto w-[700px] max-w-full"">
        <CardCn>
            <CardContentCn Class=""p-6"">
                @* Header *@
                <div class=""mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"">
