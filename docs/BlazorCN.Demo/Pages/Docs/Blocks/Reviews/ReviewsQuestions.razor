@* ========================================
   Block: reviews-questions
   Title: Reviews Questions
   Description: Product Q&A section with upvotes, seller badges, and community answers for ecommerce pages
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardHeaderCn, SeparatorCn, TextareaCn, LucideMessageSquareCn, LucideThumbsUpCn
   Source: original/blocks/reviews/reviews-questions.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Questions &amp; Answers</h1>
        <p class="mt-2 text-muted-foreground">
            @_questions.Count questions about this product
        </p>
    </div>

    <div class="mx-auto w-[650px] max-w-full space-y-4">
        @foreach (var question in _questions)
        {
            <CardCn>
                <CardHeaderCn Class="p-4">
                    <div class="flex gap-3">
                        @* Vote Button *@
                        <div class="flex flex-col items-center gap-1">
                            <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" aria-label="@($"Upvote question: {question.Text}")" @onclick="() => HandleVote(question.Id)">
                                <LucideThumbsUpCn Size="16" />
                            </ButtonCn>
                            <span class="text-sm font-medium tabular-nums">@question.Votes</span>
                        </div>

                        @* Question *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="space-y-1">
                                    <p class="font-medium">@question.Text</p>
                                    <p class="text-xs text-muted-foreground">
                                        Asked by @question.Author &#183; @question.Date
                                    </p>
                                </div>
                                <BadgeCn Class="shrink-0 gap-1" Variant="BadgeVariant.Secondary">
                                    <LucideMessageSquareCn Size="12" />
                                    @question.Answers.Count
                                </BadgeCn>
                            </div>
                        </div>
                    </div>
                </CardHeaderCn>

                <SeparatorCn />

                <CardContentCn Class="p-4">
                    @if (question.Answers.Count > 0)
                    {
                        <div class="space-y-4">
                            @foreach (var answer in question.Answers)
                            {
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@answer.Author</span>
                                        @if (answer.IsSeller)
                                        {
                                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                                Seller
                                            </BadgeCn>
                                        }
                                        <span class="text-xs text-muted-foreground">&#183; @answer.Date</span>
                                    </div>
                                    <p class="text-sm text-muted-foreground">@answer.Content</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-muted-foreground">
                            No answers yet. Be the first to answer!
                        </p>
                    }

                    @* Answer Form *@
                    @if (_showAnswerForm == question.Id)
                    {
                        <div class="mt-4 space-y-3">
                            <TextareaCn aria-label="Write your answer" Class="min-h-[80px] resize-none" Placeholder="Write your answer..." Value="@_answerText" ValueChanged='v => _answerText = v ?? ""' />
                            <div class="flex gap-2">
                                <ButtonCn Disabled="@(string.IsNullOrWhiteSpace(_answerText))" Size="ButtonSize.Sm" @onclick="() => HandleSubmitAnswer(question.Id)">
                                    Submit Answer
                                </ButtonCn>
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick='() => { _showAnswerForm = null; _answerText = ""; }'>
                                    Cancel
                                </ButtonCn>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ButtonCn Class="mt-4" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="() => _showAnswerForm = question.Id">
                            Answer this question
                        </ButtonCn>
                    }
                </CardContentCn>
            </CardCn>
        }
    </div>
</section>

@code {
    private class AnswerItem
    {
        public string Id { get; set; } = "";
        public string Author { get; set; } = "";
        public string Content { get; set; } = "";
        public string Date { get; set; } = "";
        public bool IsSeller { get; set; }
    }

    private class QuestionItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public string Author { get; set; } = "";
        public string Date { get; set; } = "";
        public int Votes { get; set; }
        public List<AnswerItem> Answers { get; set; } = [];
    }

    private string? _showAnswerForm;
    private string _answerText = "";

    private void HandleVote(string questionId)
    {
        var q = _questions.FirstOrDefault(x => x.Id == questionId);
        if (q != null) q.Votes++;
    }

    private void HandleSubmitAnswer(string questionId)
    {
        if (string.IsNullOrWhiteSpace(_answerText)) return;
        var q = _questions.FirstOrDefault(x => x.Id == questionId);
        if (q != null)
        {
            q.Answers.Add(new AnswerItem { Id = $"{questionId}-new", Author = "You", Content = _answerText, Date = "Just now", IsSeller = false });
        }
        _answerText = "";
        _showAnswerForm = null;
    }

    private readonly List<QuestionItem> _questions =
    [
        new() { Id = "1", Text = "Is this compatible with USB-C MacBooks?", Author = "TechBuyer92", Date = "Dec 2, 2024", Votes = 24, Answers = [
            new() { Id = "1a", Author = "Official Store", Content = "Yes, this product is fully compatible with all USB-C MacBooks from 2016 onwards. It supports USB-C Power Delivery up to 100W for charging while connected.", Date = "Dec 2, 2024", IsSeller = true },
            new() { Id = "1b", Author = "MacUser2023", Content = "Can confirm it works great with my M2 MacBook Air. No drivers needed, just plug and play.", Date = "Dec 3, 2024", IsSeller = false },
        ]},
        new() { Id = "2", Text = "What's the warranty period?", Author = "CarefulShopper", Date = "Nov 28, 2024", Votes = 12, Answers = [
            new() { Id = "2a", Author = "Official Store", Content = "This product comes with a 2-year manufacturer warranty. For warranty claims, please contact our support team with your order number.", Date = "Nov 28, 2024", IsSeller = true },
        ]},
        new() { Id = "3", Text = "Does it work with dual 4K monitors?", Author = "ProductivityPro", Date = "Nov 25, 2024", Votes = 8, Answers = [] },
    ];
}
