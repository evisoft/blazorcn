@* ============================================================
   Block: reviews-tagged-categories
   Title: ReviewsTaggedCategories
   Description: A sidebar-driven tagged category review browser for React and Next.js with a tag frequency sidebar, click-to-filter navigation, tag pills on reviews, and staggered animations built with shadcn/ui Avatar, Badge, and Separator components and Tailwind CSS.
   Source: original/blocks/reviews/reviews-tagged-categories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between px-5 py-3.5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="text-sm font-medium">Reviews by category</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_reviews.Length reviews across @_tagCategories.Length categories
                    </p>
                </div>
            </div>
            <div class="text-right">
                <span class="text-2xl font-semibold tabular-nums">
                    @((_reviews.Sum(r => r.Rating) / (double)_reviews.Length).ToString("F1"))
                </span>
                <p class="text-[10px] text-muted-foreground">avg rating</p>
            </div>
        </div>

        <SeparatorCn />

        @* Sidebar + Content *@
        <div class="grid grid-cols-1 md:grid-cols-[220px_1fr]">
            @* Left sidebar: tag list *@
            <div class="border-b md:border-b-0 md:border-r">
                <div class="p-3">
                    @* All reviews button *@
                    <button
                        type="button"
                        @onclick="@(() => _activeTag = null)"
                        class="@Cn.Merge("mb-1 flex w-full items-center justify-between rounded-md px-2.5 py-2 text-left text-xs transition-colors", _activeTag == null ? "bg-foreground font-medium text-background" : "text-muted-foreground hover:bg-muted/50")"
                    >
                        <span>All reviews</span>
                        <span class="@Cn.Merge("tabular-nums", _activeTag == null ? "text-background/70" : "text-muted-foreground/50")">
                            @_reviews.Length
                        </span>
                    </button>

                    <SeparatorCn Class="my-2" />

                    @* Category buttons with frequency bars *@
                    <div class="space-y-0.5">
                        @foreach (var cat in _tagCategories)
                        {
                            var category = cat;
                            var count = GetTagCount(category.Id);
                            var isActive = _activeTag == category.Id;
                            var barWidth = _maxTagCount > 0 ? (count / (double)_maxTagCount) * 100 : 0;

                            <button
                                type="button"
                                @onclick="@(() => _activeTag = (isActive ? null : category.Id))"
                                class="@Cn.Merge("group flex w-full flex-col gap-1 rounded-md px-2.5 py-2 text-left transition-colors", isActive ? "bg-muted" : "hover:bg-muted/50")"
                            >
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", category.AccentColor)" />
                                        <span class="@Cn.Merge("text-xs", isActive ? "font-medium" : "text-muted-foreground group-hover:text-foreground")">
                                            @category.Label
                                        </span>
                                    </div>
                                    <span class="text-[10px] tabular-nums text-muted-foreground">
                                        @count
                                    </span>
                                </div>
                                <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
                                    <div
                                        class="@Cn.Merge("h-full rounded-full transition-all duration-300", category.AccentColor + "/60")"
                                        style="@(FormattableString.Invariant($"width:{barWidth:F1}%"))"
                                    ></div>
                                </div>
                                <span class="text-[10px] text-muted-foreground/70">
                                    @category.Description
                                </span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Right content: filtered reviews *@
            <div>
                @* Active filter indicator *@
                <div class="flex items-center justify-between border-b px-4 py-2.5">
                    @{
                        var activeCategory = _tagCategories.FirstOrDefault(c => c.Id == _activeTag);
                        var filteredReviews = _activeTag != null
                            ? _reviews.Where(r => r.Tags.Contains(_activeTag)).ToArray()
                            : _reviews;
                    }
                    @if (activeCategory != null)
                    {
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", activeCategory.AccentColor)" />
                            <span class="text-xs font-medium">@activeCategory.Label</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                @filteredReviews.Length reviews
                            </BadgeCn>
                        </div>
                    }
                    else
                    {
                        <span class="text-xs text-muted-foreground">
                            Showing all @_reviews.Length reviews
                        </span>
                    }
                    <span class="text-[10px] text-muted-foreground">Sorted by most helpful</span>
                </div>

                @* Reviews list *@
                <div class="max-h-[480px] overflow-y-auto">
                    @{
                        var activeCategory2 = _tagCategories.FirstOrDefault(c => c.Id == _activeTag);
                        var displayReviews = _activeTag != null
                            ? _reviews.Where(r => r.Tags.Contains(_activeTag)).ToArray()
                            : _reviews;
                    }
                    @if (displayReviews.Length == 0)
                    {
                        <div class="flex flex-col items-center justify-center px-4 py-12">
                            <span class="text-sm text-muted-foreground">
                                No reviews in this category.
                            </span>
                        </div>
                    }
                    else
                    {
                        @for (var idx = 0; idx < displayReviews.Length; idx++)
                        {
                            var review = displayReviews[idx];
                            var isLast = idx == displayReviews.Length - 1;
                            var tagId = review.Id;

                            <div class="@(isLast ? "" : "border-b")">
                                <div class="px-4 py-3.5">
                                    @* Author row *@
                                    <div class="flex items-start gap-3">
                                        <AvatarCn Class="size-7">
                                            <AvatarFallbackCn Class="text-[10px]">@review.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium">@review.Author</span>
                                                @if (review.Verified)
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                                        Verified
                                                    </BadgeCn>
                                                }
                                                <span class="ml-auto text-xs text-muted-foreground">@review.Date</span>
                                            </div>
                                            <div class="mt-0.5 flex items-center gap-0.5">
                                                @for (var i = 0; i < 5; i++)
                                                {
                                                    var starIdx = i;
                                                    <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @* Content *@
                                    <div class="mt-2">
                                        <p class="text-sm font-medium">@review.Title</p>
                                        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@review.Body</p>
                                    </div>

                                    @* Tags + helpful *@
                                    <div class="mt-2.5 flex items-center justify-between">
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var tid in review.Tags)
                                            {
                                                var capturedTid = tid;
                                                var tagCat = _tagCategories.FirstOrDefault(c => c.Id == capturedTid);
                                                @if (tagCat != null)
                                                {
                                                    <div @onclick:stopPropagation @onclick="@(() => _activeTag = (_activeTag == capturedTid ? null : capturedTid))">
                                                        <button
                                                            type="button"
                                                            class="@Cn.Merge("inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] transition-colors", _activeTag == capturedTid ? "border-foreground/20 bg-foreground/5 font-medium" : "border-transparent bg-muted/50 text-muted-foreground hover:bg-muted")"
                                                        >
                                                            <span class="@Cn.Merge("size-1 rounded-full", tagCat.AccentColor)" />
                                                            @tagCat.Label
                                                        </button>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <span class="shrink-0 text-[10px] tabular-nums text-muted-foreground">
                                            @review.HelpfulCount helpful
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-5 py-2.5">
            <div class="flex items-center justify-between text-[10px] text-muted-foreground">
                <span>
                    @_reviews.Count(r => r.Verified) of @_reviews.Length are verified purchases
                </span>
                <span>
                    @(_activeTag != null
                        ? $"Filtered by {_tagCategories.FirstOrDefault(c => c.Id == _activeTag)?.Label}"
                        : "Select a category to filter")
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _activeTag = null;

    private record TagCategory(string Id, string Label, string Description, string AccentColor);
    private record Review(string Id, string Author, string Initials, int Rating, string Date, string Title, string Body, string[] Tags, int HelpfulCount, bool Verified);

    private static readonly TagCategory[] _tagCategories =
    [
        new("product-quality",   "Product Quality",   "Build, materials, finish",       "bg-emerald-500"),
        new("customer-service",  "Customer Service",  "Support, response time",         "bg-blue-500"),
        new("shipping-delivery", "Shipping & Delivery","Speed, packaging, tracking",    "bg-amber-500"),
        new("value-pricing",     "Value & Pricing",   "Cost, deals, ROI",               "bg-red-500"),
        new("ease-of-use",       "Ease of Use",       "Setup, UX, onboarding",          "bg-emerald-500"),
        new("performance",       "Performance",       "Speed, reliability, uptime",     "bg-blue-500"),
        new("design-aesthetics", "Design & Aesthetics","Look, feel, style",             "bg-amber-500"),
    ];

    private static readonly Review[] _reviews =
    [
        new("r1", "Alex Rivera",   "AR", 5, "Mar 28, 2026", "Outstanding build quality and materials",
            "Build quality is outstanding. The brushed aluminum finish feels premium and the tolerances are tight everywhere. This is a significant step up from the previous model. Setup was effortless.",
            ["product-quality", "ease-of-use", "design-aesthetics"], 34, true),
        new("r2", "Sam Patel",     "SP", 4, "Mar 25, 2026", "Support team resolved my issue fast",
            "Support team resolved my shipping issue within 2 hours. They proactively sent a replacement before I even asked. Would have been 5 stars if the initial tracking had been more transparent.",
            ["customer-service", "shipping-delivery"], 21, true),
        new("r3", "Jordan Lee",    "JL", 5, "Mar 22, 2026", "Best unboxing experience from an online purchase",
            "Arrived in 2 days with excellent packaging. Double-boxed with foam inserts protecting every corner. Best unboxing experience I have had from an online purchase. Performance is flawless.",
            ["shipping-delivery", "performance", "design-aesthetics"], 28, true),
        new("r4", "Taylor Kim",    "TK", 4, "Mar 20, 2026", "Flagship performance at a competitive price",
            "At this price point you are getting flagship-level performance. The feature set rivals products twice the cost. Only downside is the lack of included accessories. Great value overall.",
            ["value-pricing", "product-quality", "performance"], 42, true),
        new("r5", "Casey Morgan",  "CM", 3, "Mar 18, 2026", "Helpful but slow initial response time",
            "Customer service was helpful but slow to respond initially. Took 24 hours for the first reply. Once connected, the agent was knowledgeable and solved my configuration issue quickly. Setup guide could be clearer.",
            ["customer-service", "ease-of-use"], 15, false),
        new("r6", "Dana Okafor",   "DO", 5, "Mar 15, 2026", "Incredible value with three-year warranty",
            "Incredible value. I compared this against three competitors in the same price range and nothing comes close. The materials alone justify the cost, and the 3-year warranty adds peace of mind.",
            ["value-pricing", "product-quality"], 51, true),
        new("r7", "Mika Tanaka",   "MT", 5, "Mar 12, 2026", "Seamless setup and gorgeous design",
            "The design language is exactly what I wanted. Minimal, modern, and functional. Setup took under 3 minutes. Performance benchmarks match what was advertised. Very pleased with this purchase.",
            ["design-aesthetics", "ease-of-use", "performance"], 37, true),
        new("r8", "Leo Fernandez", "LF", 2, "Mar 8, 2026",  "Shipping delays and damaged packaging",
            "Shipping took 12 days instead of the promised 3-5. Package arrived with visible damage to the outer box. The product itself was fine but the experience left a bad impression. Support offered a small credit.",
            ["shipping-delivery", "customer-service"], 19, true),
    ];

    private int _maxTagCount => _tagCategories.Max(c => GetTagCount(c.Id));

    private int GetTagCount(string categoryId) =>
        _reviews.Count(r => r.Tags.Contains(categoryId));
}
