@* ========================================
   Block: reviews-reply-composer
   Title: Reviews Reply Composer
   Description: Review reply composer component with templates for seller dashboards and support tools
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, CardHeaderCn, CardTitleCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn, TextareaCn, LucideEyeCn, LucideSendCn, LucideStarCn
   Source: original/blocks/reviews/reviews-reply-composer.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Reply to Review</h1>
        <p class="mt-2 text-muted-foreground">Respond professionally to customer feedback</p>
    </div>

    <div class="mx-auto w-[600px] max-w-full space-y-4">
        @* Original Review *@
        <CardCn>
            <CardHeaderCn Class="pb-3">
                <CardTitleCn Class="text-sm font-medium text-muted-foreground">
                    Original Review
                </CardTitleCn>
            </CardHeaderCn>
            <CardContentCn Class="space-y-4">
                <div class="flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="h-10 w-10">
                            <AvatarImageCn Alt="@_reviewAuthor" Src="@_reviewAvatar" />
                            <AvatarFallbackCn>@GetInitials(_reviewAuthor)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="font-medium">@_reviewAuthor</p>
                            <p class="text-xs text-muted-foreground">@_reviewDate</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1">
                        @for (int star = 1; star <= 5; star++)
                        {
                            <LucideStarCn Size="16" Class="@(star <= _reviewRating ? "fill-primary text-primary" : "fill-muted text-muted-foreground")" />
                        }
                    </div>
                </div>
                <div>
                    <p class="font-medium">@_reviewTitle</p>
                    <p class="mt-1 text-sm text-muted-foreground">@_reviewContent</p>
                </div>
                <p class="text-xs text-muted-foreground">@_reviewProduct</p>
            </CardContentCn>
        </CardCn>

        @* Response Composer *@
        <CardCn>
            <CardHeaderCn Class="pb-3">
                <div class="flex items-center justify-between">
                    <CardTitleCn Class="text-sm font-medium">Your Response</CardTitleCn>
                    <SelectCn ValueChanged="HandleTemplateSelect">
                        @* role="combobox" takes no name from its contents, so the visible
                           "Insert template" placeholder does not name the field. *@
                        <SelectTriggerCn Class="h-8 w-[180px]" aria-label="Response template">
                            <SelectValueCn Placeholder="Insert template" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var template in _templates)
                            {
                                <SelectItemCn Value="@template.Id">@template.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </CardHeaderCn>
            <CardContentCn>
                @if (_isPreview)
                {
                    <div class="min-h-[120px] rounded-md border p-3">
                        <p class="text-sm whitespace-pre-wrap">
                            @(string.IsNullOrEmpty(_response) ? "No response written yet." : _response)
                        </p>
                    </div>
                }
                else
                {
                    <TextareaCn aria-label="Write your response to this review" Class="min-h-[120px] resize-none" Placeholder="Write your response to this review..." Value="@_response" ValueChanged='v => _response = (v ?? "").Length <= _maxLength ? v ?? "" : _response' />
                }
            </CardContentCn>
            <CardFooterCn Class="flex-col gap-3">
                <div class="flex w-full items-center justify-between">
                    <span class="@($"text-xs {(Remaining < 50 ? "text-destructive" : "text-muted-foreground")}")">
                        @Remaining characters remaining
                    </span>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _isPreview = !_isPreview">
                        <LucideEyeCn Size="14" Class="mr-1.5" />
                        @(_isPreview ? "Edit" : "Preview")
                    </ButtonCn>
                </div>
                <SeparatorCn />
                <div class="flex w-full gap-2">
                    <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                        Save Draft
                    </ButtonCn>
                    <ButtonCn Class="flex-1" Disabled="@(string.IsNullOrWhiteSpace(_response))">
                        <LucideSendCn Size="14" Class="mr-1.5" />
                        Publish Response
                    </ButtonCn>
                </div>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record TemplateItem(string Id, string Label, string Content);

    private string _response = "";
    private bool _isPreview;
    private const int _maxLength = 500;
    private int Remaining => _maxLength - _response.Length;

    private const string _reviewAuthor = "Jennifer Martinez";
    private const string _reviewAvatar = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80";
    private const int _reviewRating = 2;
    private const string _reviewTitle = "Disappointed with delivery time";
    private const string _reviewContent = "The product itself is fine, but it took 3 weeks to arrive when the listing said 5-7 days. No updates or tracking information was provided. I had to reach out twice to get any response. Would have appreciated better communication.";
    private const string _reviewDate = "December 3, 2024";
    private const string _reviewProduct = "Ceramic Plant Pot Set";

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private void HandleTemplateSelect(string? templateId)
    {
        var template = _templates.FirstOrDefault(t => t.Id == templateId);
        if (template != null)
        {
            _response = string.IsNullOrEmpty(_response) ? template.Content : $"{_response}\n\n{template.Content}";
        }
    }

    private readonly TemplateItem[] _templates =
    [
        new("apologize", "Apologize for delay", "We sincerely apologize for the delay in your delivery. This is not the experience we want for our customers. We're working to improve our shipping processes and communication."),
        new("thank", "Thank for feedback", "Thank you for taking the time to share your feedback. We truly appreciate hearing from our customers as it helps us improve our service."),
        new("resolve", "Offer resolution", "We'd like to make this right. Please reach out to our support team at support@@example.com and we'll be happy to discuss how we can resolve this for you."),
    ];
}
