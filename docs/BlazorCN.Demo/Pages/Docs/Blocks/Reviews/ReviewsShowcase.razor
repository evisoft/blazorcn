@* ========================================
   Block: reviews-showcase
   Title: Reviews Showcase
   Description: Review showcase carousel component for featuring testimonials on landing pages
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, CardCn, CardContentCn, LucideChevronLeftCn, LucideChevronRightCn, LucideQuoteCn, LucideStarCn
   Source: original/blocks/reviews/reviews-showcase.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Customer Reviews</h1>
        <p class="mt-2 text-muted-foreground">What our customers are saying</p>
    </div>

    <div class="mx-auto w-[600px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-8">
                @* Quote Icon *@
                <LucideQuoteCn Size="40" Class="text-muted-foreground/30" />

                @* Content *@
                <p class="mt-6 h-[84px] text-lg leading-relaxed line-clamp-3">@CurrentReview.Content</p>

                @* Rating *@
                <div class="mt-6 flex gap-0.5">
                    @for (int star = 1; star <= 5; star++)
                    {
                        <LucideStarCn Size="20" Class="@(star <= CurrentReview.Rating ? "fill-primary text-primary" : "fill-muted text-muted-foreground")" />
                    }
                </div>

                @* Author *@
                <div class="mt-6 flex items-center gap-4">
                    <AvatarCn Class="h-12 w-12">
                        <AvatarImageCn Alt="@CurrentReview.AuthorName" Src="@CurrentReview.AuthorAvatar" />
                        <AvatarFallbackCn>@GetInitials(CurrentReview.AuthorName)</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <p class="font-medium">@CurrentReview.AuthorName</p>
                        <p class="text-sm text-muted-foreground">@CurrentReview.AuthorTitle</p>
                    </div>
                </div>
            </CardContentCn>
        </CardCn>

        @* Navigation *@
        <div class="mt-6 flex items-center justify-center gap-4">
            <ButtonCn aria-label="Previous review" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="GoToPrev">
                <LucideChevronLeftCn Size="16" />
            </ButtonCn>

            @* Dots *@
            <div class="flex gap-2">
                @for (int i = 0; i < _reviews.Length; i++)
                {
                    var index = i;
                    <button type="button" aria-label="@($"Go to review {index + 1}")" class="@Cn.Merge("h-2 w-2 rounded-full border transition-colors", index == _currentIndex ? "bg-primary border-primary" : "bg-background border-border")" @onclick="() => _currentIndex = index"></button>
                }
            </div>

            <ButtonCn aria-label="Next review" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="GoToNext">
                <LucideChevronRightCn Size="16" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedReview(int Id, string AuthorName, string AuthorTitle, string AuthorAvatar, int Rating, string Content, string Product);

    private int _currentIndex;
    private FeaturedReview CurrentReview => _reviews[_currentIndex];

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private void GoToNext() => _currentIndex = (_currentIndex + 1) % _reviews.Length;
    private void GoToPrev() => _currentIndex = (_currentIndex - 1 + _reviews.Length) % _reviews.Length;

    private readonly FeaturedReview[] _reviews =
    [
        new(1, "Alexandra Chen", "Interior Designer", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80", 5, "This product has completely transformed my workflow. The attention to detail and build quality is exceptional. I've recommended it to all my colleagues and they're equally impressed.", "Professional Tool Kit"),
        new(2, "Marcus Johnson", "Software Engineer", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80", 5, "After trying countless alternatives, I finally found something that meets my standards. The performance is outstanding and customer support has been incredibly responsive.", "Ergonomic Keyboard"),
        new(3, "Sophie Williams", "Product Manager", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&w=100&q=80", 5, "I was skeptical at first, but this exceeded every expectation. The quality is remarkable and it arrived faster than expected. Definitely worth every penny.", "Wireless Charger Pro"),
    ];
}
