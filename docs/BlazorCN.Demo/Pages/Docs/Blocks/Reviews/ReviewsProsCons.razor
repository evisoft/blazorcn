@* ============================================================
   Block: reviews-pros-cons
   Title: ReviewsProsCons
   Description: A React split pros and cons review summary for Next.js with two-column layout, vote counts per item, aggregated themes, and contributor avatars using shadcn/ui Avatar, Badge, Button and Tailwind CSS
   Source: original/blocks/reviews/reviews-pros-cons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with summary *@
        <div class="flex flex-col gap-3 border-b px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <span class="text-sm font-medium">Community Pros &amp; Cons</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Aggregated from @_summary.TotalReviews.ToString("N0") verified reviews
                </p>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                    <span class="text-sm font-medium tabular-nums">@_summary.AvgRating</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-xs text-muted-foreground">
                        @_summary.RecommendPercent% recommend
                    </span>
                </div>
            </div>
        </div>

        @* Two-column split *@
        <div class="grid grid-cols-1 sm:grid-cols-2 sm:divide-x">
            @* Pros column *@
            <div class="px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="plus" Size="12" Class="size-3 text-emerald-600" />
                    </span>
                    <span class="text-xs font-medium text-emerald-600">Pros</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                        @_prosItems.Length themes
                    </BadgeCn>
                </div>
                <div class="mt-2 divide-y">
                    @foreach (var item in _visiblePros)
                    {
                        var proItem = item;
                        <div class="flex items-start gap-3 py-2.5">
                            <div class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm leading-relaxed">@proItem.Text</p>
                                <div class="mt-1 flex items-center gap-2">
                                    <span class="text-[10px] text-muted-foreground">
                                        Mentioned by @proItem.MentionCount reviewers
                                    </span>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                Class="@Cn.Merge("h-7 shrink-0 gap-1 px-2 text-xs tabular-nums", _upvoted.Contains(proItem.Id) ? "text-foreground" : "text-muted-foreground")"
                                @onclick="@(() => HandleUpvote(proItem.Id))">
                                <LucideIconCn Name="chevron-up" Size="12" Class="@Cn.Merge("size-3", _upvoted.Contains(proItem.Id) ? "text-foreground" : "")" />
                                @(proItem.Votes + (_upvoted.Contains(proItem.Id) ? 1 : 0))
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>

            @* Cons column *@
            <div class="border-t px-4 py-3 sm:border-t-0">
                <div class="flex items-center gap-2">
                    <span class="flex size-5 items-center justify-center rounded-full bg-red-500/10">
                        <LucideIconCn Name="minus" Size="12" Class="size-3 text-red-600" />
                    </span>
                    <span class="text-xs font-medium text-red-600">Cons</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                        @_consItems.Length themes
                    </BadgeCn>
                </div>
                <div class="mt-2 divide-y">
                    @foreach (var item in _visibleCons)
                    {
                        var conItem = item;
                        <div class="flex items-start gap-3 py-2.5">
                            <div class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-red-500/10 text-red-600">
                                <LucideIconCn Name="minus" Size="12" Class="size-3" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm leading-relaxed">@conItem.Text</p>
                                <div class="mt-1 flex items-center gap-2">
                                    <span class="text-[10px] text-muted-foreground">
                                        Mentioned by @conItem.MentionCount reviewers
                                    </span>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                Class="@Cn.Merge("h-7 shrink-0 gap-1 px-2 text-xs tabular-nums", _upvoted.Contains(conItem.Id) ? "text-foreground" : "text-muted-foreground")"
                                @onclick="@(() => HandleUpvote(conItem.Id))">
                                <LucideIconCn Name="chevron-up" Size="12" Class="@Cn.Merge("size-3", _upvoted.Contains(conItem.Id) ? "text-foreground" : "")" />
                                @(conItem.Votes + (_upvoted.Contains(conItem.Id) ? 1 : 0))
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Show more / Sentiment footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-3">
                @* Sentiment bar *@
                <div class="flex items-center gap-2">
                    <span class="text-[10px] text-muted-foreground">Overall Sentiment</span>
                    <div class="flex h-1.5 w-24 overflow-hidden rounded-full">
                        <div class="bg-emerald-500" style="@($"width:{_summary.RecommendPercent}%")"></div>
                        <div class="flex-1 bg-red-400"></div>
                    </div>
                    <span class="text-[10px] tabular-nums text-muted-foreground">
                        @_summary.RecommendPercent% positive
                    </span>
                </div>
            </div>
            @if (!_showAll && _hiddenCount > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                    Class="h-7 text-xs text-muted-foreground"
                    @onclick="@(() => _showAll = true)">
                    Show @_hiddenCount more
                </ButtonCn>
            }
            @if (_showAll)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                    Class="h-7 text-xs text-muted-foreground"
                    @onclick="@(() => _showAll = false)">
                    Show less
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record ProsConsItem(string Id, string Text, int Votes, int MentionCount);
    private record ReviewSummary(int TotalReviews, double AvgRating, int RecommendPercent);

    private static readonly ReviewSummary _summary = new(892, 4.4, 87);

    private static readonly ProsConsItem[] _prosItems =
    [
        new("p1", "TypeScript support is first-class with excellent type inference and autocompletion", 234, 312),
        new("p2", "Documentation is thorough with real-world examples and migration guides", 198, 267),
        new("p3", "Bundle size is impressively small compared to alternatives", 156, 198),
        new("p4", "Active community with fast response times on GitHub issues", 143, 187),
        new("p5", "Accessibility built in from the ground up, not bolted on", 127, 156),
    ];

    private static readonly ProsConsItem[] _consItems =
    [
        new("c1", "Initial setup requires significant configuration and boilerplate", 89, 134),
        new("c2", "Complex form validation has edge cases with async rules", 67, 98),
        new("c3", "Some newer components feel less polished than the core set", 54, 76),
        new("c4", "Animation library integration could be smoother with SSR", 41, 63),
    ];

    private HashSet<string> _upvoted = [];
    private bool _showAll;

    private ProsConsItem[] _visiblePros => _showAll ? _prosItems : _prosItems[..3];
    private ProsConsItem[] _visibleCons => _showAll ? _consItems : _consItems[..3];
    private int _hiddenCount => (_prosItems.Length - 3) + (_consItems.Length - 3);

    private void HandleUpvote(string id)
    {
        if (_upvoted.Contains(id))
            _upvoted.Remove(id);
        else
            _upvoted.Add(id);
    }
}
