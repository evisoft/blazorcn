@* ============================================================
   Block: reviews-product-card-rating
   Title: ReviewsProductCardRating
   Description: A React ecommerce product card with embedded star rating summary, review count, most helpful review quote, and price display for Next.js built with shadcn/ui Badge, Tooltip components and Tailwind CSS
   Source: original/blocks/reviews/reviews-product-card-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Top: Image + Product Info side by side *@
        <div class="flex flex-col sm:flex-row">
            @* Image placeholder *@
            <div class="flex h-48 items-center justify-center border-b bg-muted/30 sm:h-auto sm:w-56 sm:border-b-0 sm:border-r">
                <LucideIconCn Name="image" Size="40" Class="size-10 text-muted-foreground/20" />
            </div>

            @* Product details *@
            <div class="flex flex-1 flex-col p-4">
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">@_product.Category</span>
                    @foreach (var tag in _product.Tags)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@tag</BadgeCn>
                    }
                </div>

                <span class="mt-1.5 text-sm font-medium leading-tight">@_product.Name</span>

                @* Price *@
                <div class="mt-2 flex items-baseline gap-2">
                    <span class="text-xl font-semibold tabular-nums">@_product.Price</span>
                    @if (_product.OriginalPrice != null)
                    {
                        <span class="text-sm tabular-nums text-muted-foreground line-through">@_product.OriginalPrice</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal text-emerald-600">@_discountPercent% off</BadgeCn>
                    }
                </div>

                @* Rating summary row *@
                <div class="mt-3 flex items-center gap-2">
                    @RenderStars(_product.Rating, "sm")
                    <span class="text-sm font-medium tabular-nums">@_product.Rating</span>
                    <span class="text-xs text-muted-foreground">(@(_product.ReviewCount.ToString("N0")) reviews)</span>
                </div>

                @* Stock + CTA *@
                <div class="mt-3 flex items-center gap-3">
                    @if (_product.InStock)
                    {
                        <span class="flex items-center gap-1 text-xs text-emerald-600">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            In Stock
                        </span>
                    }
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="shopping-cart" Size="12" Class="size-3" />
                        Add to Cart
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Rating Distribution *@
        <div class="border-t px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Rating Breakdown</span>
            <div class="mt-2 space-y-1">
                @foreach (var dist in _product.RatingDistribution)
                {
                    <div class="flex items-center gap-2">
                        <span class="w-7 text-right text-xs tabular-nums text-muted-foreground">
                            @dist.Stars<LucideIconCn Name="star" Size="10" Class="mb-0.5 ml-0.5 inline size-2.5 fill-amber-500 text-amber-500" />
                        </span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-amber-500" style="@($"width:{dist.Percentage}%")"></div>
                        </div>
                        <TooltipProviderCn>
                            <TooltipCn>
                                <TooltipTriggerCn>
                                    <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">@(dist.Percentage)%</span>
                                </TooltipTriggerCn>
                                <TooltipContentCn Align="FloatingAlign.End">
                                    <span class="text-xs">@(dist.Count.ToString("N0")) reviews</span>
                                </TooltipContentCn>
                            </TooltipCn>
                        </TooltipProviderCn>
                    </div>
                }
            </div>
        </div>

        @* Most Helpful Review *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="quote" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Most Helpful Review</span>
            </div>
            <div class="mt-2 rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium">@_product.HelpfulReview.Author</span>
                    @if (_product.HelpfulReview.Verified)
                    {
                        <span class="flex items-center gap-0.5 text-[10px] text-emerald-600">
                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                            Verified
                        </span>
                    }
                    @RenderStars(_product.HelpfulReview.Rating, "xs")
                </div>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                    @_product.HelpfulReview.Quote
                </p>
                <div class="mt-2 flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="@Cn.Merge("h-6 gap-1 px-2 text-xs", _isHelpful ? "text-foreground" : "text-muted-foreground")" OnClick="@(() => _isHelpful = !_isHelpful)">
                        <LucideIconCn Name="thumbs-up" Size="12" Class="@Cn.Merge("size-3", _isHelpful ? "fill-current" : "")" />
                        Helpful (@(_product.HelpfulReview.HelpfulCount + (_isHelpful ? 1 : 0)))
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _isHelpful = false;

    private record RatingDistribution(int Stars, int Count, int Percentage);

    private record HelpfulReview(string Author, string Quote, int Rating, int HelpfulCount, bool Verified);

    private record Product(
        string Id,
        string Name,
        string Category,
        string Price,
        string? OriginalPrice,
        double Rating,
        int ReviewCount,
        string[] Tags,
        RatingDistribution[] RatingDistribution,
        HelpfulReview HelpfulReview,
        bool InStock
    );

    private static readonly Product _product = new(
        Id: "prod-ergo-chair-x1",
        Name: "ErgoFlow Pro Mesh Chair",
        Category: "Office Seating",
        Price: "$489",
        OriginalPrice: "$649",
        Rating: 4.7,
        ReviewCount: 1243,
        Tags: ["Best Seller", "Editor's Choice"],
        RatingDistribution:
        [
            new(5, 812, 65),
            new(4, 274, 22),
            new(3, 94, 8),
            new(2, 38, 3),
            new(1, 25, 2),
        ],
        HelpfulReview: new(
            Author: "Priya Sharma",
            Quote: "After two years of daily 10-hour sessions, the lumbar support is still as firm as day one. The mesh breathes well in summer and the armrests adjust in four directions. Best investment for my home office.",
            Rating: 5,
            HelpfulCount: 147,
            Verified: true
        ),
        InStock: true
    );

    private int _discountPercent =>
        _product.OriginalPrice != null
            ? (int)Math.Round(
                (double)(int.Parse(_product.OriginalPrice.Replace("$", "")) - int.Parse(_product.Price.Replace("$", "")))
                / int.Parse(_product.OriginalPrice.Replace("$", "")) * 100)
            : 0;

    private RenderFragment RenderStars(double rating, string size) => __builder =>
    {
        var sizeClass = size == "sm" ? "size-3.5" : "size-3";
        var iconSize = size == "sm" ? 14 : 12;
        <div class="flex items-center gap-0.5">
            @for (int i = 0; i < 5; i++)
            {
                var starIndex = i;
                <LucideIconCn Name="star" Size="@iconSize" Class="@Cn.Merge(sizeClass, starIndex < (int)Math.Round(rating) ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
            }
        </div>
    };
}
