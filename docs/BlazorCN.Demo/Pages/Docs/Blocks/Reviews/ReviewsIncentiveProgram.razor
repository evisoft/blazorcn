@* ============================================================
   Block: reviews-incentive-program
   Title: ReviewsIncentiveProgram
   Description: A bento-grid gamified review rewards dashboard for React and Next.js with point tracking, tier progress, streak multipliers, milestone badges, and redeemable rewards. Built with shadcn/ui Badge, Button, Progress, and Tailwind CSS.
   Source: original/blocks/reviews/reviews-incentive-program.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Review Rewards Program</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Earn points for every review, unlock exclusive rewards
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-xs font-normal">
                <LucideIconCn Name="trophy" Size="12" Class="size-3" />
                @_currentTier.Name
            </BadgeCn>
        </div>

        @* Bento grid *@
        <div class="grid gap-px bg-muted/50 sm:grid-cols-3">
            @* Points balance - spans 2 cols *@
            <div class="col-span-1 bg-card p-4 sm:col-span-2">
                <div class="flex items-start justify-between">
                    <div>
                        <span class="text-xs font-medium text-muted-foreground">Available points</span>
                        <div class="mt-1 flex items-baseline gap-1.5">
                            <span class="text-2xl font-semibold tabular-nums">@_pointsBalance.ToString("N0")</span>
                            <span class="text-xs text-muted-foreground">pts</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground tabular-nums">
                            @_totalEarned.ToString("N0") total earned from @_reviewsWritten reviews
                        </p>
                    </div>
                    <div class="rounded-md bg-muted/50 px-2.5 py-1.5">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                            <span class="text-xs font-medium tabular-nums">@_streakMultiplier.ToString("0.#")x</span>
                        </div>
                        <p class="mt-0.5 text-[10px] text-muted-foreground">
                            @_streakWeeks-week streak
                        </p>
                    </div>
                </div>

                @* Tier progress *@
                @if (_nextTier != null)
                {
                    <div class="mt-4">
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-medium">@_currentTier.Name</span>
                            <span class="text-muted-foreground">@_nextTier.Name</span>
                        </div>
                        <ProgressCn Value="@_progressToNext" Class="mt-1.5 h-1.5" />
                        <p class="mt-1 text-[10px] text-muted-foreground tabular-nums">
                            @_pointsToNext.ToString("N0") pts to @_nextTier.Name
                        </p>
                    </div>
                }
            </div>

            @* Earn points card *@
            <div class="col-span-1 bg-card p-4">
                <span class="text-xs font-medium text-muted-foreground">Earn points</span>
                <div class="mt-2 space-y-2">
                    @foreach (var action in _pointActions)
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-muted-foreground/60">
                                <LucideIconCn Name="@action.Icon" Size="14" Class="size-3.5" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="text-xs font-medium">@action.Label</span>
                            </div>
                            <span class="shrink-0 text-[10px] font-medium tabular-nums text-muted-foreground">
                                +@action.Points
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* Milestones - spans 2 cols *@
            <div class="col-span-1 bg-card p-4 sm:col-span-2">
                <span class="text-xs font-medium text-muted-foreground">Milestones</span>
                <div class="mt-2 flex flex-wrap gap-2">
                    @foreach (var milestone in _milestones)
                    {
                        <div class="@($"flex items-center gap-2 rounded-md border px-3 py-2 {(milestone.Achieved ? "border-emerald-500/20 bg-emerald-500/5" : "border-dashed")}")">
                            @if (milestone.Achieved)
                            {
                                <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                </span>
                            }
                            else
                            {
                                <span class="flex size-5 items-center justify-center rounded-full border border-muted-foreground/30">
                                    <span class="text-[10px] text-muted-foreground tabular-nums">@milestone.Points</span>
                                </span>
                            }
                            <div>
                                <span class="text-xs font-medium">@milestone.Label</span>
                                <p class="text-[10px] text-muted-foreground">@milestone.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Tier perks *@
            <div class="col-span-1 bg-card p-4">
                <span class="text-xs font-medium text-muted-foreground">
                    Your @_currentTier.Name perks
                </span>
                <ul class="mt-2 space-y-1.5">
                    @foreach (var perk in _currentTier.Perks)
                    {
                        <li class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1 rounded-full bg-emerald-500"></span>
                            @perk
                        </li>
                    }
                    @if (_nextTier != null)
                    {
                        <li class="pt-1 text-[10px] font-medium text-muted-foreground">
                            Unlock at @_nextTier.Name:
                        </li>
                        @foreach (var perk in _nextTier.Perks)
                        {
                            <li class="flex items-center gap-1.5 text-xs text-muted-foreground/50">
                                <span class="size-1 rounded-full bg-muted-foreground/30"></span>
                                @perk
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        @* Rewards section *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Redeem rewards</span>
                <span class="text-[10px] text-muted-foreground tabular-nums">
                    @_pointsBalance.ToString("N0") pts available
                </span>
            </div>
            <div class="mt-2.5 grid gap-2 sm:grid-cols-2">
                @foreach (var reward in _rewards)
                {
                    var canAfford = _pointsBalance >= reward.Cost;
                    var isRedeemed = _redeemedIds.Contains(reward.Id);
                    var rwItem = reward;
                    <div class="flex items-center gap-3 rounded-md border p-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-xs font-medium">@reward.Name</span>
                            <p class="text-[10px] text-muted-foreground">@reward.Description</p>
                        </div>
                        <ButtonCn Variant="@(isRedeemed ? ButtonVariant.Ghost : ButtonVariant.Outline)"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 shrink-0 text-xs"
                                  Disabled="@(!canAfford || isRedeemed)"
                                  OnClick="@(() => HandleRedeem(rwItem.Id))">
                            @if (isRedeemed)
                            {
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    Redeemed
                                </span>
                            }
                            else
                            {
                                <span class="tabular-nums">@reward.Cost pts</span>
                            }
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private const int _pointsBalance = 1340;
    private const int _totalEarned = 2540;
    private const int _reviewsWritten = 34;
    private const int _streakWeeks = 6;
    private const double _streakMultiplier = 1.5;

    private readonly HashSet<string> _redeemedIds = new();

    private record PointAction(string Label, int Points, string Icon, string Description);
    private record RewardTier(string Name, int Threshold, bool Unlocked, string[] Perks);
    private record Milestone(string Id, string Label, string Description, bool Achieved, int Points);
    private record Reward(string Id, string Name, int Cost, string Description, string Category);

    private static readonly PointAction[] _pointActions =
    [
        new("Write a text review", 50, "star", "Share your detailed experience"),
        new("Add photos", 25, "sparkles", "Include images with your review"),
        new("Submit video review", 100, "zap", "Record and upload a video review"),
        new("Review within 48 hours", 30, "flame", "Bonus for prompt feedback"),
    ];

    private static readonly RewardTier[] _tiers =
    [
        new("Bronze",   0,    true,  ["Profile badge", "Basic rewards"]),
        new("Silver",   500,  true,  ["Priority support", "Monthly coupons"]),
        new("Gold",     1500, true,  ["Early access", "Exclusive discounts"]),
        new("Platinum", 5000, false, ["VIP events", "Free shipping always"]),
    ];

    private static readonly Milestone[] _milestones =
    [
        new("m1", "First Review",   "Write your first review",    true,  75),
        new("m2", "Photo Pro",      "Add photos to 10 reviews",   true,  150),
        new("m3", "Trusted Voice",  "Get 50 helpful votes",       true,  200),
        new("m4", "Video Star",     "Submit 5 video reviews",     false, 300),
        new("m5", "Century Club",   "Write 100 reviews",          false, 500),
    ];

    private static readonly Reward[] _rewards =
    [
        new("rw1", "15% discount code",    300,  "Valid for 30 days on any order",       "Discount"),
        new("rw2", "Free express shipping", 200,  "One-time use, any order size",         "Shipping"),
        new("rw3", "Early access pass",    750,  "Preview new products 7 days early",    "Access"),
        new("rw4", "Gift card $25",        1200, "Store credit, never expires",           "Credit"),
    ];

    private RewardTier _currentTier => GetCurrentTier();
    private RewardTier? _nextTier => GetNextTier();

    private double _progressToNext => _nextTier != null
        ? Math.Min(((double)(_totalEarned - _currentTier.Threshold) / (_nextTier.Threshold - _currentTier.Threshold)) * 100.0, 100.0)
        : 100.0;

    private int _pointsToNext => _nextTier != null ? _nextTier.Threshold - _totalEarned : 0;

    private static RewardTier GetCurrentTier()
    {
        var unlocked = System.Linq.Enumerable.Where(_tiers, t => t.Unlocked).ToArray();
        return unlocked[unlocked.Length - 1];
    }

    private static RewardTier? GetNextTier()
    {
        foreach (var t in _tiers)
        {
            if (!t.Unlocked) return t;
        }
        return null;
    }

    private void HandleRedeem(string id)
    {
        _redeemedIds.Add(id);
    }
}
