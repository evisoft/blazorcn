@* ============================================================
   Block: reviews-featured-carousel
   Title: ReviewsFeaturedCarousel
   Description: A featured reviews carousel block for React and Next.js with AnimatePresence slide transitions, dot indicators, prev/next navigation, star ratings, and verified badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-featured-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with navigation *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Featured Reviews</span>
                <span class="text-xs text-muted-foreground">
                    @(_current + 1) of @_reviews.Length
                </span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Previous review" @onclick="@(() => Paginate(-1))">
                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Next review" @onclick="@(() => Paginate(1))">
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Review content *@
        <div class="relative min-h-[240px]">
            <div class="px-5 py-5">
                @{
                    var review = _reviews[_current];
                }
                @* Quote icon and rating *@
                <div class="mb-3 flex items-center justify-between">
                    <LucideIconCn Name="quote" Size="20" Class="size-5 text-muted-foreground/30" />
                    <div role="img" class="flex items-center gap-0.5" aria-label="@($"{review.Rating} out of 5 stars")">
                        @for (int i = 0; i < 5; i++)
                        {
                            var idx = i;
                            <LucideIconCn Name="star" Size="14" Class="@(idx < review.Rating ? "size-3.5 fill-amber-500 text-amber-500" : "size-3.5 text-muted-foreground/30")" />
                        }
                    </div>
                </div>

                @* Review text *@
                <p class="text-sm leading-relaxed">@review.Text</p>

                @* Tags *@
                <div class="mt-3 flex flex-wrap gap-1.5">
                    @foreach (var tag in review.Tags)
                    {
                        <span class="rounded-full bg-muted/60 px-2.5 py-0.5 text-[10px] text-muted-foreground">
                            @tag.Label
                        </span>
                    }
                    @if (review.Verified)
                    {
                        <span class="flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] text-emerald-600 dark:text-emerald-400">
                            <LucideIconCn Name="shield-check" Size="10" Class="size-2.5" />
                            Verified
                        </span>
                    }
                </div>

                @* Helpful count *@
                <p class="mt-3 text-xs text-muted-foreground">
                    @review.HelpfulCount people found this helpful
                </p>
            </div>
        </div>

        @* Author info + dot indicators *@
        <div class="flex items-center gap-3 border-t px-4 py-3">
            @{
                var cur = _reviews[_current];
            }
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-xs">@cur.Initials</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="text-sm font-medium">@cur.Author</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                        @cur.Date
                    </BadgeCn>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="building" Size="12" Class="size-3" />
                    <span>@cur.Role at @cur.Company</span>
                </div>
            </div>
            <div class="flex items-center gap-0.5">
                @for (int i = 0; i < _reviews.Length; i++)
                {
                    var idx = i;
                    <button
                        type="button"
                        @onclick="@(() => GoToSlide(idx))"
                        aria-label="@($"Go to slide {idx + 1}")"
                        class="inline-flex size-6 items-center justify-center">
                        <span class="@(idx == _current ? "size-1.5 rounded-full transition-all duration-200 scale-125 bg-foreground" : "size-1.5 rounded-full transition-all duration-200 bg-foreground/20 hover:bg-foreground/40")"></span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewTag(string Label, string Sentiment);

    private record FeaturedReview(
        string Id,
        string Author,
        string Initials,
        string Role,
        string Company,
        int Rating,
        string Text,
        string Date,
        bool Verified,
        int HelpfulCount,
        ReviewTag[] Tags
    );

    private int _current = 0;

    private void Paginate(int direction)
    {
        _current = (_current + direction + _reviews.Length) % _reviews.Length;
    }

    private void GoToSlide(int index)
    {
        _current = index;
    }

