@* ============================================================
   Block: reviews-expert-editorial
   Title: ReviewsExpertEditorial
   Description: A magazine-style expert editorial review layout for React and Next.js with sidebar section navigation, pull quotes, category scoring with progress bars, and pros-cons analysis built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-expert-editorial.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">Editorial Review</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                            Editor's Pick
                        </BadgeCn>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_review.Product — @_review.Subtitle
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="@($"text-2xl font-semibold tabular-nums {ScoreColor(_review.OverallScore)}")">
                        @_review.OverallScore
                    </span>
                    <span class="text-xs text-muted-foreground">/10</span>
                </div>
            </div>
        </div>

        @* Sidebar + Content *@
        <div class="grid grid-cols-4">
            @* Sidebar navigation *@
            <nav class="col-span-1 border-r">
                <div class="py-2">
                    @foreach (var sec in _sections)
                    {
                        var isActive = _activeSection == sec.Id;
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-center gap-2 px-4 py-2 text-left text-xs transition-colors", isActive ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/30 hover:text-foreground")"
                                @onclick="@(() => _activeSection = sec.Id)">
                            @if (isActive)
                            {
                                <span class="size-1 rounded-full bg-foreground"></span>
                            }
                            @sec.Label
                        </button>
                    }
                </div>

                @* Author info *@
                <div class="border-t px-4 py-3">
                    <p class="text-[10px] font-medium text-muted-foreground">Reviewed by</p>
                    <p class="mt-1 text-xs font-medium">@_review.Author</p>
                    <p class="text-[10px] text-muted-foreground">@_review.AuthorRole</p>
                    <p class="mt-1.5 text-[10px] text-muted-foreground">@_review.PublishedDate</p>
                </div>
            </nav>

            @* Content area *@
            <div class="col-span-3">
                @* Overview section *@
                @if (_activeSection == "overview")
                {
                    <div class="px-5 py-4">
                        @* Overall score display *@
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-0.5">
                                @for (var i = 0; i < 5; i++)
                                {
                                    var idx = i;
                                    var filled = idx < (int)Math.Round(_review.OverallScore / 2);
                                    <LucideIconCn Name="star" Size="16" Class="@Cn.Merge("size-4", filled ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">
                                Overall score based on 5 categories
                            </span>
                        </div>

                        @* Pull quote *@
                        <div class="mt-5 rounded-md bg-muted/30 px-4 py-3">
                            <div class="flex gap-2.5">
                                <LucideIconCn Name="quote" Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                                <p class="text-sm italic leading-relaxed text-foreground/80">
                                    @_review.PullQuote
                                </p>
                            </div>
                        </div>

                        @* Quick score bars *@
                        <div class="mt-5 space-y-2.5">
                            @foreach (var cat in _review.Categories)
                            {
                                var barWidth = $"{(cat.Score / cat.MaxScore) * 100:F0}%";
                                <div class="flex items-center gap-3">
                                    <span class="w-24 text-xs text-muted-foreground">@cat.Name</span>
                                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                        <div class="@($"h-full rounded-full {ScoreBarColor(cat.Score)}")" style="@($"width:{barWidth}")"></div>
                                    </div>
                                    <span class="@($"w-8 text-right text-xs font-medium tabular-nums {ScoreColor(cat.Score)}")">
                                        @cat.Score
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* Scores section *@
                @if (_activeSection == "scores")
                {
                    <div class="divide-y">
                        @foreach (var cat in _review.Categories)
                        {
                            var catName = cat.Name;
                            var isExpanded = _expandedCategory == catName;
                            <div>
                                <button type="button"
                                        class="flex w-full items-center gap-3 px-5 py-3 text-left transition-colors hover:bg-muted/30"
                                        @onclick="@(() => _expandedCategory = isExpanded ? null : catName)">
                                    <div class="min-w-0 flex-1">
                                        <span class="text-xs font-medium">@cat.Name</span>
                                    </div>
                                    <span class="@($"text-sm font-semibold tabular-nums {ScoreColor(cat.Score)}")">
                                        @cat.Score
                                    </span>
                                    <div class="@(isExpanded ? "rotate-90" : "") transition-transform duration-200">
                                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/60" />
                                    </div>
                                </button>
                                @if (isExpanded)
                                {
                                    <div class="overflow-hidden">
                                        <div class="px-5 pb-3">
                                            <p class="text-xs leading-relaxed text-muted-foreground">
                                                @cat.Summary
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @* Analysis section *@
                @if (_activeSection == "analysis")
                {
                    <div class="px-5 py-4">
                        <p class="text-xs font-medium text-muted-foreground">Detailed Analysis</p>
                        <div class="mt-3 space-y-4">
                            @foreach (var cat in _review.Categories)
                            {
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs font-medium">@cat.Name</span>
                                        <span class="@($"text-[10px] font-medium tabular-nums {ScoreColor(cat.Score)}")">
                                            @cat.Score/@cat.MaxScore
                                        </span>
                                    </div>
                                    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                        @cat.Summary
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* Pros & Cons section *@
                @if (_activeSection == "pros-cons")
                {
                    <div class="px-5 py-4">
                        <div class="grid grid-cols-2 gap-6">
                            <div>
                                <span class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                                    What we liked
                                </span>
                                <ul class="mt-2.5 space-y-2">
                                    @foreach (var pro in _review.Pros)
                                    {
                                        <li class="flex items-start gap-2 text-xs leading-relaxed">
                                            <span class="mt-1.5 size-1 shrink-0 rounded-full bg-emerald-500"></span>
                                            @pro
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div>
                                <span class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                    <LucideIconCn Name="x-circle" Size="12" Class="size-3 text-red-500" />
                                    What could improve
                                </span>
                                <ul class="mt-2.5 space-y-2">
                                    @foreach (var con in _review.Cons)
                                    {
                                        <li class="flex items-start gap-2 text-xs leading-relaxed">
                                            <span class="mt-1.5 size-1 shrink-0 rounded-full bg-red-500"></span>
                                            @con
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                @* Verdict section *@
                @if (_activeSection == "verdict")
                {
                    <div class="px-5 py-4">
                        @* Award badge *@
                        <div class="flex items-center gap-2 rounded-md bg-muted/30 px-3 py-2">
                            <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                            <div>
                                <p class="text-xs font-medium">Editor's Pick Award</p>
                                <p class="text-[10px] text-muted-foreground">
                                    Scored 8.0+ across all major categories
                                </p>
                            </div>
                            <span class="@($"ml-auto text-lg font-semibold tabular-nums {ScoreColor(_review.OverallScore)}")">
                                @_review.OverallScore
                            </span>
                        </div>

                        @* Final verdict *@
                        <div class="mt-4">
                            <p class="text-xs font-medium text-muted-foreground">Final Verdict</p>
                            <p class="mt-1.5 text-sm leading-relaxed">@_review.Verdict</p>
                        </div>

                        @* Bottom line *@
                        <div class="mt-4 rounded-md border border-dashed px-3 py-2.5">
                            <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                Bottom Line
                            </p>
                            <p class="mt-1 text-xs leading-relaxed text-foreground/80">
                                @_review.BottomLine
                            </p>
                        </div>

                        @* Score summary *@
                        <div class="mt-4 flex items-center gap-3 text-[10px] text-muted-foreground">
                            <span>Highest: Design &amp; Build (9.1)</span>
                            <span class="size-0.5 rounded-full bg-muted-foreground/50"></span>
                            <span>Lowest: Value (7.8)</span>
                            <span class="size-0.5 rounded-full bg-muted-foreground/50"></span>
                            <span>5 categories tested</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ScoreCategory(string Name, double Score, double MaxScore, string Summary);

    private record EditorialSection(string Id, string Label);

    private record EditorialReview(
        string Product,
        string Subtitle,
        string Author,
        string AuthorRole,
        string PublishedDate,
        double OverallScore,
        string PullQuote,
        string Verdict,
        ScoreCategory[] Categories,
        string[] Pros,
        string[] Cons,
        string BottomLine
    );

    private static readonly EditorialSection[] _sections =
    [
        new("overview", "Overview"),
        new("scores", "Scores"),
        new("analysis", "Analysis"),
        new("pros-cons", "Pros & Cons"),
        new("verdict", "Verdict"),
    ];

    private static readonly EditorialReview _review = new(
        "ProBook X14 Gen 3",
        "Professional Ultrabook",
        "Alex Chen",
        "Senior Hardware Editor",
        "March 18, 2026",
        8.4,
        "The kind of machine that disappears into your workflow, letting you focus entirely on the work itself.",
        "A compelling choice for developers and creative professionals who prioritize build quality and sustained performance over raw GPU power. The premium is justified if you value reliability and plan to keep the machine for 3+ years.",
        [
            new("Design & Build", 9.1, 10, "Exceptional build quality with premium materials throughout. The minimal bezels and balanced weight distribution make it comfortable for extended use. Port selection covers all common needs without dongles."),
            new("Performance", 8.2, 10, "Handles demanding workloads including 4K video editing and large codebases without throttling. The new chip architecture delivers a 35% improvement over the previous generation in sustained multi-core tasks."),
            new("Display", 8.8, 10, "Factory-calibrated to Delta E < 1 with 120Hz ProMotion support. Peak brightness of 1600 nits handles outdoor visibility well. P3 wide color gamut coverage hits 98.7% in our testing."),
            new("Battery Life", 8.5, 10, "Consistently delivers 14+ hours under mixed workloads with adaptive refresh. Fast charging from 0 to 50% in 28 minutes. Power delivery over USB-C means any compliant charger works."),
            new("Value", 7.8, 10, "Priced at a premium over competitors with similar specs. However, the build quality, display calibration, and 3-year warranty offset the cost for professionals who rely on their hardware daily."),
        ],
        [
            "Best-in-class display with factory color calibration",
            "Silent operation under normal workloads",
            "All-day battery life averaging 14 hours",
            "Excellent keyboard with 1.5mm travel",
            "Thunderbolt 4 on all three USB-C ports",
        ],
        [
            "Base storage limited to 256GB",
            "No discrete GPU option for 14-inch model",
            "Webcam quality lags behind competitors",
            "RAM not user-upgradeable",
        ],
        "If your work demands sustained performance, color accuracy, and all-day battery in a machine that feels premium without being ostentatious, the ProBook X14 Gen 3 delivers."
    );

    private string _activeSection = "overview";
    private string? _expandedCategory = null;

    private static string ScoreColor(double score)
    {
        if (score >= 8.0) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 6.0) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string ScoreBarColor(double score)
    {
        if (score >= 8.0) return "bg-emerald-500";
        if (score >= 6.0) return "bg-amber-500";
        return "bg-red-500";
    }
}
