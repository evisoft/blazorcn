@* ============================================================
   Block: reviews-long-form-review
   Title: ReviewsLongFormReview
   Description: A long-form editorial review block for React and Next.js with sidebar table of contents navigation, section anchors, verdict box, pros and cons summary, and reading progress built with shadcn/ui Badge and Button components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-long-form-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Article header *@
        <div class="border-b px-5 py-4">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                    In-Depth Review
                </BadgeCn>
                <span class="text-xs text-muted-foreground">@_review.PublishDate</span>
            </div>
            <h2 class="mt-2 text-sm font-medium">@_review.Product</h2>
            <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                @_review.Subtitle
            </p>
            <div class="mt-3 flex items-center gap-3">
                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                    @_review.Reviewer.Initials
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium">@_review.Reviewer.Name</span>
                        <span class="text-xs text-muted-foreground">@_review.Reviewer.Role</span>
                    </div>
                    <span class="text-[10px] text-muted-foreground">
                        @_review.Reviewer.ReviewCount reviews published
                    </span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="flex items-center gap-1 text-xs text-muted-foreground">
                        <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                        @_review.ReadingTime
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" OnClick="HandleCopyLink" aria-label="copy link to this review">
                        @if (_linkCopied)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Two-column layout: sidebar TOC + content *@
        <div class="grid grid-cols-[200px_1fr] divide-x">
            @* Sidebar *@
            <div class="sticky top-0 self-start">
                @* Overall score *@
                <div class="border-b px-4 py-3">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Overall Score
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", ScoreColor(_review.OverallScore))">
                            @_review.OverallScore
                        </span>
                        <span class="text-xs text-muted-foreground">/ 10</span>
                    </div>
                </div>

                @* Criteria mini-bars *@
                <div class="border-b px-4 py-3">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Breakdown
                    </span>
                    <div class="mt-2 space-y-2">
                        @foreach (var criteria in _review.CriteriaScores)
                        {
                            var pct = (int)((criteria.Score / criteria.MaxScore) * 100);
                            <div>
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] text-muted-foreground">@criteria.Category</span>
                                    <span class="@Cn.Merge("text-[10px] font-medium tabular-nums", ScoreColor(criteria.Score))">
                                        @criteria.Score
                                    </span>
                                </div>
                                <div class="mt-0.5 h-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@Cn.Merge("h-full rounded-full", ScoreBg(criteria.Score))" style="@($"width:{pct}%")"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Table of contents *@
                <nav class="px-4 py-3">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Contents
                    </span>
                    <div class="mt-2 space-y-0.5">
                        @foreach (var sec in _review.Sections)
                        {
                            var slug = sec.Slug;
                            <button type="button"
                                    @onclick="@(() => _activeSection = slug)"
                                    class="@Cn.Merge("flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-xs transition-colors", _activeSection == slug ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                                <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 shrink-0 transition-transform duration-200", _activeSection == slug ? "rotate-90" : "")" />
                                @sec.Heading
                            </button>
                        }
                    </div>
                </nav>
            </div>

            @* Content area *@
            <div>
                @* Pros & Cons summary bar *@
                <div class="grid grid-cols-2 gap-px border-b bg-border">
                    <div class="bg-card px-4 py-3">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                            Pros
                        </span>
                        <ul class="mt-1.5 space-y-1">
                            @foreach (var pro in _review.Pros)
                            {
                                <li class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
                                    <LucideIconCn Name="check" Size="12" Class="mt-0.5 size-3 shrink-0 text-emerald-500" />
                                    @pro
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="bg-card px-4 py-3">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-red-600 dark:text-red-400">
                            Cons
                        </span>
                        <ul class="mt-1.5 space-y-1">
                            @foreach (var con in _review.Cons)
                            {
                                <li class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
                                    <LucideIconCn Name="x" Size="12" Class="mt-0.5 size-3 shrink-0 text-red-500" />
                                    @con
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Article sections *@
                @foreach (var sec in _review.Sections.Where(s => s.Slug == _activeSection))
                {
                    <div class="px-5 py-4">
                        <h3 class="text-sm font-medium">@sec.Heading</h3>
                        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@sec.Body</p>
                        @if (sec.PullQuote != null)
                        {
                            <div class="my-4 border-l-2 border-l-foreground/20 pl-4">
                                <p class="text-sm italic text-foreground/70">@sec.PullQuote</p>
                            </div>
                        }
                    </div>
                }

                @* Verdict box *@
                <div class="border-t bg-muted/30 px-5 py-4">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Verdict
                        </span>
                        <div class="@Cn.Merge("rounded-md px-2 py-0.5 text-xs font-medium tabular-nums", _review.OverallScore >= 8 ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : _review.OverallScore >= 6 ? "bg-blue-500/10 text-blue-600 dark:text-blue-400" : "bg-amber-500/10 text-amber-600 dark:text-amber-400")">
                            @_review.OverallScore / 10
                        </div>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        @_review.Verdict
                    </p>

                    @* Criteria one-liner summary *@
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var c in _review.CriteriaScores)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1 text-[10px] text-muted-foreground">
                                <span class="@Cn.Merge("size-1.5 rounded-full", ScoreBg(c.Score))"></span>
                                @c.Category: @c.Score
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewerInfo(string Name, string Role, string Initials, int ReviewCount);
    private record CriteriaScore(string Category, double Score, double MaxScore, string Comment);
    private record ReviewSection(string Slug, string Heading, string Body, string? PullQuote = null);
    private record ReviewArticle(
        string Product,
        string Subtitle,
        ReviewerInfo Reviewer,
        string PublishDate,
        string ReadingTime,
        double OverallScore,
        string Verdict,
        string[] Pros,
        string[] Cons,
        CriteriaScore[] CriteriaScores,
        ReviewSection[] Sections
    );

    private string _activeSection = "context";
    private bool _linkCopied = false;

    private void HandleCopyLink()
    {
        _linkCopied = true;
        // In a real implementation this would copy the link; here we just toggle the icon
        Task.Delay(2000).ContinueWith(_ => { _linkCopied = false; InvokeAsync(StateHasChanged); });
    }

    private static string ScoreColor(double score)
    {
        if (score >= 9) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 7.5) return "text-blue-600 dark:text-blue-400";
        if (score >= 5) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string ScoreBg(double score)
    {
        if (score >= 9) return "bg-emerald-500";
        if (score >= 7.5) return "bg-blue-500";
        if (score >= 5) return "bg-amber-500";
        return "bg-red-500";
    }

    private static readonly ReviewArticle _review = new(
        Product: "Luminar Noise-Cancelling Headphones Pro",
        Subtitle: "Three weeks with the $349 ANC headphones that prioritize all-day comfort over audiophile detail",
        Reviewer: new ReviewerInfo(
            Name: "Alex Hayward",
            Role: "Audio Equipment Editor",
            Initials: "AH",
            ReviewCount: 147
        ),
        PublishDate: "March 12, 2026",
        ReadingTime: "8 min read",
        OverallScore: 8.2,
        Verdict: "A compelling daily driver for professionals who need reliable noise cancellation and all-day comfort. The warm sound signature suits most genres and calls, though detail-seekers should audition first. At $349, it matches Sony and Bose on ANC while offering class-leading comfort for extended sessions.",
        Pros:
        [
            "Exceptional ANC in open-plan offices — reduces keyboard clatter to near silence",
            "Cooling gel ear cups prevent heat buildup through 8+ hour sessions",
            "40-hour battery with USB-C fast charging (5 hrs from 10 min charge)",
            "Multipoint Bluetooth pairs with two devices simultaneously without drops",
        ],
        Cons:
        [
            "Bass response feels slightly bloated on electronic and EDM tracks",
            "Carrying case is 30% bulkier than Sony WH-1000XM6 case",
            "No aptX Lossless codec support — limited to LDAC and AAC",
        ],
        CriteriaScores:
        [
            new CriteriaScore("Sound Quality", 7.5, 10, "Warm signature, excellent mids, bass slightly overemphasized"),
            new CriteriaScore("Noise Cancellation", 9.0, 10, "Best-in-class for office and transit environments"),
            new CriteriaScore("Comfort", 9.5, 10, "Cooling gel + memory foam, 254g evenly distributed"),
            new CriteriaScore("Battery Life", 8.5, 10, "38-42 hrs real-world with ANC, fast charge is clutch"),
            new CriteriaScore("Build Quality", 7.8, 10, "Aerospace aluminum headband, plastic ear cup housings"),
        ],
        Sections:
        [
            new ReviewSection("context", "Context and Competitors",
                "The Luminar Pro arrives at a competitive $349 price point, positioning itself directly against the Sony WH-1000XM6 ($399) and Bose QuietComfort Ultra ($429). Where Sony emphasizes sound tuning and Bose leads in call quality, Luminar bets everything on comfort and ANC performance. The companion app includes a personalized ANC calibration that analyzes your ear shape — a genuine differentiator that improved isolation noticeably on first setup. After three weeks of daily use across commutes, office work, and gym sessions, the picture is clear.",
                PullQuote: "Where Sony emphasizes sound tuning and Bose leads in call quality, Luminar bets everything on comfort."),
            new ReviewSection("sound", "Sound Quality Deep-Dive",
                "Out of the box, the Luminar Pro leans warm and smooth — pleasant for podcasts, vocal jazz, and acoustic tracks. Male and female vocals sit forward in the mix with natural timbre. Instrument separation in complex orchestral passages is adequate but not exceptional. The bass boost becomes apparent on bass-heavy electronic tracks where the low end bleeds into the mids slightly. An EQ toggle in the app offers a flatter profile that improves analytical listening, but it cuts overall warmth. For the target audience — people working in offices who switch between calls, podcasts, and background music — the default tuning is well-judged."),
            new ReviewSection("anc", "Noise Cancellation Performance",
                "This is the Luminar Pro's strongest suit. In an open-plan office with 40+ people, activating ANC reduced ambient conversation to a barely perceptible murmur. Keyboard clatter from the desk next to mine disappeared entirely. On my daily train commute, low-frequency rumble was eliminated more effectively than my outgoing Sony XM5s. Wind noise handling has also improved — outdoor walks were manageable without switching to transparency mode. The adaptive ANC system adjusts intensity based on environment without user intervention, and the transitions between levels are smooth enough that I rarely noticed them happening.",
                PullQuote: "Keyboard clatter from the desk next to mine disappeared entirely."),
            new ReviewSection("comfort", "All-Day Comfort",
                "This is where the Luminar Pro genuinely breaks new ground. The memory foam ear cups incorporate a cooling gel layer that I have never experienced in this price range. After 2 hours with most over-ears, I develop a noticeable warm spot — with the Luminar Pro, 6-hour sessions passed without discomfort. The headband uses aerospace-grade aluminum with a silicone cushion that distributes the 254g weight evenly. Clamping force is gentle enough for glasses wearers (I tested with multiple frames) without being so loose that they shift during head movement. On long flights, these are genuinely transformative."),
            new ReviewSection("battery", "Battery and Charging",
                "Luminar claims 40 hours with ANC enabled. In my testing across varying ANC intensities and Bluetooth codecs, I consistently measured 38-42 hours — an honest spec from a manufacturer. The USB-C fast charging delivers 5 hours of playback from a 10-minute charge, which saved me twice when I forgot to charge overnight before morning commutes. Full charge from empty takes 2.5 hours. There is no wireless charging support, which is a minor omission at this price. The battery indicator in both the app and the Bluetooth menu was always accurate to within 5%."),
            new ReviewSection("verdict", "Final Verdict",
                "The Luminar Noise-Cancelling Headphones Pro earn a strong recommendation for professionals who wear headphones 6+ hours daily and prioritize comfort and silence over audiophile-grade detail. At $349, the value proposition is compelling — you get ANC that matches or beats Sony and Bose, comfort that exceeds both, and battery life that means weekly charging at most. The warm sound signature is a preference call: fantastic for everyday use, but not the choice for critical listening. If aptX Lossless support is essential, wait for the rumored V2 firmware. For everyone else, these are the best work headphones available today."),
        ]
    );
}
