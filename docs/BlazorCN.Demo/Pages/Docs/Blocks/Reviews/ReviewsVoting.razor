@* ========================================
   Block: reviews-voting
   Title: Reviews Voting
   Description: Interactive review card with like/dislike voting and expandable content for React ecommerce apps
   Long Description: Product Hunt style review card with upvote/downvote voting for React product directories
   Dependencies: LucideStarCn, LucideThumbsDownCn, LucideThumbsUpCn
   Source: original/blocks/reviews/reviews-voting.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Customer Review</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Header *@
                <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="h-12 w-12">
                            <AvatarImageCn Alt="@_authorName" Src="@_authorAvatar" />
                            <AvatarFallbackCn>@GetInitials(_authorName)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="font-semibold">@_authorName</p>
                            <p class="text-sm text-muted-foreground">@_authorTitle</p>
                        </div>
                    </div>
                    <p class="text-sm text-muted-foreground">
                        <span class="font-semibold text-foreground">@_likes people</span> found this helpful
                    </p>
                </div>

                @* Rating and Title *@
                <div class="mb-4 space-y-2">
                    <div class="flex items-center gap-0.5">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var star = i;
                            <LucideStarCn Size="16" Class="@($"h-4 w-4 {(star <= _rating ? "fill-primary text-primary" : "fill-muted text-muted")}")" />
                        }
                    </div>
                    <h2 class="text-xl font-semibold">@_reviewTitle</h2>
                </div>

                @* Content *@
                <p class="@Cn.Merge("text-muted-foreground", _isExpanded ? "" : "line-clamp-3")">
                    @_reviewContent
                </p>

                <ButtonCn Class="mt-2 h-auto p-0" Variant="ButtonVariant.Link" @onclick="() => _isExpanded = !_isExpanded">
                    @(_isExpanded ? "Show less" : "Show more")
                </ButtonCn>

                @* Vote Buttons *@
                <div class="mt-6 flex items-center gap-2">
                    <span class="mr-2 text-sm text-muted-foreground">Helpful?</span>
                    <ButtonCn Class="h-8"
                              Size="ButtonSize.Sm"
                              Variant="@(_userVote == "like" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              @onclick='() => HandleVote("like")'>
                        <LucideThumbsUpCn Size="12" Class="mr-1 h-3 w-3" />
                        @_likes
                    </ButtonCn>
                    <ButtonCn Class="h-8"
                              Size="ButtonSize.Sm"
                              Variant="@(_userVote == "dislike" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              @onclick='() => HandleVote("dislike")'>
                        <LucideThumbsDownCn Size="12" Class="mr-1 h-3 w-3" />
                        @_dislikes
                    </ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isExpanded;
    private int _likes = 47;
    private int _dislikes = 3;
    private string? _userVote;

    private const string _authorName = "Adam Smith";
    private const string _authorTitle = "CEO at ACME Inc.";
    private const string _authorAvatar = "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80";
    private const int _rating = 5;
    private const string _reviewTitle = "Wished I bought this thing sooner!";
    private const string _reviewContent = "I recently got my hands on this amazing bag, and after using it for a while, I can confidently say it is a solid choice for travelling. The build quality is exceptional, with reinforced stitching and premium materials throughout. The organization options are fantastic - multiple compartments for laptop, tablet, and all your accessories. The ergonomic design makes it comfortable even when fully loaded. Verdict: If you are looking for an amazing backpack that balances comfort, organization, and durability, this is a great investment. Would definitely recommend it to anyone in need of a reliable bag!";

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private void HandleVote(string vote)
    {
        if (_userVote == vote)
        {
            // Remove vote
            if (vote == "like") _likes--;
            else _dislikes--;
            _userVote = null;
        }
        else
        {
            // Remove previous vote if any
            if (_userVote == "like") _likes--;
            if (_userVote == "dislike") _dislikes--;
            // Add new vote
            if (vote == "like") _likes++;
            else _dislikes++;
            _userVote = vote;
        }
    }
}
