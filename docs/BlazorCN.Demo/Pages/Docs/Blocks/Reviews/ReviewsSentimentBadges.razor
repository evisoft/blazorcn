@* ============================================================
   Block: reviews-sentiment-badges
   Title: ReviewsSentimentBadges
   Description: AI-powered sentiment analysis badges for React and Next.js reviews with five sentiment categories, animated filter chips, confidence scores, and keyword extraction using shadcn/ui Badge, Tooltip, and Tailwind CSS.
   Source: original/blocks/reviews/reviews-sentiment-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with summary stats *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-sm font-medium">Sentiment Analysis</span>
                <span class="text-xs text-muted-foreground">
                    @_reviews.Length reviews analyzed
                </span>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var stype in _sentimentTypes)
                {
                    var cfg = _sentimentConfig[stype];
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="@Cn.Merge("size-1.5 rounded-full", cfg.Dot)"></span>
                        @_counts[stype]
                    </span>
                }
            </div>
        </div>

        @* Filter chips *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
            <button
                type="button"
                @onclick="@(() => _activeFilter = null)"
                class="@Cn.Merge("rounded-full px-2.5 py-1 text-xs transition-colors", _activeFilter == null ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                All
            </button>
            @foreach (var stype in _sentimentTypes)
            {
                var localType = stype;
                var cfg = _sentimentConfig[localType];
                var isActive = _activeFilter == localType;
                <button
                    type="button"
                    @onclick="@(() => _activeFilter = (_activeFilter == localType ? null : localType))"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs transition-colors", isActive ? Cn.Merge(cfg.Bg, cfg.Text) : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cfg.Dot)"></span>
                    @cfg.Label
                </button>
            }
        </div>

        @* Bento grid of review cards *@
        <div class="p-3">
            @{
                var filtered = _activeFilter == null
                    ? _reviews
                    : _reviews.Where(r => r.Sentiment.Type == _activeFilter).ToArray();
            }
            @if (filtered.Length == 0)
            {
                <div class="col-span-full py-12 text-center text-sm text-muted-foreground">
                    No reviews with this sentiment
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    @for (var idx = 0; idx < filtered.Length; idx++)
                    {
                        var review = filtered[idx];
                        var rcfg = _sentimentConfig[review.Sentiment.Type];
                        <div class="rounded-md border p-3">
                            @* Top: author + sentiment badge *@
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                        @review.Author.Initials
                                    </div>
                                    <span class="text-xs font-medium">@review.Author.Name</span>
                                    <span class="text-[10px] text-muted-foreground">@review.Date</span>
                                </div>
                                <TooltipProviderCn>
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <span class="@Cn.Merge("flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-medium", rcfg.Bg, rcfg.Text)">
                                                <span class="@Cn.Merge("size-1 rounded-full", rcfg.Dot)"></span>
                                                @rcfg.Label
                                            </span>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn>
                                            <p class="text-xs">@review.Sentiment.Confidence% confidence</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TooltipProviderCn>
                            </div>

                            @* Rating + title *@
                            <div class="mt-2 flex items-center gap-1.5">
                                <div class="flex items-center gap-0.5">
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        var starIndex = i;
                                        <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIndex < review.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                    }
                                </div>
                                <span class="truncate text-xs font-medium">@review.Title</span>
                            </div>

                            @* Body *@
                            <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                                @review.Body
                            </p>

                            @* Confidence bar + key phrases *@
                            <div class="mt-2.5 space-y-2">
                                @* Confidence bar *@
                                <div class="flex items-center gap-2">
                                    <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                        <div class="@Cn.Merge("h-full rounded-full", rcfg.Dot)" style="@($"width:{review.Sentiment.Confidence}%")"></div>
                                    </div>
                                    <span class="text-[10px] tabular-nums text-muted-foreground">
                                        @review.Sentiment.Confidence%
                                    </span>
                                </div>

                                @* Key phrases *@
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var phrase in review.Sentiment.KeyPhrases)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                            @phrase
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ReviewAuthorInfo(string Name, string Initials);
    private record SentimentInfo(string Type, int Confidence, string[] KeyPhrases);
    private record SentimentReview(string Id, ReviewAuthorInfo Author, int Rating, string Date, string Title, string Body, SentimentInfo Sentiment);
    private record SentimentCfg(string Label, string Dot, string Bg, string Text);

    private string? _activeFilter = null;

    private static readonly Dictionary<string, SentimentCfg> _sentimentConfig = new()
    {
        ["positive"] = new("Positive", "bg-emerald-500", "bg-emerald-500/10", "text-emerald-700 dark:text-emerald-400"),
        ["negative"] = new("Negative", "bg-red-500", "bg-red-500/10", "text-red-700 dark:text-red-400"),
        ["mixed"] = new("Mixed", "bg-amber-500", "bg-amber-500/10", "text-amber-700 dark:text-amber-400"),
        ["enthusiastic"] = new("Enthusiastic", "bg-blue-500", "bg-blue-500/10", "text-blue-700 dark:text-blue-400"),
        ["critical"] = new("Critical", "bg-red-500", "bg-red-500/10", "text-red-700 dark:text-red-400"),
    };

    private static readonly string[] _sentimentTypes = ["positive", "enthusiastic", "mixed", "negative", "critical"];

    private static readonly SentimentReview[] _reviews =
    [
        new("sb-1", new("Maria Santos", "MS"), 5, "Mar 18, 2026", "Incredible quality and fast shipping",
            "Everything about this experience was top-notch. The product arrived earlier than expected and the quality is superb. Exactly as described on the listing. Packaging was also impressive with attention to detail.",
            new("enthusiastic", 94, ["top-notch", "quality is superb", "exactly as described"])),
        new("sb-2", new("Thomas Wright", "TW"), 4, "Mar 15, 2026", "Good product with minor packaging issue",
            "The product itself is great and works perfectly. The outer box was slightly damaged during shipping but the item inside was unaffected. Would buy again despite the packaging concern.",
            new("mixed", 78, ["great and works perfectly", "slightly damaged", "would buy again"])),
        new("sb-3", new("Kenji Tanaka", "KT"), 3, "Mar 12, 2026", "Does the job, nothing special",
            "It works as advertised and I have no complaints. The build quality is average for the price range. Not particularly impressed but not disappointed either. Adequate for everyday use.",
            new("mixed", 82, ["works as advertised", "average for the price", "not impressed"])),
        new("sb-4", new("Claire Dubois", "CD"), 1, "Mar 9, 2026", "Stopped working after two weeks",
            "The product worked fine initially but completely stopped functioning after 14 days. Customer support has been unresponsive to my three emails. Very frustrated with the lack of quality control.",
            new("critical", 96, ["stopped functioning", "unresponsive", "lack of quality control"])),
        new("sb-5", new("Hannah Berg", "HB"), 5, "Mar 1, 2026", "Exceeded all my expectations",
            "I was skeptical at first but this product blew me away. The finish is beautiful, it feels solid in hand, and the performance is outstanding. Already recommended to friends and family.",
            new("enthusiastic", 91, ["blew me away", "outstanding", "already recommended"])),
        new("sb-6", new("Omar Hassan", "OH"), 2, "Feb 26, 2026", "Missing parts and poor instructions",
            "The package was missing two screws and the instruction manual has no English translation. Had to figure out assembly on my own. Disappointing for this price point.",
            new("negative", 88, ["missing two screws", "no English translation", "disappointing"])),
        new("sb-7", new("Elena Petrova", "EP"), 5, "Feb 22, 2026", "Best purchase this year hands down",
            "This is genuinely the best product I have purchased this year. Build quality is exceptional, the interface is intuitive, and it just works. Zero setup hassle and immediate value from day one.",
            new("positive", 93, ["best product", "exceptional", "zero setup hassle"])),
        new("sb-8", new("James Liu", "JL"), 4, "Feb 18, 2026", "Solid choice for the price",
            "Good value for money. The build feels premium despite the mid-range price. A few minor software quirks but nothing that breaks the experience. Regular firmware updates show the company cares.",
            new("positive", 85, ["good value", "feels premium", "company cares"])),
    ];

    private static readonly Dictionary<string, int> _counts = _sentimentTypes
        .ToDictionary(t => t, t => _reviews.Count(r => r.Sentiment.Type == t));
}
