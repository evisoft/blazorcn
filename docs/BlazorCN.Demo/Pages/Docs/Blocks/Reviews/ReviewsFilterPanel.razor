@* ========================================
   Block: reviews-filter-panel
   Title: Reviews Filter Panel
   Description: Review filter panel component with search, rating checkboxes, and keywords for React ecommerce sites
   Long Description: Side-by-side product review comparison component for React buying guides and decision tools
   Dependencies: LucideCheckCn, LucideSearchCn, LucideSlidersHorizontalCn, LucideStarCn, LucideXCn
   Source: original/blocks/reviews/reviews-filter-panel.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Filter Reviews</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Header *@
                <div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h2 class="text-lg font-semibold">Reviews (214)</h2>
                        <div class="mt-1 flex items-center gap-2">
                            <div class="flex items-center gap-0.5">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <LucideStarCn Class="@Cn.Merge("h-3 w-3", star <= 5 ? "fill-primary text-primary" : "fill-muted text-muted")" Size="12" />
                                }
                            </div>
                            <span class="text-sm font-medium">4.8</span>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        @* Search *@
                        <div class="relative flex-1 sm:w-60">
                            <LucideSearchCn Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" Size="16" />
                            <InputCn aria-label="Search reviews" Class="pl-9 pr-9" Placeholder="Search reviews..."
                                     Value="@_searchTerm" ValueChanged="@((string v) => _searchTerm = v)" />
                            @if (!string.IsNullOrEmpty(_searchTerm))
                            {
                                <ButtonCn Class="absolute right-0 top-0 h-full" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                          @onclick="@(() => _searchTerm = "")" aria-label="Close">
                                    <LucideXCn Class="h-4 w-4" Size="16" />
                                </ButtonCn>
                            }
                        </div>

                        @* Mobile Filter Toggle *@
                        <ButtonCn Class="sm:hidden" Variant="ButtonVariant.Outline"
                                  @onclick="@(() => _showMobileFilters = !_showMobileFilters)">
                            <LucideSlidersHorizontalCn Class="mr-2 h-4 w-4" Size="16" />
                            Filter
                        </ButtonCn>

                        @* Sort Dropdown *@
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default hidden sm:flex" data-variant="outline" data-size="default">
                                    Sort: @_sortBy
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                @foreach (var option in _sortOptions)
                                {
                                    <DropdownMenuItemCn OnClick="@(() => _sortBy = option)">
                                        <span class="flex-1">@option</span>
                                        @if (_sortBy == option)
                                        {
                                            <LucideCheckCn Class="ml-2 h-4 w-4" Size="16" />
                                        }
                                    </DropdownMenuItemCn>
                                }
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>

                <SeparatorCn Class="mb-4" />

                @* Filters *@
                <div class="@Cn.Merge("space-y-6", _showMobileFilters ? "block" : "hidden sm:block")">
                    @* Rating Filter *@
                    <div>
                        <h3 class="mb-3 text-sm font-medium">Rating</h3>
                        <div class="space-y-2">
                            @for (var rating = 5; rating >= 1; rating--)
                            {
                                var r = rating;
                                <label for="@($"rev-filter-rating-{r}")"
                                       class="flex cursor-pointer items-center gap-3 rounded-md p-2 hover:bg-muted/50">
                                    <CheckboxCn id="@($"rev-filter-rating-{r}")"
                                                Checked="@_ratings.Contains(r)"
                                                CheckedChanged="@((bool _) => ToggleRating(r))"
                                                aria-label="@($"{r} stars")" />
                                    <div class="flex items-center gap-0.5">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <LucideStarCn Class="@Cn.Merge("h-3 w-3", star <= r ? "fill-primary text-primary" : "fill-muted text-muted")" Size="12" />
                                        }
                                    </div>
                                    @* Was a LabelCn. A nested label element is invalid and counts as
                                       interactive content, so the outer label would be inert for clicks
                                       on this text. These classes are LabelCn's rendered output. *@
                                    <span class="cn-label flex items-center select-none cursor-pointer text-sm text-muted-foreground">
                                        @r @(r == 1 ? "star" : "stars") &amp; up
                                    </span>
                                </label>
                            }
                        </div>
                    </div>

                    @* Keywords *@
                    <div>
                        <h3 class="mb-3 text-sm font-medium">Popular mentions</h3>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var keyword in _keywords)
                            {
                                <button type="button" @onclick="@(() => ToggleKeyword(keyword))">
                                    <BadgeCn Class="cursor-pointer"
                                             Variant="@(_selectedKeywords.Contains(keyword) ? BadgeVariant.Default : BadgeVariant.Outline)">
                                        @keyword
                                    </BadgeCn>
                                </button>
                            }
                        </div>
                    </div>

                    @* Mobile Actions *@
                    <div class="flex justify-between border-t pt-4 sm:hidden">
                        <ButtonCn Variant="ButtonVariant.Outline" @onclick="ResetFilters">Reset</ButtonCn>
                        <ButtonCn @onclick="@(() => _showMobileFilters = false)">Show results</ButtonCn>
                    </div>

                    @* Desktop Reset *@
                    @if (_hasActiveFilters)
                    {
                        <div class="hidden sm:block">
                            <ButtonCn Class="text-muted-foreground" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                      @onclick="ResetFilters">
                                <LucideXCn Class="mr-1 h-3 w-3" Size="12" />
                                Clear all filters
                            </ButtonCn>
                        </div>
                    }
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private static readonly string[] _keywords = ["Quality", "Value", "Fast shipping", "Easy setup", "Great support", "Durable", "Comfortable", "As described"];
    private static readonly string[] _sortOptions = ["Most recent", "Highest rated", "Lowest rated", "Most helpful"];

    private string _searchTerm = "";
    private List<int> _ratings = new();
    private List<string> _selectedKeywords = new();
    private string _sortBy = "Most recent";
    private bool _showMobileFilters;

    private bool _hasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || _ratings.Count > 0 || _selectedKeywords.Count > 0;

    private void ToggleRating(int rating)
    {
        if (_ratings.Contains(rating))
            _ratings.Remove(rating);
        else
            _ratings.Add(rating);
    }

    private void ToggleKeyword(string keyword)
    {
        if (_selectedKeywords.Contains(keyword))
            _selectedKeywords.Remove(keyword);
        else
            _selectedKeywords.Add(keyword);
    }

    private void ResetFilters()
    {
        _searchTerm = "";
        _ratings.Clear();
        _selectedKeywords.Clear();
        _sortBy = "Most recent";
    }
}
