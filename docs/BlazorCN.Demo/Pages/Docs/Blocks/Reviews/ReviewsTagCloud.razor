@* ============================================================
   Block: reviews-tag-cloud
   Title: ReviewsTagCloud
   Description: A visual keyword tag cloud block for React and Next.js with weighted tag sizes based on mention frequency, click-to-filter functionality, and animated tag transitions built with shadcn/ui Badge and Separator components and Tailwind CSS.
   Source: original/blocks/reviews/reviews-tag-cloud.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between px-5 py-3.5">
            <div>
                <span class="text-sm font-medium">Review keyword cloud</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_keywords.Length keywords from @_totalMentions.ToString("N0") mentions
                </p>
            </div>
            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_positiveCount positive
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    @_neutralCount neutral
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_negativeCount negative
                </span>
            </div>
        </div>

        <SeparatorCn />

        @* Tag cloud visual *@
        <div class="px-5 py-5">
            <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
                @foreach (var kw in _keywords)
                {
                    var keyword = kw;
                    var isActive = _activeKeyword == keyword.Text;
                    <button type="button"
                            @onclick="@(() => SetActive(keyword.Text))"
                            class="@Cn.Merge("inline-flex items-center gap-1 rounded-md px-2 py-0.5 transition-all", SizeClass(keyword.Count), isActive ? "bg-foreground text-background" : (_activeKeyword != null ? "text-muted-foreground/40 hover:text-muted-foreground" : "text-foreground hover:text-foreground/70"))">
                        <span class="@Cn.Merge("size-1 shrink-0 rounded-full", SentimentDot(keyword.Sentiment), isActive ? "opacity-80" : "")"></span>
                        @keyword.Text
                    </button>
                }
            </div>
        </div>

        @* Active keyword detail + excerpts *@
        @if (_activeKeyword != null && _activeKeywordData != null)
        {
            var akd = _activeKeywordData;
            <SeparatorCn />
            <div class="px-5 py-4">
                @* Active keyword header *@
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="hash" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-sm font-medium">@_activeKeyword</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                            @akd.Count mentions
                        </BadgeCn>
                        <span class="@Cn.Merge("size-1.5 rounded-full", SentimentDot(akd.Sentiment))"></span>
                    </div>
                    <button type="button"
                            @onclick="@(() => _activeKeyword = null)"
                            class="rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </button>
                </div>

                @* Matching excerpts *@
                @if (_matchingExcerpts.Length > 0)
                {
                    <div class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-2">
                        @foreach (var ex in _matchingExcerpts)
                        {
                            var excerpt = ex;
                            <div class="rounded-md border bg-muted/20 p-3">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-medium">@excerpt.Author</span>
                                    <div class="flex items-center gap-0.5">
                                        @for (var i = 0; i < 5; i++)
                                        {
                                            var starIndex = i;
                                            <LucideIconCn Name="star" Size="10"
                                                          Class="@Cn.Merge("size-2.5", starIndex < excerpt.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                        }
                                    </div>
                                </div>
                                <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                                    @excerpt.Excerpt
                                </p>
                                <div class="mt-2 flex items-center gap-1">
                                    <LucideIconCn Name="message-square-text" Size="10" Class="size-2.5 text-muted-foreground/50" />
                                    <span class="text-[10px] text-muted-foreground">@excerpt.Date</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="mt-3 text-xs text-muted-foreground">
                        No excerpts available for this keyword.
                    </p>
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-5 py-2.5">
            <div class="flex items-center justify-between text-[10px] text-muted-foreground">
                <span>Extracted from @_reviewExcerpts.Length reviews</span>
                <span>
                    @(_activeKeyword != null
                        ? $"{_matchingExcerpts.Length} matching excerpts"
                        : "Click a keyword to filter")
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Keyword(string Text, int Count, string Sentiment);
    private record ReviewExcerpt(string Id, string Author, int Rating, string Excerpt, string[] Keywords, string Date);

    private static readonly Keyword[] _keywords =
    [
        new("build quality",    89, "positive"),
        new("customer support", 72, "positive"),
        new("fast shipping",    64, "positive"),
        new("easy setup",       58, "positive"),
        new("value for money",  53, "positive"),
        new("documentation",    47, "neutral"),
        new("battery life",     44, "neutral"),
        new("design",           41, "positive"),
        new("performance",      39, "positive"),
        new("mobile app",       36, "neutral"),
        new("durability",       34, "positive"),
        new("packaging",        31, "neutral"),
        new("price increase",   28, "negative"),
        new("learning curve",   25, "negative"),
        new("integrations",     23, "neutral"),
        new("dark mode",        21, "neutral"),
        new("onboarding",       19, "positive"),
        new("accessories",      17, "neutral"),
        new("slow response",    15, "negative"),
        new("warranty",         14, "positive"),
        new("API",              12, "neutral"),
        new("export options",   10, "neutral"),
        new("notifications",     9, "negative"),
        new("SSO",               8, "negative"),
    ];

    private static readonly ReviewExcerpt[] _reviewExcerpts =
    [
        new("e1", "Sarah Chen",     5,
            "The build quality is exceptional. Every seam is tight and the materials feel premium. Fast shipping too, arrived in two days.",
            ["build quality", "fast shipping"], "Mar 28, 2026"),
        new("e2", "Omar Hassan",    4,
            "Great value for money. Customer support responded within an hour. The documentation could be more detailed for advanced use cases.",
            ["value for money", "customer support", "documentation"], "Mar 24, 2026"),
        new("e3", "Yuki Nakamura", 5,
            "The design is clean and modern. Easy setup took under five minutes. Performance has been flawless across our entire team.",
            ["design", "easy setup", "performance"], "Mar 20, 2026"),
        new("e4", "Anna Bergstrom", 3,
            "Battery life is decent but not industry-leading. The mobile app needs work. Learning curve was steeper than expected from the marketing.",
            ["battery life", "mobile app", "learning curve"], "Mar 18, 2026"),
        new("e5", "Marcus Rivera", 5,
            "Durability is remarkable. Six months in and still looks brand new. The packaging was thoughtful and eco-friendly. Onboarding wizard is excellent.",
            ["durability", "packaging", "onboarding"], "Mar 14, 2026"),
        new("e6", "Lena Okonkwo",  2,
            "Price increase from last year is hard to justify. Slow response times from support when I had a billing question. SSO still missing.",
            ["price increase", "slow response", "SSO"], "Mar 10, 2026"),
        new("e7", "James Park",    4,
            "Integrations with our existing tools work great. The API is well-documented. Dark mode is a nice touch but needs better contrast.",
            ["integrations", "API", "dark mode"], "Mar 6, 2026"),
        new("e8", "Priya Mehta",   4,
            "Warranty coverage is generous. Export options cover all the formats we need. Notifications could be less aggressive though.",
            ["warranty", "export options", "notifications"], "Mar 2, 2026"),
    ];

    private static readonly int _maxCount = _keywords.Max(k => k.Count);
    private static readonly int _minCount = _keywords.Min(k => k.Count);

    private static readonly int _positiveCount = _keywords.Count(k => k.Sentiment == "positive");
    private static readonly int _negativeCount = _keywords.Count(k => k.Sentiment == "negative");
    private static readonly int _neutralCount  = _keywords.Count(k => k.Sentiment == "neutral");
    private static readonly int _totalMentions = _keywords.Sum(k => k.Count);

    private string? _activeKeyword;

    private Keyword? _activeKeywordData => _activeKeyword != null
        ? Array.Find(_keywords, k => k.Text == _activeKeyword)
        : null;

    private ReviewExcerpt[] _matchingExcerpts => _activeKeyword != null
        ? Array.FindAll(_reviewExcerpts, e => Array.IndexOf(e.Keywords, _activeKeyword) >= 0)
        : [];

    private void SetActive(string text)
    {
        _activeKeyword = _activeKeyword == text ? null : text;
    }

    private static string SizeClass(int count)
    {
        var ratio = (double)(count - _minCount) / (_maxCount - _minCount);
        if (ratio > 0.75) return "text-lg font-semibold";
        if (ratio > 0.5)  return "text-base font-medium";
        if (ratio > 0.25) return "text-sm";
        return "text-xs";
    }

    private static string SentimentDot(string sentiment) => sentiment switch
    {
        "positive" => "bg-emerald-500",
        "negative" => "bg-red-500",
        _          => "bg-muted-foreground/40",
    };
}
