@* ============================================================
   Block: reviews-recent-activity
   Title: ReviewsRecentActivity
   Description: A real-time review activity timeline feed for React and Next.js with color-coded event types, product context, rating displays, avatar indicators, and expandable detail panels built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-recent-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Recent Activity</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_events.Length events
                </BadgeCn>
            </div>
            <div class="flex items-center gap-1">
                <button type="button"
                        @onclick="@(() => _activeFilter = "all")"
                        class="@Cn.Merge("rounded px-1.5 py-0.5 text-[10px] transition-colors", _activeFilter == "all" ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    All
                </button>
                @foreach (var evtType in _filterTypes)
                {
                    var ft = evtType;
                    var cfg = GetConfig(ft);
                    <button type="button"
                            @onclick="@(() => _activeFilter = ft)"
                            class="@Cn.Merge("flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] transition-colors", _activeFilter == ft ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                        <span class="@Cn.Merge("size-1.5 rounded-full", cfg.Dot)"></span>
                        @_events.Count(e => e.Type == ft)
                    </button>
                }
            </div>
        </div>

        @* Timeline *@
        <div class="relative">
            @* Vertical timeline line *@
            <div class="absolute bottom-0 left-[27px] top-0 w-px bg-border"></div>

            @{
                var filteredEvents = _activeFilter == "all"
                    ? _events
                    : _events.Where(e => e.Type == _activeFilter).ToArray();
            }

            @foreach (var (evt, idx) in filteredEvents.Select((e, i) => (e, i)))
            {
                var evtItem = evt;
                var evtIndex = idx;
                var evtConfig = GetConfig(evtItem.Type);
                var isExpanded = _expandedId == evtItem.Id;
                var isLast = evtIndex == filteredEvents.Length - 1;

                <div class="@Cn.Merge(!isLast ? "border-b border-border/50" : "")">
                    <button type="button"
                            @onclick="@(() => _expandedId = isExpanded ? null : evtItem.Id)"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/30">
                        @* Timeline node *@
                        <div class="relative z-10 mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full border bg-card">
                            <span class="@Cn.Merge("size-2 rounded-full", evtConfig.Dot)"></span>
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                @* Avatar *@
                                <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                                    @evtItem.Actor.Initials
                                </div>
                                <span class="text-xs font-medium">@evtItem.Actor.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1 font-normal text-[10px]">
                                    <LucideIconCn Name="@evtConfig.IconName" Size="10" Class="mr-0.5 size-2.5" />
                                    @evtConfig.Label
                                </BadgeCn>
                                <span class="ml-auto shrink-0 text-[10px] text-muted-foreground">
                                    @evtItem.Timestamp
                                </span>
                            </div>

                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                                @evtItem.Summary
                            </p>

                            @* Inline metadata *@
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="truncate text-[10px] text-muted-foreground/70">
                                    @evtItem.Product
                                </span>
                                @if (evtItem.Type == "new_review" && evtItem.Rating.HasValue)
                                {
                                    <div class="flex shrink-0 items-center gap-0.5">
                                        @for (int si = 0; si < 5; si++)
                                        {
                                            var starIndex = si;
                                            <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIndex < evtItem.Rating!.Value ? "fill-amber-400 text-amber-400" : "text-muted-foreground/20")" />
                                        }
                                    </div>
                                }
                                @if (evtItem.Type == "rating_updated" && evtItem.PreviousRating.HasValue && evtItem.Rating.HasValue)
                                {
                                    <span class="flex shrink-0 items-center gap-1 text-[10px]">
                                        <span class="text-muted-foreground tabular-nums">@evtItem.PreviousRating</span>
                                        <LucideIconCn Name="refresh-cw" Size="10" Class="size-2.5 text-muted-foreground/50" />
                                        <span class="font-medium tabular-nums">@evtItem.Rating</span>
                                        <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-400 text-amber-400" />
                                    </span>
                                }
                                @if (evtItem.Type == "review_flagged")
                                {
                                    <span class="flex shrink-0 items-center gap-0.5 text-[10px] text-red-500">
                                        <LucideIconCn Name="alert-triangle" Size="10" Class="size-2.5" />
                                        Needs review
                                    </span>
                                }
                            </div>
                        </div>

                        @* Expand indicator *@
                        <LucideIconCn Name="chevron-down" Size="14" Class="@Cn.Merge("mt-1 size-3.5 shrink-0 text-muted-foreground/40 transition-transform duration-200", isExpanded ? "rotate-180" : "")" />
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-[52px]">
                                <div class="rounded-md bg-muted/40 px-3 py-2.5">
                                    <p class="text-xs leading-relaxed text-muted-foreground">
                                        @evtItem.Detail
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                @{
                    var shownCount = _activeFilter == "all"
                        ? _events.Length
                        : _events.Count(e => e.Type == _activeFilter);
                }
                <span class="text-[10px] text-muted-foreground">
                    Showing @shownCount of @_events.Length events
                </span>
                <button type="button"
                        class="text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
                    View all activity
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private record Actor(string Name, string Initials);

    private class ActivityEvent
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "";
        public Actor Actor { get; set; } = new("", "");
        public string Product { get; set; } = "";
        public string Summary { get; set; } = "";
        public string Detail { get; set; } = "";
        public int? Rating { get; set; }
        public int? PreviousRating { get; set; }
        public string Timestamp { get; set; } = "";
    }

    private record EventConfig(string Dot, string Label, string IconName);

    private static EventConfig GetConfig(string type) => type switch
    {
        "new_review"     => new("bg-emerald-500", "New review", "star"),
        "reply_added"    => new("bg-blue-500",    "Reply",      "message-square"),
        "rating_updated" => new("bg-amber-500",   "Updated",    "refresh-cw"),
        "review_flagged" => new("bg-red-500",      "Flagged",    "flag"),
        _                => new("bg-muted-foreground", "Event",  "circle"),
    };

    private static readonly string[] _filterTypes = ["new_review", "reply_added", "rating_updated", "review_flagged"];

    private string? _expandedId;
    private string _activeFilter = "all";

