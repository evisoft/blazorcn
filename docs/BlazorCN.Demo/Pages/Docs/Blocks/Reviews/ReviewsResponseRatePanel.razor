@* ============================================================
   Block: reviews-response-rate-panel
   Title: ReviewsResponseRatePanel
   Description: A React merchant response rate analytics dashboard for Next.js with sidebar navigation, response time metrics, SLA compliance gauge, agent performance table, and pending review queue built with shadcn/ui Table, Badge, Progress components, motion/react animations, and Tailwind CSS
   Source: original/blocks/reviews/reviews-response-rate-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-44 shrink-0 flex-col border-r">
                <div class="border-b px-4 py-3">
                    <span class="text-sm font-medium">Response Rate</span>
                    <p class="mt-0.5 text-[10px] text-muted-foreground">Review response analytics</p>
                </div>
                <nav class="flex-1 p-2 space-y-0.5">
                    @foreach (var sec in _sidebarSections)
                    {
                        var grp = sec;
                        var isActive = _activeSection == grp.Key;
                        <button
                            type="button"
                            @onclick="@(() => _activeSection = grp.Key)"
                            class="@Cn.Merge("flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-xs transition-colors", isActive ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                            <LucideIconCn Name="@grp.IconName" Size="14" Class="size-3.5" />
                            <span class="flex-1 text-left">@grp.Label</span>
                            @if (grp.Count.HasValue)
                            {
                                <span class="@Cn.Merge("tabular-nums text-[10px]", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @grp.Count.Value
                                </span>
                            }
                        </button>
                    }
                </nav>
                @* Sidebar footer *@
                <div class="border-t px-3 py-3">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                        <span class="text-xs font-medium tabular-nums">
                            @_metrics.StreakDays-day streak
                        </span>
                    </div>
                    <p class="mt-0.5 text-[10px] text-muted-foreground">All reviews answered daily</p>
                </div>
            </div>

            @* Content area *@
            <div class="flex-1 overflow-y-auto">
                @if (_activeSection == "overview")
                {
                    <div class="p-5">
                        @* Metric cards *@
                        <div class="grid grid-cols-2 gap-3">
                            @* Response Rate card *@
                            <div class="rounded-md border p-4">
                                <span class="text-xs text-muted-foreground">Response Rate</span>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="@($"text-2xl font-semibold tabular-nums {RateColor(_metrics.ResponseRate)}")">
                                        @_metrics.ResponseRate%
                                    </span>
                                    <span class="@Cn.Merge("flex items-center gap-0.5 text-xs", _rateDelta >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                        @if (_rateDelta >= 0)
                                        {
                                            <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                                        }
                                        @(_rateDelta >= 0 ? "+" : "")@_rateDelta%
                                    </span>
                                </div>
                                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-emerald-500" style="@($"width:{_metrics.ResponseRate}%")"></div>
                                </div>
                                <div class="mt-1.5 flex items-center justify-between text-[10px] text-muted-foreground">
                                    <span>@_metrics.TotalResponded/@_metrics.TotalReceived reviews</span>
                                    <span>Target: @_metrics.SlaTarget%</span>
                                </div>
                                @if (_slaGap > 0)
                                {
                                    <p class="mt-2 text-[10px] text-amber-600 dark:text-amber-400">
                                        @_slaGap% below SLA target
                                    </p>
                                }
                            </div>

                            @* Avg Response Time card *@
                            <div class="rounded-md border p-4">
                                <span class="text-xs text-muted-foreground">Avg Response Time</span>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="text-2xl font-semibold tabular-nums">
                                        @FormatTime(_metrics.AvgTimeMinutes)
                                    </span>
                                    <span class="@Cn.Merge("flex items-center gap-0.5 text-xs", _timeDelta >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                        @if (_timeDelta >= 0)
                                        {
                                            <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                                        }
                                        @(_timeDelta >= 0 ? "-" : "+")@FormatTime(Math.Abs(_timeDelta))
                                    </span>
                                </div>
                                <div class="mt-3 space-y-1.5">
                                    <div class="flex items-center justify-between text-[10px]">
                                        <span class="text-muted-foreground">Under 1h</span>
                                        <span class="tabular-nums text-muted-foreground">38%</span>
                                    </div>
                                    <div class="flex items-center justify-between text-[10px]">
                                        <span class="text-muted-foreground">1-4h</span>
                                        <span class="tabular-nums text-muted-foreground">44%</span>
                                    </div>
                                    <div class="flex items-center justify-between text-[10px]">
                                        <span class="text-muted-foreground">Over 4h</span>
                                        <span class="tabular-nums text-red-600 dark:text-red-400">18%</span>
                                    </div>
                                </div>
                            </div>

                            @* Pending count card *@
                            <div class="rounded-md border p-4">
                                <span class="text-xs text-muted-foreground">Pending Reviews</span>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="text-2xl font-semibold tabular-nums">
                                        @_metrics.PendingCount
                                    </span>
                                    <span class="text-xs text-muted-foreground">awaiting reply</span>
                                </div>
                                <div class="mt-3 flex items-center gap-3">
                                    <span class="flex items-center gap-1 text-[10px] text-red-600 dark:text-red-400">
                                        <LucideIconCn Name="alert-circle" Size="10" Class="size-2.5" />
                                        @_pendingReviews.Count(r => r.Priority == "critical") critical
                                    </span>
                                    <span class="flex items-center gap-1 text-[10px] text-amber-600 dark:text-amber-400">
                                        <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                        @_pendingReviews.Count(r => r.Priority == "high") high priority
                                    </span>
                                </div>
                            </div>

                            @* Response streak card *@
                            <div class="rounded-md border p-4">
                                <span class="text-xs text-muted-foreground">Response Streak</span>
                                <div class="mt-2 flex items-baseline gap-1">
                                    <span class="text-2xl font-semibold tabular-nums">
                                        @_metrics.StreakDays
                                    </span>
                                    <span class="text-sm text-muted-foreground">days</span>
                                </div>
                                <p class="mt-1 text-[10px] text-muted-foreground">
                                    All incoming reviews answered within 24h
                                </p>
                                <div class="mt-2.5 flex gap-0.5">
                                    @for (var i = 0; i < 14; i++)
                                    {
                                        var idx = i;
                                        <div class="@Cn.Merge("h-2 flex-1 rounded-sm", idx < _metrics.StreakDays ? "bg-emerald-500" : "bg-muted")"></div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (_activeSection == "agents")
                {
                    <div class="p-5">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">Team Performance</span>
                            <span class="text-xs text-muted-foreground">This month</span>
                        </div>

                        @* Agent table *@
                        <div class="mt-4">
                            <div class="flex items-center gap-3 border-b pb-2 text-[10px] text-muted-foreground">
                                <span class="flex-1">Agent</span>
                                <span class="w-16 text-right">Replies</span>
                                <span class="w-16 text-right">Avg Time</span>
                                <span class="w-14 text-right">Rate</span>
                                <span class="w-14 text-right">Trend</span>
                                <span class="w-20 text-right">Last Active</span>
                            </div>
                            @for (var i = 0; i < _agents.Length; i++)
                            {
                                var agent = _agents[i];
                                var rowIndex = i;
                                <div class="@Cn.Merge("flex items-center gap-3 py-2.5", rowIndex < _agents.Length - 1 ? "border-b" : "")">
                                    <div class="flex min-w-0 flex-1 items-center gap-2">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", RateDotColor(agent.Rate))"></span>
                                        <span class="truncate text-sm font-medium">@agent.Name</span>
                                    </div>
                                    <span class="w-16 text-right tabular-nums text-xs text-muted-foreground">
                                        @agent.Responses
                                    </span>
                                    <span class="@Cn.Merge("w-16 text-right tabular-nums text-xs", TimeColor(agent.AverageTimeMinutes))">
                                        @FormatTime(agent.AverageTimeMinutes)
                                    </span>
                                    <span class="@Cn.Merge("w-14 text-right font-medium tabular-nums text-xs", RateColor(agent.Rate))">
                                        @agent.Rate%
                                    </span>
                                    <span class="flex w-14 items-center justify-end">
                                        @if (agent.Trend == "up")
                                        {
                                            <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                        }
                                        else if (agent.Trend == "down")
                                        {
                                            <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-red-500" />
                                        }
                                        else
                                        {
                                            <span class="text-[10px] text-muted-foreground">--</span>
                                        }
                                    </span>
                                    <span class="w-20 text-right text-[10px] text-muted-foreground">
                                        @agent.LastActive
                                    </span>
                                </div>
                            }
                        </div>

                        @* Team summary *@
                        <div class="mt-4 rounded-md bg-muted/50 p-3">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Team average rate</span>
                                <span class="font-medium tabular-nums">
                                    @(Math.Round(_agents.Average(a => (double)a.Rate)))%
                                </span>
                            </div>
                            <div class="mt-1.5 flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Team average time</span>
                                <span class="font-medium tabular-nums">
                                    @FormatTime((int)Math.Round(_agents.Average(a => (double)a.AverageTimeMinutes)))
                                </span>
                            </div>
                        </div>
                    </div>
                }

                @if (_activeSection == "pending")
                {
                    <div class="p-5">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">Pending Reviews</span>
                            <span class="text-xs text-muted-foreground">
                                @_pendingReviews.Length awaiting reply
                            </span>
                        </div>

                        <div class="mt-4 space-y-2">
                            @foreach (var review in _pendingReviews)
                            {
                                var pb = PriorityBadge(review.Priority);
                                <div class="rounded-md border p-3 transition-colors hover:bg-muted/30">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium">@review.CustomerName</span>
                                                <div class="flex items-center gap-0.5">
                                                    @for (var si = 0; si < 5; si++)
                                                    {
                                                        var starIdx = si;
                                                        <LucideIconCn Name="star" Size="10" Class="@Cn.Merge("size-2.5", starIdx < review.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/20")" />
                                                    }
                                                </div>
                                            </div>
                                            <p class="mt-1 line-clamp-1 text-xs text-muted-foreground">
                                                @review.Snippet
                                            </p>
                                        </div>
                                        <div class="flex shrink-0 flex-col items-end gap-1.5">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", pb.ClassName)">
                                                @pb.Label
                                            </BadgeCn>
                                            <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                                                <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                                @review.WaitingHours h waiting
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Priority legend *@
                        <div class="mt-4 flex items-center gap-4 text-[10px] text-muted-foreground">
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-red-500"></span>
                                Critical: 1-2 stars, over 12h
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                                High: 1-3 stars, over 4h
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                                Normal
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Agent(string Id, string Name, string Initials, int Responses, int AverageTimeMinutes, int Rate, string Trend, string LastActive);
    private record PendingReview(string Id, string CustomerName, int Rating, string Snippet, int WaitingHours, string Priority);
    private record MetricSummary(int ResponseRate, int PreviousRate, int AvgTimeMinutes, int PreviousAvgTime, int StreakDays, int TotalResponded, int TotalReceived, int PendingCount, int SlaTarget);
    private record SidebarSection(string Key, string Label, string IconName, int? Count);
    private record PriorityBadgeInfo(string Label, string ClassName);

    private static readonly MetricSummary _metrics = new(92, 87, 142, 168, 17, 505, 549, 44, 95);

    private static readonly Agent[] _agents =
    [
        new("a1", "Emily Chen", "EC", 142, 72, 98, "up", "12 min ago"),
        new("a2", "Marcus Johnson", "MJ", 118, 144, 94, "stable", "1h ago"),
        new("a3", "Sofia Reyes", "SR", 97, 108, 96, "up", "28 min ago"),
        new("a4", "David Park", "DP", 85, 186, 88, "down", "3h ago"),
        new("a5", "Aisha Williams", "AW", 63, 276, 79, "down", "5h ago"),
    ];

    private static readonly PendingReview[] _pendingReviews =
    [
        new("p1", "Tomoko Sato", 1, "Extremely disappointed with the product quality. The stitching came undone after...", 18, "critical"),
        new("p2", "Marcus Webb", 2, "Shipping took much longer than expected and the box was damaged upon arrival...", 12, "high"),
        new("p3", "Elena Rodriguez", 3, "Product works fine but the color is noticeably different from what was shown in...", 8, "high"),
        new("p4", "James Okafor", 4, "Great product overall. My only minor complaint is the instruction manual could be...", 4, "normal"),
        new("p5", "Priya Sharma", 2, "The battery life is significantly shorter than advertised. I get about half of...", 6, "high"),
    ];

    private readonly SidebarSection[] _sidebarSections;

    private string _activeSection = "overview";

    private int _rateDelta => _metrics.ResponseRate - _metrics.PreviousRate;
    private int _timeDelta => _metrics.PreviousAvgTime - _metrics.AvgTimeMinutes;
    private int _slaGap => _metrics.SlaTarget - _metrics.ResponseRate;

    public ReviewsResponseRatePanel()
    {
        _sidebarSections =
        [
            new("overview", "Overview", "check-circle-2", null),
            new("agents", "Team", "users", _agents.Length),
            new("pending", "Pending", "inbox", _metrics.PendingCount),
        ];
    }

    private static string FormatTime(int minutes)
    {
        if (minutes < 60) return $"{minutes}m";
        var h = minutes / 60;
        var m = minutes % 60;
        return m > 0 ? $"{h}h {m}m" : $"{h}h";
    }

    private static string RateColor(int rate)
    {
        if (rate >= 95) return "text-emerald-600 dark:text-emerald-400";
        if (rate >= 85) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string RateDotColor(int rate)
    {
        if (rate >= 95) return "bg-emerald-500";
        if (rate >= 85) return "bg-amber-500";
        return "bg-red-500";
    }

    private static string TimeColor(int minutes)
    {
        if (minutes <= 120) return "text-emerald-600 dark:text-emerald-400";
        if (minutes <= 240) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static PriorityBadgeInfo PriorityBadge(string priority) => priority switch
    {
        "critical" => new("Critical", "bg-red-500/10 text-red-700 dark:text-red-400"),
        "high" => new("High", "bg-amber-500/10 text-amber-700 dark:text-amber-400"),
        _ => new("Normal", "bg-muted text-muted-foreground"),
    };
}
