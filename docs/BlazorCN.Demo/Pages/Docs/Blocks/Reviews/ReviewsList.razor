@* ========================================
   Block: reviews-list
   Title: Reviews List
   Description: Compact review list component with filtering and sorting for admin dashboards
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, CardCn, CardContentCn, CardHeaderCn, CardTitleCn, DropdownMenuCn, DropdownMenuContentCn, DropdownMenuItemCn, DropdownMenuTriggerCn, TabsCn, TabsListCn, TabsTriggerCn, LucideArrowDownUpCn, LucideStarCn
   Source: original/blocks/reviews/reviews-list.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Review List</h1>
    </div>

    <div class="mx-auto w-[900px] max-w-full">
        <CardCn>
            <CardHeaderCn Class="flex-row items-center justify-between space-y-0">
                <CardTitleCn Class="text-base">@_filteredReviews.Length Reviews</CardTitleCn>
                <div class="flex items-center gap-2">
                    <TabsCn Value="@_filter" ValueChanged="@((string v) => _filter = v)">
                        <TabsListCn Class="h-8 w-[200px]">
                            <TabsTriggerCn Class="text-xs" Value="all">All</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="5">5★</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="4">4★</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="3">3★</TabsTriggerCn>
                        </TabsListCn>
                    </TabsCn>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm h-8" data-variant="outline" data-size="sm">
                                <LucideArrowDownUpCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                                Sort
                            </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            @foreach (var option in _sortOptions)
                            {
                                <DropdownMenuItemCn OnClick="@(() => _sort = option.Value)">
                                    @option.Label
                                </DropdownMenuItemCn>
                            }
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            </CardHeaderCn>
            <CardContentCn Class="p-0">
                <div class="divide-y">
                    @foreach (var review in _filteredReviews)
                    {
                        <div class="flex items-start gap-3 px-6 py-4">
                            <AvatarCn Class="h-8 w-8">
                                <AvatarFallbackCn Class="text-xs">@review.Initials</AvatarFallbackCn>
                            </AvatarCn>

                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@review.Author</span>
                                        @if (review.Status == "pending")
                                        {
                                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Pending</BadgeCn>
                                        }
                                    </div>
                                    <div class="flex items-center gap-1">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <LucideStarCn Class="@Cn.Merge("h-3 w-3", star <= review.Rating ? "fill-primary text-primary" : "fill-muted text-muted-foreground")" Size="12" />
                                        }
                                    </div>
                                </div>

                                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">
                                    @review.Content
                                </p>

                                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@review.Product</span>
                                    <span>·</span>
                                    <span>@review.Date</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (_filteredReviews.Length == 0)
                {
                    <div class="py-12 text-center">
                        <p class="text-sm text-muted-foreground">No reviews match your filters</p>
                    </div>
                }
            </CardContentCn>
        </CardCn>

        @if (_filteredReviews.Length > 0)
        {
            <div class="mt-4 text-center">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Load More</ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record ReviewItem(int Id, string Author, string Initials, int Rating, string Date, string Content, string Product, string Status);
    private record SortOption(string Value, string Label);

    private static readonly ReviewItem[] _reviews =
    [
        new(1, "Emma Richardson", "ER", 5, "Dec 5, 2024", "Absolutely love this product! The quality exceeded my expectations and shipping was incredibly fast.", "Wireless Earbuds Pro", "published"),
        new(2, "James Cooper", "JC", 4, "Dec 4, 2024", "Great value for the price. Minor issue with packaging but the product itself works perfectly.", "Smart Watch Elite", "published"),
        new(3, "Olivia Martinez", "OM", 5, "Dec 3, 2024", "This is exactly what I was looking for. Premium feel and excellent build quality.", "Laptop Stand Adjustable", "pending"),
        new(4, "William Chen", "WC", 3, "Dec 2, 2024", "Decent product but took longer to arrive than expected. Works as described but nothing extraordinary.", "USB-C Hub 7-in-1", "published"),
        new(5, "Sophia Taylor", "ST", 5, "Dec 1, 2024", "Perfect gift for my husband! He uses it daily and loves it. The design is sleek and modern.", "Wireless Earbuds Pro", "published"),
    ];

    private static readonly SortOption[] _sortOptions =
    [
        new("newest", "Newest first"),
        new("oldest", "Oldest first"),
        new("highest", "Highest rated"),
        new("lowest", "Lowest rated"),
    ];

    private string _filter = "all";
    private string _sort = "newest";

    private ReviewItem[] _filteredReviews
    {
        get
        {
            var filtered = _filter == "all"
                ? _reviews
                : _reviews.Where(r => r.Rating == int.Parse(_filter)).ToArray();

            return _sort switch
            {
                "oldest" => filtered.OrderBy(r => r.Id).ToArray(),
                "highest" => filtered.OrderByDescending(r => r.Rating).ToArray(),
                "lowest" => filtered.OrderBy(r => r.Rating).ToArray(),
                _ => filtered.OrderByDescending(r => r.Id).ToArray(),
            };
        }
    }
}
