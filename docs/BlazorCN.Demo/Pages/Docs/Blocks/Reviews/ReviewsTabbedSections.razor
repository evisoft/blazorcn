@* ============================================================
   Block: reviews-tabbed-sections
   Title: ReviewsTabbedSections
   Description: A tabbed review organization block for React and Next.js with animated content transitions between Most Recent, Most Helpful, Highest Rated, Lowest Rated, and With Photos tabs using shadcn/ui Avatar, Badge, and Tabs components and Tailwind CSS.
   Source: original/blocks/reviews/reviews-tabbed-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with summary *@
        <div class="px-4 py-3.5">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Customer Reviews</span>
                    <div class="mt-1 flex items-center gap-2">
                        <div class="flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                int idx = i;
                                <LucideStarCn Size="14" Class="@Cn.Merge("size-3.5", idx < (int)Math.Round(double.Parse(_overallRating)) ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                            }
                        </div>
                        <span class="text-sm font-medium tabular-nums">@_overallRating</span>
                        <span class="text-xs text-muted-foreground">
                            based on @_totalReviews reviews
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="h-px bg-border"></div>

        @* Tab bar *@
        <div class="flex items-center gap-0.5 overflow-x-auto px-3 py-2">
            @foreach (var tab in _tabs)
            {
                var t = tab;
                var count = _reviews.Count(r => t.Filter(r));
                var isActive = _activeTab == t.Key;
                <button
                    type="button"
                    @onclick="@(() => _activeTab = t.Key)"
                    class="@Cn.Merge("flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs transition-colors", isActive ? "bg-foreground font-medium text-background" : "text-muted-foreground hover:bg-muted/50")">
                    <LucideIconCn Name="@t.IconName" Size="12" Class="size-3" />
                    <span>@t.Label</span>
                    <span class="@Cn.Merge("tabular-nums", isActive ? "text-background/70" : "text-muted-foreground/50")">
                        @count
                    </span>
                </button>
            }
        </div>

        <div class="h-px bg-border"></div>

        @* Review list *@
        <div class="min-h-[300px]">
            @{
                var currentTab = _tabs.FirstOrDefault(t => t.Key == _activeTab) ?? _tabs[0];
                var filtered = _reviews.Where(r => currentTab.Filter(r)).OrderBy(r => r, currentTab.Comparer).ToList();
            }
            @if (filtered.Count == 0)
            {
                <div class="flex flex-col items-center justify-center px-4 py-12 text-center">
                    <span class="text-sm text-muted-foreground">
                        No reviews match this filter.
                    </span>
                </div>
            }
            else
            {
                @for (int ri = 0; ri < filtered.Count; ri++)
                {
                    var review = filtered[ri];
                    var isLast = ri == filtered.Count - 1;
                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <div class="px-4 py-3.5">
                            @* Author row *@
                            <div class="flex items-start gap-3">
                                <AvatarCn Class="size-8">
                                    <AvatarFallbackCn Class="text-xs">@review.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@review.Author</span>
                                        @if (review.Verified)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                                Verified
                                            </BadgeCn>
                                        }
                                        <span class="ml-auto text-xs text-muted-foreground">
                                            @review.Date
                                        </span>
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-2">
                                        <div class="flex items-center gap-0.5">
                                            @for (int si = 0; si < 5; si++)
                                            {
                                                int starIdx = si;
                                                int rating = review.Rating;
                                                <LucideStarCn Size="12" Class="@Cn.Merge("size-3", starIdx < rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                            }
                                        </div>
                                        <span class="text-[10px] text-muted-foreground">
                                            @review.PurchaseType
                                        </span>
                                    </div>
                                </div>
                            </div>

                            @* Title and body *@
                            <div class="mt-2.5">
                                <p class="text-sm font-medium">@review.Title</p>
                                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                    @review.Body
                                </p>
                            </div>

                            @* Photo indicators *@
                            @if (review.Photos.Length > 0)
                            {
                                <div class="mt-2.5 flex items-center gap-2">
                                    @foreach (var photo in review.Photos)
                                    {
                                        <div class="flex items-center gap-1.5 rounded-md border bg-muted/30 px-2 py-1">
                                            <LucideCameraCn Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="text-[10px] text-muted-foreground">
                                                @photo.Alt
                                            </span>
                                        </div>
                                    }
                                </div>
                            }

                            @* Helpful votes *@
                            <div class="mt-2.5 flex items-center gap-3">
                                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <LucideThumbsUpCn Size="12" Class="size-3" />
                                    <span class="tabular-nums">@review.HelpfulUp</span>
                                </div>
                                @if (review.HelpfulDown > 0)
                                {
                                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                        <LucideThumbsDownCn Size="12" Class="size-3" />
                                        <span class="tabular-nums">@review.HelpfulDown</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            @{
                var footerTab = _tabs.FirstOrDefault(t => t.Key == _activeTab) ?? _tabs[0];
                var footerFiltered = _reviews.Count(r => footerTab.Filter(r));
                var verifiedCount = _reviews.Count(r => r.Verified);
            }
            <div class="flex items-center justify-between text-[10px] text-muted-foreground">
                <span>
                    Showing @footerFiltered of @_totalReviews reviews
                </span>
                <span>@verifiedCount verified purchases</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewPhoto(string Alt, string Placeholder);

    private record Review(
        string Id,
        string Author,
        string Initials,
        int Rating,
        string Date,
        int DaysAgo,
        string Title,
        string Body,
        int HelpfulUp,
        int HelpfulDown,
        bool Verified,
        ReviewPhoto[] Photos,
        string PurchaseType
    );

    private class TabDef
    {
        public string Key { get; init; } = "";
        public string Label { get; init; } = "";
        public string IconName { get; init; } = "";
        public Func<Review, bool> Filter { get; init; } = _ => true;
        public IComparer<Review> Comparer { get; init; } = Comparer<Review>.Create((a, b) => 0);
    }

    private static readonly Review[] _reviews =
