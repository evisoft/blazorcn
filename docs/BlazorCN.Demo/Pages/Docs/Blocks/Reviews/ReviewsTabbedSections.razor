            "Individual License"),
        new("r8", "Leo Fernandez", "LF", 3, "Feb 28, 2026", 30,
            "Decent but pricing feels steep",
            "The product itself works as advertised. No major bugs. But for a team of 5, the monthly cost adds up quickly compared to open-source alternatives. If pricing were more competitive, this would be an easy recommendation.",
            22, 6, true,
            [],
            "Team License"),
    ];

    private readonly TabDef[] _tabs =
    [
        new TabDef
        {
            Key = "recent",
            Label = "Most Recent",
            IconName = "clock",
            Filter = _ => true,
            Comparer = Comparer<Review>.Create((a, b) => a.DaysAgo.CompareTo(b.DaysAgo)),
        },
        new TabDef
        {
            Key = "helpful",
            Label = "Most Helpful",
            IconName = "trending-up",
            Filter = _ => true,
            Comparer = Comparer<Review>.Create((a, b) => b.HelpfulUp.CompareTo(a.HelpfulUp)),
        },
        new TabDef
        {
            Key = "highest",
            Label = "Highest Rated",
            IconName = "sparkles",
            Filter = r => r.Rating >= 4,
            Comparer = Comparer<Review>.Create((a, b) => b.Rating != a.Rating ? b.Rating.CompareTo(a.Rating) : b.HelpfulUp.CompareTo(a.HelpfulUp)),
        },
        new TabDef
        {
            Key = "lowest",
            Label = "Lowest Rated",
            IconName = "thumbs-down",
            Filter = r => r.Rating <= 3,
            Comparer = Comparer<Review>.Create((a, b) => a.Rating != b.Rating ? a.Rating.CompareTo(b.Rating) : b.HelpfulUp.CompareTo(a.HelpfulUp)),
        },
        new TabDef
        {
            Key = "photos",
            Label = "With Photos",
            IconName = "image",
            Filter = r => r.Photos.Length > 0,
            Comparer = Comparer<Review>.Create((a, b) => a.DaysAgo.CompareTo(b.DaysAgo)),
        },
    ];

    private string _activeTab = "recent";

    private static readonly string _overallRating =
        (_reviews.Average(r => r.Rating)).ToString("F1");

    private static readonly int _totalReviews = _reviews.Length;
}
