@* ========================================
   Block: reviews-travel
   Title: Reviews Travel
   Description: Hotel-style travel review component with stay details and highlights for React booking platforms
   Long Description: Translated review card with language toggle and host response for React global marketplaces
   Dependencies: LucideBuildingCn, LucideCalendarCn, LucideMapPinCn, LucideThumbsDownCn, LucideThumbsUpCn, LucideUsersCn
   Source: original/blocks/reviews/reviews-travel.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Guest Review</h1>
    </div>

    <div class="mx-auto w-[800px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-0">
                <div class="flex flex-col md:flex-row">
                    @* Sidebar - Reviewer Info *@
                    <div class="border-b p-6 md:w-64 md:border-b-0 md:border-r">
                        <div class="mb-4 flex items-center gap-3">
                            <AvatarCn Class="h-12 w-12">
                                <AvatarImageCn Alt="Maria Lopez" Src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80" />
                                <AvatarFallbackCn>ML</AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class="font-semibold">Maria Lopez</p>
                                <div class="flex items-center gap-1 text-sm text-muted-foreground">
                                    <LucideMapPinCn Class="h-3 w-3" Size="12" />
                                    Spain
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3 text-sm">
                            <div class="flex items-center gap-2">
                                <LucideBuildingCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <span>Deluxe Ocean View Suite</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <LucideCalendarCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <span>7 nights</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <LucideUsersCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <span>Couple traveler</span>
                            </div>
                            <p class="text-muted-foreground">May 12, 2024</p>
                        </div>
                    </div>

                    @* Main Content *@
                    <div class="flex-1 p-6">
                        @* Header with Score *@
                        <div class="mb-4 flex items-start justify-between gap-4">
                            <h2 class="text-xl font-semibold">Amazing view, excellent service</h2>
                            <div class="@Cn.Merge("shrink-0 rounded-tl-lg rounded-tr-lg rounded-br-lg px-3 py-1.5 text-xl font-bold", _scoreColor)">
                                @_score.ToString("F1")
                            </div>
                        </div>

                        @* Highlights *@
                        <div class="mb-4 space-y-2">
                            <div class="flex items-start gap-3 rounded-lg border p-3">
                                <LucideThumbsUpCn Class="mt-0.5 h-4 w-4 shrink-0 text-primary" Size="16" />
                                <p class="text-sm">Breathtaking ocean views and incredibly attentive staff</p>
                            </div>
                            <div class="flex items-start gap-3 rounded-lg border p-3">
                                <LucideThumbsDownCn Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                                <p class="text-sm">Bathroom could use an update, shower pressure was weak</p>
                            </div>
                        </div>

                        @* Content *@
                        <p class="@Cn.Merge("text-muted-foreground", _isExpanded ? "" : "line-clamp-3")">
                            We stayed for a week in the Deluxe Ocean View Suite and were blown away by the panoramic views. Waking up to the sound of waves every morning was therapeutic. The staff went above and beyond, especially the concierge who helped us book local experiences. The room was spacious and the bed comfortable, though the bathroom fixtures showed signs of age. The breakfast buffet offered excellent variety and the rooftop pool area was never too crowded. Would definitely return, but would request a recently renovated room next time.
                        </p>

                        <ButtonCn Class="mt-2 h-auto p-0" Variant="ButtonVariant.Link"
                                  @onclick="@(() => _isExpanded = !_isExpanded)">
                            @(_isExpanded ? "Show less" : "Read more")
                        </ButtonCn>

                        <SeparatorCn Class="my-4" />

                        @* Helpful *@
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-muted-foreground">Was this review helpful?</p>
                            <div class="flex gap-2">
                                <ButtonCn Class="h-8" Size="ButtonSize.Sm"
                                          Variant="@(_helpful == "yes" ? ButtonVariant.Default : ButtonVariant.Outline)"
                                          @onclick="@(() => _helpful = _helpful == "yes" ? null : "yes")">
                                    <LucideThumbsUpCn Class="mr-1 h-3 w-3" Size="12" />
                                    Yes
                                </ButtonCn>
                                <ButtonCn Class="h-8" Size="ButtonSize.Sm"
                                          Variant="@(_helpful == "no" ? ButtonVariant.Default : ButtonVariant.Outline)"
                                          @onclick="@(() => _helpful = _helpful == "no" ? null : "no")">
                                    <LucideThumbsDownCn Class="mr-1 h-3 w-3" Size="12" />
                                    No
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private const double _score = 8.5;
    private bool _isExpanded;
    private string? _helpful;

    private static string _scoreColor => _score >= 9
        ? "bg-primary text-primary-foreground"
        : _score >= 7
            ? "bg-primary/80 text-primary-foreground"
            : _score >= 5
                ? "bg-muted text-muted-foreground"
                : "bg-destructive text-destructive-foreground";
}
