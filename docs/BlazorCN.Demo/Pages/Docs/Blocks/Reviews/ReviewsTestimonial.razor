@* ========================================
   Block: reviews-testimonial
   Title: Reviews Testimonial
   Description: Testimonial carousel component with customer quotes and navigation for landing pages
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, CardCn, CardContentCn, LucideChevronLeftCn, LucideChevronRightCn, LucideQuoteCn
   Source: original/blocks/reviews/reviews-testimonial.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">What People Say</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-8">
                @* Quote Icon *@
                <div class="mb-6 flex justify-center">
                    <LucideQuoteCn Size="40" Class="text-muted-foreground/30" />
                </div>

                @* Quote Text *@
                <blockquote class="mb-8 text-center text-xl font-medium leading-relaxed">
                    "@CurrentTestimonial.Quote"
                </blockquote>

                @* Author *@
                <div class="flex flex-col items-center">
                    <AvatarCn Class="mb-3 h-14 w-14">
                        <AvatarImageCn Alt="@CurrentTestimonial.Author" Src="@CurrentTestimonial.Avatar" />
                        <AvatarFallbackCn>@GetInitials(CurrentTestimonial.Author)</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="text-center">
                        <p class="font-semibold">@CurrentTestimonial.Author</p>
                        <p class="text-sm text-muted-foreground">
                            @CurrentTestimonial.Role, @CurrentTestimonial.Company
                        </p>
                    </div>
                </div>

                @* Navigation *@
                <div class="mt-8 flex items-center justify-center gap-4">
                    <ButtonCn Class="h-9 w-9" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="GoToPrev" aria-label="Previous">
                        <LucideChevronLeftCn Size="16" />
                    </ButtonCn>

                    @* Dots *@
                    <div class="flex items-center gap-2">
                        @for (int i = 0; i < _testimonials.Length; i++)
                        {
                            var index = i;
                            <button type="button" class="@Cn.Merge("h-2 w-2 rounded-full border transition-colors", index == _activeIndex ? "bg-primary border-primary" : "bg-background border-border")" @onclick="() => _activeIndex = index" aria-label="@($"Go to testimonial {index + 1}")"></button>
                        }
                    </div>

                    <ButtonCn Class="h-9 w-9" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="GoToNext" aria-label="Next">
                        <LucideChevronRightCn Size="16" />
                    </ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record TestimonialItem(int Id, string Quote, string Author, string Role, string Company, string Avatar);

    private int _activeIndex;
    private TestimonialItem CurrentTestimonial => _testimonials[_activeIndex];

    private static string GetInitials(string name) => string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private void GoToNext() => _activeIndex = (_activeIndex + 1) % _testimonials.Length;
    private void GoToPrev() => _activeIndex = (_activeIndex - 1 + _testimonials.Length) % _testimonials.Length;

    private readonly TestimonialItem[] _testimonials =
    [
        new(1, "This product completely transformed how our team works. The efficiency gains have been remarkable and the support team is incredibly responsive.", "Sarah Mitchell", "Head of Operations", "TechFlow Inc.", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=100&q=80"),
        new(2, "We evaluated dozens of solutions before choosing this one. Six months later, it's clear we made the right decision. Our productivity has increased by 40%.", "Michael Torres", "CTO", "Innovate Labs", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80"),
        new(3, "The attention to detail is what sets this apart. Every feature feels thoughtfully designed and the user experience is exceptional.", "Emily Zhang", "Product Manager", "DesignCraft", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&w=100&q=80"),
        new(4, "Implementation was seamless and the ROI was evident within the first month. I recommend this to every business owner I meet.", "James Anderson", "Founder", "Growth Partners", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&w=100&q=80"),
    ];
}
