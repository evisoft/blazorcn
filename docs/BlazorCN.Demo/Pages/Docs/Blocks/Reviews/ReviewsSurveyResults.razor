@* ============================================================
   Block: reviews-survey-results
   Title: ReviewsSurveyResults
   Description: A post-purchase survey results dashboard for React and Next.js with NPS scoring, response distribution bars, completion rate tracking, and question-level breakdowns built with shadcn/ui Progress and Badge components and Tailwind CSS.
   Source: original/blocks/reviews/reviews-survey-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-5 py-3.5">
            <div>
                <span class="text-sm font-medium">@_meta.Title</span>
                <p class="mt-0.5 text-xs text-muted-foreground">@_meta.Period</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                @_questions.Length questions
            </BadgeCn>
        </div>

        @* Split panel: overview + questions *@
        <div class="grid grid-cols-1 md:grid-cols-[280px_1fr]">

            @* Left overview panel *@
            <div class="border-b md:border-b-0 md:border-r">
                <div class="p-5">

                    @* NPS Score *@
                    <div class="flex flex-col items-center rounded-lg border bg-muted/30 p-4">
                        <span class="text-xs font-medium text-muted-foreground">
                            Net Promoter Score
                        </span>
                        <span class="@($"mt-1 text-3xl font-semibold tabular-nums {NpsColor(_meta.NpsScore)}")">
                            @_meta.NpsScore
                        </span>
                        <div class="mt-2 flex items-center gap-3 text-[10px] text-muted-foreground">
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                @_meta.NpsPromoters promoters
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                                @_meta.NpsPassives passive
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-red-500"></span>
                                @_meta.NpsDetractors detractors
                            </span>
                        </div>
                    </div>

                    <SeparatorCn Class="my-4" />

                    @* Metrics *@
                    <div class="space-y-4">
                        <div>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">Completion rate</span>
                                </div>
                                <span class="text-xs font-medium tabular-nums">@_completionRate%</span>
                            </div>
                            <ProgressCn Value="@_completionRate" Class="mt-1.5 h-1.5" />
                            <p class="mt-1 text-[10px] text-muted-foreground">
                                @_meta.TotalCompleted.ToString("N0") of @_meta.TotalInvited.ToString("N0") invited
                            </p>
                        </div>

                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">Avg. completion</span>
                            </div>
                            <span class="text-xs font-medium tabular-nums">
                                @_meta.AvgCompletionTime
                            </span>
                        </div>

                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">Total responses</span>
                            </div>
                            <span class="text-xs font-medium tabular-nums">
                                @_meta.TotalCompleted.ToString("N0")
                            </span>
                        </div>

                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">Response trend</span>
                            </div>
                            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                                +12% vs Q4
                            </span>
                        </div>
                    </div>

                </div>
            </div>

            @* Right questions panel *@
            <div>
                <div class="border-b px-4 py-2.5">
                    <span class="text-xs font-medium text-muted-foreground">Question breakdown</span>
                </div>
                <div class="max-h-[440px] overflow-y-auto">
                    @for (var qi = 0; qi < _questions.Length; qi++)
                    {
                        var q = _questions[qi];
                        var idx = qi;
                        var isExpanded = _expandedId == q.Id;
                        var maxCount = q.Options.Max(o => o.Count);
                        var positiveCount = q.Options.Where(o => o.Sentiment == "positive").Sum(o => o.Count);
                        var positivePct = (int)Math.Round((double)positiveCount / q.TotalResponses * 100);
                        var isLast = idx == _questions.Length - 1;
                        var positivePctColor = positivePct >= 60
                            ? "text-emerald-600 dark:text-emerald-400"
                            : positivePct >= 40
                                ? "text-amber-600 dark:text-amber-400"
                                : "text-red-600 dark:text-red-400";

                        <div class="@(isLast ? "" : "border-b")">
                            <button type="button"
                                    @onclick="@(() => ToggleExpanded(q.Id))"
                                    class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded bg-muted text-[10px] font-medium tabular-nums text-muted-foreground">
                                    @(idx + 1)
                                </span>
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium leading-snug">@q.Question</span>
                                    <div class="mt-1 flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                            @TypeLabel(q.Type)
                                        </BadgeCn>
                                        <span class="text-[10px] tabular-nums text-muted-foreground">
                                            @q.TotalResponses.ToString("N0") responses
                                        </span>
                                        <span class="text-[10px] text-muted-foreground">&middot;</span>
                                        <span class="@($"text-[10px] font-medium tabular-nums {positivePctColor}")">
                                            @positivePct% positive
                                        </span>
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-down" Size="16" Class="@($"mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-180" : "")}")" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="overflow-hidden">
                                    <div class="px-4 pb-4 pt-0">
                                        <div class="ml-8 space-y-2">
                                            @foreach (var opt in q.Options)
                                            {
                                                var pct = (int)Math.Round((double)opt.Count / q.TotalResponses * 100);
                                                var barWidth = (double)opt.Count / maxCount * 100;
                                                var barClass = SentimentColorClass(opt.Sentiment);

                                                <div class="flex items-center gap-3">
                                                    <span class="w-28 shrink-0 truncate text-xs text-muted-foreground">
                                                        @opt.Label
                                                    </span>
                                                    <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted">
                                                        <div class="@($"h-full rounded-full {barClass}")"
                                                             style="@($"width:{barWidth:F1}%")">
                                                        </div>
                                                    </div>
                                                    <span class="w-8 shrink-0 text-right font-mono text-xs tabular-nums text-muted-foreground">
                                                        @pct%
                                                    </span>
                                                    <span class="w-12 shrink-0 text-right text-[10px] tabular-nums text-muted-foreground">
                                                        @opt.Count.ToString("N0")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-5 py-2.5">
            <span class="text-[10px] text-muted-foreground">Last updated Mar 31, 2026</span>
            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Positive
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Neutral
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Negative
                </span>
            </div>
        </div>

    </div>
</section>

@code {
    private record ResponseOption(string Label, int Count, string Sentiment);
    private record SurveyQuestion(string Id, string Question, string Type, int TotalResponses, ResponseOption[] Options);
    private record SurveyMeta(string Title, string Period, int TotalInvited, int TotalCompleted, int NpsScore, int NpsPromoters, int NpsPassives, int NpsDetractors, string AvgCompletionTime);

    private static readonly SurveyMeta _meta = new(
        Title: "Q1 2026 Post-Purchase Survey",
        Period: "Jan 1 - Mar 31, 2026",
        TotalInvited: 4280,
        TotalCompleted: 2847,
        NpsScore: 42,
        NpsPromoters: 1368,
        NpsPassives: 824,
        NpsDetractors: 655,
        AvgCompletionTime: "3m 24s"
    );

    private static readonly SurveyQuestion[] _questions =
    [
        new("sq1", "How would you rate the overall product quality?", "likert", 2847,
        [
            new("Excellent",      1139, "positive"),
            new("Good",            826, "positive"),
            new("Average",         455, "neutral"),
            new("Below average",   285, "negative"),
            new("Poor",            142, "negative"),
        ]),
        new("sq2", "How satisfied are you with the delivery and packaging experience?", "csat", 2801,
        [
            new("Very satisfied",     952, "positive"),
            new("Satisfied",          868, "positive"),
            new("Neutral",            504, "neutral"),
            new("Dissatisfied",       312, "negative"),
            new("Very dissatisfied",  165, "negative"),
        ]),
        new("sq3", "How likely are you to recommend our product to a colleague or friend?", "nps", 2847,
        [
            new("Promoter (9-10)",  1368, "positive"),
            new("Passive (7-8)",     824, "neutral"),
            new("Detractor (0-6)",   655, "negative"),
        ]),
        new("sq4", "How would you rate the value for money compared to alternatives?", "likert", 2793,
        [
            new("Excellent value",  725, "positive"),
            new("Good value",       864, "positive"),
            new("Fair",             642, "neutral"),
            new("Overpriced",       389, "negative"),
            new("Very overpriced",  173, "negative"),
        ]),
        new("sq5", "How easy was it to set up and start using the product after purchase?", "csat", 2756,
        [
            new("Very easy",      992, "positive"),
            new("Easy",           798, "positive"),
            new("Moderate",       524, "neutral"),
            new("Difficult",      298, "negative"),
            new("Very difficult", 144, "negative"),
        ]),
        new("sq6", "How responsive and helpful was our customer support team when needed?", "csat", 1892,
        [
            new("Excellent",      568, "positive"),
            new("Good",           524, "positive"),
            new("Average",        412, "neutral"),
            new("Below average",  248, "negative"),
            new("Poor",           140, "negative"),
        ]),
    ];

    private static readonly int _completionRate = (int)Math.Round((double)_meta.TotalCompleted / _meta.TotalInvited * 100);

    private string _expandedId = "sq1";

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? string.Empty : id;
    }

    private static string SentimentColorClass(string sentiment) => sentiment switch
    {
        "positive" => "bg-emerald-500/70",
        "neutral"  => "bg-amber-500/70",
        _          => "bg-red-500/70",
    };

    private static string NpsColor(int score) =>
        score >= 50
            ? "text-emerald-600 dark:text-emerald-400"
            : score >= 0
                ? "text-amber-600 dark:text-amber-400"
                : "text-red-600 dark:text-red-400";

    private static string TypeLabel(string type) => type switch
    {
        "nps"  => "NPS",
        "csat" => "CSAT",
        _      => "Likert",
    };
}
