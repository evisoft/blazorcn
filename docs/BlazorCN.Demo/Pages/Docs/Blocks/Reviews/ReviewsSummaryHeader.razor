@* ============================================================
   Block: reviews-summary-header
   Title: ReviewsSummaryHeader
   Description: A hero-style review summary header block for React and Next.js with large rating display, animated star distribution, key satisfaction metrics, category breakdown, and write-review CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-summary-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Top bar *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Customer Reviews</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_totalReviews.ToString("N0") reviews
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px]">
                    @_totalVerified.ToString("N0") verified
                </BadgeCn>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="pen-line" Size="12" Class="size-3" />
                Write a review
            </ButtonCn>
        </div>

        @* Main hero section *@
        <div class="grid grid-cols-1 divide-y md:grid-cols-[200px_1fr_200px] md:divide-x md:divide-y-0">
            @* Left: big rating *@
            <div class="flex flex-col items-center justify-center px-4 py-6">
                <span class="@($"font-semibold text-4xl tabular-nums {GetRatingColor(_averageRating)}")">
                    @_averageRating
                </span>
                <div class="mt-1.5 flex items-center gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="16" Class="@($"size-4 {(idx < (int)Math.Round(_averageRating) ? "fill-foreground text-foreground" : "text-muted-foreground/30")}")" />
                    }
                </div>
                <span class="mt-1 text-muted-foreground text-xs">
                    @_totalReviews.ToString("N0") reviews
                </span>
                <div class="mt-2 flex items-center gap-1 text-emerald-600">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    <span class="text-xs tabular-nums">+0.2 this month</span>
                </div>
            </div>

            @* Center: distribution + categories *@
            <div class="flex flex-col divide-y">
                @* Distribution bars *@
                <div class="px-4 py-4">
                    <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                        Rating distribution
                    </span>
                    <div class="space-y-1.5">
                        @foreach (var d in _distribution)
                        {
                            var barPercent = (int)Math.Round((double)d.Count / _maxCount * 100);
                            var sharePercent = (int)Math.Round((double)d.Count / _totalReviews * 100);
                            <div class="flex items-center gap-2">
                                <span class="flex w-8 shrink-0 items-center gap-0.5 text-xs tabular-nums">
                                    @d.Stars
                                    <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-foreground text-foreground" />
                                </span>
                                <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/60" style="@($"width:{barPercent}%")"></div>
                                </div>
                                <span class="w-8 shrink-0 text-right font-mono text-muted-foreground text-[10px] tabular-nums">
                                    @(sharePercent)%
                                </span>
                                <span class="w-12 shrink-0 text-right text-muted-foreground text-[10px] tabular-nums">
                                    @d.Count.ToString("N0")
                                </span>
                            </div>
                        }
                    </div>
                </div>

                @* Category scores *@
                <div class="px-4 py-4">
                    <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                        Category scores
                    </span>
                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                        @foreach (var cat in _categoryScores)
                        {
                            var catScore = cat.Score;
                            <div class="flex items-center gap-2">
                                <span class="w-28 shrink-0 text-xs">@cat.Name</span>
                                <div class="relative h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/50" style="@($"width:{(catScore / 5.0) * 100:F0}%")"></div>
                                </div>
                                <span class="@($"w-6 shrink-0 text-right text-xs tabular-nums {GetRatingColor(catScore)}")">
                                    @catScore
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Right: satisfaction metrics *@
            <div class="flex flex-col divide-y">
                @foreach (var metric in _satisfactionMetrics)
                {
                    <div class="flex flex-1 flex-col justify-center px-4 py-3">
                        <span class="font-semibold text-lg tabular-nums">@metric.Value</span>
                        <span class="font-medium text-xs">@metric.Label</span>
                        <span class="text-muted-foreground text-[10px]">@metric.Description</span>
                    </div>
                }
            </div>
        </div>

        @* Bottom summary bar *@
        <div class="flex items-center gap-3 border-t bg-muted/30 px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_recommendPercent% of reviewers recommend this product
            </span>
            <div class="w-px bg-border h-3"></div>
            <span class="text-muted-foreground text-xs">
                @_totalVerified.ToString("N0") verified purchases
            </span>
            <div class="w-px bg-border h-3"></div>
            <span class="text-muted-foreground text-xs">Updated daily</span>
        </div>
    </div>
</section>

@code {
    private record StarDistribution(int Stars, int Count);
    private record SatisfactionMetric(string Label, string Value, string Description);
    private record CategoryScore(string Name, double Score);

    private const double _averageRating = 4.6;
    private const int _totalReviews = 3841;
    private const int _totalVerified = 3247;
    private const int _recommendPercent = 94;

    private static readonly StarDistribution[] _distribution =
    [
        new(5, 2106),
        new(4, 987),
        new(3, 412),
        new(2, 218),
        new(1, 118),
    ];

    private static readonly int _maxCount = 2106;

    private static readonly SatisfactionMetric[] _satisfactionMetrics =
    [
        new("Would recommend", "94%", "of verified buyers"),
        new("Repeat purchase", "87%", "bought again within 6mo"),
        new("Support rating", "4.8", "out of 5 for support quality"),
        new("Response time", "2h", "avg response to reviews"),
    ];

    private static readonly CategoryScore[] _categoryScores =
    [
        new("Ease of use", 4.8),
        new("Documentation", 4.7),
        new("Performance", 4.6),
        new("Value for money", 4.4),
        new("Customer support", 4.3),
    ];

    private static string GetRatingColor(double score)
    {
        if (score >= 4.5) return "text-emerald-600";
        if (score >= 3.5) return "text-foreground";
        return "text-amber-600";
    }
}
