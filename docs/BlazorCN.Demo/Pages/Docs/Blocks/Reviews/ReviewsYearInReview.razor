@* ============================================================
   Block: reviews-year-in-review
   Title: ReviewsYearInReview
   Description: An annual review recap dashboard for React and Next.js with bento grid layout, monthly rating trends, milestone achievements, top reviews, and community stats built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-year-in-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-5 py-3">
            <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">@_year Year in Review</span>
                <p class="text-xs text-muted-foreground">
                    Annual review performance summary and highlights
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                @_keyMetrics.TotalReviews.ToString("N0") reviews
            </BadgeCn>
        </div>

        @* Bento grid: key metrics *@
        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            @foreach (var metric in _metrics)
            {
                var m = metric;
                <div class="@m.CellClass px-5 py-3">
                    <span class="text-[10px] text-muted-foreground">@m.Label</span>
                    <div class="mt-1 flex items-baseline gap-1.5">
                        @if (m.Star)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                        }
                        <span class="text-xl font-semibold tabular-nums">@m.Value</span>
                        <span class="flex items-center gap-0.5 text-xs text-emerald-600 dark:text-emerald-400">
                            <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                            @m.Trend
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Monthly trend chart *@
        <div class="border-b px-5 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">
                        Monthly Review Volume
                    </span>
                </div>
                <span class="text-xs text-muted-foreground tabular-nums">
                    Avg rating: @_yearlyAvgRating.ToString("F2")/5
                </span>
            </div>

            <div class="flex items-end gap-1">
                @foreach (var md in _monthlyData)
                {
                    var month = md;
                    var barHeight = (int)((month.Reviews / (double)_maxMonthlyReviews) * 100);
                    var barPx = (int)Math.Max(barHeight * 0.8, 8);
                    var isHovered = _hoveredMonth == month.Month;
                    var isAboveAvg = month.AvgRating >= _yearlyAvgRating;
                    var barColor = isAboveAvg
                        ? (isHovered ? "bg-foreground/90" : "bg-foreground/60")
                        : (isHovered ? "bg-foreground/40" : "bg-foreground/20");

                    <div class="group relative flex flex-1 flex-col items-center gap-1"
                         @onmouseenter="@(() => _hoveredMonth = month.Month)"
                         @onmouseleave="@(() => _hoveredMonth = null)">
                        @if (isHovered)
                        {
                            <div class="absolute -top-16 z-10 rounded-md border bg-card px-2.5 py-1.5 shadow-sm">
                                <p class="text-[10px] font-medium">@month.Month</p>
                                <p class="text-[10px] text-muted-foreground tabular-nums">
                                    @month.Reviews.ToString("N0") reviews
                                </p>
                                <p class="text-[10px] text-muted-foreground tabular-nums">
                                    @month.AvgRating.ToString("F2") avg
                                </p>
                            </div>
                        }
                        <div class="@($"w-full cursor-pointer rounded-sm transition-colors {barColor}")"
                             style="@($"height:{barPx}px")">
                        </div>
                        <span class="text-[10px] text-muted-foreground">@month.ShortMonth</span>
                    </div>
                }
            </div>

            @* Legend *@
            <div class="mt-2.5 flex items-center justify-center gap-4">
                <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                    <span class="size-2 rounded-sm bg-foreground/60"></span>
                    Above yearly avg
                </span>
                <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                    <span class="size-2 rounded-sm bg-foreground/20"></span>
                    Below yearly avg
                </span>
            </div>
        </div>

        @* Milestones *@
        <div class="border-b px-5 py-4">
            <div class="mb-3 flex items-center gap-1.5">
                <LucideIconCn Name="award" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Milestones Achieved</span>
            </div>

            <div class="grid gap-2 sm:grid-cols-2">
                @foreach (var ms in _milestones)
                {
                    var milestone = ms;
                    <div class="flex items-start gap-2.5 rounded-md bg-muted/30 p-3">
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="@GetMilestoneIcon(milestone.Icon)" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-medium">@milestone.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal text-muted-foreground">
                                    @milestone.AchievedMonth
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-[10px] text-muted-foreground">
                                @milestone.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tabs: Top Reviews, Categories, Community *@
        <TabsCn DefaultValue="reviews" Class="border-none">
            <div class="border-b px-5">
                <TabsListCn Class="h-9 w-full justify-start gap-1 bg-transparent p-0">
                    <TabsTriggerCn Value="reviews" Class="h-9 rounded-none border-b-2 border-b-transparent px-3 text-xs data-[state=active]:border-b-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Top Reviews
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="categories" Class="h-9 rounded-none border-b-2 border-b-transparent px-3 text-xs data-[state=active]:border-b-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        By Category
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="community" Class="h-9 rounded-none border-b-2 border-b-transparent px-3 text-xs data-[state=active]:border-b-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Community
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            @* Top Reviews tab *@
            <TabsContentCn Value="reviews" Class="mt-0">
                <div>
                    @for (var i = 0; i < _topReviews.Length; i++)
                    {
                        var review = _topReviews[i];
                        var isLast = i == _topReviews.Length - 1;
                        <div class="@($"px-5 py-3 {(isLast ? "" : "border-b")}")">
                            <div class="flex items-center gap-2">
                                <AvatarCn Class="size-6">
                                    <AvatarFallbackCn Class="text-[9px]">@review.AuthorInitials</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs font-medium">@review.AuthorName</span>
                                <div class="flex items-center gap-0.5">
                                    @for (var s = 0; s < 5; s++)
                                    {
                                        var si = s;
                                        <LucideIconCn Name="star" Size="12" Class="@($"size-3 {(si < review.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")}")" />
                                    }
                                </div>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto text-[10px] font-normal text-muted-foreground">
                                    @review.Product
                                </BadgeCn>
                            </div>
                            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                                &ldquo;@review.Snippet&rdquo;
                            </p>
                            <div class="mt-1.5 flex items-center gap-1">
                                <span class="text-[10px] text-muted-foreground tabular-nums">
                                    @review.HelpfulVotes helpful votes
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>

            @* Categories tab *@
            <TabsContentCn Value="categories" Class="mt-0">
                <div>
                    @for (var i = 0; i < _categoryPerformance.Length; i++)
                    {
                        var cat = _categoryPerformance[i];
                        var isLast = i == _categoryPerformance.Length - 1;
                        var progressVal = (cat.ReviewCount / (double)_maxCategoryCount) * 100;
                        var changeColor = cat.Change >= 0
                            ? "text-emerald-600 dark:text-emerald-400"
                            : "text-red-600 dark:text-red-400";
                        <div class="@($"px-5 py-2.5 {(isLast ? "" : "border-b")}")">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-medium">@cat.Category</span>
                                <div class="flex items-center gap-2">
                                    <div class="flex items-center gap-0.5">
                                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                                        <span class="text-xs font-medium tabular-nums">
                                            @cat.AvgRating.ToString("F1")
                                        </span>
                                    </div>
                                    <span class="@($"flex items-center gap-0.5 text-[10px] tabular-nums {changeColor}")">
                                        @(cat.Change >= 0 ? "+" : "")@cat.Change%
                                    </span>
                                </div>
                            </div>
                            <div class="mt-1.5 flex items-center gap-2">
                                <ProgressCn Value="@progressVal" Class="h-1.5 flex-1" />
                                <span class="w-14 text-right text-[10px] text-muted-foreground tabular-nums">
                                    @cat.ReviewCount.ToString("N0")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>

            @* Community tab *@
            <TabsContentCn Value="community" Class="mt-0">
                <div class="px-5 py-3">
                    <span class="text-[10px] text-muted-foreground">Top Reviewers of @_year</span>
                </div>
                <div>
                    @for (var i = 0; i < _topReviewers.Length; i++)
                    {
                        var reviewer = _topReviewers[i];
                        var isLast = i == _topReviewers.Length - 1;
                        var rank = i + 1;
                        <div class="@($"flex items-center gap-3 px-5 py-2.5 {(isLast ? "" : "border-b")}")">
                            <span class="w-4 text-right text-[10px] font-medium text-muted-foreground tabular-nums">
                                @rank
                            </span>
                            <AvatarCn Class="size-6">
                                <AvatarFallbackCn Class="text-[9px]">@reviewer.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <span class="text-xs font-medium">@reviewer.Name</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] text-muted-foreground tabular-nums">
                                        @reviewer.ReviewCount reviews
                                    </span>
                                    <span class="text-[10px] text-muted-foreground">&middot;</span>
                                    <span class="text-[10px] text-muted-foreground tabular-nums">
                                        @reviewer.HelpfulVotes.ToString("N0") helpful
                                    </span>
                                </div>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                                <span class="text-xs font-medium tabular-nums">
                                    @reviewer.AvgRating.ToString("F1")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>
        </TabsCn>

        @* Footer summary *@
        <div class="flex items-center justify-between border-t bg-muted/20 px-5 py-2.5">
            <span class="text-[10px] text-muted-foreground">
                @_keyMetrics.VerifiedRate% verified reviews &middot; @_keyMetrics.PhotosUploaded.ToString("N0") photos uploaded
            </span>
            <span class="text-[10px] text-muted-foreground">
                Generated from @_keyMetrics.TotalReviews.ToString("N0") reviews in @_year
            </span>
        </div>
    </div>
</section>

@code {
    private const int _year = 2025;
    private string? _hoveredMonth;

    private record KeyMetrics(
        int TotalReviews, double AvgRating, int ResponseRate, int NpsScore,
        int VerifiedRate, int PhotosUploaded,
        int YoyReviews, double YoyRating, int YoyResponse, int YoyNps);

    private record MonthlyDataItem(string Month, string ShortMonth, int Reviews, double AvgRating, int ResponseRate);

    private record MilestoneItem(string Id, string Title, string Description, string AchievedMonth, string Icon);

    private record TopReviewItem(string Id, string AuthorName, string AuthorInitials, string Product, int Rating, string Snippet, int HelpfulVotes);

    private record CategoryItem(string Category, int ReviewCount, double AvgRating, int Change);

    private record TopReviewerItem(string Name, string Initials, int ReviewCount, double AvgRating, int HelpfulVotes);

    private record MetricCell(string Label, string Value, string Trend, bool Star, string CellClass);

    private static readonly KeyMetrics _keyMetrics = new(
        TotalReviews: 14283, AvgRating: 4.42, ResponseRate: 96, NpsScore: 72,
        VerifiedRate: 87, PhotosUploaded: 4891,
        YoyReviews: 23, YoyRating: 0.31, YoyResponse: 8, YoyNps: 11);

    private static readonly MonthlyDataItem[] _monthlyData =
    [
        new("January",   "Jan", 892,  4.18, 91),
        new("February",  "Feb", 823,  4.12, 92),
        new("March",     "Mar", 1045, 4.24, 93),
        new("April",     "Apr", 1134, 4.31, 94),
        new("May",       "May", 1287, 4.38, 94),
        new("June",      "Jun", 1098, 4.41, 95),
        new("July",      "Jul", 1156, 4.45, 95),
        new("August",    "Aug", 1312, 4.48, 96),
        new("September", "Sep", 1367, 4.52, 97),
        new("October",   "Oct", 1578, 4.56, 97),
        new("November",  "Nov", 1423, 4.54, 98),
        new("December",  "Dec", 1168, 4.49, 96),
    ];

    private static readonly MilestoneItem[] _milestones =
    [
        new("m1", "10,000 Reviews",     "Reached five-figure lifetime review count in August",          "Aug", "message"),
        new("m2", "4.5 Average Rating", "Sustained 4.5+ average across three consecutive months",       "Sep", "star"),
        new("m3", "Community Champion", "First reviewer reached 500 helpful votes in a single year",    "Oct", "trophy"),
        new("m4", "98% Response Rate",  "Highest monthly response rate in company history",             "Nov", "users"),
    ];

    private static readonly TopReviewItem[] _topReviews =
    [
        new("tr1", "Yuki Tanaka",  "YT", "Pro Dashboard Suite",       5,
            "Tried five competitors before landing here. Nothing else comes close in terms of developer experience, performance, and design quality.",
            347),
        new("tr2", "Sofia Ruiz",   "SR", "Team Collaboration Hub",    5,
            "Rolled this out to a 40-person distributed team. Adoption was instant. We shipped our last project two weeks ahead of schedule.",
            289),
        new("tr3", "Marcus Grant", "MG", "Analytics Starter Kit",     4,
            "Honest review after 6 months: the core is exceptional but advanced filtering needs work. The team shipped 3 updates addressing my feedback.",
            234),
    ];

    private static readonly CategoryItem[] _categoryPerformance =
    [
        new("Dashboard Suite",    3421, 4.62,  12),
        new("Collaboration Hub",  2987, 4.48,   8),
        new("Analytics Kit",      2654, 4.35,  18),
        new("Design System",      2198, 4.51,  -3),
        new("CLI Tools",          1876, 4.28,  31),
        new("Mobile SDK",         1147, 4.14,  45),
    ];

    private static readonly TopReviewerItem[] _topReviewers =
    [
        new("Yuki Tanaka",    "YT", 89, 4.7, 1834),
        new("Hannah Fischer", "HF", 67, 4.5, 1247),
        new("Alex Thompson",  "AT", 54, 4.3,  987),
        new("Sofia Ruiz",     "SR", 48, 4.8,  891),
        new("Liam Chen",      "LC", 41, 4.4,  756),
    ];

    private static readonly int _maxMonthlyReviews = _monthlyData.Max(m => m.Reviews);

    private static readonly double _yearlyAvgRating =
        _monthlyData.Sum(m => m.AvgRating) / _monthlyData.Length;

    private static readonly int _maxCategoryCount = _categoryPerformance.Max(c => c.ReviewCount);

    private MetricCell[] _metrics =>
    [
        new("Total reviews",    _keyMetrics.TotalReviews.ToString("N0"),
            $"+{_keyMetrics.YoyReviews}%",  false,
            "border-b sm:border-b-0 border-r"),
        new("Average rating",   _keyMetrics.AvgRating.ToString("F1"),
            $"+{_keyMetrics.YoyRating}",    true,
            "border-b sm:border-b-0 sm:border-r"),
        new("Response rate",    $"{_keyMetrics.ResponseRate}%",
            $"+{_keyMetrics.YoyResponse}%", false,
            "border-r"),
        new("NPS score",        _keyMetrics.NpsScore.ToString(),
            $"+{_keyMetrics.YoyNps}",       false,
            ""),
    ];

    private static string GetMilestoneIcon(string icon) => icon switch
    {
        "trophy"  => "trophy",
        "star"    => "star",
        "users"   => "users",
        "message" => "message-square",
        _         => "circle",
    };
}
