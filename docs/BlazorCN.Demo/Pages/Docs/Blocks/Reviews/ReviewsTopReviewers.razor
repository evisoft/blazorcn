@* ============================================================
   Block: reviews-top-reviewers
   Title: ReviewsTopReviewers
   Description: A gamified top reviewers leaderboard for React and Next.js with podium top-three display, ranked contributor list, expertise badges, helpfulness scores, progress bars toward next tier, and time period filtering built with shadcn/ui Badge and Button components and Tailwind CSS.
   Source: original/blocks/reviews/reviews-top-reviewers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="text-sm font-medium">Top reviewers</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_reviewers.Length contributors &middot; @_totalReviews.ToString("N0") reviews
                    </p>
                </div>
            </div>
            @* Period filter *@
            <div class="flex items-center gap-0.5 rounded-md bg-muted/50 p-0.5">
                @foreach (var tp in _timePeriods)
                {
                    var tpItem = tp;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 px-2.5 text-[10px]", _period == tpItem.Value ? "bg-background shadow-sm" : "text-muted-foreground hover:text-foreground")"
                              OnClick="@(() => _period = tpItem.Value)">
                        @tpItem.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Podium - Top 3 *@
        <div class="border-b px-4 py-5">
            <div class="grid grid-cols-3 gap-3">
                @for (var i = 0; i < 3 && i < _reviewers.Length; i++)
                {
                    var index = i;
                    var reviewer = _reviewers[index];
                    var progress = GetProgress(reviewer);
                    var nextTier = GetNextTier(reviewer.Tier);

                    <div class="@Cn.Merge("flex flex-col items-center rounded-md border p-3", index == 0 ? "bg-muted/30" : "bg-card")">
                        @* Rank indicator *@
                        <span class="text-[10px] font-medium text-muted-foreground tabular-nums">
                            #@(index + 1)
                        </span>

                        @* Avatar *@
                        <div class="@Cn.Merge("mt-1.5 flex items-center justify-center rounded-full text-xs font-medium", index == 0 ? "size-10 bg-foreground text-background" : "size-8 bg-muted")">
                            @reviewer.Initials
                        </div>

                        @* Name + tier *@
                        <span class="mt-2 text-center text-xs font-medium leading-tight">
                            @reviewer.Name
                        </span>
                        <BadgeCn Class="@Cn.Merge("mt-1 text-[9px] font-normal", GetTierStyle(reviewer.Tier))">
                            @reviewer.Tier
                        </BadgeCn>

                        @* Stats *@
                        <div class="mt-2 flex items-center gap-1 text-[10px] text-muted-foreground">
                            <LucideIconCn Name="message-square" Size="10" Class="size-2.5" />
                            <span class="tabular-nums">@reviewer.ReviewCount</span>
                            <span class="mx-0.5">&middot;</span>
                            <LucideIconCn Name="thumbs-up" Size="10" Class="size-2.5" />
                            <span class="tabular-nums">@reviewer.HelpfulnessRate%</span>
                        </div>

                        @* Progress bar *@
                        @if (nextTier != null)
                        {
                            <div class="mt-2 w-full">
                                <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/60"
                                         style="@($"width:{progress}%")">
                                    </div>
                                </div>
                                <span class="mt-0.5 block text-center text-[9px] text-muted-foreground">
                                    @progress% to @nextTier.Tier
                                </span>
                            </div>
                        }
                        @if (nextTier == null)
                        {
                            <div class="mt-2 flex items-center gap-1 text-[9px] text-muted-foreground">
                                <LucideIconCn Name="award" Size="10" Class="size-2.5" />
                                Max tier
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Remaining reviewers *@
        <div>
            @for (var i = 3; i < _reviewers.Length; i++)
            {
                var index = i;
                var reviewer = _reviewers[index];
                var rank = index + 1;
                var progress = GetProgress(reviewer);
                var nextTier = GetNextTier(reviewer.Tier);
                var isLast = index == _reviewers.Length - 1;

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    @* Rank *@
                    <span class="w-5 shrink-0 text-center text-xs font-medium text-muted-foreground tabular-nums">
                        @rank
                    </span>

                    @* Avatar *@
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @reviewer.Initials
                    </div>

                    @* Info *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@reviewer.Name</span>
                            <BadgeCn Class="@Cn.Merge("text-[9px] font-normal", GetTierStyle(reviewer.Tier))">
                                @reviewer.Tier
                            </BadgeCn>
                            @if (reviewer.Streak >= 14)
                            {
                                <span class="flex items-center gap-0.5 text-[10px] text-muted-foreground">
                                    <LucideIconCn Name="flame" Size="10" Class="size-2.5" />
                                    @reviewer.Streak@("d")
                                </span>
                            }
                        </div>
                        <div class="mt-1 flex items-center gap-3">
                            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="message-square" Size="10" Class="size-2.5" />
                                    <span class="tabular-nums">@reviewer.ReviewCount</span>
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="thumbs-up" Size="10" Class="size-2.5" />
                                    <span class="tabular-nums">@reviewer.HelpfulnessRate%</span>
                                </span>
                                <span class="flex items-center gap-0.5">
                                    <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-foreground text-foreground" />
                                    <span class="tabular-nums">@reviewer.AverageRating.ToString("F1")</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    @* Progress to next tier *@
                    @if (nextTier != null)
                    {
                        <div class="w-16 shrink-0">
                            <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/50"
                                     style="@($"width:{progress}%")">
                                </div>
                            </div>
                            <span class="mt-0.5 block text-right text-[9px] text-muted-foreground tabular-nums">
                                @progress%
                            </span>
                        </div>
                    }
                    @if (nextTier == null)
                    {
                        <LucideIconCn Name="award" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-[10px] text-muted-foreground">
                @_totalVotes.ToString("N0") total helpful votes
            </span>
            <span class="text-[10px] text-muted-foreground">Rankings update daily</span>
        </div>
    </div>
</section>

@code {
    private string _period = "all";

    private record TimePeriodItem(string Value, string Label);
    private record NextTierResult(string Tier, int Threshold);

    private record Reviewer(
        string Id,
        string Name,
        string Initials,
        int ReviewCount,
        int HelpfulVotes,
        double AverageRating,
        string Tier,
        int HelpfulnessRate,
        string TopCategory,
        int Streak,
        string MemberSince);

    private static readonly TimePeriodItem[] _timePeriods =
    [
        new("all",   "All Time"),
        new("year",  "This Year"),
        new("month", "This Month"),
    ];

    private static readonly string[] _tierOrder = ["Active", "Veteran", "Expert", "Legend"];

    private static readonly (string Tier, int Threshold)[] _tierThresholds =
    [
        ("Active",  25),
        ("Veteran", 75),
        ("Expert",  150),
        ("Legend",  300),
    ];

    private static readonly Reviewer[] _reviewers =
    [
        new("u1", "Alex Thompson",  "AT", 312, 2847, 4.2, "Legend",  94, "Developer Tools", 45, "Jan 2022"),
        new("u2", "Maria Santos",   "MS", 189, 1672, 4.5, "Expert",  91, "Design Systems",  28, "Mar 2022"),
        new("u3", "Jordan Lee",     "JL", 156, 1203, 3.9, "Expert",  87, "Cloud Services",  12, "Jun 2022"),
        new("u4", "Nina Patel",     "NP",  98,  823, 4.3, "Veteran", 85, "Analytics",       19, "Sep 2022"),
        new("u5", "Ryan O'Brien",   "RO",  76,  612, 4.1, "Veteran", 82, "Security",         8, "Nov 2022"),
        new("u6", "Yuki Tanaka",    "YT",  63,  498, 4.6, "Veteran", 89, "AI/ML Tools",     31, "Feb 2023"),
        new("u7", "Sam Wright",     "SW",  47,  342, 4.0, "Active",  78, "Databases",        5, "May 2023"),
        new("u8", "Diana Kowalska", "DK",  34,  218, 4.4, "Active",  81, "Testing",         14, "Aug 2023"),
    ];

    private static readonly int _totalReviews = 975;  // sum of all reviewCount
    private static readonly int _totalVotes   = 8215; // sum of all helpfulVotes

    private static int GetTierThreshold(string tier)
    {
        foreach (var (t, threshold) in _tierThresholds)
            if (t == tier) return threshold;
        return 0;
    }

    private static NextTierResult? GetNextTier(string current)
    {
        var idx = Array.IndexOf(_tierOrder, current);
        if (idx < 0 || idx >= _tierOrder.Length - 1) return null;
        var next = _tierOrder[idx + 1];
        return new NextTierResult(next, GetTierThreshold(next));
    }

    private static int GetProgress(Reviewer reviewer)
    {
        var next = GetNextTier(reviewer.Tier);
        if (next == null) return 100;
        var currentThreshold = GetTierThreshold(reviewer.Tier);
        var range = next.Threshold - currentThreshold;
        if (range <= 0) return 100;
        var progress = reviewer.ReviewCount - currentThreshold;
        return Math.Min((int)Math.Round((double)progress / range * 100), 100);
    }

    private static string GetTierStyle(string tier) => tier switch
    {
        "Legend" => "bg-foreground text-background",
        "Expert" => "bg-foreground/80 text-background",
        "Veteran" => "bg-muted-foreground/20 text-foreground",
        _ => "bg-muted text-muted-foreground",
    };
}
