@* ============================================================
   Block: reviews-photo-wall
   Title: ReviewsPhotoWall
   Description: A React dense photo wall mosaic for Next.js with asymmetric bento grid layout, hover-to-reveal reviewer details, star ratings, and photo count overlays built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-photo-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Customer Photo Wall</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_totalPhotos photos
                </span>
                <span class="text-muted-foreground/30">|</span>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                    <span class="font-medium text-xs tabular-nums">@_avgRating</span>
                </div>
            </div>
        </div>

        @* Bento mosaic grid *@
        <div class="grid grid-cols-2 gap-px bg-border md:grid-cols-4" style="grid-auto-rows:120px">
            @foreach (var photo in _wallPhotos)
            {
                var p = photo;
                <div class="@GetGridClasses(p.Span)">
                    <button
                        type="button"
                        class="@($"group relative size-full cursor-pointer {p.BgShade} overflow-hidden transition-all")"
                        @onmouseenter="@(() => _hoveredId = p.Id)"
                        @onmouseleave="@(() => _hoveredId = null)"
                        @onfocus="@(() => _hoveredId = p.Id)"
                        @onblur="@(() => _hoveredId = null)">

                        @* Placeholder content *@
                        <div class="flex size-full flex-col items-center justify-center gap-1.5">
                            <LucideIconCn Name="camera" Size="@GetCameraSize(p.Span)" Class="@($"text-muted-foreground/25 {GetCameraClass(p.Span)}")" />
                            <span class="text-muted-foreground/40 text-[10px]">@p.Label</span>
                        </div>

                        @* Hover overlay *@
                        <div class="@($"absolute inset-0 flex flex-col justify-end p-2.5 transition-all duration-200 {(_hoveredId == p.Id ? "bg-black/50" : "bg-black/0")}")">
                            <div class="@($"transition-all duration-200 {(_hoveredId == p.Id ? "translate-y-0 opacity-100" : "translate-y-2 opacity-0")}") ">
                                @* Star rating *@
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        var starIndex = i;
                                        <LucideIconCn Name="star" Size="@(p.Span == PhotoSpan.Small ? 10 : 12)" Class="@($"{(p.Span == PhotoSpan.Small ? "size-2.5" : "size-3")} {(starIndex < p.Rating ? "fill-white text-white" : "text-white/30")}")" />
                                    }
                                </div>
                                <span class="mt-0.5 block truncate font-medium text-white text-xs">@p.Author</span>
                                @if (p.Span != PhotoSpan.Small)
                                {
                                    <span class="block truncate text-white/60 text-[10px]">@p.Product</span>
                                }
                            </div>
                        </div>

                        @* Photo count badge *@
                        @if (p.PhotoCount > 1)
                        {
                            <div class="absolute top-1.5 right-1.5">
                                <span class="flex items-center gap-0.5 rounded bg-black/50 px-1 py-0.5 font-medium text-[10px] text-white tabular-nums">
                                    <LucideIconCn Name="camera" Size="10" Class="size-2.5" />
                                    @p.PhotoCount
                                </span>
                            </div>
                        }
                    </button>
                </div>
            }
        </div>

        @* Footer summary *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-[10px]">
                    <span class="font-medium text-foreground tabular-nums">@_wallPhotos.Length</span>
                    @(" reviews with photos")
                </span>
                <span class="text-muted-foreground/30">|</span>
                <span class="text-muted-foreground text-[10px]">
                    <span class="font-medium text-foreground tabular-nums">@_totalPhotos</span>
                    @(" total photos")
                </span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Verified purchases only</BadgeCn>
        </div>
    </div>
</section>

@code {
    private enum PhotoSpan { Large, Medium, Small }

    private record WallPhoto(string Id, string Author, int Rating, string Label, int PhotoCount, string Date, string Product, PhotoSpan Span, string BgShade);

    private string? _hoveredId;

    private static readonly WallPhoto[] _wallPhotos =
    [
        new("w1",  "Olivia Torres", 5, "Unboxing",        3, "4 days ago",   "Studio Monitor Pro",  PhotoSpan.Large,  "bg-muted/20"),
        new("w2",  "Ryan Mitchell", 4, "Desk setup",      2, "1 week ago",   "Mechanical Keyboard", PhotoSpan.Small,  "bg-muted/35"),
        new("w3",  "Ava Lindgren",  5, "After 6 months",  1, "2 weeks ago",  "Desk Mat XL",         PhotoSpan.Small,  "bg-muted/25"),
        new("w4",  "Noah Patel",    5, "v2 vs v3",        4, "2 weeks ago",  "USB-C Hub",           PhotoSpan.Medium, "bg-muted/30"),
        new("w5",  "Mia Johansson", 3, "Color check",     2, "3 weeks ago",  "Webcam HD",           PhotoSpan.Small,  "bg-muted/40"),
        new("w6",  "Ethan Brooks",  4, "Travel ready",    1, "1 month ago",  "Carrying Case",       PhotoSpan.Medium, "bg-muted/20"),
        new("w7",  "Sofia Reyes",   5, "Home office",     5, "1 month ago",  "Monitor Arm Duo",     PhotoSpan.Large,  "bg-muted/25"),
        new("w8",  "Liam O'Connor", 4, "Build quality",   2, "5 weeks ago",  "Laptop Stand",        PhotoSpan.Small,  "bg-muted/35"),
        new("w9",  "Yuki Tanaka",   5, "Minimal setup",   3, "6 weeks ago",  "Cable Organizer",     PhotoSpan.Small,  "bg-muted/30"),
        new("w10", "Marcus Webb",   4, "Durability test", 2, "6 weeks ago",  "Mouse Pad Pro",       PhotoSpan.Medium, "bg-muted/20"),
    ];

    private static readonly int _totalPhotos = _wallPhotos.Sum(p => p.PhotoCount);
    private static readonly string _avgRating = (_wallPhotos.Sum(p => p.Rating) / (double)_wallPhotos.Length).ToString("F1");

    private static string GetGridClasses(PhotoSpan span) => span switch
    {
        PhotoSpan.Large  => "col-span-2 row-span-2",
        PhotoSpan.Medium => "col-span-2 row-span-1",
        _                => "col-span-1 row-span-1",
    };

    private static int GetCameraSize(PhotoSpan span) => span switch
    {
        PhotoSpan.Large  => 32,
        PhotoSpan.Medium => 24,
        _                => 20,
    };

    private static string GetCameraClass(PhotoSpan span) => span switch
    {
        PhotoSpan.Large  => "size-8",
        PhotoSpan.Medium => "size-6",
        _                => "size-5",
    };
}
