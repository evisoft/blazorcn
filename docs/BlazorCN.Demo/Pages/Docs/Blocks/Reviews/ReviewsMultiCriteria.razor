@* ========================================
   Block: reviews-multi-criteria
   Title: Reviews Multi Criteria
   Description: Multi-criteria rating breakdown component with category scores for product detail pages
   Dependencies: CardCn, CardContentCn, ProgressCn, LucideStarCn
   Source: original/blocks/reviews/reviews-multi-criteria.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Customer Reviews</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            Based on @_totalReviews.ToString("N0") reviews
        </p>
    </div>

    <div class="mx-auto w-[900px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Overall Stats *@
                <div class="mb-6 grid grid-cols-3 gap-6 text-center">
                    <div>
                        <div class="flex items-center justify-center gap-1">
                            <span class="text-3xl font-bold tabular-nums">@_overallRating</span>
                            <LucideStarCn Size="20" Class="fill-primary text-primary" />
                        </div>
                        <p class="text-sm text-muted-foreground">Overall rating</p>
                    </div>
                    <div>
                        <p class="text-3xl font-bold tabular-nums">@_totalReviews.ToString("N0")</p>
                        <p class="text-sm text-muted-foreground">Total reviews</p>
                    </div>
                    <div>
                        <p class="text-3xl font-bold tabular-nums">@(_recommendPercentage)%</p>
                        <p class="text-sm text-muted-foreground">Would recommend</p>
                    </div>
                </div>

                @* Category Ratings *@
                <div class="grid gap-4 sm:grid-cols-2">
                    @foreach (var category in _categories)
                    {
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between text-sm">
                                <span>@category.Label</span>
                                <span class="font-medium tabular-nums">@category.Score</span>
                            </div>
                            <ProgressCn Class="h-1.5" Value="@((int)(category.Score / 5.0 * 100))" />
                        </div>
                    }
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record RatingCategory(string Label, double Score);

    private const double _overallRating = 4.4;
    private const int _totalReviews = 1847;
    private const int _recommendPercentage = 87;

    private readonly RatingCategory[] _categories =
    [
        new("Quality", 4.5),
        new("Value", 4.2),
        new("Appearance", 4.6),
        new("Effectiveness", 4.5),
        new("Features", 4.1),
        new("Durability", 4.3),
    ];
}
