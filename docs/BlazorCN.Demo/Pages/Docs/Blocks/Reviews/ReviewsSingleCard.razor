@* ========================================
   Block: reviews-single-card
   Title: Reviews Single Card
   Description: Single review card component with star rating, avatar, and testimonial text for React product pages
   Long Description: Review showcase carousel component for featuring testimonials on React landing pages
   Dependencies: LucideStarCn
   Source: original/blocks/reviews/reviews-single-card.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Customer Review</h1>
    </div>

    <div class="mx-auto w-[600px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Rating and Date *@
                <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-0.5">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <LucideStarCn Class="@Cn.Merge("h-4 w-4", star <= _review.Rating ? "fill-primary text-primary" : "fill-muted text-muted")" Size="16" />
                            }
                        </div>
                        <span class="text-sm text-muted-foreground">(@_review.Rating/5)</span>
                    </div>
                    <span class="text-sm text-muted-foreground">@_review.Date</span>
                </div>

                @* Review Content *@
                <p class="mb-6 leading-relaxed">@_review.Content</p>

                @* Author *@
                <div class="flex items-center gap-3">
                    <AvatarCn Class="h-12 w-12">
                        <AvatarImageCn Alt="@_review.AuthorName" Src="@_review.AuthorAvatar" />
                        <AvatarFallbackCn>@_review.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <p class="font-semibold">@_review.AuthorName</p>
                        <p class="text-sm text-muted-foreground">@_review.AuthorTitle</p>
                    </div>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record ReviewData(string AuthorName, string AuthorTitle, string AuthorAvatar, string Initials, int Rating, string Date, string Content);

    private static readonly ReviewData _review = new(
        "Adam Smith",
        "CEO at ACME Inc.",
        "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&w=100&q=80",
        "AS",
        4,
        "Feb 12, 2025",
        "The product is great, I'm very satisfied with the quality and the price. I would recommend it to anyone looking for a good product or service. The attention to detail is impressive and customer support was incredibly helpful."
    );
}
