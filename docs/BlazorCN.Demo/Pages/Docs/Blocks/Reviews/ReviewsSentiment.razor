@* ========================================
   Block: reviews-sentiment
   Title: Reviews Sentiment
   Description: AI-powered sentiment analysis dashboard with emotion breakdown for React business analytics
   Long Description: Review request card component with rating selector for React post-purchase flows
   Dependencies: LucideArrowDownCn, LucideArrowUpCn, LucideMessageSquareTextCn, LucideSparklesCn, LucideTrendingUpCn
   Source: original/blocks/reviews/reviews-sentiment.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Sentiment Analysis</h1>
        <p class="mt-2 text-muted-foreground">
            AI-powered insights from @_totalAnalyzed.ToString("N0") reviews
        </p>
    </div>

    <div class="mx-auto w-[800px] max-w-full space-y-6">
        @* Score and Breakdown *@
        <div class="grid gap-6 md:grid-cols-2">
            <CardCn>
                <CardHeaderCn Class="pb-2">
                    <CardTitleCn Class="flex items-center gap-2 text-base font-medium">
                        <LucideSparklesCn Class="h-4 w-4" Size="16" />
                        Overall Score
                    </CardTitleCn>
                </CardHeaderCn>
                <CardContentCn>
                    <div class="flex items-baseline gap-2">
                        <span class="text-5xl font-bold tabular-nums">@_overallScore</span>
                        <span class="text-muted-foreground">/ 100</span>
                    </div>
                    <ProgressCn Class="mt-4 h-2" Value="@_overallScore" />
                    <p class="mt-3 text-sm text-muted-foreground">
                        @(_overallScore >= 70 ? "Customers are generally satisfied" : _overallScore >= 50 ? "Mixed sentiment across reviews" : "Attention needed")
                    </p>
                </CardContentCn>
            </CardCn>

            <CardCn>
                <CardHeaderCn Class="pb-2">
                    <CardTitleCn Class="text-base font-medium">Distribution</CardTitleCn>
                </CardHeaderCn>
                <CardContentCn Class="space-y-4">
                    <div class="space-y-1">
                        <div class="flex justify-between text-sm">
                            <span>Positive</span>
                            <span class="font-medium">@_positive%</span>
                        </div>
                        <ProgressCn Class="h-2" Value="@_positive" />
                    </div>
                    <div class="space-y-1">
                        <div class="flex justify-between text-sm">
                            <span>Neutral</span>
                            <span class="font-medium">@_neutral%</span>
                        </div>
                        <ProgressCn Class="h-2" Value="@_neutral" />
                    </div>
                    <div class="space-y-1">
                        <div class="flex justify-between text-sm">
                            <span>Negative</span>
                            <span class="font-medium">@_negative%</span>
                        </div>
                        <ProgressCn Class="h-2" Value="@_negative" />
                    </div>
                </CardContentCn>
            </CardCn>
        </div>

        @* Emotions *@
        <CardCn>
            <CardHeaderCn Class="pb-2">
                <CardTitleCn Class="text-base font-medium">Emotion Breakdown</CardTitleCn>
            </CardHeaderCn>
            <CardContentCn>
                <div class="grid gap-4 sm:grid-cols-2">
                    @foreach (var emotion in _emotions)
                    {
                        <div class="space-y-1.5">
                            <div class="flex justify-between text-sm">
                                <span>@emotion.Name</span>
                                <span class="tabular-nums text-muted-foreground">@emotion.Score%</span>
                            </div>
                            <ProgressCn Class="h-1.5" Value="@emotion.Score" />
                        </div>
                    }
                </div>
            </CardContentCn>
        </CardCn>

        @* Topics and Samples *@
        <div class="grid gap-6 md:grid-cols-2">
            <CardCn>
                <CardHeaderCn Class="pb-2">
                    <CardTitleCn Class="flex items-center gap-2 text-base font-medium">
                        <LucideTrendingUpCn Class="h-4 w-4" Size="16" />
                        Trending Topics
                    </CardTitleCn>
                </CardHeaderCn>
                <CardContentCn>
                    <div class="space-y-3">
                        @for (var i = 0; i < _topics.Length; i++)
                        {
                            var topic = _topics[i];
                            <div>
                                <div class="flex items-center justify-between py-2">
                                    <div>
                                        <p class="font-medium">@topic.Topic</p>
                                        <p class="text-sm text-muted-foreground">@topic.Mentions mentions</p>
                                    </div>
                                    <div class="flex items-center gap-1 text-sm text-muted-foreground">
                                        @if (topic.Change > 0)
                                        {
                                            <LucideArrowUpCn Class="h-3.5 w-3.5" Size="14" />
                                        }
                                        else
                                        {
                                            <LucideArrowDownCn Class="h-3.5 w-3.5" Size="14" />
                                        }
                                        <span class="tabular-nums">@Math.Abs(topic.Change)%</span>
                                    </div>
                                </div>
                                @if (i < _topics.Length - 1)
                                {
                                    <SeparatorCn />
                                }
                            </div>
                        }
                    </div>
                </CardContentCn>
            </CardCn>

            <CardCn>
                <CardHeaderCn Class="pb-2">
                    <CardTitleCn Class="flex items-center gap-2 text-base font-medium">
                        <LucideMessageSquareTextCn Class="h-4 w-4" Size="16" />
                        Sample Analysis
                    </CardTitleCn>
                </CardHeaderCn>
                <CardContentCn>
                    <div class="space-y-4">
                        @for (var i = 0; i < _samples.Length; i++)
                        {
                            var sample = _samples[i];
                            <div class="space-y-2">
                                <p class="text-sm leading-relaxed">"@sample.Text"</p>
                                <div class="flex items-center gap-2">
                                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                        @sample.Label
                                    </BadgeCn>
                                    <span class="text-xs text-muted-foreground">
                                        @((int)Math.Round(sample.Confidence * 100))% confidence
                                    </span>
                                </div>
                                @if (i < _samples.Length - 1)
                                {
                                    <SeparatorCn Class="mt-4" />
                                }
                            </div>
                        }
                    </div>
                </CardContentCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private record EmotionScore(string Name, int Score);
    private record TrendingTopic(string Topic, int Mentions, int Change);
    private record SentimentSample(string Text, string Label, double Confidence);

    private const int _overallScore = 78;
    private const int _totalAnalyzed = 1284;
    private const int _positive = 72;
    private const int _neutral = 18;
    private const int _negative = 10;

    private static readonly EmotionScore[] _emotions =
    [
        new("Joy", 45),
        new("Trust", 38),
        new("Anticipation", 28),
        new("Surprise", 15),
        new("Sadness", 8),
        new("Anger", 5),
    ];

    private static readonly TrendingTopic[] _topics =
    [
        new("Quality", 423, 12),
        new("Shipping", 287, 8),
        new("Price", 234, -3),
        new("Support", 189, 15),
        new("Packaging", 156, -7),
    ];

    private static readonly SentimentSample[] _samples =
    [
        new("Absolutely love this product! Best purchase I've made this year.", "Positive", 0.94),
        new("Product is okay, nothing special. Does what it says.", "Neutral", 0.87),
        new("Disappointed with the quality. Expected much better for the price.", "Negative", 0.91),
    ];
}
