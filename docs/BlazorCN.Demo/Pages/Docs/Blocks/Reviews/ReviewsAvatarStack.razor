@* ============================================================
   Block: reviews-avatar-stack
   Title: ReviewsAvatarStack
   Description: A social proof avatar stack widget for React and Next.js with animated overlapping reviewer avatars, rating summary, recent reviewer names, and category breakdown built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-avatar-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Main social proof area *@
        <div class="px-4 py-5">
            <div class="flex flex-col items-center text-center">

                @* Avatar stack *@
                <div class="flex items-center -space-x-2">
                    @foreach (var reviewer in _reviewers)
                    {
                        <AvatarCn Class="ring-2 ring-background">
                            <AvatarFallbackCn Class="text-xs">@reviewer.Initials</AvatarFallbackCn>
                        </AvatarCn>
                    }
                    @* Overflow count *@
                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-muted ring-2 ring-background">
                        <span class="text-xs tabular-nums">+@_overflowCount.ToString("N0")</span>
                    </div>
                </div>

                @* Rating display *@
                <div class="mt-4 flex items-baseline gap-2">
                    <span class="text-3xl font-semibold tabular-nums leading-none">@_averageRating</span>
                    <div class="flex items-center gap-0.5">
                        @for (int i = 0; i < 5; i++)
                        {
                            var idx = i;
                            <LucideStarCn Size="16" Class="@(idx < (int)Math.Round(_averageRating) ? "size-4 fill-foreground text-foreground" : "size-4 fill-muted text-muted")" />
                        }
                    </div>
                </div>

                @* Review count + recommendation *@
                <div class="mt-2 flex items-center gap-3">
                    <span class="text-sm text-muted-foreground">
                        <span class="font-medium text-foreground tabular-nums">@_totalReviews.ToString("N0")</span>
                        @(" verified reviews")
                    </span>
                    <span class="text-muted-foreground/40">|</span>
                    <span class="flex items-center gap-1 text-sm text-muted-foreground">
                        <LucideHeartCn Size="12" Class="size-3 fill-red-500 text-red-500" />
                        <span class="font-medium text-foreground tabular-nums">@_recommendRate%</span>
                        @(" recommend")
                    </span>
                </div>
            </div>
        </div>

        @* Recent reviewer ticker *@
        <div class="overflow-hidden border-t border-b bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-1.5">
                <span class="shrink-0 text-[10px] text-muted-foreground">Recently reviewed by</span>
                <div class="flex items-center gap-1 overflow-hidden">
                    @for (int i = 0; i < _recentNames.Length; i++)
                    {
                        var name = _recentNames[i];
                        var isLast = i == _recentNames.Length - 1;
                        <span class="shrink-0 text-[10px] font-medium">
                            @name
                            @if (!isLast)
                            {
                                <span class="text-muted-foreground/40"> , </span>
                            }
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Category satisfaction breakdown *@
        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                @foreach (var cat in _categoryRatings)
                {
                    var percentage = (cat.Score / cat.MaxScore) * 100.0;
                    <div class="flex items-center gap-2">
                        <span class="w-24 shrink-0 text-xs text-muted-foreground">@cat.Label</span>
                        <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{percentage:F0}%")"></div>
                        </div>
                        <span class="w-6 text-right text-[10px] font-medium tabular-nums">@cat.Score</span>
                    </div>
                }
            </div>
        </div>

        @* Trust signals footer *@
        <div class="flex items-center justify-center gap-4 border-t px-4 py-2.5">
            <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                <LucideShieldCheckCn Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                Verified purchases only
            </span>
            <span class="text-muted-foreground/30">|</span>
            <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                <LucideTrendingUpCn Size="12" Class="size-3" />
                Updated daily
            </span>
        </div>

    </div>
</section>

@code {
    private record Reviewer(string Name, string Initials, string Role);
    private record CategoryRating(string Label, double Score, double MaxScore);

    private static readonly Reviewer[] _reviewers =
    [
        new("Sarah Chen", "SC", "Product Designer"),
        new("Marcus Webb", "MW", "Engineering Lead"),
        new("Priya Sharma", "PS", "Startup Founder"),
        new("Tom Eriksson", "TE", "Frontend Dev"),
        new("Aisha Okafor", "AO", "CTO"),
        new("Diego Morales", "DM", "Tech Lead"),
    ];

    private static readonly string[] _recentNames =
    [
        "James P.",
        "Mia L.",
        "Raj K.",
        "Sophie T.",
        "Carlos M.",
        "Yuki N.",
        "Emma W.",
        "Liam D.",
    ];

    private static readonly CategoryRating[] _categoryRatings =
    [
        new("Ease of use", 4.9, 5),
        new("Documentation", 4.7, 5),
        new("Performance", 4.8, 5),
        new("Support", 4.6, 5),
    ];

    private const int _totalReviews = 2847;
    private const double _averageRating = 4.8;
    private const int _recommendRate = 96;
    private const int _overflowCount = _totalReviews - 6; // 6 = _reviewers.Length
}
