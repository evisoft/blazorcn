@* ========================================
   Block: reviews-thread
   Title: Reviews Thread
   Description: Review thread component with seller reply and official response badge for React marketplaces
   Long Description: Testimonial carousel component with customer quotes and navigation for React landing pages
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn, TextareaCn
   Source: original/blocks/reviews/reviews-thread.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Review Thread</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn>
            <CardContentCn Class="p-6">
                @* Original Review *@
                <div class="space-y-4">
                    @* Review Header *@
                    <div class="flex items-start gap-3">
                        <AvatarCn Class="h-10 w-10">
                            <AvatarImageCn Alt="Sarah Mitchell" Src="" />
                            <AvatarFallbackCn>SM</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-semibold">Sarah Mitchell</span>
                                <div class="flex items-center gap-0.5">
                                    @for (var s = 1; s <= 5; s++)
                                    {
                                        <LucideStarCn Size="16" Class="@($"h-4 w-4 {(s <= 4 ? "fill-primary text-primary" : "fill-muted text-muted")}")" />
                                    }
                                </div>
                            </div>
                            <p class="text-sm text-muted-foreground">Dec 3, 2024</p>
                        </div>
                    </div>

                    @* Review Content *@
                    <div>
                        <h3 class="mb-2 font-semibold">Great product with minor shipping delay</h3>
                        <p class="text-muted-foreground">
                            The product quality is excellent and exactly as described. However, shipping took longer than expected - about 10 days instead of the promised 5. Once it arrived, everything was perfect. Would recommend, but plan ahead for delivery time.
                        </p>
                    </div>

                    @* Reply Thread *@
                    <div class="ml-6 border-l-2 pl-4">
                        <div class="flex items-start gap-3">
                            <AvatarCn Class="h-9 w-9">
                                <AvatarImageCn Alt="TechStore Support" Src="" />
                                <AvatarFallbackCn>TS</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-semibold">TechStore Support</span>
                                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                        Official Response
                                    </BadgeCn>
                                </div>
                                <p class="text-sm text-muted-foreground">Dec 4, 2024</p>
                                <p class="mt-2 text-sm text-muted-foreground">
                                    Thank you for your feedback, Sarah! We apologize for the shipping delay - we experienced higher than usual demand during that period. We've since improved our logistics and are working hard to ensure faster delivery times. We're glad you love the product!
                                </p>
                            </div>
                        </div>
                    </div>

                    @* Reply Form *@
                    @if (_showReplyForm)
                    {
                        <div class="ml-6 space-y-3 border-l-2 pl-4">
                            <TextareaCn Placeholder="Write your reply..." Rows="3" Value="@_replyText" />
                            <div class="flex gap-2">
                                <ButtonCn Disabled="@(string.IsNullOrWhiteSpace(_replyText))" Size="ButtonSize.Sm">
                                    Post Reply
                                </ButtonCn>
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                                          @onclick="@(() => { _showReplyForm = false; _replyText = ""; })">
                                    Cancel
                                </ButtonCn>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ButtonCn Class="mt-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                  @onclick="@(() => _showReplyForm = true)">
                            <LucideMessageSquareCn Size="16" Class="mr-2" />
                            Reply
                        </ButtonCn>
                    }
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _showReplyForm;
    private string _replyText = "";
}
