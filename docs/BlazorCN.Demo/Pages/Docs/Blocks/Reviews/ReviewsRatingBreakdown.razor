@* ============================================================
   Block: reviews-rating-breakdown
   Title: ReviewsRatingBreakdown
   Description: A detailed rating breakdown analytics panel for React and Next.js with per-category scores, star distribution bars, comparison to category averages, and time period filtering built with shadcn/ui and Tailwind CSS
   Source: original/blocks/reviews/reviews-rating-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with period filter *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium">Rating Breakdown</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_ratingData.Total.ToString("N0") reviews
                </BadgeCn>
            </div>
            <div class="flex items-center gap-0.5 rounded-md bg-muted/50 p-0.5">
                @foreach (var period in _periods)
                {
                    var p = period;
                    <button
                        type="button"
                        @onclick="@(() => _activePeriod = p.Value)"
                        class="@Cn.Merge("rounded px-2 py-1 text-xs transition-colors", _activePeriod == p.Value ? "bg-background font-medium text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @p.Label
                    </button>
                }
            </div>
        </div>

        @* Two-column layout *@
        <div class="grid md:grid-cols-2 md:divide-x">
            @* Left: Overall score + distribution *@
            <div>
                @* Score summary *@
                <div class="flex items-center gap-4 border-b px-4 py-4">
                    <div class="flex flex-col items-center">
                        <span class="text-3xl font-semibold tabular-nums">@_ratingData.Average</span>
                        <div class="mt-1 flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                int idx = i;
                                <LucideStarCn Size="14" Class="@Cn.Merge("size-3.5", idx < _filledStars ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                            }
                        </div>
                    </div>
                    <div class="h-10 w-px bg-border"></div>
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            <span class="text-xs">
                                <span class="font-medium tabular-nums">@_ratingData.RecommendPercent%</span>
                                <span class="text-muted-foreground"> would recommend</span>
                            </span>
                        </div>
                        <span class="text-xs text-muted-foreground">
                            Based on @_ratingData.Total.ToString("N0") verified reviews
                        </span>
                    </div>
                </div>

                @* Star distribution *@
                <div class="px-4 py-3">
                    @foreach (var level in _ratingData.Levels)
                    {
                        <div class="flex items-center gap-2.5 py-1.5">
                            <span class="w-3 text-right text-xs font-medium tabular-nums">@level.Stars</span>
                            <LucideStarCn Size="12" Class="size-3 shrink-0 fill-amber-400 text-amber-400" />
                            <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                <div class="h-full rounded-full bg-foreground/70" style="@($"width:{level.Percentage}%")"></div>
                            </div>
                            <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">@(level.Percentage)%</span>
                            <span class="w-12 text-right text-xs tabular-nums text-muted-foreground">@level.Count.ToString("N0")</span>
                        </div>
                    }
                </div>
            </div>

            @* Right: Category scores vs average *@
            <div class="border-t md:border-t-0">
                <div class="border-b px-4 py-2.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-muted-foreground">Category scores</span>
                        <span class="text-[10px] text-muted-foreground">vs. category avg</span>
                    </div>
                </div>
                <div class="px-4 py-3">
                    @foreach (var cat in _categoryScores)
                    {
                        var scorePercent = (cat.Score / 5.0) * 100;
                        var avgPercent = (cat.CategoryAverage / 5.0) * 100;
                        <div class="py-2">
                            <div class="mb-1.5 flex items-center justify-between">
                                <span class="text-xs">@cat.Label</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-medium tabular-nums">@cat.Score</span>
                                    @RenderDelta(cat.Score, cat.CategoryAverage)
                                </div>
                            </div>
                            <div class="relative h-1.5 overflow-hidden rounded-full bg-muted/50">
                                @* Category average marker *@
                                <div
                                    class="absolute top-0 h-full w-px bg-muted-foreground/40"
                                    style="@($"left:{avgPercent}%")">
                                </div>
                                @* Your score bar *@
                                <div
                                    class="@Cn.Merge("h-full rounded-full", cat.Score >= cat.CategoryAverage ? "bg-emerald-500/70" : "bg-amber-500/70")"
                                    style="@($"width:{scorePercent}%")">
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Legend *@
                <div class="border-t px-4 py-2.5">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-1.5">
                            <span class="h-1.5 w-4 rounded-full bg-emerald-500/70"></span>
                            <span class="text-[10px] text-muted-foreground">Your score</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="h-3 w-px bg-muted-foreground/40"></span>
                            <span class="text-[10px] text-muted-foreground">Category avg</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StarLevel(int Stars, int Count, int Percentage);
    private record CategoryScore(string Label, double Score, double CategoryAverage);
    private record RatingData(double Average, int Total, int RecommendPercent, StarLevel[] Levels);
    private record Period(string Value, string Label);

    private string _activePeriod = "all";

    private static readonly Period[] _periods =
    [
        new("all", "All time"),
        new("90d", "90 days"),
        new("30d", "30 days"),
        new("7d", "7 days"),
    ];

    private static readonly RatingData _ratingData = new(
        Average: 4.6,
        Total: 3847,
        RecommendPercent: 91,
        Levels:
        [
            new(5, 2308, 60),
            new(4, 846, 22),
            new(3, 385, 10),
            new(2, 192, 5),
            new(1, 116, 3),
        ]
    );

    private static readonly CategoryScore[] _categoryScores =
    [
        new("Build quality", 4.8, 4.2),
        new("Value for money", 4.3, 3.9),
        new("Ease of setup", 4.7, 4.0),
        new("Customer support", 4.5, 3.7),
        new("Documentation", 4.1, 3.5),
        new("Performance", 4.9, 4.4),
    ];

    private int _filledStars => (int)Math.Round(_ratingData.Average);

    private RenderFragment RenderDelta(double score, double average)
    {
        var delta = score - average;
        if (Math.Abs(delta) < 0.1)
        {
            return @<span class="flex items-center gap-0.5 text-xs text-muted-foreground">
                <LucideMinusCn Size="12" Class="size-3" />
                <span class="tabular-nums">avg</span>
            </span>;
        }
        if (delta > 0)
        {
            return @<span class="flex items-center gap-0.5 text-xs text-emerald-600">
                <LucideArrowUpCn Size="12" Class="size-3" />
                <span class="tabular-nums">+@(delta.ToString("F1"))</span>
            </span>;
        }
        return @<span class="flex items-center gap-0.5 text-xs text-red-500">
            <LucideArrowDownCn Size="12" Class="size-3" />
            <span class="tabular-nums">@(delta.ToString("F1"))</span>
        </span>;
    }
}
