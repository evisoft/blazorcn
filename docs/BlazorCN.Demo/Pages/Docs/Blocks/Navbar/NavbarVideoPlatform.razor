@* ============================================================
   Block: navbar-video-platform
   Title: NavbarVideoPlatform
   Description: A video streaming platform navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a StreamBox logo with play icon, hamburger sidebar toggle, large center search bar with voice search button, upload camera button, notifications bell, and user avatar with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-video-platform.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Left: Hamburger + Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <ButtonCn aria-label="Toggle guide sidebar" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0" OnClick="@(() => _sidebarOpen = !_sidebarOpen)">
                    @if (_sidebarOpen)
                    {
                        <LucideIconCn Name="x" Size="16" Class="size-4" />
                    }
                    else
                    {
                        <LucideIconCn Name="menu" Size="16" Class="size-4" />
                    }
                </ButtonCn>

                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="play" Size="16" Class="size-4 fill-foreground text-foreground" />
                    <span class="font-medium text-sm">StreamBox</span>
                </div>
            </div>

            @* Center: Search bar *@
            <div class="mx-4 hidden flex-1 md:block">
                <div class="flex items-center">
                    <div class="flex flex-1 items-center rounded-l-md border bg-muted/30 px-3 py-1.5">
                        <input
                            type="text"
                            value="@_searchValue"
                            @oninput="@((ChangeEventArgs e) => _searchValue = e.Value?.ToString() ?? "")"
                            placeholder="Search videos..."
                            aria-label="Search videos"
                            class="h-5 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                    </div>
                    <ButtonCn aria-label="Search" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-[34px] rounded-l-none border-l-0 px-3">
                        <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
                    </ButtonCn>
                    <ButtonCn aria-label="Voice search" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-2 size-8 p-0">
                        <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                    </ButtonCn>
                </div>
            </div>

            @* Right: Actions *@
            <div class="ml-auto flex items-center gap-1">
                @* Upload *@
                <ButtonCn aria-label="Create video" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                    <LucideIconCn Name="video" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                @* Notifications *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative size-8 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="absolute -right-0.5 -top-0.5 flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                        5
                    </span>
                </ButtonCn>

                @* User avatar *@
                <AvatarCn Class="ml-1 size-7 text-[10px]">
                    <AvatarFallbackCn>MR</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private bool _sidebarOpen = false;
    private string _searchValue = "";
}
