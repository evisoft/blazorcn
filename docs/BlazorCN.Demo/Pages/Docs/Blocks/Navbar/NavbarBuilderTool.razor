@* ============================================================
   Block: navbar-builder-tool
   Title: NavbarBuilderTool
   Description: A page builder and no-code tool navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a logo with editable project name, centered responsive preview toggles for Desktop, Tablet, and Mobile views, Undo and Redo history buttons, a Preview button, and a Publish button with globe icon using framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-builder-tool.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Left: logo + project name *@
            <div class="flex shrink-0 items-center gap-3">
                <div class="flex size-6 items-center justify-center rounded bg-foreground">
                    <span class="font-bold text-[10px] text-background">B</span>
                </div>
                <div class="h-4 w-px bg-border" />
                <span class="text-muted-foreground text-xs">Landing Page v2</span>
            </div>

            @* Center: viewport toggles *@
            <div class="mx-auto flex items-center rounded-md border bg-muted/30 p-0.5">
                @foreach (var vp in _viewports)
                {
                    var viewport = vp;
                    var isActive = _activeViewport == viewport.Id;
                    <button
                        type="button"
                        @onclick="@(() => _activeViewport = viewport.Id)"
                        class="@($"relative flex items-center justify-center rounded-[5px] px-3 py-1.5 text-xs transition-colors {(isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")}")"
                        aria-label="@viewport.Label">
                        @if (isActive)
                        {
                            <span class="absolute inset-0 rounded-[5px] bg-background shadow-sm" />
                        }
                        <LucideIconCn Name="@viewport.IconName" Size="14" Class="relative z-10 size-3.5" />
                    </button>
                }
            </div>

            @* Right: undo/redo + preview + publish *@
            <div class="flex shrink-0 items-center gap-1">
                <ButtonCn aria-label="Undo" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0 text-muted-foreground">
                    <LucideIconCn Name="undo-2" Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn aria-label="Redo" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0 text-muted-foreground">
                    <LucideIconCn Name="redo-2" Size="14" Class="size-3.5" />
                </ButtonCn>

                <div class="mx-1 h-4 w-px bg-border" />

                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Preview
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="globe" Size="12" Class="size-3" />
                    Publish
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private string _activeViewport = "desktop";

    private record ViewportOption(string Id, string IconName, string Label);

    private static readonly ViewportOption[] _viewports =
    [
        new("desktop", "monitor", "Desktop"),
        new("tablet", "tablet", "Tablet"),
        new("mobile", "smartphone", "Mobile"),
    ];
}
