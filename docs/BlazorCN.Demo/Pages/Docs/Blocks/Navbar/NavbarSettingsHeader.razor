@* ============================================================
   Block: navbar-settings-header
   Title: NavbarSettingsHeader
   Description: A settings page header navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Settings page title with icon, horizontal tab navigation with animated active underline for General, Security, Billing, Notifications, API, and Team tabs, and a Save Changes button that enables when changes are detected, animated with framer-motion.
   Source: original/blocks/navbar/navbar-settings-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header row *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Settings</span>
            <div class="flex-1"></div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                      Disabled="@(!_hasChanges)"
                      OnClick="@(() => _hasChanges = false)">
                Save Changes
            </ButtonCn>
            @* Hidden trigger for demo *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-muted-foreground text-xs"
                      OnClick="@(() => _hasChanges = true)">
                Edit
            </ButtonCn>
        </div>

        @* Tab navigation *@
        <div class="relative px-4">
            <div class="flex items-center gap-1">
                @foreach (var tab in _tabs)
                {
                    var tabItem = tab;
                    var isActive = _activeTab == tabItem.Id;
                    <button type="button"
                            @onclick="@(() => _activeTab = tabItem.Id)"
                            class="@Cn.Merge("relative px-3 py-2.5 text-xs transition-colors", isActive ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                        @tabItem.Label
                        @if (isActive)
                        {
                            <span class="absolute inset-x-0 bottom-0 h-0.5 bg-foreground"></span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TabItem(string Id, string Label);

    private static readonly TabItem[] _tabs =
    [
        new("general", "General"),
        new("security", "Security"),
        new("billing", "Billing"),
        new("notifications", "Notifications"),
        new("api", "API"),
        new("team", "Team"),
    ];

    private string _activeTab = "general";
    private bool _hasChanges = false;
}
