@* ============================================================
   Block: navbar-music-streaming
   Title: NavbarMusicStreaming
   Description: A music streaming navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Wavelength brand logo, Browse, Library, Playlists, and Podcasts navigation, a mini now-playing indicator with track name and play/pause toggle, and a user avatar with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-music-streaming.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="audio-lines" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">Wavelength</span>
            </div>

            @* Nav links *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isActive = _activeLink == lbl;
                    <button type="button"
                            class="@Cn.Merge("relative shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", isActive ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeLink = lbl)">
                        @lbl
                        @if (isActive)
                        {
                            <span class="absolute inset-x-2.5 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Now playing indicator *@
            <div class="flex shrink-0 items-center gap-2 rounded-md bg-muted/50 py-1.5 pr-1.5 pl-3">
                <div class="flex items-center gap-2">
                    @* Animated bars (static approximation without framer-motion) *@
                    <div class="flex items-end gap-px">
                        @if (_isPlaying)
                        {
                            <span class="w-[2px] rounded-full bg-foreground" style="height:10px"></span>
                            <span class="w-[2px] rounded-full bg-foreground" style="height:14px"></span>
                            <span class="w-[2px] rounded-full bg-foreground" style="height:8px"></span>
                        }
                        else
                        {
                            <span class="w-[2px] rounded-full bg-foreground" style="height:4px"></span>
                            <span class="w-[2px] rounded-full bg-foreground" style="height:4px"></span>
                            <span class="w-[2px] rounded-full bg-foreground" style="height:4px"></span>
                        }
                    </div>
                    <div class="flex flex-col">
                        <span class="max-w-[120px] truncate font-medium text-xs">Midnight Circuit</span>
                        <span class="max-w-[120px] truncate text-[10px] text-muted-foreground">Neon Drift</span>
                    </div>
                </div>
                <ButtonCn aria-label="Play or pause Midnight Circuit" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" OnClick="@(() => _isPlaying = !_isPlaying)">
                    @if (_isPlaying)
                    {
                        <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                    }
                    else
                    {
                        <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>

            @* User avatar *@
            <AvatarCn Class="size-7 text-[10px]">
                <AvatarFallbackCn>JD</AvatarFallbackCn>
            </AvatarCn>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Browse", "#browse"),
        new("Library", "#library"),
        new("Playlists", "#playlists"),
        new("Podcasts", "#podcasts"),
    ];

    private string _activeLink = "Browse";
    private bool _isPlaying = true;
}
