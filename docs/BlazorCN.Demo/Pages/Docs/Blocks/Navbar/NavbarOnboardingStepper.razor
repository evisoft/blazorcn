@* ============================================================
   Block: navbar-onboarding-stepper
   Title: NavbarOnboardingStepper
   Description: An onboarding flow navigation bar with step progress built with React, Next.js, shadcn/ui, and Tailwind CSS. Features four sequential steps with checkmarks for completed, highlighted current step, muted future steps, animated connector lines, and progress percentage display with framer-motion transitions.
   Source: original/blocks/navbar/navbar-onboarding-stepper.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo + Progress *@
            <div class="flex shrink-0 items-center gap-3">
                <span class="font-medium text-sm">Acme</span>
                <div class="hidden items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1 sm:flex">
                    <span class="font-medium text-xs tabular-nums">@_progress%</span>
                    <span class="text-muted-foreground text-xs">complete</span>
                </div>
            </div>

            @* Center: Steps *@
            <div class="flex items-center gap-1">
                @foreach (var step in _steps)
                {
                    var s = step;
                    var idx = Array.IndexOf(_steps, s);
                    var isCompleted = s.Id < _currentStep;
                    var isCurrent = s.Id == _currentStep;
                    var isFuture = s.Id > _currentStep;

                    <div class="flex items-center">
                        @if (idx > 0)
                        {
                            <div class="mx-1.5 hidden h-px w-6 sm:block">
                                <div class="@Cn.Merge("h-full rounded-full", (isCompleted || isCurrent) ? "bg-foreground" : "bg-border")"></div>
                            </div>
                        }

                        <button type="button"
                                @onclick="@(() => { if (isCompleted) _currentStep = s.Id; })"
                                disabled="@(isFuture ? "disabled" : null)"
                                class="@Cn.Merge("flex items-center gap-2 rounded-md px-2.5 py-1.5 text-xs transition-colors", isCurrent ? "bg-muted/50 font-medium text-foreground" : isCompleted ? "cursor-pointer text-muted-foreground hover:bg-muted/50 hover:text-foreground" : "cursor-default text-muted-foreground/50")">
                            @* Step indicator *@
                            @if (isCompleted)
                            {
                                <span class="flex size-5 items-center justify-center rounded-full bg-foreground">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-background" />
                                </span>
                            }
                            else if (isCurrent)
                            {
                                <span class="flex size-5 items-center justify-center rounded-full border-2 border-foreground">
                                    <span class="size-1.5 rounded-full bg-foreground"></span>
                                </span>
                            }
                            else
                            {
                                <span class="flex size-5 items-center justify-center rounded-full border border-border">
                                    <span class="font-mono text-[10px] text-muted-foreground/50">@s.Id</span>
                                </span>
                            }

                            @* Step label *@
                            <span class="hidden sm:inline">@s.Label</span>
                        </button>
                    </div>
                }
            </div>

            @* Right: Actions *@
            <div class="flex shrink-0 items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="log-out" Size="12" Class="size-3" />
                    <span class="hidden sm:inline">Exit</span>
                </ButtonCn>
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record Step(int Id, string Label, string Description);

    private static readonly Step[] _steps =
    [
        new(1, "Account", "Create your account"),
        new(2, "Profile", "Set up your profile"),
        new(3, "Workspace", "Configure workspace"),
        new(4, "Invite Team", "Add team members"),
    ];

    private int _currentStep = 2;

    private int _progress => (int)Math.Round((_currentStep - 1.0) / _steps.Length * 100);
}
