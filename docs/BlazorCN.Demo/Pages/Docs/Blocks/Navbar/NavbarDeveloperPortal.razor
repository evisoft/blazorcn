@* ============================================================
   Block: navbar-developer-portal
   Title: NavbarDeveloperPortal
   Description: A developer portal navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a DevHub logo, Documentation, API Reference, SDKs, Changelog, and Status nav links, a monospace API key indicator, and a Dashboard button with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-developer-portal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">DevHub</span>
            </div>

            @* Nav links *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    <button type="button"
                            @onclick="@(() => _activeLink = link.Label)"
                            class="@Cn.Merge("flex shrink-0 items-center gap-1.5 rounded-md px-2 py-1.5 text-xs transition-colors", _activeLink == link.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        @link.Label
                        @if (link.HasStatus)
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                    </button>
                }
            </div>

            @* API key indicator *@
            <button type="button"
                    @onclick="HandleCopy"
                    class="flex shrink-0 items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                <span class="font-mono text-muted-foreground text-xs">sk_live_••••4f2a</span>
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                }
                else
                {
                    <LucideIconCn Name="copy" Size="12" Class="size-3 text-muted-foreground" />
                }
            </button>

            @* Dashboard button *@
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Dashboard
            </ButtonCn>
        </nav>
    </div>
</section>

@code {
    private string _activeLink = "Documentation";
    private bool _copied = false;

    private record NavLink(string Label, string Href, bool HasStatus = false);

    private static readonly NavLink[] _navLinks =
    [
        new("Documentation", "#docs"),
        new("API Reference",  "#api"),
        new("SDKs",           "#sdks"),
        new("Changelog",      "#changelog"),
        new("Status",         "#status", HasStatus: true),
    ];

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
