@* ============================================================
   Block: navbar-booking-system
   Title: NavbarBookingSystem
   Description: A booking and scheduling navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a BookIt logo, Dashboard, Availability, Bookings, and Clients nav links, an upcoming appointment indicator showing the next meeting, and a New Booking button with calendar icon using framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-booking-system.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="calendar-plus" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">BookIt</span>
            </div>

            @* Nav links *@
            <div class="hidden min-w-0 flex-1 items-center gap-1 sm:flex">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    <button
                        type="button"
                        @onclick="@(() => _activeLink = link.Label)"
                        class="@($"flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs transition-colors {(_activeLink == link.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")}")">
                        <LucideIconCn Name="@link.Icon" Size="14" Class="size-3.5" />
                        @link.Label
                    </button>
                }
            </div>

            @* Right: Next appointment + New booking *@
            <div class="flex shrink-0 items-center gap-2">
                @* Upcoming appointment indicator *@
                <div class="hidden items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 lg:flex">
                    <span class="text-muted-foreground text-xs">Next:</span>
                    <div class="flex items-center gap-1.5">
                        <span class="font-mono font-medium text-xs">@_nextAppointmentTime</span>
                        <span class="text-muted-foreground text-xs">—</span>
                        <span class="text-xs">@_nextAppointmentClient</span>
                    </div>
                    <span class="size-1.5 rounded-full bg-emerald-500" />
                </div>

                @* New Booking button *@
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    New Booking
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private string _activeLink = "Dashboard";

    private const string _nextAppointmentTime = "2:30 PM";
    private const string _nextAppointmentClient = "Sarah K.";

    private record NavLink(string Label, string Href, string Icon);

    private static readonly NavLink[] _navLinks =
    [
        new("Dashboard", "#dashboard", "layout-dashboard"),
        new("Availability", "#availability", "clock"),
        new("Bookings", "#bookings", "calendar"),
        new("Clients", "#clients", "users"),
    ];
}
