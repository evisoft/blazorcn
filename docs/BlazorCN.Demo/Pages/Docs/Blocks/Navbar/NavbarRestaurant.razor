@* ============================================================
   Block: navbar-restaurant
   Title: NavbarRestaurant
   Description: A restaurant and food ordering navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a bistro logo, navigation links for menu, reservations, catering, and about, a location indicator with downtown pin, order bag icon with item count, and an Order Now CTA button using framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-restaurant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo and nav *@
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm tracking-tight">Bistro &amp; Co</span>

                <div class="hidden items-center gap-1 sm:flex">
                    @foreach (var link in _navLinks)
                    {
                        var lbl = link.Label;
                        var isActive = _activeLink == lbl;
                        <button type="button"
                                class="@Cn.Merge("relative rounded-md px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeLink = lbl)">
                            @lbl
                            @if (isActive)
                            {
                                <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* Right: Location, bag, order button *@
            <div class="flex items-center gap-2">
                @* Location indicator *@
                <div class="hidden items-center gap-1 rounded-md bg-muted/50 px-2.5 py-1 sm:flex">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">@_currentLocation</span>
                </div>

                @* Order bag *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative size-8 shrink-0 p-0">
                    <LucideIconCn Name="shopping-bag" Size="16" Class="size-4 text-muted-foreground" />
                    @if (_orderCount > 0)
                    {
                        <span class="absolute -right-0.5 -top-0.5 flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                            @_orderCount
                        </span>
                    }
                </ButtonCn>

                @* Order CTA *@
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">
                    Order Now
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Menu", "#menu"),
        new("Reservations", "#reservations"),
        new("Catering", "#catering"),
        new("About", "#about"),
    ];

    private static readonly int _orderCount = 2;
    private static readonly string _currentLocation = "Downtown";

    private string _activeLink = "Menu";
}
