@* ============================================================
   Block: navbar-language-switcher
   Title: NavbarLanguageSwitcher
   Description: A navigation bar with language and locale dropdown selector built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a globe icon trigger showing the current language with flag emoji, a dropdown listing six languages with flags, and smooth selection updates using framer-motion animations.
   Source: original/blocks/navbar/navbar-language-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <span class="font-medium text-sm">Acme Inc</span>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    <a href="@link.Href"
                       class="px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        @link.Label
                    </a>
                }
            </div>

            @* Language switcher *@
            <div class="relative">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-2 px-2.5 text-muted-foreground"
                          @onclick="@(() => _dropdownOpen = !_dropdownOpen)">
                    <LucideIconCn Name="globe" Size="16" Class="size-4" />
                    <span class="text-xs">@_selectedLang.Flag @_selectedLang.Label</span>
                </ButtonCn>

                @if (_dropdownOpen)
                {
                    <div class="absolute right-0 z-50 mt-2 w-48 overflow-hidden rounded-md border bg-popover shadow-md">
                        <div class="p-1">
                            @foreach (var lang in _languages)
                            {
                                var isActive = _selectedLang.Code == lang.Code;
                                var capturedLang = lang;
                                <button type="button"
                                        class="@Cn.Merge("flex w-full items-center gap-2.5 rounded-sm px-2 py-1.5 text-sm transition-colors hover:bg-muted", isActive ? "text-foreground" : "text-muted-foreground")"
                                        @onclick="@(() => SelectLang(capturedLang))">
                                    <span class="text-base">@lang.Flag</span>
                                    <span class="flex-1 text-left">@lang.Label</span>
                                    @if (isActive)
                                    {
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-foreground" />
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);
    private record Language(string Code, string Label, string Flag);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];

    private static readonly Language[] _languages =
    [
        new("en", "English", "\U0001F1FA\U0001F1F8"),
        new("es", "Español", "\U0001F1EA\U0001F1F8"),
        new("fr", "Français", "\U0001F1EB\U0001F1F7"),
        new("de", "Deutsch", "\U0001F1E9\U0001F1EA"),
        new("ja", "日本語", "\U0001F1EF\U0001F1F5"),
        new("ko", "한국어", "\U0001F1F0\U0001F1F7"),
    ];

    private Language _selectedLang = new("en", "English", "\U0001F1FA\U0001F1F8");
    private bool _dropdownOpen = false;

    private void SelectLang(Language lang)
    {
        _selectedLang = lang;
        _dropdownOpen = false;
    }
}
