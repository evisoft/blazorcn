@* ============================================================
   Block: navbar-quick-actions
   Title: NavbarQuickActions
   Description: A navigation bar with quick action dropdown built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a plus icon that opens a dropdown with New Project, New Document, Import File, and Invite Member actions, each with an icon and keyboard shortcut hint. Inspired by GitHub's create menu.
   Source: original/blocks/navbar/navbar-quick-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo + Nav links *@
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm">Acme</span>
                <div class="hidden items-center gap-1 sm:flex">
                    @foreach (var link in _navLinks)
                    {
                        var lnk = link;
                        <button type="button"
                                class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", lnk == _navLinks[0] ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                            @lnk
                        </button>
                    }
                </div>
            </div>

            @* Right: Quick actions + Search + Notifications + Avatar *@
            <div class="flex items-center gap-1.5">
                @* Quick actions dropdown *@
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm h-7 w-7 p-0" data-variant="outline" data-size="sm" aria-label="Plus">
                            <LucideIconCn Name="plus" Size="16" Class="size-4" />
                        </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-56">
                        @foreach (var action in _quickActions)
                        {
                            var act = action;
                            <DropdownMenuItemCn Class="flex items-center justify-between gap-3 py-2">
                                <div class="flex items-center gap-2.5">
                                    <LucideIconCn Name="@act.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                    <div class="flex flex-col">
                                        <span class="text-sm">@act.Label</span>
                                        <span class="text-muted-foreground text-[11px]">@act.Description</span>
                                    </div>
                                </div>
                                <kbd class="ml-auto pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">
                                    @act.Shortcut
                                </kbd>
                            </DropdownMenuItemCn>
                            @if (act == _quickActions[1])
                            {
                                <DropdownMenuSeparatorCn />
                            }
                        }
                    </DropdownMenuContentCn>
                </DropdownMenuCn>

                <ButtonCn aria-label="Search" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>

                <ButtonCn aria-label="Notifications" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative h-7 w-7 p-0">
                    <LucideIconCn Name="bell" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="absolute top-0.5 right-0.5 size-1.5 rounded-full bg-red-500" />
                </ButtonCn>

                <div class="ml-1 h-4 w-px bg-border" />

                <AvatarCn Class="ml-1 size-6">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private static readonly string[] _navLinks = ["Dashboard", "Projects", "Teams", "Reports"];

    private record QuickAction(string Label, string Icon, string Shortcut, string Description);

    private static readonly QuickAction[] _quickActions =
    [
        new("New Project",    "folder-plus",  "N", "Create a new project workspace"),
        new("New Document",   "file-text",    "D", "Start a blank document"),
        new("Import File",    "import",       "I", "Import from file or URL"),
        new("Invite Member",  "user-plus",    "M", "Add someone to your team"),
    ];
}
