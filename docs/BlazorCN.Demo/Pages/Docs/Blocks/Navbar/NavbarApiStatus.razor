@* ============================================================
   Block: navbar-api-status
   Title: NavbarApiStatus
   Description: An API dashboard navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features an APIHub logo, Endpoints, Logs, Analytics, and Webhooks nav links, real-time latency and uptime indicators, and a live status dot with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-api-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">APIHub</span>
            </div>

            @* Nav links *@
            <div class="hidden min-w-0 flex-1 items-center gap-1 sm:flex">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    <button type="button"
                            @onclick="@(() => _activeLink = link.Label)"
                            class="@Cn.Merge("flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeLink == link.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        <LucideIconCn Name="@link.Icon" Size="14" Class="size-3.5" />
                        @link.Label
                    </button>
                }
            </div>

            @* Right: Status metrics *@
            <div class="flex shrink-0 items-center gap-3">
                @* Latency *@
                <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1.5">
                    <span class="text-muted-foreground text-xs">Latency</span>
                    <span class="font-mono font-medium text-emerald-600 text-xs dark:text-emerald-400">@_latency</span>
                </div>

                @* Uptime *@
                <div class="hidden items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1.5 sm:flex">
                    <span class="text-muted-foreground text-xs">Uptime</span>
                    <span class="font-mono font-medium text-xs">@_uptime</span>
                </div>

                @* Status indicator *@
                <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                    <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="font-medium text-xs">Operational</span>
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private string _activeLink = "Endpoints";
    private const string _latency = "42ms";
    private const string _uptime = "99.98%";

    private record NavLink(string Label, string Href, string Icon);

    private static readonly NavLink[] _navLinks =
    [
        new("Endpoints", "#endpoints", "network"),
        new("Logs",      "#logs",      "file-text"),
        new("Analytics", "#analytics", "bar-chart-3"),
        new("Webhooks",  "#webhooks",  "webhook"),
    ];
}
