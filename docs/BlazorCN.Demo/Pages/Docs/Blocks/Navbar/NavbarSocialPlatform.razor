@* ============================================================
   Block: navbar-social-platform
   Title: NavbarSocialPlatform
   Description: A social media platform navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Connect logo, feed and explore links, messages badge with unread count, groups link, center search bar, create post button, notifications bell, and user avatar with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-social-platform.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Logo *@
            <span class="shrink-0 font-medium text-sm">Connect</span>

            @* Nav links *@
            <div class="hidden items-center gap-1 sm:flex">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isActive = _activeLink == lbl;
                    <button type="button"
                            class="@Cn.Merge("relative flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeLink = lbl)">
                        @if (link.Icon != null)
                        {
                            <LucideIconCn Name="@link.Icon" Size="14" Class="size-3.5" />
                        }
                        @lbl
                        @if (link.Badge > 0)
                        {
                            <span class="flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                                @link.Badge
                            </span>
                        }
                        @if (isActive)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Center: Search *@
            <div class="mx-2 hidden flex-1 md:block">
                <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-1.5">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <input type="text"
                           placeholder="Search people, posts, and groups..."
                           class="h-5 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                </div>
            </div>

            @* Right actions *@
            <div class="ml-auto flex items-center gap-1">
                @* Create post *@
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    <span class="hidden sm:inline">Post</span>
                </ButtonCn>

                @* Notifications *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative size-8 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="absolute top-1.5 right-1.5 size-1.5 rounded-full bg-red-500"></span>
                </ButtonCn>

                @* User avatar *@
                <AvatarCn Class="ml-1 size-8">
                    <AvatarFallbackCn Class="text-[10px]">SC</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href, string? Icon, int Badge = 0);

    private static readonly NavLink[] _navLinks =
    [
        new("Feed", "#feed", null),
        new("Explore", "#explore", "compass"),
        new("Messages", "#messages", "message-circle", Badge: 3),
        new("Groups", "#groups", "users"),
    ];

    private string _activeLink = "Feed";
}
