@* ============================================================
   Block: navbar-floating-pill
   Title: NavbarFloatingPill
   Description: A floating pill-shaped navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a rounded-full container with shadow, compact nav links, logo, and CTA button centered on the page with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-floating-pill.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Simulated page background *@
        <div class="flex flex-col items-center bg-muted/20 px-6 py-12">
            @* Floating pill navbar *@
            <nav class="flex items-center gap-1 rounded-full border bg-background px-2 py-1.5 shadow-sm">
                @* Logo *@
                <div class="flex items-center gap-2 pl-2 pr-1">
                    <div class="flex size-6 items-center justify-center rounded-full bg-foreground">
                        <span class="font-semibold text-background text-xs">A</span>
                    </div>
                    <span class="pr-2 font-medium text-sm">Acme</span>
                </div>

                @* Divider *@
                <div class="mx-0.5 h-4 w-px bg-border"></div>

                @* Nav links *@
                <div class="flex items-center gap-0.5 px-1">
                    @foreach (var lnk in _navLinks)
                    {
                        var link = lnk;
                        var isActive = _activeLink == link.Label;
                        <a href="@link.Href"
                           class="relative rounded-full px-3 py-1 text-muted-foreground text-sm transition-colors hover:text-foreground"
                           @onmouseenter="@(() => _activeLink = link.Label)"
                           @onmouseleave="@(() => _activeLink = null)">
                            @if (isActive)
                            {
                                <span class="absolute inset-0 rounded-full bg-muted/60"></span>
                            }
                            <span class="relative z-10">@link.Label</span>
                        </a>
                    }
                </div>

                @* Divider *@
                <div class="mx-0.5 h-4 w-px bg-border"></div>

                @* CTA *@
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 rounded-full text-xs">
                    Get Started
                </ButtonCn>
            </nav>

            @* Simulated hero content below *@
            <div class="mt-12 flex flex-col items-center gap-3 text-center">
                <div class="h-2.5 w-48 rounded bg-muted/60"></div>
                <div class="h-2 w-72 rounded bg-muted/40"></div>
                <div class="h-2 w-56 rounded bg-muted/30"></div>
                <div class="mt-4 h-8 w-28 rounded-md bg-muted/50"></div>
            </div>
        </div>

        @* Info bar *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="text-muted-foreground text-xs">
                Floating pill layout with hover highlight animation
            </span>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
        new("Blog", "#blog"),
    ];

    private string? _activeLink = null;
}
