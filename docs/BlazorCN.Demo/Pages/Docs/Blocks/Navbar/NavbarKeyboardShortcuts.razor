@* ============================================================
   Block: navbar-keyboard-shortcuts
   Title: NavbarKeyboardShortcuts
   Description: A navigation bar with keyboard shortcut hints built with React, Next.js, shadcn/ui, and Tailwind CSS. Features nav items that reveal their keyboard shortcuts as Kbd badges on hover with smooth framer-motion transitions, functional shortcut listeners, and active state tracking.
   Source: original/blocks/navbar/navbar-keyboard-shortcuts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <span class="font-medium text-sm">Acme</span>
                <span class="text-muted-foreground/40">/</span>
                <span class="text-muted-foreground text-sm">Dashboard</span>
            </div>

            @* Center: Nav items with shortcut hints *@
            <div class="flex items-center gap-1">
                @foreach (var navItem in _navItems)
                {
                    var item = navItem;
                    var isActive = _activeItem == item.Id;
                    var isHovered = _hoveredItem == item.Id;
                    <button type="button"
                            class="@Cn.Merge("relative flex items-center gap-2 rounded-md px-2.5 py-1.5 text-xs transition-colors", isActive ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")"
                            @onclick="@(() => _activeItem = item.Id)"
                            @onmouseenter="@(() => _hoveredItem = item.Id)"
                            @onmouseleave="@(() => _hoveredItem = null)">
                        <LucideIconCn Name="@item.IconName" Size="14" Class="size-3.5" />
                        <span>@item.Label</span>
                        @* Shortcut badge on hover *@
                        @if (isHovered)
                        {
                            <span class="ml-0.5 flex items-center gap-0.5">
                                <KbdCn Class="h-4 min-w-4 text-[10px]">@("⌘")</KbdCn>
                                <KbdCn Class="h-4 min-w-4 text-[10px]">@item.ShortcutLabel</KbdCn>
                            </span>
                        }
                    </button>
                }
            </div>

            @* Right: Avatar *@
            <div class="flex shrink-0 items-center gap-2">
                <AvatarCn Class="size-6">
                    <AvatarImageCn Src="https://avatars.githubusercontent.com/u/1?v=4" Alt="User avatar" />
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavItem(string Id, string Label, string IconName, string ShortcutKey, string ShortcutLabel);

    private static readonly NavItem[] _navItems =
    [
        new("home", "Home", "home", "1", "1"),
        new("search", "Search", "search", "k", "K"),
        new("notifications", "Notifications", "bell", "n", "N"),
        new("settings", "Settings", "settings", ",", ","),
    ];

    private string _activeItem = "home";
    private string? _hoveredItem = null;
}
