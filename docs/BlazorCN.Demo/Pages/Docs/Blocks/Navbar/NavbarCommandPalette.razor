@* ============================================================
   Block: navbar-command-palette
   Title: NavbarCommandPalette
   Description: A navigation bar with a Cmd+K command palette built with React, Next.js, shadcn/ui Command component, and Tailwind CSS. Features grouped navigation items, actions, and settings with keyboard navigation hints and recently visited pages.
   Source: original/blocks/navbar/navbar-command-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <span class="font-medium text-sm">Acme Inc</span>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    <a href="@link.Href"
                       class="px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        @link.Label
                    </a>
                }
            </div>

            @* Command palette trigger + CTA *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-2 px-2 text-muted-foreground text-xs" @onclick="@(() => _isOpen = true)">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                    <span class="hidden sm:inline">Search</span>
                    <KbdCn Class="ml-1">
                        <span class="text-[10px]">&#8984;</span>K
                    </KbdCn>
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started
                </ButtonCn>
            </div>
        </nav>
    </div>

    @* Command palette dialog *@
    <DialogCn @bind-Open="_isOpen">
        <DialogContentCn Class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn Class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>

                    @* Recently visited *@
                    <CommandGroupCn Heading="Recently Visited">
                        @foreach (var page in _recentPages)
                        {
                            var pg = page;
                            <CommandItemCn OnSelect="@(() => _isOpen = false)" Class="flex items-center gap-2">
                                <LucideIconCn Name="@pg.IconName" Size="16" Class="size-4" />
                                <span>@pg.Label</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    @* Navigation *@
                    <CommandGroupCn Heading="Navigation">
                        @foreach (var navItem in _navigationItems)
                        {
                            var nv = navItem;
                            <CommandItemCn OnSelect="@(() => _isOpen = false)" Class="flex items-center gap-2">
                                <LucideIconCn Name="@nv.IconName" Size="16" Class="size-4" />
                                <span>@nv.Label</span>
                                <kbd class="ml-auto pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">
                                    @nv.Shortcut
                                </kbd>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    @* Actions *@
                    <CommandGroupCn Heading="Actions">
                        @foreach (var actionItem in _actionItems)
                        {
                            var act = actionItem;
                            <CommandItemCn OnSelect="@(() => _isOpen = false)" Class="flex items-center gap-2">
                                <LucideIconCn Name="@act.IconName" Size="16" Class="size-4" />
                                <span>@act.Label</span>
                                <kbd class="ml-auto pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">
                                    @act.Shortcut
                                </kbd>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    @* Settings *@
                    <CommandGroupCn Heading="Settings">
                        @foreach (var settingItem in _settingsItems)
                        {
                            var st = settingItem;
                            <CommandItemCn OnSelect="@(() => _isOpen = false)" Class="flex items-center gap-2">
                                <LucideIconCn Name="@st.IconName" Size="16" Class="size-4" />
                                <span>@st.Label</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _isOpen = false;

    private record NavLink(string Label, string Href);
    private record RecentPage(string Label, string IconName);
    private record NavItem(string Label, string IconName, string Shortcut);
    private record ActionItem(string Label, string IconName, string Shortcut);
    private record SettingItem(string Label, string IconName);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];

    private static readonly RecentPage[] _recentPages =
    [
        new("Dashboard Overview", "layout-dashboard"),
        new("Team Settings", "users"),
        new("API Documentation", "book-open"),
    ];

    private static readonly NavItem[] _navigationItems =
    [
        new("Dashboard", "layout-dashboard", "G D"),
        new("Projects", "file-text", "G P"),
        new("Team Members", "users", "G T"),
        new("Documentation", "book-open", "G O"),
    ];

    private static readonly ActionItem[] _actionItems =
    [
        new("Create New Project", "circle-plus", "C"),
        new("Invite Team Member", "users", "I"),
    ];

    private static readonly SettingItem[] _settingsItems =
    [
        new("General Settings", "settings"),
        new("Billing", "credit-card"),
        new("Appearance", "palette"),
        new("Sign Out", "log-out"),
    ];
}
