@* ============================================================
   Block: navbar-email-client
   Title: NavbarEmailClient
   Description: An email client navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features an Inbox logo, compose button, center search bar for searching all mail, filter toggle, settings gear icon, grid app launcher icon, and user avatar with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-email-client.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Left: Logo + Compose *@
            <div class="flex shrink-0 items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="mail" Size="16" Class="size-4 text-foreground" />
                    <span class="font-medium text-sm">Inbox</span>
                </div>

                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="pen-square" Size="14" Class="size-3.5" />
                    Compose
                </ButtonCn>
            </div>

            @* Center: Search bar *@
            <div class="mx-2 hidden flex-1 md:block">
                <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-1.5">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <input
                        type="text"
                        value="@_searchValue"
                        @oninput="@((e) => _searchValue = e.Value?.ToString() ?? "")"
                        placeholder="Search all mail..."
                        aria-label="Search all mail"
                        class="h-5 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                </div>
            </div>

            @* Right: Actions *@
            <div class="ml-auto flex items-center gap-1">
                @* Filter toggle *@
                <ButtonCn aria-label="Search filters"
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    Class="@Cn.Merge("relative size-8 p-0", _filterActive ? "text-foreground" : "")"
                    OnClick="@(() => _filterActive = !_filterActive)">
                    <LucideIconCn Name="sliders-horizontal" Size="16" Class="size-4 text-muted-foreground" />
                    @if (_filterActive)
                    {
                        <span class="absolute top-1.5 right-1.5 size-1.5 rounded-full bg-blue-500"></span>
                    }
                </ButtonCn>

                @* Settings *@
                <ButtonCn aria-label="Settings" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                    <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                @* App launcher grid *@
                <ButtonCn aria-label="Apps" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                    <LucideIconCn Name="grid" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                @* User avatar *@
                <AvatarCn Class="ml-1 size-7">
                    <AvatarFallbackCn Class="text-[10px]">AL</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private bool _filterActive = false;
    private string _searchValue = "";
}
