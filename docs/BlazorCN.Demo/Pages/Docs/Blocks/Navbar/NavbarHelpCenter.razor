@* ============================================================
   Block: navbar-help-center
   Title: NavbarHelpCenter
   Description: A help center and support navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Help Center logo, prominent search bar with placeholder, category navigation for Getting Started, Account, Billing, API, and Troubleshooting, a Contact Support button, and user avatar with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-help-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Top row: logo + search + actions *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="circle-help" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Help Center</span>
            </div>

            @* Search bar *@
            <div class="relative mx-auto w-full max-w-sm">
                <LucideIconCn Name="search" Size="14" Class="absolute left-3 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <input
                    type="text"
                    placeholder="How can we help?"
                    class="h-8 w-full rounded-md border bg-muted/30 pl-9 pr-3 text-xs text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"
                    @onfocus="@(() => _searchFocused = true)"
                    @onblur="@(() => _searchFocused = false)" />
            </div>

            @* Right: contact + avatar *@
            <div class="flex shrink-0 items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Contact Support
                </ButtonCn>
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </div>

        @* Bottom row: category navigation *@
        <nav class="flex items-center gap-1 px-4 py-2">
            @foreach (var cat in _categories)
            {
                var category = cat;
                <button
                    type="button"
                    @onclick="@(() => _activeCategory = category.Label)"
                    class="@Cn.Merge("shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeCategory == category.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                    @category.Label
                </button>
            }
        </nav>
    </div>
</section>

@code {
    private record Category(string Label, string Href);

    private static readonly Category[] _categories =
    [
        new("Getting Started", "#getting-started"),
        new("Account", "#account"),
        new("Billing", "#billing"),
        new("API", "#api"),
        new("Troubleshooting", "#troubleshooting"),
    ];

    private string _activeCategory = "Getting Started";
    private bool _searchFocused = false;
}
