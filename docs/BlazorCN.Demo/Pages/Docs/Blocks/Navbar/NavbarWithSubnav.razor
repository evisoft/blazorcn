@* ============================================================
   Block: navbar-with-subnav
   Title: NavbarWithSubnav
   Description: A dual-tier navigation bar with primary and secondary sub-navigation built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a main navbar with logo and section links, plus a context-sensitive secondary row that swaps content based on the active primary section using framer-motion transitions.
   Source: original/blocks/navbar/navbar-with-subnav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Primary navbar *@
        <nav class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm">Acme</span>
                <div class="flex items-center gap-1">
                    @foreach (var sec in _primarySections)
                    {
                        var isActive = _activeSection == sec;
                        var sectionName = sec;
                        <button type="button"
                                class="@Cn.Merge("relative rounded-md px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => SetActiveSection(sectionName))">
                            @sectionName
                            @if (isActive)
                            {
                                <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                            }
                        </button>
                    }
                </div>
            </div>

            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                    Sign in
                </ButtonCn>
                <AvatarCn Class="size-6">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>

        @* Secondary sub-navigation *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-1">
                @foreach (var item in GetSubNavItems())
                {
                    <a href="@item.Href"
                       class="rounded-md px-2.5 py-1 text-muted-foreground text-xs transition-colors hover:bg-muted/50 hover:text-foreground">
                        @item.Label
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SubNavItem(string Label, string Href);

    private static readonly string[] _primarySections = ["Platform", "Solutions", "Pricing", "Company"];

    private static readonly Dictionary<string, SubNavItem[]> _subNavItems = new()
    {
        ["Platform"] =
        [
            new("Overview", "#overview"),
            new("Infrastructure", "#infrastructure"),
            new("Integrations", "#integrations"),
            new("Security", "#security"),
            new("Changelog", "#changelog"),
        ],
        ["Solutions"] =
        [
            new("Startups", "#startups"),
            new("Enterprise", "#enterprise"),
            new("E-commerce", "#ecommerce"),
            new("SaaS", "#saas"),
            new("Healthcare", "#healthcare"),
        ],
        ["Pricing"] =
        [
            new("Plans", "#plans"),
            new("Compare", "#compare"),
            new("Calculator", "#calculator"),
            new("Enterprise Quote", "#enterprise-quote"),
        ],
        ["Company"] =
        [
            new("About", "#about"),
            new("Blog", "#blog"),
            new("Careers", "#careers"),
            new("Contact", "#contact"),
            new("Press", "#press"),
        ],
    };

    private string _activeSection = "Platform";

    private void SetActiveSection(string sectionName)
    {
        _activeSection = sectionName;
    }

    private SubNavItem[] GetSubNavItems()
    {
        return _subNavItems.TryGetValue(_activeSection, out var items) ? items : [];
    }
}
