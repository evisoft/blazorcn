@* ============================================================
   Block: navbar-kanban-board
   Title: NavbarKanbanBoard
   Description: A kanban board navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a board name with star/favorite toggle, clickable filter pills for Priority, Assignee, and Label, view toggles for Board, List, and Timeline, an Add Card button, and member avatar stack with framer-motion animations.
   Source: original/blocks/navbar/navbar-kanban-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Left: Board name + favorite *@
            <div class="flex shrink-0 items-center gap-2">
                <span class="font-medium text-sm">Sprint 23</span>
                <button
                    type="button"
                    @onclick="@(() => _isFavorited = !_isFavorited)"
                    class="rounded-sm p-0.5 transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", _isFavorited ? "fill-amber-400 text-amber-400" : "text-muted-foreground")" />
                </button>
            </div>

            @* Center: Filter pills *@
            <div class="flex min-w-0 flex-1 items-center justify-center gap-1">
                @foreach (var filter in _filters)
                {
                    var f = filter;
                    <button
                        type="button"
                        @onclick="@(() => ToggleFilter(f.Label))"
                        class="@Cn.Merge("flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs transition-colors", _activeFilters.Contains(f.Label) ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted hover:text-foreground")">
                        <LucideIconCn Name="@f.IconName" Size="12" Class="size-3" />
                        @f.Label
                    </button>
                }
            </div>

            @* Right: View toggles, add card, members *@
            <div class="flex shrink-0 items-center gap-2">
                @* View toggles *@
                <div class="hidden items-center rounded-md bg-muted/50 p-0.5 sm:flex">
                    @foreach (var view in _views)
                    {
                        var v = view;
                        <button
                            type="button"
                            @onclick="@(() => _activeView = v.Label)"
                            class="@Cn.Merge("relative rounded-sm p-1.5 transition-colors", _activeView == v.Label ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                            @if (_activeView == v.Label)
                            {
                                <span class="absolute inset-0 rounded-sm bg-background shadow-sm"></span>
                            }
                            <LucideIconCn Name="@v.IconName" Size="14" Class="relative z-10 size-3.5" />
                        </button>
                    }
                </div>

                @* Add card *@
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add Card
                </ButtonCn>

                @* Member avatars *@
                <div class="hidden items-center -space-x-1.5 sm:flex">
                    @foreach (var member in _members)
                    {
                        <AvatarCn Class="border-2 border-card size-6">
                            <AvatarFallbackCn Class="text-[9px]">@member.Initials</AvatarFallbackCn>
                        </AvatarCn>
                    }
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private record FilterItem(string Label, string IconName);
    private record ViewItem(string Label, string IconName);
    private record MemberItem(string Initials, string Name);

    private static readonly FilterItem[] _filters =
    [
        new("Priority", "filter"),
        new("Assignee", "user"),
        new("Label", "filter"),
    ];

    private static readonly ViewItem[] _views =
    [
        new("Board", "kanban"),
        new("List", "layout-list"),
        new("Timeline", "gantt-chart"),
    ];

    private static readonly MemberItem[] _members =
    [
        new("AK", "Alex Kim"),
        new("SR", "Sarah Reeves"),
        new("MT", "Mike Torres"),
        new("JL", "Jenny Lee"),
    ];

    private bool _isFavorited = false;
    private string _activeView = "Board";
    private List<string> _activeFilters = [];

    private void ToggleFilter(string label)
    {
        if (_activeFilters.Contains(label))
            _activeFilters.Remove(label);
        else
            _activeFilters.Add(label);
    }
}
