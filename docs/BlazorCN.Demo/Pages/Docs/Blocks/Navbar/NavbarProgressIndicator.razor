@* ============================================================
   Block: navbar-progress-indicator
   Title: NavbarProgressIndicator
   Description: A navigation bar with animated progress indicator built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a thin progress bar at the top showing profile completion percentage, a logo, nav links, a completion status label, and a Complete Profile call-to-action button, all animated with framer-motion.
   Source: original/blocks/navbar/navbar-progress-indicator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Progress bar *@
        <div class="h-1 w-full bg-muted/50">
            <div class="h-full bg-foreground transition-all duration-700 ease-out"
                 style="@($"width:{_progress}%")">
            </div>
        </div>

        @* Nav content *@
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <span class="shrink-0 font-medium text-sm">Workspace</span>

            @* Nav links *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isActive = _activeLink == lbl;
                    <button type="button"
                            @onclick="@(() => _activeLink = lbl)"
                            class="@Cn.Merge("shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", isActive ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        @lbl
                    </button>
                }
            </div>

            @* Progress status + CTA *@
            <div class="flex shrink-0 items-center gap-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">
                        Profile:&#160;<span class="font-medium tabular-nums text-foreground">@_progress%</span>
                    </span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Complete Profile
                </ButtonCn>
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Home", "#home"),
        new("Projects", "#projects"),
        new("Team", "#team"),
        new("Docs", "#docs"),
    ];

    private const int _progress = 70;
    private string _activeLink = "Home";
}
