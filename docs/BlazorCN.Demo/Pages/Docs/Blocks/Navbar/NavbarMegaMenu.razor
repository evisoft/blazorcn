@* ============================================================
   Block: navbar-mega-menu
   Title: NavbarMegaMenu
   Description: A full mega menu navbar with dropdown panels for React, Next.js, shadcn/ui, and Tailwind CSS. Hovering over navigation items reveals rich content grids with product icons, descriptions, blog links, and resource sections using AnimatePresence transitions.
   Source: original/blocks/navbar/navbar-mega-menu.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Navbar *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-6">
                    <span class="font-medium text-sm">Acme</span>
                    <nav class="flex items-center gap-1">
                        @foreach (var item in _navItems)
                        {
                            var navItem = item;
                            <div @onmouseenter="@(() => HandleEnter(navItem.Label))"
                                 @onmouseleave="HandleLeave">
                                <button type="button"
                                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _active == navItem.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                                    @navItem.Label
                                </button>
                            </div>
                        }
                        @foreach (var lnk in _plainLinks)
                        {
                            var plainLink = lnk;
                            <button type="button"
                                    class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                                    @onmouseenter="@(() => { _active = null; })">
                                @plainLink
                            </button>
                        }
                    </nav>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        Sign in
                    </button>
                    <button type="button"
                            class="rounded-md bg-foreground px-3 py-1.5 text-background text-sm transition-colors hover:bg-foreground/90">
                        Get started
                    </button>
                </div>
            </div>

            @* Mega menu panel *@
            @{
                var activeItem = System.Array.Find(_navItems, it => it.Label == _active);
            }
            @if (activeItem != null)
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card"
                     @onmouseenter="@(() => HandleEnter(activeItem.Label))"
                     @onmouseleave="HandleLeave">
                    <div class="grid grid-cols-2 gap-1 p-2 sm:grid-cols-3">
                        @foreach (var menuItem in activeItem.Items)
                        {
                            var mi = menuItem;
                            <button type="button"
                                    class="flex items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                <span class="mt-0.5 text-muted-foreground">
                                    <LucideIconCn Name="@mi.IconName" Size="16" Class="size-4" />
                                </span>
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@mi.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@mi.Description</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">Hover the nav items above</span>
                <span class="text-muted-foreground/60 text-xs">
                    Products and Resources have mega menu dropdowns
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record MegaMenuItem(string IconName, string Title, string Description);
    private record NavItem(string Label, MegaMenuItem[] Items);

    private static readonly NavItem[] _navItems =
    [
        new("Products", [
            new("layout-dashboard", "Analytics", "Real-time dashboards and reporting"),
            new("brain-circuit", "AI Engine", "Machine learning pipeline tools"),
            new("shield-check", "Security", "Threat detection and compliance"),
            new("zap", "Automation", "Workflow orchestration platform"),
            new("blocks", "Integrations", "Connect with 200+ services"),
            new("bar-chart-3", "Metrics", "Performance monitoring suite"),
        ]),
        new("Resources", [
            new("book-open", "Documentation", "Guides, references, and tutorials"),
            new("newspaper", "Blog", "Engineering insights and updates"),
            new("graduation-cap", "Academy", "Free courses and certifications"),
            new("message-circle", "Community", "Join 50k+ developers on Discord"),
            new("file-text", "Changelog", "Latest releases and improvements"),
            new("users", "Case Studies", "How teams ship faster with us"),
        ]),
    ];

    private static readonly string[] _plainLinks = ["Pricing", "Enterprise", "Contact"];

    private string? _active = null;

    private void HandleEnter(string label)
    {
        _active = label;
    }

    private void HandleLeave()
    {
        _active = null;
    }
}
