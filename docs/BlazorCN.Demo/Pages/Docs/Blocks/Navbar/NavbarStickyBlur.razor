@* ============================================================
   Block: navbar-sticky-blur
   Title: NavbarStickyBlur
   Description: A sticky navigation bar with backdrop blur effect built with React, Next.js, shadcn/ui, and Tailwind CSS. Features smooth transitions between transparent top state and frosted glass scrolled state with framer-motion animations.
   Source: original/blocks/navbar/navbar-sticky-blur.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <nav class="relative flex items-center justify-between px-6 py-3 transition-all duration-300"
             style="@NavStyle">
            @* Logo *@
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded bg-foreground">
                    <span class="font-semibold text-background text-xs">A</span>
                </div>
                <span class="font-medium text-sm">Acme</span>
            </div>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    <a href="@link.Href"
                       class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @lbl
                        @if (_hoveredLink == lbl)
                        {
                            <span class="absolute inset-x-1 -bottom-0.5 mx-2 h-px bg-foreground/50 transition-all duration-200"></span>
                        }
                    </a>
                }
            </div>

            @* Actions *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Sign In
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started
                </ButtonCn>
            </div>

            @* Blur indicator overlay *@
            @if (_scrolled)
            {
                <div class="absolute inset-0 -z-10 rounded-t-lg bg-background/80 backdrop-blur-lg transition-opacity duration-200"></div>
            }
        </nav>

        @* Simulated page content *@
        <div class="space-y-3 border-t px-6 py-8">
            <div class="h-2 w-3/4 rounded bg-muted/60"></div>
            <div class="h-2 w-1/2 rounded bg-muted/40"></div>
            <div class="h-2 w-2/3 rounded bg-muted/50"></div>
            <div class="h-2 w-1/3 rounded bg-muted/30"></div>
            <div class="h-2 w-3/5 rounded bg-muted/40"></div>
        </div>

        @* State toggle *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="@($"size-1.5 rounded-full {(_scrolled ? "bg-blue-500" : "bg-muted-foreground/40")}")"></span>
                <span class="text-muted-foreground text-xs">
                    @(_scrolled ? "Scrolled — blur + border active" : "At top — clean, no blur")
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@ToggleScrolled">
                @(_scrolled ? "Show top state" : "Show scrolled state")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
        new("Blog", "#blog"),
    ];

    private bool _scrolled = false;
    private string? _hoveredLink = null;

    private string NavStyle => _scrolled
        ? "background-color:color-mix(in oklab, var(--background) 80%, transparent);border-bottom-width:1px;border-bottom-color:var(--border);backdrop-filter:blur(16px);"
        : "background-color:color-mix(in oklab, var(--background) 0%, transparent);border-bottom-width:0;border-bottom-color:transparent;backdrop-filter:blur(0px);";

    private void ToggleScrolled()
    {
        _scrolled = !_scrolled;
    }
}
