@* ============================================================
   Block: navbar-mega-menu-grid
   Title: NavbarMegaMenuGrid
   Description: A mega menu navbar with clean grid-layout dropdowns built with React, Next.js, shadcn/ui, and Tailwind CSS. Products dropdown reveals a 3-column grid of product cards with icons and descriptions, Solutions shows a 2-column industry grid, each with footer links using framer-motion AnimatePresence transitions.
   Source: original/blocks/navbar/navbar-mega-menu-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Navbar *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-6">
                    <span class="font-medium text-sm">Acme</span>
                    <nav class="flex items-center gap-1">
                        @foreach (var lbl in _dropdownLabels)
                        {
                            var label = lbl;
                            <div @onmouseenter="@(() => HandleEnter(label))"
                                 @onmouseleave="HandleLeave">
                                <button type="button"
                                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _active == label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                                    @label
                                </button>
                            </div>
                        }
                        @foreach (var lnk in _plainLinks)
                        {
                            var plainLink = lnk;
                            <button type="button"
                                    class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                                    @onmouseenter="@(() => { _active = null; })">
                                @plainLink
                            </button>
                        }
                    </nav>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        Sign in
                    </button>
                    <button type="button"
                            class="rounded-md bg-foreground px-3 py-1.5 text-background text-sm transition-colors hover:bg-foreground/90">
                        Get started
                    </button>
                </div>
            </div>

            @* Mega menu panels *@
            @if (_active == "Products")
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card"
                     @onmouseenter="@(() => HandleEnter("Products"))"
                     @onmouseleave="HandleLeave">
                    <div class="grid grid-cols-3 gap-1 p-2">
                        @foreach (var itm in _products)
                        {
                            var item = itm;
                            <button type="button"
                                    class="flex items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                <span class="mt-0.5 text-muted-foreground">
                                    <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                                </span>
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@item.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                </div>
                            </button>
                        }
                    </div>
                    <div class="border-t px-4 py-2.5">
                        <button type="button"
                                class="flex items-center gap-1 text-muted-foreground text-xs transition-colors hover:text-foreground">
                            View all products
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                        </button>
                    </div>
                </div>
            }

            @if (_active == "Solutions")
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card"
                     @onmouseenter="@(() => HandleEnter("Solutions"))"
                     @onmouseleave="HandleLeave">
                    <div class="grid grid-cols-2 gap-1 p-2">
                        @foreach (var itm in _solutions)
                        {
                            var item = itm;
                            <button type="button"
                                    class="flex items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                <span class="mt-0.5 text-muted-foreground">
                                    <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                                </span>
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@item.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                </div>
                            </button>
                        }
                    </div>
                    <div class="border-t px-4 py-2.5">
                        <button type="button"
                                class="flex items-center gap-1 text-muted-foreground text-xs transition-colors hover:text-foreground">
                            View all solutions
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                        </button>
                    </div>
                </div>
            }
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">Hover the nav items above</span>
                <span class="text-muted-foreground/60 text-xs">
                    Products shows a 3-column grid, Solutions shows a 2-column grid
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record MenuItem(string IconName, string Title, string Description);

    private static readonly string[] _dropdownLabels = ["Products", "Solutions"];
    private static readonly string[] _plainLinks = ["Pricing", "Docs", "Blog"];

    private static readonly MenuItem[] _products =
    [
        new("bar-chart-3", "Analytics", "Real-time dashboards and metrics"),
        new("database", "Database", "Managed PostgreSQL at scale"),
        new("cloud", "Cloud", "Deploy to global edge network"),
        new("lock", "Auth", "Authentication and authorization"),
        new("zap", "Functions", "Serverless compute platform"),
        new("blocks", "Integrations", "Connect with 200+ services"),
        new("cpu", "AI Engine", "ML inference at the edge"),
        new("code", "DevTools", "CLI and local development"),
        new("rocket", "Deploy", "Zero-config CI/CD pipeline"),
    ];

    private static readonly MenuItem[] _solutions =
    [
        new("shopping-cart", "E-commerce", "High-performance storefronts and checkout flows"),
        new("landmark", "Financial Services", "Compliant infrastructure for fintech teams"),
        new("heart-pulse", "Healthcare", "HIPAA-ready platform for health applications"),
        new("briefcase", "SaaS", "Multi-tenant architecture for B2B products"),
        new("globe", "Media & Publishing", "Content delivery at global scale"),
        new("building", "Enterprise", "Custom solutions with dedicated support"),
    ];

    private string? _active = null;

    private void HandleEnter(string label)
    {
        _active = label;
    }

    private void HandleLeave()
    {
        _active = null;
    }
}
