@* ============================================================
   Block: navbar-announcement-bar
   Title: NavbarAnnouncementBar
   Description: A navigation bar with a dismissible announcement banner built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a colored announcement strip above the navbar with smooth collapse animation on dismiss using framer-motion, and a standard navigation bar below.
   Source: original/blocks/navbar/navbar-announcement-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Announcement banner *@
        @if (!_dismissed)
        {
            <div class="overflow-hidden">
                <div class="flex items-center justify-center gap-2 bg-foreground px-4 py-1.5">
                    <span class="text-center text-background text-xs">
                        New: AI-powered search is now live.
                        <a href="#learn-more"
                           class="underline underline-offset-2 transition-opacity hover:opacity-80">
                            Learn more &rarr;
                        </a>
                    </span>
                    <button type="button"
                            @onclick="@(() => _dismissed = true)"
                            class="ml-2 shrink-0 rounded-sm p-0.5 text-background/70 transition-colors hover:text-background"
                            aria-label="Dismiss announcement">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                    </button>
                </div>
            </div>
        }

        @* Navbar *@
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <span class="font-medium text-sm">Acme Inc</span>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    <a href="@link.Href"
                       class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @link.Label
                        @if (_hoveredLink == lbl)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </a>
                }
            </div>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Get Started</ButtonCn>
        </nav>
    </div>
</section>

@code {
    private bool _dismissed = false;
    private string? _hoveredLink = null;

    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];
}
