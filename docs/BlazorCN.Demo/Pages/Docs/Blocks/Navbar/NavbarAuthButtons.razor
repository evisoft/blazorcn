@* ============================================================
   Block: navbar-auth-buttons
   Title: NavbarAuthButtons
   Description: A navbar focused on authentication flow for React, Next.js, shadcn/ui, and Tailwind CSS. Features Sign In and Sign Up buttons with toggle state that transforms into an authenticated view with avatar dropdown menu including profile, settings, billing, and sign out options.
   Source: original/blocks/navbar/navbar-auth-buttons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm">Acme</span>
                <nav class="hidden items-center gap-1 sm:flex">
                    @foreach (var link in _navLinks)
                    {
                        <button type="button"
                                class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                            @link
                        </button>
                    }
                </nav>
            </div>

            <div class="flex items-center gap-2">
                @if (_isSignedIn)
                {
                    <div class="flex items-center gap-3">
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="flex items-center gap-2 rounded-md px-1.5 py-1 transition-colors hover:bg-muted/50">
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="text-xs">JD</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="hidden font-medium text-sm sm:inline">Jane Doe</span>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-48">
                                <DropdownMenuLabelCn Class="font-normal">
                                    <div class="flex flex-col gap-0.5">
                                        <span class="font-medium text-sm">Jane Doe</span>
                                        <span class="text-muted-foreground text-xs">jane@@acme.com</span>
                                    </div>
                                </DropdownMenuLabelCn>
                                <DropdownMenuSeparatorCn />
                                <DropdownMenuItemCn>
                                    <LucideIconCn Name="user" Size="16" Class="mr-2 size-4" />
                                    Profile
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>
                                    <LucideIconCn Name="settings" Size="16" Class="mr-2 size-4" />
                                    Settings
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>
                                    <LucideIconCn Name="credit-card" Size="16" Class="mr-2 size-4" />
                                    Billing
                                </DropdownMenuItemCn>
                                <DropdownMenuSeparatorCn />
                                <DropdownMenuItemCn OnClick="@(() => _isSignedIn = false)">
                                    <LucideIconCn Name="log-out" Size="16" Class="mr-2 size-4" />
                                    Sign out
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-sm"
                                  OnClick="@(() => _isSignedIn = true)">
                            Sign in
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-sm">
                            Sign up
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    @(_isSignedIn
                        ? "Signed in as Jane Doe — click the avatar for the dropdown menu"
                        : "Click Sign In to toggle to the authenticated view")
                </span>
                <button type="button"
                        @onclick="@(() => _isSignedIn = !_isSignedIn)"
                        class="text-muted-foreground/60 text-xs underline underline-offset-2 transition-colors hover:text-muted-foreground">
                    Toggle @(_isSignedIn ? "signed out" : "signed in") state
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _isSignedIn = false;

    private static readonly string[] _navLinks = ["Features", "Pricing", "Docs", "Blog"];
}
