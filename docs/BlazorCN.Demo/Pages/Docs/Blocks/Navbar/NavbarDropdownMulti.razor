@* ============================================================
   Block: navbar-dropdown-multi
   Title: NavbarDropdownMulti
   Description: A multi-level dropdown navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. First-level items reveal submenu panels with animated transitions. Click Platform to see API, SDK, CLI, and Dashboard options. Click Solutions for Startups, Enterprise, and Agency submenus using framer-motion AnimatePresence.
   Source: original/blocks/navbar/navbar-dropdown-multi.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Navbar *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-6">
                    <span class="font-medium text-sm">Acme</span>
                    <nav class="flex items-center gap-1">
                        @foreach (var catItem in _categories)
                        {
                            var cat = catItem;
                            <button type="button"
                                    @onclick="@(() => ToggleCategory(cat.Label))"
                                    class="@Cn.Merge("flex items-center gap-1 rounded-md px-3 py-1.5 text-sm transition-colors", _active == cat.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                                @cat.Label
                                <LucideIconCn Name="chevron-down" Size="12" Class="@Cn.Merge("size-3 transition-transform duration-200", _active == cat.Label ? "rotate-180" : "")" />
                            </button>
                        }
                        @foreach (var link in _plainLinks)
                        {
                            <button type="button"
                                    @onclick="@(() => { _active = null; })"
                                    class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                                @link
                            </button>
                        }
                    </nav>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        Sign in
                    </button>
                    <button type="button"
                            class="rounded-md bg-foreground px-3 py-1.5 text-background text-sm transition-colors hover:bg-foreground/90">
                        Get started
                    </button>
                </div>
            </div>

            @* Dropdown panel *@
            @{
                var activeCategory = _categories.FirstOrDefault(c => c.Label == _active);
            }
            @if (activeCategory != null)
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card">
                    <div class="grid grid-cols-2 gap-1 p-2">
                        @foreach (var subItem in activeCategory.Items)
                        {
                            var item = subItem;
                            <button type="button"
                                    class="flex items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                <span class="mt-0.5 text-muted-foreground">
                                    <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                                </span>
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@item.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    Click the nav items above to toggle dropdowns
                </span>
                <span class="text-muted-foreground/60 text-xs">
                    Platform, Solutions, and Resources each reveal different submenu panels
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record SubMenuItem(string IconName, string Title, string Description);
    private record NavCategory(string Label, SubMenuItem[] Items);

    private string? _active = null;

    private static readonly string[] _plainLinks = ["Pricing", "Blog"];

    private static readonly NavCategory[] _categories =
    [
        new NavCategory("Platform",
        [
            new SubMenuItem("code", "API", "RESTful and GraphQL endpoints"),
            new SubMenuItem("wrench", "SDK", "Client libraries for 8 languages"),
            new SubMenuItem("terminal", "CLI", "Command-line developer tools"),
            new SubMenuItem("layout-dashboard", "Dashboard", "Visual management console"),
        ]),
        new NavCategory("Solutions",
        [
            new SubMenuItem("rocket", "Startups", "Launch faster with free tier credits"),
            new SubMenuItem("building", "Enterprise", "Custom SLAs and dedicated support"),
            new SubMenuItem("briefcase", "Agency", "Multi-client project management"),
            new SubMenuItem("users", "Teams", "Collaboration tools for dev teams"),
        ]),
        new NavCategory("Resources",
        [
            new SubMenuItem("book-open", "Documentation", "Guides, references, and tutorials"),
            new SubMenuItem("graduation-cap", "Academy", "Free courses and certifications"),
            new SubMenuItem("message-circle", "Community", "Join 50k+ developers on Discord"),
            new SubMenuItem("file-text", "Changelog", "Latest releases and improvements"),
        ]),
    ];

    private void ToggleCategory(string label)
    {
        _active = _active == label ? null : label;
    }
}
