@* ============================================================
   Block: navbar-tabs-underline
   Title: NavbarTabsUnderline
   Description: A tab-style navigation bar with animated underline indicator built with React, Next.js, shadcn/ui, and Tailwind CSS. Clicking a nav item slides a bottom border to the active tab using framer-motion layoutId animation. Active tab uses text-foreground while inactive tabs use text-muted-foreground for clear visual hierarchy.
   Source: original/blocks/navbar/navbar-tabs-underline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar with tabs *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm">Acme</span>
                <nav class="flex items-center">
                    @foreach (var tab in _navTabs)
                    {
                        var t = tab;
                        var isActive = _activeTab == t.Id;
                        <button type="button"
                                class="@Cn.Merge("relative px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => SetActiveTab(t.Id))">
                            @t.Label
                            @if (isActive)
                            {
                                <span class="absolute inset-x-3 -bottom-[13px] h-0.5 bg-foreground"></span>
                            }
                        </button>
                    }
                </nav>
            </div>
            <div class="flex items-center gap-2">
                <button type="button"
                        class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                    Sign in
                </button>
                <button type="button"
                        class="rounded-md bg-foreground px-3 py-1.5 text-background text-sm transition-colors hover:bg-foreground/90">
                    Get started
                </button>
            </div>
        </div>

        @* Border with underline context *@
        <div class="border-t"></div>

        @* Tab content area *@
        <div class="px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="font-medium text-sm">@_currentTitle</span>
                <span class="max-w-sm text-muted-foreground text-xs">@_currentDescription</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavTab(string Id, string Label);

    private record TabContent(string Title, string Description);

    private static readonly NavTab[] _navTabs =
    [
        new("overview", "Overview"),
        new("analytics", "Analytics"),
        new("reports", "Reports"),
        new("settings", "Settings"),
        new("integrations", "Integrations"),
    ];

    private static readonly Dictionary<string, TabContent> _tabContent = new()
    {
        ["overview"] = new("Project Overview", "View key metrics, recent activity, and project health at a glance."),
        ["analytics"] = new("Analytics Dashboard", "Track page views, user sessions, and conversion rates over time."),
        ["reports"] = new("Generated Reports", "Download weekly and monthly reports for stakeholder presentations."),
        ["settings"] = new("Project Settings", "Configure team access, notifications, and deployment preferences."),
        ["integrations"] = new("Connected Services", "Manage third-party integrations with Slack, GitHub, and Jira."),
    };

    private string _activeTab = "overview";

    private string _currentTitle => _tabContent.TryGetValue(_activeTab, out var c) ? c.Title : string.Empty;
    private string _currentDescription => _tabContent.TryGetValue(_activeTab, out var c) ? c.Description : string.Empty;

    private void SetActiveTab(string id)
    {
        _activeTab = id;
    }
}
