@* ============================================================
   Block: navbar-pill-links
   Title: NavbarPillLinks
   Description: A navigation bar with pill-shaped nav items built with React, Next.js, shadcn/ui, and Tailwind CSS. Active links display a rounded-full background indicator that smoothly slides between items using framer-motion layoutId animations. Hover state shows a subtle bg-muted/50 transition.
   Source: original/blocks/navbar/navbar-pill-links.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-2.5">
            @* Logo *@
            <span class="font-medium text-sm">Acme Inc</span>

            @* Pill nav links *@
            <div class="flex items-center gap-0.5">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    var isActive = _activeLink == link.Label;
                    <button type="button"
                            class="@Cn.Merge("relative rounded-full px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeLink = link.Label)">
                        @if (isActive)
                        {
                            <span class="absolute inset-0 rounded-full bg-muted"></span>
                        }
                        <span class="relative z-10">@link.Label</span>
                    </button>
                }
            </div>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                Get Started
            </ButtonCn>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Home", "#home"),
        new("Products", "#products"),
        new("Pricing", "#pricing"),
        new("Blog", "#blog"),
        new("Contact", "#contact"),
    ];

    private string _activeLink = "Home";
}
