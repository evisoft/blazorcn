@* ============================================================
   Block: navbar-hover-highlight
   Title: NavbarHoverHighlight
   Description: A navigation bar with a following background highlight effect built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a subtle bg-muted/50 rounded background that smoothly transitions between hovered items using framer-motion layoutId.
   Source: original/blocks/navbar/navbar-hover-highlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded bg-foreground">
                    <span class="font-semibold text-background text-xs">A</span>
                </div>
                <span class="font-medium text-sm">Acme</span>
            </div>

            @* Nav links with hover highlight *@
            <div class="flex items-center gap-0.5"
                 @onmouseleave="@(() => _hoveredLink = null)">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isHovered = _hoveredLink == lbl;
                    <a href="@link.Href"
                       class="@Cn.Merge("relative px-3 py-1.5 text-sm transition-colors", isHovered ? "text-foreground" : "text-muted-foreground")"
                       @onmouseenter="@(() => _hoveredLink = lbl)">
                        @if (isHovered)
                        {
                            <span class="absolute inset-0 rounded-md bg-muted/50 transition-all duration-150"></span>
                        }
                        <span class="relative z-10">@lbl</span>
                    </a>
                }
            </div>

            @* CTA *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Sign In
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
        new("Blog", "#blog"),
    ];

    private string? _hoveredLink = null;
}
