@* ============================================================
   Block: navbar-dashboard
   Title: NavbarDashboard
   Description: A dashboard admin navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a sidebar toggle hamburger button, page title, breadcrumb trail, search input, notification bell with red indicator dot, and user avatar with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Sidebar toggle *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0"
                      OnClick="@(() => _sidebarOpen = !_sidebarOpen)">
                @if (_sidebarOpen)
                {
                    <LucideIconCn Name="x" Size="16" Class="size-4" />
                }
                else
                {
                    <LucideIconCn Name="menu" Size="16" Class="size-4" />
                }
            </ButtonCn>

            @* Page title and breadcrumb *@
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Dashboard</span>
                <BreadcrumbCn Class="mt-0.5">
                    <BreadcrumbListCn Class="text-xs">
                        <BreadcrumbItemCn>
                            <BreadcrumbLinkCn Href="#">Home</BreadcrumbLinkCn>
                        </BreadcrumbItemCn>
                        <BreadcrumbSeparatorCn />
                        <BreadcrumbItemCn>
                            <BreadcrumbLinkCn Href="#">Analytics</BreadcrumbLinkCn>
                        </BreadcrumbItemCn>
                        <BreadcrumbSeparatorCn />
                        <BreadcrumbItemCn>
                            <BreadcrumbPageCn>Overview</BreadcrumbPageCn>
                        </BreadcrumbItemCn>
                    </BreadcrumbListCn>
                </BreadcrumbCn>
            </div>

            @* Right actions *@
            <div class="flex items-center gap-1">
                @* Search input (toggle) *@
                @if (_searchOpen)
                {
                    <div class="overflow-hidden">
                        <InputCn Placeholder="Search..." Class="h-7 border-0 bg-muted/50 text-xs shadow-none focus-visible:ring-0" />
                    </div>
                }
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0"
                          OnClick="@(() => _searchOpen = !_searchOpen)">
                    <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                @* Notifications *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative size-8 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="absolute top-1.5 right-1.5 size-1.5 rounded-full bg-red-500"></span>
                </ButtonCn>

                @* User avatar *@
                <AvatarCn Class="ml-1 size-6">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private bool _searchOpen = false;
    private bool _sidebarOpen = true;
}
