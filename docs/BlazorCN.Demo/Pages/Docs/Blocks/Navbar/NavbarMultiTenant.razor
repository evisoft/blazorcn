@* ============================================================
   Block: navbar-multi-tenant
   Title: NavbarMultiTenant
   Description: A multi-tenant SaaS navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features an organization avatar with dropdown switcher for multiple tenants, standard nav links, user avatar menu, and framer-motion animated transitions for the org selector panel.
   Source: original/blocks/navbar/navbar-multi-tenant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">

            @* Org switcher *@
            <div class="relative"
                 @onmouseenter="HandleMouseEnter"
                 @onmouseleave="HandleMouseLeave">
                <button type="button"
                        @onclick="@(() => _orgDropdownOpen = !_orgDropdownOpen)"
                        class="flex shrink-0 items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                    <AvatarCn Class="size-6">
                        <AvatarFallbackCn Class="text-[10px]">@_selectedOrg.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <span class="font-medium text-sm">@_selectedOrg.Name</span>
                    <LucideIconCn Name="chevron-down" Size="14"
                                  Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", _orgDropdownOpen ? "rotate-180" : "")" />
                </button>

                @if (_orgDropdownOpen)
                {
                    <div class="absolute left-0 top-full z-50 mt-1 w-52 overflow-hidden rounded-md border bg-card shadow-md">
                        <div class="p-1">
                            @foreach (var org in _orgs)
                            {
                                var capturedOrg = org;
                                <button type="button"
                                        @onclick="@(() => SelectOrg(capturedOrg))"
                                        class="flex w-full items-center gap-2.5 rounded-sm px-2.5 py-2 text-left text-sm transition-colors hover:bg-muted/50">
                                    <AvatarCn Class="size-6">
                                        <AvatarFallbackCn Class="text-[10px]">@capturedOrg.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <span class="flex-1 truncate text-sm">@capturedOrg.Name</span>
                                    @if (_selectedOrg.Id == capturedOrg.Id)
                                    {
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-foreground" />
                                    }
                                </button>
                            }
                        </div>
                        <div class="border-t p-1">
                            <button type="button"
                                    class="flex w-full items-center gap-2.5 rounded-sm px-2.5 py-2 text-left text-muted-foreground text-sm transition-colors hover:bg-muted/50 hover:text-foreground">
                                <div class="flex size-6 items-center justify-center rounded-full border border-dashed">
                                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                </div>
                                <span>Create New</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            @* Nav links *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var capturedLink = link;
                    <button type="button"
                            @onclick="@(() => _activeLink = capturedLink.Label)"
                            class="@Cn.Merge("shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeLink == capturedLink.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        @capturedLink.Label
                    </button>
                }
            </div>

            @* User avatar *@
            <AvatarCn Class="size-6 shrink-0">
                <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
            </AvatarCn>

        </nav>
    </div>
</section>

@code {
    private record Org(string Id, string Name, string Initials);
    private record NavLink(string Label, string Href);

    private static readonly Org[] _orgs =
    [
        new("acme", "Acme Inc", "AC"),
        new("startup", "Startup Co", "SC"),
        new("agency", "Agency X", "AX"),
    ];

    private static readonly NavLink[] _navLinks =
    [
        new("Overview", "#overview"),
        new("Projects", "#projects"),
        new("Analytics", "#analytics"),
        new("Settings", "#settings"),
    ];

    private Org _selectedOrg = _orgs[0];
    private bool _orgDropdownOpen = false;
    private string _activeLink = "Overview";

    private System.Threading.Timer? _closeTimer;

    private void HandleMouseEnter()
    {
        _closeTimer?.Dispose();
        _closeTimer = null;
        _orgDropdownOpen = true;
    }

    private void HandleMouseLeave()
    {
        _closeTimer?.Dispose();
        _closeTimer = new System.Threading.Timer(_ =>
        {
            _orgDropdownOpen = false;
            InvokeAsync(StateHasChanged);
        }, null, 150, System.Threading.Timeout.Infinite);
    }

    private void SelectOrg(Org org)
    {
        _selectedOrg = org;
        _orgDropdownOpen = false;
    }
}
