@* ============================================================
   Block: navbar-changelog
   Title: NavbarChangelog
   Description: A changelog and release notes navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a product logo with version badge, category tabs for All Updates, Features, Fixes, and Breaking Changes, a "New" dot indicator for recent additions, subscribe-to-updates bell button, and RSS feed button with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo + version *@
            <div class="flex shrink-0 items-center gap-2.5">
                <span class="font-medium text-sm">Acme</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-mono text-[10px]">
                    v4.2.0
                </BadgeCn>
            </div>

            <div class="h-4 w-px bg-border"></div>

            @* Category tabs *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <button type="button"
                            @onclick="@(() => _activeCategory = category.Label)"
                            class="@Cn.Merge("relative flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeCategory == category.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        @category.Label
                        <span class="tabular-nums text-muted-foreground text-[10px]">@category.Count</span>
                        @if (category.HasNew)
                        {
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                        }
                    </button>
                }
            </div>

            @* Right: subscribe + RSS *@
            <div class="flex shrink-0 items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs"
                          OnClick="HandleSubscribe">
                    @if (_subscribed)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        <span>Subscribed</span>
                    }
                    else
                    {
                        <LucideIconCn Name="bell" Size="12" Class="size-3" />
                        <span>Subscribe</span>
                    }
                </ButtonCn>

                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0 text-muted-foreground"
                          AriaLabel="RSS feed">
                    <LucideIconCn Name="rss" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record Category(string Label, int Count, bool HasNew = false);

    private static readonly Category[] _categories =
    [
        new("All Updates", 24),
        new("Features", 8, HasNew: true),
        new("Fixes", 12),
        new("Breaking Changes", 4),
    ];

    private string _activeCategory = "All Updates";
    private bool _subscribed = false;

    private async Task HandleSubscribe()
    {
        _subscribed = true;
        StateHasChanged();
        await Task.Delay(2500);
        _subscribed = false;
    }
}
