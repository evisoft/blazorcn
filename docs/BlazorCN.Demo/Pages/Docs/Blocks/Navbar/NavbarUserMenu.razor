@* ============================================================
   Block: navbar-user-menu
   Title: NavbarUserMenu
   Description: A dashboard-style navbar with user avatar dropdown for React, Next.js, shadcn/ui, and Tailwind CSS. Features workspace name, notification bell with badge count, and a user dropdown with profile details, settings, team management, billing, and sign out options.
   Source: original/blocks/navbar/navbar-user-menu.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <div class="flex items-center justify-between px-4 py-3">
            @* Left: Workspace name + nav links *@
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-md bg-foreground text-background">
                        <span class="font-medium text-xs">A</span>
                    </div>
                    <span class="font-medium text-sm">Acme Corp</span>
                </div>
                <span class="text-border">|</span>
                <nav class="hidden items-center gap-1 sm:flex">
                    @for (int i = 0; i < _dashboardLinks.Length; i++)
                    {
                        var link = _dashboardLinks[i];
                        var idx = i;
                        <button type="button"
                                class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", idx == 0 ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                            @link
                        </button>
                    }
                </nav>
            </div>

            @* Right: Notifications + User menu *@
            <div class="flex items-center gap-2">
                @* Notification bell *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative h-8 w-8 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4" />
                    @if (_notificationCount > 0)
                    {
                        <span class="absolute -top-0.5 -right-0.5 flex size-4 items-center justify-center rounded-full bg-foreground text-background text-[10px] font-medium">
                            @_notificationCount
                        </span>
                    }
                </ButtonCn>

                @* User dropdown *@
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn Class="flex items-center gap-2 rounded-md px-1.5 py-1 transition-colors hover:bg-muted/50">
                        <AvatarCn Class="size-6">
                            <AvatarFallbackCn>MR</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="hidden flex-col items-start sm:flex">
                            <span class="font-medium text-xs">Marcus Rivera</span>
                            <span class="text-muted-foreground text-[10px]">Admin</span>
                        </div>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-52">
                        <DropdownMenuLabelCn Class="font-normal">
                            <div class="flex flex-col gap-0.5">
                                <span class="font-medium text-sm">Marcus Rivera</span>
                                <span class="text-muted-foreground text-xs">marcus@@acmecorp.com</span>
                            </div>
                        </DropdownMenuLabelCn>
                        <DropdownMenuSeparatorCn />
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="user" Size="16" Class="mr-2 size-4" />
                            Profile
                        </DropdownMenuItemCn>
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="settings" Size="16" Class="mr-2 size-4" />
                            Settings
                        </DropdownMenuItemCn>
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="users" Size="16" Class="mr-2 size-4" />
                            Team
                        </DropdownMenuItemCn>
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="credit-card" Size="16" Class="mr-2 size-4" />
                            Billing
                        </DropdownMenuItemCn>
                        <DropdownMenuSeparatorCn />
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="log-out" Size="16" Class="mr-2 size-4" />
                            Sign out
                        </DropdownMenuItemCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>
            </div>
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    Dashboard navbar with workspace context and user management
                </span>
                <span class="text-muted-foreground/60 text-xs">
                    Click the avatar or bell icon to see dropdown interactions
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _dashboardLinks = ["Overview", "Projects", "Analytics", "Reports"];

    private readonly int _notificationCount = 3;
}
