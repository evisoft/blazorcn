@* ============================================================
   Block: navbar-category-bar
   Title: NavbarCategoryBar
   Description: A two-tier navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Top tier has logo, search input, and account icons. Bottom tier has horizontal scrollable category pills with active state highlighting and framer-motion animations.
   Source: original/blocks/navbar/navbar-category-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Top tier: logo + search + icons *@
        <div class="flex items-center gap-4 border-b px-4 py-3">

            @* Logo *@
            <span class="shrink-0 font-medium text-sm">Marketplace</span>

            @* Search bar *@
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Placeholder="Search products, brands, and more..." Class="h-8 border-border/50 bg-muted/30 pl-8 text-sm shadow-none focus-visible:ring-1" />
            </div>

            @* Account icons *@
            <div class="flex shrink-0 items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0">
                    <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative h-8 w-8 p-0">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="absolute -right-1 -top-1 flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                        2
                    </span>
                </ButtonCn>
            </div>
        </div>

        @* Bottom tier: category pills *@
        <div class="scrollbar-none overflow-x-auto px-4 py-2">
            <div class="flex items-center gap-1">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <button type="button"
                            @onclick="@(() => _activeCategory = category)"
                            class="relative shrink-0 rounded-full px-3 py-1 text-sm transition-colors">
                        @if (_activeCategory == category)
                        {
                            <span class="absolute inset-0 rounded-full bg-foreground"></span>
                        }
                        <span class="@Cn.Merge("relative z-10 text-xs font-medium", _activeCategory == category ? "text-background" : "text-muted-foreground")">
                            @category
                        </span>
                    </button>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private string _activeCategory = "All";

    private static readonly string[] _categories =
    [
        "All",
        "Electronics",
        "Fashion",
        "Home & Garden",
        "Sports",
        "Books",
        "Beauty",
        "Toys",
        "Automotive",
    ];
}
