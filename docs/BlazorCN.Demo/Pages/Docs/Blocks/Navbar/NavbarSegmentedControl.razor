@* ============================================================
   Block: navbar-segmented-control
   Title: NavbarSegmentedControl
   Description: A navigation bar with iOS-style segmented control built with React, Next.js, shadcn/ui, and Tailwind CSS. Nav items sit inside a bg-muted container with the active segment highlighted by a sliding white card background animated with framer-motion layoutId transitions.
   Source: original/blocks/navbar/navbar-segmented-control.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-2.5">
            @* Logo *@
            <span class="font-medium text-sm">Acme</span>

            @* Segmented control *@
            <div class="flex items-center rounded-lg bg-muted p-1">
                @foreach (var seg in _segments)
                {
                    var segment = seg;
                    var isActive = _activeSegment == segment.Label;
                    <button type="button"
                            class="@Cn.Merge("relative rounded-md px-3 py-1 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeSegment = segment.Label)">
                        @if (isActive)
                        {
                            <span class="absolute inset-0 rounded-md bg-card shadow-sm"></span>
                        }
                        <span class="relative z-10">@segment.Label</span>
                    </button>
                }
            </div>

            @* Right actions *@
            <div class="flex items-center gap-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Feedback
                </ButtonCn>
                <AvatarCn Class="size-6">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record Segment(string Label, string Href);

    private static readonly Segment[] _segments =
    [
        new("Overview", "#overview"),
        new("Analytics", "#analytics"),
        new("Reports", "#reports"),
        new("Notifications", "#notifications"),
    ];

    private string _activeSegment = "Overview";
}
