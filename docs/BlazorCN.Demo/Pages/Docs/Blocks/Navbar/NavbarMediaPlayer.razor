@* ============================================================
   Block: navbar-media-player
   Title: NavbarMediaPlayer
   Description: A media player navigation bar overlay built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a semi-transparent backdrop, back arrow with video title, playback controls, quality selector dropdown, fullscreen toggle, and settings gear icon with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-media-player.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Semi-transparent overlay navbar *@
        <nav class="flex items-center gap-3 bg-zinc-950/80 px-4 py-3 backdrop-blur-sm">
            @* Left: back arrow + title *@
            <div class="flex min-w-0 shrink-0 items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0 text-zinc-300 hover:bg-zinc-800 hover:text-white">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                </ButtonCn>
                <div class="min-w-0">
                    <span class="truncate font-medium text-sm text-zinc-100">
                        Product Launch Keynote 2026
                    </span>
                    <p class="truncate text-xs text-zinc-400">Acme Inc</p>
                </div>
            </div>

            @* Center: playback controls *@
            <div class="flex flex-1 items-center justify-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0 text-zinc-400 hover:bg-zinc-800 hover:text-white">
                    <LucideIconCn Name="skip-back" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-9 p-0 text-zinc-100 hover:bg-zinc-800 hover:text-white"
                          OnClick="@(() => _isPlaying = !_isPlaying)">
                    @if (_isPlaying)
                    {
                        <LucideIconCn Name="pause" Size="20" Class="size-5" />
                    }
                    else
                    {
                        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
                            <title>Play</title>
                            <path d="M8 5v14l11-7z" />
                        </svg>
                    }
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0 text-zinc-400 hover:bg-zinc-800 hover:text-white">
                    <LucideIconCn Name="skip-forward" Size="16" Class="size-4" />
                </ButtonCn>
                <span class="ml-2 font-mono text-xs text-zinc-400 tabular-nums">12:34 / 48:02</span>
            </div>

            @* Right: quality + fullscreen + settings *@
            <div class="flex shrink-0 items-center gap-1">
                @* Quality selector *@
                <div class="relative">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white"
                              OnClick="@(() => _qualityOpen = !_qualityOpen)">
                        @_selectedQuality
                        <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                    </ButtonCn>

                    @if (_qualityOpen)
                    {
                        <div class="absolute right-0 z-50 mt-2 w-32 overflow-hidden rounded-md border border-zinc-700 bg-zinc-900 shadow-md">
                            @foreach (var q in _qualityOptions)
                            {
                                var quality = q;
                                <button type="button"
                                        class="flex w-full items-center gap-2 px-3 py-2 text-left text-xs text-zinc-300 transition-colors hover:bg-zinc-800"
                                        @onclick="@(() => SelectQuality(quality))">
                                    @if (_selectedQuality == quality)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-zinc-100" />
                                    }
                                    else
                                    {
                                        <span class="size-3"></span>
                                    }
                                    @quality
                                </button>
                            }
                        </div>
                    }
                </div>

                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0 text-zinc-400 hover:bg-zinc-800 hover:text-white">
                    <LucideIconCn Name="maximize-2" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0 text-zinc-400 hover:bg-zinc-800 hover:text-white">
                    <LucideIconCn Name="settings" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private string _selectedQuality = "720p";
    private bool _qualityOpen = false;
    private bool _isPlaying = true;

    private static readonly string[] _qualityOptions = ["1080p", "720p", "480p", "360p", "Auto"];

    private void SelectQuality(string quality)
    {
        _selectedQuality = quality;
        _qualityOpen = false;
    }
}
