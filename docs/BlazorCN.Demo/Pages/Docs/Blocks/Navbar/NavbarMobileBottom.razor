@* ============================================================
   Block: navbar-mobile-bottom
   Title: NavbarMobileBottom
   Description: A mobile bottom tab bar navigation for React, Next.js, shadcn/ui, and Tailwind CSS. Features five icon tabs with labels for Home, Search, Create, Notifications, and Profile with active state indicators, filled icon variants, and safe area padding for mobile devices.
   Source: original/blocks/navbar/navbar-mobile-bottom.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Simulated mobile screen *@
        <div class="relative flex h-[700px] flex-col">
            @* Top header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <span class="font-medium text-sm">Acme</span>
                <span class="text-muted-foreground text-xs">Mobile Preview</span>
            </div>

            @* Screen content *@
            <div class="flex flex-1 items-center justify-center">
                <div class="flex flex-col items-center gap-2 text-center">
                    <span class="font-medium text-sm capitalize">@_activeTab</span>
                    <span class="text-muted-foreground text-xs">Tap the tabs below to navigate</span>
                </div>
            </div>

            @* Bottom tab bar *@
            <div class="border-t bg-card">
                <nav class="grid grid-cols-5">
                    @foreach (var tab in _tabs)
                    {
                        var tabId = tab.Id;
                        var isActive = _activeTab == tabId;
                        <button type="button"
                                @onclick="@(() => _activeTab = tabId)"
                                class="relative flex flex-col items-center gap-1 py-2 transition-colors">
                            @* Active indicator *@
                            @if (isActive)
                            {
                                <div class="absolute top-0 h-0.5 w-8 rounded-full bg-foreground"></div>
                            }
                            <span class="@(isActive ? "text-foreground" : "text-muted-foreground")">
                                <LucideIconCn Name="@tab.IconName" Size="20" StrokeWidth="@(isActive ? 2 : 2)" Class="size-5" />
                            </span>
                            <span class="@($"text-[10px] {(isActive ? "font-medium text-foreground" : "text-muted-foreground")}")">
                                @tab.Label
                            </span>
                        </button>
                    }
                </nav>
                @* Safe area padding *@
                <div class="h-2"></div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Tab(string Id, string Label, string IconName);

    private static readonly Tab[] _tabs =
    [
        new("home",          "Home",    "home"),
        new("search",        "Search",  "search"),
        new("create",        "Create",  "plus-square"),
        new("notifications", "Alerts",  "bell"),
        new("profile",       "Profile", "user"),
    ];

    private string _activeTab = "home";
}
