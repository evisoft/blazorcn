@* ============================================================
   Block: navbar-search-overlay
   Title: NavbarSearchOverlay
   Description: A navigation bar with a full-screen search overlay built with React, Next.js, shadcn/ui, and Tailwind CSS. Click the search icon or press Cmd+K to open a dimmed overlay with a large centered search input, recent searches, and popular suggestions.
   Source: original/blocks/navbar/navbar-search-overlay.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <span class="font-medium text-sm">Acme Inc</span>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    <a href="@link.Href"
                       class="px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        @link.Label
                    </a>
                }
            </div>

            @* Search trigger + CTA *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="h-7 gap-2 px-2 text-muted-foreground text-xs"
                          OnClick="@(() => _isOverlayOpen = true)">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                    <span class="hidden sm:inline">Search</span>
                    <KbdCn Class="ml-1">
                        <span class="text-[10px]">&#8984;</span>K
                    </KbdCn>
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started
                </ButtonCn>
            </div>
        </nav>
    </div>

    @* Full-screen search overlay *@
    @if (_isOverlayOpen)
    {
        <div class="fixed inset-0 z-50 flex items-start justify-center pt-[15vh]">
            @* Backdrop *@
            <div class="absolute inset-0 bg-background/80 backdrop-blur-sm"
                 @onclick="@(() => { _isOverlayOpen = false; _searchValue = ""; })">
            </div>

            @* Search panel *@
            <div class="relative z-10 w-full max-w-lg">
                <div class="overflow-hidden rounded-lg border bg-card shadow-lg">
                    @* Search input *@
                    <div class="flex items-center gap-3 border-b px-4 py-3">
                        <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <input type="text"
                               value="@_searchValue"
                               @oninput="@((e) => _searchValue = e.Value?.ToString() ?? "")"
                               placeholder="Search everything..."
                               aria-label="Search everything"
                               class="h-6 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                        <button type="button"
                                @onclick="@(() => { _isOverlayOpen = false; _searchValue = ""; })"
                                aria-label="Close search"
                                class="shrink-0 rounded-sm p-1 text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="x" Size="16" Class="size-4" />
                        </button>
                    </div>

                    @* Recent searches *@
                    <div class="border-b px-4 py-3">
                        <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            Recent searches
                        </span>
                        <div class="mt-2 flex flex-col gap-0.5">
                            @foreach (var search in _recentSearches)
                            {
                                <button type="button"
                                        class="flex items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm transition-colors hover:bg-muted/50">
                                    <span class="flex-1">@search</span>
                                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                                </button>
                            }
                        </div>
                    </div>

                    @* Popular suggestions *@
                    <div class="px-4 py-3">
                        <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                            <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                            Popular
                        </span>
                        <div class="mt-2 flex flex-col gap-0.5">
                            @foreach (var suggestion in _popularSuggestions)
                            {
                                <button type="button"
                                        class="flex items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm transition-colors hover:bg-muted/50">
                                    <span class="flex-1">@suggestion</span>
                                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                                </button>
                            }
                        </div>
                    </div>

                    @* Footer hint *@
                    <div class="flex items-center justify-between border-t px-4 py-2">
                        <span class="text-muted-foreground text-xs">Navigate with arrow keys</span>
                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                            Press <KbdCn>Esc</KbdCn> to close
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private bool _isOverlayOpen = false;
    private string _searchValue = "";

    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];

    private static readonly string[] _recentSearches =
    [
        "React hooks authentication",
        "Stripe integration guide",
        "Dashboard components",
        "API rate limiting",
    ];

    private static readonly string[] _popularSuggestions =
    [
        "Getting started with Next.js",
        "Component library overview",
        "Deploy to Vercel",
        "Team collaboration setup",
        "Custom theme configuration",
    ];
}
