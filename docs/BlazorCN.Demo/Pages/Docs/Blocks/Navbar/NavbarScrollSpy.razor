@* ============================================================
   Block: navbar-scroll-spy
   Title: NavbarScrollSpy
   Description: A navbar with scroll-spy behavior simulation built with React, Next.js, shadcn/ui, Tailwind CSS, and framer-motion. Nav items for Intro, Features, Pricing, FAQ, and Contact highlight with an animated underline and text-foreground color as the corresponding section comes into view. Click to navigate between simulated page sections.
   Source: original/blocks/navbar/navbar-scroll-spy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Navbar with scroll spy indicators *@
        <nav class="flex items-center justify-between px-4 py-3">
            <span class="shrink-0 font-medium text-sm">Acme</span>

            <div class="flex items-center gap-1">
                @foreach (var sec in _sections)
                {
                    var secId = sec.Id;
                    var isActive = _activeSection == secId;
                    <button type="button"
                            class="@Cn.Merge("relative px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeSection = secId)">
                        @sec.Label
                        @if (isActive)
                        {
                            <span class="absolute inset-x-3 -bottom-[13px] h-0.5 rounded-full bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            <button type="button"
                    class="rounded-md bg-foreground px-3 py-1.5 text-background text-xs transition-colors hover:bg-foreground/90">
                Sign Up
            </button>
        </nav>

        @* Section progress bar *@
        <div class="relative h-px bg-border">
            <div class="absolute top-0 left-0 h-full bg-foreground transition-all duration-[400ms] ease-out"
                 style="@($"width:{ProgressPercent}%")">
            </div>
        </div>

        @* Simulated page content *@
        <div class="px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-3 text-center">
                <span class="font-medium text-sm">@CurrentSection?.Content</span>
                <p class="max-w-md text-muted-foreground text-xs leading-relaxed">
                    @CurrentSection?.Detail
                </p>
            </div>
        </div>

        @* Section indicators *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-2">
                @foreach (var sec in _sections)
                {
                    var secId = sec.Id;
                    var secIdx = IndexOf(secId);
                    var activeIdx = IndexOf(_activeSection);
                    var isPast = secIdx < activeIdx;
                    var isCurrent = secId == _activeSection;
                    <button type="button"
                            class="flex items-center gap-2"
                            @onclick="@(() => _activeSection = secId)">
                        <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", isCurrent ? "bg-foreground" : isPast ? "bg-foreground/40" : "bg-muted-foreground/30")"></span>
                    </button>
                }
                <span class="ml-2 text-muted-foreground text-xs">
                    @(IndexOf(_activeSection) + 1) / @_sections.Length
                </span>
            </div>
        </div>

    </div>
</section>

@code {
    private record SectionItem(string Id, string Label, string Content, string Detail);

    private static readonly SectionItem[] _sections =
    [
        new("intro", "Intro", "Welcome to Acme Platform",
            "The all-in-one solution for modern teams. Ship faster with integrated tools for development, deployment, and monitoring."),
        new("features", "Features", "Built for Scale",
            "Edge computing, automatic scaling, real-time analytics, and team collaboration built in from day one."),
        new("pricing", "Pricing", "Simple, Transparent Pricing",
            "Start free, scale as you grow. No hidden fees, no surprises. Pay only for what you use."),
        new("faq", "FAQ", "Frequently Asked Questions",
            "Get answers to common questions about setup, billing, integrations, and enterprise support options."),
        new("contact", "Contact", "Get in Touch",
            "Reach our team for demos, partnerships, or technical support. We respond within 24 hours."),
    ];

    private string _activeSection = "intro";

    private SectionItem? CurrentSection => System.Array.Find(_sections, s => s.Id == _activeSection);

    private int IndexOf(string id) => System.Array.FindIndex(_sections, s => s.Id == id);

    private double ProgressPercent =>
        ((double)(IndexOf(_activeSection) + 1) / _sections.Length) * 100.0;
}
