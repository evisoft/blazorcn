@* ============================================================
   Block: navbar-mega-menu-featured
   Title: NavbarMegaMenuFeatured
   Description: A mega menu navbar with featured content panel built with React, Next.js, shadcn/ui, and Tailwind CSS. Left side shows navigation links in a list, right side displays a featured card with preview area, title, and description using framer-motion AnimatePresence transitions. Inspired by Stripe-style navigation.
   Source: original/blocks/navbar/navbar-mega-menu-featured.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Navbar *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-6">
                    <span class="font-medium text-sm">Acme</span>
                    <nav class="flex items-center gap-1">
                        @foreach (var item in _navItems)
                        {
                            var navItem = item;
                            <div @onmouseenter="@(() => HandleEnter(navItem.Label))"
                                 @onmouseleave="HandleLeave">
                                <button type="button"
                                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _active == navItem.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                                    @navItem.Label
                                </button>
                            </div>
                        }
                        @foreach (var lnk in _plainLinks)
                        {
                            var plainLink = lnk;
                            <button type="button"
                                    class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                                    @onmouseenter="@(() => { _active = null; })">
                                @plainLink
                            </button>
                        }
                    </nav>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        Sign in
                    </button>
                    <button type="button"
                            class="rounded-md bg-foreground px-3 py-1.5 text-background text-sm transition-colors hover:bg-foreground/90">
                        Get started
                    </button>
                </div>
            </div>

            @* Mega menu panel *@
            @{
                var activeItem = System.Array.Find(_navItems, it => it.Label == _active);
            }
            @if (activeItem != null)
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card"
                     @onmouseenter="@(() => HandleEnter(activeItem.Label))"
                     @onmouseleave="HandleLeave">
                    <div class="flex">
                        @* Links list *@
                        <div class="flex-1 p-2">
                            @foreach (var lnk in activeItem.Links)
                            {
                                var link = lnk;
                                <button type="button"
                                        class="flex w-full items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                    <span class="mt-0.5 text-muted-foreground">
                                        <LucideIconCn Name="@link.IconName" Size="16" Class="size-4" />
                                    </span>
                                    <div class="min-w-0">
                                        <span class="font-medium text-sm">@link.Title</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@link.Description</p>
                                    </div>
                                </button>
                            }
                        </div>

                        @* Featured card *@
                        <div class="w-64 border-l p-3">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-3 h-24 rounded bg-muted"></div>
                                <span class="mb-1 inline-block rounded bg-foreground/10 px-1.5 py-0.5 font-medium text-foreground text-[10px]">
                                    @activeItem.Featured.Label
                                </span>
                                <p class="font-medium text-sm">@activeItem.Featured.Title</p>
                                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                    @activeItem.Featured.Description
                                </p>
                                <button type="button"
                                        class="mt-2.5 flex items-center gap-1 text-muted-foreground text-xs transition-colors hover:text-foreground">
                                    Read more
                                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">Hover the nav items above</span>
                <span class="text-muted-foreground/60 text-xs">
                    Each dropdown shows links on the left and featured content on the right
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavLink(string IconName, string Title, string Description);
    private record FeaturedContent(string Label, string Title, string Description);
    private record NavCategory(string Label, NavLink[] Links, FeaturedContent Featured);

    private static readonly NavCategory[] _navItems =
    [
        new("Products",
            Links:
            [
                new("layout-dashboard", "Analytics", "Real-time dashboards"),
                new("shield-check", "Security", "Threat detection suite"),
                new("zap", "Automation", "Workflow orchestration"),
            ],
            Featured: new("New", "AI-Powered Analytics",
                "Automatically surface insights from your data with our new machine learning pipeline. Now in public beta.")),
        new("Resources",
            Links:
            [
                new("book-open", "Documentation", "Guides and references"),
                new("newspaper", "Blog", "Engineering insights"),
                new("graduation-cap", "Academy", "Free courses"),
                new("message-circle", "Community", "Join 50k+ developers"),
            ],
            Featured: new("Featured", "Building at Scale",
                "How Vercel rebuilt their deployment pipeline to handle 10x traffic. Read the full case study.")),
        new("Company",
            Links:
            [
                new("users", "About", "Our story and team"),
                new("file-text", "Careers", "Open positions"),
                new("newspaper", "Press", "News and media kit"),
            ],
            Featured: new("Announcement", "Series C Funding",
                "We raised $120M to accelerate product development and expand into new markets. Read the announcement.")),
    ];

    private static readonly string[] _plainLinks = ["Pricing", "Contact"];

    private string? _active = null;

    private void HandleEnter(string label)
    {
        _active = label;
    }

    private void HandleLeave()
    {
        _active = null;
    }
}
