@* ============================================================
   Block: navbar-split-layout
   Title: NavbarSplitLayout
   Description: A split layout navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features logo and primary nav on the left, secondary actions including search, notifications, and user menu on the right with a subtle vertical divider separating navigation from actions.
   Source: original/blocks/navbar/navbar-split-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-2.5">
            @* Left: Logo + Primary Nav *@
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm">Acme</span>
                <div class="flex items-center gap-1">
                    @foreach (var lnk in _primaryLinks)
                    {
                        var link = lnk;
                        <button
                            type="button"
                            @onclick="@(() => _activeLink = link.Label)"
                            class="@Cn.Merge("relative rounded-md px-3 py-1.5 text-sm transition-colors", _activeLink == link.Label ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                            @link.Label
                            @if (_activeLink == link.Label)
                            {
                                <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* Right: Divider + Actions *@
            <div class="flex items-center gap-3">
                @* Vertical divider *@
                <div class="h-4 w-px bg-border"></div>

                <ButtonCn aria-label="Search" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>

                <div class="relative">
                    <ButtonCn aria-label="Notifications" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                        <LucideIconCn Name="bell" Size="14" Class="size-3.5 text-muted-foreground" />
                    </ButtonCn>
                    <span class="absolute top-0.5 right-0.5 size-1.5 rounded-full bg-red-500 pointer-events-none"></span>
                </div>

                <AvatarCn Class="size-6">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record PrimaryLink(string Label, string Href);

    private static readonly PrimaryLink[] _primaryLinks =
    [
        new("Overview", "#overview"),
        new("Projects", "#projects"),
        new("Analytics", "#analytics"),
        new("Settings", "#settings"),
    ];

    private string _activeLink = "Overview";
}
