@* ============================================================
   Block: navbar-open-source
   Title: NavbarOpenSource
   Description: An open source project navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a project logo with version badge, Docs, Examples, Playground, Blog, and Releases links, a GitHub stars count display, a Get Started CTA button, and a GitHub icon button with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-open-source.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Catalyst</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-mono font-normal text-[10px]">
                        @_version
                    </BadgeCn>
                </div>
                <nav class="hidden items-center gap-1 sm:flex">
                    @foreach (var link in _navLinks)
                    {
                        var lnk = link;
                        <button type="button"
                                class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _activeLink == lnk ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeLink = lnk)">
                            @lnk
                        </button>
                    }
                </nav>
            </div>

            <div class="flex items-center gap-3">
                @* GitHub stars *@
                <button type="button" class="flex items-center gap-1.5 rounded-md px-2 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                    <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-current" />
                    <span class="tabular-nums">@_starsCount</span>
                </button>

                <div class="flex items-center gap-2">
                    <ButtonCn aria-label="GitHub repository" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0">
                        <LucideIconCn Name="github" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-sm">
                        Get Started
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    Open source project navbar with version badge and GitHub stars
                </span>
                <span class="text-muted-foreground/60 text-xs">
                    Click nav links to see the active state indicator
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _navLinks = ["Docs", "Examples", "Playground", "Blog", "Releases"];
    private const string _starsCount = "12.4k";
    private const string _version = "v4.2";

    private string? _activeLink = null;
}
