@* ============================================================
   Block: navbar-dark-mode
   Title: NavbarDarkMode
   Description: A dark-themed navigation bar with zinc-950 background and zinc-100 text built with React, Next.js, shadcn/ui, and Tailwind CSS. Features high-contrast dark styling within a light page context, with zinc-400 default and zinc-100 hover link colors and framer-motion animations.
   Source: original/blocks/navbar/navbar-dark-mode.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Dark navbar *@
        <nav class="flex items-center justify-between bg-zinc-950 px-6 py-3">
            @* Logo *@
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded bg-zinc-100">
                    <span class="font-semibold text-zinc-950 text-xs">A</span>
                </div>
                <span class="font-medium text-sm text-zinc-100">Acme</span>
            </div>

            @* Nav links *@
            <div class="flex items-center gap-0.5"
                 @onmouseleave="@(() => _hoveredLink = null)">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isHovered = _hoveredLink == lbl;
                    <a href="@link.Href"
                       class="@Cn.Merge("relative px-3 py-1.5 text-sm transition-colors duration-200", isHovered ? "text-zinc-100" : "text-zinc-400")"
                       @onmouseenter="@(() => _hoveredLink = lbl)">
                        @if (isHovered)
                        {
                            <span class="absolute inset-0 rounded-md bg-zinc-800/60"></span>
                        }
                        <span class="relative z-10">@lbl</span>
                    </a>
                }
            </div>

            @* Actions *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-zinc-400 hover:bg-zinc-800/60 hover:text-zinc-100">
                    Sign In
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 bg-zinc-100 text-xs text-zinc-950 hover:bg-zinc-200">
                    Get Started
                </ButtonCn>
            </div>
        </nav>

        @* Light page content preview *@
        <div class="space-y-3 border-t px-6 py-8">
            <div class="h-2 w-3/4 rounded bg-muted/60"></div>
            <div class="h-2 w-1/2 rounded bg-muted/40"></div>
            <div class="h-2 w-2/3 rounded bg-muted/50"></div>
            <div class="h-2 w-2/5 rounded bg-muted/30"></div>
            <div class="h-2 w-3/5 rounded bg-muted/40"></div>
        </div>

        @* Description *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="size-1.5 rounded-full bg-zinc-950"></span>
            <span class="text-muted-foreground text-xs">
                Dark navbar contrasts with light page content below
            </span>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Dashboard", "#dashboard"),
        new("API", "#api"),
        new("Docs", "#docs"),
        new("Pricing", "#pricing"),
        new("Changelog", "#changelog"),
    ];

    private string? _hoveredLink = null;
}
