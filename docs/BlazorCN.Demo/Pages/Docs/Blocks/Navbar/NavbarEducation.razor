@* ============================================================
   Block: navbar-education
   Title: NavbarEducation
   Description: An online education platform navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a learning platform logo, course navigation links, a gamified streak counter, circular progress ring indicator, and user avatar with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-education.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo and nav *@
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm">LearnHub</span>

                <div class="hidden items-center gap-1 sm:flex">
                    @foreach (var lnk in _navLinks)
                    {
                        var link = lnk;
                        var isActive = _activeLink == link.Label;
                        <button type="button"
                                class="@Cn.Merge("relative rounded-md px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeLink = link.Label)">
                            @link.Label
                            @if (isActive)
                            {
                                <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* Right: Streak, progress, avatar *@
            <div class="flex items-center gap-3">
                @* Streak counter *@
                <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1">
                    <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-amber-500" />
                    <span class="font-medium text-xs tabular-nums">@_streakDays</span>
                    <span class="hidden text-muted-foreground text-xs sm:inline">day streak</span>
                </div>

                @* Progress ring *@
                <div class="relative flex size-8 items-center justify-center">
                    <svg class="-rotate-90 size-8" viewBox="0 0 24 24">
                        <title>@($"Course progress: {_progress}%")</title>
                        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" class="text-muted/50" />
                        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                class="text-foreground"
                                stroke-dasharray="@_circumference.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@(_progressOffset.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))" />
                    </svg>
                    <span class="absolute font-medium text-[9px] tabular-nums">@(_progress)%</span>
                </div>

                @* User avatar *@
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-[10px]">AK</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("My Courses", "#courses"),
        new("Browse", "#browse"),
        new("Community", "#community"),
        new("Certificates", "#certificates"),
    ];

    private const int _streakDays = 7;
    private const int _progress = 68;
    private static readonly double _circumference = 2 * Math.PI * 10;
    private static readonly double _progressOffset = _circumference - (_circumference * _progress) / 100.0;

    private string _activeLink = "My Courses";
}
