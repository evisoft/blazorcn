@* ============================================================
   Block: navbar-responsive-priority
   Title: NavbarResponsivePriority
   Description: A priority-plus pattern navbar built with React, Next.js, shadcn/ui, Tailwind CSS, and framer-motion. Shows as many navigation items as fit on wider screens then collapses remaining links into a More dropdown on narrow views, using a toggle state to demonstrate the responsive behavior.
   Source: original/blocks/navbar/navbar-responsive-priority.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <nav class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-6">
                <span class="shrink-0 font-medium text-sm">Acme</span>

                <div class="flex items-center gap-1">
                    @foreach (var lnk in _visibleLinks)
                    {
                        var link = lnk;
                        <button type="button"
                                class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _activeLink == link.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeLink = link.Label)">
                            @link.Label
                        </button>
                    }

                    @* More dropdown *@
                    @if (_overflowLinks.Length > 0)
                    {
                        <div class="relative">
                            <button type="button"
                                    class="@Cn.Merge("flex items-center gap-1 rounded-md px-3 py-1.5 text-sm transition-colors", (_moreOpen || System.Array.Exists(_overflowLinks, l => l.Label == _activeLink)) ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")"
                                    @onclick="@(() => _moreOpen = !_moreOpen)">
                                More
                                <LucideIconCn Name="chevron-down" Size="14" Class="@Cn.Merge("size-3.5 transition-transform duration-200", _moreOpen ? "rotate-180" : "")" />
                            </button>

                            @if (_moreOpen)
                            {
                                <div class="absolute top-full left-0 z-10 mt-1 min-w-[160px] overflow-hidden rounded-md border bg-card shadow-sm">
                                    <div class="p-1">
                                        @foreach (var lnk in _overflowLinks)
                                        {
                                            var link = lnk;
                                            <button type="button"
                                                    class="@Cn.Merge("flex w-full rounded-sm px-3 py-1.5 text-left text-sm transition-colors", _activeLink == link.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")"
                                                    @onclick="@(() => { _activeLink = link.Label; _moreOpen = false; })">
                                                @link.Label
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Upgrade
            </ButtonCn>
        </nav>

        @* Mode toggle + demo area *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="text-muted-foreground text-xs">View:</span>
                    <button type="button"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", !_isCompact ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => { _isCompact = false; _moreOpen = false; })">
                        Wide (all links)
                    </button>
                    <button type="button"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _isCompact ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _isCompact = true)">
                        Narrow (3 + More)
                    </button>
                </div>
                <span class="text-muted-foreground text-xs">
                    @_visibleLinks.Length visible · @_overflowLinks.Length in overflow
                </span>
            </div>
        </div>

        @* Content area *@
        <div class="border-t px-4 py-10">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="font-medium text-sm">@_activeLink</span>
                <span class="text-muted-foreground text-xs">
                    Toggle between Wide and Narrow to see the priority-plus pattern
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _allNavLinks =
    [
        new("Dashboard", "#dashboard"),
        new("Analytics", "#analytics"),
        new("Customers", "#customers"),
        new("Products", "#products"),
        new("Orders", "#orders"),
        new("Settings", "#settings"),
        new("Billing", "#billing"),
        new("Integrations", "#integrations"),
    ];

    private bool _isCompact = false;
    private bool _moreOpen = false;
    private string _activeLink = "Dashboard";

    private int VisibleCount => _isCompact ? 3 : _allNavLinks.Length;
    private NavLink[] _visibleLinks => _allNavLinks[..VisibleCount];
    private NavLink[] _overflowLinks => _allNavLinks[VisibleCount..];
}
