@* ============================================================
   Block: navbar-admin-panel
   Title: NavbarAdminPanel
   Description: An admin panel navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a hamburger toggle with shield icon, centered quick search bar, environment badge with status dot for Production or Staging, notification bell with count, and admin avatar with framer-motion animations.
   Source: original/blocks/navbar/navbar-admin-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Left: hamburger + branding *@
            <div class="flex shrink-0 items-center gap-2">
                <ButtonCn aria-label="Toggle admin sidebar" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0"
                          OnClick="@(() => _sidebarOpen = !_sidebarOpen)">
                    @if (_sidebarOpen)
                    {
                        <LucideIconCn Name="x" Size="16" Class="size-4" />
                    }
                    else
                    {
                        <LucideIconCn Name="menu" Size="16" Class="size-4" />
                    }
                </ButtonCn>
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Admin</span>
            </div>

            @* Center: search bar *@
            <div class="mx-auto w-full max-w-sm">
                <div class="relative">
                    <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                    <InputCn Placeholder="Search users, settings, logs..."
                             aria-label="Search users, settings, logs"
                             Class="h-8 border-border/50 bg-muted/30 pl-8 text-xs shadow-none focus-visible:ring-1" />
                </div>
            </div>

            @* Right: environment + notifications + avatar *@
            <div class="flex shrink-0 items-center gap-2">
                @* Environment badge *@
                <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1.5">
                    <span class="@($"size-1.5 rounded-full {_envDot}")" />
                    <span class="font-mono text-xs text-muted-foreground">@_environment</span>
                </div>

                @* Notification bell *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative size-8 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    @if (_notificationCount > 0)
                    {
                        <span class="absolute -right-1 -top-1 flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                            @_notificationCount
                        </span>
                    }
                </ButtonCn>

                @* Admin avatar *@
                <AvatarCn Class="ml-1 size-7">
                    <AvatarFallbackCn Class="text-[10px]">AD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private bool _sidebarOpen = true;
    private const string _environment = "Production";
    private const int _notificationCount = 5;

    private string _envDot => _environment == "Production" ? "bg-red-500" : "bg-amber-500";
}
