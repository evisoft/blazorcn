@* ============================================================
   Block: navbar-marketplace
   Title: NavbarMarketplace
   Description: An app marketplace navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a prominent center search bar, category dropdown on the left, For Developers link, install count with download icon, and user avatar on the right, styled like Shopify App Store or VS Code Marketplace with framer-motion animations.
   Source: original/blocks/navbar/navbar-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <span class="shrink-0 font-medium text-sm">AppStore</span>

            @* Category dropdown *@
            <div class="relative"
                 @onmouseenter="HandleMouseEnter"
                 @onmouseleave="HandleMouseLeave">
                <button type="button"
                        @onclick="@(() => _categoryOpen = !_categoryOpen)"
                        class="flex shrink-0 items-center gap-1 rounded-md px-2 py-1.5 text-muted-foreground text-sm transition-colors hover:bg-muted/50 hover:text-foreground">
                    @_selectedCategory
                    <LucideIconCn Name="chevron-down" Size="14" Class="@Cn.Merge("size-3.5 transition-transform duration-200", _categoryOpen ? "rotate-180" : "")" />
                </button>

                @if (_categoryOpen)
                {
                    <div class="absolute left-0 top-full z-50 mt-1 w-48 overflow-hidden rounded-md border bg-card shadow-md">
                        @foreach (var cat in _categories)
                        {
                            var item = cat;
                            <button type="button"
                                    @onclick="@(() => SelectCategory(item.Label))"
                                    class="@Cn.Merge("flex w-full items-center gap-2 px-3 py-2 text-left text-sm transition-colors hover:bg-muted/50", _selectedCategory == item.Label ? "text-foreground" : "text-muted-foreground")">
                                <span class="text-muted-foreground">
                                    <LucideIconCn Name="@item.IconName" Size="14" Class="size-3.5" />
                                </span>
                                @item.Label
                            </button>
                        }
                    </div>
                }
            </div>

            @* Search bar *@
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Placeholder="Search apps and integrations..."
                         Class="h-8 border-border/50 bg-muted/30 pl-8 text-sm shadow-none focus-visible:ring-1" />
            </div>

            @* For Developers link *@
            <button type="button"
                    class="hidden shrink-0 rounded-md px-2 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground sm:block">
                For Developers
            </button>

            @* Install count *@
            <div class="flex shrink-0 items-center gap-1.5 text-muted-foreground text-sm">
                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                <span class="tabular-nums">@_installCount</span>
            </div>

            @* User avatar *@
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
            </AvatarCn>
        </nav>
    </div>
</section>

@code {
    private bool _categoryOpen = false;
    private string _selectedCategory = "All Apps";
    private const string _installCount = "2.4k";

    private static readonly CategoryItem[] _categories =
    [
        new("All Apps",        "layout-grid"),
        new("Developer Tools", "code"),
        new("Productivity",    "zap"),
        new("Design",          "palette"),
        new("Security",        "shield-check"),
        new("Utilities",       "wrench"),
    ];

    private void SelectCategory(string label)
    {
        _selectedCategory = label;
        _categoryOpen = false;
    }

    private void HandleMouseEnter()
    {
        _categoryOpen = true;
    }

    private void HandleMouseLeave()
    {
        _categoryOpen = false;
    }

    private record CategoryItem(string Label, string IconName);
}
