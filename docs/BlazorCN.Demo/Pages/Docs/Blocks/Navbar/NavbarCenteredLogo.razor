@* ============================================================
   Block: navbar-centered-logo
   Title: NavbarCenteredLogo
   Description: A symmetrical navigation bar with centered logo built with React, Next.js, shadcn/ui, and Tailwind CSS. Features balanced left and right nav groups flanking a center logo with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-centered-logo.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center px-6 py-3">
            @* Left nav group *@
            <div class="flex flex-1 items-center justify-end gap-1">
                @foreach (var link in _leftLinks)
                {
                    var lbl = link.Label;
                    <a href="@link.Href"
                       class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @lbl
                        @if (_hoveredLink == lbl)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </a>
                }
            </div>

            @* Center logo *@
            <div class="mx-8 shrink-0">
                <div class="flex items-center gap-2">
                    <div class="flex size-7 items-center justify-center rounded-md bg-foreground">
                        <span class="font-semibold text-background text-xs">A</span>
                    </div>
                    <span class="font-medium text-sm">Acme</span>
                </div>
            </div>

            @* Right nav group *@
            <div class="flex flex-1 items-center gap-1">
                @foreach (var link in _rightLinks)
                {
                    var lbl = link.Label;
                    <a href="@link.Href"
                       class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @lbl
                        @if (_hoveredLink == lbl)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </a>
                }
                <div class="ml-auto">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Get Started
                    </ButtonCn>
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _leftLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
    ];

    private static readonly NavLink[] _rightLinks =
    [
        new("Pricing", "#pricing"),
        new("Contact", "#contact"),
    ];

    private string? _hoveredLink = null;
}
