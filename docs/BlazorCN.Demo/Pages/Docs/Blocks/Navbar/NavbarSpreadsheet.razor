@* ============================================================
   Block: navbar-spreadsheet
   Title: NavbarSpreadsheet
   Description: A spreadsheet application navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a logo with editable file name, classic menu bar with File, Edit, View, Insert, Format, Data, and Tools items, share button, collaborator avatars with overlap, and comment count indicator with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-spreadsheet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Top row: logo + file name + actions *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <LucideIconCn Name="file-spreadsheet" Size="20" Class="size-5 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Q4 Budget</span>
                <p class="text-xs text-muted-foreground">Last edited 2 hours ago</p>
            </div>

            @* Collaborator avatars *@
            <div class="flex items-center -space-x-2">
                @foreach (var collab in _collaborators)
                {
                    var c = collab;
                    <AvatarCn Class="size-6 border-2 border-card">
                        <AvatarFallbackCn Class="@Cn.Merge("text-[10px]", c.Color)">@c.Initials</AvatarFallbackCn>
                    </AvatarCn>
                }
            </div>

            @* Comments *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs text-muted-foreground">
                <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
                @_commentCount
            </ButtonCn>

            @* Share *@
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-3 text-xs">
                <LucideIconCn Name="share" Size="12" Class="size-3" />
                Share
            </ButtonCn>
        </div>

        @* Bottom row: menu bar *@
        <nav class="flex items-center gap-0 px-2 py-1">
            @foreach (var item in _menuItems)
            {
                var menuItem = item;
                <button type="button" class="rounded-sm px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                    @menuItem
                </button>
            }
        </nav>
    </div>
</section>

@code {
    private const int _commentCount = 12;

    private static readonly string[] _menuItems = ["File", "Edit", "View", "Insert", "Format", "Data", "Tools"];

    private record Collaborator(string Initials, string Color);

    private static readonly Collaborator[] _collaborators =
    [
        new("JD", "bg-blue-500/10 text-blue-600"),
        new("SK", "bg-emerald-500/10 text-emerald-600"),
        new("MR", "bg-amber-500/10 text-amber-600"),
    ];
}
