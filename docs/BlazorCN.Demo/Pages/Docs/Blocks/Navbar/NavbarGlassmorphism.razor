@* ============================================================
   Block: navbar-glassmorphism
   Title: NavbarGlassmorphism
   Description: A glassmorphism-style navigation bar with backdrop blur and semi-transparent background built with React, Next.js, shadcn/ui, and Tailwind CSS. Features backdrop-blur-xl, bg-background/60 transparency, and a colorful patterned background to demonstrate the frosted glass effect using framer-motion animations.
   Source: original/blocks/navbar/navbar-glassmorphism.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        @* Colorful background to demonstrate glass effect *@
        <div class="relative h-[280px]">
            <div class="absolute inset-0 bg-zinc-100 dark:bg-zinc-900"></div>
            <div class="absolute top-8 left-12 size-32 rounded-full bg-blue-400/30 blur-2xl"></div>
            <div class="absolute top-16 right-16 size-40 rounded-full bg-violet-400/25 blur-2xl"></div>
            <div class="absolute bottom-8 left-1/3 size-36 rounded-full bg-emerald-400/20 blur-2xl"></div>
            <div class="absolute right-1/4 bottom-12 size-28 rounded-full bg-amber-400/25 blur-2xl"></div>

            @* Glassmorphism navbar *@
            <nav class="@Cn.Merge("absolute inset-x-4 top-4 z-10 flex items-center justify-between rounded-lg px-6 py-3 transition-all duration-300", _glassActive ? "border border-white/20 bg-background/60 shadow-sm backdrop-blur-xl dark:border-white/10" : "border bg-background")">
                @* Logo *@
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded bg-foreground">
                        <span class="font-semibold text-background text-xs">A</span>
                    </div>
                    <span class="font-medium text-sm">Acme</span>
                </div>

                @* Nav links *@
                <div class="flex items-center gap-1">
                    @foreach (var link in _navLinks)
                    {
                        var lbl = link.Label;
                        <a href="@link.Href"
                           class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                           @onmouseenter="@(() => _hoveredLink = lbl)"
                           @onmouseleave="@(() => _hoveredLink = null)">
                            @lbl
                            @if (_hoveredLink == lbl)
                            {
                                <span class="absolute inset-x-1 -bottom-0.5 mx-2 h-px bg-foreground/50"></span>
                            }
                        </a>
                    }
                </div>

                @* CTA *@
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Sign In
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Get Started
                    </ButtonCn>
                </div>
            </nav>

            @* Demo content beneath glass *@
            <div class="flex h-full flex-col items-center justify-center gap-2 px-6 pt-16 text-center">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                    Glassmorphism demo
                </span>
                <p class="max-w-xs text-muted-foreground text-sm">
                    The navbar floats above this colorful background with a frosted glass effect.
                </p>
            </div>
        </div>

        @* State toggle *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="@Cn.Merge("size-1.5 rounded-full", _glassActive ? "bg-blue-500" : "bg-muted-foreground/40")"></span>
                <span class="text-muted-foreground text-xs">
                    @(_glassActive ? "Glass effect — backdrop-blur-xl active" : "Solid background — no blur")
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _glassActive = !_glassActive)">
                @(_glassActive ? "Show solid" : "Show glass")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];

    private bool _glassActive = true;
    private string? _hoveredLink = null;
}
