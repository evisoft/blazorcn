@* ============================================================
   Block: navbar-crm
   Title: NavbarCrm
   Description: A CRM application navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a SalesForge logo, deal pipeline navigation with active state indicators, contacts and companies links, activities and reports tabs, quick search, new deal button with plus icon, and user avatar with sales quota progress using framer-motion animations.
   Source: original/blocks/navbar/navbar-crm.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Logo *@
            <span class="shrink-0 font-medium text-sm">SalesForge</span>

            @* Nav links *@
            <div class="hidden items-center gap-0.5 sm:flex">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isActive = _activeLink == lbl;
                    <button type="button"
                            class="@Cn.Merge("relative flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeLink = lbl)">
                        <LucideIconCn Name="@link.IconName" Size="14" Class="size-3.5" />
                        @lbl
                        @if (isActive)
                        {
                            <span class="absolute inset-x-2.5 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Right actions *@
            <div class="ml-auto flex items-center gap-2">
                @* Quick search *@
                <ButtonCn aria-label="Search" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                    <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                @* New Deal *@
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Deal
                </ButtonCn>

                @* User avatar with quota *@
                <div class="flex items-center gap-2">
                    <div class="hidden flex-col items-end sm:flex">
                        <span class="font-medium text-xs">Rachel K.</span>
                        <span class="text-[10px] text-muted-foreground">@(_quotaPercent)% of quota</span>
                    </div>
                    <div class="relative">
                        <AvatarCn Class="size-7">
                            <AvatarFallbackCn Class="text-[10px]">RK</AvatarFallbackCn>
                        </AvatarCn>
                        @* Quota ring indicator *@
                        <svg class="absolute -inset-0.5 -rotate-90"
                             viewBox="0 0 28 28"
                             fill="none"
                             role="img">
                            <title>Sales quota: @(_quotaPercent)%</title>
                            <circle cx="14" cy="14" r="12" stroke-width="1.5" class="stroke-muted" />
                            <circle cx="14" cy="14" r="12"
                                    stroke-width="1.5"
                                    stroke-dasharray="@($"{(_quotaPercent / 100.0) * 75.4:F2} 75.4")"
                                    stroke-linecap="round"
                                    class="stroke-emerald-500" />
                        </svg>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string IconName);

    private static readonly NavLink[] _navLinks =
    [
        new("Deals", "circle-dot"),
        new("Contacts", "users"),
        new("Companies", "building"),
        new("Activities", "activity"),
        new("Reports", "bar-chart-3"),
    ];

    private const int _quotaPercent = 85;
    private string _activeLink = "Deals";
}
