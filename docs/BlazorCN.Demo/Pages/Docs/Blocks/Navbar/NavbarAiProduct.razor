@* ============================================================
   Block: navbar-ai-product
   Title: NavbarAiProduct
   Description: An AI product navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Neural brand logo with zap icon, navigation links for Models, Playground, API, Pricing, and Research, a token usage indicator, and an Upgrade CTA button with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-ai-product.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">Neural</span>
            </div>

            @* Nav links *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var navLink = link;
                    <button
                        type="button"
                        @onclick="@(() => SetActive(navLink.Label))"
                        @onmouseenter="@(() => _hovered = navLink.Label)"
                        @onmouseleave="@(() => _hovered = null)"
                        class="@Cn.Merge("relative shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeLink == navLink.Label ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                        @navLink.Label
                        @if (_activeLink == navLink.Label || _hovered == navLink.Label)
                        {
                            <span class="absolute inset-x-2.5 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Token usage indicator *@
            <div class="flex shrink-0 items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1.5">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-mono text-muted-foreground text-xs">@_tokenUsage tokens</span>
            </div>

            @* Upgrade CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Upgrade</ButtonCn>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Models", "#models"),
        new("Playground", "#playground"),
        new("API", "#api"),
        new("Pricing", "#pricing"),
        new("Research", "#research"),
    ];

    private const string _tokenUsage = "1.2k";

    private string _activeLink = "Playground";
    private string? _hovered = null;

    private void SetActive(string label)
    {
        _activeLink = label;
    }
}
