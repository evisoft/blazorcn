@code {
    private string _fileName = ""Untitled Design"";
    private bool _isEditing = false;
    private bool _saved = false;

    private record Collaborator(string Initials, string Name);

    private static readonly Collaborator[] _collaborators =
    [
        new(""AK"", ""Anna Kim""),
        new(""MR"", ""Marco Rivera""),
        new(""JL"", ""Jess Lee""),
    ];

    private void HandleStartEdit()
    {
        _isEditing = true;
    }

    private void HandleFinishEdit()
    {
        _isEditing = false;
        if (!string.IsNullOrWhiteSpace(_fileName))
        {
            _saved = true;
            _ = ResetSavedAfterDelay();
        }
        else
        {
            _fileName = ""Untitled Design"";
        }
    }

    private async Task ResetSavedAfterDelay()
    {
        await Task.Delay(1500);
        _saved = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == ""Enter"")
        {
            HandleFinishEdit();
        }
        else if (e.Key == ""Escape"")
        {
            _fileName = ""Untitled Design"";
            _isEditing = false;
        }
    }
}";

