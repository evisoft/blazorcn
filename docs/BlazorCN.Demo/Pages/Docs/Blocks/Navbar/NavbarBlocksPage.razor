@code {
    private record FileTab(string Id, string Name, string Extension, bool Active);

    private List<FileTab> _tabs =
    [
        new(""1"", ""index"", "".tsx"", true),
        new(""2"", ""styles"", "".css"", false),
        new(""3"", ""readme"", "".md"", false),
        new(""4"", ""utils"", "".ts"", false),
    ];

    private static string GetExtensionColor(string extension) => extension switch
    {
        "".tsx"" => ""bg-blue-500"",
        "".css"" => ""bg-purple-500"",
        "".md""  => ""bg-zinc-400"",
        "".ts""  => ""bg-blue-400"",
        _      => ""bg-zinc-400"",
    };

    private void SetActiveTab(string id)
    {
        _tabs = _tabs.Select(t => new FileTab(t.Id, t.Name, t.Extension, t.Id == id)).ToList();
    }

    private void CloseTab(string id)
    {
        var wasActive = _tabs.FirstOrDefault(t => t.Id == id)?.Active ?? false;
        var filtered = _tabs.Where(t => t.Id != id).ToList();
        if (wasActive && filtered.Count > 0)
        {
            var first = filtered[0];
            filtered[0] = new FileTab(first.Id, first.Name, first.Extension, true);
        }
        _tabs = filtered;
    }
}";

