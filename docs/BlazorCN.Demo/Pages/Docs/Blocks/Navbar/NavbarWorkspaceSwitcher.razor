@* ============================================================
   Block: navbar-workspace-switcher
   Title: NavbarWorkspaceSwitcher
   Description: A SaaS navigation bar with workspace and organization switcher dropdown built with React, Next.js, shadcn/ui, and Tailwind CSS. Features workspace avatar, name display, workspace list with create option, standard nav links, and user menu.
   Source: original/blocks/navbar/navbar-workspace-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Workspace Switcher *@
            <div class="flex items-center gap-3">
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <button type="button"
                                class="flex items-center gap-2 rounded-md px-2 py-1 transition-colors hover:bg-muted/50">
                            <AvatarCn Class="size-6">
                                <AvatarFallbackCn Class="text-[10px]">@_activeWorkspace.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex items-center gap-1.5">
                                <span class="font-medium text-sm">@_activeWorkspace.Name</span>
                                <span class="rounded-sm bg-muted px-1.5 py-0.5 text-[10px] text-muted-foreground">
                                    @_activeWorkspace.Plan
                                </span>
                            </div>
                            <LucideIconCn Name="chevrons-up-down" Size="14" Class="size-3.5 text-muted-foreground" />
                        </button>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.Start" Class="w-64">
                        <DropdownMenuLabelCn Class="text-muted-foreground text-xs">
                            Workspaces
                        </DropdownMenuLabelCn>
                        @foreach (var ws in _workspaces)
                        {
                            var workspace = ws;
                            <DropdownMenuItemCn Class="flex items-center gap-2"
                                               OnClick="@(() => _activeWorkspace = workspace)">
                                <AvatarCn Class="size-6">
                                    <AvatarFallbackCn Class="text-[10px]">@workspace.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="flex flex-1 flex-col">
                                    <span class="text-sm">@workspace.Name</span>
                                    <span class="text-muted-foreground text-xs">@workspace.Plan</span>
                                </div>
                                @if (workspace.Id == _activeWorkspace.Id)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-foreground" />
                                }
                            </DropdownMenuItemCn>
                        }
                        <DropdownMenuSeparatorCn />
                        <DropdownMenuItemCn Class="flex items-center gap-2">
                            <div class="flex size-6 items-center justify-center rounded-full border border-dashed">
                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                            </div>
                            <span class="text-sm">Create Workspace</span>
                        </DropdownMenuItemCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>

                <div class="h-5 w-px bg-border"></div>

                @* Nav links *@
                <div class="flex items-center gap-1">
                    @foreach (var lnk in _navLinks)
                    {
                        <a href="@lnk.Href"
                           class="px-2.5 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                            @lnk.Label
                        </a>
                    }
                </div>
            </div>

            @* Right: User menu *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-7 w-7 p-0">
                    <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <button type="button"
                                class="rounded-full ring-offset-background transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                            <AvatarCn Class="size-6">
                                <AvatarImageCn Src="https://avatars.githubusercontent.com/u/1?v=4" Alt="User avatar" />
                                <AvatarFallbackCn>JD</AvatarFallbackCn>
                            </AvatarCn>
                        </button>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-48">
                        <DropdownMenuLabelCn Class="font-normal">
                            <div class="flex flex-col gap-0.5">
                                <span class="font-medium text-sm">John Doe</span>
                                <span class="text-muted-foreground text-xs">@("john@acme.com")</span>
                            </div>
                        </DropdownMenuLabelCn>
                        <DropdownMenuSeparatorCn />
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="user" Size="16" Class="size-4" />
                            Profile
                        </DropdownMenuItemCn>
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="settings" Size="16" Class="size-4" />
                            Settings
                        </DropdownMenuItemCn>
                        <DropdownMenuSeparatorCn />
                        <DropdownMenuItemCn>
                            <LucideIconCn Name="log-out" Size="16" Class="size-4" />
                            Sign out
                        </DropdownMenuItemCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record Workspace(string Id, string Name, string Avatar, string Initials, string Plan);
    private record NavLink(string Label, string Href);

    private static readonly Workspace[] _workspaces =
    [
        new("1", "Acme Corp",      "", "AC", "Pro"),
        new("2", "Personal",       "", "P",  "Free"),
        new("3", "Design Studio",  "", "DS", "Team"),
        new("4", "Startup Labs",   "", "SL", "Pro"),
    ];

    private static readonly NavLink[] _navLinks =
    [
        new("Dashboard", "#dashboard"),
        new("Projects",  "#projects"),
        new("Settings",  "#settings"),
    ];

    private Workspace _activeWorkspace = _workspaces[0];
}
