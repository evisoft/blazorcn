@* ============================================================
   Block: navbar-cloud-storage
   Title: NavbarCloudStorage
   Description: A cloud storage navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a CloudVault logo, file navigation for My Files, Shared, Starred, and Trash, center search bar, storage usage progress bar showing used and total space, upload button with cloud arrow icon, and user avatar with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-cloud-storage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-1.5">
                <LucideIconCn Name="hard-drive" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">CloudVault</span>
            </div>

            @* Nav links *@
            <div class="hidden items-center gap-0.5 sm:flex">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isActive = _activeLink == lbl;
                    <button type="button"
                            class="@Cn.Merge("relative flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeLink = lbl)">
                        <LucideIconCn Name="@link.IconName" Size="14" Class="size-3.5" />
                        @lbl
                        @if (isActive)
                        {
                            <span class="absolute inset-x-2.5 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Center: Search *@
            <div class="mx-2 hidden flex-1 lg:block">
                <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-1.5">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <input type="text"
                           value="@_searchValue"
                           @oninput="@((ChangeEventArgs e) => _searchValue = e.Value?.ToString() ?? "")"
                           placeholder="Search in CloudVault..."
                           class="h-5 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                </div>
            </div>

            @* Right: Storage + Upload + Avatar *@
            <div class="ml-auto flex items-center gap-3">
                @* Storage usage *@
                <div class="hidden items-center gap-2 sm:flex">
                    <div class="flex flex-col items-end gap-0.5">
                        <span class="text-[10px] text-muted-foreground">
                            @_usedGB GB / @_totalGB GB
                        </span>
                        <div class="h-1 w-20 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/60" style="@($"width:{_usagePercent}%")"></div>
                        </div>
                    </div>
                </div>

                @* Upload *@
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="cloud-upload" Size="14" Class="size-3.5" />
                    <span class="hidden sm:inline">Upload</span>
                </ButtonCn>

                @* User avatar *@
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-[10px]">TN</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string IconName);

    private static readonly NavLink[] _navLinks =
    [
        new("My Files", "file"),
        new("Shared", "users"),
        new("Starred", "star"),
        new("Trash", "trash-2"),
    ];

    private readonly double _usedGB = 7.2;
    private readonly int _totalGB = 15;
    private int _usagePercent => (int)Math.Round(_usedGB / _totalGB * 100);

    private string _activeLink = "My Files";
    private string _searchValue = "";
}
