@* ============================================================
   Block: navbar-theme-toggle
   Title: NavbarThemeToggle
   Description: A clean navigation bar with dark and light mode toggle built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a sun and moon icon toggle with smooth rotation animation, nav links that change color to demonstrate the theme, and a system auto option in a dropdown using framer-motion transitions.
   Source: original/blocks/navbar/navbar-theme-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="@Cn.Merge("overflow-hidden rounded-lg border transition-colors duration-300", _isDark ? "border-zinc-700 bg-zinc-900 text-zinc-100" : "bg-card")">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <span class="font-medium text-sm">Acme Inc</span>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lnk = link;
                    <a href="@lnk.Href"
                       class="@Cn.Merge("px-3 py-1.5 text-sm transition-colors", _isDark ? "text-zinc-400 hover:text-zinc-100" : "text-muted-foreground hover:text-foreground")">
                        @lnk.Label
                    </a>
                }
            </div>

            @* Theme toggle *@
            <div class="relative">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="@Cn.Merge("size-8 p-0", _isDark ? "text-zinc-400 hover:bg-zinc-800 hover:text-zinc-100" : "")" OnClick="@(() => _dropdownOpen = !_dropdownOpen)" aria-label="Dark mode">
                    @if (_isDark)
                    {
                        <LucideIconCn Name="moon" Size="16" Class="size-4" />
                    }
                    else
                    {
                        <LucideIconCn Name="sun" Size="16" Class="size-4" />
                    }
                </ButtonCn>

                @if (_dropdownOpen)
                {
                    <div class="@Cn.Merge("absolute right-0 z-50 mt-2 w-40 overflow-hidden rounded-md border shadow-md", _isDark ? "border-zinc-700 bg-zinc-800" : "bg-popover")">
                        <div class="p-1">
                            @foreach (var option in _themeOptions)
                            {
                                var opt = option;
                                var isActive = _theme == opt.Value;
                                <button type="button"
                                        @onclick="@(() => SelectTheme(opt.Value))"
                                        class="@Cn.Merge("flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm transition-colors", _isDark ? (isActive ? "text-zinc-100 hover:bg-zinc-700" : "text-zinc-400 hover:bg-zinc-700") : (isActive ? "text-foreground hover:bg-muted" : "text-muted-foreground hover:bg-muted"))">
                                    <LucideIconCn Name="@opt.IconName" Size="16" Class="size-4" />
                                    <span class="flex-1 text-left">@opt.Label</span>
                                    @if (isActive)
                                    {
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);
    private record ThemeOption(string Value, string Label, string IconName);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];

    private static readonly ThemeOption[] _themeOptions =
    [
        new("light", "Light", "sun"),
        new("dark", "Dark", "moon"),
        new("system", "System", "monitor"),
    ];

    private string _theme = "light";
    private bool _dropdownOpen = false;

    private string _resolvedTheme => _theme == "system" ? "light" : _theme;
    private bool _isDark => _resolvedTheme == "dark";

    private void SelectTheme(string value)
    {
        _theme = value;
        _dropdownOpen = false;
    }
}
