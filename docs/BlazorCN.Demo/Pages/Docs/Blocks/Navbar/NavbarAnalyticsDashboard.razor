@* ============================================================
   Block: navbar-analytics-dashboard
   Title: NavbarAnalyticsDashboard
   Description: An analytics dashboard navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Metrics brand logo, tab-style navigation for Overview, Acquisition, Engagement, Monetization, and Retention, a date range picker button, and an Export action button with framer-motion entrance animations. Inspired by Google Analytics.
   Source: original/blocks/navbar/navbar-analytics-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">Metrics</span>
            </div>

            @* Tab navigation *@
            <div class="flex min-w-0 flex-1 items-center gap-0.5">
                @foreach (var tab in _tabs)
                {
                    var t = tab;
                    <button
                        type="button"
                        @onclick="@(() => _activeTab = t.Label)"
                        class="@Cn.Merge("relative shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeTab == t.Label ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                        @t.Label
                        @if (_activeTab == t.Label)
                        {
                            <span class="absolute inset-x-1 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Date range picker *@
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 text-xs">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                @_dateRange
            </ButtonCn>

            @* Export *@
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Export
            </ButtonCn>
        </nav>
    </div>
</section>

@code {
    private record TabItem(string Label, string Href);

    private static readonly TabItem[] _tabs =
    [
        new("Overview", "#overview"),
        new("Acquisition", "#acquisition"),
        new("Engagement", "#engagement"),
        new("Monetization", "#monetization"),
        new("Retention", "#retention"),
    ];

    private const string _dateRange = "Last 7 days";

    private string _activeTab = "Overview";
}
