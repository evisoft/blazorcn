@* ============================================================
   Block: navbar-healthcare
   Title: NavbarHealthcare
   Description: A healthcare and medical portal navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a medical logo with cross icon, patient navigation links for appointments, records, messages, and prescriptions, a prominent emergency button, and patient name display using framer-motion animations.
   Source: original/blocks/navbar/navbar-healthcare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo and nav *@
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-1.5">
                    <div class="flex size-5 items-center justify-center rounded bg-foreground">
                        <LucideIconCn Name="plus" Size="12" Class="size-3 text-background" />
                    </div>
                    <span class="font-medium text-sm">MedPortal</span>
                </div>

                <div class="hidden items-center gap-1 sm:flex">
                    @foreach (var link in _navLinks)
                    {
                        var lbl = link.Label;
                        var isActive = _activeLink == lbl;
                        <button type="button"
                                class="@Cn.Merge("relative flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeLink = lbl)">
                            @lbl
                            @if (link.Count.HasValue)
                            {
                                <span class="flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                                    @link.Count
                                </span>
                            }
                            @if (isActive)
                            {
                                <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* Right: Emergency + patient *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 border-red-200 text-red-600 text-xs hover:bg-red-50 hover:text-red-700 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-950 dark:hover:text-red-300">
                    <LucideIconCn Name="phone" Size="12" Class="size-3" />
                    <span class="hidden sm:inline">Emergency</span>
                </ButtonCn>

                <div class="ml-1 flex items-center gap-2">
                    <span class="hidden font-medium text-sm sm:inline">Sarah M.</span>
                    <AvatarCn Class="size-7">
                        <AvatarFallbackCn Class="text-[10px]">SM</AvatarFallbackCn>
                    </AvatarCn>
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href, int? Count = null);

    private static readonly NavLink[] _navLinks =
    [
        new("Appointments", "#appointments"),
        new("Records", "#records"),
        new("Messages", "#messages", 2),
        new("Prescriptions", "#prescriptions"),
    ];

    private string _activeLink = "Appointments";
}
