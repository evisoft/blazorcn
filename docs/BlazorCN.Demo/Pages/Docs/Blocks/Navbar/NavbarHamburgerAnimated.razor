@* ============================================================
   Block: navbar-hamburger-animated
   Title: NavbarHamburgerAnimated
   Description: A navbar with a beautifully animated hamburger-to-X icon toggle built with React, Next.js, shadcn/ui, Tailwind CSS, and framer-motion. Three lines morph into an X with smooth CSS transitions, revealing a full-width panel below with staggered link animations that slide in from the left.
   Source: original/blocks/navbar/navbar-hamburger-animated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar row *@
        <nav class="flex items-center justify-between px-4 py-3">
            <span class="font-medium text-sm">Acme Inc</span>

            <div class="flex items-center gap-3">
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started
                </ButtonCn>

                @* Animated hamburger button *@
                <button type="button"
                        @onclick="@(() => _isOpen = !_isOpen)"
                        class="relative flex size-8 flex-col items-center justify-center gap-[5px] rounded-md transition-colors hover:bg-muted/50"
                        aria-label="@(_isOpen ? "Close menu" : "Open menu")">
                    <span class="@Cn.Merge("block h-px w-4 bg-foreground transition-transform duration-300 ease-in-out", _isOpen ? "translate-y-[6px] rotate-45" : "")"></span>
                    <span class="@Cn.Merge("block h-px w-4 bg-foreground transition-all duration-200", _isOpen ? "opacity-0 -translate-x-2" : "opacity-100")"></span>
                    <span class="@Cn.Merge("block h-px w-4 bg-foreground transition-transform duration-300 ease-in-out", _isOpen ? "-translate-y-[6px] -rotate-45" : "")"></span>
                </button>
            </div>
        </nav>

        @* Expandable menu panel *@
        @if (_isOpen)
        {
            <div class="overflow-hidden border-t">
                <div class="p-4">
                    @foreach (var link in _menuLinks)
                    {
                        var lnk = link;
                        var isLast = lnk == _menuLinks[_menuLinks.Length - 1];
                        <a href="@lnk.Href"
                           class="@Cn.Merge("flex items-center gap-3 px-3 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@lnk.Label</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@lnk.Description</p>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record MenuLink(string Label, string Href, string Description);

    private static readonly MenuLink[] _menuLinks =
    [
        new("Products",      "#products",  "Explore our full product suite"),
        new("Solutions",     "#solutions", "Industry-specific workflows"),
        new("Pricing",       "#pricing",   "Plans for teams of every size"),
        new("Documentation", "#docs",      "Guides, references, and APIs"),
        new("Blog",          "#blog",      "Engineering insights and updates"),
        new("Contact",       "#contact",   "Get in touch with our team"),
    ];

    private bool _isOpen = false;
}
