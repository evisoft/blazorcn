@* ============================================================
   Block: navbar-with-banner
   Title: NavbarWithBanner
   Description: A navigation bar with a promotional accent banner built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a top banner with sale messaging and CTA button, smooth dismiss animation with framer-motion, and a standard navigation bar visually connected below.
   Source: original/blocks/navbar/navbar-with-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Promotional banner *@
        @if (_bannerVisible)
        {
            <div class="overflow-hidden">
                <div class="flex items-center justify-between gap-3 bg-foreground px-4 py-2">
                    <div class="flex flex-1 items-center justify-center gap-3">
                        <span class="text-center text-background text-xs font-medium">
                            Black Friday: 50% off all plans. Ends in 2 days.
                        </span>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                                  Class="h-6 shrink-0 border-background/30 bg-transparent px-2.5 text-background text-xs hover:bg-background/10 hover:text-background">
                            Claim Offer
                        </ButtonCn>
                    </div>
                    <button type="button"
                            @onclick="@(() => _bannerVisible = false)"
                            class="shrink-0 rounded-sm p-0.5 text-background/70 transition-colors hover:text-background"
                            aria-label="Dismiss banner">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                    </button>
                </div>
            </div>
        }

        @* Navbar *@
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <span class="font-medium text-sm">Acme Inc</span>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    <a href="@link.Href"
                       class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @link.Label
                        @if (_hoveredLink == lbl)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </a>
                }
            </div>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Get Started</ButtonCn>
        </nav>
    </div>
</section>

@code {
    private bool _bannerVisible = true;
    private string? _hoveredLink = null;

    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];
}
