@* ============================================================
   Block: navbar-transparent-hero
   Title: NavbarTransparentHero
   Description: A transparent glass navigation bar designed for hero sections built with React, Next.js, shadcn/ui, and Tailwind CSS. Features backdrop blur, white text on dark backgrounds, and a toggle to simulate solid scroll state using framer-motion.
   Source: original/blocks/navbar/navbar-transparent-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">

        @* Simulated dark hero background *@
        <div class="relative h-[320px] bg-zinc-900">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(120,119,198,0.15),_transparent_50%)]" />

            @* Navbar *@
            <nav class="@Cn.Merge("absolute inset-x-0 top-0 z-10 flex items-center justify-between px-6 py-3 transition-colors duration-300", _scrolled ? "border-b border-border bg-background/95 backdrop-blur-lg" : "bg-transparent")">

                @* Logo *@
                <span class="@Cn.Merge("font-medium text-sm transition-colors duration-300", _scrolled ? "text-foreground" : "text-white")">
                    Acme Inc
                </span>

                @* Nav links *@
                <div class="flex items-center gap-1">
                    @foreach (var link in _navLinks)
                    {
                        <a href="@link.Href"
                           class="@Cn.Merge("px-3 py-1.5 text-sm transition-colors duration-300", _scrolled ? "text-muted-foreground hover:text-foreground" : "text-white/70 hover:text-white")">
                            @link.Label
                        </a>
                    }
                </div>

                @* CTA *@
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(_scrolled ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Class="@Cn.Merge("h-7 gap-1.5 text-xs", _scrolled ? "" : "border-white/20 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20 hover:text-white")">
                    Get Started
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </ButtonCn>
            </nav>

            @* Hero content *@
            <div class="flex h-full flex-col items-center justify-center gap-3 px-6 pt-12 text-center">
                <span class="font-medium text-white/60 text-xs uppercase tracking-wider">
                    Ship faster with Acme
                </span>
                <h1 class="max-w-md font-medium text-2xl text-white tabular-nums">
                    Build products your customers love
                </h1>
                <p class="max-w-sm text-sm text-white/50">
                    The modern platform for teams that move fast. Start building today with powerful tools
                    and seamless integrations.
                </p>
            </div>
        </div>

        @* State toggle *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-500" />
                <span class="text-muted-foreground text-xs">
                    @(_scrolled ? "Scrolled state (solid)" : "Top state (transparent)")
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                      OnClick="@(() => _scrolled = !_scrolled)">
                Toggle scroll state
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _scrolled = false;

    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Resources", "#resources"),
        new("Blog", "#blog"),
    ];
}
