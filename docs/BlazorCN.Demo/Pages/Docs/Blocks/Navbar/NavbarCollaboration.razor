@* ============================================================
   Block: navbar-collaboration
   Title: NavbarCollaboration
   Description: A real-time collaboration navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a CoEdit logo, editable file name with pencil icon, presence indicators showing active collaborators as colored dots, a Share button with lock icon, comment count badge, and live save status indicator with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-collaboration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Left: logo *@
            <div class="flex shrink-0 items-center gap-2">
                <span class="font-medium text-sm">CoEdit</span>
            </div>

            <div class="h-4 w-px bg-border"></div>

            @* Center: file name *@
            <div class="flex min-w-0 flex-1 items-center justify-center gap-2">
                <span class="truncate text-sm text-muted-foreground">Q4 Product Strategy</span>
                <LucideIconCn Name="pencil" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
            </div>

            @* Right: presence + share + comments + save status *@
            <div class="flex shrink-0 items-center gap-3">
                @* Presence indicators *@
                <div class="flex items-center -space-x-1">
                    @foreach (var collab in _collaborators)
                    {
                        var user = collab;
                        <span class="@Cn.Merge("size-2.5 rounded-full border-2 border-card", user.Color)"></span>
                    }
                </div>

                <div class="h-4 w-px bg-border"></div>

                @* Share button *@
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs">
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    Share
                </ButtonCn>

                @* Comment count *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                    <span class="tabular-nums">@_commentCount</span>
                </ButtonCn>

                <div class="h-4 w-px bg-border"></div>

                @* Save status *@
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                    <span class="text-muted-foreground text-xs">All changes saved</span>
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private const int _commentCount = 12;

    private record Collaborator(string Name, string Color);

    private static readonly Collaborator[] _collaborators =
    [
        new("Sarah Chen",   "bg-blue-500"),
        new("Alex Rivera",  "bg-emerald-500"),
        new("Jordan Lee",   "bg-amber-500"),
    ];
}
