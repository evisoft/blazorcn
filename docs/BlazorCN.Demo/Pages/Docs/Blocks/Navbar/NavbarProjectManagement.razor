@* ============================================================
   Block: navbar-project-management
   Title: NavbarProjectManagement
   Description: A project management navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Taskflow brand logo, My Tasks, Projects, Team, Calendar, and Reports navigation, a New Task quick-action button, filter toggle, notification bell with indicator dot, and user avatar with framer-motion entrance animations. Inspired by Jira and Asana.
   Source: original/blocks/navbar/navbar-project-management.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="list-todo" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">Taskflow</span>
            </div>

            @* Nav links *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isActive = _activeLink == lbl;
                    <button type="button"
                            class="@Cn.Merge("relative shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", isActive ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeLink = lbl)">
                        @lbl
                        @if (isActive)
                        {
                            <span class="absolute inset-x-2.5 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Right actions *@
            <div class="flex shrink-0 items-center gap-1">
                @* New Task *@
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Task
                </ButtonCn>

                @* Filter toggle *@
                <ButtonCn aria-label="Toggle filters" Variant="@(_filterActive ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="size-8 p-0"
                          OnClick="@(() => _filterActive = !_filterActive)">
                    <LucideIconCn Name="filter" Size="16" Class="@Cn.Merge("size-4", _filterActive ? "text-foreground" : "text-muted-foreground")" />
                </ButtonCn>

                @* Notifications *@
                <ButtonCn aria-label="Notifications" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative size-8 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="absolute top-1.5 right-1.5 size-1.5 rounded-full bg-red-500"></span>
                </ButtonCn>

                @* User avatar *@
                <AvatarCn Class="ml-1 size-7">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("My Tasks", "#tasks"),
        new("Projects", "#projects"),
        new("Team", "#team"),
        new("Calendar", "#calendar"),
        new("Reports", "#reports"),
    ];

    private string _activeLink = "My Tasks";
    private bool _filterActive = false;
}
