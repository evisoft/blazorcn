@* ============================================================
   Block: navbar-flyout-panel
   Title: NavbarFlyoutPanel
   Description: A flyout navigation panel navbar built with React, Next.js, shadcn/ui, and Tailwind CSS featuring hover-triggered panels with distinct layouts per nav item and framer-motion AnimatePresence for smooth fade transitions
   Source: original/blocks/navbar/navbar-flyout-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Navbar *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-6">
                    <span class="font-medium text-sm">Acme</span>
                    <nav class="flex items-center gap-1">
                        @foreach (var item in _navItems)
                        {
                            var navItem = item;
                            <div @onmouseenter="@(() => HandleEnter(navItem.Label))"
                                 @onmouseleave="HandleLeave">
                                <button type="button"
                                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _active == navItem.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                                    @navItem.Label
                                </button>
                            </div>
                        }
                        @foreach (var lnk in _plainLinks)
                        {
                            var plainLink = lnk;
                            <button type="button"
                                    class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                                    @onmouseenter="@(() => { _active = null; })">
                                @plainLink
                            </button>
                        }
                    </nav>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        Sign in
                    </button>
                    <button type="button"
                            class="rounded-md bg-foreground px-3 py-1.5 text-background text-sm transition-colors hover:bg-foreground/90">
                        Get started
                    </button>
                </div>
            </div>

            @* Flyout panels *@
            @{
                var activeItem = System.Array.Find(_navItems, it => it.Label == _active);
            }
            @if (activeItem != null)
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card"
                     @onmouseenter="@(() => HandleEnter(activeItem.Label))"
                     @onmouseleave="HandleLeave">

                    @* Products panel — icon grid *@
                    @if (activeItem.Panel is ProductsPanel productsPanel)
                    {
                        <div class="grid grid-cols-3 gap-1 p-2">
                            @foreach (var gridItem in productsPanel.Items)
                            {
                                var gi = gridItem;
                                <button type="button"
                                        class="flex items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                    <span class="mt-0.5 text-muted-foreground">
                                        <LucideIconCn Name="@gi.IconName" Size="16" Class="size-4" />
                                    </span>
                                    <div class="min-w-0">
                                        <span class="font-medium text-sm">@gi.Title</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@gi.Description</p>
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @* Resources panel — links + blog preview *@
                    @if (activeItem.Panel is ResourcesPanel resourcesPanel)
                    {
                        <div class="flex">
                            <div class="flex-1 p-2">
                                @foreach (var lnk in resourcesPanel.Links)
                                {
                                    var rl = lnk;
                                    <button type="button"
                                            class="flex w-full items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                        <span class="mt-0.5 text-muted-foreground">
                                            <LucideIconCn Name="@rl.IconName" Size="16" Class="size-4" />
                                        </span>
                                        <div class="min-w-0">
                                            <span class="font-medium text-sm">@rl.Title</span>
                                            <p class="mt-0.5 text-muted-foreground text-xs">@rl.Description</p>
                                        </div>
                                    </button>
                                }
                            </div>
                            <div class="w-64 border-l p-3">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        From the blog
                                    </span>
                                    <div class="mt-2 h-20 rounded bg-muted"></div>
                                    <p class="mt-2 font-medium text-sm leading-snug">
                                        @resourcesPanel.Blog.Title
                                    </p>
                                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                        @resourcesPanel.Blog.Description
                                    </p>
                                    <span class="mt-2 block text-muted-foreground/60 text-xs">
                                        @resourcesPanel.Blog.Date
                                    </span>
                                </div>
                            </div>
                        </div>
                    }

                    @* Company panel — team links + offices *@
                    @if (activeItem.Panel is CompanyPanel companyPanel)
                    {
                        <div class="flex">
                            <div class="flex-1 p-2">
                                @foreach (var lnk in companyPanel.Links)
                                {
                                    var cl = lnk;
                                    <button type="button"
                                            class="flex w-full items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                        <span class="mt-0.5 text-muted-foreground">
                                            <LucideIconCn Name="@cl.IconName" Size="16" Class="size-4" />
                                        </span>
                                        <div class="min-w-0">
                                            <span class="font-medium text-sm">@cl.Title</span>
                                            <p class="mt-0.5 text-muted-foreground text-xs">@cl.Description</p>
                                        </div>
                                    </button>
                                }
                            </div>
                            <div class="w-56 border-l p-3">
                                <span class="font-medium text-muted-foreground text-xs">Offices</span>
                                <div class="mt-2 space-y-2.5">
                                    @foreach (var office in companyPanel.Offices)
                                    {
                                        var off = office;
                                        <div class="flex items-start gap-2">
                                            <LucideIconCn Name="map-pin" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/60" />
                                            <div>
                                                <p class="font-medium text-sm">@off.City</p>
                                                <p class="text-muted-foreground text-xs">@off.Country</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <button type="button"
                                        class="mt-3 flex items-center gap-1 text-muted-foreground text-xs transition-colors hover:text-foreground">
                                    View all locations
                                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">Hover the nav items above</span>
                <span class="text-muted-foreground/60 text-xs">
                    Each item reveals a different panel layout: grid, links + blog, or links + offices
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private abstract record PanelConfig(string Type);
    private record GridItem(string IconName, string Title, string Description);
    private record BlogPreview(string Title, string Description, string Date);
    private record OfficeLocation(string City, string Country);
    private record ProductsPanel(GridItem[] Items) : PanelConfig("products");
    private record ResourcesPanel(GridItem[] Links, BlogPreview Blog) : PanelConfig("resources");
    private record CompanyPanel(GridItem[] Links, OfficeLocation[] Offices) : PanelConfig("company");
    private record NavCategory(string Label, PanelConfig Panel);

    private static readonly NavCategory[] _navItems =
    [
        new("Products", new ProductsPanel([
            new("bar-chart-3", "Analytics", "Real-time dashboards"),
            new("cloud", "Cloud", "Edge deployment"),
            new("shield-check", "Security", "Threat detection"),
            new("zap", "Functions", "Serverless compute"),
            new("blocks", "Integrations", "200+ connectors"),
            new("code", "DevTools", "CLI and SDK"),
        ])),
        new("Resources", new ResourcesPanel(
            Links: [
                new("book-open", "Documentation", "Guides and references"),
                new("graduation-cap", "Academy", "Free courses"),
                new("message-circle", "Community", "50k+ developers"),
                new("file-text", "Changelog", "Release notes"),
            ],
            Blog: new(
                "Scaling WebSocket Connections to 1M",
                "How we redesigned our connection pool to handle a million concurrent WebSocket connections per cluster.",
                "Mar 18, 2026"
            )
        )),
        new("Company", new CompanyPanel(
            Links: [
                new("users", "About Us", "Our story and mission"),
                new("briefcase", "Careers", "12 open positions"),
                new("newspaper", "Press", "News and media kit"),
            ],
            Offices: [
                new("San Francisco", "United States"),
                new("London", "United Kingdom"),
                new("Tokyo", "Japan"),
            ]
        )),
    ];

    private static readonly string[] _plainLinks = ["Pricing", "Contact"];

    private string? _active = null;

    private void HandleEnter(string label)
    {
        _active = label;
    }

    private void HandleLeave()
    {
        _active = null;
    }
}
