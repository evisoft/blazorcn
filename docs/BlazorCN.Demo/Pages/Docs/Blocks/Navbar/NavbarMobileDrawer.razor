@* ============================================================
   Block: navbar-mobile-drawer
   Title: NavbarMobileDrawer
   Description: A navbar with animated hamburger menu and slide-out drawer for React, Next.js, shadcn/ui, and Tailwind CSS. Shows a clean desktop navigation that transforms into a mobile-friendly Sheet drawer with navigation links, call-to-action button, and social links on hamburger click.
   Source: original/blocks/navbar/navbar-mobile-drawer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <div class="flex items-center justify-between px-4 py-3">
            @* Left: Logo *@
            <span class="font-medium text-sm">Acme</span>

            @* Center: Desktop links *@
            <nav class="hidden items-center gap-1 md:flex">
                @foreach (var link in _navLinks)
                {
                    var lnk = link;
                    <button type="button"
                            class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        @lnk.Label
                    </button>
                }
            </nav>

            @* Right: CTA + hamburger *@
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="hidden h-8 text-sm md:inline-flex">
                    Get started
                </ButtonCn>

                @* Hamburger button *@
                <button type="button"
                        @onclick="@(() => _open = !_open)"
                        class="flex size-8 items-center justify-center rounded-md transition-colors hover:bg-muted/50 md:hidden"
                        aria-label="@(_open ? "Close menu" : "Open menu")">
                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <title>Menu</title>
                        <path d="@(_open ? "M6 6l12 12" : "M4 6h16")" style="transition: d 0.25s;" />
                        <path d="@(_open ? "M12 12h0" : "M4 12h16")"
                              style="@($"transition: d 0.2s, opacity 0.2s; opacity:{(_open ? "0" : "1")}")" />
                        <path d="@(_open ? "M6 18l12-12" : "M4 18h16")" style="transition: d 0.25s;" />
                    </svg>
                </button>
            </div>
        </div>

        @* Mobile drawer — rendered as a right-side slide-in panel overlay *@
        @if (_open)
        {
            <div class="relative">
                @* Backdrop *@
                <div class="fixed inset-0 z-40 bg-background/80"
                     @onclick="@(() => _open = false)"></div>

                @* Drawer panel *@
                <div class="fixed inset-y-0 right-0 z-50 flex w-72 flex-col bg-card shadow-lg">
                    @* Sheet header *@
                    <div class="border-b px-4 py-3">
                        <p class="text-left font-medium text-sm">Acme</p>
                        <span class="sr-only">Navigation menu</span>
                    </div>

                    <div class="flex flex-1 flex-col">
                        @* Nav links *@
                        <nav class="flex flex-col py-2">
                            @foreach (var link in _navLinks)
                            {
                                var lnk = link;
                                <button type="button"
                                        @onclick="@(() => _open = false)"
                                        class="px-4 py-2.5 text-left text-sm transition-colors hover:bg-muted/50">
                                    @lnk.Label
                                </button>
                            }
                        </nav>

                        @* CTA *@
                        <div class="border-t px-4 py-3">
                            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-sm">
                                Get started
                            </ButtonCn>
                        </div>

                        @* Social links *@
                        <div class="mt-auto border-t px-4 py-3">
                            <div class="flex items-center gap-2">
                                @foreach (var social in _socialLinks)
                                {
                                    var soc = social;
                                    <button type="button"
                                            class="flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
                                            aria-label="@soc.Label">
                                        <LucideIconCn Name="@soc.IconName" Size="16" Class="size-4" />
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    Responsive navbar with mobile drawer
                </span>
                <span class="text-muted-foreground/60 text-xs">
                    Resize the viewport or click the hamburger icon to see the drawer
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);
    private record SocialLink(string Label, string IconName, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Features",      "#"),
        new("Pricing",       "#"),
        new("Documentation", "#"),
        new("Blog",          "#"),
        new("Changelog",     "#"),
    ];

    private static readonly SocialLink[] _socialLinks =
    [
        new("Twitter", "twitter", "#"),
        new("GitHub",  "github",  "#"),
    ];

    private bool _open = false;
}
