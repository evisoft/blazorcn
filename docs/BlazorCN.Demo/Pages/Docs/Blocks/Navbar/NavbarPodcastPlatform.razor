@* ============================================================
   Block: navbar-podcast-platform
   Title: NavbarPodcastPlatform
   Description: A podcast platform navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a PodWave logo with headphones icon, Discover, Library, Following, and Charts nav links, a now-playing episode indicator with animated bars, a search button, and a Create Podcast CTA with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-podcast-platform.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-foreground" />
                <span class="font-medium text-sm">PodWave</span>
            </div>

            @* Nav links *@
            <div class="hidden items-center gap-1 sm:flex">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isActive = _activeLink == lbl;
                    <button type="button"
                            class="@Cn.Merge("relative rounded-md px-2.5 py-1.5 text-xs transition-colors", isActive ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeLink = lbl)">
                        @lbl
                        @if (isActive)
                        {
                            <span class="absolute inset-x-2.5 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @* Spacer *@
            <div class="min-w-0 flex-1"></div>

            @* Now playing indicator *@
            <div class="hidden items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 lg:flex">
                @* Animated equalizer bars (static approximation without framer-motion) *@
                <div class="flex items-end gap-px">
                    <span class="w-[2px] rounded-full bg-foreground" style="height:10px"></span>
                    <span class="w-[2px] rounded-full bg-foreground" style="height:14px"></span>
                    <span class="w-[2px] rounded-full bg-foreground" style="height:8px"></span>
                </div>
                <span class="max-w-[180px] truncate text-muted-foreground text-xs">@_nowPlaying</span>
            </div>

            @* Search *@
            <ButtonCn aria-label="Search" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
            </ButtonCn>

            @* Create CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 shrink-0 text-xs">
                <LucideIconCn Name="mic" Size="12" Class="size-3" />
                Create Podcast
            </ButtonCn>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Discover", "#discover"),
        new("Library", "#library"),
        new("Following", "#following"),
        new("Charts", "#charts"),
    ];

    private const string _nowPlaying = "The Art of Product Design — Ep. 47";

    private string _activeLink = "Discover";
}
