@* ============================================================
   Block: navbar-portfolio
   Title: NavbarPortfolio
   Description: A creative portfolio navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a designer or developer name as logo, minimal navigation links for Work, About, Services, and Contact, and a green availability indicator dot with status text using framer-motion animations.
   Source: original/blocks/navbar/navbar-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Name as logo *@
            <a href="#" class="font-medium text-sm">
                Alex Chen
            </a>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isHovered = _hoveredLink == lbl;
                    <a href="@link.Href"
                       class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @lbl
                        @if (isHovered)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </a>
                }
            </div>

            @* Availability indicator *@
            <div class="flex items-center gap-2">
                <span class="relative flex size-2">
                    @if (_isAvailable)
                    {
                        <span class="absolute inline-flex size-full rounded-full bg-emerald-500 opacity-75 animate-ping"></span>
                    }
                    <span class="@Cn.Merge("relative inline-flex size-2 rounded-full", _isAvailable ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                </span>
                <span class="text-muted-foreground text-xs">
                    @(_isAvailable ? "Available for work" : "Currently unavailable")
                </span>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Work", "#work"),
        new("About", "#about"),
        new("Services", "#services"),
        new("Contact", "#contact"),
    ];

    private const bool _isAvailable = true;
    private string? _hoveredLink = null;
}
