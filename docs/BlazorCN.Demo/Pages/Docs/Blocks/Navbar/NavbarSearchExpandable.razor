@* ============================================================
   Block: navbar-search-expandable
   Title: NavbarSearchExpandable
   Description: A navigation bar with an expandable search input built with React, Next.js, shadcn/ui, and Tailwind CSS. Click the search icon to smoothly expand a full-width search bar that pushes nav items aside, with click-away and Escape key to collapse.
   Source: original/blocks/navbar/navbar-search-expandable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <span class="shrink-0 font-medium text-sm">Acme Inc</span>

            @* Center: Nav links or Search *@
            <div class="flex flex-1 items-center justify-center">
                @if (_isSearchOpen)
                {
                    <div class="flex w-full max-w-sm items-center gap-2 rounded-md border bg-muted/50 px-3 py-1.5">
                        <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <input
                            type="text"
                            @bind="_searchValue"
                            @bind:event="oninput"
                            @onkeydown="HandleKeyDown"
                            placeholder="Search products, docs, and more..."
                            aria-label="Search products, docs, and more"
                            class="h-6 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                        <button
                            type="button"
                            @onclick="CloseSearch"
                            aria-label="Close search"
                            class="shrink-0 rounded-sm p-0.5 text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </button>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-1">
                        @foreach (var link in _navLinks)
                        {
                            var navLink = link;
                            <a href="@navLink.Href"
                               class="px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                                @navLink.Label
                            </a>
                        }
                    </div>
                }
            </div>

            @* Right: Search trigger + CTA *@
            <div class="flex shrink-0 items-center gap-2">
                @if (!_isSearchOpen)
                {
                    <ButtonCn aria-label="Search" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0"
                              OnClick="@(() => _isSearchOpen = true)">
                        <LucideIconCn Name="search" Size="16" Class="size-4" />
                    </ButtonCn>
                }
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private bool _isSearchOpen = false;
    private string _searchValue = "";

    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
    ];

    private void CloseSearch()
    {
        _isSearchOpen = false;
        _searchValue = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _isSearchOpen)
        {
            CloseSearch();
        }
    }
}
