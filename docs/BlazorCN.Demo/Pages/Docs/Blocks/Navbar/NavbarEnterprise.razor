@* ============================================================
   Block: navbar-enterprise
   Title: NavbarEnterprise
   Description: An enterprise software navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a Nexus Enterprise logo, Platform and Solutions by Industry dropdowns, Customer Stories, Partners, and Resources links, Contact Sales filled button, Try Demo outline button, and SOC 2 trust badge with framer-motion animations.
   Source: original/blocks/navbar/navbar-enterprise.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Navbar *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">Nexus Enterprise</span>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 gap-1 px-1.5 font-normal text-[10px] text-muted-foreground">
                            <LucideIconCn Name="shield-check" Size="10" Class="size-2.5" />
                            SOC 2
                        </BadgeCn>
                    </div>
                    <nav class="flex items-center gap-1">
                        @foreach (var ddItem in _dropdowns)
                        {
                            var dd = ddItem;
                            <div @onmouseenter="@(() => HandleEnter(dd.Label))"
                                 @onmouseleave="HandleLeave">
                                <button type="button"
                                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _active == dd.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                                    @dd.Label
                                </button>
                            </div>
                        }
                        @foreach (var link in _plainLinks)
                        {
                            var lnk = link;
                            <button type="button"
                                    @onmouseenter="@(() => SetActiveNull())"
                                    class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                                @lnk
                            </button>
                        }
                    </nav>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-sm">Try Demo</ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-sm">Contact Sales</ButtonCn>
                </div>
            </div>

            @* Dropdown panel *@
            @{
                var activeDropdown = _dropdowns.FirstOrDefault(d => d.Label == _active);
            }
            @if (activeDropdown != null)
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card"
                     @onmouseenter="@(() => HandleEnter(activeDropdown.Label))"
                     @onmouseleave="HandleLeave">
                    <div class="grid grid-cols-2 gap-1 p-2 sm:grid-cols-3">
                        @foreach (var subItem in activeDropdown.Items)
                        {
                            var item = subItem;
                            <button type="button"
                                    class="flex items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                <span class="mt-0.5 text-muted-foreground">
                                    <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                                </span>
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@item.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    Hover Platform or Solutions by Industry for dropdown menus
                </span>
                <span class="text-muted-foreground/60 text-xs">
                    Enterprise navbar with SOC 2 badge and dual CTA pattern
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record DropdownItem(string IconName, string Title, string Description);
    private record NavDropdown(string Label, DropdownItem[] Items);

    private string? _active = null;
    private System.Threading.Timer? _leaveTimer = null;

    private static readonly string[] _plainLinks = ["Customer Stories", "Partners", "Resources"];

    private static readonly NavDropdown[] _dropdowns =
    [
        new NavDropdown("Platform",
        [
            new DropdownItem("layout-dashboard", "Unified Dashboard", "Single pane of glass for all operations"),
            new DropdownItem("brain-circuit", "AI Engine", "Predictive analytics and anomaly detection"),
            new DropdownItem("network", "Data Fabric", "Connect and unify disparate data sources"),
            new DropdownItem("shield-check", "Compliance Center", "Automated audit trails and reporting"),
            new DropdownItem("server", "Infrastructure", "Multi-cloud and on-premise deployment"),
            new DropdownItem("zap", "Workflow Automation", "Enterprise-grade process orchestration"),
        ]),
        new NavDropdown("Solutions by Industry",
        [
            new DropdownItem("landmark", "Financial Services", "Risk management and regulatory compliance"),
            new DropdownItem("heart-pulse", "Healthcare", "HIPAA-compliant patient data platform"),
            new DropdownItem("factory", "Manufacturing", "Supply chain and IoT integration"),
            new DropdownItem("building", "Government", "FedRAMP-authorized secure infrastructure"),
            new DropdownItem("graduation-cap", "Education", "Student data privacy and analytics"),
            new DropdownItem("lock", "Cybersecurity", "Threat detection and response platform"),
        ]),
    ];

    private void HandleEnter(string label)
    {
        _leaveTimer?.Dispose();
        _leaveTimer = null;
        _active = label;
    }

    private void HandleLeave()
    {
        _leaveTimer?.Dispose();
        _leaveTimer = new System.Threading.Timer(_ =>
        {
            _active = null;
            InvokeAsync(StateHasChanged);
        }, null, 150, System.Threading.Timeout.Infinite);
    }

    private void SetActiveNull()
    {
        _leaveTimer?.Dispose();
        _leaveTimer = null;
        _active = null;
    }

    public void Dispose()
    {
        _leaveTimer?.Dispose();
    }
}
