@* ============================================================
   Block: navbar-contextual
   Title: NavbarContextual
   Description: A context-aware navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Toggles between Marketing mode with Features, Pricing, and Blog links and App mode with Dashboard, Projects, and Team links. Visual indicator shows the active context with smooth framer-motion transitions between modes.
   Source: original/blocks/navbar/navbar-contextual.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo + Context toggle + Nav links *@
            <div class="flex items-center gap-4">
                <span class="font-medium text-sm">Acme</span>

                @* Context switcher *@
                <div class="flex items-center rounded-md border bg-muted/30 p-0.5">
                    @foreach (var ctx in _contextKeys)
                    {
                        var ctxKey = ctx;
                        <button type="button"
                                @onclick="@(() => _activeContext = ctxKey)"
                                class="@Cn.Merge("relative rounded px-2.5 py-1 text-xs font-medium transition-colors", _activeContext == ctxKey ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                            @if (_activeContext == ctxKey)
                            {
                                <span class="absolute inset-0 rounded bg-card shadow-sm"></span>
                            }
                            <span class="relative">@_contexts[ctxKey].Label</span>
                        </button>
                    }
                </div>

                <div class="h-4 w-px bg-border"></div>

                @* Nav links *@
                <div class="flex items-center gap-1">
                    @foreach (var lnk in _contexts[_activeContext].Links)
                    {
                        var link = lnk;
                        <a href="@link.Href"
                           class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:bg-muted/50 hover:text-foreground">
                            @link.Label
                        </a>
                    }
                </div>
            </div>

            @* Right: Status + Avatar *@
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _activeContext == "app" ? "bg-emerald-500" : "bg-blue-500")"></span>
                    @(_activeContext == "app" ? "Signed in" : "Public")
                </span>
                <AvatarCn Class="size-6">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);
    private record ContextDef(string Label, NavLink[] Links);

    private static readonly Dictionary<string, ContextDef> _contexts = new()
    {
        ["marketing"] = new ContextDef("Marketing",
        [
            new NavLink("Features", "#features"),
            new NavLink("Pricing", "#pricing"),
            new NavLink("Blog", "#blog"),
            new NavLink("Changelog", "#changelog"),
        ]),
        ["app"] = new ContextDef("App",
        [
            new NavLink("Dashboard", "#dashboard"),
            new NavLink("Projects", "#projects"),
            new NavLink("Team", "#team"),
            new NavLink("Settings", "#settings"),
        ]),
    };

    private static readonly string[] _contextKeys = ["marketing", "app"];

    private string _activeContext = "marketing";
}
