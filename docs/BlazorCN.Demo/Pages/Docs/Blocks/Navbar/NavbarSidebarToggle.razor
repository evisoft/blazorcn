@* ============================================================
   Block: navbar-sidebar-toggle
   Title: NavbarSidebarToggle
   Description: A navigation bar with collapsible sidebar integration built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a toggle button to collapse and expand a mini sidebar preview below the navbar, showing icons when collapsed and icons with labels when expanded, using framer-motion layout animations.
   Source: original/blocks/navbar/navbar-sidebar-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <nav class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <ButtonCn aria-label="Toggle sidebar" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0"
                          OnClick="@(() => _collapsed = !_collapsed)">
                    <LucideIconCn Name="menu" Size="16" Class="size-4" />
                </ButtonCn>
                <span class="font-medium text-sm">Workspace</span>
            </div>
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
            </AvatarCn>
        </nav>

        @* Sidebar + Content area *@
        <div class="flex" style="height:320px">
            @* Sidebar *@
            <div class="shrink-0 border-r bg-muted/30 transition-all duration-200 ease-out overflow-hidden"
                 style="@($"width:{(_collapsed ? 56 : 200)}px")">
                <div class="flex flex-col gap-1 p-2">
                    @foreach (var navItem in _navItems)
                    {
                        var item = navItem;
                        <a href="@item.Href"
                           class="@Cn.Merge("flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors", item.Active ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                            <LucideIconCn Name="@item.IconName" Size="16" Class="size-4 shrink-0" />
                            @if (!_collapsed)
                            {
                                <span class="truncate text-sm">@item.Label</span>
                            }
                        </a>
                    }
                </div>
            </div>

            @* Content placeholder *@
            <div class="flex flex-1 items-center justify-center p-6">
                <div class="text-center">
                    <span class="font-medium text-muted-foreground text-sm">Page content</span>
                    <p class="mt-1 text-muted-foreground/60 text-xs">
                        Toggle the sidebar to see the collapse animation
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _collapsed = false;

    private record NavItem(string IconName, string Label, string Href, bool Active = false);

    private static readonly NavItem[] _navItems =
    [
        new("home", "Home", "#home", Active: true),
        new("bar-chart-3", "Analytics", "#analytics"),
        new("users", "Customers", "#customers"),
        new("folder", "Projects", "#projects"),
        new("settings", "Settings", "#settings"),
    ];
}
