@* ============================================================
   Block: navbar-icon-only
   Title: NavbarIconOnly
   Description: An ultra-minimal icon-only navbar built with React, Next.js, shadcn/ui, Tailwind CSS, and framer-motion. Displays navigation as icons for Home, Search, Bell, Mail, Settings, and User with tooltips on hover and an active indicator using bg-muted rounded backgrounds. Supports both horizontal and vertical orientations.
   Source: original/blocks/navbar/navbar-icon-only.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Icon navbar *@
        <div class="flex items-start gap-4 px-4 py-4">
            @if (_isVertical)
            {
                <div class="flex flex-col items-center gap-1 rounded-lg border bg-muted/20 p-2">
                    @foreach (var navItem in _navIcons)
                    {
                        var item = navItem;
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <button type="button"
                                        @onclick="@(() => _activeIcon = item.Id)"
                                        class="@Cn.Merge("relative flex size-9 items-center justify-center rounded-md transition-colors", _activeIcon == item.Id ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                                    <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                                </button>
                            </TooltipTriggerCn>
                            <TooltipContentCn>@item.Label</TooltipContentCn>
                        </TooltipCn>
                    }
                </div>

                @* Content preview *@
                <div class="flex flex-1 items-center justify-center py-8">
                    <div class="text-center">
                        <span class="font-medium text-sm">
                            @(_navIcons.FirstOrDefault(i => i.Id == _activeIcon)?.Label)
                        </span>
                        <p class="mt-1 text-muted-foreground text-xs">Hover icons for labels</p>
                    </div>
                </div>
            }
            else
            {
                <div class="flex w-full items-center justify-between">
                    <div class="flex items-center gap-1 rounded-lg border bg-muted/20 p-1.5">
                        @foreach (var navItem in _navIcons)
                        {
                            var item = navItem;
                            <TooltipCn>
                                <TooltipTriggerCn>
                                    <button type="button"
                                            @onclick="@(() => _activeIcon = item.Id)"
                                            class="@Cn.Merge("relative flex size-9 items-center justify-center rounded-md transition-colors", _activeIcon == item.Id ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                                        <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                                    </button>
                                </TooltipTriggerCn>
                                <TooltipContentCn Align="FloatingAlign.Center">@item.Label</TooltipContentCn>
                            </TooltipCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Orientation toggle *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="text-muted-foreground text-xs">Orientation:</span>
                    <button type="button"
                            @onclick="@(() => _isVertical = false)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", !_isVertical ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                        Horizontal
                    </button>
                    <button type="button"
                            @onclick="@(() => _isVertical = true)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _isVertical ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                        Vertical
                    </button>
                </div>
                <span class="text-muted-foreground text-xs">
                    Active: @(_navIcons.FirstOrDefault(i => i.Id == _activeIcon)?.Label)
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavIcon(string Id, string Label, string IconName);

    private static readonly NavIcon[] _navIcons =
    [
        new("home", "Home", "home"),
        new("search", "Search", "search"),
        new("notifications", "Notifications", "bell"),
        new("mail", "Mail", "mail"),
        new("settings", "Settings", "settings"),
        new("profile", "Profile", "user"),
    ];

    private string _activeIcon = "home";
    private bool _isVertical = false;
}
