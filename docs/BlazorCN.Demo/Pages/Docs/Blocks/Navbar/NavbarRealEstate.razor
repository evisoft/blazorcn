@* ============================================================
   Block: navbar-real-estate
   Title: NavbarRealEstate
   Description: A real estate platform navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a property platform logo, navigation links for buying, renting, selling, agents, and mortgage tools, a prominent search bar, saved properties heart icon with count, and a list property CTA button using framer-motion animations.
   Source: original/blocks/navbar/navbar-real-estate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Top bar: Logo + Search + Actions *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="shrink-0 font-medium text-sm">Homebase</span>

            @* Search bar *@
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Placeholder="Search by address, city, or ZIP..." aria-label="Search by address, city, or ZIP" Class="h-8 border-border/50 bg-muted/30 pl-8 text-sm shadow-none focus-visible:ring-1" />
            </div>

            @* Saved properties *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative h-8 shrink-0 gap-1.5 px-2">
                <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-xs tabular-nums">@_savedCount</span>
            </ButtonCn>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">
                List Property
            </ButtonCn>
        </div>

        @* Navigation links *@
        <nav class="flex items-center gap-1 px-4 py-2">
            @foreach (var link in _navLinks)
            {
                var lbl = link.Label;
                var isActive = _activeLink == lbl;
                <button type="button"
                        class="@Cn.Merge("relative rounded-md px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _activeLink = lbl)">
                    @lbl
                    @if (isActive)
                    {
                        <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                    }
                </button>
            }
        </nav>

    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Buy", "#buy"),
        new("Rent", "#rent"),
        new("Sell", "#sell"),
        new("Agents", "#agents"),
        new("Mortgage Calculator", "#mortgage"),
    ];

    private const int _savedCount = 12;
    private string _activeLink = "Buy";
}
