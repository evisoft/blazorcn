@* ============================================================
   Block: navbar-animated-underline
   Title: NavbarAnimatedUnderline
   Description: A navigation bar with animated sliding underline effect built with React, Next.js, shadcn/ui, and Tailwind CSS. Features framer-motion layoutId for smooth underline transitions that slide between hovered and active items with rounded 2px caps.
   Source: original/blocks/navbar/navbar-animated-underline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded bg-foreground">
                    <span class="font-semibold text-background text-xs">A</span>
                </div>
                <span class="font-medium text-sm">Acme</span>
            </div>

            @* Nav links with animated underline *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isDisplayed = (_hoveredLink ?? _activeLink) == lbl;
                    <a href="@link.Href"
                       class="@Cn.Merge("relative px-3 py-1.5 text-sm transition-colors", isDisplayed ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)"
                       @onclick="@((MouseEventArgs e) => SetActive(lbl))"
                       @onclick:preventDefault>
                        @lbl
                        @if (isDisplayed)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-0.5 rounded-full bg-foreground transition-all duration-200"></span>
                        }
                    </a>
                }
            </div>

            @* CTA *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Sign In
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Products", "#products"),
        new("Solutions", "#solutions"),
        new("Pricing", "#pricing"),
        new("Docs", "#docs"),
        new("Blog", "#blog"),
    ];

    private string _activeLink = "Products";
    private string? _hoveredLink = null;

    private void SetActive(string label)
    {
        _activeLink = label;
    }
}
