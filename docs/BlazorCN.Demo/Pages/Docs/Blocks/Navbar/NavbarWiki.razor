@* ============================================================
   Block: navbar-wiki
   Title: NavbarWiki
   Description: An internal wiki and knowledge base navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a TeamWiki logo with book icon, Home, Spaces, Recent, Starred, and Templates nav links, centered search bar with Cmd+K shortcut hint, a Create dropdown for new pages, spaces, and templates, and user avatar with framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-wiki.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">TeamWiki</span>
            </div>

            <div class="h-4 w-px bg-border"></div>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    <button
                        type="button"
                        @onclick="@(() => _activeLink = link.Label)"
                        class="@Cn.Merge("shrink-0 rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeLink == link.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        @link.Label
                    </button>
                }
            </div>

            @* Search *@
            <div class="flex max-w-44 flex-1 items-center gap-2 rounded-md border bg-muted/50 px-2.5 py-1.5">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="flex-1 text-muted-foreground text-xs">Search...</span>
                <kbd class="inline-flex h-4 min-w-0 items-center rounded border bg-background px-1 font-mono text-[10px] text-muted-foreground">
                    <span class="text-[10px]">&#8984;K</span>
                </kbd>
            </div>

            @* Create dropdown *@
            <DropdownMenuCn>
                <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm h-7 gap-1 px-2.5 text-xs" data-variant="outline" data-size="sm">
                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                        Create
                        <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                    </DropdownMenuTriggerCn>
                <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-40">
                    @foreach (var opt in _createOptions)
                    {
                        <DropdownMenuItemCn Class="gap-2 text-xs">
                            <LucideIconCn Name="@opt.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            @opt.Label
                        </DropdownMenuItemCn>
                    }
                </DropdownMenuContentCn>
            </DropdownMenuCn>

            @* User avatar *@
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-[10px]">MK</AvatarFallbackCn>
            </AvatarCn>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);
    private record CreateOption(string Label, string Icon);

    private static readonly NavLink[] _navLinks =
    [
        new("Home", "#home"),
        new("Spaces", "#spaces"),
        new("Recent", "#recent"),
        new("Starred", "#starred"),
        new("Templates", "#templates"),
    ];

    private static readonly CreateOption[] _createOptions =
    [
        new("Page", "file-text"),
        new("Space", "folder"),
        new("Template", "layout-template"),
    ];

    private string _activeLink = "Home";
}
