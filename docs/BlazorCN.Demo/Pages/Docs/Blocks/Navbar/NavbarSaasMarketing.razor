@* ============================================================
   Block: navbar-saas-marketing
   Title: NavbarSaasMarketing
   Description: A complete SaaS marketing navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a logo, Product dropdown with feature list, Solutions dropdown, Pricing link, Resources dropdown with Blog, Docs, Community, and Changelog items, plus right-aligned Log In text link and Start Free Trial CTA with framer-motion animated dropdown panels.
   Source: original/blocks/navbar/navbar-saas-marketing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Navbar *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-6">
                    <span class="font-medium text-sm">Acme</span>
                    <nav class="flex items-center gap-1">
                        @foreach (var ddItem in _dropdowns)
                        {
                            var dropdown = ddItem;
                            <div @onmouseenter="@(() => HandleEnter(dropdown.Label))"
                                 @onmouseleave="HandleLeave">
                                <button type="button"
                                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _active == dropdown.Label ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                                    @dropdown.Label
                                </button>
                            </div>
                        }
                        <button type="button"
                                @onmouseenter="HandlePlainLinkEnter"
                                class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                            Pricing
                        </button>
                    </nav>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        Log in
                    </button>
                    <button type="button"
                            class="rounded-md bg-foreground px-3 py-1.5 text-background text-sm transition-colors hover:bg-foreground/90">
                        Start Free Trial
                    </button>
                </div>
            </div>

            @* Dropdown panel *@
            @{
                var activeDropdown = _dropdowns.FirstOrDefault(d => d.Label == _active);
            }
            @if (activeDropdown != null)
            {
                <div class="absolute top-full right-0 left-0 z-10 border-t bg-card"
                     @onmouseenter="@(() => HandleEnter(activeDropdown.Label))"
                     @onmouseleave="HandleLeave">
                    <div class="grid grid-cols-2 gap-1 p-2">
                        @foreach (var ddSubItem in activeDropdown.Items)
                        {
                            var item = ddSubItem;
                            <button type="button"
                                    class="flex items-start gap-3 rounded-md p-3 text-left transition-colors hover:bg-muted/50">
                                <span class="mt-0.5 text-muted-foreground">
                                    <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                                </span>
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@item.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    Hover Product, Solutions, or Resources for dropdown menus
                </span>
                <span class="text-muted-foreground/60 text-xs">
                    Complete SaaS marketing navigation with three dropdown panels
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record DropdownItem(string IconName, string Title, string Description);
    private record NavDropdown(string Label, DropdownItem[] Items);

    private string? _active = null;

    private static readonly NavDropdown[] _dropdowns =
    [
        new NavDropdown("Product",
        [
            new DropdownItem("bar-chart-3", "Analytics", "Real-time dashboards and metrics"),
            new DropdownItem("brain-circuit", "AI Workflows", "Automate tasks with machine learning"),
            new DropdownItem("blocks", "Integrations", "Connect with 300+ tools and APIs"),
            new DropdownItem("shield-check", "Security", "SOC 2 compliant data protection"),
            new DropdownItem("zap", "Automation", "Build pipelines with no code"),
            new DropdownItem("users", "Collaboration", "Real-time team editing and comments"),
        ]),
        new NavDropdown("Solutions",
        [
            new DropdownItem("building", "Enterprise", "Scalable solutions for large teams"),
            new DropdownItem("shopping-bag", "E-commerce", "Optimize conversion and revenue"),
            new DropdownItem("heart-pulse", "Healthcare", "HIPAA-compliant patient workflows"),
            new DropdownItem("globe", "Agencies", "Multi-client project management"),
        ]),
        new NavDropdown("Resources",
        [
            new DropdownItem("newspaper", "Blog", "Product updates and best practices"),
            new DropdownItem("book-open", "Docs", "Guides, references, and tutorials"),
            new DropdownItem("message-circle", "Community", "Join 40k+ members on Discord"),
            new DropdownItem("file-text", "Changelog", "Latest releases and improvements"),
        ]),
    ];

    private void HandleEnter(string label)
    {
        _active = label;
    }

    private void HandleLeave()
    {
        _active = null;
    }

    private void HandlePlainLinkEnter()
    {
        _active = null;
    }
}
