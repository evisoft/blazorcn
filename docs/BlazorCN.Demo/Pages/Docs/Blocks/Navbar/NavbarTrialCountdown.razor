@* ============================================================
   Block: navbar-trial-countdown
   Title: NavbarTrialCountdown
   Description: A SaaS navigation bar with trial countdown timer built with React, Next.js, shadcn/ui, and Tailwind CSS. Features standard nav links on the left, trial days remaining with a progress bar indicator, urgency styling that shifts to amber when under three days, and a prominent Upgrade Now call-to-action button with framer-motion animations.
   Source: original/blocks/navbar/navbar-trial-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Left: Logo + Nav *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Acme</span>
            </div>

            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    <button type="button"
                            class="@Cn.Merge("shrink-0 rounded-md px-2 py-1.5 text-xs transition-colors", _activeLink == link.Label ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")"
                            @onclick="@(() => _activeLink = link.Label)">
                        @link.Label
                    </button>
                }
            </div>

            @* Right: Trial countdown + Upgrade + Avatar *@
            <div class="flex shrink-0 items-center gap-3">
                @* Trial indicator *@
                <div class="flex items-center gap-2.5 rounded-md bg-muted/50 px-3 py-1.5">
                    <div class="flex items-center gap-1.5">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _isUrgent ? "bg-amber-500" : "bg-foreground/40")"></span>
                        <span class="@Cn.Merge("text-xs font-medium tabular-nums", _isUrgent ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground")">
                            Trial: @_daysLeft @(_daysLeft == 1 ? "day" : "days") left
                        </span>
                    </div>
                    @* Mini progress bar *@
                    <div class="hidden h-1.5 w-16 overflow-hidden rounded-full bg-muted sm:block">
                        <div class="@Cn.Merge("h-full rounded-full", _isUrgent ? "bg-amber-500" : "bg-foreground/30")"
                             style="@($"width:{_progressPercent:F0}%")">
                        </div>
                    </div>
                </div>

                @* Upgrade CTA *@
                <ButtonCn Variant="@(_isUrgent ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 text-xs">
                    <LucideIconCn Name="zap" Size="12" Class="size-3" />
                    Upgrade Now
                </ButtonCn>

                @* Avatar *@
                <AvatarCn Class="size-7">
                    <AvatarImageCn Src="https://avatars.githubusercontent.com/u/1?v=4" Alt="User avatar" />
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Dashboard", "#dashboard"),
        new("Projects", "#projects"),
        new("Analytics", "#analytics"),
        new("Settings", "#settings"),
    ];

    private const int _totalTrialDays = 14;
    private const int _daysLeft = 7;

    private string _activeLink = "Dashboard";

    private bool _isUrgent => _daysLeft <= 3;
    private double _progressPercent => ((double)(_totalTrialDays - _daysLeft) / _totalTrialDays) * 100;
}
