@* ============================================================
   Block: navbar-environment-switcher
   Title: NavbarEnvironmentSwitcher
   Description: A developer toolbar navigation bar with environment switcher built with React, Next.js, shadcn/ui, and Tailwind CSS. Features toggleable Production, Staging, and Development environments with colored status dots, current API URL display, environment name badge, and a warning indicator on production with framer-motion transitions.
   Source: original/blocks/navbar/navbar-environment-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Left: Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">DevTools</span>
            </div>

            <div class="h-5 w-px bg-border"></div>

            @* Environment switcher dropdown *@
            <DropdownMenuCn>
                <DropdownMenuTriggerCn>
                    <button type="button"
                            class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _currentEnv.Dot)"></span>
                        <span class="font-medium text-xs">@_currentEnv.Label</span>
                        <LucideIconCn Name="chevron-down" Size="12" Class="size-3 text-muted-foreground/60" />
                    </button>
                </DropdownMenuTriggerCn>
                <DropdownMenuContentCn Align="FloatingAlign.Start" Class="w-48">
                    @foreach (var en in _environments)
                    {
                        var env = en;
                        <DropdownMenuItemCn Class="@Cn.Merge("", _activeEnv == env.Id ? "bg-muted/50" : "")"
                                           OnClick="@(() => _activeEnv = env.Id)">
                            <div class="flex w-full items-center gap-2">
                                <span class="@Cn.Merge("size-2 shrink-0 rounded-full", env.Dot)"></span>
                                <span class="@Cn.Merge("", _activeEnv == env.Id ? "font-medium" : "")">@env.Label</span>
                                @if (_activeEnv == env.Id)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="ml-auto size-3 text-muted-foreground" />
                                }
                            </div>
                        </DropdownMenuItemCn>
                    }
                </DropdownMenuContentCn>
            </DropdownMenuCn>

            @* Production warning badge *@
            @if (_isProduction)
            {
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-amber-500/30 text-amber-600 dark:text-amber-400">
                    <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                    <span class="text-[10px]">Live</span>
                </BadgeCn>
            }

            @* API URL display *@
            <div class="ml-auto flex shrink-0 items-center gap-1.5">
                <LucideIconCn Name="code" Size="12" Class="size-3 text-muted-foreground/60" />
                <span class="font-mono text-muted-foreground text-xs">@_currentEnv.ApiUrl</span>
            </div>

            @* Copy URL *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 px-2 text-xs"
                      OnClick="@HandleCopyUrl">
                <span class="flex items-center gap-1">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </span>
            </ButtonCn>
        </nav>
    </div>
</section>

@code {
    private string _activeEnv = "staging";
    private bool _copied = false;

    private record Environment(string Id, string Label, string Dot, string ApiUrl);

    private static readonly Environment[] _environments =
    [
        new("production",  "Production",  "bg-emerald-500", "https://api.acme.com/v1"),
        new("staging",     "Staging",     "bg-amber-500",   "https://staging-api.acme.com/v1"),
        new("development", "Development", "bg-blue-500",    "http://localhost:3001/v1"),
    ];

    private Environment _currentEnv => _environments.FirstOrDefault(e => e.Id == _activeEnv) ?? _environments[1];
    private bool _isProduction => _activeEnv == "production";

    private async Task HandleCopyUrl()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
