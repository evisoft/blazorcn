@* ============================================================
   Block: navbar-design-tool
   Title: NavbarDesignTool
   Description: A design tool navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features an editable file name with inline rename, collaborator avatar stack, Share and Present action buttons with framer-motion entrance animations. Inspired by Figma and Canva interfaces.
   Source: original/blocks/navbar/navbar-design-tool.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <div class="flex size-5 items-center justify-center rounded bg-foreground">
                    <span class="font-semibold text-[10px] text-background">D</span>
                </div>
                <span class="font-medium text-sm">Design</span>
            </div>

            @* Center: Editable file name *@
            <div class="flex min-w-0 flex-1 items-center justify-center">
                <div class="flex items-center gap-1.5">
                    @if (_isEditing)
                    {
                        <InputCn @bind-Value="_fileName"
                                 aria-label="File name"
                                 Class="h-7 w-48 border-0 bg-muted/50 text-center text-sm shadow-none focus-visible:ring-1"
                                 @onblur="HandleFinishEdit"
                                 @onkeydown="HandleKeyDown" />
                    }
                    else
                    {
                        <button type="button"
                                @onclick="HandleStartEdit"
                                class="flex items-center gap-1.5 rounded-md px-2 py-1 text-sm transition-colors hover:bg-muted/50">
                            <span class="truncate font-medium text-sm">@_fileName</span>
                            @if (_saved)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="pencil" Size="12" Class="size-3 text-muted-foreground" />
                            }
                        </button>
                    }
                </div>
            </div>

            @* Right: Collaborators + actions *@
            <div class="flex shrink-0 items-center gap-3">
                @* Collaborator avatars *@
                <div class="flex -space-x-2">
                    @foreach (var collab in _collaborators)
                    {
                        var user = collab;
                        <span class="inline-flex size-6 items-center justify-center rounded-full border-2 border-card bg-muted text-[9px] font-medium" title="@user.Name">@user.Initials</span>
                    }
                </div>

                @* Share *@
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="share" Size="12" Class="size-3" />
                    Share
                </ButtonCn>

                @* Present *@
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Present
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private string _fileName = "Untitled Design";
    private bool _isEditing = false;
    private bool _saved = false;

    private record Collaborator(string Initials, string Name);

    private static readonly Collaborator[] _collaborators =
    [
        new("AK", "Anna Kim"),
        new("MR", "Marco Rivera"),
        new("JL", "Jess Lee"),
    ];

    private void HandleStartEdit()
    {
        _isEditing = true;
    }

    private void HandleFinishEdit()
    {
        _isEditing = false;
        if (!string.IsNullOrWhiteSpace(_fileName))
        {
            _saved = true;
            _ = ResetSavedAfterDelay();
        }
        else
        {
            _fileName = "Untitled Design";
        }
    }

    private async Task ResetSavedAfterDelay()
    {
        await Task.Delay(1500);
        _saved = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleFinishEdit();
        }
        else if (e.Key == "Escape")
        {
            _fileName = "Untitled Design";
            _isEditing = false;
        }
    }
}
