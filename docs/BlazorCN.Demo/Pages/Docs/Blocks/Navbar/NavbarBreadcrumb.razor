@* ============================================================
   Block: navbar-breadcrumb
   Title: NavbarBreadcrumb
   Description: A dashboard navigation bar with breadcrumb navigation built with React, Next.js, shadcn/ui, and Tailwind CSS. Features clickable breadcrumb trail with chevron separators, user avatar, and settings icon with hover states.
   Source: original/blocks/navbar/navbar-breadcrumb.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Left: Logo + Breadcrumbs *@
            <div class="flex items-center gap-3">
                <span class="font-medium text-sm">Acme</span>
                <span class="text-muted-foreground/40">/</span>

                @* Breadcrumb trail *@
                <div class="flex items-center gap-1">
                    @foreach (var crumb in _breadcrumbs)
                    {
                        var currentCrumb = crumb;
                        var idx = System.Array.IndexOf(_breadcrumbs, currentCrumb);
                        <div class="flex items-center gap-1">
                            @if (idx > 0)
                            {
                                <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/50" />
                            }
                            @if (idx == 0)
                            {
                                <a href="@currentCrumb.Href"
                                   aria-label="Home"
                                   class="rounded-sm p-1 text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
                                   @onmouseenter="@(() => _hoveredCrumb = currentCrumb.Label)"
                                   @onmouseleave="@(() => _hoveredCrumb = null)">
                                    <LucideIconCn Name="home" Size="14" Class="size-3.5" />
                                </a>
                            }
                            else if (currentCrumb.IsCurrent)
                            {
                                <span class="rounded-sm px-1.5 py-1 font-medium text-foreground text-sm">
                                    @currentCrumb.Label
                                </span>
                            }
                            else
                            {
                                <a href="@currentCrumb.Href"
                                   class="relative rounded-sm px-1.5 py-1 text-muted-foreground text-sm transition-colors hover:bg-muted/50 hover:text-foreground"
                                   @onmouseenter="@(() => _hoveredCrumb = currentCrumb.Label)"
                                   @onmouseleave="@(() => _hoveredCrumb = null)">
                                    @currentCrumb.Label
                                    @if (_hoveredCrumb == currentCrumb.Label)
                                    {
                                        <span class="absolute inset-x-1.5 -bottom-0.5 h-px bg-foreground/30"></span>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Right: Actions + User *@
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative h-7 w-7 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    @if (_notifications > 0)
                    {
                        <span class="absolute -top-0.5 -right-0.5 flex size-3.5 items-center justify-center rounded-full bg-foreground text-[9px] text-background">
                            @_notifications
                        </span>
                    }
                </ButtonCn>

                <ButtonCn aria-label="Settings" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                <div class="ml-2 h-5 w-px bg-border"></div>

                <button type="button"
                        class="ml-2 flex items-center gap-2 rounded-sm py-1 pr-1 text-left transition-colors hover:bg-muted/50">
                    <AvatarCn Class="size-6">
                        <AvatarImageCn Src="https://avatars.githubusercontent.com/u/1?v=4" Alt="User avatar" />
                        <AvatarFallbackCn>JD</AvatarFallbackCn>
                    </AvatarCn>
                    <span class="hidden text-sm sm:inline">John Doe</span>
                </button>
            </div>
        </nav>
    </div>
</section>

@code {
    private record BreadcrumbItem(string Label, string Href, bool IsCurrent = false);

    private static readonly BreadcrumbItem[] _breadcrumbs =
    [
        new("Home", "#home"),
        new("Projects", "#projects"),
        new("Website Redesign", "#website-redesign", true),
    ];

    private const int _notifications = 3;
    private string? _hoveredCrumb = null;
}
