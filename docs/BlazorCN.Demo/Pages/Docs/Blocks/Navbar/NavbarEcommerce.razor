@* ============================================================
   Block: navbar-ecommerce
   Title: NavbarEcommerce
   Description: A full-featured e-commerce navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a category dropdown menu, prominent center search bar, cart icon with item count badge, and user account icon with framer-motion animations.
   Source: original/blocks/navbar/navbar-ecommerce.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-4 px-4 py-3">
            @* Logo *@
            <span class="shrink-0 font-medium text-sm">Store</span>

            @* Categories dropdown *@
            <div class="relative"
                 @onmouseenter="HandleMouseEnter"
                 @onmouseleave="HandleMouseLeave">
                <button type="button"
                        @onclick="@(() => _categoryOpen = !_categoryOpen)"
                        class="flex shrink-0 items-center gap-1 rounded-md px-2 py-1.5 text-muted-foreground text-sm transition-colors hover:bg-muted/50 hover:text-foreground">
                    Categories
                    <LucideIconCn Name="chevron-down" Size="14"
                                  Class="@Cn.Merge("size-3.5 transition-transform duration-200", _categoryOpen ? "rotate-180" : "")" />
                </button>

                @if (_categoryOpen)
                {
                    <div class="absolute left-0 top-full z-50 mt-1 w-44 overflow-hidden rounded-md border bg-card shadow-md">
                        @foreach (var cat in _categories)
                        {
                            <a href="@cat.Href"
                               class="block px-3 py-2 text-sm transition-colors hover:bg-muted/50">
                                @cat.Label
                            </a>
                        }
                    </div>
                }
            </div>

            @* Search bar — takes center space *@
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14"
                              Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Placeholder="Search products..."
                         aria-label="Search products"
                         Class="h-8 border-border/50 bg-muted/30 pl-8 text-sm shadow-none focus-visible:ring-1" />
            </div>

            @* Cart with badge *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative h-8 w-8 shrink-0 p-0">
                <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="absolute -right-1 -top-1 flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                    @_cartCount
                </span>
            </ButtonCn>

            @* User account *@
            <ButtonCn aria-label="Account" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 shrink-0 p-0">
                <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
            </ButtonCn>
        </nav>
    </div>
</section>

@code {
    private bool _categoryOpen = false;
    private const int _cartCount = 3;

    private record Category(string Label, string Href);

    private static readonly Category[] _categories =
    [
        new("Electronics", "#electronics"),
        new("Clothing", "#clothing"),
        new("Home", "#home"),
        new("Sports", "#sports"),
    ];

    private void HandleMouseEnter()
    {
        _categoryOpen = true;
    }

    private void HandleMouseLeave()
    {
        _categoryOpen = false;
    }
}
