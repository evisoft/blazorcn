@* ============================================================
   Block: navbar-breadcrumb-dropdown
   Title: NavbarBreadcrumbDropdown
   Description: A breadcrumb navigation bar with dropdown menus at each level built with React, Next.js, shadcn/ui, and Tailwind CSS. Features clickable breadcrumb segments that open dropdown menus showing sibling items for multi-level navigation, chevron separators, and framer-motion entrance animation.
   Source: original/blocks/navbar/navbar-breadcrumb-dropdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo *@
            <div class="flex shrink-0 items-center gap-2">
                <span class="font-medium text-sm">Acme</span>
                <span class="text-muted-foreground/40">/</span>
            </div>

            @* Center: Breadcrumb dropdowns *@
            <div class="flex min-w-0 flex-1 items-center gap-1">
                @foreach (var levelItem in _breadcrumbLevels)
                {
                    var level = levelItem;
                    var index = _breadcrumbLevels.IndexOf(level);
                    var isLast = index == _breadcrumbLevels.Count - 1;

                    <div class="flex items-center gap-1">
                        @if (index > 0)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3 shrink-0 text-muted-foreground/50" />
                        }

                        @if (isLast)
                        {
                            @* Current page: no dropdown *@
                            <span class="rounded-md px-2 py-1.5 font-medium text-foreground text-xs">
                                @level.Label
                            </span>
                        }
                        else
                        {
                            @* Intermediate levels: dropdown *@
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn AsChild="true">
                                    <button type="button"
                                            class="flex items-center gap-1 rounded-md px-2 py-1.5 text-muted-foreground text-xs transition-colors hover:bg-muted/50 hover:text-foreground">
                                        @level.Label
                                        <LucideIconCn Name="chevron-down" Size="12" Class="size-3 text-muted-foreground/60" />
                                    </button>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.Start" Class="w-48">
                                    @foreach (var siblingItem in level.Siblings)
                                    {
                                        var sibling = siblingItem;
                                        var sIndex = level.Siblings.IndexOf(sibling);

                                        <div>
                                            <DropdownMenuItemCn Class="@(sibling.IsCurrent ? "bg-muted/50 font-medium" : "")">
                                                <a href="@sibling.Href" class="flex w-full items-center gap-2">
                                                    @if (sibling.IsCurrent)
                                                    {
                                                        <span class="size-1.5 shrink-0 rounded-full bg-foreground" />
                                                    }
                                                    <span>@sibling.Label</span>
                                                </a>
                                            </DropdownMenuItemCn>
                                            @if (sIndex == 0 && level.Siblings.Count > 1)
                                            {
                                                <DropdownMenuSeparatorCn />
                                            }
                                        </div>
                                    }
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        }
                    </div>
                }
            </div>

            @* Right: Actions *@
            <div class="flex shrink-0 items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>
                <div class="h-5 w-px bg-border" />
                <AvatarCn Class="ml-1 size-8">
                    <AvatarImageCn Src="https://avatars.githubusercontent.com/u/1?v=4" Alt="User avatar" />
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record Sibling(string Label, string Href, bool IsCurrent = false);
    private record BreadcrumbLevel(string Label, string Href, List<Sibling> Siblings);

    private List<BreadcrumbLevel> _breadcrumbLevels =
    [
        new BreadcrumbLevel("Home", "#home",
        [
            new Sibling("Dashboard", "#dashboard"),
            new Sibling("Projects", "#projects", true),
            new Sibling("Analytics", "#analytics"),
            new Sibling("Team", "#team"),
            new Sibling("Settings", "#settings"),
        ]),
        new BreadcrumbLevel("Projects", "#projects",
        [
            new Sibling("Website Redesign", "#website-redesign", true),
            new Sibling("Mobile App", "#mobile-app"),
            new Sibling("Marketing Site", "#marketing-site"),
            new Sibling("API Platform", "#api-platform"),
        ]),
        new BreadcrumbLevel("Website Redesign", "#website-redesign",
        [
            new Sibling("Overview", "#overview", true),
            new Sibling("Tasks", "#tasks"),
            new Sibling("Files", "#files"),
            new Sibling("Timeline", "#timeline"),
            new Sibling("Members", "#members"),
        ]),
    ];
}
