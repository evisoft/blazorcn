@* ============================================================
   Block: navbar-cart-preview
   Title: NavbarCartPreview
   Description: An e-commerce navigation bar with cart dropdown preview built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a mini cart showing items with image placeholders, names, prices, quantities, subtotal, and checkout button with framer-motion animations.
   Source: original/blocks/navbar/navbar-cart-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Logo *@
            <span class="font-medium text-sm">Store</span>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    <a href="@link.Href"
                       class="px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground">
                        @link.Label
                    </a>
                }
            </div>

            @* Cart with dropdown *@
            <div class="relative">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative h-8 w-8 p-0"
                          OnClick="@(() => _cartOpen = !_cartOpen)">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="absolute -right-1 -top-1 flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                        @_cartItems.Sum(item => item.Quantity)
                    </span>
                </ButtonCn>

                @if (_cartOpen)
                {
                    <div class="absolute right-0 top-full z-50 mt-2 w-72 overflow-hidden rounded-md border bg-card shadow-lg">
                        @* Header *@
                        <div class="border-b px-3 py-2">
                            <span class="font-medium text-xs">
                                Cart (@(_cartItems.Sum(item => item.Quantity)) items)
                            </span>
                        </div>

                        @* Items *@
                        <div class="max-h-60 overflow-y-auto">
                            @for (int i = 0; i < _cartItems.Length; i++)
                            {
                                var item = _cartItems[i];
                                var borderClass = i < _cartItems.Length - 1 ? "border-b" : "";
                                <div class="@Cn.Merge("flex items-center gap-3 px-3 py-2.5", borderClass)">
                                    @* Image placeholder *@
                                    <div class="flex size-10 shrink-0 items-center justify-center rounded bg-muted text-muted-foreground text-xs font-medium">
                                        @item.Image
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate font-medium text-xs">@item.Name</p>
                                        <div class="mt-0.5 flex items-center gap-2">
                                            <span class="text-muted-foreground text-xs">@item.Price</span>
                                            <span class="text-muted-foreground text-xs">×@item.Quantity</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Subtotal *@
                        <div class="border-t px-3 py-2">
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">Subtotal</span>
                                <span class="font-medium text-sm">@_subtotal</span>
                            </div>
                        </div>

                        @* Actions *@
                        <div class="border-t px-3 py-2.5">
                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 w-full text-xs">
                                Checkout
                            </ButtonCn>
                            <a href="#cart"
                               class="mt-1.5 block text-center text-muted-foreground text-xs transition-colors hover:text-foreground">
                                View Full Cart
                            </a>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </div>
</section>

@code {
    private bool _cartOpen = false;

    private static readonly string _subtotal = "$155.96";

    private record CartItem(string Id, string Name, string Price, int Quantity, string Image);

    private static readonly CartItem[] _cartItems =
    [
        new("1", "Wireless Headphones", "$79.99", 1, "WH"),
        new("2", "USB-C Charging Cable", "$12.99", 2, "UC"),
        new("3", "Laptop Stand", "$49.99", 1, "LS"),
    ];

    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Shop", "#shop"),
        new("New Arrivals", "#new"),
        new("Sale", "#sale"),
    ];
}
