@* ============================================================
   Block: navbar-startup
   Title: NavbarStartup
   Description: A minimal startup navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a logo with Beta badge, clean navigation links for Product, Pricing, About, and Blog, plus a right-aligned Join Waitlist CTA button with sparkle icon and framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-startup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Navbar *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Launchpad</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-normal text-[10px]">
                        Beta
                    </BadgeCn>
                </div>
                <nav class="hidden items-center gap-1 sm:flex">
                    @foreach (var lnk in _navLinks)
                    {
                        var link = lnk;
                        <button type="button"
                                class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm transition-colors", _activeLink == link ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeLink = link)">
                            @link
                        </button>
                    }
                </nav>
            </div>

            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-sm">
                    <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" />
                    Join Waitlist
                </ButtonCn>
            </div>
        </div>

        @* Demo content area *@
        <div class="border-t px-4 py-12">
            <div class="flex flex-col items-center justify-center gap-2 text-center">
                <span class="text-muted-foreground text-xs">
                    Minimal startup navbar with Beta badge and waitlist CTA
                </span>
                <span class="text-muted-foreground/60 text-xs">
                    Click nav links to see the active state indicator
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _navLinks = ["Product", "Pricing", "About", "Blog"];

    private string? _activeLink = null;
}
