@* ============================================================
   Block: navbar-code-editor
   Title: NavbarCodeEditor
   Description: A code editor navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features file tabs with close buttons, active tab highlighting, git branch indicator, run button, extensions icon, and settings gear with framer-motion tab animations. VS Code inspired design.
   Source: original/blocks/navbar/navbar-code-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center">
            @* Left: file tabs *@
            <div class="flex min-w-0 flex-1 items-center overflow-x-auto">
                @foreach (var tab in _tabs)
                {
                    var tabItem = tab;
                    <div class="@Cn.Merge("group flex shrink-0 items-center gap-2 border-r px-3 py-2.5 transition-colors", tabItem.Active ? "bg-card" : "bg-muted/30 text-muted-foreground hover:bg-muted/50")">
                        <button type="button"
                                class="flex items-center gap-2"
                                @onclick="@(() => SetActiveTab(tabItem.Id))">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetExtensionColor(tabItem.Extension))"></span>
                            <span class="@Cn.Merge("text-xs", tabItem.Active ? "font-medium" : "")">
                                @tabItem.Name<span class="text-muted-foreground">@tabItem.Extension</span>
                            </span>
                        </button>
                        <button type="button"
                                class="flex size-4 shrink-0 items-center justify-center rounded-sm opacity-0 transition-opacity hover:bg-muted group-hover:opacity-100"
                                @onclick="@(() => CloseTab(tabItem.Id))">
                            <LucideIconCn Name="x" Size="12" Class="size-3 text-muted-foreground" />
                        </button>
                    </div>
                }
            </div>

            @* Right: git branch + actions *@
            <div class="flex shrink-0 items-center gap-1 px-3">
                <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1">
                    <LucideIconCn Name="git-branch" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-mono text-xs text-muted-foreground">main</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
                    <LucideIconCn Name="play" Size="12" Class="size-3" />
                    Run
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                    <LucideIconCn Name="blocks" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                    <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record FileTab(string Id, string Name, string Extension, bool Active);

    private List<FileTab> _tabs =
    [
        new("1", "index", ".tsx", true),
        new("2", "styles", ".css", false),
        new("3", "readme", ".md", false),
        new("4", "utils", ".ts", false),
    ];

    private static string GetExtensionColor(string extension) => extension switch
    {
        ".tsx" => "bg-blue-500",
        ".css" => "bg-purple-500",
        ".md"  => "bg-zinc-400",
        ".ts"  => "bg-blue-400",
        _      => "bg-zinc-400",
    };

    private void SetActiveTab(string id)
    {
        _tabs = _tabs.Select(t => new FileTab(t.Id, t.Name, t.Extension, t.Id == id)).ToList();
    }

    private void CloseTab(string id)
    {
        var wasActive = _tabs.FirstOrDefault(t => t.Id == id)?.Active ?? false;
        var filtered = _tabs.Where(t => t.Id != id).ToList();
        if (wasActive && filtered.Count > 0)
        {
            var first = filtered[0];
            filtered[0] = new FileTab(first.Id, first.Name, first.Extension, true);
        }
        _tabs = filtered;
    }
}
