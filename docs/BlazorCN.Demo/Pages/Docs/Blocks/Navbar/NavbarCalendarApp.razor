@* ============================================================
   Block: navbar-calendar-app
   Title: NavbarCalendarApp
   Description: A calendar application navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a logo with Today button, navigation arrows for date switching, current month and year display, view toggle for Day, Week, Month, and Agenda modes, timezone selector, New Event button, and user avatar with framer-motion animations.
   Source: original/blocks/navbar/navbar-calendar-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center gap-3 px-4 py-3">
            @* Left: logo + today + navigation *@
            <div class="flex shrink-0 items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 px-2.5 text-xs">
                    Today
                </ButtonCn>
                <div class="flex items-center gap-0.5">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4 text-muted-foreground" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground" />
                    </ButtonCn>
                </div>
                <span class="font-medium text-sm">March 2026</span>
            </div>

            @* Center: view toggle *@
            <div class="flex flex-1 items-center justify-center">
                <div class="flex items-center rounded-md bg-muted/50 p-0.5">
                    @foreach (var v in _views)
                    {
                        var view = v;
                        <button
                            type="button"
                            @onclick="@(() => _activeView = view)"
                            class="@($"relative rounded-sm px-3 py-1 text-xs transition-colors {(_activeView == view ? "text-foreground" : "text-muted-foreground hover:text-foreground")}")">
                            @if (_activeView == view)
                            {
                                <span class="absolute inset-0 rounded-sm bg-background shadow-sm"></span>
                            }
                            <span class="relative z-10">@view</span>
                        </button>
                    }
                </div>
            </div>

            @* Right: timezone + new event + avatar *@
            <div class="flex shrink-0 items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="globe" Size="12" Class="size-3" />
                    EST
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-3 text-xs">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    New Event
                </ButtonCn>
                <AvatarCn Class="ml-1 size-7">
                    <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                </AvatarCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private string _activeView = "Month";

    private static readonly string[] _views = ["Day", "Week", "Month", "Agenda"];
}
