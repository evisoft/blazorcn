@* ============================================================
   Block: navbar-fintech
   Title: NavbarFintech
   Description: A financial services navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a trust-inspiring bank logo, account navigation links, notification bell with count indicator, help icon, and a user avatar with account type premium badge using framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-fintech.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo and nav *@
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="shield" Size="16" Class="size-4 text-foreground" />
                    <span class="font-medium text-sm">Vault</span>
                </div>

                <div class="hidden items-center gap-1 sm:flex">
                    @foreach (var link in _navLinks)
                    {
                        var lbl = link.Label;
                        var isActive = _activeLink == lbl;
                        <button type="button"
                                class="@Cn.Merge("relative rounded-md px-3 py-1.5 text-sm transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeLink = lbl)">
                            @lbl
                            @if (isActive)
                            {
                                <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* Right: Actions and user *@
            <div class="flex items-center gap-1">
                @* Help *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                    <LucideIconCn Name="circle-help" Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                @* Notifications *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="relative size-8 p-0">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    @if (_notificationCount > 0)
                    {
                        <span class="absolute -right-0.5 -top-0.5 flex size-4 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                            @_notificationCount
                        </span>
                    }
                </ButtonCn>

                @* User with account badge *@
                <div class="ml-2 flex items-center gap-2">
                    <div class="hidden flex-col items-end sm:flex">
                        <span class="font-medium text-sm">John D.</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                            Premium
                        </BadgeCn>
                    </div>
                    <AvatarCn Class="size-8">
                        <AvatarFallbackCn Class="text-[10px]">JD</AvatarFallbackCn>
                    </AvatarCn>
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Accounts", "#accounts"),
        new("Transfers", "#transfers"),
        new("Investments", "#investments"),
        new("Cards", "#cards"),
    ];

    private static readonly int _notificationCount = 3;

    private string _activeLink = "Accounts";
}
