@* ============================================================
   Block: navbar-condensed
   Title: NavbarCondensed
   Description: An ultra-compact single-line navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a small logo icon, tightly spaced text links, and minimal action buttons all within a h-10 height. Designed for dense dashboards and data-heavy interfaces using framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-condensed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex h-10 items-center justify-between px-3">
            @* Left: Logo icon + Links *@
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <button
                        type="button"
                        aria-label="Toggle sidebar"
                        class="flex items-center justify-center rounded-md p-1 text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="panel-left" Size="14" Class="size-3.5" />
                    </button>
                    <div class="h-3.5 w-px bg-border"></div>
                    <span class="flex items-center gap-1 font-medium text-xs">
                        <LucideIconCn Name="command" Size="12" Class="size-3" />
                        Acme
                    </span>
                </div>

                <div class="flex items-center">
                    @foreach (var lnk in _navLinks)
                    {
                        var link = lnk;
                        <button
                            type="button"
                            @onclick="@(() => _activeLink = link.Label)"
                            class="@Cn.Merge("px-2 py-1 text-xs transition-colors", _activeLink == link.Label ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                            @link.Label
                        </button>
                    }
                </div>
            </div>

            @* Right: Minimal actions *@
            <div class="flex items-center gap-1">
                <button
                    type="button"
                    class="flex items-center gap-1 rounded-md px-2 py-1 text-muted-foreground text-xs transition-colors hover:text-foreground">
                    <LucideIconCn Name="search" Size="12" Class="size-3" />
                    <span class="text-muted-foreground/60">Cmd+K</span>
                </button>
                <div class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                    J
                </div>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Dashboard", "#dashboard"),
        new("Deployments", "#deployments"),
        new("Logs", "#logs"),
        new("Monitoring", "#monitoring"),
        new("Storage", "#storage"),
        new("Settings", "#settings"),
    ];

    private string _activeLink = "Dashboard";
}
