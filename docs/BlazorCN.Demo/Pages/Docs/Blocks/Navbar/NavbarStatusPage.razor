@* ============================================================
   Block: navbar-status-page
   Title: NavbarStatusPage
   Description: A status page navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a StatusHub logo, live system status indicator with green or amber dot, navigation for Current Status, Incidents, Maintenance, and Subscribe pages, plus an RSS feed icon and subscribe button with framer-motion animations.
   Source: original/blocks/navbar/navbar-status-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Main navbar *@
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo + Status indicator *@
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-md bg-foreground text-background">
                        <span class="font-medium text-xs">S</span>
                    </div>
                    <span class="font-medium text-sm">StatusHub</span>
                </div>

                <div class="h-4 w-px bg-border"></div>

                @* System status *@
                <div class="flex items-center gap-2">
                    <span class="@($"size-2 rounded-full {_statusConfigs[_status].DotColor}")"></span>
                    <span class="@($"text-xs font-medium {_statusConfigs[_status].TextColor}")">@_statusConfigs[_status].Label</span>
                </div>
            </div>

            @* Right: Nav links + RSS + Subscribe *@
            <div class="flex items-center gap-1">
                <div class="hidden items-center gap-1 sm:flex">
                    @foreach (var lnk in _navLinks)
                    {
                        var link = lnk;
                        <button type="button"
                                @onclick="@(() => _activeLink = link.Label)"
                                class="@Cn.Merge("relative rounded-md px-2.5 py-1.5 text-xs transition-colors", _activeLink == link.Label ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                            @link.Label
                            @if (_activeLink == link.Label)
                            {
                                <span class="absolute inset-x-2 -bottom-0.5 h-px bg-foreground"></span>
                            }
                        </button>
                    }
                </div>

                <div class="mx-1 h-4 w-px bg-border"></div>

                <ButtonCn aria-label="RSS feed" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideIconCn Name="rss" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>

                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                    Subscribe
                </ButtonCn>
            </div>
        </nav>

        @* Demo: Status toggle *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Toggle status to preview</span>
            <div class="flex items-center gap-1">
                @foreach (var key in _statusKeys)
                {
                    var s = key;
                    <button type="button"
                            @onclick="@(() => _status = s)"
                            class="@Cn.Merge("relative rounded-md px-2.5 py-1 text-xs transition-colors", _status == s ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                        @if (_status == s)
                        {
                            <span class="absolute inset-0 rounded-md bg-muted/50"></span>
                        }
                        <span class="relative flex items-center gap-1.5">
                            <span class="@($"size-1.5 rounded-full {_statusConfigs[s].DotColor}")"></span>
                            @_statusConfigs[s].Label
                        </span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string _status = "operational";
    private string _activeLink = "Current Status";

    private record StatusConfig(string Label, string DotColor, string TextColor);

    private static readonly Dictionary<string, StatusConfig> _statusConfigs = new()
    {
        ["operational"] = new("All Systems Operational", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        ["partial"]     = new("Partial Outage",          "bg-amber-500",   "text-amber-600 dark:text-amber-400"),
        ["major"]       = new("Major Outage",            "bg-red-500",     "text-red-600 dark:text-red-400"),
    };

    private static readonly string[] _statusKeys = ["operational", "partial", "major"];

    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Current Status", "#status"),
        new("Incidents",      "#incidents"),
        new("Maintenance",    "#maintenance"),
        new("Subscribe",      "#subscribe"),
    ];
}
