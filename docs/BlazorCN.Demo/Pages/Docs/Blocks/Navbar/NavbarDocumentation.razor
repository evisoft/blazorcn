@* ============================================================
   Block: navbar-documentation
   Title: NavbarDocumentation
   Description: A documentation site navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a logo with docs badge, version picker dropdown, search input with Cmd+K shortcut hint, navigation links, GitHub star count badge, and dark mode toggle using framer-motion transitions.
   Source: original/blocks/navbar/navbar-documentation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between gap-4 px-6 py-3">
            @* Logo + Docs badge + Version *@
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Acme</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-[10px]">
                        Docs
                    </BadgeCn>
                </div>

                <div class="h-4 w-px bg-border"></div>

                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 font-mono text-xs text-muted-foreground">
                            @_selectedVersion
                            <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                        </ButtonCn>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.Start" Class="w-28">
                        @foreach (var ver in _versions)
                        {
                            var version = ver;
                            <DropdownMenuItemCn OnClick="@(() => _selectedVersion = version)" Class="flex items-center justify-between font-mono text-xs">
                                @version
                                @if (version == _selectedVersion)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-foreground" />
                                }
                            </DropdownMenuItemCn>
                        }
                    </DropdownMenuContentCn>
                </DropdownMenuCn>
            </div>

            @* Search *@
            <div class="flex max-w-48 flex-1 items-center gap-2 rounded-md border bg-muted/50 px-2.5 py-1.5">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="flex-1 text-muted-foreground text-xs">Search docs...</span>
                <kbd class="h-4 min-w-0 rounded border bg-background px-1 font-mono text-[10px] text-muted-foreground shadow-sm">
                    <span class="text-[10px]">&#8984;K</span>
                </kbd>
            </div>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var lnk in _navLinks)
                {
                    var link = lnk;
                    <a href="@link.Href"
                       class="relative px-2.5 py-1.5 text-muted-foreground text-xs transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = link.Label)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @link.Label
                        @if (_hoveredLink == link.Label)
                        {
                            <span class="absolute inset-x-2.5 -bottom-0.5 h-px bg-foreground transition-all duration-200"></span>
                        }
                    </a>
                }
            </div>

            @* GitHub stars + Dark mode toggle *@
            <div class="flex items-center gap-1">
                <a href="https://github.com"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="flex h-7 items-center gap-1.5 rounded-md border bg-muted/50 px-2 text-muted-foreground text-xs transition-colors hover:text-foreground">
                    <svg viewBox="0 0 24 24" class="size-3.5 fill-current" aria-hidden="true">
                        <title>GitHub</title>
                        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                    <LucideIconCn Name="star" Size="12" Class="size-3" />
                    <span class="font-medium tabular-nums">12.4k</span>
                </a>

                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0 text-muted-foreground" aria-label="Toggle dark mode" OnClick="@(() => _isDark = !_isDark)">
                    @if (_isDark)
                    {
                        <LucideIconCn Name="sun" Size="14" Class="size-3.5" />
                    }
                    else
                    {
                        <LucideIconCn Name="moon" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Guide", "#guide"),
        new("API", "#api"),
        new("Examples", "#examples"),
        new("Blog", "#blog"),
    ];

    private static readonly string[] _versions = ["v3.2", "v3.1", "v3.0", "v2.9"];

    private string _selectedVersion = "v3.2";
    private string? _hoveredLink = null;
    private bool _isDark = false;
}
