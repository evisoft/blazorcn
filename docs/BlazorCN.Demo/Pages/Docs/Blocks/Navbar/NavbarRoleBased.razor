@* ============================================================
   Block: navbar-role-based
   Title: NavbarRoleBased
   Description: A role-aware navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Displays different menu items based on user role with toggle between Admin, Editor, and Viewer roles. Features a role badge next to the user name and framer-motion AnimatePresence for smooth menu transitions.
   Source: original/blocks/navbar/navbar-role-based.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Main navbar *@
        <nav class="flex items-center justify-between px-4 py-3">
            @* Left: Logo + Role nav links *@
            <div class="flex items-center gap-6">
                <span class="font-medium text-sm">Acme CMS</span>
                <div class="h-4 w-px bg-border"></div>
                <div class="flex items-center gap-1">
                    @foreach (var link in _currentLinks)
                    {
                        <a href="@link.Href"
                           class="flex items-center gap-1.5 rounded-md px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:bg-muted/50 hover:text-foreground">
                            <LucideIconCn Name="@link.Icon" Size="14" Class="size-3.5" />
                            @link.Label
                        </a>
                    }
                </div>
            </div>

            @* Right: User + Role badge *@
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-2">
                    <AvatarCn Class="size-6">
                        <AvatarFallbackCn Class="text-[10px]">MR</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="hidden flex-col items-start sm:flex">
                        <span class="font-medium text-xs">Marcus Rivera</span>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-[10px]", _currentColor)">
                    @_currentLabel
                </BadgeCn>
            </div>
        </nav>

        @* Role switcher demo bar *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Switch role to preview</span>
            <div class="flex items-center gap-1">
                @foreach (var role in _roles)
                {
                    var r = role;
                    <button type="button"
                            @onclick="@(() => _activeRole = r.Key)"
                            class="@Cn.Merge("relative rounded-md px-2.5 py-1 text-xs transition-colors", _activeRole == r.Key ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                        @if (_activeRole == r.Key)
                        {
                            <span class="absolute inset-0 rounded-md bg-muted/50"></span>
                        }
                        <span class="relative">@r.Value.Label</span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string _activeRole = "admin";

    private record NavLink(string Label, string Href, string Icon);
    private record RoleConfig(string Label, string Color, NavLink[] Links);

    private static readonly Dictionary<string, RoleConfig> _roles = new()
    {
        ["admin"] = new RoleConfig("Admin", "bg-foreground text-background", [
            new("Dashboard", "#dashboard", "layout-dashboard"),
            new("Users", "#users", "users"),
            new("Content", "#content", "file-text"),
            new("Settings", "#settings", "settings"),
            new("Admin Panel", "#admin", "shield"),
        ]),
        ["editor"] = new RoleConfig("Editor", "bg-muted text-foreground", [
            new("Content", "#content", "file-text"),
            new("Media", "#media", "image"),
            new("Publish", "#publish", "send"),
            new("Drafts", "#drafts", "folder"),
        ]),
        ["viewer"] = new RoleConfig("Viewer", "bg-muted text-muted-foreground", [
            new("Browse", "#browse", "folder"),
            new("Saved", "#saved", "bookmark"),
            new("Recent", "#recent", "file-text"),
        ]),
    };

    private RoleConfig _current => _roles[_activeRole];
    private NavLink[] _currentLinks => _current.Links;
    private string _currentLabel => _current.Label;
    private string _currentColor => _current.Color;
}
