@* ============================================================
   Block: navbar-landing-page
   Title: NavbarLandingPage
   Description: A marketing landing page navigation bar built with React, Next.js, shadcn/ui, and Tailwind CSS. Features a company logo, anchor navigation links for Features, Pricing, Testimonials, and FAQ, a ghost Log in button, and a filled Get Started Free CTA button with framer-motion entrance animations.
   Source: original/blocks/navbar/navbar-landing-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <nav class="flex items-center justify-between px-6 py-3">
            @* Logo *@
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-md bg-foreground">
                    <span class="font-medium text-background text-xs">A</span>
                </div>
                <span class="font-medium text-sm">Acme</span>
            </div>

            @* Nav links *@
            <div class="flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    var lbl = link.Label;
                    var isHovered = _hoveredLink == lbl;
                    <a href="@link.Href"
                       class="relative px-3 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
                       @onmouseenter="@(() => _hoveredLink = lbl)"
                       @onmouseleave="@(() => _hoveredLink = null)">
                        @lbl
                        @if (isHovered)
                        {
                            <span class="absolute inset-x-3 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </a>
                }
            </div>

            @* Auth buttons *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                    Log in
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Get Started Free
                </ButtonCn>
            </div>
        </nav>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Features", "#features"),
        new("Pricing", "#pricing"),
        new("Testimonials", "#testimonials"),
        new("FAQ", "#faq"),
    ];

    private string? _hoveredLink = null;
}
