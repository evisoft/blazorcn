@* ============================================================
   Block: calendar-garden-planner
   Title: CalendarGardenPlanner
   Description: A garden planting calendar block for Next.js with seasonal planting windows, plant care schedules, and harvest date tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-garden-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Garden Planner</h2>
                <p class="text-muted-foreground text-xs">Spring 2026 — Zone 7b</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="sprout" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_plants.Length</span>
                <span class="text-muted-foreground text-xs">plants</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="leaf" Size="14" Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @ActiveCount
                </span>
                active
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="sun" Size="14" Class="size-3.5" />
                Last frost: Mar 28
            </div>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            @foreach (var f in new[] { "all", "active", "planned" })
            {
                var filterVal = f;
                <ButtonCn Variant="@(_filter == filterVal ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs capitalize" @onclick="@(() => _filter = filterVal)">
                    @filterVal
                </ButtonCn>
            }
        </div>

        <div>
            @{ var filtered = Filtered; }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var plant = filtered[i];
                var phase = _phaseConfig[plant.Phase];
                var status = _statusConfig[plant.Status];
                var isLast = i == filtered.Length - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {phase.Dot}")"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@plant.Name</span>
                            <span class="text-muted-foreground text-xs">@plant.Variety</span>
                        </div>
                        <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @phase.Label
                            </BadgeCn>
                            <span>·</span>
                            <span>@plant.Sunlight</span>
                            <span>·</span>
                            <span>@plant.Spacing spacing</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-0.5 shrink-0">
                        <span class="@($"text-xs {status.Color}")">@status.Label</span>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            Harvest: @plant.HarvestDate
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Plant(string Id, string Name, string Variety, string Phase, string PlantDate, string HarvestDate, int DaysToHarvest, string Spacing, string Sunlight, string Status);
    private record PhaseInfo(string Label, string Dot);
    private record StatusInfo(string Label, string Color);

    private string _filter = "all";

    private static readonly Dictionary<string, PhaseInfo> _phaseConfig = new()
    {
        ["sow-indoors"] = new("Sow Indoors", "bg-purple-500"),
        ["transplant"] = new("Transplant", "bg-blue-500"),
        ["direct-sow"] = new("Direct Sow", "bg-emerald-500"),
        ["harvest"] = new("Harvest", "bg-amber-500"),
    };

    private static readonly Dictionary<string, StatusInfo> _statusConfig = new()
    {
        ["planted"] = new("Planted", "text-blue-600"),
        ["growing"] = new("Growing", "text-emerald-600"),
        ["ready"] = new("Ready to Harvest", "text-amber-600"),
        ["planned"] = new("Planned", "text-muted-foreground"),
    };

    private static readonly Plant[] _plants =
    [
        new("1", "Tomatoes", "Roma", "transplant", "Mar 15", "Jul 10", 117, "24 in", "Full sun", "planted"),
        new("2", "Lettuce", "Butterhead", "direct-sow", "Mar 10", "Apr 20", 41, "8 in", "Partial shade", "growing"),
        new("3", "Peppers", "Bell", "sow-indoors", "Mar 1", "Jul 25", 146, "18 in", "Full sun", "growing"),
        new("4", "Basil", "Genovese", "transplant", "Mar 20", "May 15", 56, "12 in", "Full sun", "planned"),
        new("5", "Carrots", "Nantes", "direct-sow", "Mar 22", "Jun 10", 80, "3 in", "Full sun", "planned"),
        new("6", "Radishes", "Cherry Belle", "direct-sow", "Mar 5", "Apr 2", 28, "2 in", "Full sun", "ready"),
        new("7", "Zucchini", "Black Beauty", "direct-sow", "Apr 5", "Jun 20", 76, "36 in", "Full sun", "planned"),
        new("8", "Spinach", "Bloomsdale", "direct-sow", "Mar 8", "Apr 15", 38, "6 in", "Partial shade", "growing"),
    ];

    private Plant[] Filtered => _filter switch
    {
        "active" => _plants.Where(p => p.Status == "planted" || p.Status == "growing" || p.Status == "ready").ToArray(),
        "planned" => _plants.Where(p => p.Status == "planned").ToArray(),
        _ => _plants,
    };

    private int ActiveCount => _plants.Count(p => p.Status != "planned");
}
