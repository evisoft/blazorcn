@* ============================================================
   Block: calendar-payment-schedule
   Title: Calendar Payment Schedule
   Description: A React payment due date schedule block for Next.js with amount, payment status indicators, auto-pay toggle, and overdue alerts built with shadcn/ui and Tailwind CSS
   Long Description: React On-Call Rotation Calendar Block
   Dependencies: BadgeCn, SwitchCn
   Source: original/blocks/calendar/calendar-payment-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCreditCardCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payment Schedule</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500" /> Paid
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500" /> Due
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500" /> Overdue
                </span>
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@FormatCurrency(_totalUpcoming)</span>
                <span class="text-muted-foreground text-xs">due</span>
            </div>
            @if (_totalOverdue > 0)
            {
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-red-600 text-xs dark:text-red-400">@FormatCurrency(_totalOverdue) overdue</span>
            }
            <span class="ml-auto text-muted-foreground text-xs">@_payments.Length bills</span>
        </div>

        @* Payment list *@
        <div>
            @for (int i = 0; i < _payments.Length; i++)
            {
                var payment = _payments[i];
                var isExpanded = _expanded == payment.Id;
                var isLast = i == _payments.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == payment.Id ? null : payment.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {GetStatusDot(payment.Status)}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@payment.Name</span>
                                <span class="text-muted-foreground text-xs">@payment.Category</span>
                            </div>
                            <span class="mt-0.5 text-muted-foreground text-xs">Due @payment.DueDate</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-medium text-sm tabular-nums">@FormatCurrency(payment.Amount)</span>
                            <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-center gap-4 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1.5">
                                        <LucideDollarSignCn Class="size-3" />
                                        @payment.Account
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @GetStatusLabel(payment.Status)
                                    </BadgeCn>
                                </div>
                                <div class="flex items-center justify-between rounded-md bg-muted/50 p-3">
                                    <div>
                                        <span class="font-medium text-xs">Auto-pay</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">Last paid @payment.LastPaid</p>
                                    </div>
                                    <SwitchCn aria-label="@($"Toggle auto-pay for {payment.Name}")" Checked="@_autoPayState[payment.Id]"
                                              CheckedChanged="@((bool v) => _autoPayState[payment.Id] = v)" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "2";
    private Dictionary<string, bool> _autoPayState = new();

    private record Payment(string Id, string Name, string Category, decimal Amount, string DueDate, string Status, bool AutoPay, string Account, string LastPaid);

    protected override void OnInitialized()
    {
        _autoPayState = _payments.ToDictionary(p => p.Id, p => p.AutoPay);
    }

    private static readonly Payment[] _payments =
    [
        new("1", "Rent", "Housing", 2150m, "Mar 1, 2026", "paid", true, "Chase \u2022\u20224521", "Mar 1, 2026"),
        new("2", "Electric Bill", "Utilities", 134.50m, "Mar 15, 2026", "overdue", false, "BOA \u2022\u20227832", "Feb 15, 2026"),
        new("3", "Internet", "Utilities", 79.99m, "Mar 20, 2026", "upcoming", true, "Chase \u2022\u20224521", "Feb 20, 2026"),
        new("4", "Car Insurance", "Insurance", 215m, "Mar 22, 2026", "upcoming", true, "Amex \u2022\u20229102", "Feb 22, 2026"),
        new("5", "Student Loan", "Debt", 485m, "Mar 25, 2026", "upcoming", false, "Navient \u2022\u20223344", "Feb 25, 2026"),
        new("6", "Gym Membership", "Health", 49.99m, "Mar 28, 2026", "upcoming", true, "Chase \u2022\u20224521", "Feb 28, 2026"),
        new("7", "Phone Plan", "Utilities", 65m, "Apr 3, 2026", "upcoming", false, "BOA \u2022\u20227832", "Mar 3, 2026"),
    ];

    private static readonly decimal _totalUpcoming = _payments.Where(p => p.Status == "upcoming").Sum(p => p.Amount);
    private static readonly decimal _totalOverdue = _payments.Where(p => p.Status == "overdue").Sum(p => p.Amount);

    private static string FormatCurrency(decimal amount) => $"${amount:N2}";

    private static string GetStatusDot(string status) => status switch
    {
        "paid" => "bg-emerald-500",
        "upcoming" => "bg-blue-500",
        "overdue" => "bg-red-500",
        _ => "bg-zinc-400"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "paid" => "Paid",
        "upcoming" => "Upcoming",
        "overdue" => "Overdue",
        _ => status
    };
}
