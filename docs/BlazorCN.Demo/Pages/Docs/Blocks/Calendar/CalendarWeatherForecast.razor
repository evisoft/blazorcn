@* ============================================================
   Block: calendar-weather-forecast
   Title: Calendar Weather Forecast
   Description: A React 7-day weather forecast calendar block for Next.js with temperature, conditions, wind speed, and daily weather icons built with shadcn/ui and Tailwind CSS
   Long Description: React Travel Itinerary Calendar Block
   Dependencies: None
   Source: original/blocks/calendar/calendar-weather-forecast.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideSunCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">7-Day Forecast</span>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideMapPinCn Size="12" class="size-3" />
                San Francisco, CA
            </div>
        </div>

        @* Day cards grid *@
        <div class="grid grid-cols-7 gap-px border-b bg-border">
            @foreach (var day in _forecast)
            {
                var isSelected = _selected == day.Id;
                <button type="button"
                        @onclick="@(() => _selected = day.Id)"
                        class="@Cn.Merge("flex flex-col items-center gap-1.5 bg-card px-1 py-3 transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50" : "")">
                    <span class="font-medium text-xs">@day.Day</span>
                    <span class="text-muted-foreground text-xs">@day.Date</span>
                    @switch (day.Condition)
                    {
                        case "clear":
                            <LucideSunCn Size="20" class="my-1 size-5 text-muted-foreground" />
                            break;
                        case "partly-cloudy":
                        case "cloudy":
                            <LucideCloudCn Size="20" class="my-1 size-5 text-muted-foreground" />
                            break;
                        case "rain":
                            <LucideCloudRainCn Size="20" class="my-1 size-5 text-muted-foreground" />
                            break;
                        case "drizzle":
                            <LucideCloudDrizzleCn Size="20" class="my-1 size-5 text-muted-foreground" />
                            break;
                        case "snow":
                            <LucideCloudSnowCn Size="20" class="my-1 size-5 text-muted-foreground" />
                            break;
                    }
                    <div class="flex items-center gap-1">
                        <span class="font-medium text-xs tabular-nums">@(day.High)&deg;</span>
                        <span class="text-muted-foreground text-xs tabular-nums">@(day.Low)&deg;</span>
                    </div>
                </button>
            }
        </div>

        @* Selected day detail *@
        @{ var selectedDay = _forecast.FirstOrDefault(d => d.Id == _selected); }
        @if (selectedDay is not null)
        {
            <div class="px-4 py-3">
                <div class="flex items-center gap-3">
                    <div class="flex items-baseline gap-1">
                        <span class="font-semibold text-2xl tabular-nums">@(selectedDay.High)&deg;</span>
                        <span class="text-muted-foreground text-sm tabular-nums">
                            /@(selectedDay.Low)&deg;
                        </span>
                    </div>
                    <span class="text-muted-foreground text-xs">
                        @_conditionLabel[selectedDay.Condition]
                    </span>
                </div>
                <p class="mt-2 text-muted-foreground text-sm">@selectedDay.Description</p>
                <div class="mt-3 flex items-center gap-4 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1.5">
                        <LucideWindCn Size="12" class="size-3" />
                        @selectedDay.Wind mph
                    </span>
                    <span class="flex items-center gap-1.5">
                        <LucideDropletCn Size="12" class="size-3" />
                        @(selectedDay.Humidity)%
                    </span>
                    <span class="flex items-center gap-1.5">
                        <LucideSunCn Size="12" class="size-3" />
                        @selectedDay.Sunrise
                    </span>
                    <span class="text-muted-foreground/60">&middot;</span>
                    <span class="tabular-nums">@selectedDay.Sunset</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ForecastDay(string Id, string Day, string Date, string Condition, int High, int Low, int Wind, int Humidity, string Description, string Sunrise, string Sunset);

    private static readonly Dictionary<string, string> _conditionLabel = new()
    {
        ["clear"] = "Clear",
        ["partly-cloudy"] = "Partly Cloudy",
        ["cloudy"] = "Cloudy",
        ["rain"] = "Rain",
        ["drizzle"] = "Drizzle",
        ["snow"] = "Snow",
    };

    private static readonly ForecastDay[] _forecast =
    [
        new("1", "Today", "Mar 18", "partly-cloudy", 62, 45, 8, 55, "Partly cloudy skies throughout the day with light winds", "6:42 AM", "7:18 PM"),
        new("2", "Thu", "Mar 19", "clear", 68, 48, 5, 40, "Clear skies and mild temperatures, perfect for outdoor activities", "6:41 AM", "7:19 PM"),
        new("3", "Fri", "Mar 20", "clear", 71, 50, 6, 38, "Sunny and warm, the warmest day of the week", "6:39 AM", "7:20 PM"),
        new("4", "Sat", "Mar 21", "cloudy", 58, 44, 12, 65, "Overcast with increasing cloud cover, chance of evening rain", "6:38 AM", "7:21 PM"),
        new("5", "Sun", "Mar 22", "rain", 52, 41, 15, 80, "Steady rain expected throughout the day, bring an umbrella", "6:36 AM", "7:22 PM"),
        new("6", "Mon", "Mar 23", "drizzle", 54, 43, 10, 72, "Light drizzle in the morning, clearing by afternoon", "6:35 AM", "7:23 PM"),
        new("7", "Tue", "Mar 24", "partly-cloudy", 60, 46, 7, 50, "Mix of sun and clouds, temperatures returning to normal", "6:33 AM", "7:24 PM"),
    ];

    private string _selected = "1";
}
