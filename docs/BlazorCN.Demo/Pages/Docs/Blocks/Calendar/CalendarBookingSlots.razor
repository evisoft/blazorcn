@* ============================================================
   Block: calendar-booking-slots
   Title: Calendar Booking Slots
   Description: An appointment booking interface with date selection, available time slot grid, and booking confirmation built with React, Next.js, shadcn/ui Calendar component, and Tailwind CSS
   Long Description: React Birthday Tracker Calendar Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-booking-slots.tsx
   ============================================================ *@

@if (_confirmed)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex flex-col items-center px-4 py-12 text-center">
                <LucideCircleCheckCn Class="mb-3 size-8 text-emerald-500" />
                <span class="font-medium text-sm">Booking Confirmed</span>
                <span class="mt-1 text-muted-foreground text-xs">
                    @_bookingDates[_selectedDateIndex].DayLabel at @_selectedSlot
                </span>
                <span class="mt-0.5 text-muted-foreground text-xs">
                    30 min consultation with Dr. Emily Chen
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs"
                          OnClick="@(() => { _confirmed = false; _selectedSlot = null; })">
                    Book Another
                </ButtonCn>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideCalendarCn Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Book Appointment</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">30 min</BadgeCn>
            </div>

            @* Provider info *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                    <LucideUserCn Class="size-4 text-muted-foreground" />
                </div>
                <div>
                    <span class="font-medium text-sm">Dr. Emily Chen</span>
                    <span class="ml-2 text-muted-foreground text-xs">General Consultation</span>
                </div>
            </div>

            @* Date selector *@
            <div class="flex items-center border-b">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0"
                          OnClick="@(() => { _selectedDateIndex = Math.Max(0, _selectedDateIndex - 1); })">
                    <LucideChevronLeftCn Class="size-4" />
                </ButtonCn>
                <div class="flex flex-1 overflow-hidden">
                    @for (int i = 0; i < _bookingDates.Length; i++)
                    {
                        var index = i;
                        var bd = _bookingDates[i];
                        <button type="button"
                                @onclick="@(() => { _selectedDateIndex = index; _selectedSlot = null; })"
                                class="@($"flex-1 px-3 py-2 text-center transition-colors hover:bg-muted/50 {(index == _selectedDateIndex ? "bg-muted/50" : "")}")">
                            <span class="@($"block font-medium text-xs {(index == _selectedDateIndex ? "text-foreground" : "text-muted-foreground")}")">
                                @bd.DayLabel
                            </span>
                            <span class="mt-0.5 block text-muted-foreground text-xs tabular-nums">
                                @bd.Slots.Count(s => s.Available) available
                            </span>
                        </button>
                    }
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0"
                          OnClick="@(() => { _selectedDateIndex = Math.Min(_bookingDates.Length - 1, _selectedDateIndex + 1); })">
                    <LucideChevronRightCn Class="size-4" />
                </ButtonCn>
            </div>

            @* Time slots *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">@CurrentDate.DayLabel</span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @AvailableCount slot@(AvailableCount != 1 ? "s" : "") open
                    </span>
                </div>
                <div class="grid grid-cols-3 gap-2 sm:grid-cols-4">
                    @foreach (var slot in CurrentDate.Slots)
                    {
                        var slotTime = slot.Time;
                        <button type="button"
                                disabled="@(!slot.Available)"
                                @onclick="@(() => _selectedSlot = slotTime)"
                                class="@($"flex items-center justify-center gap-1.5 rounded-md border px-3 py-2 text-xs tabular-nums transition-colors {(!slot.Available ? "cursor-not-allowed border-transparent bg-muted/30 text-muted-foreground/40" : _selectedSlot == slotTime ? "border-foreground bg-foreground text-background" : "border-border hover:bg-muted/50")}")">
                            <LucideClockCn Class="size-3" />
                            @slot.Time
                        </button>
                    }
                </div>
            </div>

            @* Confirm *@
            <div class="flex items-center justify-between px-4 py-3">
                <div>
                    @if (_selectedSlot != null)
                    {
                        <span class="text-sm">
                            <span class="text-muted-foreground">Selected: </span>
                            <span class="font-medium">@_selectedSlot</span>
                        </span>
                    }
                    else
                    {
                        <span class="text-muted-foreground text-sm">Select a time slot</span>
                    }
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs"
                          Disabled="@(_selectedSlot == null)"
                          OnClick="@(() => _confirmed = true)">
                    Confirm Booking
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private int _selectedDateIndex;
    private string? _selectedSlot;
    private bool _confirmed;

    private record TimeSlot(string Time, bool Available);
    private record BookingDate(string Date, string DayLabel, TimeSlot[] Slots);

    private BookingDate CurrentDate => _bookingDates[_selectedDateIndex];
    private int AvailableCount => CurrentDate.Slots.Count(s => s.Available);

    private static readonly BookingDate[] _bookingDates =
    [
        new("2026-03-18", "Wed, Mar 18",
        [
            new("9:00 AM", true), new("9:30 AM", false), new("10:00 AM", true),
            new("10:30 AM", true), new("11:00 AM", false), new("11:30 AM", false),
            new("1:00 PM", true), new("1:30 PM", true), new("2:00 PM", true),
            new("2:30 PM", false), new("3:00 PM", true), new("3:30 PM", true),
        ]),
        new("2026-03-19", "Thu, Mar 19",
        [
            new("9:00 AM", true), new("9:30 AM", true), new("10:00 AM", false),
            new("10:30 AM", true), new("11:00 AM", true), new("11:30 AM", true),
            new("1:00 PM", false), new("1:30 PM", false), new("2:00 PM", true),
            new("2:30 PM", true), new("3:00 PM", true), new("3:30 PM", false),
        ]),
        new("2026-03-20", "Fri, Mar 20",
        [
            new("9:00 AM", false), new("9:30 AM", true), new("10:00 AM", true),
            new("10:30 AM", true), new("11:00 AM", true), new("11:30 AM", false),
            new("1:00 PM", true), new("1:30 PM", true), new("2:00 PM", false),
            new("2:30 PM", false), new("3:00 PM", true), new("3:30 PM", true),
        ]),
    ];
}
