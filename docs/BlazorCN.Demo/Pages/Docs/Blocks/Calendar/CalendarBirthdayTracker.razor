@* ============================================================
   Block: calendar-birthday-tracker
   Title: Calendar Birthday Tracker
   Description: React birthday and anniversary tracker calendar block for Next.js with upcoming celebrations list, month view grid, age and tenure display, and notification preferences using shadcn/ui and Tailwind CSS
   Long Description: Meeting scheduling with availability
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-birthday-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Celebrations</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_birthdayCount birthdays · @_anniversaryCount anniversaries
                </p>
            </div>
            <div class="flex items-center gap-1 rounded-full bg-muted p-0.5">
                <button type="button"
                        @onclick="@(() => _view = "list")"
                        class="@($"rounded-full px-2.5 py-1 text-xs transition-colors {(_view == "list" ? "bg-card shadow-sm" : "text-muted-foreground")}")">
                    List
                </button>
                <button type="button"
                        @onclick="@(() => _view = "month")"
                        class="@($"rounded-full px-2.5 py-1 text-xs transition-colors {(_view == "month" ? "bg-card shadow-sm" : "text-muted-foreground")}")">
                    Month
                </button>
            </div>
        </div>

        @if (_view == "list")
        {
            @* Next up highlight *@
            <div class="border-b bg-muted/20 px-4 py-3">
                <div class="flex items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-full bg-pink-500/10">
                        <LucideGiftCn Class="size-5 text-pink-600 dark:text-pink-400" />
                    </div>
                    <div class="flex-1">
                        <span class="font-medium text-sm">@_people[0].Name</span>
                        <p class="text-muted-foreground text-xs">
                            @GetTypeLabel(_people[0].Type) · @_people[0].Detail
                        </p>
                    </div>
                    <div class="text-right">
                        <span class="@($"font-medium text-sm tabular-nums {UrgencyColor(_people[0].DaysUntil)}")">
                            @UrgencyLabel(_people[0].DaysUntil)
                        </span>
                        <p class="text-muted-foreground text-xs">@_people[0].Date</p>
                    </div>
                </div>
            </div>

            @* This month *@
            @if (_thisMonth.Length > 1)
            {
                <div>
                    <div class="bg-muted/30 px-4 py-1.5">
                        <span class="text-muted-foreground text-xs">March 2026</span>
                    </div>
                    @for (int i = 0; i < _thisMonth.Length - 1; i++)
                    {
                        var person = _thisMonth[i + 1];
                        var isLast = i == _thisMonth.Length - 2 && _nextMonth.Length == 0;
                        <div class="@(isLast ? "" : "border-b")">
                            <div class="flex items-center gap-3 px-4 py-3">
                                <span class="@($"size-2 shrink-0 rounded-full {GetTypeDot(person.Type)}")" />
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                    @person.Initials
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">@person.Name</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">
                                        @GetTypeLabel(person.Type) · @person.Detail
                                    </p>
                                </div>
                                <div class="shrink-0 text-right">
                                    <span class="@($"text-xs tabular-nums {UrgencyColor(person.DaysUntil)}")">
                                        @UrgencyLabel(person.DaysUntil)
                                    </span>
                                    <p class="text-muted-foreground text-[10px]">@person.Date</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Next month *@
            @if (_nextMonth.Length > 0)
            {
                <div>
                    <div class="border-t bg-muted/30 px-4 py-1.5">
                        <span class="text-muted-foreground text-xs">April 2026</span>
                    </div>
                    @for (int i = 0; i < _nextMonth.Length; i++)
                    {
                        var person = _nextMonth[i];
                        var isLast = i == _nextMonth.Length - 1;
                        <div class="@(isLast ? "" : "border-b")">
                            <div class="flex items-center gap-3 px-4 py-3">
                                <span class="@($"size-2 shrink-0 rounded-full {GetTypeDot(person.Type)}")" />
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                    @person.Initials
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">@person.Name</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">
                                        @GetTypeLabel(person.Type) · @person.Detail
                                    </p>
                                </div>
                                <div class="shrink-0 text-right">
                                    <span class="@($"text-xs tabular-nums {UrgencyColor(person.DaysUntil)}")">
                                        @UrgencyLabel(person.DaysUntil)
                                    </span>
                                    <p class="text-muted-foreground text-[10px]">@person.Date</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @* Month view *@
            <div class="p-4">
                <div class="mb-3 flex items-center justify-between">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                        <LucideChevronLeftCn Class="size-4" />
                    </ButtonCn>
                    <span class="font-medium text-sm">March 2026</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                        <LucideChevronRightCn Class="size-4" />
                    </ButtonCn>
                </div>

                @* Day headers *@
                <div class="mb-1 grid grid-cols-7">
                    @foreach (var label in _dayLabels)
                    {
                        <div class="py-1 text-center text-muted-foreground text-xs">@label</div>
                    }
                </div>

                @* Calendar grid *@
                <div class="grid grid-cols-7 gap-px">
                    @for (int d = 1; d <= 31; d++)
                    {
                        var day = d;
                        var celebrations = GetCelebrations(day);
                        var isToday = day == 17;
                        <div class="@($"aspect-square rounded-md p-1 {(isToday ? "bg-primary/5 ring-1 ring-primary/20" : "")}")">
                            <span class="@($"block text-center text-xs tabular-nums {(isToday ? "font-medium" : "text-muted-foreground")}")">
                                @day
                            </span>
                            @if (celebrations.Length > 0)
                            {
                                <div class="mt-0.5 flex justify-center gap-0.5">
                                    @foreach (var c in celebrations)
                                    {
                                        <span class="@($"size-1.5 rounded-full {GetTypeDot(c.Type)}")"
                                              title="@($"{c.Name} — {GetTypeLabel(c.Type)}")" />
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-pink-500" />
                @_birthdayCount birthdays
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-violet-500" />
                @_anniversaryCount anniversaries
            </span>
        </div>
    </div>
</section>

@code {
    private string _view = "list";

    private record Person(string Id, string Name, string Initials, string Type, string Date, int DayOfMonth, int Month, string Detail, int DaysUntil);

    private static readonly Person[] _people =
    [
        new("p1", "Sarah Chen", "SC", "birthday", "Mar 19", 19, 3, "Turning 32", 1),
        new("p2", "Marcus Kim", "MK", "anniversary", "Mar 22", 22, 3, "3 years", 4),
        new("p3", "Elena Petrov", "EP", "birthday", "Mar 28", 28, 3, "Turning 29", 10),
        new("p4", "James Taylor", "JT", "anniversary", "Apr 2", 2, 4, "5 years", 15),
        new("p5", "Alex Rivera", "AR", "birthday", "Apr 8", 8, 4, "Turning 36", 21),
        new("p6", "Lina Nguyen", "LN", "anniversary", "Apr 14", 14, 4, "2 years", 27),
        new("p7", "Chris Park", "CP", "birthday", "Apr 20", 20, 4, "Turning 28", 33),
        new("p8", "Nina Ortiz", "NO", "birthday", "Mar 31", 31, 3, "Turning 34", 13),
    ];

    private static readonly Person[] _thisMonth = _people.Where(p => p.Month == 3).ToArray();
    private static readonly Person[] _nextMonth = _people.Where(p => p.Month == 4).ToArray();
    private static readonly int _birthdayCount = _people.Count(p => p.Type == "birthday");
    private static readonly int _anniversaryCount = _people.Count(p => p.Type == "anniversary");

    private static readonly string[] _dayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private record Celebration(string Name, string Type);

    private static readonly Dictionary<int, Celebration[]> _marchCelebrations = new()
    {
        [19] = [new("Sarah C.", "birthday")],
        [22] = [new("Marcus K.", "anniversary")],
        [28] = [new("Elena P.", "birthday")],
        [31] = [new("Nina O.", "birthday")],
    };

    private static Celebration[] GetCelebrations(int day) =>
        _marchCelebrations.TryGetValue(day, out var c) ? c : [];

    private static string GetTypeDot(string type) => type == "birthday" ? "bg-pink-500" : "bg-violet-500";
    private static string GetTypeLabel(string type) => type == "birthday" ? "Birthday" : "Anniversary";

    private static string UrgencyLabel(int days) => days switch
    {
        0 => "Today",
        1 => "Tomorrow",
        _ => $"In {days} days"
    };

    private static string UrgencyColor(int days) => days switch
    {
        <= 1 => "text-red-600 dark:text-red-400",
        <= 7 => "text-amber-600 dark:text-amber-400",
        _ => "text-muted-foreground"
    };
}
