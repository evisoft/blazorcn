@* ============================================================
   Block: calendar-on-call-rotation
   Title: Calendar On Call Rotation
   Description: On-call rotation calendar with escalation chain, swap requests, and weekly rotation schedule
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-on-call-rotation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">On-Call Rotation</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">Week 12</BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Currently on-call</span>
            <div class="flex items-center gap-3">
                <div class="relative flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    SC
                    <span class="absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full border-2 border-card bg-emerald-500"></span>
                </div>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Sarah Chen</span>
                    <p class="text-muted-foreground text-xs">SRE Lead · Since Mon, Mar 17</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="h-7 gap-1.5 text-xs">
                    <LucidePhoneCn Size="12" Class="size-3" />
                    Page
                </ButtonCn>
            </div>
        </div>

        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Escalation chain</span>
            </div>
            @for (var i = 0; i < _escalationChain.Length; i++)
            {
                var tier = _escalationChain[i];
                var isLast = i == _escalationChain.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="w-5 text-center font-mono text-muted-foreground text-xs tabular-nums">@(i + 1)</span>
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">@tier.Initials</div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@tier.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@tier.Tier</span>
                    </div>
                    <span class="text-muted-foreground text-xs">@tier.Timeout</span>
                </div>
            }
        </div>

        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Upcoming rotation</span>
            </div>
            @for (var i = 0; i < _rotation.Length; i++)
            {
                var slot = _rotation[i];
                var isLast = i == _rotation.Length - 1;
                var isExpanded = _expanded == slot.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : slot.Id" class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        @if (slot.IsCurrent)
                        {
                            <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
                        }
                        else if (slot.HasGap)
                        {
                            <LucideTriangleAlertCn Size="12" Class="size-3.5 shrink-0 text-amber-500" />
                        }
                        else
                        {
                            <span class="size-2 shrink-0 rounded-full bg-muted-foreground/30"></span>
                        }
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">@slot.Initials</div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@slot.Name</span>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">@slot.DateRange</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3 pl-14">
                            <div class="flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@slot.Role</span>
                                @if (slot.HasGap)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" class="font-normal text-xs text-amber-600 dark:text-amber-400">Swap requested</BadgeCn>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            <div class="flex items-center gap-1.5 px-4 py-2">
                <LucideArrowRightLeftCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Swap requests</span>
            </div>
            @for (var i = 0; i < _swaps.Length; i++)
            {
                var swap = _swaps[i];
                var isLast = i == _swaps.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-2">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">@swap.RequesterInitials</div>
                        <span class="text-sm">@swap.RequesterName</span>
                        <LucideChevronRightCn Size="12" Class="size-3 text-muted-foreground" />
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">@swap.TargetInitials</div>
                        <span class="text-sm">@swap.TargetName</span>
                    </div>
                    <p class="mt-1 pl-8 text-muted-foreground text-xs">@swap.Date · @swap.Reason</p>
                    @if (swap.Status == "pending")
                    {
                        <div class="mt-1 flex items-center gap-2 pl-8">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="h-6 gap-1 px-2 text-xs">
                                <LucideCheckCn Size="12" Class="size-3" />
                                Accept
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-6 gap-1 px-2 text-xs">
                                <LucideXCn Size="12" Class="size-3" />
                                Decline
                            </ButtonCn>
                        </div>
                    }
                    else
                    {
                        <div class="mt-1 pl-8">
                            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">@(swap.Status == "accepted" ? "Accepted" : "Declined")</BadgeCn>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record EscalationItem(string Name, string Initials, string Tier, string Timeout);
    private record RotationSlot(string Id, string Name, string Initials, string Role, string DateRange, bool IsCurrent, bool HasGap);
    private record SwapRequest(string RequesterName, string RequesterInitials, string TargetName, string TargetInitials, string Date, string Reason, string Status);

    private static readonly EscalationItem[] _escalationChain =
    [
        new("Sarah Chen", "SC", "Primary", "15 min"),
        new("Marcus Webb", "MW", "Secondary", "30 min"),
        new("Elena Rossi", "ER", "Manager", "1 hr"),
    ];

    private static readonly RotationSlot[] _rotation =
    [
        new("r1", "Sarah Chen", "SC", "SRE Lead", "Mar 17 - Mar 23", true, false),
        new("r2", "Marcus Webb", "MW", "Backend Engineer", "Mar 24 - Mar 30", false, true),
        new("r3", "James Park", "JP", "Platform Engineer", "Mar 31 - Apr 6", false, false),
        new("r4", "Elena Rossi", "ER", "Engineering Manager", "Apr 7 - Apr 13", false, false),
    ];

    private static readonly SwapRequest[] _swaps =
    [
        new("Marcus Webb", "MW", "James Park", "JP", "Mar 26", "Conference travel", "pending"),
        new("Elena Rossi", "ER", "Sarah Chen", "SC", "Apr 10", "Vacation", "accepted"),
    ];
}
