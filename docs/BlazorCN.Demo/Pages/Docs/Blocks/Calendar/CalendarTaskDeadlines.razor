@* ============================================================
   Block: calendar-task-deadlines
   Title: Calendar Task Deadlines
   Description: Task deadline list with priority indicators, overdue warnings, progress tracking, and assignee avatars
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-task-deadlines.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Task Deadlines</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_tasks.Length tasks · @OverdueCount overdue · @AtRiskCount at risk
                </p>
            </div>
            @if (OverdueCount > 0)
            {
                <div class="flex items-center gap-1.5 text-red-600 dark:text-red-400">
                    <LucideTriangleAlertCn Size="14" Class="size-3.5" />
                    <span class="text-xs tabular-nums">@OverdueCount overdue</span>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            @foreach (var f in _filterOptions)
            {
                var isActive = _filter == f.Key;
                <button type="button" @onclick="() => _filter = f.Key" class="@Cn.Merge("rounded-full px-2.5 py-1 text-xs transition-colors", isActive ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground hover:bg-muted/80")">
                    @f.Label
                    <span class="ml-1 tabular-nums">@f.Count</span>
                </button>
            }
        </div>

        <div>
            @{ var filtered = FilteredTasks; }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var task = filtered[i];
                var isLast = i == filtered.Length - 1;
                var isExpanded = _expanded == task.Id;
                var priorityDot = task.Priority switch { "high" => "bg-red-500", "medium" => "bg-amber-500", _ => "bg-blue-500" };
                var statusTextColor = task.Status switch { "on-track" => "text-emerald-600 dark:text-emerald-400", "at-risk" => "text-amber-600 dark:text-amber-400", "overdue" => "text-red-600 dark:text-red-400", _ => "text-muted-foreground" };
                var statusLabel = task.Status switch { "on-track" => "On track", "at-risk" => "At risk", "overdue" => "Overdue", _ => "Completed" };
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : task.Id" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", priorityDot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@task.Title</span>
                                @if (task.Status == "overdue")
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" class="shrink-0 bg-red-500/10 font-normal text-red-600 text-xs dark:text-red-400">Overdue</BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @task.Project · Due @task.DueDate
                            </p>
                        </div>
                        <span class="@Cn.Merge("shrink-0 text-xs tabular-nums", statusTextColor)">
                            @task.DueLabel
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            <div>
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Progress</span>
                                    <span class="font-medium text-xs tabular-nums">@task.Progress%</span>
                                </div>
                                <ProgressCn Value="@task.Progress" class="h-1.5" aria-label="Progress" />
                            </div>

                            <div class="flex items-center gap-4">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-muted-foreground text-xs">Assignee:</span>
                                    <div class="flex items-center gap-1">
                                        <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                                            @task.AssigneeInitials
                                        </span>
                                        <span class="text-xs">@task.Assignee</span>
                                    </div>
                                </div>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="@Cn.Merge("text-xs", statusTextColor)">@statusLabel</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                @HighCount high
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                @MediumCount medium
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                @LowCount low
            </span>
        </div>
    </div>
</section>

@code {
    private string _filter = "all";
    private string? _expanded = "t1";

    private int OverdueCount => _tasks.Count(t => t.Status == "overdue");
    private int AtRiskCount => _tasks.Count(t => t.Status == "at-risk");
    private int HighCount => _tasks.Count(t => t.Priority == "high");
    private int MediumCount => _tasks.Count(t => t.Priority == "medium");
    private int LowCount => _tasks.Count(t => t.Priority == "low");

    private TaskItem[] FilteredTasks => _filter == "all" ? _tasks : _tasks.Where(t => t.Priority == _filter).ToArray();

    private record FilterOption(string Key, string Label, int Count);

    private FilterOption[] _filterOptions => [
        new("all", "All", _tasks.Length),
        new("high", "High", HighCount),
        new("medium", "Medium", MediumCount),
        new("low", "Low", LowCount),
    ];

    private record TaskItem(string Id, string Title, string Project, string DueDate, string DueLabel, string Priority, string Status, int Progress, string Assignee, string AssigneeInitials);

    private static readonly TaskItem[] _tasks =
    [
        new("t1", "API rate limiting implementation", "Platform", "Mar 14", "3 days ago", "high", "overdue", 65, "Sarah Chen", "SC"),
        new("t2", "Payment webhook error handling", "Billing", "Mar 17", "Today", "high", "at-risk", 80, "Alex Rivera", "AR"),
        new("t3", "Dashboard redesign mockups", "Design", "Mar 18", "Tomorrow", "medium", "on-track", 45, "Elena Petrov", "EP"),
        new("t4", "Database migration script", "Platform", "Mar 20", "In 3 days", "high", "on-track", 30, "Marcus Kim", "MK"),
        new("t5", "User onboarding email sequence", "Marketing", "Mar 22", "In 5 days", "medium", "on-track", 10, "Lina Nguyen", "LN"),
        new("t6", "Update privacy policy page", "Legal", "Mar 25", "In 8 days", "low", "on-track", 0, "James Taylor", "JT"),
        new("t7", "SSO integration testing", "Platform", "Mar 12", "5 days ago", "medium", "overdue", 90, "Sarah Chen", "SC"),
        new("t8", "Mobile responsive audit", "Design", "Mar 28", "In 11 days", "low", "on-track", 5, "Elena Petrov", "EP"),
    ];
}
