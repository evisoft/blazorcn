@* ============================================================
   Block: calendar-recurring-events
   Title: Calendar Recurring Events
   Description: A recurring event configuration form with frequency selector, interval controls, end date options, and exception management built with React, Next.js, shadcn/ui Select, and Tailwind CSS
   Long Description: React Project Milestones Calendar Block
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn
   Source: original/blocks/calendar/calendar-recurring-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideRepeatCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Recurring Event</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                Every @(_interval > 1 ? $"{_interval} " : "")@_frequencyLabel
            </BadgeCn>
        </div>

        @* Event name *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Event</span>
            <span class="font-medium text-sm">Engineering Standup</span>
            <span class="ml-2 text-muted-foreground text-xs">9:00 AM - 9:15 AM</span>
        </div>

        @* Frequency and interval *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Repeat</span>
            <div class="flex items-center gap-2">
                <span class="text-sm">Every</span>
                <InputCn aria-label="Repeat interval" Type="number" Value="@_interval.ToString()" ValueChanged="@(v => _interval = Math.Max(1, int.TryParse(v, out var n) ? n : 1))" class="h-8 w-16 text-center text-sm tabular-nums" />
                <SelectCn Value="@_frequency" ValueChanged="@(v => _frequency = v)">
                    <SelectTriggerCn Size="ButtonSize.Sm" class="w-28" aria-label="Repeat frequency unit">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="daily">Day(s)</SelectItemCn>
                        <SelectItemCn Value="weekly">Week(s)</SelectItemCn>
                        <SelectItemCn Value="monthly">Month(s)</SelectItemCn>
                        <SelectItemCn Value="yearly">Year(s)</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Day selector (weekly only) *@
        @if (_frequency == "weekly")
        {
            <div class="border-b px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">On days</span>
                <div class="flex gap-1.5">
                    @foreach (var day in _days)
                    {
                        var isSelected = _selectedDays.Contains(day.Key);
                        <button
                            type="button"
                            @onclick="@(() => ToggleDay(day.Key))"
                            class="@Cn.Merge("flex size-8 items-center justify-center rounded-full text-xs transition-colors", isSelected ? "bg-foreground font-medium text-background" : "border border-border hover:bg-muted/50")">
                            @day.Label
                        </button>
                    }
                </div>
            </div>
        }

        @* End condition *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Ends</span>
            <div class="space-y-2">
                <label class="flex items-center gap-2">
                    <input type="radio" name="endType" checked="@(_endType == "never")" @onchange="@(() => _endType = "never")" class="size-3.5 accent-foreground" />
                    <span class="text-sm">Never</span>
                </label>
                <label class="flex items-center gap-2">
                    <input type="radio" name="endType" checked="@(_endType == "after")" @onchange="@(() => _endType = "after")" class="size-3.5 accent-foreground" />
                    <span class="text-sm">After</span>
                    <InputCn aria-label="Number of occurrences" Type="number" Value="@_endAfterCount.ToString()" ValueChanged="@(v => _endAfterCount = int.TryParse(v, out var n) ? n : 1)" disabled="@(_endType != "after")" class="h-7 w-16 text-center text-sm tabular-nums" />
                    <span class="text-muted-foreground text-sm">occurrences</span>
                </label>
                <label class="flex items-center gap-2">
                    <input type="radio" name="endType" checked="@(_endType == "on")" @onchange="@(() => _endType = "on")" class="size-3.5 accent-foreground" />
                    <span class="text-sm">On</span>
                    <InputCn Type="text" Value="@_endOnDate" ValueChanged="@(v => _endOnDate = v)" disabled="@(_endType != "on")" placeholder="YYYY-MM-DD" class="h-7 w-32 text-sm tabular-nums" />
                </label>
            </div>
        </div>

        @* Exceptions *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">
                    Exceptions (@_exceptions.Count)
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-6 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="12" class="size-3" />
                    Add
                </ButtonCn>
            </div>
            @if (_exceptions.Count == 0)
            {
                <span class="text-muted-foreground text-xs">No exceptions</span>
            }
            else
            {
                <div class="space-y-1">
                    @foreach (var exc in _exceptions)
                    {
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-1.5">
                            <span class="flex items-center gap-1.5 text-sm">
                                <LucideCalendarCn Size="12" class="size-3 text-muted-foreground" />
                                @exc
                            </span>
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @onclick="@(() => _exceptions.Remove(exc))" aria-label="Close">
                                <LucideXCn Size="14" class="size-3.5" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>

        @* Upcoming occurrences preview *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Next occurrences
            </span>
            <div class="space-y-1">
                @foreach (var occ in _upcomingOccurrences.Take(5))
                {
                    var isException = _exceptions.Any(exc => occ.Contains(exc.Split('-').Last()));
                    <div class="flex items-center gap-2 py-0.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", isException ? "bg-red-500" : "bg-emerald-500")"></span>
                        <span class="@Cn.Merge("text-xs", isException ? "text-muted-foreground line-through" : "")">
                            @occ
                        </span>
                        @if (isException)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                Skipped
                            </BadgeCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn
                Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Sm"
                class="h-7 gap-1 px-2 text-xs text-red-600 dark:text-red-400">
                <LucideTrashCn Size="12" class="size-3" />
                Delete Series
            </ButtonCn>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="h-7 text-xs">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" class="h-7 text-xs">
                    Save
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record DayInfo(string Key, string Label);

    private static readonly DayInfo[] _days =
    [
        new("MO", "M"), new("TU", "T"), new("WE", "W"), new("TH", "T"),
        new("FR", "F"), new("SA", "S"), new("SU", "S"),
    ];

    private static readonly string[] _upcomingOccurrences =
    [
        "Wed, Mar 18, 2026", "Fri, Mar 20, 2026", "Mon, Mar 23, 2026", "Wed, Mar 25, 2026",
        "Fri, Mar 27, 2026", "Mon, Mar 30, 2026", "Wed, Apr 1, 2026", "Fri, Apr 3, 2026",
    ];

    private string _frequency = "weekly";
    private int _interval = 1;
    private HashSet<string> _selectedDays = new(["MO", "WE", "FR"]);
    private string _endType = "after";
    private int _endAfterCount = 12;
    private string _endOnDate = "2026-06-30";
    private List<string> _exceptions = new(["2026-03-25", "2026-04-01"]);

    private string _frequencyLabel => _interval == 1
        ? _frequency switch { "daily" => "day", "weekly" => "week", "monthly" => "month", "yearly" => "year", _ => "" }
        : _frequency switch { "daily" => "days", "weekly" => "weeks", "monthly" => "months", "yearly" => "years", _ => "" };

    private void ToggleDay(string day)
    {
        if (!_selectedDays.Remove(day))
            _selectedDays.Add(day);
    }
}
