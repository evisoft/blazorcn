@* ============================================================
   Block: calendar-conference-agenda
   Title: CalendarConferenceAgenda
   Description: A conference multi-track agenda block for Next.js with parallel session tracks, speaker profiles, and room assignments using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-conference-agenda.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Conference Agenda</h2>
                <p class="text-muted-foreground text-xs">DevCon 2026 — Mar 22, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideMicCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_sessions.Length</span>
                <span class="text-muted-foreground text-xs">sessions</span>
            </div>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            <ButtonCn
                Variant="@(_activeTrack == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                Size="ButtonSize.Sm"
                class="h-6 px-2 text-xs"
                @onclick="@(() => _activeTrack = "all")">
                All Tracks
            </ButtonCn>
            @foreach (var entry in _trackConfig)
            {
                var key = entry.Key;
                var config = entry.Value;
                <ButtonCn
                    Variant="@(_activeTrack == key ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                    Size="ButtonSize.Sm"
                    class="h-6 gap-1 px-2 text-xs"
                    @onclick="@(() => _activeTrack = key)">
                    <span class="@Cn.Merge("size-1.5 rounded-full", config.Dot)"></span>
                    @config.Label
                </ButtonCn>
            }
        </div>

        <div>
            @for (var i = 0; i < FilteredSessions.Length; i++)
            {
                var index = i;
                var session = FilteredSessions[index];
                var track = _trackConfig[session.Track];
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", index < FilteredSessions.Length - 1 ? "border-b" : "")">
                    <span class="w-16 shrink-0 pt-0.5 font-mono text-muted-foreground text-xs tabular-nums">
                        @session.Time
                    </span>
                    <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", track.Dot)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@session.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs shrink-0">
                                @_typeLabels[session.Type]
                            </BadgeCn>
                        </div>
                        <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                            <span class="flex items-center gap-1">
                                <LucideMicCn Size="12" class="size-3" />
                                @session.Speaker
                            </span>
                            <span>·</span>
                            <span class="flex items-center gap-1">
                                <LucideMapPinCn Size="12" class="size-3" />
                                @session.Room
                            </span>
                            <span>·</span>
                            <span>@session.Duration</span>
                            <span>·</span>
                            <span class="flex items-center gap-1">
                                <LucideUsersCn Size="12" class="size-3" />
                                @session.Capacity
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Session(string Id, string Title, string Speaker, string Track, string Type, string Time, string Duration, string Room, int Capacity);
    private record TrackConfig(string Label, string Dot);

    private static readonly Session[] _sessions =
    [
        new("1",  "Opening Keynote: The Future of Web",  "Dr. Lisa Park",     "main",      "keynote",   "9:00 AM",  "45 min", "Grand Hall", 500),
        new("2",  "Advanced React Patterns",              "Alex Chen",         "main",      "talk",      "10:00 AM", "30 min", "Grand Hall", 500),
        new("3",  "Building Design Systems",              "Maya Johnson",      "workshops", "workshop",  "10:00 AM", "2 hr",   "Room 201",   40),
        new("4",  "5 Tips for Better TypeScript",         "Ryan Cole",         "lightning", "lightning", "10:00 AM", "10 min", "Room 105",   80),
        new("5",  "CSS Architecture at Scale",            "Nora Fischer",      "lightning", "lightning", "10:15 AM", "10 min", "Room 105",   80),
        new("6",  "State Management Panel",               "Multiple Speakers", "main",      "panel",     "11:00 AM", "45 min", "Grand Hall", 500),
        new("7",  "Performance Optimization Lab",         "Kai Nakamura",      "workshops", "workshop",  "1:00 PM",  "2 hr",   "Room 201",   40),
        new("8",  "Serverless Edge Functions",            "Emma Wright",       "main",      "talk",      "1:00 PM",  "30 min", "Grand Hall", 500),
        new("9",  "Accessibility Deep Dive",              "Sam Torres",        "main",      "talk",      "2:00 PM",  "30 min", "Grand Hall", 500),
        new("10", "Closing Keynote: AI in Dev Tools",     "Prof. James Lee",   "main",      "keynote",   "4:00 PM",  "45 min", "Grand Hall", 500),
    ];

    private static readonly Dictionary<string, TrackConfig> _trackConfig = new()
    {
        ["main"]      = new("Main Stage", "bg-blue-500"),
        ["workshops"] = new("Workshops",  "bg-emerald-500"),
        ["lightning"] = new("Lightning",  "bg-amber-500"),
    };

    private static readonly Dictionary<string, string> _typeLabels = new()
    {
        ["talk"]      = "Talk",
        ["workshop"]  = "Workshop",
        ["panel"]     = "Panel",
        ["keynote"]   = "Keynote",
        ["lightning"] = "Lightning",
    };

    private string _activeTrack = "all";

    private Session[] FilteredSessions => _activeTrack == "all"
        ? _sessions
        : _sessions.Where(s => s.Track == _activeTrack).ToArray();
}
