@* ============================================================
   Block: calendar-inventory-restock
   Title: Calendar Inventory Restock
   Description: A React inventory restock schedule block for Next.js with product names, restock quantities, supplier details, ETA tracking, and stock level alerts built with shadcn/ui and Tailwind CSS
   Long Description: React Interview Scheduler Calendar Block
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-inventory-restock.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePackageCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Restock Schedule</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500" />
                    @_criticalCount critical
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500" />
                    @_inTransitCount in transit
                </span>
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@_pendingCount</span>
                <span class="text-muted-foreground text-xs">pending orders</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @FormatCurrency(_totalOrderValue) total value
            </span>
        </div>

        @* Order list *@
        <div>
            @for (int i = 0; i < _orders.Length; i++)
            {
                var order = _orders[i];
                var isExpanded = _expanded == order.Id;
                var isLast = i == _orders.Length - 1;
                var stockPercent = (int)Math.Round((double)order.CurrentStock / order.MaxStock * 100);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == order.Id ? null : order.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {GetStatusDot(order.Status)}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@order.Product</span>
                                @if (order.StockLevel == "critical")
                                {
                                    <span class="size-1.5 rounded-full bg-red-500" />
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="font-mono">@order.Sku</span>
                                <span>·</span>
                                <span>ETA @order.Eta</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <span class="font-medium text-sm tabular-nums">@order.CurrentStock</span>
                                <span class="text-muted-foreground text-xs">/@order.MaxStock</span>
                            </div>
                            <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="flex flex-col gap-3">
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="text-muted-foreground">Current stock</span>
                                        <span class="font-medium tabular-nums">@stockPercent%</span>
                                    </div>
                                    <ProgressCn Value="@stockPercent" Class="h-1.5" aria-label="Progress" />
                                </div>

                                <div class="flex items-center gap-3 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1.5">
                                        <LucideTruckCn Class="size-3" />
                                        @order.Supplier
                                    </span>
                                    <span>·</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @GetStatusLabel(order.Status)
                                    </BadgeCn>
                                </div>

                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="font-medium text-muted-foreground text-xs">Order details</span>
                                    <div class="mt-2 flex flex-col gap-1.5 text-sm">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Restock quantity</span>
                                            <span class="tabular-nums">@order.RestockQty units</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Unit cost</span>
                                            <span class="tabular-nums">@FormatCurrency(order.UnitCost)</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Order total</span>
                                            <span class="font-medium tabular-nums">@FormatCurrency(order.RestockQty * order.UnitCost)</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Ordered</span>
                                            <span>@order.OrderDate</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record RestockOrder(string Id, string Product, string Sku, int CurrentStock, int MaxStock, int RestockQty, string Supplier, string OrderDate, string Eta, string Status, string StockLevel, decimal UnitCost);

    private static readonly RestockOrder[] _orders =
    [
        new("1", "Wireless Keyboard", "KB-2200", 12, 200, 150, "TechParts Inc.", "Mar 10", "Mar 20", "in-transit", "critical", 24.50m),
        new("2", "USB-C Hub Adapter", "HB-4401", 8, 150, 120, "ConnectPro Supply", "Mar 12", "Mar 22", "in-transit", "critical", 18.75m),
        new("3", "LED Monitor 27\"", "MN-2700", 35, 120, 80, "DisplayWorld", "Mar 14", "Mar 28", "ordered", "low", 189.00m),
        new("4", "Ergonomic Mouse", "MS-1100", 45, 300, 200, "TechParts Inc.", "Mar 8", "Mar 19", "delayed", "low", 32.00m),
        new("5", "Webcam HD 1080p", "WC-1080", 92, 250, 100, "VisionTech Co.", "Mar 6", "Mar 16", "delivered", "healthy", 42.50m),
        new("6", "Noise-Canceling Headset", "HS-3300", 18, 100, 75, "AudioGear Ltd.", "Mar 15", "Mar 30", "ordered", "low", 65.00m),
        new("7", "Laptop Stand", "LS-5500", 5, 80, 60, "ErgoDesk Supply", "Mar 16", "Apr 1", "ordered", "critical", 28.00m),
    ];

    private static readonly int _criticalCount = _orders.Count(o => o.StockLevel == "critical");
    private static readonly int _inTransitCount = _orders.Count(o => o.Status == "in-transit");
    private static readonly int _pendingCount = _orders.Count(o => o.Status != "delivered");
    private static readonly decimal _totalOrderValue = _orders.Where(o => o.Status != "delivered").Sum(o => o.RestockQty * o.UnitCost);

    private static string FormatCurrency(decimal amount) => $"${amount:N2}";

    private static string GetStatusDot(string status) => status switch
    {
        "in-transit" => "bg-blue-500",
        "ordered" => "bg-amber-500",
        "delivered" => "bg-emerald-500",
        "delayed" => "bg-red-500",
        _ => "bg-zinc-400"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "in-transit" => "In Transit",
        "ordered" => "Ordered",
        "delivered" => "Delivered",
        "delayed" => "Delayed",
        _ => status
    };
}
