@* ============================================================
   Block: calendar-court-booking
   Title: Calendar Court Booking
   Description: React sports court and facility booking calendar block for Next.js with court selection, hourly time slots, duration options, and pricing display using shadcn/ui and Tailwind CSS
   Long Description: React Event Countdown Calendar Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-court-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Court Booking</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Select a court and time slot</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                Wed, Mar 18
            </BadgeCn>
        </div>

        <div class="flex">
            @* Court list *@
            <div class="w-48 shrink-0 border-r">
                <div class="px-3 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Courts</span>
                </div>
                @for (var i = 0; i < _courts.Length; i++)
                {
                    var court = _courts[i];
                    var isSelected = _selectedCourt == court.Id;
                    <button
                        type="button"
                        @onclick="@(() => _selectedCourt = court.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-2 border-b px-3 py-2.5 text-left transition-colors hover:bg-muted/50 last:border-b-0", isSelected ? "bg-muted/50" : "")">
                        <span class="@Cn.Merge("size-2 rounded-full", court.StatusDot)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate font-medium text-xs">@court.Name</span>
                            <span class="text-muted-foreground text-[10px]">@court.Type · @court.Surface</span>
                        </div>
                    </button>
                }
            </div>

            @* Time slots *@
            <div class="flex-1">
                @{
                    var activeCourt = _courts.FirstOrDefault(c => c.Id == _selectedCourt);
                }
                @if (activeCourt != null)
                {
                    <div class="flex items-center justify-between border-b px-4 py-2">
                        <span class="font-medium text-sm">@activeCourt.Name</span>
                        <span class="text-muted-foreground text-xs">$@(activeCourt.PricePerHour)/hr</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2 p-4">
                        @foreach (var slot in _timeSlots)
                        {
                            var isBooked = activeCourt.BookedSlots.Contains(slot);
                            var isChosen = _selectedSlot == slot && _selectedCourt == activeCourt.Id;
                            <button
                                type="button"
                                disabled="@isBooked"
                                @onclick="@(() => _selectedSlot = isChosen ? "" : slot)"
                                class="@Cn.Merge("rounded-md border px-3 py-2 text-center text-xs transition-colors", isBooked ? "cursor-not-allowed bg-muted/30 text-muted-foreground/50" : isChosen ? "border-primary bg-primary/5 font-medium" : "hover:bg-muted/50")">
                                <span class="tabular-nums">@slot</span>
                                @if (isBooked)
                                {
                                    <span class="block text-[10px] text-muted-foreground/50">Booked</span>
                                }
                            </button>
                        }
                    </div>
                }

                @* Booking summary *@
                @if (!string.IsNullOrEmpty(_selectedSlot) && activeCourt != null)
                {
                    <div class="border-t px-4 py-3">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="font-medium text-sm">@activeCourt.Name · @_selectedSlot</span>
                                <p class="text-muted-foreground text-xs">1 hour · $@activeCourt.PricePerHour</p>
                            </div>
                            <ButtonCn Size="ButtonSize.Sm" class="h-7 text-xs">
                                Book Now
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CourtInfo(string Id, string Name, string Type, string Surface, string StatusDot, int PricePerHour, HashSet<string> BookedSlots);

    private static readonly string[] _timeSlots =
    [
        "8:00 AM", "9:00 AM", "10:00 AM", "11:00 AM", "12:00 PM",
        "1:00 PM", "2:00 PM", "3:00 PM", "4:00 PM", "5:00 PM",
        "6:00 PM", "7:00 PM",
    ];

    private static readonly CourtInfo[] _courts =
    [
        new("c1", "Court 1", "Tennis", "Hard", "bg-emerald-500", 40, new(["9:00 AM", "10:00 AM", "2:00 PM"])),
        new("c2", "Court 2", "Tennis", "Clay", "bg-emerald-500", 45, new(["11:00 AM", "3:00 PM"])),
        new("c3", "Court 3", "Badminton", "Wood", "bg-amber-500", 25, new(["8:00 AM", "9:00 AM", "10:00 AM", "11:00 AM"])),
        new("c4", "Court 4", "Squash", "Hardwood", "bg-emerald-500", 30, new(["1:00 PM"])),
        new("c5", "Court 5", "Basketball", "Indoor", "bg-red-500", 60, new(["8:00 AM", "9:00 AM", "10:00 AM", "11:00 AM", "12:00 PM", "1:00 PM", "2:00 PM", "3:00 PM", "4:00 PM", "5:00 PM", "6:00 PM", "7:00 PM"])),
    ];

    private string _selectedCourt = "c1";
    private string _selectedSlot = "";
}
