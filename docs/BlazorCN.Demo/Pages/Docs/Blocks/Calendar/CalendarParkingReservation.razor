@* ============================================================
   Block: calendar-parking-reservation
   Title: CalendarParkingReservation
   Description: A parking spot reservation calendar block for Next.js with floor maps, spot selection, time slots, and vehicle assignment using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-parking-reservation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="car" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Parking Reservation</span>
                    <p class="text-muted-foreground text-xs">Tuesday, Mar 24, 2026</p>
                </div>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_spots.Count(s => s.Status == "available")) available
            </span>
        </div>

        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var floor in _floors)
            {
                var f = floor;
                <button
                    type="button"
                    @onclick="@(() => _selectedFloor = f)"
                    class="@Cn.Merge("rounded-md px-3 py-1 text-xs transition-colors", _selectedFloor == f ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted/50")">
                    Floor @f
                </button>
            }
        </div>

        <div>
            @{
                var filtered = _spots.Where(s => s.Floor == _selectedFloor).ToList();
            }
            @for (var i = 0; i < filtered.Count; i++)
            {
                var spot = filtered[i];
                var isLast = i == filtered.Count - 1;
                var isExpanded = _expanded == spot.Id;
                var config = _spotTypeConfig[spot.Type];
                <div class="@(!isLast ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (_expanded == spot.Id ? "" : spot.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-medium text-sm">@spot.Spot</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @config.Label
                                </BadgeCn>
                            </div>
                            <span class="mt-0.5 flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                @spot.Time
                            </span>
                        </div>
                        <span class="@Cn.Merge("text-xs font-medium capitalize", _statusConfig[spot.Status])">
                            @spot.Status
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        var parts = spot.Spot.Split('-');
                        var sectionChar = parts.Length > 1 && parts[1].Length > 0 ? parts[1][0].ToString() : "";
                        <div class="border-t px-4 pb-3 pt-2">
                            <div class="flex flex-col gap-1.5">
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                    Floor @spot.Floor, Section @sectionChar
                                </span>
                                @if (!string.IsNullOrEmpty(spot.Vehicle))
                                {
                                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideIconCn Name="car" Size="12" Class="size-3" />
                                        @spot.Vehicle
                                    </span>
                                }
                            </div>
                            @if (spot.Status == "available")
                            {
                                var spotId = spot.Id;
                                <div class="mt-3">
                                    <ButtonCn Size="ButtonSize.Sm" class="h-7 text-xs" OnClick="@(() => ReserveSpot(spotId))">
                                        Reserve Spot
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _spotTypeConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Value.Dot)"></span>
                    @entry.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record SpotTypeInfo(string Dot, string Label);

    private record ParkingSpot(string Id, string Spot, string Floor, string Type, string Status, string Time, string? Vehicle = null)
    {
        public string Status { get; set; } = Status;
        public string? Vehicle { get; set; } = Vehicle;
    }

    private static readonly Dictionary<string, SpotTypeInfo> _spotTypeConfig = new()
    {
        ["standard"]   = new("bg-blue-500", "Standard"),
        ["compact"]    = new("bg-violet-500", "Compact"),
        ["ev"]         = new("bg-emerald-500", "EV Charging"),
        ["accessible"] = new("bg-amber-500", "Accessible"),
    };

    private static readonly Dictionary<string, string> _statusConfig = new()
    {
        ["available"] = "text-emerald-600 dark:text-emerald-400",
        ["reserved"]  = "text-amber-600 dark:text-amber-400",
        ["occupied"]  = "text-red-600 dark:text-red-400",
    };

    private static readonly string[] _floors = ["B1", "B2", "B3"];

    private List<ParkingSpot> _spots =
    [
        new("1", "B1-A04", "B1", "standard",   "available", "8:00 AM - 6:00 PM"),
        new("2", "B1-A07", "B1", "ev",          "available", "8:00 AM - 6:00 PM"),
        new("3", "B1-B02", "B1", "compact",     "reserved",  "9:00 AM - 5:00 PM",  "Toyota Camry"),
        new("4", "B2-A01", "B2", "accessible",  "available", "All day"),
        new("5", "B2-C05", "B2", "standard",    "occupied",  "7:30 AM - 4:00 PM",  "Honda Civic"),
        new("6", "B2-C08", "B2", "ev",          "available", "8:00 AM - 6:00 PM"),
        new("7", "B3-A03", "B3", "standard",    "available", "8:00 AM - 6:00 PM"),
        new("8", "B3-B06", "B3", "compact",     "reserved",  "10:00 AM - 3:00 PM", "Tesla Model 3"),
    ];

    private string _selectedFloor = "B1";
    private string _expanded = "1";

    private void ReserveSpot(string id)
    {
        var spot = _spots.FirstOrDefault(s => s.Id == id);
        if (spot is not null)
        {
            spot.Status = "reserved";
            spot.Vehicle = "Your Vehicle";
        }
    }
}
