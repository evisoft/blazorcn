@* ============================================================
   Block: calendar-editorial-calendar
   Title: Calendar Editorial Calendar
   Description: React editorial content calendar block for Next.js with article status tracking, author assignments, category columns, and publishing schedule built with shadcn/ui and Tailwind CSS
   Long Description: React Doctor Appointments Calendar Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-editorial-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideFileTextCn Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Editorial Calendar</span>
                </div>
                <span class="text-muted-foreground text-xs">March - April 2026</span>
            </div>
        </div>

        @* Filters *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            <LucideFunnelCn Class="mr-1 size-3 text-muted-foreground" />
            <button type="button"
                    @onclick="@(() => _activeFilter = "all")"
                    class="@($"rounded-full px-2.5 py-1 text-xs transition-colors {(_activeFilter == "all" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")}")">
                All (@_articles.Length)
            </button>
            @foreach (var status in _statusFilters)
            {
                var s = status;
                var config = GetStatusConfig(s);
                var count = _articles.Count(a => a.Status == s);
                <button type="button"
                        @onclick="@(() => _activeFilter = s)"
                        class="@($"flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs transition-colors {(_activeFilter == s ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")}")">
                    <span class="@($"size-1.5 rounded-full {config.Dot}")" />
                    @config.Label (@count)
                </button>
            }
        </div>

        @* Article list *@
        <div>
            @{ var filtered = _activeFilter == "all" ? _articles : _articles.Where(a => a.Status == _activeFilter).ToArray(); }
            @for (int i = 0; i < filtered.Length; i++)
            {
                var article = filtered[i];
                var isExpanded = _expanded == article.Id;
                var isLast = i == filtered.Length - 1;
                var status = GetStatusConfig(article.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == article.Id ? null : article.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {status.Dot}")" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@article.Title</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@article.Author</span>
                                <span>·</span>
                                <span class="tabular-nums">@article.PublishDate</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary"
                                 Class="@($"shrink-0 border-0 font-normal text-xs {GetCategoryColor(article.Category)}")">
                            @article.Category
                        </BadgeCn>
                        <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pl-9 pt-3">
                            <div class="flex items-center gap-4">
                                <div class="flex items-center gap-2">
                                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                        @article.AuthorInitials
                                    </div>
                                    <span class="text-xs">@article.Author</span>
                                </div>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @article.WordCount.ToString("N0") words
                                </span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-6 gap-1 px-2 text-xs">
                                    <LucidePencilCn Class="size-3" />
                                    Edit
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _activeFilter = "all";
    private string? _expanded;

    private record Article(string Id, string Title, string Author, string AuthorInitials, string Status, string Category, string PublishDate, int WordCount);
    private record StatusConfig(string Label, string Dot);

    private static readonly string[] _statusFilters = ["draft", "review", "scheduled", "published"];

    private static readonly Article[] _articles =
    [
        new("a1", "Building Accessible React Components", "Sarah Chen", "SC", "published", "Engineering", "Mar 12", 2400),
        new("a2", "Our Design System Migration Story", "Marcus Johnson", "MJ", "published", "Design", "Mar 14", 1800),
        new("a3", "Q2 Product Roadmap Highlights", "Elena Rodriguez", "ER", "review", "Product", "Mar 21", 1200),
        new("a4", "Scaling Postgres to 10M Rows", "David Kim", "DK", "review", "Engineering", "Mar 24", 3100),
        new("a5", "How We Redesigned Our Onboarding", "Priya Patel", "PP", "scheduled", "Design", "Mar 28", 2000),
        new("a6", "Content Marketing in 2026", "James Wilson", "JW", "scheduled", "Marketing", "Apr 1", 1600),
        new("a7", "Why We Switched to Bun", "Sarah Chen", "SC", "draft", "Engineering", "Apr 4", 800),
        new("a8", "A Day in the Life of Our Support Team", "Aisha Thompson", "AT", "draft", "Culture", "Apr 7", 450),
    ];

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "draft" => new("Draft", "bg-muted-foreground/30"),
        "review" => new("In review", "bg-amber-500"),
        "scheduled" => new("Scheduled", "bg-blue-500"),
        "published" => new("Published", "bg-emerald-500"),
        _ => new(status, "bg-zinc-400")
    };

    private static string GetCategoryColor(string category) => category switch
    {
        "Engineering" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Product" => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        "Design" => "bg-pink-500/10 text-pink-700 dark:text-pink-400",
        "Marketing" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "Culture" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _ => ""
    };
}
