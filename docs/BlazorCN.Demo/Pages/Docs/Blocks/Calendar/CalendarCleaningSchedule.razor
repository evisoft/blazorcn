@* ============================================================
   Block: calendar-cleaning-schedule
   Title: CalendarCleaningSchedule
   Description: A cleaning and maintenance rotation schedule block for Next.js with assignee tracking, task checklists, and room-by-room organization using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-cleaning-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Cleaning Schedule</h2>
                <p class="text-muted-foreground text-xs">Week of Mar 17, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@CompletedTasks/@TotalTasks</span>
                <span class="text-muted-foreground text-xs">tasks done</span>
            </div>
        </div>

        <div>
            @for (int si = 0; si < _slots.Count; si++)
            {
                var slot = _slots[si];
                var slotIndex = si;
                var isExpanded = _expandedSlot == slot.Id;
                var doneCount = slot.Tasks.Count(t => t.Completed);
                var allDone = doneCount == slot.Tasks.Count;

                <div class="@(slotIndex < _slots.Count - 1 ? "border-b" : "")">
                    <button type="button"
                            @onclick="@(() => _expandedSlot = _expandedSlot == slot.Id ? "" : slot.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (allDone)
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="circle" Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@slot.Area</span>
                                <span class="text-muted-foreground text-xs">@slot.Day</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="user" Size="12" Class="size-3" />
                                @slot.Assignee
                            </div>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">@doneCount/@slot.Tasks.Count</span>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-1">
                            @foreach (var taskItem in slot.Tasks)
                            {
                                var task = taskItem;
                                <span class="flex cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50"
                                      @onclick="@(() => ToggleTask(slot.Id, task.Id))">
                                    @if (task.Completed)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-500 cursor-pointer" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="circle" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40 cursor-pointer" />
                                    }
                                    <span class="@($"text-sm {(task.Completed ? "text-muted-foreground line-through" : "")}")">@task.TaskText</span>
                                </span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _expandedSlot = "1";

    private class CleaningTask
    {
        public string Id { get; init; } = "";
        public string TaskText { get; init; } = "";
        public bool Completed { get; set; }
    }

    private class CleaningSlot
    {
        public string Id { get; init; } = "";
        public string Area { get; init; } = "";
        public string Assignee { get; init; } = "";
        public string Day { get; init; } = "";
        public List<CleaningTask> Tasks { get; init; } = new();
    }

    private List<CleaningSlot> _slots =
    [
        new() { Id = "1", Area = "Kitchen", Assignee = "Alice M.", Day = "Monday", Tasks =
        [
            new() { Id = "t1", TaskText = "Wipe counters and stovetop", Completed = true },
            new() { Id = "t2", TaskText = "Clean sink and faucet", Completed = true },
            new() { Id = "t3", TaskText = "Mop floor", Completed = false },
            new() { Id = "t4", TaskText = "Empty trash bins", Completed = true },
        ]},
        new() { Id = "2", Area = "Conference Room A", Assignee = "Bob K.", Day = "Monday", Tasks =
        [
            new() { Id = "t5", TaskText = "Vacuum carpet", Completed = true },
            new() { Id = "t6", TaskText = "Wipe whiteboard", Completed = true },
            new() { Id = "t7", TaskText = "Clean table surfaces", Completed = true },
        ]},
        new() { Id = "3", Area = "Restrooms", Assignee = "Carol D.", Day = "Tuesday", Tasks =
        [
            new() { Id = "t8", TaskText = "Sanitize all surfaces", Completed = false },
            new() { Id = "t9", TaskText = "Restock supplies", Completed = false },
            new() { Id = "t10", TaskText = "Mop floors", Completed = false },
            new() { Id = "t11", TaskText = "Clean mirrors", Completed = false },
        ]},
        new() { Id = "4", Area = "Open Office", Assignee = "David L.", Day = "Tuesday", Tasks =
        [
            new() { Id = "t12", TaskText = "Vacuum all aisles", Completed = false },
            new() { Id = "t13", TaskText = "Dust monitors and desks", Completed = false },
            new() { Id = "t14", TaskText = "Empty recycling bins", Completed = false },
        ]},
        new() { Id = "5", Area = "Lobby", Assignee = "Alice M.", Day = "Wednesday", Tasks =
        [
            new() { Id = "t15", TaskText = "Mop entrance floor", Completed = false },
            new() { Id = "t16", TaskText = "Clean glass doors", Completed = false },
            new() { Id = "t17", TaskText = "Water plants", Completed = false },
        ]},
        new() { Id = "6", Area = "Break Room", Assignee = "Bob K.", Day = "Thursday", Tasks =
        [
            new() { Id = "t18", TaskText = "Clean microwave and fridge", Completed = false },
            new() { Id = "t19", TaskText = "Wipe tables and chairs", Completed = false },
            new() { Id = "t20", TaskText = "Restock coffee supplies", Completed = false },
        ]},
    ];

    private int TotalTasks => _slots.Sum(s => s.Tasks.Count);
    private int CompletedTasks => _slots.Sum(s => s.Tasks.Count(t => t.Completed));

    private void ToggleTask(string slotId, string taskId)
    {
        var slot = _slots.First(s => s.Id == slotId);
        var task = slot.Tasks.First(t => t.Id == taskId);
        task.Completed = !task.Completed;
    }
}
