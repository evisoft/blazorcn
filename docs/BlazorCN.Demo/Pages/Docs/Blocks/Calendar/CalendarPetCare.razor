@* ============================================================
   Block: calendar-pet-care
   Title: CalendarPetCare
   Description: A pet care schedule calendar block for Next.js with feeding times, vet appointments, grooming sessions, and medication reminders using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-pet-care.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHeartPulseCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Pet Care Schedule</span>
                    <p class="text-muted-foreground text-xs">Tuesday, Mar 24, 2026</p>
                </div>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completed/@_tasks.Count done
            </span>
        </div>

        @* Pet filter tabs *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var petName in _pets)
            {
                var p = petName;
                <button
                    type="button"
                    @onclick="@(() => _filter = p)"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs transition-colors", _filter == p ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted/50")">
                    @if (p == "all")
                    {
                        <LucidePawPrintCn Size="12" class="size-3" />
                    }
                    @(p == "all" ? "All" : p)
                </button>
            }
        </div>

        @* Task list *@
        <div class="divide-y">
            @foreach (var task in _filtered)
            {
                var t = task;
                var config = _taskConfig[t.Type];
                <div>
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <button type="button" @onclick="@(() => ToggleTask(t.Id))" class="shrink-0">
                            @if (t.Completed)
                            {
                                <LucideCheckCircle2Cn Size="16" class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideCircleCn Size="16" class="size-4 text-muted-foreground/40" />
                            }
                        </button>
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", t.Completed ? "text-muted-foreground line-through" : "")">
                                    @t.Task
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @t.Pet
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">@t.Notes</p>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @t.Time
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _taskConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Value.Dot)"></span>
                    @entry.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record PetTask(string Id, string Pet, string PetEmoji, string Task, string Type, string Time, bool Completed, string Notes);
    private record TaskConfig(string Dot, string Label);

    private static readonly Dictionary<string, TaskConfig> _taskConfig = new()
    {
        ["feeding"]    = new("bg-amber-500", "Feeding"),
        ["medication"] = new("bg-red-500", "Medication"),
        ["grooming"]   = new("bg-violet-500", "Grooming"),
        ["vet"]        = new("bg-blue-500", "Vet Visit"),
        ["walk"]       = new("bg-emerald-500", "Walk"),
    };

    private static readonly PetTask[] _initialTasks =
    [
        new("1",  "Max",  "D", "Morning feeding",   "feeding",    "7:00 AM",  true,  "1 cup kibble + joint supplement"),
        new("2",  "Max",  "D", "Morning walk",      "walk",       "7:30 AM",  true,  "30 min around the park"),
        new("3",  "Luna", "C", "Breakfast",          "feeding",    "8:00 AM",  true,  "Half can wet food"),
        new("4",  "Max",  "D", "Heartworm pill",    "medication", "9:00 AM",  false, "Monthly dose - hide in peanut butter"),
        new("5",  "Luna", "C", "Brushing session",   "grooming",   "11:00 AM", false, "Long-hair deshedding brush, 15 min"),
        new("6",  "Max",  "D", "Afternoon walk",    "walk",       "12:30 PM", false, "20 min, avoid hot pavement"),
        new("7",  "Max",  "D", "Vet checkup",       "vet",        "3:00 PM",  false, "Annual wellness exam at Downtown Vet Clinic"),
        new("8",  "Luna", "C", "Dinner",             "feeding",    "5:30 PM",  false, "Half can wet food + dental treats"),
        new("9",  "Max",  "D", "Evening feeding",   "feeding",    "6:00 PM",  false, "1 cup kibble"),
        new("10", "Max",  "D", "Evening walk",      "walk",       "7:00 PM",  false, "15 min, quick loop around block"),
    ];

    private static readonly string[] _pets =
        ["all", .. _initialTasks.Select(t => t.Pet).Distinct().ToArray()];

    private List<PetTask> _tasks = [.. _initialTasks];
    private string _filter = "all";

    private List<PetTask> _filtered => _filter == "all"
        ? _tasks
        : _tasks.Where(t => t.Pet == _filter).ToList();

    private int _completed => _tasks.Count(t => t.Completed);

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }
}
