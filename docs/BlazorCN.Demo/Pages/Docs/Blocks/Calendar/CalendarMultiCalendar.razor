@* ============================================================
   Block: calendar-multi-calendar
   Title: CalendarMultiCalendar
   Description: A multiple calendar overlay block for Next.js with layered calendar views, toggle visibility, and merged event display using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-multi-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Multi-Calendar</h2>
                <p class="text-muted-foreground text-xs">Merged View</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideLayersCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@TotalEvents</span>
                <span class="text-muted-foreground text-xs">events</span>
            </div>
        </div>

        @* Calendar toggles *@
        <div class="flex flex-wrap gap-2 border-b px-4 py-2.5">
            @foreach (var cal in _calendars)
            {
                var calendar = cal;
                var isVisible = _visibleCalendars.Contains(calendar.Id);
                <button
                    type="button"
                    @onclick="@(() => ToggleCalendar(calendar.Id))"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-all", isVisible ? "bg-muted/50" : "opacity-40")">
                    <span class="@Cn.Merge("size-1.5 rounded-full", calendar.Dot)"></span>
                    <span>@calendar.Name</span>
                    @if (isVisible)
                    {
                        <LucideEyeCn Size="12" class="size-3 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideEyeOffCn Size="12" class="size-3 text-muted-foreground" />
                    }
                </button>
            }
        </div>

        @* Days *@
        <div>
            @for (var di = 0; di < _days.Length; di++)
            {
                var dayIndex = di;
                var day = _days[dayIndex];
                var visibleEvents = day.Events.Where(e => _visibleCalendars.Contains(e.CalendarId)).ToArray();
                if (visibleEvents.Length == 0) { continue; }
                <div class="@(dayIndex < _days.Length - 1 ? "border-b" : "")">
                    <div class="px-4 py-2">
                        <span class="font-medium text-muted-foreground text-xs">@day.Day, @day.Date</span>
                    </div>
                    @foreach (var evt in visibleEvents)
                    {
                        var cal = GetCalendar(evt.CalendarId);
                        if (cal != null)
                        {
                            <div class="flex items-center gap-3 px-4 py-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", cal.Dot)"></span>
                                <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@evt.Time</span>
                                <span class="min-w-0 flex-1 text-sm">@evt.Title</span>
                                <span class="@Cn.Merge("rounded-md px-1.5 py-0.5 text-xs", cal.Bg)">@cal.Name</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record CalendarSource(string Id, string Name, string Dot, string Bg);
    private record MergedEvent(string Id, string Title, string Time, string CalendarId);
    private record DayData(string Date, string Day, MergedEvent[] Events);

    private static readonly CalendarSource[] _calendars =
    [
        new("work", "Work", "bg-blue-500", "bg-blue-500/10"),
        new("personal", "Personal", "bg-emerald-500", "bg-emerald-500/10"),
        new("team", "Team Shared", "bg-purple-500", "bg-purple-500/10"),
        new("holidays", "Holidays", "bg-amber-500", "bg-amber-500/10"),
    ];

    private static readonly DayData[] _days =
    [
        new("Mar 18", "Tuesday",
        [
            new("1", "Sprint Planning", "9:00 AM", "work"),
            new("2", "Gym Session", "6:30 AM", "personal"),
            new("3", "Design Review", "2:00 PM", "team"),
            new("4", "Dentist Appointment", "4:00 PM", "personal"),
        ]),
        new("Mar 19", "Wednesday",
        [
            new("5", "Client Call", "10:30 AM", "work"),
            new("6", "Team Lunch", "12:00 PM", "team"),
            new("7", "React Meetup", "6:00 PM", "personal"),
        ]),
        new("Mar 20", "Thursday",
        [
            new("8", "Code Review", "11:00 AM", "work"),
            new("9", "Spring Equinox", "All Day", "holidays"),
            new("10", "Book Club", "7:00 PM", "personal"),
        ]),
        new("Mar 21", "Friday",
        [
            new("11", "Deploy Review", "3:00 PM", "work"),
            new("12", "Happy Hour", "5:00 PM", "team"),
        ]),
    ];

    private HashSet<string> _visibleCalendars = new(["work", "personal", "team", "holidays"]);

    private void ToggleCalendar(string calendarId)
    {
        if (_visibleCalendars.Contains(calendarId))
            _visibleCalendars.Remove(calendarId);
        else
            _visibleCalendars.Add(calendarId);
    }

    private CalendarSource? GetCalendar(string id) => _calendars.FirstOrDefault(c => c.Id == id);

    private int TotalEvents => _days.Sum(d => d.Events.Count(e => _visibleCalendars.Contains(e.CalendarId)));
}
