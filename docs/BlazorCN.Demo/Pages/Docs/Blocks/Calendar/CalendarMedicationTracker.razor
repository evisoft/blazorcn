@* ============================================================
   Block: calendar-medication-tracker
   Title: CalendarMedicationTracker
   Description: A medication reminder calendar block for Next.js with dose schedules, refill alerts, and adherence tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-medication-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Medication Tracker</h2>
                <p class="text-muted-foreground text-xs">Tuesday, Mar 18, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucidePillCn Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@TakenDoses/@TotalDoses</span>
                <span class="text-muted-foreground text-xs">taken today</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideCheckCircle2Cn Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">@AvgAdherence%</span>
                avg adherence
            </div>
            @if (LowStockCount > 0)
            {
                <span class="text-muted-foreground text-xs">·</span>
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideAlertTriangleCn Class="size-3.5 text-amber-500" />
                    <span class="font-medium text-amber-600 tabular-nums">@LowStockCount</span>
                    need refill
                </div>
            }
        </div>

        <div>
            @for (int mi = 0; mi < _meds.Count; mi++)
            {
                var med = _meds[mi];
                var isLast = mi == _meds.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3">
                        <span class="@($"mt-1 size-1.5 shrink-0 rounded-full {med.Color}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@med.Name</span>
                                <span class="text-muted-foreground text-xs">@med.Dosage</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@med.Frequency</span>
                                <span>·</span>
                                <span class="tabular-nums">@med.PillsLeft pills left</span>
                                @if (med.PillsLeft <= 7)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-amber-600">Refill soon</BadgeCn>
                                }
                            </div>
                            <div class="mt-1.5 flex items-center gap-2">
                                <ProgressCn Value="@med.AdherenceRate" Class="h-1 w-16" />
                                <span class="text-muted-foreground text-xs tabular-nums">@med.AdherenceRate%</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex gap-2 px-4 pb-3 pl-9">
                        @for (int ti = 0; ti < med.Times.Count; ti++)
                        {
                            var dose = med.Times[ti];
                            var tIndex = ti;
                            var medId = med.Id;
                            <button type="button"
                                    @onclick="@(() => ToggleDose(medId, tIndex))"
                                    class="@($"flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs transition-colors {(dose.Taken ? "bg-emerald-500/10 text-emerald-700" : "bg-muted/50 text-muted-foreground hover:bg-muted")}")">
                                @if (dose.Taken)
                                {
                                    <LucideCheckCircle2Cn Class="size-3" />
                                }
                                else
                                {
                                    <LucideClockCn Class="size-3" />
                                }
                                @dose.Time
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class DoseTime
    {
        public string Time { get; set; } = "";
        public bool Taken { get; set; }
    }

    private class Medication
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string Dosage { get; init; } = "";
        public string Frequency { get; init; } = "";
        public string Color { get; init; } = "";
        public List<DoseTime> Times { get; init; } = new();
        public string RefillDate { get; init; } = "";
        public int PillsLeft { get; init; }
        public int AdherenceRate { get; init; }
    }

    private List<Medication> _meds =
    [
        new() { Id = "1", Name = "Lisinopril", Dosage = "10mg", Frequency = "Once daily", Color = "bg-blue-500", Times = [new() { Time = "8:00 AM", Taken = true }], RefillDate = "Mar 28", PillsLeft = 10, AdherenceRate = 96 },
        new() { Id = "2", Name = "Metformin", Dosage = "500mg", Frequency = "Twice daily", Color = "bg-emerald-500", Times = [new() { Time = "7:00 AM", Taken = true }, new() { Time = "7:00 PM", Taken = false }], RefillDate = "Apr 5", PillsLeft = 22, AdherenceRate = 88 },
        new() { Id = "3", Name = "Vitamin D3", Dosage = "2000 IU", Frequency = "Once daily", Color = "bg-amber-500", Times = [new() { Time = "9:00 AM", Taken = true }], RefillDate = "May 1", PillsLeft = 45, AdherenceRate = 92 },
        new() { Id = "4", Name = "Atorvastatin", Dosage = "20mg", Frequency = "Once daily (evening)", Color = "bg-purple-500", Times = [new() { Time = "9:00 PM", Taken = false }], RefillDate = "Mar 22", PillsLeft = 4, AdherenceRate = 85 },
        new() { Id = "5", Name = "Omeprazole", Dosage = "20mg", Frequency = "Once daily (before breakfast)", Color = "bg-rose-500", Times = [new() { Time = "7:30 AM", Taken = true }], RefillDate = "Apr 10", PillsLeft = 28, AdherenceRate = 94 },
    ];

    private int TotalDoses => _meds.Sum(m => m.Times.Count);
    private int TakenDoses => _meds.Sum(m => m.Times.Count(t => t.Taken));
    private int LowStockCount => _meds.Count(m => m.PillsLeft <= 7);
    private int AvgAdherence => (int)Math.Round((double)_meds.Sum(m => m.AdherenceRate) / _meds.Count);

    private void ToggleDose(string medId, int timeIndex)
    {
        var med = _meds.First(m => m.Id == medId);
        med.Times[timeIndex].Taken = !med.Times[timeIndex].Taken;
    }
}
