            new("2:00 PM", true),
            new("3:00 PM", true),
            new("4:00 PM", false, "Team Standup"),
        ]),
        new("2", "Cedar", "2nd Floor", 10, ["Whiteboard", "Video Call", "Display"], [
            new("9:00 AM", true),
