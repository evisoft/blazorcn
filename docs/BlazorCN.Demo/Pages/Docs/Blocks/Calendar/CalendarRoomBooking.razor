            new("1:00 PM", true),
            new("2:00 PM", true),
            new("3:00 PM", false, "Retrospective"),
            new("4:00 PM", true),
        ]),
        new("3", "Birch", "3rd Floor", 4, ["Display"], [
            new("9:00 AM", true),
            new("10:00 AM", true),
            new("11:00 AM", true),
            new("12:00 PM", true),
            new("1:00 PM", false, "Interview - Engineering"),
            new("2:00 PM", false, "Interview - Design"),
            new("3:00 PM", true),
            new("4:00 PM", true),
        ]),
        new("4", "Sequoia", "3rd Floor", 16, ["Whiteboard", "Video Call", "Display", "Standing Desks"], [
