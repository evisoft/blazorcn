@* ============================================================
   Block: calendar-room-booking
   Title: Calendar Room Booking
   Description: Room booking calendar with two-panel layout, room list, and time slots
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-room-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Room Booking</h2>
                <p class="text-muted-foreground text-xs">Wednesday, Mar 18, 2026</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs">
                    <LucideChevronLeftCn Size="14" class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs">
                    <LucideChevronRightCn Size="14" class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Two panel layout *@
        <div class="flex">
            @* Room list *@
            <div class="w-56 shrink-0 border-r">
                <div class="border-b px-3 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Rooms</span>
                </div>
                @for (var i = 0; i < _rooms.Length; i++)
                {
                    var room = _rooms[i];
                    var isSelected = _selectedRoom == room.Id;
                    var roomAvailable = room.Slots.Count(s => s.Available);
                    var isLast = i == _rooms.Length - 1;
                    <button type="button"
                            @onclick="@(() => { _selectedRoom = room.Id; _selectedSlot = null; })"
                            class="@Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50" : "", isLast ? "" : "border-b")">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="font-medium text-sm">@room.Name</span>
                                <span class="@Cn.Merge("size-1.5 rounded-full", roomAvailable > 0 ? "bg-emerald-500" : "bg-red-500")"></span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@room.Floor</span>
                                <span>&middot;</span>
                                <span class="flex items-center gap-0.5">
                                    <LucideUsersCn Size="12" class="size-3" />
                                    @room.Capacity
                                </span>
                            </div>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @roomAvailable free
                        </span>
                    </button>
                }
            </div>

            @* Time slots *@
            <div class="min-w-0 flex-1">
                @{ var activeRoom = _rooms.FirstOrDefault(r => r.Id == _selectedRoom); }
                @if (activeRoom is not null)
                {
                    var availableCount = activeRoom.Slots.Count(s => s.Available);

                    @* Room info *@
                    <div class="flex items-center justify-between border-b px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@activeRoom.Name</span>
                            <span class="text-muted-foreground text-xs">&middot;</span>
                            <span class="text-muted-foreground text-xs">
                                @availableCount slots available
                            </span>
                        </div>
                        <div class="flex items-center gap-1">
                            @foreach (var amenity in activeRoom.Amenities)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                    @amenity
                                </BadgeCn>
                            }
                        </div>
                    </div>

                    @* Slots *@
                    <div>
                        @for (var i = 0; i < activeRoom.Slots.Length; i++)
                        {
                            var slot = activeRoom.Slots[i];
                            var slotKey = $"{activeRoom.Id}-{slot.Time}";
                            var isSlotSelected = _selectedSlot == slotKey;
                            var isLast = i == activeRoom.Slots.Length - 1;
                            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors", slot.Available ? "hover:bg-muted/50" : "", isLast ? "" : "border-b", isSlotSelected ? "bg-muted/50" : "")">
                                <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                    @slot.Time
                                </span>
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", slot.Available ? "bg-emerald-500" : "bg-red-500/60")"></span>
                                @if (slot.Available)
                                {
                                    <div class="flex min-w-0 flex-1 items-center justify-between">
                                        <span class="text-muted-foreground text-sm">Available</span>
                                        <ButtonCn Variant="ButtonVariant.Outline"
                                                  Size="ButtonSize.Sm"
                                                  class="h-6 text-xs"
                                                  @onclick="@(() => _selectedSlot = slotKey)">
                                            @(isSlotSelected ? "Selected" : "Book")
                                        </ButtonCn>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex min-w-0 flex-1 items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideMonitorCn Size="12" class="size-3 text-muted-foreground" />
                                            <span class="text-sm">@slot.BookedBy</span>
                                        </div>
                                        <span class="text-muted-foreground text-xs">Booked</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TimeSlot(string Time, bool Available, string? BookedBy = null);
    private record Room(string Id, string Name, string Floor, int Capacity, string[] Amenities, TimeSlot[] Slots);

    private static readonly Room[] _rooms =
    [
        new("1", "Maple", "2nd Floor", 6, ["Whiteboard", "Display"], [
