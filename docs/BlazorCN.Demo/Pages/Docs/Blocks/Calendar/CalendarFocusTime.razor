@* ============================================================
   Block: calendar-focus-time
   Title: CalendarFocusTime
   Description: A focus time scheduler block for Next.js with distraction-free time slots, focus session types, and daily deep work tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-focus-time.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Focus Time</h2>
                <p class="text-muted-foreground text-xs">Wednesday, Mar 18, 2026</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                New Session
            </ButtonCn>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideTargetCn Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @(_completedHours.ToString("0.##"))h
                </span>
                of @(_dailyGoal)h goal
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideTimerCn Class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">@(_totalHours.ToString("0.##"))h</span>
                planned
            </div>
        </div>

        <div class="flex flex-wrap gap-2 border-b px-4 py-2.5">
            @foreach (var entry in _typeEntries)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Dot)"></span>
                    @entry.Label
                </span>
            }
        </div>

        <div>
            @for (var i = 0; i < _focusSessions.Count; i++)
            {
                var index = i;
                var session = _focusSessions[index];
                var config = _typeConfig[session.Type];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", index < _focusSessions.Count - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        aria-label="@(session.Completed ? $"Mark {session.Title} incomplete" : $"Mark {session.Title} complete")"
                        @onclick="@(() => ToggleComplete(session.Id))"
                        class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full border transition-colors", session.Completed ? "border-emerald-500 bg-emerald-500 text-white" : "border-muted-foreground/30 hover:border-muted-foreground/60")">
                        @if (session.Completed)
                        {
                            <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <title>Completed</title>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        }
                    </button>
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("font-medium text-sm", session.Completed ? "text-muted-foreground line-through" : "")">
                                @session.Title
                            </span>
                            @if (session.NotificationsBlocked)
                            {
                                <LucideShieldCn Class="size-3 text-muted-foreground/60" />
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@config.Label</span>
                            <span>·</span>
                            <span class="tabular-nums">
                                @session.StartTime - @session.EndTime
                            </span>
                        </div>
                    </div>
                    <span class="shrink-0 font-medium text-muted-foreground text-xs tabular-nums">
                        @session.Duration
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FocusSession(string Id, string Title, string Type, string StartTime, string EndTime, string Duration, bool Completed, bool NotificationsBlocked);
    private record TypeConfig(string Label, string Dot);

    private static readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["deep-work"] = new TypeConfig("Deep Work", "bg-blue-500"),
        ["creative"] = new TypeConfig("Creative", "bg-purple-500"),
        ["learning"] = new TypeConfig("Learning", "bg-emerald-500"),
        ["planning"] = new TypeConfig("Planning", "bg-amber-500"),
    };

    private static readonly (string Key, string Label, string Dot)[] _typeEntries =
    [
        ("deep-work", "Deep Work", "bg-blue-500"),
        ("creative", "Creative", "bg-purple-500"),
        ("learning", "Learning", "bg-emerald-500"),
        ("planning", "Planning", "bg-amber-500"),
    ];

    private static readonly int _dailyGoal = 6;

    private List<FocusSession> _focusSessions =
    [
        new FocusSession("1", "Algorithm Design", "deep-work", "8:00 AM", "10:00 AM", "2h", true, true),
        new FocusSession("2", "UI Prototyping", "creative", "10:30 AM", "12:00 PM", "1.5h", true, true),
        new FocusSession("3", "React Patterns Course", "learning", "1:00 PM", "2:00 PM", "1h", false, false),
        new FocusSession("4", "Sprint Planning Prep", "planning", "2:30 PM", "3:30 PM", "1h", false, false),
        new FocusSession("5", "API Refactoring", "deep-work", "4:00 PM", "5:30 PM", "1.5h", false, true),
    ];

    private float _completedHours => _focusSessions.Where(s => s.Completed).Sum(s => ParseHours(s.Duration));
    private float _totalHours => _focusSessions.Sum(s => ParseHours(s.Duration));

    private static float ParseHours(string d) =>
        float.Parse(d.TrimEnd('h'), System.Globalization.CultureInfo.InvariantCulture);

    private void ToggleComplete(string id)
    {
        for (var i = 0; i < _focusSessions.Count; i++)
        {
            if (_focusSessions[i].Id == id)
            {
                _focusSessions[i] = _focusSessions[i] with { Completed = !_focusSessions[i].Completed };
                break;
            }
        }
    }
}
