@* ============================================================
   Block: calendar-employee-onboarding
   Title: Calendar Employee Onboarding
   Description: A React employee onboarding timeline block for Next.js with task checklist, due dates, assigned owners, and completion progress built with shadcn/ui and Tailwind CSS
   Long Description: React Editorial Content Calendar Block
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-employee-onboarding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideClipboardListCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Onboarding Timeline</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Alex Rivera — Engineering
            </BadgeCn>
        </div>

        @* Progress summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">@_overallProgress%</span>
                    <span class="text-muted-foreground text-xs">complete</span>
                </div>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_completedCount/@_totalCount tasks
                </span>
            </div>
            <ProgressCn Value="@_overallProgress" Class="mt-2 h-1.5" aria-label="Progress" />
        </div>

        @* Phases *@
        <div>
            @for (int pi = 0; pi < _phases.Length; pi++)
            {
                var phase = _phases[pi];
                var isExpanded = _expandedPhase == phase.Id;
                var isLast = pi == _phases.Length - 1;
                var phaseCompleted = phase.Tasks.Count(t => t.Status == "completed");
                var phaseTotal = phase.Tasks.Length;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expandedPhase = _expandedPhase == phase.Id ? null : phase.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {(phaseCompleted == phaseTotal ? "bg-emerald-500" : phaseCompleted > 0 ? "bg-blue-500" : "bg-muted-foreground/30")}")" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@phase.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@phase.Period</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-muted-foreground text-xs tabular-nums">@phaseCompleted/@phaseTotal</span>
                            <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="flex flex-col gap-1">
                                @foreach (var task in phase.Tasks)
                                {
                                    <div class="flex items-start gap-2.5 rounded-md px-2 py-2 transition-colors hover:bg-muted/30">
                                        @if (task.Status == "completed")
                                        {
                                            <LucideCircleCheckCn Class="mt-0.5 size-4 shrink-0 text-emerald-500" />
                                        }
                                        else
                                        {
                                            <LucideCircleCn Class="@($"mt-0.5 size-4 shrink-0 {(task.Status == "in-progress" ? "text-blue-500" : "text-muted-foreground/30")}")" />
                                        }
                                        <div class="min-w-0 flex-1">
                                            <span class="@($"text-sm {(task.Status == "completed" ? "text-muted-foreground line-through" : "font-medium")}")">
                                                @task.Title
                                            </span>
                                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                                <span class="flex items-center gap-1">
                                                    <LucideUserCn Class="size-3" />
                                                    @task.Owner
                                                </span>
                                                <span>Due @task.DueDate</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expandedPhase = "p2";

    private record OnboardingTask(string Id, string Title, string DueDate, string Owner, string OwnerInitials, string Status);
    private record OnboardingPhase(string Id, string Name, string Period, OnboardingTask[] Tasks);

    private static readonly OnboardingPhase[] _phases =
    [
        new("p1", "Pre-boarding", "Before start date", [
            new("t1", "Send welcome email with first-day instructions", "Mar 14", "HR Team", "HR", "completed"),
            new("t2", "Set up workstation and equipment", "Mar 16", "IT Support", "IT", "completed"),
            new("t3", "Create accounts: email, Slack, GitHub, Jira", "Mar 16", "IT Support", "IT", "completed"),
            new("t4", "Prepare onboarding buddy assignment", "Mar 17", "Team Lead", "TL", "completed"),
        ]),
        new("p2", "Week 1 \u2014 Orientation", "Mar 18 \u2014 Mar 22", [
            new("t5", "Office tour and team introductions", "Mar 18", "Team Lead", "TL", "in-progress"),
            new("t6", "HR orientation: benefits, policies, handbook", "Mar 18", "HR Team", "HR", "in-progress"),
            new("t7", "Development environment setup", "Mar 19", "Onboarding Buddy", "OB", "pending"),
            new("t8", "Codebase walkthrough and architecture overview", "Mar 20", "Tech Lead", "TK", "pending"),
            new("t9", "First starter task assignment", "Mar 21", "Tech Lead", "TK", "pending"),
        ]),
        new("p3", "Week 2-4 \u2014 Ramp Up", "Mar 25 \u2014 Apr 12", [
            new("t10", "Complete security training and compliance modules", "Mar 28", "HR Team", "HR", "pending"),
            new("t11", "Join sprint and attend first standup", "Mar 25", "Team Lead", "TL", "pending"),
            new("t12", "30-day check-in with manager", "Apr 12", "Team Lead", "TL", "pending"),
        ]),
    ];

    private static readonly int _completedCount = _phases.SelectMany(p => p.Tasks).Count(t => t.Status == "completed");
    private static readonly int _totalCount = _phases.SelectMany(p => p.Tasks).Count();
    private static readonly int _overallProgress = (int)Math.Round((double)_completedCount / _totalCount * 100);
}
