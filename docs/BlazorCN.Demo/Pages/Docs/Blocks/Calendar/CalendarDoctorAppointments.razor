@* ============================================================
   Block: calendar-doctor-appointments
   Title: Calendar Doctor Appointments
   Description: Medical appointment scheduler with doctor profiles, specialty tags, available time slots, and booking confirmation
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, LucideChevronLeftCn, LucideChevronRightCn, LucideClockCn, LucideStarCn
   Source: original/blocks/calendar/calendar-doctor-appointments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Book Appointment</h2>
                <p class="text-xs text-muted-foreground">Wednesday, Mar 18, 2026</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" aria-label="Previous">
                    <LucideChevronLeftCn Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" aria-label="Next">
                    <LucideChevronRightCn Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Two panel layout *@
        <div class="flex">
            @* Doctor list *@
            <div class="w-60 shrink-0 border-r">
                <div class="border-b px-3 py-2">
                    <span class="text-xs font-medium text-muted-foreground">Doctors</span>
                </div>
                @for (var i = 0; i < _doctors.Length; i++)
                {
                    var doctor = _doctors[i];
                    var isSelected = _selectedDoctor == doctor.Id;
                    var docAvailable = doctor.Slots.Count(s => s.Available);
                    var isLast = i == _doctors.Length - 1;

                    <button
                        type="button"
                        @onclick="@(() => { _selectedDoctor = doctor.Id; _selectedSlot = null; })"
                        class="@(Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50" : "", !isLast ? "border-b" : ""))">
                        <AvatarCn Class="size-8">
                            <AvatarFallbackCn Class="text-xs">@doctor.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-medium">@doctor.Name</span>
                            <div class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span>@doctor.Specialty</span>
                            </div>
                        </div>
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", docAvailable > 0 ? "bg-emerald-500" : "bg-red-500"))"></span>
                    </button>
                }
            </div>

            @* Appointment slots *@
            <div class="min-w-0 flex-1">
                @if (ActiveDoctor is not null)
                {
                    @* Doctor info *@
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-sm font-medium">@ActiveDoctor.Name</span>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @ActiveDoctor.Specialty
                                    </BadgeCn>
                                    <span class="flex items-center gap-0.5">
                                        <LucideStarCn Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                                        <span class="tabular-nums">@ActiveDoctor.Rating</span>
                                    </span>
                                    <span>&middot;</span>
                                    <span>@ActiveDoctor.Experience</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @AvailableSlots slots
                                </span>
                            </div>
                        </div>
                    </div>

                    @* Time slots header *@
                    <div class="border-b px-4 py-2">
                        <span class="text-xs font-medium text-muted-foreground">Available times</span>
                    </div>

                    @* Slot grid *@
                    <div class="p-4">
                        <div class="grid grid-cols-3 gap-2 sm:grid-cols-4">
                            @foreach (var slot in ActiveDoctor.Slots)
                            {
                                var slotKey = $"{ActiveDoctor.Id}-{slot.Time}";
                                var isSlotSelected = _selectedSlot == slotKey;
                                var sk = slotKey;

                                <button
                                    type="button"
                                    disabled="@(!slot.Available)"
                                    @onclick="@(() => _selectedSlot = isSlotSelected ? null : sk)"
                                    class="@(Cn.Merge("flex items-center justify-center gap-1.5 rounded-md border px-3 py-2 text-sm transition-colors", !slot.Available ? "cursor-not-allowed border-transparent bg-muted/30 text-muted-foreground/40 line-through" : isSlotSelected ? "border-foreground bg-foreground text-background" : "border-border hover:bg-muted/50"))">
                                    <LucideClockCn Size="12" Class="size-3" />
                                    <span class="font-mono text-xs tabular-nums">@slot.Time</span>
                                </button>
                            }
                        </div>

                        @if (_selectedSlot is not null)
                        {
                            <div class="mt-4 flex items-center justify-between rounded-md bg-muted/50 p-3">
                                <div>
                                    <span class="text-sm font-medium">@ActiveDoctor.Name</span>
                                    <span class="text-sm text-muted-foreground"> at </span>
                                    <span class="text-sm font-medium">@SelectedTime</span>
                                </div>
                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                                    Confirm
                                </ButtonCn>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string _selectedDoctor = "1";
    private string? _selectedSlot;

    private record TimeSlot(string Time, bool Available);
    private record Doctor(string Id, string Name, string Initials, string Specialty, double Rating, string Experience, string NextAvailable, TimeSlot[] Slots);

    private Doctor? ActiveDoctor => _doctors.FirstOrDefault(d => d.Id == _selectedDoctor);
    private int AvailableSlots => ActiveDoctor?.Slots.Count(s => s.Available) ?? 0;
    private string SelectedTime => _selectedSlot?.Split('-', 2) is [_, var time] ? time : "";

    private static readonly Doctor[] _doctors =
    [
        new("1", "Dr. Sarah Mitchell", "SM", "General Practice", 4.9, "12 years", "Today",
        [
            new("9:00 AM", false), new("9:30 AM", false), new("10:00 AM", true),
            new("10:30 AM", true), new("11:00 AM", false), new("2:00 PM", true),
            new("2:30 PM", false), new("3:00 PM", true), new("3:30 PM", true),
        ]),
        new("2", "Dr. James Park", "JP", "Cardiology", 4.8, "18 years", "Today",
        [
            new("10:00 AM", true), new("10:30 AM", false), new("11:00 AM", true),
            new("11:30 AM", false), new("1:00 PM", false), new("1:30 PM", true),
            new("2:00 PM", false),
        ]),
        new("3", "Dr. Amara Osei", "AO", "Dermatology", 4.7, "9 years", "Tomorrow",
        [
            new("9:00 AM", true), new("9:30 AM", true), new("10:00 AM", true),
            new("10:30 AM", false), new("11:00 AM", true), new("3:00 PM", true),
            new("3:30 PM", false), new("4:00 PM", true),
        ]),
        new("4", "Dr. Carlos Rivera", "CR", "Orthopedics", 4.6, "15 years", "Today",
        [
            new("11:00 AM", true), new("11:30 AM", true), new("1:00 PM", false),
            new("1:30 PM", false), new("2:00 PM", true), new("4:00 PM", true),
            new("4:30 PM", true),
        ]),
    ];
}
