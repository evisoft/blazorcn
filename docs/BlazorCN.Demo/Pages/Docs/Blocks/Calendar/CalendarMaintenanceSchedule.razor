@* ============================================================
   Block: calendar-maintenance-schedule
   Title: Calendar Maintenance Schedule
   Description: React maintenance window scheduler block for Next.js with affected services list, recurrence options, approval workflow, and downtime estimation built with shadcn/ui and Tailwind CSS
   Long Description: React Employee Leave Tracker Calendar Block
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-maintenance-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideWrenchCn Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Maintenance Schedule</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    New window
                </ButtonCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                3 upcoming maintenance windows · 1 pending approval
            </p>
        </div>

        @* Summary stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5 text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500" />
                <span class="text-muted-foreground">1 approved</span>
            </div>
            <div class="flex items-center gap-1.5 text-xs">
                <span class="size-1.5 rounded-full bg-amber-500" />
                <span class="text-muted-foreground">2 pending</span>
            </div>
            <div class="ml-auto flex items-center gap-1.5 text-xs">
                <LucideServerCn Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground">8 services affected</span>
            </div>
        </div>

        @* Maintenance windows *@
        <div>
            @for (int i = 0; i < _windows.Length; i++)
            {
                var mw = _windows[i];
                var isExpanded = _expanded == mw.Id;
                var isLast = i == _windows.Length - 1;
                var status = GetStatusConfig(mw.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == mw.Id ? null : mw.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {status.Color}")" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@mw.Title</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Class="size-3" />
                                    @mw.Date
                                </span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideClockCn Class="size-3" />
                                    @mw.Duration
                                </span>
                                @if (mw.Recurrence != "One-time")
                                {
                                    <span>·</span>
                                    <span class="flex items-center gap-1">
                                        <LucideRepeatCn Class="size-3" />
                                        @mw.Recurrence
                                    </span>
                                }
                            </div>
                        </div>
                        <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-4 pl-9 pt-3">
                            <p class="mb-3 text-muted-foreground text-sm">@mw.Description</p>

                            <div class="mb-3 rounded-md bg-muted/50 p-3">
                                <span class="mb-1 block font-medium text-muted-foreground text-xs">Maintenance window</span>
                                <span class="text-sm">@mw.Time</span>
                            </div>

                            <div class="mb-3">
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Affected services</span>
                                <div class="space-y-1.5">
                                    @foreach (var service in mw.Services)
                                    {
                                        <div class="flex items-center gap-2">
                                            <span class="@($"size-1.5 rounded-full {GetSeverityDot(service.Severity)}")" />
                                            <span class="flex-1 text-sm">@service.Name</span>
                                            <span class="text-muted-foreground text-xs tabular-nums">~@service.EstimatedDowntime</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="flex items-center justify-between">
                                @if (mw.ApprovedBy != null)
                                {
                                    <span class="flex items-center gap-1.5 text-xs text-emerald-600 dark:text-emerald-400">
                                        <LucideCircleCheckCn Class="size-3" />
                                        Approved by @mw.ApprovedBy
                                    </span>
                                }
                                else
                                {
                                    <span class="flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
                                        <LucideTriangleAlertCn Class="size-3" />
                                        Awaiting approval
                                    </span>
                                }
                                @if (mw.ApprovedBy == null)
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 text-xs">
                                        Approve
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "mw1";

    private record AffectedService(string Id, string Name, string Severity, string EstimatedDowntime);
    private record MaintenanceWindow(string Id, string Title, string Date, string Time, string Duration, string Status, string Recurrence, string? ApprovedBy, AffectedService[] Services, string Description);
    private record StatusInfo(string Label, string Color);

    private static readonly MaintenanceWindow[] _windows =
    [
        new("mw1", "Database cluster upgrade", "Sat, Mar 22", "2:00 AM - 4:00 AM UTC", "2 hrs", "scheduled", "One-time", "Alex Rivera",
            [new("s1", "PostgreSQL Primary", "critical", "45 min"), new("s2", "Read Replicas", "critical", "30 min"), new("s3", "API Gateway", "major", "15 min"), new("s4", "Background Workers", "minor", "5 min")],
            "Upgrading PostgreSQL from 15.4 to 16.2. Includes schema migrations and index rebuilds."),
        new("mw2", "SSL certificate rotation", "Sun, Mar 30", "3:00 AM - 3:30 AM UTC", "30 min", "pending", "Quarterly", null,
            [new("s5", "Load Balancer", "major", "2 min"), new("s6", "CDN Edge Nodes", "minor", "0 min")],
            "Rotating TLS certificates across all edge endpoints. Zero-downtime deployment expected."),
        new("mw3", "Kubernetes node pool scaling", "Sat, Apr 5", "1:00 AM - 2:00 AM UTC", "1 hr", "pending", "Monthly", null,
            [new("s7", "Compute Cluster", "major", "10 min"), new("s8", "Service Mesh", "minor", "5 min")],
            "Expanding node pool from 12 to 18 nodes. Rolling update with pod disruption budgets."),
    ];

    private static StatusInfo GetStatusConfig(string status) => status switch
    {
        "scheduled" => new("Scheduled", "bg-emerald-500"),
        "pending" => new("Pending approval", "bg-amber-500"),
        "in-progress" => new("In progress", "bg-blue-500"),
        "completed" => new("Completed", "bg-muted-foreground/30"),
        _ => new(status, "bg-zinc-400")
    };

    private static string GetSeverityDot(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "major" => "bg-amber-500",
        "minor" => "bg-blue-500",
        _ => "bg-zinc-400"
    };
}
