@* ============================================================
   Block: calendar-year-overview
   Title: Calendar Year Overview
   Description: 12-month year overview with heat map style event density per day, month grids, and yearly statistics
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-year-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Year Overview</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_totalEvents events across @_eventDensity.Count days
                </p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideChevronLeftCn Class="size-4" />
                </ButtonCn>
                <span class="rounded-full bg-muted px-2 py-0.5 font-medium text-sm tabular-nums">
                    @Year
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideChevronRightCn Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Month grids *@
        <div class="grid grid-cols-3 gap-0 sm:grid-cols-4">
            @for (int monthIndex = 0; monthIndex < 12; monthIndex++)
            {
                var mi = monthIndex;
                var grid = BuildMonthGrid(Year, mi);
                <div class="border-b border-r p-3 last:border-r-0 [&:nth-child(3n)]:border-r-0 sm:[&:nth-child(3n)]:border-r sm:[&:nth-child(4n)]:border-r-0">
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        @_monthNames[mi]
                    </span>
                    @* Day headers *@
                    <div class="mb-0.5 grid grid-cols-7 gap-px">
                        @for (int di = 0; di < _dayLabels.Length; di++)
                        {
                            <span class="text-center text-muted-foreground/60 text-[9px]">@_dayLabels[di]</span>
                        }
                    </div>
                    @* Day cells *@
                    <div class="grid grid-cols-7 gap-px">
                        @foreach (var day in grid)
                        {
                            @if (day == null)
                            {
                                <div class="aspect-square" />
                            }
                            else
                            {
                                var dateKey = $"{Year}-{(mi + 1):D2}-{day:D2}";
                                _eventDensity.TryGetValue(dateKey, out var count);
                                <div class="@($"aspect-square rounded-sm {DensityColor(count)}")"
                                     title="@($"{dateKey}: {count} events")" />
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @* Legend *@
        <div class="flex items-center justify-between border-t bg-muted/20 px-4 py-2">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Less</span>
                <span class="size-3 rounded-sm bg-muted/30" />
                <span class="size-3 rounded-sm bg-primary/15" />
                <span class="size-3 rounded-sm bg-primary/30" />
                <span class="size-3 rounded-sm bg-primary/50" />
                <span class="text-muted-foreground text-xs">More</span>
            </div>
            @if (_busiestDay != null)
            {
                <span class="text-muted-foreground text-xs">
                    Busiest: @_busiestDay.Value.Key[5..] (@_busiestDay.Value.Value events)
                </span>
            }
        </div>
    </div>
</section>

@code {
    private const int Year = 2026;

    private static readonly string[] _monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    private static readonly string[] _dayLabels = ["S", "M", "T", "W", "T", "F", "S"];

    private static readonly Dictionary<string, int> _eventDensity = new()
    {
        ["2026-01-06"] = 2, ["2026-01-07"] = 3, ["2026-01-08"] = 1, ["2026-01-13"] = 4,
        ["2026-01-14"] = 2, ["2026-01-20"] = 1, ["2026-01-21"] = 5, ["2026-01-27"] = 3,
        ["2026-01-28"] = 2, ["2026-02-03"] = 1, ["2026-02-10"] = 2, ["2026-02-11"] = 3,
        ["2026-02-17"] = 4, ["2026-02-24"] = 1, ["2026-03-02"] = 2, ["2026-03-09"] = 3,
        ["2026-03-10"] = 5, ["2026-03-16"] = 2, ["2026-03-17"] = 4, ["2026-03-23"] = 1,
        ["2026-03-24"] = 3, ["2026-03-30"] = 2, ["2026-04-06"] = 1, ["2026-04-07"] = 2,
        ["2026-04-14"] = 3, ["2026-04-21"] = 4, ["2026-04-28"] = 2, ["2026-05-04"] = 3,
        ["2026-05-11"] = 1, ["2026-05-18"] = 5, ["2026-05-25"] = 2, ["2026-06-01"] = 2,
        ["2026-06-08"] = 3, ["2026-06-15"] = 1, ["2026-06-22"] = 4, ["2026-06-29"] = 2,
        ["2026-07-06"] = 1, ["2026-07-13"] = 3, ["2026-07-20"] = 2, ["2026-07-27"] = 5,
        ["2026-08-03"] = 2, ["2026-08-10"] = 4, ["2026-08-17"] = 1, ["2026-08-24"] = 3,
        ["2026-09-07"] = 2, ["2026-09-14"] = 3, ["2026-09-21"] = 4, ["2026-09-28"] = 1,
        ["2026-10-05"] = 3, ["2026-10-12"] = 2, ["2026-10-19"] = 5, ["2026-10-26"] = 1,
        ["2026-11-02"] = 2, ["2026-11-09"] = 3, ["2026-11-16"] = 4, ["2026-11-23"] = 1,
        ["2026-11-30"] = 2, ["2026-12-07"] = 3, ["2026-12-14"] = 5, ["2026-12-21"] = 2,
        ["2026-12-28"] = 1,
    };

    private static readonly int _totalEvents = _eventDensity.Values.Sum();
    private static readonly KeyValuePair<string, int>? _busiestDay = _eventDensity.OrderByDescending(kv => kv.Value).FirstOrDefault();

    private static int GetDaysInMonth(int year, int month) =>
        DateTime.DaysInMonth(year, month + 1);

    private static int GetFirstDayOfWeek(int year, int month) =>
        (int)new DateTime(year, month + 1, 1).DayOfWeek;

    private static int?[] BuildMonthGrid(int year, int month)
    {
        var daysInMonth = GetDaysInMonth(year, month);
        var firstDay = GetFirstDayOfWeek(year, month);
        var cells = new List<int?>();

        for (int i = 0; i < firstDay; i++)
            cells.Add(null);
        for (int d = 1; d <= daysInMonth; d++)
            cells.Add(d);

        return cells.ToArray();
    }

    private static string DensityColor(int count) => count switch
    {
        0 => "bg-muted/30",
        1 => "bg-primary/15",
        <= 3 => "bg-primary/30",
        _ => "bg-primary/50"
    };
}
