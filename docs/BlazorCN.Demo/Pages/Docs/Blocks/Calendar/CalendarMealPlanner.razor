@* ============================================================
   Block: calendar-meal-planner
   Title: Calendar Meal Planner
   Description: Weekly meal planner calendar with breakfast, lunch, and dinner slots and calorie counts
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-meal-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Meal Planner</h2>
                <p class="text-muted-foreground text-xs">Mar 17 - Mar 23, 2026</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" aria-label="Previous">
                    <LucideChevronLeftCn Size="14" class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" aria-label="Next">
                    <LucideChevronRightCn Size="14" class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Weekly summary *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <LucideFlameCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Weekly avg</span>
                <span class="font-semibold text-sm tabular-nums">@_weekAvg.ToString("N0")</span>
                <span class="text-muted-foreground text-xs">kcal/day</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_weekTotal.ToString("N0") kcal total
            </span>
        </div>

        @* Day selector *@
        <div class="grid grid-cols-7 border-b">
            @foreach (var day in _weekMeals)
            {
                var cals = DailyCalories(day);
                <button type="button"
                        @onclick="@(() => _selectedDay = day.Date)"
                        class="@Cn.Merge("flex flex-col items-center gap-0.5 px-1 py-2.5 transition-colors hover:bg-muted/50", _selectedDay == day.Date ? "bg-muted/50" : "")">
                    <span class="text-muted-foreground text-xs">@day.Day</span>
                    <span class="@Cn.Merge("font-medium text-sm tabular-nums", _selectedDay == day.Date ? "text-foreground" : "text-muted-foreground")">
                        @day.Date.Split(' ')[1]
                    </span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @(cals > 0 ? cals.ToString() : "-")
                    </span>
                </button>
            }
        </div>

        @* Meal slots *@
        @{ var dayData = _weekMeals.FirstOrDefault(d => d.Date == _selectedDay); }
        @if (dayData is not null)
        {
            <div>
                <div class="flex items-center justify-between border-b px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">
                        @dayData.Day, @dayData.Date
                    </span>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                        <LucideFlameCn Size="12" class="size-3" />
                        @DailyCalories(dayData) kcal
                    </span>
                </div>
                @for (var i = 0; i < _mealTypes.Length; i++)
                {
                    var mealType = _mealTypes[i];
                    var meal = dayData.Meals[mealType];
                    var isLast = i == _mealTypes.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                        <div class="w-16 shrink-0">
                            <span class="font-medium text-muted-foreground text-xs">
                                @_mealLabels[mealType]
                            </span>
                        </div>
                        @if (meal is not null)
                        {
                            <div class="flex min-w-0 flex-1 items-center justify-between gap-2">
                                <span class="truncate font-medium text-sm">@meal.Name</span>
                                <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                                    @meal.Calories kcal
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="flex min-w-0 flex-1 items-center justify-between gap-2">
                                <span class="text-muted-foreground text-sm">No meal planned</span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Xs" class="h-6 gap-1 px-2 text-xs">
                                    <LucidePlusCn Size="12" class="size-3" />
                                    Add
                                </ButtonCn>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Meal(string Id, string Name, int Calories);
    private record DayMeals(string Day, string Date, Dictionary<string, Meal?> Meals);

    private static readonly string[] _mealTypes = ["breakfast", "lunch", "dinner"];

    private static readonly Dictionary<string, string> _mealLabels = new()
    {
        ["breakfast"] = "Breakfast",
        ["lunch"] = "Lunch",
        ["dinner"] = "Dinner",
    };

    private static readonly DayMeals[] _weekMeals =
    [
        new("Mon", "Mar 17", new() {
            ["breakfast"] = new("1", "Greek Yogurt Parfait", 340),
            ["lunch"] = new("2", "Grilled Chicken Salad", 480),
            ["dinner"] = new("3", "Salmon with Quinoa", 620),
        }),
        new("Tue", "Mar 18", new() {
            ["breakfast"] = new("4", "Avocado Toast", 380),
            ["lunch"] = new("5", "Turkey Wrap", 450),
            ["dinner"] = new("6", "Stir-Fry Vegetables", 510),
        }),
        new("Wed", "Mar 19", new() {
            ["breakfast"] = new("7", "Oatmeal with Berries", 290),
            ["lunch"] = null,
            ["dinner"] = new("8", "Pasta Primavera", 580),
        }),
        new("Thu", "Mar 20", new() {
            ["breakfast"] = new("9", "Smoothie Bowl", 320),
            ["lunch"] = new("10", "Lentil Soup", 390),
            ["dinner"] = new("11", "Grilled Steak", 650),
        }),
        new("Fri", "Mar 21", new() {
            ["breakfast"] = new("12", "Eggs Benedict", 460),
            ["lunch"] = new("13", "Poke Bowl", 520),
            ["dinner"] = null,
        }),
        new("Sat", "Mar 22", new() {
            ["breakfast"] = null,
            ["lunch"] = new("14", "Caesar Salad", 410),
            ["dinner"] = new("15", "Mushroom Risotto", 570),
        }),
        new("Sun", "Mar 23", new() {
            ["breakfast"] = new("16", "Pancakes", 440),
            ["lunch"] = new("17", "Grilled Panini", 490),
            ["dinner"] = new("18", "Roast Chicken", 600),
        }),
    ];

    private static int DailyCalories(DayMeals day) =>
        _mealTypes.Sum(t => day.Meals.TryGetValue(t, out var m) && m is not null ? m.Calories : 0);

    private int _weekTotal => _weekMeals.Sum(DailyCalories);
    private int _weekAvg => _weekTotal / 7;

    private string _selectedDay = "Mar 18";
}
