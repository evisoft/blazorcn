@* ============================================================
   Block: calendar-invoice-dates
   Title: CalendarInvoiceDates
   Description: An invoice date tracker block for Next.js with payment status, due date alerts, and client billing summaries using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-invoice-dates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Invoice Tracker</h2>
                <p class="text-muted-foreground text-xs">March 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_invoices.Length</span>
                <span class="text-muted-foreground text-xs">invoices</span>
            </div>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    $@_totalOutstanding.ToString("N0")
                </span>
                outstanding
            </div>
            @if (_overdueAmount > 0)
            {
                <span class="text-muted-foreground text-xs">·</span>
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-red-500" />
                    <span class="font-medium text-red-600 tabular-nums">
                        $@_overdueAmount.ToString("N0")
                    </span>
                    overdue
                </div>
            }
        </div>

        @* Filter tabs *@
        <div class="flex gap-1 border-b px-4 py-2">
            @foreach (var f in new[] { "outstanding", "paid", "all" })
            {
                var filterVal = f;
                <ButtonCn Variant="@(_filter == filterVal ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" class="h-6 px-2 text-xs capitalize" @onclick="@(() => _filter = filterVal)">
                    @filterVal
                </ButtonCn>
            }
        </div>

        @* Invoice list *@
        <div>
            @for (var i = 0; i < _filtered.Length; i++)
            {
                var index = i;
                var invoice = _filtered[index];
                var config = _statusConfig[invoice.Status];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", index < _filtered.Length - 1 ? "border-b" : "")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@invoice.Client</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" class="@Cn.Merge("font-normal text-xs", config.Color)">
                                @config.Label
                            </BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span class="font-mono">@invoice.InvoiceNumber</span>
                            <span>·</span>
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                Due @invoice.DueDate
                            </span>
                        </div>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@invoice.Amount.ToString("N0")
                    </span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Invoice(string Id, string InvoiceNumber, string Client, int Amount, string DueDate, string Status, string IssuedDate);
    private record StatusConfig(string Label, string Dot, string Color);

    private static readonly Invoice[] _invoices =
    [
        new("1", "INV-2026-042", "Acme Corp",     4500,  "Mar 15", "overdue",  "Feb 15"),
        new("2", "INV-2026-043", "Nexus Labs",    8200,  "Mar 20", "pending",  "Feb 20"),
        new("3", "INV-2026-044", "Bright Health", 3150,  "Mar 25", "pending",  "Feb 25"),
        new("4", "INV-2026-045", "Vertex AI",    12000,  "Mar 30", "pending",  "Mar 1"),
        new("5", "INV-2026-046", "DataFlow",      6750,  "Apr 5",  "draft",    "Mar 5"),
        new("6", "INV-2026-040", "CloudPeak",     5400,  "Mar 1",  "paid",     "Feb 1"),
        new("7", "INV-2026-041", "TechBridge",    3800,  "Mar 10", "paid",     "Feb 10"),
    ];

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["paid"]    = new("Paid",    "bg-emerald-500",         "text-emerald-600"),
        ["pending"] = new("Pending", "bg-amber-500",           "text-amber-600"),
        ["overdue"] = new("Overdue", "bg-red-500",             "text-red-600"),
        ["draft"]   = new("Draft",   "bg-muted-foreground/40", "text-muted-foreground"),
    };

    private string _filter = "outstanding";

    private Invoice[] _outstanding => _invoices.Where(i => i.Status is "pending" or "overdue").ToArray();
    private Invoice[] _paid        => _invoices.Where(i => i.Status == "paid").ToArray();
    private Invoice[] _filtered    => _filter == "outstanding" ? _outstanding : _filter == "paid" ? _paid : _invoices;
    private int _totalOutstanding  => _outstanding.Sum(i => i.Amount);
    private int _overdueAmount     => _invoices.Where(i => i.Status == "overdue").Sum(i => i.Amount);
}
