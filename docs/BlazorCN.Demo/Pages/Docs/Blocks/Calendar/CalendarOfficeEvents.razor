@* ============================================================
   Block: calendar-office-events
   Title: CalendarOfficeEvents
   Description: An office events calendar block for Next.js with team gatherings, company-wide events, department activities, and RSVP tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-office-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBuildingCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Office Events</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@Upcoming awaiting RSVP</span>
        </div>

        @* Event list *@
        <div>
            @for (var ei = 0; ei < _events.Count; ei++)
            {
                var evtIdx = ei;
                var evt = _events[evtIdx];
                var evtId = evt.Id;
                var isExpanded = _expanded == evt.Id;
                var config = _categoryConfig[evt.Category];

                <div class="@(evtIdx < _events.Count - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (_expanded == evtId ? "" : evtId))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@evt.Title</span>
                                @if (evt.Rsvpd)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">Going</BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Size="12" class="size-3" />
                                    @evt.Date
                                </span>
                                <span>@evt.Department</span>
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        var expandedEvtId = evt.Id;
                        <div class="border-t px-4 pb-3 pt-2">
                            <p class="mb-2 text-muted-foreground text-sm leading-relaxed">@evt.Description</p>
                            <div class="flex flex-col gap-1.5">
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideClockCn Size="12" class="size-3" />
                                    @evt.Time
                                </span>
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideMapPinCn Size="12" class="size-3" />
                                    @evt.Location
                                </span>
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideUsersCn Size="12" class="size-3" />
                                    @evt.Attendees/@evt.Capacity attending
                                </span>
                            </div>
                            <div class="mt-3">
                                <ButtonCn Variant="@(evt.Rsvpd ? ButtonVariant.Outline : ButtonVariant.Default)" Size="ButtonSize.Sm" class="h-7 text-xs" @onclick="@(() => ToggleRsvp(expandedEvtId))">
                                    @(evt.Rsvpd ? "Cancel RSVP" : "RSVP")
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _categoryConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Value.Dot)"></span>
                    @entry.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record CategoryConfig(string Dot, string Label);

    private class OfficeEvent
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Date { get; set; } = "";
        public string Time { get; set; } = "";
        public string Location { get; set; } = "";
        public string Category { get; set; } = "";
        public string Department { get; set; } = "";
        public int Attendees { get; set; }
        public int Capacity { get; set; }
        public string Description { get; set; } = "";
        public bool Rsvpd { get; set; }
    }

    private static readonly Dictionary<string, CategoryConfig> _categoryConfig = new()
    {
        ["social"] = new("bg-blue-500", "Social"),
        ["meeting"] = new("bg-violet-500", "All-Hands"),
        ["workshop"] = new("bg-amber-500", "Workshop"),
        ["celebration"] = new("bg-emerald-500", "Celebration"),
    };

    private List<OfficeEvent> _events =
    [
        new() { Id = "1", Title = "Friday Happy Hour", Date = "Mar 21, 2026", Time = "5:00 PM - 7:00 PM", Location = "Rooftop Lounge", Category = "social", Department = "Company-wide", Attendees = 34, Capacity = 50, Description = "Wind down the week with drinks and snacks on the rooftop. Bring a friend from another team.", Rsvpd = true },
        new() { Id = "2", Title = "Q1 All-Hands Meeting", Date = "Mar 24, 2026", Time = "10:00 AM - 11:30 AM", Location = "Main Auditorium", Category = "meeting", Department = "Company-wide", Attendees = 128, Capacity = 200, Description = "Q1 results review, product roadmap update, and team recognition awards.", Rsvpd = true },
        new() { Id = "3", Title = "Design Thinking Workshop", Date = "Mar 25, 2026", Time = "2:00 PM - 4:00 PM", Location = "Innovation Lab, 3rd Floor", Category = "workshop", Department = "Design", Attendees = 12, Capacity = 20, Description = "Hands-on workshop on design thinking methodology. Bring a notebook and your favorite pen.", Rsvpd = false },
        new() { Id = "4", Title = "March Birthday Celebration", Date = "Mar 27, 2026", Time = "3:00 PM - 4:00 PM", Location = "Break Room B", Category = "celebration", Department = "People Ops", Attendees = 22, Capacity = 40, Description = "Celebrating all March birthdays with cake and refreshments. Cards are on the welcome table.", Rsvpd = false },
        new() { Id = "5", Title = "Lunch & Learn: AI in Production", Date = "Mar 28, 2026", Time = "12:00 PM - 1:00 PM", Location = "Conference Room 4A", Category = "workshop", Department = "Engineering", Attendees = 18, Capacity = 30, Description = "Senior engineer Sarah presents lessons learned from deploying ML models at scale. Lunch provided.", Rsvpd = false },
    ];

    private string _expanded = "1";

    private int Upcoming => _events.Count(e => !e.Rsvpd);

    private void ToggleRsvp(string id)
    {
        var evt = _events.FirstOrDefault(e => e.Id == id);
        if (evt is not null)
        {
            evt.Attendees = evt.Rsvpd ? evt.Attendees - 1 : evt.Attendees + 1;
            evt.Rsvpd = !evt.Rsvpd;
        }
    }
}
