@* ============================================================
   Block: calendar-exercise-log
   Title: CalendarExerciseLog
   Description: An exercise and workout log calendar block for Next.js with session tracking, muscle group tags, and weekly volume stats using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-exercise-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Exercise Log</h2>
                <p class="text-muted-foreground text-xs">Week of Mar 14, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideDumbbellCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_weekSessions</span>
                <span class="text-muted-foreground text-xs">sessions</span>
            </div>
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideFlameCn Size="14" class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @_weekCalories.ToString("N0")
                </span>
                kcal burned
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideTimerCn Size="14" class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">
                    @_totalMinutes min
                </span>
                total
            </div>
        </div>

        @* Workout list *@
        <div>
            @for (var i = 0; i < _workouts.Length; i++)
            {
                var idx = i;
                var workout = _workouts[idx];
                var isExpanded = _expandedWorkout == workout.Id;
                var isLast = idx == _workouts.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => ToggleWorkout(workout.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@workout.Type</span>
                                <span class="text-muted-foreground text-xs">@workout.Day, @workout.Date</span>
                            </div>
                            <div class="mt-1 flex items-center gap-1.5">
                                @foreach (var mg in workout.MuscleGroups)
                                {
                                    <span class="@($"size-1.5 rounded-full {_muscleColors[mg]}")"></span>
                                }
                                <span class="ml-1 text-muted-foreground text-xs">@workout.Duration</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs tabular-nums">@workout.Calories kcal</span>
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20">
                            <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 px-4 py-2 text-muted-foreground text-xs font-medium">
                                <span>Exercise</span>
                                <span>Sets</span>
                                <span>Reps</span>
                                <span>Weight</span>
                            </div>
                            @foreach (var exercise in workout.Exercises)
                            {
                                <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 border-t border-border/50 px-4 py-2 text-sm">
                                    <span>@exercise.Name</span>
                                    <span class="text-muted-foreground text-xs tabular-nums">@exercise.Sets</span>
                                    <span class="text-muted-foreground text-xs tabular-nums">@exercise.Reps</span>
                                    <span class="text-muted-foreground text-xs tabular-nums">@exercise.Weight</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ExerciseItem(string Name, int Sets, string Reps, string Weight);
    private record Workout(string Id, string Date, string Day, string Type, string[] MuscleGroups, string Duration, int Calories, ExerciseItem[] Exercises);

    private static readonly Dictionary<string, string> _muscleColors = new()
    {
        ["chest"] = "bg-blue-500",
        ["back"] = "bg-emerald-500",
        ["legs"] = "bg-amber-500",
        ["shoulders"] = "bg-purple-500",
        ["arms"] = "bg-rose-500",
        ["core"] = "bg-cyan-500",
        ["cardio"] = "bg-orange-500",
    };

    private static readonly Workout[] _workouts =
    [
        new("1", "Mar 18", "Tue", "Upper Body Push", ["chest", "shoulders", "arms"], "55 min", 420,
        [
            new("Bench Press", 4, "8-10", "185 lbs"),
            new("Overhead Press", 3, "8-10", "115 lbs"),
            new("Incline Dumbbell Press", 3, "10-12", "65 lbs"),
            new("Tricep Dips", 3, "12-15", "BW"),
        ]),
        new("2", "Mar 17", "Mon", "Lower Body", ["legs", "core"], "60 min", 510,
        [
            new("Barbell Squat", 4, "6-8", "245 lbs"),
            new("Romanian Deadlift", 3, "8-10", "185 lbs"),
            new("Leg Press", 3, "10-12", "360 lbs"),
            new("Plank Hold", 3, "60s", "BW"),
        ]),
        new("3", "Mar 15", "Sat", "Cardio & Core", ["cardio", "core"], "40 min", 380,
        [
            new("Treadmill Run", 1, "25 min", "-"),
            new("Russian Twists", 3, "20", "25 lbs"),
            new("Hanging Leg Raises", 3, "12", "BW"),
        ]),
        new("4", "Mar 14", "Fri", "Upper Body Pull", ["back", "arms"], "50 min", 390,
        [
            new("Deadlift", 4, "5", "315 lbs"),
            new("Pull-ups", 4, "8-10", "BW+25"),
            new("Barbell Rows", 3, "8-10", "155 lbs"),
            new("Bicep Curls", 3, "12", "35 lbs"),
        ]),
    ];

    private string _expandedWorkout = "1";

    private int _weekSessions => _workouts.Length;
    private int _weekCalories => _workouts.Sum(w => w.Calories);
    private int _totalMinutes => _workouts.Sum(w => int.Parse(w.Duration.Split(' ')[0]));

    private void ToggleWorkout(string id)
    {
        _expandedWorkout = _expandedWorkout == id ? "" : id;
    }
}
