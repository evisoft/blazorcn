@* ============================================================
   Block: calendar-water-intake
   Title: CalendarWaterIntake
   Description: A water intake tracking calendar block for Next.js with daily hydration goals, glass counting, weekly trends, and reminder scheduling using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-water-intake.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="droplet" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Water Intake</span>
                    <p class="text-muted-foreground text-xs">Tuesday, Mar 24, 2026</p>
                </div>
            </div>
        </div>

        @* Today's progress *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-4">
                <div class="relative flex size-20 items-center justify-center">
                    <svg class="size-20 -rotate-90" viewBox="0 0 80 80">
                        <title>Water intake: @TodayTotal of @_todayGoal glasses</title>
                        <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="6" class="text-muted/40" />
                        <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="6"
                                stroke-linecap="round"
                                stroke-dasharray="@(FormattableString.Invariant($"{CircleCircumference:F3}"))"
                                stroke-dashoffset="@(FormattableString.Invariant($"{CircleCircumference * (1 - Pct / 100.0):F3}"))"
                                class="@(Pct >= 100 ? "text-emerald-500" : "text-blue-500")" />
                    </svg>
                    <span class="absolute font-semibold text-lg tabular-nums">@TodayTotal</span>
                </div>
                <div class="flex-1">
                    <div class="flex items-baseline gap-1">
                        <span class="font-semibold text-2xl tabular-nums">@Pct%</span>
                        <span class="text-muted-foreground text-xs">of daily goal</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @TodayTotal of @_todayGoal glasses (@(TodayTotal * 8) oz)
                    </p>
                    @if (TodayTotal >= _todayGoal)
                    {
                        <p class="mt-1 text-emerald-600 text-xs dark:text-emerald-400">Goal reached!</p>
                    }
                    else
                    {
                        <p class="mt-1 text-muted-foreground text-xs">
                            @(_todayGoal - TodayTotal) more to go
                        </p>
                    }
                </div>
            </div>
        </div>

        @* Time slots *@
        <div class="border-b">
            @for (int i = 0; i < _timeSlots.Count; i++)
            {
                var slot = _timeSlots[i];
                var slotId = slot.Id;
                var isLast = i == _timeSlots.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-2">
                        <span class="w-14 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @slot.Time
                        </span>
                        <span class="min-w-0 flex-1 text-muted-foreground text-xs">@slot.Label</span>
                        <div class="flex items-center gap-1">
                            @for (int gi = 0; gi < slot.Glasses; gi++)
                            {
                                <LucideIconCn Name="droplet" Size="14" Class="size-3.5 text-blue-500" />
                            }
                            @if (slot.Glasses == 0)
                            {
                                <span class="text-muted-foreground/40 text-xs">—</span>
                            }
                        </div>
                        <div class="flex items-center gap-0.5">
                            <ButtonCn aria-label="@($"Remove a glass at {slot.Time}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="@(() => RemoveGlass(slotId))">
                                <LucideIconCn Name="minus" Size="12" Class="size-3" />
                            </ButtonCn>
                            <span class="w-4 text-center font-mono text-xs tabular-nums">
                                @slot.Glasses
                            </span>
                            <ButtonCn aria-label="@($"Add a glass at {slot.Time}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="@(() => AddGlass(slotId))">
                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Weekly trends *@
        <div class="px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Last 7 days</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    @DaysMetGoal/7 days goal met · @WeekTotal/@WeekGoal total
                </span>
            </div>
            <div class="flex items-end gap-2">
                @foreach (var day in _week)
                {
                    var barHeight = Math.Max((double)day.Glasses / MaxGlasses * 36, 4);
                    var metGoal = day.Glasses >= day.Goal;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="text-muted-foreground text-[10px] tabular-nums">
                            @day.Glasses
                        </span>
                        <div class="@($"w-full rounded-sm {(metGoal ? "bg-blue-500/50" : "bg-muted")}")"
                             style="@($"height:{barHeight:F0}px")" />
                        <span class="text-muted-foreground text-[10px]">@day.Day</span>
                    </div>
                }
            </div>
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500" />
                Goal met
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-muted" />
                Below goal
            </span>
            <span class="text-muted-foreground text-xs">1 glass = 8 oz</span>
        </div>
    </div>
</section>

@code {
    private readonly int _todayGoal = 8;

    private class TimeSlot
    {
        public string Id { get; init; } = "";
        public string Time { get; init; } = "";
        public int Glasses { get; set; }
        public string Label { get; init; } = "";
    }

    private record DayLog(string Day, string Date, int Glasses, int Goal);

    private List<TimeSlot> _timeSlots =
    [
        new() { Id = "t1", Time = "7:00 AM", Glasses = 1, Label = "Morning" },
        new() { Id = "t2", Time = "9:00 AM", Glasses = 1, Label = "Mid-morning" },
        new() { Id = "t3", Time = "11:00 AM", Glasses = 1, Label = "Late morning" },
        new() { Id = "t4", Time = "12:30 PM", Glasses = 1, Label = "Lunch" },
        new() { Id = "t5", Time = "2:30 PM", Glasses = 1, Label = "Afternoon" },
        new() { Id = "t6", Time = "4:30 PM", Glasses = 0, Label = "Late afternoon" },
        new() { Id = "t7", Time = "6:30 PM", Glasses = 0, Label = "Evening" },
        new() { Id = "t8", Time = "8:30 PM", Glasses = 0, Label = "Night" },
    ];

    private static readonly DayLog[] _week =
    [
        new("Mon", "Mar 17", 8, 8),
        new("Tue", "Mar 18", 7, 8),
        new("Wed", "Mar 19", 9, 8),
        new("Thu", "Mar 20", 6, 8),
        new("Fri", "Mar 21", 8, 8),
        new("Sat", "Mar 22", 5, 8),
        new("Sun", "Mar 23", 7, 8),
    ];

    private int TodayTotal => _timeSlots.Sum(s => s.Glasses);
    private int Pct => Math.Min((int)Math.Round((double)TodayTotal / _todayGoal * 100), 100);
    private int WeekTotal => _week.Sum(d => d.Glasses);
    private int WeekGoal => _week.Sum(d => d.Goal);
    private int DaysMetGoal => _week.Count(d => d.Glasses >= d.Goal);
    private int MaxGlasses => Math.Max(_week.Max(d => d.Glasses), _todayGoal);
    private double CircleCircumference => 2 * Math.PI * 34;

    private void AddGlass(string slotId)
    {
        var slot = _timeSlots.FirstOrDefault(s => s.Id == slotId);
        if (slot is not null) slot.Glasses++;
    }

    private void RemoveGlass(string slotId)
    {
        var slot = _timeSlots.FirstOrDefault(s => s.Id == slotId);
        if (slot is not null && slot.Glasses > 0) slot.Glasses--;
    }
}
