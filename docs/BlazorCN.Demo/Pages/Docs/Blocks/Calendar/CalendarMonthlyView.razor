@* ============================================================
   Block: calendar-monthly-view
   Title: Calendar Monthly View
   Description: A full month calendar grid with event dot indicators, interactive day selection, and an event list sidebar built with React, Next.js, shadcn/ui, and Tailwind CSS
   Long Description: Week view with hourly time slots
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-monthly-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">March 2026</span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn aria-label="Previous month" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronLeftCn Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Today</ButtonCn>
                <ButtonCn aria-label="Next month" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronRightCn Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        <div class="flex">
            @* Calendar grid *@
            <div class="flex-1 border-r">
                <div class="grid grid-cols-7 border-b">
                    @foreach (var day in _weekdays)
                    {
                        <div class="px-1 py-2 text-center text-muted-foreground text-xs">@day</div>
                    }
                </div>

                <div class="grid grid-cols-7">
                    @* Leading days *@
                    @for (int d = 27; d <= 28; d++)
                    {
                        <div class="flex min-h-16 flex-col items-center border-b border-r p-1 last:border-r-0">
                            <span class="font-medium text-muted-foreground/40 text-xs tabular-nums">@d</span>
                        </div>
                    }

                    @* Current month *@
                    @for (int d = 1; d <= 31; d++)
                    {
                        var day = d;
                        var dateKey = $"2026-03-{day:D2}";
                        _events.TryGetValue(dateKey, out var dayEvents);
                        var evts = dayEvents ?? [];
                        var isSelected = dateKey == _selectedDate;
                        var isToday = dateKey == "2026-03-18";

                        <button type="button"
                                @onclick="@(() => _selectedDate = dateKey)"
                                class="@($"flex min-h-16 flex-col items-center border-b border-r p-1 transition-colors last:border-r-0 hover:bg-muted/50 {(isSelected ? "bg-muted/50" : "")}")">
                            <span class="@($"flex size-6 items-center justify-center rounded-full font-medium text-xs tabular-nums {(isToday ? "bg-foreground text-background" : isSelected ? "text-foreground" : "text-muted-foreground")}")">
                                @day
                            </span>
                            @if (evts.Length > 0)
                            {
                                <div class="mt-1 flex items-center gap-0.5">
                                    @foreach (var evt in evts.Take(3))
                                    {
                                        <span class="@($"size-1.5 rounded-full {GetCategoryDot(evt.Category)}")" />
                                    }
                                </div>
                            }
                        </button>
                    }

                    @* Trailing days *@
                    @for (int d = 1; d <= 4; d++)
                    {
                        <div class="flex min-h-16 flex-col items-center border-r p-1 last:border-r-0">
                            <span class="font-medium text-muted-foreground/40 text-xs tabular-nums">@d</span>
                        </div>
                    }
                </div>
            </div>

            @* Event sidebar *@
            <div class="w-64 shrink-0">
                <div class="border-b px-4 py-2">
                    <span class="font-medium text-sm">@_selectedDate[8..] March</span>
                    <span class="ml-2 text-muted-foreground text-xs">@SelectedEvents.Length event@(SelectedEvents.Length != 1 ? "s" : "")</span>
                </div>

                @if (SelectedEvents.Length == 0)
                {
                    <div class="flex flex-col items-center justify-center px-4 py-12 text-center">
                        <LucideCalendarCn Class="mb-2 size-5 text-muted-foreground/40" />
                        <span class="text-muted-foreground text-xs">No events scheduled</span>
                    </div>
                }
                else
                {
                    <div>
                        @for (int i = 0; i < SelectedEvents.Length; i++)
                        {
                            var evt = SelectedEvents[i];
                            var isLast = i >= SelectedEvents.Length - 1;
                            <div class="@($"px-4 py-3 {(isLast ? "" : "border-b")}")">
                                <div class="flex items-center gap-2">
                                    <span class="@($"size-1.5 shrink-0 rounded-full {GetCategoryDot(evt.Category)}")" />
                                    <span class="font-medium text-sm">@evt.Title</span>
                                </div>
                                <div class="mt-1.5 flex flex-col gap-1 pl-3.5">
                                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideClockCn Class="size-3" />
                                        @evt.Time
                                    </span>
                                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideMapPinCn Class="size-3" />
                                        @evt.Location
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-1 w-fit font-normal text-xs">
                                        @GetCategoryLabel(evt.Category)
                                    </BadgeCn>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string _selectedDate = "2026-03-17";

    private record CalendarEvent(string Id, string Title, string Time, string Location, string Category);

    private CalendarEvent[] SelectedEvents => _events.TryGetValue(_selectedDate, out var evts) ? evts : [];

    private static readonly string[] _weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private static readonly Dictionary<string, CalendarEvent[]> _events = new()
    {
        ["2026-03-02"] = [new("1", "Sprint Planning", "9:00 AM", "Room 4A", "meeting")],
        ["2026-03-05"] = [new("2", "Design Review", "2:00 PM", "Virtual", "meeting"), new("3", "Dentist Appointment", "4:30 PM", "Downtown Dental", "personal")],
        ["2026-03-10"] = [new("4", "Q1 Report Due", "5:00 PM", "Finance Portal", "deadline")],
        ["2026-03-12"] = [new("5", "Team Standup", "10:00 AM", "Slack Huddle", "meeting"), new("6", "Lunch with Sarah", "12:30 PM", "Cafe Milano", "personal")],
        ["2026-03-17"] = [new("7", "Client Presentation", "11:00 AM", "Board Room", "meeting"), new("8", "Project Milestone", "End of Day", "Jira", "deadline"), new("9", "Yoga Class", "6:00 PM", "Studio B", "personal")],
        ["2026-03-22"] = [new("10", "1:1 with Manager", "3:00 PM", "Virtual", "meeting")],
        ["2026-03-28"] = [new("11", "Release Deadline", "11:59 PM", "GitHub", "deadline")],
    };

    private static string GetCategoryDot(string category) => category switch
    {
        "meeting" => "bg-blue-500",
        "personal" => "bg-emerald-500",
        "deadline" => "bg-amber-500",
        _ => "bg-zinc-400"
    };

    private static string GetCategoryLabel(string category) => category switch
    {
        "meeting" => "Meeting",
        "personal" => "Personal",
        "deadline" => "Deadline",
        _ => category
    };
}
