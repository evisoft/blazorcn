@* ============================================================
   Block: calendar-due-dates
   Title: CalendarDueDates
   Description: An assignment due date tracker block for Next.js with priority levels, subject tags, and countdown indicators using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-due-dates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Due Dates</h2>
                <p class="text-muted-foreground text-xs">Spring Semester 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="book-open" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_upcoming.Length</span>
                <span class="text-muted-foreground text-xs">pending</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            @if (_urgentCount > 0)
            {
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-red-500" />
                    <span class="font-semibold text-red-600 text-sm tabular-nums">@_urgentCount</span>
                    due soon
                </div>
            }
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">@_submitted.Length</span>
                submitted
            </div>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            <ButtonCn Variant="@(_filter == "upcoming" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="SelectUpcoming">
                Upcoming (@_upcoming.Length)
            </ButtonCn>
            <ButtonCn Variant="@(_filter == "submitted" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="SelectSubmitted">
                Submitted (@_submitted.Length)
            </ButtonCn>
        </div>

        <div>
            @for (var i = 0; i < _filtered.Length; i++)
            {
                var assignment = _filtered[i];
                var isLast = i == _filtered.Length - 1;
                var pDot = assignment.Priority switch { "high" => "bg-red-500", "medium" => "bg-amber-500", _ => "bg-blue-500" };
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", pDot)"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@assignment.Title</span>
                        <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @assignment.Subject
                            </BadgeCn>
                            <span>·</span>
                            <span>Weight: @assignment.Weight</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-0.5 shrink-0">
                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            @assignment.DueDate
                        </span>
                        @if (assignment.Status == "submitted")
                        {
                            <span class="flex items-center gap-1 text-emerald-600 text-xs">
                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                Submitted
                            </span>
                        }
                        else
                        {
                            <span class="@Cn.Merge("text-xs tabular-nums", assignment.DaysLeft <= 2 ? "font-medium text-red-600" : "text-muted-foreground")">
                                @(assignment.DaysLeft == 0 ? "Due today" : assignment.DaysLeft == 1 ? "1 day left" : $"{assignment.DaysLeft} days left")
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _filter = "upcoming";

    private void SelectUpcoming() => _filter = "upcoming";
    private void SelectSubmitted() => _filter = "submitted";

    private Assignment[] _upcoming => _assignments.Where(a => a.Status != "submitted").ToArray();
    private Assignment[] _submitted => _assignments.Where(a => a.Status == "submitted").ToArray();
    private Assignment[] _filtered => _filter == "upcoming" ? _upcoming : _submitted;
    private int _urgentCount => _upcoming.Count(a => a.DaysLeft <= 2);

    private record Assignment(string Id, string Title, string Subject, string DueDate, int DaysLeft, string Priority, string Status, string Weight);

    private static readonly Assignment[] _assignments =
    [
        new("1", "Research Paper: Machine Learning Ethics", "Computer Science", "Mar 19", 1, "high", "in-progress", "25%"),
        new("2", "Lab Report: Chemical Reactions", "Chemistry", "Mar 20", 2, "high", "in-progress", "15%"),
        new("3", "Problem Set 7: Linear Algebra", "Mathematics", "Mar 22", 4, "medium", "pending", "10%"),
        new("4", "Group Presentation: Market Analysis", "Business", "Mar 25", 7, "medium", "pending", "20%"),
        new("5", "Essay: Postmodern Literature", "English", "Mar 28", 10, "low", "pending", "15%"),
        new("6", "Midterm Study Guide", "Physics", "Mar 30", 12, "low", "pending", "5%"),
        new("7", "Database Design Project", "Computer Science", "Mar 15", -3, "high", "submitted", "30%"),
        new("8", "Case Study Analysis", "Business", "Mar 14", -4, "medium", "submitted", "15%"),
    ];
}
