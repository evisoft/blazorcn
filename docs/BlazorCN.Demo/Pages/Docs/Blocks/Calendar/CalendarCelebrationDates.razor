@* ============================================================
   Block: calendar-celebration-dates
   Title: CalendarCelebrationDates
   Description: A company celebration calendar block for Next.js with birthdays, work anniversaries, team events, and milestone badges using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-celebration-dates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Celebrations</h2>
                <p class="text-muted-foreground text-xs">March 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="gift" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_celebrations.Length</span>
                <span class="text-muted-foreground text-xs">this month</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="party-popper" Size="14" Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @_thisWeek.Length
                </span>
                this week
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                Next: @_celebrations[0].Name on @_celebrations[0].Date
            </span>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            <ButtonCn Variant="@(_filter == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                      Size="ButtonSize.Sm"
                      Class="h-6 px-2 text-xs"
                      @onclick="@(() => _filter = "all")">
                All
            </ButtonCn>
            @foreach (var typeKey in _typeKeys)
            {
                var key = typeKey;
                <ButtonCn Variant="@(_filter == key ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-xs"
                          @onclick="@(() => _filter = key)">
                    <span class="@($"size-1.5 rounded-full {GetDot(key)}")" />
                    @GetLabel(key)
                </ButtonCn>
            }
        </div>

        <div>
            @for (int i = 0; i < FilteredCelebrations.Length; i++)
            {
                var celebration = FilteredCelebrations[i];
                var isLast = i == FilteredCelebrations.Length - 1;
                <div class="@($"flex items-center gap-3 px-4 py-3 {(isLast ? "" : "border-b")}")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @celebration.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@celebration.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                <LucideIconCn Name="@GetIconName(celebration.Type)" Size="12" Class="mr-1 size-3" />
                                @GetLabel(celebration.Type)
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@celebration.Detail</p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                        @celebration.Date
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _filter = "all";

    private record Celebration(string Id, string Name, string Type, string Date, string Detail, string Initials);

    private static readonly Celebration[] _celebrations =
    [
        new("1",  "Sarah Chen",            "birthday",   "Mar 18", "Turning 30",           "SC"),
        new("2",  "Marcus Johnson",         "anniversary","Mar 19", "5 years at company",   "MJ"),
        new("3",  "Team Offsite",           "team-event", "Mar 21", "Annual team retreat",  "TO"),
        new("4",  "Elena Rodriguez",        "milestone",  "Mar 22", "100th customer closed","ER"),
        new("5",  "James O'Brien",          "birthday",   "Mar 24", "Turning 28",           "JO"),
        new("6",  "Priya Sharma",           "anniversary","Mar 25", "3 years at company",   "PS"),
        new("7",  "David Kim",              "anniversary","Mar 27", "10 years at company",  "DK"),
        new("8",  "Quarterly Celebration",  "team-event", "Mar 28", "Q1 wrap-up party",     "QC"),
        new("9",  "Lisa Novak",             "birthday",   "Mar 30", "Turning 35",           "LN"),
        new("10", "Alex Tanaka",            "milestone",  "Mar 31", "Promotion to Senior",  "AT"),
    ];

    private static readonly string[] _thisWeekDates = ["Mar 18", "Mar 19", "Mar 20", "Mar 21", "Mar 22"];
    private static readonly Celebration[] _thisWeek = _celebrations.Where(c => _thisWeekDates.Contains(c.Date)).ToArray();

    private static readonly string[] _typeKeys = ["birthday", "anniversary", "milestone", "team-event"];

    private Celebration[] FilteredCelebrations =>
        _filter == "all" ? _celebrations : _celebrations.Where(c => c.Type == _filter).ToArray();

    private static string GetLabel(string type) => type switch
    {
        "birthday"   => "Birthday",
        "anniversary"=> "Anniversary",
        "milestone"  => "Milestone",
        "team-event" => "Team Event",
        _            => type
    };

    private static string GetDot(string type) => type switch
    {
        "birthday"   => "bg-rose-500",
        "anniversary"=> "bg-blue-500",
        "milestone"  => "bg-amber-500",
        "team-event" => "bg-emerald-500",
        _            => "bg-muted-foreground"
    };

    private static string GetIconName(string type) => type switch
    {
        "birthday"   => "cake",
        "anniversary"=> "star",
        "milestone"  => "trophy",
        "team-event" => "party-popper",
        _            => "circle"
    };
}
