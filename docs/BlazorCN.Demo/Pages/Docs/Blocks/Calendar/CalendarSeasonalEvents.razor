@* ============================================================
   Block: calendar-seasonal-events
   Title: CalendarSeasonalEvents
   Description: A seasonal and holiday event planner calendar block for Next.js with holiday tracking, seasonal campaigns, team celebrations, and countdown displays using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-seasonal-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePartyPopperCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Seasonal Events</span>
                    <p class="text-muted-foreground text-xs">
                        Spring 2026 · @_events.Length events planned
                    </p>
                </div>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_thisMonth this week</span>
        </div>

        <div>
            @for (var i = 0; i < _events.Length; i++)
            {
                var idx = i;
                var evt = _events[idx];
                var isExpanded = _expanded == evt.Id;
                var config = _typeConfig[evt.Type];

                <div class="@(idx < _events.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (isExpanded ? "" : evt.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@evt.Name</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Size="12" class="size-3" />
                                    @evt.Date
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @config.Label
                                </BadgeCn>
                            </div>
                        </div>
                        <span class="@Cn.Merge("shrink-0 text-xs font-medium tabular-nums", UrgencyColor(evt.DaysUntil))">
                            @UrgencyLabel(evt.DaysUntil)
                        </span>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            <p class="mb-2 text-muted-foreground text-sm leading-relaxed">
                                @evt.Description
                            </p>
                            <div class="mb-2 rounded-md bg-muted/50 p-3">
                                <span class="text-muted-foreground text-xs">Preparation tasks</span>
                                <ul class="mt-1 space-y-0.5">
                                    @foreach (var task in evt.Tasks)
                                    {
                                        <li class="flex items-center gap-1.5 text-xs">
                                            <LucideStarCn Size="12" class="size-3 text-muted-foreground/40" />
                                            @task
                                        </li>
                                    }
                                </ul>
                            </div>
                            @if (!string.IsNullOrEmpty(evt.Budget))
                            {
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideGiftCn Size="12" class="size-3" />
                                    Budget: @evt.Budget
                                </span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var key in _typeOrder)
            {
                var tc = _typeConfig[key];
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", tc.Dot)"></span>
                    @tc.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record TypeConfig(string Dot, string Label);
    private record SeasonalEvent(string Id, string Name, string Date, string Type, int DaysUntil, string Description, string[] Tasks, string? Budget = null);

    private static readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["holiday"]     = new("bg-red-500",     "Holiday"),
        ["campaign"]    = new("bg-blue-500",     "Campaign"),
        ["celebration"] = new("bg-violet-500",   "Celebration"),
        ["seasonal"]    = new("bg-emerald-500",  "Seasonal"),
    };

    private static readonly string[] _typeOrder = ["holiday", "campaign", "celebration", "seasonal"];

    private static readonly SeasonalEvent[] _events =
    [
        new("1", "Spring Equinox Office Party", "Mar 20, 2026", "celebration", 0,
            "Company-wide spring celebration. Outdoor patio event with food trucks and live music.",
            ["Book food trucks", "Set up patio lighting", "Send invitations", "Arrange entertainment"],
            "$3,200"),
        new("2", "Easter Weekend", "Apr 5 - Apr 6, 2026", "holiday", 12,
            "Company closed Friday and Monday. Easter egg hunt event for employees with children on Thursday.",
            ["Confirm office closure", "Send holiday notice", "Organize egg hunt", "Order supplies"]),
        new("3", "Spring Sale Campaign", "Apr 1 - Apr 15, 2026", "campaign", 8,
            "Annual spring promotion across all channels. 20% off selected items with seasonal landing page.",
            ["Finalize creative assets", "Set up email sequences", "Update landing page", "Brief sales team"],
            "$8,500"),
        new("4", "Earth Day Initiative", "Apr 22, 2026", "seasonal", 29,
            "Sustainability awareness day. Volunteer park cleanup, office green audit, and social media campaign.",
            ["Coordinate volunteer groups", "Plan social media content", "Order eco-friendly swag"],
            "$1,500"),
        new("5", "Mother's Day Campaign", "May 10, 2026", "campaign", 47,
            "Gift guide campaign with curated product bundles and special discount codes for subscribers.",
            ["Create gift guide content", "Design email templates", "Set up discount codes", "Schedule social posts"],
            "$5,000"),
        new("6", "Memorial Day Weekend", "May 25, 2026", "holiday", 62,
            "Company closed Monday. Summer hours begin the following week.",
            ["Send holiday notice", "Update office hours", "Plan summer kickoff message"]),
    ];

    private int _thisMonth => _events.Count(e => e.DaysUntil <= 14);
    private string _expanded = "1";

    private static string UrgencyColor(int days)
    {
        if (days == 0) return "text-red-600 dark:text-red-400";
        if (days <= 7) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }

    private static string UrgencyLabel(int days)
    {
        if (days == 0) return "Today";
        if (days == 1) return "Tomorrow";
        return $"{days} days";
    }
}
