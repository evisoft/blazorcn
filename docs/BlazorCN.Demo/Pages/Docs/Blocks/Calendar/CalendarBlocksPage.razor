    private static int GetDaysInMonth(int year, int month) =>
        DateTime.DaysInMonth(year, month + 1);

    private static int GetFirstDayOfWeek(int year, int month) =>
        (int)new DateTime(year, month + 1, 1).DayOfWeek;

    private static int?[] BuildMonthGrid(int year, int month)
    {
        var daysInMonth = GetDaysInMonth(year, month);
        var firstDay = GetFirstDayOfWeek(year, month);
        var cells = new List<int?>();

        for (int i = 0; i < firstDay; i++)
            cells.Add(null);
        for (int d = 1; d <= daysInMonth; d++)
            cells.Add(d);

        return cells.ToArray();
    }

    private static string DensityColor(int count) => count switch
    {
        0 => ""bg-muted/30"",
        1 => ""bg-primary/15"",
        <= 3 => ""bg-primary/30"",
        _ => ""bg-primary/50""
    };
