    private const string CalendarYearOverviewCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div>
                <span class=""font-medium text-sm"">Year Overview</span>
                <p class=""mt-0.5 text-muted-foreground text-xs"">
                    @_totalEvents events across @_eventDensity.Count days
                </p>
            </div>
            <div class=""flex items-center gap-1"">
                <ButtonCn aria-label=""Previous year"" Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-7 w-7 p-0"">
                    <LucideChevronLeftCn Class=""size-4"" />
                </ButtonCn>
                <span class=""rounded-full bg-muted px-2 py-0.5 font-medium text-sm tabular-nums"">
                    @Year
                </span>
                <ButtonCn aria-label=""Next year"" Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-7 w-7 p-0"">
                    <LucideChevronRightCn Class=""size-4"" />
                </ButtonCn>
            </div>
        </div>

        @* Month grids *@
        <div class=""grid grid-cols-3 gap-0 sm:grid-cols-4"">
            @for (int monthIndex = 0; monthIndex < 12; monthIndex++)
            {
                var mi = monthIndex;
                var grid = BuildMonthGrid(Year, mi);
                <div class=""border-b border-r p-3 last:border-r-0 [&:nth-child(3n)]:border-r-0 sm:[&:nth-child(3n)]:border-r sm:[&:nth-child(4n)]:border-r-0"">
                    <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">
                        @_monthNames[mi]
                    </span>
                    @* Day headers *@
                    <div class=""mb-0.5 grid grid-cols-7 gap-px"">
                        @for (int di = 0; di < _dayLabels.Length; di++)
                        {
                            <span class=""text-center text-muted-foreground/60 text-[9px]"">@_dayLabels[di]</span>
                        }
                    </div>
                    @* Day cells *@
                    <div class=""grid grid-cols-7 gap-px"">
                        @foreach (var day in grid)
                        {
                            @if (day == null)
                            {
                                <div class=""aspect-square"" />
                            }
                            else
                            {
                                var dateKey = $""{Year}-{(mi + 1):D2}-{day:D2}"";
                                _eventDensity.TryGetValue(dateKey, out var count);
                                <div class=""@($""aspect-square rounded-sm {DensityColor(count)}"")""
                                     title=""@($""{dateKey}: {count} events"")"" />
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @* Legend *@
        <div class=""flex items-center justify-between border-t bg-muted/20 px-4 py-2"">
            <div class=""flex items-center gap-2"">
                <span class=""text-muted-foreground text-xs"">Less</span>
                <span class=""size-3 rounded-sm bg-muted/30"" />
                <span class=""size-3 rounded-sm bg-primary/15"" />
                <span class=""size-3 rounded-sm bg-primary/30"" />
                <span class=""size-3 rounded-sm bg-primary/50"" />
                <span class=""text-muted-foreground text-xs"">More</span>
            </div>
            @if (_busiestDay != null)
            {
                <span class=""text-muted-foreground text-xs"">
                    Busiest: @_busiestDay.Value.Key[5..] (@_busiestDay.Value.Value events)
                </span>
            }
        </div>
    </div>
</section>

