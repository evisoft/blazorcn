    private const string CalendarMeetingSchedulerCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div>
                <span class=""font-medium text-sm"">Schedule Meeting</span>
