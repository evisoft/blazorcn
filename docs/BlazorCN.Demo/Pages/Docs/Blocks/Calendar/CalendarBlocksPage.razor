                                        <span class=""block truncate text-muted-foreground text-[10px]"">@session.Instructor</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Legend *@
        <div class=""flex flex-wrap items-center gap-3 border-t px-4 py-2"">
            @foreach (var kvp in _subjectStyles)
            {
                <span class=""flex items-center gap-1.5 text-muted-foreground text-xs"">
                    <span class=""@Cn.Merge(""size-2 rounded-sm"", kvp.Value.Bg, ""ring-1 ring-inset ring-black/5"")""></span>
                    @kvp.Key
                </span>
            }
        </div>
    </div>
</section>

