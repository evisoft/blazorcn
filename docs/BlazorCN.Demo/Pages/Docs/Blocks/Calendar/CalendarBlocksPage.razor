        </div>

        @* Participants *@
        <div class=""border-b px-4 py-3"">
            <div class=""mb-2 flex items-center gap-1.5"">
                <LucideUsersCn Class=""size-3.5 text-muted-foreground"" />
                <span class=""text-muted-foreground text-xs"">Participants</span>
            </div>
            <div class=""flex flex-wrap gap-2"">
                @foreach (var p in _participants)
                {
                    <div class=""flex items-center gap-1.5 rounded-full bg-muted px-2.5 py-1"">
                        <span class=""flex size-5 items-center justify-center rounded-full bg-card text-[9px] font-medium"">@p.Initials</span>
                        <span class=""text-xs"">@p.Name</span>
                    </div>
                }
            </div>
        </div>

        @* Availability grid *@
        <div class=""border-b px-4 py-3"">
            <span class=""mb-2 block text-muted-foreground text-xs"">Availability</span>
            <div class=""overflow-x-auto"">
                <div class=""min-w-[500px]"">
                    <div class=""mb-1 flex"">
                        <div class=""w-20 shrink-0"" />
                        @foreach (var h in _hours)
                        {
                            <div class=""flex-1 text-center"">
                                <span class=""text-muted-foreground text-[10px] tabular-nums"">@FormatHourShort(h)</span>
                            </div>
                        }
                    </div>
                    @foreach (var p in _participants)
                    {
                        <div class=""mb-1 flex items-center"">
                            <div class=""flex w-20 shrink-0 items-center gap-1.5"">
                                <span class=""flex size-5 items-center justify-center rounded-full bg-muted text-[9px] font-medium"">@p.Initials</span>
                                <span class=""truncate text-xs"">@p.Name.Split(' ')[0]</span>
                            </div>
                            <div class=""flex flex-1 gap-px"">
                                @foreach (var h in _hours)
                                {
                                    var isBusy = p.BusySlots.Contains(h);
                                    <div class=""@($""h-6 flex-1 rounded-sm {(isBusy ? ""bg-red-500/15"" : ""bg-emerald-500/15"")}"")""
                                         title=""@($""{p.Name}: {(isBusy ? ""Busy"" : ""Available"")} at {FormatHourShort(h)}"")"" />
                                }
                            </div>
                        </div>
                    }
                    <div class=""mt-2 flex items-center"">
                        <div class=""w-20 shrink-0"">
                            <span class=""text-muted-foreground text-[10px]"">All free</span>
                        </div>
                        <div class=""flex flex-1 gap-px"">
                            @foreach (var h in _hours)
                            {
                                var busyCount = _participants.Count(p => p.BusySlots.Contains(h));
                                var allFree = busyCount == 0;
                                <div class=""@($""flex h-6 flex-1 items-center justify-center rounded-sm {(allFree ? ""bg-emerald-500/20"" : busyCount <= 1 ? ""bg-amber-500/15"" : ""bg-red-500/10"")}"")"">
                                    <span class=""text-[9px] tabular-nums text-muted-foreground"">@(_participants.Length - busyCount)/@_participants.Length</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Suggested times *@
        <div class=""px-4 py-3"">
            <div class=""mb-2 flex items-center gap-1.5"">
                <LucideClockCn Class=""size-3.5 text-muted-foreground"" />
                <span class=""text-muted-foreground text-xs"">Suggested times</span>
            </div>
            <div class=""space-y-1"">
                @foreach (var slot in _suggestedSlots)
                {
                    var isSelected = _selected == slot.Id;
                    var allAvailable = slot.AvailableCount == slot.TotalCount;
                    <button type=""button""
                            @onclick=""@(() => _selected = slot.Id)""
                            class=""@($""flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors {(isSelected ? ""bg-primary/5 ring-1 ring-primary/20"" : ""hover:bg-muted/50"")}"")"">
                        <span class=""@($""size-1.5 shrink-0 rounded-full {(allAvailable ? ""bg-emerald-500"" : ""bg-amber-500"")}"")"" />
