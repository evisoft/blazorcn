                        @for (var di = 0; di < _weekDays.Length; di++)
                        {
                            var dayIndex = di;
                            var session = _sessions.FirstOrDefault(s => s.TimeSlot == slot.Time && s.DayIndex == dayIndex);

                            <div class=""border-r p-1 last:border-r-0"">
