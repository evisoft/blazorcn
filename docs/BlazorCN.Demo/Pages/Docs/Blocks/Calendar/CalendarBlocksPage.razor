                        </div>
                    }
                </div>

                @* Time slots *@
                @for (var si = 0; si < _timeSlots.Length; si++)
                {
                    var slot = _timeSlots[si];
                    var isLast = si == _timeSlots.Length - 1;

                    <div class=""@Cn.Merge(""grid grid-cols-[4.5rem_repeat(5,1fr)]"", isLast ? """" : ""border-b"")"">
                        <div class=""border-r px-2 py-3"">
