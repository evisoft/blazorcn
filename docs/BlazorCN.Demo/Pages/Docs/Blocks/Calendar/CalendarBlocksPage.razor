    private const string CalendarAvailabilityPickerCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideClockCn Size=""16"" class=""size-4 text-muted-foreground"" />
                <span class=""font-medium text-sm"">Weekly Availability</span>
            </div>
            <div class=""flex items-center gap-2"">
                <span class=""text-muted-foreground text-xs tabular-nums"">
                    @_totalHours hr@(_totalHours != 1 ? ""s"" : """") / week
                </span>
                <ButtonCn
                    Variant=""ButtonVariant.Ghost""
                    Size=""ButtonSize.Sm""
                    class=""h-7 gap-1 px-2 text-xs""
                    @onclick=""ResetDays"">
                    <LucideRotateCcwCn Size=""12"" class=""size-3"" />
                    Reset
                </ButtonCn>
            </div>
        </div>

        @* Time slot header row *@
        <div class=""grid grid-cols-[7rem_repeat(9,1fr)] border-b"">
            <div class=""border-r px-3 py-2"">
                <span class=""text-muted-foreground text-xs"">Day</span>
            </div>
            @foreach (var slot in _timeSlots)
            {
                <div class=""border-r px-1 py-2 text-center last:border-r-0"">
                    <span class=""text-muted-foreground text-xs"">@slot</span>
                </div>
            }
        </div>

        @* Day rows *@
        @for (var di = 0; di < _days.Length; di++)
        {
            var dayIndex = di;
            var day = _days[dayIndex];
            <div class=""@Cn.Merge(""grid grid-cols-[7rem_repeat(9,1fr)]"", dayIndex < _days.Length - 1 ? ""border-b"" : """")"">
                @* Day label with switch *@
                <div class=""flex items-center gap-2 border-r px-3 py-2.5"">
                    <SwitchCn Checked=""@day.Enabled"" CheckedChanged=""@(val => ToggleDay(dayIndex, val))"" />
                    <span class=""@Cn.Merge(""text-xs"", day.Enabled ? ""font-medium"" : ""text-muted-foreground"")"">
                        @day.ShortDay
                    </span>
                </div>

                @* Time slot cells *@
                @foreach (var slot in _timeSlots)
                {
                    var isSelected = day.Enabled && day.Slots.Contains(slot);
                    <button
                        type=""button""
                        disabled=""@(!day.Enabled)""
                        @onclick=""@(() => ToggleSlot(dayIndex, slot))""
                        class=""@Cn.Merge(""border-r p-1 transition-colors last:border-r-0"", !day.Enabled ? ""cursor-not-allowed bg-muted/20"" : isSelected ? ""bg-emerald-500/15 hover:bg-emerald-500/25"" : ""hover:bg-muted/50"")"">
                        @if (isSelected)
                        {
                            <div class=""mx-auto size-2 rounded-full bg-emerald-500""></div>
                        }
                    </button>
                }
            </div>
        }

        @* Footer legend *@
        <div class=""flex items-center gap-4 border-t px-4 py-2"">
            <span class=""flex items-center gap-1.5 text-muted-foreground text-xs"">
                <span class=""size-2 rounded-full bg-emerald-500""></span>
                Available
            </span>
            <span class=""flex items-center gap-1.5 text-muted-foreground text-xs"">
                <span class=""size-2 rounded-full bg-muted""></span>
                Unavailable
            </span>
            <div class=""ml-auto"">
                <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" class=""h-7 text-xs"">
                    Save Changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private class DayAvailability
    {
        public string ShortDay { get; set; } = """";
        public bool Enabled { get; set; }
        public HashSet<string> Slots { get; set; } = new();
    }

    private static readonly string[] _timeSlots = [""9 AM"", ""10 AM"", ""11 AM"", ""12 PM"", ""1 PM"", ""2 PM"", ""3 PM"", ""4 PM"", ""5 PM""];

    private DayAvailability[] _days = CreateInitialDays();

    private static DayAvailability[] CreateInitialDays() =>
    [
        new() { ShortDay = ""Mon"", Enabled = true, Slots = new([""9 AM"", ""10 AM"", ""11 AM"", ""2 PM"", ""3 PM""]) },
        new() { ShortDay = ""Tue"", Enabled = true, Slots = new([""9 AM"", ""10 AM"", ""11 AM"", ""1 PM"", ""2 PM"", ""3 PM"", ""4 PM""]) },
        new() { ShortDay = ""Wed"", Enabled = true, Slots = new([""10 AM"", ""11 AM"", ""2 PM"", ""3 PM"", ""4 PM""]) },
        new() { ShortDay = ""Thu"", Enabled = true, Slots = new([""9 AM"", ""10 AM"", ""11 AM"", ""1 PM"", ""2 PM""]) },
        new() { ShortDay = ""Fri"", Enabled = true, Slots = new([""9 AM"", ""10 AM""]) },
        new() { ShortDay = ""Sat"", Enabled = false, Slots = new() },
        new() { ShortDay = ""Sun"", Enabled = false, Slots = new() },
    ];

    private int _totalHours => _days.Where(d => d.Enabled).Sum(d => d.Slots.Count);

    private void ToggleDay(int index, bool enabled)
    {
        _days[index].Enabled = enabled;
    }

    private void ToggleSlot(int dayIndex, string slot)
    {
        var day = _days[dayIndex];
        if (!day.Enabled) return;
        if (!day.Slots.Remove(slot))
            day.Slots.Add(slot);
    }

    private void ResetDays()
    {
        _days = CreateInitialDays();
    }
}";
