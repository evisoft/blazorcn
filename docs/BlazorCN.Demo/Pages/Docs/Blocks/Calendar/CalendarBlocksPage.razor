                        </span>
                        <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""ml-auto font-normal text-xs"">
                            @slot.AvailableCount/@slot.TotalCount available
                        </BadgeCn>
                        @if (isSelected)
                        {
                            <LucideCheckCn Class=""size-3.5 text-primary"" />
                        }
                    </button>
                }
            </div>
        </div>

        @* Action *@
        <div class=""border-t px-4 py-3"">
            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-8 w-full text-xs"" Disabled=""@(_selected == null)"">
                Schedule Meeting
            </ButtonCn>
        </div>
    </div>
</section>

