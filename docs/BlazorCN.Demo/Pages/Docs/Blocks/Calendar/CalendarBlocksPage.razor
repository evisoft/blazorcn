@code {
    private class DayAvailability
    {
        public string ShortDay { get; set; } = """";
        public bool Enabled { get; set; }
        public HashSet<string> Slots { get; set; } = new();
    }

    private static readonly string[] _timeSlots = [""9 AM"", ""10 AM"", ""11 AM"", ""12 PM"", ""1 PM"", ""2 PM"", ""3 PM"", ""4 PM"", ""5 PM""];

    private DayAvailability[] _days = CreateInitialDays();

    private static DayAvailability[] CreateInitialDays() =>
    [
        new() { ShortDay = ""Mon"", Enabled = true, Slots = new([""9 AM"", ""10 AM"", ""11 AM"", ""2 PM"", ""3 PM""]) },
        new() { ShortDay = ""Tue"", Enabled = true, Slots = new([""9 AM"", ""10 AM"", ""11 AM"", ""1 PM"", ""2 PM"", ""3 PM"", ""4 PM""]) },
        new() { ShortDay = ""Wed"", Enabled = true, Slots = new([""10 AM"", ""11 AM"", ""2 PM"", ""3 PM"", ""4 PM""]) },
        new() { ShortDay = ""Thu"", Enabled = true, Slots = new([""9 AM"", ""10 AM"", ""11 AM"", ""1 PM"", ""2 PM""]) },
        new() { ShortDay = ""Fri"", Enabled = true, Slots = new([""9 AM"", ""10 AM""]) },
        new() { ShortDay = ""Sat"", Enabled = false, Slots = new() },
        new() { ShortDay = ""Sun"", Enabled = false, Slots = new() },
    ];

    private int _totalHours => _days.Where(d => d.Enabled).Sum(d => d.Slots.Count);

    private void ToggleDay(int index, bool enabled)
    {
        _days[index].Enabled = enabled;
    }

    private void ToggleSlot(int dayIndex, string slot)
    {
        var day = _days[dayIndex];
        if (!day.Enabled) return;
        if (!day.Slots.Remove(slot))
            day.Slots.Add(slot);
    }

    private void ResetDays()
    {
        _days = CreateInitialDays();
    }
}";

