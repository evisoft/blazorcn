@* ============================================================
   Block: calendar-daily-standup
   Title: CalendarDailyStandup
   Description: A daily standup schedule block for Next.js with team member updates, blockers, and time slots using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-daily-standup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Daily Standup</h2>
                <p class="text-muted-foreground text-xs">Wednesday, Mar 18, 2026 — 9:30 AM</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideClockCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">~15 min</span>
            </div>
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideUsersCn Size="14" class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @_presentCount/@_team.Length
                </span>
                present
            </div>
            @if (_blockerCount > 0)
            {
                <span class="text-muted-foreground text-xs">·</span>
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideTriangleAlertCn Size="14" class="size-3.5 text-amber-500" />
                    <span class="font-medium text-foreground tabular-nums">@_blockerCount</span>
                    blocker@(_blockerCount != 1 ? "s" : "")
                </div>
            }
        </div>

        @* Team list *@
        <div>
            @for (var i = 0; i < _team.Length; i++)
            {
                var index = i;
                var member = _team[index];
                var isExpanded = _expandedMember == member.Id;
                var config = _statusConfig[member.Status];
                <div class="@(index < _team.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedMember = isExpanded ? "" : member.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@member.Name</span>
                                <span class="@Cn.Merge("size-1.5 rounded-full", config.Dot)"></span>
                            </div>
                            <span class="text-muted-foreground text-xs">@member.Role</span>
                        </div>
                        @if (member.Blockers.Length > 0)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs text-amber-600">
                                @member.Blockers.Length blocker@(member.Blockers.Length != 1 ? "s" : "")
                            </BadgeCn>
                        }
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded && member.Status != "absent")
                    {
                        <div class="border-t bg-muted/20 px-4 py-3 pl-15">
                            <div class="space-y-2.5">
                                <div>
                                    <span class="font-medium text-muted-foreground text-xs">Yesterday</span>
                                    <p class="mt-0.5 text-sm">@member.Yesterday</p>
                                </div>
                                <div>
                                    <span class="font-medium text-muted-foreground text-xs">Today</span>
                                    <p class="mt-0.5 text-sm">@member.Today</p>
                                </div>
                                @if (member.Blockers.Length > 0)
                                {
                                    <div>
                                        <span class="font-medium text-amber-600 text-xs">Blockers</span>
                                        @foreach (var blocker in member.Blockers)
                                        {
                                            <div class="mt-1 flex items-start gap-1.5">
                                                <LucideTriangleAlertCn Size="12" class="mt-0.5 size-3 shrink-0 text-amber-500" />
                                                <span class="text-sm">@blocker</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Initials, string Role, string Status, string Yesterday, string Today, string[] Blockers);
    private record StatusConfig(string Label, string Dot);

    private static readonly TeamMember[] _team =
    [
        new("1", "Sarah Chen", "SC", "Frontend", "done", "Completed login page redesign", "Start dashboard widget refactor", []),
        new("2", "Marcus Johnson", "MJ", "Backend", "done", "Fixed API rate limiting bug", "Implement webhook retry logic", ["Waiting on AWS credentials from DevOps"]),
        new("3", "Elena Rodriguez", "ER", "Design", "speaking", "Finalized onboarding flow mockups", "Create component library updates", []),
        new("4", "James O'Brien", "JO", "QA", "waiting", "Tested payment flow edge cases", "Write regression tests for auth module", ["Staging environment is down"]),
        new("5", "Priya Sharma", "PS", "DevOps", "waiting", "Deployed monitoring alerts", "Set up CI pipeline for new repo", []),
        new("6", "David Kim", "DK", "Backend", "absent", "-", "-", []),
    ];

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["done"] = new("Done", "bg-emerald-500"),
        ["speaking"] = new("Speaking", "bg-blue-500"),
        ["waiting"] = new("Waiting", "bg-amber-500"),
        ["absent"] = new("Absent", "bg-muted-foreground/40"),
    };

    private int _presentCount => _team.Count(m => m.Status != "absent");
    private int _blockerCount => _team.Sum(m => m.Blockers.Length);
    private string _expandedMember = "3";
}
