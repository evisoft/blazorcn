@* ============================================================
   Block: calendar-social-media-planner
   Title: Calendar Social Media Planner
   Description: React social media post scheduler block for Next.js with platform icons, post preview queue, scheduling timeline, and engagement metrics built with shadcn/ui and Tailwind CSS
   Long Description: React Shift Planner Calendar Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-social-media-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideShareCn Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Social Media Planner</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    New post
                </ButtonCn>
            </div>
        </div>

        @* Summary / filter tabs *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <button type="button"
                    @onclick="@(() => _filter = "all")"
                    class="@($"text-xs transition-colors {(_filter == "all" ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")}")">
                All (@_posts.Length)
            </button>
            <button type="button"
                    @onclick="@(() => _filter = "published")"
                    class="@($"flex items-center gap-1.5 text-xs transition-colors {(_filter == "published" ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")}")">
                <span class="size-1.5 rounded-full bg-emerald-500" />
                Published (@_counts["published"])
            </button>
            <button type="button"
                    @onclick="@(() => _filter = "scheduled")"
                    class="@($"flex items-center gap-1.5 text-xs transition-colors {(_filter == "scheduled" ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")}")">
                <span class="size-1.5 rounded-full bg-blue-500" />
                Scheduled (@_counts["scheduled"])
            </button>
            <button type="button"
                    @onclick="@(() => _filter = "draft")"
                    class="@($"flex items-center gap-1.5 text-xs transition-colors {(_filter == "draft" ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")}")">
                <span class="size-1.5 rounded-full bg-muted-foreground/30" />
                Draft (@_counts["draft"])
            </button>
        </div>

        @* Post queue *@
        <div>
            @{ var filtered = _filter == "all" ? _posts : _posts.Where(p => p.Status == _filter).ToArray(); }
            @for (int i = 0; i < filtered.Length; i++)
            {
                var post = filtered[i];
                var isExpanded = _expanded == post.Id;
                var isLast = i == filtered.Length - 1;
                var platformColor = GetPlatformColor(post.Platform);
                var platformAbbr = GetPlatformAbbr(post.Platform);
                var statusDot = GetStatusDot(post.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == post.Id ? null : post.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="@($"flex size-7 shrink-0 items-center justify-center rounded-md text-[10px] font-bold {platformColor}")">
                            @platformAbbr
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm">@post.Content</p>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Class="size-3" />
                                    @post.ScheduledDate
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideClockCn Class="size-3" />
                                    @post.ScheduledTime
                                </span>
                                @if (post.HasImage)
                                {
                                    <span class="flex items-center gap-1">
                                        <LucideImageCn Class="size-3" />
                                        Image
                                    </span>
                                }
                            </div>
                        </div>
                        <span class="@($"size-2 shrink-0 rounded-full {statusDot}")" />
                        <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-3">
                            @* Post preview *@
                            <div class="mb-3 rounded-md bg-muted/50 p-3">
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        @GetPlatformLabel(post.Platform) preview
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @GetStatusLabel(post.Status)
                                    </BadgeCn>
                                </div>
                                <p class="text-sm leading-relaxed">@post.Content</p>
                                @if (post.HasImage)
                                {
                                    <div class="mt-2 flex h-20 items-center justify-center rounded-md bg-muted">
                                        <LucideImageCn Class="size-6 text-muted-foreground/40" />
                                    </div>
                                }
                            </div>

                            @* Engagement (published only) *@
                            @if (post.Likes.HasValue)
                            {
                                <div class="flex items-center gap-4">
                                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideHeartCn Class="size-3" />
                                        <span class="tabular-nums">@post.Likes</span>
                                    </span>
                                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideMessageCircleCn Class="size-3" />
                                        <span class="tabular-nums">@post.Comments</span>
                                    </span>
                                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideRepeatCn Class="size-3" />
                                        <span class="tabular-nums">@post.Shares</span>
                                    </span>
                                </div>
                            }

                            @* Actions for non-published *@
                            @if (post.Status != "published")
                            {
                                <div class="flex items-center gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 text-xs">
                                        Edit
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 text-xs">
                                        Reschedule
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private string _filter = "all";

    private record SocialPost(string Id, string Content, string Platform, string Status, string ScheduledDate, string ScheduledTime, bool HasImage, int? Likes = null, int? Comments = null, int? Shares = null);

    private static readonly SocialPost[] _posts =
    [
        new("p1", "Excited to announce our new design system is live! Check out the interactive playground and start building faster.", "twitter", "published", "Mar 15", "10:00 AM", true, 142, 23, 38),
        new("p2", "We're hiring senior engineers! Join our team and help us build the future of developer tools. Remote-friendly, competitive comp.", "linkedin", "published", "Mar 16", "9:00 AM", false, 89, 12, 24),
        new("p3", "Behind the scenes of our latest product shoot. The team put in incredible work to bring this vision to life.", "instagram", "scheduled", "Mar 19", "12:00 PM", true),
        new("p4", "Join us for a live Q&A with our engineering team this Thursday at 2 PM EST. We'll cover our migration to edge computing.", "twitter", "scheduled", "Mar 20", "2:00 PM", false),
        new("p5", "Our Q1 impact report is out. 3x faster deployments, 99.99% uptime, and a new accessibility score of 98.", "linkedin", "scheduled", "Mar 22", "11:00 AM", true),
        new("p6", "New blog post: How we reduced our bundle size by 40% with tree shaking and code splitting.", "facebook", "draft", "Mar 25", "3:00 PM", false),
    ];

    private static readonly Dictionary<string, int> _counts = new()
    {
        ["published"] = _posts.Count(p => p.Status == "published"),
        ["scheduled"] = _posts.Count(p => p.Status == "scheduled"),
        ["draft"] = _posts.Count(p => p.Status == "draft"),
    };

    private static string GetPlatformColor(string platform) => platform switch
    {
        "twitter" => "bg-foreground text-background",
        "linkedin" => "bg-blue-600 text-white",
        "instagram" => "bg-pink-600 text-white",
        "facebook" => "bg-blue-500 text-white",
        _ => "bg-muted text-muted-foreground"
    };

    private static string GetPlatformAbbr(string platform) => platform switch
    {
        "twitter" => "X",
        "linkedin" => "Li",
        "instagram" => "Ig",
        "facebook" => "Fb",
        _ => "?"
    };

    private static string GetPlatformLabel(string platform) => platform switch
    {
        "twitter" => "Twitter/X",
        "linkedin" => "LinkedIn",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        _ => platform
    };

    private static string GetStatusDot(string status) => status switch
    {
        "published" => "bg-emerald-500",
        "scheduled" => "bg-blue-500",
        "draft" => "bg-muted-foreground/30",
        _ => "bg-zinc-400"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "published" => "Published",
        "scheduled" => "Scheduled",
        "draft" => "Draft",
        _ => status
    };
}
