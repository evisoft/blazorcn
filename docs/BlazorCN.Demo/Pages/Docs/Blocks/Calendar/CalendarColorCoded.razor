@* ============================================================
   Block: calendar-color-coded
   Title: CalendarColorCoded
   Description: A color-coded event categories calendar block for Next.js with filterable categories, event legends, and daily event listings using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-color-coded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Color-Coded Calendar</h2>
                <p class="text-muted-foreground text-xs">March 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideCalendarCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_events.Length</span>
                <span class="text-muted-foreground text-xs">events</span>
            </div>
        </div>

        <div class="flex flex-wrap gap-2 border-b px-4 py-2.5">
            @foreach (var cat in _categories)
            {
                var category = cat;
                var isVisible = _visibleCategories.Contains(category.Id);
                <button
                    type="button"
                    @onclick="@(() => ToggleCategory(category.Id))"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors", isVisible ? "bg-muted/50" : "opacity-40")">
                    <span class="@Cn.Merge("size-1.5 rounded-full", category.DotClass)"></span>
                    <span class="@(isVisible ? "text-foreground" : "text-muted-foreground")">@category.Name</span>
                    @if (isVisible)
                    {
                        <LucideEyeCn Size="12" class="size-3 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideEyeOffCn Size="12" class="size-3 text-muted-foreground" />
                    }
                </button>
            }
        </div>

        <div>
            @for (var di = 0; di < _days.Length; di++)
            {
                var dIndex = di;
                var day = _days[dIndex];
                var dayEvents = _events.Where(e => e.Date == day && _visibleCategories.Contains(e.CategoryId)).ToArray();
                <div class="@(dIndex < _days.Length - 1 ? "border-b" : "")">
                    <div class="px-4 py-2">
                        <span class="font-medium text-muted-foreground text-xs">@day, 2026</span>
                    </div>
                    @if (dayEvents.Length == 0)
                    {
                        <div class="px-4 pb-3">
                            <span class="text-muted-foreground/60 text-xs">No visible events</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var evt in dayEvents)
                        {
                            var evtCat = GetCategoryById(evt.CategoryId);
                            @if (evtCat is not null)
                            {
                                <div class="flex items-center gap-3 px-4 py-2">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", evtCat.DotClass)"></span>
                                    <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@evt.Time</span>
                                    <span class="text-sm">@evt.Title</span>
                                    <span class="@Cn.Merge("ml-auto rounded-md px-1.5 py-0.5 text-xs", evtCat.BgClass)">@evtCat.Name</span>
                                </div>
                            }
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EventCategory(string Id, string Name, string Color, string DotClass, string BgClass);
    private record CalendarEvent(string Id, string Title, string CategoryId, string Time, string Date);

    private static readonly EventCategory[] _categories =
    [
        new("work",     "Work",     "blue",    "bg-blue-500",    "bg-blue-500/10"),
        new("personal", "Personal", "emerald", "bg-emerald-500", "bg-emerald-500/10"),
        new("health",   "Health",   "rose",    "bg-rose-500",    "bg-rose-500/10"),
        new("learning", "Learning", "amber",   "bg-amber-500",   "bg-amber-500/10"),
        new("social",   "Social",   "purple",  "bg-purple-500",  "bg-purple-500/10"),
    ];

    private static readonly CalendarEvent[] _events =
    [
        new("1",  "Sprint Planning",    "work",     "9:00 AM",  "Mar 17"),
        new("2",  "Morning Run",        "health",   "6:30 AM",  "Mar 17"),
        new("3",  "React Course",       "learning", "7:00 PM",  "Mar 17"),
        new("4",  "Client Call",        "work",     "10:30 AM", "Mar 18"),
        new("5",  "Dentist",            "health",   "2:00 PM",  "Mar 18"),
        new("6",  "Team Dinner",        "social",   "7:30 PM",  "Mar 18"),
        new("7",  "Code Review",        "work",     "11:00 AM", "Mar 19"),
        new("8",  "Yoga Class",         "health",   "6:00 AM",  "Mar 19"),
        new("9",  "Book Club",          "social",   "6:00 PM",  "Mar 19"),
        new("10", "Design Workshop",    "learning", "3:00 PM",  "Mar 20"),
        new("11", "Grocery Shopping",   "personal", "5:00 PM",  "Mar 20"),
        new("12", "1:1 with Manager",   "work",     "4:00 PM",  "Mar 20"),
    ];

    private static readonly string[] _days = ["Mar 17", "Mar 18", "Mar 19", "Mar 20"];

    private HashSet<string> _visibleCategories = new HashSet<string>(_categories.Select(c => c.Id));

    private void ToggleCategory(string categoryId)
    {
        if (_visibleCategories.Contains(categoryId))
            _visibleCategories.Remove(categoryId);
        else
            _visibleCategories.Add(categoryId);
    }

    private EventCategory? GetCategoryById(string id) => _categories.FirstOrDefault(c => c.Id == id);
}
