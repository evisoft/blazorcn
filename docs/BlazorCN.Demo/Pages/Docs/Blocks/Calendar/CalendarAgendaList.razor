@* ============================================================
   Block: calendar-agenda-list
   Title: Calendar Agenda List
   Description: A chronological agenda list view with grouped date headers, event times, category indicators, and expandable event cards built with React, Next.js, shadcn/ui, and Tailwind CSS
   Long Description: Daily writing prompt section with featured prompt, topic badge, word count suggestion, start button, and past prompts
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-agenda-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideListCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Agenda</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_totalEvents upcoming</span>
        </div>

        @* Agenda days *@
        <div>
            @for (var di = 0; di < _agendaDays.Length; di++)
            {
                var dayIndex = di;
                var day = _agendaDays[dayIndex];
                <div>
                    @* Date header *@
                    <div class="@Cn.Merge("flex items-center gap-2 bg-muted/30 px-4 py-2", dayIndex > 0 ? "border-t" : "")">
                        <span class="font-medium text-xs">@day.RelativeLabel</span>
                        <span class="text-muted-foreground text-xs">@day.Label</span>
                        <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                            @day.Events.Length event@(day.Events.Length != 1 ? "s" : "")
                        </span>
                    </div>

                    @* Events *@
                    @for (var ei = 0; ei < day.Events.Length; ei++)
                    {
                        var evtIndex = ei;
                        var evt = day.Events[evtIndex];
                        var isExpanded = _expanded == evt.Id;
                        var isLast = evtIndex == day.Events.Length - 1 && dayIndex == _agendaDays.Length - 1;

                        <div class="@(isLast ? "" : "border-b")">
                            <button
                                type="button"
                                @onclick="@(() => _expanded = isExpanded ? "" : evt.Id)"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                @* Time column *@
                                <div class="w-16 shrink-0">
                                    @if (evt.AllDay)
                                    {
                                        <span class="font-medium text-muted-foreground text-xs">All day</span>
                                    }
                                    else
                                    {
                                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                            @evt.Time
                                        </span>
                                    }
                                </div>

                                @* Category dot *@
                                <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _categoryDot[evt.Category])"></span>

                                @* Title and meta *@
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">@evt.Title</span>
                                    <div class="mt-0.5 flex items-center gap-2">
                                        @if (!evt.AllDay && !string.IsNullOrEmpty(evt.EndTime))
                                        {
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideClockCn Size="12" class="size-3" />
                                                @evt.Time - @evt.EndTime
                                            </span>
                                        }
                                        @if (evt.Attendees > 0)
                                        {
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideUsersCn Size="12" class="size-3" />
                                                @evt.Attendees
                                            </span>
                                        }
                                    </div>
                                </div>

                                <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="px-4 pb-3 pl-[5.75rem]">
                                    <p class="mb-2 text-muted-foreground text-sm leading-relaxed">
                                        @evt.Description
                                    </p>
                                    @if (!string.IsNullOrEmpty(evt.Location))
                                    {
                                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                            <LucideMapPinCn Size="12" class="size-3" />
                                            @evt.Location
                                        </span>
                                    }
                                    <div class="mt-2 flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                            @(char.ToUpper(evt.Category[0]) + evt.Category.Substring(1))
                                        </BadgeCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-6 px-2 text-xs">
                                            View details
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AgendaEvent(string Id, string Title, string Time, string EndTime, bool AllDay, string Category, int Attendees, string Description, string Location);
    private record AgendaDay(string RelativeLabel, string Label, AgendaEvent[] Events);

    private static readonly Dictionary<string, string> _categoryDot = new()
    {
        ["work"] = "bg-blue-500",
        ["personal"] = "bg-emerald-500",
        ["health"] = "bg-rose-500",
        ["social"] = "bg-amber-500",
    };

    private static readonly AgendaDay[] _agendaDays =
    [
        new("Today", "Wed, Mar 18", [
            new("1", "Product Roadmap Review", "9:00 AM", "10:30 AM", false, "work", 8, "Quarterly product roadmap alignment with stakeholders. Review progress on current initiatives and plan next quarter priorities.", "Conference Room A"),
            new("2", "Dentist Appointment", "11:00 AM", "12:00 PM", false, "health", 0, "Regular 6-month dental checkup and cleaning.", "Downtown Dental Clinic"),
            new("3", "Team Lunch", "12:30 PM", "1:30 PM", false, "social", 5, "Monthly team lunch to celebrate recent launches and welcome new members.", "Italiano's Restaurant"),
            new("4", "Sprint Planning", "2:00 PM", "3:30 PM", false, "work", 6, "Plan sprint 24 stories and assign story points. Review backlog grooming notes.", "Zoom"),
        ]),
        new("Tomorrow", "Thu, Mar 19", [
            new("5", "Morning Yoga", "7:00 AM", "8:00 AM", false, "health", 0, "Weekly yoga session for flexibility and mindfulness.", "Wellness Studio"),
            new("6", "Client Presentation", "10:00 AM", "11:00 AM", false, "work", 3, "Present Q1 results and analytics dashboard to client stakeholders.", "Client Office / Zoom"),
            new("7", "Design System Sync", "2:00 PM", "2:30 PM", false, "work", 4, "Sync on component library updates and new design tokens.", "Figma / Slack Huddle"),
        ]),
        new("Friday", "Fri, Mar 20", [
            new("8", "Company All-Hands", "10:00 AM", "11:00 AM", false, "work", 50, "Monthly all-hands with CEO updates, team spotlights, and Q&A.", "Main Auditorium"),
            new("9", "Hackathon Kick-off", "1:00 PM", "", false, "work", 12, "Internal hackathon begins — 24 hours to build something cool.", "Innovation Lab"),
        ]),
    ];

    private int _totalEvents => _agendaDays.Sum(d => d.Events.Length);
    private string _expanded = "3";
}
