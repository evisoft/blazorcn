@* ============================================================
   Block: calendar-gym-sessions
   Title: Calendar Gym Sessions
   Description: React gym and fitness class schedule calendar block for Next.js with workout type, trainer info, capacity bar, and booking buttons using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn, ProgressCn
   Source: original/blocks/calendar/calendar-gym-sessions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Gym Schedule</h2>
                <p class="text-muted-foreground text-xs">Week of Mar 17, 2026</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                    <LucideChevronLeftCn Size="14" class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                    <LucideChevronRightCn Size="14" class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Day tabs *@
        <div class="flex border-b">
            @foreach (var day in _schedule)
            {
                <button
                    type="button"
                    @onclick="@(() => _selectedDay = day.Date)"
                    class="@Cn.Merge("flex flex-1 flex-col items-center gap-0.5 px-3 py-2.5 transition-colors hover:bg-muted/50", _selectedDay == day.Date ? "border-b-2 border-foreground bg-muted/30" : "")">
                    <span class="text-muted-foreground text-xs">@day.Day</span>
                    <span class="@Cn.Merge("font-medium text-sm tabular-nums", _selectedDay == day.Date ? "text-foreground" : "text-muted-foreground")">
                        @day.Date.Split(" ")[1]
                    </span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @day.Classes.Length classes
                    </span>
                </button>
            }
        </div>

        @* Classes list *@
        <div>
            @if (_dayData is not null)
            {
                @for (var i = 0; i < _dayData.Classes.Length; i++)
                {
                    var idx = i;
                    var cls = _dayData.Classes[idx];
                    var fillPercent = (int)Math.Round((double)cls.Booked / cls.Capacity * 100);
                    var isFull = cls.Booked >= cls.Capacity;
                    var isBooked = _bookedIds.Contains(cls.Id);
                    var isLast = idx == _dayData.Classes.Length - 1;

                    <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@cls.Name</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                        @_typeLabels[cls.Type]
                                    </BadgeCn>
                                </div>
                                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1">
                                        <LucideClockCn Size="12" class="size-3" />
                                        @cls.Time · @cls.Duration
                                    </span>
                                    <span>@cls.Trainer</span>
                                </div>
                            </div>
                            <ButtonCn
                                Variant="@(isBooked ? ButtonVariant.Default : ButtonVariant.Outline)"
                                Size="ButtonSize.Sm"
                                class="h-7 shrink-0 text-xs"
                                Disabled="@(isFull && !isBooked)"
                                @onclick="@(() => HandleBook(cls.Id))">
                                @(isBooked ? "Booked" : isFull ? "Full" : "Book")
                            </ButtonCn>
                        </div>
                        <div class="mt-2 flex items-center gap-2">
                            <ProgressCn Value="@fillPercent" class="h-1.5 flex-1" />
                            <span class="flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                                <LucideUsersCn Size="12" class="size-3" />
                                @cls.Booked/@cls.Capacity
                            </span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record GymClass(string Id, string Name, string Type, string Trainer, string Time, string Duration, int Booked, int Capacity);
    private record DaySchedule(string Day, string Date, GymClass[] Classes);

    private static readonly Dictionary<string, string> _typeLabels = new()
    {
        ["hiit"] = "HIIT", ["yoga"] = "Yoga", ["cycling"] = "Cycling",
        ["strength"] = "Strength", ["pilates"] = "Pilates",
    };

    private static readonly DaySchedule[] _schedule =
    [
        new("Mon", "Mar 17", [
            new("1", "Morning HIIT Blast", "hiit", "Alex Rivera", "6:30 AM", "45 min", 18, 20),
            new("2", "Vinyasa Flow", "yoga", "Maya Chen", "8:00 AM", "60 min", 12, 15),
            new("3", "Power Cycling", "cycling", "Jake Thompson", "12:00 PM", "45 min", 22, 25),
            new("4", "Full Body Strength", "strength", "Sam Okafor", "5:30 PM", "50 min", 16, 18),
        ]),
        new("Tue", "Mar 18", [
            new("5", "Sunrise Yoga", "yoga", "Maya Chen", "6:00 AM", "60 min", 10, 15),
            new("6", "Tabata Express", "hiit", "Alex Rivera", "12:15 PM", "30 min", 20, 20),
            new("7", "Reformer Pilates", "pilates", "Lena Kowalski", "4:00 PM", "55 min", 8, 10),
        ]),
        new("Wed", "Mar 19", [
            new("8", "Spin & Burn", "cycling", "Jake Thompson", "6:30 AM", "45 min", 19, 25),
            new("9", "Upper Body Focus", "strength", "Sam Okafor", "10:00 AM", "50 min", 14, 18),
            new("10", "Yin Yoga", "yoga", "Maya Chen", "6:00 PM", "75 min", 7, 15),
        ]),
    ];

    private string _selectedDay = "Mar 18";
    private HashSet<string> _bookedIds = new() { "5" };

    private DaySchedule? _dayData => _schedule.FirstOrDefault(d => d.Date == _selectedDay);

    private void HandleBook(string id)
    {
        if (!_bookedIds.Add(id))
            _bookedIds.Remove(id);
    }
}
