@* ============================================================
   Block: calendar-mini-widget
   Title: Calendar Mini Widget
   Description: A compact mini calendar widget with today indicator, event count badges, and quick navigation built with React, Next.js, shadcn/ui Badge component, and Tailwind CSS
   Long Description: React Meeting Scheduler Calendar Block
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-mini-widget.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">March 2026</span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn aria-label="Previous month" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0">
                    <LucideChevronLeftCn Class="size-3.5" />
                </ButtonCn>
                <ButtonCn aria-label="Next month" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0">
                    <LucideChevronRightCn Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Calendar grid *@
        <div class="px-3 py-2">
            @* Weekday headers *@
            <div class="grid grid-cols-7">
                @for (int i = 0; i < _weekdays.Length; i++)
                {
                    <div class="flex h-7 items-center justify-center text-muted-foreground text-xs">
                        @_weekdays[i]
                    </div>
                }
            </div>

            @* Day cells *@
            <div class="grid grid-cols-7">
                @* Leading days from previous month (March 2026 starts on Sunday, offset = 0) *@
                @for (int i = 0; i < _leadingDays.Length; i++)
                {
                    <div class="flex h-9 flex-col items-center justify-center">
                        <span class="text-muted-foreground/30 text-xs tabular-nums">@_leadingDays[i]</span>
                    </div>
                }

                @* Current month days *@
                @for (int d = 1; d <= 31; d++)
                {
                    var day = d;
                    var dayStr = day.ToString();
                    var isToday = dayStr == Today;
                    var isSelected = dayStr == _selectedDay;
                    _eventCounts.TryGetValue(dayStr, out var count);

                    <button type="button"
                            @onclick="@(() => _selectedDay = dayStr)"
                            class="flex h-9 flex-col items-center justify-center rounded transition-colors hover:bg-muted/50">
                        <span class="@($"flex size-6 items-center justify-center rounded-full text-xs tabular-nums {(isToday ? "bg-foreground font-medium text-background" : isSelected ? "bg-muted font-medium" : "")}")">
                            @day
                        </span>
                        @if (count > 0)
                        {
                            <div class="mt-0.5 flex items-center gap-0.5">
                                @if (count <= 3)
                                {
                                    @for (int j = 0; j < count; j++)
                                    {
                                        <span class="size-1 rounded-full bg-blue-500" />
                                    }
                                }
                                else
                                {
                                    <span class="size-1 rounded-full bg-blue-500" />
                                    <span class="size-1 rounded-full bg-blue-500" />
                                    <span class="text-muted-foreground text-[8px] tabular-nums">+@(count - 2)</span>
                                }
                            </div>
                        }
                    </button>
                }

                @* Trailing days *@
                @for (int i = 1; i <= _trailingCount; i++)
                {
                    <div class="flex h-9 flex-col items-center justify-center">
                        <span class="text-muted-foreground/30 text-xs tabular-nums">@i</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2">
            <span class="text-muted-foreground text-xs tabular-nums">
                @_totalEvents events this month
            </span>
            @{
                _eventCounts.TryGetValue(_selectedDay, out var selectedEvents);
                if (selectedEvents > 0)
                {
                    <span class="text-xs">
                        <span class="font-medium tabular-nums">@selectedEvents</span>
                        <span class="text-muted-foreground"> on March @_selectedDay</span>
                    </span>
                }
            }
        </div>
    </div>
</section>

@code {
    private string _selectedDay = "18";
    private const string Today = "18";

    private static readonly string[] _weekdays = ["S", "M", "T", "W", "T", "F", "S"];

    // March 2026 starts on Sunday, so no leading days
    private static readonly int[] _leadingDays = [];
    // 31 days + 0 leading = 31, 31 % 7 = 3, trailing = 7 - 3 = 4
    private static readonly int _trailingCount = 4;

    private static readonly Dictionary<string, int> _eventCounts = new()
    {
        ["3"] = 2, ["5"] = 1, ["8"] = 3, ["10"] = 1, ["12"] = 2,
        ["15"] = 1, ["17"] = 4, ["18"] = 2, ["20"] = 1, ["22"] = 3,
        ["25"] = 1, ["28"] = 2,
    };

    private static readonly int _totalEvents = _eventCounts.Values.Sum();
}
