@* ============================================================
   Block: calendar-countdown-timer
   Title: Calendar Countdown Timer
   Description: React event countdown display calendar block for Next.js with days hours and minutes remaining for upcoming events, progress rings, category labels, and pinned priority events using shadcn/ui and Tailwind CSS
   Long Description: Task deadline calendar with priorities
   Dependencies: BadgeCn
   Source: original/blocks/calendar/calendar-countdown-timer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTimerCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Upcoming Events</span>
            </div>
            <span class="text-muted-foreground text-xs">@_events.Length events</span>
        </div>

        @* Pinned event *@
        @{
            var pinned = _events.FirstOrDefault(e => e.Pinned);
        }
        @if (pinned != null)
        {
            var pStyle = _categoryStyle[pinned.Category];
            <div class="border-b bg-muted/20 px-4 py-4">
                <div class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucidePinCn Size="12" class="size-3" />
                    <span>Pinned</span>
                </div>
                <div class="mt-2 flex items-center gap-4">
                    <div class="flex-1">
                        <span class="font-medium text-sm">@pinned.Title</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@pinned.Date</p>
                    </div>
                    <div class="flex items-center gap-3 tabular-nums">
                        <div class="text-center">
                            <span class="block font-semibold text-lg">@pinned.Days</span>
                            <span class="text-muted-foreground text-xs">days</span>
                        </div>
                        <span class="text-muted-foreground">:</span>
                        <div class="text-center">
                            <span class="block font-semibold text-lg">@pinned.Hours</span>
                            <span class="text-muted-foreground text-xs">hrs</span>
                        </div>
                        <span class="text-muted-foreground">:</span>
                        <div class="text-center">
                            <span class="block font-semibold text-lg">@pinned.Minutes</span>
                            <span class="text-muted-foreground text-xs">min</span>
                        </div>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" class="@Cn.Merge("mt-2 font-normal text-xs", pStyle.Text)">
                    @pStyle.Label
                </BadgeCn>
            </div>
        }

        @* Event list *@
        <div>
            @for (var i = 0; i < _events.Length; i++)
            {
                var evt = _events[i];
                if (evt.Pinned) continue;
                var style = _categoryStyle[evt.Category];
                var isLast = i == _events.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", style.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@evt.Title</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@evt.Date</p>
                        </div>
                        <div class="flex items-center gap-2 tabular-nums">
                            @if (evt.Days > 0)
                            {
                                <span class="font-medium text-sm">@(evt.Days)d</span>
                            }
                            <span class="text-muted-foreground text-xs">@(evt.Hours)h @(evt.Minutes)m</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var kvp in _categoryStyle)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", kvp.Value.Dot)"></span>
                    @kvp.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record CountdownEvent(string Id, string Title, string Date, string Category, int Days, int Hours, int Minutes, bool Pinned);
    private record CategoryStyleInfo(string Label, string Dot, string Text);

    private static readonly Dictionary<string, CategoryStyleInfo> _categoryStyle = new()
    {
        ["launch"] = new("Launch", "bg-blue-500", "text-blue-600 dark:text-blue-400"),
        ["deadline"] = new("Deadline", "bg-red-500", "text-red-600 dark:text-red-400"),
        ["meeting"] = new("Meeting", "bg-amber-500", "text-amber-600 dark:text-amber-400"),
        ["personal"] = new("Personal", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
    };

    private static readonly CountdownEvent[] _events =
    [
        new("1", "Product Launch v2.0", "March 25, 2026 at 9:00 AM", "launch", 7, 14, 30, true),
        new("2", "Quarterly Report Due", "March 20, 2026 at 5:00 PM", "deadline", 2, 22, 15, false),
        new("3", "Team Offsite", "March 28, 2026 at 8:00 AM", "meeting", 10, 13, 45, false),
        new("4", "Conference Talk", "April 5, 2026 at 2:00 PM", "meeting", 18, 19, 30, false),
        new("5", "Vacation Start", "April 14, 2026 at 12:00 PM", "personal", 27, 17, 0, false),
    ];
}
