@* ============================================================
   Block: calendar-campaign-timeline
   Title: Calendar Campaign Timeline
   Description: A React marketing campaign timeline block for Next.js with campaign phases, budget allocation, channel breakdown, and status tracking built with shadcn/ui and Tailwind CSS
   Long Description: React Calendar Booking Slots Block
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-campaign-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Spring Campaign 2026</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Mar 1 - May 31 · 3 phases</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                In Progress
            </BadgeCn>
        </div>

        @* Budget summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Total Budget</span>
                <p class="font-semibold text-lg tabular-nums">$45,000</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <span class="text-muted-foreground text-xs">Spent</span>
                <p class="font-medium text-sm tabular-nums">$12,400 (28%)</p>
            </div>
            <div class="flex-1">
                <ProgressCn Value="28" class="h-1.5" />
            </div>
        </div>

        @* Phases *@
        <div>
            @for (var i = 0; i < _phases.Length; i++)
            {
                var phase = _phases[i];
                var isLast = i == _phases.Length - 1;
                var isExpanded = _expanded == phase.Id;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? "" : phase.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", phase.StatusDot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@phase.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                    @phase.Status
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @phase.DateRange · @FormatBudget(phase.Budget)
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs tabular-nums text-muted-foreground">@phase.Progress%</span>
                            <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            <div>
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Progress</span>
                                    <span class="font-medium text-xs tabular-nums">@phase.Progress%</span>
                                </div>
                                <ProgressCn Value="@phase.Progress" class="h-1.5" />
                            </div>
                            <div>
                                <span class="text-muted-foreground text-xs">Channels</span>
                                <div class="mt-1 flex flex-wrap gap-1">
                                    @foreach (var channel in phase.Channels)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" class="font-normal text-xs">@channel</BadgeCn>
                                    }
                                </div>
                            </div>
                            <div>
                                <span class="text-muted-foreground text-xs">Deliverables</span>
                                <div class="mt-1 space-y-1">
                                    @foreach (var d in phase.Deliverables)
                                    {
                                        <div class="flex items-center gap-2">
                                            @if (d.Done)
                                            {
                                                <LucideCheckCircle2Cn Size="14" class="size-3.5 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideCircleCn Size="14" class="size-3.5 text-muted-foreground" />
                                            }
                                            <span class="@Cn.Merge("text-xs", d.Done ? "text-muted-foreground line-through" : "")">@d.Label</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DeliverableItem(string Label, bool Done);
    private record PhaseInfo(string Id, string Title, string DateRange, string Status, string StatusDot, int Budget, int Progress, string[] Channels, DeliverableItem[] Deliverables);

    private static string FormatBudget(int amount) => $"${amount / 1000}k";

    private static readonly PhaseInfo[] _phases =
    [
        new("p1", "Phase 1: Awareness", "Mar 1 - Mar 31", "Active", "bg-emerald-500", 15000, 65, ["Social", "Display", "Email"], [
            new("Brand awareness campaign launch", true),
            new("Social media content calendar", true),
            new("Influencer outreach", false),
            new("Landing page A/B test", false),
        ]),
        new("p2", "Phase 2: Engagement", "Apr 1 - Apr 30", "Upcoming", "bg-amber-500", 18000, 10, ["Email", "Webinar", "Content"], [
            new("Email drip campaign setup", true),
            new("Webinar series planning", false),
            new("Case study production", false),
        ]),
        new("p3", "Phase 3: Conversion", "May 1 - May 31", "Planned", "bg-blue-500", 12000, 0, ["Retargeting", "Sales", "Demo"], [
            new("Retargeting pixel setup", false),
            new("Sales enablement kit", false),
            new("Demo request flow", false),
        ]),
    ];

    private string _expanded = "p1";
}
