@* ============================================================
   Block: calendar-goals-tracker
   Title: CalendarGoalsTracker
   Description: A goal milestone tracker block for Next.js with progress tracking, deadline management, and milestone checklists using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-goals-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Goal Tracker</h2>
                <p class="text-muted-foreground text-xs">2026 Goals</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideTrophyCn Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@AvgProgress%</span>
                <span class="text-muted-foreground text-xs">avg progress</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideTargetCn Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @_goals.Length
                </span>
                goals
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideFlagCn Class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">
                    @CompletedMilestones/@TotalMilestones
                </span>
                milestones
            </div>
        </div>

        <div>
            @for (int gi = 0; gi < _goals.Length; gi++)
            {
                var goal = _goals[gi];
                var isExpanded = _expandedGoal == goal.Id;
                var config = _categoryConfig[goal.Category];
                var isLast = gi == _goals.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expandedGoal = _expandedGoal == goal.Id ? "" : goal.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-1.5 shrink-0 rounded-full {config.Dot}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@goal.Title</span>
                            <div class="mt-1 flex items-center gap-2">
                                <ProgressCn Value="@goal.Progress" Class="h-1 w-24" aria-label="Progress" />
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @goal.Progress%
                                </span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-0.5 shrink-0">
                            <span class="text-muted-foreground text-xs">@config.Label</span>
                            <span class="text-muted-foreground text-xs tabular-nums">
                                Due @goal.Deadline
                            </span>
                        </div>
                        <LucideChevronRightCn Class="@($"size-4 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-2 pl-9">
                            @for (int mi = 0; mi < goal.Milestones.Length; mi++)
                            {
                                var milestone = goal.Milestones[mi];
                                var isLastMilestone = mi == goal.Milestones.Length - 1;

                                <div class="@($"flex items-center gap-2 py-1.5{(isLastMilestone ? "" : " border-b border-border/50")}")">
                                    <span class="@($"size-1.5 rounded-full {(milestone.Completed ? "bg-emerald-500" : "bg-muted-foreground/30")}")"></span>
                                    <span class="@($"flex-1 text-sm{(milestone.Completed ? " text-muted-foreground line-through" : "")}")">
                                        @milestone.Title
                                    </span>
                                    <span class="text-muted-foreground text-xs tabular-nums">
                                        @milestone.DueDate
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _expandedGoal = "1";

    private record MilestoneItem(string Id, string Title, bool Completed, string DueDate);
    private record GoalItem(string Id, string Title, string Category, int Progress, string Deadline, MilestoneItem[] Milestones);
    private record CategoryInfo(string Label, string Dot);

    private static readonly GoalItem[] _goals =
    [
        new("1", "Get AWS Certification", "career", 72, "Apr 30",
        [
            new("m1", "Complete study guide chapters 1-5", true, "Feb 28"),
            new("m2", "Finish practice exams set A", true, "Mar 10"),
            new("m3", "Complete hands-on labs", true, "Mar 20"),
            new("m4", "Pass all practice exams >85%", false, "Apr 10"),
            new("m5", "Schedule and take exam", false, "Apr 30"),
        ]),
        new("2", "Run a Half Marathon", "health", 55, "Jun 15",
        [
            new("m6", "Run 5k without stopping", true, "Feb 15"),
            new("m7", "Complete 10k distance", true, "Mar 15"),
            new("m8", "Run 15k at target pace", false, "Apr 15"),
            new("m9", "Complete 18k training run", false, "May 15"),
            new("m10", "Race day: half marathon", false, "Jun 15"),
        ]),
        new("3", "Save $10,000 Emergency Fund", "financial", 82, "May 31",
        [
            new("m11", "Set up automated transfers", true, "Jan 15"),
            new("m12", "Reach $5,000 saved", true, "Feb 28"),
            new("m13", "Reach $7,500 saved", true, "Mar 15"),
            new("m14", "Reach $10,000 goal", false, "May 31"),
        ]),
        new("4", "Read 24 Books This Year", "learning", 33, "Dec 31",
        [
            new("m15", "Complete 6 books (Q1)", true, "Mar 31"),
            new("m16", "Complete 12 books (Q2)", false, "Jun 30"),
            new("m17", "Complete 18 books (Q3)", false, "Sep 30"),
            new("m18", "Complete 24 books (Q4)", false, "Dec 31"),
        ]),
    ];

    private static readonly Dictionary<string, CategoryInfo> _categoryConfig = new()
    {
        ["career"] = new("Career", "bg-blue-500"),
        ["health"] = new("Health", "bg-emerald-500"),
        ["financial"] = new("Financial", "bg-amber-500"),
        ["learning"] = new("Learning", "bg-purple-500"),
        ["personal"] = new("Personal", "bg-rose-500"),
    };

    private int AvgProgress => (int)Math.Round(_goals.Average(g => g.Progress));
    private int CompletedMilestones => _goals.Sum(g => g.Milestones.Count(m => m.Completed));
    private int TotalMilestones => _goals.Sum(g => g.Milestones.Length);
}
