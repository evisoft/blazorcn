@* ============================================================
   Block: calendar-movie-releases
   Title: CalendarMovieReleases
   Description: A movie and show release calendar block for Next.js with release dates, genre tags, and watchlist tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-movie-releases.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Upcoming Releases</h2>
                <p class="text-muted-foreground text-xs">March - April 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="film" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_items.Count</span>
                <span class="text-muted-foreground text-xs">titles</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="bookmark" Size="14" Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @_watchlistCount
                </span>
                in watchlist
            </div>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            <ButtonCn Variant="@(_filter == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                      Size="ButtonSize.Sm"
                      Class="h-6 px-2 text-xs"
                      @onclick="@(() => _filter = "all")">
                All
            </ButtonCn>
            <ButtonCn Variant="@(_filter == "watchlist" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                      Size="ButtonSize.Sm"
                      Class="h-6 px-2 text-xs"
                      @onclick="@(() => _filter = "watchlist")">
                Watchlist
            </ButtonCn>
        </div>

        <div>
            @foreach (var (release, index) in _filtered.Select((r, i) => (r, i)))
            {
                var item = release;
                var genre = _genreConfig[item.Genre];
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", index < _filtered.Count - 1 ? "border-b" : "")">
                    <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", genre.Dot)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@item.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @(item.Type == "series" ? "Series" : "Movie")
                            </BadgeCn>
                        </div>
                        <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                            <span>@genre.Label</span>
                            <span>·</span>
                            <span>@item.Platform</span>
                            @if (!string.IsNullOrEmpty(item.Rating))
                            {
                                <span>·</span>
                                <span>@item.Rating</span>
                            }
                            <span>·</span>
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                @item.ReleaseDate
                            </span>
                        </div>
                    </div>
                    <button aria-label="@(item.Watchlisted ? $"Remove {item.Title} from watchlist" : $"Add {item.Title} to watchlist")"
                        type="button"
                        @onclick="@(() => ToggleWatchlist(item.Id))"
                        class="shrink-0 p-1">
                        <LucideIconCn Name="bookmark" Size="16"
                                      Class="@Cn.Merge("size-4", item.Watchlisted ? "fill-foreground text-foreground" : "text-muted-foreground/40")" />
                    </button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Release(string Id, string Title, string Genre, string ReleaseDate, string Platform, string? Rating, string Type, bool Watchlisted);
    private record GenreInfo(string Label, string Dot);

    private static readonly Dictionary<string, GenreInfo> _genreConfig = new()
    {
        ["action"]      = new("Action",      "bg-red-500"),
        ["drama"]       = new("Drama",       "bg-blue-500"),
        ["comedy"]      = new("Comedy",      "bg-amber-500"),
        ["sci-fi"]      = new("Sci-Fi",      "bg-purple-500"),
        ["horror"]      = new("Horror",      "bg-rose-500"),
        ["documentary"] = new("Documentary", "bg-emerald-500"),
    };

    private List<Release> _items =
    [
        new("1", "Quantum Horizon",              "sci-fi",       "Mar 21", "Theaters",    "PG-13", "movie",  true),
        new("2", "The Last Detective: Season 3", "drama",        "Mar 22", "Netflix",     null,    "series", true),
        new("3", "Laughing Matters",             "comedy",       "Mar 24", "Apple TV+",   "R",     "movie",  false),
        new("4", "Deep Ocean: Part 2",           "documentary",  "Mar 25", "Disney+",     null,    "series", false),
        new("5", "Shadow Protocol",              "action",       "Mar 28", "Theaters",    "PG-13", "movie",  true),
        new("6", "Midnight Echo",                "horror",       "Mar 28", "Hulu",        "R",     "movie",  false),
        new("7", "Code Zero: Season 1",          "action",       "Mar 30", "Prime Video", null,    "series", false),
        new("8", "The Algorithm",                "drama",        "Apr 2",  "HBO Max",     "R",     "movie",  true),
    ];

    private string _filter = "all";

    private List<Release> _filtered => _filter == "watchlist"
        ? _items.Where(r => r.Watchlisted).ToList()
        : _items;

    private int _watchlistCount => _items.Count(r => r.Watchlisted);

    private void ToggleWatchlist(string id)
    {
        var idx = _items.FindIndex(r => r.Id == id);
        if (idx >= 0)
        {
            var r = _items[idx];
            _items[idx] = r with { Watchlisted = !r.Watchlisted };
        }
    }
}
