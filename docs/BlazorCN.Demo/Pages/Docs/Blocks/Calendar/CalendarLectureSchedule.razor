@* ============================================================
   Block: calendar-lecture-schedule
   Title: CalendarLectureSchedule
   Description: A university lecture schedule block for Next.js with course timetable, room assignments, and professor details using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-lecture-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Lecture Schedule</h2>
                <p class="text-muted-foreground text-xs">Spring 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideBookOpenCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@UniqueCourses</span>
                <span class="text-muted-foreground text-xs">courses</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs tabular-nums">@_totalCredits credits</span>
            </div>
        </div>

        @* Day selector tabs *@
        <div class="grid grid-cols-5 border-b">
            @foreach (var day in _weekDays)
            {
                var d = day;
                var count = _lectures.Count(l => l.Day == d);
                <button type="button" @onclick="@(() => _selectedDay = d)"
                        class="@Cn.Merge("flex flex-col items-center gap-0.5 py-2.5 transition-colors hover:bg-muted/50", _selectedDay == d ? "bg-muted/50" : "")">
                    <span class="text-muted-foreground text-xs">@d</span>
                    <span class="@Cn.Merge("font-medium text-sm", _selectedDay == d ? "text-foreground" : "text-muted-foreground")">@count</span>
                </button>
            }
        </div>

        @* Lecture list for selected day *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">
                    @_selectedDay — @DayLectures.Length lecture@(DayLectures.Length != 1 ? "s" : "")
                </span>
            </div>
            @if (DayLectures.Length == 0)
            {
                <div class="px-4 py-8 text-center">
                    <span class="text-muted-foreground text-xs">No lectures scheduled</span>
                </div>
            }
            else
            {
                @for (var i = 0; i < DayLectures.Length; i++)
                {
                    var lecture = DayLectures[i];
                    var isLast = i == DayLectures.Length - 1;
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                        <div class="@Cn.Merge("mt-0.5 rounded-md px-2 py-1", lecture.Color)">
                            <span class="font-mono text-xs">@lecture.CourseCode</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@lecture.Course</span>
                            <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideClockCn Size="12" class="size-3" />
                                    @lecture.Time - @lecture.EndTime
                                </span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideMapPinCn Size="12" class="size-3" />
                                    @lecture.Room
                                </span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideUserCn Size="12" class="size-3" />
                                    @lecture.Professor
                                </span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</section>

@code {
    private record Lecture(
        string Id,
        string Course,
        string CourseCode,
        string Professor,
        string Room,
        string Time,
        string EndTime,
        string Day,
        string Color,
        string Dot
    );

    private static readonly string[] _weekDays = ["Mon", "Tue", "Wed", "Thu", "Fri"];

    private const int _totalCredits = 15;

    private static readonly Lecture[] _lectures =
    [
        new("1",  "Data Structures",    "CS 301",   "Dr. Chen",    "Hall 205", "9:00 AM",  "10:30 AM", "Mon", "bg-blue-500/10",    "bg-blue-500"),
        new("2",  "Linear Algebra",     "MATH 240", "Prof. Adams", "Math 110", "11:00 AM", "12:15 PM", "Mon", "bg-emerald-500/10", "bg-emerald-500"),
        new("3",  "Organic Chemistry",  "CHEM 220", "Dr. Patel",   "Sci 340",  "2:00 PM",  "3:15 PM",  "Mon", "bg-amber-500/10",   "bg-amber-500"),
        new("4",  "Computer Networks",  "CS 330",   "Prof. Kim",   "Hall 301", "9:00 AM",  "10:30 AM", "Tue", "bg-purple-500/10",  "bg-purple-500"),
        new("5",  "Technical Writing",  "ENG 210",  "Dr. Foster",  "Arts 102", "11:00 AM", "12:15 PM", "Tue", "bg-rose-500/10",    "bg-rose-500"),
        new("6",  "Data Structures",    "CS 301",   "Dr. Chen",    "Lab 105",  "1:00 PM",  "3:00 PM",  "Tue", "bg-blue-500/10",    "bg-blue-500"),
        new("7",  "Linear Algebra",     "MATH 240", "Prof. Adams", "Math 110", "11:00 AM", "12:15 PM", "Wed", "bg-emerald-500/10", "bg-emerald-500"),
        new("8",  "Organic Chemistry",  "CHEM 220", "Dr. Patel",   "Sci 340",  "2:00 PM",  "3:15 PM",  "Wed", "bg-amber-500/10",   "bg-amber-500"),
        new("9",  "Data Structures",    "CS 301",   "Dr. Chen",    "Hall 205", "9:00 AM",  "10:30 AM", "Thu", "bg-blue-500/10",    "bg-blue-500"),
        new("10", "Computer Networks",  "CS 330",   "Prof. Kim",   "Hall 301", "9:00 AM",  "10:30 AM", "Fri", "bg-purple-500/10",  "bg-purple-500"),
    ];

    private string _selectedDay = "Mon";

    private Lecture[] DayLectures => _lectures.Where(l => l.Day == _selectedDay).ToArray();

    private int UniqueCourses => _lectures.Select(l => l.CourseCode).Distinct().Count();
}
