@* ============================================================
   Block: calendar-delivery-tracking
   Title: CalendarDeliveryTracking
   Description: A package delivery tracking calendar block for Next.js with shipment statuses, estimated arrival dates, and carrier details using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-delivery-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Delivery Tracking</h2>
                <p class="text-muted-foreground text-xs">@_deliveries.Length packages</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="truck" Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_activeCount</span>
                <span class="text-muted-foreground text-xs">in transit</span>
            </div>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            @foreach (var f in new[] { "active", "delivered", "all" })
            {
                var filterF = f;
                <ButtonCn Variant="@(_filter == filterF ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          class="h-6 px-2 text-xs capitalize"
                          @onclick="@(() => _filter = filterF)">
                    @filterF
                </ButtonCn>
            }
        </div>

        <div>
            @for (var i = 0; i < _filtered.Length; i++)
            {
                var index = i;
                var delivery = _filtered[index];
                var config = _statusConfig[delivery.Status];
                <div class="@Cn.Merge("px-4 py-3", index < _filtered.Length - 1 ? "border-b" : "")">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@delivery.Item</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                    @config.Label
                                </BadgeCn>
                            </div>
                            <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                                <span>@delivery.Carrier</span>
                                <span>·</span>
                                <span class="font-mono">@delivery.TrackingId</span>
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="clock" Size="12" class="size-3" />
                                    Est. @delivery.EstimatedDate
                                </span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="@config.IconName" Size="12" class="size-3" />
                                    @delivery.LastLocation
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Delivery(string Id, string Item, string Carrier, string TrackingId, string Status,
        string OrderedDate, string EstimatedDate, string LastUpdate, string LastLocation);

    private record StatusConfig(string Label, string Dot, string IconName);

    private static readonly Delivery[] _deliveries =
    [
        new("1", "MacBook Pro 16-inch", "FedEx", "FX-892741", "out-for-delivery", "Mar 12", "Mar 18", "8:30 AM", "Local delivery facility"),
        new("2", "Ergonomic Standing Desk", "UPS", "UP-334521", "in-transit", "Mar 14", "Mar 20", "Yesterday", "Denver distribution center"),
        new("3", "Wireless Keyboard & Mouse", "USPS", "US-667823", "shipped", "Mar 16", "Mar 22", "Mar 16", "Origin facility"),
        new("4", "Monitor Arm Mount", "Amazon", "AZ-112344", "ordered", "Mar 17", "Mar 24", "Mar 17", "Processing"),
        new("5", "USB-C Hub", "FedEx", "FX-445589", "delivered", "Mar 8", "Mar 14", "Mar 13", "Front door"),
        new("6", "Webcam HD Pro", "DHL", "DH-778234", "delivered", "Mar 5", "Mar 11", "Mar 10", "Signed by: J. Smith"),
    ];

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["ordered"] = new("Ordered", "bg-muted-foreground/40", "package"),
        ["shipped"] = new("Shipped", "bg-blue-500", "package"),
        ["in-transit"] = new("In Transit", "bg-amber-500", "truck"),
        ["out-for-delivery"] = new("Out for Delivery", "bg-purple-500", "truck"),
        ["delivered"] = new("Delivered", "bg-emerald-500", "check-circle-2"),
    };

    private string _filter = "active";

    private Delivery[] _filtered => _filter switch
    {
        "active" => _deliveries.Where(d => d.Status != "delivered").ToArray(),
        "delivered" => _deliveries.Where(d => d.Status == "delivered").ToArray(),
        _ => _deliveries,
    };

    private int _activeCount => _deliveries.Count(d => d.Status != "delivered");
}
