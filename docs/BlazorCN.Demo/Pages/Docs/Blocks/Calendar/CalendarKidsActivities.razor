@* ============================================================
   Block: calendar-kids-activities
   Title: CalendarKidsActivities
   Description: A kids activity schedule block for Next.js with after-school programs, class times, and parent coordination using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-kids-activities.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Kids Activities</h2>
                <p class="text-muted-foreground text-xs">Week of Mar 17, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="backpack" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_activities.Length</span>
                <span class="text-muted-foreground text-xs">activities</span>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <ButtonCn Variant="@(_selectedChild == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                      Size="ButtonSize.Sm"
                      Class="h-6 px-2 text-xs"
                      @onclick="@(() => SetSelectedChild("all"))">
                All
            </ButtonCn>
            @foreach (var child in _children)
            {
                var c = child;
                <button type="button"
                        @onclick="@(() => SetSelectedChild(c.Id))"
                        class="@Cn.Merge("flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs transition-opacity", c.Color, _selectedChild == c.Id ? "" : "opacity-50")">
                    @c.Name
                </button>
            }
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            @foreach (var day in _days)
            {
                var d = day;
                <ButtonCn Variant="@(_selectedDay == d ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-3 text-xs"
                          @onclick="@(() => SetSelectedDay(d))">
                    @d
                </ButtonCn>
            }
        </div>

        <div>
            @if (_filtered.Count == 0)
            {
                <div class="px-4 py-8 text-center">
                    <span class="text-muted-foreground text-xs">No activities scheduled</span>
                </div>
            }
            else
            {
                @for (var i = 0; i < _filtered.Count; i++)
                {
                    var activity = _filtered[i];
                    var idx = i;
                    var child = GetChild(activity.ChildId);
                    <div class="@Cn.Merge("px-4 py-3", idx < _filtered.Count - 1 ? "border-b" : "")">
                        <div class="flex items-start gap-3">
                            @if (child != null)
                            {
                                <span class="@Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", child.Dot)"></span>
                            }
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@activity.Title</span>
                                    @if (child != null)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary"
                                                 Class="@Cn.Merge("font-normal text-xs", child.Color)">
                                            @child.Name
                                        </BadgeCn>
                                    }
                                </div>
                                <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                        @activity.Time - @activity.EndTime
                                    </span>
                                    <span>·</span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                        @activity.Location
                                    </span>
                                </div>
                                <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>Instructor: @activity.Instructor</span>
                                    <span>·</span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="user" Size="12" Class="size-3" />
                                        Pickup: @activity.Pickup
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record Child(string Id, string Name, string Initials, string Color, string Dot);
    private record Activity(string Id, string Title, string ChildId, string Day, string Time, string EndTime, string Location, string Instructor, string Pickup);

    private static readonly Child[] _children =
    [
        new("emma", "Emma", "E", "bg-purple-100 text-purple-700", "bg-purple-500"),
        new("jack", "Jack", "J", "bg-emerald-100 text-emerald-700", "bg-emerald-500"),
    ];

    private static readonly Activity[] _activities =
    [
        new("1", "Piano Lesson", "emma", "Mon", "3:30 PM", "4:30 PM", "Music Academy", "Ms. Harper", "Dad"),
        new("2", "Soccer Practice", "jack", "Mon", "4:00 PM", "5:30 PM", "Riverside Park", "Coach Martinez", "Mom"),
        new("3", "Art Class", "emma", "Tue", "3:30 PM", "5:00 PM", "Creative Studio", "Ms. Rivera", "Mom"),
        new("4", "Swim Class", "jack", "Tue", "4:00 PM", "5:00 PM", "Community Pool", "Mr. Chen", "Dad"),
        new("5", "Dance Class", "emma", "Wed", "4:00 PM", "5:00 PM", "Dance World", "Ms. Patel", "Mom"),
        new("6", "Basketball", "jack", "Wed", "3:30 PM", "5:00 PM", "School Gym", "Coach Williams", "Dad"),
        new("7", "Coding Club", "emma", "Thu", "3:30 PM", "4:30 PM", "Library", "Mr. Lee", "Dad"),
        new("8", "Karate", "jack", "Thu", "4:00 PM", "5:00 PM", "Dojo Center", "Sensei Tanaka", "Mom"),
    ];

    private static readonly string[] _days = ["Mon", "Tue", "Wed", "Thu"];

    private string _selectedChild = "all";
    private string _selectedDay = "Mon";
    private List<Activity> _filtered = [];

    protected override void OnInitialized()
    {
        UpdateFiltered();
    }

    private void SetSelectedChild(string child)
    {
        _selectedChild = child;
        UpdateFiltered();
    }

    private void SetSelectedDay(string day)
    {
        _selectedDay = day;
        UpdateFiltered();
    }

    private void UpdateFiltered()
    {
        _filtered = _activities
            .Where(a => (_selectedChild == "all" || a.ChildId == _selectedChild) && a.Day == _selectedDay)
            .ToList();
    }

    private Child? GetChild(string id) => _children.FirstOrDefault(c => c.Id == id);
}
