@* ============================================================
   Block: calendar-property-viewings
   Title: CalendarPropertyViewings
   Description: A property viewing schedule calendar block for Next.js with listing details, time slot booking, agent assignment, and viewing feedback using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-property-viewings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHouseCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Property Viewings</span>
                    <p class="text-muted-foreground text-xs">
                        @_todayCount today · @_pending pending confirmation
                    </p>
                </div>
            </div>
        </div>

        <div>
            @for (var vi = 0; vi < _viewings.Length; vi++)
            {
                var idx = vi;
                var viewing = _viewings[idx];
                var isExpanded = _expanded == viewing.Id;
                var config = _statusConfig[viewing.Status];
                <div class="@(idx < _viewings.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? "" : viewing.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@viewing.Address</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="shrink-0 font-normal text-[10px]">
                                    @viewing.Type
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideClockCn Size="12" class="size-3" />
                                    @viewing.Time
                                </span>
                                <span class="font-medium tabular-nums">@viewing.Price</span>
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            <div class="mb-2 flex items-center gap-4 text-sm">
                                <span class="text-muted-foreground">@viewing.Bedrooms bed</span>
                                <span class="text-muted-foreground">@viewing.Sqft sqft</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @config.Label
                                </BadgeCn>
                            </div>
                            <div class="flex flex-col gap-1.5 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1.5">
                                    <LucideUserCn Size="12" class="size-3" />
                                    <span class="text-foreground">@viewing.Agent</span> showing to @viewing.Client
                                </span>
                                <span class="flex items-center gap-1.5">
                                    <LucideMapPinCn Size="12" class="size-3" />
                                    @viewing.Address
                                </span>
                            </div>
                            <p class="mt-2 text-muted-foreground text-xs italic">@viewing.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _statusConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Value.Dot)"></span>
                    @entry.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record PropertyViewing(string Id, string Address, string Type, string Price, string Time, string Date, string Agent, string Client, string Status, int Bedrooms, string Sqft, string Notes);
    private record StatusInfo(string Dot, string Label);

    private static readonly Dictionary<string, StatusInfo> _statusConfig = new()
    {
        ["confirmed"] = new("bg-emerald-500", "Confirmed"),
        ["pending"]   = new("bg-amber-500",   "Pending"),
        ["completed"] = new("bg-blue-500",     "Completed"),
        ["cancelled"] = new("bg-red-500",      "Cancelled"),
    };

    private static readonly PropertyViewing[] _viewings =
    [
        new("1", "142 Elm Street, Unit 3A", "Apartment",     "$2,850/mo", "9:00 AM - 9:30 AM",   "Mar 24, 2026", "Rachel Kim",    "David & Sarah Chen",   "confirmed", 2, "1,100", "Couple relocating from Boston. Looking for pet-friendly with parking."),
        new("2", "28 Oak Avenue",           "Townhouse",     "$485,000",  "10:30 AM - 11:15 AM", "Mar 24, 2026", "Marcus Torres", "Emily Watson",          "confirmed", 3, "1,850", "First-time buyer. Pre-approved for $500K. Interested in backyard space."),
        new("3", "567 Maple Drive",         "Single Family", "$725,000",  "1:00 PM - 1:45 PM",   "Mar 24, 2026", "Rachel Kim",    "James & Olivia Park",   "pending",   4, "2,400", "Upgrading from condo. Need good school district. Second viewing."),
        new("4", "89 Pine Lane, Suite B",   "Condo",         "$325,000",  "3:00 PM - 3:30 PM",   "Mar 24, 2026", "Marcus Torres", "Alex Rivera",           "pending",   1, "750",   "Investment property. Client wants to see HOA financials."),
        new("5", "210 Birch Road",          "Single Family", "$599,000",  "9:30 AM - 10:15 AM",  "Mar 23, 2026", "Rachel Kim",    "Nina Ortiz",            "completed", 3, "1,950", "Client loved the kitchen. Wants to submit an offer. Follow up required."),
    ];

    private int _todayCount => _viewings.Count(v => v.Date == "Mar 24, 2026");
    private int _pending    => _viewings.Count(v => v.Status == "pending");

    private string _expanded = "1";
}
