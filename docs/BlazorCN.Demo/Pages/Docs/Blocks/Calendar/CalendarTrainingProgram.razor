@* ============================================================
   Block: calendar-training-program
   Title: CalendarTrainingProgram
   Description: A training program schedule calendar block for Next.js with workout plans, weekly periodization, exercise tracking, and progress logging using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-training-program.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="dumbbell" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Training Program</span>
                    <p class="text-muted-foreground text-xs">Week 6 of 12 · Hypertrophy Phase</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs tabular-nums">
                    @WeekVolume/@TotalExercises exercises
                </span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _trainingDays.Length; i++)
            {
                var idx = i;
                var day = _trainingDays[idx];
                var isExpanded = _expanded == day.Id;
                var config = _typeConfig[day.Type];
                var doneCount = day.Exercises.Count(e => _doneExercises.Contains(e.Id));
                var capturedDayId = day.Id;
                var capturedIsExpanded = isExpanded;

                <div class="@(idx < _trainingDays.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = capturedIsExpanded ? "" : capturedDayId)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (day.Status == "completed")
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                        }
                        else
                        {
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@day.Day</span>
                                <span class="text-muted-foreground text-xs">@day.Date</span>
                                @if (day.Status == "today")
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                        Today
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @day.Focus · @day.Duration
                            </p>
                        </div>
                        @if (day.Exercises.Length > 0)
                        {
                            <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                                @doneCount/@day.Exercises.Length
                            </span>
                        }
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded && day.Exercises.Length > 0)
                    {
                        <div class="border-t">
                            <div class="px-4 py-1">
                                @foreach (var ex in day.Exercises)
                                {
                                    var exercise = ex;
                                    var isDone = _doneExercises.Contains(exercise.Id);
                                    <div class="flex items-center gap-2.5 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                                        <button
                                            type="button"
                                            aria-label="@(isDone ? $"Mark {exercise.Name} not done" : $"Mark {exercise.Name} done")"
                                            @onclick="@(() => ToggleExercise(exercise.Id))"
                                            class="shrink-0">
                                            @if (isDone)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="circle" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                            }
                                        </button>
                                        <span class="@Cn.Merge("flex-1 text-sm", isDone ? "text-muted-foreground line-through" : "")">
                                            @exercise.Name
                                        </span>
                                        <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                            @($"{exercise.Sets}×{exercise.Reps}")
                                        </span>
                                        <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                            @exercise.Weight
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (isExpanded && day.Type == "rest")
                    {
                        <div class="border-t px-4 py-3">
                            <p class="text-muted-foreground text-xs">
                                Full rest day. Light walking and stretching encouraged. Prioritize sleep and
                                nutrition.
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var kvp in _typeConfig)
            {
                var val = kvp.Value;
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", val.Dot)"></span>
                    @val.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record Exercise(string Id, string Name, string Sets, string Reps, string Weight);
    private record TrainingDay(string Id, string Day, string Date, string Type, string Focus, string Status, string Duration, Exercise[] Exercises);
    private record TypeConfig(string Dot, string Label);

    private static readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["strength"] = new("bg-blue-500", "Strength"),
        ["cardio"] = new("bg-red-500", "Cardio"),
        ["flexibility"] = new("bg-violet-500", "Flexibility"),
        ["rest"] = new("bg-zinc-400", "Rest"),
    };

    private static readonly TrainingDay[] _trainingDays =
    [
        new("1", "Monday", "Mar 23", "strength", "Upper Body Push", "completed", "60 min", [
            new("e1", "Bench Press", "4", "8", "185 lbs"),
            new("e2", "Overhead Press", "3", "10", "115 lbs"),
            new("e3", "Incline Dumbbell Press", "3", "12", "60 lbs"),
            new("e4", "Lateral Raises", "3", "15", "25 lbs"),
            new("e5", "Tricep Dips", "3", "12", "BW"),
        ]),
        new("2", "Tuesday", "Mar 24", "strength", "Lower Body", "today", "65 min", [
            new("e6", "Back Squat", "4", "6", "255 lbs"),
            new("e7", "Romanian Deadlift", "3", "10", "185 lbs"),
            new("e8", "Bulgarian Split Squat", "3", "10/leg", "50 lbs"),
            new("e9", "Leg Curl", "3", "12", "90 lbs"),
            new("e10", "Calf Raises", "4", "15", "135 lbs"),
        ]),
        new("3", "Wednesday", "Mar 25", "cardio", "HIIT + Core", "upcoming", "40 min", [
            new("e11", "Rowing Intervals", "8", "30s on/30s off", "—"),
            new("e12", "Plank Variations", "3", "45s", "BW"),
            new("e13", "Russian Twists", "3", "20", "25 lbs"),
            new("e14", "Hanging Leg Raises", "3", "12", "BW"),
        ]),
        new("4", "Thursday", "Mar 26", "strength", "Upper Body Pull", "upcoming", "60 min", [
            new("e15", "Barbell Row", "4", "8", "175 lbs"),
            new("e16", "Pull-ups", "4", "8", "BW+25"),
            new("e17", "Face Pulls", "3", "15", "40 lbs"),
            new("e18", "Barbell Curl", "3", "12", "75 lbs"),
        ]),
        new("5", "Friday", "Mar 27", "flexibility", "Yoga + Mobility", "upcoming", "45 min", [
            new("e19", "Hip Opener Flow", "1", "10 min", "—"),
            new("e20", "Thoracic Spine Mobility", "1", "10 min", "—"),
            new("e21", "Hamstring Stretches", "1", "10 min", "—"),
        ]),
        new("6", "Saturday", "Mar 28", "strength", "Full Body Power", "upcoming", "55 min", [
            new("e22", "Deadlift", "5", "3", "315 lbs"),
            new("e23", "Power Clean", "4", "5", "155 lbs"),
            new("e24", "Weighted Pull-up", "3", "6", "BW+35"),
        ]),
        new("7", "Sunday", "Mar 29", "rest", "Recovery", "upcoming", "—", []),
    ];

    private string _expanded = "2";
    private HashSet<string> _doneExercises = ["e1", "e2", "e3", "e4", "e5", "e6", "e7"];

    private int WeekVolume => _trainingDays.Sum(d => d.Exercises.Count(e => _doneExercises.Contains(e.Id)));
    private int TotalExercises => _trainingDays.Sum(d => d.Exercises.Length);

    private void ToggleExercise(string exerciseId)
    {
        if (!_doneExercises.Remove(exerciseId))
            _doneExercises.Add(exerciseId);
    }
}
