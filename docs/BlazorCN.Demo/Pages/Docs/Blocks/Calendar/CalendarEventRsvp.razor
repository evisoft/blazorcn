@* ============================================================
   Block: calendar-event-rsvp
   Title: Calendar Event Rsvp
   Description: React event RSVP card block for Next.js with attending, maybe, and decline buttons, guest count tracker, notes field, and response summary built with shadcn/ui and Tailwind CSS
   Long Description: React Calendar Event Details Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-event-rsvp.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Event header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">@_eventData.Title</span>
                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                    In 23 days
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">@_eventData.Description</p>
        </div>

        @* Event details *@
        <div class="space-y-2 border-b px-4 py-3">
            <div class="flex items-center gap-2 text-sm">
                <LucideCalendarCn Size="14" class="size-3.5 text-muted-foreground" />
                <span>@_eventData.Date</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
                <LucideClockCn Size="14" class="size-3.5 text-muted-foreground" />
                <span>@_eventData.Time</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
                <LucideMapPinCn Size="14" class="size-3.5 text-muted-foreground" />
                <span>@_eventData.Location</span>
            </div>
        </div>

        @* RSVP actions *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Your response
            </span>
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(_myStatus == "attending" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          class="h-7 gap-1.5 text-xs"
                          @onclick="@(() => _myStatus = "attending")">
                    <LucideCheckCn Size="12" class="size-3" />
                    Attending
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(_myStatus == "maybe" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          class="h-7 gap-1.5 text-xs"
                          @onclick="@(() => _myStatus = "maybe")">
                    <LucideCircleHelpCn Size="12" class="size-3" />
                    Maybe
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(_myStatus == "declined" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          class="h-7 gap-1.5 text-xs"
                          @onclick="@(() => _myStatus = "declined")">
                    <LucideXCn Size="12" class="size-3" />
                    Decline
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="ButtonVariant.Ghost"
                          class="ml-auto h-7 gap-1 px-2 text-xs"
                          @onclick="@(() => _showNote = !_showNote)">
                    <LucideMessageSquareCn Size="12" class="size-3" />
                    Note
                </ButtonCn>
            </div>
            @if (_showNote)
            {
                <div class="mt-2">
                    <input type="text"
                           @bind="_note"
                           placeholder="Add a note for the organizer..."
                           class="h-8 w-full rounded-md border-0 bg-muted/50 px-3 text-sm shadow-none outline-none placeholder:text-muted-foreground focus-visible:ring-0" />
                </div>
            }
        </div>

        @* Guest count summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideUsersCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_guests.Length</span>
                <span class="text-muted-foreground text-xs">invited</span>
            </div>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_countAttending
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_countMaybe
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_countDeclined
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                    @_countPending
                </span>
            </div>
        </div>

        @* Guest list *@
        <div>
            @for (var i = 0; i < _guests.Length; i++)
            {
                var guest = _guests[i];
                var isLast = i == _guests.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @guest.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@guest.Name</span>
                        @if (!string.IsNullOrEmpty(guest.Note))
                        {
                            <p class="truncate text-muted-foreground text-xs">@guest.Note</p>
                        }
                    </div>
                    @if (guest.Status is not null)
                    {
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[guest.Status])"></span>
                            @(guest.Status == "attending" ? "Going" : guest.Status == "maybe" ? "Maybe" : "Declined")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted-foreground/60 text-xs">No response</span>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EventInfo(string Title, string Date, string Time, string Location, string Description);
    private record Guest(string Id, string Name, string Initials, string? Status, string? Note = null);

    private static readonly EventInfo _eventData = new(
        "Q2 Product Launch Party",
        "Thursday, April 10, 2026",
        "6:00 PM - 9:00 PM",
        "Rooftop Terrace, 450 Market St",
        "Join us to celebrate the Q2 product launch with drinks, demos, and team recognition awards."
    );

    private static readonly Guest[] _guests =
    [
        new("1", "Sarah Chen", "SC", "attending"),
        new("2", "Marcus Johnson", "MJ", "attending"),
        new("3", "Elena Rodriguez", "ER", "maybe", "Depends on flight timing"),
        new("4", "David Kim", "DK", "attending"),
        new("5", "Priya Patel", "PP", "declined", "Out of town"),
        new("6", "James Wilson", "JW", "maybe"),
        new("7", "Aisha Thompson", "AT", "attending"),
        new("8", "Leo Martinez", "LM", null),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["attending"] = "bg-emerald-500",
        ["maybe"] = "bg-amber-500",
        ["declined"] = "bg-red-500",
    };

    private int _countAttending => _guests.Count(g => g.Status == "attending");
    private int _countMaybe => _guests.Count(g => g.Status == "maybe");
    private int _countDeclined => _guests.Count(g => g.Status == "declined");
    private int _countPending => _guests.Count(g => g.Status is null);

    private string _myStatus = "attending";
    private string _note = "";
    private bool _showNote;
}
