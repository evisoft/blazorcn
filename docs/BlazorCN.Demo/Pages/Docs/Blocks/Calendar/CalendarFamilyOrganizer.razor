@* ============================================================
   Block: calendar-family-organizer
   Title: CalendarFamilyOrganizer
   Description: A family activity organizer calendar block for Next.js with member-specific schedules, color-coded members, and shared event management using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-family-organizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Family Organizer</h2>
                <p class="text-muted-foreground text-xs">Week of Mar 17, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideUsersCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_members.Length</span>
                <span class="text-muted-foreground text-xs">members</span>
            </div>
        </div>

        @* Member filter toggles *@
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            @foreach (var member in _members)
            {
                var m = member;
                <button
                    type="button"
                    @onclick="@(() => ToggleMember(m.Id))"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs transition-opacity", m.Color, _visibleMembers.Contains(m.Id) ? "" : "opacity-30")">
                    @m.Name
                </button>
            }
        </div>

        @* Day selector *@
        <div class="flex gap-1 border-b px-4 py-2">
            @foreach (var day in _schedule)
            {
                var d = day;
                <ButtonCn
                    Variant="@(_selectedDay == d.Date ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                    Size="ButtonSize.Sm"
                    class="h-6 px-2 text-xs"
                    @onclick="@(() => _selectedDay = d.Date)">
                    @(d.Day.Substring(0, 3)) @(d.Date.Split(' ')[1])
                </ButtonCn>
            }
        </div>

        @* Selected day schedule *@
        @if (SelectedSchedule is not null)
        {
            var sel = SelectedSchedule;
            var filteredEvents = sel.Events.Where(e => e.MemberIds.Any(id => _visibleMembers.Contains(id))).ToArray();
            <div>
                <div class="border-b px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">@sel.Day, @sel.Date</span>
                </div>
                @for (var i = 0; i < filteredEvents.Length; i++)
                {
                    var idx = i;
                    var evt = filteredEvents[idx];
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2.5", idx < filteredEvents.Length - 1 ? "border-b" : "")">
                        <span class="w-16 shrink-0 pt-0.5 font-mono text-muted-foreground text-xs tabular-nums">
                            @evt.Time
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@evt.Title</span>
                            @if (!string.IsNullOrEmpty(evt.Location))
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">@evt.Location</p>
                            }
                            <div class="mt-1 flex items-center gap-1">
                                @foreach (var memberId in evt.MemberIds)
                                {
                                    var mid = memberId;
                                    var mem = GetMember(mid);
                                    @if (mem is not null)
                                    {
                                        <span class="@Cn.Merge("size-1.5 rounded-full", mem.Dot)"></span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record FamilyMember(string Id, string Name, string Initials, string Color, string Dot);
    private record FamilyEvent(string Id, string Title, string Time, string[] MemberIds, string Location = "");
    private record DaySchedule(string Date, string Day, FamilyEvent[] Events);

    private static readonly FamilyMember[] _members =
    [
        new("mom",  "Mom",  "M", "bg-rose-100 text-rose-700",     "bg-rose-500"),
        new("dad",  "Dad",  "D", "bg-blue-100 text-blue-700",     "bg-blue-500"),
        new("emma", "Emma", "E", "bg-purple-100 text-purple-700", "bg-purple-500"),
        new("jack", "Jack", "J", "bg-emerald-100 text-emerald-700", "bg-emerald-500"),
    ];

    private static readonly DaySchedule[] _schedule =
    [
        new("Mar 18", "Tuesday",
        [
            new("1",  "School Drop-off", "7:45 AM", ["dad", "emma", "jack"]),
            new("2",  "Yoga Class",      "9:00 AM", ["mom"]),
            new("3",  "Soccer Practice", "3:30 PM", ["jack"],               "Riverside Park"),
            new("4",  "Piano Lesson",    "4:00 PM", ["emma"],               "Music Academy"),
            new("5",  "Family Dinner",   "6:30 PM", ["mom", "dad", "emma", "jack"], "Home"),
        ]),
        new("Mar 19", "Wednesday",
        [
            new("6",  "School Drop-off",      "7:45 AM", ["mom", "emma", "jack"]),
            new("7",  "Team Meeting",          "10:00 AM", ["dad"]),
            new("8",  "Dentist Appointment",   "2:00 PM",  ["emma"], "Bright Smiles Dental"),
            new("9",  "Swim Class",            "4:00 PM",  ["jack"], "Community Pool"),
            new("10", "Date Night",            "7:00 PM",  ["mom", "dad"], "Cafe Bella"),
        ]),
        new("Mar 20", "Thursday",
        [
            new("11", "School Drop-off",      "7:45 AM", ["dad", "emma", "jack"]),
            new("12", "Book Club",            "10:00 AM", ["mom"]),
            new("13", "Art Class",            "3:30 PM",  ["emma"], "Creative Studio"),
            new("14", "Basketball Practice",  "4:00 PM",  ["jack"], "School Gym"),
        ]),
    ];

    private HashSet<string> _visibleMembers = new(["mom", "dad", "emma", "jack"]);
    private string _selectedDay = "Mar 18";

    private DaySchedule? SelectedSchedule => _schedule.FirstOrDefault(s => s.Date == _selectedDay);

    private void ToggleMember(string memberId)
    {
        if (_visibleMembers.Contains(memberId))
            _visibleMembers.Remove(memberId);
        else
            _visibleMembers.Add(memberId);
    }

    private FamilyMember? GetMember(string id) => _members.FirstOrDefault(m => m.Id == id);
}
