@* ============================================================
   Block: calendar-class-timetable
   Title: Calendar Class Timetable
   Description: React class timetable calendar block for Next.js with subject color coding, room numbers, instructor names, and weekly schedule grid using shadcn/ui and Tailwind CSS
   Long Description: React Marketing Campaign Timeline Calendar Block
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-class-timetable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBookOpenCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Class Timetable</span>
            </div>
            <span class="text-muted-foreground text-xs">Spring 2026</span>
        </div>

        @* Timetable grid *@
        <div class="overflow-x-auto">
            <div class="min-w-[640px]">
                @* Day headers *@
                <div class="grid grid-cols-[4.5rem_repeat(5,1fr)] border-b">
                    <div class="border-r px-2 py-2">
                        <span class="text-muted-foreground text-xs">Time</span>
                    </div>
                    @foreach (var day in _weekDays)
                    {
                        <div class="border-r px-2 py-2 text-center last:border-r-0">
                            <span class="font-medium text-xs">@day</span>
                        </div>
                    }
                </div>

                @* Time slots *@
                @for (var si = 0; si < _timeSlots.Length; si++)
                {
                    var slot = _timeSlots[si];
                    var isLast = si == _timeSlots.Length - 1;

                    <div class="@Cn.Merge("grid grid-cols-[4.5rem_repeat(5,1fr)]", isLast ? "" : "border-b")">
                        <div class="border-r px-2 py-3">
                            <span class="text-muted-foreground text-xs tabular-nums">@slot.Time</span>
                        </div>
                        @for (var di = 0; di < _weekDays.Length; di++)
                        {
                            var dayIndex = di;
                            var session = _sessions.FirstOrDefault(s => s.TimeSlot == slot.Time && s.DayIndex == dayIndex);

                            <div class="border-r p-1 last:border-r-0">
                                @if (session != null)
                                {
                                    var style = _subjectStyles[session.Subject];
                                    <div class="@Cn.Merge("rounded-md border-l-2 px-2 py-1.5", style.Bg, style.Border)">
                                        <span class="@Cn.Merge("block truncate font-medium text-xs", style.Text)">@session.Subject</span>
                                        <span class="block truncate text-muted-foreground text-[10px]">@session.Room</span>
                                        <span class="block truncate text-muted-foreground text-[10px]">@session.Instructor</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Legend *@
        <div class="flex flex-wrap items-center gap-3 border-t px-4 py-2">
            @foreach (var kvp in _subjectStyles)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-2 rounded-sm", kvp.Value.Bg, "ring-1 ring-inset ring-black/5")"></span>
                    @kvp.Key
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record TimeSlotInfo(string Time);
    private record SubjectStyleInfo(string Bg, string Border, string Text);
    private record ClassSession(string Subject, string Room, string Instructor, string TimeSlot, int DayIndex);

    private static readonly string[] _weekDays = ["Mon", "Tue", "Wed", "Thu", "Fri"];

    private static readonly TimeSlotInfo[] _timeSlots =
    [
        new("8:00 AM"), new("9:00 AM"), new("10:00 AM"), new("11:00 AM"),
        new("12:00 PM"), new("1:00 PM"), new("2:00 PM"), new("3:00 PM"),
    ];

    private static readonly Dictionary<string, SubjectStyleInfo> _subjectStyles = new()
    {
        ["Mathematics"] = new("bg-blue-500/10", "border-l-blue-500", "text-blue-700 dark:text-blue-300"),
        ["Physics"] = new("bg-emerald-500/10", "border-l-emerald-500", "text-emerald-700 dark:text-emerald-300"),
