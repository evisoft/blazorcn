        ["History"] = new("bg-rose-500/10", "border-l-rose-500", "text-rose-700 dark:text-rose-300"),
        ["CS"] = new("bg-cyan-500/10", "border-l-cyan-500", "text-cyan-700 dark:text-cyan-300"),
    };

    private static readonly ClassSession[] _sessions =
    [
