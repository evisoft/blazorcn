@* ============================================================
   Block: calendar-compact-week
   Title: CalendarCompactWeek
   Description: A compact 7-day overview calendar block for Next.js with mini event indicators, daily summaries, and quick-glance layout using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-compact-week.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">This Week</h2>
                <p class="text-muted-foreground text-xs">Mar 17 - 23, 2026</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn aria-label="Previous week" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="size-7 p-0">
                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="h-7 text-xs">
                    Today
                </ButtonCn>
                <ButtonCn aria-label="Next week" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="size-7 p-0">
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        <div class="grid grid-cols-7 border-b">
            @foreach (var day in _weekDays)
            {
                var d = day;
                <button
                    type="button"
                    @onclick="@(() => _selectedDay = d.Date)"
                    class="@Cn.Merge("flex flex-col items-center gap-1 py-3 transition-colors hover:bg-muted/50", _selectedDay == d.Date ? "bg-muted/50" : "")">
                    <span class="text-muted-foreground text-xs">@d.Label</span>
                    <span class="@Cn.Merge("flex size-7 items-center justify-center rounded-full font-medium text-sm tabular-nums", d.IsToday ? "bg-foreground text-background" : "")">
                        @d.DayNum
                    </span>
                    <div class="flex items-center gap-0.5">
                        @foreach (var evt in d.Events.Take(3))
                        {
                            var e = evt;
                            <span class="@Cn.Merge("size-1 rounded-full", _categoryDot[e.Category])"></span>
                        }
                        @if (d.Events.Length == 0)
                        {
                            <span class="size-1"></span>
                        }
                    </div>
                </button>
            }
        </div>

        <div class="px-4 py-2 border-b">
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_totalEvents events this week</span>
                <span>·</span>
                @foreach (var pair in _categoryDot)
                {
                    var key = pair.Key;
                    var dot = pair.Value;
                    <span class="flex items-center gap-1">
                        <span class="@Cn.Merge("size-1.5 rounded-full", dot)"></span>
                        @key
                    </span>
                }
            </div>
        </div>

        @if (_selected != null)
        {
            <div>
                <div class="border-b px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">
                        @_selected.Label, @_selected.Date
                    </span>
                    <span class="ml-2 text-muted-foreground text-xs">
                        @_selected.Events.Length event@(_selected.Events.Length != 1 ? "s" : "")
                    </span>
                </div>
                @if (_selected.Events.Length == 0)
                {
                    <div class="px-4 py-8 text-center">
                        <span class="text-muted-foreground text-xs">No events scheduled</span>
                    </div>
                }
                else
                {
                    @for (var ei = 0; ei < _selected.Events.Length; ei++)
                    {
                        var eIndex = ei;
                        var evt = _selected.Events[eIndex];
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", eIndex < _selected.Events.Length - 1 ? "border-b" : "")">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _categoryDot[evt.Category])"></span>
                            <span class="w-12 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                @evt.Time
                            </span>
                            <span class="font-medium text-sm">@evt.Title</span>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>

@code {
    private record DayEvent(string Id, string Title, string Time, string Category);
    private record WeekDay(string Label, string Date, string DayNum, bool IsToday, DayEvent[] Events);

    private static readonly Dictionary<string, string> _categoryDot = new()
    {
        ["meeting"] = "bg-blue-500",
        ["task"] = "bg-amber-500",
        ["personal"] = "bg-emerald-500",
    };

    private static readonly WeekDay[] _weekDays =
    [
        new("Mon", "Mar 17", "17", false, [
            new("1", "Sprint Planning", "9:00", "meeting"),
            new("2", "Code review", "14:00", "task"),
        ]),
        new("Tue", "Mar 18", "18", true, [
            new("3", "Design sync", "10:00", "meeting"),
            new("4", "Dentist", "15:00", "personal"),
            new("5", "API integration", "11:00", "task"),
        ]),
        new("Wed", "Mar 19", "19", false, [
            new("6", "Team standup", "9:30", "meeting"),
        ]),
        new("Thu", "Mar 20", "20", false, [
            new("7", "Client call", "14:00", "meeting"),
            new("8", "Write docs", "10:00", "task"),
        ]),
        new("Fri", "Mar 21", "21", false, [
            new("9", "Retro", "16:00", "meeting"),
            new("10", "Deploy v2.3", "11:00", "task"),
            new("11", "Happy hour", "17:30", "personal"),
        ]),
        new("Sat", "Mar 22", "22", false, [
            new("12", "Gym", "8:00", "personal"),
        ]),
        new("Sun", "Mar 23", "23", false, []),
    ];

    private string _selectedDay = "Mar 18";
    private WeekDay? _selected => _weekDays.FirstOrDefault(d => d.Date == _selectedDay);
    private int _totalEvents => _weekDays.Sum(d => d.Events.Length);
}
