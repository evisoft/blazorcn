@* ============================================================
   Block: calendar-moon-phases
   Title: Calendar Moon Phases
   Description: A React moon phase calendar block for Next.js with lunar phase icons, phase names, illumination percentage, and monthly cycle view built with shadcn/ui and Tailwind CSS
   Long Description: React Monthly Calendar View Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-moon-phases.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMoonCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Moon Phases</span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronLeftCn Class="size-4" />
                </ButtonCn>
                <span class="px-2 font-medium text-sm">March 2026</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronRightCn Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Key phases summary *@
        <div class="grid grid-cols-4 gap-px border-b bg-border">
            @foreach (var phase in _keyPhases)
            {
                var phaseId = phase.Id;
                <button type="button"
                        @onclick="@(() => _selected = phaseId)"
                        class="@($"flex flex-col items-center gap-1.5 bg-card px-2 py-3 transition-colors hover:bg-muted/50 {(_selected == phaseId ? "bg-muted/50" : "")}")">
                    <svg width="28" height="28" viewBox="0 0 28 28" class="text-foreground" role="img">
                        <title>Moon at @phase.Illumination% illumination</title>
                        <circle cx="14" cy="14" r="13" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2" />
                        <circle cx="14" cy="14" r="13" fill="currentColor" opacity="@(0.08 + phase.Illumination / 100.0 * 0.3)" />
                    </svg>
                    <span class="font-medium text-xs">@phase.Phase</span>
                    <span class="text-muted-foreground text-xs">@phase.Date</span>
                </button>
            }
        </div>

        @* Phase list *@
        <div>
            @for (int i = 0; i < _moonPhases.Length; i++)
            {
                var phase = _moonPhases[i];
                var isSelected = _selected == phase.Id;
                var isLast = i == _moonPhases.Length - 1;
                <button type="button"
                        @onclick="@(() => _selected = phase.Id)"
                        class="@($"flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50 {(isSelected ? "bg-muted/50" : "")} {(isLast ? "" : "border-b")}")">
                    <svg width="24" height="24" viewBox="0 0 24 24" class="text-foreground" role="img">
                        <title>Moon at @phase.Illumination%</title>
                        <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2" />
                        <circle cx="12" cy="12" r="11" fill="currentColor" opacity="@(0.08 + phase.Illumination / 100.0 * 0.3)" />
                    </svg>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@phase.Phase</span>
                            @if (phase.IsKeyPhase)
                            {
                                <span class="size-1.5 rounded-full bg-blue-500" />
                            }
                        </div>
                        <span class="text-muted-foreground text-xs">@phase.Date</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-muted-foreground text-xs tabular-nums">@phase.Illumination%</span>
                        @if (phase.IsKeyPhase)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Key</BadgeCn>
                        }
                    </div>
                </button>
            }
        </div>

        @* Selected phase detail *@
        @if (SelectedPhase != null)
        {
            <div class="border-t px-4 py-3">
                <div class="flex items-center gap-3">
                    <svg width="36" height="36" viewBox="0 0 36 36" class="text-foreground" role="img">
                        <title>Moon at @SelectedPhase.Illumination%</title>
                        <circle cx="18" cy="18" r="17" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2" />
                        <circle cx="18" cy="18" r="17" fill="currentColor" opacity="@(0.08 + SelectedPhase.Illumination / 100.0 * 0.3)" />
                    </svg>
                    <div>
                        <span class="font-medium text-sm">@SelectedPhase.Phase</span>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@SelectedPhase.Date, 2026</span>
                            <span>·</span>
                            <span class="tabular-nums">@SelectedPhase.Illumination% illuminated</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _selected = "6";

    private record MoonPhase(string Id, string Date, int Day, string Phase, int Illumination, bool IsKeyPhase);

    private MoonPhase? SelectedPhase => _moonPhases.FirstOrDefault(p => p.Id == _selected);

    private static readonly MoonPhase[] _moonPhases =
    [
        new("1", "Mar 1", 1, "Waxing Crescent", 15, false),
        new("2", "Mar 3", 3, "Waxing Crescent", 30, false),
        new("3", "Mar 6", 6, "First Quarter", 50, true),
        new("4", "Mar 9", 9, "Waxing Gibbous", 70, false),
        new("5", "Mar 11", 11, "Waxing Gibbous", 85, false),
        new("6", "Mar 14", 14, "Full Moon", 100, true),
        new("7", "Mar 17", 17, "Waning Gibbous", 85, false),
        new("8", "Mar 19", 19, "Waning Gibbous", 70, false),
        new("9", "Mar 21", 21, "Last Quarter", 50, true),
        new("10", "Mar 24", 24, "Waning Crescent", 30, false),
        new("11", "Mar 27", 27, "Waning Crescent", 12, false),
        new("12", "Mar 29", 29, "New Moon", 0, true),
    ];

    private static readonly MoonPhase[] _keyPhases = _moonPhases.Where(p => p.IsKeyPhase).ToArray();
}
