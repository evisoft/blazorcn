@* ============================================================
   Block: calendar-exam-schedule
   Title: Calendar Exam Schedule
   Description: A React exam and test schedule calendar block for Next.js with subject name, exam date, time, location, and study countdown timer built with shadcn/ui and Tailwind CSS
   Long Description: React Event RSVP Calendar Block
   Dependencies: BadgeCn
   Source: original/blocks/calendar/calendar-exam-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBookOpenCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Exam Schedule</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500" />
                    Today
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500" />
                    Upcoming
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500" />
                    Done
                </span>
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@_upcoming.Length</span>
                <span class="text-muted-foreground text-xs">remaining</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                Next exam in @(_upcoming.FirstOrDefault(e => e.DaysUntil >= 0)?.DaysUntil ?? 0) days
            </span>
        </div>

        @* Exam list *@
        <div>
            @for (int i = 0; i < _exams.Length; i++)
            {
                var exam = _exams[i];
                var isExpanded = _expanded == exam.Id;
                var isLast = i == _exams.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == exam.Id ? null : exam.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {GetStatusDot(exam.Status)}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@exam.Subject</span>
                                <span class="font-mono text-muted-foreground text-xs">@exam.Code</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@exam.Date</span>
                                <span>·</span>
                                <span>@exam.Time</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (exam.Status == "today")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Today</BadgeCn>
                            }
                            else if (exam.Status == "upcoming" && exam.DaysUntil > 0)
                            {
                                <span class="font-medium text-muted-foreground text-xs tabular-nums">@(exam.DaysUntil)d</span>
                            }
                            else if (exam.Status == "completed")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Done</BadgeCn>
                            }
                            <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="flex flex-col gap-2">
                                <div class="flex items-center gap-4 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1.5">
                                        <LucideClockCn Class="size-3" />
                                        @exam.Duration
                                    </span>
                                    <span class="flex items-center gap-1.5">
                                        <LucideMapPinCn Class="size-3" />
                                        @exam.Location
                                    </span>
                                    <span class="flex items-center gap-1.5">
                                        <LucideCalendarCn Class="size-3" />
                                        @GetStatusLabel(exam.Status)
                                    </span>
                                </div>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="font-medium text-muted-foreground text-xs">Topics to review</span>
                                    <div class="mt-2 flex flex-wrap gap-1.5">
                                        @foreach (var topic in exam.Topics)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@topic</BadgeCn>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record Exam(string Id, string Subject, string Code, string Date, string Time, string Duration, string Location, string Status, int DaysUntil, string[] Topics);

    private static readonly Exam[] _exams =
    [
        new("1", "Linear Algebra", "MATH 204", "Mar 18, 2026", "9:00 AM", "2 hours", "Hall A, Room 101", "today", 0, ["Eigenvalues", "Matrix decomposition", "Vector spaces"]),
        new("2", "Organic Chemistry", "CHEM 301", "Mar 21, 2026", "1:00 PM", "3 hours", "Science Building, Lab 4B", "upcoming", 3, ["Stereochemistry", "Reaction mechanisms", "Spectroscopy"]),
        new("3", "Data Structures", "CS 210", "Mar 24, 2026", "10:30 AM", "2 hours", "Engineering Hall, Room 305", "upcoming", 6, ["Binary trees", "Graph algorithms", "Hash tables"]),
        new("4", "Microeconomics", "ECON 202", "Mar 28, 2026", "2:00 PM", "2.5 hours", "Business School, Auditorium", "upcoming", 10, ["Market structures", "Game theory", "Consumer choice"]),
        new("5", "Modern Physics", "PHYS 310", "Apr 2, 2026", "9:00 AM", "3 hours", "Physics Building, Room 201", "upcoming", 15, ["Quantum mechanics", "Special relativity", "Wave-particle duality"]),
        new("6", "Technical Writing", "ENG 215", "Mar 14, 2026", "11:00 AM", "1.5 hours", "Liberal Arts, Room 110", "completed", -4, ["Research papers", "Citations", "Technical documentation"]),
    ];

    private static readonly Exam[] _upcoming = _exams.Where(e => e.Status != "completed").ToArray();

    private static string GetStatusDot(string status) => status switch
    {
        "today" => "bg-amber-500",
        "upcoming" => "bg-blue-500",
        "completed" => "bg-emerald-500",
        _ => "bg-zinc-400"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "today" => "Today",
        "upcoming" => "Upcoming",
        "completed" => "Completed",
        _ => status
    };
}
