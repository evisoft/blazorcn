@* ============================================================
   Block: calendar-holiday-manager
   Title: Calendar Holiday Manager
   Description: React holiday and PTO management calendar block for Next.js with country preset holidays, custom holiday creation, approval status tracking, and categorized leave types using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-holiday-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Holidays & PTO</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_holidays.Length entries · 2026</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" class="h-7 gap-1 text-xs">
                <LucidePlusCn Size="12" class="size-3" />
                Add
            </ButtonCn>
        </div>

        @* Filters *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            @foreach (var f in _filterOptions)
            {
                <button
                    type="button"
                    @onclick="@(() => _filter = f)"
                    class="@Cn.Merge("rounded-full px-2.5 py-1 text-xs transition-colors", _filter == f ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground hover:bg-muted/80")">
                    @(f == "all" ? "All" : _typeLabel[f])
                    <span class="ml-1 tabular-nums">@(f == "all" ? _holidays.Length : _holidays.Count(h => h.Type == f))</span>
                </button>
            }
        </div>

        @* Holiday list *@
        <div>
            @{ var filtered = _filter == "all" ? _holidays : _holidays.Where(h => h.Type == _filter).ToArray(); }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var idx = i;
                var holiday = filtered[idx];
                var isExpanded = _expanded == holiday.Id;
                var isLast = idx == filtered.Length - 1;
                var status = _statusIcon[holiday.Status];

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : holiday.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _typeDot[holiday.Type])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@holiday.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">@holiday.Date</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" class="shrink-0 font-normal text-xs">
                            @_typeLabel[holiday.Type]
                        </BadgeCn>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-2 px-4 pb-4 pl-9">
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground text-xs">Status:</span>
                                <span class="@Cn.Merge("flex items-center gap-1 text-xs", status.Color)">
                                    @if (holiday.Status == "approved") { <LucideCheckCn Size="12" class="size-3" /> }
                                    @if (holiday.Status == "rejected") { <LucideXCn Size="12" class="size-3" /> }
                                    @status.Label
                                </span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground text-xs">Region:</span>
                                <span class="text-xs">@holiday.Country</span>
                            </div>
                            @if (!string.IsNullOrEmpty(holiday.RequestedBy))
                            {
                                <div class="flex items-center gap-3">
                                    <span class="text-muted-foreground text-xs">Requested by:</span>
                                    <span class="text-xs">@holiday.RequestedBy</span>
                                </div>
                            }
                            @if (holiday.Status == "pending")
                            {
                                <div class="flex items-center gap-2 pt-1">
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" class="h-7 gap-1 text-xs">
                                        <LucideCheckCn Size="12" class="size-3" />
                                        Approve
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" class="h-7 gap-1 text-xs text-muted-foreground">
                                        <LucideXCn Size="12" class="size-3" />
                                        Reject
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                @_holidays.Count(h => h.Type == "public") public
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-violet-500"></span>
                @_holidays.Count(h => h.Type == "company") company
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                @_holidays.Count(h => h.Type == "pto") PTO
            </span>
        </div>
    </div>
</section>

@code {
    private record Holiday(string Id, string Name, string Date, string Type, string Country, string Status, string? RequestedBy = null);
    private record StatusInfo(string Color, string Label);

    private static readonly string[] _filterOptions = ["all", "public", "company", "pto"];

    private static readonly Dictionary<string, string> _typeLabel = new()
    {
        ["public"] = "Public", ["company"] = "Company", ["pto"] = "PTO",
    };

    private static readonly Dictionary<string, string> _typeDot = new()
    {
        ["public"] = "bg-blue-500", ["company"] = "bg-violet-500", ["pto"] = "bg-amber-500",
    };

    private static readonly Dictionary<string, StatusInfo> _statusIcon = new()
    {
        ["approved"] = new("text-emerald-600 dark:text-emerald-400", "Approved"),
        ["pending"] = new("text-amber-600 dark:text-amber-400", "Pending"),
        ["rejected"] = new("text-red-600 dark:text-red-400", "Rejected"),
    };

    private static readonly Holiday[] _holidays =
    [
        new("h1", "New Year's Day", "Jan 1", "public", "US", "approved"),
        new("h2", "Martin Luther King Jr. Day", "Jan 19", "public", "US", "approved"),
        new("h3", "Company Founding Day", "Feb 14", "company", "All", "approved"),
        new("h4", "Spring Break", "Mar 23 - Mar 27", "pto", "All", "pending", "Sarah Chen"),
        new("h5", "Good Friday", "Apr 3", "public", "US", "approved"),
        new("h6", "Mental Health Day", "Apr 15", "pto", "All", "approved", "Alex Rivera"),
        new("h7", "Memorial Day", "May 25", "public", "US", "approved"),
        new("h8", "Company Offsite", "Jun 12 - Jun 13", "company", "All", "approved"),
        new("h9", "Independence Day", "Jul 4", "public", "US", "approved"),
        new("h10", "Summer Vacation", "Aug 4 - Aug 15", "pto", "All", "pending", "Marcus Kim"),
        new("h11", "Labor Day", "Sep 7", "public", "US", "approved"),
        new("h12", "Thanksgiving", "Nov 26 - Nov 27", "public", "US", "approved"),
    ];

    private string? _expanded = null;
    private string _filter = "all";
}
