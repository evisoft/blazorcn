@* ============================================================
   Block: calendar-renovation-timeline
   Title: CalendarRenovationTimeline
   Description: A home renovation timeline calendar block for Next.js with phase tracking, contractor management, budget monitoring, and milestone completion using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-renovation-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHammerCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Renovation Timeline</span>
                    <p class="text-muted-foreground text-xs">Kitchen &amp; Master Bath Remodel</p>
                </div>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedPhases/@_phases.Length phases done
            </span>
        </div>

        @* Budget summary *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideWalletCn Size="14" class="size-3.5 text-muted-foreground" />
                <div>
                    <span class="text-muted-foreground text-xs">Spent</span>
                    <p class="font-semibold text-lg tabular-nums">$@(_totalSpent.ToString("N0"))</p>
                </div>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Budget</span>
                <p class="text-muted-foreground text-sm tabular-nums">$@(_totalBudget.ToString("N0"))</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Remaining</span>
                <p class="@Cn.Merge("text-sm tabular-nums", (_totalSpent > _totalBudget) ? "text-red-600 dark:text-red-400" : "")">
                    $@((_totalBudget - _totalSpent).ToString("N0"))
                </p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _phases.Length; i++)
            {
                var phase = _phases[i];
                var isLast = i == _phases.Length - 1;
                var isExpanded = _expanded == phase.Id;
                var config = GetStatusConfig(phase.Status);
                var doneTasks = phase.Tasks.Count(t => t.Done);
                var budgetPct = phase.Budget > 0 ? (int)Math.Round((double)phase.Spent / phase.Budget * 100) : 0;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? "" : phase.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (phase.Status == PhaseStatus.Completed)
                        {
                            <LucideCircleCheckBigCn Size="16" class="size-4 shrink-0 text-emerald-500" />
                        }
                        else
                        {
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@phase.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @phase.Room
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @phase.StartDate - @phase.EndDate · @phase.Contractor
                            </p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                            @doneTasks/@phase.Tasks.Length
                        </span>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            <div class="mb-2">
                                <div class="mb-1 flex justify-between text-xs">
                                    <span class="text-muted-foreground">Budget</span>
                                    <span class="@Cn.Merge("tabular-nums", budgetPct > 100 ? "text-red-600 dark:text-red-400" : "")">
                                        $@(phase.Spent.ToString("N0")) / $@(phase.Budget.ToString("N0"))
                                    </span>
                                </div>
                                <div class="h-1.5 rounded-full bg-muted">
                                    <div
                                        class="@Cn.Merge("h-1.5 rounded-full transition-all", budgetPct > 100 ? "bg-red-500" : "bg-blue-500")"
                                        style="width: @(Math.Min(budgetPct, 100))%">
                                    </div>
                                </div>
                            </div>
                            <div class="space-y-1">
                                @foreach (var task in phase.Tasks)
                                {
                                    <div class="flex items-center gap-2 px-1 py-0.5">
                                        @if (task.Done)
                                        {
                                            <LucideCircleCheckBigCn Size="14" class="size-3.5 shrink-0 text-emerald-500" />
                                        }
                                        else
                                        {
                                            <LucideCircleCn Size="14" class="size-3.5 shrink-0 text-muted-foreground/40" />
                                        }
                                        <span class="@Cn.Merge("text-sm", task.Done ? "text-muted-foreground line-through" : "")">
                                            @task.Task
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _statusLegend)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Dot)"></span>
                    @entry.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private enum PhaseStatus { Completed, InProgress, Upcoming, Delayed }

    private record TaskItem(string Id, string Task, bool Done);
    private record RenovationPhase(string Id, string Name, string Room, string Contractor, string StartDate, string EndDate, PhaseStatus Status, int Budget, int Spent, TaskItem[] Tasks);
    private record StatusConfig(string Dot, string Label);
    private record LegendEntry(string Dot, string Label);

    private static StatusConfig GetStatusConfig(PhaseStatus status) => status switch
    {
        PhaseStatus.Completed  => new("bg-emerald-500", "Completed"),
        PhaseStatus.InProgress => new("bg-blue-500",    "In Progress"),
        PhaseStatus.Upcoming   => new("bg-zinc-400",    "Upcoming"),
        PhaseStatus.Delayed    => new("bg-red-500",     "Delayed"),
        _                      => new("bg-zinc-400",    "Unknown"),
    };

    private static readonly LegendEntry[] _statusLegend =
    [
        new("bg-emerald-500", "Completed"),
        new("bg-blue-500",    "In Progress"),
        new("bg-zinc-400",    "Upcoming"),
        new("bg-red-500",     "Delayed"),
    ];

    private static readonly RenovationPhase[] _phases =
    [
        new("1", "Kitchen Demolition", "Kitchen", "BuildRight Co.", "Mar 3", "Mar 7", PhaseStatus.Completed, 3500, 3200,
        [
            new("t1",  "Remove old cabinets",   true),
            new("t2",  "Tear out countertops",  true),
            new("t3",  "Remove flooring",        true),
            new("t4",  "Haul debris",            true),
        ]),
        new("2", "Plumbing & Electrical", "Kitchen", "ProPipe Plumbing / Sparks Electric", "Mar 10", "Mar 18", PhaseStatus.Completed, 8000, 8450,
        [
            new("t5",  "Rough-in plumbing for island sink",      true),
            new("t6",  "Add dedicated circuits for appliances",  true),
            new("t7",  "Install under-cabinet wiring",           true),
            new("t8",  "City inspection",                        true),
        ]),
        new("3", "Cabinet Installation", "Kitchen", "BuildRight Co.", "Mar 19", "Mar 28", PhaseStatus.InProgress, 12000, 6800,
        [
            new("t9",  "Install base cabinets",           true),
            new("t10", "Install wall cabinets",           true),
            new("t11", "Install island framework",        false),
            new("t12", "Hardware and soft-close hinges",  false),
        ]),
        new("4", "Countertop & Backsplash", "Kitchen", "StoneWorks Inc.", "Apr 1", "Apr 8", PhaseStatus.Upcoming, 6500, 0,
        [
            new("t13", "Template quartz countertops",      false),
            new("t14", "Fabricate and install counters",   false),
            new("t15", "Install subway tile backsplash",   false),
            new("t16", "Grout and seal",                   false),
        ]),
        new("5", "Bathroom Tile Work", "Master Bath", "TilePro LLC", "Mar 24", "Apr 4", PhaseStatus.Delayed, 5000, 1200,
        [
            new("t17", "Waterproof shower pan",   true),
            new("t18", "Lay shower wall tile",    false),
            new("t19", "Install floor tile",      false),
            new("t20", "Grout and seal",          false),
        ]),
    ];

    private string _expanded = "3";

    private int _totalBudget => _phases.Sum(p => p.Budget);
    private int _totalSpent  => _phases.Sum(p => p.Spent);
    private int _completedPhases => _phases.Count(p => p.Status == PhaseStatus.Completed);
}
