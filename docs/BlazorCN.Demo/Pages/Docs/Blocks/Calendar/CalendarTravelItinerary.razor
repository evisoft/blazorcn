@* ============================================================
   Block: calendar-travel-itinerary
   Title: Calendar Travel Itinerary
   Description: React travel itinerary timeline block for Next.js with flights, hotels, activities per day, map markers, and trip progress tracking built with shadcn/ui and Tailwind CSS
   Long Description: React Timezone Converter Calendar Block
   Dependencies: BadgeCn
   Source: original/blocks/calendar/calendar-travel-itinerary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucidePlaneCn Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Japan Trip</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_itinerary.Length days
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Apr 14 - Apr 19, 2026 &middot; San Francisco &rarr; Tokyo &rarr; Kyoto
            </p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs tabular-nums">
                @_confirmedItems/@_totalItems confirmed
            </span>
            <div class="flex flex-1 items-center gap-2">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-emerald-500 transition-all"
                         style="@($"width: {(double)_confirmedItems / _totalItems * 100:F0}%")" />
                </div>
            </div>
        </div>

        @* Day-by-day itinerary *@
        <div>
            @for (int di = 0; di < _itinerary.Length; di++)
            {
                var day = _itinerary[di];
                var isDayExpanded = _expandedDay == day.DayNumber;
                var isLastDay = di == _itinerary.Length - 1;
                <div class="@(isLastDay ? "" : "border-b")">
                    @* Day header *@
                    <button type="button"
                            @onclick="@(() => _expandedDay = _expandedDay == day.DayNumber ? (int?)null : day.DayNumber)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted font-mono text-xs tabular-nums">
                            @day.DayNumber
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@day.Date</span>
                            <p class="text-muted-foreground text-xs">@day.City</p>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @day.Items.Length items
                        </span>
                        <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isDayExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @* Day items *@
                    @if (isDayExpanded)
                    {
                        <div class="border-t">
                            @for (int ii = 0; ii < day.Items.Length; ii++)
                            {
                                var item = day.Items[ii];
                                var isLastItem = ii == day.Items.Length - 1;
                                <div class="@($"flex items-start gap-3 px-4 py-2.5 pl-14 {(isLastItem ? "" : "border-b")}")">
                                    @switch (item.Type)
                                    {
                                        case "flight":
                                            <LucidePlaneCn Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            break;
                                        case "hotel":
                                            <LucideBedDoubleCn Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            break;
                                        case "activity":
                                            <LucideCoffeeCn Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            break;
                                        case "restaurant":
                                            <LucideUtensilsCn Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            break;
                                        default:
                                            <LucideTicketCn Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                            break;
                                    }
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@item.Title</span>
                                            @if (!item.Confirmed)
                                            {
                                                <span class="size-1.5 rounded-full bg-amber-500" />
                                            }
                                        </div>
                                        <p class="text-muted-foreground text-xs">@item.Subtitle</p>
                                        <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                                            <span class="tabular-nums">@item.Time</span>
                                            <span>&middot;</span>
                                            <span class="flex items-center gap-1 truncate">
                                                <LucideMapPinCn Class="size-3 shrink-0" />
                                                @item.Location
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.Reference))
                                        {
                                            <span class="mt-1 inline-block font-mono text-muted-foreground text-[10px]">
                                                Ref: @item.Reference
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private int? _expandedDay = 2;

    private record ItineraryItem(string Id, string Type, string Title, string Subtitle, string Time, string Location, bool Confirmed, string? Reference = null);
    private record TripDay(string Date, int DayNumber, string City, ItineraryItem[] Items);

    private static readonly TripDay[] _itinerary =
    [
        new("Mon, Apr 14", 1, "San Francisco \u2192 Tokyo",
        [
            new("d1-1", "transport", "Uber to SFO", "Pick-up at 10:30 AM", "10:30 AM", "Home \u2192 SFO Terminal 1", true),
            new("d1-2", "flight", "JAL 1 \u00b7 SFO \u2192 NRT", "Economy \u00b7 Seat 24A \u00b7 Gate G9", "1:15 PM", "San Francisco International", true, "XKJF4R"),
        ]),
        new("Tue, Apr 15", 2, "Tokyo",
        [
            new("d2-1", "flight", "JAL 1 arrives NRT", "Terminal 2 \u00b7 Immigration + customs", "4:45 PM", "Narita International Airport", true, "XKJF4R"),
            new("d2-2", "transport", "Narita Express to Shinjuku", "Platform 1 \u00b7 Car 4 \u00b7 Reserved", "6:00 PM", "Narita \u2192 Shinjuku Station", true),
            new("d2-3", "hotel", "Park Hyatt Tokyo", "Deluxe King \u00b7 42nd floor \u00b7 3 nights", "Check-in 7:30 PM", "3-7-1-2 Nishi Shinjuku", true, "PH9284571"),
        ]),
        new("Wed, Apr 16", 3, "Tokyo",
        [
            new("d3-1", "activity", "Tsukiji Outer Market tour", "Guided walking food tour \u00b7 3 hrs", "8:00 AM", "Tsukiji, Chuo City", true),
            new("d3-2", "activity", "teamLab Borderless", "Digital art museum \u00b7 Timed entry", "2:00 PM", "Azabudai Hills, Minato City", true, "TL-0416-2PM"),
            new("d3-3", "restaurant", "Dinner at Gonpachi", "Reservation for 2 \u00b7 Non-smoking", "7:00 PM", "1-13-11 Nishi-Azabu, Minato", false),
        ]),
        new("Thu, Apr 17", 4, "Tokyo \u2192 Kyoto",
        [
            new("d4-1", "transport", "Shinkansen Nozomi 203", "Car 7 \u00b7 Seat 3A \u00b7 Reserved", "9:33 AM", "Tokyo Station \u2192 Kyoto Station", true, "JR-N203"),
            new("d4-2", "hotel", "The Ritz-Carlton Kyoto", "Garden View Suite \u00b7 2 nights", "Check-in 3:00 PM", "Kamogawa Nijo-Ohashi, Nakagyo", true, "RC7751023"),
            new("d4-3", "activity", "Fushimi Inari evening walk", "Self-guided \u00b7 Less crowded after 4 PM", "4:30 PM", "68 Fukakusa, Fushimi-ku", true),
        ]),
    ];

    private static readonly int _totalItems = _itinerary.Sum(d => d.Items.Length);
    private static readonly int _confirmedItems = _itinerary.Sum(d => d.Items.Count(i => i.Confirmed));
}
