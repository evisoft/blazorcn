@* ============================================================
   Block: calendar-podcast-schedule
   Title: CalendarPodcastSchedule
   Description: A podcast recording and publishing schedule calendar block for Next.js with episode planning, guest management, recording status, and publishing timeline using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-podcast-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideRadioCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Podcast Schedule</span>
                    <p class="text-muted-foreground text-xs">The Dev Dispatch</p>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs">
                <span class="text-muted-foreground tabular-nums">@_scheduled upcoming</span>
                <span class="text-muted-foreground">·</span>
                <span class="text-amber-600 tabular-nums dark:text-amber-400">@_editing editing</span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _episodes.Length; i++)
            {
                var idx = i;
                var ep = _episodes[idx];
                var isExpanded = _expanded == ep.Id;
                var config = _statusConfig[ep.Status];
                var guestFirst = ep.Guest.Split(',')[0];

                <div class="@(idx < _episodes.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (isExpanded ? "" : ep.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">#@ep.EpisodeNumber</span>
                                <span class="truncate font-medium text-sm">@ep.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideUserCn Size="12" class="size-3" />
                                    @guestFirst
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideMicCn Size="12" class="size-3" />
                                    @ep.RecordDate
                                </span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" class="shrink-0 font-normal text-[10px]">
                            @config.Label
                        </BadgeCn>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            <div class="mb-2 rounded-md bg-muted/50 p-3">
                                <span class="text-muted-foreground text-xs">Topic</span>
                                <p class="mt-0.5 text-sm">@ep.Topic</p>
                            </div>
                            <div class="flex flex-col gap-1.5 text-muted-foreground text-xs">
                                <span>
                                    <span class="font-medium text-foreground">Guest:</span> @ep.Guest
                                </span>
                                <span>
                                    <span class="font-medium text-foreground">Duration:</span> @ep.Duration
                                </span>
                                <span>
                                    <span class="font-medium text-foreground">Record:</span> @ep.RecordDate
                                </span>
                                <span>
                                    <span class="font-medium text-foreground">Publish:</span> @ep.PublishDate
                                </span>
                            </div>
                            <p class="mt-2 text-muted-foreground text-xs italic">@ep.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var kvp in _statusConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", kvp.Value.Dot)"></span>
                    @kvp.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record Episode(string Id, string Title, int EpisodeNumber, string Guest, string RecordDate, string PublishDate, string Status, string Duration, string Topic, string Notes);
    private record StatusInfo(string Dot, string Label);

    private static readonly Dictionary<string, StatusInfo> _statusConfig = new()
    {
        ["scheduled"] = new("bg-blue-500", "Scheduled"),
        ["recording"] = new("bg-amber-500", "Recording"),
        ["editing"] = new("bg-violet-500", "Editing"),
        ["published"] = new("bg-emerald-500", "Published"),
    };

    private static readonly Episode[] _episodes =
    [
        new("1", "The Future of Remote Work", 47, "Sarah Chen, CEO of FlexWork", "Mar 20, 2026", "Mar 24, 2026", "editing", "45 min", "Remote work trends, hybrid models, and async communication", "Recorded via Riverside. Audio quality good. Need to cut intro rambling."),
        new("2", "Building Developer Communities", 48, "Marcus Liu, DevRel at Vercel", "Mar 25, 2026", "Mar 31, 2026", "scheduled", "50 min est.", "Community building, open source, and developer experience", "Pre-interview done. Guest prefers afternoon recording slots."),
        new("3", "Scaling Design Systems", 49, "Elena Kowalski, Design Lead", "Apr 1, 2026", "Apr 7, 2026", "scheduled", "40 min est.", "Design tokens, component libraries, and cross-team adoption", "Guest will share screen for live demo segment. Prepare questions about token naming."),
        new("4", "AI in Code Review", 50, "James Park, CTO of CodeBot", "Apr 8, 2026", "Apr 14, 2026", "scheduled", "55 min est.", "Automated code review, AI pair programming, and developer productivity", "Special 50th episode. Plan extended intro and listener Q&A segment."),
        new("5", "Startup Lessons Learned", 46, "Nina Torres, Founder of LaunchKit", "Mar 13, 2026", "Mar 17, 2026", "published", "42 min", "Fundraising, product-market fit, and first 100 customers", "Great episode. High engagement on social clips."),
    ];

    private int _scheduled => _episodes.Count(e => e.Status == "scheduled");
    private int _editing => _episodes.Count(e => e.Status == "editing");
    private string _expanded = "1";
}
