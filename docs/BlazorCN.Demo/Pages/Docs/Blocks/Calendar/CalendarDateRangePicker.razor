@* ============================================================
   Block: calendar-date-range-picker
   Title: Calendar Date Range Picker
   Description: A date range selection component with preset range buttons, custom date inputs, and visual range highlighting built with React, Next.js, shadcn/ui Calendar, and Tailwind CSS
   Long Description: React Court Booking Calendar Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-date-range-picker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Date Range</span>
            </div>
            @if (_rangeStart > 0 && _rangeEnd > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs tabular-nums">
                    @(_rangeEnd - _rangeStart + 1) days selected
                </BadgeCn>
            }
        </div>

        @* Preset ranges *@
        <div class="flex flex-wrap gap-1.5 border-b px-4 py-2.5">
            @foreach (var preset in _presets)
            {
                var isActive = _activePreset == preset.Label;
                <button
                    type="button"
                    @onclick="@(() => SelectPreset(preset))"
                    class="@Cn.Merge("rounded-full px-2.5 py-1 text-xs transition-colors", isActive ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground hover:bg-muted/80")">
                    @preset.Label
                </button>
            }
        </div>

        @* Two-month calendar *@
        <div class="grid grid-cols-2 gap-0 border-b">
            @* March *@
            <div class="border-r p-4">
                <div class="mb-3 flex items-center justify-between">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                        <LucideChevronLeftCn Size="16" class="size-4" />
                    </ButtonCn>
                    <span class="font-medium text-sm">March 2026</span>
                    <div class="w-7"></div>
                </div>
                @RenderMonthGrid(2, 2026)
            </div>

            @* April *@
            <div class="p-4">
                <div class="mb-3 flex items-center justify-between">
                    <div class="w-7"></div>
                    <span class="font-medium text-sm">April 2026</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                        <LucideChevronRightCn Size="16" class="size-4" />
                    </ButtonCn>
                </div>
                @RenderMonthGrid(3, 2026)
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground text-xs tabular-nums">
                @if (_rangeStart > 0)
                {
                    <span>Mar @_rangeStart</span>
                    <span>→</span>
                    <span>@(_rangeEnd > 31 ? $"Apr {_rangeEnd - 31}" : $"Mar {_rangeEnd}")</span>
                }
                else
                {
                    <span>Select a range</span>
                }
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="h-7 text-xs" @onclick="ClearRange">
                    Clear
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" class="h-7 text-xs">
                    Apply
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PresetRange(string Label, int Start, int End);

    private static readonly string[] _dayLabels = ["S", "M", "T", "W", "T", "F", "S"];

    private static readonly PresetRange[] _presets =
    [
        new("Today", 18, 18),
        new("Last 7 days", 12, 18),
        new("Last 14 days", 5, 18),
        new("This month", 1, 31),
        new("Last 30 days", -11, 18),
        new("Custom", 0, 0),
    ];

    private int _rangeStart = 18;
    private int _rangeEnd = 25;
    private string _activePreset = "";

    private void SelectPreset(PresetRange preset)
    {
        _activePreset = preset.Label;
        if (preset.Label != "Custom")
        {
            _rangeStart = Math.Max(1, preset.Start);
            _rangeEnd = preset.End;
        }
    }

    private void ClearRange()
    {
        _rangeStart = 0;
        _rangeEnd = 0;
        _activePreset = "";
    }

    private void SelectDay(int absoluteDay)
    {
        if (_rangeStart == 0 || (_rangeStart > 0 && _rangeEnd > 0))
        {
            _rangeStart = absoluteDay;
            _rangeEnd = 0;
            _activePreset = "Custom";
        }
        else
        {
            if (absoluteDay >= _rangeStart)
                _rangeEnd = absoluteDay;
            else
            {
                _rangeEnd = _rangeStart;
                _rangeStart = absoluteDay;
            }
        }
    }

    private RenderFragment RenderMonthGrid(int monthIndex, int year) => __builder =>
    {
        var daysInMonth = DateTime.DaysInMonth(year, monthIndex + 1);
        var firstDay = (int)new DateTime(year, monthIndex + 1, 1).DayOfWeek;
        var offset = monthIndex == 2 ? 0 : 31; // March=0 offset, April=31 offset

        <div class="mb-1 grid grid-cols-7">
            @foreach (var label in _dayLabels)
            {
                <div class="py-1 text-center text-muted-foreground text-xs">@label</div>
            }
        </div>
        <div class="grid grid-cols-7 gap-px">
            @for (var i = 0; i < firstDay; i++)
            {
                <div class="aspect-square"></div>
            }
            @for (var d = 1; d <= daysInMonth; d++)
            {
                var day = d;
                var absoluteDay = day + offset;
                var isInRange = _rangeStart > 0 && _rangeEnd > 0 && absoluteDay >= _rangeStart && absoluteDay <= _rangeEnd;
                var isEdge = absoluteDay == _rangeStart || absoluteDay == _rangeEnd;
                var isToday = monthIndex == 2 && day == 18;

                <button
                    type="button"
                    @onclick="@(() => SelectDay(absoluteDay))"
                    class="@Cn.Merge("flex aspect-square items-center justify-center rounded-md text-xs tabular-nums transition-colors", isEdge ? "bg-foreground font-medium text-background" : isInRange ? "bg-primary/10" : "hover:bg-muted/50", isToday && !isEdge ? "ring-1 ring-primary/30" : "")">
                    @day
                </button>
            }
        </div>
    };
}
