@* ============================================================
   Block: calendar-timezone-converter
   Title: Calendar Timezone Converter
   Description: React multi-timezone time converter block for Next.js with city selector, UTC offset comparison, business hours overlay, and meeting time finder built with shadcn/ui and Tailwind CSS
   Long Description: React Horizontal Timeline Calendar Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-timezone-converter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideGlobeCn Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Timezone Converter</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_selected.Count cities
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Reference time: San Francisco 9:00 AM PDT
            </p>
        </div>

        @* Timezone list *@
        <div class="border-b">
            @{ var selectedTimezones = _allTimezones.Where(tz => _selected.Contains(tz.Id)).ToArray(); }
            @for (int i = 0; i < selectedTimezones.Length; i++)
            {
                var tz = selectedTimezones[i];
                var isLast = i == selectedTimezones.Length - 1;
                var localOffset = tz.OffsetMinutes / 60.0;
                <div class="@($"px-4 py-3 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@tz.City</span>
                                <span class="text-muted-foreground text-xs">@tz.Offset</span>
                            </div>
                            <span class="text-muted-foreground text-xs">@tz.Country</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="text-right">
                                <span class="font-semibold text-lg tabular-nums">@tz.Time</span>
                                <span class="ml-1 text-muted-foreground text-xs">@tz.Period</span>
                            </div>
                            @if (tz.IsBusinessHours)
                            {
                                <span class="size-1.5 rounded-full bg-emerald-500" />
                            }
                            else
                            {
                                <span class="size-1.5 rounded-full bg-muted-foreground/30" />
                            }
                            <ButtonCn aria-label="@($"Remove {tz.City}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0"
                                      OnClick="@(() => RemoveCity(tz.Id))">
                                <LucideXCn Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                    @* 24h bar *@
                    <div class="mt-2 flex gap-px">
                        @for (int h = 0; h < 24; h++)
                        {
                            var localHour = (((h + (int)Math.Round(localOffset)) % 24) + 24) % 24;
                            var isBusiness = localHour >= 9 && localHour < 17;
                            <div class="@($"h-1.5 flex-1 rounded-sm {(isBusiness ? "bg-emerald-500/30" : "bg-muted")}")" />
                        }
                    </div>
                    <div class="mt-0.5 flex justify-between">
                        <span class="text-muted-foreground text-[10px] tabular-nums">12a</span>
                        <span class="text-muted-foreground text-[10px] tabular-nums">6a</span>
                        <span class="text-muted-foreground text-[10px] tabular-nums">12p</span>
                        <span class="text-muted-foreground text-[10px] tabular-nums">6p</span>
                        <span class="text-muted-foreground text-[10px] tabular-nums">12a</span>
                    </div>
                </div>
            }
        </div>

        @* Add city *@
        @if (_showAdd)
        {
            var availableCities = _allTimezones.Where(tz => !_selected.Contains(tz.Id)).ToArray();
            <div class="border-b">
                <div class="px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Add a city</span>
                </div>
                @for (int i = 0; i < availableCities.Length; i++)
                {
                    var city = availableCities[i];
                    var isLast = i == availableCities.Length - 1;
                    <button type="button"
                            @onclick="@(() => AddCity(city.Id))"
                            class="@($"flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50 {(isLast ? "" : "border-b")}")">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@city.City</span>
                            <span class="ml-2 text-muted-foreground text-xs">@city.Country</span>
                        </div>
                        <span class="text-muted-foreground text-xs">@city.Offset</span>
                        <LucideChevronRightCn Class="size-3.5 text-muted-foreground/60" />
                    </button>
                }
            </div>
        }

        @* Overlap info + Add button *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideClockCn Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">
                    Best overlap: <span class="font-medium text-foreground">4:00 PM - 5:00 PM UTC</span>
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      OnClick="@(() => _showAdd = !_showAdd)">
                <LucidePlusCn Class="size-3" />
                Add city
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private List<string> _selected = ["sf", "nyc", "london", "tokyo"];
    private bool _showAdd;

    private record TimezoneCity(string Id, string City, string Country, string Offset, int OffsetMinutes, string Time, string Period, bool IsBusinessHours);

    private static readonly TimezoneCity[] _allTimezones =
    [
        new("sf", "San Francisco", "United States", "UTC-7", -420, "9:00", "AM", true),
        new("nyc", "New York", "United States", "UTC-4", -240, "12:00", "PM", true),
        new("london", "London", "United Kingdom", "UTC+1", 60, "5:00", "PM", true),
        new("tokyo", "Tokyo", "Japan", "UTC+9", 540, "1:00", "AM", false),
        new("sydney", "Sydney", "Australia", "UTC+11", 660, "3:00", "AM", false),
        new("berlin", "Berlin", "Germany", "UTC+2", 120, "6:00", "PM", false),
        new("dubai", "Dubai", "UAE", "UTC+4", 240, "8:00", "PM", false),
        new("singapore", "Singapore", "Singapore", "UTC+8", 480, "12:00", "AM", false),
    ];

    private void RemoveCity(string id)
    {
        _selected.Remove(id);
    }

    private void AddCity(string id)
    {
        _selected.Add(id);
        _showAdd = false;
    }
}
