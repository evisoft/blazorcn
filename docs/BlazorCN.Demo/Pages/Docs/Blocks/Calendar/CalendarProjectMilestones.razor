@* ============================================================
   Block: calendar-project-milestones
   Title: Calendar Project Milestones
   Description: React project milestone timeline calendar block for Next.js with dependency tracking, completion status, date ranges, and progress indicators using shadcn/ui and Tailwind CSS
   Long Description: React Payment Schedule Calendar Block
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-project-milestones.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Project Milestones</h2>
            <p class="text-muted-foreground text-xs">Product v2.0 Roadmap</p>
        </div>

        @* Progress summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@_completed</span>
                <span class="text-muted-foreground text-xs">/ @_total</span>
            </div>
            <span class="text-muted-foreground text-xs">milestones completed</span>
            <div class="ml-auto flex items-center gap-2">
                <ProgressCn Value="@_progress" Class="h-1.5 w-24" />
                <span class="text-muted-foreground text-xs tabular-nums">@_progress%</span>
            </div>
        </div>

        @* Timeline *@
        <div>
            @for (int i = 0; i < _milestones.Length; i++)
            {
                var milestone = _milestones[i];
                var isExpanded = _expanded == milestone.Id;
                var isLast = i == _milestones.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == milestone.Id ? null : milestone.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="relative flex flex-col items-center">
                            @if (milestone.Status == "completed")
                            {
                                <LucideCircleCheckCn Class="size-4 shrink-0 text-emerald-500" />
                            }
                            else if (milestone.Status == "in-progress")
                            {
                                <LucideCircleDashedCn Class="size-4 shrink-0 text-blue-500" />
                            }
                            else
                            {
                                <LucideCircleCn Class="size-4 shrink-0 text-muted-foreground/40" />
                            }
                            @if (!isLast)
                            {
                                <div class="absolute top-5 h-4 w-px bg-border" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@milestone.Title</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@milestone.StartDate - @milestone.EndDate</span>
                                <span>&middot;</span>
                                <span>@milestone.Assignee</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @GetStatusLabel(milestone.Status)
                        </BadgeCn>
                        <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-11">
                            <p class="mb-2 text-muted-foreground text-sm leading-relaxed">
                                @milestone.Description
                            </p>
                            @if (milestone.DependsOn.Length > 0)
                            {
                                <div class="rounded-md bg-muted/50 p-2.5">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        Dependencies
                                    </span>
                                    <div class="mt-1 flex flex-wrap gap-1.5">
                                        @foreach (var depId in milestone.DependsOn)
                                        {
                                            var dep = _milestones.FirstOrDefault(m => m.Id == depId);
                                            if (dep != null)
                                            {
                                                <span class="flex items-center gap-1 text-xs">
                                                    <span class="@($"size-1.5 rounded-full {(dep.Status == "completed" ? "bg-emerald-500" : "bg-amber-500")}")" />
                                                    @dep.Title
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "4";

    private record Milestone(string Id, string Title, string Description, string Status, string StartDate, string EndDate, string Assignee, string[] DependsOn);

    private static readonly Milestone[] _milestones =
    [
        new("1", "Design System Foundation", "Establish color tokens, typography scale, spacing system, and component primitives for the design system.", "completed", "Feb 3", "Feb 14", "Sarah K.", []),
        new("2", "Core Component Library", "Build Button, Input, Card, Dialog, and 12 other base components with full accessibility support.", "completed", "Feb 17", "Mar 7", "James L.", ["1"]),
        new("3", "Authentication Flow", "Implement OAuth, magic link, and email/password sign-in with session management and rate limiting.", "completed", "Mar 3", "Mar 14", "Priya M.", ["2"]),
        new("4", "Dashboard Layout", "Create responsive sidebar navigation, header, breadcrumbs, and main content area with collapsible sections.", "in-progress", "Mar 10", "Mar 24", "Alex R.", ["2"]),
        new("5", "Data Visualization", "Integrate charting library with line, bar, area, and pie chart components. Add real-time data streaming support.", "in-progress", "Mar 17", "Mar 31", "Sarah K.", ["4"]),
        new("6", "Billing Integration", "Connect Stripe checkout, subscription management, invoices, and usage-based metering with webhook handlers.", "upcoming", "Mar 24", "Apr 7", "Priya M.", ["3"]),
        new("7", "Beta Launch", "Deploy to production, enable feature flags, onboard first 50 beta users, and begin feedback collection.", "upcoming", "Apr 7", "Apr 14", "James L.", ["5", "6"]),
    ];

    private static readonly int _completed = _milestones.Count(m => m.Status == "completed");
    private static readonly int _total = _milestones.Length;
    private static readonly int _progress = (int)Math.Round((double)_completed / _total * 100);

    private static string GetStatusLabel(string status) => status switch
    {
        "completed" => "Completed",
        "in-progress" => "In progress",
        "upcoming" => "Upcoming",
        _ => status
    };
}
