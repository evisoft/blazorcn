@* ============================================================
   Block: calendar-sprint-timeline
   Title: Calendar Sprint Timeline
   Description: Agile sprint timeline with story status indicators, burndown progress, and velocity tracking
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-sprint-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Sprint Timeline</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_sprints.Length sprints · Velocity: 42 pts/sprint</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">@(_sprints[0].DaysRemaining)d remaining</BadgeCn>
        </div>

        @{ var activeSprint = _sprints[0]; }
        <div class="border-b bg-muted/20 px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideFlagCn Size="14" Class="size-3.5 text-primary" />
                <span class="font-medium text-sm">@activeSprint.Name</span>
                <span class="text-muted-foreground text-xs">@activeSprint.StartDate - @activeSprint.EndDate</span>
            </div>
            <p class="mb-3 text-muted-foreground text-xs">@activeSprint.Goal</p>

            <div class="mb-2">
                <div class="mb-1 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Progress</span>
                    <span class="font-medium text-xs tabular-nums">@activeSprint.CompletedPoints/@activeSprint.TotalPoints pts</span>
                </div>
                <ProgressCn Value="@(activeSprint.TotalPoints > 0 ? (int)((double)activeSprint.CompletedPoints / activeSprint.TotalPoints * 100) : 0)" class="h-1.5" />
            </div>

            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(activeSprint.Stories.Count(s => s.Status == "done")) done
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @(activeSprint.Stories.Count(s => s.Status == "in-progress")) in progress
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    @(activeSprint.Stories.Count(s => s.Status == "todo")) todo
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(activeSprint.Stories.Count(s => s.Status == "blocked")) blocked
                </span>
            </div>
        </div>

        <div>
            @for (var si = 0; si < _sprints.Length; si++)
            {
                var sprint = _sprints[si];
                var isLast = si == _sprints.Length - 1;
                var isActive = si == 0;
                var isExpanded = _expandedSprint == sprint.Id;
                var progress = sprint.TotalPoints > 0 ? (int)((double)sprint.CompletedPoints / sprint.TotalPoints * 100) : 0;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expandedSprint = isExpanded ? null : sprint.Id" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", isActive ? "bg-primary" : "bg-muted-foreground/30")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@sprint.Name</span>
                                @if (isActive)
                                {
                                    <span class="rounded-full bg-primary/10 px-1.5 py-0.5 text-primary text-[10px]">Active</span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@sprint.StartDate - @sprint.EndDate · @sprint.Stories.Length stories · @sprint.TotalPoints pts</p>
                        </div>
                        <span class="shrink-0 font-medium text-xs tabular-nums">@progress%</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="border-t">
                            @for (var sti = 0; sti < sprint.Stories.Length; sti++)
                            {
                                var story = sprint.Stories[sti];
                                var isStoryLast = sti == sprint.Stories.Length - 1;
                                var dotColor = story.Status switch { "done" => "bg-emerald-500", "in-progress" => "bg-blue-500", "blocked" => "bg-red-500", _ => "bg-muted-foreground/40" };
                                var statusLabel = story.Status switch { "done" => "Done", "in-progress" => "In Progress", "blocked" => "Blocked", _ => "To Do" };
                                <div class="@(isStoryLast ? "" : "border-b")">
                                    <div class="flex w-full items-center gap-3 px-4 py-2.5 pl-8">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                                        <span class="min-w-0 flex-1 truncate text-sm">@story.Title</span>
                                        <span class="shrink-0 rounded-full bg-muted px-1.5 py-0.5 text-muted-foreground text-[10px] tabular-nums">@story.Points pts</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">@statusLabel</BadgeCn>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t bg-muted/20 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Burndown</span>
                <div class="flex items-center gap-4">
                    <span class="text-muted-foreground text-xs">Actual: <span class="tabular-nums">@(activeSprint.TotalPoints - activeSprint.CompletedPoints)</span> pts remaining</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expandedSprint = "s1";

    private record StoryItem(string Title, string Status, int Points);
    private record SprintItem(string Id, string Name, string StartDate, string EndDate, string Goal, int TotalPoints, int CompletedPoints, int DaysRemaining, StoryItem[] Stories);

    private static readonly SprintItem[] _sprints =
    [
        new("s1", "Sprint 24", "Mar 10", "Mar 21", "Complete auth v2 and launch SSO", 42, 28, 4,
        [
            new("SAML 2.0 SSO integration", "done", 8),
            new("Session management refactor", "done", 5),
            new("OAuth provider configuration", "in-progress", 8),
            new("Audit log for auth events", "in-progress", 5),
            new("Password policy enforcement", "todo", 8),
            new("Login page redesign", "blocked", 8),
        ]),
        new("s2", "Sprint 23", "Feb 24", "Mar 7", "API v2 and webhook system", 38, 38, 0,
        [
            new("REST API v2 endpoints", "done", 13),
            new("Webhook delivery system", "done", 8),
            new("API key management", "done", 5),
            new("Rate limiting middleware", "done", 8),
            new("API explorer UI", "done", 4),
        ]),
        new("s3", "Sprint 22", "Feb 10", "Feb 21", "Dashboard improvements", 35, 35, 0,
        [
            new("New sidebar navigation", "done", 8),
            new("Dashboard widget system", "done", 13),
            new("Loading skeleton states", "done", 5),
            new("Dark mode polish", "done", 5),
            new("Mobile responsive fixes", "done", 4),
        ]),
    ];
}
