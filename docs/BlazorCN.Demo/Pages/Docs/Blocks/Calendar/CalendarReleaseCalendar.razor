@* ============================================================
   Block: calendar-release-calendar
   Title: Calendar Release Calendar
   Description: React software release calendar block for Next.js with version tags, feature freeze dates, milestone tracking, and release status indicators built with shadcn/ui and Tailwind CSS
   Long Description: React Calendar Recurring Events Block
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-release-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucidePackageCn Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Release Calendar</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Q1&ndash;Q2 2026
                </BadgeCn>
            </div>
        </div>

        @* Release list *@
        <div>
            @for (int i = 0; i < _releases.Length; i++)
            {
                var release = _releases[i];
                var isExpanded = _expanded == release.Id;
                var isLast = i == _releases.Length - 1;
                var statusDot = GetStatusDot(release.Status);
                var statusLabel = GetStatusLabel(release.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == release.Id ? null : release.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {statusDot}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@release.Version</span>
                                <span class="text-muted-foreground text-xs">@release.Codename</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@release.ReleaseDate</span>
                                <span>&middot;</span>
                                <span class="tabular-nums">@release.Features features</span>
                                @if (release.Bugs > 0)
                                {
                                    <span>&middot;</span>
                                    <span class="tabular-nums">@release.Bugs fixes</span>
                                }
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @statusLabel
                        </BadgeCn>
                        <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-4 pl-9 pt-3">
                            @* Branch info *@
                            <div class="mb-3 flex items-center gap-2 text-xs">
                                <LucideGitBranchCn Class="size-3 text-muted-foreground" />
                                <span class="font-mono text-muted-foreground">@release.Branch</span>
                            </div>

                            @* Progress *@
                            <div class="mb-3">
                                <div class="mb-1 flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Progress</span>
                                    <span class="font-medium tabular-nums">@release.Progress%</span>
                                </div>
                                <ProgressCn Value="@release.Progress" Class="h-1.5" aria-label="Progress" />
                            </div>

                            @* Milestones *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Milestones
                                </span>
                                <div class="space-y-1.5">
                                    @foreach (var milestone in release.Milestones)
                                    {
                                        <div class="flex items-center gap-2">
                                            @if (milestone.Completed)
                                            {
                                                <LucideCircleCheckCn Class="size-3.5 shrink-0 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideCircleDotCn Class="size-3.5 shrink-0 text-muted-foreground/40" />
                                            }
                                            <span class="@($"flex-1 text-sm {(milestone.Completed ? "text-muted-foreground line-through" : "")}")">
                                                @milestone.Name
                                            </span>
                                            <span class="text-muted-foreground text-xs tabular-nums">
                                                @milestone.Date
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "r2";

    private record ReleaseMilestone(string Id, string Name, string Date, bool Completed);
    private record Release(string Id, string Version, string Codename, string Status, string Branch, string ReleaseDate, int Progress, int Features, int Bugs, ReleaseMilestone[] Milestones);

    private static readonly Release[] _releases =
    [
        new("r1", "v3.2.0", "Aurora", "released", "release/3.2", "Mar 10, 2026", 100, 14, 23,
        [
            new("m1", "Feature freeze", "Feb 24", true),
            new("m2", "Code complete", "Mar 3", true),
            new("m3", "RC1", "Mar 5", true),
            new("m4", "GA Release", "Mar 10", true),
        ]),
        new("r2", "v3.3.0", "Boreal", "rc", "release/3.3", "Apr 7, 2026", 78, 11, 8,
        [
            new("m5", "Feature freeze", "Mar 17", true),
            new("m6", "Code complete", "Mar 24", false),
            new("m7", "RC1", "Mar 31", false),
            new("m8", "GA Release", "Apr 7", false),
        ]),
        new("r3", "v3.4.0", "Cascade", "development", "main", "May 5, 2026", 32, 18, 0,
        [
            new("m9", "Feature freeze", "Apr 14", false),
            new("m10", "Code complete", "Apr 21", false),
            new("m11", "RC1", "Apr 28", false),
            new("m12", "GA Release", "May 5", false),
        ]),
        new("r4", "v4.0.0", "Drift", "planned", "\u2014", "Jun 16, 2026", 0, 24, 0,
        [
            new("m13", "Feature freeze", "May 25", false),
            new("m14", "Code complete", "Jun 1", false),
            new("m15", "RC1", "Jun 8", false),
            new("m16", "GA Release", "Jun 16", false),
        ]),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "released" => "bg-emerald-500",
        "rc" => "bg-blue-500",
        "development" => "bg-amber-500",
        "planned" => "bg-muted-foreground/30",
        _ => "bg-zinc-400"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "released" => "Released",
        "rc" => "Release candidate",
        "development" => "In development",
        "planned" => "Planned",
        _ => status
    };
}
