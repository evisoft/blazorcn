@* ============================================================
   Block: calendar-prayer-times
   Title: CalendarPrayerTimes
   Description: A prayer and meditation times schedule block for Next.js with daily prayer times, meditation sessions, streak tracking, and mindfulness reminders using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-prayer-times.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Prayer &amp; Meditation</span>
                <p class="text-muted-foreground text-xs">Tuesday, Mar 24, 2026</p>
            </div>
            <div class="text-right">
                <span class="font-medium text-sm tabular-nums">@(Completed)/@(_prayers.Count)</span>
                <p class="text-muted-foreground text-xs">completed</p>
            </div>
        </div>

        @* Week streak *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">This week</span>
                <span class="text-muted-foreground text-xs tabular-nums">@(Streak)-day streak</span>
            </div>
            <div class="flex items-center gap-2">
                @foreach (var session in _weekStreak)
                {
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-full text-xs tabular-nums", session.Completed ? "bg-emerald-500/10 font-medium text-emerald-600 dark:text-emerald-400" : "bg-muted/50 text-muted-foreground")">
                            @(session.Completed ? session.Minutes.ToString() : "—")
                        </div>
                        <span class="text-muted-foreground text-[10px]">@session.Day</span>
                    </div>
                }
            </div>
        </div>

        @* Prayer times *@
        <div>
            @for (int i = 0; i < _prayers.Count; i++)
            {
                var prayer = _prayers[i];
                var config = _categoryConfig[prayer.Category];
                var isLast = i == _prayers.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <button type="button" @onclick="@(() => TogglePrayer(prayer.Id))" class="shrink-0">
                            @if (prayer.Completed)
                            {
                                <LucideIconCn Name="check-circle-2" Class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle" Class="size-4 text-muted-foreground/40" />
                            }
                        </button>
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)" />
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("font-medium text-sm", prayer.Completed ? "text-muted-foreground line-through" : "")">
                                @prayer.Name
                            </span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@prayer.Notes</p>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <LucideIconCn Name="@config.Icon" Class="size-3 text-muted-foreground" />
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">@prayer.Time</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                Morning
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-orange-500"></span>
                Afternoon
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-violet-500"></span>
                Evening
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-indigo-500"></span>
                Night
            </span>
        </div>
    </div>
</section>

@code {
    private class PrayerTime
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string Time { get; init; } = "";
        public string Category { get; init; } = "";
        public bool Completed { get; set; }
        public string Notes { get; init; } = "";
    }

    private record MeditationSession(string Day, int Minutes, bool Completed);

    private class CategoryConfig
    {
        public string Dot { get; init; } = "";
        public string Icon { get; init; } = "";
    }

    private static readonly Dictionary<string, CategoryConfig> _categoryConfig = new()
    {
        ["morning"]   = new() { Dot = "bg-amber-500",  Icon = "sunrise" },
        ["midday"]    = new() { Dot = "bg-yellow-500", Icon = "sun" },
        ["afternoon"] = new() { Dot = "bg-orange-500", Icon = "sun" },
        ["evening"]   = new() { Dot = "bg-violet-500", Icon = "sunset" },
        ["night"]     = new() { Dot = "bg-indigo-500", Icon = "moon" },
    };

    private List<PrayerTime> _prayers = new()
    {
        new() { Id = "1", Name = "Fajr",                Time = "5:42 AM",  Category = "morning",   Completed = true,  Notes = "Dawn prayer" },
        new() { Id = "2", Name = "Morning Meditation",  Time = "6:15 AM",  Category = "morning",   Completed = true,  Notes = "15 min mindfulness" },
        new() { Id = "3", Name = "Dhuhr",               Time = "12:18 PM", Category = "midday",    Completed = true,  Notes = "Midday prayer" },
        new() { Id = "4", Name = "Asr",                 Time = "3:45 PM",  Category = "afternoon", Completed = false, Notes = "Afternoon prayer" },
        new() { Id = "5", Name = "Afternoon Meditation",Time = "4:15 PM",  Category = "afternoon", Completed = false, Notes = "10 min breathing exercise" },
        new() { Id = "6", Name = "Maghrib",             Time = "6:32 PM",  Category = "evening",   Completed = false, Notes = "Sunset prayer" },
        new() { Id = "7", Name = "Isha",                Time = "8:01 PM",  Category = "night",     Completed = false, Notes = "Night prayer" },
        new() { Id = "8", Name = "Evening Reflection",  Time = "9:00 PM",  Category = "night",     Completed = false, Notes = "10 min gratitude journaling" },
    };

    private static readonly MeditationSession[] _weekStreak =
    [
        new("Mon", 15, true),
        new("Tue", 20, true),
        new("Wed", 15, true),
        new("Thu", 10, true),
        new("Fri", 25, true),
        new("Sat", 15, true),
        new("Sun",  0, false),
    ];

    private int Completed => _prayers.Count(p => p.Completed);
    private int Streak => _weekStreak.Count(s => s.Completed);

    private void TogglePrayer(string id)
    {
        var prayer = _prayers.First(p => p.Id == id);
        prayer.Completed = !prayer.Completed;
    }
}
