@* ============================================================
   Block: calendar-appointment-queue
   Title: CalendarAppointmentQueue
   Description: A queue-based appointment scheduler block for Next.js with priority ordering, wait times, status indicators, and position tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-appointment-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Appointment Queue</h2>
                <p class="text-muted-foreground text-xs">Tuesday, Mar 17, 2026</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="MarkNext">
                Next Patient
            </ButtonCn>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="user" Size="14" Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @_activeCount
                </span>
                in queue
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">@_completedCount</span>
                completed
            </div>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            @foreach (var f in _filterOptions)
            {
                var filterVal = f;
                <ButtonCn Variant="@(_filter == filterVal ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs capitalize" @onclick="@(() => SetFilter(filterVal))">
                    @filterVal
                </ButtonCn>
            }
        </div>

        <div>
            @for (var i = 0; i < _filteredItems.Count; i++)
            {
                var index = i;
                var item = _filteredItems[index];
                var config = _statusConfig[item.Status];
                var isLast = index == _filteredItems.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@item.Name</span>
                            @if (item.Priority == "urgent")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-red-600">
                                    Urgent
                                </BadgeCn>
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="text-muted-foreground text-xs">@item.Service</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                @item.CheckInTime
                            </span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-0.5">
                        @if (item.Position > 0)
                        {
                            <span class="flex items-center gap-0.5 font-medium text-xs tabular-nums">
                                <LucideIconCn Name="hash" Size="12" Class="size-3 text-muted-foreground" />
                                @item.Position
                            </span>
                        }
                        <span class="@Cn.Merge("text-xs", config.Color)">
                            @(item.Status == "waiting" ? item.EstimatedWait : config.Label)
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class QueueItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Service { get; set; } = "";
        public int Position { get; set; }
        public string EstimatedWait { get; set; } = "";
        public string Status { get; set; } = "";
        public string CheckInTime { get; set; } = "";
        public string Priority { get; set; } = "";
    }

    private record StatusConfig(string Label, string Color, string Dot);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["waiting"]     = new("Waiting",     "text-muted-foreground", "bg-amber-500"),
        ["in-progress"] = new("In Progress", "text-blue-600",         "bg-blue-500"),
        ["completed"]   = new("Completed",   "text-emerald-600",      "bg-emerald-500"),
        ["no-show"]     = new("No Show",     "text-red-600",          "bg-red-500"),
    };

    private static readonly string[] _filterOptions = ["active", "done", "all"];

    private List<QueueItem> _queue =
    [
        new() { Id = "1", Name = "Sarah Chen",       Service = "General Consultation", Position = 1, EstimatedWait = "Now",    Status = "in-progress", CheckInTime = "9:00 AM", Priority = "normal" },
        new() { Id = "2", Name = "Marcus Johnson",   Service = "Follow-up Visit",       Position = 2, EstimatedWait = "5 min",  Status = "waiting",     CheckInTime = "9:12 AM", Priority = "urgent" },
        new() { Id = "3", Name = "Elena Rodriguez",  Service = "New Patient Intake",    Position = 3, EstimatedWait = "15 min", Status = "waiting",     CheckInTime = "9:18 AM", Priority = "normal" },
        new() { Id = "4", Name = "James O'Brien",    Service = "Lab Results Review",    Position = 4, EstimatedWait = "25 min", Status = "waiting",     CheckInTime = "9:24 AM", Priority = "normal" },
        new() { Id = "5", Name = "Priya Sharma",     Service = "Prescription Refill",   Position = 5, EstimatedWait = "35 min", Status = "waiting",     CheckInTime = "9:31 AM", Priority = "normal" },
        new() { Id = "6", Name = "David Kim",        Service = "General Consultation",  Position = 6, EstimatedWait = "45 min", Status = "waiting",     CheckInTime = "9:40 AM", Priority = "urgent" },
        new() { Id = "7", Name = "Lisa Novak",       Service = "Follow-up Visit",       Position = 0, EstimatedWait = "-",      Status = "completed",   CheckInTime = "8:30 AM", Priority = "normal" },
        new() { Id = "8", Name = "Tom Patel",        Service = "General Consultation",  Position = 0, EstimatedWait = "-",      Status = "no-show",     CheckInTime = "8:45 AM", Priority = "normal" },
    ];

    private string _filter = "active";
    private List<QueueItem> _filteredItems = [];
    private int _activeCount;
    private int _completedCount;

    protected override void OnInitialized()
    {
        UpdateDerived();
    }

    private void SetFilter(string f)
    {
        _filter = f;
        UpdateDerived();
    }

    private void MarkNext()
    {
        var inProgress = _queue.FirstOrDefault(i => i.Status == "in-progress");
        if (inProgress != null) inProgress.Status = "completed";
        var nextWaiting = _queue.FirstOrDefault(i => i.Status == "waiting");
        if (nextWaiting != null) nextWaiting.Status = "in-progress";
        UpdateDerived();
    }

    private void UpdateDerived()
    {
        _filteredItems = _filter switch
        {
            "active" => _queue.Where(i => i.Status == "waiting" || i.Status == "in-progress").ToList(),
            "done"   => _queue.Where(i => i.Status == "completed" || i.Status == "no-show").ToList(),
            _        => _queue.ToList()
        };
        _activeCount    = _queue.Count(i => i.Status == "waiting" || i.Status == "in-progress");
        _completedCount = _queue.Count(i => i.Status == "completed");
    }
}
