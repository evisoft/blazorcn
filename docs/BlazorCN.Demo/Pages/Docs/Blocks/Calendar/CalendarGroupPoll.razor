@* ============================================================
   Block: calendar-group-poll
   Title: CalendarGroupPoll
   Description: A group availability poll block for Next.js with time slot voting, participant responses, and best-time suggestions using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-group-poll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">When2Meet: Sprint Retro</h2>
                <p class="text-muted-foreground text-xs">Find the best time for everyone</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideUsersCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_participants.Length</span>
                <span class="text-muted-foreground text-xs">responded</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Best time:</span>
            <span class="font-medium text-sm">
                @_bestSlot.Date at @_bestSlot.Time
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-emerald-600 text-xs tabular-nums">
                @GetYesCount(_bestSlot)/@_participants.Length available
            </span>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="flex size-4 items-center justify-center rounded bg-emerald-500/20 text-emerald-600">
                    <LucideCheckCn Size="12" class="size-3" />
                </span>
                Yes
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="flex size-4 items-center justify-center rounded bg-muted text-muted-foreground">
                    ~
                </span>
                Maybe
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="flex size-4 items-center justify-center rounded bg-red-500/20 text-red-600">
                    <LucideXCn Size="12" class="size-3" />
                </span>
                No
            </div>
        </div>

        @* Header row *@
        <div class="flex items-center border-b px-4 py-2">
            <div class="w-36 shrink-0"></div>
            @foreach (var p in _participants)
            {
                <div class="flex flex-1 justify-center">
                    <div
                        class="flex size-7 items-center justify-center rounded-full bg-muted text-xs font-medium"
                        title="@p.Name">
                        @p.Initials
                    </div>
                </div>
            }
            <div class="w-12 shrink-0 text-center text-muted-foreground text-xs">Total</div>
        </div>

        @* Time slots *@
        <div>
            @for (var si = 0; si < _slots.Length; si++)
            {
                var index = si;
                var slot = _slots[index];
                var yesCount = GetYesCount(slot);
                var isBest = slot.Id == _bestSlot.Id;
                <div class="@Cn.Merge("flex items-center px-4 py-2.5", index < _slots.Length - 1 ? "border-b" : "", isBest ? "bg-emerald-500/5" : "")">
                    <div class="w-36 shrink-0">
                        <span class="font-medium text-sm">@slot.Time</span>
                        <p class="text-muted-foreground text-xs">@slot.Date</p>
                    </div>
                    @foreach (var p in _participants)
                    {
                        var vote = slot.Votes.TryGetValue(p.Id, out var v) ? v : "";
                        <div class="flex flex-1 justify-center">
                            @if (vote == "yes")
                            {
                                <span class="flex size-6 items-center justify-center rounded bg-emerald-500/20 text-emerald-600">
                                    <LucideCheckCn Size="12" class="size-3" />
                                </span>
                            }
                            @if (vote == "no")
                            {
                                <span class="flex size-6 items-center justify-center rounded bg-red-500/20 text-red-600">
                                    <LucideXCn Size="12" class="size-3" />
                                </span>
                            }
                            @if (vote == "maybe")
                            {
                                <span class="flex size-6 items-center justify-center rounded bg-muted text-muted-foreground text-xs">
                                    ~
                                </span>
                            }
                        </div>
                    }
                    <div class="w-12 shrink-0 text-center">
                        <span class="@Cn.Merge("font-medium text-xs tabular-nums", yesCount == _participants.Length ? "text-emerald-600" : "text-muted-foreground")">
                            @yesCount/@_participants.Length
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="h-7 w-full text-xs">
                Confirm Best Time
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Participant(string Id, string Name, string Initials);
    private record TimeSlot(string Id, string Date, string Time, Dictionary<string, string> Votes);

    private static readonly Participant[] _participants =
    [
        new("p1", "Sarah Chen", "SC"),
        new("p2", "Marcus J.", "MJ"),
        new("p3", "Elena R.", "ER"),
        new("p4", "James O.", "JO"),
        new("p5", "Priya S.", "PS"),
    ];

    private static readonly TimeSlot[] _slots =
    [
        new("s1", "Mon, Mar 23", "10:00 AM", new() { ["p1"] = "yes", ["p2"] = "yes", ["p3"] = "no",  ["p4"] = "yes",   ["p5"] = "maybe" }),
        new("s2", "Mon, Mar 23", "2:00 PM",  new() { ["p1"] = "no",  ["p2"] = "yes", ["p3"] = "yes", ["p4"] = "no",    ["p5"] = "yes"   }),
        new("s3", "Tue, Mar 24", "10:00 AM", new() { ["p1"] = "yes", ["p2"] = "yes", ["p3"] = "yes", ["p4"] = "yes",   ["p5"] = "yes"   }),
        new("s4", "Tue, Mar 24", "3:00 PM",  new() { ["p1"] = "yes", ["p2"] = "no",  ["p3"] = "yes", ["p4"] = "maybe", ["p5"] = "no"    }),
        new("s5", "Wed, Mar 25", "11:00 AM", new() { ["p1"] = "yes", ["p2"] = "yes", ["p3"] = "yes", ["p4"] = "yes",   ["p5"] = "no"    }),
        new("s6", "Wed, Mar 25", "4:00 PM",  new() { ["p1"] = "maybe", ["p2"] = "no", ["p3"] = "yes", ["p4"] = "yes",  ["p5"] = "yes"   }),
    ];

    private static int GetYesCount(TimeSlot slot) =>
        slot.Votes.Values.Count(v => v == "yes");

    private static readonly TimeSlot _bestSlot =
        _slots.OrderByDescending(s => GetYesCount(s)).First();
}
