@* ============================================================
   Block: calendar-team-schedule
   Title: Calendar Team Schedule
   Description: A team availability matrix with member rows, time slot columns, status indicators, and overlap detection built with React, Next.js, shadcn/ui Avatar, and Tailwind CSS
   Long Description: Individual availability selector
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-team-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team Schedule</span>
                <span class="text-muted-foreground text-xs">@_members.Length members</span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronLeftCn Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideCalendarCn Class="size-3" />
                    Wed, Mar 18
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronRightCn Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Schedule matrix *@
        <div class="overflow-x-auto">
            <div class="min-w-[640px]">
                @* Time slot headers *@
                <div class="grid grid-cols-[11rem_repeat(9,1fr)] border-b">
                    <div class="border-r px-3 py-2">
                        <span class="text-muted-foreground text-xs">Team Member</span>
                    </div>
                    @for (int i = 0; i < _timeSlots.Length; i++)
                    {
                        var slotIdx = i;
                        <button type="button"
                                @onclick="@(() => _selectedSlot = _selectedSlot == slotIdx ? (int?)null : slotIdx)"
                                class="@($"border-r px-1 py-2 text-center transition-colors last:border-r-0 hover:bg-muted/50 {(_selectedSlot == slotIdx ? "bg-muted/50" : "")}")">
                            <span class="text-muted-foreground text-xs">@_timeSlots[slotIdx]</span>
                        </button>
                    }
                </div>

                @* Member rows *@
                @for (int mi = 0; mi < _members.Length; mi++)
                {
                    var member = _members[mi];
                    var isLast = mi == _members.Length - 1;
                    <div class="@($"grid grid-cols-[11rem_repeat(9,1fr)] {(isLast ? "" : "border-b")}")">
                        @* Member info *@
                        <div class="flex items-center gap-2 border-r px-3 py-2.5">
                            <AvatarCn Size="AvatarSize.Sm">
                                <AvatarFallbackCn Class="text-xs">@member.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <span class="block truncate font-medium text-xs">@member.Name</span>
                                <span class="block truncate text-muted-foreground text-xs">@member.Role</span>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">@member.Timezone</span>
                        </div>

                        @* Schedule slots *@
                        @for (int si = 0; si < member.Schedule.Length; si++)
                        {
                            var status = member.Schedule[si];
                            var slotIdx = si;
                            <div class="@($"flex items-center justify-center border-r p-1 last:border-r-0 {GetStatusColor(status)} {(_selectedSlot == slotIdx ? "ring-1 ring-inset ring-foreground/10" : "")}")"
                                 title="@($"{member.Name}: {GetStatusLabel(status)} at {_timeSlots[slotIdx]}")">
                                <span class="@($"size-2 rounded-full {GetStatusDot(status)}")" />
                            </div>
                        }
                    </div>
                }

                @* Availability summary row *@
                <div class="grid grid-cols-[11rem_repeat(9,1fr)] border-t">
                    <div class="flex items-center border-r px-3 py-2">
                        <span class="font-medium text-muted-foreground text-xs">Available</span>
                    </div>
                    @for (int i = 0; i < _timeSlots.Length; i++)
                    {
                        var count = _availabilityCounts[i];
                        var isMax = count == _maxAvailable && count > 0;
                        <div class="@($"flex items-center justify-center border-r py-2 last:border-r-0 {(isMax ? "bg-emerald-500/10" : "")}")">
                            <span class="@($"font-medium text-xs tabular-nums {(isMax ? "text-emerald-600 dark:text-emerald-400" : count == 0 ? "text-muted-foreground/40" : "text-muted-foreground")}")">
                                @count/@_activeMemberCount
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Legend *@
        <div class="flex flex-wrap items-center gap-4 border-t px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500" />
                Available
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500" />
                Busy
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500" />
                In meeting
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-red-500" />
                Out of office
            </span>
            <div class="ml-auto">
                @if (_selectedSlot.HasValue)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                        @_availabilityCounts[_selectedSlot.Value] of @_activeMemberCount free at @_timeSlots[_selectedSlot.Value]
                    </BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private int? _selectedSlot;

    private record TeamMember(string Id, string Name, string Initials, string Role, string Timezone, string[] Schedule);

    private static readonly string[] _timeSlots = ["9 AM", "10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM", "5 PM"];

    private static readonly TeamMember[] _members =
    [
        new("1", "Alex Rivera", "AR", "Engineering Lead", "PST", ["meeting", "meeting", "available", "available", "busy", "available", "available", "meeting", "available"]),
        new("2", "Jordan Lee", "JL", "Product Designer", "PST", ["available", "available", "meeting", "available", "available", "available", "busy", "available", "available"]),
        new("3", "Priya Sharma", "PS", "Frontend Engineer", "EST", ["available", "busy", "busy", "available", "available", "meeting", "available", "available", "available"]),
        new("4", "Marcus Chen", "MC", "Backend Engineer", "CST", ["busy", "available", "available", "meeting", "available", "available", "available", "busy", "ooo"]),
        new("5", "Sophia Nguyen", "SN", "QA Engineer", "PST", ["available", "available", "available", "available", "meeting", "meeting", "available", "available", "available"]),
        new("6", "David Kim", "DK", "DevOps Engineer", "EST", ["ooo", "ooo", "ooo", "ooo", "ooo", "ooo", "ooo", "ooo", "ooo"]),
    ];

    private static readonly int[] _availabilityCounts = _timeSlots.Select((_, i) =>
        _members.Count(m => m.Schedule[i] == "available")).ToArray();

    private static readonly int _maxAvailable = _availabilityCounts.Max();
    private static readonly int _activeMemberCount = _members.Count(m => !m.Schedule.All(s => s == "ooo"));

    private static string GetStatusColor(string status) => status switch
    {
        "available" => "bg-emerald-500/15",
        "busy" => "bg-amber-500/15",
        "meeting" => "bg-blue-500/15",
        "ooo" => "bg-red-500/10",
        _ => ""
    };

    private static string GetStatusDot(string status) => status switch
    {
        "available" => "bg-emerald-500",
        "busy" => "bg-amber-500",
        "meeting" => "bg-blue-500",
        "ooo" => "bg-red-500",
        _ => "bg-zinc-400"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "available" => "Available",
        "busy" => "Busy",
        "meeting" => "In meeting",
        "ooo" => "Out of office",
        _ => status
    };
}
