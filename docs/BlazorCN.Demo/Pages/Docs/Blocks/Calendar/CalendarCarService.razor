@* ============================================================
   Block: calendar-car-service
   Title: CalendarCarService
   Description: A vehicle service reminder calendar block for Next.js with maintenance schedules, mileage tracking, and service history using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-car-service.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Vehicle Service Calendar</h2>
                <p class="text-muted-foreground text-xs">@_vehicles.Length vehicles tracked</p>
            </div>
            <div class="flex items-center gap-2">
                @if (_overdueCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs text-red-600">
                        @_overdueCount overdue
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideWrenchCn Size="14" class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @_upcomingCount
                </span>
                upcoming
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideAlertTriangleCn Size="14" class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">@_overdueCount</span>
                overdue
            </div>
        </div>

        <div>
            @for (var vi = 0; vi < _vehicles.Length; vi++)
            {
                var vIndex = vi;
                var vehicle = _vehicles[vIndex];
                var isExpanded = _expandedVehicle == vehicle.Id;
                <div class="@(vIndex < _vehicles.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedVehicle = (isExpanded ? "" : vehicle.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideCarCn Size="16" class="size-4 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@vehicle.Name</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">
                                    @vehicle.Plate
                                </span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @vehicle.Mileage
                                </span>
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t">
                            @for (var si = 0; si < vehicle.Services.Length; si++)
                            {
                                var sIndex = si;
                                var service = vehicle.Services[sIndex];
                                var config = _statusConfig[service.Status];
                                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 pl-11", sIndex < vehicle.Services.Length - 1 ? "border-b" : "")">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm">@service.Type</span>
                                        <div class="mt-0.5 flex items-center gap-2">
                                            <span class="text-muted-foreground text-xs">@service.Date</span>
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <span class="text-muted-foreground text-xs tabular-nums">
                                                @service.Mileage
                                            </span>
                                        </div>
                                    </div>
                                    @if (service.Status == "completed")
                                    {
                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                            <LucideCheckCircle2Cn Size="12" class="size-3" />
                                            @service.Cost
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="@Cn.Merge("text-xs", service.Status == "overdue" ? "text-red-600" : "text-muted-foreground")">
                                            @config.Label
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ServiceRecord(string Id, string Type, string Date, string Mileage, string Status, string Cost = "", string Notes = "");
    private record Vehicle(string Id, string Name, string Plate, string Mileage, ServiceRecord[] Services);
    private record StatusConfig(string Label, string Dot);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["completed"] = new StatusConfig("Done", "bg-emerald-500"),
        ["upcoming"] = new StatusConfig("Upcoming", "bg-blue-500"),
        ["overdue"] = new StatusConfig("Overdue", "bg-red-500"),
    };

    private static readonly Vehicle[] _vehicles =
    [
        new("1", "2024 Tesla Model 3", "ABC-1234", "28,400 mi",
        [
            new("s1", "Tire Rotation", "Mar 28, 2026", "30,000 mi", "upcoming"),
            new("s2", "Brake Fluid Flush", "Mar 15, 2026", "28,000 mi", "overdue"),
            new("s3", "Cabin Air Filter", "Feb 10, 2026", "25,000 mi", "completed", "$45"),
            new("s4", "Annual Inspection", "Jan 5, 2026", "22,000 mi", "completed", "$120"),
        ]),
        new("2", "2022 Honda CR-V", "XYZ-5678", "45,200 mi",
        [
            new("s5", "Oil Change", "Apr 2, 2026", "47,500 mi", "upcoming"),
            new("s6", "Timing Belt", "Mar 20, 2026", "45,000 mi", "upcoming"),
            new("s7", "Oil Change", "Jan 22, 2026", "42,500 mi", "completed", "$65"),
        ]),
    ];

    private string _expandedVehicle = "1";

    private int _overdueCount => _vehicles.Sum(v => v.Services.Count(s => s.Status == "overdue"));
    private int _upcomingCount => _vehicles.Sum(v => v.Services.Count(s => s.Status == "upcoming"));
}
