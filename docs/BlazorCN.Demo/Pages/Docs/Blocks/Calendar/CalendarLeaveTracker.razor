@* ============================================================
   Block: calendar-leave-tracker
   Title: Calendar Leave Tracker
   Description: A React employee leave and PTO tracker block for Next.js with leave type, remaining balance, approval status, and team calendar view built with shadcn/ui and Tailwind CSS
   Long Description: React Inventory Restock Schedule Calendar Block
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-leave-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Leave Tracker</span>
            </div>
            @if (_pendingCount > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_pendingCount pending
                </BadgeCn>
            }
        </div>

        @* Leave balances *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var balance in _leaveBalances)
            {
                <div class="flex flex-col gap-2 bg-card px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        <span class="@($"size-1.5 rounded-full {GetTypeDot(balance.Type)}")" />
                        <span class="text-muted-foreground text-xs">@balance.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="font-semibold text-lg tabular-nums">@balance.Remaining</span>
                        <span class="text-muted-foreground text-xs">/@balance.Total</span>
                    </div>
                    <ProgressCn Value="@((int)((double)balance.Used / balance.Total * 100))" Class="h-1" />
                </div>
            }
        </div>

        @* Leave requests *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Recent requests</span>
        </div>
        <div>
            @for (int i = 0; i < _leaveRequests.Length; i++)
            {
                var request = _leaveRequests[i];
                var isExpanded = _expanded == request.Id;
                var isLast = i == _leaveRequests.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == request.Id ? null : request.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50 font-medium text-muted-foreground text-xs">
                            @request.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@request.Employee</span>
                                <span class="@($"size-1.5 rounded-full {GetTypeDot(request.Type)}")" />
                            </div>
                            <span class="mt-0.5 text-muted-foreground text-xs">
                                @request.StartDate@(request.StartDate != request.EndDate ? $" \u2014 {request.EndDate}" : "")
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="@($"rounded-full px-2 py-0.5 text-xs {GetStatusBadge(request.Status)}")">
                                @(char.ToUpper(request.Status[0]) + request.Status[1..])
                            </span>
                            <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-14">
                            <div class="flex flex-col gap-2">
                                <div class="flex items-center gap-3 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1.5">
                                        <LucideUserCn Class="size-3" />
                                        @GetTypeLabel(request.Type)
                                    </span>
                                    <span>·</span>
                                    <span class="tabular-nums">@request.Days day@(request.Days != 1 ? "s" : "")</span>
                                </div>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="font-medium text-muted-foreground text-xs">Reason</span>
                                    <p class="mt-1 text-sm">@request.Reason</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record LeaveBalance(string Type, string Label, int Total, int Used, int Remaining);
    private record LeaveRequest(string Id, string Employee, string Initials, string Type, string StartDate, string EndDate, int Days, string Status, string Reason);

    private static readonly LeaveBalance[] _leaveBalances =
    [
        new("vacation", "Vacation", 20, 7, 13),
        new("sick", "Sick Leave", 10, 2, 8),
        new("personal", "Personal", 5, 1, 4),
        new("remote", "Remote Days", 48, 18, 30),
    ];

    private static readonly LeaveRequest[] _leaveRequests =
    [
        new("1", "Sarah Chen", "SC", "vacation", "Mar 23, 2026", "Mar 27, 2026", 5, "pending", "Family vacation \u2014 visiting relatives in Vancouver"),
        new("2", "James Wilson", "JW", "sick", "Mar 18, 2026", "Mar 18, 2026", 1, "approved", "Doctor appointment"),
        new("3", "Maria Garcia", "MG", "personal", "Mar 20, 2026", "Mar 20, 2026", 1, "approved", "Moving day \u2014 apartment relocation"),
        new("4", "Alex Park", "AP", "vacation", "Apr 6, 2026", "Apr 10, 2026", 5, "pending", "Spring break trip"),
        new("5", "Taylor Reed", "TR", "remote", "Mar 19, 2026", "Mar 20, 2026", 2, "approved", "Working from home \u2014 internet installation"),
        new("6", "Jordan Lee", "JL", "vacation", "Mar 10, 2026", "Mar 12, 2026", 3, "rejected", "Short getaway"),
    ];

    private static readonly int _pendingCount = _leaveRequests.Count(r => r.Status == "pending");

    private static string GetTypeDot(string type) => type switch
    {
        "vacation" => "bg-blue-500",
        "sick" => "bg-red-500",
        "personal" => "bg-amber-500",
        "remote" => "bg-emerald-500",
        _ => "bg-zinc-400"
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "vacation" => "Vacation",
        "sick" => "Sick",
        "personal" => "Personal",
        "remote" => "Remote",
        _ => type
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "approved" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "pending" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "rejected" => "bg-red-500/10 text-red-700 dark:text-red-400",
        _ => ""
    };
}
