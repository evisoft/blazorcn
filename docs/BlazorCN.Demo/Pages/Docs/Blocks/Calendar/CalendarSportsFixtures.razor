@* ============================================================
   Block: calendar-sports-fixtures
   Title: CalendarSportsFixtures
   Description: A sports fixtures calendar block for Next.js with match schedules, team standings, venue details, and score tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-sports-fixtures.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTrophyCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">@_ourTeam Fixtures</span>
                    <p class="text-muted-foreground text-xs">2025/26 Season</p>
                </div>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_upcoming upcoming</span>
        </div>

        @* Form summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Recent form:</span>
            <div class="flex items-center gap-2">
                <span class="flex items-center gap-1 text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_wins W
                </span>
                <span class="flex items-center gap-1 text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_draws D
                </span>
                <span class="flex items-center gap-1 text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_losses L
                </span>
            </div>
        </div>

        <div>
            @for (var mi = 0; mi < _matches.Length; mi++)
            {
                var matchIndex = mi;
                var match = _matches[matchIndex];
                var isExpanded = _expanded == match.Id;
                var config = _statusConfig[match.Status];
                var isHome = match.HomeTeam == _ourTeam;

                <div class="@(matchIndex < _matches.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? "" : match.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("text-sm", match.HomeTeam == _ourTeam ? "font-medium" : "")">
                                    @match.HomeTeam
                                </span>
                                @if (match.Status == "completed")
                                {
                                    <span class="font-mono text-xs font-medium tabular-nums">
                                        @match.HomeScore - @match.AwayScore
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-xs">vs</span>
                                }
                                <span class="@Cn.Merge("text-sm", match.AwayTeam == _ourTeam ? "font-medium" : "")">
                                    @match.AwayTeam
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Size="12" class="size-3" />
                                    @match.Date, @match.Time
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @(isHome ? "Home" : "Away")
                                </BadgeCn>
                            </div>
                        </div>
                        @if (match.Result != null)
                        {
                            <span class="@Cn.Merge("shrink-0 text-xs font-medium uppercase", _resultConfig[match.Result])">
                                @match.Result
                            </span>
                        }
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            <div class="flex flex-col gap-1.5 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1.5">
                                    <LucideMapPinCn Size="12" class="size-3" />
                                    @match.Venue
                                </span>
                                <span>
                                    <span class="font-medium text-foreground">Competition:</span>
                                    @(" ")@match.Competition
                                </span>
                            </div>
                            <p class="mt-2 text-muted-foreground text-xs italic">@match.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _statusConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Value.Dot)"></span>
                    @entry.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record Match(string Id, string HomeTeam, string AwayTeam, int? HomeScore, int? AwayScore, string Date, string Time, string Venue, string Competition, string Status, string? Result, string Notes);
    private record StatusConfig(string Dot, string Label);

    private const string _ourTeam = "FC United";

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["upcoming"] = new("bg-blue-500", "Upcoming"),
        ["live"] = new("bg-red-500", "Live"),
        ["completed"] = new("bg-zinc-400", "Final"),
    };

    private static readonly Dictionary<string, string> _resultConfig = new()
    {
        ["win"] = "text-emerald-600 dark:text-emerald-400",
        ["loss"] = "text-red-600 dark:text-red-400",
        ["draw"] = "text-amber-600 dark:text-amber-400",
    };

    private static readonly Match[] _matches =
    [
        new("1", "FC United", "City Rangers", 3, 1, "Mar 15, 2026", "3:00 PM", "United Park", "Premier League", "completed", "win",
            "Strong second half. Goals from Torres (32'), Kim (58'), Santos (72'). Clean sheet almost held."),
        new("2", "Riverside FC", "FC United", 2, 2, "Mar 22, 2026", "5:30 PM", "River Stadium", "Premier League", "completed", "draw",
            "Late equalizer from Chen (89'). Fought back from 2-0 down. Encouraging second half display."),
        new("3", "FC United", "Athletic Wanderers", null, null, "Mar 29, 2026", "3:00 PM", "United Park", "Premier League", "upcoming", null,
            "Key clash for top-4 finish. Wanderers unbeaten in last 5. Captain back from injury."),
        new("4", "FC United", "Dynamo SC", null, null, "Apr 2, 2026", "7:45 PM", "United Park", "Cup Quarter-Final", "upcoming", null,
            "Cup quarter-final. Single leg elimination. Full stadium expected. Priority match."),
        new("5", "Parkside Town", "FC United", null, null, "Apr 5, 2026", "12:30 PM", "Parkside Ground", "Premier League", "upcoming", null,
            "Early kickoff. TV selection. Parkside struggling in bottom 3. Away support sold out."),
    ];

    private int _wins => _matches.Count(m => m.Result == "win");
    private int _draws => _matches.Count(m => m.Result == "draw");
    private int _losses => _matches.Count(m => m.Result == "loss");
    private int _upcoming => _matches.Count(m => m.Status == "upcoming");

    private string _expanded = "3";
}
