@* ============================================================
   Block: calendar-sales-pipeline
   Title: CalendarSalesPipeline
   Description: A sales pipeline timeline calendar block for Next.js with deal stages, revenue forecasting, close dates, and opportunity tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-sales-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTrendingUpCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Sales Pipeline</span>
                    <p class="text-muted-foreground text-xs">
                        Q1 2026 · @ActiveDeals.Count() active deals
                    </p>
                </div>
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Pipeline</span>
                <p class="font-semibold text-lg tabular-nums">
                    $@(PipelineValue / 1000)K
                </p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Weighted</span>
                <p class="text-sm tabular-nums">$@((int)(WeightedValue / 1000))K</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Won</span>
                <p class="text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                    $@(WonValue / 1000)K
                </p>
            </div>
        </div>

        <div>
            @for (var di = 0; di < _deals.Length; di++)
            {
                var dealIndex = di;
                var deal = _deals[dealIndex];
                var isExpanded = _expanded == deal.Id;
                var config = _stageConfig[deal.Stage];
                <div class="@(dealIndex < _deals.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? "" : deal.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@deal.Company</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @config.Label
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1 tabular-nums">
                                    <LucideDollarSignCn Size="12" class="size-3" />$@(deal.Value.ToString("N0"))
                                </span>
                                <span>Close: @deal.CloseDate</span>
                            </div>
                        </div>
                        @if (deal.Probability > 0 && deal.Probability < 100)
                        {
                            <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                @(deal.Probability)%
                            </span>
                        }
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            <div class="flex flex-col gap-1.5 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1.5">
                                    <LucideUserCn Size="12" class="size-3" />
                                    @deal.Contact
                                </span>
                                <span>
                                    <span class="font-medium text-foreground">Owner:</span> @deal.Owner
                                </span>
                                @if (deal.DaysInStage > 0)
                                {
                                    <span class="tabular-nums">
                                        @deal.DaysInStage days in current stage
                                    </span>
                                }
                            </div>
                            <p class="mt-2 text-muted-foreground text-xs italic">@deal.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _stageConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Value.Dot)"></span>
                    @entry.Value.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record StageConfig(string Dot, string Label);
    private record Deal(string Id, string Company, string Contact, int Value, string Stage, int Probability, string CloseDate, int DaysInStage, string Owner, string Notes);

    private static readonly Dictionary<string, StageConfig> _stageConfig = new()
    {
        ["discovery"] = new StageConfig("bg-blue-500", "Discovery"),
        ["proposal"] = new StageConfig("bg-violet-500", "Proposal"),
        ["negotiation"] = new StageConfig("bg-amber-500", "Negotiation"),
        ["closed-won"] = new StageConfig("bg-emerald-500", "Closed Won"),
        ["closed-lost"] = new StageConfig("bg-red-500", "Closed Lost"),
    };

    private static readonly Deal[] _deals =
    [
        new("1", "Acme Corp", "John Blake, VP Engineering", 85000, "negotiation", 75, "Mar 28, 2026", 8, "Sarah Kim", "Finalizing contract terms. Legal review in progress. Discount approved at 10%."),
        new("2", "TechStart Inc", "Maria Santos, CTO", 42000, "proposal", 50, "Apr 4, 2026", 5, "Sarah Kim", "Sent proposal on Mar 19. Follow-up call scheduled for Mar 25."),
        new("3", "GlobalRetail", "David Chen, Head of IT", 120000, "discovery", 25, "Apr 18, 2026", 3, "Marcus Lee", "Initial demo completed. Evaluating against 2 competitors. Need technical deep-dive."),
        new("4", "FinanceHub", "Elena Petrov, COO", 68000, "negotiation", 80, "Mar 26, 2026", 12, "Marcus Lee", "Verbal agreement received. Awaiting procurement sign-off. Expected this week."),
        new("5", "MediCare Solutions", "Robert Kim, Director", 55000, "closed-won", 100, "Mar 20, 2026", 0, "Sarah Kim", "Contract signed Mar 20. Onboarding starts Apr 1. Annual subscription."),
        new("6", "EduTech Pro", "Lisa Wang, CEO", 35000, "closed-lost", 0, "Mar 18, 2026", 0, "Marcus Lee", "Lost to competitor on pricing. Budget constraints. Revisit in Q3."),
    ];

    private string _expanded = "1";

    private IEnumerable<Deal> ActiveDeals => _deals.Where(d => !d.Stage.StartsWith("closed"));
    private int PipelineValue => ActiveDeals.Sum(d => d.Value);
    private double WeightedValue => ActiveDeals.Sum(d => d.Value * (d.Probability / 100.0));
    private int WonValue => _deals.Where(d => d.Stage == "closed-won").Sum(d => d.Value);
}
