@* ============================================================
   Block: calendar-tax-deadlines
   Title: CalendarTaxDeadlines
   Description: A tax filing deadline tracker calendar block for Next.js with filing dates, document checklists, penalty alerts, and status tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-tax-deadlines.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="landmark" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Tax Deadlines</span>
                    <p class="text-muted-foreground text-xs">Tax Year 2025 · Filing Season 2026</p>
                </div>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_upcoming pending</span>
        </div>

        <div>
            @for (var i = 0; i < _deadlines.Length; i++)
            {
                var deadline = _deadlines[i];
                var isLast = i == _deadlines.Length - 1;
                var isExpanded = _expanded == deadline.Id;
                var tConfig = _typeConfig[deadline.Type];
                var sConfig = _statusConfig[deadline.Status];
                var docsReady = deadline.Documents.Count(d => d.Ready);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="@(() => _expanded = isExpanded ? "" : deadline.Id)" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (deadline.Status == "filed")
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                        }
                        else
                        {
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", tConfig.Dot)"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@deadline.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">@deadline.Form</BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>Due @deadline.DueDate</span>
                                <span class="@sConfig.Color">@sConfig.Label</span>
                            </div>
                        </div>
                        @if (deadline.DaysUntil > 0 && deadline.Status != "filed")
                        {
                            <span class="@Cn.Merge("shrink-0 text-xs font-medium tabular-nums", UrgencyColor(deadline.DaysUntil))">
                                @(deadline.DaysUntil)d
                            </span>
                        }
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            @if (deadline.Status != "filed")
                            {
                                <div class="mb-2 flex items-start gap-1.5 rounded-md bg-amber-500/10 p-2">
                                    <LucideIconCn Name="alert-triangle" Size="12" Class="mt-0.5 size-3 shrink-0 text-amber-600 dark:text-amber-400" />
                                    <span class="text-xs text-amber-700 dark:text-amber-300">
                                        Penalty: @deadline.Penalty
                                    </span>
                                </div>
                            }
                            <div class="mb-2">
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                                        Documents
                                    </span>
                                    <span class="text-muted-foreground text-xs tabular-nums">
                                        @docsReady/@deadline.Documents.Length ready
                                    </span>
                                </div>
                                <div class="space-y-1">
                                    @foreach (var doc in deadline.Documents)
                                    {
                                        <div class="flex items-center gap-2 px-1 py-0.5">
                                            @if (doc.Ready)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="circle" Size="12" Class="size-3 shrink-0 text-muted-foreground/40" />
                                            }
                                            <span class="@Cn.Merge("text-xs", doc.Ready ? "text-muted-foreground" : "")">@doc.Name</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <p class="text-muted-foreground text-xs italic">@deadline.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            @foreach (var entry in _typeConfigOrdered)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", entry.Dot)"></span>
                    @entry.Label
                </span>
            }
        </div>
    </div>
</section>

@code {
    private string _expanded = "1";

    private int _upcoming => _deadlines.Count(d => d.DaysUntil > 0 && d.Status != "filed");

    private static string UrgencyColor(int days)
    {
        if (days < 0) return "text-red-600 dark:text-red-400";
        if (days <= 14) return "text-red-600 dark:text-red-400";
        if (days <= 30) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }

    private record TypeConfigEntry(string Dot, string Label);
    private record StatusConfigEntry(string Label, string Color);
    private record DocumentItem(string Id, string Name, bool Ready);
    private record TaxDeadline(string Id, string Name, string Form, string Type, string DueDate, int DaysUntil, string Status, string Penalty, DocumentItem[] Documents, string Notes);

    private static readonly Dictionary<string, TypeConfigEntry> _typeConfig = new()
    {
        ["federal"]   = new("bg-blue-500",    "Federal"),
        ["state"]     = new("bg-violet-500",  "State"),
        ["quarterly"] = new("bg-amber-500",   "Quarterly"),
        ["payroll"]   = new("bg-emerald-500", "Payroll"),
    };

    private static readonly TypeConfigEntry[] _typeConfigOrdered =
    [
        new("bg-blue-500",    "Federal"),
        new("bg-violet-500",  "State"),
        new("bg-amber-500",   "Quarterly"),
        new("bg-emerald-500", "Payroll"),
    ];

    private static readonly Dictionary<string, StatusConfigEntry> _statusConfig = new()
    {
        ["filed"]        = new("Filed",       "text-emerald-600 dark:text-emerald-400"),
        ["in-progress"]  = new("In Progress", "text-blue-600 dark:text-blue-400"),
        ["not-started"]  = new("Not Started", "text-muted-foreground"),
        ["overdue"]      = new("Overdue",     "text-red-600 dark:text-red-400"),
    };

    private static readonly TaxDeadline[] _deadlines =
    [
        new("1", "Federal Income Tax Return", "Form 1040", "federal", "Apr 15, 2026", 22, "in-progress",
            "5% per month on unpaid tax, up to 25%",
            [
                new("d1",  "W-2 from employer",          true),
                new("d2",  "1099-INT bank interest",      true),
                new("d3",  "1099-DIV dividends",          true),
                new("d4",  "Mortgage interest (1098)",    false),
                new("d5",  "Charitable donation receipts", false),
            ],
            "Review itemized vs standard deduction. May benefit from itemizing due to mortgage interest."),
        new("2", "State Income Tax Return", "Form IT-201", "state", "Apr 15, 2026", 22, "not-started",
            "Varies by state, typically 5% per month",
            [
                new("d6",  "Federal return copy",    false),
                new("d7",  "State W-2 copies",       true),
                new("d8",  "Property tax records",   true),
            ],
            "File after federal return is complete. Check for state-specific credits."),
        new("3", "Q1 Estimated Tax Payment", "Form 1040-ES", "quarterly", "Apr 15, 2026", 22, "not-started",
            "Underpayment penalty if total payments < 90% of current year tax",
            [
                new("d9",  "Prior year tax return",          true),
                new("d10", "Estimated income calculation",   false),
            ],
            "Based on freelance income projections. Consider increasing payment to avoid underpayment penalty."),
        new("4", "Quarterly Payroll Tax", "Form 941", "payroll", "Apr 30, 2026", 37, "not-started",
            "2-15% of unpaid tax depending on days late",
            [
                new("d11", "Q1 payroll records",               false),
                new("d12", "Employee withholding summaries",   false),
            ],
            "Q1 employer payroll taxes. Include Social Security and Medicare withholding."),
        new("5", "Q4 Estimated Tax (Prior Year)", "Form 1040-ES", "quarterly", "Jan 15, 2026", -68, "filed",
            "N/A — Filed on time",
            [new("d13", "Payment confirmation", true)],
            "Paid $4,200 via IRS Direct Pay on Jan 12. Confirmation #DP-2026-0412."),
    ];
}
