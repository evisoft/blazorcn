@* ============================================================
   Block: calendar-fiscal-quarters
   Title: Calendar Fiscal Quarters
   Description: A React fiscal quarter overview calendar block for Next.js with revenue targets, quarterly deadlines, milestone tracking, and progress indicators built with shadcn/ui and Tailwind CSS
   Long Description: React Exam Schedule Calendar Block
   Dependencies: BadgeCn, ProgressCn
   Source: original/blocks/calendar/calendar-fiscal-quarters.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTrendingUpCn Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Fiscal Year 2026</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @FormatRevenue(_totalActual) / @FormatRevenue(_totalTarget)
            </span>
        </div>

        @* Annual summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@FormatRevenue(_totalActual)</span>
                <span class="text-muted-foreground text-xs">YTD revenue</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @((int)Math.Round((double)_totalActual / _totalTarget * 100))% of annual target
            </span>
        </div>

        @* Quarters *@
        <div>
            @for (int i = 0; i < _quarters.Length; i++)
            {
                var quarter = _quarters[i];
                var isExpanded = _expanded == quarter.Id;
                var isLast = i == _quarters.Length - 1;
                var completedMilestones = quarter.Milestones.Count(m => m.Completed);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == quarter.Id ? null : quarter.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {GetStatusDot(quarter.Status)}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@quarter.Name</span>
                                @if (quarter.Status == "current")
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Current</BadgeCn>
                                }
                            </div>
                            <span class="mt-0.5 text-muted-foreground text-xs">@quarter.Period</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <span class="font-medium text-sm tabular-nums">@FormatRevenue(quarter.RevenueTarget)</span>
                                <p class="text-muted-foreground text-xs">target</p>
                            </div>
                            <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="flex flex-col gap-3">
                                @if (quarter.Status == "current")
                                {
                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">
                                                @FormatRevenue(quarter.RevenueActual) of @FormatRevenue(quarter.RevenueTarget)
                                            </span>
                                            <span class="font-medium tabular-nums">@(quarter.Progress)%</span>
                                        </div>
                                        <ProgressCn Value="@quarter.Progress" Class="h-1.5" />
                                    </div>
                                }

                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <span class="font-medium text-muted-foreground text-xs">Milestones</span>
                                        <span class="text-muted-foreground text-xs tabular-nums">@completedMilestones/@quarter.Milestones.Length</span>
                                    </div>
                                    <div class="flex flex-col gap-2">
                                        @foreach (var milestone in quarter.Milestones)
                                        {
                                            <div class="flex items-center gap-2 text-sm">
                                                <span class="@($"size-1.5 shrink-0 rounded-full {(milestone.Completed ? "bg-emerald-500" : "bg-muted-foreground/30")}")" />
                                                <span class="@(milestone.Completed ? "text-muted-foreground line-through" : "")">
                                                    @milestone.Title
                                                </span>
                                                <span class="ml-auto flex shrink-0 items-center gap-1 text-muted-foreground text-xs">
                                                    <LucideCalendarCn Class="size-3" />
                                                    @milestone.Date
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "q1";

    private record Milestone(string Id, string Title, string Date, bool Completed);
    private record Quarter(string Id, string Name, string Period, string Status, int RevenueTarget, int RevenueActual, int Progress, Milestone[] Milestones);

    private static readonly Quarter[] _quarters =
    [
        new("q1", "Q1 FY2026", "Jan \u2014 Mar 2026", "current", 2400000, 1980000, 82, [
            new("m1", "Annual budget approval", "Jan 15", true),
            new("m2", "Q1 sales kickoff", "Jan 22", true),
            new("m3", "Product launch v3.2", "Feb 28", true),
            new("m4", "Q1 board review", "Mar 25", false),
            new("m5", "Quarter close", "Mar 31", false),
        ]),
        new("q2", "Q2 FY2026", "Apr \u2014 Jun 2026", "upcoming", 2800000, 0, 0, [
            new("m6", "Enterprise pricing update", "Apr 10", false),
            new("m7", "Partner summit", "May 5", false),
            new("m8", "Mid-year strategy review", "May 30", false),
            new("m9", "Q2 board review", "Jun 25", false),
            new("m10", "Quarter close", "Jun 30", false),
        ]),
        new("q3", "Q3 FY2026", "Jul \u2014 Sep 2026", "upcoming", 3100000, 0, 0, [
            new("m11", "Annual conference", "Jul 15", false),
            new("m12", "Product launch v4.0", "Aug 20", false),
            new("m13", "Q3 board review", "Sep 25", false),
            new("m14", "Quarter close", "Sep 30", false),
        ]),
        new("q4", "Q4 FY2026", "Oct \u2014 Dec 2026", "upcoming", 3500000, 0, 0, [
            new("m15", "FY2027 planning kickoff", "Oct 10", false),
            new("m16", "Black Friday campaign", "Nov 28", false),
            new("m17", "Annual review", "Dec 15", false),
            new("m18", "Year-end close", "Dec 31", false),
        ]),
    ];

    private static readonly int _totalTarget = _quarters.Sum(q => q.RevenueTarget);
    private static readonly int _totalActual = _quarters.Sum(q => q.RevenueActual);

    private static string FormatRevenue(int amount)
    {
        if (amount >= 1_000_000) return $"${amount / 1_000_000.0:F1}M";
        if (amount >= 1_000) return $"${amount / 1_000}K";
        return $"${amount}";
    }

    private static string GetStatusDot(string status) => status switch
    {
        "completed" => "bg-emerald-500",
        "current" => "bg-blue-500",
        _ => "bg-muted-foreground/30"
    };
}
