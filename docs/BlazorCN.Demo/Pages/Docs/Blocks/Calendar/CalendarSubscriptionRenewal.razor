@* ============================================================
   Block: calendar-subscription-renewal
   Title: Calendar Subscription Renewal
   Description: A React subscription renewal calendar block for Next.js showing service names, monthly costs, renewal dates, and billing cycle management built with shadcn/ui and Tailwind CSS
   Long Description: React Sprint Timeline Calendar Block
   Dependencies: BadgeCn
   Source: original/blocks/calendar/calendar-subscription-renewal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideRefreshCcwCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Subscription Renewals</span>
            </div>
            <span class="text-muted-foreground text-xs">@_subscriptions.Length active</span>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">
                    @FormatCurrency(_totalMonthly)
                </span>
                <span class="text-muted-foreground text-xs">/mo</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                Next: @_soonest.Name in @(_soonest.DaysUntilRenewal)d
            </span>
        </div>

        @* Subscription list *@
        <div>
            @for (var i = 0; i < _subscriptions.Length; i++)
            {
                var index = i;
                var sub = _subscriptions[index];
                var isExpanded = _expanded == sub.Id;
                var isLast = index == _subscriptions.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? "" : sub.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50 font-medium text-muted-foreground text-xs">
                            @sub.Icon
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@sub.Name</span>
                                <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[sub.Status])"></span>
                            </div>
                            <span class="mt-0.5 text-muted-foreground text-xs">
                                Renews @sub.NextRenewal
                            </span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <span class="font-medium text-sm tabular-nums">
                                    @FormatCurrency(sub.Cost)
                                </span>
                                <span class="text-muted-foreground text-xs">
                                    /@(sub.Cycle == "monthly" ? "mo" : "yr")
                                </span>
                            </div>
                            <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-14">
                            <div class="flex flex-col gap-2">
                                <div class="flex items-center gap-3 text-muted-foreground text-xs">
                                    <span>@sub.Category</span>
                                    <span>·</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                        @_statusLabel[sub.Status]
                                    </BadgeCn>
                                    <span>·</span>
                                    <span>
                                        @if (sub.Cycle == "yearly")
                                        {
                                            @($"{FormatCurrency(MonthlyCost(sub))}/mo equivalent")
                                        }
                                        else
                                        {
                                            @($"{FormatCurrency(sub.Cost * 12)}/yr if annual")
                                        }
                                    </span>
                                </div>
                                @if (sub.Status == "expiring")
                                {
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <span class="font-medium text-muted-foreground text-xs">
                                            Renewal reminder
                                        </span>
                                        <p class="mt-1 text-sm">
                                            This subscription expires in @sub.DaysUntilRenewal days. Review your plan before auto-renewal.
                                        </p>
                                    </div>
                                }
                                @if (sub.Status == "trial")
                                {
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <span class="font-medium text-muted-foreground text-xs">
                                            Trial ending
                                        </span>
                                        <p class="mt-1 text-sm">
                                            Free trial ends in @sub.DaysUntilRenewal days. You will be charged @FormatCurrency(sub.Cost)/@(sub.Cycle == "monthly" ? "mo" : "yr") after.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SubscriptionInfo(string Id, string Name, string Category, decimal Cost, string Cycle, string NextRenewal, string Status, string Icon, int DaysUntilRenewal);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["trial"] = "bg-blue-500",
        ["expiring"] = "bg-amber-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["active"] = "Active",
        ["trial"] = "Trial",
        ["expiring"] = "Expiring",
    };

    private static readonly SubscriptionInfo[] _subscriptions =
    [
        new("1", "Figma", "Design", 15m, "monthly", "Mar 22, 2026", "active", "F", 4),
        new("2", "GitHub Copilot", "Developer", 19m, "monthly", "Mar 25, 2026", "active", "G", 7),
        new("3", "Notion", "Productivity", 96m, "yearly", "Apr 3, 2026", "active", "N", 16),
        new("4", "Linear", "Developer", 10m, "monthly", "Apr 8, 2026", "active", "L", 21),
        new("5", "Vercel Pro", "Hosting", 20m, "monthly", "Apr 12, 2026", "active", "V", 25),
        new("6", "Adobe Creative Cloud", "Design", 659.88m, "yearly", "Mar 20, 2026", "expiring", "A", 2),
        new("7", "Grammarly", "Productivity", 12m, "monthly", "Mar 30, 2026", "trial", "Gr", 12),
        new("8", "Spotify Premium", "Entertainment", 10.99m, "monthly", "Apr 1, 2026", "active", "S", 14),
    ];

    private static decimal MonthlyCost(SubscriptionInfo sub) => sub.Cycle == "yearly" ? sub.Cost / 12 : sub.Cost;
    private static string FormatCurrency(decimal amount) => $"${amount:F2}";

    private decimal _totalMonthly => _subscriptions.Sum(s => MonthlyCost(s));
    private SubscriptionInfo _soonest => _subscriptions.OrderBy(s => s.DaysUntilRenewal).First();

    private string _expanded = "6";
}
