@* ============================================================
   Block: calendar-interview-scheduler
   Title: Calendar Interview Scheduler
   Description: React interview scheduling calendar block for Next.js with candidate info, interviewer assignments, round types, room details, and status tracking using shadcn/ui and Tailwind CSS
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-interview-scheduler.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Interview Schedule</h2>
                <p class="text-muted-foreground text-xs">@_totalInterviews interviews this week</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                    <LucideChevronLeftCn Size="14" class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                    <LucideChevronRightCn Size="14" class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Day tabs *@
        <div class="flex border-b">
            @foreach (var day in _schedule)
            {
                <button
                    type="button"
                    @onclick="@(() => _selectedDay = day.Date)"
                    class="@Cn.Merge("flex flex-1 flex-col items-center gap-0.5 px-3 py-2.5 transition-colors hover:bg-muted/50", _selectedDay == day.Date ? "border-b-2 border-foreground bg-muted/30" : "")">
                    <span class="text-muted-foreground text-xs">@day.Day</span>
                    <span class="@Cn.Merge("font-medium text-sm tabular-nums", _selectedDay == day.Date ? "text-foreground" : "text-muted-foreground")">
                        @day.Date.Split(" ")[1]
                    </span>
                    <span class="text-muted-foreground text-xs tabular-nums">@day.Interviews.Length</span>
                </button>
            }
        </div>

        @* Interviews *@
        <div>
            @if (_dayData is not null)
            {
                @for (var i = 0; i < _dayData.Interviews.Length; i++)
                {
                    var idx = i;
                    var interview = _dayData.Interviews[idx];
                    var isExpanded = _expandedId == interview.Id;
                    var isLast = idx == _dayData.Interviews.Length - 1;

                    <div class="@(isLast ? "" : "border-b")">
                        <button
                            type="button"
                            @onclick="@(() => _expandedId = isExpanded ? null : interview.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <AvatarCn>
                                <AvatarFallbackCn class="text-xs">@interview.CandidateInitials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@interview.CandidateName</span>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@interview.Time</span>
                                    <span>·</span>
                                    <span>@_roundLabels[interview.Round]</span>
                                </div>
                            </div>
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _statusDot[interview.Status])"></span>
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3 pl-12">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="space-y-2 text-sm">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Role</span>
                                            <span class="text-xs">@interview.Role</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Interviewer</span>
                                            <span class="text-xs">@interview.Interviewer</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Duration</span>
                                            <span class="flex items-center gap-1 text-xs">
                                                <LucideClockCn Size="12" class="size-3" />
                                                @interview.Duration
                                            </span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Location</span>
                                            <span class="flex items-center gap-1 text-xs">
                                                @if (interview.IsRemote)
                                                {
                                                    <LucideVideoCn Size="12" class="size-3" />
                                                }
                                                else
                                                {
                                                    <LucideMapPinCn Size="12" class="size-3" />
                                                }
                                                @interview.Room
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-3 flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                            @_roundLabels[interview.Round]
                                        </BadgeCn>
                                        <BadgeCn
                                            Variant="BadgeVariant.Secondary"
                                            class="@Cn.Merge("font-normal text-xs", interview.Status == "confirmed" ? "text-emerald-700 dark:text-emerald-400" : interview.Status == "pending" ? "text-amber-700 dark:text-amber-400" : "")">
                                            @(interview.Status == "confirmed" ? "Confirmed" : interview.Status == "pending" ? "Pending" : "Completed")
                                        </BadgeCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record Interview(string Id, string CandidateName, string CandidateInitials, string Role, string Interviewer, string Round, string Time, string Duration, string Room, bool IsRemote, string Status);
    private record DaySchedule(string Day, string Date, Interview[] Interviews);

    private static readonly Dictionary<string, string> _roundLabels = new()
    {
        ["phone-screen"] = "Phone Screen", ["technical"] = "Technical",
        ["system-design"] = "System Design", ["behavioral"] = "Behavioral", ["final"] = "Final Round",
    };

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["confirmed"] = "bg-emerald-500", ["pending"] = "bg-amber-500", ["completed"] = "bg-zinc-400",
    };

    private static readonly DaySchedule[] _schedule =
    [
        new("Tue", "Mar 17", [
            new("1", "Elena Vasquez", "EV", "Senior Frontend Engineer", "David Kim", "technical", "9:00 AM", "60 min", "Room 3A", false, "completed"),
            new("2", "Marcus Johnson", "MJ", "Product Designer", "Sarah Chen", "behavioral", "11:00 AM", "45 min", "Zoom", true, "completed"),
            new("3", "Aisha Patel", "AP", "Backend Engineer", "Tom Wright", "system-design", "2:00 PM", "90 min", "Room 5B", false, "completed"),
        ]),
        new("Wed", "Mar 18", [
            new("4", "Lucas Hernandez", "LH", "Engineering Manager", "Priya Gupta", "final", "10:00 AM", "60 min", "Room 2A", false, "confirmed"),
            new("5", "Sophie Moreau", "SM", "Data Scientist", "David Kim", "technical", "1:00 PM", "60 min", "Zoom", true, "confirmed"),
            new("6", "Ravi Krishnan", "RK", "DevOps Engineer", "Tom Wright", "phone-screen", "3:30 PM", "30 min", "Zoom", true, "pending"),
        ]),
        new("Thu", "Mar 19", [
            new("7", "Clara Johansson", "CJ", "Senior Frontend Engineer", "Sarah Chen", "technical", "9:30 AM", "60 min", "Room 3A", false, "confirmed"),
            new("8", "Omar Al-Rashid", "OA", "Product Manager", "Priya Gupta", "behavioral", "2:00 PM", "45 min", "Room 2A", false, "pending"),
        ]),
    ];

    private int _totalInterviews => _schedule.Sum(d => d.Interviews.Length);
    private string _selectedDay = "Mar 18";
    private string? _expandedId = "4";

    private DaySchedule? _dayData => _schedule.FirstOrDefault(d => d.Date == _selectedDay);
}
