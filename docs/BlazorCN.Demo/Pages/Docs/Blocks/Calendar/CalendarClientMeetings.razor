@* ============================================================
   Block: calendar-client-meetings
   Title: CalendarClientMeetings
   Description: A client meeting schedule block for Next.js with meeting types, client details, preparation notes, and timeline view using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-client-meetings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Client Meetings</h2>
                <p class="text-muted-foreground text-xs">Wednesday, Mar 18, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideBriefcaseCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_meetings.Length</span>
                <span class="text-muted-foreground text-xs">meetings</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideVideoCn Size="14" class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">@_virtualCount</span>
                virtual
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideMapPinCn Size="14" class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">@_inPersonCount</span>
                in-person
            </div>
        </div>

        <div>
            @for (var i = 0; i < _meetings.Length; i++)
            {
                var index = i;
                var meeting = _meetings[index];
                var isExpanded = _expandedMeeting == meeting.Id;
                var config = _typeConfig[meeting.Type];
                <div class="@(index < _meetings.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedMeeting = isExpanded ? "" : meeting.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@meeting.Client</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                    @config.Label
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@meeting.Company</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideClockCn Size="12" class="size-3" />
                                    @meeting.Time
                                </span>
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3">
                            <div class="space-y-2">
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideUserCn Size="12" class="size-3 text-muted-foreground" />
                                    <span class="text-muted-foreground">Client:</span>
                                    <span>@meeting.Client, @meeting.Company</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideClockCn Size="12" class="size-3 text-muted-foreground" />
                                    <span class="text-muted-foreground">Duration:</span>
                                    <span>@meeting.Duration</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideMapPinCn Size="12" class="size-3 text-muted-foreground" />
                                    <span class="text-muted-foreground">Location:</span>
                                    <span>@meeting.Location</span>
                                </div>
                                <div class="mt-2 rounded-md bg-muted/50 p-2.5">
                                    <span class="font-medium text-muted-foreground text-xs">Agenda</span>
                                    <p class="mt-1 text-sm">@meeting.Agenda</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ClientMeeting(string Id, string Client, string Company, string Type, string Time, string Duration, string Location, bool IsVirtual, string Agenda);
    private record TypeConfig(string Label, string Dot);

    private static readonly ClientMeeting[] _meetings =
    [
        new("1", "Rachel Foster", "Acme Corp", "discovery", "9:00 AM", "45 min", "Zoom", true, "Understand current tech stack and pain points"),
        new("2", "Tom Bradley", "Nexus Labs", "proposal", "10:30 AM", "1 hr", "Board Room B", false, "Present Phase 2 proposal and timeline"),
        new("3", "Mia Cheng", "Bright Health", "review", "1:00 PM", "30 min", "Google Meet", true, "Q1 deliverables review and feedback"),
        new("4", "Liam O'Connor", "Vertex AI", "kickoff", "2:30 PM", "1 hr", "Conference Room A", false, "Project kickoff and team introductions"),
        new("5", "Nina Patel", "DataFlow", "follow-up", "4:00 PM", "30 min", "Microsoft Teams", true, "Follow up on contract terms and next steps"),
    ];

    private static readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["discovery"] = new("Discovery", "bg-blue-500"),
        ["proposal"] = new("Proposal", "bg-amber-500"),
        ["review"] = new("Review", "bg-emerald-500"),
        ["kickoff"] = new("Kickoff", "bg-purple-500"),
        ["follow-up"] = new("Follow-up", "bg-rose-500"),
    };

    private int _virtualCount => _meetings.Count(m => m.IsVirtual);
    private int _inPersonCount => _meetings.Length - _virtualCount;
    private string _expandedMeeting = "2";
}
