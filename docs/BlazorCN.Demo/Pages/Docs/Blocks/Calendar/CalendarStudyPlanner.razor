@* ============================================================
   Block: calendar-study-planner
   Title: CalendarStudyPlanner
   Description: A study session planner calendar block for Next.js with subject scheduling, study hour tracking, exam countdowns, and progress monitoring using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-study-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGraduationCapCn Size="16" class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Study Planner</span>
                    <p class="text-muted-foreground text-xs">
                        @CompletedToday/@TodaySessions.Count sessions today · @(TotalHoursToday.ToString("G"))h planned
                    </p>
                </div>
            </div>
        </div>

        @* Exam countdowns *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-muted-foreground text-xs">Upcoming exams</span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var exam in _exams)
                {
                    var examConfig = _subjectConfig[exam.Subject];
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", examConfig.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate text-xs font-medium">@exam.Name</span>
                            <span class="text-muted-foreground text-[10px]">@exam.Date</span>
                        </div>
                        <span class="@Cn.Merge("shrink-0 text-[10px] font-medium tabular-nums", exam.DaysUntil <= 14 ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                            @(exam.DaysUntil)d
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Today's sessions *@
        <div>
            <div class="bg-muted/30 px-4 py-1.5">
                <span class="text-muted-foreground text-xs">Today</span>
            </div>
            @foreach (var session in TodaySessions)
            {
                var sess = session;
                var sessConfig = _subjectConfig[sess.Subject];
                <div class="border-b">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <button type="button" aria-label="@(sess.Completed ? $"Mark {sess.Topic} incomplete" : $"Mark {sess.Topic} complete")" @onclick="@(() => ToggleSession(sess.Id))" class="shrink-0">
                            @if (sess.Completed)
                            {
                                <LucideCircleCheckBigCn Size="16" class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideCircleCn Size="16" class="size-4 text-muted-foreground/40" />
                            }
                        </button>
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", sessConfig.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", sess.Completed ? "text-muted-foreground line-through" : "")">
                                    @sess.Topic
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-[10px]">
                                    @sessConfig.Label
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">@sess.Notes</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="flex items-center gap-1 font-mono text-muted-foreground text-xs tabular-nums">
                                <LucideClockCn Size="12" class="size-3" />
                                @sess.Time
                            </span>
                            <span class="text-muted-foreground text-[10px]">@sess.Duration</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Tomorrow's sessions *@
        <div>
            <div class="bg-muted/30 px-4 py-1.5">
                <span class="text-muted-foreground text-xs">Tomorrow</span>
            </div>
            @for (var ti = 0; ti < TomorrowSessions.Count; ti++)
            {
                var tidx = ti;
                var session = TomorrowSessions[tidx];
                var sessConfig = _subjectConfig[session.Subject];
                var isLast = tidx == TomorrowSessions.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", sessConfig.Dot)"></span>
                        <LucideBookOpenCn Size="14" class="size-3.5 shrink-0 text-muted-foreground/40" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@session.Topic</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @sessConfig.Label · @session.Duration
                            </p>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @session.Time
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Subject legend *@
        <div class="flex flex-wrap items-center gap-3 border-t bg-muted/20 px-4 py-2">
            @foreach (var kvp in _subjectConfig)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", kvp.Value.Dot)"></span>
                    @kvp.Value.Label
                </span>
            }
        </div>

    </div>
</section>

@code {
    private record SubjectConfig(string Dot, string Label);
    private record StudySession(string Id, string Subject, string Topic, string Time, string Duration, string Day, bool Completed, string Notes);
    private record ExamCountdown(string Subject, string Name, string Date, int DaysUntil);

    private static readonly Dictionary<string, SubjectConfig> _subjectConfig = new()
    {
        ["math"]      = new("bg-blue-500",    "Mathematics"),
        ["physics"]   = new("bg-violet-500",  "Physics"),
        ["chemistry"] = new("bg-emerald-500", "Chemistry"),
        ["english"]   = new("bg-amber-500",   "English"),
        ["history"]   = new("bg-red-500",     "History"),
    };

    private static readonly ExamCountdown[] _exams =
    [
        new("math",      "Calculus II Final",      "Apr 14", 21),
        new("physics",   "Mechanics Exam",         "Apr 16", 23),
        new("chemistry", "Organic Chem Midterm",   "Apr 10", 17),
        new("english",   "Essay Submission",       "Apr 7",  14),
    ];

    private List<StudySession> _sessions =
    [
        new("1", "math",      "Integration by Parts",          "9:00 AM",  "2h",   "Today",    true,  "Chapter 7 problems 1-20. Focus on trig substitutions."),
        new("2", "chemistry", "Reaction Mechanisms",           "11:30 AM", "1.5h", "Today",    true,  "SN1 vs SN2 reactions. Draw mechanisms for each problem."),
        new("3", "physics",   "Rotational Dynamics",           "2:00 PM",  "2h",   "Today",    false, "Moments of inertia, angular momentum. Textbook pages 245-280."),
        new("4", "english",   "Essay Outline: Modernism",      "4:30 PM",  "1h",   "Today",    false, "Draft thesis statement and outline. Research 3 primary sources."),
        new("5", "math",      "Series and Sequences",          "9:00 AM",  "2h",   "Tomorrow", false, "Taylor series, convergence tests. Practice problems set 8."),
        new("6", "history",   "World War II: Pacific Theater", "11:00 AM", "1.5h", "Tomorrow", false, "Key battles, turning points. Prepare timeline for discussion."),
        new("7", "physics",   "Thermodynamics Review",         "2:00 PM",  "2h",   "Tomorrow", false, "Laws of thermodynamics, entropy calculations. Past exam questions."),
        new("8", "chemistry", "Spectroscopy Practice",         "4:30 PM",  "1.5h", "Tomorrow", false, "NMR and IR spectrum analysis. Practice identifying unknowns."),
    ];

    private List<StudySession> TodaySessions    => _sessions.Where(s => s.Day == "Today").ToList();
    private List<StudySession> TomorrowSessions => _sessions.Where(s => s.Day == "Tomorrow").ToList();
    private int    CompletedToday   => TodaySessions.Count(s => s.Completed);
    private double TotalHoursToday  => TodaySessions.Sum(s => ParseDuration(s.Duration));

    private static double ParseDuration(string duration)
    {
        var trimmed = duration.TrimEnd('h');
        return double.TryParse(trimmed, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var h) ? h : 0.0;
    }

    private void ToggleSession(string id)
    {
        var idx = _sessions.FindIndex(s => s.Id == id);
        if (idx >= 0)
            _sessions[idx] = _sessions[idx] with { Completed = !_sessions[idx].Completed };
    }
}
