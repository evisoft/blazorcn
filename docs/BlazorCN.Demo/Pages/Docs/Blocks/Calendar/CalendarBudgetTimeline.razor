@* ============================================================
   Block: calendar-budget-timeline
   Title: CalendarBudgetTimeline
   Description: A budget allocation timeline block for Next.js with monthly spend tracking, category breakdowns, and progress bars using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-budget-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Budget Timeline</h2>
                <p class="text-muted-foreground text-xs">Q1 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideDollarSignCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">
                    @($"${_totalAllocated / 1000}k")
                </span>
                <span class="text-muted-foreground text-xs">total budget</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideTrendingDownCn Size="14" class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">
                    @($"${(_totalAllocated - _totalSpent) / 1000.0:F1}k")
                </span>
                remaining
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideTrendingUpCn Size="14" class="size-3.5" />
                <span class="font-medium text-foreground tabular-nums">
                    @((int)Math.Round((double)_totalSpent / _totalAllocated * 100))%
                </span>
                utilized
            </div>
        </div>

        <div>
            @for (var mIndex = 0; mIndex < _months.Length; mIndex++)
            {
                var month = _months[mIndex];
                var isExpanded = _expandedMonth == month.Month;
                var monthSpent = month.Categories.Sum(c => c.Spent);
                var utilization = (int)Math.Round((double)monthSpent / month.TotalBudget * 100);
                var isOver = monthSpent > month.TotalBudget;
                var isLastMonth = mIndex == _months.Length - 1;

                <div class="@(isLastMonth ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedMonth = isExpanded ? "" : month.Month)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@month.Month @month.Year</span>
                                @if (isOver)
                                {
                                    <span class="text-red-600 text-xs">Over budget</span>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <ProgressCn Value="@Math.Min(utilization, 100)" class="h-1 w-24" aria-label="Progress" />
                                <span class="text-muted-foreground text-xs tabular-nums">@utilization%</span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-0.5">
                            <span class="font-medium text-sm tabular-nums">
                                @($"${monthSpent / 1000.0:F1}k")
                            </span>
                            <span class="text-muted-foreground text-xs tabular-nums">
                                of @($"${month.TotalBudget / 1000}k")
                            </span>
                        </div>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-2">
                            @for (var cIndex = 0; cIndex < month.Categories.Length; cIndex++)
                            {
                                var cat = month.Categories[cIndex];
                                var pct = (int)Math.Round((double)cat.Spent / cat.Allocated * 100);
                                var isLastCat = cIndex == month.Categories.Length - 1;
                                <div class="@Cn.Merge("flex items-center gap-3 py-2", isLastCat ? "" : "border-b border-border/50")">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", cat.Color)"></span>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm">@cat.Name</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <ProgressCn Value="@Math.Min(pct, 100)" class="h-1 w-16" aria-label="Progress" />
                                        <span class="@Cn.Merge("text-xs tabular-nums", pct > 100 ? "text-red-600" : "text-muted-foreground")">
                                            @($"${cat.Spent / 1000.0:F1}k")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BudgetCategory(string Id, string Name, int Allocated, int Spent, string Color);
    private record MonthBudget(string Month, string Year, int TotalBudget, BudgetCategory[] Categories);

    private static readonly MonthBudget[] _months =
    [
        new("January", "2026", 50000,
        [
            new("1", "Engineering", 20000, 18500, "bg-blue-500"),
            new("2", "Marketing", 15000, 14200, "bg-amber-500"),
            new("3", "Operations", 10000, 9800, "bg-emerald-500"),
            new("4", "Infrastructure", 5000, 4100, "bg-purple-500"),
        ]),
        new("February", "2026", 50000,
        [
            new("5", "Engineering", 20000, 21200, "bg-blue-500"),
            new("6", "Marketing", 15000, 12800, "bg-amber-500"),
            new("7", "Operations", 10000, 10400, "bg-emerald-500"),
            new("8", "Infrastructure", 5000, 5900, "bg-purple-500"),
        ]),
        new("March", "2026", 55000,
        [
            new("9", "Engineering", 22000, 11400, "bg-blue-500"),
            new("10", "Marketing", 16000, 8200, "bg-amber-500"),
            new("11", "Operations", 11000, 5600, "bg-emerald-500"),
            new("12", "Infrastructure", 6000, 3100, "bg-purple-500"),
        ]),
    ];

    private static readonly int _totalAllocated = _months.Sum(m => m.TotalBudget);
    private static readonly int _totalSpent = _months.Sum(m => m.Categories.Sum(c => c.Spent));

    private string _expandedMonth = "March";
}
