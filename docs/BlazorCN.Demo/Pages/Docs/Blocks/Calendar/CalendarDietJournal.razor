@* ============================================================
   Block: calendar-diet-journal
   Title: CalendarDietJournal
   Description: A diet and nutrition tracking calendar block for Next.js with macro breakdowns, meal logging, and daily nutrition scores using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-diet-journal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Diet Journal</h2>
                <p class="text-muted-foreground text-xs">Week of Mar 17, 2026</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideTargetCn Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_avgScore</span>
                <span class="text-muted-foreground text-xs">avg score</span>
            </div>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideFlameCn Class="size-3.5" />
                <span class="font-semibold text-foreground text-sm tabular-nums">@_avgCalories</span>
                avg kcal/day
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">Target: 2,100 kcal</span>
        </div>

        <div class="grid grid-cols-3 border-b">
            @foreach (var dayItem in _weekLog)
            {
                var day = dayItem;
                var pct = (int)Math.Round((double)day.Calories / day.Target * 100);
                var isSelected = _selectedDay == day.Date;
                <button type="button"
                        @onclick="@(() => _selectedDay = day.Date)"
                        class="@($"flex flex-col items-center gap-1 py-3 transition-colors hover:bg-muted/50 {(isSelected ? "bg-muted/50" : "")}")">
                    <span class="text-muted-foreground text-xs">@day.Day, @day.Date</span>
                    <span class="font-semibold text-lg tabular-nums">@day.Score</span>
                    <div class="flex items-center gap-1">
                        <ProgressCn Value="@Math.Min(pct, 100)" Class="h-1 w-12" />
                        <span class="@($"text-xs tabular-nums {(pct > 105 ? "text-red-600" : "text-muted-foreground")}")">@day.Calories</span>
                    </div>
                </button>
            }
        </div>

        @if (_selected != null)
        {
            var sel = _selected;
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Macros</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@sel.Calories kcal total</span>
                </div>
                <div class="mt-2 grid grid-cols-4 gap-3">
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-blue-500" />
                        <div>
                            <span class="font-medium text-xs tabular-nums">@sel.Macros.Protein g</span>
                            <span class="ml-1 text-muted-foreground text-xs">Protein</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-amber-500" />
                        <div>
                            <span class="font-medium text-xs tabular-nums">@sel.Macros.Carbs g</span>
                            <span class="ml-1 text-muted-foreground text-xs">Carbs</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-rose-500" />
                        <div>
                            <span class="font-medium text-xs tabular-nums">@sel.Macros.Fat g</span>
                            <span class="ml-1 text-muted-foreground text-xs">Fat</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500" />
                        <div>
                            <span class="font-medium text-xs tabular-nums">@sel.Macros.Fiber g</span>
                            <span class="ml-1 text-muted-foreground text-xs">Fiber</span>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="border-b px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Meals</span>
                </div>
                @for (int mi = 0; mi < sel.Meals.Length; mi++)
                {
                    var meal = sel.Meals[mi];
                    var isLast = mi == sel.Meals.Length - 1;
                    <div class="@($"flex items-center gap-3 px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                        <LucideAppleCn Class="size-3.5 text-muted-foreground" />
                        <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@meal.Time</span>
                        <span class="min-w-0 flex-1 text-sm">@meal.Name</span>
                        <span class="text-muted-foreground text-xs tabular-nums">@meal.Calories kcal</span>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string _selectedDay = "Mar 18";

    private DayLog? _selected => System.Array.Find(_weekLog, d => d.Date == _selectedDay);
    private int _avgCalories => (int)Math.Round(_weekLog.Average(d => (double)d.Calories));
    private int _avgScore => (int)Math.Round(_weekLog.Average(d => (double)d.Score));

    private record MacroData(int Protein, int Carbs, int Fat, int Fiber);
    private record Meal(string Name, string Time, int Calories);
    private record DayLog(string Date, string Day, int Calories, int Target, MacroData Macros, int Score, Meal[] Meals);

    private static readonly DayLog[] _weekLog =
    [
        new("Mar 17", "Mon", 1980, 2100,
            new(140, 210, 65, 28), 88,
            [
                new("Greek Yogurt Bowl", "7:30 AM", 340),
                new("Chicken Caesar Wrap", "12:15 PM", 520),
                new("Protein Shake", "3:00 PM", 280),
                new("Grilled Salmon & Veggies", "7:00 PM", 620),
                new("Dark Chocolate", "8:30 PM", 220),
            ]),
        new("Mar 18", "Tue", 2240, 2100,
            new(125, 250, 78, 22), 72,
            [
                new("Oatmeal with Banana", "8:00 AM", 380),
                new("Sushi Bento Box", "12:30 PM", 640),
                new("Trail Mix", "3:30 PM", 320),
                new("Pasta Bolognese", "7:30 PM", 680),
                new("Ice Cream", "9:00 PM", 220),
            ]),
        new("Mar 19", "Wed", 1850, 2100,
            new(155, 180, 58, 32), 92,
            [
                new("Scrambled Eggs & Toast", "7:00 AM", 420),
                new("Quinoa Salad", "12:00 PM", 460),
                new("Turkey & Avocado Wrap", "6:30 PM", 580),
                new("Berries & Cottage Cheese", "8:00 PM", 190),
            ]),
    ];
}
