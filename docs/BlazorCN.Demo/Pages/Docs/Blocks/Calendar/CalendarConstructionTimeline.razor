@* ============================================================
   Block: calendar-construction-timeline
   Title: CalendarConstructionTimeline
   Description: A construction project timeline block for Next.js with phase tracking, contractor assignments, and Gantt-style progress bars using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-construction-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Construction Timeline</h2>
                <p class="text-muted-foreground text-xs">Riverside Office Complex</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideHardHatCn Size="14" class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@_overallProgress%</span>
                <span class="text-muted-foreground text-xs">complete</span>
            </div>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            @foreach (var sc in _statusConfigs)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", sc.Dot)"></span>
                    @sc.Label
                </span>
            }
        </div>

        <div>
            @for (var i = 0; i < _phases.Length; i++)
            {
                var phase = _phases[i];
                var isLast = i == _phases.Length - 1;
                var isExpanded = _expandedPhase == phase.Id;
                var config = _statusConfigMap[phase.Status];

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedPhase = (_expandedPhase == phase.Id ? "" : phase.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@phase.Name</span>
                            <div class="mt-1 flex items-center gap-2">
                                <ProgressCn Value="@phase.Progress" class="h-1 w-20" />
                                <span class="text-muted-foreground text-xs tabular-nums">@phase.Progress%</span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-0.5">
                            <span class="text-muted-foreground text-xs tabular-nums">@phase.StartDate - @phase.EndDate</span>
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideUserCn Size="12" class="size-3" />
                                @phase.Contractor
                            </span>
                        </div>
                        <LucideChevronRightCn Size="16" class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-2 pl-9">
                            @for (var t = 0; t < phase.Tasks.Length; t++)
                            {
                                var task = phase.Tasks[t];
                                var tIndex = t;
                                var isLastTask = tIndex == phase.Tasks.Length - 1;
                                var dotClass = GetTaskDotClass(phase, tIndex);
                                <div class="@Cn.Merge("flex items-center gap-2 py-1.5", isLastTask ? "" : "border-b border-border/50")">
                                    <span class="@Cn.Merge("size-1 rounded-full", dotClass)"></span>
                                    <span class="text-sm">@task</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PhaseInfo(string Id, string Name, string Contractor, string StartDate, string EndDate, int Progress, string Status, string[] Tasks);
    private record StatusConfigItem(string Label, string Dot);

    private string _expandedPhase = "3";

    private int _overallProgress => (int)Math.Round(_phases.Sum(p => p.Progress) / (double)_phases.Length);

    private static string GetTaskDotClass(PhaseInfo phase, int tIndex) =>
        phase.Progress == 100
            ? "bg-emerald-500"
            : (phase.Progress > 0 && tIndex < (int)Math.Ceiling(phase.Tasks.Length * phase.Progress / 100.0))
                ? "bg-blue-500"
                : "bg-muted-foreground/30";

    private static readonly StatusConfigItem[] _statusConfigs =
    [
        new("Completed", "bg-emerald-500"),
        new("In Progress", "bg-blue-500"),
        new("Upcoming", "bg-muted-foreground/40"),
        new("Delayed", "bg-red-500"),
    ];

    private static readonly Dictionary<string, StatusConfigItem> _statusConfigMap = new()
    {
        ["completed"] = new("Completed", "bg-emerald-500"),
        ["in-progress"] = new("In Progress", "bg-blue-500"),
        ["upcoming"] = new("Upcoming", "bg-muted-foreground/40"),
        ["delayed"] = new("Delayed", "bg-red-500"),
    };

    private static readonly PhaseInfo[] _phases =
    [
        new("1", "Site Preparation", "GroundWork LLC", "Jan 6", "Jan 24", 100, "completed",
            ["Clear site", "Grade land", "Install erosion controls", "Survey markers"]),
        new("2", "Foundation", "SolidBase Inc", "Jan 27", "Feb 21", 100, "completed",
            ["Excavation", "Footings", "Foundation walls", "Waterproofing"]),
        new("3", "Framing", "TimberCraft Co", "Feb 24", "Mar 28", 65, "in-progress",
            ["Wall framing", "Roof trusses", "Sheathing", "Window openings"]),
        new("4", "Plumbing & Electrical", "PipeFlow Services", "Mar 31", "Apr 25", 0, "upcoming",
            ["Rough plumbing", "Electrical wiring", "HVAC ductwork", "Inspections"]),
        new("5", "Exterior Finishing", "FacadePro LLC", "Apr 28", "May 23", 0, "upcoming",
            ["Siding installation", "Roofing", "Window fitting", "Paint"]),
        new("6", "Interior Finishing", "InteriorEdge", "May 26", "Jul 3", 0, "delayed",
            ["Drywall", "Flooring", "Cabinets", "Trim work", "Paint"]),
    ];
}
