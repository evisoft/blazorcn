@* ============================================================
   Block: calendar-sync-settings
   Title: Calendar Sync Settings
   Description: Calendar sync settings with provider toggles, sync frequency, and conflict resolution options
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/calendar/calendar-sync-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCloudCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Calendar Sync</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">Manage connected calendars and sync preferences</p>
        </div>

        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Connected calendars</span>
            </div>
            @for (var i = 0; i < _providers.Length; i++)
            {
                var provider = _providers[i];
                var isLast = i == _providers.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@provider.Name</span>
                            @if (provider.Connected)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">@provider.Direction</BadgeCn>
                            }
                        </div>
                        @if (provider.Connected)
                        {
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span class="truncate">@provider.Account</span>
                                <span>·</span>
                                <span class="flex shrink-0 items-center gap-1">
                                    <LucideCircleCheckBigCn Size="12" Class="size-3 text-emerald-500" />
                                    Synced @provider.LastSync
                                </span>
                            </div>
                        }
                        else
                        {
                            <span class="mt-0.5 flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideCircleXCn Size="12" Class="size-3" />
                                Not connected
                            </span>
                        }
                    </div>
                    <SwitchCn Checked="@provider.Connected" />
                </div>
            }
        </div>

        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Sync settings</span>
            </div>
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div>
                    <span class="text-sm">Sync frequency</span>
                    <p class="text-muted-foreground text-xs">How often to check for calendar updates</p>
                </div>
                <SelectCn @bind-Value="_syncFrequency">
                    <SelectTriggerCn class="h-8 w-32 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="5">Every 5 min</SelectItemCn>
                        <SelectItemCn Value="15">Every 15 min</SelectItemCn>
                        <SelectItemCn Value="30">Every 30 min</SelectItemCn>
                        <SelectItemCn Value="60">Every hour</SelectItemCn>
                        <SelectItemCn Value="manual">Manual only</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div class="flex items-center justify-between px-4 py-3">
                <div>
                    <span class="text-sm">Conflict resolution</span>
                    <p class="text-muted-foreground text-xs">How to handle overlapping events</p>
                </div>
                <SelectCn @bind-Value="_conflictResolution">
                    <SelectTriggerCn class="h-8 w-32 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="local">Keep local</SelectItemCn>
                        <SelectItemCn Value="remote">Keep remote</SelectItemCn>
                        <SelectItemCn Value="manual">Manual</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Preferences</span>
            </div>
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideShieldCn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">Auto-decline conflicts</span>
                </div>
                <SwitchCn @bind-Checked="_autoDecline" />
            </div>
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideRefreshCwCn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">Show declined events</span>
                </div>
                <SwitchCn @bind-Checked="_showDeclined" />
            </div>
        </div>

        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">@(_providers.Count(p => p.Connected)) calendars connected</span>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" class="h-7 gap-1.5 text-xs">
                <LucideRefreshCwCn Size="12" Class="size-3" />
                Sync now
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _syncFrequency = "15";
    private string _conflictResolution = "manual";
    private bool _autoDecline;
    private bool _showDeclined = true;

    private record ProviderItem(string Name, string Account, string Direction, string LastSync, bool Connected);

    private static readonly ProviderItem[] _providers =
    [
        new("Google Calendar", "sarah@@example.com", "Two-way", "3 min ago", true),
        new("Outlook", "sarah@@company.com", "One-way", "15 min ago", true),
        new("Apple iCal", "", "", "", false),
    ];
}
