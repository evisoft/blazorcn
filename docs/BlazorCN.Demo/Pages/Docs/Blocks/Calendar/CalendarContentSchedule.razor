@* ============================================================
   Block: calendar-content-schedule
   Title: Calendar Content Schedule
   Description: React content publishing schedule calendar block for Next.js with draft, scheduled, and published status indicators per day, weekly view, and content type labels using shadcn/ui and Tailwind CSS
   Long Description: React Class Timetable Calendar Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-content-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Content Schedule</h2>
                <p class="text-muted-foreground text-xs">Mar 17 - Mar 23, 2026</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronLeftCn Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                    <LucideChevronRightCn Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Status summary *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500" />
                @_counts["published"] published
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500" />
                @_counts["scheduled"] scheduled
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-zinc-400" />
                @_counts["draft"] drafts
            </span>
        </div>

        @* Week day selector *@
        <div class="grid grid-cols-7 border-b">
            @foreach (var day in _weekData)
            {
                var dayDate = day.Date;
                <button type="button"
                        @onclick="@(() => _selectedDay = dayDate)"
                        class="@($"flex flex-col items-center gap-0.5 px-1 py-2.5 text-center transition-colors hover:bg-muted/50 {(_selectedDay == dayDate ? "bg-muted/50" : "")}")">
                    <span class="text-muted-foreground text-xs">@day.Day</span>
                    <span class="@($"font-medium text-sm tabular-nums {(_selectedDay == dayDate ? "text-foreground" : "text-muted-foreground")}")">
                        @day.Date.Split(' ')[1]
                    </span>
                    @if (day.Items.Length > 0)
                    {
                        <div class="flex items-center gap-0.5">
                            @foreach (var item in day.Items.Take(3))
                            {
                                <span class="@($"size-1 rounded-full {GetStatusDot(item.Status)}")" />
                            }
                        </div>
                    }
                </button>
            }
        </div>

        @* Selected day content *@
        <div>
            <div class="flex items-center justify-between border-b px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">
                    @(Selected != null ? $"{Selected.Day}, {Selected.Date}" : "Select a day")
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucidePlusCn Class="size-3" />
                    Add
                </ButtonCn>
            </div>
            @if (Selected != null && Selected.Items.Length > 0)
            {
                @for (int i = 0; i < Selected.Items.Length; i++)
                {
                    var item = Selected.Items[i];
                    var isLast = i >= Selected.Items.Length - 1;
                    <div class="@($"flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50 {(isLast ? "" : "border-b")}")">
                        <span class="@($"size-2 shrink-0 rounded-full {GetStatusDot(item.Status)}")" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Title</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@item.Time</span>
                                <span class="text-muted-foreground text-xs">@GetStatusLabel(item.Status)</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@item.Type</BadgeCn>
                    </div>
                }
            }
            else
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No content scheduled
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _selectedDay = "Mar 18";

    private record ContentItem(string Id, string Title, string Status, string Type, string Time);
    private record DayContent(string Day, string Date, ContentItem[] Items);

    private DayContent? Selected => _weekData.FirstOrDefault(d => d.Date == _selectedDay);

    private static readonly DayContent[] _weekData =
    [
        new("Mon", "Mar 17", [
            new("1", "Q1 Product Recap", "published", "article", "9:00 AM"),
            new("2", "Instagram Carousel", "published", "social", "12:00 PM"),
        ]),
        new("Tue", "Mar 18", [
            new("3", "Feature Walkthrough", "scheduled", "video", "10:00 AM"),
            new("4", "Weekly Digest #42", "scheduled", "newsletter", "2:00 PM"),
        ]),
        new("Wed", "Mar 19", [
            new("5", "Customer Story: Acme", "scheduled", "article", "8:00 AM"),
        ]),
        new("Thu", "Mar 20", [
            new("6", "Twitter Thread: Tips", "draft", "social", "11:00 AM"),
            new("7", "Webinar Promo Clip", "draft", "video", "3:00 PM"),
            new("8", "Changelog March", "draft", "article", "5:00 PM"),
        ]),
        new("Fri", "Mar 21", [
            new("9", "LinkedIn Announcement", "draft", "social", "9:00 AM"),
        ]),
        new("Sat", "Mar 22", []),
        new("Sun", "Mar 23", [
            new("10", "Week Ahead Preview", "draft", "newsletter", "6:00 PM"),
        ]),
    ];

    private static readonly Dictionary<string, int> _counts = new()
    {
        ["draft"] = _weekData.SelectMany(d => d.Items).Count(i => i.Status == "draft"),
        ["scheduled"] = _weekData.SelectMany(d => d.Items).Count(i => i.Status == "scheduled"),
        ["published"] = _weekData.SelectMany(d => d.Items).Count(i => i.Status == "published"),
    };

    private static string GetStatusDot(string status) => status switch
    {
        "draft" => "bg-zinc-400",
        "scheduled" => "bg-blue-500",
        "published" => "bg-emerald-500",
        _ => "bg-zinc-400"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "draft" => "Draft",
        "scheduled" => "Scheduled",
        "published" => "Published",
        _ => status
    };
}
