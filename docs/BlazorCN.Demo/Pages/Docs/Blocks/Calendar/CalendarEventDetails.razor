@* ============================================================
   Block: calendar-event-details
   Title: Calendar Event Details
   Description: A detailed event card with attendee avatars, location map link, time display, rich description, and RSVP action buttons built with React, Next.js, shadcn/ui, and Tailwind CSS
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/calendar/calendar-event-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Size="16" class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Event Details</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 gap-1 px-2 text-xs">
                <LucidePencilCn Size="12" class="size-3" />
                Edit
            </ButtonCn>
        </div>

        @* Title and time *@
        <div class="border-b px-4 py-3">
            <h3 class="font-medium text-sm">@_event.Title</h3>
            <div class="mt-2 flex flex-wrap items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideCalendarCn Size="12" class="size-3" />
                    @_event.Date
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideClockCn Size="12" class="size-3" />
                    @_event.StartTime - @_event.EndTime
                </span>
            </div>
        </div>

        @* Location and conference *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex flex-1 items-center gap-1.5">
                    <LucideMapPinCn Size="12" class="size-3 shrink-0 text-muted-foreground" />
                    <span class="text-sm">@_event.Location</span>
                </div>
            </div>
            <div class="mt-2 flex items-center gap-2">
                <LucideVideoCn Size="12" class="size-3 shrink-0 text-muted-foreground" />
                <span class="truncate font-mono text-muted-foreground text-xs">
                    @_event.ConferenceUrl
                </span>
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    class="h-6 shrink-0 gap-1 px-2 text-xs">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideLinkCn Size="12" class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Description</span>
            <p class="text-sm leading-relaxed">@_event.Description</p>
        </div>

        @* Attendees *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                    <LucideUsersCn Size="12" class="size-3" />
                    Attendees
                </span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_accepted/@_event.Attendees.Length accepted
                </span>
            </div>
            <div class="space-y-0">
                @for (var i = 0; i < _event.Attendees.Length; i++)
                {
                    var idx = i;
                    var attendee = _event.Attendees[idx];
                    var isLast = idx == _event.Attendees.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-2.5 py-2", isLast ? "" : "border-b")">
                        <AvatarCn>
                            <AvatarFallbackCn class="text-xs">@attendee.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <span class="flex-1 text-sm">@attendee.Name</span>
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[attendee.Status])"></span>
                            @(char.ToUpper(attendee.Status[0]) + attendee.Status.Substring(1))
                        </span>
                        @if (attendee.Name == _event.Organizer)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" class="font-normal text-xs">
                                Organizer
                            </BadgeCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* RSVP actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">Your response</span>
            <div class="flex items-center gap-1.5">
                <ButtonCn
                    Variant="@(_rsvp == "accepted" ? ButtonVariant.Default : ButtonVariant.Outline)"
                    Size="ButtonSize.Sm"
                    class="h-7 gap-1 text-xs"
                    @onclick="@(() => _rsvp = "accepted")">
                    <LucideCheckCn Size="12" class="size-3" />
                    Accept
                </ButtonCn>
                <ButtonCn
                    Variant="@(_rsvp == "tentative" ? ButtonVariant.Default : ButtonVariant.Outline)"
                    Size="ButtonSize.Sm"
                    class="h-7 text-xs"
                    @onclick="@(() => _rsvp = "tentative")">
                    Maybe
                </ButtonCn>
                <ButtonCn
                    Variant="@(_rsvp == "declined" ? ButtonVariant.Default : ButtonVariant.Outline)"
                    Size="ButtonSize.Sm"
                    class="h-7 gap-1 text-xs"
                    @onclick="@(() => _rsvp = "declined")">
                    <LucideXCn Size="12" class="size-3" />
                    Decline
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Attendee(string Id, string Name, string Initials, string Status);
    private record EventDetail(string Title, string Date, string StartTime, string EndTime, string Location, string ConferenceUrl, string Description, string Organizer, Attendee[] Attendees);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["accepted"] = "bg-emerald-500",
        ["declined"] = "bg-red-500",
        ["tentative"] = "bg-amber-500",
        ["pending"] = "bg-muted-foreground/40",
    };

    private static readonly EventDetail _event = new(
        "Q1 Product Strategy Review",
        "Wednesday, March 18, 2026",
        "2:00 PM", "3:30 PM",
        "Board Room 3A, Floor 12",
        "https://meet.google.com/abc-defg-hij",
        "Review Q1 product performance metrics, discuss roadmap adjustments for Q2, and align on feature prioritization. Please review the pre-read deck shared in the #product channel before the meeting.",
        "Alex Rivera",
        [
            new("1", "Alex Rivera", "AR", "accepted"),
            new("2", "Jordan Lee", "JL", "accepted"),
            new("3", "Priya Sharma", "PS", "tentative"),
            new("4", "Marcus Chen", "MC", "accepted"),
            new("5", "Sophia Nguyen", "SN", "pending"),
            new("6", "David Kim", "DK", "declined"),
        ]
    );

    private int _accepted => _event.Attendees.Count(a => a.Status == "accepted");
    private string _rsvp = "accepted";
    private bool _copied = false;
}
