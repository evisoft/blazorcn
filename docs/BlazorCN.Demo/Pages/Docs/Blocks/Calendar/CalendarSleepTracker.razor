@* ============================================================
   Block: calendar-sleep-tracker
   Title: CalendarSleepTracker
   Description: A sleep schedule tracker calendar block for Next.js with bedtime tracking, sleep quality scoring, weekly patterns, and sleep goal monitoring using shadcn/ui and Tailwind CSS
   Source: original/blocks/calendar/calendar-sleep-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMoonCn Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Sleep Tracker</span>
                    <p class="text-muted-foreground text-xs">Week of Mar 17, 2026</p>
                </div>
            </div>
        </div>

        @* Weekly summary *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Avg Duration</span>
                <p class="font-semibold text-lg tabular-nums">@AvgDuration.ToString("F1")h</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Goal</span>
                <p class="text-muted-foreground text-sm tabular-nums">@(GoalHours)h</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Avg Quality</span>
                <p class="@($"text-sm font-medium tabular-nums {QualityColor(AvgQuality)}")">@AvgQuality% @QualityLabel(AvgQuality)</p>
            </div>
        </div>

        @* Sleep duration chart *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Sleep duration</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideTrendingUpCn Class="size-3" />
                    @(GoalHours)h goal
                </span>
            </div>
            <div class="flex items-end gap-2">
                @foreach (var entry in _entries)
                {
                    var barHeight = (int)Math.Max((entry.DurationHours / MaxHours) * 48, 4);
                    var metGoal = entry.DurationHours >= GoalHours;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="text-muted-foreground text-[10px] tabular-nums">@entry.DurationHours.ToString("F1")</span>
                        <div class="@($"w-full rounded-sm {(metGoal ? "bg-emerald-500/50" : "bg-blue-500/30")}")" style="@($"height:{barHeight}px")"></div>
                        <span class="text-muted-foreground text-[10px]">@entry.Day.Substring(0, 3)</span>
                    </div>
                }
            </div>
        </div>

        @* Daily entries *@
        <div>
            @for (int i = 0; i < _entries.Count; i++)
            {
                var entry = _entries[i];
                var isExpanded = _expanded == entry.Id;
                var isLast = i == _entries.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = _expanded == entry.Id ? "" : entry.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {QualityDot(entry.Quality)}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Day</span>
                                <span class="text-muted-foreground text-xs">@entry.Date</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideMoonCn Class="size-3" />
                                    @entry.Bedtime
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideSunriseCn Class="size-3" />
                                    @entry.WakeTime
                                </span>
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="font-mono text-xs tabular-nums">@entry.Duration</span>
                            <p class="@($"text-[10px] font-medium {QualityColor(entry.Quality)}")">@entry.Quality%</p>
                        </div>
                        <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 pb-3 pt-2">
                            <div class="mb-2 flex items-center gap-4 text-xs">
                                <span class="text-muted-foreground">
                                    Bedtime: <span class="text-foreground">@entry.Bedtime</span>
                                </span>
                                <span class="text-muted-foreground">
                                    Wake: <span class="text-foreground">@entry.WakeTime</span>
                                </span>
                                <span class="text-muted-foreground">
                                    Quality: <span class="@QualityColor(entry.Quality)">@QualityLabel(entry.Quality)</span>
                                </span>
                            </div>
                            <p class="text-muted-foreground text-xs italic">@entry.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Excellent
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                Good
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                Fair
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                Poor
            </span>
        </div>

    </div>
</section>

@code {
    private string _expanded = "7";
    private const int GoalHours = 8;

    private class SleepEntry
    {
        public string Id { get; init; } = "";
        public string Day { get; init; } = "";
        public string Date { get; init; } = "";
        public string Bedtime { get; init; } = "";
        public string WakeTime { get; init; } = "";
        public string Duration { get; init; } = "";
        public double DurationHours { get; init; }
        public int Quality { get; init; }
        public string Notes { get; init; } = "";
    }

    private static readonly List<SleepEntry> _entries =
    [
        new() { Id = "1", Day = "Monday",    Date = "Mar 17", Bedtime = "10:45 PM", WakeTime = "6:30 AM", Duration = "7h 45m", DurationHours = 7.75, Quality = 88, Notes = "Fell asleep quickly. One brief wake-up around 3 AM." },
        new() { Id = "2", Day = "Tuesday",   Date = "Mar 18", Bedtime = "11:15 PM", WakeTime = "6:30 AM", Duration = "7h 15m", DurationHours = 7.25, Quality = 76, Notes = "Late screen time delayed sleep onset. Restless first hour." },
        new() { Id = "3", Day = "Wednesday", Date = "Mar 19", Bedtime = "10:30 PM", WakeTime = "6:15 AM", Duration = "7h 45m", DurationHours = 7.75, Quality = 92, Notes = "Excellent sleep. Evening walk helped. No interruptions." },
        new() { Id = "4", Day = "Thursday",  Date = "Mar 20", Bedtime = "11:00 PM", WakeTime = "6:30 AM", Duration = "7h 30m", DurationHours = 7.5,  Quality = 82, Notes = "Good overall. Slight trouble falling asleep due to caffeine at 4 PM." },
        new() { Id = "5", Day = "Friday",    Date = "Mar 21", Bedtime = "11:30 PM", WakeTime = "7:45 AM", Duration = "8h 15m", DurationHours = 8.25, Quality = 90, Notes = "Longer sleep on weekend eve. Deep sleep phase felt extended." },
        new() { Id = "6", Day = "Saturday",  Date = "Mar 22", Bedtime = "12:15 AM", WakeTime = "8:30 AM", Duration = "8h 15m", DurationHours = 8.25, Quality = 85, Notes = "Later bedtime but compensated with later wake. Dreamed vividly." },
        new() { Id = "7", Day = "Sunday",    Date = "Mar 23", Bedtime = "10:30 PM", WakeTime = "6:30 AM", Duration = "8h 0m",  DurationHours = 8.0,  Quality = 94, Notes = "Best night of the week. Early bedtime, consistent routine, no disruptions." },
    ];

    private double AvgDuration => _entries.Sum(e => e.DurationHours) / _entries.Count;
    private int AvgQuality => (int)Math.Round((double)_entries.Sum(e => e.Quality) / _entries.Count);
    private double MaxHours => _entries.Max(e => e.DurationHours);

    private static string QualityLabel(int q) =>
        q >= 90 ? "Excellent" : q >= 75 ? "Good" : q >= 60 ? "Fair" : "Poor";

    private static string QualityColor(int q) =>
        q >= 90 ? "text-emerald-600 dark:text-emerald-400" :
        q >= 75 ? "text-blue-600 dark:text-blue-400" :
        q >= 60 ? "text-amber-600 dark:text-amber-400" :
                  "text-red-600 dark:text-red-400";

    private static string QualityDot(int q) =>
        q >= 90 ? "bg-emerald-500" :
        q >= 75 ? "bg-blue-500" :
        q >= 60 ? "bg-amber-500" :
                  "bg-red-500";
}
