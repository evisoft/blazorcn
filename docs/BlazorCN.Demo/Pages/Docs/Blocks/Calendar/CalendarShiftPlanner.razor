@* ============================================================
   Block: calendar-shift-planner
   Title: Calendar Shift Planner
   Description: React employee shift planning calendar block for Next.js with morning afternoon and night shift slots per person, weekly grid layout, shift type indicators, and coverage summary using shadcn/ui and Tailwind CSS
   Long Description: Resource scheduling grid with rooms
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-shift-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Shift Planner</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_employees.Length team members &middot; Week of Mar 16
                </p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideChevronLeftCn Class="size-4" />
                </ButtonCn>
                <span class="rounded-full bg-muted px-2 py-0.5 text-muted-foreground text-xs">
                    This Week
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideChevronRightCn Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Grid *@
        <div class="overflow-x-auto">
            <div class="min-w-[600px]">
                @* Grid header *@
                <div class="grid grid-cols-[140px_repeat(7,1fr)_56px] border-b bg-muted/30">
                    <div class="border-r px-3 py-2">
                        <span class="text-muted-foreground text-xs">Employee</span>
                    </div>
                    @for (int i = 0; i < _days.Length; i++)
                    {
                        <div class="border-r px-1 py-2 text-center">
                            <span class="block text-muted-foreground text-xs">@_days[i]</span>
                            <span class="text-muted-foreground/60 text-[10px] tabular-nums">@_dates[i]</span>
                        </div>
                    }
                    <div class="px-2 py-2 text-center">
                        <span class="text-muted-foreground text-xs">Hrs</span>
                    </div>
                </div>

                @* Employee rows *@
                <div>
                    @for (int eIdx = 0; eIdx < _employees.Length; eIdx++)
                    {
                        var employee = _employees[eIdx];
                        var isLast = eIdx == _employees.Length - 1;
                        var hours = CountShiftHours(employee.Shifts);
                        <div class="@($"grid grid-cols-[140px_repeat(7,1fr)_56px] {(isLast ? "" : "border-b")}")">
                            @* Name *@
                            <div class="flex items-center gap-2 border-r px-3 py-3">
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                    @employee.Initials
                                </div>
                                <div class="min-w-0">
                                    <span class="block truncate text-sm">@employee.Name</span>
                                    <span class="text-muted-foreground text-[10px]">@employee.Role</span>
                                </div>
                            </div>

                            @* Shifts *@
                            @for (int si = 0; si < employee.Shifts.Length; si++)
                            {
                                var shift = employee.Shifts[si];
                                var bg = GetShiftBg(shift);
                                var text = GetShiftText(shift);
                                var label = GetShiftLabel(shift);
                                <div class="flex items-center justify-center border-r p-1">
                                    <span class="@($"flex h-7 w-full items-center justify-center rounded-md text-xs font-medium {bg} {text}")">
                                        @label
                                    </span>
                                </div>
                            }

                            @* Hours *@
                            <div class="flex items-center justify-center px-2 py-3">
                                <span class="font-medium text-sm tabular-nums">@hours</span>
                            </div>
                        </div>
                    }
                </div>

                @* Coverage row *@
                <div class="grid grid-cols-[140px_repeat(7,1fr)_56px] border-t bg-muted/20">
                    <div class="border-r px-3 py-2">
                        <span class="text-muted-foreground text-xs">Coverage</span>
                    </div>
                    @for (int i = 0; i < _days.Length; i++)
                    {
                        var count = _coverageByDay[i];
                        var colorClass = count < 3
                            ? "text-red-600 dark:text-red-400"
                            : count < 5
                                ? "text-amber-600 dark:text-amber-400"
                                : "text-emerald-600 dark:text-emerald-400";
                        <div class="flex items-center justify-center border-r py-2">
                            <span class="@($"font-medium text-xs tabular-nums {colorClass}")">
                                @count/@_employees.Length
                            </span>
                        </div>
                    }
                    <div class="px-2 py-2" />
                </div>
            </div>
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-t px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="rounded-sm px-1 py-0.5 text-[10px] font-medium bg-amber-500/10 text-amber-700 dark:text-amber-300">AM</span>
                Morning
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="rounded-sm px-1 py-0.5 text-[10px] font-medium bg-blue-500/10 text-blue-700 dark:text-blue-300">PM</span>
                Afternoon
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="rounded-sm px-1 py-0.5 text-[10px] font-medium bg-violet-500/10 text-violet-700 dark:text-violet-300">NT</span>
                Night
            </span>
        </div>
    </div>
</section>

@code {
    private record Employee(string Id, string Name, string Initials, string Role, string[] Shifts);

    private static readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private static readonly string[] _dates = ["Mar 16", "Mar 17", "Mar 18", "Mar 19", "Mar 20", "Mar 21", "Mar 22"];

    private static readonly Employee[] _employees =
    [
        new("e1", "Sarah Chen", "SC", "Lead", ["morning", "morning", "afternoon", "morning", "morning", "off", "off"]),
        new("e2", "Alex Rivera", "AR", "Senior", ["afternoon", "afternoon", "morning", "afternoon", "night", "morning", "off"]),
        new("e3", "Marcus Kim", "MK", "Mid", ["night", "night", "off", "night", "afternoon", "afternoon", "morning"]),
        new("e4", "Elena Petrov", "EP", "Senior", ["morning", "off", "morning", "morning", "morning", "night", "night"]),
        new("e5", "James Taylor", "JT", "Junior", ["off", "morning", "night", "afternoon", "off", "morning", "afternoon"]),
        new("e6", "Lina Nguyen", "LN", "Mid", ["afternoon", "afternoon", "afternoon", "off", "morning", "off", "morning"]),
    ];

    private static readonly int[] _coverageByDay = Enumerable.Range(0, 7)
        .Select(i => _employees.Count(e => e.Shifts[i] != "off"))
        .ToArray();

    private static int CountShiftHours(string[] shifts) =>
        shifts.Sum(s => s == "off" ? 0 : 8);

    private static string GetShiftBg(string shift) => shift switch
    {
        "morning" => "bg-amber-500/10",
        "afternoon" => "bg-blue-500/10",
        "night" => "bg-violet-500/10",
        _ => ""
    };

    private static string GetShiftText(string shift) => shift switch
    {
        "morning" => "text-amber-700 dark:text-amber-300",
        "afternoon" => "text-blue-700 dark:text-blue-300",
        "night" => "text-violet-700 dark:text-violet-300",
        _ => "text-muted-foreground/40"
    };

    private static string GetShiftLabel(string shift) => shift switch
    {
        "morning" => "AM",
        "afternoon" => "PM",
        "night" => "NT",
        _ => "--"
    };
}
