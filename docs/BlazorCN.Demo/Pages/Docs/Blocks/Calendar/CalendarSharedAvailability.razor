@* ============================================================
   Block: calendar-shared-availability
   Title: Calendar Shared Availability
   Description: Team availability overlay with member toggles, heatmap, and suggested meeting times
   Dependencies: ButtonCn
   Source: original/blocks/calendar/calendar-shared-availability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Team Availability</span>
                </div>
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                        <LucideChevronLeftCn Size="16" Class="size-4" />
                    </ButtonCn>
                    <span class="text-sm tabular-nums">Wed, Apr 9</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-7 p-0">
                        <LucideChevronRightCn Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-2">
                @foreach (var member in _members)
                {
                    var isSelected = _selectedMembers.Contains(member.Id);
                    <button type="button" @onclick="() => ToggleMember(member.Id)" class="@Cn.Merge("flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs transition-colors", isSelected ? "bg-foreground text-background" : "bg-muted text-muted-foreground hover:bg-muted/80")">
                        <span class="font-medium">@member.Initials</span>
                        <span>@member.FirstName</span>
                        <span class="text-[10px] opacity-60">@member.Timezone</span>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Availability heatmap</span>
                <div class="flex items-center gap-2 text-[10px] text-muted-foreground">
                    <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-emerald-500/30"></span> All free</span>
                    <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-amber-500/15"></span> Some free</span>
                    <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-red-500/10"></span> Most busy</span>
                </div>
            </div>
            <div class="flex gap-1">
                @foreach (var hour in _timeSlots)
                {
                    var activeMembers = _members.Where(m => _selectedMembers.Contains(m.Id)).ToArray();
                    var available = activeMembers.Count(m => !m.BusySlots.Any(s => hour >= s.Start && hour < s.End));
                    var total = activeMembers.Length;
                    <div class="flex-1">
                        <div class="@Cn.Merge("mb-1 h-8 rounded-md", GetSlotColor(available, total))">
                            <div class="flex h-full items-center justify-center">
                                <span class="font-medium text-xs tabular-nums">@available/@total</span>
                            </div>
                        </div>
                        <span class="block text-center text-muted-foreground text-[10px] tabular-nums">@FormatHour(hour)</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Individual schedules</span>
            </div>
            @{ var activeList = _members.Where(m => _selectedMembers.Contains(m.Id)).ToArray(); }
            @for (var i = 0; i < activeList.Length; i++)
            {
                var member = activeList[i];
                var isLast = i == activeList.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">@member.Initials</div>
                    <span class="w-16 shrink-0 truncate text-xs">@member.FirstName</span>
                    <div class="flex flex-1 gap-px">
                        @foreach (var hour in _timeSlots)
                        {
                            var isBusy = member.BusySlots.Any(s => hour >= s.Start && hour < s.End);
                            <div class="@Cn.Merge("h-3 flex-1 rounded-sm", isBusy ? "bg-red-500/20" : "bg-emerald-500/20")"></div>
                        }
                    </div>
                </div>
            }
        </div>

        <div>
            <div class="flex items-center gap-1.5 px-4 py-2">
                <LucideSparklesCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Suggested meeting times</span>
            </div>
            @for (var i = 0; i < _suggestions.Length; i++)
            {
                var suggestion = _suggestions[i];
                var isLast = i == _suggestions.Length - 1;
                var isSelected = _selectedSuggestion == i;
                <button type="button" @onclick="() => _selectedSuggestion = isSelected ? null : i" class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b", isSelected ? "bg-muted/50" : "")">
                    <LucideClockCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@suggestion.Time</span>
                        <span class="ml-2 text-muted-foreground text-xs">@suggestion.Duration</span>
                    </div>
                    <span class="flex items-center gap-1.5 text-xs">
                        @if (suggestion.Available == suggestion.Total)
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                        else
                        {
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                        }
                        <span class="text-muted-foreground tabular-nums">@suggestion.Available/@suggestion.Total</span>
                    </span>
                    @if (isSelected)
                    {
                        <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                    }
                </button>
            }
        </div>
    </div>
</section>

@code {
    private HashSet<string> _selectedMembers = ["m1", "m2", "m3", "m4"];
    private int? _selectedSuggestion;

    private static readonly int[] _timeSlots = [9, 10, 11, 12, 13, 14, 15, 16, 17];

    private void ToggleMember(string id)
    {
        if (!_selectedMembers.Remove(id)) _selectedMembers.Add(id);
    }

    private static string FormatHour(int h) => h > 12 ? $"{h - 12}p" : h == 12 ? "12p" : $"{h}a";

    private static string GetSlotColor(int available, int total)
    {
        if (total == 0) return "bg-muted";
        var ratio = (double)available / total;
        return ratio >= 0.8 ? "bg-emerald-500/30" : ratio >= 0.4 ? "bg-amber-500/15" : "bg-red-500/10";
    }

    private record BusySlot(int Start, int End);
    private record MemberItem(string Id, string FirstName, string Initials, string Timezone, BusySlot[] BusySlots);
    private record SuggestionItem(string Time, string Duration, int Available, int Total);

    private static readonly MemberItem[] _members =
    [
        new("m1", "Sarah", "SC", "EST", [new(9, 10), new(14, 15)]),
        new("m2", "Marcus", "MW", "EST", [new(10, 12)]),
        new("m3", "Elena", "ER", "CET", [new(11, 12), new(15, 16)]),
        new("m4", "James", "JP", "PST", [new(9, 10), new(13, 14)]),
    ];

    private static readonly SuggestionItem[] _suggestions =
    [
        new("12:00 PM - 1:00 PM", "1 hour", 4, 4),
        new("2:00 PM - 3:00 PM", "1 hour", 3, 4),
        new("4:00 PM - 5:00 PM", "1 hour", 4, 4),
    ];
}
