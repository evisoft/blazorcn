@* ============================================================
   Block: banner-top-bar-rating
   Title: BannerTopBarRating
   Description: A single-line top bar banner for React and Next.js with an inline five-star rating, numeric score, review count, and underlined review link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center gap-3 rounded-lg border bg-card px-4 py-2.5">
        <div role="img"
             aria-label="@($"Rated {_rating} out of 5")"
             class="flex shrink-0 items-center gap-0.5">
            @foreach (var i in _starIndices)
            {
                <LucideIconCn Name="star" Size="14" aria-hidden="true" Class="size-3.5 fill-amber-500/80 text-amber-500/80" />
            }
        </div>
        <p class="min-w-0 flex-1 truncate text-center text-xs text-muted-foreground">
            <span class="font-semibold text-foreground tabular-nums">@_rating</span> from
            @_totalReviews.ToString("N0") verified developers.
            <a href="#"
               class="font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                Leave a review
            </a>
        </p>
    </div>
</section>

@code {
    private const double _rating = 4.8;
    private const int _totalReviews = 1342;
    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];
}
