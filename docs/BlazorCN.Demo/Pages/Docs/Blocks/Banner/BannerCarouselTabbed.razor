@* ============================================================
   Block: banner-carousel-tabbed
   Title: BannerCarouselTabbed
   Description: A tabbed carousel banner for React and Next.js with three inline tab triggers, a motion/react cross-fade slide transition, and pagination dots built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-carousel-tabbed.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div role="tablist"
             aria-label="Announcement categories"
             class="flex items-center gap-0.5 border-b px-2">
            @for (var i = 0; i < _slides.Length; i++)
            {
                var slide = _slides[i];
                var idx = i;
                var active = idx == _index;
                <button type="button"
                        role="tab"
                        aria-selected="@(active.ToString().ToLower())"
                        @onclick="@(() => SetIndex(idx))"
                        class="@Cn.Merge("relative px-3 py-2.5 text-xs transition-colors", active ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @slide.Label
                    @if (active)
                    {
                        <span class="absolute inset-x-3 bottom-0 h-px bg-foreground"></span>
                    }
                </button>
            }
        </div>

        <div class="relative overflow-hidden px-4 py-3">
            <p class="text-sm font-medium text-foreground">@_slides[_index].Title</p>
            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@_slides[_index].Description</p>
        </div>

        <div class="flex items-center justify-center gap-0.5 border-t px-4 py-2.5">
            @for (var i = 0; i < _slides.Length; i++)
            {
                var idx = i;
                var active = idx == _index;
                <button type="button"
                        @onclick="@(() => SetIndex(idx))"
                        aria-label="@($"Go to slide {idx + 1}")"
                        class="inline-flex size-6 items-center justify-center">
                    <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", active ? "bg-foreground" : "bg-muted-foreground/30 hover:bg-muted-foreground/60")"></span>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private record Slide(string Id, string Label, string Title, string Description);

    private static readonly Slide[] _slides =
    [
        new("whats-new", "What's new", "Multi-region deployments are live",
            "Ship to six regions from a single config. Global read latency drops below 40ms for end users on the free plan."),
        new("tips", "Tips", "Move faster with keyboard shortcuts",
            "Press Cmd+K for the palette, Cmd+/ to comment lines, and Cmd+Shift+P to jump to any action from anywhere in the app."),
        new("updates", "Updates", "Scheduled maintenance on April 18",
            "Database primary failover between 02:00 and 04:00 UTC. Expect read-only mode for roughly 12 minutes during the window."),
    ];

    private const int AutoplayMs = 6000;
    private int _index;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new Timer(_ =>
        {
            _index = (_index + 1) % _slides.Length;
            InvokeAsync(StateHasChanged);
        }, null, AutoplayMs, AutoplayMs);
    }

    private void SetIndex(int i)
    {
        _index = i;
        _timer?.Change(AutoplayMs, AutoplayMs);
    }

    public void Dispose() => _timer?.Dispose();
}
