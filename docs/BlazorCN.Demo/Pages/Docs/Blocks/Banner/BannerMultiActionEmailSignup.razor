@* ============================================================
   Block: banner-multi-action-email-signup
   Title: BannerMultiActionEmailSignup
   Description: A multi-action email signup banner for React and Next.js with a title and description pair, inline email input, primary Subscribe button, outline remind-later action, and corner dismiss built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-email-signup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="mail" Size="16" aria-hidden="true" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-foreground">
                        Join the v4.0 early access list
                    </p>
                    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                        We are inviting 500 teams to try the new theme engine and tree-shakeable exports
                        before general availability on May 14.
                    </p>
                    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
                        <label for="banner-email-signup" class="flex min-w-0 flex-1 items-center rounded-md border bg-background px-3 py-1.5">
                            <span class="sr-only">Work email</span>
                            <InputCn id="banner-email-signup"
                                     type="email"
                                     @bind-Value="_email"
                                     Placeholder="you@company.com"
                                     Class="h-6 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0" />
                        </label>
                        <div class="flex items-center gap-2">
                            <ButtonCn type="submit" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                Request access
                            </ButtonCn>
                            <ButtonCn type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _visible = false)">
                                Remind me later
                            </ButtonCn>
                        </div>
                    </div>
                </div>
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="@(() => _visible = false)" aria-label="Dismiss banner" Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
    private string _email = "";
}
