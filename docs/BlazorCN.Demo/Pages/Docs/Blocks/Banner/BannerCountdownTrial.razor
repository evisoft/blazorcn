@* ============================================================
   Block: banner-countdown-trial
   Title: BannerCountdownTrial
   Description: A hydration-safe countdown banner for React and Next.js showing days, hours, and minutes remaining on a trial, with tabular-nums typography and a compact upgrade button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-countdown-trial.tsx
   ============================================================ *@

@implements IDisposable

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <LucideIconCn Name="clock" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-foreground">Your Pro trial ends on April 18</p>
                    <div aria-live="polite"
                         class="mt-1 flex items-baseline gap-1 font-mono text-sm tabular-nums">
                        <span class="font-semibold text-foreground">@_display.Days</span>
                        <span class="text-muted-foreground">d</span>
                        <span class="ml-1 font-semibold text-foreground">@_display.Hours</span>
                        <span class="text-muted-foreground">h</span>
                        <span class="ml-1 font-semibold text-foreground">@_display.Mins</span>
                        <span class="text-muted-foreground">m</span>
                        <span class="ml-2 text-xs text-muted-foreground">remaining</span>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                        Keep unlimited projects, priority support, and custom domains by upgrading before the
                        timer runs out.
                    </p>
                    <div class="mt-2.5">
                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Upgrade to Pro</ButtonCn>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          OnClick="@(() => _visible = false)"
                          Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                          aria-label="Dismiss banner">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private static readonly DateTimeOffset _target = new DateTimeOffset(2026, 4, 18, 23, 59, 0, TimeSpan.Zero);

    private record DisplayValues(string Days, string Hours, string Mins);

    private bool _visible = true;
    private long? _remainingMs = null;
    private System.Threading.Timer? _timer;

    private DisplayValues _display => _remainingMs is null
        ? new DisplayValues("--", "--", "--")
        : FormatRemaining(_remainingMs.Value);

    private static DisplayValues FormatRemaining(long ms)
    {
        var total = Math.Max(0L, ms);
        var days = (int)(total / 86_400_000L);
        var hours = (int)(total % 86_400_000L / 3_600_000L);
        var mins = (int)(total % 3_600_000L / 60_000L);
        return new DisplayValues(
            days.ToString().PadLeft(2, '0'),
            hours.ToString().PadLeft(2, '0'),
            mins.ToString().PadLeft(2, '0')
        );
    }

    protected override void OnInitialized()
    {
        Update();
        _timer = new System.Threading.Timer(_ =>
        {
            Update();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void Update()
    {
        _remainingMs = Math.Max(0L, (long)(_target - DateTimeOffset.UtcNow).TotalMilliseconds);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
