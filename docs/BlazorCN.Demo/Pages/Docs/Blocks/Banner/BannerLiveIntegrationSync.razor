@* ============================================================
   Block: banner-live-integration-sync
   Title: BannerLiveIntegrationSync
   Description: A live integration sync banner for React and Next.js with a pulsing status dot, service presence line, static last-sync label, and inline status link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-live-integration-sync.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <span aria-label="Live" class="relative mt-1.5 flex size-2 shrink-0" role="status">
                <span class="@(Cn.Merge("absolute inline-flex h-full w-full animate-ping rounded-full opacity-75", _healthy ? "bg-emerald-500/60" : "bg-amber-500/60"))"></span>
                <span class="@(Cn.Merge("relative inline-flex size-2 rounded-full", _healthy ? "bg-emerald-500" : "bg-amber-500"))"></span>
            </span>
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-3">
                    <p class="text-sm font-medium text-foreground">
                        @_connected of @_integrations.Length integrations syncing
                    </p>
                    <span class="shrink-0 font-mono text-[10px] uppercase tracking-widest text-muted-foreground">
                        Checked 2m ago
                    </span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Linear has not delivered events since 09:42 UTC. Other integrations are pushing within
                    the expected 5-minute SLA.
                </p>
                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1.5">
                    @foreach (var integration in _integrations)
                    {
                        <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span aria-hidden="true" class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", StatusDotClass(integration.Status)))"></span>
                            @integration.Name
                        </span>
                    }
                </div>
                <div class="mt-2.5">
                    <a
                        href="#"
                        class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        View integration logs
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Integration(string Id, string Name, string Status);

    private static readonly Integration[] _integrations =
    [
        new("slack", "Slack", "connected"),
        new("github", "GitHub", "connected"),
        new("vercel", "Vercel", "connected"),
        new("linear", "Linear", "disconnected"),
    ];

    private static readonly int _connected = _integrations.Count(i => i.Status == "connected");
    private static readonly bool _healthy = _connected == _integrations.Length;

    private static string StatusDotClass(string status) => status switch
    {
        "connected" => "bg-emerald-500/90",
        "degraded"  => "bg-amber-500/90",
        "disconnected" => "bg-red-500/90",
        _ => ""
    };
}
