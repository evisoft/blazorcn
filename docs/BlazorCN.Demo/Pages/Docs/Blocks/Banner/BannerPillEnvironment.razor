@* ============================================================
   Block: banner-pill-environment
   Title: BannerPillEnvironment
   Description: A floating pill banner for React and Next.js showing the active deployment environment as a compact rounded-full badge with a status dot, branch slug, and copy action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-pill-environment.tsx
   ============================================================ *@

@inject IJSRuntime JSRuntime

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center">
        <div class="inline-flex items-center gap-3 rounded-full border bg-card px-4 py-2 shadow-lg">
            <span role="status" aria-label="Staging environment active" class="relative flex size-2">
                <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500/60 opacity-75"></span>
                <span aria-hidden="true" class="relative inline-flex size-2 rounded-full bg-amber-500/90"></span>
            </span>
            <span class="text-xs font-medium uppercase tracking-widest text-foreground">
                Staging
            </span>
            <span class="hidden h-3 w-px bg-border sm:inline-block" aria-hidden="true"></span>
            <span class="hidden truncate font-mono text-xs text-muted-foreground sm:inline">
                @_branch · @_commitHash
            </span>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" @onclick="CopyHash"
                      Class="h-6 gap-1 rounded-full px-2 text-xs text-muted-foreground hover:text-foreground"
                      aria-label="Copy commit hash">
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="12" aria-hidden="true" Class="size-3" />
                    @:Copied
                }
                else
                {
                    <LucideIconCn Name="copy" Size="12" aria-hidden="true" Class="size-3" />
                    @:Copy
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _branch = "feat/user-dashboard";
    private const string _commitHash = "a3f7c2e";
    private bool _copied;

    private async Task CopyHash()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _commitHash);
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
