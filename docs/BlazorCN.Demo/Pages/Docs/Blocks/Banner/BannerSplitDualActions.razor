<section class="mx-auto w-full max-w-2xl p-4">
    <div class="grid grid-cols-1 overflow-hidden rounded-lg border sm:grid-cols-[1fr_1.5fr]">
        <div class="bg-foreground p-4 text-background">
            <p class="text-[10px] font-medium uppercase tracking-widest text-background/60">
                Choose a path
            </p>
            <p class="mt-2 text-sm font-semibold">Build or customise</p>
            <p class="mt-1 text-xs text-background/70 leading-relaxed">
                Pick the track that matches how you plan to ship this week.
            </p>
        </div>
        <div class="bg-card p-4">
            <p class="text-xs text-muted-foreground leading-relaxed">
                Start with prebuilt blocks to move quickly, or open the theme layer to restyle every
                primitive before you ship.
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                <a
                    href="#"
                    class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                    Browse blocks
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" aria-hidden="true" />
                </a>
                <a
                    href="#"
                    class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                    Open theme editor
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" aria-hidden="true" />
                </a>
            </div>
        </div>
    </div>
</section>
