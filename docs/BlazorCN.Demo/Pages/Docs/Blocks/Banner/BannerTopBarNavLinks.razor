@* ============================================================
   Block: banner-top-bar-nav-links
   Title: BannerTopBarNavLinks
   Description: A top bar banner for React and Next.js with inline dot-separated navigation links and a moving active underline indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar-nav-links.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="rounded-lg border bg-card">
        <nav aria-label="Section navigation" class="flex items-center justify-center gap-1 px-4 py-2.5">
            @for (int i = 0; i < _navItems.Length; i++)
            {
                var item = _navItems[i];
                var isActive = _active == item.Key;
                var index = i;
                <div class="flex items-center gap-1" @key="item.Key">
                    @if (index > 0)
                    {
                        <span aria-hidden="true" class="mx-1 text-muted-foreground/40 text-[10px]">&middot;</span>
                    }
                    <button
                        aria-current="@(isActive ? "page" : null)"
                        class="@ButtonClass(isActive)"
                        @onclick="@(() => _active = item.Key)"
                        type="button">
                        @item.Label
                        @if (isActive)
                        {
                            <span class="absolute inset-x-1 -bottom-0.5 h-px bg-foreground"></span>
                        }
                    </button>
                </div>
            }
        </nav>
    </div>
</section>

@code {
    private string _active = "overview";

    private record NavItem(string Key, string Label);

    private static readonly NavItem[] _navItems =
    [
        new("overview", "Overview"),
        new("features", "Features"),
        new("pricing", "Pricing"),
        new("docs", "Docs"),
        new("changelog", "Changelog"),
    ];

    private static string ButtonClass(bool isActive) =>
        Cn.Merge("relative px-1 py-0.5 text-xs transition-colors",
            isActive ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground");
}
