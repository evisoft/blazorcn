@* ============================================================
   Block: banner-numbered-social-proof
   Title: BannerNumberedSocialProof
   Description: A numbered list banner for React and Next.js presenting three recent community actions as numbered rows with truncated names quiet timestamps and arrow links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-numbered-social-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-2.5">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Latest activity
            </p>
        </div>
        <ol>
            @for (var i = 0; i < _activities.Length; i++)
            {
                var activity = _activities[i];
                var isLast = i == _activities.Length - 1;
                <li class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[10px] font-medium text-muted-foreground">
                        @activity.Id
                    </span>
                    <p class="min-w-0 flex-1 truncate text-sm text-foreground">
                        <span class="font-medium">@activity.Name</span>
                        <span class="text-muted-foreground"> @activity.Action</span>
                    </p>
                    <span class="shrink-0 text-xs text-muted-foreground">@activity.Time</span>
                    <a href="@activity.Href"
                       aria-label="@($"View activity by {activity.Name}")"
                       class="inline-flex size-5 shrink-0 items-center justify-center rounded text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3" aria-hidden="true" />
                    </a>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record Activity(int Id, string Name, string Action, string Time, string Href);

    private static readonly Activity[] _activities =
    [
        new(1, "Jamie Davis",  "joined the Pro waitlist",     "2 min ago",  "#"),
        new(2, "Alex Rivera",  "upgraded to the Team plan",   "14 min ago", "#"),
        new(3, "Morgan Park",  "starred the v4.0 release",    "38 min ago", "#"),
    ];
}
