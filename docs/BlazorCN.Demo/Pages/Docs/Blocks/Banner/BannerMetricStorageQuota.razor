@* ============================================================
   Block: banner-metric-storage-quota
   Title: BannerMetricStorageQuota
   Description: A progress metric banner for React and Next.js showing storage quota with a thin bar, tabular-nums readout, and inline upgrade link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-metric-storage-quota.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="hard-drive" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-medium text-foreground">Storage used</p>
                    <p class="text-sm font-semibold tabular-nums text-foreground">@_usedGb / @_totalGb GB</p>
                </div>
                <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div role="progressbar"
                         aria-label="Storage usage percentage"
                         aria-valuenow="@_percent"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         class="@($"h-full rounded-full transition-all duration-500 ease-out {_barClass}")"
                         style="@($"width:{_percent}%")">
                    </div>
                </div>
                <div class="mt-1.5 flex items-center justify-between gap-2">
                    <p class="text-xs text-muted-foreground">@((_totalGb - _usedGb).ToString("F1")) GB remaining on the Pro plan</p>
                    <a href="#"
                       class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        Upgrade
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const double _usedGb = 8.4;
    private const double _totalGb = 10;
    private static readonly int _percent = (int)Math.Round(_usedGb / _totalGb * 100);
    private static readonly string _barClass =
        _percent >= 95 ? "bg-red-500/80" : _percent >= 80 ? "bg-amber-500/80" : "bg-foreground";
}
