@* ============================================================
   Block: banner-alert-stacked
   Title: BannerAlertStacked
   Description: A vertically stacked set of semantic alert strip banners for React and Next.js showing error, warning, info, and success variants with refined 3px left border accents, inline arrow links, and individual dismiss controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-alert-stacked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex flex-col gap-2">
        @foreach (var alert in _alerts)
        {
            var config = _typeConfig[alert.Type];
            <div class="overflow-hidden">
                <div class="@($"flex items-start gap-3 rounded-lg border border-l-[3px] bg-card px-4 py-3 {config.Border}")">
                    <LucideIconCn Name="@config.IconName" Size="16" aria-hidden="true" Class="@($"mt-0.5 size-4 shrink-0 {config.IconClass}")" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium text-foreground">@alert.Title</p>
                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                            @alert.Description
                        </p>
                        <div class="mt-2">
                            <a
                                href="#"
                                class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                                @alert.ActionLabel
                                <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                            </a>
                        </div>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              @onclick="@(() => Dismiss(alert.Id))"
                              Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                              aria-label="@($"Dismiss {alert.Title}")">
                        <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>
        }
        @if (_alerts.Count == 0)
        {
            <div class="rounded-lg border bg-card px-4 py-3 text-center">
                <p class="text-xs text-muted-foreground">All alerts dismissed</p>
            </div>
        }
    </div>
</section>

@code {
    private record AlertItem(string Id, string Type, string Title, string Description, string ActionLabel);

    private record TypeConfig(string IconName, string Border, string IconClass);

    private static readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["error"]   = new TypeConfig("x-circle",       "border-l-red-500/80",     "text-red-500/90"),
        ["warning"] = new TypeConfig("alert-triangle",  "border-l-amber-500/80",   "text-amber-500/90"),
        ["info"]    = new TypeConfig("info",            "border-l-blue-500/80",    "text-blue-500/90"),
        ["success"] = new TypeConfig("check-circle",    "border-l-emerald-500/80", "text-emerald-500/90"),
    };

    private List<AlertItem> _alerts =
    [
        new("error-1",   "error",   "Payment method declined on April 10",
            "Update your billing information by April 14 to avoid a 7-day service interruption on the Pro plan.",
            "Update billing"),
        new("warning-1", "warning", "SSL certificate expires in 3 days",
            "Renew the certificate for api.acme.dev before April 14 to prevent downtime across all production traffic.",
            "Renew certificate"),
        new("info-1",    "info",    "Scheduled maintenance on April 18 at 02:00 UTC",
            "Expect 30 minutes of downtime between 02:00 and 02:30 UTC while we migrate the primary database.",
            "View status page"),
        new("success-1", "success", "DNS records propagated for acme.dev",
            "Your custom domain is now active across all 18 edge regions. No further action is required.",
            "Open dashboard"),
    ];

    private void Dismiss(string id)
    {
        _alerts = _alerts.Where(a => a.Id != id).ToList();
    }
}
