@* ============================================================
   Block: banner-live-services-status
   Title: BannerLiveServicesStatus
   Description: A live status indicator banner for React and Next.js with a pulsing emerald dot, overall status message, static last-checked label, and an inline arrow link to the status page built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-live-services-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <span aria-label="Live" class="relative mt-1.5 flex size-2 shrink-0" role="status">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/60 opacity-75"></span>
                <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">
                    All @_operationalCount of @_totalCount services operational
                </p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    API, dashboard, database, CDN, webhooks, and background workers are healthy. Last
                    checked 2 min ago.
                </p>
                <div class="mt-2.5">
                    <a
                        href="#"
                        class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        View status page
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int _operationalCount = 12;
    private const int _totalCount = 12;
}
