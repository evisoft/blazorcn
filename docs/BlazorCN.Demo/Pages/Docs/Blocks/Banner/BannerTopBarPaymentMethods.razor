@* ============================================================
   Block: banner-top-bar-payment-methods
   Title: BannerTopBarPaymentMethods
   Description: A compact top bar banner for React and Next.js showing accepted payment method tokens inline with a centered secure-checkout note and subtle lock icon built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center gap-3 rounded-lg border bg-card px-4 py-2.5">
        <div class="flex items-center gap-1.5">
            @foreach (var method in _methods)
            {
                <span aria-label="@method.Label"
                      role="img"
                      class="inline-flex h-5 w-8 items-center justify-center rounded border bg-muted/50 font-mono text-[9px] font-medium tracking-wider text-muted-foreground">
                    @method.Token
                </span>
            }
        </div>
        <p class="min-w-0 flex-1 text-center text-xs text-muted-foreground">
            <LucideIconCn Name="lock" Size="12" Class="mr-1 inline-block size-3 -translate-y-px text-muted-foreground" aria-hidden="true" />
            Secure checkout over TLS 1.3.&#160;
            <a href="#" class="font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                See all methods
            </a>
        </p>
    </div>
</section>

@code {
    private record PaymentMethod(string Id, string Label, string Token);

    private static readonly PaymentMethod[] _methods =
    [
        new("visa", "Visa", "VISA"),
        new("mc", "Mastercard", "MC"),
        new("amex", "American Express", "AMEX"),
        new("disc", "Discover", "DISC"),
        new("pp", "PayPal", "PP"),
    ];
}
