@* ============================================================
   Block: banner-collapsible-details
   Title: BannerCollapsibleDetails
   Description: An expandable banner for React and Next.js with a single-line summary header, smooth height animation reveal, and an affected services list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-collapsible-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <button
            type="button"
            @onclick="@(() => _open = !_open)"
            aria-expanded="@(_open ? "true" : "false")"
            aria-controls="incident-body"
            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
            <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-amber-500/90"></span>
            <p class="min-w-0 flex-1 truncate text-sm font-medium text-foreground">
                Elevated error rates in US-East since 14:32 UTC
            </p>
            <span class="shrink-0 text-[11px] font-medium text-muted-foreground tabular-nums">
                Investigating
            </span>
            <LucideIconCn Name="chevron-down" Size="16" aria-hidden="true" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground transition-transform duration-300 ease-out", _open ? "rotate-180" : "")" />
        </button>

        @if (_open)
        {
            <div id="incident-body" class="overflow-hidden">
                <div class="border-t px-4 py-3">
                    <p class="text-xs text-muted-foreground leading-relaxed">
                        Infrastructure team detected a 3.4x spike in p99 latency on write endpoints. Root
                        cause under investigation. Estimated resolution within the next 90 minutes.
                    </p>

                    <div class="mt-3">
                        <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            Affected services
                        </p>
                        <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5">
                            @foreach (var service in _affectedServices)
                            {
                                <li class="flex items-center gap-2 text-xs text-foreground">
                                    <span
                                        aria-hidden="true"
                                        class="@Cn.Merge("size-1.5 shrink-0 rounded-full", service.Status == "degraded" ? "bg-amber-500/90" : "bg-emerald-500/90")"></span>
                                    <span class="truncate">@service.Name</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="mt-3">
                        <a
                            href="#"
                            class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                            View status page
                            <LucideIconCn Name="chevron-down" Size="12" aria-hidden="true" Class="size-3 -rotate-90" />
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private bool _open = false;

    private record AffectedService(string Id, string Name, string Status);

    private static readonly AffectedService[] _affectedServices =
    [
        new("api", "API Gateway", "degraded"),
        new("auth", "Authentication", "operational"),
        new("db", "Database primary", "degraded"),
        new("cdn", "Edge CDN", "operational"),
    ];
}
