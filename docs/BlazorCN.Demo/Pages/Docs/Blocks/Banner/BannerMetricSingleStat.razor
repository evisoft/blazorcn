@* ============================================================
   Block: banner-metric-single-stat
   Title: BannerMetricSingleStat
   Description: A single-stat progress metric banner for React and Next.js with an icon, right-aligned tabular metric, a semantic progress bar, and a subtext line built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-metric-single-stat.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="users" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-medium text-foreground">@_label</p>
                    <p class="text-sm font-semibold tabular-nums text-foreground">
                        @_value
                        <span class="ml-1 text-xs font-normal text-muted-foreground tabular-nums">
                            / @_max
                        </span>
                    </p>
                </div>
                <div role="progressbar"
                     aria-label="@_label"
                     aria-valuenow="@_percent"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground transition-all duration-500"
                         style="@($"width:{_percent}%")">
                    </div>
                </div>
                <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">@_subtext</p>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _label   = "Monthly active users";
    private const string _value   = "12,847";
    private const string _max     = "15,000";
    private const int    _percent = 85;
    private const string _subtext = "1,294 new users this week vs 1,096 last week";
}
