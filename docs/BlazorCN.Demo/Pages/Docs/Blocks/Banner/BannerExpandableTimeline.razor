@* ============================================================
   Block: banner-expandable-timeline
   Title: BannerExpandableTimeline
   Description: An expandable summary banner for React and Next.js with a one-line current-stage header and a collapsible vertical timeline of completed and upcoming steps built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-expandable-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <button
            type="button"
            @onclick="@(() => _open = !_open)"
            aria-expanded="@(_open ? "true" : "false")"
            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
            <LucideIconCn Name="clock" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-foreground">@_activeStep.Label</p>
                <p class="mt-0.5 truncate text-xs text-muted-foreground">
                    Step 3 of 4 · Expected delivery Wed 14 Apr
                </p>
            </div>
            <LucideIconCn Name="chevron-down" Size="16" aria-hidden="true" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground transition-transform duration-200", _open ? "rotate-180" : "")" />
        </button>

        @if (_open)
        {
            <div class="overflow-hidden">
                <ol class="border-t px-4 py-4">
                    @foreach (var (step, index) in _steps.Select((s, i) => (s, i)))
                    {
                        var isLast = index == _steps.Length - 1;
                        <li class="relative flex gap-3 pb-4 last:pb-0">
                            @if (!isLast)
                            {
                                <span
                                    aria-hidden="true"
                                    class="@Cn.Merge("absolute left-[11px] top-6 bottom-0 w-px", step.Status == "completed" ? "bg-foreground/60" : "bg-border")"></span>
                            }
                            <span
                                aria-hidden="true"
                                class="@Cn.Merge("relative z-10 flex size-[22px] shrink-0 items-center justify-center rounded-full", step.Status == "completed" ? "bg-foreground text-background" : step.Status == "active" ? "border-2 border-foreground bg-card" : "border border-border bg-card")">
                                @if (step.Status == "completed")
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                @if (step.Status == "active")
                                {
                                    <span class="size-1.5 rounded-full bg-foreground"></span>
                                }
                            </span>
                            <div class="min-w-0 flex-1 pt-0.5">
                                <div class="flex items-baseline justify-between gap-2">
                                    <p class="@Cn.Merge("text-sm", step.Status == "upcoming" ? "text-muted-foreground" : "font-medium text-foreground")">
                                        @step.Label
                                    </p>
                                    <p class="shrink-0 text-[10px] font-medium uppercase tracking-widest text-muted-foreground tabular-nums">
                                        @step.Timestamp
                                    </p>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                                    @step.Detail
                                </p>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        }
    </div>
</section>

@code {
    private bool _open = false;

    private record TimelineStep(string Id, string Label, string Detail, string Timestamp, string Status);

    private static readonly TimelineStep[] _steps =
    [
        new("placed", "Order placed", "Payment authorized on card ending 4821.", "Mon 09:12", "completed"),
        new("processing", "Picked and packed", "Warehouse DE-02 packed 3 items into one parcel.", "Mon 14:47", "completed"),
        new("shipped", "In transit to Berlin hub", "DHL 00340434161094021732 — expected arrival Wed 18:00.", "Tue 08:05", "active"),
        new("delivered", "Out for delivery", "Estimated Wed 14 Apr between 10:00 and 14:00.", "—", "upcoming"),
    ];

    private TimelineStep _activeStep => _steps.FirstOrDefault(s => s.Status == "active") ?? _steps[0];
}
