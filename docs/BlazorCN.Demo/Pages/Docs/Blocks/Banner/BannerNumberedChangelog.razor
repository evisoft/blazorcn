@* ============================================================
   Block: banner-numbered-changelog
   Title: BannerNumberedChangelog
   Description: A numbered changelog list banner for React and Next.js with mono version digits, truncated entry titles, and trailing arrow links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-numbered-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-2.5">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Latest releases
            </p>
        </div>
        <ul class="divide-y">
            @foreach (var entry in _entries)
            {
                <li class="flex items-center gap-3 px-4 py-2.5">
                    <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[10px] font-medium text-muted-foreground">
                        @entry.Version
                    </span>
                    <p class="min-w-0 flex-1 truncate text-sm text-foreground">@entry.Title</p>
                    <a href="@entry.Href"
                       class="inline-flex shrink-0 items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                        Read
                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3" aria-hidden="true" />
                    </a>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Entry(string Id, string Version, string Title, string Href);

    private static readonly Entry[] _entries =
    [
        new("e1", "1", "v4.2.0 adds streaming responses and multi-model routing", "#"),
        new("e2", "2", "v4.1.3 patches a CSRF edge case in the OAuth callback", "#"),
        new("e3", "3", "v4.1.0 ships new chart primitives and tabular-nums metrics", "#"),
        new("e4", "4", "v4.0.0 introduces the theme API and tree-shakeable exports", "#"),
    ];
}
