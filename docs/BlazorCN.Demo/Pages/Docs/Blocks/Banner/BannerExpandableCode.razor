@* ============================================================
   Block: banner-expandable-code
   Title: BannerExpandableCode
   Description: An expandable banner for React and Next.js revealing a dark CLI install snippet with copy-to-clipboard on click, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-expandable-code.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <button
            type="button"
            @onclick="@(() => _open = !_open)"
            aria-expanded="@(_open ? "true" : "false")"
            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
            <LucideIconCn Name="terminal" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-muted-foreground" />
            <span class="min-w-0 flex-1 text-sm font-medium text-foreground">
                Install the Button component
            </span>
            <span class="hidden font-mono text-[10px] text-muted-foreground sm:inline">v4.0</span>
            <LucideIconCn Name="chevron-down" Size="16" aria-hidden="true" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground transition-transform duration-200", _open ? "rotate-180" : "")" />
        </button>

        @if (_open)
        {
            <div class="overflow-hidden">
                <div class="border-t px-4 py-3">
                    <p class="text-xs text-muted-foreground leading-relaxed">
                        Run the command below in your project root. Supports npm, pnpm, yarn, and bun via
                        the shadcn CLI v4.0.
                    </p>
                    <div class="mt-2.5 flex items-center gap-2">
                        <code class="min-w-0 flex-1 truncate rounded-md bg-zinc-950 px-3 py-1.5 font-mono text-xs text-zinc-300 dark:bg-zinc-900">
                            @_command
                        </code>
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="h-7 shrink-0 gap-1.5 text-xs"
                            OnClick="HandleCopy"
                            aria-label="Copy install command">
                            @if (_copied)
                            {
                                <LucideIconCn Name="check" Size="12" aria-hidden="true" Class="size-3" />
                                <text>Copied</text>
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" aria-hidden="true" Class="size-3" />
                                <text>Copy</text>
                            }
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private const string _command = "npx shadcn@latest add button";
    private bool _open = false;
    private bool _copied = false;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
