@* ============================================================
   Block: banner-countdown-session
   Title: BannerCountdownSession
   Description: A hydration-safe session countdown banner for React and Next.js with a ShieldAlert icon, monospace tabular countdown to a fixed expiry timestamp, and an extend session button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-countdown-session.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="shield-alert" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-amber-500/90" />
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-3">
                    <p class="text-sm font-medium text-foreground">
                        @(_expired ? "Session expired" : "Session ends soon")
                    </p>
                    <p aria-live="polite" class="shrink-0 font-mono text-sm font-semibold tabular-nums text-foreground">
                        @(_display.Minutes):@(_display.Seconds)
                    </p>
                </div>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Idle timeout enforced after 15 minutes without activity. Extend to keep unsaved
                    changes safe.
                </p>
                <div class="mt-2.5">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Extend session</ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly long _targetMs =
        new DateTimeOffset(2026, 4, 11, 23, 59, 0, TimeSpan.Zero).ToUnixTimeMilliseconds();

    private (string Minutes, string Seconds) _display = ("--", "--");
    private bool _expired;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        UpdateDisplay();
        _timer = new System.Threading.Timer(_ =>
        {
            UpdateDisplay();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void UpdateDisplay()
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var remaining = Math.Max(0L, _targetMs - now);
        _expired = remaining == 0;
        var totalSeconds = (int)(remaining / 1000);
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        _display = (minutes.ToString("D2"), seconds.ToString("D2"));
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
