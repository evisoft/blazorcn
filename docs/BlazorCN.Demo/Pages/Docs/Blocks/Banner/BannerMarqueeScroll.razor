@* ============================================================
   Block: banner-marquee-scroll
   Title: BannerMarqueeScroll
   Description: A marquee ticker banner for React and Next.js with an infinite horizontal scroll, doubled dataset, reduced-motion fallback, and edge-fade masks built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-marquee-scroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        <div class="flex py-3">
            <div class="banner-ticker-row flex shrink-0 items-center gap-6 whitespace-nowrap pr-6"
                 aria-live="off">
                @foreach (var item in _doubled)
                {
                    <span class="flex shrink-0 items-center gap-2 text-xs text-muted-foreground">
                        <span aria-hidden="true"
                              class="size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                        <span class="text-foreground/90">@item.Label</span>
                    </span>
                }
            </div>
        </div>

        <div aria-hidden="true"
             class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-card to-transparent"></div>
        <div aria-hidden="true"
             class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-card to-transparent"></div>

        <style>
            @@keyframes ticker-left {
                from { transform: translateX(0); }
                to { transform: translateX(-50%); }
            }
            .banner-ticker-row {
                animation: ticker-left 40s linear infinite;
            }
            @@media (prefers-reduced-motion: reduce) {
                .banner-ticker-row {
                    animation: none;
                }
            }
        </style>
    </div>
</section>

@code {
    private record TickerItem(string Id, string Label);

    private static readonly TickerItem[] _items =
    [
        new("v4", "v4.0 shipped — 50+ new components"),
        new("api", "API p95 latency down 32% this week"),
        new("region", "New region: ap-southeast-2 now live"),
        new("sso", "SSO with Okta and Entra in general availability"),
        new("theme", "Redesigned theme API with token overrides"),
        new("audit", "Audit log retention extended to 90 days"),
        new("webhook", "Webhook signing upgraded to Ed25519"),
        new("docs", "Docs rewritten for React 19 server components"),
    ];

    private static readonly TickerItem[] _doubled = [.. _items, .. _items];
}
