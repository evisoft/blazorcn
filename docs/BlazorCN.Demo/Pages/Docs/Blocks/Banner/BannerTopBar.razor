@* ============================================================
   Block: banner-top-bar
   Title: BannerTopBar
   Description: A top bar banner for React and Next.js with a single centered message line, inline underlined link, and a compact dismiss ghost button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-center gap-3 px-4 py-2.5">
                <p class="min-w-0 flex-1 text-center text-xs text-muted-foreground">
                    v4.0 is live with 50+ new components and tree-shakeable exports.&nbsp;
                    <a class="font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground"
                       href="#">
                        See the changelog
                    </a>
                </p>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          aria-label="Dismiss banner"
                          Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                          OnClick="@(() => _visible = false)">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
}
