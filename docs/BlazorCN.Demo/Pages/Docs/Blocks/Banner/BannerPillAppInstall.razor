@* ============================================================
   Block: banner-pill-app-install
   Title: BannerPillAppInstall
   Description: A floating pill banner for React and Next.js featuring a rounded-full container, inline app icon, compact pill install button, and dismiss control built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-pill-app-install.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="flex items-center justify-center">
            <div class="inline-flex items-center gap-3 rounded-full border bg-card px-4 py-2 shadow-lg">
                <LucideIconCn Name="smartphone" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-muted-foreground" />
                <p class="text-sm font-medium">Get the Acme app for 2x faster checkout</p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-6 rounded-full px-3 text-xs">
                    Install
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" @onclick="@(() => _visible = false)" Class="size-5 shrink-0 rounded-full p-0 text-muted-foreground hover:text-foreground" aria-label="Dismiss banner">
                    <LucideIconCn Name="x" Size="12" aria-hidden="true" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
}
