@* ============================================================
   Block: banner-pill-language-selector
   Title: BannerPillLanguageSelector
   Description: A floating pill language selector banner for React and Next.js with a rounded-full container, Globe icon, inline native locale label, and a compact pill popover of six languages built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-pill-language-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center">
        <div class="relative">
            <div class="inline-flex items-center gap-3 rounded-full border bg-card px-4 py-2 shadow-lg">
                <LucideIconCn Name="globe" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-muted-foreground" />
                <p class="text-sm font-medium text-foreground">@_current.NativeLabel</p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-6 gap-1 rounded-full px-3 text-xs"
                          aria-expanded="@(_open ? "true" : "false")"
                          aria-label="Change language"
                          @onclick="@(() => _open = !_open)">
                    @_current.Code.ToUpperInvariant()
                    <LucideIconCn Name="chevron-down" Size="12" aria-hidden="true" Class="@Cn.Merge("size-3 transition-transform duration-200", _open ? "rotate-180" : "")" />
                </ButtonCn>
            </div>
            @if (_open)
            {
                <div class="absolute right-0 top-full z-10 mt-2 w-48 overflow-hidden rounded-lg border bg-card shadow-lg">
                    @foreach (var locale in _locales)
                    {
                        <button class="flex w-full items-center gap-2 px-3 py-2 text-left transition-colors hover:bg-muted/50"
                                type="button"
                                @onclick="@(() => SelectLocale(locale.Code))">
                            <span class="min-w-0 flex-1">
                                <span class="text-xs font-medium text-foreground">@locale.Label</span>
                                <span class="ml-1.5 text-xs text-muted-foreground">@locale.NativeLabel</span>
                            </span>
                            @if (_selected == locale.Code)
                            {
                                <LucideIconCn Name="check" Size="14" aria-hidden="true" Class="size-3.5 shrink-0 text-foreground" />
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _selected = "en";
    private bool _open = false;

    private record Locale(string Code, string Label, string NativeLabel);

    private static readonly Locale[] _locales =
    [
        new("en", "English", "English"),
        new("es", "Spanish", "Espanol"),
        new("fr", "French", "Francais"),
        new("de", "German", "Deutsch"),
        new("ja", "Japanese", "Nihongo"),
        new("zh", "Chinese", "Zhongwen"),
    ];

    private Locale _current => _locales.FirstOrDefault(l => l.Code == _selected) ?? _locales[0];

    private void SelectLocale(string code)
    {
        _selected = code;
        _open = false;
    }
}
