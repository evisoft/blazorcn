@* ============================================================
   Block: banner-full-bleed-animated-outline
   Title: BannerFullBleedAnimatedOutline
   Description: A full-bleed inverted announcement banner for React and Next.js with a subtle animated outline accent, centered eyebrow and headline, and outline CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-full-bleed-animated-outline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <style>
        .banner-outline-shell {
            background: linear-gradient(90deg, transparent 0%, transparent 35%, hsl(var(--foreground) / 0.4) 50%, transparent 65%, transparent 100%);
            background-size: 200% 100%;
            animation: banner-outline-shimmer 6s linear infinite;
        }
        @@keyframes banner-outline-shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        @@media (prefers-reduced-motion: reduce) {
            .banner-outline-shell { animation: none; background: hsl(var(--foreground) / 0.2); }
        }
    </style>
    <div class="banner-outline-shell rounded-lg p-px">
        <div class="overflow-hidden rounded-[calc(0.5rem-1px)] bg-card">
            <div class="bg-foreground px-4 py-8 text-background">
                <div class="mx-auto max-w-lg text-center">
                    <p class="text-[10px] font-medium uppercase tracking-widest text-background/60">
                        Launch week
                    </p>
                    <p class="mt-2 text-sm font-semibold">
                        v4.0 ships April 18 with 50+ new components
                    </p>
                    <p class="mt-1.5 text-xs text-background/70 leading-relaxed">
                        Tree-shakeable exports, a new theme API, and 30% faster builds. Watch the keynote
                        live at 09:00 UTC.
                    </p>
                    <div class="mt-4 flex items-center justify-center">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                                  Class="h-8 gap-1 border-background/20 bg-transparent text-xs text-background hover:bg-background/10 hover:text-background">
                            Watch keynote
                            <LucideIconCn Name="arrow-right" aria-hidden="true" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
