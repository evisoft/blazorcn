@* ============================================================
   Block: banner-pill-quick-actions
   Title: BannerPillQuickActions
   Description: A floating pill banner for React and Next.js with an inline icon, a one-line message, and a compact rounded action button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-pill-quick-actions.tsx
   ============================================================ *@

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="flex items-center justify-center">
            <div class="inline-flex items-center gap-3 rounded-full border bg-card px-4 py-2 shadow-lg">
                <LucideIconCn Name="sparkles" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-muted-foreground" />
                <p class="text-sm font-medium text-foreground">
                    AI search preview is live for Team plans
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-6 rounded-full px-3 text-xs">
                    Try it
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          OnClick="@(() => _visible = false)"
                          aria-label="Dismiss banner"
                          Class="size-5 shrink-0 rounded-full p-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="x" Size="12" aria-hidden="true" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private bool _visible = true;
}
