@* ============================================================
   Block: banner-multi-action-cookie-consent
   Title: BannerMultiActionCookieConsent
   Description: A multi-action cookie consent banner for React and Next.js with a Cookie icon, specific privacy copy, and a three-button action stack for accepting all, managing preferences, or declining non-essential cookies built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-cookie-consent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="cookie" Size="16" aria-hidden="true" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-foreground">
                        We use cookies for analytics and personalization
                    </p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                        Essential cookies keep you signed in. Analytics and marketing cookies help us
                        improve the product. You can change this anytime in settings.
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <ButtonCn Class="h-7 text-xs" @onclick="@(() => _visible = false)" Size="ButtonSize.Sm">
                            Accept all
                        </ButtonCn>
                        <ButtonCn
                            Class="h-7 text-xs"
                            @onclick="@(() => _visible = false)"
                            Size="ButtonSize.Sm"
                            Variant="ButtonVariant.Outline">
                            Manage preferences
                        </ButtonCn>
                        <ButtonCn
                            Class="h-7 text-xs text-muted-foreground"
                            @onclick="@(() => _visible = false)"
                            Size="ButtonSize.Sm"
                            Variant="ButtonVariant.Ghost">
                            Decline
                        </ButtonCn>
                    </div>
                </div>
                <ButtonCn
                    aria-label="Dismiss banner"
                    Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                    @onclick="@(() => _visible = false)"
                    Size="ButtonSize.Sm"
                    Variant="ButtonVariant.Ghost">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
}
