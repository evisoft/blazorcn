@* ============================================================
   Block: banner-ribbon-achievement
   Title: BannerRibbonAchievement
   Description: A ribbon corner accent banner for React and Next.js with a diagonal monochrome ribbon over a stacked centered card announcing a milestone unlock built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-ribbon-achievement.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        @* Corner ribbon *@
        <div
            aria-hidden="true"
            class="-rotate-45 absolute top-[14px] left-[-36px] bg-foreground px-10 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-background">
            Unlocked
        </div>

        @* Stacked centered content *@
        <div class="flex flex-col items-center px-6 py-6 text-center">
            <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="trophy" Size="20" aria-hidden="true" Class="size-5 text-muted-foreground" />
            </div>
            <p class="mt-3 text-sm font-medium text-foreground">
                First Deploy achievement earned
            </p>
            <p class="mt-1 max-w-xs text-xs text-muted-foreground leading-relaxed">
                You shipped your first project to production on April 11. Two more milestones remain on
                the current streak.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 text-xs">
                View details
            </ButtonCn>
        </div>
    </div>
</section>
