<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="bg-foreground px-4 py-8 text-background">
            <div class="mx-auto max-w-lg text-center">
                <p class="text-[10px] font-medium uppercase tracking-widest text-background/60">
                    Platform update
                </p>
                <p class="mt-2 text-sm font-medium">
                    AI-assisted code review is rolling out on April 18
                </p>
                <p class="mt-1.5 text-xs text-background/70 leading-relaxed">
                    Every pull request now ships with inline suggestions, drift detection, and a one-click
                    apply. Available on Team and Enterprise plans.
                </p>
                <div class="mt-4 flex items-center justify-center">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 border-background/20 bg-transparent text-xs text-background hover:bg-background/10 hover:text-background">
                        See the release notes
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>
