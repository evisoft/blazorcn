@* ============================================================
   Block: banner-countdown-flash-sale
   Title: BannerCountdownFlashSale
   Description: A hydration-safe flash sale countdown banner for React and Next.js with a hardcoded target timestamp, client-only interval ticking, tabular number blocks, and an inline claim action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-countdown-flash-sale.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="clock" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">Early-bird pricing ends June 15</p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Lock in 40% off the Team plan before the launch rate expires. No code required at
                    checkout.
                </p>
                <div role="timer"
                     aria-label="Time remaining until sale ends"
                     class="mt-2.5 flex items-center gap-1.5">
                    @foreach (var unit in _units)
                    {
                        <div class="flex items-baseline gap-0.5 rounded-md border bg-muted/50 px-2 py-1 font-mono text-xs tabular-nums">
                            <span class="font-semibold text-foreground">@GetValue(unit.Key)</span>
                            <span class="text-[10px] text-muted-foreground">@unit.Label</span>
                        </div>
                    }
                </div>
                <div class="mt-2.5">
                    <a href="#"
                       class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        Claim the offer
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly DateTime _targetTimestamp = new DateTime(2026, 6, 15, 0, 0, 0, DateTimeKind.Utc);

    private record Unit(string Key, string Label);

    private static readonly Unit[] _units =
    [
        new("days", "d"),
        new("hours", "h"),
        new("mins", "m"),
        new("secs", "s"),
    ];

    private string _days = "--";
    private string _hours = "--";
    private string _mins = "--";
    private string _secs = "--";

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Update();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { Update(); StateHasChanged(); }), null, 1000, 1000);
    }

    private void Update()
    {
        var diff = _targetTimestamp - DateTime.UtcNow;
        var totalSeconds = (long)Math.Max(0, diff.TotalSeconds);
        var days = totalSeconds / 86400;
        var hours = (totalSeconds % 86400) / 3600;
        var mins = (totalSeconds % 3600) / 60;
        var secs = totalSeconds % 60;
        _days = days.ToString().PadLeft(2, '0');
        _hours = hours.ToString().PadLeft(2, '0');
        _mins = mins.ToString().PadLeft(2, '0');
        _secs = secs.ToString().PadLeft(2, '0');
    }

    private string GetValue(string key) => key switch
    {
        "days" => _days,
        "hours" => _hours,
        "mins" => _mins,
        "secs" => _secs,
        _ => "--"
    };

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
