<section class="mx-auto w-full max-w-2xl p-4">
    <div class="rounded-lg border bg-card">
        <div class="flex items-center gap-3 px-4 py-2.5">
            <AvatarCn>
                <AvatarFallbackCn Class="bg-muted font-medium text-[10px]">AC</AvatarFallbackCn>
            </AvatarCn>
            <p class="min-w-0 flex-1 truncate text-xs text-muted-foreground">
                You are in <span class="font-medium text-foreground">Acme Corp</span>
            </p>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 shrink-0 px-1.5 font-normal text-[10px]">
                Owner
            </BadgeCn>
            <span aria-hidden="true" class="h-3 w-px shrink-0 bg-border"></span>
            <a class="inline-flex shrink-0 items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground"
               href="#">
                Switch
                <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
            </a>
        </div>
    </div>
</section>
