@* ============================================================
   Block: banner-multi-action-feedback-prompt
   Title: BannerMultiActionFeedbackPrompt
   Description: A multi-action feedback prompt banner for React and Next.js with a flask icon, title and description, and a row of thumbs up, thumbs down, and send feedback buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-feedback-prompt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="flask-conical" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">
                    Experiment 27 is in beta until April 30
                </p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Tell us whether the new inline filters work for you. Your response is tagged to this
                    feature flag and helps us decide whether to graduate it next sprint.
                </p>
                <div class="mt-3 flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm"
                              Class="h-7 gap-1.5 text-xs"
                              @onclick="@(() => _vote = _vote == "up" ? null : "up")"
                              aria-pressed="@(_vote == "up" ? "true" : "false")">
                        <LucideIconCn Name="thumbs-up" Size="12" aria-hidden="true" Class="size-3" />
                        Useful
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1.5 text-xs"
                              @onclick="@(() => _vote = _vote == "down" ? null : "down")"
                              aria-pressed="@(_vote == "down" ? "true" : "false")">
                        <LucideIconCn Name="thumbs-down" Size="12" aria-hidden="true" Class="size-3" />
                        Not for me
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1.5 text-xs text-muted-foreground">
                        <LucideIconCn Name="message-square" Size="12" aria-hidden="true" Class="size-3" />
                        Send detail
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _vote = null;
}
