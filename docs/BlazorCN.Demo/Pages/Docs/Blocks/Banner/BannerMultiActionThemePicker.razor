@* ============================================================
   Block: banner-multi-action-theme-picker
   Title: BannerMultiActionThemePicker
   Description: A multi-action theme picker banner for React and Next.js with an icon header, six swatch buttons, an apply action, and a reset ghost built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-theme-picker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucideIconCn Name="palette" Size="16" aria-hidden="true" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-medium text-foreground">Pick an accent color</p>
                    <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground">
                        @ActiveLabel
                    </span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Preview six accents for buttons, links, and focus rings. Applies site-wide until you
                    change it.
                </p>
                <div class="mt-2.5 flex items-center gap-2">
                    @foreach (var theme in _themes)
                    {
                        var isActive = _selected == theme.Key;
                        <button aria-label="@($"Select {theme.Label} accent")"
                                aria-pressed="@isActive.ToString().ToLower()"
                                class="@Cn.Merge("size-5 rounded-full transition-all", theme.Swatch, isActive ? "ring-2 ring-foreground ring-offset-2 ring-offset-card" : "hover:ring-1 hover:ring-muted-foreground/40 hover:ring-offset-1 hover:ring-offset-card")"
                                type="button"
                                @onclick="@(() => _selected = theme.Key)">
                        </button>
                    }
                </div>
                <div class="mt-3 flex items-center gap-2">
                    <ButtonCn Class="h-7 text-xs"
                              Disabled="@(!Dirty)"
                              Size="ButtonSize.Sm"
                              @onclick="@(() => _applied = _selected)">
                        Apply accent
                    </ButtonCn>
                    <ButtonCn Class="h-7 text-xs"
                              Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Outline"
                              @onclick="@(() => _selected = _applied)">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Class="h-7 text-xs text-muted-foreground"
                              Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Ghost"
                              @onclick="@(() => { _selected = DefaultKey; _applied = DefaultKey; })">
                        Reset
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ThemeColor(string Key, string Label, string Swatch);

    private const string DefaultKey = "zinc";

    private static readonly ThemeColor[] _themes =
    [
        new("zinc",    "Zinc",    "bg-zinc-500"),
        new("rose",    "Rose",    "bg-rose-500/90"),
        new("blue",    "Blue",    "bg-blue-500/90"),
        new("emerald", "Emerald", "bg-emerald-500/90"),
        new("amber",   "Amber",   "bg-amber-500/90"),
        new("violet",  "Violet",  "bg-violet-500/90"),
    ];

    private string _selected = DefaultKey;
    private string _applied  = DefaultKey;

    private string ActiveLabel => _themes.FirstOrDefault(t => t.Key == _selected)?.Label ?? "Zinc";
    private bool   Dirty       => _selected != _applied;
}
