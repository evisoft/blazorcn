@* ============================================================
   Block: banner-top-bar-dismissible
   Title: BannerTopBarDismissible
   Description: A compact single-line top bar banner for React and Next.js with centered message, inline link, and a quiet ghost dismiss button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar-dismissible.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-center gap-3 px-4 py-2.5">
                <p class="min-w-0 flex-1 truncate text-center text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">v4.0 is live.</span> 50+ new
                    components, tree-shakeable exports, and a rewritten theme API.&nbsp;
                    <a
                        href="#"
                        class="inline-flex items-center gap-1 font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        See what&apos;s new
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </p>
                <button
                    type="button"
                    @onclick="@(() => _visible = false)"
                    aria-label="Dismiss banner"
                    class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </button>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
}
