@* ============================================================
   Block: banner-pill-theme-toggle
   Title: BannerPillThemeToggle
   Description: A compact floating pill banner for React and Next.js with sun and moon icons flanking an inline theme switch and shadow-lg lift built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-pill-theme-toggle.tsx
   ============================================================ *@

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="flex items-center justify-center">
            <div class="inline-flex items-center gap-3 rounded-full border bg-card px-4 py-2 shadow-lg">
                <LucideIconCn Name="sun" Size="16" aria-hidden="true"
                              Class="@Cn.Merge("size-4 shrink-0 transition-colors", _isDark ? "text-muted-foreground/40" : "text-amber-500/90")" />
                <SwitchCn @bind-Value="_isDark" aria-label="Toggle dark mode" Class="scale-90" />
                <LucideIconCn Name="moon" Size="16" aria-hidden="true"
                              Class="@Cn.Merge("size-4 shrink-0 transition-colors", _isDark ? "text-blue-500/90" : "text-muted-foreground/40")" />
                <span class="text-sm font-medium text-foreground">
                    @(_isDark ? "Dark" : "Light") mode
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="size-5 shrink-0 rounded-full p-0 text-muted-foreground hover:text-foreground"
                          aria-label="Dismiss banner"
                          OnClick="@(() => _visible = false)">
                    <LucideIconCn Name="x" Size="12" aria-hidden="true" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private bool _isDark = false;
    private bool _visible = true;
}
