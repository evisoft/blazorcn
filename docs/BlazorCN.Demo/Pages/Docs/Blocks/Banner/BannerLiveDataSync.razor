<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <span role="status" aria-label="Live" class="relative mt-1.5 flex size-2">
                <span aria-hidden="true"
                      class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/60 opacity-75"></span>
                <span aria-hidden="true"
                      class="relative inline-flex size-2 rounded-full bg-emerald-500/90"></span>
            </span>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">
                    Warehouse sync healthy across 3 sources
                </p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Last sync 2 min ago · 1,248 records reconciled · next run in 3 min
                </p>
            </div>
            <a href="#"
               class="mt-0.5 inline-flex shrink-0 items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                View log
                <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
            </a>
        </div>
    </div>
</section>
