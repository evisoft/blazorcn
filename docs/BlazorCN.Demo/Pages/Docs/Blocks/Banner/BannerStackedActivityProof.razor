@* ============================================================
   Block: banner-stacked-activity-proof
   Title: BannerStackedActivityProof
   Description: A stacked centered banner for React and Next.js with overlapping avatar group, recent activity headline, and a primary action button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-stacked-activity-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center px-6 py-6 text-center">
            <AvatarGroupCn>
                @foreach (var user in _recentUsers)
                {
                    <AvatarCn Class="size-8 rounded-full">
                        <AvatarFallbackCn Class="bg-muted text-[10px] font-medium text-muted-foreground">
                            @user.Initials
                        </AvatarFallbackCn>
                    </AvatarCn>
                }
            </AvatarGroupCn>

            <p class="mt-3 text-sm font-medium text-foreground">
                Sarah K. just upgraded to the Team plan
            </p>
            <p class="mt-1 max-w-xs text-xs text-muted-foreground leading-relaxed">
                Join the 142 teams who upgraded this week. Annual billing saves two months and unlocks
                shared workspaces.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                See upgrade options
                <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ActivityUser(string Id, string Initials);

    private static readonly ActivityUser[] _recentUsers =
    [
        new("u1", "SK"),
        new("u2", "MR"),
        new("u3", "JL"),
        new("u4", "AT"),
    ];
}
