@* ============================================================
   Block: banner-countdown-event
   Title: BannerCountdownEvent
   Description: A hydration-safe event countdown banner for React and Next.js with live days hours minutes seconds, a calendar icon, and a compact register link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-countdown-event.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="calendar" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-3">
                    <p class="min-w-0 flex-1 truncate text-sm font-medium text-foreground">
                        @EventName
                    </p>
                    <p class="shrink-0 font-mono text-sm tabular-nums">
                        @if (_started)
                        {
                            <span class="font-semibold text-foreground">Live now</span>
                        }
                        else
                        {
                            <span class="font-semibold text-foreground">@_display.days</span>
                            <span class="text-muted-foreground">d </span>
                            <span class="font-semibold text-foreground">@_display.hours</span>
                            <span class="text-muted-foreground">h </span>
                            <span class="font-semibold text-foreground">@_display.mins</span>
                            <span class="text-muted-foreground">m </span>
                            <span class="font-semibold text-foreground">@_display.secs</span>
                            <span class="text-muted-foreground">s</span>
                        }
                    </p>
                </div>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    @EventMeta. Registration closes one hour before the opening keynote.
                </p>
                <div class="mt-2">
                    <a
                        href="#"
                        class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        @(_started ? "Join the stream" : "Reserve your seat")
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly DateTime _targetTime = new DateTime(2026, 6, 15, 16, 0, 0, DateTimeKind.Utc);
    private const string EventName = "React Summit 2026";
    private const string EventMeta = "June 15 in San Francisco";

    private long _remainingMs;
    private System.Threading.Timer? _timer;

    private bool _started => _remainingMs == 0;

    private (string days, string hours, string mins, string secs) _display =>
        FormatRemaining(_remainingMs);

    protected override void OnInitialized()
    {
        UpdateRemaining();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    UpdateRemaining();
                    StateHasChanged();
                });
            }, null, 1000, 1000);
        }
    }

    private void UpdateRemaining()
    {
        var ms = (long)((_targetTime - DateTime.UtcNow).TotalMilliseconds);
        _remainingMs = Math.Max(0, ms);
    }

    private static (string days, string hours, string mins, string secs) FormatRemaining(long ms)
    {
        var totalSeconds = ms / 1000;
        var days = totalSeconds / 86400;
        var hours = (totalSeconds % 86400) / 3600;
        var mins = (totalSeconds % 3600) / 60;
        var secs = totalSeconds % 60;
        return (
            days.ToString().PadLeft(2, '0'),
            hours.ToString().PadLeft(2, '0'),
            mins.ToString().PadLeft(2, '0'),
            secs.ToString().PadLeft(2, '0')
        );
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
