   Block: banner-live-connectivity
   Title: BannerLiveConnectivity
   Description: A live connectivity status banner for React and Next.js with a pulsing emerald dot indicator, one-line status message, last-checked timestamp, and inline retry link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-live-connectivity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <span
                aria-label="Live connection"
                class="relative mt-1.5 flex size-2 shrink-0"
                role="status">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/60 opacity-75"></span>
                <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">Connected to realtime sync</p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Last checked 14 seconds ago from the us-east-1 edge. Changes propagate in under 300ms.
                </p>
                <div class="mt-2">
                    <a
                        href="#"
                        class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        View status page
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
            <p class="shrink-0 font-mono text-[10px] uppercase tracking-widest text-muted-foreground">
                Live
            </p>
        </div>
    </div>
</section>
