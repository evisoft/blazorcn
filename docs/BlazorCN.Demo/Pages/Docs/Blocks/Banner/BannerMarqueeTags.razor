@* ============================================================
   Block: banner-marquee-tags
   Title: BannerMarqueeTags
   Description: A marquee tags ticker banner for React and Next.js with an infinite horizontal scroll of tag pills, trending dot accents, and edge fade masks built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-marquee-tags.tsx
   ============================================================ *@

<style>
@@keyframes banner-tags-ticker {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
.banner-tags-ticker-row {
  animation: banner-tags-ticker 40s linear infinite;
}
@@media (prefers-reduced-motion: reduce) {
  .banner-tags-ticker-row { animation: none; }
}
</style>

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <LucideIconCn Name="trending-up" Size="14" aria-hidden="true" Class="size-3.5 text-muted-foreground" />
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Trending topics
            </p>
        </div>
        <div class="relative overflow-hidden py-3">
            <div class="banner-tags-ticker-row flex w-max gap-2">
                @foreach (var (tag, i) in _doubled.Select((t, i) => (t, i)))
                {
                    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border bg-muted/30 px-3 py-1 text-xs text-muted-foreground">
                        @if (tag.Trending)
                        {
                            <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500/80"></span>
                        }
                        @tag.Label
                    </span>
                }
            </div>
            <div aria-hidden="true"
                 class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-card to-transparent">
            </div>
            <div aria-hidden="true"
                 class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-card to-transparent">
            </div>
        </div>
    </div>
</section>

@code {
    private record TagItem(string Id, string Label, bool Trending);

    private static readonly TagItem[] _items =
    [
        new("1",  "React 19",             true),
        new("2",  "Next.js App Router",   true),
        new("3",  "Server Components",    false),
        new("4",  "Tailwind v4",          true),
        new("5",  "TypeScript",           false),
        new("6",  "Edge runtimes",        true),
        new("7",  "Streaming SSR",        false),
        new("8",  "Partial Prerendering", true),
        new("9",  "Auth.js",              false),
        new("10", "Drizzle ORM",          false),
        new("11", "tRPC",                 false),
        new("12", "Zustand",              false),
        new("13", "Vitest",               false),
        new("14", "Playwright",           false),
    ];

    private static readonly TagItem[] _doubled = [.. _items, .. _items];
}
