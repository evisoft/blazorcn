@* ============================================================
   Block: banner-multi-action-consent-granular
   Title: BannerMultiActionConsentGranular
   Description: A multi-action consent banner for React and Next.js with four category rows, inline Switch toggles, and a primary plus outline action pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-consent-granular.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">
                    Choose which cookies you allow on this site
                </p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    We comply with GDPR and ePrivacy. Toggle each category below. Essential cookies remain
                    on so the site keeps working.
                </p>
            </div>
        </div>

        <div class="border-t">
            @foreach (var (category, index) in _categories.Select((c, i) => (c, i)))
            {
                var isLast = index == _categories.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium text-foreground">@category.Label</p>
                            @if (category.Required)
                            {
                                <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                    Required
                                </span>
                            }
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                            @category.Description
                        </p>
                    </div>
                    <SwitchCn Checked="@_consent[category.Id]"
                              Disabled="@category.Required"
                              CheckedChanged="@(_ => Toggle(category.Id))" />
                </div>
            }
        </div>

        <div class="flex items-center justify-end gap-2 border-t bg-muted/30 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Class="h-7 text-xs"
                      @onclick="AcceptAll">
                Accept all
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm"
                      Class="h-7 text-xs"
                      @onclick="SavePreferences">
                Save preferences
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ConsentCategory(string Id, string Label, string Description, bool Required = false);

    private static readonly ConsentCategory[] _categories =
    [
        new("essential", "Essential", "Session, CSRF, and auth cookies required for the site to function.", Required: true),
        new("analytics", "Analytics", "Anonymous page view and interaction metrics used to improve the product."),
        new("marketing", "Marketing", "Third-party pixels for retargeting and campaign attribution."),
        new("functional", "Functional", "Remembers language, theme, and layout preferences across visits."),
    ];

    private Dictionary<string, bool> _consent = new()
    {
        ["essential"] = true,
        ["analytics"] = false,
        ["marketing"] = false,
        ["functional"] = true,
    };

    private void Toggle(string id)
    {
        _consent[id] = !_consent[id];
    }

    private void AcceptAll()
    {
        _consent = new()
        {
            ["essential"] = true,
            ["analytics"] = true,
            ["marketing"] = true,
            ["functional"] = true,
        };
    }

    private void SavePreferences()
    {
        // Preferences saved — extend as needed
    }
}
