@* ============================================================
   Block: banner-alert-toggle-setting
   Title: BannerAlertToggleSetting
   Description: An alert strip banner for React and Next.js with a muted blue left border, info icon, tight title and description, and an inline shadcn/ui Switch setting control built with Tailwind CSS
   Source: original/blocks/banner/banner-alert-toggle-setting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-start gap-3 overflow-hidden rounded-lg border border-l-[3px] border-l-blue-500/80 bg-card px-4 py-3">
        <LucideIconCn Name="bell" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-blue-500/90" />
        <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-foreground">
                Deployment notifications are available
            </p>
            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                Enable to receive an email within 30 seconds of any deployment completing or failing on
                this project.
            </p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            <span aria-hidden="true"
                  class="@Cn.Merge("text-[10px] font-medium uppercase tracking-widest tabular-nums", _enabled ? "text-foreground" : "text-muted-foreground")">
                @(_enabled ? "On" : "Off")
            </span>
            <SwitchCn Checked="@_enabled"
                      CheckedChanged="@(v => _enabled = v)"
                      aria-label="Toggle deployment notifications" />
        </div>
    </div>
</section>

@code {
    private bool _enabled = false;
}
