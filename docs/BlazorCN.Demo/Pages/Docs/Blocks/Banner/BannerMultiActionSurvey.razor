@* ============================================================
   Block: banner-multi-action-survey
   Title: BannerMultiActionSurvey
   Description: A multi-action survey prompt banner for React and Next.js with title description and three inline sentiment buttons for quick one-click feedback built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-survey.tsx
   ============================================================ *@

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <LucideIconCn Name="message-square" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    @if (_selected == null)
                    {
                        <p class="text-sm font-medium text-foreground">
                            How was the new dashboard experience?
                        </p>
                        <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                            Takes 2 seconds. Your answer goes straight to the team shipping the redesign.
                        </p>
                        <div class="mt-3 flex items-center gap-2">
                            <ButtonCn Size="ButtonSize.Sm"
                                      Class="h-7 text-xs"
                                      @onclick="@(() => _selected = _options[2].Value)">
                                @_options[2].Label
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 text-xs"
                                      @onclick="@(() => _selected = _options[1].Value)">
                                @_options[1].Label
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 text-xs text-muted-foreground"
                                      @onclick="@(() => _selected = _options[0].Value)">
                                @_options[0].Label
                            </ButtonCn>
                        </div>
                    }
                    else
                    {
                        <div role="status">
                            <p class="text-sm font-medium text-foreground">Thanks for the feedback</p>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                                We logged your rating and will use it to prioritize next week's dashboard
                                work.
                            </p>
                        </div>
                    }
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          @onclick="@(() => _visible = false)"
                          Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                          aria-label="Dismiss banner">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private record SurveyOption(string Id, string Label, int Value);

    private static readonly SurveyOption[] _options =
    [
        new("bad", "Needs work", 1),
        new("ok", "It's okay", 2),
        new("good", "Love it", 3),
    ];

    private bool _visible = true;
    private int? _selected = null;
}
