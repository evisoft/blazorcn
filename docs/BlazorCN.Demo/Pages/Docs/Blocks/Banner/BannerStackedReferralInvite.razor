@* ============================================================
   Block: banner-stacked-referral-invite
   Title: BannerStackedReferralInvite
   Description: A stacked centered referral banner for React and Next.js with a rounded icon container, muted badge, title and description stack, and a compact primary share button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-stacked-referral-invite.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex flex-col items-center rounded-lg border bg-card px-6 py-6 text-center">
        <div class="flex size-10 items-center justify-center rounded-full bg-muted">
            <LucideIconCn Name="gift" Size="20" aria-hidden="true" Class="size-5 text-muted-foreground" />
        </div>
        <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-3 font-normal text-[10px] uppercase tracking-widest">
            Referral
        </BadgeCn>
        <p class="mt-2 text-sm font-medium text-foreground">
            Give @_rewardAmount, get @_rewardAmount when a friend subscribes
        </p>
        <p class="mt-1 max-w-xs text-xs text-muted-foreground leading-relaxed">
            Credits land in both accounts within 24 hours of the first paid invoice. No cap on the
            number of invites.
        </p>
        <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
            <LucideIconCn Name="share-2" Size="12" aria-hidden="true" Class="size-3" />
            Share invite link
        </ButtonCn>
    </div>
</section>

@code {
    private const string _rewardAmount = "$10";
}
