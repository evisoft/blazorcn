@* ============================================================
   Block: banner-alert-warning
   Title: BannerAlertWarning
   Description: A warning alert strip banner for React and Next.js with a refined amber left border, AlertTriangle icon, title plus description, and an inline fix action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-alert-warning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="overflow-hidden rounded-lg border border-l-[3px] border-l-amber-500/80 bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <LucideIconCn Name="alert-triangle" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-amber-500/90" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-foreground">
                        Storage is 92% full on the Pro 10 GB plan
                    </p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                        New uploads will be blocked once you hit 10 GB. Free up 800 MB or upgrade to Team
                        before April 18 to avoid interruption.
                    </p>
                    <div class="mt-2.5">
                        <a
                            href="#"
                            class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                            Free up space
                            <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                        </a>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          @onclick="@(() => _visible = false)"
                          Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                          aria-label="Dismiss banner">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
}
