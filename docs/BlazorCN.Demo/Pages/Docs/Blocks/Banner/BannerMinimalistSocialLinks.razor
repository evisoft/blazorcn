@* ============================================================
   Block: banner-minimalist-social-links
   Title: BannerMinimalistSocialLinks
   Description: An ultra-minimal text banner for React and Next.js presenting social platforms as an inline list of underlined text links separated by dot glyphs with no icons or buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-minimalist-social-links.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="rounded-lg border bg-card px-4 py-3 text-center">
        <p class="text-xs text-muted-foreground leading-relaxed">
            Follow along on&#160;
            @for (int i = 0; i < _platforms.Length; i++)
            {
                var platform = _platforms[i];
                <span>
                    <a href="@platform.Href"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        @platform.Label
                    </a>
                    @if (i < _platforms.Length - 1)
                    {
                        <span aria-hidden="true" class="mx-1.5 text-muted-foreground/60">&#183;</span>
                    }
                </span>
            }
            .
        </p>
    </div>
</section>

@code {
    private record Platform(string Id, string Label, string Href);

    private static readonly Platform[] _platforms =
    [
        new("x",       "X",       "#"),
        new("gh",      "GitHub",  "#"),
        new("discord", "Discord", "#"),
        new("youtube", "YouTube", "#"),
        new("rss",     "RSS",     "#"),
    ];
}
