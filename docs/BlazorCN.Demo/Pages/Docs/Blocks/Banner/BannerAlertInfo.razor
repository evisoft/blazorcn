<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-l-[3px] border-l-blue-500/80 bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="info" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-blue-500/90" />
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">
                    Two-factor authentication becomes mandatory on April 18
                </p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Admins without 2FA enabled will lose dashboard access at 00:00 UTC. Set up an
                    authenticator app or hardware key to avoid a lockout.
                </p>
                <div class="mt-2.5">
                    <a href="#"
                       class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        Set up 2FA
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
