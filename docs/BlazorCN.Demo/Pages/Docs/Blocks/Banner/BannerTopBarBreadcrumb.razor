@* ============================================================
   Block: banner-top-bar-breadcrumb
   Title: BannerTopBarBreadcrumb
   Description: A compact top bar banner for React and Next.js rendering a single-line breadcrumb trail with chevron separators, inline links, and a current-page label built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar-breadcrumb.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center gap-2 rounded-lg border bg-card px-4 py-2.5">
        <LucideIconCn Name="home" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
        <nav aria-label="Breadcrumb" class="min-w-0 flex-1 overflow-hidden">
            <ol class="flex min-w-0 items-center gap-1.5">
                @foreach (var (crumb, index) in _crumbs.Select((c, i) => (c, i)))
                {
                    var isLast = index == _crumbs.Length - 1;
                    <li class="flex min-w-0 items-center gap-1.5">
                        @if (isLast || crumb.Href == null)
                        {
                            <span aria-current="page" class="truncate text-xs font-medium text-foreground">
                                @crumb.Label
                            </span>
                        }
                        else
                        {
                            <a href="@crumb.Href" class="truncate text-xs text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline">
                                @crumb.Label
                            </a>
                        }
                        @if (!isLast)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" aria-hidden="true" />
                        }
                    </li>
                }
            </ol>
        </nav>
    </div>
</section>

@code {
    private record Crumb(string Id, string Label, string? Href);

    private static readonly Crumb[] _crumbs =
    [
        new("home",       "Home",          "#"),
        new("docs",       "Documentation", "#"),
        new("components", "Components",    "#"),
        new("breadcrumb", "Breadcrumb",    null),
    ];
}
