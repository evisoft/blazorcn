@* ============================================================
   Block: banner-live-team-presence
   Title: BannerLiveTeamPresence
   Description: A live status banner for React and Next.js with a pulsing emerald dot, online team count, static last-synced timestamp, and an inline view link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-live-team-presence.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <span role="status" aria-label="Live" class="relative mt-1.5 flex size-2 shrink-0">
                <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/60 opacity-75"></span>
                <span aria-hidden="true" class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-medium text-foreground">
                        @_onlineCount teammates active in the workspace
                    </p>
                    <span class="shrink-0 text-[11px] text-muted-foreground tabular-nums">
                        @_lastSyncedLabel
                    </span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    Editing docs, reviewing pull requests, and reacting in the standup channel right now.
                </p>
                <div class="mt-2">
                    <a href="#"
                       class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                        View the roster
                        <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int _onlineCount = 5;
    private const string _lastSyncedLabel = "Synced 2 min ago";
}
