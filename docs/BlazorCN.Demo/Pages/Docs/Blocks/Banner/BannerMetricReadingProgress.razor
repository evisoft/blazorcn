@* ============================================================
   Block: banner-metric-reading-progress
   Title: BannerMetricReadingProgress
   Description: A progress metric banner for React and Next.js showing article reading completion with a label row, monospace percentage, thin progress bar, and subtext line for minutes remaining built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-metric-reading-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="book-open" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                    <p class="min-w-0 truncate text-sm font-medium text-foreground">
                        @_articleTitle
                    </p>
                    <p class="shrink-0 font-mono text-sm font-semibold tabular-nums text-foreground">
                        @(_progressPercent)%
                    </p>
                </div>
                <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div aria-valuemax="100"
                         aria-valuemin="0"
                         aria-valuenow="@_progressPercent"
                         aria-label="Reading progress"
                         class="h-full rounded-full bg-foreground"
                         role="progressbar"
                         style="@($"width:{_progressPercent}%")">
                    </div>
                </div>
                <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                    About @_minutesRemaining minutes left at the average reading pace of 238 words per
                    minute.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _articleTitle = "Designing chrome at the edge of the hero";
    private const int _progressPercent = 64;
    private const int _minutesRemaining = 4;
}
