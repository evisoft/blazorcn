@* ============================================================
   Block: banner-numbered-feature-highlights
   Title: BannerNumberedFeatureHighlights
   Description: A numbered announcement list banner for React and Next.js with a labeled header row, three numbered rows, arrow links, and a tight chrome silhouette built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-numbered-feature-highlights.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-2.5">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Shipped this week
            </p>
        </div>
        <ul class="divide-y divide-dashed">
            @foreach (var (item, index) in _highlights.Select((h, i) => (h, i)))
            {
                <li>
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[10px] font-medium text-muted-foreground tabular-nums">
                            @(index + 1)
                        </span>
                        <p class="min-w-0 flex-1 truncate text-sm text-foreground">@item.Title</p>
                        <a href="@item.Href"
                           class="inline-flex shrink-0 items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                            Read more
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3" aria-hidden="true" />
                        </a>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Highlight(string Id, string Title, string Href);

    private static readonly Highlight[] _highlights =
    [
        new("api-v3", "API v3 is generally available with cursor-based pagination", "#"),
        new("analytics", "Real-time dashboard analytics with 30-second refresh", "#"),
        new("workspaces", "Team workspaces now support up to 50 members on Pro", "#"),
    ];
}
