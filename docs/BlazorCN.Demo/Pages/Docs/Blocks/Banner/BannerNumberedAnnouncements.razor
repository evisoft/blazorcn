@* ============================================================
   Block: banner-numbered-announcements
   Title: BannerNumberedAnnouncements
   Description: A numbered announcement list banner for React and Next.js with a quiet uppercase header, three numbered rows, and trailing arrow links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-numbered-announcements.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-2.5">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                This week in product
            </p>
        </div>
        <ul>
            @foreach (var (item, index) in _announcements.Select((a, i) => (a, i)))
            {
                var isLast = index == _announcements.Length - 1;
                <li class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[10px] font-medium text-muted-foreground">
                        @item.Id
                    </span>
                    <p class="min-w-0 flex-1 truncate text-sm text-foreground">@item.Title</p>
                    <a href="@item.Href" class="inline-flex shrink-0 items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                        Read more
                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3" aria-hidden="true" />
                    </a>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Announcement(int Id, string Title, string Href);

    private static readonly Announcement[] _announcements =
    [
        new(1, "API v3 is generally available with breaking auth changes", "#"),
        new(2, "Real-time dashboard analytics shipped on April 8", "#"),
        new(3, "Team workspaces now support up to 50 members on Pro", "#"),
    ];
}
