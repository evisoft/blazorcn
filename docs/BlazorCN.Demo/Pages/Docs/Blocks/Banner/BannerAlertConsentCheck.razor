@* ============================================================
   Block: banner-alert-consent-check
   Title: BannerAlertConsentCheck
   Description: A muted blue alert strip banner for React and Next.js with an info icon, a compact title and description, and an inline checkbox plus outline dismiss action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-alert-consent-check.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="overflow-hidden rounded-lg border border-l-[3px] border-l-blue-500/80 bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <LucideIconCn Name="info" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-blue-500/90" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-foreground">
                        Product updates moved to a monthly digest
                    </p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                        Starting April 15 we send one monthly email instead of per-release notes. You can
                        change the cadence anytime in account settings.
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          @onclick="@(() => _visible = false)"
                          Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                          aria-label="Dismiss banner">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>

            <div class="flex items-center justify-between gap-3 border-t px-4 py-2.5">
                <label for="banner-alert-consent-check"
                       class="inline-flex cursor-pointer select-none items-center gap-2 text-xs text-muted-foreground">
                    <CheckboxCn id="banner-alert-consent-check"
                                Checked="_checked"
                                CheckedChanged="@(v => _checked = v)" />
                    Don't show this again
                </label>
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          @onclick="@(() => _visible = false)">
                    @(_checked ? "Dismiss permanently" : "Got it")
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
    private bool _checked = false;
}
