@* ============================================================
   Block: banner-metric-sparkline-trend
   Title: BannerMetricSparklineTrend
   Description: A metric trend banner for React and Next.js with a headline stat, a positive change pill, and an inline 24-bar sparkline mini chart built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-metric-sparkline-trend.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-4 px-4 py-3">
            <div class="min-w-0 shrink-0">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    @_metric.Label
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums text-foreground">
                    @_metric.Value
                </p>
            </div>

            <div class="inline-flex shrink-0 items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5">
                <LucideIconCn Name="trending-up" Size="12" aria-hidden="true" Class="size-3 text-emerald-500/90" />
                <span class="font-mono text-[10px] font-semibold tabular-nums text-emerald-500/90">
                    @_metric.Change
                </span>
            </div>

            <div role="img"
                 aria-label="@($"Sparkline trend {_metric.Change} {_metric.Window}")"
                 class="ml-auto flex h-8 items-end gap-[3px]">
                @foreach (var bar in _sparkline)
                {
                    <span aria-hidden="true"
                          class="w-[3px] rounded-full bg-foreground/25"
                          style="@($"height:{(bar.Value / (double)SparklineMax) * 100}%")"></span>
                }
            </div>
        </div>
        <div class="border-t bg-muted/30 px-4 py-2">
            <p class="text-[10px] text-muted-foreground">
                @_metric.Window · updated every 60 seconds
            </p>
        </div>
    </div>
</section>

@code {
    private record MetricSnapshot(string Label, string Value, string Change, string Window);
    private record SparkBar(string Id, int Value);

    private const int SparklineMax = 100;

    private static readonly MetricSnapshot _metric = new(
        Label: "Revenue · last 24h",
        Value: "$48,240",
        Change: "+12.4%",
        Window: "vs previous 24h"
    );

    private static readonly SparkBar[] _sparkline =
    [
        new("h00", 28), new("h01", 32), new("h02", 26), new("h03", 34),
        new("h04", 30), new("h05", 38), new("h06", 44), new("h07", 40),
        new("h08", 47), new("h09", 52), new("h10", 48), new("h11", 58),
        new("h12", 55), new("h13", 63), new("h14", 60), new("h15", 68),
        new("h16", 72), new("h17", 70), new("h18", 78), new("h19", 82),
        new("h20", 80), new("h21", 88), new("h22", 92), new("h23", 96),
    ];
}
