@* ============================================================
   Block: banner-pill-toast
   Title: BannerPillToast
   Description: A floating pill toast banner for React and Next.js with a success check icon one line confirmation message an inline undo link and a subtle dismiss control built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-pill-toast.tsx
   ============================================================ *@

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="flex items-center justify-center">
            <div role="status"
                 aria-live="polite"
                 class="inline-flex items-center gap-3 rounded-full border bg-card px-4 py-2 shadow-lg">
                <LucideIconCn Name="check-circle-2" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-emerald-500/90" />
                <p class="text-sm font-medium text-foreground">Workspace settings saved</p>
                <a href="#"
                   class="text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                    Undo
                </a>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="size-5 shrink-0 rounded-full p-0 text-muted-foreground hover:text-foreground"
                          aria-label="Dismiss notification"
                          OnClick="@(() => _visible = false)">
                    <LucideIconCn Name="x" Size="12" aria-hidden="true" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private bool _visible = true;
}
