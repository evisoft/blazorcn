@* ============================================================
   Block: banner-top-bar-shipping
   Title: BannerTopBarShipping
   Description: A single-line top bar banner for React and Next.js with three chrome-scale info chips separated by a dot bullet for shipping perks built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar-shipping.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 px-4 py-2.5">
            @for (var i = 0; i < _chips.Length; i++)
            {
                var chip = _chips[i];
                <div class="inline-flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
                        <LucideIconCn Name="@chip.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
                        <span class="font-medium text-foreground">@chip.Label</span>
                    </span>
                    @if (i < _chips.Length - 1)
                    {
                        <span aria-hidden="true" class="hidden size-1 rounded-full bg-muted-foreground/40 sm:inline-block"></span>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ShippingChip(string Id, string Icon, string Label);

    private static readonly ShippingChip[] _chips =
    [
        new("free", "truck", "Free shipping over $50"),
        new("fast", "clock", "2-day express delivery"),
        new("returns", "refresh-cw", "30-day free returns"),
    ];
}
