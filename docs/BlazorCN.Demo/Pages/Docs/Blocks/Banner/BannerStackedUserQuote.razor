<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex flex-col items-center rounded-lg border bg-card px-6 py-6 text-center">
        <AvatarCn Class="size-10">
            <AvatarFallbackCn Class="bg-muted text-xs font-medium text-muted-foreground">
                SR
            </AvatarFallbackCn>
        </AvatarCn>
        <figure class="mt-3 flex flex-col items-center">
            <blockquote class="max-w-sm text-sm font-medium text-foreground">
                &ldquo;We migrated our entire frontend to shadcn/ui in a weekend and cut bundle size by
                38 percent.&rdquo;
            </blockquote>
            <figcaption class="mt-2 text-xs text-muted-foreground">
                <span class="font-medium text-foreground">Sarah Rivera</span>
                <span> &middot; Staff Engineer at Northwind</span>
            </figcaption>
        </figure>
        <a
            href="#"
            class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground"
        >
            Read the case study
            <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
        </a>
    </div>
</section>
