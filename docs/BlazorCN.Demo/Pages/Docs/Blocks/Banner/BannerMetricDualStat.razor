@* ============================================================
   Block: banner-metric-dual-stat
   Title: BannerMetricDualStat
   Description: A dual metric banner for React and Next.js with two side-by-side progress bars, tabular stat values, delta change indicators, and a central divider built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-metric-dual-stat.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-2">
            @foreach (var (metric, index) in _metrics.Select((m, i) => (m, i)))
            {
                <div class="@(index > 0 ? "border-l px-4 py-3" : "px-4 py-3")">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-xs text-muted-foreground">@metric.Label</p>
                        <div class="@(metric.IsPositive ? "inline-flex items-center gap-0.5 text-xs text-emerald-500/90 tabular-nums" : "inline-flex items-center gap-0.5 text-xs text-red-500/90 tabular-nums")">
                            <LucideIconCn Name="@(metric.IsPositive ? "arrow-up-right" : "arrow-down-right")" Size="12" aria-hidden="true" Class="size-3" />
                            <span class="font-medium">@metric.Delta</span>
                        </div>
                    </div>
                    <p class="mt-1 text-sm font-semibold text-foreground tabular-nums">
                        @metric.Value
                    </p>
                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div role="progressbar"
                             aria-valuenow="@metric.Percent"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-label="@($"{metric.Label} progress")"
                             class="h-full rounded-full bg-foreground"
                             style="@($"width:{metric.Percent}%")">
                        </div>
                    </div>
                    <p class="mt-1.5 text-[10px] uppercase tracking-widest text-muted-foreground">
                        Week to date
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Metric(string Id, string Label, string Value, int Percent, string Delta, bool IsPositive);

    private static readonly Metric[] _metrics =
    [
        new("signups", "New signups", "4,291", 64, "+12.5%", true),
        new("revenue", "Revenue", "$38.4k", 48, "-3.2%", false),
    ];
}
