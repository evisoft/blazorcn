@* ============================================================
   Block: banner-multi-action-dropdown
   Title: BannerMultiActionDropdown
   Description: A multi-action banner for React and Next.js with an icon, stacked title and description, an inline dropdown select, and a primary plus outline button row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-dropdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="globe" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground">
                    Choose a deployment region before April 18
                </p>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    New projects default to US East after the cutover. Pick a region once and we pin all
                    future workspaces to it.
                </p>

                <div class="mt-3 flex flex-wrap items-center gap-2">
                    <SelectCn Value="@_region" ValueChanged="@(v => _region = v ?? _region)">
                        <SelectTriggerCn Class="h-7 w-[180px] text-xs" aria-label="Select a deployment region">
                            <SelectValueCn Placeholder="Select region" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var option in _options)
                            {
                                <SelectItemCn Value="@option.Value" Class="text-xs">@option.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(string.IsNullOrEmpty(_region))">
                        Continue
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                        Skip for now
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _region = "";

    private record RegionOption(string Value, string Label);

    private static readonly RegionOption[] _options =
    [
        new("us-east", "US East (Virginia)"),
        new("us-west", "US West (Oregon)"),
        new("eu-west", "EU West (Ireland)"),
        new("ap-south", "Asia Pacific (Singapore)"),
    ];
}
