   Block: banner-minimalist-keyboard-hint
   Title: BannerMinimalistKeyboardHint
   Description: A minimalist one-line keyboard shortcut hint banner for React and Next.js with inline kbd key caps, muted body copy, and a single underlined link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-minimalist-keyboard-hint.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="rounded-lg border bg-card px-4 py-3 text-center">
        <p class="text-xs text-muted-foreground">
            Skip the mouse. Press
            <span class="inline-flex items-center gap-0.5 align-middle">
                <kbd class="inline-flex h-4 items-center rounded border bg-muted px-1 font-mono text-[10px] text-foreground">
                    Ctrl
                </kbd>
                <kbd class="inline-flex h-4 items-center rounded border bg-muted px-1 font-mono text-[10px] text-foreground">
                    /
                </kbd>
            </span>
            anywhere on this page to jump straight to search, or
            <a
                href="#"
                class="font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                see the full shortcut list
            </a>
            .
        </p>
    </div>
</section>
