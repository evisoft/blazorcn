@* ============================================================
   Block: banner-marquee-badges
   Title: BannerMarqueeBadges
   Description: A horizontal marquee ticker banner for React and Next.js with infinite scrolling badge chips, gradient edge masks, and reduced-motion fallback built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-marquee-badges.tsx
   ============================================================ *@

<style>
    @@keyframes ticker-badges-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    .ticker-badges-track {
        animation: ticker-badges-left 48s linear infinite;
        will-change: transform;
    }
    @@media (prefers-reduced-motion: reduce) {
        .ticker-badges-track { animation: none; }
    }
</style>

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-3 px-4 py-3">
            <span class="shrink-0 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Built with
            </span>
            <div class="relative min-w-0 flex-1 overflow-hidden">
                <div class="ticker-badges-track flex w-max gap-2">
                    @foreach (var item in _doubled)
                    {
                        <span class="inline-flex shrink-0 items-center rounded-full border bg-background px-2.5 py-0.5 text-[11px] font-medium text-foreground">
                            @item.Label
                        </span>
                    }
                </div>
                <div aria-hidden="true"
                     class="pointer-events-none absolute inset-y-0 left-0 w-10 bg-gradient-to-r from-card to-transparent">
                </div>
                <div aria-hidden="true"
                     class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-card to-transparent">
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TickerItem(string Id, string Label);

    private static readonly TickerItem[] _items =
    [
        new("react",       "React 19"),
        new("next",        "Next.js 16"),
        new("ts",          "TypeScript 5.5"),
        new("tw",          "Tailwind CSS 4"),
        new("shadcn",      "shadcn/ui"),
        new("motion",      "motion/react"),
        new("lucide",      "Lucide Icons"),
        new("prisma",      "Prisma 6"),
        new("drizzle",     "Drizzle ORM"),
        new("better-auth", "Better Auth"),
        new("stripe",      "Stripe 2026"),
        new("turbo",       "Turborepo 2"),
    ];

    private static readonly TickerItem[] _doubled = [.._items, .._items];
}
