@* ============================================================
   Block: banner-multi-action-preferences
   Title: BannerMultiActionPreferences
   Description: A multi-action preferences banner for React and Next.js with a title-description header, a row of aria-pressed toggle chips, and a primary Save plus outline Reset and ghost Dismiss action stack built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-preferences.tsx
   ============================================================ *@

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <LucideIconCn Name="accessibility" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-foreground">Adjust your reading preferences</p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                        Pick the options that match how you read best. Changes apply to this session until you
                        save them to your account.
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <TooltipProviderCn>
                            @foreach (var opt in _options)
                            {
                                var isActive = _active.Contains(opt.Id);
                                <TooltipCn>
                                    <TooltipTriggerCn Tabbable="false">
                                        <ButtonCn aria-label="@opt.Label"
                                                  aria-pressed="@(isActive ? "true" : "false")"
                                                  Class="h-7 gap-1.5 px-2.5 text-xs"
                                                  Size="ButtonSize.Sm"
                                                  Variant="@(isActive ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                                                  OnClick="@(() => Toggle(opt.Id))">
                                            <LucideIconCn Name="@opt.Icon" Size="14" aria-hidden="true" Class="size-3.5" />
                                            @opt.Label
                                        </ButtonCn>
                                    </TooltipTriggerCn>
                                    <TooltipContentCn Side="FloatingSide.Bottom" Class="text-xs">
                                        @(isActive ? $"Disable {opt.Label.ToLower()}" : $"Enable {opt.Label.ToLower()}")
                                    </TooltipContentCn>
                                </TooltipCn>
                            }
                        </TooltipProviderCn>
                        <span aria-live="polite" class="ml-auto text-xs text-muted-foreground tabular-nums">
                            @_active.Count of @_options.Length enabled
                        </span>
                    </div>
                    <div class="mt-3 flex items-center gap-2">
                        <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" OnClick="@(() => _visible = false)">
                            Save preferences
                        </ButtonCn>
                        <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="@(() => _active = [])">
                            Reset
                        </ButtonCn>
                        <ButtonCn Class="h-7 text-xs text-muted-foreground" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="@(() => _visible = false)">
                            Not now
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    private bool _visible = true;
    private HashSet<string> _active = [];

    private record Option(string Id, string Icon, string Label);

    private static readonly Option[] _options =
    [
        new("font", "type", "Larger text"),
        new("contrast", "contrast", "High contrast"),
        new("motion", "pause", "Reduce motion"),
    ];

    private void Toggle(string id)
    {
        if (_active.Contains(id))
            _active.Remove(id);
        else
            _active.Add(id);
    }
}
