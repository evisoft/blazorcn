@* ============================================================
   Block: banner-carousel-rotating
   Title: BannerCarouselRotating
   Description: A rotating carousel banner for React and Next.js that autoplays three announcement slides with slide-in motion and pagination dots built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-carousel-rotating.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-3 px-4 py-3">
            <LucideIconCn Name="sparkles" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="relative min-w-0 flex-1">
                <div>
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        @_slides[_index].Eyebrow
                    </p>
                    <p class="mt-0.5 text-sm font-medium text-foreground">@_slides[_index].Title</p>
                    <div class="mt-2">
                        <a href="@_slides[_index].Href"
                           class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                            @_slides[_index].LinkLabel
                            <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex items-center justify-center gap-1.5 border-t px-4 py-2">
            @for (var i = 0; i < _slides.Length; i++)
            {
                var idx = i;
                var active = idx == _index;
                <button type="button"
                        @onclick="@(() => SetIndex(idx))"
                        aria-label="@($"Show slide {idx + 1}")"
                        aria-current="@(active ? "true" : null)"
                        class="@Cn.Merge("h-1.5 rounded-full transition-all", active ? "w-4 bg-foreground" : "w-1.5 bg-muted-foreground/30")">
                </button>
            }
        </div>
    </div>
</section>

@code {
    private record Slide(string Id, string Eyebrow, string Title, string Href, string LinkLabel);

    private static readonly Slide[] _slides =
    [
        new("s1", "v4.2", "Dark mode refresh ships with 12 new theme tokens", "#", "Release notes"),
        new("s2", "April 10", "Community meetup in San Francisco with the core team", "#", "Register"),
        new("s3", "Docs", "New REST and webhooks reference with 40+ code samples", "#", "Read docs"),
    ];

    private int _index = 0;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            _index = (_index + 1) % _slides.Length;
            InvokeAsync(StateHasChanged);
        }, null, 6000, 6000);
    }

    private void SetIndex(int i) => _index = i;

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
