@* ============================================================
   Block: banner-marquee-trust-badges
   Title: BannerMarqueeTrustBadges
   Description: A marquee ticker banner for React and Next.js scrolling a doubled row of compliance and trust badges with Lucide icons, edge gradient masks, and a reduced-motion fallback built with Tailwind CSS
   Source: original/blocks/banner/banner-marquee-trust-badges.tsx
   ============================================================ *@

<style>
    @@keyframes trust-ticker-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    .trust-ticker-row {
        animation: trust-ticker-left 40s linear infinite;
    }
    @@media (prefers-reduced-motion: reduce) {
        .trust-ticker-row { animation: none; }
    }
</style>

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        <div aria-hidden="true"
             class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-card to-transparent">
        </div>
        <div aria-hidden="true"
             class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-card to-transparent">
        </div>
        <div class="py-3">
            <div class="trust-ticker-row flex w-max items-center gap-8 whitespace-nowrap">
                @foreach (var (badge, i) in _doubledBadges.Select((b, idx) => (b, idx)))
                {
                    <div class="flex shrink-0 items-center gap-2">
                        <LucideIconCn Name="@badge.IconName" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex items-baseline gap-1.5">
                            <span class="text-xs font-medium text-foreground">@badge.Label</span>
                            <span class="text-[11px] text-muted-foreground">@badge.Detail</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TrustBadge(string Id, string IconName, string Label, string Detail);

    private static readonly TrustBadge[] _badges =
    [
        new("ssl",    "lock",         "TLS 1.3",        "End-to-end encryption"),
        new("soc2",   "shield-check", "SOC 2 Type II",  "Audited May 2025"),
        new("refund", "badge-check",  "30-day refund",  "No questions asked"),
        new("uptime", "clock",        "99.98% uptime",  "Last 90 days"),
        new("gdpr",   "sparkles",     "GDPR ready",     "EU data residency"),
        new("teams",  "users",        "12k+ teams",     "In 84 countries"),
    ];

    private static readonly TrustBadge[] _doubledBadges = [.._badges, .._badges];
}
