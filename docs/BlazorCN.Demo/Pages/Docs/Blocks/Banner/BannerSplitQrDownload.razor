@* ============================================================
   Block: banner-split-qr-download
   Title: BannerSplitQrDownload
   Description: A split two-tone banner for React and Next.js with an inverted QR panel on the left and a compact scan-to-download copy column on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-split-qr-download.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="grid grid-cols-1 overflow-hidden rounded-lg border bg-card sm:grid-cols-[auto_1fr]">
        <div class="flex items-center justify-center bg-foreground p-4 text-background">
            <div class="rounded-md bg-background p-2">
                <div class="grid gap-[1px]"
                     style="grid-template-columns: repeat(17, 1fr)"
                     aria-label="QR code for mobile download"
                     role="img">
                    @foreach (var cell in _qrCells)
                    {
                        <span aria-hidden="true" class="size-[5px] @(cell == 1 ? "bg-foreground" : "bg-transparent")"></span>
                    }
                </div>
            </div>
        </div>
        <div class="flex flex-col justify-center p-4">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Scan to install
            </p>
            <p class="mt-1 text-sm font-medium text-foreground">
                Open the mobile app in under 10 seconds
            </p>
            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                Point your phone camera at the code to jump straight to the iOS or Android listing. No
                store search, no account link.
            </p>
            <div class="mt-2.5">
                <a href="#"
                   class="inline-flex items-center gap-1 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground">
                    Or view both listings
                    <LucideIconCn Name="arrow-right" Size="12" aria-hidden="true" Class="size-3" />
                </a>
            </div>
        </div>
    </div>
</section>

