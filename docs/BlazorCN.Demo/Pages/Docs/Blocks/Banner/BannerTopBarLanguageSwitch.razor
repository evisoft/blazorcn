@* ============================================================
   Block: banner-top-bar-language-switch
   Title: BannerTopBarLanguageSwitch
   Description: A compact top bar banner for React and Next.js with a centered single-line message, an inline underlined language-switch link, and a dismiss control built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-top-bar-language-switch.tsx
   ============================================================ *@

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="flex items-center gap-3 rounded-lg border bg-card px-4 py-2.5">
            <p class="min-w-0 flex-1 truncate text-center text-xs text-muted-foreground">
                Reading in <span class="font-medium text-foreground">@_active.Label</span> · switch to&nbsp;<button
                    type="button"
                    class="font-medium text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground"
                    @onclick="@(() => _index = (_index + 1) % _locales.Length)">
                    @_next.Label
                </button>
            </p>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                      aria-label="Dismiss banner"
                      @onclick="@(() => _visible = false)">
                <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
            </ButtonCn>
        </div>
    </section>
}

@code {
    private bool _visible = true;
    private int _index = 0;

    private record Locale(string Id, string Code, string Label);

    private static readonly Locale[] _locales =
    [
        new("en", "EN", "English"),
        new("es", "ES", "Español"),
        new("fr", "FR", "Français"),
    ];

    private Locale _active => _locales[_index];
    private Locale _next => _locales[(_index + 1) % _locales.Length];
}
