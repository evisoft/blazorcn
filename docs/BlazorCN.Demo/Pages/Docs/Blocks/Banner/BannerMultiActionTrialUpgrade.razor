@* ============================================================
   Block: banner-multi-action-trial-upgrade
   Title: BannerMultiActionTrialUpgrade
   Description: A multi action trial upgrade banner for React and Next.js with title, description, primary upgrade button, outline secondary action, ghost dismiss, and smooth AnimatePresence collapse built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-multi-action-trial-upgrade.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_visible)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="rocket" Size="16" aria-hidden="true" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-foreground">Your Pro trial ends in 3 days</p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                        Keep unlimited projects, priority support, and the new analytics module by
                        upgrading before April 14. No re-onboarding required.
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm">
                            Upgrade to Pro
                        </ButtonCn>
                        <ButtonCn
                            Class="h-7 text-xs"
                            Size="ButtonSize.Sm"
                            Variant="ButtonVariant.Outline">
                            Compare plans
                        </ButtonCn>
                        <ButtonCn
                            Class="h-7 text-xs text-muted-foreground"
                            Size="ButtonSize.Sm"
                            Variant="ButtonVariant.Ghost">
                            Remind me later
                        </ButtonCn>
                    </div>
                </div>
                <ButtonCn
                    aria-label="Dismiss banner"
                    Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                    @onclick="@(() => _visible = false)"
                    Size="ButtonSize.Sm"
                    Variant="ButtonVariant.Ghost">
                    <LucideIconCn Name="x" Size="14" aria-hidden="true" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private bool _visible = true;
}
