@* ============================================================
   Block: banner-pill-sticky-bottom
   Title: BannerPillStickyBottom
   Description: A sticky bottom floating pill banner for React and Next.js with a rounded-full container, inline icon, compact pill button, and dismiss control anchored above page content built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-pill-sticky-bottom.tsx
   ============================================================ *@

@if (_visible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="flex items-center justify-center">
            <div class="inline-flex items-center gap-3 rounded-full border bg-card px-4 py-2 shadow-lg">
                <LucideIconCn Name="truck" Size="16" aria-hidden="true" Class="size-4 shrink-0 text-muted-foreground" />
                <p class="text-sm font-medium">Add $12 more for free shipping</p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-6 rounded-full px-3 text-xs">
                    View cart
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="size-5 shrink-0 rounded-full p-0 text-muted-foreground hover:text-foreground"
                          aria-label="Dismiss banner"
                          OnClick="@(() => _visible = false)">
                    <LucideIconCn Name="x" Size="12" aria-hidden="true" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private bool _visible = true;
}
