<section class="mx-auto w-full max-w-2xl p-4">
    <div class="rounded-lg border bg-card px-4 py-3 text-center">
        <p class="inline-flex items-center justify-center gap-2 text-xs text-muted-foreground">
            <span class="relative flex size-2" aria-label="Unread" role="status">
