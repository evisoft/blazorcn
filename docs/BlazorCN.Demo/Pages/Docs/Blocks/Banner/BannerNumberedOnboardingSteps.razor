@* ============================================================
   Block: banner-numbered-onboarding-steps
   Title: BannerNumberedOnboardingSteps
   Description: A numbered announcement list banner for React and Next.js showing five onboarding steps with completed state, neutral numbered circles, and trailing arrow links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/banner/banner-numbered-onboarding-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Setup checklist
            </p>
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground tabular-nums">
                @_completed / @_steps.Length
            </p>
        </div>
        <ul class="divide-y divide-dashed">
            @foreach (var (step, index) in _steps.Select((s, i) => (s, i)))
            {
                <li>
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        @if (step.Completed)
                        {
                            <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-foreground">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-background" aria-hidden="true" />
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[10px] font-medium text-muted-foreground tabular-nums">
                                @(index + 1)
                            </span>
                        }
                        <p class="@Cn.Merge("min-w-0 flex-1 truncate text-sm", step.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                            @step.Title
                        </p>
                        @if (!step.Completed)
                        {
                            <a href="#" class="inline-flex shrink-0 items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                                Start
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" aria-hidden="true" />
                            </a>
                        }
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record OnboardingStep(string Id, string Title, bool Completed);

    private static readonly OnboardingStep[] _steps =
    [
        new("account", "Create your workspace account", true),
        new("repo", "Connect a GitHub or GitLab repository", true),
        new("invite", "Invite up to 3 teammates by email", true),
        new("ci", "Configure the CI pipeline for main branch", false),
        new("deploy", "Trigger your first production deployment", false),
    ];

    private int _completed => _steps.Count(s => s.Completed);
}
