@* ============================================================
   Block: form-conditional-fields
   Title: FormConditionalFields
   Description: A form where certain fields appear or disappear based on select values using React Hook Form's watch function
   Source: original/blocks/form/form-conditional-fields.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">User Profile</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Complete your profile information</p>
        </div>

        <form class="p-4">
            <FieldSetCn>
                <div class="space-y-4">
                    @* Full Name field *@
                    <FieldCn>
                        <FieldLabelCn For="conditional-fields-name">Full Name</FieldLabelCn>
                        <InputCn id="conditional-fields-name" @bind-Value="_name" Placeholder="Enter your full name" aria-invalid="@(_nameError != null ? "true" : "false")" />
                        @if (_nameError != null)
                        {
                            <FieldErrorCn Errors="@(new[] { _nameError })" />
                        }
                    </FieldCn>

                    @* Role field *@
                    <FieldCn>
                        <FieldLabelCn For="conditional-fields-role">Role</FieldLabelCn>
                        <SelectCn Value="@_role" ValueChanged="@OnRoleChanged">
                            <SelectTriggerCn id="conditional-fields-role" Class="w-full" aria-invalid="@(_roleError != null ? "true" : "false")">
                                <SelectValueCn Placeholder="Select your role" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="developer">Developer</SelectItemCn>
                                <SelectItemCn Value="designer">Designer</SelectItemCn>
                                <SelectItemCn Value="manager">Manager</SelectItemCn>
                                <SelectItemCn Value="other">Other</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        <FieldDescriptionCn>Choose the role that best describes you</FieldDescriptionCn>
                        @if (_roleError != null)
                        {
                            <FieldErrorCn Errors="@(new[] { _roleError })" />
                        }
                    </FieldCn>

                    @* Custom Role field — conditional *@
                    @if (_role == "other")
                    {
                        <FieldCn>
                            <FieldLabelCn For="customRole">Custom Role</FieldLabelCn>
                            <InputCn id="customRole" @bind-Value="_customRole" Placeholder="Specify your role" aria-invalid="@(_customRoleError != null ? "true" : "false")" />
                            <FieldDescriptionCn>Please specify your role</FieldDescriptionCn>
                            @if (_customRoleError != null)
                            {
                                <FieldErrorCn Errors="@(new[] { _customRoleError })" />
                            }
                        </FieldCn>
                    }
                </div>

                <div class="mt-6 flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveProfile">
                        Save Profile
                    </ButtonCn>
                </div>
            </FieldSetCn>
        </form>
    </div>
</section>

@code {
    private string _name = "";
    private string _role = "";
    private string _customRole = "";

    private string? _nameError = null;
    private string? _roleError = null;
    private string? _customRoleError = null;

    private void OnRoleChanged(string? value)
    {
        _role = value ?? "";
        _roleError = null;
        _customRole = "";
        _customRoleError = null;
    }

    private void ResetForm()
    {
        _name = "";
        _role = "";
        _customRole = "";
        _nameError = null;
        _roleError = null;
        _customRoleError = null;
    }

    private void SaveProfile()
    {
        _nameError = string.IsNullOrWhiteSpace(_name) ? "Name is required" : null;
        _roleError = string.IsNullOrEmpty(_role) ? "Please select a role" : null;
        _customRoleError = null;
        // If valid, form is "submitted" (presentational only)
    }
}
