@* ============================================================
   Block: form-repeatable-group
   Title: FormRepeatableGroup
   Description: A form with repeatable field groups where each entry contains multiple related fields using React Hook Form's useFieldArray
   Source: original/blocks/form/form-repeatable-group.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Team Members</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Add team members with their contact details and roles
            </p>
        </div>

        <div class="p-4">
            <FieldSetCn>
                <div class="space-y-4">
                    @foreach (var it in _members)
                    {
                        var member = it;
                        <div class="rounded-md border bg-muted/50 p-3">
                            <div class="mb-2 flex items-center justify-between">
                                <span class="text-muted-foreground text-xs font-medium">
                                    Member @member.Index
                                </span>
                                @if (_members.Count > 1)
                                {
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2" type="button"
                                              aria-label="@($"Remove member {member.Index}")"
                                              @onclick="@(() => RemoveMember(member.Id))">
                                        <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                }
                            </div>

                            <div class="grid grid-cols-12 gap-3">
                                <div class="col-span-12 sm:col-span-5">
                                    <FieldCn>
                                        <FieldLabelCn For="@($"name-{member.Id}")">Name</FieldLabelCn>
                                        <InputCn id="@($"name-{member.Id}")"
                                                 Value="@member.Name"
                                                 ValueChanged="@((string v) => UpdateName(member.Id, v))"
                                                 Placeholder="John Doe"
                                                 aria-invalid="@member.NameError" />
                                        @if (member.NameError)
                                        {
                                            <FieldErrorCn Errors="@(new[] { "Name is required" })" />
                                        }
                                    </FieldCn>
                                </div>

                                <div class="col-span-12 sm:col-span-4">
                                    <FieldCn>
                                        <FieldLabelCn For="@($"email-{member.Id}")">Email</FieldLabelCn>
                                        <InputCn id="@($"email-{member.Id}")"
                                                 type="email"
                                                 Value="@member.Email"
                                                 ValueChanged="@((string v) => UpdateEmail(member.Id, v))"
                                                 Placeholder="@("john@example.com")"
                                                 aria-invalid="@member.EmailError" />
                                        @if (member.EmailError)
                                        {
                                            <FieldErrorCn Errors="@(new[] { "Invalid email address" })" />
                                        }
                                    </FieldCn>
                                </div>

                                <div class="col-span-12 sm:col-span-3">
                                    <FieldCn>
                                        <FieldLabelCn For="@($"role-{member.Id}")">Role</FieldLabelCn>
                                        <SelectCn Value="@member.Role"
                                                  ValueChanged="@((string v) => UpdateRole(member.Id, v))">
                                            <SelectTriggerCn id="@($"role-{member.Id}")" aria-invalid="@member.RoleError">
                                                <SelectValueCn Placeholder="Select" />
                                            </SelectTriggerCn>
                                            <SelectContentCn>
                                                <SelectItemCn Value="admin">Admin</SelectItemCn>
                                                <SelectItemCn Value="member">Member</SelectItemCn>
                                                <SelectItemCn Value="viewer">Viewer</SelectItemCn>
                                            </SelectContentCn>
                                        </SelectCn>
                                        @if (member.RoleError)
                                        {
                                            <FieldErrorCn Errors="@(new[] { "Role is required" })" />
                                        }
                                    </FieldCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (_rootError)
                {
                    <FieldErrorCn Class="mt-2" Errors="@(new[] { "Add at least one team member" })" />
                }

                <FieldDescriptionCn Class="mt-3">
                    Add multiple team members with their contact information and access level
                </FieldDescriptionCn>

                <div class="mt-4 flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button"
                              @onclick="AddMember">
                        <LucideIconCn Name="plus" Size="16" Class="mr-1 size-4" /> Add Member
                    </ButtonCn>
                </div>

                <div class="mt-6 flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveTeam">
                        Save Team
                    </ButtonCn>
                </div>
            </FieldSetCn>
        </div>
    </div>
</section>

@code {
    private int _nextId = 2;
    private bool _rootError = false;

    private List<MemberItem> _members = new()
    {
        new MemberItem { Id = 1, Index = 1, Name = "", Email = "", Role = "" }
    };

    private void AddMember()
    {
        _rootError = false;
        _members.Add(new MemberItem { Id = _nextId, Index = _members.Count + 1, Name = "", Email = "", Role = "" });
        _nextId++;
    }

    private void RemoveMember(int id)
    {
        _members.RemoveAll(x => x.Id == id);
        RenumberMembers();
        _rootError = false;
    }

    private void UpdateName(int id, string value)
    {
        var m = _members.FirstOrDefault(x => x.Id == id);
        if (m is not null)
        {
            m.Name = value;
            m.NameError = string.IsNullOrWhiteSpace(value);
        }
    }

    private void UpdateEmail(int id, string value)
    {
        var m = _members.FirstOrDefault(x => x.Id == id);
        if (m is not null)
        {
            m.Email = value;
            m.EmailError = string.IsNullOrWhiteSpace(value) || !value.Contains('@');
        }
    }

    private void UpdateRole(int id, string value)
    {
        var m = _members.FirstOrDefault(x => x.Id == id);
        if (m is not null)
        {
            m.Role = value;
            m.RoleError = string.IsNullOrWhiteSpace(value);
        }
    }

    private void RenumberMembers()
    {
        for (int i = 0; i < _members.Count; i++)
            _members[i].Index = i + 1;
    }

    private void SaveTeam()
    {
        bool valid = true;
        foreach (var m in _members)
        {
            m.NameError = string.IsNullOrWhiteSpace(m.Name);
            m.EmailError = string.IsNullOrWhiteSpace(m.Email) || !m.Email.Contains('@');
            m.RoleError = string.IsNullOrWhiteSpace(m.Role);
            if (m.NameError || m.EmailError || m.RoleError) valid = false;
        }
        if (_members.Count == 0)
        {
            _rootError = true;
            valid = false;
        }
        // If valid, form is "submitted" (presentational only)
    }

    private void ResetForm()
    {
        _nextId = 2;
        _rootError = false;
        _members = new()
        {
            new MemberItem { Id = 1, Index = 1, Name = "", Email = "", Role = "" }
        };
    }

    private class MemberItem
    {
        public int Id { get; set; }
        public int Index { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public bool NameError { get; set; }
        public bool EmailError { get; set; }
        public bool RoleError { get; set; }
    }
}
