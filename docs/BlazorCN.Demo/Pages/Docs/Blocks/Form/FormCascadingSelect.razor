@* ============================================================
   Block: form-cascading-select
   Title: FormCascadingSelect
   Description: A form with two dependent select dropdowns where the second select's options change based on the first selection
   Source: original/blocks/form/form-cascading-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Select Product Category</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose a category and subcategory for your product
            </p>
        </div>
        <div class="px-4 py-4">
            <div class="space-y-4">
                @* Category field *@
                <FieldCn>
                    <FieldLabelCn For="category">Category</FieldLabelCn>
                    <SelectCn Value="@_category" ValueChanged="@OnCategoryChanged">
                        <SelectTriggerCn id="category" Class="w-full">
                            <SelectValueCn Placeholder="Select a category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="electronics">Electronics</SelectItemCn>
                            <SelectItemCn Value="clothing">Clothing</SelectItemCn>
                            <SelectItemCn Value="home">Home &amp; Garden</SelectItemCn>
                            <SelectItemCn Value="sports">Sports &amp; Outdoors</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>Choose the main category for your product</FieldDescriptionCn>
                    @if (_categoryError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a category" })" />
                    }
                </FieldCn>

                @* Subcategory field *@
                <FieldCn>
                    <FieldLabelCn For="subcategory">Subcategory</FieldLabelCn>
                    <SelectCn Value="@_subcategory" ValueChanged="@OnSubcategoryChanged" Disabled="@(string.IsNullOrEmpty(_category))">
                        <SelectTriggerCn id="subcategory" Class="w-full">
                            <SelectValueCn Placeholder="@(string.IsNullOrEmpty(_category) ? "Select a category first" : "Select a subcategory")" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var sub in _availableSubcategories)
                            {
                                var subItem = sub;
                                <SelectItemCn Value="@subItem.Value">@subItem.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>
                        @(string.IsNullOrEmpty(_category) ? "Select a category first to see subcategories" : "Choose a specific subcategory")
                    </FieldDescriptionCn>
                    @if (_subcategoryError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a subcategory" })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ClearForm">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveSelection">
                        Save Selection
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SubcategoryOption(string Value, string Label);

    private static readonly SubcategoryOption[] _electronicsOptions =
    [
        new("smartphones", "Smartphones"),
        new("laptops", "Laptops"),
        new("tablets", "Tablets"),
        new("accessories", "Accessories"),
    ];

    private static readonly SubcategoryOption[] _clothingOptions =
    [
        new("mens", "Men's Clothing"),
        new("womens", "Women's Clothing"),
        new("kids", "Kids Clothing"),
        new("shoes", "Shoes"),
    ];

    private static readonly SubcategoryOption[] _homeOptions =
    [
        new("furniture", "Furniture"),
        new("decor", "Home Decor"),
        new("kitchen", "Kitchen & Dining"),
        new("bedding", "Bedding"),
    ];

    private static readonly SubcategoryOption[] _sportsOptions =
    [
        new("fitness", "Fitness Equipment"),
        new("outdoor", "Outdoor Gear"),
        new("team-sports", "Team Sports"),
        new("athletic-wear", "Athletic Wear"),
    ];

    private string _category = "";
    private string _subcategory = "";
    private bool _categoryError = false;
    private bool _subcategoryError = false;

    private SubcategoryOption[] _availableSubcategories => _category switch
    {
        "electronics" => _electronicsOptions,
        "clothing" => _clothingOptions,
        "home" => _homeOptions,
        "sports" => _sportsOptions,
        _ => []
    };

    private void OnCategoryChanged(string? value)
    {
        _category = value ?? "";
        _subcategory = "";
        _categoryError = false;
        _subcategoryError = false;
    }

    private void OnSubcategoryChanged(string? value)
    {
        _subcategory = value ?? "";
        _subcategoryError = false;
    }

    private void ClearForm()
    {
        _category = "";
        _subcategory = "";
        _categoryError = false;
        _subcategoryError = false;
    }

    private void SaveSelection()
    {
        _categoryError = string.IsNullOrEmpty(_category);
        _subcategoryError = string.IsNullOrEmpty(_subcategory);
        // If valid, form is "submitted" (presentational only)
    }
}
