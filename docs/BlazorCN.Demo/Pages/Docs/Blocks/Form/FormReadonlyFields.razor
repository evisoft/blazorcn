@* ============================================================
   Block: form-readonly-fields
   Title: FormReadonlyFields
   Description: A form demonstrating read-only field states with visual indicators for non-editable inputs
   Source: original/blocks/form/form-readonly-fields.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Account Information</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Update your editable account details below
            </p>
        </div>

        <form class="p-4">
            <div class="space-y-4">
                @* userId — read-only *@
                <FieldCn>
                    <FieldLabelCn For="userId">User ID</FieldLabelCn>
                    <FieldContentCn>
                        <div class="relative">
                            <InputCn id="userId" Value="@_userId" readonly="readonly" Class="bg-muted/50 pr-8" />
                            <LucideIconCn Name="lock" Size="16" Class="pointer-events-none absolute right-2 top-1/2 size-4 -translate-y-1/2 text-muted-foreground/60" />
                        </div>
                        <FieldDescriptionCn>Your unique user identifier cannot be changed</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>

                @* email — read-only *@
                <FieldCn>
                    <FieldLabelCn For="email">Email Address</FieldLabelCn>
                    <FieldContentCn>
                        <div class="relative">
                            <InputCn id="email" type="email" Value="@_email" readonly="readonly" Class="bg-muted/50 pr-8" />
                            <LucideIconCn Name="lock" Size="16" Class="pointer-events-none absolute right-2 top-1/2 size-4 -translate-y-1/2 text-muted-foreground/60" />
                        </div>
                        <FieldDescriptionCn>Contact support to change your email address</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>

                @* accountType — disabled select (readonly equivalent) *@
                <FieldCn>
                    <FieldLabelCn For="accountType">Account Type</FieldLabelCn>
                    <FieldContentCn>
                        <SelectCn Value="@_accountType" Disabled="@true">
                            <SelectTriggerCn id="accountType" Class="bg-muted/50">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="free">Free</SelectItemCn>
                                <SelectItemCn Value="premium">Premium</SelectItemCn>
                                <SelectItemCn Value="enterprise">Enterprise</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        <FieldDescriptionCn>Your subscription plan is managed separately</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>

                @* bio — read-only textarea *@
                <FieldCn>
                    <FieldLabelCn For="bio">Bio</FieldLabelCn>
                    <FieldContentCn>
                        <div class="relative">
                            <TextareaCn id="bio" Value="@_bio" readonly="readonly" Class="min-h-[100px] resize-none bg-muted/50" />
                            <LucideIconCn Name="lock" Size="16" Class="pointer-events-none absolute right-2 top-2 size-4 text-muted-foreground/60" />
                        </div>
                        <FieldDescriptionCn>Bio is imported from your LinkedIn profile</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>

                @* username — editable *@
                <FieldCn>
                    <FieldLabelCn For="username">Username</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="username" @bind-Value="_username" Placeholder="Enter your username" />
                        <FieldDescriptionCn>This field can be edited freely</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>

                <div class="flex justify-end gap-2 pt-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Cancel">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="submit" @onclick="SaveChanges">
                        Save Changes
                    </ButtonCn>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private string _userId = "user_8x92kl3m";
    private string _email = "john.smith@example.com";
    private string _accountType = "premium";
    private string _bio = "Software engineer with 10 years of experience in web development. Passionate about building scalable applications and open source.";
    private string _username = "";

    private void Cancel()
    {
        _username = "";
    }

    private void SaveChanges()
    {
        // Presentational only — would submit form data
    }
}
