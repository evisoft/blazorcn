@* ============================================================
   Block: form-toggle-feature-flags
   Title: FormToggleFeatureFlags
   Description: A form for managing feature flags with toggle switches and code-style identifiers
   Source: original/blocks/form/form-toggle-feature-flags.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Feature Flags</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Enable or disable application features
            </p>
        </div>

        <form>
            <div class="divide-y">
                @foreach (var flag in _flags)
                {
                    var f = flag;
                    <div class="px-4 py-3">
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <FieldContentCn>
                                <LabelCn For="@($"toggle-feature-flags-{f.Name}")">@f.Label</LabelCn>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <span class="font-mono text-muted-foreground text-xs">
                                        @f.Key
                                    </span>
                                </div>
                                <FieldDescriptionCn>@f.Description</FieldDescriptionCn>
                            </FieldContentCn>
                            <SwitchCn id="@($"toggle-feature-flags-{f.Name}")" Checked="@_values[f.Name]" CheckedChanged="@((bool v) => _values[f.Name] = v)" />
                        </FieldCn>
                    </div>
                }
            </div>

            <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" type="button" @onclick="SaveChanges">
                    Save Changes
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record FeatureFlag(string Name, string Key, string Label, string Description);

    private static readonly FeatureFlag[] _flags =
    [
        new("darkMode",       "dark_mode",       "Dark Mode",        "Enable dark theme across the application"),
        new("betaFeatures",   "beta_features",   "Beta Features",    "Access experimental features before public release"),
        new("analytics",      "analytics",       "Analytics Tracking","Collect usage data to improve the product"),
        new("autoSave",       "auto_save",       "Auto Save",        "Automatically save changes every 30 seconds"),
        new("debugMode",      "debug_mode",      "Debug Mode",       "Show detailed error messages and logs"),
        new("experimentalUI", "experimental_ui", "Experimental UI",  "Preview upcoming interface improvements"),
    ];

    private readonly Dictionary<string, bool> _values = new()
    {
        ["darkMode"]       = false,
        ["betaFeatures"]   = false,
        ["analytics"]      = true,
        ["autoSave"]       = true,
        ["debugMode"]      = false,
        ["experimentalUI"] = false,
    };

    private void ResetForm()
    {
        _values["darkMode"]       = false;
        _values["betaFeatures"]   = false;
        _values["analytics"]      = true;
        _values["autoSave"]       = true;
        _values["debugMode"]      = false;
        _values["experimentalUI"] = false;
    }

    private void SaveChanges()
    {
        // Handle form submission (presentational only)
    }
}
