@* ============================================================
   Block: form-review-submit
   Title: FormReviewSubmit
   Description: A review-and-submit form that shows a summary of all form values in a read-only card layout with inline edit capability per section.
   Source: original/blocks/form/form-review-submit.tsx
   ============================================================ *@

@if (_isSubmitted)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="px-4 py-8 text-center">
                <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check" Size="24" Class="size-6 text-emerald-600" />
                </div>
                <h2 class="font-semibold text-lg">Submission successful</h2>
                <p class="mt-1 text-muted-foreground text-sm">
                    Your information has been saved successfully
                </p>
                <ButtonCn Class="mt-6" @onclick="@(() => _isSubmitted = false)">
                    Back to form
                </ButtonCn>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-4 py-3">
                <h2 class="font-medium text-sm">Review &amp; Submit</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Review your information and make changes if needed
                </p>
            </div>

            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                @* Personal Info Section *@
                <div class="border-b">
                    <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2.5">
                        <h3 class="font-medium text-sm">Personal Information</h3>
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => ToggleEdit("personal"))">
                            @if (_editingSection == "personal")
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                @("Done")
                            }
                            else
                            {
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5" />
                                @("Edit")
                            }
                        </ButtonCn>
                    </div>

                    <div class="px-4 py-3">
                        @if (_editingSection == "personal")
                        {
                            <div class="space-y-3">
                                <div class="space-y-1">
                                    <label class="text-xs font-medium leading-none">Full name</label>
                                    <InputCn @bind-Value="_fullName" aria-label="Full name" />
                                    @if (!string.IsNullOrEmpty(_fullNameError))
                                    {
                                        <p class="text-xs text-destructive">@_fullNameError</p>
                                    }
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs font-medium leading-none">Date of birth</label>
                                    <input type="date" aria-label="Date of birth" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50" value="@_dateOfBirth" @onchange="@((ChangeEventArgs e) => _dateOfBirth = e.Value?.ToString() ?? "")" />
                                    @if (!string.IsNullOrEmpty(_dateOfBirthError))
                                    {
                                        <p class="text-xs text-destructive">@_dateOfBirthError</p>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <dl class="space-y-2">
                                <div class="flex justify-between">
                                    <dt class="text-muted-foreground text-sm">Full name</dt>
                                    <dd class="font-medium text-sm">@_fullName</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-muted-foreground text-sm">Date of birth</dt>
                                    <dd class="font-medium text-sm">@_dateOfBirth</dd>
                                </div>
                            </dl>
                        }
                    </div>
                </div>

                @* Contact Section *@
                <div class="border-b">
                    <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2.5">
                        <h3 class="font-medium text-sm">Contact Information</h3>
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => ToggleEdit("contact"))">
                            @if (_editingSection == "contact")
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                @("Done")
                            }
                            else
                            {
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5" />
                                @("Edit")
                            }
                        </ButtonCn>
                    </div>

                    <div class="px-4 py-3">
                        @if (_editingSection == "contact")
                        {
                            <div class="space-y-3">
                                <div class="space-y-1">
                                    <label class="text-xs font-medium leading-none">Email</label>
                                    <InputCn @bind-Value="_email" aria-label="Email" />
                                    @if (!string.IsNullOrEmpty(_emailError))
                                    {
                                        <p class="text-xs text-destructive">@_emailError</p>
                                    }
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs font-medium leading-none">Phone</label>
                                    <InputCn @bind-Value="_phone" aria-label="Phone" />
                                    @if (!string.IsNullOrEmpty(_phoneError))
                                    {
                                        <p class="text-xs text-destructive">@_phoneError</p>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <dl class="space-y-2">
                                <div class="flex justify-between">
                                    <dt class="text-muted-foreground text-sm">Email</dt>
                                    <dd class="font-medium text-sm">@_email</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-muted-foreground text-sm">Phone</dt>
                                    <dd class="font-medium text-sm">@_phone</dd>
                                </div>
                            </dl>
                        }
                    </div>
                </div>

                @* Preferences Section *@
                <div class="border-b">
                    <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2.5">
                        <h3 class="font-medium text-sm">Preferences</h3>
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => ToggleEdit("preferences"))">
                            @if (_editingSection == "preferences")
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                @("Done")
                            }
                            else
                            {
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5" />
                                @("Edit")
                            }
                        </ButtonCn>
                    </div>

                    <div class="px-4 py-3">
                        @if (_editingSection == "preferences")
                        {
                            <div class="space-y-3">
                                <div class="space-y-1">
                                    <label class="text-xs font-medium leading-none">Language</label>
                                    <SelectCn Value="@_language" ValueChanged="@OnLanguageChanged">
                                        <SelectTriggerCn Class="w-full" aria-label="Language">
                                            <SelectValueCn Placeholder="Select language" />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var lang in _languages)
                                            {
                                                var l = lang;
                                                <SelectItemCn Value="@l.Value">@l.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>

                                <div class="space-y-2">
                                    <div class="flex items-center justify-between rounded-md px-3 py-2 hover:bg-muted/50">
                                        <span class="text-sm">Push notifications</span>
                                        <SwitchCn @bind-Checked="_notifications" aria-label="Push notifications" />
                                    </div>

                                    <div class="flex items-center justify-between rounded-md px-3 py-2 hover:bg-muted/50">
                                        <span class="text-sm">Newsletter subscription</span>
                                        <SwitchCn @bind-Checked="_newsletter" aria-label="Newsletter subscription" />
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <dl class="space-y-2">
                                <div class="flex justify-between">
                                    <dt class="text-muted-foreground text-sm">Language</dt>
                                    <dd class="font-medium text-sm">@GetLanguageLabel(_language)</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-muted-foreground text-sm">Push notifications</dt>
                                    <dd class="font-medium text-sm">@(_notifications ? "Enabled" : "Disabled")</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-muted-foreground text-sm">Newsletter</dt>
                                    <dd class="font-medium text-sm">@(_newsletter ? "Subscribed" : "Not subscribed")</dd>
                                </div>
                            </dl>
                        }
                    </div>
                </div>

                <div class="bg-muted/50 px-4 py-3">
                    <ButtonCn type="submit" Class="w-full">
                        Confirm &amp; Submit
                    </ButtonCn>
                    <p class="mt-2 text-center text-muted-foreground text-xs">
                        By submitting, you agree to our terms and conditions
                    </p>
                </div>
            </form>
        </div>
    </section>
}

@code {
    private record LanguageOption(string Value, string Label);

    private static readonly LanguageOption[] _languages =
    [
        new("en", "English"),
        new("es", "Spanish"),
        new("fr", "French"),
        new("de", "German"),
    ];

    private string? _editingSection;
    private bool _isSubmitted;

    // Form fields
    private string _fullName    = "Sarah Anderson";
    private string _dateOfBirth = "1990-05-15";
    private string _email       = "sarah.anderson@example.com";
    private string _phone       = "+1 (555) 123-4567";
    private string _language    = "en";
    private bool   _notifications = true;
    private bool   _newsletter    = false;

    // Validation errors
    private string _fullNameError    = "";
    private string _dateOfBirthError = "";
    private string _emailError       = "";
    private string _phoneError       = "";

    private void ToggleEdit(string sec)
    {
        _editingSection = _editingSection == sec ? null : sec;
        _fullNameError    = "";
        _dateOfBirthError = "";
        _emailError       = "";
        _phoneError       = "";
    }

    private void OnLanguageChanged(string? value)
    {
        _language = value ?? "en";
    }

    private string GetLanguageLabel(string value)
    {
        foreach (var l in _languages)
        {
            if (l.Value == value) return l.Label;
        }
        return value;
    }

    private void HandleSubmit()
    {
        var valid = true;

        if (string.IsNullOrWhiteSpace(_fullName))
        {
            _fullNameError = "Full name is required";
            _editingSection = "personal";
            valid = false;
        }
        if (string.IsNullOrWhiteSpace(_dateOfBirth))
        {
            _dateOfBirthError = "Date of birth is required";
            _editingSection = "personal";
            valid = false;
        }
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _emailError = "Invalid email address";
            if (valid) _editingSection = "contact";
            valid = false;
        }
        if (string.IsNullOrWhiteSpace(_phone) || _phone.Replace(" ", "").Replace("-", "").Replace("+", "").Replace("(", "").Replace(")", "").Length < 10)
        {
            _phoneError = "Phone must be at least 10 digits";
            if (valid) _editingSection = "contact";
            valid = false;
        }

        if (valid)
        {
            _editingSection = null;
            _isSubmitted = true;
        }
    }
}
