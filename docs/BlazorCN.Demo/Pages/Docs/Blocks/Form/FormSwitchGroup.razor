@* ============================================================
   Block: form-switch-group
   Title: FormSwitchGroup
   Description: A switch group form with multiple toggle fields demonstrating grouped boolean settings
   Source: original/blocks/form/form-switch-group.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Notification Preferences</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Manage how you receive updates and communications
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2">Communication Settings</legend>
                    <div class="space-y-0">
                        @foreach (var setting in _settings)
                        {
                            var s = setting;
                            <div>
                                <FieldCn Orientation="FieldOrientation.Horizontal" Class="py-4">
                                    <FieldContentCn>
                                        <LabelCn For="@s.Name">@s.Label</LabelCn>
                                        <FieldDescriptionCn>@s.Description</FieldDescriptionCn>
                                    </FieldContentCn>
                                    <SwitchCn id="@s.Name" Checked="@_values[s.Name]" CheckedChanged="@((bool v) => _values[s.Name] = v)" />
                                </FieldCn>
                                @if (s.Name != _settings[_settings.Length - 1].Name)
                                {
                                    <div class="border-b"></div>
                                }
                            </div>
                        }
                    </div>
                </fieldset>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SavePreferences">
                        Save Preferences
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record Setting(string Name, string Label, string Description);

    private static readonly Setting[] _settings =
    [
        new("notifications", "Push Notifications", "Receive push notifications on your device"),
        new("emails", "Email Notifications", "Get updates via email about your account activity"),
        new("marketing", "Marketing Emails", "Receive promotional content and product updates"),
        new("analytics", "Usage Analytics", "Help us improve by sharing anonymous usage data"),
    ];

    private readonly Dictionary<string, bool> _values = new()
    {
        ["notifications"] = true,
        ["emails"] = false,
        ["marketing"] = false,
        ["analytics"] = true,
    };

    private void ResetForm()
    {
        _values["notifications"] = true;
        _values["emails"] = false;
        _values["marketing"] = false;
        _values["analytics"] = true;
    }

    private void SavePreferences()
    {
        // Handle form submission (presentational only)
    }
}
