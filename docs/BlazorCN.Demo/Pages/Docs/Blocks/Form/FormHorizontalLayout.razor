@* ============================================================
   Block: form-horizontal-layout
   Title: FormHorizontalLayout
   Description: A form with labels on the left and inputs on the right, using responsive field orientation
   Source: original/blocks/form/form-horizontal-layout.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Account Settings</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Update your account information</p>
        </div>
        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <FieldGroupCn class="space-y-4">

                @* Full name field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_nameError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="horizontal-layout-name">Full name</FieldLabelCn>
                        <FieldDescriptionCn>
                            Your full name as it appears on official documents
                        </FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_nameError))
                        {
                            <FieldErrorCn Errors="@(new[] { _nameError })" />
                        }
                    </FieldContentCn>
                    <InputCn id="horizontal-layout-name"
                             @bind-Value="_name"
                             Placeholder="John Doe"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_nameError) ? "true" : "false")" />
                </FieldCn>

                @* Email address field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="horizontal-layout-email">Email address</FieldLabelCn>
                        <FieldDescriptionCn>
                            We'll use this email for account notifications
                        </FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_emailError))
                        {
                            <FieldErrorCn Errors="@(new[] { _emailError })" />
                        }
                    </FieldContentCn>
                    <InputCn id="horizontal-layout-email"
                             type="email"
                             @bind-Value="_email"
                             Placeholder="@("john@example.com")"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : "false")" />
                </FieldCn>

                @* Role field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_roleError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="horizontal-layout-role">Role</FieldLabelCn>
                        <FieldDescriptionCn>Your primary role in the organization</FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_roleError))
                        {
                            <FieldErrorCn Errors="@(new[] { _roleError })" />
                        }
                    </FieldContentCn>
                    <SelectCn Value="@_role" ValueChanged="@OnRoleChanged">
                        <SelectTriggerCn id="horizontal-layout-role" Class="w-full">
                            <SelectValueCn Placeholder="Select a role" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="developer">Developer</SelectItemCn>
                            <SelectItemCn Value="designer">Designer</SelectItemCn>
                            <SelectItemCn Value="manager">Manager</SelectItemCn>
                            <SelectItemCn Value="analyst">Analyst</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </FieldCn>

                @* Bio field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_bioError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="horizontal-layout-bio">Bio</FieldLabelCn>
                        <FieldDescriptionCn>Tell us a bit about yourself and your work</FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_bioError))
                        {
                            <FieldErrorCn Errors="@(new[] { _bioError })" />
                        }
                    </FieldContentCn>
                    <TextareaCn id="horizontal-layout-bio"
                                @bind-Value="_bio"
                                Placeholder="I'm a passionate developer..."
                                rows="4"
                                aria-invalid="@(_submitted && !string.IsNullOrEmpty(_bioError) ? "true" : "false")" />
                </FieldCn>

            </FieldGroupCn>

            <div class="mt-6 flex justify-end gap-2">
                <ButtonCn type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="Cancel">
                    Cancel
                </ButtonCn>
                <ButtonCn type="submit" Size="ButtonSize.Sm">
                    Save changes
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _name = "";
    private string _email = "";
    private string _role = "";
    private string _bio = "";

    private string _nameError = "";
    private string _emailError = "";
    private string _roleError = "";
    private string _bioError = "";

    private bool _submitted = false;

    private void OnRoleChanged(string? value)
    {
        _role = value ?? "";
        _roleError = "";
    }

    private void Validate()
    {
        _nameError = _name.Length < 2 ? "Name must be at least 2 characters" : "";
        _emailError = string.IsNullOrWhiteSpace(_email) || !_email.Contains('@')
            ? "Please enter a valid email address"
            : "";
        _roleError = string.IsNullOrEmpty(_role) ? "Please select a role" : "";
        _bioError = _bio.Length < 10 ? "Bio must be at least 10 characters" : "";
    }

    private void HandleSubmit()
    {
        _submitted = true;
        Validate();
        // Presentational only — would submit form data if valid
    }

    private void Cancel()
    {
        _name = "";
        _email = "";
        _role = "";
        _bio = "";
        _nameError = "";
        _emailError = "";
        _roleError = "";
        _bioError = "";
        _submitted = false;
    }
}
