@* ============================================================
   Block: form-select-grouped
   Title: FormSelectGrouped
   Description: A select dropdown form with grouped options using SelectGroup and SelectLabel
   Source: original/blocks/form/form-select-grouped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Select Your Favorite Food</h2>
            <p class="mt-1 text-muted-foreground text-xs">Choose from fruits or vegetables</p>
        </div>
        <div class="px-4 py-4">
            <div class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="food">Food Item</FieldLabelCn>
                    <SelectCn Value="@_food" ValueChanged="@OnFoodChanged">
                        <SelectTriggerCn id="food" Class="w-full">
                            <SelectValueCn Placeholder="Select a food item" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectGroupCn>
                                <SelectLabelCn>Fruits</SelectLabelCn>
                                <SelectItemCn Value="apple">Apple</SelectItemCn>
                                <SelectItemCn Value="banana">Banana</SelectItemCn>
                                <SelectItemCn Value="orange">Orange</SelectItemCn>
                                <SelectItemCn Value="strawberry">Strawberry</SelectItemCn>
                            </SelectGroupCn>
                            <SelectGroupCn>
                                <SelectLabelCn>Vegetables</SelectLabelCn>
                                <SelectItemCn Value="carrot">Carrot</SelectItemCn>
                                <SelectItemCn Value="broccoli">Broccoli</SelectItemCn>
                                <SelectItemCn Value="spinach">Spinach</SelectItemCn>
                                <SelectItemCn Value="tomato">Tomato</SelectItemCn>
                            </SelectGroupCn>
                            <SelectGroupCn>
                                <SelectLabelCn>Grains</SelectLabelCn>
                                <SelectItemCn Value="rice">Rice</SelectItemCn>
                                <SelectItemCn Value="wheat">Wheat</SelectItemCn>
                                <SelectItemCn Value="oats">Oats</SelectItemCn>
                            </SelectGroupCn>
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>Options are organized by food category for easier selection</FieldDescriptionCn>
                    @if (_foodError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a food item" })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ClearForm">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveSelection">
                        Save Selection
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _food = "";
    private bool _foodError = false;

    private void OnFoodChanged(string? value)
    {
        _food = value ?? "";
        _foodError = false;
    }

    private void ClearForm()
    {
        _food = "";
        _foodError = false;
    }

    private void SaveSelection()
    {
        _foodError = string.IsNullOrEmpty(_food);
        // If valid, form is "submitted" (presentational only)
    }
}
