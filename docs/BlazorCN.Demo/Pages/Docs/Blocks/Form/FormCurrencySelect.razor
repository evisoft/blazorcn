@* ============================================================
   Block: form-currency-select
   Title: FormCurrencySelect
   Description: A currency selector with symbols and codes for payment and financial forms.
   Source: original/blocks/form/form-currency-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <fieldset class="space-y-6 px-4 py-6">
                <div class="space-y-2">
                    <p class="text-base font-semibold leading-none">Currency Preferences</p>
                    <p class="text-sm text-muted-foreground">
                        Select your preferred currency for payments and display
                    </p>
                </div>

                @* Payment Currency field *@
                <FieldCn>
                    <FieldLabelCn For="currency">Payment Currency</FieldLabelCn>
                    <FieldDescriptionCn>
                        Currency for processing payments and transactions
                    </FieldDescriptionCn>
                    <SelectCn Value="@_currency" ValueChanged="@OnCurrencyChanged">
                        <SelectTriggerCn id="currency" Class="w-full" aria-invalid="@(_currencyError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select currency" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var curr in _currencies)
                            {
                                var c = curr;
                                <SelectItemCn Value="@c.Code">
                                    <div class="flex items-center gap-2">
                                        <span class="w-6 font-medium">@c.Symbol</span>
                                        <span class="font-mono text-xs text-muted-foreground">@c.Code</span>
                                        <span class="text-muted-foreground">-</span>
                                        <span>@c.Name</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_currencyError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a currency" })" />
                    }
                </FieldCn>

                @* Display Currency field *@
                <FieldCn>
                    <FieldLabelCn For="displayCurrency">Display Currency</FieldLabelCn>
                    <FieldDescriptionCn>
                        Currency used for showing prices throughout the app
                    </FieldDescriptionCn>
                    <SelectCn Value="@_displayCurrency" ValueChanged="@OnDisplayCurrencyChanged">
                        <SelectTriggerCn id="displayCurrency" Class="w-full" aria-invalid="@(_displayCurrencyError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select display currency" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var curr in _currencies)
                            {
                                var c = curr;
                                <SelectItemCn Value="@c.Code">
                                    <div class="flex items-center gap-2">
                                        <span class="w-6 font-medium">@c.Symbol</span>
                                        <span class="font-mono text-xs text-muted-foreground">@c.Code</span>
                                        <span class="text-muted-foreground">-</span>
                                        <span>@c.Name</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_displayCurrencyError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a display currency" })" />
                    }
                </FieldCn>
            </fieldset>

            <div class="flex justify-end gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn type="submit">Save Preferences</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record CurrencyOption(string Symbol, string Code, string Name);

    private static readonly CurrencyOption[] _currencies =
    [
        new("$",  "USD", "US Dollar"),
        new("€",  "EUR", "Euro"),
        new("£",  "GBP", "British Pound"),
        new("¥",  "JPY", "Japanese Yen"),
        new("¥",  "CNY", "Chinese Yuan"),
        new("₹",  "INR", "Indian Rupee"),
        new("$",  "AUD", "Australian Dollar"),
        new("$",  "CAD", "Canadian Dollar"),
        new("Fr", "CHF", "Swiss Franc"),
        new("$",  "SGD", "Singapore Dollar"),
    ];

    private string _currency = "";
    private string _displayCurrency = "";
    private bool _currencyError = false;
    private bool _displayCurrencyError = false;

    private void OnCurrencyChanged(string? value)
    {
        _currency = value ?? "";
        _currencyError = false;
    }

    private void OnDisplayCurrencyChanged(string? value)
    {
        _displayCurrency = value ?? "";
        _displayCurrencyError = false;
    }

    private void ResetForm()
    {
        _currency = "";
        _displayCurrency = "";
        _currencyError = false;
        _displayCurrencyError = false;
    }

    private void HandleSubmit()
    {
        _currencyError = string.IsNullOrEmpty(_currency);
        _displayCurrencyError = string.IsNullOrEmpty(_displayCurrency);
        // If valid, form is "submitted" (presentational only)
    }
}
