@* ============================================================
   Block: form-url-input
   Title: FormUrlInput
   Description: A URL input form with proper URL validation
   Source: original/blocks/form/form-url-input.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Add Website</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Enter the URL of your website or portfolio
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_websiteError) ? "true" : null)">
                    <LabelCn For="url-input-website">Website URL</LabelCn>
                    <InputCn id="url-input-website"
                             type="url"
                             Placeholder="@("https://example.com")"
                             @bind-Value="_website"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_websiteError) ? "true" : "false")" />
                    <FieldDescriptionCn>Include the full URL starting with https://</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_websiteError))
                    {
                        <FieldErrorCn Errors="@(new[] { _websiteError })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Clear">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="submit" @onclick="Submit">
                        Save Website
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _website = "";
    private bool _submitted = false;
    private string _websiteError = "";

    private void Validate()
    {
        _websiteError = "";

        if (string.IsNullOrWhiteSpace(_website))
        {
            _websiteError = "Please enter a valid URL (e.g., https://example.com)";
        }
        else if (!Uri.TryCreate(_website, UriKind.Absolute, out var uri) ||
                 (uri.Scheme != "http" && uri.Scheme != "https"))
        {
            _websiteError = "Please enter a valid URL (e.g., https://example.com)";
        }
    }

    private void Clear()
    {
        _website = "";
        _submitted = false;
        _websiteError = "";
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
        // Handle form submission (presentational only)
    }
}
