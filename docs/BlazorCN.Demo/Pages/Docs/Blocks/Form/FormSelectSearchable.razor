@* ============================================================
   Block: form-select-searchable
   Title: FormSelectSearchable
   Description: A searchable combobox-style select form using Popover and Command components
   Source: original/blocks/form/form-select-searchable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Select Framework</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Search and select your preferred framework
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="select-searchable-framework">Framework</FieldLabelCn>
                    <PopoverCn Open="@_open" OpenChanged="@((bool v) => _open = v)">
                        <PopoverTriggerCn id="select-searchable-framework" Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-full justify-between" data-variant="outline" data-size="default" role="combobox" aria-expanded="@(_open ? "true" : "false")" aria-invalid="@(_submitted && _hasError ? "true" : null)">
                                @if (!string.IsNullOrEmpty(_framework))
                                {
                                    @(_frameworks.FirstOrDefault(f => f.Value == _framework)?.Label ?? "Select framework...")
                                }
                                else
                                {
                                    <span>Select framework...</span>
                                }
                                <LucideIconCn Name="chevrons-up-down" Size="16" Class="ml-2 size-4 shrink-0 opacity-50" />
                            </PopoverTriggerCn>
                        <PopoverContentCn Class="w-full p-0" Align="FloatingAlign.Start">
                            <CommandCn>
                                <CommandInputCn Placeholder="Search frameworks..." />
                                <CommandListCn>
                                    <CommandEmptyCn>No framework found.</CommandEmptyCn>
                                    <CommandGroupCn>
                                        @foreach (var fw in _frameworks)
                                        {
                                            var framework = fw;
                                            <CommandItemCn Value="@framework.Value"
                                                           OnSelect="@(() => SelectFramework(framework.Value))">
                                                <LucideIconCn Name="check" Size="16" Class="@Cn.Merge("mr-2 size-4", _framework == framework.Value ? "opacity-100" : "opacity-0")" />
                                                @framework.Label
                                            </CommandItemCn>
                                        }
                                    </CommandGroupCn>
                                </CommandListCn>
                            </CommandCn>
                        </PopoverContentCn>
                    </PopoverCn>
                    <FieldDescriptionCn>Type to search through available frameworks</FieldDescriptionCn>
                    @if (_submitted && _hasError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a framework" })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ClearForm">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveFramework">
                        Save Framework
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private bool _open = false;
    private string _framework = "";
    private bool _submitted = false;
    private bool _hasError => string.IsNullOrEmpty(_framework);

    private static readonly FrameworkOption[] _frameworks =
    [
        new("next", "Next.js"),
        new("react", "React"),
        new("vue", "Vue"),
        new("nuxt", "Nuxt"),
        new("remix", "Remix"),
        new("astro", "Astro"),
        new("svelte", "Svelte"),
        new("sveltekit", "SvelteKit"),
        new("solid", "Solid"),
        new("qwik", "Qwik"),
    ];

    private void SelectFramework(string value)
    {
        _framework = _framework == value ? "" : value;
        _open = false;
    }

    private void ClearForm()
    {
        _framework = "";
        _submitted = false;
        _open = false;
    }

    private void SaveFramework()
    {
        _submitted = true;
        if (!_hasError)
        {
            // Handle form submission
        }
    }

    private record FrameworkOption(string Value, string Label);
}
