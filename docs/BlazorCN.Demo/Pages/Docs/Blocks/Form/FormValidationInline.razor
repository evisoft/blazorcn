@* ============================================================
   Block: form-validation-inline
   Title: FormValidationInline
   Description: A form demonstrating inline validation messages appearing directly below each field with different validation rules.
   Source: original/blocks/form/form-validation-inline.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Create Account</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Fill out the form below to create your account
            </p>
        </div>

        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="validation-inline-name">Full Name</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="validation-inline-name" @bind-Value="_name" Placeholder="John Doe" aria-invalid="@(_nameError != "" ? "true" : "false")" />
                        <FieldDescriptionCn>Enter your first and last name</FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_nameError))
                        {
                            <FieldErrorCn>@_nameError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="validation-inline-email">Email Address</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="validation-inline-email" type="email" @bind-Value="_email" Placeholder="@("john@example.com")" aria-invalid="@(_emailError != "" ? "true" : "false")" />
                        <FieldDescriptionCn>We'll never share your email with anyone</FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_emailError))
                        {
                            <FieldErrorCn>@_emailError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="validation-inline-age">Age</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="validation-inline-age" type="number" @bind-Value="_age" Placeholder="25" aria-invalid="@(_ageError != "" ? "true" : "false")" />
                        <FieldDescriptionCn>You must be 18 or older to register</FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_ageError))
                        {
                            <FieldErrorCn>@_ageError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="validation-inline-username">Username</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="validation-inline-username" @bind-Value="_username" Placeholder="johndoe" aria-invalid="@(_usernameError != "" ? "true" : "false")" />
                        <FieldDescriptionCn>
                            Lowercase letters, numbers, and underscores only
                        </FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_usernameError))
                        {
                            <FieldErrorCn>@_usernameError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>
            </div>

            <div class="mt-6 flex gap-3">
                <ButtonCn type="submit" Class="flex-1">
                    Create Account
                </ButtonCn>
                <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Reset">
                    Reset
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _name = "";
    private string _email = "";
    private string _age = "";
    private string _username = "";

    private string _nameError = "";
    private string _emailError = "";
    private string _ageError = "";
    private string _usernameError = "";

    private void HandleSubmit()
    {
        _nameError = "";
        _emailError = "";
        _ageError = "";
        _usernameError = "";

        var valid = true;

        if (_name.Length < 2)
        {
            _nameError = "Name must be at least 2 characters";
            valid = false;
        }

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@') || !_email.Contains('.'))
        {
            _emailError = "Please enter a valid email address";
            valid = false;
        }

        if (string.IsNullOrWhiteSpace(_age) || !int.TryParse(_age, out int ageVal))
        {
            _ageError = "Age must be a number";
            valid = false;
        }
        else if (ageVal < 18)
        {
            _ageError = "You must be at least 18 years old";
            valid = false;
        }
        else if (ageVal > 120)
        {
            _ageError = "Please enter a valid age";
            valid = false;
        }

        if (_username.Length < 3)
        {
            _usernameError = "Username must be at least 3 characters";
            valid = false;
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_username, @"^[a-z0-9_]+$"))
        {
            _usernameError = "Username can only contain lowercase letters, numbers, and underscores";
            valid = false;
        }

        if (valid)
        {
            // Presentational only — would submit form data
        }
    }

    private void Reset()
    {
        _name = "";
        _email = "";
        _age = "";
        _username = "";
        _nameError = "";
        _emailError = "";
        _ageError = "";
        _usernameError = "";
    }
}
