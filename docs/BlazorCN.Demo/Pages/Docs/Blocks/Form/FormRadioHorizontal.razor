@* ============================================================
   Block: form-radio-horizontal
   Title: FormRadioHorizontal
   Description: A radio group with options laid out horizontally in a row instead of a vertical stack
   Source: original/blocks/form/form-radio-horizontal.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Task Settings</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Configure priority and duration</p>
        </div>
        <form class="p-4">
            <FieldGroupCn>
                <FieldSetCn>
                    <FieldLegendCn>Priority level</FieldLegendCn>
                    <FieldDescriptionCn>Set the urgency level for this task</FieldDescriptionCn>
                    <RadioGroupCn Value="@_priority" ValueChanged="@((string? v) => _priority = v ?? "")" Class="flex flex-row gap-4">
                        @foreach (var it in _priorities)
                        {
                            var item = it;
                            <div class="flex cursor-pointer items-center gap-2">
                                <RadioGroupItemCn aria-label="@item.Label" Value="@item.Id" />
                                <span class="cursor-pointer text-sm">@item.Label</span>
                            </div>
                        }
                    </RadioGroupCn>
                    @if (_submitted && string.IsNullOrEmpty(_priority))
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a priority level" })" />
                    }
                </FieldSetCn>

                <FieldSetCn>
                    <FieldLegendCn>Estimated duration</FieldLegendCn>
                    <FieldDescriptionCn>How long will this task take?</FieldDescriptionCn>
                    <RadioGroupCn Value="@_duration" ValueChanged="@((string? v) => _duration = v ?? "")" Class="flex flex-row gap-4">
                        @foreach (var it in _durations)
                        {
                            var item = it;
                            <div class="flex cursor-pointer items-center gap-2">
                                <RadioGroupItemCn aria-label="@item.Label" Value="@item.Id" />
                                <span class="cursor-pointer text-sm">@item.Label</span>
                            </div>
                        }
                    </RadioGroupCn>
                    @if (_submitted && string.IsNullOrEmpty(_duration))
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a duration" })" />
                    }
                </FieldSetCn>
            </FieldGroupCn>

            <div class="mt-6 flex justify-end">
                <ButtonCn type="button" @onclick="SaveSettings">Save Settings</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private static readonly RadioOption[] _priorities =
    [
        new RadioOption("low", "Low"),
        new RadioOption("medium", "Medium"),
        new RadioOption("high", "High"),
        new RadioOption("urgent", "Urgent"),
    ];

    private static readonly RadioOption[] _durations =
    [
        new RadioOption("1h", "1 hour"),
        new RadioOption("4h", "4 hours"),
        new RadioOption("1d", "1 day"),
    ];

    private string _priority = "";
    private string _duration = "";
    private bool _submitted = false;

    private void SaveSettings()
    {
        _submitted = true;
    }

    private record RadioOption(string Id, string Label);
}
