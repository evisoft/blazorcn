@* ============================================================
   Block: form-dependent-fields
   Title: FormDependentFields
   Description: A form with cascading fields where one field's options depend on another field's value using watch and setValue
   Source: original/blocks/form/form-dependent-fields.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Shipping Address</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Enter your shipping information</p>
        </div>

        <form class="p-4">
            <div class="space-y-4">
                @* Full Name field *@
                <FieldCn>
                    <FieldLabelCn For="name">Full Name</FieldLabelCn>
                    <InputCn id="name" @bind-Value="_name" Placeholder="Enter your name" />
                    @if (_nameError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Name is required" })" />
                    }
                </FieldCn>

                @* Country field *@
                <FieldCn>
                    <FieldLabelCn For="country">Country</FieldLabelCn>
                    <SelectCn Value="@_country" ValueChanged="@OnCountryChanged">
                        <SelectTriggerCn id="country" Class="w-full">
                            <SelectValueCn Placeholder="Select a country" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="usa">United States</SelectItemCn>
                            <SelectItemCn Value="canada">Canada</SelectItemCn>
                            <SelectItemCn Value="uk">United Kingdom</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>Select your country first</FieldDescriptionCn>
                    @if (_countryError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a country" })" />
                    }
                </FieldCn>

                @* State/Region field *@
                <FieldCn>
                    <FieldLabelCn For="state">State/Region</FieldLabelCn>
                    <SelectCn Value="@_state" ValueChanged="@OnStateChanged" Disabled="@(string.IsNullOrEmpty(_country))">
                        <SelectTriggerCn id="state" Class="w-full">
                            <SelectValueCn Placeholder="@(string.IsNullOrEmpty(_country) ? "Select country first" : "Select a state/region")" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var st in _availableStates)
                            {
                                var stateItem = st;
                                <SelectItemCn Value="@stateItem.Value">@stateItem.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>
                        @(string.IsNullOrEmpty(_country)
                            ? "This field will be enabled after selecting a country"
                            : "Available regions for selected country")
                    </FieldDescriptionCn>
                    @if (_stateError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a state/region" })" />
                    }
                </FieldCn>
            </div>

            <div class="mt-6 flex justify-end gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn type="button" @onclick="OnSubmit">
                    Continue to Shipping
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record StateOption(string Value, string Label);

    private static readonly StateOption[] _usaStates =
    [
        new("ca", "California"),
        new("ny", "New York"),
        new("tx", "Texas"),
        new("fl", "Florida"),
    ];

    private static readonly StateOption[] _canadaStates =
    [
        new("on", "Ontario"),
        new("qc", "Quebec"),
        new("bc", "British Columbia"),
        new("ab", "Alberta"),
    ];

    private static readonly StateOption[] _ukStates =
    [
        new("eng", "England"),
        new("sct", "Scotland"),
        new("wal", "Wales"),
        new("nir", "Northern Ireland"),
    ];

    private string _name = "";
    private string _country = "";
    private string _state = "";
    private bool _nameError = false;
    private bool _countryError = false;
    private bool _stateError = false;

    private StateOption[] _availableStates => _country switch
    {
        "usa" => _usaStates,
        "canada" => _canadaStates,
        "uk" => _ukStates,
        _ => []
    };

    private void OnCountryChanged(string? value)
    {
        _country = value ?? "";
        _state = "";
        _countryError = false;
        _stateError = false;
    }

    private void OnStateChanged(string? value)
    {
        _state = value ?? "";
        _stateError = false;
    }

    private void ResetForm()
    {
        _name = "";
        _country = "";
        _state = "";
        _nameError = false;
        _countryError = false;
        _stateError = false;
    }

    private void OnSubmit()
    {
        _nameError = string.IsNullOrWhiteSpace(_name);
        _countryError = string.IsNullOrEmpty(_country);
        _stateError = string.IsNullOrEmpty(_state);
        // If valid, form is "submitted" (presentational only)
    }
}
