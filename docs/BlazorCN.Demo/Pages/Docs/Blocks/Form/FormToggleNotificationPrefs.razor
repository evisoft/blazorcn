@* ============================================================
   Block: form-toggle-notification-prefs
   Title: FormToggleNotificationPrefs
   Description: A categorized notification settings form with email and push notification sections
   Source: original/blocks/form/form-toggle-notification-prefs.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Notification Preferences</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose how you want to be notified about activity
            </p>
        </div>

        <form class="p-4">
            <div class="space-y-6">
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Email Notifications</legend>
                    <div class="mt-4 space-y-4">
                        @foreach (var notif in _emailNotifications)
                        {
                            var n = notif;
                            <FieldCn Orientation="FieldOrientation.Horizontal">
                                <FieldContentCn>
                                    <LabelCn For="@n.Name">@n.Label</LabelCn>
                                    <FieldDescriptionCn>@n.Description</FieldDescriptionCn>
                                </FieldContentCn>
                                <SwitchCn id="@n.Name" Checked="@_values[n.Name]" CheckedChanged="@((bool v) => _values[n.Name] = v)" />
                            </FieldCn>
                        }
                    </div>
                </fieldset>

                <div class="border-t"></div>

                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Push Notifications</legend>
                    <div class="mt-4 space-y-4">
                        @foreach (var notif in _pushNotifications)
                        {
                            var n = notif;
                            <FieldCn Orientation="FieldOrientation.Horizontal">
                                <FieldContentCn>
                                    <LabelCn For="@n.Name">@n.Label</LabelCn>
                                    <FieldDescriptionCn>@n.Description</FieldDescriptionCn>
                                </FieldContentCn>
                                <SwitchCn id="@n.Name" Checked="@_values[n.Name]" CheckedChanged="@((bool v) => _values[n.Name] = v)" />
                            </FieldCn>
                        }
                    </div>
                </fieldset>
            </div>

            <div class="mt-6 flex items-center justify-end gap-2 border-t pt-4">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button" @onclick="ResetToDefault">
                    Reset to Default
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" type="button" @onclick="UpdatePreferences">
                    Update Preferences
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record NotificationItem(string Name, string Label, string Description);

    private static readonly NotificationItem[] _emailNotifications =
    [
        new("emailComments", "Comments", "Receive emails when someone comments on your posts"),
        new("emailMentions", "Mentions", "Get notified when someone mentions you"),
        new("emailUpdates", "Product Updates", "Weekly digest of new features and improvements"),
    ];

    private static readonly NotificationItem[] _pushNotifications =
    [
        new("pushComments", "Comments", "Push notifications for new comments"),
        new("pushMentions", "Mentions", "Real-time alerts when you're mentioned"),
        new("pushUpdates", "Product Updates", "Browser notifications for major updates"),
    ];

    private readonly Dictionary<string, bool> _values = new()
    {
        ["emailComments"] = true,
        ["emailMentions"] = true,
        ["emailUpdates"] = false,
        ["pushComments"] = false,
        ["pushMentions"] = true,
        ["pushUpdates"] = false,
    };

    private void ResetToDefault()
    {
        _values["emailComments"] = true;
        _values["emailMentions"] = true;
        _values["emailUpdates"] = false;
        _values["pushComments"] = false;
        _values["pushMentions"] = true;
        _values["pushUpdates"] = false;
    }

    private void UpdatePreferences()
    {
        // Handle form submission (presentational only)
    }
}
