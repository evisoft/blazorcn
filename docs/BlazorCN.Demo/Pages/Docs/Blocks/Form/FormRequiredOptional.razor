@* ============================================================
   Block: form-required-optional
   Title: FormRequiredOptional
   Description: A form showing the pattern for required versus optional fields with asterisks and labels.
   Source: original/blocks/form/form-required-optional.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Contact Information</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Fields marked with <span class="text-destructive">*</span> are required
            </p>
        </div>

        <form class="p-4" @onsubmit="Submit" @onsubmit:preventDefault="true">
            <div class="space-y-4">
                <div class="grid gap-4 sm:grid-cols-2">
                    <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_firstNameError) ? "true" : null)">
                        <LabelCn For="required-optional-firstName">
                            First Name <span class="text-destructive">*</span>
                        </LabelCn>
                        <InputCn id="required-optional-firstName"
                                 Placeholder="John"
                                 @bind-Value="_firstName"
                                 aria-required="true"
                                 aria-invalid="@(_submitted && !string.IsNullOrEmpty(_firstNameError) ? "true" : "false")" />
                        @if (_submitted && !string.IsNullOrEmpty(_firstNameError))
                        {
                            <FieldErrorCn Errors="@(new[] { _firstNameError })" />
                        }
                    </FieldCn>

                    <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_lastNameError) ? "true" : null)">
                        <LabelCn For="required-optional-lastName">
                            Last Name <span class="text-destructive">*</span>
                        </LabelCn>
                        <InputCn id="required-optional-lastName"
                                 Placeholder="Doe"
                                 @bind-Value="_lastName"
                                 aria-required="true"
                                 aria-invalid="@(_submitted && !string.IsNullOrEmpty(_lastNameError) ? "true" : "false")" />
                        @if (_submitted && !string.IsNullOrEmpty(_lastNameError))
                        {
                            <FieldErrorCn Errors="@(new[] { _lastNameError })" />
                        }
                    </FieldCn>
                </div>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : null)">
                    <LabelCn For="required-optional-email">
                        Email Address <span class="text-destructive">*</span>
                    </LabelCn>
                    <InputCn id="required-optional-email"
                             type="email"
                             Placeholder="@("john@example.com")"
                             @bind-Value="_email"
                             aria-required="true"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : "false")" />
                    <FieldDescriptionCn>Your primary contact email</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_emailError))
                    {
                        <FieldErrorCn Errors="@(new[] { _emailError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_phoneError) ? "true" : null)">
                    <LabelCn For="required-optional-phone">
                        Phone Number <span class="text-xs text-muted-foreground">(optional)</span>
                    </LabelCn>
                    <InputCn id="required-optional-phone"
                             type="tel"
                             Placeholder="+1 (555) 000-0000"
                             @bind-Value="_phone"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_phoneError) ? "true" : "false")" />
                    <FieldDescriptionCn>We'll only call if necessary</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_phoneError))
                    {
                        <FieldErrorCn Errors="@(new[] { _phoneError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_companyError) ? "true" : null)">
                    <LabelCn For="company">
                        Company <span class="text-xs text-muted-foreground">(optional)</span>
                    </LabelCn>
                    <InputCn id="company"
                             Placeholder="Acme Inc."
                             @bind-Value="_company"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_companyError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_companyError))
                    {
                        <FieldErrorCn Errors="@(new[] { _companyError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_websiteError) ? "true" : null)">
                    <LabelCn For="required-optional-website">
                        Website <span class="text-xs text-muted-foreground">(optional)</span>
                    </LabelCn>
                    <InputCn id="required-optional-website"
                             type="url"
                             Placeholder="https://example.com"
                             @bind-Value="_website"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_websiteError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_websiteError))
                    {
                        <FieldErrorCn Errors="@(new[] { _websiteError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_notesError) ? "true" : null)">
                    <LabelCn For="notes">
                        Additional Notes <span class="text-xs text-muted-foreground">(optional)</span>
                    </LabelCn>
                    <TextareaCn id="notes"
                                Placeholder="@("Any additional information you'd like to share...")"
                                @bind-Value="_notes"
                                rows="3"
                                aria-invalid="@(_submitted && !string.IsNullOrEmpty(_notesError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_notesError))
                    {
                        <FieldErrorCn Errors="@(new[] { _notesError })" />
                    }
                </FieldCn>
            </div>

            <div class="mt-6 flex gap-3">
                <ButtonCn type="submit" Class="flex-1">
                    Submit Information
                </ButtonCn>
                <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Reset">
                    Reset
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _phone = "";
    private string _company = "";
    private string _website = "";
    private string _notes = "";

    private bool _submitted = false;

    private string _firstNameError = "";
    private string _lastNameError = "";
    private string _emailError = "";
    private string _phoneError = "";
    private string _companyError = "";
    private string _websiteError = "";
    private string _notesError = "";

    private void Validate()
    {
        _firstNameError = string.IsNullOrWhiteSpace(_firstName) ? "First name is required" : "";
        _lastNameError = string.IsNullOrWhiteSpace(_lastName) ? "Last name is required" : "";
        _emailError = string.IsNullOrWhiteSpace(_email) || !_email.Contains('@')
            ? "Please enter a valid email address"
            : "";
        _phoneError = "";
        _companyError = "";
        _websiteError = !string.IsNullOrEmpty(_website) &&
                        !_website.StartsWith("http://") && !_website.StartsWith("https://")
            ? "Please enter a valid URL"
            : "";
        _notesError = "";
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
    }

    private void Reset()
    {
        _firstName = "";
        _lastName = "";
        _email = "";
        _phone = "";
        _company = "";
        _website = "";
        _notes = "";
        _firstNameError = "";
        _lastNameError = "";
        _emailError = "";
        _phoneError = "";
        _companyError = "";
        _websiteError = "";
        _notesError = "";
        _submitted = false;
    }
}
