@* ============================================================
   Block: form-checkbox-list-with-actions
   Title: FormCheckboxListWithActions
   Description: A checkbox list with select all toggle and selection count display at the top
   Source: original/blocks/form/form-checkbox-list-with-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">User Permissions</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure access permissions for this user
            </p>
        </div>
        <form class="p-4">
            <FieldSetCn>
                <FieldLegendCn>Access permissions</FieldLegendCn>
                <FieldDescriptionCn>Select which actions this user can perform</FieldDescriptionCn>

                <div class="mb-3 flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex cursor-pointer items-center gap-2">
                        <CheckboxCn Checked="@_isAllSelected"
                                    CheckedChanged="@HandleSelectAll"
                                    id="checkbox-list-with-actions-select-all" />
                        <FieldLabelCn For="checkbox-list-with-actions-select-all" Class="cursor-pointer font-medium">
                            Select all
                        </FieldLabelCn>
                    </div>
                    <span class="text-muted-foreground text-xs">
                        @_selectedPermissions.Count of @_permissions.Length selected
                    </span>
                </div>

                <FieldGroupCn>
                    @foreach (var perm in _permissions)
                    {
                        var permission = perm;
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <CheckboxCn id="@($"checkbox-list-with-actions-permissions-{permission.Id}")"
                                        Checked="@_selectedPermissions.Contains(permission.Id)"
                                        CheckedChanged="@((bool chk) => TogglePermission(permission.Id, chk))" />
                            <div class="flex-1">
                                <FieldLabelCn For="@($"checkbox-list-with-actions-permissions-{permission.Id}")" Class="font-normal">
                                    @permission.Label
                                </FieldLabelCn>
                                <FieldDescriptionCn>@permission.Description</FieldDescriptionCn>
                            </div>
                        </FieldCn>
                    }
                </FieldGroupCn>

                @if (_submitted && _selectedPermissions.Count == 0)
                {
                    <FieldErrorCn Errors="@(new[] { "Please select at least one permission" })" />
                }
            </FieldSetCn>

            <div class="mt-6 flex justify-end">
                <ButtonCn type="button" @onclick="HandleSubmit">Save Permissions</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record Permission(string Id, string Label, string Description);

    private static readonly Permission[] _permissions =
    [
        new("read",   "Read",   "View files and folders"),
        new("write",  "Write",  "Create and edit files"),
        new("delete", "Delete", "Remove files and folders"),
        new("share",  "Share",  "Share with other users"),
        new("admin",  "Admin",  "Manage users and settings"),
        new("export", "Export", "Export data and reports"),
    ];

    private List<string> _selectedPermissions = [];
    private bool _submitted = false;

    private bool _isAllSelected => _selectedPermissions.Count == _permissions.Length;

    private void HandleSelectAll(bool isChecked)
    {
        if (isChecked)
            _selectedPermissions = _permissions.Select(p => p.Id).ToList();
        else
            _selectedPermissions = [];
    }

    private void TogglePermission(string id, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedPermissions.Contains(id))
                _selectedPermissions.Add(id);
        }
        else
        {
            _selectedPermissions.Remove(id);
        }
        _submitted = false;
    }

    private void HandleSubmit()
    {
        _submitted = true;
        // If valid (_selectedPermissions.Count > 0), form is submitted (presentational only)
    }
}
