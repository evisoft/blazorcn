@* ============================================================
   Block: form-timezone-select
   Title: FormTimezoneSelect
   Description: A timezone selector displaying UTC offsets for scheduling and time-sensitive applications.
   Source: original/blocks/form/form-timezone-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <fieldset class="space-y-6 px-4 py-6">
                <div class="space-y-2">
                    <p class="text-base font-semibold leading-none">Time Zone Settings</p>
                    <p class="text-sm text-muted-foreground">
                        Configure your timezone preferences for accurate scheduling
                    </p>
                </div>

                @* Your Timezone field *@
                <FieldCn>
                    <FieldLabelCn For="timezone-select-timezone">Your Timezone</FieldLabelCn>
                    <FieldDescriptionCn>
                        This will be used for displaying dates and times
                    </FieldDescriptionCn>
                    <SelectCn Value="@_timezone" ValueChanged="@OnTimezoneChanged">
                        <SelectTriggerCn id="timezone-select-timezone" Class="w-full" aria-invalid="@(_timezoneError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select timezone" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var tz in _timezones)
                            {
                                var t = tz;
                                <SelectItemCn Value="@t.Value">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs text-muted-foreground">@t.Offset</span>
                                        <span>@t.Name</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_timezoneError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a timezone" })" />
                    }
                </FieldCn>

                @* Meeting Timezone field *@
                <FieldCn>
                    <FieldLabelCn For="meetingTimezone">Meeting Timezone</FieldLabelCn>
                    <FieldDescriptionCn>Default timezone for scheduling meetings</FieldDescriptionCn>
                    <SelectCn Value="@_meetingTimezone" ValueChanged="@OnMeetingTimezoneChanged">
                        <SelectTriggerCn id="meetingTimezone" Class="w-full" aria-invalid="@(_meetingTimezoneError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select meeting timezone" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var tz in _timezones)
                            {
                                var t = tz;
                                <SelectItemCn Value="@t.Value">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs text-muted-foreground">@t.Offset</span>
                                        <span>@t.Name</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_meetingTimezoneError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a meeting timezone" })" />
                    }
                </FieldCn>
            </fieldset>

            <div class="flex justify-end gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn type="submit">Save Settings</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record TimezoneOption(string Offset, string Name, string Value);

    private static readonly TimezoneOption[] _timezones =
    [
        new("UTC-8",   "Pacific Time",          "America/Los_Angeles"),
        new("UTC-7",   "Mountain Time",         "America/Denver"),
        new("UTC-6",   "Central Time",          "America/Chicago"),
        new("UTC-5",   "Eastern Time",          "America/New_York"),
        new("UTC+0",   "London",                "Europe/London"),
        new("UTC+1",   "Central European Time", "Europe/Paris"),
        new("UTC+3",   "Moscow",                "Europe/Moscow"),
        new("UTC+5:30","India Standard Time",   "Asia/Kolkata"),
        new("UTC+8",   "Singapore",             "Asia/Singapore"),
        new("UTC+9",   "Japan Standard Time",   "Asia/Tokyo"),
    ];

    private string _timezone = "";
    private string _meetingTimezone = "";
    private bool _timezoneError = false;
    private bool _meetingTimezoneError = false;

    private void OnTimezoneChanged(string? value)
    {
        _timezone = value ?? "";
        _timezoneError = false;
    }

    private void OnMeetingTimezoneChanged(string? value)
    {
        _meetingTimezone = value ?? "";
        _meetingTimezoneError = false;
    }

    private void ResetForm()
    {
        _timezone = "";
        _meetingTimezone = "";
        _timezoneError = false;
        _meetingTimezoneError = false;
    }

    private void HandleSubmit()
    {
        _timezoneError = string.IsNullOrEmpty(_timezone);
        _meetingTimezoneError = string.IsNullOrEmpty(_meetingTimezone);
        // If valid, form is "submitted" (presentational only)
    }
}
