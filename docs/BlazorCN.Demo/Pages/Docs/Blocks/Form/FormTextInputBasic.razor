@* ============================================================
   Block: form-text-input-basic
   Title: FormTextInputBasic
   Description: A simple text input form demonstrating the basic Field and Controller pattern
   Source: original/blocks/form/form-text-input-basic.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Create New Item</h2>
            <p class="mt-1 text-muted-foreground text-xs">Enter a title for your new item</p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_titleError) ? "true" : null)">
                    <LabelCn For="text-input-basic-title">Title</LabelCn>
                    <InputCn id="text-input-basic-title"
                             Placeholder="Enter a descriptive title"
                             @bind-Value="_title"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_titleError) ? "true" : "false")" />
                    <FieldDescriptionCn>Choose a clear, concise title between 3-50 characters</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_titleError))
                    {
                        <FieldErrorCn Errors="@(new[] { _titleError })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Clear">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="submit" @onclick="Submit">
                        Create Item
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _title = "";
    private bool _submitted = false;
    private string _titleError = "";

    private void Validate()
    {
        _titleError = "";

        if (_title.Length < 3)
            _titleError = "Title must be at least 3 characters";
        else if (_title.Length > 50)
            _titleError = "Title must not exceed 50 characters";
    }

    private void Clear()
    {
        _title = "";
        _submitted = false;
        _titleError = "";
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
        // Handle form submission (presentational only)
    }
}
