@* ============================================================
   Block: form-inline-fields
   Title: FormInlineFields
   Description: A compact inline form with fields arranged in a single row, perfect for filters and search bars
   Source: original/blocks/form/form-inline-fields.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Filter Products</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Use the filters below to narrow down results
            </p>
        </div>
        <form class="p-4">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end">

                @* Search field *@
                <FieldCn Class="flex-1">
                    <FieldLabelCn For="search" Class="text-xs">Search</FieldLabelCn>
                    <div class="relative">
                        <LucideIconCn Name="search" Size="16" Class="absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
                        <InputCn id="search"
                                 Placeholder="Search products..."
                                 Class="pl-8"
                                 @bind-Value="_search" />
                    </div>
                </FieldCn>

                @* Category field *@
                <FieldCn Class="min-w-[160px]">
                    <FieldLabelCn For="category" Class="text-xs">Category</FieldLabelCn>
                    <SelectCn Value="@_category" ValueChanged="@((string? v) => _category = v ?? "")">
                        <SelectTriggerCn id="category">
                            <SelectValueCn Placeholder="All categories" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="all">All categories</SelectItemCn>
                            <SelectItemCn Value="electronics">Electronics</SelectItemCn>
                            <SelectItemCn Value="clothing">Clothing</SelectItemCn>
                            <SelectItemCn Value="books">Books</SelectItemCn>
                            <SelectItemCn Value="home">Home &amp; Garden</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </FieldCn>

                @* Status field *@
                <FieldCn Class="min-w-[140px]">
                    <FieldLabelCn For="status" Class="text-xs">Status</FieldLabelCn>
                    <SelectCn Value="@_status" ValueChanged="@((string? v) => _status = v ?? "")">
                        <SelectTriggerCn id="status">
                            <SelectValueCn Placeholder="All status" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="all">All status</SelectItemCn>
                            <SelectItemCn Value="active">Active</SelectItemCn>
                            <SelectItemCn Value="draft">Draft</SelectItemCn>
                            <SelectItemCn Value="archived">Archived</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </FieldCn>

                <ButtonCn type="button" Size="ButtonSize.Sm" Class="sm:mb-0.5" @onclick="ApplyFilters">
                    Apply filters
                </ButtonCn>
            </div>

            <div class="mt-4 flex items-center gap-2">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" @onclick="ClearAll">
                    Clear all
                </ButtonCn>
                <span class="text-xs text-muted-foreground">124 results found</span>
            </div>
        </form>
    </div>
</section>

@code {
    private string _search = "";
    private string _category = "";
    private string _status = "";

    private void ApplyFilters()
    {
        // Presentational only — apply filter logic as needed
    }

    private void ClearAll()
    {
        _search = "";
        _category = "";
        _status = "";
    }
}
