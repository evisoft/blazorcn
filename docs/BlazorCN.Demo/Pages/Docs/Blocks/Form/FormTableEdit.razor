@* ============================================================
   Block: form-table-edit
   Title: FormTableEdit
   Description: An editable table form where each row contains editable cells with add and remove functionality
   Source: original/blocks/form/form-table-edit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Team Members</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage your team members and their roles
            </p>
        </div>

        <div class="overflow-x-auto">
            <div class="min-w-[600px] px-4 py-3">
                @* Header Row *@
                <div class="mb-2 grid grid-cols-[1fr,1fr,180px,auto] gap-3 px-3">
                    <span class="font-medium text-muted-foreground text-xs">Name</span>
                    <span class="font-medium text-muted-foreground text-xs">Email</span>
                    <span class="font-medium text-muted-foreground text-xs">Role</span>
                    <div class="w-8"></div>
                </div>

                @* Data Rows *@
                <div class="space-y-2">
                    @foreach (var it in _members)
                    {
                        var member = it;
                        <div class="grid grid-cols-[1fr,1fr,180px,auto] items-start gap-3 rounded-md border bg-muted/50 p-3">
                            @* Name *@
                            <div>
                                <InputCn aria-label="Full name" Value="@member.Name" @oninput="@((e) => UpdateName(member.Id, e.Value?.ToString() ?? ""))" Placeholder="Full name" Class="h-8" />
                                @if (_showErrors && string.IsNullOrWhiteSpace(member.Name))
                                {
                                    <p class="mt-1 text-xs text-destructive">Name is required</p>
                                }
                            </div>

                            @* Email *@
                            <div>
                                <input type="email" aria-label="Email" value="@member.Email" @oninput="@((e) => UpdateEmail(member.Id, e.Value?.ToString() ?? ""))" placeholder="@("email@example.com")" class="flex h-8 w-full rounded-md border border-input bg-background px-3 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                                @if (_showErrors && string.IsNullOrWhiteSpace(member.Email))
                                {
                                    <p class="mt-1 text-xs text-destructive">Invalid email</p>
                                }
                            </div>

                            @* Role *@
                            <div>
                                <SelectCn Value="@member.Role" ValueChanged="@((v) => UpdateRole(member.Id, v))">
                                    <SelectTriggerCn Class="h-8" aria-label="@($"Role for {member.Email}")">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="admin">Admin</SelectItemCn>
                                        <SelectItemCn Value="editor">Editor</SelectItemCn>
                                        <SelectItemCn Value="viewer">Viewer</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            @* Remove Button *@
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0" Disabled="@(_members.Count == 1)" aria-label="@($"Remove {member.Email}")" @onclick="@(() => RemoveMember(member.Id))">
                                <LucideIconCn Name="trash" Size="16" Class="size-4 text-muted-foreground" />
                            </ButtonCn>
                        </div>
                    }
                </div>

                @* Add Member Button *@
                <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-8" @onclick="AddMember">
                    <LucideIconCn Name="plus" Size="14" Class="mr-1.5 size-3.5" />
                    Add Member
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                Cancel
            </ButtonCn>
            <ButtonCn Type="button" Size="ButtonSize.Sm" Disabled="@_submitted" @onclick="HandleSubmit">
                @(_submitted ? "Saved" : "Save Changes")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MemberRow(string Id, string Name, string Email, string Role);

    private List<MemberRow> _members =
    [
        new("1", "Alice Johnson", "alice@example.com", "admin"),
        new("2", "Bob Smith", "bob@example.com", "editor"),
        new("3", "Carol White", "carol@example.com", "viewer"),
        new("4", "David Lee", "david@example.com", "editor"),
    ];

    private bool _submitted;
    private bool _showErrors;
    private int _nextId = 5;

    private void UpdateName(string id, string value)
    {
        _members = _members.Select(m => m.Id == id ? m with { Name = value } : m).ToList();
    }

    private void UpdateEmail(string id, string value)
    {
        _members = _members.Select(m => m.Id == id ? m with { Email = value } : m).ToList();
    }

    private void UpdateRole(string id, string value)
    {
        _members = _members.Select(m => m.Id == id ? m with { Role = value } : m).ToList();
    }

    private void RemoveMember(string id)
    {
        _members = _members.Where(m => m.Id != id).ToList();
    }

    private void AddMember()
    {
        _members.Add(new(_nextId.ToString(), "", "", "viewer"));
        _nextId++;
    }

    private async Task HandleSubmit()
    {
        _showErrors = true;
        if (_members.Any(m => string.IsNullOrWhiteSpace(m.Name) || string.IsNullOrWhiteSpace(m.Email)))
            return;

        _submitted = true;
        StateHasChanged();
        await Task.Delay(2000);
        _submitted = false;
        _showErrors = false;
    }
}
