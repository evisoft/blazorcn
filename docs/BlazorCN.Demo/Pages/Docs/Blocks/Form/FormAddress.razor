@* ============================================================
   Block: form-address
   Title: FormAddress
   Description: A comprehensive address form with street, apartment, city, state, and zip code fields in a responsive grid layout with proper field sizing.
   Source: original/blocks/form/form-address.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Shipping Address</h2>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Where should we send your order?</p>
        </div>
        <form class="px-4 py-6" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-4">
                @* Street Address *@
                <div>
                    <LabelCn For="street" Class="mb-1.5 block">Street Address</LabelCn>
                    <div>
                        <InputCn id="street" Placeholder="123 Main St" @bind-Value="_street" />
                        @if (_submitted && string.IsNullOrWhiteSpace(_street))
                        {
                            <p class="mt-1 text-xs text-destructive">Street address is required</p>
                        }
                    </div>
                </div>

                @* Apartment *@
                <div>
                    <LabelCn For="apt" Class="mb-1.5 block">Apartment, Suite, etc. (optional)</LabelCn>
                    <div>
                        <InputCn id="apt" Placeholder="Apt 4B" @bind-Value="_apt" />
                    </div>
                </div>

                @* City / State / ZIP grid *@
                <div class="grid grid-cols-6 gap-3">
                    @* City — col-span-3 *@
                    <div class="col-span-3">
                        <LabelCn For="city" Class="mb-1.5 block">City</LabelCn>
                        <div>
                            <InputCn id="city" Placeholder="San Francisco" @bind-Value="_city" />
                            @if (_submitted && string.IsNullOrWhiteSpace(_city))
                            {
                                <p class="mt-1 text-xs text-destructive">City is required</p>
                            }
                        </div>
                    </div>

                    @* State — col-span-2 *@
                    <div class="col-span-2">
                        <LabelCn For="state-trigger" Class="mb-1.5 block">State</LabelCn>
                        <div>
                            <SelectCn Value="@_state" ValueChanged="@((string? v) => _state = v ?? "")">
                                <SelectTriggerCn id="state-trigger">
                                    <SelectValueCn Placeholder="Select" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var st in _states)
                                    {
                                        var stItem = st;
                                        <SelectItemCn Value="@stItem.Value">@stItem.Value</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                            @if (_submitted && string.IsNullOrWhiteSpace(_state))
                            {
                                <p class="mt-1 text-xs text-destructive">State is required</p>
                            }
                        </div>
                    </div>

                    @* ZIP — col-span-1 *@
                    <div class="col-span-1">
                        <LabelCn For="zip" Class="mb-1.5 block">ZIP</LabelCn>
                        <div>
                            <InputCn id="zip" Placeholder="94102" @bind-Value="_zip" maxlength="5" />
                            @if (_submitted && !System.Text.RegularExpressions.Regex.IsMatch(_zip, @"^\d{5}$"))
                            {
                                <p class="mt-1 text-xs text-destructive">5 digits required</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <ButtonCn Type="submit" Class="mt-6 w-full">
                Continue to Payment
            </ButtonCn>
        </form>
    </div>
</section>

@code {
