@* ============================================================
   Block: form-grid-layout
   Title: FormGridLayout
   Description: A responsive form using CSS grid with fields that span different column widths
   Source: original/blocks/form/form-grid-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Create New Project</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Set up your project details and timeline
            </p>
        </div>

        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-6">

                @* Project Name - Full Width *@
                <div class="md:col-span-6">
                    <LabelCn For="grid-layout-projectName" Class="mb-1.5 block">Project Name</LabelCn>
                    <InputCn id="grid-layout-projectName" Placeholder="Website Redesign" @bind-Value="_projectName" />
                    @if (_submitted && _projectName.Length < 3)
                    {
                        <p class="mt-1 text-xs text-destructive">Project name must be at least 3 characters</p>
                    }
                </div>

                @* Category - Half Width *@
                <div class="md:col-span-3">
                    <LabelCn For="category-trigger" Class="mb-1.5 block">Category</LabelCn>
                    <SelectCn Value="@_category" ValueChanged="@((string? v) => _category = v ?? "")">
                        <SelectTriggerCn id="category-trigger">
                            <SelectValueCn Placeholder="Select category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="design">Design</SelectItemCn>
                            <SelectItemCn Value="development">Development</SelectItemCn>
                            <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                            <SelectItemCn Value="research">Research</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    @if (_submitted && string.IsNullOrWhiteSpace(_category))
                    {
                        <p class="mt-1 text-xs text-destructive">Please select a category</p>
                    }
                </div>

                @* Priority - Half Width *@
                <div class="md:col-span-3">
                    <LabelCn For="priority-trigger" Class="mb-1.5 block">Priority</LabelCn>
                    <SelectCn Value="@_priority" ValueChanged="@((string? v) => _priority = v ?? "")">
                        <SelectTriggerCn id="priority-trigger">
                            <SelectValueCn Placeholder="Select priority" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="low">Low</SelectItemCn>
                            <SelectItemCn Value="medium">Medium</SelectItemCn>
                            <SelectItemCn Value="high">High</SelectItemCn>
                            <SelectItemCn Value="critical">Critical</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    @if (_submitted && string.IsNullOrWhiteSpace(_priority))
                    {
                        <p class="mt-1 text-xs text-destructive">Please select a priority</p>
                    }
                </div>

                @* Start Date - One Third *@
                <div class="md:col-span-2">
                    <LabelCn For="startDate" Class="mb-1.5 block">Start Date</LabelCn>
                    <InputCn id="startDate" type="date" @bind-Value="_startDate" />
                    @if (_submitted && string.IsNullOrWhiteSpace(_startDate))
                    {
                        <p class="mt-1 text-xs text-destructive">Start date is required</p>
                    }
                </div>

                @* End Date - One Third *@
                <div class="md:col-span-2">
                    <LabelCn For="endDate" Class="mb-1.5 block">End Date</LabelCn>
                    <InputCn id="endDate" type="date" @bind-Value="_endDate" />
                    @if (_submitted && string.IsNullOrWhiteSpace(_endDate))
                    {
                        <p class="mt-1 text-xs text-destructive">End date is required</p>
                    }
                </div>

                @* Duration Display - One Third (Read-only visual element) *@
                <div class="md:col-span-2">
                    <LabelCn Class="mb-1.5 block">Duration</LabelCn>
                    <div class="flex h-9 items-center rounded-md border bg-muted/50 px-3 text-sm text-muted-foreground">
                        30 days
                    </div>
                </div>

                @* Description - Full Width *@
                <div class="md:col-span-6">
                    <LabelCn For="grid-layout-description" Class="mb-1.5 block">Description</LabelCn>
                    <TextareaCn id="grid-layout-description" Placeholder="Provide a detailed description of the project scope and objectives..." Class="min-h-24 resize-none" @bind-Value="_description" />
                    @if (_submitted && _description.Length < 10)
                    {
                        <p class="mt-1 text-xs text-destructive">Description must be at least 10 characters</p>
                    }
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <ButtonCn Type="button" Variant="ButtonVariant.Outline" @onclick="HandleCancel">
                    Cancel
                </ButtonCn>
                <ButtonCn Type="submit">Create Project</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _projectName = "";
    private string _category = "";
    private string _priority = "";
    private string _startDate = "";
    private string _endDate = "";
    private string _description = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        _submitted = true;
        if (_projectName.Length >= 3 &&
            !string.IsNullOrWhiteSpace(_category) &&
            !string.IsNullOrWhiteSpace(_priority) &&
            !string.IsNullOrWhiteSpace(_startDate) &&
            !string.IsNullOrWhiteSpace(_endDate) &&
            _description.Length >= 10)
        {
            // Form is valid — reset for demo purposes
            _submitted = false;
            _projectName = "";
            _category = "";
            _priority = "";
            _startDate = "";
            _endDate = "";
            _description = "";
        }
    }

    private void HandleCancel()
    {
        _submitted = false;
        _projectName = "";
        _category = "";
        _priority = "";
        _startDate = "";
        _endDate = "";
        _description = "";
    }
}
