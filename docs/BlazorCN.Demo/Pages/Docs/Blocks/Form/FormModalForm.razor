@* ============================================================
   Block: form-modal-form
   Title: FormModalForm
   Description: A form inside a dialog modal with proper validation and state handling
   Source: original/blocks/form/form-modal-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Projects</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_projects.Count active projects
                    </p>
                </div>

                <DialogCn Open="@_open" OpenChanged="@HandleOpenChanged">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8" @onclick="@(() => _open = true)">
                        <LucideIconCn Name="plus" Size="14" Class="mr-1.5 size-3.5" />
                        New Project
                    </ButtonCn>
                    <DialogContentCn>
                        <DialogHeaderCn>
                            <DialogTitleCn>Create New Project</DialogTitleCn>
                            <DialogDescriptionCn>
                                Add a new project to your workspace. Click save when you're done.
                            </DialogDescriptionCn>
                        </DialogHeaderCn>

                        <form>
                            <div class="space-y-4 py-4">
                                @* Name Field *@
                                <FieldCn data-invalid="@(_submitted && _name.Length < 3 ? "true" : null)">
                                    <FieldLabelCn For="projectName">Project Name</FieldLabelCn>
                                    <FieldContentCn>
                                        <InputCn id="projectName"
                                                 Placeholder="My Awesome Project"
                                                 @bind-Value="_name" />
                                        @if (_submitted && _name.Length < 3)
                                        {
                                            <FieldErrorCn Errors="@(new[] { "Name must be at least 3 characters" })" />
                                        }
                                    </FieldContentCn>
                                </FieldCn>

                                @* Description Field *@
                                <FieldCn data-invalid="@(_submitted && _description.Length < 10 ? "true" : null)">
                                    <FieldLabelCn For="projectDescription">Description</FieldLabelCn>
                                    <FieldContentCn>
                                        <TextareaCn id="projectDescription"
                                                    Placeholder="Describe your project..."
                                                    Class="min-h-[100px] resize-none"
                                                    @bind-Value="_description" />
                                        <FieldDescriptionCn>
                                            Provide a brief overview of your project
                                        </FieldDescriptionCn>
                                        @if (_submitted && _description.Length < 10)
                                        {
                                            <FieldErrorCn Errors="@(new[] { "Description must be at least 10 characters" })" />
                                        }
                                    </FieldContentCn>
                                </FieldCn>

                                @* Category Field *@
                                <FieldCn>
                                    <FieldLabelCn For="projectCategory">Category</FieldLabelCn>
                                    <FieldContentCn>
                                        <SelectCn Value="@_category" ValueChanged="@((string? v) => _category = v ?? "web")">
                                            <SelectTriggerCn id="projectCategory">
                                                <SelectValueCn />
                                            </SelectTriggerCn>
                                            <SelectContentCn>
                                                <SelectItemCn Value="web">Web Application</SelectItemCn>
                                                <SelectItemCn Value="mobile">Mobile App</SelectItemCn>
                                                <SelectItemCn Value="desktop">Desktop Software</SelectItemCn>
                                                <SelectItemCn Value="other">Other</SelectItemCn>
                                            </SelectContentCn>
                                        </SelectCn>
                                    </FieldContentCn>
                                </FieldCn>
                            </div>

                            <DialogFooterCn>
                                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="@(() => HandleOpenChanged(false))">
                                    Cancel
                                </ButtonCn>
                                <ButtonCn type="button" @onclick="SubmitForm" Disabled="@_submitting">
                                    @(_submitting ? "Creating..." : "Create Project")
                                </ButtonCn>
                            </DialogFooterCn>
                        </form>
                    </DialogContentCn>
                </DialogCn>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var project in _projects)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-sm">@project.Name</p>
                            <p class="mt-0.5 text-muted-foreground text-xs capitalize">
                                @project.Category
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _open = false;
    private bool _submitted = false;
    private bool _submitting = false;

    // Form fields
    private string _name = "";
    private string _description = "";
    private string _category = "web";

    private List<ProjectItem> _projects = new()
    {
        new ProjectItem("1", "Marketing Website", "web"),
        new ProjectItem("2", "Mobile App", "mobile"),
    };

    private void HandleOpenChanged(bool newOpen)
    {
        _open = newOpen;
        if (!newOpen)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _name = "";
        _description = "";
        _category = "web";
        _submitted = false;
    }

    private async Task SubmitForm()
    {
        _submitted = true;

        // Validate
        if (_name.Length < 3 || _description.Length < 10) return;

        _submitting = true;
        // Simulate API call
        await Task.Delay(1000);

        _projects.Add(new ProjectItem(
            string.Empty + (_projects.Count + 1),
            _name,
            _category
        ));

        _submitting = false;
        _open = false;
        ResetForm();
    }

    private record ProjectItem(string Id, string Name, string Category);
}
