@* ============================================================
   Block: form-split-panel
   Title: FormSplitPanel
   Description: A two-panel form with navigation labels on the left and form fields on the right
   Source: original/blocks/form/form-split-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Business Inquiry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your company and requirements
            </p>
        </div>

        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="grid grid-cols-1 md:grid-cols-[200px_1fr]">

                @* Left Navigation Panel *@
                <div class="border-b px-4 py-5 md:border-b-0 md:border-r">
                    <nav class="space-y-4">
                        <div>
                            <span class="text-sm text-muted-foreground">Company Info</span>
                        </div>
                        <div>
                            <span class="text-sm text-muted-foreground">Contact Person</span>
                        </div>
                        <div>
                            <span class="text-sm text-muted-foreground">Additional Details</span>
                        </div>
                    </nav>
                </div>

                @* Right Form Panel *@
                <div class="p-4">
                    <div class="space-y-6">

                        @* Company Info Section *@
                        <div class="space-y-4">
                            <div>
                                <h3 class="text-sm font-medium">Company Information</h3>
                                <p class="mt-1 text-xs text-muted-foreground">
                                    Basic details about your organization
                                </p>
                            </div>

                            <div>
                                <LabelCn For="companyName" Class="mb-1.5 block">Company Name</LabelCn>
                                <InputCn id="companyName" Placeholder="Acme Corporation" @bind-Value="_companyName" />
                                @if (_submitted && _companyName.Length < 2)
                                {
                                    <p class="mt-1 text-xs text-destructive">Company name is required</p>
                                }
                            </div>

                            <div>
                                <LabelCn For="industry-trigger" Class="mb-1.5 block">Industry</LabelCn>
                                <SelectCn Value="@_industry" ValueChanged="@((string? v) => _industry = v ?? "")">
                                    <SelectTriggerCn id="industry-trigger">
                                        <SelectValueCn Placeholder="Select industry" />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="technology">Technology</SelectItemCn>
                                        <SelectItemCn Value="finance">Finance</SelectItemCn>
                                        <SelectItemCn Value="healthcare">Healthcare</SelectItemCn>
                                        <SelectItemCn Value="retail">Retail</SelectItemCn>
                                        <SelectItemCn Value="manufacturing">Manufacturing</SelectItemCn>
                                        <SelectItemCn Value="other">Other</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                                @if (_submitted && string.IsNullOrWhiteSpace(_industry))
                                {
                                    <p class="mt-1 text-xs text-destructive">Please select an industry</p>
                                }
                            </div>

                            <div>
                                <LabelCn For="website" Class="mb-1.5 block">Website</LabelCn>
                                <InputCn id="website" type="url" Placeholder="https://example.com" @bind-Value="_website" />
                                @if (_submitted && !IsValidUrl(_website))
                                {
                                    <p class="mt-1 text-xs text-destructive">Invalid URL format</p>
                                }
                            </div>
                        </div>

                        @* Contact Person Section *@
                        <div class="space-y-4 border-t pt-6">
                            <div>
                                <h3 class="text-sm font-medium">Contact Person</h3>
                                <p class="mt-1 text-xs text-muted-foreground">
                                    Primary point of contact for this inquiry
                                </p>
                            </div>

                            <div>
                                <LabelCn For="contactName" Class="mb-1.5 block">Full Name</LabelCn>
                                <InputCn id="contactName" Placeholder="Jane Smith" @bind-Value="_contactName" />
                                @if (_submitted && _contactName.Length < 2)
                                {
                                    <p class="mt-1 text-xs text-destructive">Contact name is required</p>
                                }
                            </div>

                            <div>
                                <LabelCn For="contactEmail" Class="mb-1.5 block">Email Address</LabelCn>
                                <InputCn id="contactEmail" type="email" Placeholder="@("jane.smith@example.com")" @bind-Value="_contactEmail" />
                                @if (_submitted && !IsValidEmail(_contactEmail))
                                {
                                    <p class="mt-1 text-xs text-destructive">Invalid email address</p>
                                }
                            </div>

                            <div>
                                <LabelCn For="contactPhone" Class="mb-1.5 block">Phone Number</LabelCn>
                                <InputCn id="contactPhone" type="tel" Placeholder="+1 (555) 000-0000" @bind-Value="_contactPhone" />
                                @if (_submitted && _contactPhone.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace("+", "").Length < 10)
                                {
                                    <p class="mt-1 text-xs text-destructive">Phone number must be at least 10 digits</p>
                                }
                            </div>
                        </div>

                        @* Additional Details Section *@
                        <div class="space-y-4 border-t pt-6">
                            <div>
                                <h3 class="text-sm font-medium">Additional Details</h3>
                                <p class="mt-1 text-xs text-muted-foreground">
                                    Share more about your requirements
                                </p>
                            </div>

                            <div>
                                <LabelCn For="message" Class="mb-1.5 block">Message</LabelCn>
                                <TextareaCn id="message" Placeholder="Tell us about your project requirements, timeline, and budget..." Class="min-h-32 resize-none" @bind-Value="_message" />
                                @if (_submitted && _message.Length < 20)
                                {
                                    <p class="mt-1 text-xs text-destructive">Message must be at least 20 characters</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 flex justify-end gap-3 border-t pt-6">
                        <ButtonCn Type="button" Variant="ButtonVariant.Outline" @onclick="HandleCancel">
                            Cancel
                        </ButtonCn>
                        <ButtonCn Type="submit">Submit Inquiry</ButtonCn>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private string _companyName = "";
    private string _industry = "";
    private string _website = "";
    private string _contactName = "";
    private string _contactEmail = "";
    private string _contactPhone = "";
    private string _message = "";
    private bool _submitted = false;

    private bool IsValidUrl(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        return Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    private bool IsValidEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var atIndex = value.IndexOf('@');
        return atIndex > 0 && atIndex < value.Length - 2 && value.LastIndexOf('.') > atIndex;
    }

    private void HandleSubmit()
    {
        _submitted = true;
        var phoneDigits = _contactPhone.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace("+", "");
        if (_companyName.Length >= 2 &&
            !string.IsNullOrWhiteSpace(_industry) &&
            IsValidUrl(_website) &&
            _contactName.Length >= 2 &&
            IsValidEmail(_contactEmail) &&
            phoneDigits.Length >= 10 &&
            _message.Length >= 20)
        {
            // Form is valid — reset for demo purposes
            _submitted = false;
            _companyName = "";
            _industry = "";
            _website = "";
            _contactName = "";
            _contactEmail = "";
            _contactPhone = "";
            _message = "";
        }
    }

    private void HandleCancel()
    {
        _submitted = false;
        _companyName = "";
        _industry = "";
        _website = "";
        _contactName = "";
        _contactEmail = "";
        _contactPhone = "";
        _message = "";
    }
}
