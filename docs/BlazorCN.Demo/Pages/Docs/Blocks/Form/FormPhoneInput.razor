@* ============================================================
   Block: form-phone-input
   Title: FormPhoneInput
   Description: A phone number input form with formatting mask display and validation
   Source: original/blocks/form/form-phone-input.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="phone" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-medium text-sm">Phone Number Form</h2>
            </div>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-6">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_phoneError) ? "true" : null)">
                    <LabelCn For="phone-input-phone">Phone Number</LabelCn>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 font-medium text-muted-foreground text-sm">
                            +1
                        </span>
                        <InputCn id="phone-input-phone"
                                 type="tel"
                                 Placeholder="@("+1 (555) 000-0000")"
                                 Class="pl-10"
                                 @bind-Value="_phone"
                                 aria-invalid="@(_submitted && !string.IsNullOrEmpty(_phoneError) ? "true" : "false")" />
                    </div>
                    <FieldDescriptionCn>
                        Enter your phone number in the format: +1 (555) 000-0000
                    </FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_phoneError))
                    {
                        <FieldErrorCn Errors="@(new[] { _phoneError })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Reset">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="submit" @onclick="Submit">
                        Submit
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _phone = "";
    private string _phoneError = "";
    private bool _submitted = false;

    private void Validate()
    {
        _phoneError = "";

        if (string.IsNullOrWhiteSpace(_phone))
        {
            _phoneError = "Phone number is required";
            return;
        }

        // Format: +1 (555) 000-0000
        var pattern = @"^\+1 \(\d{3}\) \d{3}-\d{4}$";
        if (!System.Text.RegularExpressions.Regex.IsMatch(_phone, pattern))
        {
            _phoneError = "Phone must be in format: +1 (555) 000-0000";
        }
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
    }

    private void Reset()
    {
        _phone = "";
        _phoneError = "";
        _submitted = false;
    }
}
