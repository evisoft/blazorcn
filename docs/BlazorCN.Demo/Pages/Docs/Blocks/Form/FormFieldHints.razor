@* ============================================================
   Block: form-field-hints
   Title: FormFieldHints
   Description: A form demonstrating various field hint patterns using FieldDescription for helper text and guidance
   Source: original/blocks/form/form-field-hints.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Create Your Profile</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Complete your profile information to get started
            </p>
        </div>

        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <FieldSetCn>
                <FieldCn>
                    <FieldLabelCn For="fullName">Full Name</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="fullName" @bind-Value="_fullName" Placeholder="John Smith" />
                        <FieldDescriptionCn>
                            Enter your full legal name as it appears on official documents
                        </FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_fullNameError))
                        {
                            <FieldErrorCn>@_fullNameError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="email">Email Address</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="email" type="email" @bind-Value="_email" Placeholder="@("john@example.com")" />
                        <FieldDescriptionCn>
                            We'll never share your email with third parties or send spam
                        </FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_emailError))
                        {
                            <FieldErrorCn>@_emailError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="password">Password</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="password" type="password" @bind-Value="_password" Placeholder="Create a strong password" />
                        <FieldDescriptionCn>
                            Must contain at least 8 characters with uppercase, lowercase, and a number
                        </FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_passwordError))
                        {
                            <FieldErrorCn>@_passwordError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="websiteUrl">Website URL</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="websiteUrl" type="url" @bind-Value="_websiteUrl" Placeholder="https://example.com" />
                        <FieldDescriptionCn>
                            Include the https:// prefix. Personal website, portfolio, or blog.
                        </FieldDescriptionCn>
                        @if (!string.IsNullOrEmpty(_websiteUrlError))
                        {
                            <FieldErrorCn>@_websiteUrlError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="bio">Bio</FieldLabelCn>
                    <FieldContentCn>
                        <TextareaCn id="bio" @bind-Value="_bio" Placeholder="Tell us about yourself" Class="min-h-[100px] resize-none" />
                        <div class="flex items-center justify-between">
                            <FieldDescriptionCn>
                                A brief description that appears on your profile
                            </FieldDescriptionCn>
                            <span class="@($"text-xs tabular-nums {(_bio.Length > 280 ? "text-destructive" : "text-muted-foreground")}")">
                                @_bio.Length/280
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(_bioError))
                        {
                            <FieldErrorCn>@_bioError</FieldErrorCn>
                        }
                    </FieldContentCn>
                </FieldCn>

                <div class="flex justify-end gap-2 pt-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Cancel">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="submit">Create Profile</ButtonCn>
                </div>
            </FieldSetCn>
        </form>
    </div>
</section>

@code {
    private string _fullName = "";
    private string _email = "";
    private string _password = "";
    private string _websiteUrl = "";
    private string _bio = "";

    private string _fullNameError = "";
    private string _emailError = "";
    private string _passwordError = "";
    private string _websiteUrlError = "";
    private string _bioError = "";

    private void HandleSubmit()
    {
        _fullNameError = "";
        _emailError = "";
        _passwordError = "";
        _websiteUrlError = "";
        _bioError = "";

        var valid = true;

        if (_fullName.Length < 2)
        {
            _fullNameError = "Full name is required";
            valid = false;
        }

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _emailError = "Invalid email address";
            valid = false;
        }

        if (_password.Length < 8)
        {
            _passwordError = "Password must be at least 8 characters";
            valid = false;
        }
        else if (!_password.Any(char.IsUpper))
        {
            _passwordError = "Password must contain at least one uppercase letter";
            valid = false;
        }
        else if (!_password.Any(char.IsLower))
        {
            _passwordError = "Password must contain at least one lowercase letter";
            valid = false;
        }
        else if (!_password.Any(char.IsDigit))
        {
            _passwordError = "Password must contain at least one number";
            valid = false;
        }

        if (string.IsNullOrWhiteSpace(_websiteUrl) || !_websiteUrl.StartsWith("https://"))
        {
            _websiteUrlError = "Must be a valid URL with https://";
            valid = false;
        }

        if (_bio.Length > 280)
        {
            _bioError = "Bio cannot exceed 280 characters";
            valid = false;
        }

        if (valid)
        {
            // Presentational only — would submit form data
        }
    }

    private void Cancel()
    {
        _fullName = "";
        _email = "";
        _password = "";
        _websiteUrl = "";
        _bio = "";
        _fullNameError = "";
        _emailError = "";
        _passwordError = "";
        _websiteUrlError = "";
        _bioError = "";
    }
}
