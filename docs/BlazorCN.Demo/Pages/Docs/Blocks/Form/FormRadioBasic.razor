@* ============================================================
   Block: form-radio-basic
   Title: FormRadioBasic
   Description: A basic radio group form demonstrating single-selection input
   Source: original/blocks/form/form-radio-basic.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Notification Preferences</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose how you'd like to receive notifications
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldSetCn>
                    <FieldLegendCn>Email Notifications</FieldLegendCn>
                    <RadioGroupCn Value="@_selectedNotification" ValueChanged="@((string? v) => _selectedNotification = v ?? "")"
                                  aria-invalid="@(_submitted && _hasError ? "true" : null)">
                        @foreach (var opt in _notificationOptions)
                        {
                            var option = opt;
                            <FieldCn Orientation="FieldOrientation.Horizontal">
                                <RadioGroupItemCn id="@($"notifications-{option.Id}")" Value="@option.Id" />
                                <LabelCn For="@($"notifications-{option.Id}")" Class="font-normal">
                                    @option.Label
                                </LabelCn>
                            </FieldCn>
                        }
                    </RadioGroupCn>
                    @if (_submitted && _hasError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a notification preference" })" />
                    }
                </FieldSetCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SavePreferences">
                        Save Preferences
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private static readonly NotificationOption[] _notificationOptions =
    [
        new NotificationOption("all", "All notifications"),
        new NotificationOption("important", "Important only"),
        new NotificationOption("mentions", "Mentions and replies"),
        new NotificationOption("none", "No notifications"),
    ];

    private string _selectedNotification = "";
    private bool _submitted = false;
    private bool _hasError => string.IsNullOrEmpty(_selectedNotification);

    private void ResetForm()
    {
        _selectedNotification = "";
        _submitted = false;
    }

    private void SavePreferences()
    {
        _submitted = true;
        // If valid (a selection was made), form is "submitted" (presentational only)
    }

    private record NotificationOption(string Id, string Label);
}
