@* ============================================================
   Block: form-payment
   Title: FormPayment
   Description: A payment method form with radio cards for selecting payment type and corresponding dynamic fields based on the selected method.
   Source: original/blocks/form/form-payment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Payment Method</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose your preferred payment method
            </p>
        </div>

        <form class="p-4">
            <FieldGroupCn>
                <FieldLabelCn class="text-sm font-medium">Select payment method</FieldLabelCn>
                <FieldContentCn>
                    <RadioGroupCn Value="@_selectedMethod" ValueChanged="@OnMethodChanged" Class="gap-3">
                        @foreach (var method in _paymentMethods)
                        {
                            var m = method;
                            <label
                                for="@m.Value"
                                class="@Cn.Merge("flex cursor-pointer items-start gap-3 rounded-lg border p-4 transition-colors hover:bg-muted/50", _selectedMethod == m.Value ? "border-foreground bg-muted/50" : "")">
                                <FieldCn class="flex items-start gap-3 pt-0.5">
                                    <RadioGroupItemCn Value="@m.Value" id="@m.Value" />
                                </FieldCn>
                                <LucideIconCn Name="@m.Icon" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <p class="font-medium text-sm">@m.Label</p>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@m.Description</p>
                                </div>
                            </label>
                        }
                    </RadioGroupCn>
                </FieldContentCn>
            </FieldGroupCn>

            <div class="mt-6 space-y-4">
                @if (_selectedMethod == "credit-card")
                {
                    <FieldCn>
                        <FieldLabelCn For="cardNumber">Card number</FieldLabelCn>
                        <FieldContentCn>
                            <InputCn id="cardNumber" @bind-Value="_cardNumber" Placeholder="1234567812345678" maxlength="16" aria-invalid="@(_cardNumberError != null ? "true" : "false")" />
                            <FieldDescriptionCn>Enter 16-digit card number</FieldDescriptionCn>
                            @if (_cardNumberError != null)
                            {
                                <FieldErrorCn Errors="@(new[] { _cardNumberError })" />
                            }
                        </FieldContentCn>
                    </FieldCn>

                    <div class="grid grid-cols-2 gap-4">
                        <FieldCn>
                            <FieldLabelCn For="expiryDate">Expiry date</FieldLabelCn>
                            <FieldContentCn>
                                <InputCn id="expiryDate" @bind-Value="_expiryDate" Placeholder="MM/YY" maxlength="5" aria-invalid="@(_expiryDateError != null ? "true" : "false")" />
                                @if (_expiryDateError != null)
                                {
                                    <FieldErrorCn Errors="@(new[] { _expiryDateError })" />
                                }
                            </FieldContentCn>
                        </FieldCn>

                        <FieldCn>
                            <FieldLabelCn For="cvc">CVC</FieldLabelCn>
                            <FieldContentCn>
                                <InputCn id="cvc" @bind-Value="_cvc" Placeholder="123" maxlength="4" aria-invalid="@(_cvcError != null ? "true" : "false")" />
                                @if (_cvcError != null)
                                {
                                    <FieldErrorCn Errors="@(new[] { _cvcError })" />
                                }
                            </FieldContentCn>
                        </FieldCn>
                    </div>
                }

                @if (_selectedMethod == "bank-transfer")
                {
                    <FieldCn>
                        <FieldLabelCn For="accountNumber">Account number</FieldLabelCn>
                        <FieldContentCn>
                            <InputCn id="accountNumber" @bind-Value="_accountNumber" Placeholder="12345678" maxlength="12" aria-invalid="@(_accountNumberError != null ? "true" : "false")" />
                            <FieldDescriptionCn>Your bank account number (8-12 digits)</FieldDescriptionCn>
                            @if (_accountNumberError != null)
                            {
                                <FieldErrorCn Errors="@(new[] { _accountNumberError })" />
                            }
                        </FieldContentCn>
                    </FieldCn>

                    <FieldCn>
                        <FieldLabelCn For="routingNumber">Routing number</FieldLabelCn>
                        <FieldContentCn>
                            <InputCn id="routingNumber" @bind-Value="_routingNumber" Placeholder="123456789" maxlength="9" aria-invalid="@(_routingNumberError != null ? "true" : "false")" />
                            <FieldDescriptionCn>9-digit routing number</FieldDescriptionCn>
                            @if (_routingNumberError != null)
                            {
                                <FieldErrorCn Errors="@(new[] { _routingNumberError })" />
                            }
                        </FieldContentCn>
                    </FieldCn>
                }

                @if (_selectedMethod == "digital-wallet")
                {
                    <FieldCn>
                        <FieldLabelCn For="walletEmail">Wallet email</FieldLabelCn>
                        <FieldContentCn>
                            <InputCn id="walletEmail" type="email" @bind-Value="_walletEmail" Placeholder="@("you@example.com")" aria-invalid="@(_walletEmailError != null ? "true" : "false")" />
                            <FieldDescriptionCn>Email associated with your digital wallet</FieldDescriptionCn>
                            @if (_walletEmailError != null)
                            {
                                <FieldErrorCn Errors="@(new[] { _walletEmailError })" />
                            }
                        </FieldContentCn>
                    </FieldCn>
                }
            </div>

            <div class="mt-6 flex gap-3">
                <ButtonCn type="submit" Class="flex-1" @onclick="@((MouseEventArgs e) => SubmitForm())">
                    Continue to payment
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record PaymentMethod(string Value, string Label, string Description, string Icon);

    private static readonly PaymentMethod[] _paymentMethods =
    [
        new("credit-card", "Credit Card", "Pay with Visa, Mastercard, or Amex", "credit-card"),
        new("bank-transfer", "Bank Transfer", "Direct bank account transfer", "building"),
        new("digital-wallet", "Digital Wallet", "PayPal, Venmo, or similar", "wallet"),
    ];

    private string _selectedMethod = "credit-card";

    // Credit card fields
    private string _cardNumber = "";
    private string _expiryDate = "";
    private string _cvc = "";

    // Bank transfer fields
    private string _accountNumber = "";
    private string _routingNumber = "";

    // Digital wallet fields
    private string _walletEmail = "";

    // Errors
    private string? _cardNumberError;
    private string? _expiryDateError;
    private string? _cvcError;
    private string? _accountNumberError;
    private string? _routingNumberError;
    private string? _walletEmailError;

    private void OnMethodChanged(string? value)
    {
        _selectedMethod = value ?? "credit-card";
        ClearErrors();
    }

    private void ClearErrors()
    {
        _cardNumberError = null;
        _expiryDateError = null;
        _cvcError = null;
        _accountNumberError = null;
        _routingNumberError = null;
        _walletEmailError = null;
    }

    private void SubmitForm()
    {
        ClearErrors();
        var valid = true;

        if (_selectedMethod == "credit-card")
        {
            if (string.IsNullOrWhiteSpace(_cardNumber))
            { _cardNumberError = "Card number is required"; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_cardNumber, @"^\d{16}$"))
            { _cardNumberError = "Card number must be 16 digits"; valid = false; }

            if (string.IsNullOrWhiteSpace(_expiryDate))
            { _expiryDateError = "Expiry date is required"; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_expiryDate, @"^\d{2}/\d{2}$"))
            { _expiryDateError = "Format: MM/YY"; valid = false; }

            if (string.IsNullOrWhiteSpace(_cvc))
            { _cvcError = "CVC is required"; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_cvc, @"^\d{3,4}$"))
            { _cvcError = "CVC must be 3-4 digits"; valid = false; }
        }
        else if (_selectedMethod == "bank-transfer")
        {
            if (string.IsNullOrWhiteSpace(_accountNumber))
            { _accountNumberError = "Account number is required"; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_accountNumber, @"^\d{8,12}$"))
            { _accountNumberError = "Account number must be 8-12 digits"; valid = false; }

            if (string.IsNullOrWhiteSpace(_routingNumber))
            { _routingNumberError = "Routing number is required"; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_routingNumber, @"^\d{9}$"))
            { _routingNumberError = "Routing number must be 9 digits"; valid = false; }
        }
        else if (_selectedMethod == "digital-wallet")
        {
            if (string.IsNullOrWhiteSpace(_walletEmail))
            { _walletEmailError = "Email is required"; valid = false; }
            else if (!_walletEmail.Contains('@'))
            { _walletEmailError = "Invalid email address"; valid = false; }
        }

        // If valid, form is "submitted" (presentational only)
        _ = valid;
    }
}
