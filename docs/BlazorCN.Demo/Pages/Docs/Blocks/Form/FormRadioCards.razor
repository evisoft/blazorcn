@* ============================================================
   Block: form-radio-cards
   Title: FormRadioCards
   Description: A radio group form with card-style options containing titles and descriptions
   Source: original/blocks/form/form-radio-cards.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Choose Your Plan</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Select the subscription plan that best fits your needs
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldSetCn>
                    <FieldLegendCn>Subscription Plans</FieldLegendCn>
                    <RadioGroupCn Value="@_selectedPlan" ValueChanged="@((string? v) => _selectedPlan = v ?? "")">
                        @foreach (var it in _subscriptionPlans)
                        {
                            var plan = it;
                            <FieldLabelCn>
                                <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="@(_submitted && _hasError ? "true" : null)">
                                    <FieldContentCn>
                                        <FieldTitleCn>@plan.Title</FieldTitleCn>
                                        <FieldDescriptionCn>@plan.Description</FieldDescriptionCn>
                                    </FieldContentCn>
                                    <RadioGroupItemCn id="@($"plan-{plan.Id}")" Value="@plan.Id" />
                                </FieldCn>
                            </FieldLabelCn>
                        }
                    </RadioGroupCn>
                    @if (_submitted && _hasError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a subscription plan" })" />
                    }
                </FieldSetCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SubmitForm">
                        Continue with Plan
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private static readonly SubscriptionPlan[] _subscriptionPlans =
    [
        new SubscriptionPlan("free", "Free Plan", "Perfect for trying out our platform with basic features"),
        new SubscriptionPlan("pro", "Pro Plan", "Unlock advanced features and priority support for professionals"),
        new SubscriptionPlan("team", "Team Plan", "Collaborate with your team and access enterprise features"),
        new SubscriptionPlan("enterprise", "Enterprise Plan", "Custom solutions with dedicated support for large organizations"),
    ];

    private string _selectedPlan = "";
    private bool _submitted = false;
    private bool _hasError => string.IsNullOrEmpty(_selectedPlan);

    private void ResetForm()
    {
        _selectedPlan = "";
        _submitted = false;
    }

    private void SubmitForm()
    {
        _submitted = true;
        // If valid (_selectedPlan is set), form is "submitted" (presentational only)
    }

    private record SubscriptionPlan(string Id, string Title, string Description);
}
