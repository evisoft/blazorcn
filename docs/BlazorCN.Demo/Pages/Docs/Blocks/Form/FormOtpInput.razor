@* ============================================================
   Block: form-otp-input
   Title: FormOtpInput
   Description: A one-time password verification code input form with 6-digit validation
   Source: original/blocks/form/form-otp-input.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Verify Your Identity</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Enter the 6-digit code sent to your device
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_codeError) ? "true" : null)">
                    <LabelCn For="code">Verification Code</LabelCn>
                    <div class="flex items-center gap-2">
                        <div class="flex items-center">
                            @for (int i = 0; i < 3; i++)
                            {
                                var idx = i;
                                <input id="@(idx == 0 ? "code" : $"otp-{idx}")"
                                       aria-label="@($"Digit {idx + 1}")"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="1"
                                       value="@(_slots[idx])"
                                       @oninput="@((ChangeEventArgs e) => HandleSlotInput(idx, e))"
                                       @onkeydown="@((KeyboardEventArgs e) => HandleSlotKeyDown(idx, e))"
                                       aria-invalid="@(_submitted && !string.IsNullOrEmpty(_codeError) ? "true" : "false")"
                                       class="@Cn.Merge("relative flex h-9 w-9 items-center justify-center border-y border-r text-sm shadow-sm transition-all first:rounded-l-md first:border-l last:rounded-r-md", _submitted && !string.IsNullOrEmpty(_codeError) ? "border-destructive" : "border-input")" />
                            }
                        </div>
                        <div class="flex w-4 items-center justify-center">
                            <div class="h-px w-3 bg-border"></div>
                        </div>
                        <div class="flex items-center">
                            @for (int i = 3; i < 6; i++)
                            {
                                var idx = i;
                                <input id="@($"otp-{idx}")"
                                       aria-label="@($"Digit {idx + 1}")"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="1"
                                       value="@(_slots[idx])"
                                       @oninput="@((ChangeEventArgs e) => HandleSlotInput(idx, e))"
                                       @onkeydown="@((KeyboardEventArgs e) => HandleSlotKeyDown(idx, e))"
                                       aria-invalid="@(_submitted && !string.IsNullOrEmpty(_codeError) ? "true" : "false")"
                                       class="@Cn.Merge("relative flex h-9 w-9 items-center justify-center border-y border-r text-sm shadow-sm transition-all first:rounded-l-md first:border-l last:rounded-r-md", _submitted && !string.IsNullOrEmpty(_codeError) ? "border-destructive" : "border-input")" />
                            }
                        </div>
                    </div>
                    <FieldDescriptionCn>Enter the code from your authenticator app</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_codeError))
                    {
                        <FieldErrorCn Errors="@(new[] { _codeError })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="Cancel">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="submit" @onclick="Submit">
                        Verify Code
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string[] _slots = ["", "", "", "", "", ""];
    private bool _submitted = false;
    private string _codeError = "";

    private string GetCode() => string.Join("", _slots);

    private void HandleSlotInput(int index, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (val.Length > 0)
        {
            _slots[index] = val[val.Length - 1].ToString();
        }
        else
        {
            _slots[index] = "";
        }
        if (_submitted)
            Validate();
    }

    private void HandleSlotKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(_slots[index]) && index > 0)
        {
            _slots[index - 1] = "";
        }
    }

    private void Validate()
    {
        _codeError = "";
        var code = GetCode();
        if (code.Length < 6)
            _codeError = "Code must be 6 digits";
    }

    private void Cancel()
    {
        _slots = ["", "", "", "", "", ""];
        _codeError = "";
        _submitted = false;
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
        // If no errors, OTP code is verified (presentational only)
    }
}
