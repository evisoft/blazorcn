@* ============================================================
   Block: form-nested-objects
   Title: FormNestedObjects
   Description: A form demonstrating deeply nested object structures using dot notation field names
   Source: original/blocks/form/form-nested-objects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">User Profile</h2>
            <p class="mt-1 text-muted-foreground text-xs">Complete your profile information</p>
        </div>

        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-6 px-4 py-6">

                @* ---- Personal Name fieldset ---- *@
                <fieldset class="space-y-4">
                    <legend class="text-sm font-medium leading-none">Personal Name</legend>

                    <div class="space-y-4">
                        <div class="grid gap-4 sm:grid-cols-2">
                            @* First Name *@
                            <div>
                                <LabelCn For="first-name" Class="mb-1.5 block">First Name</LabelCn>
                                <div>
                                    <InputCn id="first-name" Placeholder="John" @bind-Value="_firstName" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(_firstName))
                                    {
                                        <p class="mt-1 text-xs text-destructive">First name is required</p>
                                    }
                                </div>
                            </div>

                            @* Last Name *@
                            <div>
                                <LabelCn For="last-name" Class="mb-1.5 block">Last Name</LabelCn>
                                <div>
                                    <InputCn id="last-name" Placeholder="Doe" @bind-Value="_lastName" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(_lastName))
                                    {
                                        <p class="mt-1 text-xs text-destructive">Last name is required</p>
                                    }
                                </div>
                            </div>
                        </div>

                        @* Middle Name *@
                        <div>
                            <LabelCn For="middle-name" Class="mb-1.5 block">Middle Name</LabelCn>
                            <div>
                                <InputCn id="middle-name" Placeholder="Optional" @bind-Value="_middleName" />
                                <p class="mt-1 text-xs text-muted-foreground">Optional</p>
                            </div>
                        </div>
                    </div>
                </fieldset>

                @* ---- Contact Information fieldset ---- *@
                <fieldset class="space-y-4">
                    <legend class="text-sm font-medium leading-none">Contact Information</legend>

                    <div class="space-y-4">
                        @* Email *@
                        <div>
                            <LabelCn For="nested-objects-email" Class="mb-1.5 block">Email Address</LabelCn>
                            <div>
                                <InputCn id="nested-objects-email" type="email" Placeholder="@("john.doe@example.com")" @bind-Value="_email" />
                                @if (_submitted && !IsValidEmail(_email))
                                {
                                    <p class="mt-1 text-xs text-destructive">
                                        @(string.IsNullOrWhiteSpace(_email) ? "Invalid email address" : "Invalid email address")
                                    </p>
                                }
                            </div>
                        </div>

                        @* Phone *@
                        <div>
                            <LabelCn For="nested-objects-phone" Class="mb-1.5 block">Phone Number</LabelCn>
                            <div>
                                <InputCn id="nested-objects-phone" type="tel" Placeholder="+1 (555) 123-4567" @bind-Value="_phone" />
                                <p class="mt-1 text-xs text-muted-foreground">Include area code for best results</p>
                                @if (_submitted && _phone.Length < 10)
                                {
                                    <p class="mt-1 text-xs text-destructive">Phone must be at least 10 digits</p>
                                }
                            </div>
                        </div>
                    </div>
                </fieldset>

                @* ---- Mailing Address fieldset ---- *@
                <fieldset class="space-y-4">
                    <legend class="text-sm font-medium leading-none">Mailing Address</legend>

                    <div class="space-y-4">
                        @* Street *@
                        <div>
                            <LabelCn For="nested-objects-street" Class="mb-1.5 block">Street Address</LabelCn>
                            <div>
                                <InputCn id="nested-objects-street" Placeholder="123 Main St" @bind-Value="_street" />
                                @if (_submitted && string.IsNullOrWhiteSpace(_street))
                                {
                                    <p class="mt-1 text-xs text-destructive">Street address is required</p>
                                }
                            </div>
                        </div>

                        @* Apartment *@
                        <div>
                            <LabelCn For="apartment" Class="mb-1.5 block">Apartment / Suite</LabelCn>
                            <div>
                                <InputCn id="apartment" Placeholder="Apt 4B" @bind-Value="_apartment" />
                                <p class="mt-1 text-xs text-muted-foreground">Optional</p>
                            </div>
                        </div>

                        @* City / State / ZIP *@
                        <div class="grid gap-4 sm:grid-cols-3">
                            @* City *@
                            <div>
                                <LabelCn For="nested-objects-city" Class="mb-1.5 block">City</LabelCn>
                                <div>
                                    <InputCn id="nested-objects-city" Placeholder="New York" @bind-Value="_city" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(_city))
                                    {
                                        <p class="mt-1 text-xs text-destructive">City is required</p>
                                    }
                                </div>
                            </div>

                            @* State *@
                            <div>
                                <LabelCn For="nested-objects-state-trigger" Class="mb-1.5 block">State</LabelCn>
                                <div>
                                    <SelectCn Value="@_state" ValueChanged="@((string? v) => _state = v ?? "")">
                                        <SelectTriggerCn id="nested-objects-state-trigger">
                                            <SelectValueCn Placeholder="Select" />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="NY">New York</SelectItemCn>
                                            <SelectItemCn Value="CA">California</SelectItemCn>
                                            <SelectItemCn Value="TX">Texas</SelectItemCn>
                                            <SelectItemCn Value="FL">Florida</SelectItemCn>
                                            <SelectItemCn Value="IL">Illinois</SelectItemCn>
                                            <SelectItemCn Value="WA">Washington</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                    @if (_submitted && string.IsNullOrWhiteSpace(_state))
                                    {
                                        <p class="mt-1 text-xs text-destructive">Please select a state</p>
                                    }
                                </div>
                            </div>

                            @* ZIP *@
                            <div>
                                <LabelCn For="nested-objects-zip" Class="mb-1.5 block">ZIP Code</LabelCn>
                                <div>
                                    <InputCn id="nested-objects-zip" Placeholder="10001" @bind-Value="_zip" />
                                    @if (_submitted && _zip.Length < 5)
                                    {
                                        <p class="mt-1 text-xs text-destructive">ZIP code must be at least 5 digits</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>

            </div>

            <div class="flex items-center justify-end border-t px-4 py-3">
                <ButtonCn Type="submit">Save Profile</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _firstName = "";
    private string _middleName = "";
    private string _lastName = "";
    private string _email = "";
    private string _phone = "";
    private string _street = "";
    private string _apartment = "";
    private string _city = "";
    private string _state = "";
    private string _zip = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        _submitted = true;
    }

    private static bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }
}
