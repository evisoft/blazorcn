@* ============================================================
   Block: form-select-basic
   Title: FormSelectBasic
   Description: A basic select dropdown form demonstrating the standard Select and Controller pattern
   Source: original/blocks/form/form-select-basic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Set Task Priority</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose the priority level for this task
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="priority">Priority Level</FieldLabelCn>
                    <SelectCn Value="@_priority" ValueChanged="@((string? v) => _priority = v ?? "")"
                              aria-invalid="@(_submitted && _hasError ? "true" : null)">
                        <SelectTriggerCn id="priority" Class="w-full"
                                         aria-invalid="@(_submitted && _hasError ? "true" : null)">
                            <SelectValueCn Placeholder="Select a priority level" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="critical">Critical</SelectItemCn>
                            <SelectItemCn Value="high">High</SelectItemCn>
                            <SelectItemCn Value="medium">Medium</SelectItemCn>
                            <SelectItemCn Value="low">Low</SelectItemCn>
                            <SelectItemCn Value="none">None</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>Select the appropriate priority level for this task</FieldDescriptionCn>
                    @if (_submitted && _hasError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a priority level" })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ClearForm">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SavePriority">
                        Save Priority
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _priority = "";
    private bool _submitted = false;
    private bool _hasError => string.IsNullOrEmpty(_priority);

    private void ClearForm()
    {
        _priority = "";
        _submitted = false;
    }

    private void SavePriority()
    {
        _submitted = true;
        // If valid (a selection was made), form is "submitted" (presentational only)
    }
}
