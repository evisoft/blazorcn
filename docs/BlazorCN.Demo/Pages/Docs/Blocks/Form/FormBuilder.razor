@* ============================================================
   Block: form-builder
   Title: FormBuilder
   Description: A simple form builder where users can dynamically add and configure different field types to construct custom forms with live preview.
   Source: original/blocks/form/form-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Form Builder</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Design your custom form by adding and configuring fields
            </p>
        </div>

        <div class="grid md:grid-cols-2">
            <div class="border-b md:border-b-0 md:border-r">
                <div class="border-b px-4 py-3">
                    <div class="space-y-1.5">
                        <LabelCn>Form name</LabelCn>
                        <InputCn aria-label="Form name" @bind-Value="_formName" Placeholder="My Custom Form" />
                        @if (string.IsNullOrWhiteSpace(_formName))
                        {
                            <p class="text-destructive text-xs">Form name is required</p>
                        }
                    </div>
                </div>

                <div class="px-4 py-3">
                    <div class="mb-3 flex items-center justify-between">
                        <h3 class="font-medium text-sm">Form Fields</h3>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm h-7 gap-1.5" data-variant="outline" data-size="sm">
                                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                                    Add field
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                @foreach (var ft in _fieldTypes)
                                {
                                    var ftype = ft;
                                    <DropdownMenuItemCn OnClick="@(() => AddField(ftype.Value))">@ftype.Label</DropdownMenuItemCn>
                                }
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>

                    @if (_fields.Count == 0)
                    {
                        <div class="rounded-lg border border-dashed px-4 py-8 text-center">
                            <p class="text-muted-foreground text-sm">No fields added yet</p>
                            <p class="mt-1 text-muted-foreground text-xs">
                                Click "Add field" to get started
                            </p>
                        </div>
                    }

                    <div class="space-y-3">
                        @foreach (var f in _fields)
                        {
                            var field = f;
                            <div class="rounded-lg border bg-muted/30 p-3">
                                <div class="mb-3 flex items-start gap-2">
                                    <LucideIconCn Name="grip-vertical" Size="16" Class="mt-1 size-4 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <p class="font-medium text-sm">
                                            @(string.IsNullOrWhiteSpace(field.Label) ? "Untitled field" : field.Label)
                                        </p>
                                        <p class="text-muted-foreground text-xs">
                                            @GetFieldTypeLabel(field.Type)@(field.Required ? " • Required" : "")
                                        </p>
                                    </div>
                                    <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" aria-label="@($"Remove field {(string.IsNullOrWhiteSpace(field.Label) ? "Untitled field" : field.Label)}")" OnClick="@(() => RemoveField(field.Id))">
                                        <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                </div>

                                <div class="space-y-2">
                                    <div class="space-y-1.5">
                                        <LabelCn Class="text-xs">Field label</LabelCn>
                                        <InputCn aria-label="Field label" Value="@field.Label" ValueChanged="@((string v) => { field.Label = v; })" Placeholder="Label" Class="h-8 text-sm" />
                                        @if (string.IsNullOrWhiteSpace(field.Label))
                                        {
                                            <p class="text-destructive text-xs">Label is required</p>
                                        }
                                    </div>

                                    <div class="space-y-1.5">
                                        <LabelCn Class="text-xs">Field type</LabelCn>
                                        <SelectCn Value="@field.Type" ValueChanged="@((string v) => { field.Type = v ?? field.Type; })">
                                            <SelectTriggerCn Class="h-8 text-sm" aria-label="Field type">
                                                <SelectValueCn />
                                            </SelectTriggerCn>
                                            <SelectContentCn>
                                                @foreach (var ft in _fieldTypes)
                                                {
                                                    <SelectItemCn Value="@ft.Value">@ft.Label</SelectItemCn>
                                                }
                                            </SelectContentCn>
                                        </SelectCn>
                                    </div>

                                    <div class="space-y-1.5">
                                        <LabelCn Class="text-xs">Placeholder (optional)</LabelCn>
                                        <InputCn aria-label="Placeholder" Value="@field.Placeholder" ValueChanged="@((string v) => { field.Placeholder = v; })" Placeholder="Enter placeholder" Class="h-8 text-sm" />
                                    </div>

                                    <div class="flex items-center justify-between rounded-md px-2 py-1.5">
                                        <span class="text-sm">Required field</span>
                                        <SwitchCn Checked="@field.Required" CheckedChanged="@((bool v) => { field.Required = v; })" aria-label="Required field" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_submitted && _fields.Count == 0)
                    {
                        <p class="mt-2 text-destructive text-sm">Add at least one field</p>
                    }
                </div>

                <div class="border-t bg-muted/50 px-4 py-3">
                    <ButtonCn Class="w-full" OnClick="SaveForm">
                        Save form configuration
                    </ButtonCn>
                </div>
            </div>

            <div class="px-4 py-3">
                <div class="mb-3">
                    <h3 class="font-medium text-sm">Form Preview</h3>
                    <p class="mt-0.5 text-muted-foreground text-xs">Live preview of your form</p>
                </div>

                <div class="rounded-lg border bg-background p-4">
                    <h2 class="mb-4 font-semibold text-lg">@_formName</h2>

                    @if (_fields.Count == 0)
                    {
                        <p class="text-center text-muted-foreground text-sm">No fields to preview</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var f in _fields)
                            {
                                var field = f;
                                <div class="space-y-1.5">
                                    <LabelCn>
                                        @field.Label
                                        @if (field.Required)
                                        {
                                            <span class="text-destructive"> *</span>
                                        }
                                    </LabelCn>
                                    @if (field.Type == "text")
                                    {
                                        <InputCn aria-label="@field.Label" Placeholder="@field.Placeholder" Disabled="true" />
                                    }
                                    @if (field.Type == "email")
                                    {
                                        <InputCn aria-label="@field.Label" Placeholder="@field.Placeholder" Disabled="true" />
                                    }
                                    @if (field.Type == "select")
                                    {
                                        <SelectCn Disabled="true">
                                            <SelectTriggerCn aria-label="@field.Label">
                                                <SelectValueCn Placeholder="@(string.IsNullOrEmpty(field.Placeholder) ? "Select an option" : field.Placeholder)" />
                                            </SelectTriggerCn>
                                            <SelectContentCn>
                                            </SelectContentCn>
                                        </SelectCn>
                                    }
                                    @if (field.Type == "textarea")
                                    {
                                        <TextareaCn aria-label="@field.Label" Placeholder="@field.Placeholder" Disabled="true" Rows="3" />
                                    }
                                </div>
                            }

                            <ButtonCn Class="w-full" Disabled="true">
                                Submit
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _formName = "Contact Form";
    private bool _submitted = false;

    private readonly List<FormFieldItem> _fields =
    [
        new FormFieldItem
        {
            Id = "field-1",
            Type = "text",
            Label = "Full Name",
            Required = true,
            Placeholder = "Enter your name",
        },
    ];

    private static readonly FieldTypeOption[] _fieldTypes =
    [
        new FieldTypeOption("text", "Text Input"),
        new FieldTypeOption("email", "Email Input"),
        new FieldTypeOption("select", "Select Dropdown"),
        new FieldTypeOption("textarea", "Textarea"),
    ];

    private void AddField(string type)
    {
        var label = GetFieldTypeLabel(type);
        _fields.Add(new FormFieldItem
        {
            Id = $"field-{_fields.Count + 1}-{type}",
            Type = type,
            Label = $"New {label}",
            Required = false,
            Placeholder = "",
        });
    }

    private void RemoveField(string id)
    {
        var item = _fields.Find(f => f.Id == id);
        if (item is not null)
            _fields.Remove(item);
    }

    private void SaveForm()
    {
        _submitted = true;
    }

    private string GetFieldTypeLabel(string type) => type switch
    {
        "text" => "Text Input",
        "email" => "Email Input",
        "select" => "Select Dropdown",
        "textarea" => "Textarea",
        _ => type,
    };

    private sealed class FormFieldItem
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "text";
        public string Label { get; set; } = "";
        public bool Required { get; set; }
        public string Placeholder { get; set; } = "";
    }

    private sealed record FieldTypeOption(string Value, string Label);
}
