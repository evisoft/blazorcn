@* ============================================================
   Block: form-date-range
   Title: FormDateRange
   Description: A date range form with start and end date fields featuring cross-field validation to ensure the end date is after the start date.
   Source: original/blocks/form/form-date-range.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Select Date Range</h2>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Choose your travel dates</p>
        </div>
        <form class="px-4 py-6" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="grid grid-cols-2 gap-4">
                @* Start Date *@
                <div>
                    <LabelCn For="start-date" Class="mb-1.5 block">Start Date</LabelCn>
                    <div>
                        <input id="start-date" type="date" class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                               value="@_startDate" @onchange="@((ChangeEventArgs e) => _startDate = e.Value?.ToString() ?? "")" />
                        <p class="mt-1 text-muted-foreground text-xs">When do you want to start?</p>
                        @if (_submitted && string.IsNullOrWhiteSpace(_startDate))
                        {
                            <p class="mt-1 text-xs text-destructive">Start date is required</p>
                        }
                    </div>
                </div>

                @* End Date *@
                <div>
                    <LabelCn For="end-date" Class="mb-1.5 block">End Date</LabelCn>
                    <div>
                        <input id="end-date" type="date" class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                               value="@_endDate" @onchange="@((ChangeEventArgs e) => _endDate = e.Value?.ToString() ?? "")" />
                        <p class="mt-1 text-muted-foreground text-xs">When do you want to end?</p>
                        @if (_submitted && string.IsNullOrWhiteSpace(_endDate))
                        {
                            <p class="mt-1 text-xs text-destructive">End date is required</p>
                        }
                        else if (_submitted && !string.IsNullOrWhiteSpace(_endDate) && !string.IsNullOrWhiteSpace(_startDate) && string.Compare(_endDate, _startDate, StringComparison.Ordinal) < 0)
                        {
                            <p class="mt-1 text-xs text-destructive">End date must be after start date</p>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4 rounded-md bg-muted/50 p-3">
                <p class="text-muted-foreground text-xs">
                    Select a start date and an end date to see available options. The end date must be
                    after the start date.
                </p>
            </div>

            <ButtonCn Type="submit" Class="mt-6 w-full">
                Search Availability
            </ButtonCn>
        </form>
    </div>
</section>

@code {
    private string _startDate = "";
    private string _endDate = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
