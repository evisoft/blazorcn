@* ============================================================
   Block: form-switch-with-description
   Title: FormSwitchWithDescription
   Description: A switch form with detailed description and explanation
   Source: original/blocks/form/form-switch-with-description.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Security Settings</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Enhance your account security with additional protection
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <FieldContentCn>
                        <LabelCn For="twoFactor">Two-Factor Authentication</LabelCn>
                        <FieldDescriptionCn>
                            Add an extra layer of security to your account by requiring a verification
                            code in addition to your password when signing in. You'll receive codes via
                            SMS or an authenticator app. This helps protect your account even if your
                            password is compromised.
                        </FieldDescriptionCn>
                    </FieldContentCn>
                    <SwitchCn id="twoFactor" Checked="@_twoFactor" CheckedChanged="@((bool v) => _twoFactor = v)" />
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="Submit">
                        Update Security Settings
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private bool _twoFactor = false;

    private void ResetForm()
    {
        _twoFactor = false;
    }

    private void Submit()
    {
        // Handle form submission (presentational only)
    }
}
