@code {
    // Drawer open state
    private bool _open = false;
    private bool _submitted = false;
    private bool _saving = false;

    // Form fields (working copy inside the drawer)
    private string _companyName = ""Acme Corporation"";
    private string _website = ""https://acme.com"";
    private string _industry = ""technology"";
    private string _description = ""Leading provider of innovative solutions for businesses worldwide."";

    // Saved / displayed values
    private string _savedCompanyName = ""Acme Corporation"";
    private string _savedWebsite = ""https://acme.com"";
    private string _savedIndustry = ""technology"";
    private string _savedDescription = ""Leading provider of innovative solutions for businesses worldwide."";

    private void HandleOpenChanged(bool newOpen)
    {
        _open = newOpen;
        if (!newOpen)
        {
            // Reset working copy back to saved values on close/cancel
            _companyName = _savedCompanyName;
            _website = _savedWebsite;
            _industry = _savedIndustry;
            _description = _savedDescription;
            _submitted = false;
        }
    }

    private async Task SaveSettings()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_companyName)) return;

        _saving = true;
        // Simulate API call
        await Task.Delay(1000);

        _savedCompanyName = _companyName;
        _savedWebsite = _website;
        _savedIndustry = _industry;
        _savedDescription = _description;

        _saving = false;
        _submitted = false;
        _open = false;
    }
}
";

