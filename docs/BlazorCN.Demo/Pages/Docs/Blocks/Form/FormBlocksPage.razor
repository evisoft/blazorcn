@code {
    private string _password = """";
    private bool _submitted = false;
    private string _passwordError = """";

    private static readonly int[] _segments = [1, 2, 3, 4];

    private PasswordStrength _strength => CalculatePasswordStrength(_password);

    private record PasswordStrength(int Level, string Label, string Color);

    private static PasswordStrength CalculatePasswordStrength(string password)
    {
        if (string.IsNullOrEmpty(password))
            return new PasswordStrength(0, """", """");

        int strength = 0;

        // Length
        if (password.Length >= 8) strength += 1;
        if (password.Length >= 12) strength += 1;

        // Character variety
        if (System.Text.RegularExpressions.Regex.IsMatch(password, ""[a-z]"")) strength += 1;
        if (System.Text.RegularExpressions.Regex.IsMatch(password, ""[A-Z]"")) strength += 1;
        if (System.Text.RegularExpressions.Regex.IsMatch(password, @""\d"")) strength += 1;
        if (System.Text.RegularExpressions.Regex.IsMatch(password, @""[^a-zA-Z\d]"")) strength += 1;

        // Normalize to 0-4 scale
        int level = Math.Min((int)Math.Floor(strength / 1.5), 4);

        string[] labels = ["""", ""Weak"", ""Fair"", ""Strong"", ""Very strong""];
        string[] colors = ["""", ""bg-red-500"", ""bg-orange-500"", ""bg-yellow-500"", ""bg-green-500""];

        return new PasswordStrength(level, labels[level], colors[level]);
    }

    private void Submit()
    {
        _submitted = true;
        _passwordError = """";

        if (string.IsNullOrEmpty(_password) || _password.Length < 8)
            _passwordError = ""Minimum 8 characters"";
    }
}
";

