    private static readonly SatisfactionOption[] _satisfactionOptions =
    [
        new SatisfactionOption(""very-dissatisfied"", ""Very dissatisfied""),
        new SatisfactionOption(""dissatisfied"", ""Dissatisfied""),
        new SatisfactionOption(""neutral"", ""Neutral""),
        new SatisfactionOption(""satisfied"", ""Satisfied""),
        new SatisfactionOption(""very-satisfied"", ""Very satisfied""),
    ];

    private static readonly FeatureOption[] _featureOptions =
    [
        new FeatureOption(""ease-of-use"", ""Ease of use""),
        new FeatureOption(""performance"", ""Performance""),
        new FeatureOption(""design"", ""Design""),
        new FeatureOption(""features"", ""Features""),
        new FeatureOption(""support"", ""Customer support""),
        new FeatureOption(""pricing"", ""Pricing""),
    ];

    private string _satisfaction = """";
    private List<string> _selectedFeatures = new();
    private int _rating = 5;
    private string _feedback = """";
    private bool _submitted = false;
    private int _answeredQuestions = 1; // rating always has a value
    private readonly int _totalQuestions = 4;

    protected override void OnInitialized()
    {
        UpdateProgress();
    }

    private void UpdateProgress()
    {
        _answeredQuestions = new[]
        {
            !string.IsNullOrEmpty(_satisfaction),
            _selectedFeatures.Count > 0,
            true, // rating always has a value (0-10)
            _feedback.Length >= 10,
        }.Count(b => b);
    }

    private void ToggleFeature(string value, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedFeatures.Contains(value))
                _selectedFeatures.Add(value);
        }
        else
        {
            _selectedFeatures.Remove(value);
        }
        UpdateProgress();
    }

    private void SaveDraft()
    {
        // Save draft (presentational only)
    }

    private void SubmitSurvey()
    {
        _submitted = true;
    }

    private record SatisfactionOption(string Value, string Label);
    private record FeatureOption(string Value, string Label);
}";

