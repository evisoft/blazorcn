        new(""delete"", ""Delete access""),
        new(""share"",  ""Share access""),
    ];

    private List<string> _selected = new();
    private bool _parentChecked = false;
    private bool _parentIndeterminate = false;

    private void UpdateParentState()
    {
        int count = _selected.Count;
        if (count == 0)
        {
            _parentChecked = false;
            _parentIndeterminate = false;
        }
        else if (count == _permissions.Length)
        {
            _parentChecked = true;
            _parentIndeterminate = false;
        }
        else
        {
            _parentChecked = false;
            _parentIndeterminate = true;
        }
    }

    private void TogglePermission(string id, bool add)
    {
        if (add)
        {
            if (!_selected.Contains(id))
                _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
        UpdateParentState();
    }

    private void HandleParentChange()
    {
        if (_parentChecked || _parentIndeterminate)
        {
            _selected = new();
            _parentChecked = false;
            _parentIndeterminate = false;
        }
        else
        {
            _selected = _permissions.Select(p => p.Id).ToList();
            _parentChecked = true;
            _parentIndeterminate = false;
        }
    }

    private void ClearForm()
    {
        _selected = new();
        _parentChecked = false;
        _parentIndeterminate = false;
    }

    private void SavePermissions()
    {
        // Presentational only — form submitted with _selected values
    }
}
";

