        new FieldTypeOption(""select"", ""Select Dropdown""),
        new FieldTypeOption(""textarea"", ""Textarea""),
    ];

    private void AddField(string type)
    {
        var label = GetFieldTypeLabel(type);
        _fields.Add(new FormFieldItem
        {
            Id = $""field-{_fields.Count + 1}-{type}"",
            Type = type,
            Label = $""New {label}"",
            Required = false,
            Placeholder = """",
        });
    }

    private void RemoveField(string id)
    {
        var item = _fields.Find(f => f.Id == id);
        if (item is not null)
            _fields.Remove(item);
    }

    private void SaveForm()
    {
        _submitted = true;
    }

    private string GetFieldTypeLabel(string type) => type switch
    {
        ""text"" => ""Text Input"",
        ""email"" => ""Email Input"",
        ""select"" => ""Select Dropdown"",
        ""textarea"" => ""Textarea"",
        _ => type,
    };

