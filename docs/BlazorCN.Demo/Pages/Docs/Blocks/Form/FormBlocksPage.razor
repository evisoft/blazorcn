@code {
    private int _nextId = 2;
    private bool _rootError = false;

    private List<FieldItem> _items = new()
    {
        new FieldItem { Id = 1, Index = 1, Value = """", HasError = false }
    };

    private void AddItem()
    {
        _rootError = false;
        _items.Add(new FieldItem { Id = _nextId, Index = _items.Count + 1, Value = """", HasError = false });
        _nextId++;
    }

    private void RemoveItem(int id)
    {
        _items.RemoveAll(x => x.Id == id);
        RenumberItems();
        _rootError = false;
    }

    private void UpdateItem(int id, string value)
    {
        var item = _items.FirstOrDefault(x => x.Id == id);
        if (item is not null)
        {
            item.Value = value;
            item.HasError = string.IsNullOrEmpty(value);
        }
    }

    private void RenumberItems()
    {
        for (int i = 0; i < _items.Count; i++)
            _items[i].Index = i + 1;
    }

    private void SaveList()
    {
        bool valid = true;
        foreach (var item in _items)
        {
            item.HasError = string.IsNullOrEmpty(item.Value);
            if (item.HasError) valid = false;
        }
        if (_items.Count == 0)
        {
            _rootError = true;
            valid = false;
        }
        // If valid, form is ""submitted"" (presentational only)
    }

    private void ResetForm()
    {
        _nextId = 2;
        _rootError = false;
        _items = new()
        {
            new FieldItem { Id = 1, Index = 1, Value = """", HasError = false }
        };
    }

    private class FieldItem
    {
        public int Id { get; set; }
        public int Index { get; set; }
        public string Value { get; set; } = """";
        public bool HasError { get; set; }
    }
}";

