@code {
    private string _phone = """";
    private string _phoneError = """";
    private bool _submitted = false;

    private void Validate()
    {
        _phoneError = """";

        if (string.IsNullOrWhiteSpace(_phone))
        {
            _phoneError = ""Phone number is required"";
            return;
        }

        // Format: +1 (555) 000-0000
        var pattern = @""^\+1 \(\d{3}\) \d{3}-\d{4}$"";
        if (!System.Text.RegularExpressions.Regex.IsMatch(_phone, pattern))
        {
            _phoneError = ""Phone must be in format: +1 (555) 000-0000"";
        }
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
    }

    private void Reset()
    {
        _phone = """";
        _phoneError = """";
        _submitted = false;
    }
}
";

