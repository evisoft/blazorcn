    private string _editEmail = """";
    private string _editTitle = """";
    private string _editBio   = """";

    // Validation errors
    private string _nameError  = """";
    private string _emailError = """";
    private string _titleError = """";
    private string _bioError   = """";

    private void HandleEdit(string field)
    {
        _editingField = field;
        _editName  = _savedName;
        _editEmail = _savedEmail;
        _editTitle = _savedTitle;
        _editBio   = _savedBio;
        _nameError  = """";
        _emailError = """";
        _titleError = """";
        _bioError   = """";
