@code {
    private record PaymentMethod(string Value, string Label, string Description, string Icon);

    private static readonly PaymentMethod[] _paymentMethods =
    [
        new(""credit-card"", ""Credit Card"", ""Pay with Visa, Mastercard, or Amex"", ""credit-card""),
        new(""bank-transfer"", ""Bank Transfer"", ""Direct bank account transfer"", ""building""),
        new(""digital-wallet"", ""Digital Wallet"", ""PayPal, Venmo, or similar"", ""wallet""),
    ];

    private string _selectedMethod = ""credit-card"";

    // Credit card fields
    private string _cardNumber = """";
    private string _expiryDate = """";
    private string _cvc = """";

    // Bank transfer fields
    private string _accountNumber = """";
    private string _routingNumber = """";

    // Digital wallet fields
    private string _walletEmail = """";

    // Errors
    private string? _cardNumberError;
    private string? _expiryDateError;
    private string? _cvcError;
    private string? _accountNumberError;
    private string? _routingNumberError;
    private string? _walletEmailError;

    private void OnMethodChanged(string? value)
    {
        _selectedMethod = value ?? ""credit-card"";
        ClearErrors();
    }

    private void ClearErrors()
    {
        _cardNumberError = null;
        _expiryDateError = null;
        _cvcError = null;
        _accountNumberError = null;
        _routingNumberError = null;
        _walletEmailError = null;
    }

    private void SubmitForm()
    {
        ClearErrors();
        var valid = true;

        if (_selectedMethod == ""credit-card"")
        {
            if (string.IsNullOrWhiteSpace(_cardNumber))
            { _cardNumberError = ""Card number is required""; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_cardNumber, @""^\d{16}$""))
            { _cardNumberError = ""Card number must be 16 digits""; valid = false; }

            if (string.IsNullOrWhiteSpace(_expiryDate))
            { _expiryDateError = ""Expiry date is required""; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_expiryDate, @""^\d{2}/\d{2}$""))
            { _expiryDateError = ""Format: MM/YY""; valid = false; }

            if (string.IsNullOrWhiteSpace(_cvc))
            { _cvcError = ""CVC is required""; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_cvc, @""^\d{3,4}$""))
            { _cvcError = ""CVC must be 3-4 digits""; valid = false; }
        }
        else if (_selectedMethod == ""bank-transfer"")
        {
            if (string.IsNullOrWhiteSpace(_accountNumber))
            { _accountNumberError = ""Account number is required""; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_accountNumber, @""^\d{8,12}$""))
            { _accountNumberError = ""Account number must be 8-12 digits""; valid = false; }

            if (string.IsNullOrWhiteSpace(_routingNumber))
            { _routingNumberError = ""Routing number is required""; valid = false; }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(_routingNumber, @""^\d{9}$""))
            { _routingNumberError = ""Routing number must be 9 digits""; valid = false; }
        }
        else if (_selectedMethod == ""digital-wallet"")
        {
            if (string.IsNullOrWhiteSpace(_walletEmail))
            { _walletEmailError = ""Email is required""; valid = false; }
            else if (!_walletEmail.Contains('@'))
            { _walletEmailError = ""Invalid email address""; valid = false; }
        }

        // If valid, form is ""submitted"" (presentational only)
        _ = valid;
    }
}
";

