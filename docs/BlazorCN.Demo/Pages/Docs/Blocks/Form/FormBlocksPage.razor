    private string _fullName = """";
    private string _dateOfBirth = """";
    private string _bio = """";
    private string _email = """";
    private string _phone = """";
    private string _language = """";
    private string _timezone = """";
    private bool _emailNotifications = true;
    private bool _submitted = false;

    private bool _fullNameInvalid    => _submitted && _fullName.Trim().Length < 2;
    private bool _dateOfBirthInvalid => _submitted && string.IsNullOrWhiteSpace(_dateOfBirth);
    private bool _bioInvalid         => _submitted && _bio.Trim().Length < 10;
    private bool _emailInvalid       => _submitted && !IsValidEmail(_email);
    private bool _phoneInvalid       => _submitted && StripPhone(_phone).Length < 10;
    private bool _languageInvalid    => _submitted && string.IsNullOrEmpty(_language);
    private bool _timezoneInvalid    => _submitted && string.IsNullOrEmpty(_timezone);

    private static readonly Dictionary<string, object> _invalidAttr = new() { [""data-invalid""] = ""true"" };

    private void HandleSubmit()
    {
        _submitted = true;
    }

    private void HandleCancel()
    {
        _fullName           = """";
        _dateOfBirth        = """";
        _bio                = """";
        _email              = """";
        _phone              = """";
        _language           = """";
        _timezone           = """";
        _emailNotifications = true;
        _submitted          = false;
    }

    private static bool IsValidEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var at = value.IndexOf('@');
        if (at <= 0 || at == value.Length - 1) return false;
        var dot = value.LastIndexOf('.');
        return dot > at + 1 && dot < value.Length - 1;
    }

    private static string StripPhone(string value) =>
        value.Replace("" "", """").Replace(""-"", """").Replace(""("", """").Replace("")"", """").Replace(""+"", """");
}
";

