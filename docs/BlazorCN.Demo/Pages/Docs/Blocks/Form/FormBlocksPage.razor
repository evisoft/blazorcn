@code {
    private string _companyName = """";
    private string _email = """";
    private string _phone = """";
    private string _website = """";
    private string _description = """";
    private Dictionary<string, string> _errors = new();
    private bool _isSubmitted = false;

    private int _errorCount => _errors.Count;
    private bool _hasErrors => _errorCount > 0 && _isSubmitted;

    private bool Validate()
    {
        _errors = new Dictionary<string, string>();

        if (_companyName.Length < 2)
            _errors[""companyName""] = ""Company name must be at least 2 characters"";

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@') || !_email.Contains('.'))
            _errors[""email""] = ""Please enter a valid email address"";

        if (string.IsNullOrWhiteSpace(_phone) || !System.Text.RegularExpressions.Regex.IsMatch(_phone, @""^\+?[1-9]\d{1,14}$""))
            _errors[""phone""] = ""Please enter a valid phone number"";

        if (!string.IsNullOrWhiteSpace(_website) && !Uri.TryCreate(_website, UriKind.Absolute, out _))
            _errors[""website""] = ""Please enter a valid URL"";

        if (_description.Length < 10)
            _errors[""description""] = ""Description must be at least 10 characters"";
        else if (_description.Length > 500)
            _errors[""description""] = ""Description must not exceed 500 characters"";

        return _errors.Count == 0;
    }

    private void HandleSubmit()
    {
        _isSubmitted = true;
        if (Validate())
        {
            // Form submitted successfully
            _isSubmitted = false;
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _companyName = """";
        _email = """";
        _phone = """";
        _website = """";
        _description = """";
        _errors = new Dictionary<string, string>();
        _isSubmitted = false;
    }
}
";

