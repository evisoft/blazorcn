    private record BulkItem(string Id, string Name, string Status, bool Selected);

    private List<BulkItem> _items =
    [
        new(""1"", ""Product Alpha"", ""active"", false),
        new(""2"", ""Product Beta"", ""pending"", false),
        new(""3"", ""Product Gamma"", ""active"", false),
        new(""4"", ""Product Delta"", ""inactive"", false),
    ];

    private bool _submitted;

    private int _selectedCount => _items.Count(i => i.Selected);

    private void ToggleSelected(string id, bool value)
    {
        _items = _items.Select(i => i.Id == id ? i with { Selected = value } : i).ToList();
    }

    private void UpdateName(string id, string value)
    {
        _items = _items.Select(i => i.Id == id ? i with { Name = value } : i).ToList();
    }

    private void UpdateStatus(string id, string value)
    {
        _items = _items.Select(i => i.Id == id ? i with { Status = value } : i).ToList();
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
    }

    private void ApplyToSelected(string status)
    {
        _items = _items.Select(i => i.Selected ? i with { Status = status } : i).ToList();
    }

    private async Task HandleSubmit()
    {
        _submitted = true;
        StateHasChanged();
        await Task.Delay(2000);
        _submitted = false;
    }
}";

