    private void HandleCancel()
    {
        _editingField = null;
        _nameError  = """";
        _emailError = """";
        _titleError = """";
        _bioError   = """";
    }

    private void HandleSave(string field)
    {
        if (field == ""name"")
        {
            if (_editName.Length < 2)
            {
                _nameError = ""Name must be at least 2 characters"";
                return;
            }
            _savedName = _editName;
        }
        else if (field == ""email"")
        {
            if (!_editEmail.Contains('@') || !_editEmail.Contains('.'))
            {
                _emailError = ""Invalid email address"";
                return;
            }
            _savedEmail = _editEmail;
        }
        else if (field == ""title"")
        {
            if (_editTitle.Length < 1)
            {
                _titleError = ""Title is required"";
                return;
            }
            _savedTitle = _editTitle;
        }
        else if (field == ""bio"")
        {
            if (_editBio.Length > 200)
            {
                _bioError = ""Bio must be 200 characters or less"";
                return;
            }
            _savedBio = _editBio;
        }
        _editingField = null;
    }
}";

