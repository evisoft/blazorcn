@* ============================================================
   Block: form-email-password
   Title: FormEmailPassword
   Description: An email and password input form with validation
   Source: original/blocks/form/form-email-password.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Sign In</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Enter your credentials to access your account
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : null)">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email"
                             type="email"
                             Placeholder="@("you@example.com")"
                             @bind-Value="_email"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : "false")" />
                    <FieldDescriptionCn>We'll never share your email with anyone else</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_emailError))
                    {
                        <FieldErrorCn Errors="@(new[] { _emailError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_passwordError) ? "true" : null)">
                    <LabelCn For="password">Password</LabelCn>
                    <InputCn id="password"
                             type="password"
                             Placeholder="Enter your password"
                             @bind-Value="_password"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_passwordError) ? "true" : "false")" />
                    <FieldDescriptionCn>Must be at least 8 characters long</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_passwordError))
                    {
                        <FieldErrorCn Errors="@(new[] { _passwordError })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="Cancel">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="submit" @onclick="Submit">
                        Sign In
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
    private bool _submitted = false;
    private string _emailError = "";
    private string _passwordError = "";

    private void Validate()
    {
        _emailError = "";
        _passwordError = "";

        if (string.IsNullOrEmpty(_email) || !_email.Contains('@'))
            _emailError = "Please enter a valid email address";

        if (string.IsNullOrEmpty(_password) || _password.Length < 8)
            _passwordError = "Password must be at least 8 characters";
        else if (_password.Length > 100)
            _passwordError = "Password must not exceed 100 characters";
    }

    private void Cancel()
    {
        _email = "";
        _password = "";
        _emailError = "";
        _passwordError = "";
        _submitted = false;
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
        // If no errors, form is "submitted" (presentational only)
    }
}
