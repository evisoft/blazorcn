@* ============================================================
   Block: form-country-select
   Title: FormCountrySelect
   Description: A country selector with flag emojis for quick visual identification and improved international user experience.
   Source: original/blocks/form/form-country-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <fieldset class="space-y-6 px-4 py-6">
                <div class="space-y-2">
                    <p class="text-base font-semibold leading-none">Location Details</p>
                    <p class="text-sm text-muted-foreground">Select your country and shipping destination</p>
                </div>

                @* Country field *@
                <FieldCn>
                    <FieldLabelCn For="country-select-country">Country</FieldLabelCn>
                    <FieldDescriptionCn>Your current country of residence</FieldDescriptionCn>
                    <SelectCn Value="@_country" ValueChanged="@OnCountryChanged">
                        <SelectTriggerCn id="country-select-country" Class="w-full" aria-invalid="@(_countryError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select country" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var ctry in _countries)
                            {
                                var c = ctry;
                                <SelectItemCn Value="@c.Code">
                                    <div class="flex items-center gap-2">
                                        <span class="text-base">@c.Flag</span>
                                        <span>@c.Name</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_countryError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a country" })" />
                    }
                </FieldCn>

                @* Shipping country field *@
                <FieldCn>
                    <FieldLabelCn For="shippingCountry">Shipping Country</FieldLabelCn>
                    <FieldDescriptionCn>Where should we ship your order?</FieldDescriptionCn>
                    <SelectCn Value="@_shippingCountry" ValueChanged="@OnShippingCountryChanged">
                        <SelectTriggerCn id="shippingCountry" Class="w-full" aria-invalid="@(_shippingCountryError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select shipping country" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var ctry in _countries)
                            {
                                var c = ctry;
                                <SelectItemCn Value="@c.Code">
                                    <div class="flex items-center gap-2">
                                        <span class="text-base">@c.Flag</span>
                                        <span>@c.Name</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_shippingCountryError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a shipping country" })" />
                    }
                </FieldCn>
            </fieldset>

            <div class="flex justify-end gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn type="submit">
                    Continue
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record CountryOption(string Flag, string Name, string Code);

    private static readonly CountryOption[] _countries =
    [
        new("🇦🇺", "Australia", "AU"),
        new("🇧🇷", "Brazil", "BR"),
        new("🇨🇦", "Canada", "CA"),
        new("🇨🇳", "China", "CN"),
        new("🇫🇷", "France", "FR"),
        new("🇩🇪", "Germany", "DE"),
        new("🇮🇳", "India", "IN"),
        new("🇮🇹", "Italy", "IT"),
        new("🇯🇵", "Japan", "JP"),
        new("🇲🇽", "Mexico", "MX"),
        new("🇳🇱", "Netherlands", "NL"),
        new("🇪🇸", "Spain", "ES"),
        new("🇬🇧", "United Kingdom", "GB"),
        new("🇺🇸", "United States", "US"),
    ];

    private string _country = "";
    private string _shippingCountry = "";
    private bool _countryError = false;
    private bool _shippingCountryError = false;

    private void OnCountryChanged(string? value)
    {
        _country = value ?? "";
        _countryError = false;
    }

    private void OnShippingCountryChanged(string? value)
    {
        _shippingCountry = value ?? "";
        _shippingCountryError = false;
    }

    private void ResetForm()
    {
        _country = "";
        _shippingCountry = "";
        _countryError = false;
        _shippingCountryError = false;
    }

    private void HandleSubmit()
    {
        _countryError = string.IsNullOrEmpty(_country);
        _shippingCountryError = string.IsNullOrEmpty(_shippingCountry);
        // If valid, form is "submitted" (presentational only)
    }
}
