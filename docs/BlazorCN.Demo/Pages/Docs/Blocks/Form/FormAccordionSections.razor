@* ============================================================
   Block: form-accordion-sections
   Title: FormAccordionSections
   Description: A form with collapsible accordion sections to organize fields and reduce visual complexity
   Source: original/blocks/form/form-accordion-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Account Setup</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Configure your account settings</p>
        </div>

        <div class="divide-y">
            @* Account Section *@
            <div>
                <button type="button"
                        class="flex w-full items-center justify-between px-6 py-4 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => ToggleSection("account"))">
                    <div>
                        <h3 class="text-sm font-medium">Account Information</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">Basic account credentials</p>
                    </div>
                    <LucideIconCn Name="chevron-down" Size="16"
                                  Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _openSections.Contains("account") ? "rotate-180" : "")" />
                </button>
                @if (_openSections.Contains("account"))
                {
                    <div class="space-y-4 px-6 pb-6">
                        <div>
                            <LabelCn Class="mb-1.5 block">Username</LabelCn>
                            <InputCn @bind-Value="_username" Placeholder="johndoe" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Must be unique and at least 3 characters</p>
                            @if (!string.IsNullOrEmpty(_usernameError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_usernameError</p>
                            }
                        </div>

                        <div>
                            <LabelCn Class="mb-1.5 block">Email</LabelCn>
                            <InputCn @bind-Value="_email" Placeholder="@("john@example.com")" Type="email" />
                            @if (!string.IsNullOrEmpty(_emailError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_emailError</p>
                            }
                        </div>

                        <div>
                            <LabelCn Class="mb-1.5 block">Password</LabelCn>
                            <InputCn @bind-Value="_password" Placeholder="••••••••" Type="password" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Minimum 8 characters</p>
                            @if (!string.IsNullOrEmpty(_passwordError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_passwordError</p>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Profile Section *@
            <div>
                <button type="button"
                        class="flex w-full items-center justify-between px-6 py-4 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => ToggleSection("profile"))">
                    <div>
                        <h3 class="text-sm font-medium">Profile Details</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">Public information and bio</p>
                    </div>
                    <LucideIconCn Name="chevron-down" Size="16"
                                  Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _openSections.Contains("profile") ? "rotate-180" : "")" />
                </button>
                @if (_openSections.Contains("profile"))
                {
                    <div class="space-y-4 px-6 pb-6">
                        <div>
                            <LabelCn Class="mb-1.5 block">Display Name</LabelCn>
                            <InputCn @bind-Value="_displayName" Placeholder="John Doe" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Your name as it appears to others</p>
                            @if (!string.IsNullOrEmpty(_displayNameError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_displayNameError</p>
                            }
                        </div>

                        <div>
                            <LabelCn Class="mb-1.5 block">Bio</LabelCn>
                            <TextareaCn @bind-Value="_bio" Placeholder="Tell us about yourself" Rows="3" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Optional. Maximum 200 characters.</p>
                            @if (!string.IsNullOrEmpty(_bioError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_bioError</p>
                            }
                        </div>

                        <div>
                            <LabelCn Class="mb-1.5 block">Website</LabelCn>
                            <InputCn @bind-Value="_website" Placeholder="https://example.com" Type="url" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Optional</p>
                            @if (!string.IsNullOrEmpty(_websiteError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_websiteError</p>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Preferences Section *@
            <div>
                <button type="button"
                        class="flex w-full items-center justify-between px-6 py-4 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => ToggleSection("preferences"))">
                    <div>
                        <h3 class="text-sm font-medium">Preferences</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Language and privacy settings
                        </p>
                    </div>
                    <LucideIconCn Name="chevron-down" Size="16"
                                  Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _openSections.Contains("preferences") ? "rotate-180" : "")" />
                </button>
                @if (_openSections.Contains("preferences"))
                {
                    <div class="space-y-4 px-6 pb-6">
                        <div>
                            <LabelCn Class="mb-1.5 block">Language</LabelCn>
                            <SelectCn Value="@_language" ValueChanged="@((string? v) => SetLanguage(v))">
                                <SelectTriggerCn>
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="en">English</SelectItemCn>
                                    <SelectItemCn Value="es">Español</SelectItemCn>
                                    <SelectItemCn Value="fr">Français</SelectItemCn>
                                    <SelectItemCn Value="de">Deutsch</SelectItemCn>
                                    <SelectItemCn Value="ja">日本語</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        <div>
                            <div class="flex items-center justify-between">
                                <div class="space-y-0.5">
                                    <LabelCn>Email Updates</LabelCn>
                                    <p class="text-xs text-muted-foreground">
                                        Receive notifications about new features
                                    </p>
                                </div>
                                <SwitchCn Checked="_emailUpdates" CheckedChanged="v => _emailUpdates = v" />
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center justify-between">
                                <div class="space-y-0.5">
                                    <LabelCn>Public Profile</LabelCn>
                                    <p class="text-xs text-muted-foreground">Make your profile visible to everyone</p>
                                </div>
                                <SwitchCn Checked="_publicProfile" CheckedChanged="v => _publicProfile = v" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex justify-end gap-2 border-t px-6 py-4">
            <ButtonCn Variant="ButtonVariant.Outline" Type="button">
                Cancel
            </ButtonCn>
            <ButtonCn Type="submit" @onclick="HandleSubmit">Create Account</ButtonCn>
        </div>
    </div>
</section>

@code {
    private List<string> _openSections = ["account"];

    private string _username = "";
    private string _email = "";
    private string _password = "";
    private string _displayName = "";
    private string _bio = "";
    private string _website = "";
    private string _language = "en";
    private bool _emailUpdates = true;
    private bool _publicProfile = false;

    private string _usernameError = "";
    private string _emailError = "";
    private string _passwordError = "";
    private string _displayNameError = "";
    private string _bioError = "";
    private string _websiteError = "";

    private void SetLanguage(string? v) => _language = v ?? "en";

    private void ToggleSection(string grp)
    {
        if (_openSections.Contains(grp))
            _openSections.Remove(grp);
        else
            _openSections.Add(grp);
    }

    private void HandleSubmit()
    {
        _usernameError = _username.Length < 3 ? "Username must be at least 3 characters" : "";
        _emailError = !_email.Contains('@') ? "Invalid email address" : "";
        _passwordError = _password.Length < 8 ? "Password must be at least 8 characters" : "";
        _displayNameError = string.IsNullOrEmpty(_displayName) ? "Display name is required" : "";
        _bioError = _bio.Length > 200 ? "Bio must be less than 200 characters" : "";
        _websiteError = !string.IsNullOrEmpty(_website) && !_website.StartsWith("http") ? "Invalid URL" : "";
    }
}
