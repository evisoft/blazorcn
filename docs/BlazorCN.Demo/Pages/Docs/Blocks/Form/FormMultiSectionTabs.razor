@* ============================================================
   Block: form-multi-section-tabs
   Title: FormMultiSectionTabs
   Description: A tabbed form where each tab contains a different section of fields with single form submission
   Source: original/blocks/form/form-multi-section-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">User Settings</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Configure your account across multiple sections
            </p>
        </div>

        <TabsCn Value="@_activeTab" ValueChanged="@((v) => SetActiveTab(v))" Class="w-full">
            <div class="border-b px-4">
                <TabsListCn Class="h-auto w-full justify-start rounded-none border-0 bg-transparent p-0">
                    <TabsTriggerCn Value="general" Class="rounded-none border-b-2 border-transparent data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        General
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="details" Class="rounded-none border-b-2 border-transparent data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Details
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="advanced" Class="rounded-none border-b-2 border-transparent data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Advanced
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <div class="p-6">
                <TabsContentCn Value="general" Class="mt-0 space-y-4">
                    <div>
                        <LabelCn Class="mb-1.5 block">Full Name</LabelCn>
                        <div>
                            <InputCn aria-label="Full Name" @bind-Value="_name" Placeholder="John Doe" />
                            @if (!string.IsNullOrEmpty(_nameError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_nameError</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn Class="mb-1.5 block">Email Address</LabelCn>
                        <div>
                            <InputCn aria-label="Email Address" @bind-Value="_email" Placeholder="@("john@example.com")" Type="email" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Your primary email for notifications</p>
                            @if (!string.IsNullOrEmpty(_emailError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_emailError</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn Class="mb-1.5 block">Role</LabelCn>
                        <div>
                            <SelectCn Value="@_role" ValueChanged="@((v) => SetRole(v))">
                                <SelectTriggerCn aria-label="Role">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="admin">Administrator</SelectItemCn>
                                    <SelectItemCn Value="editor">Editor</SelectItemCn>
                                    <SelectItemCn Value="viewer">Viewer</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            <p class="mt-1.5 text-xs text-muted-foreground">Your access level in the system</p>
                            @if (!string.IsNullOrEmpty(_roleError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_roleError</p>
                            }
                        </div>
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="details" Class="mt-0 space-y-4">
                    <div>
                        <LabelCn Class="mb-1.5 block">Company</LabelCn>
                        <div>
                            <InputCn aria-label="Company" @bind-Value="_company" Placeholder="Acme Corporation" />
                            @if (!string.IsNullOrEmpty(_companyError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_companyError</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn Class="mb-1.5 block">Department</LabelCn>
                        <div>
                            <InputCn aria-label="Department" @bind-Value="_department" Placeholder="Engineering" />
                            @if (!string.IsNullOrEmpty(_departmentError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_departmentError</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn Class="mb-1.5 block">Bio</LabelCn>
                        <div>
                            <TextareaCn aria-label="Bio" @bind-Value="_bio" Placeholder="Tell us about yourself" Rows="4" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Optional. Max 500 characters.</p>
                            @if (!string.IsNullOrEmpty(_bioError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_bioError</p>
                            }
                        </div>
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="advanced" Class="mt-0 space-y-4">
                    <div>
                        <LabelCn Class="mb-1.5 block">Timezone</LabelCn>
                        <div>
                            <SelectCn Value="@_timezone" ValueChanged="@((v) => SetTimezone(v))">
                                <SelectTriggerCn aria-label="Timezone">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="America/New_York">Eastern Time</SelectItemCn>
                                    <SelectItemCn Value="America/Chicago">Central Time</SelectItemCn>
                                    <SelectItemCn Value="America/Denver">Mountain Time</SelectItemCn>
                                    <SelectItemCn Value="America/Los_Angeles">Pacific Time</SelectItemCn>
                                    <SelectItemCn Value="Europe/London">London</SelectItemCn>
                                    <SelectItemCn Value="Europe/Paris">Paris</SelectItemCn>
                                    <SelectItemCn Value="Asia/Tokyo">Tokyo</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            <p class="mt-1.5 text-xs text-muted-foreground">Used for scheduling and timestamps</p>
                            @if (!string.IsNullOrEmpty(_timezoneError))
                            {
                                <p class="mt-1 text-xs text-destructive">@_timezoneError</p>
                            }
                        </div>
                    </div>

                    <div>
                        <div>
                            <div class="flex items-center justify-between">
                                <div class="space-y-0.5">
                                    <LabelCn>Email Notifications</LabelCn>
                                    <p class="text-xs text-muted-foreground">
                                        Receive email updates about your activity
                                    </p>
                                </div>
                                <SwitchCn Checked="_notifications" CheckedChanged="v => _notifications = v" aria-label="Email Notifications" />
                            </div>
                        </div>
                    </div>

                    <div>
                        <div>
                            <div class="flex items-center justify-between">
                                <div class="space-y-0.5">
                                    <LabelCn>Two-Factor Authentication</LabelCn>
                                    <p class="text-xs text-muted-foreground">Add an extra layer of security</p>
                                </div>
                                <SwitchCn Checked="_twoFactor" CheckedChanged="v => _twoFactor = v" aria-label="Two-Factor Authentication" />
                            </div>
                        </div>
                    </div>
                </TabsContentCn>
            </div>
        </TabsCn>

        <div class="flex justify-end gap-2 border-t px-6 py-4">
            <ButtonCn Variant="ButtonVariant.Outline" Type="button">
                Cancel
            </ButtonCn>
            <ButtonCn Type="submit" @onclick="HandleSubmit">Save Changes</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _activeTab = "general";

    private string _name = "";
    private string _email = "";
    private string _role = "viewer";

    private string _company = "";
    private string _department = "";
    private string _bio = "";

    private string _timezone = "America/New_York";
    private bool _notifications = true;
    private bool _twoFactor = false;

    private string _nameError = "";
    private string _emailError = "";
    private string _roleError = "";
    private string _companyError = "";
    private string _departmentError = "";
    private string _bioError = "";
    private string _timezoneError = "";

    private void SetActiveTab(string? v) => _activeTab = v ?? "general";
    private void SetRole(string? v) => _role = v ?? "viewer";
    private void SetTimezone(string? v) => _timezone = v ?? "America/New_York";

    private void HandleSubmit()
    {
        _nameError = string.IsNullOrEmpty(_name) ? "Name is required" : "";
        _emailError = !_email.Contains('@') ? "Invalid email address" : "";
        _roleError = string.IsNullOrEmpty(_role) ? "Role is required" : "";
        _companyError = string.IsNullOrEmpty(_company) ? "Company name is required" : "";
        _departmentError = string.IsNullOrEmpty(_department) ? "Department is required" : "";
        _bioError = _bio.Length > 500 ? "Bio must be less than 500 characters" : "";
        _timezoneError = string.IsNullOrEmpty(_timezone) ? "Timezone is required" : "";
    }
}
