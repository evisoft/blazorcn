@* ============================================================
   Block: form-loading-state
   Title: FormLoadingState
   Description: A form showing loading and submitting states with disabled fields and animated spinner
   Source: original/blocks/form/form-loading-state.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Contact Support</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Submit your inquiry and we'll respond within 24 hours
            </p>
        </div>

        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="loading-state-name">Full Name</FieldLabelCn>
                    <InputCn id="loading-state-name" @bind-Value="_name" Placeholder="Enter your name" Disabled="@_isSubmitting" />
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="loading-state-email">Email Address</FieldLabelCn>
                    <InputCn id="loading-state-email" @bind-Value="_email" Placeholder="@("your.email@example.com")" Disabled="@_isSubmitting" />
                    <FieldDescriptionCn>We'll reply to this address</FieldDescriptionCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="department">Department</FieldLabelCn>
                    <SelectCn Value="@_department" ValueChanged="@((string? v) => _department = v ?? "")" Disabled="@_isSubmitting">
                        <SelectTriggerCn id="department">
                            <SelectValueCn Placeholder="Select department" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="sales">Sales</SelectItemCn>
                            <SelectItemCn Value="support">Technical Support</SelectItemCn>
                            <SelectItemCn Value="billing">Billing</SelectItemCn>
                            <SelectItemCn Value="general">General Inquiry</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="loading-state-message">Message</FieldLabelCn>
                    <TextareaCn id="loading-state-message" @bind-Value="_message" Placeholder="Describe your issue or question" Class="min-h-[120px] resize-none" Disabled="@_isSubmitting" />
                    <FieldDescriptionCn>Provide as much detail as possible</FieldDescriptionCn>
                </FieldCn>

                <div class="flex justify-end gap-2 pt-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" Disabled="@_isSubmitting">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="submit" Disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <LucideIconCn Name="loader" Size="16" Class="mr-2 size-4 animate-spin" />
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <span>Submit Request</span>
                        }
                    </ButtonCn>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private string _name = "";
    private string _email = "";
    private string _department = "";
    private string _message = "";
    private bool _isSubmitting = false;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;

        // Simulate API call
        await Task.Delay(2000);

        _name = "";
        _email = "";
        _department = "";
        _message = "";
        _isSubmitting = false;
    }
}
