@* ============================================================
   Block: form-responsive-layout
   Title: FormResponsiveLayout
   Description: A form that automatically switches between vertical and horizontal layouts based on screen size
   Source: original/blocks/form/form-responsive-layout.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Company Profile</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Tell us about your company</p>
        </div>
        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <FieldGroupCn class="space-y-4">

                @* Company name field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_companyNameError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="responsive-layout-companyName">Company name</FieldLabelCn>
                        <FieldDescriptionCn>The legal name of your organization</FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_companyNameError))
                        {
                            <FieldErrorCn Errors="@(new[] { _companyNameError })" />
                        }
                    </FieldContentCn>
                    <InputCn id="responsive-layout-companyName"
                             @bind-Value="_companyName"
                             Placeholder="Acme Corporation"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_companyNameError) ? "true" : "false")" />
                </FieldCn>

                @* Website URL field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_websiteError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="responsive-layout-website">Website URL</FieldLabelCn>
                        <FieldDescriptionCn>Your company's primary website</FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_websiteError))
                        {
                            <FieldErrorCn Errors="@(new[] { _websiteError })" />
                        }
                    </FieldContentCn>
                    <InputCn id="responsive-layout-website"
                             type="url"
                             @bind-Value="_website"
                             Placeholder="https://example.com"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_websiteError) ? "true" : "false")" />
                </FieldCn>

                @* Industry field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_industryError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="industry">Industry</FieldLabelCn>
                        <FieldDescriptionCn>
                            The primary industry your company operates in
                        </FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_industryError))
                        {
                            <FieldErrorCn Errors="@(new[] { _industryError })" />
                        }
                    </FieldContentCn>
                    <SelectCn Value="@_industry" ValueChanged="@OnIndustryChanged">
                        <SelectTriggerCn id="industry" Class="w-full">
                            <SelectValueCn Placeholder="Select industry" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="technology">Technology</SelectItemCn>
                            <SelectItemCn Value="finance">Finance</SelectItemCn>
                            <SelectItemCn Value="healthcare">Healthcare</SelectItemCn>
                            <SelectItemCn Value="education">Education</SelectItemCn>
                            <SelectItemCn Value="retail">Retail</SelectItemCn>
                            <SelectItemCn Value="manufacturing">Manufacturing</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </FieldCn>

                @* Description field *@
                <FieldCn Orientation="FieldOrientation.Responsive"
                         data-invalid="@(_submitted && !string.IsNullOrEmpty(_descriptionError) ? "true" : null)">
                    <FieldContentCn>
                        <FieldLabelCn For="responsive-layout-description">Description</FieldLabelCn>
                        <FieldDescriptionCn>Brief overview of your company and services</FieldDescriptionCn>
                        @if (_submitted && !string.IsNullOrEmpty(_descriptionError))
                        {
                            <FieldErrorCn Errors="@(new[] { _descriptionError })" />
                        }
                    </FieldContentCn>
                    <TextareaCn id="responsive-layout-description"
                                @bind-Value="_description"
                                Placeholder="We specialize in..."
                                rows="4"
                                aria-invalid="@(_submitted && !string.IsNullOrEmpty(_descriptionError) ? "true" : "false")" />
                </FieldCn>

                @* Newsletter / email preferences field *@
                <FieldCn Orientation="FieldOrientation.Responsive">
                    <FieldContentCn>
                        <FieldLabelCn>Email preferences</FieldLabelCn>
                        <FieldDescriptionCn>Choose how you'd like to hear from us</FieldDescriptionCn>
                    </FieldContentCn>
                    <div class="flex items-center gap-2">
                        <CheckboxCn @bind-Checked="_newsletter" aria-label="Subscribe to newsletter and updates" />
                        <span class="text-sm">Subscribe to newsletter and updates</span>
                    </div>
                </FieldCn>

            </FieldGroupCn>

            <div class="mt-6 flex justify-end gap-2">
                <ButtonCn type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="Cancel">
                    Cancel
                </ButtonCn>
                <ButtonCn type="submit" Size="ButtonSize.Sm">
                    Save profile
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _companyName = "";
    private string _website = "";
    private string _industry = "";
    private string _description = "";
    private bool _newsletter = false;

    private string _companyNameError = "";
    private string _websiteError = "";
    private string _industryError = "";
    private string _descriptionError = "";

    private bool _submitted = false;

    private void OnIndustryChanged(string? value)
    {
        _industry = value ?? "";
        _industryError = "";
    }

    private void Validate()
    {
        _companyNameError = _companyName.Length < 2 ? "Company name is required" : "";
        _websiteError = string.IsNullOrWhiteSpace(_website) || (!_website.StartsWith("http://") && !_website.StartsWith("https://"))
            ? "Please enter a valid URL"
            : "";
        _industryError = string.IsNullOrEmpty(_industry) ? "Please select an industry" : "";
        _descriptionError = _description.Length < 20 ? "Description must be at least 20 characters" : "";
    }

    private void HandleSubmit()
    {
        _submitted = true;
        Validate();
        // Presentational only — would submit form data if valid
    }

    private void Cancel()
    {
        _companyName = "";
        _website = "";
        _industry = "";
        _description = "";
        _newsletter = false;
        _companyNameError = "";
        _websiteError = "";
        _industryError = "";
        _descriptionError = "";
        _submitted = false;
    }
}
