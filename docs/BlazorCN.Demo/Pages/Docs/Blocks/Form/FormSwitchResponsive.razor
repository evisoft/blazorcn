@* ============================================================
   Block: form-switch-responsive
   Title: FormSwitchResponsive
   Description: A responsive switch form that adapts layout from vertical to horizontal
   Source: original/blocks/form/form-switch-responsive.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Display Preferences</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Customize how content is displayed across devices
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <fieldset>
                    <legend class="text-sm font-medium leading-none">Appearance Settings</legend>
                    <div class="mt-3 space-y-3">
                        @foreach (var setting in _displaySettings)
                        {
                            var s = setting;
                            <FieldCn Orientation="FieldOrientation.Responsive">
                                <FieldContentCn>
                                    <LabelCn For="@s.Name">@s.Label</LabelCn>
                                    <FieldDescriptionCn>@s.Description</FieldDescriptionCn>
                                </FieldContentCn>
                                <SwitchCn id="@s.Name" Checked="@_values[s.Name]" CheckedChanged="@((bool v) => _values[s.Name] = v)" />
                            </FieldCn>
                        }
                    </div>
                </fieldset>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="ApplyChanges">
                        Apply Changes
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record DisplaySetting(string Name, string Label, string Description);

    private static readonly DisplaySetting[] _displaySettings =
    [
        new("darkMode", "Dark Mode", "Switch to a dark color scheme for reduced eye strain"),
        new("compactView", "Compact View", "Display more content by reducing spacing and padding"),
        new("animations", "Enable Animations", "Show smooth transitions and animated UI elements"),
    ];

    private Dictionary<string, bool> _values = new()
    {
        ["darkMode"] = false,
        ["compactView"] = false,
        ["animations"] = true,
    };

    private void ResetForm()
    {
        _values = new()
        {
            ["darkMode"] = false,
            ["compactView"] = false,
            ["animations"] = true,
        };
    }

    private void ApplyChanges()
    {
        // Handle form submission (presentational only)
    }
}
