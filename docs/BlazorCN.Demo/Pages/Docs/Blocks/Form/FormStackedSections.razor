@* ============================================================
   Block: form-stacked-sections
   Title: FormStackedSections
   Description: A form divided into logical sections with separators and fieldset groups
   Source: original/blocks/form/form-stacked-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">User Profile</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Complete your profile information</p>
        </div>
        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-6">

                @* Personal Information Section *@
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Personal Information</legend>
                    <div class="mt-3 space-y-4">
                        <div @attributes="_fullNameInvalid ? _invalidAttr : null">
                            <LabelCn For="stacked-sections-fullName" Class="mb-1.5 block">Full name</LabelCn>
                            <InputCn id="stacked-sections-fullName" Placeholder="John Doe" @bind-Value="_fullName"
                                     aria-invalid="@(_fullNameInvalid ? "true" : "false")" />
                            <p class="mt-1 text-xs text-muted-foreground">Your name as you'd like it displayed</p>
                            @if (_fullNameInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Full name is required</p>
                            }
                        </div>

                        <div @attributes="_dateOfBirthInvalid ? _invalidAttr : null">
                            <LabelCn For="dateOfBirth" Class="mb-1.5 block">Date of birth</LabelCn>
                            <InputCn id="dateOfBirth" type="date" @bind-Value="_dateOfBirth"
                                     aria-invalid="@(_dateOfBirthInvalid ? "true" : "false")" />
                            <p class="mt-1 text-xs text-muted-foreground">Your date of birth (MM/DD/YYYY)</p>
                            @if (_dateOfBirthInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Date of birth is required</p>
                            }
                        </div>

                        <div @attributes="_bioInvalid ? _invalidAttr : null">
                            <LabelCn For="stacked-sections-bio" Class="mb-1.5 block">Bio</LabelCn>
                            <TextareaCn id="stacked-sections-bio" Placeholder="Tell us about yourself..."
                                        @bind-Value="_bio" rows="3"
                                        aria-invalid="@(_bioInvalid ? "true" : "false")" />
                            <p class="mt-1 text-xs text-muted-foreground">Brief description about yourself</p>
                            @if (_bioInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Bio must be at least 10 characters</p>
                            }
                        </div>
                    </div>
                </fieldset>

                <hr class="border-border" />

                @* Contact Information Section *@
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Contact Information</legend>
                    <div class="mt-3 space-y-4">
                        <div @attributes="_emailInvalid ? _invalidAttr : null">
                            <LabelCn For="stacked-sections-email" Class="mb-1.5 block">Email address</LabelCn>
                            <InputCn id="stacked-sections-email" type="email" Placeholder="@("john@example.com")"
                                     @bind-Value="_email"
                                     aria-invalid="@(_emailInvalid ? "true" : "false")" />
                            <p class="mt-1 text-xs text-muted-foreground">Primary email for account notifications</p>
                            @if (_emailInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Please enter a valid email</p>
                            }
                        </div>

                        <div @attributes="_phoneInvalid ? _invalidAttr : null">
                            <LabelCn For="stacked-sections-phone" Class="mb-1.5 block">Phone number</LabelCn>
                            <InputCn id="stacked-sections-phone" type="tel" Placeholder="+1 (555) 123-4567"
                                     @bind-Value="_phone"
                                     aria-invalid="@(_phoneInvalid ? "true" : "false")" />
                            <p class="mt-1 text-xs text-muted-foreground">Include your country code</p>
                            @if (_phoneInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Please enter a valid phone number</p>
                            }
                        </div>
                    </div>
                </fieldset>

                <hr class="border-border" />

                @* Preferences Section *@
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Preferences</legend>
                    <div class="mt-3 space-y-4">
                        <div @attributes="_languageInvalid ? _invalidAttr : null">
                            <LabelCn For="stacked-sections-language" Class="mb-1.5 block">Language</LabelCn>
                            <SelectCn Value="@_language" ValueChanged="@((string? v) => _language = v ?? "")">
                                <SelectTriggerCn id="stacked-sections-language" Class="w-full"
                                                 aria-invalid="@(_languageInvalid ? "true" : "false")">
                                    <SelectValueCn Placeholder="Select language" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="en">English</SelectItemCn>
                                    <SelectItemCn Value="es">Spanish</SelectItemCn>
                                    <SelectItemCn Value="fr">French</SelectItemCn>
                                    <SelectItemCn Value="de">German</SelectItemCn>
                                    <SelectItemCn Value="ja">Japanese</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            <p class="mt-1 text-xs text-muted-foreground">Preferred language for the interface</p>
                            @if (_languageInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Please select a language</p>
                            }
                        </div>

                        <div @attributes="_timezoneInvalid ? _invalidAttr : null">
                            <LabelCn For="stacked-sections-timezone" Class="mb-1.5 block">Timezone</LabelCn>
                            <SelectCn Value="@_timezone" ValueChanged="@((string? v) => _timezone = v ?? "")">
                                <SelectTriggerCn id="stacked-sections-timezone" Class="w-full"
                                                 aria-invalid="@(_timezoneInvalid ? "true" : "false")">
                                    <SelectValueCn Placeholder="Select timezone" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="pst">Pacific Time (PST)</SelectItemCn>
                                    <SelectItemCn Value="mst">Mountain Time (MST)</SelectItemCn>
                                    <SelectItemCn Value="cst">Central Time (CST)</SelectItemCn>
                                    <SelectItemCn Value="est">Eastern Time (EST)</SelectItemCn>
                                    <SelectItemCn Value="utc">UTC</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            <p class="mt-1 text-xs text-muted-foreground">Your local timezone for scheduling</p>
                            @if (_timezoneInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Please select a timezone</p>
                            }
                        </div>

                        <div>
                            <div class="flex items-start gap-2">
                                <CheckboxCn id="stacked-sections-emailNotifications"
                                            aria-label="Email notifications"
                                            Checked="@_emailNotifications"
                                            CheckedChanged="@((bool v) => _emailNotifications = v)"
                                            Class="mt-0.5" />
                                <div class="flex-1">
                                    <span class="text-sm font-medium">Email notifications</span>
                                    <p class="text-xs text-muted-foreground">
                                        Receive updates and announcements via email
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>

            </div>

            <div class="mt-6 flex justify-end gap-2">
                <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="HandleCancel">
                    Cancel
                </ButtonCn>
                <ButtonCn Type="submit" Size="ButtonSize.Sm">
                    Save changes
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _fullName = "";
    private string _dateOfBirth = "";
    private string _bio = "";
    private string _email = "";
    private string _phone = "";
    private string _language = "";
    private string _timezone = "";
    private bool _emailNotifications = true;
    private bool _submitted = false;

    private bool _fullNameInvalid    => _submitted && _fullName.Trim().Length < 2;
    private bool _dateOfBirthInvalid => _submitted && string.IsNullOrWhiteSpace(_dateOfBirth);
    private bool _bioInvalid         => _submitted && _bio.Trim().Length < 10;
    private bool _emailInvalid       => _submitted && !IsValidEmail(_email);
    private bool _phoneInvalid       => _submitted && StripPhone(_phone).Length < 10;
    private bool _languageInvalid    => _submitted && string.IsNullOrEmpty(_language);
    private bool _timezoneInvalid    => _submitted && string.IsNullOrEmpty(_timezone);

    private static readonly Dictionary<string, object> _invalidAttr = new() { ["data-invalid"] = "true" };

    private void HandleSubmit()
    {
        _submitted = true;
    }

    private void HandleCancel()
    {
        _fullName           = "";
        _dateOfBirth        = "";
        _bio                = "";
        _email              = "";
        _phone              = "";
        _language           = "";
        _timezone           = "";
        _emailNotifications = true;
        _submitted          = false;
    }

    private static bool IsValidEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var at = value.IndexOf('@');
        if (at <= 0 || at == value.Length - 1) return false;
        var dot = value.LastIndexOf('.');
        return dot > at + 1 && dot < value.Length - 1;
    }

    private static string StripPhone(string value) =>
        value.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace("+", "");
}
