@* ============================================================
   Block: form-wizard
   Title: FormWizard
   Description: A wizard form with left sidebar navigation showing progress through multiple steps
   Source: original/blocks/form/form-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Setup Wizard</h2>
            <p class="mt-1 text-muted-foreground text-xs">Complete all steps to get started</p>
        </div>

        <div class="flex">
            <div class="w-48 border-r bg-muted/50 px-4 py-6">
                <nav class="space-y-2">
                    @foreach (var step in _steps)
                    {
                        var s = step;
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-start gap-3 rounded-md px-3 py-2 text-left transition-colors", _currentStep == s.Id ? "bg-background" : "hover:bg-muted/50", s.Id > _currentStep ? "cursor-not-allowed opacity-50" : "")"
                                disabled="@(s.Id > _currentStep ? "disabled" : null)"
                                @onclick="@(() => GoToStep(s.Id))">
                            <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full border text-xs font-medium", _currentStep > s.Id ? "border-emerald-500 bg-emerald-500 text-white" : _currentStep == s.Id ? "border-foreground bg-foreground text-background" : "border-muted-foreground/30 bg-background text-muted-foreground")">
                                @if (_currentStep > s.Id)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    @s.Id
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="@Cn.Merge("text-sm", _currentStep >= s.Id ? "font-medium text-foreground" : "text-muted-foreground")">
                                    @s.Title
                                </div>
                                <div class="mt-0.5 text-muted-foreground text-xs">@s.Description</div>
                            </div>
                        </button>
                    }
                </nav>
            </div>

            <div class="flex-1">
                <form>
                    <div class="px-6 py-6">
                        @if (_currentStep == 1)
                        {
                            <div class="space-y-4">
                                <div>
                                    <h3 class="font-medium text-sm">Account Details</h3>
                                    <p class="mt-1 text-muted-foreground text-xs">
                                        Choose your login credentials
                                    </p>
                                </div>

                                <FieldCn>
                                    <FieldLabelCn For="username">Username</FieldLabelCn>
                                    <InputCn id="username"
                                             Placeholder="Enter username"
                                             @bind-Value="_username"
                                             aria-invalid="@(!string.IsNullOrEmpty(_usernameError) ? "true" : "false")" />
                                    @if (!string.IsNullOrEmpty(_usernameError))
                                    {
                                        <FieldErrorCn Errors="@(new[] { _usernameError })" />
                                    }
                                </FieldCn>

                                <FieldCn>
                                    <FieldLabelCn For="password">Password</FieldLabelCn>
                                    <InputCn id="password"
                                             type="password"
                                             Placeholder="Enter password"
                                             @bind-Value="_password"
                                             aria-invalid="@(!string.IsNullOrEmpty(_passwordError) ? "true" : "false")" />
                                    @if (!string.IsNullOrEmpty(_passwordError))
                                    {
                                        <FieldErrorCn Errors="@(new[] { _passwordError })" />
                                    }
                                </FieldCn>
                            </div>
                        }

                        @if (_currentStep == 2)
                        {
                            <div class="space-y-4">
                                <div>
                                    <h3 class="font-medium text-sm">Profile Information</h3>
                                    <p class="mt-1 text-muted-foreground text-xs">Tell us about yourself</p>
                                </div>

                                <FieldCn>
                                    <FieldLabelCn For="displayName">Display Name</FieldLabelCn>
                                    <InputCn id="displayName"
                                             Placeholder="How should we call you?"
                                             @bind-Value="_displayName"
                                             aria-invalid="@(!string.IsNullOrEmpty(_displayNameError) ? "true" : "false")" />
                                    @if (!string.IsNullOrEmpty(_displayNameError))
                                    {
                                        <FieldErrorCn Errors="@(new[] { _displayNameError })" />
                                    }
                                </FieldCn>

                                <FieldCn>
                                    <FieldLabelCn For="avatar">Avatar URL</FieldLabelCn>
                                    <InputCn id="avatar"
                                             type="url"
                                             Placeholder="@("https://example.com/avatar.jpg")"
                                             @bind-Value="_avatar"
                                             aria-invalid="@(!string.IsNullOrEmpty(_avatarError) ? "true" : "false")" />
                                    <FieldDescriptionCn>Optional. Provide a URL to your profile picture.</FieldDescriptionCn>
                                    @if (!string.IsNullOrEmpty(_avatarError))
                                    {
                                        <FieldErrorCn Errors="@(new[] { _avatarError })" />
                                    }
                                </FieldCn>
                            </div>
                        }

                        @if (_currentStep == 3)
                        {
                            <div class="space-y-4">
                                <div>
                                    <h3 class="font-medium text-sm">Preferences</h3>
                                    <p class="mt-1 text-muted-foreground text-xs">
                                        Customize your experience
                                    </p>
                                </div>

                                <FieldCn>
                                    <FieldLabelCn For="timezone">Timezone</FieldLabelCn>
                                    <SelectCn Value="@_timezone" ValueChanged="@OnTimezoneChanged">
                                        <SelectTriggerCn id="timezone" Class="w-full">
                                            <SelectValueCn Placeholder="Select timezone" />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="America/New_York">Eastern Time (ET)</SelectItemCn>
                                            <SelectItemCn Value="America/Chicago">Central Time (CT)</SelectItemCn>
                                            <SelectItemCn Value="America/Denver">Mountain Time (MT)</SelectItemCn>
                                            <SelectItemCn Value="America/Los_Angeles">Pacific Time (PT)</SelectItemCn>
                                            <SelectItemCn Value="UTC">UTC</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                    @if (!string.IsNullOrEmpty(_timezoneError))
                                    {
                                        <FieldErrorCn Errors="@(new[] { _timezoneError })" />
                                    }
                                </FieldCn>

                                <FieldCn>
                                    <span class="flex items-center gap-2">
                                        <CheckboxCn id="notifications" Checked="@_notifications" CheckedChanged="@OnNotificationsChanged" />
                                        <span class="text-sm">Enable email notifications</span>
                                    </span>
                                    <FieldDescriptionCn>Receive updates about your account activity</FieldDescriptionCn>
                                </FieldCn>
                            </div>
                        }

                        @if (_currentStep == 4)
                        {
                            <div class="space-y-4">
                                <div>
                                    <h3 class="font-medium text-sm">Review &amp; Confirm</h3>
                                    <p class="mt-1 text-muted-foreground text-xs">
                                        Check your information before submitting
                                    </p>
                                </div>

                                <div class="space-y-3 rounded-md bg-muted/50 p-3">
                                    <div>
                                        <span class="text-muted-foreground text-xs">Username</span>
                                        <p class="mt-0.5 text-sm">@_username</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground text-xs">Display Name</span>
                                        <p class="mt-0.5 text-sm">@_displayName</p>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_avatar))
                                    {
                                        <div>
                                            <span class="text-muted-foreground text-xs">Avatar URL</span>
                                            <p class="mt-0.5 truncate text-sm">@_avatar</p>
                                        </div>
                                    }
                                    <div>
                                        <span class="text-muted-foreground text-xs">Timezone</span>
                                        <p class="mt-0.5 text-sm">@_timezone</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground text-xs">Email Notifications</span>
                                        <p class="mt-0.5 text-sm">@(_notifications ? "Enabled" : "Disabled")</p>
                                    </div>
                                </div>

                                <FieldCn>
                                    <span class="flex items-start gap-2">
                                        <CheckboxCn id="terms" Checked="@_terms" CheckedChanged="@OnTermsChanged" />
                                        <span class="text-sm">
                                            I agree to the terms of service and privacy policy
                                        </span>
                                    </span>
                                    @if (!string.IsNullOrEmpty(_termsError))
                                    {
                                        <FieldErrorCn Errors="@(new[] { _termsError })" />
                                    }
                                </FieldCn>
                            </div>
                        }
                    </div>

                    <div class="flex items-center justify-between border-t px-6 py-3">
                        <ButtonCn type="button" Variant="ButtonVariant.Ghost" @onclick="HandleBack" Disabled="@(_currentStep == 1)">
                            Back
                        </ButtonCn>
                        @if (_currentStep < _steps.Length)
                        {
                            <ButtonCn type="button" @onclick="HandleNext">
                                Continue
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn type="submit" @onclick="HandleSubmit">
                                Complete Setup
                            </ButtonCn>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepInfo(int Id, string Title, string Description);

    private static readonly StepInfo[] _steps =
    [
        new(1, "Account", "Create your account"),
        new(2, "Profile", "Set up your profile"),
        new(3, "Preferences", "Configure settings"),
        new(4, "Confirm", "Review and submit"),
    ];

    private int _currentStep = 1;

    // Step 1 — Account
    private string _username = "";
    private string _password = "";
    private string _usernameError = "";
    private string _passwordError = "";

    // Step 2 — Profile
    private string _displayName = "";
    private string _avatar = "";
    private string _displayNameError = "";
    private string _avatarError = "";

    // Step 3 — Preferences
    private string _timezone = "";
    private bool _notifications = true;
    private string _timezoneError = "";

    // Step 4 — Confirm
    private bool _terms = false;
    private string _termsError = "";

    private void GoToStep(int stepId)
    {
        if (stepId <= _currentStep)
            _currentStep = stepId;
    }

    private void OnTimezoneChanged(string? value)
    {
        _timezone = value ?? "";
        _timezoneError = "";
    }

    private void OnNotificationsChanged(bool value)
    {
        _notifications = value;
    }

    private void OnTermsChanged(bool value)
    {
        _terms = value;
        _termsError = "";
    }

    private bool ValidateStep1()
    {
        _usernameError = "";
        _passwordError = "";

        if (string.IsNullOrEmpty(_username) || _username.Length < 3)
            _usernameError = "Username must be at least 3 characters";

        if (string.IsNullOrEmpty(_password) || _password.Length < 8)
            _passwordError = "Password must be at least 8 characters";

        return string.IsNullOrEmpty(_usernameError) && string.IsNullOrEmpty(_passwordError);
    }

    private bool ValidateStep2()
    {
        _displayNameError = "";
        _avatarError = "";

        if (string.IsNullOrEmpty(_displayName) || _displayName.Length < 2)
            _displayNameError = "Display name is required";

        if (!string.IsNullOrEmpty(_avatar) && !Uri.TryCreate(_avatar, UriKind.Absolute, out _))
            _avatarError = "Must be a valid URL";

        return string.IsNullOrEmpty(_displayNameError) && string.IsNullOrEmpty(_avatarError);
    }

    private bool ValidateStep3()
    {
        _timezoneError = "";

        if (string.IsNullOrEmpty(_timezone))
            _timezoneError = "Please select a timezone";

        return string.IsNullOrEmpty(_timezoneError);
    }

    private bool ValidateStep4()
    {
        _termsError = "";

        if (!_terms)
            _termsError = "You must accept the terms";

        return string.IsNullOrEmpty(_termsError);
    }

    private void HandleNext()
    {
        bool isValid = _currentStep switch
        {
            1 => ValidateStep1(),
            2 => ValidateStep2(),
            3 => ValidateStep3(),
            _ => true,
        };

        if (isValid && _currentStep < _steps.Length)
            _currentStep++;
    }

    private void HandleBack()
    {
        if (_currentStep > 1)
            _currentStep--;
    }

    private void HandleSubmit()
    {
        if (ValidateStep4())
        {
            // Presentational only — form submitted
        }
    }
}
