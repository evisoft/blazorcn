@* ============================================================
   Block: form-survey
   Title: FormSurvey
   Description: A survey form with mixed question types including radio buttons, checkboxes, textarea, and slider rating scales with progress tracking.
   Source: original/blocks/form/form-survey.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Customer Satisfaction Survey</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Help us improve your experience
                    </p>
                </div>
                <div class="text-right">
                    <p class="font-medium text-sm tabular-nums">
                        @_answeredQuestions/@_totalQuestions
                    </p>
                    <p class="text-muted-foreground text-xs">Completed</p>
                </div>
            </div>
            <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div
                    class="h-full bg-foreground transition-all duration-300"
                    style="@($"width:{(_answeredQuestions * 100 / _totalQuestions)}%")" />
            </div>
        </div>

        <form>
            <div class="border-b px-4 py-4">
                <FieldGroupCn>
                    <LabelCn Class="text-sm font-medium">
                        1. How satisfied are you with our product?
                    </LabelCn>
                    <div class="mt-3">
                        <RadioGroupCn Value="@_satisfaction" ValueChanged="@((string? v) => { _satisfaction = v ?? ""; UpdateProgress(); })">
                            @foreach (var opt in _satisfactionOptions)
                            {
                                var option = opt;
                                <label for="@option.Value" class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50">
                                    <RadioGroupItemCn id="@option.Value" Value="@option.Value" />
                                    <span class="text-sm">@option.Label</span>
                                </label>
                            }
                        </RadioGroupCn>
                        @if (_submitted && string.IsNullOrEmpty(_satisfaction))
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select your satisfaction level" })" />
                        }
                    </div>
                </FieldGroupCn>
            </div>

            <div class="border-b px-4 py-4">
                <FieldGroupCn>
                    <LabelCn Class="text-sm font-medium">
                        2. Which aspects do you value most?
                    </LabelCn>
                    <FieldDescriptionCn Class="mt-1">Select all that apply</FieldDescriptionCn>
                    <div class="mt-3">
                        <div class="space-y-2">
                            @foreach (var opt in _featureOptions)
                            {
                                var option = opt;
                                <label for="@($"feature-{option.Value}")" class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50">
                                    <CheckboxCn id="@($"feature-{option.Value}")"
                                                Checked="@(_selectedFeatures.Contains(option.Value))"
                                                CheckedChanged="@((bool v) => ToggleFeature(option.Value, v))" />
                                    <span class="text-sm">@option.Label</span>
                                </label>
                            }
                        </div>
                        @if (_submitted && _selectedFeatures.Count == 0)
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select at least one feature" })" />
                        }
                    </div>
                </FieldGroupCn>
            </div>

            <div class="border-b px-4 py-4">
                <FieldGroupCn>
                    <LabelCn Class="text-sm font-medium">
                        3. How likely are you to recommend us to a friend?
                    </LabelCn>
                    <FieldDescriptionCn Class="mt-1">0 = Not likely, 10 = Very likely</FieldDescriptionCn>
                    <div class="mt-4">
                        <div class="space-y-4">
                            <SliderCn Value="@((double)_rating)"
                                      ValueChanged="@((double v) => { _rating = (int)v; UpdateProgress(); })"
                                      Min="0"
                                      Max="10"
                                      Step="1"
                                      aria-label="How likely are you to recommend us to a friend?"
                                      Class="w-full" />
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">Not likely</span>
                                <span class="font-semibold text-2xl tabular-nums">@_rating</span>
                                <span class="text-muted-foreground text-xs">Very likely</span>
                            </div>
                        </div>
                    </div>
                </FieldGroupCn>
            </div>

            <div class="px-4 py-4">
                <FieldCn>
                    <LabelCn Class="text-sm font-medium">4. What could we improve?</LabelCn>
                    <FieldDescriptionCn Class="mt-1">
                        Share your thoughts and suggestions
                    </FieldDescriptionCn>
                    <div class="mt-3">
                        <TextareaCn aria-label="What could we improve" @bind-Value="_feedback" Placeholder="I think you could improve..." Rows="4" />
                        <FieldDescriptionCn Class="mt-1.5">
                            @_feedback.Length characters (minimum 10)
                        </FieldDescriptionCn>
                        @if (_submitted && _feedback.Length < 10)
                        {
                            <FieldErrorCn Errors="@(new[] { "Please provide at least 10 characters of feedback" })" />
                        }
                    </div>
                </FieldCn>
            </div>

            <div class="border-t bg-muted/50 px-4 py-3">
                <div class="flex gap-3">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" Class="flex-1" @onclick="SaveDraft">
                        Save draft
                    </ButtonCn>
                    <ButtonCn type="button" Class="flex-1" @onclick="SubmitSurvey">
                        Submit survey
                    </ButtonCn>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private static readonly SatisfactionOption[] _satisfactionOptions =
    [
        new SatisfactionOption("very-dissatisfied", "Very dissatisfied"),
        new SatisfactionOption("dissatisfied", "Dissatisfied"),
        new SatisfactionOption("neutral", "Neutral"),
        new SatisfactionOption("satisfied", "Satisfied"),
        new SatisfactionOption("very-satisfied", "Very satisfied"),
    ];

    private static readonly FeatureOption[] _featureOptions =
    [
        new FeatureOption("ease-of-use", "Ease of use"),
        new FeatureOption("performance", "Performance"),
        new FeatureOption("design", "Design"),
        new FeatureOption("features", "Features"),
        new FeatureOption("support", "Customer support"),
        new FeatureOption("pricing", "Pricing"),
    ];

    private string _satisfaction = "";
    private List<string> _selectedFeatures = new();
    private int _rating = 5;
    private string _feedback = "";
    private bool _submitted = false;
    private int _answeredQuestions = 1; // rating always has a value
    private readonly int _totalQuestions = 4;

    protected override void OnInitialized()
    {
        UpdateProgress();
    }

    private void UpdateProgress()
    {
        _answeredQuestions = new[]
        {
            !string.IsNullOrEmpty(_satisfaction),
            _selectedFeatures.Count > 0,
            true, // rating always has a value (0-10)
            _feedback.Length >= 10,
        }.Count(b => b);
    }

    private void ToggleFeature(string value, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedFeatures.Contains(value))
                _selectedFeatures.Add(value);
        }
        else
        {
            _selectedFeatures.Remove(value);
        }
        UpdateProgress();
    }

    private void SaveDraft()
    {
        // Save draft (presentational only)
    }

    private void SubmitSurvey()
    {
        _submitted = true;
    }

    private record SatisfactionOption(string Value, string Label);
    private record FeatureOption(string Value, string Label);
}
