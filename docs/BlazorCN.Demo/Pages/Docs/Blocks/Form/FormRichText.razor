@* ============================================================
   Block: form-rich-text
   Title: FormRichText
   Description: A textarea form field with a formatting toolbar featuring bold, italic, underline, and list buttons. Demonstrates the pattern for text editors with action bars.
   Source: original/blocks/form/form-rich-text.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Write Your Post</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Share your thoughts with the community
            </p>
        </div>
        <form class="px-4 py-6">
            <FieldCn>
                <LabelCn>Content</LabelCn>
                <div class="space-y-2">
                    <div class="flex gap-1 rounded-md border bg-muted/50 p-1">
                        <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2" aria-label="Bold" @onclick="@(() => HandleFormatClick("bold"))">
                            <LucideIconCn Name="bold" Size="16" Class="size-4" />
                        </ButtonCn>
                        <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2" aria-label="Italic" @onclick="@(() => HandleFormatClick("italic"))">
                            <LucideIconCn Name="italic" Size="16" Class="size-4" />
                        </ButtonCn>
                        <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2" aria-label="Underline" @onclick="@(() => HandleFormatClick("underline"))">
                            <LucideIconCn Name="underline" Size="16" Class="size-4" />
                        </ButtonCn>
                        <div class="mx-1 w-px bg-border"></div>
                        <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2" aria-label="Bulleted list" @onclick="@(() => HandleFormatClick("list"))">
                            <LucideIconCn Name="list" Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>
                    <TextareaCn aria-label="Write something amazing" Placeholder="Write something amazing..."
                                Class="min-h-[200px] resize-none"
                                @bind-Value="_content" />
                </div>
                <FieldDescriptionCn>Use the toolbar above to format your text</FieldDescriptionCn>
                @if (_submitted && !string.IsNullOrEmpty(_contentError))
                {
                    <FieldErrorCn Errors="@(new[] { _contentError })" />
                }
            </FieldCn>

            <div class="mt-6 flex items-center justify-between gap-3">
                <p class="text-xs text-muted-foreground">
                    @_content.Length characters
                </p>
                <div class="flex gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline">
                        Save Draft
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="Submit">
                        Publish Post
                    </ButtonCn>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private string _content = "";
    private bool _submitted = false;
    private string _contentError = "";

    private void HandleFormatClick(string format)
    {
        // In a real implementation, this would apply formatting to selected text
    }

    private void Validate()
    {
        _contentError = "";
        if (_content.Length < 10)
            _contentError = "Content must be at least 10 characters";
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
        // If no errors, form is "submitted" (presentational only)
    }
}
