@* ============================================================
   Block: form-with-preview
   Title: FormWithPreview
   Description: A form with a live preview panel showing formatted output of the form data as you type
   Source: original/blocks/form/form-with-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-6 lg:grid-cols-2">

            @* Form Panel *@
            <div class="border-b p-6 lg:border-b-0 lg:border-r">
                <div class="mb-6">
                    <h2 class="text-sm font-medium">Article Details</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Fill in the details and see the live preview
                    </p>
                </div>

                <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="space-y-4">

                    <div>
                        <LabelCn For="title" Class="mb-1.5 block">Title</LabelCn>
                        <InputCn id="title" Placeholder="Enter article title" @bind-Value="_title" />
                        @if (_submitted && _title.Trim().Length == 0)
                        {
                            <p class="mt-1 text-xs text-destructive">Title is required</p>
                        }
                    </div>

                    <div>
                        <LabelCn For="description" Class="mb-1.5 block">Description</LabelCn>
                        <TextareaCn id="description" Placeholder="Write a brief description" Class="min-h-[96px] resize-none" @bind-Value="_description" />
                        <p class="mt-1.5 text-xs text-muted-foreground">A short summary of your article</p>
                        @if (_submitted && _description.Length < 10)
                        {
                            <p class="mt-1 text-xs text-destructive">Description must be at least 10 characters</p>
                        }
                    </div>

                    <div>
                        <LabelCn For="status-trigger" Class="mb-1.5 block">Status</LabelCn>
                        <SelectCn Value="@_status" ValueChanged="@((string? v) => _status = v ?? "draft")">
                            <SelectTriggerCn id="status-trigger">
                                <SelectValueCn Placeholder="Select status" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="draft">Draft</SelectItemCn>
                                <SelectItemCn Value="review">In Review</SelectItemCn>
                                <SelectItemCn Value="published">Published</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        @if (_submitted && string.IsNullOrWhiteSpace(_status))
                        {
                            <p class="mt-1 text-xs text-destructive">Please select a status</p>
                        }
                    </div>

                    <div>
                        <LabelCn For="badge-color-trigger" Class="mb-1.5 block">Badge Color</LabelCn>
                        <SelectCn Value="@_badgeColor" ValueChanged="@((string? v) => _badgeColor = v ?? "blue")">
                            <SelectTriggerCn id="badge-color-trigger">
                                <SelectValueCn Placeholder="Select color" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="gray">Gray</SelectItemCn>
                                <SelectItemCn Value="blue">Blue</SelectItemCn>
                                <SelectItemCn Value="green">Green</SelectItemCn>
                                <SelectItemCn Value="yellow">Yellow</SelectItemCn>
                                <SelectItemCn Value="red">Red</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div>
                        <LabelCn For="author" Class="mb-1.5 block">Author</LabelCn>
                        <InputCn id="author" Placeholder="Author name" @bind-Value="_author" />
                        @if (_submitted && _author.Trim().Length == 0)
                        {
                            <p class="mt-1 text-xs text-destructive">Author name is required</p>
                        }
                    </div>

                    <ButtonCn Type="submit" Class="w-full">Save Article</ButtonCn>
                </form>
            </div>

            @* Preview Panel *@
            <div class="p-6">
                <div class="mb-6">
                    <h2 class="text-sm font-medium">Live Preview</h2>
                    <p class="mt-1 text-xs text-muted-foreground">See how your article will appear</p>
                </div>

                <div class="space-y-4">
                    <div class="rounded-lg border bg-muted/50 p-4">
                        <div class="mb-3 flex items-start justify-between gap-3">
                            <h3 class="flex-1 text-sm font-medium leading-snug">
                                @(string.IsNullOrWhiteSpace(_title) ? "Untitled Article" : _title)
                            </h3>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="@BadgeColorClass(_badgeColor)">
                                @_status
                            </BadgeCn>
                        </div>

                        <p class="text-xs text-muted-foreground leading-relaxed">
                            @(string.IsNullOrWhiteSpace(_description) ? "No description provided" : _description)
                        </p>

                        <div class="mt-4 flex items-center gap-2 border-t pt-3">
                            <AvatarCn Class="size-6">
                                <AvatarFallbackCn Class="text-[10px]">@GetInitials(_author)</AvatarFallbackCn>
                            </AvatarCn>
                            <span class="text-xs text-muted-foreground">
                                @(string.IsNullOrWhiteSpace(_author) ? "Unknown Author" : _author)
                            </span>
                        </div>
                    </div>

                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="mb-2 text-xs font-medium text-muted-foreground">Metadata</p>
                        <dl class="space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <dt class="text-muted-foreground">Words</dt>
                                <dd class="font-medium tabular-nums">@WordCount(_description)</dd>
                            </div>
                            <div class="flex justify-between text-xs">
                                <dt class="text-muted-foreground">Characters</dt>
                                <dd class="font-medium tabular-nums">@_description.Length</dd>
                            </div>
                            <div class="flex justify-between text-xs">
                                <dt class="text-muted-foreground">Read time</dt>
                                <dd class="font-medium tabular-nums">@(Math.Max(1, (int)Math.Ceiling(WordCount(_description) / 200.0))) min</dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private string _title = "Getting Started with React";
    private string _description = "Learn the fundamentals of React development with practical examples and best practices.";
    private string _status = "draft";
    private string _badgeColor = "blue";
    private string _author = "Sarah Chen";
    private bool _submitted = false;

    private static string BadgeColorClass(string color) => color switch
    {
        "gray"   => "bg-gray-500/10 text-gray-700 dark:text-gray-300",
        "blue"   => "bg-blue-500/10 text-blue-700 dark:text-blue-300",
        "green"  => "bg-green-500/10 text-green-700 dark:text-green-300",
        "yellow" => "bg-yellow-500/10 text-yellow-700 dark:text-yellow-300",
        "red"    => "bg-red-500/10 text-red-700 dark:text-red-300",
        _        => ""
    };

    private static int WordCount(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Split(new[] { ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "UN";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = string.Concat(parts.Take(2).Select(p => char.ToUpper(p[0])));
        return initials.Length > 0 ? initials : "UN";
    }

    private void HandleSubmit()
    {
        _submitted = true;
        if (_title.Trim().Length > 0 &&
            _description.Length >= 10 &&
            !string.IsNullOrWhiteSpace(_status) &&
            _author.Trim().Length > 0)
        {
            // Valid — reset for demo
            _submitted = false;
        }
    }
}
