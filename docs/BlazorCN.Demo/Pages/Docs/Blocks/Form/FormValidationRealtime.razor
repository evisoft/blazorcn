@* ============================================================
   Block: form-validation-realtime
   Title: FormValidationRealtime
   Description: A form with real-time validation that validates fields as the user types, showing green checkmarks for valid fields.
   Source: original/blocks/form/form-validation-realtime.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Create Your Account</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Real-time validation as you type</p>
        </div>

        <form class="p-4">
            <div class="space-y-4">
                <FieldCn data-invalid="@(!string.IsNullOrEmpty(_usernameError) && _usernameTouched ? "true" : null)">
                    <LabelCn For="validation-realtime-username">Username</LabelCn>
                    <div class="relative">
                        <InputCn id="validation-realtime-username"
                                 Placeholder="johndoe"
                                 Class="pr-9"
                                 Value="@_username"
                                 ValueChanged="@((string v) => { _username = v; _usernameTouched = true; ValidateUsername(); })"
                                 aria-invalid="@(_usernameTouched && !string.IsNullOrEmpty(_usernameError) ? "true" : "false")" />
                        @if (_usernameTouched && string.IsNullOrEmpty(_usernameError) && _username.Length > 0)
                        {
                            <LucideIconCn Name="check" Size="16" Class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-emerald-500" />
                        }
                    </div>
                    <FieldDescriptionCn>3-20 characters, lowercase only</FieldDescriptionCn>
                    @if (_usernameTouched && !string.IsNullOrEmpty(_usernameError))
                    {
                        <FieldErrorCn Errors="@(new[] { _usernameError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(!string.IsNullOrEmpty(_emailError) && _emailTouched ? "true" : null)">
                    <LabelCn For="validation-realtime-email">Email Address</LabelCn>
                    <div class="relative">
                        <InputCn id="validation-realtime-email"
                                 type="email"
                                 Placeholder="@("john@example.com")"
                                 Class="pr-9"
                                 Value="@_email"
                                 ValueChanged="@((string v) => { _email = v; _emailTouched = true; ValidateEmail(); })"
                                 aria-invalid="@(_emailTouched && !string.IsNullOrEmpty(_emailError) ? "true" : "false")" />
                        @if (_emailTouched && string.IsNullOrEmpty(_emailError) && _email.Length > 0)
                        {
                            <LucideIconCn Name="check" Size="16" Class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-emerald-500" />
                        }
                    </div>
                    <FieldDescriptionCn>We'll send a verification email</FieldDescriptionCn>
                    @if (_emailTouched && !string.IsNullOrEmpty(_emailError))
                    {
                        <FieldErrorCn Errors="@(new[] { _emailError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(!string.IsNullOrEmpty(_passwordError) && _passwordTouched ? "true" : null)">
                    <LabelCn For="validation-realtime-password">Password</LabelCn>
                    <div class="relative">
                        <InputCn id="validation-realtime-password"
                                 type="password"
                                 Placeholder="••••••••"
                                 Class="pr-9"
                                 Value="@_password"
                                 ValueChanged="@((string v) => { _password = v; _passwordTouched = true; ValidatePassword(); ValidateConfirmPassword(); })"
                                 aria-invalid="@(_passwordTouched && !string.IsNullOrEmpty(_passwordError) ? "true" : "false")" />
                        @if (_passwordTouched && string.IsNullOrEmpty(_passwordError) && _password.Length > 0)
                        {
                            <LucideIconCn Name="check" Size="16" Class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-emerald-500" />
                        }
                    </div>
                    <FieldDescriptionCn>
                        At least 8 characters with uppercase, lowercase, and number
                    </FieldDescriptionCn>
                    @if (_passwordTouched && !string.IsNullOrEmpty(_passwordError))
                    {
                        <FieldErrorCn Errors="@(new[] { _passwordError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(!string.IsNullOrEmpty(_confirmPasswordError) && _confirmPasswordTouched ? "true" : null)">
                    <LabelCn For="confirmPassword">Confirm Password</LabelCn>
                    <div class="relative">
                        <InputCn id="confirmPassword"
                                 type="password"
                                 Placeholder="••••••••"
                                 Class="pr-9"
                                 Value="@_confirmPassword"
                                 ValueChanged="@((string v) => { _confirmPassword = v; _confirmPasswordTouched = true; ValidateConfirmPassword(); })"
                                 aria-invalid="@(_confirmPasswordTouched && !string.IsNullOrEmpty(_confirmPasswordError) ? "true" : "false")" />
                        @if (_confirmPasswordTouched && string.IsNullOrEmpty(_confirmPasswordError) && _confirmPassword.Length > 0)
                        {
                            <LucideIconCn Name="check" Size="16" Class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-emerald-500" />
                        }
                    </div>
                    @if (_confirmPasswordTouched && !string.IsNullOrEmpty(_confirmPasswordError))
                    {
                        <FieldErrorCn Errors="@(new[] { _confirmPasswordError })" />
                    }
                </FieldCn>
            </div>

            <div class="mt-6 flex gap-3">
                <ButtonCn type="submit" Class="flex-1" Disabled="@(!IsFormValid())" @onclick="HandleSubmit">
                    Create Account
                </ButtonCn>
                <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="ResetForm">
                    Reset
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _username = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";

    private bool _usernameTouched = false;
    private bool _emailTouched = false;
    private bool _passwordTouched = false;
    private bool _confirmPasswordTouched = false;

    private string _usernameError = "";
    private string _emailError = "";
    private string _passwordError = "";
    private string _confirmPasswordError = "";

    private void ValidateUsername()
    {
        _usernameError = "";
        if (_username.Length < 3)
            _usernameError = "Username must be at least 3 characters";
        else if (_username.Length > 20)
            _usernameError = "Username must not exceed 20 characters";
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_username, @"^[a-z0-9_]+$"))
            _usernameError = "Only lowercase letters, numbers, and underscores";
    }

    private void ValidateEmail()
    {
        _emailError = "";
        if (string.IsNullOrEmpty(_email) || !_email.Contains('@') || !_email.Contains('.'))
            _emailError = "Please enter a valid email address";
    }

    private void ValidatePassword()
    {
        _passwordError = "";
        if (_password.Length < 8)
            _passwordError = "Password must be at least 8 characters";
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_password, @"[A-Z]"))
            _passwordError = "Password must contain at least one uppercase letter";
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_password, @"[a-z]"))
            _passwordError = "Password must contain at least one lowercase letter";
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_password, @"[0-9]"))
            _passwordError = "Password must contain at least one number";
    }

    private void ValidateConfirmPassword()
    {
        _confirmPasswordError = "";
        if (_confirmPassword != _password)
            _confirmPasswordError = "Passwords do not match";
    }

    private bool IsFormValid()
    {
        return _username.Length > 0 && string.IsNullOrEmpty(_usernameError)
            && _email.Length > 0 && string.IsNullOrEmpty(_emailError)
            && _password.Length > 0 && string.IsNullOrEmpty(_passwordError)
            && _confirmPassword.Length > 0 && string.IsNullOrEmpty(_confirmPasswordError);
    }

    private void HandleSubmit()
    {
        // Presentational only — mark all fields as touched to show any remaining errors
        _usernameTouched = true;
        _emailTouched = true;
        _passwordTouched = true;
        _confirmPasswordTouched = true;
        ValidateUsername();
        ValidateEmail();
        ValidatePassword();
        ValidateConfirmPassword();
    }

    private void ResetForm()
    {
        _username = "";
        _email = "";
        _password = "";
        _confirmPassword = "";
        _usernameTouched = false;
        _emailTouched = false;
        _passwordTouched = false;
        _confirmPasswordTouched = false;
        _usernameError = "";
        _emailError = "";
        _passwordError = "";
        _confirmPasswordError = "";
    }
}
