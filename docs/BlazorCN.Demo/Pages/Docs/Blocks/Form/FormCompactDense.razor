@* ============================================================
   Block: form-compact-dense
   Title: FormCompactDense
   Description: An ultra-compact form with minimal spacing and smaller text for space-constrained UIs
   Source: original/blocks/form/form-compact-dense.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-3 py-2">
            <h2 class="text-xs font-medium">Quick Task</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Create a new task assignment</p>
        </div>

        <form class="p-3">
            <div class="space-y-2">

                @* Task Name *@
                <FieldCn data-invalid="@(_submitted && string.IsNullOrWhiteSpace(_taskName) ? "true" : null)">
                    <FieldLabelCn For="taskName" Class="text-xs">Task Name</FieldLabelCn>
                    <InputCn id="taskName"
                             Placeholder="Update documentation"
                             Class="h-8 text-sm"
                             @bind-Value="_taskName" />
                    @if (_submitted && string.IsNullOrWhiteSpace(_taskName))
                    {
                        <FieldErrorCn Errors="@(new[] { "Task name must be at least 3 characters" })" />
                    }
                </FieldCn>

                <div class="grid grid-cols-2 gap-2">
                    @* Assignee *@
                    <FieldCn data-invalid="@(_submitted && string.IsNullOrEmpty(_assignee) ? "true" : null)">
                        <FieldLabelCn For="assignee" Class="text-xs">Assignee</FieldLabelCn>
                        <SelectCn Value="@_assignee" ValueChanged="@((string? v) => _assignee = v ?? "")">
                            <SelectTriggerCn id="assignee" Class="h-8 text-sm">
                                <SelectValueCn Placeholder="Select" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="alice">Alice Johnson</SelectItemCn>
                                <SelectItemCn Value="bob">Bob Smith</SelectItemCn>
                                <SelectItemCn Value="charlie">Charlie Davis</SelectItemCn>
                                <SelectItemCn Value="diana">Diana Chen</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        @if (_submitted && string.IsNullOrEmpty(_assignee))
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select an assignee" })" />
                        }
                    </FieldCn>

                    @* Priority *@
                    <FieldCn data-invalid="@(_submitted && string.IsNullOrEmpty(_priority) ? "true" : null)">
                        <FieldLabelCn For="priority" Class="text-xs">Priority</FieldLabelCn>
                        <SelectCn Value="@_priority" ValueChanged="@((string? v) => _priority = v ?? "")">
                            <SelectTriggerCn id="priority" Class="h-8 text-sm">
                                <SelectValueCn Placeholder="Select" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="low">Low</SelectItemCn>
                                <SelectItemCn Value="medium">Medium</SelectItemCn>
                                <SelectItemCn Value="high">High</SelectItemCn>
                                <SelectItemCn Value="critical">Critical</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        @if (_submitted && string.IsNullOrEmpty(_priority))
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select a priority" })" />
                        }
                    </FieldCn>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    @* Due Date *@
                    <FieldCn data-invalid="@(_submitted && string.IsNullOrEmpty(_dueDate) ? "true" : null)">
                        <FieldLabelCn For="dueDate" Class="text-xs">Due Date</FieldLabelCn>
                        <InputCn id="dueDate"
                                 type="date"
                                 Class="h-8 text-sm"
                                 @bind-Value="_dueDate" />
                        @if (_submitted && string.IsNullOrEmpty(_dueDate))
                        {
                            <FieldErrorCn Errors="@(new[] { "Due date is required" })" />
                        }
                    </FieldCn>

                    @* Tags *@
                    <FieldCn>
                        <FieldLabelCn For="tags" Class="text-xs">Tags</FieldLabelCn>
                        <InputCn id="tags"
                                 Placeholder="bug, urgent"
                                 Class="h-8 text-sm"
                                 @bind-Value="_tags" />
                    </FieldCn>
                </div>

                @* Notify Assignee *@
                <div class="flex items-center gap-2">
                    <CheckboxCn Checked="@_notifyAssignee" CheckedChanged="@((bool v) => _notifyAssignee = v)" />
                    <span class="text-xs text-muted-foreground">Send notification to assignee</span>
                </div>
            </div>

            <div class="mt-3 flex justify-end gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" type="button" Class="h-7 text-xs" @onclick="CancelForm">
                    Cancel
                </ButtonCn>
                <ButtonCn type="button" Class="h-7 text-xs" @onclick="SubmitForm">
                    Create Task
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _taskName = "";
    private string _assignee = "";
    private string _priority = "";
    private string _dueDate = "";
    private string _tags = "";
    private bool _notifyAssignee = true;
    private bool _submitted = false;

    private void SubmitForm()
    {
        _submitted = true;
        // Presentational only — log/validate as needed
    }

    private void CancelForm()
    {
        _taskName = "";
        _assignee = "";
        _priority = "";
        _dueDate = "";
        _tags = "";
        _notifyAssignee = true;
        _submitted = false;
    }
}
