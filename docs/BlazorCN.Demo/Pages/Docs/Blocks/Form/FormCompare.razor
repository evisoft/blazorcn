@* ============================================================
   Block: form-compare
   Title: FormCompare
   Description: A side-by-side comparison form showing original read-only values alongside editable fields with visual diff indicators for changed values
   Source: original/blocks/form/form-compare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Review Changes</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Compare original and updated values
                    </p>
                </div>
                @if (_changedCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                        @_changedCount @(_changedCount == 1 ? "change" : "changes")
                    </BadgeCn>
                }
            </div>
        </div>

        @* Form with comparison *@
        <div class="p-4">
            <div class="grid gap-6 md:grid-cols-2">
                @* Original column *@
                <div>
                    <div class="mb-4 flex items-center gap-2">
                        <h3 class="text-xs font-medium text-muted-foreground">Original</h3>
                        <div class="h-px flex-1 bg-border"></div>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <span class="text-xs font-medium text-muted-foreground">Title</span>
                            <div class="mt-1.5 rounded-md border bg-muted/30 px-3 py-2">
                                <p class="text-sm">@_originalTitle</p>
                            </div>
                        </div>

                        <div>
                            <span class="text-xs font-medium text-muted-foreground">Description</span>
                            <div class="mt-1.5 rounded-md border bg-muted/30 px-3 py-2">
                                <p class="text-sm">@_originalDescription</p>
                            </div>
                        </div>

                        <div>
                            <span class="text-xs font-medium text-muted-foreground">Status</span>
                            <div class="mt-1.5 rounded-md border bg-muted/30 px-3 py-2">
                                <p class="text-sm">@GetStatusLabel(_originalStatus)</p>
                            </div>
                        </div>

                        <div>
                            <span class="text-xs font-medium text-muted-foreground">Priority</span>
                            <div class="mt-1.5 rounded-md border bg-muted/30 px-3 py-2">
                                <p class="text-sm">@GetPriorityLabel(_originalPriority)</p>
                            </div>
                        </div>
                    </div>
                </div>

                @* Updated column *@
                <div>
                    <div class="mb-4 flex items-center gap-2">
                        <h3 class="text-xs font-medium text-muted-foreground">Updated</h3>
                        <div class="h-px flex-1 bg-border"></div>
                    </div>

                    <div class="space-y-4">
                        @* Title field *@
                        <div>
                            <LabelCn Class="text-xs font-medium">Title</LabelCn>
                            <div class="relative mt-1.5">
                                <InputCn Value="@_title"
                                         @oninput="@((e) => { _title = e.Value?.ToString() ?? ""; })"
                                         Placeholder="Enter title"
                                         Class="@Cn.Merge(_titleChanged ? "border-amber-500/50 bg-amber-500/5" : "")" />
                                @if (_titleChanged)
                                {
                                    <div class="absolute right-2 top-2">
                                        <span class="size-1.5 rounded-full bg-amber-500 block"></span>
                                    </div>
                                }
                            </div>
                            @if (_titleError)
                            {
                                <p class="mt-1 text-xs text-destructive">Title is required</p>
                            }
                        </div>

                        @* Description field *@
                        <div>
                            <LabelCn Class="text-xs font-medium">Description</LabelCn>
                            <div class="relative mt-1.5">
                                <TextareaCn Value="@_description"
                                            @oninput="@((e) => { _description = e.Value?.ToString() ?? ""; })"
                                            Placeholder="Enter description"
                                            Rows="3"
                                            Class="@Cn.Merge("resize-none", _descriptionChanged ? "border-amber-500/50 bg-amber-500/5" : "")" />
                                @if (_descriptionChanged)
                                {
                                    <div class="absolute right-2 top-2">
                                        <span class="size-1.5 rounded-full bg-amber-500 block"></span>
                                    </div>
                                }
                            </div>
                            @if (_descriptionError)
                            {
                                <p class="mt-1 text-xs text-destructive">Description is required</p>
                            }
                        </div>

                        @* Status field *@
                        <div>
                            <LabelCn Class="text-xs font-medium">Status</LabelCn>
                            <div class="relative mt-1.5">
                                <SelectCn Value="@_status" ValueChanged="@((v) => { _status = v; })">
                                    <SelectTriggerCn Class="@Cn.Merge(_statusChanged ? "border-amber-500/50 bg-amber-500/5" : "")">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="in-progress">In Progress</SelectItemCn>
                                        <SelectItemCn Value="completed">Completed</SelectItemCn>
                                        <SelectItemCn Value="blocked">Blocked</SelectItemCn>
                                        <SelectItemCn Value="review">In Review</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                                @if (_statusChanged)
                                {
                                    <div class="absolute right-10 top-3">
                                        <span class="size-1.5 rounded-full bg-amber-500 block"></span>
                                    </div>
                                }
                            </div>
                            @if (_statusError)
                            {
                                <p class="mt-1 text-xs text-destructive">Status is required</p>
                            }
                        </div>

                        @* Priority field *@
                        <div>
                            <LabelCn Class="text-xs font-medium">Priority</LabelCn>
                            <div class="relative mt-1.5">
                                <SelectCn Value="@_priority" ValueChanged="@((v) => { _priority = v; })">
                                    <SelectTriggerCn Class="@Cn.Merge(_priorityChanged ? "border-amber-500/50 bg-amber-500/5" : "")">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="low">Low</SelectItemCn>
                                        <SelectItemCn Value="medium">Medium</SelectItemCn>
                                        <SelectItemCn Value="high">High</SelectItemCn>
                                        <SelectItemCn Value="urgent">Urgent</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                                @if (_priorityChanged)
                                {
                                    <div class="absolute right-10 top-3">
                                        <span class="size-1.5 rounded-full bg-amber-500 block"></span>
                                    </div>
                                }
                            </div>
                            @if (_priorityError)
                            {
                                <p class="mt-1 text-xs text-destructive">Priority is required</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex items-center justify-between border-t pt-4">
                <p class="text-xs text-muted-foreground">
                    @if (_changedCount == 0)
                    {
                        <span>No changes made</span>
                    }
                    else
                    {
                        <span>@_changedCount @(_changedCount == 1 ? "field" : "fields") modified</span>
                    }
                </p>
                <div class="flex gap-2">
                    <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn Type="button" Size="ButtonSize.Sm" Disabled="@(_changedCount == 0)" @onclick="SaveChanges">
                        Save Changes
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    // Original values (read-only reference)
    private const string _originalTitle = "Implement Dark Mode";
    private const string _originalDescription = "Add dark mode support across all components";
    private const string _originalStatus = "in-progress";
    private const string _originalPriority = "medium";

    // Editable field state
    private string _title = "Implement Dark Mode";
    private string _description = "Add dark mode support across all components";
    private string _status = "in-progress";
    private string _priority = "medium";

    // Validation error flags
    private bool _titleError;
    private bool _descriptionError;
    private bool _statusError;
    private bool _priorityError;

    // Change detection computed properties
    private bool _titleChanged => _title != _originalTitle;
    private bool _descriptionChanged => _description != _originalDescription;
    private bool _statusChanged => _status != _originalStatus;
    private bool _priorityChanged => _priority != _originalPriority;

    private int _changedCount =>
        (_titleChanged ? 1 : 0) +
        (_descriptionChanged ? 1 : 0) +
        (_statusChanged ? 1 : 0) +
        (_priorityChanged ? 1 : 0);

    private static string GetStatusLabel(string status) => status switch
    {
        "in-progress" => "In Progress",
        "completed" => "Completed",
        "blocked" => "Blocked",
        "review" => "In Review",
        _ => status
    };

    private static string GetPriorityLabel(string priority) => priority switch
    {
        "low" => "Low",
        "medium" => "Medium",
        "high" => "High",
        "urgent" => "Urgent",
        _ => priority
    };

    private void ResetForm()
    {
        _title = _originalTitle;
        _description = _originalDescription;
        _status = _originalStatus;
        _priority = _originalPriority;
        _titleError = false;
        _descriptionError = false;
        _statusError = false;
        _priorityError = false;
    }

    private void SaveChanges()
    {
        _titleError = string.IsNullOrWhiteSpace(_title);
        _descriptionError = string.IsNullOrWhiteSpace(_description);
        _statusError = string.IsNullOrWhiteSpace(_status);
        _priorityError = string.IsNullOrWhiteSpace(_priority);
    }
}
