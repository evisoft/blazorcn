@* ============================================================
   Block: form-language-select
   Title: FormLanguageSelect
   Description: A language selector displaying native language names with ISO codes for internationalization.
   Source: original/blocks/form/form-language-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <fieldset class="space-y-6 px-4 py-6">
                <div class="space-y-2">
                    <p class="text-base font-semibold leading-none">Language Preferences</p>
                    <p class="text-sm text-muted-foreground">
                        Configure your interface and content language settings
                    </p>
                </div>

                @* Interface Language field *@
                <FieldCn>
                    <FieldLabelCn For="language-select-language">Interface Language</FieldLabelCn>
                    <FieldDescriptionCn>
                        Language used for menus, buttons, and interface elements
                    </FieldDescriptionCn>
                    <SelectCn Value="@_language" ValueChanged="@OnLanguageChanged">
                        <SelectTriggerCn id="language-select-language" Class="w-full" aria-invalid="@(_languageError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select language" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var lang in _languages)
                            {
                                var l = lang;
                                <SelectItemCn Value="@l.Code">
                                    <div class="flex items-center gap-2">
                                        <span>@l.Native</span>
                                        <span class="font-mono text-xs text-muted-foreground">@l.Code.ToUpper()</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_languageError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a language" })" />
                    }
                </FieldCn>

                @* Content Language field *@
                <FieldCn>
                    <FieldLabelCn For="contentLanguage">Content Language</FieldLabelCn>
                    <FieldDescriptionCn>
                        Preferred language for articles, notifications, and content
                    </FieldDescriptionCn>
                    <SelectCn Value="@_contentLanguage" ValueChanged="@OnContentLanguageChanged">
                        <SelectTriggerCn id="contentLanguage" Class="w-full" aria-invalid="@(_contentLanguageError ? "true" : "false")">
                            <SelectValueCn Placeholder="Select content language" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var lang in _languages)
                            {
                                var l = lang;
                                <SelectItemCn Value="@l.Code">
                                    <div class="flex items-center gap-2">
                                        <span>@l.Native</span>
                                        <span class="font-mono text-xs text-muted-foreground">@l.Code.ToUpper()</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_contentLanguageError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a content language" })" />
                    }
                </FieldCn>
            </fieldset>

            <div class="flex justify-end gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn type="submit">Save Preferences</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record LanguageOption(string Native, string Code);

    private static readonly LanguageOption[] _languages =
    [
        new("English",   "en"),
        new("Español",   "es"),
        new("Français",  "fr"),
        new("Deutsch",   "de"),
        new("Italiano",  "it"),
        new("Português", "pt"),
        new("日本語",     "ja"),
        new("한국어",     "ko"),
        new("中文",       "zh"),
        new("العربية",   "ar"),
    ];

    private string _language = "";
    private string _contentLanguage = "";
    private bool _languageError = false;
    private bool _contentLanguageError = false;

    private void OnLanguageChanged(string? value)
    {
        _language = value ?? "";
        _languageError = false;
    }

    private void OnContentLanguageChanged(string? value)
    {
        _contentLanguage = value ?? "";
        _contentLanguageError = false;
    }

    private void ResetForm()
    {
        _language = "";
        _contentLanguage = "";
        _languageError = false;
        _contentLanguageError = false;
    }

    private void HandleSubmit()
    {
        _languageError = string.IsNullOrEmpty(_language);
        _contentLanguageError = string.IsNullOrEmpty(_contentLanguage);
        // If valid, form is "submitted" (presentational only)
    }
}
