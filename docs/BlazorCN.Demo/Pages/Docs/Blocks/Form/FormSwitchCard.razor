@* ============================================================
   Block: form-switch-card
   Title: FormSwitchCard
   Description: A switch form with card-style containers for each toggle
   Source: original/blocks/form/form-switch-card.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Privacy Settings</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Control who can see your information and activity
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldSetCn>
                    <FieldLegendCn Variant="FieldLegendVariant.Label">Visibility Controls</FieldLegendCn>
                    <div class="space-y-3">
                        @foreach (var setting in _privacySettings)
                        {
                            var s = setting;
                            <div class="rounded-md bg-muted/50 p-4">
                                <FieldCn Orientation="FieldOrientation.Horizontal">
                                    <FieldContentCn>
                                        <LabelCn For="@s.Name">@s.Label</LabelCn>
                                        <FieldDescriptionCn>@s.Description</FieldDescriptionCn>
                                    </FieldContentCn>
                                    <SwitchCn id="@s.Name" Checked="@_values[s.Name]" CheckedChanged="@((bool v) => _values[s.Name] = v)" />
                                </FieldCn>
                            </div>
                        }
                    </div>
                </FieldSetCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetToDefaults">
                        Reset to Defaults
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SavePrivacySettings">
                        Save Privacy Settings
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record PrivacySetting(string Name, string Label, string Description);

    private static readonly PrivacySetting[] _privacySettings =
    [
        new("profileVisibility", "Public Profile", "Make your profile visible to other users on the platform"),
        new("activityStatus", "Activity Status", "Show when you're online and active to your connections"),
        new("searchVisibility", "Search Engine Indexing", "Allow search engines to index your public profile"),
        new("dataSharing", "Analytics Data Sharing", "Share anonymized usage data with third-party analytics"),
    ];

    private Dictionary<string, bool> _values = new()
    {
        ["profileVisibility"] = true,
        ["activityStatus"] = true,
        ["searchVisibility"] = false,
        ["dataSharing"] = false,
    };

    private void ResetToDefaults()
    {
        _values["profileVisibility"] = true;
        _values["activityStatus"] = true;
        _values["searchVisibility"] = false;
        _values["dataSharing"] = false;
    }

    private void SavePrivacySettings()
    {
        // Handle form submission (presentational only)
    }
}
