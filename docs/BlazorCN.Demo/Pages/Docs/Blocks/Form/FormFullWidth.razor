@* ============================================================
   Block: form-full-width
   Title: FormFullWidth
   Description: A full-width stacked form with generous spacing and clear visual hierarchy
   Source: original/blocks/form/form-full-width.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-base font-medium">Create New Article</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                Write and publish a new article to your blog. All fields are required unless marked as
                optional.
            </p>
        </div>

        <form class="px-6 py-5" @onsubmit="Submit" @onsubmit:preventDefault="true">
            <div class="space-y-6">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_articleTitleError) ? "true" : null)">
                    <LabelCn For="articleTitle">Article Title</LabelCn>
                    <FieldDescriptionCn>A compelling headline that summarizes your article</FieldDescriptionCn>
                    <InputCn id="articleTitle"
                             Placeholder="10 Essential Tips for Better Web Design"
                             @bind-Value="_articleTitle"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_articleTitleError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_articleTitleError))
                    {
                        <FieldErrorCn Errors="@(new[] { _articleTitleError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_categoryError) ? "true" : null)">
                    <LabelCn For="full-width-category">Category</LabelCn>
                    <FieldDescriptionCn>Choose the primary category for this article</FieldDescriptionCn>
                    <SelectCn @bind-Value="_category" aria-invalid="@(_submitted && !string.IsNullOrEmpty(_categoryError) ? "true" : "false")">
                        <SelectTriggerCn id="full-width-category">
                            <SelectValueCn Placeholder="Select a category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="design">Design</SelectItemCn>
                            <SelectItemCn Value="development">Development</SelectItemCn>
                            <SelectItemCn Value="product">Product</SelectItemCn>
                            <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                            <SelectItemCn Value="business">Business</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    @if (_submitted && !string.IsNullOrEmpty(_categoryError))
                    {
                        <FieldErrorCn Errors="@(new[] { _categoryError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_excerptError) ? "true" : null)">
                    <LabelCn For="excerpt">Excerpt</LabelCn>
                    <FieldDescriptionCn>A brief summary that appears in article previews</FieldDescriptionCn>
                    <TextareaCn id="excerpt"
                                Placeholder="This article explores practical design principles that will help you create better user experiences..."
                                Class="min-h-20 resize-none"
                                @bind-Value="_excerpt"
                                aria-invalid="@(_submitted && !string.IsNullOrEmpty(_excerptError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_excerptError))
                    {
                        <FieldErrorCn Errors="@(new[] { _excerptError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_contentError) ? "true" : null)">
                    <LabelCn For="content">Content</LabelCn>
                    <FieldDescriptionCn>The main body of your article</FieldDescriptionCn>
                    <TextareaCn id="content"
                                Placeholder="Write your article content here..."
                                Class="min-h-48 resize-none"
                                @bind-Value="_content"
                                aria-invalid="@(_submitted && !string.IsNullOrEmpty(_contentError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_contentError))
                    {
                        <FieldErrorCn Errors="@(new[] { _contentError })" />
                    }
                </FieldCn>

                <div class="grid gap-6 sm:grid-cols-2">
                    <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_tagsError) ? "true" : null)">
                        <LabelCn For="full-width-tags">Tags</LabelCn>
                        <FieldDescriptionCn>Comma-separated keywords</FieldDescriptionCn>
                        <InputCn id="full-width-tags"
                                 Placeholder="design, ui, ux"
                                 @bind-Value="_tags"
                                 aria-invalid="@(_submitted && !string.IsNullOrEmpty(_tagsError) ? "true" : "false")" />
                        @if (_submitted && !string.IsNullOrEmpty(_tagsError))
                        {
                            <FieldErrorCn Errors="@(new[] { _tagsError })" />
                        }
                    </FieldCn>

                    <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_authorNameError) ? "true" : null)">
                        <LabelCn For="authorName">Author Name</LabelCn>
                        <FieldDescriptionCn>Article byline</FieldDescriptionCn>
                        <InputCn id="authorName"
                                 Placeholder="Jane Doe"
                                 @bind-Value="_authorName"
                                 aria-invalid="@(_submitted && !string.IsNullOrEmpty(_authorNameError) ? "true" : "false")" />
                        @if (_submitted && !string.IsNullOrEmpty(_authorNameError))
                        {
                            <FieldErrorCn Errors="@(new[] { _authorNameError })" />
                        }
                    </FieldCn>
                </div>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_publishDateError) ? "true" : null)">
                    <LabelCn For="publishDate">Publish Date</LabelCn>
                    <FieldDescriptionCn>Schedule when this article goes live</FieldDescriptionCn>
                    <InputCn id="publishDate"
                             type="date"
                             @bind-Value="_publishDate"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_publishDateError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_publishDateError))
                    {
                        <FieldErrorCn Errors="@(new[] { _publishDateError })" />
                    }
                </FieldCn>
            </div>

            <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <ButtonCn type="button" Variant="ButtonVariant.Outline" Class="sm:w-auto" @onclick="SaveDraft">
                    Save Draft
                </ButtonCn>
                <ButtonCn type="submit" Class="sm:w-auto">
                    Publish Article
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _articleTitle = "";
    private string _category = "";
    private string _excerpt = "";
    private string _content = "";
    private string _tags = "";
    private string _authorName = "";
    private string _publishDate = "";
    private bool _submitted = false;

    private string _articleTitleError = "";
    private string _categoryError = "";
    private string _excerptError = "";
    private string _contentError = "";
    private string _tagsError = "";
    private string _authorNameError = "";
    private string _publishDateError = "";

    private void Validate()
    {
        _articleTitleError = "";
        _categoryError = "";
        _excerptError = "";
        _contentError = "";
        _tagsError = "";
        _authorNameError = "";
        _publishDateError = "";

        if (_articleTitle.Length < 10)
            _articleTitleError = "Title must be at least 10 characters";
        else if (_articleTitle.Length > 100)
            _articleTitleError = "Title must not exceed 100 characters";

        if (string.IsNullOrEmpty(_category))
            _categoryError = "Please select a category";

        if (_excerpt.Length < 20)
            _excerptError = "Excerpt must be at least 20 characters";
        else if (_excerpt.Length > 200)
            _excerptError = "Excerpt must not exceed 200 characters";

        if (_content.Length < 100)
            _contentError = "Content must be at least 100 characters";

        if (string.IsNullOrEmpty(_tags))
            _tagsError = "Please add at least one tag";

        if (_authorName.Length < 2)
            _authorNameError = "Author name is required";

        if (string.IsNullOrEmpty(_publishDate))
            _publishDateError = "Publish date is required";
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
        // If no errors, form is "submitted" (presentational only)
    }

    private void SaveDraft()
    {
        // Save draft action (presentational only)
    }
}
