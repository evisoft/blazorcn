@* ============================================================
   Block: form-fieldset-groups
   Title: FormFieldsetGroups
   Description: A form organized with multiple FieldSet components for semantic grouping of related fields
   Source: original/blocks/form/form-fieldset-groups.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Account Setup</h2>
            <p class="mt-1 text-xs text-muted-foreground">Complete your profile information</p>
        </div>

        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-6">

                @* Personal Information fieldset *@
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Personal Information</legend>
                    <div class="mt-3 space-y-4">
                        <div @attributes="_firstNameInvalid ? _invalidAttr : null">
                            <LabelCn For="firstName" Class="mb-1.5 block">First Name</LabelCn>
                            <InputCn id="firstName" Placeholder="John" @bind-Value="_firstName" aria-invalid="@(_firstNameInvalid ? "true" : "false")" />
                            @if (_firstNameInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">First name must be at least 2 characters</p>
                            }
                        </div>

                        <div @attributes="_lastNameInvalid ? _invalidAttr : null">
                            <LabelCn For="lastName" Class="mb-1.5 block">Last Name</LabelCn>
                            <InputCn id="lastName" Placeholder="Doe" @bind-Value="_lastName" aria-invalid="@(_lastNameInvalid ? "true" : "false")" />
                            @if (_lastNameInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Last name must be at least 2 characters</p>
                            }
                        </div>
                    </div>
                </fieldset>

                @* Contact Details fieldset *@
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Contact Details</legend>
                    <div class="mt-3 space-y-4">
                        <div @attributes="_emailInvalid ? _invalidAttr : null">
                            <LabelCn For="email" Class="mb-1.5 block">Email</LabelCn>
                            <InputCn id="email" type="email" Placeholder="@("john.doe@example.com")" @bind-Value="_email" aria-invalid="@(_emailInvalid ? "true" : "false")" />
                            @if (_emailInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Invalid email address</p>
                            }
                        </div>

                        <div @attributes="_phoneInvalid ? _invalidAttr : null">
                            <LabelCn For="phone" Class="mb-1.5 block">Phone Number</LabelCn>
                            <InputCn id="phone" type="tel" Placeholder="+1 (555) 000-0000" @bind-Value="_phone" aria-invalid="@(_phoneInvalid ? "true" : "false")" />
                            @if (_phoneInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Phone number must be at least 10 digits</p>
                            }
                        </div>
                    </div>
                </fieldset>

                @* Address fieldset *@
                <fieldset>
                    <legend class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Address</legend>
                    <div class="mt-3 space-y-4">
                        <div @attributes="_addressInvalid ? _invalidAttr : null">
                            <LabelCn For="address" Class="mb-1.5 block">Street Address</LabelCn>
                            <InputCn id="address" Placeholder="123 Main St" @bind-Value="_address" aria-invalid="@(_addressInvalid ? "true" : "false")" />
                            @if (_addressInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">Address is required</p>
                            }
                        </div>

                        <div @attributes="_cityInvalid ? _invalidAttr : null">
                            <LabelCn For="city" Class="mb-1.5 block">City</LabelCn>
                            <InputCn id="city" Placeholder="San Francisco" @bind-Value="_city" aria-invalid="@(_cityInvalid ? "true" : "false")" />
                            @if (_cityInvalid)
                            {
                                <p class="mt-1 text-xs text-destructive">City is required</p>
                            }
                        </div>
                    </div>
                </fieldset>

            </div>

            <div class="mt-6 flex justify-end gap-3">
                <ButtonCn Type="button" Variant="ButtonVariant.Outline" @onclick="HandleCancel">
                    Cancel
                </ButtonCn>
                <ButtonCn Type="submit">Save Changes</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _phone = "";
    private string _address = "";
    private string _city = "";
    private bool _submitted = false;

    private bool _firstNameInvalid => _submitted && _firstName.Trim().Length < 2;
    private bool _lastNameInvalid  => _submitted && _lastName.Trim().Length < 2;
    private bool _emailInvalid     => _submitted && !IsValidEmail(_email);
    private bool _phoneInvalid     => _submitted && _phone.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace("+", "").Length < 10;
    private bool _addressInvalid   => _submitted && _address.Trim().Length < 5;
    private bool _cityInvalid      => _submitted && _city.Trim().Length < 2;

    private static readonly Dictionary<string, object> _invalidAttr = new() { ["data-invalid"] = "true" };

    private void HandleSubmit()
    {
        _submitted = true;
    }

    private void HandleCancel()
    {
        _firstName = "";
        _lastName  = "";
        _email     = "";
        _phone     = "";
        _address   = "";
        _city      = "";
        _submitted = false;
    }

    private static bool IsValidEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var at = value.IndexOf('@');
        if (at <= 0 || at == value.Length - 1) return false;
        var dot = value.LastIndexOf('.');
        return dot > at + 1 && dot < value.Length - 1;
    }
}
