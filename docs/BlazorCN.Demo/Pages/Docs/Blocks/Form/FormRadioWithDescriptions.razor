@* ============================================================
   Block: form-radio-with-descriptions
   Title: FormRadioWithDescriptions
   Description: A radio group where each option includes a title and detailed description text for better context
   Source: original/blocks/form/form-radio-with-descriptions.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Choose Your Plan</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Select the plan that best fits your needs
            </p>
        </div>
        <form class="p-4">
            <FieldSetCn>
                <FieldLegendCn>Plan options</FieldLegendCn>
                <RadioGroupCn Value="@_selectedPlan" ValueChanged="@((string? v) => _selectedPlan = v ?? "")">
                    @foreach (var it in _plans)
                    {
                        var plan = it;
                        <div class="cursor-pointer">
                            <FieldCn Orientation="FieldOrientation.Horizontal">
                                <FieldContentCn>
                                    <FieldTitleCn>@plan.Title</FieldTitleCn>
                                    <FieldDescriptionCn>@plan.Description</FieldDescriptionCn>
                                </FieldContentCn>
                                <RadioGroupItemCn Value="@plan.Id" />
                            </FieldCn>
                        </div>
                    }
                </RadioGroupCn>
                @if (_submitted && string.IsNullOrEmpty(_selectedPlan))
                {
                    <FieldErrorCn Errors="@(new[] { "Please select a plan" })" />
                }
            </FieldSetCn>
            <div class="mt-6 flex justify-end">
                <ButtonCn type="button" @onclick="HandleSubmit">Continue</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private static readonly PlanItem[] _plans =
    [
        new PlanItem("starter", "Starter",
            "Perfect for individuals and small projects. Includes basic features and 5GB storage."),
        new PlanItem("professional", "Professional",
            "Ideal for growing teams. Advanced features, 50GB storage, priority support, and collaboration tools."),
        new PlanItem("enterprise", "Enterprise",
            "Built for large organizations. Unlimited storage, dedicated support, custom integrations, and SLA guarantees."),
        new PlanItem("custom", "Custom",
            "Tailored solution for unique requirements. Contact our sales team to discuss your specific needs."),
    ];

    private string _selectedPlan = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        _submitted = true;
        // presentational only — would process form data here
    }

    private record PlanItem(string Id, string Title, string Description);
}
