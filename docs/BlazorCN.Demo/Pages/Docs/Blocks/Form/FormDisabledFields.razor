@* ============================================================
   Block: form-disabled-fields
   Title: FormDisabledFields
   Description: A form demonstrating disabled field states across different input types including Input, Select, Textarea, Checkbox, and Switch.
   Source: original/blocks/form/form-disabled-fields.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Account Settings</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Some fields are disabled and cannot be edited
            </p>
        </div>

        <form class="p-4">
            <div class="space-y-4">
                @* userId — disabled *@
                <FieldCn data-disabled="true">
                    <FieldLabelCn For="userId">User ID</FieldLabelCn>
                    <InputCn id="userId" Value="@_userId" Disabled="@true" />
                    <FieldDescriptionCn>Your unique user identifier (cannot be changed)</FieldDescriptionCn>
                </FieldCn>

                @* username — editable *@
                <FieldCn>
                    <FieldLabelCn For="username">Username</FieldLabelCn>
                    <InputCn id="username" @bind-Value="_username" Placeholder="Enter username" />
                    <FieldDescriptionCn>You can change your username</FieldDescriptionCn>
                </FieldCn>

                @* email — disabled *@
                <FieldCn data-disabled="true">
                    <FieldLabelCn For="email">Email Address</FieldLabelCn>
                    <InputCn id="email" type="email" Value="@_email" Disabled="@true" />
                    <FieldDescriptionCn>Contact support to change your email</FieldDescriptionCn>
                </FieldCn>

                @* accountType — disabled select *@
                <FieldCn data-disabled="true">
                    <FieldLabelCn For="accountType">Account Type</FieldLabelCn>
                    <SelectCn Value="@_accountType" Disabled="@true">
                        <SelectTriggerCn id="accountType">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="free">Free</SelectItemCn>
                            <SelectItemCn Value="premium">Premium</SelectItemCn>
                            <SelectItemCn Value="enterprise">Enterprise</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>Upgrade or downgrade in billing settings</FieldDescriptionCn>
                </FieldCn>

                @* status — editable select *@
                <FieldCn>
                    <FieldLabelCn For="status">Status</FieldLabelCn>
                    <SelectCn Value="@_status" ValueChanged="@((string? v) => _status = v ?? "")">
                        <SelectTriggerCn id="status">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="active">Active</SelectItemCn>
                            <SelectItemCn Value="away">Away</SelectItemCn>
                            <SelectItemCn Value="busy">Busy</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>Your current availability status</FieldDescriptionCn>
                </FieldCn>

                @* bio — disabled textarea *@
                <FieldCn data-disabled="true">
                    <FieldLabelCn For="bio">Bio</FieldLabelCn>
                    <TextareaCn id="bio" Value="@_bio" Disabled="@true" Rows="3" />
                    <FieldDescriptionCn>Bio is managed by your organization admin</FieldDescriptionCn>
                </FieldCn>

                <div class="space-y-3">
                    @* emailNotifications — disabled switch *@
                    <div class="flex items-center gap-3">
                        <SwitchCn Checked="@_emailNotifications" Disabled="@true" />
                        <div class="flex-1">
                            <p class="text-sm font-medium text-muted-foreground">Email Notifications (Disabled)</p>
                            <p class="text-xs text-muted-foreground">Managed by your administrator</p>
                        </div>
                    </div>

                    @* marketingEmails — editable switch *@
                    <div class="flex items-center gap-3">
                        <SwitchCn Checked="@_marketingEmails" CheckedChanged="@((bool v) => _marketingEmails = v)" />
                        <div class="flex-1">
                            <p class="text-sm font-medium">Marketing Emails</p>
                            <p class="text-xs text-muted-foreground">Receive updates about new features</p>
                        </div>
                    </div>

                    @* terms — disabled checkbox *@
                    <div class="flex items-start gap-3">
                        <CheckboxCn Checked="@_terms" Disabled="@true" Class="mt-0.5" />
                        <div class="flex-1">
                            <p class="text-sm font-medium text-muted-foreground">Terms and Conditions (Disabled)</p>
                            <p class="text-xs text-muted-foreground">You agreed to terms on account creation</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex gap-3">
                <ButtonCn type="submit" Class="flex-1" @onclick="SaveChanges">
                    Save Changes
                </ButtonCn>
                <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="ResetForm">
                    Reset
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _userId = "USR-12345";
    private string _username = "johndoe";
    private string _email = "john@example.com";
    private string _accountType = "premium";
    private string _status = "active";
    private string _bio = "This is a pre-filled bio that cannot be edited.";
    private bool _emailNotifications = true;
    private bool _marketingEmails = false;
    private bool _terms = true;

    private void SaveChanges()
    {
        // Presentational only — would submit form data
    }

    private void ResetForm()
    {
        _username = "johndoe";
        _status = "active";
        _marketingEmails = false;
    }
}
