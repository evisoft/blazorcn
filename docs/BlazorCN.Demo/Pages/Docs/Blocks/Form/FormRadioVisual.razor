@* ============================================================
   Block: form-radio-visual
   Title: FormRadioVisual
   Description: A radio group where each option is displayed as a visual card with an icon, title, and description
   Source: original/blocks/form/form-radio-visual.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Create New Project</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose the type of project you want to create
            </p>
        </div>
        <form class="p-4">
            <FieldSetCn>
                <FieldLegendCn>Project type</FieldLegendCn>
                <RadioGroupCn Value="@_projectType" ValueChanged="@((string? v) => _projectType = v ?? "")">
                    <div class="grid grid-cols-2 gap-3">
                        @foreach (var pt in _projectTypes)
                        {
                            var type = pt;
                            <div class="cursor-pointer">
                                <div class="@Cn.Merge("rounded-lg border p-3 transition-colors hover:bg-muted/50", _projectType == type.Id ? "border-primary bg-muted/50" : "")">
                                    <FieldCn Orientation="FieldOrientation.Horizontal">
                                        <FieldContentCn>
                                            <div class="mb-2 flex items-center gap-2">
                                                <LucideIconCn Name="@type.IconName" Size="16" Class="size-4 text-muted-foreground" />
                                                <FieldTitleCn>@type.Title</FieldTitleCn>
                                            </div>
                                            <FieldDescriptionCn>@type.Description</FieldDescriptionCn>
                                        </FieldContentCn>
                                        <RadioGroupItemCn aria-label="@type.Title" Value="@type.Id" />
                                    </FieldCn>
                                </div>
                            </div>
                        }
                    </div>
                </RadioGroupCn>
                @if (_submitted && string.IsNullOrEmpty(_projectType))
                {
                    <FieldErrorCn Errors="@(new[] { "Please select a project type" })" />
                }
            </FieldSetCn>
            <div class="mt-6 flex justify-end">
                <ButtonCn type="button" @onclick="Submit">Create Project</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private static readonly ProjectTypeItem[] _projectTypes =
    [
        new ProjectTypeItem("web-app", "globe", "Web Application", "Full-stack web app with frontend and backend"),
        new ProjectTypeItem("api", "server", "REST API", "Backend API service with database integration"),
        new ProjectTypeItem("static", "code-2", "Static Site", "Static website with SSG or pre-rendered content"),
        new ProjectTypeItem("microservice", "database", "Microservice", "Containerized service for distributed architecture"),
    ];

    private string _projectType = "";
    private bool _submitted = false;

    private void Submit()
    {
        _submitted = true;
        // Presentational: if valid, form is "submitted"
    }

    private record ProjectTypeItem(string Id, string IconName, string Title, string Description);
}
