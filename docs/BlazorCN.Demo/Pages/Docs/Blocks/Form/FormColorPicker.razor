@* ============================================================
   Block: form-color-picker
   Title: FormColorPicker
   Description: A color picker form with hex value input and visual swatch
   Source: original/blocks/form/form-color-picker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Brand Color</h2>
            <p class="mt-1 text-muted-foreground text-xs">Choose your primary brand color</p>
        </div>
        <div class="px-4 py-4">
            <div class="space-y-4">
                <div>
                    <LabelCn Class="mb-1.5 block" For="color">Primary Color</LabelCn>
                    <div class="flex items-center gap-3">
                        <input type="color"
                               value="@_color"
                               @oninput="@((ChangeEventArgs e) => OnColorPickerChange(e.Value?.ToString() ?? _color))"
                               class="size-10 cursor-pointer rounded border bg-transparent"
                               aria-label="Color picker" />
                        <div class="flex flex-1 items-center gap-2">
                            <div class="size-6 shrink-0 rounded border"
                                 style="@($"background-color:{_color}")"
                                 aria-hidden="true">
                            </div>
                            <InputCn id="color"
                                     @bind-Value="_color"
                                     Placeholder="#3b82f6"
                                     Class="font-mono text-sm uppercase"
                                     aria-invalid="@(_colorError != "" ? "true" : "false")" />
                        </div>
                    </div>
                    <p class="mt-1.5 text-xs text-muted-foreground">Enter a hex color code or use the color picker</p>
                    @if (_colorError != "")
                    {
                        <p class="mt-1 text-xs text-destructive">@_colorError</p>
                    }
                </div>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn Type="button" @onclick="SaveColor">Save Color</ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _color = "#3b82f6";
    private string _colorError = "";

    private void OnColorPickerChange(string value)
    {
        _color = value;
        ValidateColor();
    }

    private void ValidateColor()
    {
        if (string.IsNullOrEmpty(_color) || !System.Text.RegularExpressions.Regex.IsMatch(_color, @"^#[0-9a-fA-F]{6}$"))
            _colorError = "Invalid hex color format";
        else
            _colorError = "";
    }

    private void ResetForm()
    {
        _color = "#3b82f6";
        _colorError = "";
    }

    private void SaveColor()
    {
        ValidateColor();
        if (_colorError == "")
        {
            // Save color preference
        }
    }
}
