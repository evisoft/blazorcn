@* ============================================================
   Block: form-switch-danger
   Title: FormSwitchDanger
   Description: A form with dangerous toggle switches requiring careful consideration before enabling
   Source: original/blocks/form/form-switch-danger.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-destructive" />
                <h2 class="font-medium text-sm">Danger Zone</h2>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Irreversible and potentially destructive actions
            </p>
        </div>

        <form>
            <div class="divide-y">
                @foreach (var item in _dangerousSettings)
                {
                    var setting = item;
                    <div class="px-4 py-3">
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <FieldContentCn>
                                <LabelCn For="@setting.Name" Class="text-destructive">@setting.Label</LabelCn>
                                <FieldDescriptionCn>@setting.Description</FieldDescriptionCn>
                                @if (_values[setting.Name])
                                {
                                    <div class="mt-2 flex items-start gap-2 rounded-md bg-destructive/10 p-2">
                                        <LucideIconCn Name="alert-triangle" Size="12" Class="mt-0.5 size-3 shrink-0 text-destructive" />
                                        <span class="text-destructive text-xs">@setting.Warning</span>
                                    </div>
                                }
                            </FieldContentCn>
                            <SwitchCn id="@setting.Name" Checked="@_values[setting.Name]" CheckedChanged="@((bool v) => SetValue(setting.Name, v))" />
                        </FieldCn>
                    </div>
                }
            </div>

            <div class="flex items-center justify-between border-t px-4 py-3">
                <p class="text-muted-foreground text-xs">These actions require confirmation</p>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button" @onclick="Cancel">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" type="button"
                              disabled="@(!_values.Values.Any(v => v))" @onclick="ConfirmChanges">
                        Confirm Changes
                    </ButtonCn>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private record DangerSetting(string Name, string Label, string Description, string Warning);

    private static readonly DangerSetting[] _dangerousSettings =
    [
        new("deleteAccount", "Delete Account",
            "Permanently delete your account and all associated data. This action cannot be undone.",
            "This will permanently delete all your data"),
        new("disableBackups", "Disable Automatic Backups",
            "Stop creating automatic backups of your data. You may lose data if something goes wrong.",
            "You may lose data without backups"),
        new("allowPublicAccess", "Allow Public Access",
            "Make your private content publicly accessible. Anyone with the link can view your data.",
            "Your private content will become public"),
        new("disableTwoFactor", "Disable Two-Factor Authentication",
            "Turn off two-factor authentication. Your account will be less secure.",
            "This reduces your account security"),
    ];

    private Dictionary<string, bool> _values = new()
    {
        ["deleteAccount"] = false,
        ["disableBackups"] = false,
        ["allowPublicAccess"] = false,
        ["disableTwoFactor"] = false,
    };

    private void SetValue(string name, bool value)
    {
        _values[name] = value;
    }

    private void Cancel()
    {
        _values = new()
        {
            ["deleteAccount"] = false,
            ["disableBackups"] = false,
            ["allowPublicAccess"] = false,
            ["disableTwoFactor"] = false,
        };
    }

    private void ConfirmChanges()
    {
        // Handle form submission (presentational only)
    }
}
