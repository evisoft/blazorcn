@* ============================================================
   Block: form-branching
   Title: FormBranching
   Description: A decision-tree form that shows different fields based on user selections
   Source: original/blocks/form/form-branching.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Account Registration</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose your account type and complete the required information
            </p>
        </div>

        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-6 px-4 py-6">

                @* Account Type Field *@
                <div>
                    <LabelCn>Account Type</LabelCn>
                    <div class="mt-1.5">
                        <SelectCn Value="@_accountType" ValueChanged="@((string v) => _accountType = v)">
                            <SelectTriggerCn>
                                <SelectValueCn Placeholder="Select account type" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="individual">Individual Account</SelectItemCn>
                                <SelectItemCn Value="business">Business Account</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        <p class="mt-1 text-muted-foreground text-xs">
                            @(_accountType == "individual"
                                ? "For personal use and individual projects"
                                : "For companies and organizations")
                        </p>
                    </div>
                </div>

                @* Individual Branch *@
                @if (_accountType == "individual")
                {
                    <div class="rounded-md border-l-2 border-foreground/20 bg-muted/50 px-4 py-3">
                        <h3 class="font-medium text-sm">Personal Information</h3>
                        <p class="mt-1 text-muted-foreground text-xs">Provide your contact details</p>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <LabelCn>First Name</LabelCn>
                            <div class="mt-1.5">
                                <InputCn @bind-Value="_firstName" Placeholder="John" />
                                @if (_submitted && string.IsNullOrWhiteSpace(_firstName))
                                {
                                    <p class="mt-1 text-xs text-destructive">First name is required</p>
                                }
                            </div>
                        </div>

                        <div>
                            <LabelCn>Last Name</LabelCn>
                            <div class="mt-1.5">
                                <InputCn @bind-Value="_lastName" Placeholder="Doe" />
                                @if (_submitted && string.IsNullOrWhiteSpace(_lastName))
                                {
                                    <p class="mt-1 text-xs text-destructive">Last name is required</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div>
                        <LabelCn>Email Address</LabelCn>
                        <div class="mt-1.5">
                            <InputCn @bind-Value="_email" Type="email" Placeholder="@("john.doe@example.com")" />
                            @if (_submitted && string.IsNullOrWhiteSpace(_email))
                            {
                                <p class="mt-1 text-xs text-destructive">Invalid email address</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn>Phone Number</LabelCn>
                        <div class="mt-1.5">
                            <InputCn @bind-Value="_phone" Type="tel" Placeholder="+1 (555) 123-4567" />
                            <p class="mt-1 text-muted-foreground text-xs">
                                Include country code for international numbers
                            </p>
                            @if (_submitted && string.IsNullOrWhiteSpace(_phone))
                            {
                                <p class="mt-1 text-xs text-destructive">Phone number must be at least 10 digits</p>
                            }
                        </div>
                    </div>
                }

                @* Business Branch *@
                @if (_accountType == "business")
                {
                    <div class="rounded-md border-l-2 border-foreground/20 bg-muted/50 px-4 py-3">
                        <h3 class="font-medium text-sm">Business Information</h3>
                        <p class="mt-1 text-muted-foreground text-xs">Provide your company details</p>
                    </div>

                    <div>
                        <LabelCn>Company Name</LabelCn>
                        <div class="mt-1.5">
                            <InputCn @bind-Value="_companyName" Placeholder="Acme Corporation" />
                            @if (_submitted && string.IsNullOrWhiteSpace(_companyName))
                            {
                                <p class="mt-1 text-xs text-destructive">Company name is required</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn>Tax ID / EIN</LabelCn>
                        <div class="mt-1.5">
                            <InputCn @bind-Value="_taxId" Placeholder="12-3456789" />
                            <p class="mt-1 text-muted-foreground text-xs">
                                Your company's federal tax identification number
                            </p>
                            @if (_submitted && string.IsNullOrWhiteSpace(_taxId))
                            {
                                <p class="mt-1 text-xs text-destructive">Tax ID must be at least 9 characters</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn>Department</LabelCn>
                        <div class="mt-1.5">
                            <SelectCn Value="@_department" ValueChanged="@((string v) => _department = v)">
                                <SelectTriggerCn>
                                    <SelectValueCn Placeholder="Select department" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="engineering">Engineering</SelectItemCn>
                                    <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                                    <SelectItemCn Value="sales">Sales</SelectItemCn>
                                    <SelectItemCn Value="operations">Operations</SelectItemCn>
                                    <SelectItemCn Value="finance">Finance</SelectItemCn>
                                    <SelectItemCn Value="other">Other</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            @if (_submitted && string.IsNullOrWhiteSpace(_department))
                            {
                                <p class="mt-1 text-xs text-destructive">Please select a department</p>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn>Contact Email</LabelCn>
                        <div class="mt-1.5">
                            <InputCn @bind-Value="_contactEmail" Type="email" Placeholder="@("contact@acme.com")" />
                            <p class="mt-1 text-muted-foreground text-xs">
                                Primary email for business communications
                            </p>
                            @if (_submitted && string.IsNullOrWhiteSpace(_contactEmail))
                            {
                                <p class="mt-1 text-xs text-destructive">Invalid email address</p>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="flex items-center justify-end border-t px-4 py-3">
                <ButtonCn>Create Account</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _accountType = "individual";
    private bool _submitted;

    // Individual fields
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _phone = "";

    // Business fields
    private string _companyName = "";
    private string _taxId = "";
    private string _department = "";
    private string _contactEmail = "";

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
