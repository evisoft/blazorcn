@* ============================================================
   Block: form-inline-edit
   Title: FormInlineEdit
   Description: An inline edit form where text becomes editable on click with smooth transitions between display and edit modes
   Source: original/blocks/form/form-inline-edit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Profile Settings</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Click edit to modify your information
            </p>
        </div>

        <div class="divide-y">
            @* Name Field *@
            <div class="px-4 py-3">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <label class="text-xs font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Full Name</label>
                        <div>
                            @if (_editingField == "name")
                            {
                                <InputCn aria-label="Full Name" @bind-Value="_editName" Placeholder="Your name" Class="mt-1 h-8" />
                                @if (!string.IsNullOrEmpty(_nameError))
                                {
                                    <p class="mt-1 text-xs text-destructive">@_nameError</p>
                                }
                            }
                            else
                            {
                                <p class="mt-1 text-sm">@_savedName</p>
                            }
                        </div>
                    </div>
                    <div class="flex gap-1">
                        @if (_editingField == "name")
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Save name" @onclick="@(() => HandleSave("name"))">
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-green-600" />
                            </ButtonCn>
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Cancel editing" @onclick="HandleCancel">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Edit name" @onclick="@(() => HandleEdit("name"))">
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Email Field *@
            <div class="px-4 py-3">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <label class="text-xs font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Email Address</label>
                        <div>
                            @if (_editingField == "email")
                            {
                                <InputCn aria-label="Email Address" @bind-Value="_editEmail" Placeholder="@("your.email@example.com")" Class="mt-1 h-8" />
                                @if (!string.IsNullOrEmpty(_emailError))
                                {
                                    <p class="mt-1 text-xs text-destructive">@_emailError</p>
                                }
                            }
                            else
                            {
                                <p class="mt-1 text-sm">@_savedEmail</p>
                            }
                        </div>
                    </div>
                    <div class="flex gap-1">
                        @if (_editingField == "email")
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Save email" @onclick="@(() => HandleSave("email"))">
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-green-600" />
                            </ButtonCn>
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Cancel editing" @onclick="HandleCancel">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Edit email" @onclick="@(() => HandleEdit("email"))">
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Title Field *@
            <div class="px-4 py-3">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <label class="text-xs font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Job Title</label>
                        <div>
                            @if (_editingField == "title")
                            {
                                <InputCn aria-label="Job Title" @bind-Value="_editTitle" Placeholder="Your job title" Class="mt-1 h-8" />
                                @if (!string.IsNullOrEmpty(_titleError))
                                {
                                    <p class="mt-1 text-xs text-destructive">@_titleError</p>
                                }
                            }
                            else
                            {
                                <p class="mt-1 text-sm">@_savedTitle</p>
                            }
                        </div>
                    </div>
                    <div class="flex gap-1">
                        @if (_editingField == "title")
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Save title" @onclick="@(() => HandleSave("title"))">
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-green-600" />
                            </ButtonCn>
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Cancel editing" @onclick="HandleCancel">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Edit title" @onclick="@(() => HandleEdit("title"))">
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Bio Field *@
            <div class="px-4 py-3">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <label class="text-xs font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Bio</label>
                        <div>
                            @if (_editingField == "bio")
                            {
                                <TextareaCn aria-label="Bio" @bind-Value="_editBio" Placeholder="Tell us about yourself" Class="mt-1 min-h-[80px] resize-none" />
                                @if (!string.IsNullOrEmpty(_bioError))
                                {
                                    <p class="mt-1 text-xs text-destructive">@_bioError</p>
                                }
                            }
                            else
                            {
                                <p class="mt-1 text-sm">@_savedBio</p>
                            }
                        </div>
                    </div>
                    <div class="flex gap-1">
                        @if (_editingField == "bio")
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Save bio" @onclick="@(() => HandleSave("bio"))">
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-green-600" />
                            </ButtonCn>
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Cancel editing" @onclick="HandleCancel">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Edit bio" @onclick="@(() => HandleEdit("bio"))">
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _editingField;

    // Saved values
    private string _savedName  = "Sarah Chen";
    private string _savedEmail = "sarah.chen@example.com";
    private string _savedTitle = "Senior Product Designer";
    private string _savedBio   = "Passionate about creating delightful user experiences. 8+ years in product design.";

    // Edit buffers
    private string _editName  = "";
    private string _editEmail = "";
    private string _editTitle = "";
    private string _editBio   = "";

    // Validation errors
    private string _nameError  = "";
    private string _emailError = "";
    private string _titleError = "";
    private string _bioError   = "";

    private void HandleEdit(string field)
    {
        _editingField = field;
        _editName  = _savedName;
        _editEmail = _savedEmail;
        _editTitle = _savedTitle;
        _editBio   = _savedBio;
        _nameError  = "";
        _emailError = "";
        _titleError = "";
        _bioError   = "";
    }

    private void HandleCancel()
    {
        _editingField = null;
        _nameError  = "";
        _emailError = "";
        _titleError = "";
        _bioError   = "";
    }

    private void HandleSave(string field)
    {
        if (field == "name")
        {
            if (_editName.Length < 2)
            {
                _nameError = "Name must be at least 2 characters";
                return;
            }
            _savedName = _editName;
        }
        else if (field == "email")
        {
            if (!_editEmail.Contains('@') || !_editEmail.Contains('.'))
            {
                _emailError = "Invalid email address";
                return;
            }
            _savedEmail = _editEmail;
        }
        else if (field == "title")
        {
            if (_editTitle.Length < 1)
            {
                _titleError = "Title is required";
                return;
            }
            _savedTitle = _editTitle;
        }
        else if (field == "bio")
        {
            if (_editBio.Length > 200)
            {
                _bioError = "Bio must be 200 characters or less";
                return;
            }
            _savedBio = _editBio;
        }
        _editingField = null;
    }
}
