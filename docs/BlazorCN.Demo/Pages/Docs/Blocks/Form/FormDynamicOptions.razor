@* ============================================================
   Block: form-dynamic-options
   Title: FormDynamicOptions
   Description: A form demonstrating dynamically loaded options with loading states using useEffect and useState
   Source: original/blocks/form/form-dynamic-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Product Listing</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Create a new product listing</p>
        </div>

        <form class="p-4">
            <fieldset>
                <div class="space-y-4">

                    @* Name field *@
                    <FieldCn>
                        <FieldLabelCn For="dynamic-options-name">Product Name</FieldLabelCn>
                        <InputCn id="dynamic-options-name" @bind-Value="_name" Placeholder="Enter product name" />
                        @if (_nameError)
                        {
                            <FieldErrorCn Errors="@(new[] { "Name is required" })" />
                        }
                    </FieldCn>

                    @* Category field *@
                    <FieldCn>
                        <FieldLabelCn For="dynamic-options-category">Category</FieldLabelCn>
                        <SelectCn Value="@_category" ValueChanged="@OnCategoryChanged">
                            <SelectTriggerCn id="dynamic-options-category">
                                <SelectValueCn Placeholder="Select a category" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="electronics">Electronics</SelectItemCn>
                                <SelectItemCn Value="clothing">Clothing</SelectItemCn>
                                <SelectItemCn Value="books">Books</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        <FieldDescriptionCn>Choose the main product category</FieldDescriptionCn>
                        @if (_categoryError)
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select a category" })" />
                        }
                    </FieldCn>

                    @* Subcategory field *@
                    <FieldCn>
                        <FieldLabelCn For="dynamic-options-subcategory">Subcategory</FieldLabelCn>
                        @if (_isLoadingOptions)
                        {
                            <div class="space-y-2">
                                <SkeletonCn Class="h-9 w-full" />
                                <p class="text-muted-foreground text-xs">Loading subcategories...</p>
                            </div>
                        }
                        else
                        {
                            <SelectCn Value="@_subcategory" ValueChanged="@OnSubcategoryChanged" Disabled="@(string.IsNullOrEmpty(_category) || _isLoadingOptions)">
                                <SelectTriggerCn id="dynamic-options-subcategory">
                                    <SelectValueCn Placeholder="@(string.IsNullOrEmpty(_category) ? "Select category first" : "Select a subcategory")" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var opt in _subcategoryOptions)
                                    {
                                        var option = opt;
                                        <SelectItemCn Value="@option.Value">@option.Label</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                            <FieldDescriptionCn>
                                @(string.IsNullOrEmpty(_category) ? "This field will be enabled after selecting a category" : "Options loaded based on selected category")
                            </FieldDescriptionCn>
                        }
                        @if (_subcategoryError)
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select a subcategory" })" />
                        }
                    </FieldCn>

                </div>

                <div class="mt-6 flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="OnSubmit">
                        Create Listing
                    </ButtonCn>
                </div>
            </fieldset>
        </form>
    </div>
</section>

@code {
    private record SubcategoryOption(string Value, string Label);

    private static readonly SubcategoryOption[] _electronicsOptions =
    [
        new("phones", "Phones"),
        new("laptops", "Laptops"),
        new("tablets", "Tablets"),
        new("accessories", "Accessories"),
    ];

    private static readonly SubcategoryOption[] _clothingOptions =
    [
        new("shirts", "Shirts"),
        new("pants", "Pants"),
        new("shoes", "Shoes"),
        new("outerwear", "Outerwear"),
    ];

    private static readonly SubcategoryOption[] _booksOptions =
    [
        new("fiction", "Fiction"),
        new("nonfiction", "Non-Fiction"),
        new("textbooks", "Textbooks"),
        new("magazines", "Magazines"),
    ];

    private string _name = "";
    private string _category = "";
    private string _subcategory = "";
    private bool _isLoadingOptions = false;
    private SubcategoryOption[] _subcategoryOptions = [];

    private bool _nameError = false;
    private bool _categoryError = false;
    private bool _subcategoryError = false;

    private async Task OnCategoryChanged(string? value)
    {
        _category = value ?? "";
        _subcategory = "";
        _subcategoryOptions = [];
        _categoryError = false;
        _subcategoryError = false;

        if (!string.IsNullOrEmpty(_category))
        {
            _isLoadingOptions = true;
            StateHasChanged();

            await Task.Delay(500);

            _subcategoryOptions = _category switch
            {
                "electronics" => _electronicsOptions,
                "clothing" => _clothingOptions,
                "books" => _booksOptions,
                _ => []
            };
            _isLoadingOptions = false;
        }
    }

    private void OnSubcategoryChanged(string? value)
    {
        _subcategory = value ?? "";
        _subcategoryError = false;
    }

    private void ResetForm()
    {
        _name = "";
        _category = "";
        _subcategory = "";
        _subcategoryOptions = [];
        _isLoadingOptions = false;
        _nameError = false;
        _categoryError = false;
        _subcategoryError = false;
    }

    private void OnSubmit()
    {
        _nameError = string.IsNullOrWhiteSpace(_name);
        _categoryError = string.IsNullOrEmpty(_category);
        _subcategoryError = string.IsNullOrEmpty(_subcategory);
    }
}
