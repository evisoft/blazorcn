@* ============================================================
   Block: form-switch-basic
   Title: FormSwitchBasic
   Description: A basic switch toggle form with a single switch field
   Source: original/blocks/form/form-switch-basic.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Notification Settings</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Control your notification preferences
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <FieldContentCn>
                        <LabelCn For="enabled">Enable Notifications</LabelCn>
                        <FieldDescriptionCn>
                            Receive notifications about important updates
                        </FieldDescriptionCn>
                    </FieldContentCn>
                    <SwitchCn id="enabled" Checked="@_enabled" CheckedChanged="@((bool v) => _enabled = v)" />
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveChanges">
                        Save Changes
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private bool _enabled = false;

    private void ResetForm()
    {
        _enabled = false;
    }

    private void SaveChanges()
    {
        // Handle form submission (presentational only)
    }
}
