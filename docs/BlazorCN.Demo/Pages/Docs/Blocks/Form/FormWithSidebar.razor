@* ============================================================
   Block: form-with-sidebar
   Title: FormWithSidebar
   Description: A form with a sticky navigation sidebar for quick access to different sections
   Source: original/blocks/form/form-with-sidebar.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Registration Form</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Complete all sections to register</p>
        </div>

        <div class="grid lg:grid-cols-[200px_1fr]">
            @* Sidebar *@
            <nav class="border-b border-r-0 p-4 lg:border-b-0 lg:border-r">
                <div class="space-y-1">
                    @foreach (var sec in _sections)
                    {
                        var navSec = sec;
                        <button type="button" @onclick="@(() => ScrollToSection(navSec.Id))"
                                class="block w-full rounded-md px-3 py-2 text-left text-sm transition-colors hover:bg-muted">
                            @navSec.Label
                        </button>
                    }
                </div>
            </nav>

            @* Form Content *@
            <form class="p-6" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <div class="space-y-8">
                    @* Personal Information *@
                    <div id="personal" class="scroll-mt-6">
                        <h3 class="mb-4 text-sm font-medium">Personal Information</h3>
                        <div class="space-y-4">
                            <div class="grid gap-4 sm:grid-cols-2">
                                <div>
                                    <LabelCn For="firstName" Class="mb-1.5 block">First Name</LabelCn>
                                    <InputCn id="firstName" Placeholder="John" @bind-Value="_firstName" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(_firstName))
                                    {
                                        <p class="mt-1 text-xs text-destructive">First name is required</p>
                                    }
                                </div>

                                <div>
                                    <LabelCn For="lastName" Class="mb-1.5 block">Last Name</LabelCn>
                                    <InputCn id="lastName" Placeholder="Doe" @bind-Value="_lastName" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(_lastName))
                                    {
                                        <p class="mt-1 text-xs text-destructive">Last name is required</p>
                                    }
                                </div>
                            </div>

                            <div>
                                <LabelCn For="email" Class="mb-1.5 block">Email</LabelCn>
                                <InputCn id="email" type="email" Placeholder="@("john@example.com")" @bind-Value="_email" />
                                @if (_submitted && string.IsNullOrWhiteSpace(_email))
                                {
                                    <p class="mt-1 text-xs text-destructive">Invalid email address</p>
                                }
                            </div>

                            <div>
                                <LabelCn For="phone" Class="mb-1.5 block">Phone</LabelCn>
                                <InputCn id="phone" type="tel" Placeholder="(555) 123-4567" @bind-Value="_phone" />
                                @if (_submitted && _phone.Length < 10)
                                {
                                    <p class="mt-1 text-xs text-destructive">Phone number must be at least 10 digits</p>
                                }
                            </div>
                        </div>
                    </div>

                    @* Address *@
                    <div id="address" class="scroll-mt-6">
                        <h3 class="mb-4 text-sm font-medium">Address</h3>
                        <div class="space-y-4">
                            <div>
                                <LabelCn For="street" Class="mb-1.5 block">Street Address</LabelCn>
                                <InputCn id="street" Placeholder="123 Main St" @bind-Value="_street" />
                                @if (_submitted && string.IsNullOrWhiteSpace(_street))
                                {
                                    <p class="mt-1 text-xs text-destructive">Street address is required</p>
                                }
                            </div>

                            <div class="grid gap-4 sm:grid-cols-3">
                                <div class="sm:col-span-2">
                                    <LabelCn For="city" Class="mb-1.5 block">City</LabelCn>
                                    <InputCn id="city" Placeholder="New York" @bind-Value="_city" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(_city))
                                    {
                                        <p class="mt-1 text-xs text-destructive">City is required</p>
                                    }
                                </div>

                                <div>
                                    <LabelCn For="state" Class="mb-1.5 block">State</LabelCn>
                                    <InputCn id="state" Placeholder="NY" @bind-Value="_state" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(_state))
                                    {
                                        <p class="mt-1 text-xs text-destructive">State is required</p>
                                    }
                                </div>
                            </div>

                            <div>
                                <LabelCn For="zip" Class="mb-1.5 block">ZIP Code</LabelCn>
                                <InputCn id="zip" Placeholder="10001" Class="max-w-xs" @bind-Value="_zip" />
                                @if (_submitted && _zip.Length < 5)
                                {
                                    <p class="mt-1 text-xs text-destructive">ZIP code must be at least 5 digits</p>
                                }
                            </div>
                        </div>
                    </div>

                    @* Preferences *@
                    <div id="preferences" class="scroll-mt-6">
                        <h3 class="mb-4 text-sm font-medium">Preferences</h3>
                        <div class="space-y-4">
                            <div>
                                <LabelCn Class="mb-1.5 block">Preferred Contact Method</LabelCn>
                                <RadioGroupCn Value="@_contactMethod" ValueChanged="@((string? v) => _contactMethod = v ?? "email")">
                                    <div class="flex items-center gap-2">
                                        <RadioGroupItemCn id="contact-email" Value="email" />
                                        <label for="contact-email" class="text-sm">Email</label>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <RadioGroupItemCn id="contact-phone" Value="phone" />
                                        <label for="contact-phone" class="text-sm">Phone</label>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <RadioGroupItemCn id="contact-sms" Value="sms" />
                                        <label for="contact-sms" class="text-sm">SMS</label>
                                    </div>
                                </RadioGroupCn>
                            </div>

                            <div>
                                <div class="flex items-center justify-between">
                                    <div class="space-y-0.5">
                                        <LabelCn>Newsletter Subscription</LabelCn>
                                        <p class="text-xs text-muted-foreground">Receive updates and promotional emails</p>
                                    </div>
                                    <SwitchCn Checked="@_newsletter" CheckedChanged="@((bool v) => _newsletter = v)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Additional Information *@
                    <div id="additional" class="scroll-mt-6">
                        <h3 class="mb-4 text-sm font-medium">Additional Information</h3>
                        <div class="space-y-4">
                            <div>
                                <LabelCn For="comments" Class="mb-1.5 block">Comments or Questions</LabelCn>
                                <TextareaCn id="comments" Placeholder="Optional. Any additional information you'd like to share." rows="4" @bind-Value="_comments" />
                                <p class="mt-1 text-xs text-muted-foreground">Maximum 1000 characters</p>
                                @if (_submitted && _comments.Length > 1000)
                                {
                                    <p class="mt-1 text-xs text-destructive">Comments must be less than 1000 characters</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="Cancel">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="submit">Submit Registration</ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record NavSection(string Id, string Label);

    private static readonly NavSection[] _sections =
    [
        new("personal", "Personal Information"),
        new("address", "Address"),
        new("preferences", "Preferences"),
        new("additional", "Additional Information"),
    ];

    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _phone = "";
    private string _street = "";
    private string _city = "";
    private string _state = "";
    private string _zip = "";
    private string _contactMethod = "email";
    private bool _newsletter = false;
    private string _comments = "";
    private bool _submitted = false;

    private void ScrollToSection(string sectionId)
    {
        // Presentational only — smooth scroll not wired (would require JS interop)
    }

    private void Cancel()
    {
        _firstName = "";
        _lastName = "";
        _email = "";
        _phone = "";
        _street = "";
        _city = "";
        _state = "";
        _zip = "";
        _contactMethod = "email";
        _newsletter = false;
        _comments = "";
        _submitted = false;
    }

    private void HandleSubmit()
    {
        _submitted = true;
        // Presentational only
    }
}
