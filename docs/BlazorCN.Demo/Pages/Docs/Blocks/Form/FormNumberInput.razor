@* ============================================================
   Block: form-number-input
   Title: FormNumberInput
   Description: A number input form with min/max validation
   Source: original/blocks/form/form-number-input.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Set Quantity</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Enter the number of items you want to order
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_quantityError) ? "true" : null)">
                    <LabelCn For="quantity">Quantity</LabelCn>
                    <InputCn id="quantity"
                             type="number"
                             Placeholder="Enter quantity"
                             @bind-Value="_quantityText"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_quantityError) ? "true" : "false")" />
                    <FieldDescriptionCn>Enter a number between 1 and 100</FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_quantityError))
                    {
                        <FieldErrorCn Errors="@(new[] { _quantityError })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="Clear">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="submit" @onclick="Submit">
                        Confirm Quantity
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _quantityText = "";
    private string _quantityError = "";
    private bool _submitted = false;

    private void Validate()
    {
        _quantityError = "";

        if (string.IsNullOrWhiteSpace(_quantityText))
        {
            _quantityError = "Quantity is required";
            return;
        }

        if (!int.TryParse(_quantityText, out var qty))
        {
            _quantityError = "Please enter a valid number";
            return;
        }

        if (qty < 1)
            _quantityError = "Quantity must be at least 1";
        else if (qty > 100)
            _quantityError = "Quantity must not exceed 100";
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
    }

    private void Clear()
    {
        _quantityText = "";
        _quantityError = "";
        _submitted = false;
    }
}
