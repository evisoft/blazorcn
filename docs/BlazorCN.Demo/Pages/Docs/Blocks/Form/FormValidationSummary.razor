@* ============================================================
   Block: form-validation-summary
   Title: FormValidationSummary
   Description: A form with a validation error summary displayed at the top when there are errors, plus inline field errors.
   Source: original/blocks/form/form-validation-summary.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Company Registration</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Register your company to get started
            </p>
        </div>

        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            @if (_hasErrors)
            {
                <div class="mb-4 rounded-md border border-destructive/20 bg-destructive/10 p-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="alert-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-destructive" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium text-destructive">
                                @(_errorCount == 1
                                    ? "There is 1 error with your submission"
                                    : $"There are {_errorCount} errors with your submission")
                            </p>
                            <ul class="mt-2 space-y-1 text-xs text-destructive">
                                @if (_errors.ContainsKey("companyName"))
                                {
                                    <li>• @_errors["companyName"]</li>
                                }
                                @if (_errors.ContainsKey("email"))
                                {
                                    <li>• @_errors["email"]</li>
                                }
                                @if (_errors.ContainsKey("phone"))
                                {
                                    <li>• @_errors["phone"]</li>
                                }
                                @if (_errors.ContainsKey("website"))
                                {
                                    <li>• @_errors["website"]</li>
                                }
                                @if (_errors.ContainsKey("description"))
                                {
                                    <li>• @_errors["description"]</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }

            <div class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="validation-summary-companyName">Company Name</FieldLabelCn>
                    <InputCn id="validation-summary-companyName" @bind-Value="_companyName" Placeholder="Acme Inc." aria-invalid="@(_errors.ContainsKey("companyName") ? "true" : "false")" />
                    @if (_errors.ContainsKey("companyName"))
                    {
                        <FieldErrorCn>@_errors["companyName"]</FieldErrorCn>
                    }
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="validation-summary-email">Email Address</FieldLabelCn>
                    <InputCn id="validation-summary-email" type="email" @bind-Value="_email" Placeholder="@("contact@acme.com")" aria-invalid="@(_errors.ContainsKey("email") ? "true" : "false")" />
                    @if (_errors.ContainsKey("email"))
                    {
                        <FieldErrorCn>@_errors["email"]</FieldErrorCn>
                    }
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="validation-summary-phone">Phone Number</FieldLabelCn>
                    <InputCn id="validation-summary-phone" type="tel" @bind-Value="_phone" Placeholder="+1234567890" aria-invalid="@(_errors.ContainsKey("phone") ? "true" : "false")" />
                    <FieldDescriptionCn>Include country code (e.g., +1 for US)</FieldDescriptionCn>
                    @if (_errors.ContainsKey("phone"))
                    {
                        <FieldErrorCn>@_errors["phone"]</FieldErrorCn>
                    }
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="validation-summary-website">Website (Optional)</FieldLabelCn>
                    <InputCn id="validation-summary-website" type="url" @bind-Value="_website" Placeholder="@("https://acme.com")" aria-invalid="@(_errors.ContainsKey("website") ? "true" : "false")" />
                    @if (_errors.ContainsKey("website"))
                    {
                        <FieldErrorCn>@_errors["website"]</FieldErrorCn>
                    }
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="validation-summary-description">Company Description</FieldLabelCn>
                    <TextareaCn id="validation-summary-description" @bind-Value="_description" Placeholder="Tell us about your company..." Class="min-h-[100px] resize-none" aria-invalid="@(_errors.ContainsKey("description") ? "true" : "false")" />
                    <FieldDescriptionCn>@_description.Length/500 characters</FieldDescriptionCn>
                    @if (_errors.ContainsKey("description"))
                    {
                        <FieldErrorCn>@_errors["description"]</FieldErrorCn>
                    }
                </FieldCn>
            </div>

            <div class="mt-6 flex gap-3">
                <ButtonCn type="submit" Class="flex-1">
                    Register Company
                </ButtonCn>
                <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="ResetForm">
                    Reset
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _companyName = "";
    private string _email = "";
    private string _phone = "";
    private string _website = "";
    private string _description = "";
    private Dictionary<string, string> _errors = new();
    private bool _isSubmitted = false;

    private int _errorCount => _errors.Count;
    private bool _hasErrors => _errorCount > 0 && _isSubmitted;

    private bool Validate()
    {
        _errors = new Dictionary<string, string>();

        if (_companyName.Length < 2)
            _errors["companyName"] = "Company name must be at least 2 characters";

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@') || !_email.Contains('.'))
            _errors["email"] = "Please enter a valid email address";

        if (string.IsNullOrWhiteSpace(_phone) || !System.Text.RegularExpressions.Regex.IsMatch(_phone, @"^\+?[1-9]\d{1,14}$"))
            _errors["phone"] = "Please enter a valid phone number";

        if (!string.IsNullOrWhiteSpace(_website) && !Uri.TryCreate(_website, UriKind.Absolute, out _))
            _errors["website"] = "Please enter a valid URL";

        if (_description.Length < 10)
            _errors["description"] = "Description must be at least 10 characters";
        else if (_description.Length > 500)
            _errors["description"] = "Description must not exceed 500 characters";

        return _errors.Count == 0;
    }

    private void HandleSubmit()
    {
        _isSubmitted = true;
        if (Validate())
        {
            // Form submitted successfully
            _isSubmitted = false;
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _companyName = "";
        _email = "";
        _phone = "";
        _website = "";
        _description = "";
        _errors = new Dictionary<string, string>();
        _isSubmitted = false;
    }
}
