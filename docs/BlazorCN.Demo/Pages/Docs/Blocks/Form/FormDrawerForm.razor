@* ============================================================
   Block: form-drawer-form
   Title: FormDrawerForm
   Description: A form inside a drawer sheet that slides in from the right side with validation
   Source: original/blocks/form/form-drawer-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Company Profile</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        View and manage your company information
                    </p>
                </div>

                <SheetCn Open="@_open" OpenChanged="@HandleOpenChanged">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8" @onclick="@(() => _open = true)">
                        <LucideIconCn Name="settings" Size="14" Class="mr-1.5 size-3.5" />
                        Edit Settings
                    </ButtonCn>
                    <SheetContentCn Class="w-full sm:max-w-lg">
                        <SheetHeaderCn>
                            <SheetTitleCn>Company Settings</SheetTitleCn>
                            <SheetDescriptionCn>Update your company profile and preferences</SheetDescriptionCn>
                        </SheetHeaderCn>

                        <form class="mt-6">
                            <div class="space-y-4">
                                @* Company Name *@
                                <FieldCn data-invalid="@(_submitted && string.IsNullOrWhiteSpace(_companyName) ? "true" : null)">
                                    <FieldLabelCn For="companyName">Company Name</FieldLabelCn>
                                    <FieldContentCn>
                                        <InputCn id="companyName"
                                                 Placeholder="Acme Corporation"
                                                 @bind-Value="_companyName" />
                                        @if (_submitted && string.IsNullOrWhiteSpace(_companyName))
                                        {
                                            <FieldErrorCn Errors="@(new[] { "Company name must be at least 2 characters" })" />
                                        }
                                    </FieldContentCn>
                                </FieldCn>

                                @* Website *@
                                <FieldCn>
                                    <FieldLabelCn For="website">Website</FieldLabelCn>
                                    <FieldContentCn>
                                        <InputCn id="website"
                                                 type="url"
                                                 Placeholder="https://example.com"
                                                 @bind-Value="_website" />
                                        <FieldDescriptionCn>Your company's website URL</FieldDescriptionCn>
                                    </FieldContentCn>
                                </FieldCn>

                                @* Industry *@
                                <FieldCn data-invalid="@(_submitted && string.IsNullOrEmpty(_industry) ? "true" : null)">
                                    <FieldLabelCn For="industry">Industry</FieldLabelCn>
                                    <FieldContentCn>
                                        <SelectCn Value="@_industry" ValueChanged="@((string? v) => _industry = v ?? "")">
                                            <SelectTriggerCn id="industry">
                                                <SelectValueCn />
                                            </SelectTriggerCn>
                                            <SelectContentCn>
                                                <SelectItemCn Value="technology">Technology</SelectItemCn>
                                                <SelectItemCn Value="healthcare">Healthcare</SelectItemCn>
                                                <SelectItemCn Value="finance">Finance</SelectItemCn>
                                                <SelectItemCn Value="education">Education</SelectItemCn>
                                                <SelectItemCn Value="other">Other</SelectItemCn>
                                            </SelectContentCn>
                                        </SelectCn>
                                    </FieldContentCn>
                                </FieldCn>

                                @* Description *@
                                <FieldCn data-invalid="@(_submitted && _description.Length > 500 ? "true" : null)">
                                    <FieldLabelCn For="description">Description</FieldLabelCn>
                                    <FieldContentCn>
                                        <TextareaCn id="description"
                                                    Placeholder="Describe your company..."
                                                    Class="min-h-[120px] resize-none"
                                                    @bind-Value="_description" />
                                        <FieldDescriptionCn>
                                            Brief description of your company (max 500 characters)
                                        </FieldDescriptionCn>
                                        @if (_submitted && _description.Length > 500)
                                        {
                                            <FieldErrorCn Errors="@(new[] { "Description must be 500 characters or less" })" />
                                        }
                                    </FieldContentCn>
                                </FieldCn>
                            </div>

                            <SheetFooterCn Class="mt-6">
                                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="@(() => HandleOpenChanged(false))">
                                    Cancel
                                </ButtonCn>
                                <ButtonCn type="button" @onclick="SaveSettings" Disabled="@_saving">
                                    @(_saving ? "Saving..." : "Save Changes")
                                </ButtonCn>
                            </SheetFooterCn>
                        </form>
                    </SheetContentCn>
                </SheetCn>
            </div>
        </div>

        <div class="px-4 py-3">
            <dl class="space-y-3">
                <div>
                    <dt class="font-medium text-muted-foreground text-xs">Company Name</dt>
                    <dd class="mt-1 text-sm">@_savedCompanyName</dd>
                </div>
                <div>
                    <dt class="font-medium text-muted-foreground text-xs">Website</dt>
                    <dd class="mt-1 text-sm">@(string.IsNullOrEmpty(_savedWebsite) ? "Not set" : _savedWebsite)</dd>
                </div>
                <div>
                    <dt class="font-medium text-muted-foreground text-xs">Industry</dt>
                    <dd class="mt-1 text-sm capitalize">@_savedIndustry</dd>
                </div>
                <div>
                    <dt class="font-medium text-muted-foreground text-xs">Description</dt>
                    <dd class="mt-1 text-sm">@_savedDescription</dd>
                </div>
            </dl>
        </div>
    </div>
</section>

@code {
    // Drawer open state
    private bool _open = false;
    private bool _submitted = false;
    private bool _saving = false;

    // Form fields (working copy inside the drawer)
    private string _companyName = "Acme Corporation";
    private string _website = "https://acme.com";
    private string _industry = "technology";
    private string _description = "Leading provider of innovative solutions for businesses worldwide.";

    // Saved / displayed values
    private string _savedCompanyName = "Acme Corporation";
    private string _savedWebsite = "https://acme.com";
    private string _savedIndustry = "technology";
    private string _savedDescription = "Leading provider of innovative solutions for businesses worldwide.";

    private void HandleOpenChanged(bool newOpen)
    {
        _open = newOpen;
        if (!newOpen)
        {
            // Reset working copy back to saved values on close/cancel
            _companyName = _savedCompanyName;
            _website = _savedWebsite;
            _industry = _savedIndustry;
            _description = _savedDescription;
            _submitted = false;
        }
    }

    private async Task SaveSettings()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_companyName)) return;

        _saving = true;
        // Simulate API call
        await Task.Delay(1000);

        _savedCompanyName = _companyName;
        _savedWebsite = _website;
        _savedIndustry = _industry;
        _savedDescription = _description;

        _saving = false;
        _submitted = false;
        _open = false;
    }
}
