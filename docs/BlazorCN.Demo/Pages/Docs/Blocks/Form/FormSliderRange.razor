@* ============================================================
   Block: form-slider-range
   Title: FormSliderRange
   Description: A slider range input form with real-time value display
   Source: original/blocks/form/form-slider-range.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Volume Settings</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Adjust the volume level for notifications
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn>
                    <div class="flex items-center justify-between">
                        <LabelCn For="slider-range-volume">Notification Volume</LabelCn>
                        <span class="font-medium tabular-nums text-sm">@_volume%</span>
                    </div>
                    <SliderCn Id="slider-range-volume"
                               Value="@((double)_volume)"
                               ValueChanged="@((double v) => { _volume = (int)v; })"
                               Min="0"
                               Max="100"
                               Step="1"
                               Class="mt-2" />
                    <FieldDescriptionCn>Drag the slider to adjust the volume from 0% to 100%</FieldDescriptionCn>
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveSettings">
                        Save Settings
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private int _volume = 50;

    private void ResetForm()
    {
        _volume = 50;
    }

    private void SaveSettings()
    {
        // Save volume preference
    }
}
