@* ============================================================
   Block: form-sortable-items
   Title: FormSortableItems
   Description: A form with a dynamic list of items that can be reordered, added, and removed
   Source: original/blocks/form/form-sortable-items.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Task Priority List</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Create and reorder your tasks by priority
            </p>
        </div>

        <div class="space-y-6 px-4 py-6">
            <FieldCn>
                <FieldLabelCn For="list-title">List Title</FieldLabelCn>
                <InputCn id="list-title"
                         Value="@_title"
                         ValueChanged="@((string v) => UpdateTitle(v))"
                         Placeholder="Enter list title" />
                @if (_titleError)
                {
                    <FieldErrorCn Errors="@(new[] { "Title is required" })" />
                }
            </FieldCn>

            <div>
                <FieldLabelCn>Tasks</FieldLabelCn>
                <FieldDescriptionCn>Use the arrows to reorder tasks by priority</FieldDescriptionCn>

                <div class="mt-3 space-y-2">
                    @foreach (var it in _items)
                    {
                        var item = it;
                        var idx = _items.IndexOf(item);
                        <div class="flex items-center gap-2 rounded-md border bg-background p-2">
                            <LucideIconCn Name="grip-vertical" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />

                            <div class="min-w-0 flex-1">
                                <input type="text"
                                       value="@item.Value"
                                       placeholder="Enter task description"
                                       class="h-8 w-full border-0 bg-transparent px-2 text-sm shadow-none outline-none focus-visible:ring-0"
                                       @oninput="@((ChangeEventArgs e) => UpdateItemValue(item.Id, e.Value?.ToString() ?? ""))" />
                                @if (item.HasError)
                                {
                                    <p class="mt-1 px-2 text-destructive text-xs">Item cannot be empty</p>
                                }
                            </div>

                            <div class="flex shrink-0 items-center gap-1">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7"
                                          type="button"
                                          Disabled="@(idx == 0)"
                                          @onclick="@(() => MoveUp(item.Id))">
                                    <LucideIconCn Name="chevron-up" Size="16" Class="size-4" />
                                </ButtonCn>

                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7"
                                          type="button"
                                          Disabled="@(idx == _items.Count - 1)"
                                          @onclick="@(() => MoveDown(item.Id))">
                                    <LucideIconCn Name="chevron-down" Size="16" Class="size-4" />
                                </ButtonCn>

                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 text-destructive hover:text-destructive"
                                          type="button"
                                          Disabled="@(_items.Count == 1)"
                                          @onclick="@(() => RemoveItem(item.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="size-4" />
                                </ButtonCn>
                            </div>
                        </div>
                    }

                    @if (_rootError)
                    {
                        <p class="text-destructive text-xs">At least one item is required</p>
                    }
                </div>

                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="mt-3 h-8 gap-1.5"
                          type="button"
                          @onclick="AddItem">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Task
                </ButtonCn>
            </div>

            <div class="rounded-md bg-muted/50 p-3">
                <h3 class="mb-2 font-medium text-sm">Preview Order</h3>
                <ol class="space-y-1 text-sm">
                    @foreach (var it in _items)
                    {
                        var item = it;
                        var idx = _items.IndexOf(item);
                        <li class="flex items-center gap-2">
                            <span class="font-medium text-muted-foreground text-xs">@(idx + 1).</span>
                            <span class="text-muted-foreground">@(string.IsNullOrEmpty(item.Value) ? "(empty)" : item.Value)</span>
                        </li>
                    }
                </ol>
            </div>
        </div>

        <div class="flex items-center justify-end border-t px-4 py-3">
            <ButtonCn type="button" @onclick="SaveList">Save List</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _title = "";
    private bool _titleError = false;
    private bool _rootError = false;
    private int _nextId = 4;

    private List<SortableItem> _items = new()
    {
        new SortableItem { Id = 1, Value = "Design landing page" },
        new SortableItem { Id = 2, Value = "Set up authentication" },
        new SortableItem { Id = 3, Value = "Create database schema" },
    };

    private void UpdateTitle(string value)
    {
        _title = value;
        _titleError = string.IsNullOrWhiteSpace(value);
    }

    private void UpdateItemValue(int id, string value)
    {
        var item = _items.FirstOrDefault(x => x.Id == id);
        if (item is not null)
        {
            item.Value = value;
            item.HasError = string.IsNullOrEmpty(value);
        }
    }

    private void MoveUp(int id)
    {
        var idx = _items.FindIndex(x => x.Id == id);
        if (idx > 0)
        {
            var temp = _items[idx];
            _items[idx] = _items[idx - 1];
            _items[idx - 1] = temp;
        }
    }

    private void MoveDown(int id)
    {
        var idx = _items.FindIndex(x => x.Id == id);
        if (idx < _items.Count - 1)
        {
            var temp = _items[idx];
            _items[idx] = _items[idx + 1];
            _items[idx + 1] = temp;
        }
    }

    private void RemoveItem(int id)
    {
        _items.RemoveAll(x => x.Id == id);
        _rootError = false;
    }

    private void AddItem()
    {
        _rootError = false;
        _items.Add(new SortableItem { Id = _nextId, Value = "" });
        _nextId++;
    }

    private void SaveList()
    {
        bool valid = true;
        _titleError = string.IsNullOrWhiteSpace(_title);
        if (_titleError) valid = false;

        foreach (var item in _items)
        {
            item.HasError = string.IsNullOrEmpty(item.Value);
            if (item.HasError) valid = false;
        }

        if (_items.Count == 0)
        {
            _rootError = true;
            valid = false;
        }
        // Presentational — no further action on valid submit
    }

    private class SortableItem
    {
        public int Id { get; set; }
        public string Value { get; set; } = "";
        public bool HasError { get; set; }
    }
}
