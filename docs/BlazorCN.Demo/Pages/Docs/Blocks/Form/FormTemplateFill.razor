@* ============================================================
   Block: form-template-fill
   Title: FormTemplateFill
   Description: A form with preset templates that automatically populate fields with predefined values for common use cases and faster data entry
   Source: original/blocks/form/form-template-fill.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Contact Support</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Choose a template to get started quickly
            </p>
        </div>

        @* Template selector *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="file-text" Size="16" Class="mt-0.5 size-4 text-muted-foreground" />
                <div class="flex-1">
                    <label for="template-select" class="text-xs font-medium text-muted-foreground">
                        Select Template
                    </label>
                    <SelectCn Value="@_templateId" ValueChanged="@((string? v) => HandleTemplateChange(v ?? "blank"))">
                        <SelectTriggerCn id="template-select" Class="mt-1.5">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var tmpl in _templates)
                            {
                                var t = tmpl;
                                <SelectItemCn Value="@t.Id">
                                    <div class="flex flex-col items-start">
                                        <span class="text-sm font-medium">@t.Name</span>
                                        <span class="text-xs text-muted-foreground">@t.Description</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Form *@
        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="recipient-input">Recipient</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="recipient-input" type="email" Placeholder="@("recipient@example.com")"
                                 Value="@_recipient" ValueChanged="@((string v) => _recipient = v)"
                                 aria-invalid="@(_submitted && string.IsNullOrEmpty(_recipient) ? "true" : null)" />
                        @if (_submitted && string.IsNullOrEmpty(_recipient))
                        {
                            <FieldErrorCn Errors="@(new[] { "Recipient is required" })" />
                        }
                    </FieldContentCn>
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="subject-input">Subject</FieldLabelCn>
                    <FieldContentCn>
                        <InputCn id="subject-input" Placeholder="Enter subject"
                                 Value="@_subject" ValueChanged="@((string v) => _subject = v)"
                                 aria-invalid="@(_submitted && string.IsNullOrEmpty(_subject) ? "true" : null)" />
                        @if (_submitted && string.IsNullOrEmpty(_subject))
                        {
                            <FieldErrorCn Errors="@(new[] { "Subject is required" })" />
                        }
                    </FieldContentCn>
                </FieldCn>

                <div class="grid gap-4 sm:grid-cols-2">
                    <FieldCn>
                        <FieldLabelCn For="category-select">Category</FieldLabelCn>
                        <FieldContentCn>
                            <SelectCn Value="@_category" ValueChanged="@((string? v) => _category = v ?? "general")">
                                <SelectTriggerCn id="category-select">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="general">General</SelectItemCn>
                                    <SelectItemCn Value="technical">Technical</SelectItemCn>
                                    <SelectItemCn Value="product">Product</SelectItemCn>
                                    <SelectItemCn Value="billing">Billing</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            @if (_submitted && string.IsNullOrEmpty(_category))
                            {
                                <FieldErrorCn Errors="@(new[] { "Category is required" })" />
                            }
                        </FieldContentCn>
                    </FieldCn>

                    <FieldCn>
                        <FieldLabelCn For="priority-select">Priority</FieldLabelCn>
                        <FieldContentCn>
                            <SelectCn Value="@_priority" ValueChanged="@((string? v) => _priority = v ?? "medium")">
                                <SelectTriggerCn id="priority-select">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="low">Low</SelectItemCn>
                                    <SelectItemCn Value="medium">Medium</SelectItemCn>
                                    <SelectItemCn Value="high">High</SelectItemCn>
                                    <SelectItemCn Value="urgent">Urgent</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            @if (_submitted && string.IsNullOrEmpty(_priority))
                            {
                                <FieldErrorCn Errors="@(new[] { "Priority is required" })" />
                            }
                        </FieldContentCn>
                    </FieldCn>
                </div>

                <FieldCn>
                    <FieldLabelCn For="message-textarea">Message</FieldLabelCn>
                    <FieldContentCn>
                        <TextareaCn id="message-textarea" Placeholder="Enter your message"
                                    Rows="8" Class="resize-none"
                                    Value="@_message" ValueChanged="@((string v) => _message = v)"
                                    aria-invalid="@(_submitted && string.IsNullOrEmpty(_message) ? "true" : null)" />
                        <FieldDescriptionCn>@_message.Length characters</FieldDescriptionCn>
                        @if (_submitted && string.IsNullOrEmpty(_message))
                        {
                            <FieldErrorCn Errors="@(new[] { "Message is required" })" />
                        }
                    </FieldContentCn>
                </FieldCn>
            </div>

            <div class="mt-6 flex justify-end gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button"
                          @onclick="ClearForm">
                    Clear
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" type="submit">
                    Send Message
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record Template(string Id, string Name, string Description,
        string Recipient, string Subject, string Message, string Priority, string Category);

    private static readonly Template[] _templates =
    [
        new("blank", "Blank", "Start with an empty form",
            "", "", "", "medium", "general"),
        new("bug-report", "Bug Report", "Report a technical issue",
            "support@example.com", "Bug Report: ",
            "Description of the issue:\n\nSteps to reproduce:\n1. \n2. \n3. \n\nExpected behavior:\n\nActual behavior:",
            "high", "technical"),
        new("feature-request", "Feature Request", "Suggest a new feature or improvement",
            "product@example.com", "Feature Request: ",
            "Feature description:\n\nUse case:\n\nExpected benefit:\n\nAdditional context:",
            "medium", "product"),
        new("general-inquiry", "General Inquiry", "Ask a general question",
            "info@example.com", "Question about ",
            "Hello,\n\nI have a question regarding:\n\nThank you!",
            "low", "general"),
    ];

    private string _templateId = "blank";
    private string _recipient = "";
    private string _subject = "";
    private string _message = "";
    private string _priority = "medium";
    private string _category = "general";
    private bool _submitted = false;

    private void HandleTemplateChange(string templateId)
    {
        _templateId = templateId;
        var tmpl = System.Array.Find(_templates, t => t.Id == templateId);
        if (tmpl is not null)
        {
            _recipient = tmpl.Recipient;
            _subject = tmpl.Subject;
            _message = tmpl.Message;
            _priority = tmpl.Priority;
            _category = tmpl.Category;
        }
        _submitted = false;
    }

    private void ClearForm()
    {
        HandleTemplateChange("blank");
    }

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
