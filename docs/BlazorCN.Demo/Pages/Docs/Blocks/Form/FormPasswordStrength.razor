@* ============================================================
   Block: form-password-strength
   Title: FormPasswordStrength
   Description: A password input field with a real-time strength meter showing weak, fair, strong, or very strong levels based on length and character variety.
   Source: original/blocks/form/form-password-strength.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Create Password</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose a strong password for your account
            </p>
        </div>
        <form class="px-4 py-6" @onsubmit="Submit" @onsubmit:preventDefault="true">
            <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_passwordError) ? "true" : null)">
                <LabelCn For="password">Password</LabelCn>
                <InputCn id="password"
                         type="password"
                         Placeholder="Enter your password"
                         @bind-Value="_password"
                         @bind-Value:event="oninput"
                         aria-invalid="@(_submitted && !string.IsNullOrEmpty(_passwordError) ? "true" : "false")" />
                @if (!string.IsNullOrEmpty(_password))
                {
                    <div class="mt-2 space-y-1">
                        <div class="flex gap-1">
                            @foreach (var seg in _segments)
                            {
                                var segment = seg;
                                <div class="@Cn.Merge("h-1 flex-1 rounded-full transition-colors", segment <= _strength.Level ? _strength.Color : "bg-muted")"></div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_strength.Label))
                        {
                            <p class="text-muted-foreground text-xs">Strength: @_strength.Label</p>
                        }
                    </div>
                }
                @if (_submitted && !string.IsNullOrEmpty(_passwordError))
                {
                    <FieldErrorCn Errors="@(new[] { _passwordError })" />
                }
            </FieldCn>
            <ButtonCn type="submit" Class="mt-4 w-full">
                Create Account
            </ButtonCn>
        </form>
    </div>
</section>

@code {
    private string _password = "";
    private bool _submitted = false;
    private string _passwordError = "";

    private static readonly int[] _segments = [1, 2, 3, 4];

    private PasswordStrength _strength => CalculatePasswordStrength(_password);

    private record PasswordStrength(int Level, string Label, string Color);

    private static PasswordStrength CalculatePasswordStrength(string password)
    {
        if (string.IsNullOrEmpty(password))
            return new PasswordStrength(0, "", "");

        int strength = 0;

        // Length
        if (password.Length >= 8) strength += 1;
        if (password.Length >= 12) strength += 1;

        // Character variety
        if (System.Text.RegularExpressions.Regex.IsMatch(password, "[a-z]")) strength += 1;
        if (System.Text.RegularExpressions.Regex.IsMatch(password, "[A-Z]")) strength += 1;
        if (System.Text.RegularExpressions.Regex.IsMatch(password, @"\d")) strength += 1;
        if (System.Text.RegularExpressions.Regex.IsMatch(password, @"[^a-zA-Z\d]")) strength += 1;

        // Normalize to 0-4 scale
        int level = Math.Min((int)Math.Floor(strength / 1.5), 4);

        string[] labels = ["", "Weak", "Fair", "Strong", "Very strong"];
        string[] colors = ["", "bg-red-500", "bg-orange-500", "bg-yellow-500", "bg-green-500"];

        return new PasswordStrength(level, labels[level], colors[level]);
    }

    private void Submit()
    {
        _submitted = true;
        _passwordError = "";

        if (string.IsNullOrEmpty(_password) || _password.Length < 8)
            _passwordError = "Minimum 8 characters";
    }
}
