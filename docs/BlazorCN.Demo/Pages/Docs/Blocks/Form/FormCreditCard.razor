@* ============================================================
   Block: form-credit-card
   Title: FormCreditCard
   Description: A credit card payment form with formatted card number input, expiry date, and CVC fields with proper input masking and validation.
   Source: original/blocks/form/form-credit-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Payment Details</h2>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Enter your card information</p>
        </div>
        <form class="px-4 py-6" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="space-y-4">
                @* Card Number *@
                <div>
                    <LabelCn For="card-number" Class="mb-1.5 block">Card Number</LabelCn>
                    <div>
                        <InputCn id="card-number"
                                 Placeholder="1234 5678 9012 3456"
                                 Value="@_cardNumber"
                                 ValueChanged="@((string v) => OnCardNumberChanged(v))"
                                 maxlength="19" />
                        @if (_submitted && _cardNumber.Length < 19)
                        {
                            <p class="mt-1 text-xs text-destructive">Invalid card number</p>
                        }
                    </div>
                </div>

                @* Expiry / CVC grid *@
                <div class="grid grid-cols-2 gap-4">
                    @* Expiry Date *@
                    <div>
                        <LabelCn For="expiry" Class="mb-1.5 block">Expiry Date</LabelCn>
                        <div>
                            <InputCn id="expiry"
                                     Placeholder="MM/YY"
                                     Value="@_expiry"
                                     ValueChanged="@((string v) => OnExpiryChanged(v))"
                                     maxlength="5" />
                            @if (_submitted && !System.Text.RegularExpressions.Regex.IsMatch(_expiry, @"^\d{2}/\d{2}$"))
                            {
                                <p class="mt-1 text-xs text-destructive">Use MM/YY format</p>
                            }
                        </div>
                    </div>

                    @* CVC *@
                    <div>
                        <LabelCn For="credit-card-cvc" Class="mb-1.5 block">CVC</LabelCn>
                        <div>
                            <InputCn id="credit-card-cvc"
                                     Placeholder="123"
                                     Value="@_cvc"
                                     ValueChanged="@((string v) => OnCvcChanged(v))"
                                     maxlength="3" />
                            @if (_submitted && _cvc.Length != 3)
                            {
                                <p class="mt-1 text-xs text-destructive">3 digits required</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <ButtonCn Type="submit" Class="mt-6 w-full">
                Complete Payment
            </ButtonCn>
        </form>
    </div>
</section>

@code {
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvc = "";
    private bool _submitted = false;

    private void OnCardNumberChanged(string value)
    {
        _cardNumber = FormatCardNumber(value);
    }

    private void OnExpiryChanged(string value)
    {
        _expiry = FormatExpiry(value);
    }

    private void OnCvcChanged(string value)
    {
        var digits = System.Text.RegularExpressions.Regex.Replace(value, @"[^0-9]", "");
        _cvc = digits.Length > 3 ? digits.Substring(0, 3) : digits;
    }

    private void HandleSubmit()
    {
        _submitted = true;
    }

    private static string FormatCardNumber(string value)
    {
        var v = System.Text.RegularExpressions.Regex.Replace(value, @"[^0-9]", "");
        if (v.Length == 0) return value;
        var parts = new System.Collections.Generic.List<string>();
        for (int i = 0; i < v.Length && i < 16; i += 4)
        {
            var end = System.Math.Min(i + 4, v.Length);
            parts.Add(v.Substring(i, end - i));
        }
        return string.Join(" ", parts);
    }

    private static string FormatExpiry(string value)
    {
        var v = System.Text.RegularExpressions.Regex.Replace(value, @"[^0-9]", "");
        if (v.Length >= 2)
            return v.Substring(0, 2) + "/" + v.Substring(2, System.Math.Min(2, v.Length - 2));
        return v;
    }
}
