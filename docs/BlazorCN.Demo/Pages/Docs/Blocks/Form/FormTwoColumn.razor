@* ============================================================
   Block: form-two-column
   Title: FormTwoColumn
   Description: A form with fields arranged in two columns on desktop, single column on mobile
   Source: original/blocks/form/form-two-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Registration Form</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Create your account by filling out the form below
            </p>
        </div>
        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                @* First Name *@
                <div>
                    <LabelCn For="firstName" Class="mb-1.5 block">First name</LabelCn>
                    <InputCn id="firstName" Placeholder="John" @bind-Value="_firstName" aria-invalid="@(_submitted && string.IsNullOrWhiteSpace(_firstName) ? "true" : "false")" />
                    <p class="mt-1 text-xs text-muted-foreground">Your given name</p>
                    @if (_submitted && string.IsNullOrWhiteSpace(_firstName))
                    {
                        <p class="mt-1 text-xs text-destructive">First name is required</p>
                    }
                </div>

                @* Last Name *@
                <div>
                    <LabelCn For="lastName" Class="mb-1.5 block">Last name</LabelCn>
                    <InputCn id="lastName" Placeholder="Doe" @bind-Value="_lastName" aria-invalid="@(_submitted && string.IsNullOrWhiteSpace(_lastName) ? "true" : "false")" />
                    <p class="mt-1 text-xs text-muted-foreground">Your family name</p>
                    @if (_submitted && string.IsNullOrWhiteSpace(_lastName))
                    {
                        <p class="mt-1 text-xs text-destructive">Last name is required</p>
                    }
                </div>

                @* Email *@
                <div>
                    <LabelCn For="email" Class="mb-1.5 block">Email address</LabelCn>
                    <InputCn id="email" type="email" Placeholder="@("john@example.com")" @bind-Value="_email" aria-invalid="@(_submitted && string.IsNullOrWhiteSpace(_email) ? "true" : "false")" />
                    <p class="mt-1 text-xs text-muted-foreground">We'll never share your email</p>
                    @if (_submitted && string.IsNullOrWhiteSpace(_email))
                    {
                        <p class="mt-1 text-xs text-destructive">Please enter a valid email</p>
                    }
                </div>

                @* Phone *@
                <div>
                    <LabelCn For="phone" Class="mb-1.5 block">Phone number</LabelCn>
                    <InputCn id="phone" type="tel" Placeholder="+1 (555) 123-4567" @bind-Value="_phone" aria-invalid="@(_submitted && string.IsNullOrWhiteSpace(_phone) ? "true" : "false")" />
                    <p class="mt-1 text-xs text-muted-foreground">Include country code</p>
                    @if (_submitted && string.IsNullOrWhiteSpace(_phone))
                    {
                        <p class="mt-1 text-xs text-destructive">Please enter a valid phone number</p>
                    }
                </div>

                @* Country *@
                <div>
                    <LabelCn For="country-trigger" Class="mb-1.5 block">Country</LabelCn>
                    <SelectCn Value="@_country" ValueChanged="@((string? v) => _country = v ?? "")">
                        <SelectTriggerCn id="country-trigger">
                            <SelectValueCn Placeholder="Select country" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="us">United States</SelectItemCn>
                            <SelectItemCn Value="ca">Canada</SelectItemCn>
                            <SelectItemCn Value="uk">United Kingdom</SelectItemCn>
                            <SelectItemCn Value="au">Australia</SelectItemCn>
                            <SelectItemCn Value="de">Germany</SelectItemCn>
                            <SelectItemCn Value="fr">France</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <p class="mt-1 text-xs text-muted-foreground">Your country of residence</p>
                    @if (_submitted && string.IsNullOrWhiteSpace(_country))
                    {
                        <p class="mt-1 text-xs text-destructive">Please select a country</p>
                    }
                </div>

                @* City *@
                <div>
                    <LabelCn For="city" Class="mb-1.5 block">City</LabelCn>
                    <InputCn id="city" Placeholder="San Francisco" @bind-Value="_city" aria-invalid="@(_submitted && string.IsNullOrWhiteSpace(_city) ? "true" : "false")" />
                    <p class="mt-1 text-xs text-muted-foreground">Your city of residence</p>
                    @if (_submitted && string.IsNullOrWhiteSpace(_city))
                    {
                        <p class="mt-1 text-xs text-destructive">City is required</p>
                    }
                </div>

            </div>

            <div class="mt-6 flex justify-end gap-2">
                <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="HandleCancel">
                    Cancel
                </ButtonCn>
                <ButtonCn Type="submit" Size="ButtonSize.Sm">
                    Create account
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _phone = "";
    private string _country = "";
    private string _city = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        _submitted = true;
    }

    private void HandleCancel()
    {
        _firstName = "";
        _lastName = "";
        _email = "";
        _phone = "";
        _country = "";
        _city = "";
        _submitted = false;
    }
}
