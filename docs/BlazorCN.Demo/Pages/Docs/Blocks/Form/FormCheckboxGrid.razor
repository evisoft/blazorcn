@* ============================================================
   Block: form-checkbox-grid
   Title: FormCheckboxGrid
   Description: A grid of checkboxes arranged in multiple columns instead of a vertical list for efficient space usage
   Source: original/blocks/form/form-checkbox-grid.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Select Your Interests</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose all topics that interest you
            </p>
        </div>
        <form class="p-4">
            <FieldSetCn>
                <FieldLegendCn>Technical interests</FieldLegendCn>
                <FieldDescriptionCn>
                    Select one or more areas you'd like to learn about
                </FieldDescriptionCn>
                <FieldGroupCn Class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                    @foreach (var it in _interests)
                    {
                        var interest = it;
                        <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="@(_submitted && _selectedIds.Count == 0 ? "true" : null)">
                            <CheckboxCn id="@($"interests-{interest.Id}")"
                                        Checked="@(_selectedIds.Contains(interest.Id))"
                                        CheckedChanged="@((bool v) => ToggleInterest(interest.Id, v))" />
                            <FieldLabelCn For="@($"interests-{interest.Id}")" Class="font-normal">
                                @interest.Label
                            </FieldLabelCn>
                        </FieldCn>
                    }
                </FieldGroupCn>
                @if (_submitted && _selectedIds.Count == 0)
                {
                    <FieldErrorCn Errors="@(new[] { "Please select at least one interest" })" />
                }
            </FieldSetCn>
            <div class="mt-6 flex justify-end">
                <ButtonCn type="button" @onclick="SaveInterests">Save Interests</ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private bool _submitted = false;

    private readonly List<string> _selectedIds = new();

    private static readonly Interest[] _interests =
    [
        new Interest("web-dev", "Web Development"),
        new Interest("mobile-dev", "Mobile Apps"),
        new Interest("ui-design", "UI/UX Design"),
        new Interest("data-science", "Data Science"),
        new Interest("machine-learning", "Machine Learning"),
        new Interest("cloud-computing", "Cloud Computing"),
        new Interest("devops", "DevOps"),
        new Interest("security", "Security"),
        new Interest("blockchain", "Blockchain"),
    ];

    private void ToggleInterest(string id, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedIds.Contains(id))
                _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private void SaveInterests()
    {
        _submitted = true;
        // If valid, form is "submitted" (presentational only)
    }

    private record Interest(string Id, string Label);
}
