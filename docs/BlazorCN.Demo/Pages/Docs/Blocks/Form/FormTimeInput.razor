@* ============================================================
   Block: form-time-input
   Title: FormTimeInput
   Description: A time input form with native time picker and timezone selection
   Source: original/blocks/form/form-time-input.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-medium text-sm">Time &amp; Timezone Form</h2>
            </div>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-6">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_timeError) ? "true" : null)">
                    <LabelCn For="time">Select Time</LabelCn>
                    <input id="time"
                           type="time"
                           class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                           value="@_time"
                           aria-invalid="@(_submitted && !string.IsNullOrEmpty(_timeError) ? "true" : null)"
                           @onchange="@((ChangeEventArgs e) => { _time = e.Value?.ToString() ?? ""; _timeError = ValidateTime(_time); })" />
                    <FieldDescriptionCn>
                        Choose a time using the time picker (24-hour format)
                    </FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_timeError))
                    {
                        <FieldErrorCn Errors="@(new[] { _timeError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_timezoneError) ? "true" : null)">
                    <LabelCn For="time-input-timezone">Timezone</LabelCn>
                    <SelectCn @bind-Value="_timezone">
                        <SelectTriggerCn id="time-input-timezone" aria-invalid="@(_submitted && !string.IsNullOrEmpty(_timezoneError) ? "true" : null)">
                            <SelectValueCn Placeholder="Select timezone" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var tz in _timezones)
                            {
                                var tzItem = tz;
                                <SelectItemCn Value="@tzItem.Value">@tzItem.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    <FieldDescriptionCn>
                        Select your timezone for accurate time conversion
                    </FieldDescriptionCn>
                    @if (_submitted && !string.IsNullOrEmpty(_timezoneError))
                    {
                        <FieldErrorCn Errors="@(new[] { _timezoneError })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="Reset">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="Submit">
                        Submit
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _time = "";
    private string _timezone = "";
    private string _timeError = "";
    private string _timezoneError = "";
    private bool _submitted = false;

    private record TimezoneOption(string Value, string Label);

    private static readonly TimezoneOption[] _timezones =
    [
        new("UTC", "UTC (Coordinated Universal Time)"),
        new("America/New_York", "EST (Eastern Standard Time)"),
        new("America/Chicago", "CST (Central Standard Time)"),
        new("America/Denver", "MST (Mountain Standard Time)"),
        new("America/Los_Angeles", "PST (Pacific Standard Time)"),
        new("Europe/London", "GMT (Greenwich Mean Time)"),
        new("Europe/Paris", "CET (Central European Time)"),
        new("Asia/Tokyo", "JST (Japan Standard Time)"),
        new("Australia/Sydney", "AEST (Australian Eastern Time)"),
    ];

    private string ValidateTime(string value)
    {
        if (string.IsNullOrEmpty(value))
            return "Time is required";
        // Basic HH:MM format check
        if (value.Length != 5 || value[2] != ':')
            return "Time must be in valid format (HH:MM)";
        return "";
    }

    private string ValidateTimezone(string value)
    {
        if (string.IsNullOrEmpty(value))
            return "Timezone is required";
        return "";
    }

    private void Reset()
    {
        _time = "";
        _timezone = "";
        _timeError = "";
        _timezoneError = "";
        _submitted = false;
    }

    private void Submit()
    {
        _submitted = true;
        _timeError = ValidateTime(_time);
        _timezoneError = ValidateTimezone(_timezone);
    }
}
