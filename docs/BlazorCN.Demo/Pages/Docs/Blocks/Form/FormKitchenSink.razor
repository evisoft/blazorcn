@* ============================================================
   Block: form-kitchen-sink
   Title: FormKitchenSink
   Description: A comprehensive showcase form demonstrating all field types and patterns including text inputs, selects, checkboxes, radio groups, switches, textareas, and dynamic fields.
   Source: original/blocks/form/form-kitchen-sink.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Kitchen Sink Form</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                A comprehensive example of all form field types
            </p>
        </div>

        <form class="p-4">
            @* Section 1: Basic Information *@
            <fieldset>
                <legend class="text-sm font-semibold">Basic Information</legend>
                <p class="mt-0.5 text-sm text-muted-foreground">Enter your personal details</p>

                <div class="mt-4 space-y-4">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <FieldCn>
                            <FieldLabelCn For="kitchen-sink-firstName">First name</FieldLabelCn>
                            <InputCn id="kitchen-sink-firstName" @bind-Value="_firstName" Placeholder="John" />
                            @if (_submitted && string.IsNullOrWhiteSpace(_firstName))
                            {
                                <FieldErrorCn Errors="@(new[] { "First name is required" })" />
                            }
                        </FieldCn>

                        <FieldCn>
                            <FieldLabelCn For="kitchen-sink-lastName">Last name</FieldLabelCn>
                            <InputCn id="kitchen-sink-lastName" @bind-Value="_lastName" Placeholder="Doe" />
                            @if (_submitted && string.IsNullOrWhiteSpace(_lastName))
                            {
                                <FieldErrorCn Errors="@(new[] { "Last name is required" })" />
                            }
                        </FieldCn>
                    </div>

                    <FieldCn>
                        <FieldLabelCn For="kitchen-sink-email">Email</FieldLabelCn>
                        <InputCn id="kitchen-sink-email" type="email" @bind-Value="_email" Placeholder="@("john.doe@example.com")" />
                        @if (_submitted && !IsValidEmail(_email))
                        {
                            <FieldErrorCn Errors="@(new[] { string.IsNullOrWhiteSpace(_email) ? "Email is required" : "Invalid email address" })" />
                        }
                    </FieldCn>

                    <FieldCn>
                        <FieldLabelCn For="kitchen-sink-age">Age</FieldLabelCn>
                        <InputCn id="kitchen-sink-age" type="number" @bind-Value="_age" Placeholder="25" />
                        <FieldDescriptionCn>You must be 18 or older</FieldDescriptionCn>
                        @if (_submitted && !(int.TryParse(_age, out var ageVal) && ageVal >= 18 && ageVal <= 120))
                        {
                            <FieldErrorCn Errors="@(new[] { int.TryParse(_age, out var av) && av < 18 ? "Must be 18 or older" : "Invalid age" })" />
                        }
                    </FieldCn>
                </div>
            </fieldset>

            <hr class="my-4 border-border" />

            @* Section 2: Selection Fields *@
            <fieldset>
                <legend class="text-sm font-semibold">Selection Fields</legend>
                <p class="mt-0.5 text-sm text-muted-foreground">Choose from dropdown options</p>

                <div class="mt-4 space-y-4">
                    <FieldCn>
                        <FieldLabelCn For="kitchen-sink-country">Country</FieldLabelCn>
                        <SelectCn Value="@_country" ValueChanged="@((string? v) => _country = v ?? "")">
                            <SelectTriggerCn id="kitchen-sink-country">
                                <SelectValueCn Placeholder="Select a country" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var c in _countries)
                                {
                                    var country = c;
                                    <SelectItemCn Value="@country.Value">@country.Label</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                        @if (_submitted && string.IsNullOrEmpty(_country))
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select a country" })" />
                        }
                    </FieldCn>

                    <FieldGroupCn>
                        <FieldLabelCn>Role</FieldLabelCn>
                        <RadioGroupCn Value="@_role" ValueChanged="@((string? v) => _role = v ?? "")" Class="gap-2">
                            @foreach (var r in _roles)
                            {
                                var role = r;
                                <label for="@role.Value"
                                       class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50">
                                    <FieldCn>
                                        <RadioGroupItemCn Value="@role.Value" id="@role.Value" />
                                    </FieldCn>
                                    <span class="text-sm">@role.Label</span>
                                </label>
                            }
                        </RadioGroupCn>
                        @if (_submitted && string.IsNullOrEmpty(_role))
                        {
                            <FieldErrorCn Errors="@(new[] { "Please select a role" })" />
                        }
                    </FieldGroupCn>
                </div>
            </fieldset>

            <hr class="my-4 border-border" />

            @* Section 3: Multiple Choice *@
            <fieldset>
                <legend class="text-sm font-semibold">Interests</legend>
                <p class="mt-0.5 text-sm text-muted-foreground">Select all that apply</p>

                <div class="mt-4">
                    <FieldGroupCn>
                        <div class="grid gap-2 sm:grid-cols-2">
                            @foreach (var opt in _interestOptions)
                            {
                                var interest = opt;
                                <label for="@interest.Value"
                                       class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50">
                                    <FieldCn>
                                        <CheckboxCn id="@interest.Value"
                                                    Checked="@(_selectedInterests.Contains(interest.Value))"
                                                    CheckedChanged="@((bool v) => ToggleInterest(interest.Value, v))" />
                                    </FieldCn>
                                    <span class="text-sm">@interest.Label</span>
                                </label>
                            }
                        </div>
                        <FieldDescriptionCn Class="mt-2">
                            @_selectedInterests.Count selected
                        </FieldDescriptionCn>
                        @if (_submitted && _selectedInterests.Count == 0)
                        {
                            <FieldErrorCn Errors="@(new[] { "Select at least one interest" })" />
                        }
                    </FieldGroupCn>
                </div>
            </fieldset>

            <hr class="my-4 border-border" />

            @* Section 4: Preferences & Toggles *@
            <fieldset>
                <legend class="text-sm font-semibold">Preferences</legend>
                <p class="mt-0.5 text-sm text-muted-foreground">Configure your account settings</p>

                <div class="mt-4 space-y-2">
                    <div class="flex items-center justify-between rounded-md px-3 py-3 transition-colors hover:bg-muted/50">
                        <div>
                            <p class="font-medium text-sm">Newsletter subscription</p>
                            <p class="text-muted-foreground text-xs">Receive our weekly newsletter</p>
                        </div>
                        <SwitchCn Checked="@_newsletter" CheckedChanged="@((bool v) => _newsletter = v)" aria-label="Newsletter subscription" />
                    </div>

                    <div class="flex items-center justify-between rounded-md px-3 py-3 transition-colors hover:bg-muted/50">
                        <div>
                            <p class="font-medium text-sm">Push notifications</p>
                            <p class="text-muted-foreground text-xs">Get notified about updates</p>
                        </div>
                        <SwitchCn Checked="@_notifications" CheckedChanged="@((bool v) => _notifications = v)" aria-label="Push notifications" />
                    </div>

                    <div class="flex items-center justify-between rounded-md px-3 py-3 transition-colors hover:bg-muted/50">
                        <div>
                            <p class="font-medium text-sm">Dark mode</p>
                            <p class="text-muted-foreground text-xs">Use dark theme</p>
                        </div>
                        <SwitchCn Checked="@_darkMode" CheckedChanged="@((bool v) => _darkMode = v)" aria-label="Dark mode" />
                    </div>
                </div>
            </fieldset>

            <hr class="my-4 border-border" />

            @* Section 5: Long Text *@
            <fieldset>
                <legend class="text-sm font-semibold">About You</legend>
                <p class="mt-0.5 text-sm text-muted-foreground">Tell us about yourself</p>

                <div class="mt-4">
                    <FieldCn>
                        <FieldLabelCn For="kitchen-sink-bio">Bio</FieldLabelCn>
                        <TextareaCn id="kitchen-sink-bio" @bind-Value="_bio" Placeholder="Write a short bio..." Rows="4" />
                        <FieldDescriptionCn>@_bio.Length / 500 characters</FieldDescriptionCn>
                        @if (_submitted && (_bio.Length < 10 || _bio.Length > 500))
                        {
                            <FieldErrorCn Errors="@(new[] { _bio.Length < 10 ? "Bio must be at least 10 characters" : "Bio must not exceed 500 characters" })" />
                        }
                    </FieldCn>
                </div>
            </fieldset>

            <hr class="my-4 border-border" />

            @* Section 6: Dynamic Fields *@
            <fieldset>
                <legend class="text-sm font-semibold">Skills</legend>
                <p class="mt-0.5 text-sm text-muted-foreground">Add your technical skills</p>

                <div class="mt-4 space-y-3">
                    @foreach (var sk in _skills)
                    {
                        var skill = sk;
                        <div class="rounded-lg border bg-muted/30 p-3">
                            <div class="mb-3 flex items-center justify-between">
                                <p class="font-medium text-sm">Skill @(skill.Index)</p>
                                @if (_skills.Count > 1)
                                {
                                    <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0"
                                              aria-label="@($"Remove skill {skill.Index}")"
                                              @onclick="@(() => RemoveSkill(skill.Id))">
                                        <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                }
                            </div>

                            <div class="grid gap-3 sm:grid-cols-2">
                                <FieldCn>
                                    <FieldLabelCn For="@($"skill-name-{skill.Id}")" Class="text-xs">Skill name</FieldLabelCn>
                                    <InputCn id="@($"skill-name-{skill.Id}")"
                                             Value="@skill.Name"
                                             ValueChanged="@((string v) => UpdateSkillName(skill.Id, v))"
                                             Placeholder="e.g. React"
                                             Class="h-8 text-sm" />
                                    @if (_submitted && string.IsNullOrWhiteSpace(skill.Name))
                                    {
                                        <FieldErrorCn Errors="@(new[] { "Skill name is required" })" />
                                    }
                                </FieldCn>

                                <FieldCn>
                                    <FieldLabelCn For="@($"skill-level-{skill.Id}")" Class="text-xs">Skill level</FieldLabelCn>
                                    <SelectCn Value="@skill.Level" ValueChanged="@((string? v) => UpdateSkillLevel(skill.Id, v ?? "beginner"))">
                                        <SelectTriggerCn id="@($"skill-level-{skill.Id}")" Class="h-8 text-sm">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var lvl in _skillLevels)
                                            {
                                                var level = lvl;
                                                <SelectItemCn Value="@level.Value">@level.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </FieldCn>
                            </div>
                        </div>
                    }

                    <ButtonCn type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full gap-1.5"
                              @onclick="AddSkill">
                        <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                        Add skill
                    </ButtonCn>

                    @if (_submitted && _skills.Count == 0)
                    {
                        <FieldErrorCn Errors="@(new[] { "Add at least one skill" })" />
                    }
                </div>
            </fieldset>

            <div class="mt-6 flex gap-3">
                <ButtonCn type="button" Variant="ButtonVariant.Outline" Class="flex-1" @onclick="CancelForm">
                    Cancel
                </ButtonCn>
                <ButtonCn type="button" Class="flex-1" @onclick="SubmitForm">
                    Submit form
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private static readonly OptionItem[] _countries =
    [
        new("us", "United States"),
        new("uk", "United Kingdom"),
        new("ca", "Canada"),
        new("au", "Australia"),
    ];

    private static readonly OptionItem[] _roles =
    [
        new("developer", "Software Developer"),
        new("designer", "UI/UX Designer"),
        new("manager", "Product Manager"),
        new("other", "Other"),
    ];

    private static readonly OptionItem[] _interestOptions =
    [
        new("web", "Web Development"),
        new("mobile", "Mobile Development"),
        new("design", "Design"),
        new("data", "Data Science"),
        new("devops", "DevOps"),
        new("ai", "AI/Machine Learning"),
    ];

    private static readonly OptionItem[] _skillLevels =
    [
        new("beginner", "Beginner"),
        new("intermediate", "Intermediate"),
        new("advanced", "Advanced"),
    ];

    // Basic Information
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _age = "";

    // Selection Fields
    private string _country = "";
    private string _role = "";

    // Multiple Choice
    private List<string> _selectedInterests = new();

    // Preferences
    private bool _newsletter = false;
    private bool _notifications = true;
    private bool _darkMode = false;

    // Additional Information
    private string _bio = "";

    // Dynamic Fields
    private int _nextSkillId = 2;
    private List<SkillItem> _skills = new()
    {
        new SkillItem { Id = 1, Index = 1, Name = "React", Level = "advanced" }
    };

    private bool _submitted = false;

    private void ToggleInterest(string value, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedInterests.Contains(value))
                _selectedInterests.Add(value);
        }
        else
        {
            _selectedInterests.Remove(value);
        }
    }

    private void AddSkill()
    {
        _skills.Add(new SkillItem { Id = _nextSkillId, Index = _skills.Count + 1, Name = "", Level = "beginner" });
        _nextSkillId++;
    }

    private void RemoveSkill(int id)
    {
        _skills.RemoveAll(x => x.Id == id);
        for (int i = 0; i < _skills.Count; i++)
            _skills[i].Index = i + 1;
    }

    private void UpdateSkillName(int id, string value)
    {
        var skill = _skills.FirstOrDefault(x => x.Id == id);
        if (skill is not null)
            skill.Name = value;
    }

    private void UpdateSkillLevel(int id, string value)
    {
        var skill = _skills.FirstOrDefault(x => x.Id == id);
        if (skill is not null)
            skill.Level = value;
    }

    private void SubmitForm()
    {
        _submitted = true;
        // Presentational only — would process form data if valid
    }

    private void CancelForm()
    {
        _submitted = false;
        _firstName = "";
        _lastName = "";
        _email = "";
        _age = "";
        _country = "";
        _role = "";
        _selectedInterests = new();
        _newsletter = false;
        _notifications = true;
        _darkMode = false;
        _bio = "";
        _nextSkillId = 2;
        _skills = new()
        {
            new SkillItem { Id = 1, Index = 1, Name = "React", Level = "advanced" }
        };
    }

    private static bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        var atIndex = email.IndexOf('@');
        if (atIndex <= 0) return false;
        var dotIndex = email.LastIndexOf('.');
        return dotIndex > atIndex + 1 && dotIndex < email.Length - 1;
    }

    private record OptionItem(string Value, string Label);

    private class SkillItem
    {
        public int Id { get; set; }
        public int Index { get; set; }
        public string Name { get; set; } = "";
        public string Level { get; set; } = "beginner";
    }
}
