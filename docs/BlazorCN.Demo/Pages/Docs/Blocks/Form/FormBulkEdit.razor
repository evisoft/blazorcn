@* ============================================================
   Block: form-bulk-edit
   Title: FormBulkEdit
   Description: A bulk edit form for editing multiple items at once with table-like layout and batch actions
   Source: original/blocks/form/form-bulk-edit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Bulk Edit Products</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Edit multiple products at once</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">
                    @(_selectedCount) of @(_items.Count) selected
                </p>
                @if (_selectedCount > 0)
                {
                    <div class="flex items-center gap-2">
                        <span class="text-muted-foreground text-xs">Apply to selected:</span>
                        <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => ApplyToSelected("active"))">
                            Set Active
                        </ButtonCn>
                        <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => ApplyToSelected("inactive"))">
                            Set Inactive
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            @* Header Row *@
            <div class="mb-2 grid grid-cols-[auto,1fr,180px,auto] items-center gap-3 px-2">
                <div class="w-4"></div>
                <span class="font-medium text-muted-foreground text-xs">Name</span>
                <span class="font-medium text-muted-foreground text-xs">Status</span>
                <div class="w-8"></div>
            </div>

            @* Data Rows *@
            <div class="space-y-2">
                @foreach (var it in _items)
                {
                    var item = it;
                    <div class="grid grid-cols-[auto,1fr,180px,auto] items-start gap-3 rounded-md border bg-muted/50 p-2">
                        @* Select Checkbox *@
                        <div class="pt-2">
                            <label class="flex cursor-pointer items-center">
                                <input type="checkbox" aria-label="@($"Select {item.Name}")" checked="@item.Selected" @onchange="@((e) => ToggleSelected(item.Id, (bool)(e.Value ?? false)))" class="size-4 cursor-pointer rounded border-input" />
                            </label>
                        </div>

                        @* Name Input *@
                        <div>
                            <InputCn aria-label="Product name" Value="@item.Name" @oninput="@((e) => UpdateName(item.Id, e.Value?.ToString() ?? ""))" Placeholder="Product name" Class="h-8" />
                            @if (string.IsNullOrWhiteSpace(item.Name))
                            {
                                <p class="mt-1 text-xs text-destructive">Name is required</p>
                            }
                        </div>

                        @* Status Select *@
                        <div>
                            <SelectCn Value="@item.Status" ValueChanged="@((v) => UpdateStatus(item.Id, v))">
                                <SelectTriggerCn Class="h-8" aria-label="@($"Status for {item.Name}")">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="active">Active</SelectItemCn>
                                    <SelectItemCn Value="pending">Pending</SelectItemCn>
                                    <SelectItemCn Value="inactive">Inactive</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        @* Remove Button *@
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0" aria-label="@($"Remove {item.Name}")" @onclick="@(() => RemoveItem(item.Id))">
                            <LucideIconCn Name="trash" Size="16" Class="size-4 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 px-4 py-3">
            <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                Cancel
            </ButtonCn>
            <ButtonCn Type="submit" Size="ButtonSize.Sm" Disabled="@_submitted" @onclick="HandleSubmit">
                @if (_submitted)
                {
                    <LucideIconCn Name="check" Size="14" Class="mr-1.5 size-3.5" />
                    <span>Saved</span>
                }
                else
                {
                    <span>Save Changes</span>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BulkItem(string Id, string Name, string Status, bool Selected);

    private List<BulkItem> _items =
    [
        new("1", "Product Alpha", "active", false),
        new("2", "Product Beta", "pending", false),
        new("3", "Product Gamma", "active", false),
        new("4", "Product Delta", "inactive", false),
    ];

    private bool _submitted;

    private int _selectedCount => _items.Count(i => i.Selected);

    private void ToggleSelected(string id, bool value)
    {
        _items = _items.Select(i => i.Id == id ? i with { Selected = value } : i).ToList();
    }

    private void UpdateName(string id, string value)
    {
        _items = _items.Select(i => i.Id == id ? i with { Name = value } : i).ToList();
    }

    private void UpdateStatus(string id, string value)
    {
        _items = _items.Select(i => i.Id == id ? i with { Status = value } : i).ToList();
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
    }

    private void ApplyToSelected(string status)
    {
        _items = _items.Select(i => i.Selected ? i with { Status = status } : i).ToList();
    }

    private async Task HandleSubmit()
    {
        _submitted = true;
        StateHasChanged();
        await Task.Delay(2000);
        _submitted = false;
    }
}
