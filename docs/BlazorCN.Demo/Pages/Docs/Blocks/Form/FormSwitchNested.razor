@* ============================================================
   Block: form-switch-nested
   Title: FormSwitchNested
   Description: A switch that reveals additional form fields when enabled with conditional rendering
   Source: original/blocks/form/form-switch-nested.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Notification Settings</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure how you receive notifications
            </p>
        </div>

        <form class="p-4">
            <div class="space-y-4">
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <FieldContentCn>
                        <LabelCn For="enableNotifications">Enable Notifications</LabelCn>
                        <FieldDescriptionCn>
                            Receive email notifications for important updates
                        </FieldDescriptionCn>
                    </FieldContentCn>
                    <SwitchCn id="enableNotifications" Checked="@_enableNotifications" CheckedChanged="@((bool v) => _enableNotifications = v)" />
                </FieldCn>

                @if (_enableNotifications)
                {
                    <div class="space-y-4 rounded-md border bg-muted/50 p-4">
                        <FieldCn>
                            <LabelCn For="switch-nested-email">Email Address</LabelCn>
                            <InputCn id="switch-nested-email" type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                            <FieldDescriptionCn>We'll send notifications to this address</FieldDescriptionCn>
                        </FieldCn>

                        <FieldCn>
                            <LabelCn For="frequency">Frequency</LabelCn>
                            <SelectCn Value="@_frequency" ValueChanged="@((string? v) => _frequency = v ?? "daily")">
                                <SelectTriggerCn id="frequency" Class="w-full">
                                    <SelectValueCn Placeholder="Select frequency" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="instant">Instant (as it happens)</SelectItemCn>
                                    <SelectItemCn Value="daily">Daily digest</SelectItemCn>
                                    <SelectItemCn Value="weekly">Weekly summary</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            <FieldDescriptionCn>
                                How often you want to receive notifications
                            </FieldDescriptionCn>
                        </FieldCn>

                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <FieldContentCn>
                                <LabelCn For="includeDigest">Include Digest</LabelCn>
                                <FieldDescriptionCn>Add a summary of recent activity</FieldDescriptionCn>
                            </FieldContentCn>
                            <SwitchCn id="includeDigest" Checked="@_includeDigest" CheckedChanged="@((bool v) => _includeDigest = v)" />
                        </FieldCn>
                    </div>
                }
            </div>

            <div class="mt-4 flex items-center justify-end gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button" @onclick="Cancel">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" type="button" @onclick="SaveSettings">
                    Save Settings
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private bool _enableNotifications = false;
    private string _email = "";
    private string _frequency = "daily";
    private bool _includeDigest = false;

    private void Cancel()
    {
        _enableNotifications = false;
        _email = "";
        _frequency = "daily";
        _includeDigest = false;
    }

    private void SaveSettings()
    {
        // Handle form submission (presentational only)
    }
}
