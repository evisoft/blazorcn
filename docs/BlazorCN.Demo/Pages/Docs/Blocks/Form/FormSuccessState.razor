@* ============================================================
   Block: form-success-state
   Title: FormSuccessState
   Description: A form that transitions to a success confirmation view after submission
   Source: original/blocks/form/form-success-state.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Request Enterprise Demo</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @(_viewState == "form"
                    ? "Fill out the form to schedule a personalized demo"
                    : "Your demo request has been received")
            </p>
        </div>

        @if (_viewState == "form")
        {
            <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <div class="space-y-4">
                    <FieldCn>
                        <FieldLabelCn For="companyName">Company Name</FieldLabelCn>
                        <InputCn id="companyName" @bind-Value="_companyName" Placeholder="Acme Corporation" />
                        @if (_errors.ContainsKey("companyName"))
                        {
                            <FieldErrorCn>@_errors["companyName"]</FieldErrorCn>
                        }
                    </FieldCn>

                    <FieldCn>
                        <FieldLabelCn For="contactName">Contact Name</FieldLabelCn>
                        <InputCn id="contactName" @bind-Value="_contactName" Placeholder="John Smith" />
                        @if (_errors.ContainsKey("contactName"))
                        {
                            <FieldErrorCn>@_errors["contactName"]</FieldErrorCn>
                        }
                    </FieldCn>

                    <FieldCn>
                        <FieldLabelCn For="email">Work Email</FieldLabelCn>
                        <InputCn id="email" type="email" @bind-Value="_email" Placeholder="@("john@acme.com")" />
                        <FieldDescriptionCn>Use your company email address</FieldDescriptionCn>
                        @if (_errors.ContainsKey("email"))
                        {
                            <FieldErrorCn>@_errors["email"]</FieldErrorCn>
                        }
                    </FieldCn>

                    <FieldCn>
                        <FieldLabelCn For="employeeCount">Company Size</FieldLabelCn>
                        <SelectCn Value="@_employeeCount" ValueChanged="@((string? v) => _employeeCount = v ?? "")">
                            <SelectTriggerCn id="employeeCount">
                                <SelectValueCn Placeholder="Select employee count" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="1-10">1-10 employees</SelectItemCn>
                                <SelectItemCn Value="11-50">11-50 employees</SelectItemCn>
                                <SelectItemCn Value="51-200">51-200 employees</SelectItemCn>
                                <SelectItemCn Value="201-1000">201-1,000 employees</SelectItemCn>
                                <SelectItemCn Value="1000+">1,000+ employees</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        @if (_errors.ContainsKey("employeeCount"))
                        {
                            <FieldErrorCn>@_errors["employeeCount"]</FieldErrorCn>
                        }
                    </FieldCn>

                    <FieldCn>
                        <FieldLabelCn For="phone">Phone Number</FieldLabelCn>
                        <InputCn id="phone" type="tel" @bind-Value="_phone" Placeholder="+1 (555) 000-0000" />
                        <FieldDescriptionCn>We'll call to schedule your demo</FieldDescriptionCn>
                        @if (_errors.ContainsKey("phone"))
                        {
                            <FieldErrorCn>@_errors["phone"]</FieldErrorCn>
                        }
                    </FieldCn>

                    <div class="flex justify-end gap-2 pt-2">
                        <ButtonCn type="button" Variant="ButtonVariant.Outline">
                            Cancel
                        </ButtonCn>
                        <ButtonCn type="submit">Request Demo</ButtonCn>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="flex min-h-[400px] flex-col items-center justify-center p-4 text-center">
                <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle-2" Size="32" Class="size-8 text-emerald-600" />
                </div>
                <h3 class="mb-2 text-lg font-semibold">Demo Request Submitted</h3>
                <p class="mb-6 max-w-md text-sm text-muted-foreground">
                    Thank you for your interest, @_submittedContactName. Our sales team will contact
                    you at <span class="font-medium text-foreground">@_submittedEmail</span>
                    within 24 hours to schedule your personalized demo.
                </p>
                <div class="flex gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="HandleReset">
                        Submit Another Request
                    </ButtonCn>
                    <ButtonCn type="button">
                        Return to Dashboard
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _viewState = "form";
    private string _companyName = "";
    private string _contactName = "";
    private string _email = "";
    private string _employeeCount = "";
    private string _phone = "";
    private string _submittedContactName = "";
    private string _submittedEmail = "";
    private Dictionary<string, string> _errors = new();

    private bool Validate()
    {
        _errors = new Dictionary<string, string>();

        if (_companyName.Length < 2)
            _errors["companyName"] = "Company name is required";

        if (_contactName.Length < 2)
            _errors["contactName"] = "Contact name is required";

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
            _errors["email"] = "Invalid email address";

        if (string.IsNullOrWhiteSpace(_employeeCount))
            _errors["employeeCount"] = "Please select company size";

        if (_phone.Length < 10)
            _errors["phone"] = "Phone number must be at least 10 digits";

        return _errors.Count == 0;
    }

    private async Task HandleSubmit()
    {
        if (!Validate()) return;

        // Simulate API call
        await Task.Delay(1000);

        _submittedContactName = _contactName;
        _submittedEmail = _email;
        _viewState = "success";
    }

    private void HandleReset()
    {
        _viewState = "form";
        _companyName = "";
        _contactName = "";
        _email = "";
        _employeeCount = "";
        _phone = "";
        _submittedContactName = "";
        _submittedEmail = "";
        _errors = new Dictionary<string, string>();
    }
}
