@* ============================================================
   Block: form-error-state
   Title: FormErrorState
   Description: A form demonstrating error handling with a dismissible error banner and retry functionality
   Source: original/blocks/form/form-error-state.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Create New Project</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Deploy your application from a Git repository
            </p>
        </div>

        <form class="p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            @if (_error != null)
            {
                <div class="mb-4 rounded-md border border-destructive/20 bg-destructive/10 p-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="alert-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-destructive" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm text-destructive">@_error</p>
                        </div>
                        <button
                            type="button"
                            @onclick="@(() => _error = null)"
                            aria-label="Dismiss error"
                            class="shrink-0 rounded-sm p-0.5 text-destructive/60 transition-colors hover:text-destructive">
                            <LucideIconCn Name="x" Size="16" Class="size-4" />
                        </button>
                    </div>
                    <div class="ml-7 mt-2">
                        <ButtonCn type="submit" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@_isSubmitting">
                            Try Again
                        </ButtonCn>
                    </div>
                </div>
            }

            <div class="space-y-4">
                <FieldCn>
                    <FieldLabelCn For="error-state-projectName">Project Name</FieldLabelCn>
                    <InputCn id="error-state-projectName" @bind-Value="_projectName" Placeholder="my-awesome-project" Disabled="@_isSubmitting" />
                    <FieldDescriptionCn>Choose a unique name for your project</FieldDescriptionCn>
                    @if (_errors.ContainsKey("projectName"))
                    {
                        <FieldErrorCn>@_errors["projectName"]</FieldErrorCn>
                    }
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="repository">Repository URL</FieldLabelCn>
                    <InputCn id="repository" @bind-Value="_repository" Placeholder="@("https://github.com/username/repo")" Disabled="@_isSubmitting" />
                    <FieldDescriptionCn>GitHub, GitLab, or Bitbucket repository</FieldDescriptionCn>
                    @if (_errors.ContainsKey("repository"))
                    {
                        <FieldErrorCn>@_errors["repository"]</FieldErrorCn>
                    }
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="error-state-framework">Framework</FieldLabelCn>
                    <SelectCn Value="@_framework" ValueChanged="@((string? v) => _framework = v ?? "")" Disabled="@_isSubmitting">
                        <SelectTriggerCn id="error-state-framework">
                            <SelectValueCn Placeholder="Select framework" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="nextjs">Next.js</SelectItemCn>
                            <SelectItemCn Value="react">React</SelectItemCn>
                            <SelectItemCn Value="vue">Vue</SelectItemCn>
                            <SelectItemCn Value="svelte">Svelte</SelectItemCn>
                            <SelectItemCn Value="astro">Astro</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    @if (_errors.ContainsKey("framework"))
                    {
                        <FieldErrorCn>@_errors["framework"]</FieldErrorCn>
                    }
                </FieldCn>

                <FieldCn>
                    <FieldLabelCn For="error-state-description">Description</FieldLabelCn>
                    <TextareaCn id="error-state-description" @bind-Value="_description" Placeholder="Describe your project and its purpose" Class="min-h-[100px] resize-none" Disabled="@_isSubmitting" />
                    <FieldDescriptionCn>Help others understand what your project does</FieldDescriptionCn>
                    @if (_errors.ContainsKey("description"))
                    {
                        <FieldErrorCn>@_errors["description"]</FieldErrorCn>
                    }
                </FieldCn>

                <div class="flex justify-end gap-2 pt-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" Disabled="@_isSubmitting">
                        Cancel
                    </ButtonCn>
                    <ButtonCn type="submit" Disabled="@_isSubmitting">
                        @(_isSubmitting ? "Creating..." : "Create Project")
                    </ButtonCn>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private string _projectName = "";
    private string _repository = "";
    private string _framework = "";
    private string _description = "";
    private string? _error = null;
    private bool _isSubmitting = false;
    private Dictionary<string, string> _errors = new();

    private bool Validate()
    {
        _errors = new Dictionary<string, string>();

        if (_projectName.Length < 3)
            _errors["projectName"] = "Project name must be at least 3 characters";

        if (string.IsNullOrWhiteSpace(_repository) || !Uri.TryCreate(_repository, UriKind.Absolute, out _))
            _errors["repository"] = "Must be a valid repository URL";

        if (string.IsNullOrWhiteSpace(_framework))
            _errors["framework"] = "Please select a framework";

        if (_description.Length < 20)
            _errors["description"] = "Description must be at least 20 characters";

        return _errors.Count == 0;
    }

    private async Task HandleSubmit()
    {
        if (!Validate()) return;

        _isSubmitting = true;
        _error = null;

        // Simulate API call
        await Task.Delay(1500);

        // Simulate 70% chance of error
        var rnd = new Random();
        if (rnd.NextDouble() > 0.3)
        {
            _error = "Failed to create project. The repository URL may be invalid or our servers are experiencing issues. Please try again.";
            _isSubmitting = false;
            return;
        }

        _isSubmitting = false;
        _projectName = "";
        _repository = "";
        _framework = "";
        _description = "";
    }
}
