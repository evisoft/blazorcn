@* ============================================================
   Block: form-array-fields
   Title: FormArrayFields
   Description: A dynamic form with an array of text fields that can be added or removed using React Hook Form's useFieldArray
   Source: original/blocks/form/form-array-fields.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Shopping List</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Add items you need to purchase</p>
        </div>

        <div class="p-4">
            <FieldSetCn>
                <div class="space-y-3">
                    @foreach (var it in _items)
                    {
                        var item = it;
                        <div class="flex items-end gap-2">
                            <FieldCn Class="flex-1">
                                <FieldLabelCn For="@($"item-{item.Id}")">Item @item.Index</FieldLabelCn>
                                <InputCn id="@($"item-{item.Id}")"
                                         Value="@item.Value"
                                         ValueChanged="@((string v) => UpdateItem(item.Id, v))"
                                         Placeholder="Enter item name" />
                                @if (item.HasError)
                                {
                                    <FieldErrorCn Errors="@(new[] { "This field is required" })" />
                                }
                            </FieldCn>
                            @if (_items.Count > 1)
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-9" type="button"
                                          @onclick="@(() => RemoveItem(item.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="size-4" />
                                </ButtonCn>
                            }
                        </div>
                    }
                </div>

                @if (_rootError)
                {
                    <FieldErrorCn Class="mt-2" Errors="@(new[] { "Add at least one item" })" />
                }

                <FieldDescriptionCn Class="mt-3">
                    Click the plus button to add more items to your list
                </FieldDescriptionCn>

                <div class="mt-4 flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button"
                              @onclick="AddItem">
                        <LucideIconCn Name="plus" Size="16" Class="mr-1 size-4" /> Add Item
                    </ButtonCn>
                </div>

                <div class="mt-6 flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveList">
                        Save List
                    </ButtonCn>
                </div>
            </FieldSetCn>
        </div>
    </div>
</section>

@code {
    private int _nextId = 2;
    private bool _rootError = false;

    private List<FieldItem> _items = new()
    {
        new FieldItem { Id = 1, Index = 1, Value = "", HasError = false }
    };

    private void AddItem()
    {
        _rootError = false;
        _items.Add(new FieldItem { Id = _nextId, Index = _items.Count + 1, Value = "", HasError = false });
        _nextId++;
    }

    private void RemoveItem(int id)
    {
        _items.RemoveAll(x => x.Id == id);
        RenumberItems();
        _rootError = false;
    }

    private void UpdateItem(int id, string value)
    {
        var item = _items.FirstOrDefault(x => x.Id == id);
        if (item is not null)
        {
            item.Value = value;
            item.HasError = string.IsNullOrEmpty(value);
        }
    }

    private void RenumberItems()
    {
        for (int i = 0; i < _items.Count; i++)
            _items[i].Index = i + 1;
    }

    private void SaveList()
    {
        bool valid = true;
        foreach (var item in _items)
        {
            item.HasError = string.IsNullOrEmpty(item.Value);
            if (item.HasError) valid = false;
        }
        if (_items.Count == 0)
        {
            _rootError = true;
            valid = false;
        }
        // If valid, form is "submitted" (presentational only)
    }

    private void ResetForm()
    {
        _nextId = 2;
        _rootError = false;
        _items = new()
        {
            new FieldItem { Id = 1, Index = 1, Value = "", HasError = false }
        };
    }

    private class FieldItem
    {
        public int Id { get; set; }
        public int Index { get; set; }
        public string Value { get; set; } = "";
        public bool HasError { get; set; }
    }
}
