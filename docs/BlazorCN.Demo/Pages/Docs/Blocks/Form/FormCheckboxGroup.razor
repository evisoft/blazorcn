@* ============================================================
   Block: form-checkbox-group
   Title: FormCheckboxGroup
   Description: A checkbox group form with multiple options demonstrating array field validation
   Source: original/blocks/form/form-checkbox-group.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Select Your Interests</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose at least one area you're interested in
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldSetCn>
                    <FieldLegendCn>Areas of Interest</FieldLegendCn>
                    <FieldGroupCn data-slot="checkbox-group">
                        @foreach (var it in _interests)
                        {
                            var item = it;
                            <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="@(_submitted && _hasError ? "true" : null)">
                                <CheckboxCn id="@($"selectedInterests-{item.Id}")"
                                            Checked="@(_selectedInterests.Contains(item.Id))"
                                            CheckedChanged="@((bool v) => ToggleInterest(item.Id, v))" />
                                <LabelCn For="@($"selectedInterests-{item.Id}")" Class="font-normal">
                                    @item.Label
                                </LabelCn>
                            </FieldCn>
                        }
                    </FieldGroupCn>
                    @if (_submitted && _hasError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select at least one interest" })" />
                    }
                </FieldSetCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ClearForm">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SavePreferences">
                        Save Preferences
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private static readonly InterestItem[] _interests =
    [
        new InterestItem("design", "UI/UX Design"),
        new InterestItem("development", "Web Development"),
        new InterestItem("marketing", "Digital Marketing"),
        new InterestItem("analytics", "Data Analytics"),
        new InterestItem("content", "Content Writing"),
        new InterestItem("strategy", "Business Strategy"),
    ];

    private List<string> _selectedInterests = new();
    private bool _submitted = false;
    private bool _hasError => _selectedInterests.Count == 0;

    private void ToggleInterest(string id, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedInterests.Contains(id))
                _selectedInterests.Add(id);
        }
        else
        {
            _selectedInterests.Remove(id);
        }
    }

    private void ClearForm()
    {
        _selectedInterests = new();
        _submitted = false;
    }

    private void SavePreferences()
    {
        _submitted = true;
        // If valid (_selectedInterests.Count > 0), form is "submitted" (presentational only)
    }

    private record InterestItem(string Id, string Label);
}
