@* ============================================================
   Block: form-multi-select
   Title: FormMultiSelect
   Description: A multi-select form using checkboxes inside a popover to select multiple items with badge display
   Source: original/blocks/form/form-multi-select.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Select Your Skills</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose one or more skills from the list
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && _hasError ? "true" : null)">
                    <LabelCn For="skills">Skills</LabelCn>
                    <PopoverCn>
                        <PopoverTriggerCn id="skills" Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default h-auto min-h-10 w-full justify-between" data-variant="outline" data-size="default" aria-invalid="@(_submitted && _hasError ? "true" : null)">
                            @if (_selectedSkills.Count > 0)
                            {
                                <span>@_selectedSkills.Count selected</span>
                            }
                            else
                            {
                                <span class="text-muted-foreground">Select skills...</span>
                            }
                            <LucideIconCn Name="chevrons-up-down" Size="16" Class="ml-2 size-4 shrink-0 opacity-50" />
                        </PopoverTriggerCn>
                        <PopoverContentCn Align="FloatingAlign.Start" Class="w-full p-0">
                            <CommandCn>
                                <CommandInputCn Placeholder="Search skills..." />
                                <CommandListCn>
                                    <CommandEmptyCn>No skill found.</CommandEmptyCn>
                                    <CommandGroupCn>
                                        @foreach (var it in _skills)
                                        {
                                            var skill = it;
                                            var isSelected = _selectedSkills.Contains(skill.Value);
                                            <CommandItemCn OnSelect="@(() => ToggleSkill(skill.Value))">
                                                <div class="@Cn.Merge("mr-2 flex size-4 items-center justify-center rounded-sm border border-primary", isSelected ? "bg-primary text-primary-foreground" : "opacity-50 [&_svg]:invisible")">
                                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                </div>
                                                @skill.Label
                                            </CommandItemCn>
                                        }
                                    </CommandGroupCn>
                                </CommandListCn>
                            </CommandCn>
                        </PopoverContentCn>
                    </PopoverCn>
                    @* The removable chips live OUTSIDE the popover trigger: a <button> may not contain
                       other interactive elements (invalid HTML, axe nested-interactive, double tab stop). *@
                    @if (_selectedSkills.Count > 0)
                    {
                        <div class="flex flex-wrap gap-2">
                            @foreach (var it in _selectedSkills)
                            {
                                var skillValue = it;
                                var skill = Array.Find(_skills, s => s.Value == skillValue);
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-6 gap-1 pr-1">
                                    @skill?.Label
                                    <button type="button"
                                            class="inline-flex size-6 shrink-0 items-center justify-center rounded-full outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring/50"
                                            @onclick="@(() => RemoveSkill(skillValue))"
                                            aria-label="@($"Remove {skill?.Label}")">
                                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                                    </button>
                                </BadgeCn>
                            }
                        </div>
                    }
                    <FieldDescriptionCn>Select multiple skills that match your expertise</FieldDescriptionCn>
                    @if (_submitted && _hasError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select at least one skill" })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" @onclick="ClearForm">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SaveSkills">
                        Save Skills
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record SkillItem(string Value, string Label);

    private static readonly SkillItem[] _skills =
    [
        new("react",      "React"),
        new("typescript", "TypeScript"),
        new("javascript", "JavaScript"),
        new("nodejs",     "Node.js"),
        new("python",     "Python"),
        new("java",       "Java"),
        new("go",         "Go"),
        new("rust",       "Rust"),
        new("sql",        "SQL"),
        new("docker",     "Docker"),
    ];

    private List<string> _selectedSkills = new();
    private bool _submitted = false;
    private bool _hasError => _selectedSkills.Count == 0;

    private void ToggleSkill(string value)
    {
        if (_selectedSkills.Contains(value))
            _selectedSkills.Remove(value);
        else
            _selectedSkills.Add(value);
    }

    private void RemoveSkill(string value)
    {
        _selectedSkills.Remove(value);
    }

    private void ClearForm()
    {
        _selectedSkills = new();
        _submitted = false;
    }

    private void SaveSkills()
    {
        _submitted = true;
        // If valid (_selectedSkills.Count > 0), form is "submitted" (presentational only)
    }
}
