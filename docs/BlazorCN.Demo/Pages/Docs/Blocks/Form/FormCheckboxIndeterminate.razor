@* ============================================================
   Block: form-checkbox-indeterminate
   Title: FormCheckboxIndeterminate
   Description: A checkbox form with parent-child relationships demonstrating indeterminate state management
   Source: original/blocks/form/form-checkbox-indeterminate.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Set User Permissions</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Configure access levels for this user
            </p>
        </div>
        <div class="px-4 py-4">
            <div class="space-y-4">
                <FieldSetCn>
                    <FieldLegendCn>Access Permissions</FieldLegendCn>
                    <FieldGroupCn data-slot="checkbox-group">
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            @* Parent checkbox — rendered manually to support indeterminate visual *@
                            <button type="button"
                                    role="checkbox"
                                    id="select-all"
                                    aria-checked="@(_parentIndeterminate ? "mixed" : _parentChecked.ToString().ToLowerInvariant())"
                                    data-slot="checkbox"
                                    data-state="@(_parentChecked ? "checked" : "unchecked")"
                                    class="cn-checkbox peer shrink-0 outline-none"
                                    @onclick="HandleParentChange">
                                @if (_parentIndeterminate)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                }
                                else if (_parentChecked)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M20 6 9 17l-5-5"/></svg>
                                }
                            </button>
                            <FieldLabelCn For="select-all" Class="font-medium">
                                Select All Permissions
                            </FieldLabelCn>
                        </FieldCn>

                        <div class="ml-6 space-y-3">
                            @foreach (var perm in _permissions)
                            {
                                var p = perm;
                                <FieldCn Orientation="FieldOrientation.Horizontal">
                                    <CheckboxCn id="@($"permissions-{p.Id}")"
                                                Checked="@_selected.Contains(p.Id)"
                                                CheckedChanged="@((bool v) => TogglePermission(p.Id, v))" />
                                    <FieldLabelCn For="@($"permissions-{p.Id}")" Class="font-normal">
                                        @p.Label
                                    </FieldLabelCn>
                                </FieldCn>
                            }
                        </div>
                    </FieldGroupCn>
                </FieldSetCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ClearForm">
                        Clear
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SavePermissions">
                        Save Permissions
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Permission(string Id, string Label);

    private static readonly Permission[] _permissions =
    [
        new("read",   "Read access"),
        new("write",  "Write access"),
        new("delete", "Delete access"),
        new("share",  "Share access"),
    ];

    private List<string> _selected = new();
    private bool _parentChecked = false;
    private bool _parentIndeterminate = false;

    private void UpdateParentState()
    {
        int count = _selected.Count;
        if (count == 0)
        {
            _parentChecked = false;
            _parentIndeterminate = false;
        }
        else if (count == _permissions.Length)
        {
            _parentChecked = true;
            _parentIndeterminate = false;
        }
        else
        {
            _parentChecked = false;
            _parentIndeterminate = true;
        }
    }

    private void TogglePermission(string id, bool add)
    {
        if (add)
        {
            if (!_selected.Contains(id))
                _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
        UpdateParentState();
    }

    private void HandleParentChange()
    {
        if (_parentChecked || _parentIndeterminate)
        {
            _selected = new();
            _parentChecked = false;
            _parentIndeterminate = false;
        }
        else
        {
            _selected = _permissions.Select(p => p.Id).ToList();
            _parentChecked = true;
            _parentIndeterminate = false;
        }
    }

    private void ClearForm()
    {
        _selected = new();
        _parentChecked = false;
        _parentIndeterminate = false;
    }

    private void SavePermissions()
    {
        // Presentational only — form submitted with _selected values
    }
}
