@* ============================================================
   Block: form-rating-input
   Title: FormRatingInput
   Description: A star rating input form with interactive stars and validation
   Source: original/blocks/form/form-rating-input.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Rate Your Experience</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                How would you rate your experience with our service?
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && _hasError ? "true" : null)">
                    <LabelCn>Rating</LabelCn>
                    <div class="flex items-center gap-1">
                        @foreach (var s in _stars)
                        {
                            var star = s;
                            var isActive = star <= (_hoverRating > 0 ? _hoverRating : _currentRating);
                            <button type="button"
                                    @onclick="@(() => _currentRating = star)"
                                    @onmouseenter="@(() => _hoverRating = star)"
                                    @onmouseleave="@(() => _hoverRating = 0)"
                                    class="transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded"
                                    aria-label="@($"Rate {star} stars")">
                                <LucideIconCn Name="star" Size="32" Class="@Cn.Merge("size-8 transition-colors", isActive ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                            </button>
                        }
                    </div>
                    @if (_currentRating > 0)
                    {
                        <div class="mt-2 text-muted-foreground text-sm">
                            You rated: @_currentRating @(_currentRating == 1 ? "star" : "stars")
                        </div>
                    }
                    <FieldDescriptionCn>Click a star to rate from 1 to 5</FieldDescriptionCn>
                    @if (_submitted && _hasError)
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a rating" })" />
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                        Reset
                    </ButtonCn>
                    <ButtonCn type="button" @onclick="SubmitRating">
                        Submit Rating
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _stars = [1, 2, 3, 4, 5];

    private int _currentRating = 0;
    private int _hoverRating = 0;
    private bool _submitted = false;
    private bool _hasError => _currentRating < 1;

    private void ResetForm()
    {
        _currentRating = 0;
        _hoverRating = 0;
        _submitted = false;
    }

    private void SubmitRating()
    {
        _submitted = true;
        // Save rating when valid
    }
}
