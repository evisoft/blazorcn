@* ============================================================
   Block: form-textarea-with-counter
   Title: FormTextareaWithCounter
   Description: A textarea field with character counter showing remaining characters
   Source: original/blocks/form/form-textarea-with-counter.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Add Description</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Provide a detailed description of your item
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <FieldCn>
                    <FieldLabelCn For="description">Description</FieldLabelCn>
                    <TextareaCn id="description" @bind-Value="_description" Placeholder="Enter a detailed description..." Rows="6" />
                    <div class="flex items-center justify-between">
                        <FieldDescriptionCn>
                            Add context and details to help others understand
                        </FieldDescriptionCn>
                        <span class="@(_description.Length > MaxLength ? "text-xs text-red-500" : "text-xs text-muted-foreground")">
                            @_description.Length/@MaxLength
                        </span>
                    </div>
                    @if (_descriptionError != null)
                    {
                        <FieldErrorCn>@_descriptionError</FieldErrorCn>
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" OnClick="HandleClear">Clear</ButtonCn>
                    <ButtonCn type="submit">Save Description</ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private const int MaxLength = 500;

    private string _description = "";
    private string? _descriptionError = null;

    private bool Validate()
    {
        if (_description.Length > MaxLength)
        {
            _descriptionError = $"Description must not exceed {MaxLength} characters";
            return false;
        }
        _descriptionError = null;
        return true;
    }

    private void HandleSubmit()
    {
        if (!Validate()) return;
        // Form submitted: _description
    }

    private void HandleClear()
    {
        _description = "";
        _descriptionError = null;
    }
}
