@* ============================================================
   Block: form-tag-input
   Title: FormTagInput
   Description: A tag input form with add/remove functionality and validation
   Source: original/blocks/form/form-tag-input.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Add Skills</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Enter your skills and press Enter to add them
            </p>
        </div>
        <div class="px-4 py-4">
            <form class="space-y-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <FieldCn>
                    <FieldLabelCn For="tag-input">Skills</FieldLabelCn>
                    <div class="space-y-2">
                        @if (_tags.Count > 0)
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var tag in _tags)
                                {
                                    var capturedTag = tag;
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 pr-1">
                                        <span>@capturedTag</span>
                                        <button
                                            type="button"
                                            @onclick="@(() => RemoveTag(capturedTag))"
                                            class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                                            aria-label="@($"Remove {capturedTag}")">
                                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                                        </button>
                                    </BadgeCn>
                                }
                            </div>
                        }
                        <InputCn id="tag-input"
                                 type="text"
                                 Placeholder="Type a skill and press Enter"
                                 Value="@_inputValue"
                                 ValueChanged="@((string v) => _inputValue = v)"
                                 ValueExpression="@(() => _inputValue)"
                                 Disabled="@(_tags.Count >= 5)"
                                 @onkeydown="HandleKeyDown" />
                    </div>
                    <FieldDescriptionCn>Add 1-5 skills. Press Enter to add each one.</FieldDescriptionCn>
                    @if (_tagsError != null)
                    {
                        <FieldErrorCn>@_tagsError</FieldErrorCn>
                    }
                </FieldCn>

                <div class="flex justify-end gap-2">
                    <ButtonCn type="button" Variant="ButtonVariant.Outline" OnClick="HandleReset">Reset</ButtonCn>
                    <ButtonCn type="submit">Save Skills</ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private string _inputValue = "";
    private List<string> _tags = [];
    private string? _tagsError = null;

    private void AddTag(string value)
    {
        var trimmed = value.Trim();
        if (!string.IsNullOrEmpty(trimmed) && !_tags.Contains(trimmed) && _tags.Count < 5)
        {
            _tags.Add(trimmed);
            _inputValue = "";
            _tagsError = null;
        }
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
        ValidateTags();
    }

    private bool ValidateTags()
    {
        if (_tags.Count < 1)
        {
            _tagsError = "Add at least one tag";
            return false;
        }
        if (_tags.Count > 5)
        {
            _tagsError = "Maximum 5 tags allowed";
            return false;
        }
        _tagsError = null;
        return true;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTag(_inputValue);
        }
    }

    private void HandleSubmit()
    {
        if (!ValidateTags()) return;
        // Save tags: _tags
    }

    private void HandleReset()
    {
        _tags = [];
        _inputValue = "";
        _tagsError = null;
    }
}
