@* ============================================================
   Block: form-multi-step
   Title: FormMultiStep
   Description: A multi-step form with numbered progress indicator, validation at each step, and back/next navigation
   Source: original/blocks/form/form-multi-step.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Create Your Profile</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Complete all steps to set up your account
            </p>
        </div>

        <div class="border-b px-4 py-6">
            <div class="flex items-center justify-between">
                @foreach (var step in _steps)
                {
                    var s = step;
                    var stepIndex = Array.IndexOf(_steps, s);
                    <div class="flex flex-1 items-center">
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-full border-2 text-xs font-medium transition-colors", _currentStep > s.Id ? "border-emerald-500 bg-emerald-500 text-white" : _currentStep == s.Id ? "border-foreground bg-foreground text-background" : "border-muted-foreground/30 bg-background text-muted-foreground")">
                                @if (_currentStep > s.Id)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    @s.Id
                                }
                            </div>
                            <span class="@Cn.Merge("mt-2 text-xs", _currentStep >= s.Id ? "font-medium text-foreground" : "text-muted-foreground")">
                                @s.Title
                            </span>
                        </div>
                        @if (stepIndex < _steps.Length - 1)
                        {
                            <div class="@Cn.Merge("mx-2 h-0.5 flex-1 transition-colors", _currentStep > s.Id ? "bg-emerald-500" : "bg-muted-foreground/30")"></div>
                        }
                    </div>
                }
            </div>
        </div>

        <form>
            <div class="px-4 py-6">
                @if (_currentStep == 1)
                {
                    <div class="space-y-4">
                        <FieldCn>
                            <FieldLabelCn For="name">Full Name</FieldLabelCn>
                            <InputCn id="name"
                                     Placeholder="Enter your full name"
                                     @bind-Value="_name"
                                     aria-invalid="@(_submitted && !string.IsNullOrEmpty(_nameError) ? "true" : "false")" />
                            @if (_submitted && !string.IsNullOrEmpty(_nameError))
                            {
                                <FieldErrorCn Errors="@(new[] { _nameError })" />
                            }
                        </FieldCn>

                        <FieldCn>
                            <FieldLabelCn For="email">Email Address</FieldLabelCn>
                            <InputCn id="email"
                                     type="email"
                                     Placeholder="@("you@example.com")"
                                     @bind-Value="_email"
                                     aria-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : "false")" />
                            @if (_submitted && !string.IsNullOrEmpty(_emailError))
                            {
                                <FieldErrorCn Errors="@(new[] { _emailError })" />
                            }
                        </FieldCn>
                    </div>
                }

                @if (_currentStep == 2)
                {
                    <div class="space-y-4">
                        <FieldCn>
                            <FieldLabelCn For="role">Role</FieldLabelCn>
                            <SelectCn Value="@_role" ValueChanged="@OnRoleChanged">
                                <SelectTriggerCn id="role" Class="w-full">
                                    <SelectValueCn Placeholder="Select your role" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="developer">Developer</SelectItemCn>
                                    <SelectItemCn Value="designer">Designer</SelectItemCn>
                                    <SelectItemCn Value="product-manager">Product Manager</SelectItemCn>
                                    <SelectItemCn Value="other">Other</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                            @if (_submitted && !string.IsNullOrEmpty(_roleError))
                            {
                                <FieldErrorCn Errors="@(new[] { _roleError })" />
                            }
                        </FieldCn>

                        <FieldCn>
                            <FieldLabelCn For="bio">Bio</FieldLabelCn>
                            <TextareaCn id="bio"
                                        Placeholder="Tell us about yourself..."
                                        rows="4"
                                        @bind-Value="_bio"
                                        aria-invalid="@(_submitted && !string.IsNullOrEmpty(_bioError) ? "true" : "false")" />
                            @if (_submitted && !string.IsNullOrEmpty(_bioError))
                            {
                                <FieldErrorCn Errors="@(new[] { _bioError })" />
                            }
                        </FieldCn>
                    </div>
                }

                @if (_currentStep == 3)
                {
                    <div class="space-y-4">
                        <div>
                            <h3 class="mb-3 font-medium text-sm">Review Your Information</h3>
                            <div class="space-y-3 rounded-md bg-muted/50 p-3">
                                <div>
                                    <span class="text-muted-foreground text-xs">Full Name</span>
                                    <p class="mt-0.5 text-sm">@_name</p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground text-xs">Email Address</span>
                                    <p class="mt-0.5 text-sm">@_email</p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground text-xs">Role</span>
                                    <p class="mt-0.5 text-sm capitalize">@_role.Replace("-", " ")</p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground text-xs">Bio</span>
                                    <p class="mt-0.5 text-sm">@_bio</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="flex items-center justify-between border-t px-4 py-3">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" @onclick="HandleBack" Disabled="@(_currentStep == 1)">
                    Back
                </ButtonCn>
                @if (_currentStep < _steps.Length)
                {
                    <ButtonCn type="button" @onclick="HandleNext">
                        Next
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn type="submit" @onclick="HandleSubmit">
                        Submit
                    </ButtonCn>
                }
            </div>
        </form>
    </div>
</section>

@code {
    private record StepInfo(int Id, string Title);

    private static readonly StepInfo[] _steps =
    [
        new(1, "Personal Info"),
        new(2, "Professional Details"),
        new(3, "Review & Submit"),
    ];

    private int _currentStep = 1;
    private bool _submitted = false;

    private string _name = "";
    private string _email = "";
    private string _role = "";
    private string _bio = "";

    private string _nameError = "";
    private string _emailError = "";
    private string _roleError = "";
    private string _bioError = "";

    private void OnRoleChanged(string? value)
    {
        _role = value ?? "";
        _roleError = "";
    }

    private void ClearErrors()
    {
        _nameError = "";
        _emailError = "";
        _roleError = "";
        _bioError = "";
    }

    private bool ValidateStep1()
    {
        _nameError = "";
        _emailError = "";

        if (string.IsNullOrEmpty(_name) || _name.Length < 2)
            _nameError = "Name must be at least 2 characters";

        if (string.IsNullOrEmpty(_email) || !_email.Contains('@'))
            _emailError = "Invalid email address";

        return string.IsNullOrEmpty(_nameError) && string.IsNullOrEmpty(_emailError);
    }

    private bool ValidateStep2()
    {
        _roleError = "";
        _bioError = "";

        if (string.IsNullOrEmpty(_role))
            _roleError = "Please select a role";

        if (string.IsNullOrEmpty(_bio) || _bio.Length < 10)
            _bioError = "Bio must be at least 10 characters";

        return string.IsNullOrEmpty(_roleError) && string.IsNullOrEmpty(_bioError);
    }

    private void HandleNext()
    {
        _submitted = true;
        bool isValid = _currentStep == 1 ? ValidateStep1() : ValidateStep2();
        if (isValid && _currentStep < _steps.Length)
        {
            _currentStep++;
            _submitted = false;
        }
    }

    private void HandleBack()
    {
        if (_currentStep > 1)
        {
            _currentStep--;
            _submitted = false;
            ClearErrors();
        }
    }

    private void HandleSubmit()
    {
        // Presentational only — form submitted
    }
}
