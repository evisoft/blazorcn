@* ============================================================
   Block: form-minimal
   Title: FormMinimal
   Description: An ultra-minimal form with no visible labels, using placeholders for a clean aesthetic
   Source: original/blocks/form/form-minimal.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="p-6">
            <div class="mb-6">
                <h2 class="text-sm font-medium">Get in Touch</h2>
                <p class="mt-1 text-xs text-muted-foreground">
                    Send us a message and we'll get back to you
                </p>
            </div>

            <form class="space-y-4">
                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_nameError) ? "true" : null)">
                    <LabelCn For="minimal-name" Class="sr-only">Your Name</LabelCn>
                    <InputCn id="minimal-name"
                             Placeholder="Your name"
                             Class="h-11 border-muted bg-transparent"
                             @bind-Value="_name"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_nameError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_nameError))
                    {
                        <FieldErrorCn Errors="@(new[] { _nameError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : null)">
                    <LabelCn For="minimal-email" Class="sr-only">Email Address</LabelCn>
                    <InputCn id="minimal-email"
                             type="email"
                             Placeholder="@("your@email.com")"
                             Class="h-11 border-muted bg-transparent"
                             @bind-Value="_email"
                             aria-invalid="@(_submitted && !string.IsNullOrEmpty(_emailError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_emailError))
                    {
                        <FieldErrorCn Errors="@(new[] { _emailError })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && !string.IsNullOrEmpty(_messageError) ? "true" : null)">
                    <LabelCn For="minimal-message" Class="sr-only">Message</LabelCn>
                    <TextareaCn id="minimal-message"
                                Placeholder="Write your message here..."
                                rows="5"
                                Class="resize-none border-muted bg-transparent"
                                @bind-Value="_message"
                                aria-invalid="@(_submitted && !string.IsNullOrEmpty(_messageError) ? "true" : "false")" />
                    @if (_submitted && !string.IsNullOrEmpty(_messageError))
                    {
                        <FieldErrorCn Errors="@(new[] { _messageError })" />
                    }
                </FieldCn>

                <ButtonCn type="submit" Class="w-full" @onclick="Submit">
                    Send Message
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private string _name = "";
    private string _email = "";
    private string _message = "";
    private bool _submitted = false;
    private string _nameError = "";
    private string _emailError = "";
    private string _messageError = "";

    private void Validate()
    {
        _nameError = "";
        _emailError = "";
        _messageError = "";

        if (string.IsNullOrEmpty(_name))
            _nameError = "Name is required";

        if (string.IsNullOrEmpty(_email) || !_email.Contains('@'))
            _emailError = "Invalid email address";

        if (string.IsNullOrEmpty(_message) || _message.Length < 10)
            _messageError = "Message must be at least 10 characters";
    }

    private void Submit()
    {
        _submitted = true;
        Validate();
        // If no errors, form is "submitted" (presentational only)
    }
}
