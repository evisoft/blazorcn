@* ============================================================
   Block: form-select-with-icons
   Title: FormSelectWithIcons
   Description: A select dropdown component where each option displays a leading icon alongside the text for enhanced visual recognition.
   Source: original/blocks/form/form-select-with-icons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <form>
            <fieldset class="space-y-6 px-4 py-6">
                <div class="space-y-2">
                    <p class="font-semibold text-base leading-none">Contact Preferences</p>
                    <p class="text-sm text-muted-foreground">Select your preferred contact method and platform</p>
                </div>

                <FieldCn data-invalid="@(_submitted && string.IsNullOrEmpty(_contactMethod) ? "true" : null)">
                    <FieldLabelCn For="contactMethod">Preferred Contact Method</FieldLabelCn>
                    <SelectCn Value="@_contactMethod" ValueChanged="@((string? v) => _contactMethod = v ?? "")"
                              aria-invalid="@(_submitted && string.IsNullOrEmpty(_contactMethod) ? "true" : null)">
                        <SelectTriggerCn id="contactMethod" Class="w-full"
                                         aria-invalid="@(_submitted && string.IsNullOrEmpty(_contactMethod) ? "true" : null)">
                            <SelectValueCn Placeholder="Select contact method" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var method in _contactMethods)
                            {
                                var m = method;
                                <SelectItemCn Value="@m.Value">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="@m.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                        <span>@m.Label</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_submitted && string.IsNullOrEmpty(_contactMethod))
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a contact method" })" />
                    }
                </FieldCn>

                <FieldCn data-invalid="@(_submitted && string.IsNullOrEmpty(_platform) ? "true" : null)">
                    <FieldLabelCn For="platform">Platform</FieldLabelCn>
                    <FieldDescriptionCn>Choose which platform you use most often</FieldDescriptionCn>
                    <SelectCn Value="@_platform" ValueChanged="@((string? v) => _platform = v ?? "")"
                              aria-invalid="@(_submitted && string.IsNullOrEmpty(_platform) ? "true" : null)">
                        <SelectTriggerCn id="platform" Class="w-full"
                                         aria-invalid="@(_submitted && string.IsNullOrEmpty(_platform) ? "true" : null)">
                            <SelectValueCn Placeholder="Select platform" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var plat in _platforms)
                            {
                                var p = plat;
                                <SelectItemCn Value="@p.Value">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="@p.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                        <span>@p.Label</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    @if (_submitted && string.IsNullOrEmpty(_platform))
                    {
                        <FieldErrorCn Errors="@(new[] { "Please select a platform" })" />
                    }
                </FieldCn>
            </fieldset>

            <div class="flex justify-end gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn type="button" @onclick="SavePreferences">
                    Save Preferences
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private string _contactMethod = "";
    private string _platform = "";
    private bool _submitted = false;

    private record SelectOption(string Icon, string Label, string Value);

    private static readonly SelectOption[] _contactMethods =
    [
        new("mail", "Email", "email"),
        new("phone", "Phone", "phone"),
        new("message-square", "Chat", "chat"),
        new("video", "Video Call", "video"),
    ];

    private static readonly SelectOption[] _platforms =
    [
        new("globe", "Web", "web"),
        new("zap", "API", "api"),
        new("message-square", "Mobile App", "mobile"),
        new("video", "Desktop App", "desktop"),
    ];

    private void ResetForm()
    {
        _contactMethod = "";
        _platform = "";
        _submitted = false;
    }

    private void SavePreferences()
    {
        _submitted = true;
    }
}
