@* ============================================================
   Block: form-switch-side-by-side
   Title: FormSwitchSideBySide
   Description: A two-column layout displaying multiple toggle switches in a compact grid
   Source: original/blocks/form/form-switch-side-by-side.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">User Preferences</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Customize your experience with these settings
            </p>
        </div>

        <form class="p-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="space-y-4">
                    @foreach (var setting in _leftColumnSettings)
                    {
                        var s = setting;
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <FieldContentCn>
                                <LabelCn For="@($"switch-side-by-side-{s.Name}")">@s.Label</LabelCn>
                                <FieldDescriptionCn>@s.Description</FieldDescriptionCn>
                            </FieldContentCn>
                            <SwitchCn id="@($"switch-side-by-side-{s.Name}")" Checked="@_values[s.Name]" CheckedChanged="@((bool v) => _values[s.Name] = v)" />
                        </FieldCn>
                    }
                </div>

                <div class="space-y-4">
                    @foreach (var setting in _rightColumnSettings)
                    {
                        var s = setting;
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <FieldContentCn>
                                <LabelCn For="@($"switch-side-by-side-{s.Name}")">@s.Label</LabelCn>
                                <FieldDescriptionCn>@s.Description</FieldDescriptionCn>
                            </FieldContentCn>
                            <SwitchCn id="@($"switch-side-by-side-{s.Name}")" Checked="@_values[s.Name]" CheckedChanged="@((bool v) => _values[s.Name] = v)" />
                        </FieldCn>
                    }
                </div>
            </div>

            <div class="mt-4 flex items-center justify-end gap-2 border-t pt-4">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" type="button" @onclick="ResetForm">
                    Reset
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" type="button" @onclick="SavePreferences">
                    Save Preferences
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record Setting(string Name, string Label, string Description);

    private static readonly Setting[] _leftColumnSettings =
    [
        new("emailNotifications", "Email Notifications", "Receive updates via email"),
        new("pushNotifications", "Push Notifications", "Browser push notifications"),
        new("smsNotifications", "SMS Notifications", "Text message alerts"),
    ];

    private static readonly Setting[] _rightColumnSettings =
    [
        new("autoSave", "Auto Save", "Save changes automatically"),
        new("darkMode", "Dark Mode", "Use dark color scheme"),
        new("compactView", "Compact View", "Reduce spacing and padding"),
    ];

    private readonly Dictionary<string, bool> _values = new()
    {
        ["emailNotifications"] = true,
        ["pushNotifications"] = false,
        ["smsNotifications"] = false,
        ["autoSave"] = true,
        ["darkMode"] = false,
        ["compactView"] = false,
    };

    private void ResetForm()
    {
        _values["emailNotifications"] = true;
        _values["pushNotifications"] = false;
        _values["smsNotifications"] = false;
        _values["autoSave"] = true;
        _values["darkMode"] = false;
        _values["compactView"] = false;
    }

    private void SavePreferences()
    {
        // Handle form submission (presentational only)
    }
}
