@* ============================================================
   Block: crud-event-manager
   Title: CrudEventManager
   Description: Event creation and management with date, time, location, capacity tracking, and RSVP status
   Source: original/blocks/crud/crud-event-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Events</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_events.Count(e => e.Status == "upcoming") upcoming · @_events.Count total
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                          OnClick="@(() => _showAdd = !_showAdd)">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    New Event
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                    <InputCn Placeholder="Event title" Class="h-8 text-xs"
                             Value="@_newTitle" ValueChanged="@((string v) => _newTitle = v)" />
                    <InputCn Placeholder="Date" Class="h-8 text-xs"
                             Value="@_newDate" ValueChanged="@((string v) => _newDate = v)" />
                    <InputCn Placeholder="Time" Class="h-8 text-xs"
                             Value="@_newTime" ValueChanged="@((string v) => _newTime = v)" />
                    <InputCn Placeholder="Location" Class="h-8 text-xs"
                             Value="@_newLocation" ValueChanged="@((string v) => _newLocation = v)" />
                </div>
                <div class="mt-2 flex gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleAdd">
                        Create Event
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs"
                              OnClick="@(() => _showAdd = false)">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        <div class="flex border-b">
            @foreach (var s in _filterTabs)
            {
                var tab = s;
                <button type="button" @onclick="@(() => _filter = tab)"
                        class="@Cn.Merge("flex-1 border-b-2 px-3 py-2 text-xs font-medium transition-colors", _filter == tab ? "border-foreground text-foreground" : "border-transparent text-muted-foreground hover:text-foreground")">
                    @(tab.Substring(0, 1).ToUpper() + tab.Substring(1))
                </button>
            }
        </div>

        <div>
            @{
                var filtered = _filter == "all" ? _events : _events.Where(e => e.Status == _filter).ToList();
            }
            @foreach (var evt in filtered)
            {
                var ev = evt;
                var pct = ev.Capacity > 0 ? (int)Math.Round((double)ev.Rsvps / ev.Capacity * 100) : 0;
                <div class="@Cn.Merge("border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50", ev.Status == "cancelled" ? "opacity-50" : "")">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetStatusColor(ev.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@ev.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">@ev.Type</BadgeCn>
                            </div>
                            <div class="mt-1 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Size="12" Class="size-3" />
                                    @ev.Date
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideClockCn Size="12" Class="size-3" />
                                    @ev.Time
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideMapPinCn Size="12" Class="size-3" />
                                    @ev.Location
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideUsersCn Size="12" Class="size-3" />
                                    @ev.Rsvps/@ev.Capacity (@pct%)
                                </span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0">
                                    <LucideMoreHorizontalCn Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>View RSVPs</DropdownMenuItemCn>
                                @if (ev.Status == "upcoming")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandleCancel(ev.Id))">Cancel Event</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(ev.Id))">
                                    <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No events found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class EventItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Date { get; set; } = "";
        public string Time { get; set; } = "";
        public string Location { get; set; } = "";
        public int Capacity { get; set; }
        public int Rsvps { get; set; }
        public string Status { get; set; } = "upcoming";
        public string Type { get; set; } = "";
        public string Organizer { get; set; } = "";
    }

    private static readonly string[] _filterTabs = ["all", "upcoming", "ongoing", "completed", "cancelled"];

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["upcoming"] = "bg-blue-500",
        ["ongoing"] = "bg-emerald-500",
        ["completed"] = "bg-muted-foreground/40",
        ["cancelled"] = "bg-red-500",
    };

    private List<EventItem> _events =
    [
        new() { Id = 1, Title = "Q2 Product Launch", Date = "Apr 15, 2026", Time = "2:00 PM", Location = "Main Auditorium", Capacity = 200, Rsvps = 156, Status = "upcoming", Type = "Company", Organizer = "Product Team" },
        new() { Id = 2, Title = "Design Sprint Workshop", Date = "Apr 8, 2026", Time = "9:00 AM", Location = "Room 3B", Capacity = 20, Rsvps = 18, Status = "upcoming", Type = "Workshop", Organizer = "Design Team" },
        new() { Id = 3, Title = "Engineering All-Hands", Date = "Mar 28, 2026", Time = "3:00 PM", Location = "Virtual (Zoom)", Capacity = 150, Rsvps = 142, Status = "upcoming", Type = "Meeting", Organizer = "Engineering" },
        new() { Id = 4, Title = "Customer Success Meetup", Date = "Mar 25, 2026", Time = "6:00 PM", Location = "Downtown Hub", Capacity = 50, Rsvps = 47, Status = "ongoing", Type = "Meetup", Organizer = "CS Team" },
        new() { Id = 5, Title = "New Hire Orientation", Date = "Apr 1, 2026", Time = "10:00 AM", Location = "Training Room", Capacity = 15, Rsvps = 8, Status = "upcoming", Type = "Onboarding", Organizer = "HR" },
        new() { Id = 6, Title = "Tech Talk: AI in Production", Date = "Mar 20, 2026", Time = "4:00 PM", Location = "Virtual", Capacity = 100, Rsvps = 89, Status = "completed", Type = "Talk", Organizer = "Engineering" },
        new() { Id = 7, Title = "Team Building Retreat", Date = "Mar 15, 2026", Time = "All Day", Location = "Mountain Lodge", Capacity = 40, Rsvps = 35, Status = "cancelled", Type = "Social", Organizer = "People Ops" },
    ];

    private string _filter = "all";
    private bool _showAdd;
    private string _newTitle = "";
    private string _newDate = "";
    private string _newTime = "";
    private string _newLocation = "";

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;
        var nextId = _events.Count > 0 ? _events.Max(e => e.Id) + 1 : 1;
        _events.Add(new EventItem
        {
            Id = nextId,
            Title = _newTitle,
            Date = _newDate,
            Time = _newTime,
            Location = _newLocation,
            Capacity = 50,
            Rsvps = 0,
            Status = "upcoming",
            Type = "Event",
            Organizer = "You",
        });
        _newTitle = "";
        _newDate = "";
        _newTime = "";
        _newLocation = "";
        _showAdd = false;
    }

    private void HandleCancel(int id)
    {
        var ev = _events.FirstOrDefault(e => e.Id == id);
        if (ev != null) ev.Status = "cancelled";
    }

    private void HandleDelete(int id)
    {
        _events = _events.Where(e => e.Id != id).ToList();
    }

    private static string GetStatusColor(string status) =>
        _statusColors.TryGetValue(status, out var color) ? color : "bg-muted-foreground/40";
}
