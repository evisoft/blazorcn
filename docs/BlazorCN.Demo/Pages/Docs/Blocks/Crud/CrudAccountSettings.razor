@* ============================================================
   Block: crud-account-settings
   Title: Crud Account Settings
   Description: Comprehensive account settings form with tabbed interface for profile, account, appearance, notifications, and security preferences
   Long Description: User profile form with avatar and role management
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn, TabsCn, TextareaCn
   Source: original/blocks/crud/crud-account-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Settings</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Manage your account settings and preferences
            </p>
        </div>

        <div class="px-6 py-5">
            <TabsCn Class="space-y-5" Value="profile">
                <TabsListCn Class="grid w-full grid-cols-3">
                    <TabsTriggerCn Value="profile">Profile</TabsTriggerCn>
                    <TabsTriggerCn Value="notifications">Notifications</TabsTriggerCn>
                    <TabsTriggerCn Value="security">Security</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="profile">
                    <div class="space-y-5">
                        <div class="flex items-center gap-4">
                            <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-muted/50 text-sm font-medium">
                                JD
                            </div>
                            <div>
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                    Upload Photo
                                </ButtonCn>
                                <p class="mt-1 text-xs text-muted-foreground">JPG, GIF or PNG. Max 800K</p>
                            </div>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="space-y-1.5">
                                <span class="text-xs font-medium text-muted-foreground">First Name</span>
                                <InputCn Placeholder="John" type="text" />
                            </div>
                            <div class="space-y-1.5">
                                <span class="text-xs font-medium text-muted-foreground">Last Name</span>
                                <InputCn Placeholder="Doe" type="text" />
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">Email</span>
                            <InputCn Placeholder="@("john.doe@example.com")" type="email" />
                        </div>

                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">Language</span>
                            <SelectCn>
                                <SelectTriggerCn>
                                    <SelectValueCn Placeholder="Select language" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="en">English</SelectItemCn>
                                    <SelectItemCn Value="es">Spanish</SelectItemCn>
                                    <SelectItemCn Value="fr">French</SelectItemCn>
                                    <SelectItemCn Value="de">German</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">Bio</span>
                            <TextareaCn Placeholder="Tell us about yourself" Rows="3" />
                        </div>

                        <ButtonCn Class="w-full">Save Changes</ButtonCn>
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="notifications">
                    <div class="space-y-1">
                        @foreach (var item in _notifications)
                        {
                            <div class="flex items-center justify-between rounded-md px-1 py-3">
                                <div>
                                    <span class="text-sm font-medium">@item.Title</span>
                                    <p class="text-xs text-muted-foreground">@item.Description</p>
                                </div>
                                <SwitchCn />
                            </div>
                        }
                        <div class="pt-4">
                            <ButtonCn Class="w-full">Save Changes</ButtonCn>
                        </div>
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="security">
                    <div class="space-y-4">
                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">
                                Current Password
                            </span>
                            <InputCn Placeholder="Enter current password" type="password" />
                        </div>

                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">New Password</span>
                            <InputCn Placeholder="Enter new password" type="password" />
                        </div>

                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">
                                Confirm Password
                            </span>
                            <InputCn Placeholder="Confirm new password" type="password" />
                        </div>

                        <div class="flex items-center justify-between rounded-md px-1 py-3">
                            <div>
                                <span class="text-sm font-medium">Two-Factor Authentication</span>
                                <p class="text-xs text-muted-foreground">Add an extra layer of security</p>
                            </div>
                            <SwitchCn />
                        </div>

                        <ButtonCn Class="w-full">Update Password</ButtonCn>
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Title, string Description);

    private readonly NotificationItem[] _notifications =
    [
        new("Email Notifications", "Receive email updates about your account"),
        new("Marketing Emails", "Receive emails about new features and offers"),
        new("Push Notifications", "Receive push notifications on this device"),
    ];
}
