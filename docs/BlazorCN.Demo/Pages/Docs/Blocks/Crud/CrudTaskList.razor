@* ============================================================
   Block: crud-task-list
   Title: Task List with Progress
   Description: Task checklist with progress tracking, assignees, due dates, and priority indicators
   Dependencies: AvatarCn, ButtonCn, CheckboxCn, InputCn, ProgressCn
   Source: original/blocks/crud/crud-task-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            @{
                var completedCount = _tasks.Count(t => t.Completed);
                var totalCount = _tasks.Count;
                var progressPercentage = totalCount > 0 ? (int)Math.Round(100.0 * completedCount / totalCount) : 0;
            }
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Tasks</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @completedCount of @totalCount completed
                    </p>
                </div>
                <span class="text-muted-foreground text-xs">@progressPercentage%</span>
            </div>
            <ProgressCn Value="@progressPercentage" Class="mt-2 h-1.5" aria-label="Progress" />
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex gap-1">
                <ButtonCn Variant="@(_filter == "all" ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                          Class="h-7 text-xs" @onclick="@(() => _filter = "all")">
                    All
                </ButtonCn>
                <ButtonCn Variant="@(_filter == "active" ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                          Class="h-7 text-xs" @onclick="@(() => _filter = "active")">
                    Active
                </ButtonCn>
                <ButtonCn Variant="@(_filter == "completed" ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                          Class="h-7 text-xs" @onclick="@(() => _filter = "completed")">
                    Completed
                </ButtonCn>
            </div>
        </div>

        <div>
            @{
                var filteredTasks = _filter switch
                {
                    "active" => _tasks.Where(t => !t.Completed).ToList(),
                    "completed" => _tasks.Where(t => t.Completed).ToList(),
                    _ => _tasks,
                };
            }
            @foreach (var task in filteredTasks)
            {
                <div class="flex cursor-pointer items-center gap-3 border-b px-4 py-3 transition-colors last:border-0 hover:bg-muted/50">
                    <CheckboxCn Checked="@task.Completed" CheckedChanged="@(_ => task.Completed = !task.Completed)" aria-label="@task.Title" />
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetPriorityColor(task.Priority))"></span>
                    <div class="min-w-0 flex-1">
                        <p class="@Cn.Merge("text-sm", task.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                            @task.Title
                        </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <AvatarCn Class="size-6">
                            <AvatarFallbackCn Class="bg-muted text-xs">@task.AssigneeInitials</AvatarFallbackCn>
                        </AvatarCn>
                        <span class="text-muted-foreground text-xs">@task.DueDate</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/20 px-4 py-3">
            <div class="flex gap-2">
                <InputCn Placeholder="Add new task..." Value="@_newTaskTitle"
                         Class="h-8 border-0 bg-transparent text-sm shadow-none focus-visible:ring-0" aria-label="Add new task" />
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 shrink-0 gap-1.5 text-xs" @onclick="AddTask">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private class TaskItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public bool Completed { get; set; }
        public string AssigneeName { get; set; } = "";
        public string AssigneeInitials { get; set; } = "";
        public string DueDate { get; set; } = "";
        public string Priority { get; set; } = "";
    }

    private string _filter = "all";
    private string _newTaskTitle = "";

    private readonly List<TaskItem> _tasks =
    [
        new() { Id = "1", Title = "Design new landing page hero section", Completed = true, AssigneeName = "Sarah Chen", AssigneeInitials = "SC", DueDate = "Mar 10", Priority = "high" },
        new() { Id = "2", Title = "Implement user authentication flow", Completed = true, AssigneeName = "Mike Johnson", AssigneeInitials = "MJ", DueDate = "Mar 12", Priority = "high" },
        new() { Id = "3", Title = "Review pull request for API endpoints", Completed = false, AssigneeName = "Emily Davis", AssigneeInitials = "ED", DueDate = "Mar 15", Priority = "high" },
        new() { Id = "4", Title = "Update documentation for new features", Completed = false, AssigneeName = "Alex Rodriguez", AssigneeInitials = "AR", DueDate = "Mar 16", Priority = "medium" },
        new() { Id = "5", Title = "Fix bug in search filter functionality", Completed = true, AssigneeName = "Sarah Chen", AssigneeInitials = "SC", DueDate = "Mar 11", Priority = "high" },
        new() { Id = "6", Title = "Optimize database queries for dashboard", Completed = false, AssigneeName = "Mike Johnson", AssigneeInitials = "MJ", DueDate = "Mar 18", Priority = "medium" },
        new() { Id = "7", Title = "Create unit tests for payment module", Completed = false, AssigneeName = "Emily Davis", AssigneeInitials = "ED", DueDate = "Mar 20", Priority = "medium" },
        new() { Id = "8", Title = "Schedule team retrospective meeting", Completed = false, AssigneeName = "Alex Rodriguez", AssigneeInitials = "AR", DueDate = "Mar 17", Priority = "low" },
        new() { Id = "9", Title = "Update dependencies to latest versions", Completed = true, AssigneeName = "Mike Johnson", AssigneeInitials = "MJ", DueDate = "Mar 09", Priority = "low" },
        new() { Id = "10", Title = "Design mobile-responsive navigation", Completed = false, AssigneeName = "Sarah Chen", AssigneeInitials = "SC", DueDate = "Mar 22", Priority = "medium" },
    ];

    private void AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle)) return;
        _tasks.Add(new TaskItem
        {
            Id = (_tasks.Count + 1).ToString(),
            Title = _newTaskTitle,
            Completed = false,
            AssigneeName = "You",
            AssigneeInitials = "Y",
            DueDate = "Today",
            Priority = "medium",
        });
        _newTaskTitle = "";
    }

    private static string GetPriorityColor(string priority) => priority switch
    {
        "high" => "bg-red-500",
        "medium" => "bg-amber-500",
        _ => "bg-blue-500",
    };
}
