@* ============================================================
   Block: crud-custom-fields
   Title: CrudCustomFields
   Description: Custom field definition editor with type selection, validation rules, and field ordering for dynamic form configuration
   Source: original/blocks/crud/crud-custom-fields.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Custom Fields</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_fields.Count fields &middot; @_fields.Count(f => f.Required) required
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs" @onclick="@(() => _showAdd = !_showAdd)">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Field
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="flex items-center gap-2">
                    <InputCn Placeholder="Field label" Class="h-8 flex-1 text-xs" @bind-Value="_newLabel" aria-label="Field label" />
                    <SelectCn Value="@_newType" ValueChanged="@((string v) => _newType = v)">
                        <SelectTriggerCn aria-label="Field type" Class="h-8 w-32 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var entry in _fieldTypeLabels)
                            {
                                var val = entry.Key;
                                <SelectItemCn Value="@val">@entry.Value</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    <div class="flex items-center gap-1.5">
                        <SwitchCn Checked="@_newRequired" CheckedChanged="@((bool v) => _newRequired = v)" aria-label="Required" />
                        <span class="text-xs text-muted-foreground">Required</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" @onclick="HandleAdd">
                        Add
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs" @onclick="@(() => _showAdd = false)">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto] items-center gap-3 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <span class="w-4"></span>
            <span>Label</span>
            <span>Key</span>
            <span>Type</span>
            <span>Required</span>
            <span class="w-8"></span>
        </div>

        <div>
            @foreach (var field in _fields)
            {
                var f = field;
                <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto] items-center gap-3 border-b px-4 py-2.5 transition-colors last:border-b-0 hover:bg-muted/50">
                    <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5 cursor-grab text-muted-foreground/40" />
                    <div class="min-w-0">
                        <span class="text-sm font-medium">@f.Label</span>
                        @if (!string.IsNullOrEmpty(f.Placeholder))
                        {
                            <p class="text-xs text-muted-foreground">@f.Placeholder</p>
                        }
                        @if (!string.IsNullOrEmpty(f.Options))
                        {
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">Options: @f.Options</p>
                        }
                    </div>
                    <span class="font-mono text-xs text-muted-foreground">@f.FieldKey</span>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                        @(_fieldTypeLabels.TryGetValue(f.Type, out var lbl) ? lbl : f.Type)
                    </BadgeCn>
                    <SwitchCn Checked="@f.Required" CheckedChanged="@(_ => ToggleRequired(f.Id))" aria-label="@($"{f.Label} required")" />
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 text-destructive" @onclick="@(() => HandleDelete(f.Id))" aria-label="Delete">
                        <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-2">
            <span class="text-xs text-muted-foreground">
                Drag fields to reorder. Changes are saved automatically.
            </span>
        </div>
    </div>
</section>

@code {
    private class CustomField
    {
        public int Id { get; set; }
        public string Label { get; set; } = "";
        public string FieldKey { get; set; } = "";
        public string Type { get; set; } = "text";
        public bool Required { get; set; }
        public string Placeholder { get; set; } = "";
        public string Options { get; set; } = "";
        public int Order { get; set; }
    }

    private static readonly Dictionary<string, string> _fieldTypeLabels = new()
    {
        ["text"] = "Text",
        ["number"] = "Number",
        ["dropdown"] = "Dropdown",
        ["checkbox"] = "Checkbox",
        ["date"] = "Date",
        ["textarea"] = "Text Area",
        ["email"] = "Email",
        ["url"] = "URL",
    };

    private readonly List<CustomField> _fields =
    [
        new() { Id = 1, Label = "Company Size", FieldKey = "company_size", Type = "dropdown", Required = true, Placeholder = "", Options = "1-10, 11-50, 51-200, 201-500, 500+", Order = 1 },
        new() { Id = 2, Label = "Website URL", FieldKey = "website_url", Type = "url", Required = false, Placeholder = "https://example.com", Options = "", Order = 2 },
        new() { Id = 3, Label = "Annual Revenue", FieldKey = "annual_revenue", Type = "number", Required = false, Placeholder = "Enter amount", Options = "", Order = 3 },
        new() { Id = 4, Label = "Industry", FieldKey = "industry", Type = "dropdown", Required = true, Placeholder = "", Options = "Technology, Healthcare, Finance, Education, Retail, Other", Order = 4 },
        new() { Id = 5, Label = "Newsletter Opt-in", FieldKey = "newsletter_optin", Type = "checkbox", Required = false, Placeholder = "", Options = "", Order = 5 },
        new() { Id = 6, Label = "Start Date", FieldKey = "start_date", Type = "date", Required = false, Placeholder = "Select date", Options = "", Order = 6 },
        new() { Id = 7, Label = "Notes", FieldKey = "notes", Type = "textarea", Required = false, Placeholder = "Additional notes...", Options = "", Order = 7 },
        new() { Id = 8, Label = "Contact Email", FieldKey = "contact_email", Type = "email", Required = true, Placeholder = "name@@company.com", Options = "", Order = 8 },
    ];

    private bool _showAdd;
    private string _newLabel = "";
    private string _newType = "text";
    private bool _newRequired;

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newLabel)) return;
        var id = _fields.Count > 0 ? _fields.Max(f => f.Id) + 1 : 1;
        var key = _newLabel.ToLowerInvariant().Replace(" ", "_");
        _fields.Add(new CustomField
        {
            Id = id,
            Label = _newLabel,
            FieldKey = key,
            Type = _newType,
            Required = _newRequired,
            Placeholder = "",
            Options = "",
            Order = _fields.Count + 1,
        });
        _newLabel = "";
        _newType = "text";
        _newRequired = false;
        _showAdd = false;
    }

    private void ToggleRequired(int id)
    {
        var f = _fields.FirstOrDefault(x => x.Id == id);
        if (f is not null) f.Required = !f.Required;
    }

    private void HandleDelete(int id) => _fields.RemoveAll(f => f.Id == id);
}
