@* ============================================================
   Block: crud-access-control
   Title: Crud Access Control
   Description: Manage role permissions across different resources with granular control
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, DropdownMenuCn, InputCn
   Source: original/blocks/crud/crud-access-control.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Access Control</h2>
                    <p class="mt-1 text-xs text-muted-foreground">Manage role permissions across resources</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs"
                          OnClick="@(() => _showAddRole = !_showAddRole)">
                    <LucidePlusCn Class="size-3.5" Size="14" />
                    Add Role
                </ButtonCn>
            </div>
        </div>

        @if (_showAddRole)
        {
            <div class="border-b bg-muted/50 px-6 py-4">
                <div class="flex items-center gap-2">
                    <InputCn placeholder="Role name" @bind-Value="_newRoleName"
                             Class="h-8 max-w-xs border-0 bg-background text-xs shadow-none focus-visible:ring-1" aria-label="Role name" />
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="AddRole">
                        <LucideCheckCn Class="size-3.5" Size="14" />
                        Create
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs"
                              OnClick="@(() => { _showAddRole = false; _newRoleName = ""; })">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b">
                        <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground">Role</th>
                        @foreach (var resource in _resources)
                        {
                            <th class="px-6 py-3 text-center text-xs font-medium text-muted-foreground" colspan="4">@resource</th>
                        }
                        <th class="px-6 py-3 text-right text-xs font-medium text-muted-foreground">Actions</th>
                    </tr>
                    <tr class="border-b bg-muted/30">
                        <th class="px-6 py-2 text-left text-xs font-medium text-muted-foreground"><span class="sr-only">Role</span></th>
                        @foreach (var _ in _resources)
                        {
                            <th class="px-2 py-2 text-center text-xs font-medium text-muted-foreground">View</th>
                            <th class="px-2 py-2 text-center text-xs font-medium text-muted-foreground">Create</th>
                            <th class="px-2 py-2 text-center text-xs font-medium text-muted-foreground">Edit</th>
                            <th class="px-2 py-2 text-center text-xs font-medium text-muted-foreground">Delete</th>
                        }
                        <th class="px-6 py-2 text-right text-xs font-medium text-muted-foreground"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in _roles)
                    {
                        <tr class="border-b last:border-0">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@role.Name</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-xs">@role.UserCount</BadgeCn>
                                </div>
                            </td>
                            @foreach (var resource in _resources)
                            {
                                var perm = role.Permissions[resource];
                                <td class="px-2 py-4 text-center">
                                    <div class="flex justify-center">
                                        <CheckboxCn Checked="@perm.View" CheckedChanged="@((bool v) => perm.View = v)" aria-label="@($"View {resource}")" />
                                    </div>
                                </td>
                                <td class="px-2 py-4 text-center">
                                    <div class="flex justify-center">
                                        <CheckboxCn Checked="@perm.Create" CheckedChanged="@((bool v) => perm.Create = v)" aria-label="@($"Create {resource}")" />
                                    </div>
                                </td>
                                <td class="px-2 py-4 text-center">
                                    <div class="flex justify-center">
                                        <CheckboxCn Checked="@perm.Edit" CheckedChanged="@((bool v) => perm.Edit = v)" aria-label="@($"Edit {resource}")" />
                                    </div>
                                </td>
                                <td class="px-2 py-4 text-center">
                                    <div class="flex justify-center">
                                        <CheckboxCn Checked="@perm.CanDelete" CheckedChanged="@((bool v) => perm.CanDelete = v)" aria-label="@($"Delete {resource}")" />
                                    </div>
                                </td>
                            }
                            <td class="px-6 py-4 text-right">
                                <DropdownMenuCn>
                                    <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm h-7 w-7 p-0" data-variant="ghost" data-size="sm" aria-label="Open menu">
                                            <LucideChevronDownCn Class="size-4" Size="16" />
                                        </DropdownMenuTriggerCn>
                                    <DropdownMenuContentCn Align="FloatingAlign.End">
                                        <DropdownMenuItemCn OnClick="@(() => DuplicateRole(role))">
                                            <LucideSettingsCn Class="mr-2 size-3.5" Size="14" />
                                            Duplicate
                                        </DropdownMenuItemCn>
                                        <DropdownMenuItemCn Class="text-red-600" OnClick="@(() => _roles.Remove(role))">
                                            <LucideTrashCn Class="mr-2 size-3.5" Size="14" />
                                            Delete
                                        </DropdownMenuItemCn>
                                    </DropdownMenuContentCn>
                                </DropdownMenuCn>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    private class Permission
    {
        public bool View { get; set; }
        public bool Create { get; set; }
        public bool Edit { get; set; }
        public bool CanDelete { get; set; }
    }

    private class Role
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public int UserCount { get; set; }
        public Dictionary<string, Permission> Permissions { get; set; } = new();
    }

    private static readonly string[] _resources = ["Users", "Posts", "Settings", "Billing"];

    private bool _showAddRole;
    private string _newRoleName = "";

    private List<Role> _roles = new()
    {
        new() { Id = "1", Name = "Admin", UserCount = 3, Permissions = new() { ["Users"] = new() { View = true, Create = true, Edit = true, CanDelete = true }, ["Posts"] = new() { View = true, Create = true, Edit = true, CanDelete = true }, ["Settings"] = new() { View = true, Create = true, Edit = true, CanDelete = true }, ["Billing"] = new() { View = true, Create = true, Edit = true, CanDelete = true } } },
        new() { Id = "2", Name = "Editor", UserCount = 12, Permissions = new() { ["Users"] = new() { View = true }, ["Posts"] = new() { View = true, Create = true, Edit = true }, ["Settings"] = new() { View = true }, ["Billing"] = new() } },
        new() { Id = "3", Name = "Viewer", UserCount = 45, Permissions = new() { ["Users"] = new() { View = true }, ["Posts"] = new() { View = true }, ["Settings"] = new(), ["Billing"] = new() } },
        new() { Id = "4", Name = "Guest", UserCount = 28, Permissions = new() { ["Users"] = new(), ["Posts"] = new() { View = true }, ["Settings"] = new(), ["Billing"] = new() } },
    };

    private void AddRole()
    {
        if (string.IsNullOrWhiteSpace(_newRoleName)) return;
        var perms = new Dictionary<string, Permission>();
        foreach (var r in _resources) perms[r] = new Permission();
        _roles.Add(new Role { Id = $"role-{_roles.Count + 1}", Name = _newRoleName, UserCount = 0, Permissions = perms });
        _newRoleName = "";
        _showAddRole = false;
    }

    private void DuplicateRole(Role source)
    {
        var perms = new Dictionary<string, Permission>();
        foreach (var (k, v) in source.Permissions)
            perms[k] = new Permission { View = v.View, Create = v.Create, Edit = v.Edit, CanDelete = v.CanDelete };
        _roles.Add(new Role { Id = $"dup-{_roles.Count + 1}", Name = $"{source.Name} Copy", UserCount = 0, Permissions = perms });
    }
}
