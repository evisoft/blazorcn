@* ============================================================
   Block: crud-portfolio-manager
   Title: CrudPortfolioManager
   Description: Portfolio item management with project showcase, tags, categories, and featured items
   Source: original/blocks/crud/crud-portfolio-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideFolderOpenCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Portfolio</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_items.Count projects · @_items.Count(i => i.Featured) featured
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Add Project
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search projects..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
            <div class="flex gap-1">
                <button type="button"
                        @onclick="@(() => _filter = "all")"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "all" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                    All
                </button>
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <button type="button"
                            @onclick="@(() => _filter = category)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == category ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @category
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var item in Filtered)
            {
                var portfolioItem = item;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetStatusColor(portfolioItem.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@portfolioItem.Title</span>
                                @if (portfolioItem.Featured)
                                {
                                    <LucideStarCn Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                                }
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">
                                    @portfolioItem.Category
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">
                                @portfolioItem.Description
                            </p>
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var tag in portfolioItem.Tags)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">
                                        @tag
                                    </span>
                                }
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@portfolioItem.Client</span>
                                <span>·</span>
                                <span>@portfolioItem.Year</span>
                                @if (portfolioItem.Views > 0)
                                {
                                    <span>·</span>
                                    <span class="tabular-nums">@portfolioItem.Views.ToString("N0") views</span>
                                }
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn AsChild="true">
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideMoreHorizontalCn Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn @onclick="@(() => ToggleFeatured(portfolioItem.Id))">
                                    @(portfolioItem.Featured ? "Unfeature" : "Feature")
                                </DropdownMenuItemCn>
                                @if (portfolioItem.Status == "draft")
                                {
                                    <DropdownMenuItemCn @onclick="@(() => Publish(portfolioItem.Id))">
                                        Publish
                                    </DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => Delete(portfolioItem.Id))">
                                    <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No projects found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class PortfolioItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Client { get; set; } = "";
        public string Category { get; set; } = "";
        public string[] Tags { get; set; } = [];
        public string Status { get; set; } = "published";
        public bool Featured { get; set; }
        public string Year { get; set; } = "";
        public int Views { get; set; }
    }

    private readonly List<PortfolioItem> _items =
    [
        new() { Id = 1, Title = "Fintech Dashboard Redesign", Description = "Complete redesign of a trading platform dashboard with real-time data visualization", Client = "Apex Capital", Category = "Web Design", Tags = ["Dashboard", "Finance", "React"], Status = "published", Featured = true, Year = "2026", Views = 3420 },
        new() { Id = 2, Title = "E-commerce Mobile App", Description = "Native iOS and Android shopping app with AR product preview", Client = "StyleHouse", Category = "Mobile", Tags = ["iOS", "Android", "AR"], Status = "published", Featured = true, Year = "2026", Views = 2890 },
        new() { Id = 3, Title = "SaaS Onboarding Experience", Description = "Multi-step onboarding flow with personalization and interactive tutorials", Client = "CloudBase", Category = "UX Design", Tags = ["Onboarding", "SaaS", "Animation"], Status = "published", Featured = false, Year = "2025", Views = 1560 },
        new() { Id = 4, Title = "Healthcare Patient Portal", Description = "Accessible patient portal for appointment scheduling and medical records", Client = "MedConnect", Category = "Web Design", Tags = ["Healthcare", "Accessibility", "Portal"], Status = "published", Featured = false, Year = "2025", Views = 2100 },
        new() { Id = 5, Title = "Brand Identity System", Description = "Complete brand identity including logo, typography, color palette, and guidelines", Client = "Elevate Studio", Category = "Branding", Tags = ["Logo", "Identity", "Guidelines"], Status = "draft", Featured = false, Year = "2026", Views = 0 },
        new() { Id = 6, Title = "Real Estate Platform", Description = "Property listing and search platform with map integration and virtual tours", Client = "HomeView", Category = "Web Design", Tags = ["Maps", "Search", "3D"], Status = "archived", Featured = false, Year = "2024", Views = 4200 },
    ];

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _allCategories = ["Web Design", "Mobile", "UX Design", "Branding"];

    private IEnumerable<string> _categories => _allCategories;

    private IEnumerable<PortfolioItem> Filtered =>
        _items
            .Where(i => _filter == "all" || i.Category == _filter)
            .Where(i =>
                i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                i.Client.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void Delete(int id) => _items.RemoveAll(i => i.Id == id);

    private void ToggleFeatured(int id)
    {
        var item = _items.Find(i => i.Id == id);
        if (item != null) item.Featured = !item.Featured;
    }

    private void Publish(int id)
    {
        var item = _items.Find(i => i.Id == id);
        if (item != null) item.Status = "published";
    }

    private static string GetStatusColor(string status) => status switch
    {
        "published" => "bg-emerald-500",
        "draft" => "bg-amber-500",
        "archived" => "bg-muted-foreground/40",
        _ => "bg-muted-foreground/40",
    };
}
