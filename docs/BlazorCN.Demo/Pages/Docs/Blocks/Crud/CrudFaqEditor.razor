@* ============================================================
   Block: crud-faq-editor
   Title: CrudFaqEditor
   Description: FAQ question and answer editor with categories, ordering, and publish status for help center management
   Source: original/blocks/crud/crud-faq-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">FAQ Editor</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @(_faqs.Count(f => f.Published)) published · @_faqs.Count total
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs" @onclick="() => _showAdd = !_showAdd">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Add FAQ
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="space-y-2 border-b bg-muted/30 px-4 py-3">
                <InputCn Placeholder="Question" Class="h-8 text-xs" @bind-Value="_newQuestion" aria-label="Question" />
                <TextareaCn Placeholder="Answer" Class="min-h-[60px] text-xs" @bind-Value="_newAnswer" aria-label="Answer" />
                <div class="flex items-center gap-2">
                    <InputCn Placeholder="Category" Class="h-8 w-32 text-xs" @bind-Value="_newCategory" aria-label="Category" />
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" @onclick="HandleAdd">Add</ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs" @onclick="() => _showAdd = false">Cancel</ButtonCn>
                </div>
            </div>
        }

        <div>
            @foreach (var cat in Categories)
            {
                var category = cat;
                <div>
                    <div class="border-b bg-muted/30 px-4 py-2">
                        <span class="text-xs font-medium text-muted-foreground">@category</span>
                        <span class="ml-2 text-xs text-muted-foreground">(@(_faqs.Count(f => f.Category == category)))</span>
                    </div>
                    @foreach (var faqItem in _faqs.Where(f => f.Category == category).ToList())
                    {
                        var faq = faqItem;
                        <div class="border-b last:border-b-0">
                            <div class="relative flex cursor-pointer items-center gap-2 px-4 py-3 transition-colors hover:bg-muted/50">
                                <button type="button"
                                        class="absolute inset-0 z-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset"
                                        aria-expanded="@(_expandedId == faq.Id ? "true" : "false")"
                                        aria-label="@($"Toggle answer for {faq.Question}")"
                                        @onclick="() => _expandedId = (_expandedId == faq.Id ? (int?)null : faq.Id)"></button>
                                <LucideGripVerticalCn Size="14" Class="size-3.5 shrink-0 cursor-grab text-muted-foreground/40" />
                                <LucideChevronRightCn Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground transition-transform duration-200", _expandedId == faq.Id ? "rotate-90" : "")" />
                                <span class="flex-1 text-sm font-medium">@faq.Question</span>
                                @if (!faq.Published)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">Draft</BadgeCn>
                                }
                                <div class="relative z-10 flex gap-1">
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 px-2 text-[10px]" @onclick="() => TogglePublish(faq.Id)">
                                        @(faq.Published ? "Unpublish" : "Publish")
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-destructive" @onclick="() => HandleDelete(faq.Id)" aria-label="Delete">
                                        <LucideTrashCn Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>
                            @if (_expandedId == faq.Id)
                            {
                                <div class="border-t bg-muted/20 px-4 py-3" style="padding-left:52px">
                                    @if (_editingId == faq.Id)
                                    {
                                        <div class="space-y-2">
                                            <InputCn Class="h-8 text-xs" @bind-Value="_editQuestion" aria-label="Question" />
                                            <TextareaCn Class="min-h-[60px] text-xs" @bind-Value="_editAnswer" aria-label="Answer" />
                                            <div class="flex gap-2">
                                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="() => HandleSaveEdit(faq.Id)">Save</ButtonCn>
                                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs" @onclick="() => _editingId = null">Cancel</ButtonCn>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-xs text-muted-foreground">@faq.Answer</p>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="mt-2 h-6 px-2 text-[10px]"
                                                  @onclick="() => StartEdit(faq.Id, faq.Question, faq.Answer)">
                                            Edit
                                        </ButtonCn>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class FaqItem
    {
        public int Id { get; set; }
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
        public string Category { get; set; } = "";
        public bool Published { get; set; }
    }

    private readonly List<FaqItem> _faqs =
    [
        new() { Id = 1, Question = "How do I reset my password?", Answer = "Click the 'Forgot Password' link on the login page. Enter your email and we'll send a reset link valid for 24 hours.", Category = "Account", Published = true },
        new() { Id = 2, Question = "What payment methods do you accept?", Answer = "We accept Visa, Mastercard, American Express, and PayPal. Enterprise customers can pay via invoice with NET-30 terms.", Category = "Billing", Published = true },
        new() { Id = 3, Question = "How do I cancel my subscription?", Answer = "Go to Settings > Billing > Cancel Subscription. You'll retain access until the end of your current billing period.", Category = "Billing", Published = true },
        new() { Id = 4, Question = "Is there a free trial available?", Answer = "Yes, all plans include a 14-day free trial with full access to all features. No credit card required.", Category = "Billing", Published = true },
        new() { Id = 5, Question = "How do I invite team members?", Answer = "Navigate to Settings > Team > Invite Members. Enter their email addresses and select the appropriate role.", Category = "Team", Published = true },
        new() { Id = 6, Question = "What are the API rate limits?", Answer = "Free plans: 100 req/min. Pro: 1,000 req/min. Enterprise: custom limits. Rate limit headers are included in every response.", Category = "API", Published = true },
        new() { Id = 7, Question = "Do you offer data export?", Answer = "Yes, you can export all your data as CSV or JSON from Settings > Data > Export. This includes all records, configurations, and audit logs.", Category = "Data", Published = false },
        new() { Id = 8, Question = "Is my data encrypted?", Answer = "All data is encrypted at rest (AES-256) and in transit (TLS 1.3). We are SOC 2 Type II certified.", Category = "Security", Published = true },
    ];

    private int? _expandedId;
    private bool _showAdd;
    private string _newQuestion = "";
    private string _newAnswer = "";
    private string _newCategory = "General";
    private int? _editingId;
    private string _editQuestion = "";
    private string _editAnswer = "";

    private IEnumerable<string> Categories =>
        _faqs.Select(f => f.Category).Distinct();

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newQuestion)) return;
        var newId = _faqs.Count > 0 ? _faqs.Max(f => f.Id) + 1 : 1;
        _faqs.Add(new FaqItem
        {
            Id = newId,
            Question = _newQuestion,
            Answer = _newAnswer,
            Category = _newCategory,
            Published = false,
        });
        _newQuestion = "";
        _newAnswer = "";
        _newCategory = "General";
        _showAdd = false;
    }

    private void TogglePublish(int id)
    {
        var faq = _faqs.FirstOrDefault(f => f.Id == id);
        if (faq != null) faq.Published = !faq.Published;
    }

    private void HandleDelete(int id)
    {
        var faq = _faqs.FirstOrDefault(f => f.Id == id);
        if (faq != null) _faqs.Remove(faq);
    }

    private void StartEdit(int id, string question, string answer)
    {
        _editingId = id;
        _editQuestion = question;
        _editAnswer = answer;
    }

    private void HandleSaveEdit(int id)
    {
        var faq = _faqs.FirstOrDefault(f => f.Id == id);
        if (faq != null)
        {
            faq.Question = _editQuestion;
            faq.Answer = _editAnswer;
        }
        _editingId = null;
    }
}
