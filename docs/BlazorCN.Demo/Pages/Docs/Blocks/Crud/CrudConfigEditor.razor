@* ============================================================
   Block: crud-config-editor
   Title: Crud Config Editor
   Description: Manage application configuration with inline key-value editing and type validation
   Long Description: A powerful configuration management interface for editing application settings. Features namespaced keys, inline value editing, type indicators, and modification tracking. Perfect for admin panels, environment configuration, feature flags, or application settings management.
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn
   Source: original/blocks/crud/crud-config-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h2 class="font-medium text-sm">Configuration</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_config.Count settings</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add Config
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="relative">
                <LucideSearchCn Size="16" Class="absolute top-2 left-2.5 size-4 text-muted-foreground" />
                <InputCn Placeholder="Search config keys..." Value="@_searchQuery" Class="border-0 bg-muted/50 pl-9 shadow-none focus-visible:ring-0" />
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <div class="grid grid-cols-12 gap-3 text-muted-foreground text-xs">
                <span class="col-span-3">Key</span>
                <span class="col-span-4">Value</span>
                <span class="col-span-2">Type</span>
                <span class="col-span-2">Modified</span>
                <span class="col-span-1 text-right">Actions</span>
            </div>
        </div>

        <div>
            @if (_filteredConfig.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <p class="text-muted-foreground text-sm">No config found</p>
                </div>
            }
            else
            {
                @foreach (var entry in _filteredConfig)
                {
                    var ns = GetNamespace(entry.Key);
                    <div class="grid grid-cols-12 items-center gap-3 border-b px-4 py-3 transition-colors last:border-0 hover:bg-muted/50">
                        <div class="col-span-3 min-w-0">
                            <p class="truncate font-mono text-sm">@entry.Key</p>
                            @if (!string.IsNullOrEmpty(ns))
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">@ns</p>
                            }
                        </div>
                        <div class="col-span-4 min-w-0">
                            <p class="truncate font-mono text-sm">@entry.Value</p>
                        </div>
                        <div class="col-span-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"{GetTypeColor(entry.Type)} border-0 text-xs")">
                                @entry.Type
                            </BadgeCn>
                        </div>
                        <div class="col-span-2">
                            <p class="text-muted-foreground text-xs">@entry.LastModified</p>
                        </div>
                        <div class="col-span-1 flex items-center justify-end gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0">
                                <LucidePencilCn Size="12" Class="size-3 text-muted-foreground" />
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0">
                                <LucideTrash2Cn Size="12" Class="size-3 text-muted-foreground" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private string _searchQuery = "";

    private record ConfigEntry(string Id, string Key, string Value, string Type, string LastModified);

    private readonly List<ConfigEntry> _config =
    [
        new("1", "app.theme", "dark", "String", "2 days ago"),
        new("2", "app.language", "en-US", "String", "1 week ago"),
        new("3", "api.rateLimit", "100", "Number", "3 days ago"),
        new("4", "api.timeout", "30000", "Number", "5 days ago"),
        new("5", "features.betaAccess", "true", "Boolean", "1 day ago"),
        new("6", "features.analytics", "false", "Boolean", "4 days ago"),
        new("7", "database.pool", "{\"min\":5,\"max\":20}", "JSON", "1 week ago"),
        new("8", "mail.smtp", "{\"host\":\"smtp.example.com\",\"port\":587}", "JSON", "2 weeks ago"),
    ];

    private List<ConfigEntry> _filteredConfig => _config
        .Where(e => e.Key.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private static string GetNamespace(string key)
    {
        var parts = key.Split('.');
        return parts.Length > 1 ? parts[0] : "";
    }

    private static string GetTypeColor(string type) => type switch
    {
        "String" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Number" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "Boolean" => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        "JSON" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        _ => "",
    };
}
