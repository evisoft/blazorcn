@* ============================================================
   Block: crud-playlist-manager
   Title: CrudPlaylistManager
   Description: Playlist and collection manager with track listing, duration tracking, collaborative editing, and sharing
   Source: original/blocks/crud/crud-playlist-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideListMusicCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Playlists</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_playlists.Count playlists · @_playlists.Sum(p => p.Tracks) total tracks
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    New Playlist
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search playlists..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterVal = s;
                    <button type="button"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _filter = filterVal)">
                        @(char.ToUpper(filterVal[0]) + filterVal.Substring(1))
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var playlist in Filtered)
            {
                var pl = playlist;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetVisibilityColor(pl.Visibility))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@pl.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                    @pl.Genre
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">
                                @pl.Description
                            </p>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span class="tabular-nums">@pl.Tracks tracks</span>
                                <span>·</span>
                                <span>@pl.Duration</span>
                                <span>·</span>
                                <span>@pl.Creator</span>
                                @if (pl.Followers > 0)
                                {
                                    <span>·</span>
                                    <span class="tabular-nums">@pl.Followers.ToString("N0") followers</span>
                                }
                                <span>·</span>
                                <span>@pl.LastUpdated</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideMoreHorizontalCn Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Add Tracks</DropdownMenuItemCn>
                                <DropdownMenuItemCn @onclick="@(() => HandleToggleVisibility(pl.Id))">
                                    Make @(pl.Visibility == "public" ? "Private" : "Public")
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>Share</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => HandleDelete(pl.Id))">
                                    <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No playlists found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PlaylistItem(
        int Id,
        string Name,
        string Description,
        int Tracks,
        string Duration,
        string Creator,
        string Visibility,
        int Followers,
        string LastUpdated,
        string Genre
    );

    private static readonly string[] _filterOptions = ["all", "public", "private", "shared"];

    private readonly List<PlaylistItem> _playlists =
    [
        new(1, "Deep Focus", "Ambient electronic tracks for deep work sessions and concentration", 48, "3h 22m", "Sarah Chen", "public", 1240, "Mar 24, 2026", "Electronic"),
        new(2, "Morning Commute", "Upbeat indie and alternative for the morning drive", 32, "2h 8m", "Mike Johnson", "public", 890, "Mar 22, 2026", "Indie"),
        new(3, "Team Standup Vibes", "Light background music for daily team standups and meetings", 24, "1h 45m", "Emma Davis", "shared", 45, "Mar 20, 2026", "Lo-fi"),
        new(4, "Weekend BBQ", "Classic rock, blues, and soul for outdoor gatherings", 56, "4h 12m", "David Lee", "public", 2100, "Mar 18, 2026", "Rock"),
        new(5, "Pre-Release Review", "Tracks under consideration for next week's featured playlist", 15, "52m", "Lisa Wang", "private", 0, "Mar 23, 2026", "Mixed"),
        new(6, "Acoustic Sessions", "Stripped-down acoustic performances and unplugged recordings", 38, "2h 34m", "Tom Bradley", "public", 560, "Mar 15, 2026", "Acoustic"),
    ];

    private string _search = "";
    private string _filter = "all";

    private IEnumerable<PlaylistItem> Filtered =>
        _playlists
            .Where(p => _filter == "all" || p.Visibility == _filter)
            .Where(p =>
                p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                p.Genre.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleDelete(int id) => _playlists.RemoveAll(p => p.Id == id);

    private void HandleToggleVisibility(int id)
    {
        var idx = _playlists.FindIndex(p => p.Id == id);
        if (idx < 0) return;
        var p = _playlists[idx];
        _playlists[idx] = p with { Visibility = p.Visibility == "public" ? "private" : "public" };
    }

    private static string GetVisibilityColor(string visibility) => visibility switch
    {
        "public" => "bg-emerald-500",
        "private" => "bg-muted-foreground/40",
        "shared" => "bg-blue-500",
        _ => "bg-muted-foreground/40",
    };
}
