@* ============================================================
   Block: crud-goal-tracker
   Title: CrudGoalTracker
   Description: Goal and OKR tracking with progress visualization, key results, ownership, and deadline management
   Source: original/blocks/crud/crud-goal-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideTargetCn Class="size-4 text-muted-foreground" Size="16" />
                    <div>
                        <h2 class="text-sm font-medium">Goals &amp; OKRs</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_goals.Count goals · @_goals.Count(g => g.Status == "completed") completed
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Class="size-3.5" Size="14" />
                    New Goal
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" Size="14" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search goals..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var slug = s;
                    <button type="button"
                            @onclick="@(() => _filter = slug)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == slug ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(slug == "all" ? "All" : GetStatusLabel(slug))
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _goals
                    .Where(g => _filter == "all" || g.Status == _filter)
                    .Where(g => g.Title.ToLower().Contains(_search.ToLower()) || g.Owner.ToLower().Contains(_search.ToLower()))
                    .ToList();
            }
            @foreach (var goal in filtered)
            {
                var item = goal;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetStatusColor(item.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@item.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">@item.Team</BadgeCn>
                            </div>
                            <p class="mt-0.5 line-clamp-1 text-xs text-muted-foreground">@item.Description</p>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@item.Owner</span>
                                <span>·</span>
                                <span>@item.Quarter</span>
                                <span>·</span>
                                <span>Due @item.Deadline</span>
                                <span>·</span>
                                <span class="tabular-nums">@item.CompletedKRs/@item.KeyResults key results</span>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/20" style="@($"width:{item.Progress}%")"></div>
                                </div>
                                <span class="text-xs font-medium tabular-nums">@item.Progress%</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideEllipsisCn Class="size-4" Size="16" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>View Key Results</DropdownMenuItemCn>
                                @if (item.Status != "completed")
                                {
                                    <DropdownMenuItemCn @onclick="@(() => HandleComplete(item.Id))">Mark Complete</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => HandleDelete(item.Id))">
                                    <LucideTrash2Cn Class="mr-2 size-4" Size="16" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No goals found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class Goal
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Team { get; set; } = "";
        public string Status { get; set; } = "";
        public int Progress { get; set; }
        public int KeyResults { get; set; }
        public int CompletedKRs { get; set; }
        public string Deadline { get; set; } = "";
        public string Quarter { get; set; } = "";
    }

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "on-track", "at-risk", "behind", "completed"];

    private readonly List<Goal> _goals =
    [
        new() { Id = 1, Title = "Increase monthly active users to 50K", Description = "Grow user base through product-led growth and marketing campaigns", Owner = "Sarah Chen", Team = "Growth", Status = "on-track", Progress = 72, KeyResults = 4, CompletedKRs = 3, Deadline = "Mar 31", Quarter = "Q1 2026" },
        new() { Id = 2, Title = "Reduce API response time to <100ms p95", Description = "Optimize database queries, add caching layer, and improve indexing", Owner = "Mike Johnson", Team = "Engineering", Status = "at-risk", Progress = 45, KeyResults = 3, CompletedKRs = 1, Deadline = "Mar 31", Quarter = "Q1 2026" },
        new() { Id = 3, Title = "Launch enterprise tier with SSO", Description = "Build and ship enterprise features including SAML SSO and audit logs", Owner = "Emma Davis", Team = "Product", Status = "on-track", Progress = 85, KeyResults = 5, CompletedKRs = 4, Deadline = "Mar 31", Quarter = "Q1 2026" },
        new() { Id = 4, Title = "Achieve NPS score of 60+", Description = "Improve customer satisfaction through support response time and feature requests", Owner = "Alex Morgan", Team = "Customer Success", Status = "behind", Progress = 28, KeyResults = 3, CompletedKRs = 0, Deadline = "Mar 31", Quarter = "Q1 2026" },
        new() { Id = 5, Title = "Hire 10 senior engineers", Description = "Scale the engineering team with senior talent across backend and frontend", Owner = "Lisa Wang", Team = "People", Status = "on-track", Progress = 60, KeyResults = 4, CompletedKRs = 2, Deadline = "Jun 30", Quarter = "Q2 2026" },
        new() { Id = 6, Title = "Ship mobile app v1.0", Description = "Launch native mobile apps for iOS and Android with core feature parity", Owner = "David Lee", Team = "Mobile", Status = "completed", Progress = 100, KeyResults = 4, CompletedKRs = 4, Deadline = "Feb 28", Quarter = "Q1 2026" },
    ];

    private void HandleDelete(int id) => _goals.RemoveAll(g => g.Id == id);

    private void HandleComplete(int id)
    {
        var goal = _goals.FirstOrDefault(g => g.Id == id);
        if (goal is null) return;
        goal.Status = "completed";
        goal.Progress = 100;
        goal.CompletedKRs = goal.KeyResults;
    }

    private static string GetStatusColor(string status) => status switch
    {
        "on-track" => "bg-emerald-500",
        "at-risk" => "bg-amber-500",
        "behind" => "bg-red-500",
        "completed" => "bg-blue-500",
        _ => "bg-muted-foreground",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "on-track" => "On Track",
        "at-risk" => "At Risk",
        "behind" => "Behind",
        "completed" => "Completed",
        _ => status,
    };
}
