@* ============================================================
   Block: crud-bookmark-manager
   Title: Crud Bookmark Manager
   Description: Organize and manage saved bookmarks with categories, search, and bulk actions
   Long Description: A comprehensive bookmark manager for organizing saved resources.
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, InputCn, SelectCn
   Source: original/blocks/crud/crud-bookmark-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h2 class="font-medium text-sm">Bookmarks</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_bookmarks.Count saved items</p>
                </div>
                @if (_selected.Count > 0)
                {
                    <div class="flex items-center gap-2">
                        <span class="text-muted-foreground text-xs">@_selected.Count selected</span>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 text-xs" @onclick="DeleteSelected">
                            <LucideTrash2Cn Size="12" Class="size-3" />
                            Delete Selected
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="relative">
                <LucideSearchCn Size="16" Class="absolute top-2 left-2.5 size-4 text-muted-foreground" />
                <InputCn Placeholder="Search bookmarks..."
                         Value="@_searchQuery"
                         Class="border-0 bg-muted/50 pl-9 shadow-none focus-visible:ring-0" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm"
                              Class="absolute top-2 right-2.5"
                              @onclick="@(() => _searchQuery = "")">
                        <LucideXCn Size="16" Class="size-4 text-muted-foreground" />
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex items-center gap-3">
                <CheckboxCn Checked="@(_filteredBookmarks.Count > 0 && _selected.Count == _filteredBookmarks.Count)"
                            CheckedChanged="@(_ => ToggleSelectAll())" />
                <span class="text-muted-foreground text-xs">Select all</span>
            </div>
        </div>

        <div>
            @if (_filteredBookmarks.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <p class="text-muted-foreground text-sm">No bookmarks found</p>
                </div>
            }
            else
            {
                @foreach (var bookmark in _filteredBookmarks)
                {
                    <div class="flex items-start gap-3 border-b px-4 py-3 transition-colors last:border-0 hover:bg-muted/50">
                        <CheckboxCn Checked="@_selected.Contains(bookmark.Id)" Class="mt-0.5"
                                    CheckedChanged="@(_ => ToggleSelect(bookmark.Id))" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start gap-2">
                                <h3 class="flex-1 font-medium text-sm">@bookmark.Title</h3>
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="@Cn.Merge("border-0 text-xs", GetCategoryColor(bookmark.Category))">
                                    @bookmark.Category
                                </BadgeCn>
                            </div>
                            <p class="mt-1 truncate font-mono text-muted-foreground text-xs">
                                @bookmark.Url
                            </p>
                            <p class="mt-1 text-muted-foreground text-xs">Saved @bookmark.Saved</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="size-7 p-0" @onclick="@(() => ToggleStar(bookmark.Id))">
                                <LucideStarCn Size="16" Class="@Cn.Merge("size-4", bookmark.Starred ? "fill-amber-500 text-amber-500" : "text-muted-foreground")" />
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="size-7 p-0">
                                <LucideCopyCn Size="16" Class="size-4 text-muted-foreground" />
                            </ButtonCn>
                            <SelectCn Value="@bookmark.Category">
                                <SelectTriggerCn Class="h-7 w-7 border-0 p-0 shadow-none">
                                    <LucideFolderCn Size="16" Class="size-4 text-muted-foreground" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="Design">Design</SelectItemCn>
                                    <SelectItemCn Value="Dev">Dev</SelectItemCn>
                                    <SelectItemCn Value="Marketing">Marketing</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private class BookmarkItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Url { get; set; } = "";
        public string Category { get; set; } = "";
        public string Saved { get; set; } = "";
        public bool Starred { get; set; }
    }

    private string _searchQuery = "";
    private readonly HashSet<string> _selected = [];

    private readonly List<BookmarkItem> _bookmarks =
    [
        new() { Id = "1", Title = "Figma Component Library", Url = "https://figma.com/file/abc123", Category = "Design", Saved = "2 days ago", Starred = true },
        new() { Id = "2", Title = "React Best Practices 2026", Url = "https://react.dev/learn/best-practices", Category = "Dev", Saved = "1 week ago", Starred = false },
        new() { Id = "3", Title = "Content Marketing Guide", Url = "https://example.com/marketing-guide", Category = "Marketing", Saved = "3 days ago", Starred = true },
        new() { Id = "4", Title = "Tailwind CSS Documentation", Url = "https://tailwindcss.com/docs", Category = "Dev", Saved = "5 days ago", Starred = false },
        new() { Id = "5", Title = "Typography Inspiration", Url = "https://fonts.google.com/knowledge", Category = "Design", Saved = "1 week ago", Starred = false },
        new() { Id = "6", Title = "SEO Checklist 2026", Url = "https://example.com/seo-checklist", Category = "Marketing", Saved = "4 days ago", Starred = true },
    ];

    private List<BookmarkItem> _filteredBookmarks => _bookmarks.Where(b =>
        string.IsNullOrEmpty(_searchQuery) ||
        b.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
        b.Url.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    private void ToggleStar(string id)
    {
        var b = _bookmarks.Find(x => x.Id == id);
        if (b != null) b.Starred = !b.Starred;
    }

    private void ToggleSelect(string id) { if (!_selected.Remove(id)) _selected.Add(id); }

    private void ToggleSelectAll()
    {
        var filtered = _filteredBookmarks;
        if (_selected.Count == filtered.Count) _selected.Clear();
        else foreach (var b in filtered) _selected.Add(b.Id);
    }

    private void DeleteSelected()
    {
        _bookmarks.RemoveAll(b => _selected.Contains(b.Id));
        _selected.Clear();
    }

    private static string GetCategoryColor(string category) => category switch
    {
        "Design" => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        "Dev" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Marketing" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _ => "bg-muted text-muted-foreground",
    };
}
