@* ============================================================
   Block: crud-create-post
   Title: Create Blog Post
   Description: CRUD form for creating new blog posts with title, slug, content editor, category, tags, featured image, and publish settings
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn, TextareaCn
   Source: original/blocks/crud/crud-create-post.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Create New Post</h2>
            <p class="mt-1 text-xs text-muted-foreground">Write and publish your blog post</p>
        </div>

        <form action="#">
            <div class="divide-y">
                <div class="px-4 py-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">Post Title *</span>
                        <InputCn Placeholder="Enter an engaging title" type="text" aria-label="Title" />
                    </div>
                </div>

                <div class="px-4 py-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">URL Slug *</span>
                        <div class="flex gap-2">
                            <InputCn Class="flex-1" Placeholder="auto-generated-from-title" type="text" aria-label="URL slug" />
                            <ButtonCn Size="ButtonSize.Sm" type="button" Variant="ButtonVariant.Outline">Generate</ButtonCn>
                        </div>
                        <p class="text-xs text-muted-foreground">
                            yoursite.com/blog/<span class="text-foreground">slug-here</span>
                        </p>
                    </div>
                </div>

                <div class="px-4 py-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">Content *</span>
                        <TextareaCn Class="resize-none" Placeholder="Write your post content here..." rows="10" aria-label="Content" />
                        <p class="text-xs text-muted-foreground">0 words</p>
                    </div>
                </div>

                <div class="px-4 py-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">Excerpt</span>
                        <TextareaCn Placeholder="Brief summary for previews (150-200 characters)" rows="2" aria-label="Excerpt" />
                    </div>
                </div>

                <div class="px-4 py-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">Featured Image</span>
                        <div class="flex cursor-pointer items-center gap-3 rounded-md border border-dashed p-4 transition-colors hover:border-foreground/30">
                            <LucideUploadCn Size="20" Class="size-5 text-muted-foreground" />
                            <div>
                                <p class="text-sm text-muted-foreground">Click to upload</p>
                                <p class="text-xs text-muted-foreground/60">PNG, JPG up to 5MB</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="px-4 py-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">Category *</span>
                        <SelectCn>
                            <SelectTriggerCn aria-label="Select category">
                                <SelectValueCn Placeholder="Select category" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="technology">Technology</SelectItemCn>
                                <SelectItemCn Value="design">Design</SelectItemCn>
                                <SelectItemCn Value="business">Business</SelectItemCn>
                                <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>

                <div class="px-4 py-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">Tags</span>
                        @if (_tags.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var tag in _tags)
                                {
                                    <BadgeCn Class="gap-1 text-xs" Variant="BadgeVariant.Secondary">
                                        @tag
                                        <button class="hover:text-destructive" type="button" @onclick="@(() => _tags.Remove(tag))" aria-label="@($"Remove {tag}")">
                                            <LucideXCn Size="12" Class="size-3" />
                                        </button>
                                    </BadgeCn>
                                }
                            </div>
                        }
                        <div class="flex gap-2">
                            <InputCn Class="flex-1" Placeholder="Add tag" Value="@_newTag" aria-label="Add tag" />
                            <ButtonCn Size="ButtonSize.Sm" type="button" Variant="ButtonVariant.Outline" @onclick="AddTag">Add</ButtonCn>
                        </div>
                    </div>
                </div>

                <div class="space-y-1 px-4 py-4">
                    <div class="flex items-center justify-between py-2">
                        <div>
                            <span class="text-sm font-medium">Featured Post</span>
                            <p class="text-xs text-muted-foreground">Show on homepage</p>
                        </div>
                        <SwitchCn aria-label="Featured Post" />
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <div>
                            <span class="text-sm font-medium">Allow Comments</span>
                            <p class="text-xs text-muted-foreground">Enable discussions</p>
                        </div>
                        <SwitchCn Checked="true" aria-label="Allow Comments" />
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <div>
                            <span class="text-sm font-medium">Schedule Post</span>
                            <p class="text-xs text-muted-foreground">Publish at specific time</p>
                        </div>
                        <SwitchCn Checked="@_isScheduled" CheckedChanged="@(v => _isScheduled = v)" aria-label="Schedule Post" />
                    </div>
                    @if (_isScheduled)
                    {
                        <div class="pt-2">
                            <ButtonCn Class="w-full justify-start text-left font-normal" type="button" Variant="ButtonVariant.Outline">
                                <LucideCalendarCn Size="16" Class="mr-2 size-4" />
                                Pick a date
                            </ButtonCn>
                        </div>
                    }
                </div>

                <div class="flex gap-2 px-4 py-4">
                    <ButtonCn Class="flex-1" type="submit">Publish Now</ButtonCn>
                    <ButtonCn Class="flex-1" type="button" Variant="ButtonVariant.Outline">Save Draft</ButtonCn>
                    <ButtonCn type="button" Variant="ButtonVariant.Ghost">Discard</ButtonCn>
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private readonly List<string> _tags = ["React", "TypeScript"];
    private string _newTag = "";
    private bool _isScheduled;

    private void AddTag()
    {
        if (!string.IsNullOrWhiteSpace(_newTag) && !_tags.Contains(_newTag.Trim()))
        {
            _tags.Add(_newTag.Trim());
            _newTag = "";
        }
    }
}
