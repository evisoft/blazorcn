@* ============================================================
   Block: crud-dashboard-widgets
   Title: Dashboard Widget Manager
   Description: Configure and reorder dashboard widgets with visibility toggles
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/crud/crud-dashboard-widgets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideLayoutDashboardCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">Dashboard Widgets</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideSettingsCn Size="14" Class="size-3.5" />
                    Settings
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">
                        @_widgets.Count(w => w.Enabled) of @_widgets.Count widgets enabled
                    </p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Drag to reorder, toggle to show or hide</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Reset to Default</ButtonCn>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _widgets.Count; i++)
            {
                var index = i;
                var widget = _widgets[index];
                var isLast = index == _widgets.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "", !widget.Enabled ? "opacity-60" : "")">
                    <div class="flex shrink-0 flex-col gap-1">
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" Disabled="@(index == 0)"
                                @onclick="@(() => MoveWidget(index, -1))" aria-label="Move up">
                            <LucideArrowUpCn Size="14" Class="size-3.5" />
                        </ButtonCn>
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" Disabled="@isLast"
                                @onclick="@(() => MoveWidget(index, 1))" aria-label="Move down">
                            <LucideArrowDownCn Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>

                    <div class="min-w-0 flex-1">
                        <div class="mb-1 flex items-center gap-2">
                            <span class="text-sm font-medium">@widget.Name</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-5 rounded-md px-1.5 text-xs {GetSizeColor(widget.Size)}")">
                                @widget.Size
                            </BadgeCn>
                        </div>
                        <p class="text-xs text-muted-foreground">@widget.Description</p>
                        <div class="mt-1 flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">@widget.Category</span>
                        </div>
                    </div>

                    <div class="flex shrink-0 items-center gap-2">
                        @if (widget.Enabled)
                        {
                            <LucideEyeCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideEyeOffCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        <SwitchCn Checked="@widget.Enabled" CheckedChanged="@(_ => ToggleWidget(widget.Id))" aria-label="@widget.Name" />
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">Changes are saved automatically</p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Apply Changes</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private class WidgetItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Size { get; set; } = "";
        public bool Enabled { get; set; }
        public string Category { get; set; } = "";
    }

    private readonly List<WidgetItem> _widgets =
    [
        new() { Id = "revenue", Name = "Revenue Chart", Description = "Monthly revenue trends with year-over-year comparison", Size = "2x1", Enabled = true, Category = "Analytics" },
        new() { Id = "users", Name = "Active Users", Description = "Real-time active user count and session duration", Size = "1x1", Enabled = true, Category = "Analytics" },
        new() { Id = "orders", Name = "Recent Orders", Description = "Latest orders with status and fulfillment tracking", Size = "Full Width", Enabled = true, Category = "Sales" },
        new() { Id = "health", Name = "System Health", Description = "Server uptime, response time, and error rates", Size = "2x1", Enabled = false, Category = "Operations" },
        new() { Id = "tasks", Name = "Task Overview", Description = "Pending tasks, deadlines, and team assignments", Size = "1x1", Enabled = true, Category = "Productivity" },
        new() { Id = "notifications", Name = "Recent Notifications", Description = "System alerts and user activity notifications", Size = "1x1", Enabled = false, Category = "System" },
        new() { Id = "conversion", Name = "Conversion Funnel", Description = "User journey stages with drop-off analysis", Size = "Full Width", Enabled = true, Category = "Analytics" },
        new() { Id = "support", Name = "Support Tickets", Description = "Open tickets by priority and average response time", Size = "2x1", Enabled = false, Category = "Support" },
    ];

    private void ToggleWidget(string id)
    {
        var w = _widgets.Find(x => x.Id == id);
        if (w != null) w.Enabled = !w.Enabled;
    }

    private void MoveWidget(int index, int direction)
    {
        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= _widgets.Count) return;
        (_widgets[index], _widgets[newIndex]) = (_widgets[newIndex], _widgets[index]);
    }

    private static string GetSizeColor(string size) => size switch
    {
        "1x1" => "bg-blue-500/10 text-blue-700",
        "2x1" => "bg-purple-500/10 text-purple-700",
        "Full Width" => "bg-emerald-500/10 text-emerald-700",
        _ => "bg-muted text-muted-foreground",
    };
}
