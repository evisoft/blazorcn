@* ============================================================
   Block: crud-status-workflow
   Title: Status Workflow
   Description: CRUD status workflow interface showing record state transitions with visual timeline, allowed next states, and validation requirements
   Dependencies: BadgeCn, ButtonCn, LabelCn, TextareaCn
   Source: original/blocks/crud/crud-status-workflow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-6 py-5">
            <div>
                <h2 class="text-sm font-medium">Blog Post: Getting Started with React</h2>
                <p class="mt-1 text-xs text-muted-foreground">ID: POST-001</p>
            </div>
            <BadgeCn Class="flex items-center gap-1"
                     Variant="@(_currentStatus == "rejected" ? BadgeVariant.Destructive : _currentStatus == "draft" ? BadgeVariant.Secondary : BadgeVariant.Default)">
                @GetStatusLabel(_currentStatus)
            </BadgeCn>
        </div>

        <div class="grid lg:grid-cols-3">
            <div class="lg:col-span-2 lg:border-r">
                <div class="border-b px-4 py-3">
                    <span class="mb-2.5 block text-xs font-medium text-muted-foreground">Available Actions</span>
                    <div class="flex flex-wrap gap-2">
                        @{
                            var transitions = GetTransitions(_currentStatus);
                        }
                        @foreach (var status in transitions)
                        {
                            <ButtonCn Class="h-8 gap-1.5 text-xs" Size="ButtonSize.Sm"
                                      Variant="@(status == "rejected" ? ButtonVariant.Destructive : ButtonVariant.Outline)"
                                      @onclick="@(() => { _targetStatus = status; _showDialog = true; })">
                                @GetTransitionLabel(status)
                            </ButtonCn>
                        }
                    </div>
                </div>

                <div class="px-4 py-3">
                    <span class="mb-2.5 block text-xs font-medium text-muted-foreground">Status History</span>
                    <div class="space-y-0">
                        @for (var i = 0; i < _history.Count; i++)
                        {
                            var entry = _history[i];
                            var isLastEntry = i == _history.Count - 1;
                            <div class="flex gap-3">
                                <div class="relative flex flex-col items-center">
                                    <div class="@Cn.Merge("rounded-full p-1.5", isLastEntry ? "bg-foreground text-background" : "bg-muted")">
                                        <LucideFileTextCn Size="14" Class="size-3.5" />
                                    </div>
                                    @if (!isLastEntry)
                                    {
                                        <div class="mt-1 h-full w-px bg-border"></div>
                                    }
                                </div>
                                <div class="flex-1 pb-4">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@GetStatusLabel(entry.Status)</span>
                                        <span class="text-xs text-muted-foreground">@entry.Timestamp</span>
                                    </div>
                                    <p class="text-xs text-muted-foreground">@entry.User</p>
                                    @if (!string.IsNullOrEmpty(entry.Notes))
                                    {
                                        <p class="mt-0.5 text-xs text-muted-foreground">@entry.Notes</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="border-t px-4 py-3 lg:border-t-0">
                <span class="mb-2.5 block text-xs font-medium text-muted-foreground">Workflow Requirements</span>
                <div class="space-y-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="mb-1.5 text-xs font-medium">For Review</p>
                        <ul class="space-y-0.5 text-xs text-muted-foreground">
                            <li>Title</li>
                            <li>Content</li>
                            <li>Category</li>
                        </ul>
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="mb-1.5 text-xs font-medium">For Publishing</p>
                        <ul class="space-y-0.5 text-xs text-muted-foreground">
                            <li>All review requirements</li>
                            <li>Featured image</li>
                            <li>SEO metadata</li>
                            <li>Manager approval</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_showDialog)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="@(() => _showDialog = false)">
            <div class="mx-4 w-full max-w-md rounded-lg border bg-card p-6" @onclick:stopPropagation="true">
                <h3 class="text-lg font-semibold">@GetTransitionLabel(_targetStatus)</h3>
                <p class="mt-1 text-sm text-muted-foreground">@GetTransitionDescription(_targetStatus)</p>
                <div class="mt-4 space-y-2">
                    <LabelCn>Notes @(_targetStatus == "rejected" ? "(Required)" : "(Optional)")</LabelCn>
                    <TextareaCn Placeholder="Add any comments or feedback..." rows="3" Value="@_notes" />
                </div>
                <div class="mt-4 flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _showDialog = false)">Cancel</ButtonCn>
                    <ButtonCn Variant="@(_targetStatus == "rejected" ? ButtonVariant.Destructive : ButtonVariant.Default)"
                              Disabled="@(_targetStatus == "rejected" && string.IsNullOrWhiteSpace(_notes))"
                              @onclick="HandleTransition">
                        Confirm
                    </ButtonCn>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private class HistoryEntry
    {
        public string Status { get; set; } = "";
        public string User { get; set; } = "";
        public string Timestamp { get; set; } = "";
        public string? Notes { get; set; }
    }

    private string _currentStatus = "approved";
    private string _notes = "";
    private bool _showDialog;
    private string _targetStatus = "";

    private readonly List<HistoryEntry> _history =
    [
        new() { Status = "draft", User = "Sarah Chen", Timestamp = "Mar 10, 2024 at 9:00 AM", Notes = "Initial draft created" },
        new() { Status = "review", User = "Sarah Chen", Timestamp = "Mar 12, 2024 at 2:30 PM", Notes = "Submitted for review" },
        new() { Status = "approved", User = "Mike Johnson", Timestamp = "Mar 13, 2024 at 10:15 AM", Notes = "Looks good, approved for publishing" },
    ];

    private void HandleTransition()
    {
        if (string.IsNullOrEmpty(_targetStatus)) return;
        _history.Add(new HistoryEntry
        {
            Status = _targetStatus,
            User = "Current User",
            Timestamp = "Just now",
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes,
        });
        _currentStatus = _targetStatus;
        _notes = "";
        _showDialog = false;
        _targetStatus = "";
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "draft" => "Draft",
        "review" => "In Review",
        "approved" => "Approved",
        "published" => "Published",
        "rejected" => "Rejected",
        _ => status,
    };

    private static string GetTransitionLabel(string status) => status switch
    {
        "review" => "Submit for Review",
        "approved" => "Approve",
        "published" => "Publish",
        "rejected" => "Reject",
        "draft" => "Move to Draft",
        _ => status,
    };

    private static string GetTransitionDescription(string status) => status switch
    {
        "published" => "This will make the post visible to all users.",
        "review" => "This will notify reviewers to check the content.",
        "approved" => "This will approve the post for publishing.",
        "rejected" => "This will send the post back to draft.",
        "draft" => "This will move the post back to draft status.",
        _ => "",
    };

    private static string[] GetTransitions(string status) => status switch
    {
        "draft" => ["review"],
        "review" => ["approved", "rejected", "draft"],
        "approved" => ["published", "review"],
        "published" => [],
        "rejected" => ["draft"],
        _ => [],
    };
}
