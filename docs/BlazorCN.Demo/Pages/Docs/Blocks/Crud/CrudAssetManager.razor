@* ============================================================
   Block: crud-asset-manager
   Title: CrudAssetManager
   Description: Digital asset management with file type indicators, metadata editing, and organizational tagging for media libraries
   Source: original/blocks/crud/crud-asset-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Assets</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_totalSize files</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Class="size-3.5" Size="14" />
                    Upload
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" Size="14" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search assets..."
                         @bind-Value="_search" aria-label="Search assets" />
            </div>
            <div class="flex gap-1">
                @foreach (var t in _filterTypes)
                {
                    var type = t;
                    var label = type == "all" ? "All" : (char.ToUpper(type[0]) + type.Substring(1));
                    <button type="button"
                            @onclick="@(() => _typeFilter = type)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _typeFilter == type ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @label
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var asset in Filtered)
            {
                var a = asset;
                <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        @if (a.Type == "image")
                        {
                            <LucideFileImageCn Class="size-4 text-muted-foreground" Size="16" />
                        }
                        else if (a.Type == "document")
                        {
                            <LucideFileTextCn Class="size-4 text-muted-foreground" Size="16" />
                        }
                        else if (a.Type == "video")
                        {
                            <LucideFileVideoCameraCn Class="size-4 text-muted-foreground" Size="16" />
                        }
                        else
                        {
                            <LucideFileCn Class="size-4 text-muted-foreground" Size="16" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        @if (_editingId == a.Id)
                        {
                            <div class="flex items-center gap-2">
                                <InputCn Class="h-7 text-xs" @bind-Value="_editName" @onkeydown="@((e) => { if (e.Key == "Enter") HandleRename(a.Id); })" aria-label="Asset name" />
                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => HandleRename(a.Id))">Save</ButtonCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7" OnClick="@(() => _editingId = null)" aria-label="Close">
                                    <LucideXCn Class="size-3.5" Size="14" />
                                </ButtonCn>
                            </div>
                        }
                        else
                        {
                            <p class="truncate text-sm font-medium">@a.Name</p>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@a.Size</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@a.Uploaded</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@a.Author</span>
                            </div>
                        }
                    </div>
                    @if (_editingId != a.Id)
                    {
                        <div class="hidden gap-1 sm:flex">
                            @foreach (var tag in a.Tags)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">@tag</BadgeCn>
                            }
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                    <LucideEllipsisCn Class="size-4" Size="16" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn OnClick="@(() => { _editingId = a.Id; _editName = a.Name; })">
                                    <LucidePencilCn Class="mr-2 size-4" Size="16" />
                                    Rename
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>Download</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Copy URL</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(a.Id))">
                                    <LucideTrashCn Class="mr-2 size-4" Size="16" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    }
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No assets found
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-2">
            <span class="text-xs text-muted-foreground">
                Showing @Filtered.Count() of @_assets.Count assets
            </span>
        </div>
    </div>
</section>

@code {
    private record Asset(int Id, string Name, string Type, string Size, string[] Tags, string Uploaded, string Author);

    private static readonly string[] _filterTypes = ["all", "image", "document", "video"];

    private List<Asset> _assets = new List<Asset>
    {
        new(1, "hero-banner.png",       "image",    "2.4 MB",  ["marketing", "homepage"],  "Mar 20, 2026", "Sarah Chen"),
        new(2, "brand-guidelines.pdf",  "document", "8.1 MB",  ["brand", "design"],         "Mar 18, 2026", "Mike Johnson"),
        new(3, "product-demo.mp4",      "video",    "156 MB",  ["product", "demo"],         "Mar 15, 2026", "Emma Davis"),
        new(4, "team-photo.jpg",        "image",    "3.7 MB",  ["team", "about"],           "Mar 12, 2026", "David Lee"),
        new(5, "api-docs.pdf",          "document", "1.2 MB",  ["docs", "api"],             "Mar 10, 2026", "Alex Morgan"),
        new(6, "onboarding-video.mp4",  "video",    "89 MB",   ["onboarding", "training"],  "Mar 8, 2026",  "Lisa Wang"),
        new(7, "logo-dark.svg",         "image",    "24 KB",   ["brand", "logo"],           "Mar 5, 2026",  "Sarah Chen"),
        new(8, "quarterly-report.xlsx", "other",    "540 KB",  ["finance", "report"],       "Mar 3, 2026",  "Tom Brown"),
    };

    private string _search = "";
    private string _typeFilter = "all";
    private int? _editingId = null;
    private string _editName = "";

    private int _totalSize => _assets.Count;

    private IEnumerable<Asset> Filtered =>
        _assets
            .Where(a => _typeFilter == "all" || a.Type == _typeFilter)
            .Where(a => a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || a.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private void HandleDelete(int id)
    {
        _assets.RemoveAll(a => a.Id == id);
    }

    private void HandleRename(int id)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        var idx = _assets.FindIndex(a => a.Id == id);
        if (idx >= 0)
        {
            var old = _assets[idx];
            _assets[idx] = old with { Name = _editName };
        }
        _editingId = null;
    }
}
