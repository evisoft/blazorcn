@* ============================================================
   Block: crud-database-browser
   Title: CrudDatabaseBrowser
   Description: Database table browser with schema inspection, row editing, and SQL-like filtering for database administration
   Source: original/blocks/crud/crud-database-browser.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Database Browser</h2>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Insert Row
                </ButtonCn>
            </div>
        </div>

        <div class="flex border-b">
            @foreach (var tbl in _tables)
            {
                var tblItem = tbl;
                <button
                    type="button"
                    @onclick="@(() => SelectTable(tblItem.Name))"
                    class="@Cn.Merge("border-b-2 px-4 py-2 text-xs font-medium transition-colors", _selectedTable == tblItem.Name ? "border-foreground text-foreground" : "border-transparent text-muted-foreground hover:text-foreground")">
                    @tblItem.Name
                    <span class="ml-1.5 text-muted-foreground">(@tblItem.RowCount.ToString("N0"))</span>
                </button>
            }
        </div>

        @{
            var currentTable = _tables.FirstOrDefault(t => t.Name == _selectedTable);
        }
        @if (currentTable != null)
        {
            <div class="border-b bg-muted/30 px-4 py-2">
                <div class="flex flex-wrap gap-2">
                    @foreach (var col in currentTable.Columns)
                    {
                        <span class="flex items-center gap-1 text-xs text-muted-foreground">
                            <span class="font-mono font-medium text-foreground">@col.Name</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[9px] px-1 py-0">@col.Type</BadgeCn>
                        </span>
                    }
                </div>
            </div>
        }

        <div class="border-b px-4 py-2">
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Filter rows..."
                         @bind-Value="_search" />
            </div>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="text-xs">id</TableHeadCn>
                    <TableHeadCn Class="text-xs">name</TableHeadCn>
                    <TableHeadCn Class="text-xs">email</TableHeadCn>
                    <TableHeadCn Class="text-xs">role</TableHeadCn>
                    <TableHeadCn Class="text-xs">created_at</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs"></TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var row in Filtered)
                {
                    var rowItem = row;
                    <TableRowCn>
                        <TableCellCn Class="font-mono text-xs text-muted-foreground">@rowItem.Id</TableCellCn>
                        <TableCellCn Class="text-xs">
                            @if (_editingId == rowItem.Id)
                            {
                                <InputCn Class="h-6 text-xs" @bind-Value="_editName" />
                            }
                            else
                            {
                                @rowItem.Name
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-xs text-muted-foreground">
                            @if (_editingId == rowItem.Id)
                            {
                                <InputCn Class="h-6 text-xs" @bind-Value="_editEmail" />
                            }
                            else
                            {
                                @rowItem.Email
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-xs">
                            @if (_editingId == rowItem.Id)
                            {
                                <InputCn Class="h-6 w-20 text-xs" @bind-Value="_editRole" />
                            }
                            else
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">@rowItem.Role</BadgeCn>
                            }
                        </TableCellCn>
                        <TableCellCn Class="font-mono text-xs text-muted-foreground">@rowItem.CreatedAt</TableCellCn>
                        <TableCellCn>
                            <div class="flex gap-1">
                                @if (_editingId == rowItem.Id)
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-6 text-xs" @onclick="@(() => SaveEdit(rowItem.Id))">Save</ButtonCn>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 text-xs" @onclick="@(() => CancelEdit())">Cancel</ButtonCn>
                                }
                                else
                                {
                                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6" @onclick="@(() => StartEdit(rowItem))">
                                        <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-destructive" @onclick="@(() => DeleteRow(rowItem.Id))">
                                        <LucideIconCn Name="trash" Size="12" Class="size-3" />
                                    </ButtonCn>
                                }
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>

        <div class="border-t bg-muted/30 px-4 py-2">
            <span class="text-xs text-muted-foreground">
                Showing @Filtered.Count() of @_rows.Count rows
            </span>
        </div>
    </div>
</section>

@code {
    private record ColumnDef(string Name, string Type);
    private record TableDef(string Name, int RowCount, ColumnDef[] Columns);

    private class UserRow
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string CreatedAt { get; set; } = "";
    }

    private static readonly TableDef[] _tables =
    [
        new("users", 1247,
        [
            new("id", "int"),
            new("name", "varchar"),
            new("email", "varchar"),
            new("role", "enum"),
            new("created_at", "timestamp"),
        ]),
        new("orders", 5823,
        [
            new("id", "int"),
            new("user_id", "int"),
            new("total", "decimal"),
            new("status", "enum"),
            new("created_at", "timestamp"),
        ]),
        new("products", 342,
        [
            new("id", "int"),
            new("name", "varchar"),
            new("price", "decimal"),
            new("stock", "int"),
            new("category", "varchar"),
        ]),
    ];

    private List<UserRow> _rows =
    [
        new() { Id = 1, Name = "Sarah Chen",   Email = "sarah@@example.com",  Role = "admin",  CreatedAt = "2024-01-15 09:30:00" },
        new() { Id = 2, Name = "Mike Johnson", Email = "mike@@example.com",   Role = "editor", CreatedAt = "2024-02-03 14:22:00" },
        new() { Id = 3, Name = "Emma Davis",   Email = "emma@@example.com",   Role = "viewer", CreatedAt = "2024-02-18 11:45:00" },
        new() { Id = 4, Name = "David Lee",    Email = "david@@example.com",  Role = "admin",  CreatedAt = "2024-03-01 08:15:00" },
        new() { Id = 5, Name = "Alex Morgan",  Email = "alex@@example.com",   Role = "editor", CreatedAt = "2024-03-12 16:30:00" },
        new() { Id = 6, Name = "Lisa Wang",    Email = "lisa@@example.com",   Role = "viewer", CreatedAt = "2024-03-20 10:00:00" },
    ];

    private string _selectedTable = "users";
    private string _search = "";
    private int? _editingId = null;
    private string _editName = "";
    private string _editEmail = "";
    private string _editRole = "";

    private IEnumerable<UserRow> Filtered =>
        _rows.Where(r =>
            r.Id.ToString().Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            r.Email.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            r.Role.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            r.CreatedAt.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void SelectTable(string name) => _selectedTable = name;

    private void DeleteRow(int id) => _rows.RemoveAll(r => r.Id == id);

    private void StartEdit(UserRow row)
    {
        _editingId = row.Id;
        _editName = row.Name;
        _editEmail = row.Email;
        _editRole = row.Role;
    }

    private void SaveEdit(int id)
    {
        var row = _rows.FirstOrDefault(r => r.Id == id);
        if (row != null)
        {
            row.Name = _editName;
            row.Email = _editEmail;
            row.Role = _editRole;
        }
        _editingId = null;
    }

    private void CancelEdit() => _editingId = null;
}
