@* ============================================================
   Block: crud-coupon-manager
   Title: CrudCouponManager
   Description: Discount coupon CRUD with code generation, usage limits, expiry dates, and activation controls
   Source: original/blocks/crud/crud-coupon-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideTagCn Class="size-4 text-muted-foreground" Size="16" />
                    <div>
                        <h2 class="text-sm font-medium">Coupons</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @(_coupons.Count(c => c.Active)) active · @_coupons.Count total
                        </p>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                          OnClick="@(() => _showAdd = !_showAdd)">
                    <LucidePlusCn Class="size-3.5" Size="14" />
                    New Coupon
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="flex items-center gap-2">
                    <InputCn Placeholder="CODE" Class="h-8 w-28 font-mono text-xs uppercase"
                             @bind-Value="_newCode" aria-label="Coupon code" />
                    <InputCn Placeholder="Description" Class="h-8 flex-1 text-xs"
                             @bind-Value="_newDescription" aria-label="Description" />
                    <InputCn Placeholder="% off" Class="h-8 w-16 text-xs"
                             @bind-Value="_newDiscountValue" aria-label="Discount percentage" />
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="HandleAdd">
                        Create
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs"
                              OnClick="@(() => _showAdd = false)">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        <div>
            @foreach (var coupon in _coupons)
            {
                var item = coupon;
                <div class="@Cn.Merge("flex items-center gap-4 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50", !item.Active ? "opacity-50" : "")">
                    <SwitchCn Checked="@item.Active" CheckedChanged="@(() => ToggleActive(item.Id))" Class="shrink-0" aria-label="@item.Code" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="rounded bg-muted px-2 py-0.5 font-mono text-xs font-medium">@item.Code</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                @(item.DiscountType == "percentage" ? $"{item.DiscountValue}%" : $"${item.DiscountValue}")
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@item.Description</p>
                        <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                            <span>
                                @item.UsageCount.ToString("N0") used@(item.UsageLimit > 0 ? $" / {item.UsageLimit.ToString("N0")} limit" : "")
                            </span>
                            <span>·</span>
                            <span>Expires @item.ExpiresAt</span>
                            @if (item.MinOrderValue > 0)
                            {
                                <span>·</span>
                                <span>Min $@item.MinOrderValue</span>
                            }
                        </div>
                    </div>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                <LucideEllipsisCn Class="size-4" Size="16" />
                            </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuItemCn>
                                <LucideCopyCn Class="mr-2 size-4" Size="16" />
                                Copy Code
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                            <DropdownMenuItemCn>View Usage</DropdownMenuItemCn>
                            <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(item.Id))">
                                <LucideTrashCn Class="mr-2 size-4" Size="16" />
                                Delete
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Coupon(
        int Id,
        string Code,
        string Description,
        string DiscountType,
        int DiscountValue,
        int UsageCount,
        int UsageLimit,
        string ExpiresAt,
        bool Active,
        int MinOrderValue);

    private bool _showAdd;
    private string _newCode = "";
    private string _newDescription = "";
    private string _newDiscountValue = "";

    private List<Coupon> _coupons =
    [
        new(1, "SPRING25",  "Spring sale 25% off",        "percentage", 25, 342,  1000, "Apr 30, 2026", true,  50),
        new(2, "WELCOME10", "New customer discount",       "percentage", 10, 1567, 0,    "Dec 31, 2026", true,  0),
        new(3, "FLAT20",    "$20 off any order",           "fixed",      20, 89,   500,  "May 15, 2026", true,  100),
        new(4, "VIP50",     "VIP exclusive 50% off",       "percentage", 50, 23,   50,   "Mar 31, 2026", false, 200),
        new(5, "FREESHIP",  "Free shipping on orders",     "fixed",      15, 2340, 0,    "Jun 30, 2026", true,  75),
        new(6, "LOYALTY15", "Loyalty program discount",    "percentage", 15, 456,  2000, "Dec 31, 2026", true,  0),
    ];

    private void ToggleActive(int id)
    {
        var idx = _coupons.FindIndex(c => c.Id == id);
        if (idx >= 0)
        {
            var c = _coupons[idx];
            _coupons[idx] = c with { Active = !c.Active };
        }
    }

    private void HandleDelete(int id) => _coupons.RemoveAll(c => c.Id == id);

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newCode)) return;
        var newId = _coupons.Count > 0 ? _coupons.Max(c => c.Id) + 1 : 1;
        var discount = int.TryParse(_newDiscountValue, out var d) ? d : 10;
        _coupons.Add(new Coupon(
            newId,
            _newCode.ToUpperInvariant(),
            _newDescription,
            "percentage",
            discount,
            0,
            0,
            "Dec 31, 2026",
            true,
            0));
        _newCode = "";
        _newDescription = "";
        _newDiscountValue = "";
        _showAdd = false;
    }
}
