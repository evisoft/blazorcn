@* ============================================================
   Block: crud-label-printer
   Title: CrudLabelPrinter
   Description: Label and badge template editor with size presets, field mapping, batch printing, and template management
   Source: original/blocks/crud/crud-label-printer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="printer" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Label Templates</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_templates.Count templates · @_templates.Count(t => t.Status == "active") active
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Template
                </ButtonCn>
            </div>
        </div>

        @* Search & Filter *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search templates..."
                         @bind-Value="_search" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var slug = s;
                    <button type="button"
                            @onclick="@(() => _filter = slug)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == slug ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(slug == "all" ? "All" : char.ToUpper(slug[0]) + slug.Substring(1))
                    </button>
                }
            </div>
        </div>

        @* Template List *@
        <div>
            @{
                var filtered = _templates
                    .Where(t => _filter == "all" || t.Type == _filter)
                    .Where(t => t.Name.ToLower().Contains(_search.ToLower()))
                    .ToList();
            }
            @foreach (var tmpl in filtered)
            {
                var template = tmpl;
                var statusColor = template.Status switch { "active" => "bg-emerald-500", "draft" => "bg-amber-500", _ => "bg-muted-foreground/40" };
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {statusColor}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@template.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">@template.Type</BadgeCn>
                                <span class="font-mono text-[10px] text-muted-foreground">@template.Size</span>
                            </div>
                            <div class="mt-1.5 flex gap-1">
                                @foreach (var field in template.Fields)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">@field</span>
                                }
                            </div>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@template.CreatedBy</span>
                                <span>·</span>
                                <span class="tabular-nums">@template.PrintCount.ToString("N0") printed</span>
                                <span>·</span>
                                <span>Last: @template.LastPrinted</span>
                            </div>
                        </div>

                        @* Actions dropdown *@
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit Template</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Preview</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Print Batch</DropdownMenuItemCn>
                                @if (template.Status != "active")
                                {
                                    var tid = template.Id;
                                    <DropdownMenuItemCn OnClick="@(() => HandleActivate(tid))">Activate</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                @{
                                    var delId = template.Id;
                                }
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(delId))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No templates found
                </div>
            }
        </div>

    </div>
</section>

@code {
    private class LabelTemplate
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
        public string Size { get; set; } = "";
        public string[] Fields { get; set; } = [];
        public string Status { get; set; } = "active";
        public int PrintCount { get; set; }
        public string LastPrinted { get; set; } = "";
        public string CreatedBy { get; set; } = "";
    }

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "shipping", "badge", "product", "barcode"];

    private readonly List<LabelTemplate> _templates =
    [
        new() { Id = 1, Name = "Standard Shipping Label", Type = "shipping", Size = "4\" x 6\"", Fields = ["Name", "Address", "Tracking #", "Barcode"], Status = "active", PrintCount = 12450, LastPrinted = "Mar 24, 2026", CreatedBy = "Operations" },
        new() { Id = 2, Name = "Conference Badge", Type = "badge", Size = "3.5\" x 2.25\"", Fields = ["Name", "Company", "Role", "QR Code"], Status = "active", PrintCount = 850, LastPrinted = "Mar 15, 2026", CreatedBy = "Events Team" },
        new() { Id = 3, Name = "Product Price Tag", Type = "product", Size = "2\" x 1\"", Fields = ["SKU", "Name", "Price", "Barcode"], Status = "active", PrintCount = 34200, LastPrinted = "Mar 23, 2026", CreatedBy = "Retail Ops" },
        new() { Id = 4, Name = "Inventory Barcode", Type = "barcode", Size = "1.5\" x 0.75\"", Fields = ["Item ID", "Barcode", "Location"], Status = "active", PrintCount = 56000, LastPrinted = "Mar 24, 2026", CreatedBy = "Warehouse" },
        new() { Id = 5, Name = "Return Shipping Label", Type = "shipping", Size = "4\" x 6\"", Fields = ["Return Address", "Customer", "RMA #", "Barcode"], Status = "draft", PrintCount = 0, LastPrinted = "Never", CreatedBy = "Support" },
        new() { Id = 6, Name = "VIP Event Badge", Type = "badge", Size = "4\" x 3\"", Fields = ["Name", "Title", "Photo", "QR Code", "Access Level"], Status = "archived", PrintCount = 200, LastPrinted = "Feb 28, 2026", CreatedBy = "Events Team" },
    ];

    private void HandleDelete(int id) => _templates.RemoveAll(t => t.Id == id);

    private void HandleActivate(int id)
    {
        var tmpl = _templates.FirstOrDefault(t => t.Id == id);
        if (tmpl != null) tmpl.Status = "active";
    }
}
