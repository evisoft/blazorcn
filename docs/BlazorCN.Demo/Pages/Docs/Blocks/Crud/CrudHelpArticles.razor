@* ============================================================
   Block: crud-help-articles
   Title: CrudHelpArticles
   Description: Help center article editor with categories, search, publish workflow, and view analytics
   Source: original/blocks/crud/crud-help-articles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Help Articles</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_articles.Count articles · @_articles.Count(a => a.Status == "published") published
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Article
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search articles..."
                         Value="@_search"
                         ValueChanged="@((string v) => { _search = v; })" />
            </div>
            <div class="flex gap-1">
                @foreach (var tab in _filterTabs)
                {
                    var t = tab;
                    <button type="button"
                            @onclick="@(() => _filter = t)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == t ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(t[0].ToString().ToUpperInvariant() + t.Substring(1))
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var article in Filtered())
            {
                var art = article;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", StatusColor(art.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@art.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">@art.Category</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">@art.Excerpt</p>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@art.Author</span>
                                <span>·</span>
                                <span>Updated @art.LastUpdated</span>
                                @if (art.Views > 0)
                                {
                                    <span>·</span>
                                    <span class="tabular-nums">@art.Views.ToString("N0") views</span>
                                    <span>·</span>
                                    <span class="tabular-nums">@art.Helpful found helpful</span>
                                }
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                @if (art.Status == "draft")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandlePublish(art.Id))">Publish</DropdownMenuItemCn>
                                }
                                @if (art.Status == "published")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandleArchive(art.Id))">Archive</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(art.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!Filtered().Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No articles found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Article(int Id, string Title, string Excerpt, string Category, string Status, string Author, int Views, int Helpful, string LastUpdated);

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterTabs = ["all", "published", "draft", "archived"];

    private List<Article> _articles =
    [
        new(1, "Getting Started with Your Account",
            "Learn how to create your account, set up your profile, and configure basic settings.",
            "Getting Started", "published", "Support Team", 12450, 892, "Mar 20, 2026"),
        new(2, "Billing and Subscription FAQ",
            "Common questions about billing cycles, plan changes, invoices, and payment methods.",
            "Billing", "published", "Finance Team", 8920, 654, "Mar 18, 2026"),
        new(3, "API Authentication Guide",
            "Step-by-step guide to authenticating API requests using OAuth 2.0 and API keys.",
            "Developer", "published", "Engineering", 6780, 521, "Mar 22, 2026"),
        new(4, "Troubleshooting SSO Configuration",
            "Common issues and solutions when setting up SAML or OIDC single sign-on.",
            "Security", "draft", "Security Team", 0, 0, "Mar 24, 2026"),
        new(5, "Data Export and Migration",
            "How to export your data in CSV, JSON, or XML format and migrate to other platforms.",
            "Data", "published", "Support Team", 3420, 287, "Mar 15, 2026"),
        new(6, "Webhook Integration Setup",
            "Configure webhooks to receive real-time notifications about events in your account.",
            "Developer", "draft", "Engineering", 0, 0, "Mar 23, 2026"),
        new(7, "Team Permissions and Roles",
            "Understanding role-based access control, custom roles, and permission inheritance.",
            "Admin", "archived", "Support Team", 5670, 412, "Feb 10, 2026"),
    ];

    private IEnumerable<Article> Filtered() =>
        _articles
            .Where(a => _filter == "all" || a.Status == _filter)
            .Where(a => string.IsNullOrEmpty(_search) ||
                        a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        a.Category.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static string StatusColor(string status) => status switch
    {
        "published" => "bg-emerald-500",
        "draft"     => "bg-amber-500",
        _           => "bg-muted-foreground/40",
    };

    private void HandleDelete(int id) => _articles = _articles.Where(a => a.Id != id).ToList();

    private void HandlePublish(int id) =>
        _articles = _articles.Select(a => a.Id == id ? a with { Status = "published" } : a).ToList();

    private void HandleArchive(int id) =>
        _articles = _articles.Select(a => a.Id == id ? a with { Status = "archived" } : a).ToList();
}
