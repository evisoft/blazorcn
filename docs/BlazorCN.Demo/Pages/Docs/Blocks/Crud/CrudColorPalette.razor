@* ============================================================
   Block: crud-color-palette
   Title: CrudColorPalette
   Description: Color palette manager with hex/RGB values, naming, grouping, and copy-to-clipboard for design system management
   Source: original/blocks/crud/crud-color-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Color Palette</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_colors.Count colors · @Groups.Count() groups
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs" @onclick="@(() => _showAdd = !_showAdd)">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Add Color
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="flex items-center gap-2">
                    <input
                        type="color"
                        value="@_newHex"
                        @oninput="@((e) => { _newHex = e.Value?.ToString() ?? _newHex; })"
                        class="size-8 cursor-pointer rounded border-0" />
                    <InputCn Placeholder="Name" Class="h-8 w-32 text-xs" @bind-Value="_newName" />
                    <InputCn Placeholder="#000000" Class="h-8 w-24 font-mono text-xs" @bind-Value="_newHex" />
                    <InputCn Placeholder="Group" Class="h-8 w-24 text-xs" @bind-Value="_newGroup" />
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" @onclick="HandleAdd">Add</ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs" @onclick="@(() => _showAdd = false)">Cancel</ButtonCn>
                </div>
            </div>
        }

        <div>
            @foreach (var grp in Groups)
            {
                var group = grp;
                <div>
                    <div class="border-b bg-muted/30 px-4 py-2">
                        <span class="text-xs font-medium text-muted-foreground">@group</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2">
                        @foreach (var col in _colors.Where(c => c.Group == group))
                        {
                            var color = col;
                            <div class="flex items-center gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50">
                                <div class="size-8 shrink-0 rounded-md border" style="@($"background-color:{color.Hex}")"></div>
                                @if (_editingId == color.Id)
                                {
                                    <div class="flex flex-1 items-center gap-2">
                                        <InputCn Class="h-7 w-24 text-xs" @bind-Value="_editName" />
                                        <InputCn Class="h-7 w-20 font-mono text-xs" @bind-Value="_editHex" />
                                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6" @onclick="@(() => HandleSave(color.Id))">
                                            <LucideCheckCn Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6" @onclick="@(() => _editingId = null)">
                                            <LucideXCn Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                    </div>
                                }
                                else
                                {
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@color.Name</span>
                                        <p class="font-mono text-xs text-muted-foreground">@color.Hex</p>
                                    </div>
                                    <div class="flex gap-1">
                                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6" @onclick="@(() => HandleCopy(color.Id, color.Hex))">
                                            @if (_copiedId == color.Id)
                                            {
                                                <LucideCheckCn Size="12" Class="size-3 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="12" Class="size-3" />
                                            }
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6" @onclick="@(() => HandleEdit(color))">
                                            <span class="text-[10px]">Edit</span>
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-destructive" @onclick="@(() => HandleDelete(color.Id))">
                                            <LucideTrashCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class ColorItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Hex { get; set; } = "";
        public string Group { get; set; } = "";
    }

    private readonly List<ColorItem> _colors = [
        new() { Id = 1,  Name = "Primary",       Hex = "#0F172A", Group = "Brand"    },
        new() { Id = 2,  Name = "Primary Light",  Hex = "#334155", Group = "Brand"    },
        new() { Id = 3,  Name = "Accent",         Hex = "#2563EB", Group = "Brand"    },
        new() { Id = 4,  Name = "Accent Light",   Hex = "#3B82F6", Group = "Brand"    },
        new() { Id = 5,  Name = "Success",        Hex = "#059669", Group = "Semantic" },
        new() { Id = 6,  Name = "Warning",        Hex = "#D97706", Group = "Semantic" },
        new() { Id = 7,  Name = "Error",          Hex = "#DC2626", Group = "Semantic" },
        new() { Id = 8,  Name = "Info",           Hex = "#0284C7", Group = "Semantic" },
        new() { Id = 9,  Name = "Background",     Hex = "#FFFFFF", Group = "Neutral"  },
        new() { Id = 10, Name = "Surface",        Hex = "#F8FAFC", Group = "Neutral"  },
        new() { Id = 11, Name = "Border",         Hex = "#E2E8F0", Group = "Neutral"  },
        new() { Id = 12, Name = "Muted",          Hex = "#94A3B8", Group = "Neutral"  },
    ];

    private int? _copiedId;
    private int? _editingId;
    private string _editName = "";
    private string _editHex = "";
    private bool _showAdd;
    private string _newName = "";
    private string _newHex = "#000000";
    private string _newGroup = "Brand";

    private IEnumerable<string> Groups => _colors.Select(c => c.Group).Distinct();

    private void HandleCopy(int id, string hex)
    {
        _copiedId = id;
        // Note: clipboard API is not invoked here to keep the demo self-contained
        // In production, inject IJSRuntime and call navigator.clipboard.writeText(hex)
    }

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        var nextId = _colors.Count > 0 ? _colors.Max(c => c.Id) + 1 : 1;
        _colors.Add(new ColorItem { Id = nextId, Name = _newName, Hex = _newHex, Group = _newGroup });
        _newName = "";
        _newHex = "#000000";
        _newGroup = "Brand";
        _showAdd = false;
    }

    private void HandleEdit(ColorItem color)
    {
        _editingId = color.Id;
        _editName = color.Name;
        _editHex = color.Hex;
    }

    private void HandleSave(int id)
    {
        var item = _colors.FirstOrDefault(c => c.Id == id);
        if (item != null)
        {
            item.Name = _editName;
            item.Hex = _editHex;
        }
        _editingId = null;
    }

    private void HandleDelete(int id)
    {
        var item = _colors.FirstOrDefault(c => c.Id == id);
        if (item != null) _colors.Remove(item);
    }
}
