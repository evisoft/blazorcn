@* ============================================================
   Block: crud-edit-user
   Title: Crud Edit User
   Description: CRUD form for editing user profile information with avatar upload, name, email, bio, role selection, and status toggle
   Long Description: CRUD form for product inventory management
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, SwitchCn, TextareaCn
   Source: original/blocks/crud/crud-edit-user.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Edit Profile</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Manage user profile information, role assignments, and account status.
          </p>
        </div>

        <form action="#" class="space-y-6 px-6 py-5">
          <div class="flex flex-col items-center gap-4 sm:flex-row">
            <div class="flex h-24 w-24 items-center justify-center rounded-full bg-muted/50 text-sm font-medium">
              JD
            </div>
            <div class="text-center sm:text-left">
              <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Change Picture
              </ButtonCn>
              <p class="mt-2 text-xs text-muted-foreground">
                JPG, GIF or PNG. Max size of 800K
              </p>
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="firstName">First Name</LabelCn>
              <InputCn id="firstName" name="firstName" Placeholder="e.g. John" type="text" />
            </div>

            <div class="space-y-2">
              <LabelCn for="lastName">Last Name</LabelCn>
              <InputCn id="lastName" name="lastName" Placeholder="e.g. Doe" type="text" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="email">Email Address</LabelCn>
            <InputCn id="email" name="email" Placeholder=@("e.g. john.doe@example.com") type="email" />
          </div>

          <div class="space-y-2">
            <LabelCn for="bio">Bio</LabelCn>
            <TextareaCn id="bio" name="bio" Placeholder="Tell us about yourself..." rows="4" />
          </div>

          <div class="space-y-2">
            <LabelCn for="role">Role</LabelCn>
            <SelectCn name="role">
              <SelectTriggerCn aria-label="Select a role" class="w-full" id="role">
                <SelectValueCn Placeholder="Select a role" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="admin">Admin</SelectItemCn>
                <SelectItemCn Value="manager">Manager</SelectItemCn>
                <SelectItemCn Value="user">User</SelectItemCn>
                <SelectItemCn Value="guest">Guest</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="flex items-center justify-between">
            <div class="space-y-0.5">
              <LabelCn for="status">Account Status</LabelCn>
              <p class="text-xs text-muted-foreground">Enable or disable this user account</p>
            </div>
            <SwitchCn id="status" />
          </div>

          <div class="flex gap-4">
            <ButtonCn class="flex-1" type="submit">
              Save Changes
            </ButtonCn>
            <ButtonCn class="flex-1" type="button" Variant="ButtonVariant.Destructive">
              Delete User
            </ButtonCn>
          </div>
        </form>
      </div>
    </section>

