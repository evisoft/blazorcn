@* ============================================================
   Block: crud-search-results
   Title: Search Results with Filters
   Description: Search results with faceted filters for type, status, and date range
   Dependencies: BadgeCn, CheckboxCn, InputCn, LabelCn
   Source: original/blocks/crud/crud-search-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="relative">
                <LucideSearchCn Size="16" Class="absolute top-2.5 left-3 size-4 text-muted-foreground" />
                <InputCn type="search" Placeholder="Search..." Value="@_searchQuery" Class="border-0 bg-muted/50 pl-9 shadow-none focus-visible:ring-0" aria-label="Search" />
            </div>
            @{
                var filteredResults = _results.Where(r =>
                    (_typeFilters.Count == 0 || _typeFilters.Contains(r.Type)) &&
                    (_statusFilters.Count == 0 || _statusFilters.Contains(r.Status))).ToList();
            }
            <p class="mt-2 text-muted-foreground text-xs">@filteredResults.Count results</p>
        </div>

        <div class="grid gap-0 md:grid-cols-[200px_1fr]">
            <div class="border-b bg-muted/20 px-4 py-3 md:border-b-0 md:border-r">
                <div class="space-y-4">
                    <div>
                        <LabelCn Class="text-muted-foreground text-xs">Type</LabelCn>
                        <div class="mt-2 space-y-2">
                            @foreach (var typeOption in new[] { "Users", "Posts", "Comments" })
                            {
                                <span class="flex cursor-pointer items-center gap-2">
                                    <CheckboxCn Checked="@_typeFilters.Contains(typeOption)"
                                                CheckedChanged="@(_ => ToggleFilter(_typeFilters, typeOption))" aria-label="@typeOption" />
                                    <span class="text-sm">@typeOption</span>
                                </span>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn Class="text-muted-foreground text-xs">Status</LabelCn>
                        <div class="mt-2 space-y-2">
                            @foreach (var statusOption in new[] { "Active", "Archived" })
                            {
                                <span class="flex cursor-pointer items-center gap-2">
                                    <CheckboxCn Checked="@_statusFilters.Contains(statusOption)"
                                                CheckedChanged="@(_ => ToggleFilter(_statusFilters, statusOption))" aria-label="@statusOption" />
                                    <span class="text-sm">@statusOption</span>
                                </span>
                            }
                        </div>
                    </div>

                    <div>
                        <LabelCn Class="text-muted-foreground text-xs">Date range</LabelCn>
                        <div class="mt-2 space-y-2">
                            @foreach (var rangeOption in new[] { "Last 7 days", "Last 30 days", "All time" })
                            {
                                <span class="flex cursor-pointer items-center gap-2">
                                    <CheckboxCn Checked="@(_dateFilter == rangeOption)"
                                                CheckedChanged="@(_ => _dateFilter = rangeOption)" aria-label="@rangeOption" />
                                    <span class="text-sm">@rangeOption</span>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div>
                @foreach (var result in filteredResults)
                {
                    <button type="button"
                            class="flex w-full items-start gap-3 border-b px-4 py-3 text-left transition-colors last:border-0 hover:bg-muted/50">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", result.Relevance == "high" ? "bg-emerald-500" : "bg-blue-500")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <h3 class="text-sm font-medium">@result.Title</h3>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1.5 text-xs capitalize">@result.Type</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@result.Description</p>
                        </div>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SearchResult(string Id, string Title, string Description, string Type, string Status, string Date, string Relevance);

    private string _searchQuery = "user";
    private readonly HashSet<string> _typeFilters = ["Users", "Posts"];
    private readonly HashSet<string> _statusFilters = ["Active"];
    private string _dateFilter = "Last 30 days";

    private readonly List<SearchResult> _results =
    [
        new("1", "User authentication implementation guide", "Complete guide for implementing secure user authentication with OAuth and session management", "Posts", "Active", "2024-03-10", "high"),
        new("2", "Sarah Chen", "Senior developer, active contributor with 145 posts", "Users", "Active", "2024-03-08", "high"),
        new("3", "Great tutorial on user permissions!", "This helped me implement role-based access control in my app", "Comments", "Active", "2024-03-05", "medium"),
        new("4", "Database migration strategies for user data", "Best practices for migrating user data between database schemas", "Posts", "Archived", "2024-02-28", "medium"),
        new("5", "Mike Johnson", "Frontend specialist, last active 2 months ago", "Users", "Archived", "2024-01-15", "medium"),
        new("6", "Can we add user profile customization?", "Feature request for allowing users to customize their profiles", "Comments", "Active", "2024-03-12", "high"),
    ];

    private static void ToggleFilter(HashSet<string> filters, string value)
    {
        if (!filters.Remove(value)) filters.Add(value);
    }
}
