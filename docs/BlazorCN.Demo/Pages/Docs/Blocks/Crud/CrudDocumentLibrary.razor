@* ============================================================
   Block: crud-document-library
   Title: CrudDocumentLibrary
   Description: Document library with version history, file type icons, sharing controls, and folder organization
   Source: original/blocks/crud/crud-document-library.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Documents</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_docs.Count documents · @_folders.Count folders
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Class="size-3.5" Size="14" />
                    Upload
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" Size="14" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search documents..."
                         @bind-Value="_search" />
            </div>
        </div>

        <div class="flex gap-2 overflow-x-auto border-b px-4 py-2">
            <button type="button"
                    @onclick="@(() => _folderFilter = "all")"
                    class="@Cn.Merge("flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _folderFilter == "all" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                All
            </button>
            @foreach (var f in _folders)
            {
                var folder = f;
                <button type="button"
                        @onclick="@(() => _folderFilter = folder)"
                        class="@Cn.Merge("flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _folderFilter == folder ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                    <LucideFolderCn Class="size-3" Size="12" />
                    @folder
                </button>
            }
        </div>

        <div>
            @foreach (var doc in Filtered)
            {
                var item = doc;
                var iconName = GetIconName(item.Type);
                var iconColor = GetIconColor(item.Type);
                <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@iconName" Size="16" Class="@Cn.Merge("size-4", iconColor)" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@item.Name</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-[10px] px-1.5 py-0">
                                @item.Version
                            </BadgeCn>
                            @if (item.Shared)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-[10px] px-1.5 py-0">
                                    Shared
                                </BadgeCn>
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@item.Folder</span>
                            <span>·</span>
                            <span>@item.Size</span>
                            <span>·</span>
                            <span>@item.ModifiedBy</span>
                            <span>·</span>
                            <span>@item.LastModified</span>
                        </div>
                    </div>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn>
                            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                <LucideMoreHorizontalCn Class="size-4" Size="16" />
                            </ButtonCn>
                        </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuItemCn>Download</DropdownMenuItemCn>
                            <DropdownMenuItemCn OnClick="@(() => ToggleShare(item.Id))">
                                @(item.Shared ? "Unshare" : "Share")
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn>Version History</DropdownMenuItemCn>
                            <DropdownMenuItemCn>Move</DropdownMenuItemCn>
                            <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(item.Id))">
                                <LucideTrashCn Class="mr-2 size-4" Size="16" />
                                Delete
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No documents found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Document(int Id, string Name, string Type, string Folder, string Size, string Version, string LastModified, string ModifiedBy, bool Shared);

    private string _search = "";
    private string _folderFilter = "all";

    private List<Document> _docs = new List<Document>
    {
        new(1, "Product Requirements", "doc", "Engineering", "245 KB", "v3.2", "2 hours ago", "Sarah Chen", true),
        new(2, "Q1 Financial Report", "sheet", "Finance", "1.2 MB", "v1.0", "Yesterday", "Mike Johnson", false),
        new(3, "Brand Guidelines", "pdf", "Design", "8.4 MB", "v2.1", "3 days ago", "Emma Davis", true),
        new(4, "Sales Deck 2026", "slide", "Sales", "12 MB", "v4.0", "1 week ago", "David Lee", true),
        new(5, "API Documentation", "doc", "Engineering", "520 KB", "v8.1", "4 hours ago", "Alex Morgan", true),
        new(6, "Employee Handbook", "pdf", "HR", "3.1 MB", "v2.0", "2 weeks ago", "Lisa Wang", true),
        new(7, "Marketing Budget", "sheet", "Marketing", "340 KB", "v1.3", "5 days ago", "Tom Brown", false),
        new(8, "Technical Architecture", "doc", "Engineering", "1.8 MB", "v5.0", "1 day ago", "Sarah Chen", true),
    };

    private List<string> _folders => _docs.Select(d => d.Folder).Distinct().ToList();

    private IEnumerable<Document> Filtered =>
        _docs
            .Where(d => _folderFilter == "all" || d.Folder == _folderFilter)
            .Where(d => d.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleDelete(int id) => _docs = _docs.Where(d => d.Id != id).ToList();

    private void ToggleShare(int id) =>
        _docs = _docs.Select(d => d.Id == id ? d with { Shared = !d.Shared } : d).ToList();

    private static string GetIconName(string type) => type switch
    {
        "doc" => "file-text",
        _ => "file",
    };

    private static string GetIconColor(string type) => type switch
    {
        "pdf" => "text-red-500",
        "doc" => "text-blue-500",
        "sheet" => "text-emerald-500",
        "slide" => "text-amber-500",
        _ => "text-muted-foreground",
    };
}
