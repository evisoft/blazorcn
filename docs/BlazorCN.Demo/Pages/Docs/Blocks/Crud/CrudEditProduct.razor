@* ============================================================
   Block: crud-edit-product
   Title: Crud Edit Product
   Description: CRUD form for editing product details with name, brand, price, category, and description fields
   Long Description: CRUD form for user account management
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/crud/crud-edit-product.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Edit Apparel Item</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Update product information, pricing, and categorization for your fashion inventory.
          </p>
        </div>

        <form action="#" class="space-y-5 px-6 py-5">
          <div class="space-y-2">
            <LabelCn for="productName" class="text-xs">
              Product Name
            </LabelCn>
            <InputCn
              id="productName"
              name="productName"
              Placeholder="e.g. Slim Fit Denim Jacket"
              type="text"
            />
          </div>

          <div class="space-y-2">
            <LabelCn for="brand" class="text-xs">
              Designer Brand
            </LabelCn>
            <InputCn id="brand" name="brand" Placeholder="e.g. Balenciaga" type="text" />
          </div>

          <div class="space-y-2">
            <LabelCn for="price" class="text-xs">
              Retail Price ($)
            </LabelCn>
            <InputCn id="price" name="price" Placeholder="e.g. 199" type="number" />
          </div>

          <div class="space-y-2">
            <LabelCn for="category" class="text-xs">
              Category
            </LabelCn>
            <SelectCn name="category">
              <SelectTriggerCn class="w-full" id="category">
                <SelectValueCn Placeholder="Select a category" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="outerwear">Outerwear</SelectItemCn>
                <SelectItemCn Value="tops">Tops</SelectItemCn>
                <SelectItemCn Value="bottoms">Bottoms</SelectItemCn>
                <SelectItemCn Value="footwear">Footwear</SelectItemCn>
                <SelectItemCn Value="accessories">Accessories</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="description" class="text-xs">
              Product Details
            </LabelCn>
            <TextareaCn
              id="description"
              name="description"
              Placeholder="Material, fit, washing instructions..."
              rows="4"
            />
          </div>

          <div class="flex gap-2 pt-1">
            <ButtonCn class="flex-1" type="submit">
              Save Changes
            </ButtonCn>
            <ButtonCn class="flex-1" type="button" Variant="ButtonVariant.Destructive">
              Remove Item
            </ButtonCn>
          </div>
        </form>
      </div>
    </section>

@code {
}
