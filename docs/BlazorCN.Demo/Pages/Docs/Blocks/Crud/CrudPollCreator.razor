@* ============================================================
   Block: crud-poll-creator
   Title: CrudPollCreator
   Description: Poll and survey creator with question types, response tracking, deadline management, and results visualization
   Source: original/blocks/crud/crud-poll-creator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Polls &amp; Surveys</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_polls.Count polls · @_polls.Count(p => p.Status == "active") active
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Create Poll
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search polls..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var slug = s;
                    <button type="button"
                            @onclick="@(() => _filter = slug)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == slug ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(slug.Length > 0 ? char.ToUpper(slug[0]) + slug.Substring(1) : slug)
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _polls
                    .Where(p => _filter == "all" || p.Status == _filter)
                    .Where(p => p.Title.ToLower().Contains(_search.ToLower()) || p.Creator.ToLower().Contains(_search.ToLower()))
                    .ToList();
            }
            @foreach (var poll in filtered)
            {
                var item = poll;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetStatusColor(item.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@item.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                    @item.Type.Replace("-", " ")
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">
                                @item.Description
                            </p>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@item.Creator</span>
                                <span>·</span>
                                <span class="tabular-nums">@item.Responses responses</span>
                                @if (item.Options > 0)
                                {
                                    <span>·</span>
                                    <span>@item.Options options</span>
                                }
                                <span>·</span>
                                <span>Deadline: @item.Deadline</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn AsChild="true">
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>View Results</DropdownMenuItemCn>
                                @if (item.Status == "draft")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandleActivate(item.Id))">Publish</DropdownMenuItemCn>
                                }
                                @if (item.Status == "active")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandleClose(item.Id))">Close Poll</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Share Link</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(item.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (filtered.Count == 0)
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No polls found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class Poll
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Type { get; set; } = "";
        public string Status { get; set; } = "";
        public int Responses { get; set; }
        public int Options { get; set; }
        public string Deadline { get; set; } = "";
        public string Creator { get; set; } = "";
        public string CreatedDate { get; set; } = "";
    }

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "active", "draft", "scheduled", "closed"];

    private readonly List<Poll> _polls =
    [
        new() { Id = 1, Title = "Q2 Feature Priority Vote", Description = "Vote on which features should be prioritized for the Q2 roadmap", Type = "single-choice", Status = "active", Responses = 234, Options = 6, Deadline = "Mar 31, 2026", Creator = "Product Team", CreatedDate = "Mar 15, 2026" },
        new() { Id = 2, Title = "Team Offsite Location Preference", Description = "Choose your preferred location for the upcoming team offsite", Type = "single-choice", Status = "active", Responses = 45, Options = 4, Deadline = "Mar 28, 2026", Creator = "People Ops", CreatedDate = "Mar 20, 2026" },
        new() { Id = 3, Title = "Developer Experience Survey", Description = "Rate your experience with our developer tools and API documentation", Type = "rating", Status = "active", Responses = 89, Options = 10, Deadline = "Apr 5, 2026", Creator = "Developer Relations", CreatedDate = "Mar 22, 2026" },
        new() { Id = 4, Title = "Conference Talk Proposals", Description = "Submit and vote on proposed talks for the engineering conference", Type = "open-ended", Status = "draft", Responses = 0, Options = 0, Deadline = "Apr 15, 2026", Creator = "Engineering", CreatedDate = "Mar 24, 2026" },
        new() { Id = 5, Title = "Lunch Catering Preferences", Description = "Select your dietary preferences for office catering", Type = "multiple-choice", Status = "closed", Responses = 78, Options = 8, Deadline = "Mar 20, 2026", Creator = "Office Manager", CreatedDate = "Mar 10, 2026" },
        new() { Id = 6, Title = "New Brand Colors Feedback", Description = "Review and rate the proposed new brand color palette options", Type = "rating", Status = "scheduled", Responses = 0, Options = 5, Deadline = "Apr 10, 2026", Creator = "Design Team", CreatedDate = "Mar 23, 2026" },
    ];

    private void HandleDelete(int id) =>
        _polls.RemoveAll(p => p.Id == id);

    private void HandleClose(int id)
    {
        var poll = _polls.FirstOrDefault(p => p.Id == id);
        if (poll != null) poll.Status = "closed";
    }

    private void HandleActivate(int id)
    {
        var poll = _polls.FirstOrDefault(p => p.Id == id);
        if (poll != null) poll.Status = "active";
    }

    private static string GetStatusColor(string status) => status switch
    {
        "active" => "bg-emerald-500",
        "draft" => "bg-amber-500",
        "scheduled" => "bg-blue-500",
        _ => "bg-muted-foreground/40",
    };
}
