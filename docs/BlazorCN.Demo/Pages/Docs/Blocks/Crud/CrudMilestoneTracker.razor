@* ============================================================
   Block: crud-milestone-tracker
   Title: CrudMilestoneTracker
   Description: Project milestone management with deadlines, progress tracking, dependencies, and team assignment
   Source: original/blocks/crud/crud-milestone-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="flag" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Milestones</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_milestones.Count milestones · @_milestones.Count(m => m.Status == "completed") completed
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Milestone
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search milestones..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterKey = s;
                    <button type="button"
                            @onclick="@(() => _filter = filterKey)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterKey ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(filterKey == "all" ? "All" : GetStatusLabel(filterKey))
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _milestones
                    .Where(m => _filter == "all" || m.Status == _filter)
                    .Where(m => m.Title.Contains(_search, System.StringComparison.OrdinalIgnoreCase)
                             || m.Project.Contains(_search, System.StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            @foreach (var ms in filtered)
            {
                var milestone = ms;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetStatusColor(milestone.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@milestone.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">
                                    @milestone.Project
                                </BadgeCn>
                                @if (milestone.Priority == "high")
                                {
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                }
                            </div>
                            <p class="mt-0.5 line-clamp-1 text-xs text-muted-foreground">
                                @milestone.Description
                            </p>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@milestone.Owner</span>
                                <span>·</span>
                                <span>Due @milestone.Deadline</span>
                                <span>·</span>
                                <span class="tabular-nums">@milestone.CompletedTasks/@milestone.Tasks tasks</span>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/20"
                                         style="@($"width:{milestone.Progress}%")">
                                    </div>
                                </div>
                                <span class="text-xs font-medium tabular-nums">@milestone.Progress%</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn AsChild="true">
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>View Tasks</DropdownMenuItemCn>
                                @if (milestone.Status != "completed")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandleComplete(milestone.Id))">
                                        Mark Complete
                                    </DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(milestone.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No milestones found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class MilestoneItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Project { get; set; } = "";
        public string Status { get; set; } = "";
        public int Progress { get; set; }
        public string Owner { get; set; } = "";
        public int Tasks { get; set; }
        public int CompletedTasks { get; set; }
        public string Deadline { get; set; } = "";
        public string Priority { get; set; } = "";
    }

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "on-track", "at-risk", "delayed", "completed"];

    private readonly List<MilestoneItem> _milestones =
    [
        new() { Id = 1, Title = "Beta Launch", Description = "Public beta release with core features and onboarding flow", Project = "Product v2.0", Status = "on-track", Progress = 78, Owner = "Sarah Chen", Tasks = 24, CompletedTasks = 19, Deadline = "Mar 31, 2026", Priority = "high" },
        new() { Id = 2, Title = "API v3 Migration", Description = "Migrate all endpoints from REST v2 to v3 with breaking change documentation", Project = "Platform", Status = "at-risk", Progress = 52, Owner = "David Lee", Tasks = 18, CompletedTasks = 9, Deadline = "Apr 15, 2026", Priority = "high" },
        new() { Id = 3, Title = "Design System v2", Description = "Updated component library with new tokens, accessibility improvements, and documentation", Project = "Design", Status = "on-track", Progress = 90, Owner = "Emma Davis", Tasks = 32, CompletedTasks = 29, Deadline = "Mar 28, 2026", Priority = "medium" },
        new() { Id = 4, Title = "SOC 2 Compliance", Description = "Complete SOC 2 Type II audit preparation and documentation", Project = "Security", Status = "delayed", Progress = 35, Owner = "Tom Bradley", Tasks = 40, CompletedTasks = 14, Deadline = "Apr 30, 2026", Priority = "high" },
        new() { Id = 5, Title = "Mobile App Launch", Description = "iOS and Android app submission to app stores", Project = "Mobile", Status = "completed", Progress = 100, Owner = "Mike Johnson", Tasks = 28, CompletedTasks = 28, Deadline = "Mar 15, 2026", Priority = "high" },
        new() { Id = 6, Title = "Analytics Dashboard v2", Description = "Redesigned analytics with custom reports, export, and scheduled emails", Project = "Product v2.0", Status = "planned", Progress = 0, Owner = "Lisa Wang", Tasks = 15, CompletedTasks = 0, Deadline = "May 31, 2026", Priority = "medium" },
    ];

    private void HandleDelete(int id) =>
        _milestones.RemoveAll(m => m.Id == id);

    private void HandleComplete(int id)
    {
        var m = _milestones.FirstOrDefault(x => x.Id == id);
        if (m is null) return;
        m.Status = "completed";
        m.Progress = 100;
        m.CompletedTasks = m.Tasks;
    }

    private static string GetStatusColor(string status) => status switch
    {
        "on-track" => "bg-emerald-500",
        "at-risk" => "bg-amber-500",
        "delayed" => "bg-red-500",
        "completed" => "bg-blue-500",
        _ => "bg-muted-foreground/40",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "on-track" => "On Track",
        "at-risk" => "At Risk",
        "delayed" => "Delayed",
        "completed" => "Completed",
        "planned" => "Planned",
        _ => status,
    };
}
