@* ============================================================
   Block: crud-location-manager
   Title: CrudLocationManager
   Description: Location and branch management with address details, operating hours, contact info, and status tracking
   Source: original/blocks/crud/crud-location-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideMapPinCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Locations</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_locations.Count locations · @_locations.Count(l => l.Status == "open") open
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Add Location
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search locations..."
                         @bind-Value="_search" aria-label="Search locations" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var slug = s;
                    <button type="button"
                            @onclick="@(() => _filter = slug)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == slug ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(slug.Substring(0, 1).ToUpper() + slug.Substring(1))
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var loc in Filtered)
            {
                var location = loc;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {StatusColor(location.Status)}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@location.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">@location.Type</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @location.Address, @location.City, @location.State
                            </p>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@location.Manager</span>
                                <span>·</span>
                                <span>@location.Phone</span>
                                <span>·</span>
                                <span class="tabular-nums">@location.Employees employees</span>
                                <span>·</span>
                                <span>@location.Hours</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                    <LucideEllipsisCn Size="16" Class="size-4" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn @onclick="@(() => HandleToggleStatus(location.Id))">
                                    @(location.Status == "open" ? "Close" : "Open")
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>View on Map</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => HandleDelete(location.Id))">
                                    <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No locations found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class LocationItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string State { get; set; } = "";
        public string Type { get; set; } = "";
        public string Status { get; set; } = "";
        public string Manager { get; set; } = "";
        public string Phone { get; set; } = "";
        public int Employees { get; set; }
        public string Hours { get; set; } = "";
    }

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "office", "warehouse", "retail", "remote"];

    private readonly List<LocationItem> _locations =
    [
        new() { Id = 1, Name = "Downtown HQ", Address = "350 Market Street, Suite 400", City = "San Francisco", State = "CA", Type = "office", Status = "open", Manager = "Sarah Chen", Phone = "(415) 555-0120", Employees = 85, Hours = "Mon-Fri 8am-6pm" },
        new() { Id = 2, Name = "East Bay Warehouse", Address = "1200 Industrial Parkway", City = "Oakland", State = "CA", Type = "warehouse", Status = "open", Manager = "Mike Torres", Phone = "(510) 555-0145", Employees = 32, Hours = "Mon-Sat 6am-10pm" },
        new() { Id = 3, Name = "Union Square Store", Address = "225 Powell Street", City = "San Francisco", State = "CA", Type = "retail", Status = "open", Manager = "Emma Liu", Phone = "(415) 555-0198", Employees = 12, Hours = "Mon-Sun 10am-9pm" },
        new() { Id = 4, Name = "Austin Office", Address = "500 Congress Avenue, Floor 12", City = "Austin", State = "TX", Type = "office", Status = "renovating", Manager = "Alex Morgan", Phone = "(512) 555-0167", Employees = 45, Hours = "Mon-Fri 9am-5pm" },
        new() { Id = 5, Name = "Brooklyn Flagship", Address = "88 North 6th Street", City = "Brooklyn", State = "NY", Type = "retail", Status = "planned", Manager = "TBD", Phone = "—", Employees = 0, Hours = "TBD" },
        new() { Id = 6, Name = "Portland Distribution", Address = "4500 NW Yeon Avenue", City = "Portland", State = "OR", Type = "warehouse", Status = "closed", Manager = "Tom Bradley", Phone = "(503) 555-0134", Employees = 0, Hours = "Closed" },
    ];

    private IEnumerable<LocationItem> Filtered => _locations
        .Where(l => _filter == "all" || l.Type == _filter)
        .Where(l => l.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    l.City.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static string StatusColor(string status) => status switch
    {
        "open" => "bg-emerald-500",
        "closed" => "bg-muted-foreground/40",
        "renovating" => "bg-amber-500",
        "planned" => "bg-blue-500",
        _ => "bg-muted-foreground/40",
    };

    private void HandleDelete(int id)
    {
        var item = _locations.FirstOrDefault(l => l.Id == id);
        if (item != null) _locations.Remove(item);
    }

    private void HandleToggleStatus(int id)
    {
        var item = _locations.FirstOrDefault(l => l.Id == id);
        if (item != null)
            item.Status = item.Status == "open" ? "closed" : "open";
    }
}
