@* ============================================================
   Block: crud-form-builder
   Title: Crud Form Builder
   Description: Dynamic form field configuration with drag reordering and type management
   Dependencies: ButtonCn, DropdownMenuCn, SwitchCn
   Source: original/blocks/crud/crud-form-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Form Builder</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">@_fields.Count fields configured</p>
            </div>
            <DropdownMenuCn>
                <DropdownMenuTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucidePlusCn Class="size-3.5" Size="14" />
                        Add Field
                        <LucideChevronDownCn Class="size-3.5" Size="14" />
                    </ButtonCn>
                </DropdownMenuTriggerCn>
                <DropdownMenuContentCn Align="FloatingAlign.End">
                    @foreach (var ft in _fieldTypes)
                    {
                        <DropdownMenuItemCn OnClick="@(() => AddField(ft.Value))">@ft.Label</DropdownMenuItemCn>
                    }
                </DropdownMenuContentCn>
            </DropdownMenuCn>
        </div>

        <div class="grid grid-cols-[auto_1fr_auto_auto_auto] items-center gap-4 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <span class="w-6"></span>
            <span>Field Name</span>
            <span>Type</span>
            <span>Required</span>
            <span class="w-24 text-center">Actions</span>
        </div>

        <div>
            @for (var i = 0; i < _fields.Count; i++)
            {
                var field = _fields[i];
                var index = i;
                <div class="grid grid-cols-[auto_1fr_auto_auto_auto] items-center gap-4 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <LucideGripVerticalCn Class="size-4 shrink-0 text-muted-foreground/60" Size="16" />

                    <div class="min-w-0">
                        <p class="text-sm font-medium">@field.Name</p>
                        @if (!string.IsNullOrEmpty(field.Placeholder))
                        {
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">@field.Placeholder</p>
                        }
                    </div>

                    <span class="inline-flex rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">@GetTypeLabel(field.Type)</span>

                    <div class="flex items-center gap-2">
                        <SwitchCn Checked="@field.Required" CheckedChanged="@((bool v) => field.Required = v)" />
                    </div>

                    <div class="flex items-center justify-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                                  Disabled="@(index == 0)" OnClick="@(() => MoveField(field.Id, "up"))">
                            <LucideArrowUpCn Class="size-4" Size="16" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                                  Disabled="@(index == _fields.Count - 1)" OnClick="@(() => MoveField(field.Id, "down"))">
                            <LucideArrowDownCn Class="size-4" Size="16" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="size-7 p-0 text-red-600 hover:text-red-700"
                                  OnClick="@(() => _fields.Remove(field))">
                            <LucideTrash2Cn Class="size-4" Size="16" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <span class="text-xs text-muted-foreground">@_fields.Count(f => f.Required) required fields</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Preview Form</ButtonCn>
        </div>
    </div>
</section>

@code {
    private class FormField
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Type { get; set; } = "text";
        public bool Required { get; set; }
        public string Placeholder { get; set; } = "";
    }

    private record FieldType(string Value, string Label);

    private static readonly FieldType[] _fieldTypes =
    [
        new("text", "Text"), new("email", "Email"), new("number", "Number"), new("select", "Select"),
        new("checkbox", "Checkbox"), new("textarea", "Textarea"), new("date", "Date"), new("phone", "Phone"),
    ];

    private static string GetTypeLabel(string type) =>
        _fieldTypes.FirstOrDefault(t => t.Value == type)?.Label ?? type;

    private List<FormField> _fields =
    [
        new() { Id = "1", Name = "Full Name", Type = "text", Required = true, Placeholder = "Enter your full name" },
        new() { Id = "2", Name = "Email Address", Type = "email", Required = true, Placeholder = "you@@example.com" },
        new() { Id = "3", Name = "Phone Number", Type = "phone", Required = false, Placeholder = "+1 (555) 000-0000" },
        new() { Id = "4", Name = "Company", Type = "text", Required = false, Placeholder = "Your company name" },
        new() { Id = "5", Name = "Industry", Type = "select", Required = true, Placeholder = "Select an industry" },
        new() { Id = "6", Name = "Message", Type = "textarea", Required = true, Placeholder = "Tell us about your project" },
        new() { Id = "7", Name = "Subscribe to newsletter", Type = "checkbox", Required = false, Placeholder = "" },
    ];

    private void MoveField(string id, string direction)
    {
        var index = _fields.FindIndex(f => f.Id == id);
        if (direction == "up" && index > 0)
            (_fields[index], _fields[index - 1]) = (_fields[index - 1], _fields[index]);
        else if (direction == "down" && index < _fields.Count - 1)
            (_fields[index], _fields[index + 1]) = (_fields[index + 1], _fields[index]);
    }

    private void AddField(string type)
    {
        _fields.Add(new FormField
        {
            Id = $"field-{_fields.Count + 1}",
            Name = $"New {GetTypeLabel(type)} Field",
            Type = type,
            Required = false,
            Placeholder = $"Enter {type}",
        });
    }
}
