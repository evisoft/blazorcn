@* ============================================================
   Block: crud-priority-queue
   Title: Crud Priority Queue
   Description: Manage tasks and tickets with priority ordering and quick actions
   Dependencies: AvatarCn, BadgeCn, ButtonCn, DropdownMenuCn
   Source: original/blocks/crud/crud-priority-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Priority Queue</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Tasks sorted by priority and age</p>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="@(_sortBy == "priority" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              OnClick="@(() => _sortBy = "priority")" Class="h-7 text-xs">
                        By Priority
                    </ButtonCn>
                    <ButtonCn Variant="@(_sortBy == "age" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              OnClick="@(() => _sortBy = "age")" Class="h-7 text-xs">
                        By Age
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var item in _sortedQueue)
            {
                var priorityColor = item.Priority switch { "critical" => "bg-red-500", "high" => "bg-amber-500", "medium" => "bg-blue-500", _ => "bg-muted-foreground/40" };
                var statusVariant = item.Status switch { "in-progress" => BadgeVariant.Default, "pending" => BadgeVariant.Outline, _ => BadgeVariant.Secondary };
                <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", priorityColor)"></span>
                                <span class="text-sm font-medium">@item.Title</span>
                            </div>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <div class="flex items-center gap-1.5">
                                    <AvatarCn Class="size-4">
                                        <AvatarFallbackCn Class="text-[8px]">@item.AssigneeInitials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <span class="text-xs text-muted-foreground">@item.AssigneeName</span>
                                </div>
                                <span class="text-muted-foreground">&bull;</span>
                                <div class="flex items-center gap-1">
                                    <LucideClockCn Class="size-3 text-muted-foreground" Size="12" />
                                    <span class="text-xs text-muted-foreground">@item.Age</span>
                                </div>
                                <span class="text-muted-foreground">&bull;</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 text-[10px]">@item.Category</BadgeCn>
                                <BadgeCn Variant="@statusVariant" Class="h-4 text-[10px]">@item.Status</BadgeCn>
                            </div>
                            <div class="mt-1 font-mono text-xs text-muted-foreground">@item.Id</div>
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-xs">
                                        <LucideUserCn Class="size-3" Size="12" />
                                        Assign
                                        <LucideChevronDownCn Class="size-3" Size="12" />
                                    </ButtonCn>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                    <DropdownMenuItemCn Class="text-xs">Alex Chen</DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-xs">Sarah Kim</DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-xs">Mike Torres</DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-xs">
                                        Priority
                                        <LucideChevronDownCn Class="size-3" Size="12" />
                                    </ButtonCn>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                    <DropdownMenuItemCn Class="text-xs">
                                        <span class="mr-2 size-1.5 rounded-full bg-red-500"></span> Critical
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-xs">
                                        <span class="mr-2 size-1.5 rounded-full bg-amber-500"></span> High
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-xs">
                                        <span class="mr-2 size-1.5 rounded-full bg-blue-500"></span> Medium
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-xs">
                                        <span class="mr-2 size-1.5 rounded-full bg-muted-foreground/40"></span> Low
                                    </DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-muted-foreground">@_queue.Count(i => i.Priority == "critical") Critical</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-muted-foreground">@_queue.Count(i => i.Priority == "high") High</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span class="text-muted-foreground">@_queue.Count(i => i.Priority == "medium") Medium</span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideAlertCircleCn Class="size-3.5" Size="14" />
                <span>@_queue.Length items in queue</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 text-xs">Bulk Actions</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record QueueItem(string Id, string Title, string Priority, string AssigneeName, string AssigneeInitials, string Age, string Category, string Status);

    private string _sortBy = "priority";

    private QueueItem[] _sortedQueue => _sortBy == "priority"
        ? _queue.OrderBy(q => q.Priority switch { "critical" => 0, "high" => 1, "medium" => 2, _ => 3 }).ToArray()
        : _queue;

    private static readonly QueueItem[] _queue =
    [
        new("TKT-1247", "Production database connection timeout", "critical", "Alex Chen", "AC", "2h ago", "Infrastructure", "in-progress"),
        new("TKT-1245", "Customer unable to complete checkout", "critical", "Sarah Kim", "SK", "4h ago", "Payments", "in-progress"),
        new("TKT-1249", "API rate limit returning 500 errors", "high", "Mike Torres", "MT", "1h ago", "API", "open"),
        new("TKT-1243", "Email notifications delayed by 15 minutes", "high", "Jordan Lee", "JL", "1d ago", "Notifications", "pending"),
        new("TKT-1248", "Dashboard charts not loading for Safari users", "medium", "Taylor Brown", "TB", "3h ago", "Frontend", "open"),
        new("TKT-1242", "Add export to CSV feature for reports", "medium", "Alex Chen", "AC", "2d ago", "Features", "open"),
        new("TKT-1246", "Update privacy policy link in footer", "low", "Sarah Kim", "SK", "5h ago", "Content", "open"),
    ];
}
