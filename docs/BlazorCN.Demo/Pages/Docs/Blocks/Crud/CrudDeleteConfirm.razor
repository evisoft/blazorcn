@* ============================================================
   Block: crud-delete-confirm
   Title: Crud Delete Confirm
   Description: CRUD delete confirmation dialog with warning message, consequence description, confirmation input, and destructive action buttons
   Dependencies: ButtonCn, DialogCn, InputCn, LabelCn
   Source: original/blocks/crud/crud-delete-confirm.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Dangerous Actions</h2>
            <p class="mt-1 text-xs text-muted-foreground">Demonstration of delete confirmation patterns for destructive operations</p>
        </div>

        <div class="space-y-4 px-6 py-5">
            <div>
                <span class="text-xs font-medium text-muted-foreground">Simple Confirmation</span>
                <div class="mt-2">
                    <DialogCn @bind-Open="_simpleOpen">
                        <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Destructive"
                                  OnClick="@(() => _simpleOpen = true)">
                            Delete Item (Simple)
                        </ButtonCn>
                        <DialogContentCn>
                            <DialogHeaderCn>
                                <DialogTitleCn>Are you sure?</DialogTitleCn>
                                <DialogDescriptionCn>This action cannot be undone. This will permanently delete the item.</DialogDescriptionCn>
                            </DialogHeaderCn>
                            <DialogFooterCn>
                                <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _simpleOpen = false)">Cancel</ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Destructive" OnClick="@(() => _simpleOpen = false)">Delete</ButtonCn>
                            </DialogFooterCn>
                        </DialogContentCn>
                    </DialogCn>
                </div>
            </div>

            <div class="border-t pt-4">
                <span class="text-xs font-medium text-muted-foreground">Type to Confirm</span>
                <div class="mt-2">
                    <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Destructive"
                              OnClick="@(() => _open = true)">
                        Delete Item (Type Confirm)
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn Class="sm:max-w-md">
            <DialogHeaderCn>
                <div class="mb-2 flex items-center gap-3">
                    <div class="rounded-full bg-destructive/10 p-2">
                        <LucideAlertTriangleCn Class="size-5 text-destructive" Size="20" />
                    </div>
                    <DialogTitleCn Class="text-sm font-medium">Delete Product</DialogTitleCn>
                </div>
                <DialogDescriptionCn Class="text-xs text-muted-foreground">
                    This will permanently delete <strong>@_itemName</strong> and all associated data.
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="mt-4 rounded-md bg-muted/50 p-3">
                <span class="text-xs font-medium text-muted-foreground">This action is irreversible. The following will be deleted:</span>
                <ul class="mt-2 space-y-1 text-xs text-muted-foreground">
                    <li>Product information and images</li>
                    <li>45 active listings across 3 marketplaces</li>
                    <li>Order history and analytics data</li>
                </ul>
            </div>

            <div class="mt-4 space-y-2">
                <LabelCn For="confirm" Class="text-xs">
                    Type <strong>@_itemName</strong> to confirm
                </LabelCn>
                <InputCn Class="@(_confirmText.Length > 0 && !_canDelete ? "border-destructive" : "")"
                         id="confirm" placeholder="Enter product name exactly" @bind-Value="_confirmText" />
                @if (_confirmText.Length > 0 && !_canDelete)
                {
                    <p class="text-xs text-destructive">Product name doesn't match. Please type exactly as shown.</p>
                }
            </div>

            <DialogFooterCn Class="mt-6 gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => { _open = false; _confirmText = ""; })">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!_canDelete)" Variant="ButtonVariant.Destructive"
                          OnClick="@(() => { _open = false; _confirmText = ""; })">
                    Delete Product
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _simpleOpen;
    private bool _open;
    private string _confirmText = "";
    private static readonly string _itemName = "Premium Product Bundle";
    private bool _canDelete => _confirmText == _itemName;
}
