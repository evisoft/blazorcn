@* ============================================================
   Block: crud-linked-records
   Title: Linked Records Manager
   Description: Cross-reference and relationship management interface for connecting related records
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/crud/crud-linked-records.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Account Details</h2>
            <p class="mt-1 text-xs text-muted-foreground">Acme Corporation - Enterprise Account</p>
        </div>

        <div class="border-b">
            <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
                <div class="flex items-center gap-2">
                    <LucideLink2Cn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">Linked Contacts</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-xs">@_contacts.Count</BadgeCn>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1.5 px-2 text-xs"
                          @onclick="@(() => _showContactSearch = !_showContactSearch)">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Link Contact
                </ButtonCn>
            </div>

            @if (_showContactSearch)
            {
                <div class="border-b bg-muted/20 px-4 py-3">
                    <div class="relative">
                        <LucideSearchCn Size="14" Class="absolute left-2.5 top-2 size-3.5 text-muted-foreground" />
                        <InputCn type="text" Placeholder="Search contacts to link..." Value="@_contactSearchQuery" Class="h-7 pl-8 text-xs" aria-label="Search contacts to link" />
                    </div>
                </div>
            }

            <div class="divide-y">
                @foreach (var contact in _contacts)
                {
                    <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex min-w-0 flex-1 items-start gap-3">
                                <div class="mt-0.5 shrink-0">
                                    <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                                        <span class="text-xs font-medium">@contact.Initials</span>
                                    </div>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@contact.Name</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"h-5 text-xs {GetRelationshipColor(contact.Relationship)}")">
                                            @Capitalize(contact.Relationship)
                                        </BadgeCn>
                                    </div>
                                    <div class="mt-1.5 space-y-1">
                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                            <LucideMailCn Size="12" Class="size-3" />
                                            @contact.Email
                                        </div>
                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                            <LucidePhoneCn Size="12" Class="size-3" />
                                            @contact.Phone
                                        </div>
                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                            <LucideBuilding2Cn Size="12" Class="size-3" />
                                            @contact.Company
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="h-7 gap-1.5 px-2 text-xs text-red-600 hover:text-red-700"
                                      @onclick="@(() => _contacts.RemoveAll(c => c.Id == contact.Id))">
                                <LucideXCn Size="14" Class="size-3.5" />
                                Unlink
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
                <div class="flex items-center gap-2">
                    <LucideLink2Cn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">Linked Documents</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-xs">@_documents.Count</BadgeCn>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1.5 px-2 text-xs"
                          @onclick="@(() => _showDocumentSearch = !_showDocumentSearch)">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Link Document
                </ButtonCn>
            </div>

            @if (_showDocumentSearch)
            {
                <div class="border-b bg-muted/20 px-4 py-3">
                    <div class="relative">
                        <LucideSearchCn Size="14" Class="absolute left-2.5 top-2 size-3.5 text-muted-foreground" />
                        <InputCn type="text" Placeholder="Search documents to link..." Value="@_documentSearchQuery" Class="h-7 pl-8 text-xs" aria-label="Search documents to link" />
                    </div>
                </div>
            }

            <div class="divide-y">
                @foreach (var doc in _documents)
                {
                    <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex min-w-0 flex-1 items-start gap-3">
                                <div class="mt-0.5 shrink-0 text-muted-foreground">
                                    <LucideFileTextCn Size="16" Class="size-4" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="truncate text-sm font-medium">@doc.Title</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"h-5 text-xs {GetRelationshipColor(doc.Relationship)}")">
                                            @Capitalize(doc.Relationship)
                                        </BadgeCn>
                                    </div>
                                    <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span>@doc.Type</span>
                                        <span>&#x2022;</span>
                                        <span>Added @doc.DateAdded</span>
                                    </div>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="h-7 gap-1.5 px-2 text-xs text-red-600 hover:text-red-700"
                                      @onclick="@(() => _documents.RemoveAll(d => d.Id == doc.Id))">
                                <LucideXCn Size="14" Class="size-3.5" />
                                Unlink
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/30 px-4 py-3">
            <p class="text-xs text-muted-foreground">@(_contacts.Count + _documents.Count) total linked records</p>
        </div>
    </div>
</section>

@code {
    private class ContactItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Company { get; set; } = "";
        public string Relationship { get; set; } = "";
    }

    private record DocumentItem(string Id, string Title, string Type, string DateAdded, string Relationship);

    private bool _showContactSearch;
    private bool _showDocumentSearch;
    private string _contactSearchQuery = "";
    private string _documentSearchQuery = "";

    private readonly List<ContactItem> _contacts =
    [
        new() { Id = "c1", Name = "Sarah Chen", Initials = "SC", Email = "sarah.chen@acme.com", Phone = "+1 (555) 123-4567", Company = "Acme Corporation", Relationship = "primary" },
        new() { Id = "c2", Name = "Michael Rodriguez", Initials = "MR", Email = "m.rodriguez@acme.com", Phone = "+1 (555) 234-5678", Company = "Acme Corporation", Relationship = "associated" },
        new() { Id = "c3", Name = "Emily Thompson", Initials = "ET", Email = "emily.t@acme.com", Phone = "+1 (555) 345-6789", Company = "Acme Corporation", Relationship = "billing" },
    ];

    private readonly List<DocumentItem> _documents =
    [
        new("d1", "Master Services Agreement 2026", "PDF", "March 12, 2026", "contract"),
        new("d2", "Q1 Invoice - INV-2026-001", "PDF", "March 10, 2026", "invoice"),
        new("d3", "Project Proposal - Analytics Platform", "DOCX", "March 5, 2026", "proposal"),
        new("d4", "Technical Requirements Document", "PDF", "March 1, 2026", "reference"),
    ];

    private static string GetRelationshipColor(string relationship) => relationship switch
    {
        "primary" => "bg-blue-500/10 text-blue-600",
        "associated" => "bg-purple-500/10 text-purple-600",
        "billing" => "bg-emerald-500/10 text-emerald-600",
        "contract" => "bg-amber-500/10 text-amber-600",
        "invoice" => "bg-emerald-500/10 text-emerald-600",
        "proposal" => "bg-blue-500/10 text-blue-600",
        "reference" => "bg-muted text-muted-foreground",
        _ => "bg-muted text-muted-foreground",
    };

    private static string Capitalize(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
