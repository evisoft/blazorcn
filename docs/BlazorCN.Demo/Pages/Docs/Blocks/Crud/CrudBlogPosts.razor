@* ============================================================
   Block: crud-blog-posts
   Title: CrudBlogPosts
   Description: Blog post management with draft/published status, author info, category tagging, and content preview
   Source: original/blocks/crud/crud-blog-posts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Blog Posts</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_posts.Count posts · @_posts.Count(p => p.Status == "published") published
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Post
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search posts..."
                         Value="@_search"
                         ValueChanged="@((string v) => { _search = v; })" aria-label="Search posts" />
            </div>
        </div>

        <div class="flex border-b">
            @foreach (var tab in _tabs)
            {
                var t = tab;
                <button type="button"
                        @onclick="@(() => _filter = t)"
                        class="@Cn.Merge("flex-1 border-b-2 px-3 py-2 text-xs font-medium transition-colors", _filter == t ? "border-foreground text-foreground" : "border-transparent text-muted-foreground hover:text-foreground")">
                    @(t[0].ToString().ToUpperInvariant() + t.Substring(1))
                </button>
            }
        </div>

        <div>
            @foreach (var post in Filtered())
            {
                var p = post;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", StatusColor(p.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@p.Title</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">@p.Excerpt</p>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">@p.Category</BadgeCn>
                                <span class="text-xs text-muted-foreground">@p.Author</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@p.Date</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@p.ReadTime read</span>
                                @if (p.Views > 0)
                                {
                                    <span class="text-xs text-muted-foreground">·</span>
                                    <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                        @p.Views.ToString("N0")
                                    </span>
                                }
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>
                                    <LucideIconCn Name="pencil" Size="16" Class="mr-2 size-4" />
                                    Edit
                                </DropdownMenuItemCn>
                                @if (p.Status == "draft")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandlePublish(p.Id))">Publish</DropdownMenuItemCn>
                                }
                                @if (p.Status == "published")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandleArchive(p.Id))">Archive</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(p.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!Filtered().Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No posts found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Post(int Id, string Title, string Excerpt, string Author, string Category, string Status, string Date, string ReadTime, int Views);

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _tabs = ["all", "published", "draft", "scheduled", "archived"];

    private List<Post> _posts =
    [
        new(1, "Getting Started with React Server Components",
            "A comprehensive guide to understanding and implementing React Server Components in your Next.js applications.",
            "Sarah Chen", "Engineering", "published", "Mar 22, 2026", "8 min", 3420),
        new(2, "Design Systems at Scale",
            "How we built and maintained a design system serving 50+ products and 200+ engineers.",
            "Mike Johnson", "Design", "published", "Mar 20, 2026", "12 min", 2180),
        new(3, "The Future of AI in Developer Tools",
            "Exploring how artificial intelligence is reshaping the way we write, test, and deploy code.",
            "Emma Davis", "AI", "draft", "Mar 24, 2026", "10 min", 0),
        new(4, "Scaling PostgreSQL to 10M Rows",
            "Practical strategies for query optimization, indexing, and partitioning at scale.",
            "David Lee", "Engineering", "published", "Mar 18, 2026", "15 min", 5670),
        new(5, "Building a Product-Led Growth Engine",
            "Lessons learned from implementing PLG strategies at a B2B SaaS company.",
            "Alex Morgan", "Product", "scheduled", "Mar 28, 2026", "7 min", 0),
        new(6, "CSS Container Queries in Practice",
            "Real-world examples of using container queries to build truly responsive components.",
            "Lisa Wang", "Frontend", "draft", "Mar 23, 2026", "6 min", 0),
        new(7, "Remote Work Culture That Works",
            "How our distributed team maintains productivity and connection across time zones.",
            "Tom Brown", "Culture", "archived", "Feb 14, 2026", "5 min", 1890),
    ];

    private IEnumerable<Post> Filtered() =>
        _posts
            .Where(p => _filter == "all" || p.Status == _filter)
            .Where(p => string.IsNullOrEmpty(_search) ||
                        p.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        p.Author.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static string StatusColor(string status) => status switch
    {
        "published" => "bg-emerald-500",
        "draft"     => "bg-amber-500",
        "scheduled" => "bg-blue-500",
        _           => "bg-muted-foreground/40",
    };

    private void HandleDelete(int id) => _posts = _posts.Where(p => p.Id != id).ToList();

    private void HandlePublish(int id) =>
        _posts = _posts.Select(p => p.Id == id ? p with { Status = "published" } : p).ToList();

    private void HandleArchive(int id) =>
        _posts = _posts.Select(p => p.Id == id ? p with { Status = "archived" } : p).ToList();
}
