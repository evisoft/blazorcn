@* ============================================================
   Block: crud-client-directory
   Title: CrudClientDirectory
   Description: Client directory with contact details, company info, engagement status, and relationship management
   Source: original/blocks/crud/crud-client-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Client Directory</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_clients.Count clients · @_clients.Count(c => c.Status == "active") active
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Client
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search clients..."
                         Value="@_search"
                         ValueChanged="@((string v) => { _search = v; })" aria-label="Search clients" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterVal = s;
                    <button type="button"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _filter = filterVal)">
                        @(filterVal.Length > 0 ? char.ToUpper(filterVal[0]) + filterVal.Substring(1) : filterVal)
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var client in Filtered)
            {
                var item = client;
                <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Company</span>
                            <span class="@Cn.Merge("size-1.5 rounded-full", _statusColors.GetValueOrDefault(item.Status, "bg-muted-foreground"))"></span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@item.Contact</span>
                            <span>·</span>
                            <span>@item.Email</span>
                        </div>
                    </div>
                    <div class="hidden text-right sm:block">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">@item.Industry</BadgeCn>
                        <div class="mt-1 flex items-center justify-end gap-2">
                            <span class="text-xs font-medium tabular-nums">@item.Revenue</span>
                            <span class="text-xs text-muted-foreground">· @item.LastContact</span>
                        </div>
                    </div>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="Ellipsis">
                                <LucideIconCn Name="ellipsis" Size="16" Class="size-4" />
                            </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuItemCn>View Profile</DropdownMenuItemCn>
                            <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                            <DropdownMenuItemCn>Log Activity</DropdownMenuItemCn>
                            <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(item.Id))">
                                <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                Delete
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No clients found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Client(int Id, string Company, string Contact, string Email, string Industry, string Status, string Revenue, string LastContact);

    private List<Client> _clients = new List<Client>
    {
        new(1, "Acme Corporation", "Jennifer Walsh", "jennifer@@acme.com", "Technology", "active", "$124,000", "2 days ago"),
        new(2, "Meridian Health", "Dr. Robert Kim", "rkim@@meridian.health", "Healthcare", "active", "$89,000", "1 week ago"),
        new(3, "Atlas Financial", "Marcus Chen", "mchen@@atlasfinancial.com", "Finance", "onboarding", "$0", "Yesterday"),
        new(4, "Vertex Design Studio", "Olivia Park", "olivia@@vertex.design", "Design", "active", "$45,000", "3 days ago"),
        new(5, "Pinnacle Logistics", "James Rodriguez", "jrodriguez@@pinnacle.io", "Logistics", "prospect", "$0", "2 weeks ago"),
        new(6, "Nova Education", "Dr. Sarah Miller", "smiller@@novaedu.org", "Education", "churned", "$32,000", "1 month ago"),
        new(7, "Quantum Labs", "Alex Tanaka", "atanaka@@quantumlabs.io", "Research", "active", "$210,000", "4 days ago"),
        new(8, "Greenleaf Organics", "Emma Thompson", "emma@@greenleaf.co", "Food & Bev", "prospect", "$0", "5 days ago"),
    };

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "active", "prospect", "onboarding", "churned"];

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["active"] = "bg-emerald-500",
        ["prospect"] = "bg-blue-500",
        ["churned"] = "bg-red-500",
        ["onboarding"] = "bg-amber-500",
    };

    private IEnumerable<Client> Filtered =>
        _clients
            .Where(c => _filter == "all" || c.Status == _filter)
            .Where(c => c.Company.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        c.Contact.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleDelete(int id) => _clients.RemoveAll(c => c.Id == id);
}
