@* ============================================================
   Block: crud-recipe-manager
   Title: CrudRecipeManager
   Description: Recipe collection manager with ingredients, prep time, difficulty, servings, and dietary tags
   Source: original/blocks/crud/crud-recipe-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="chef-hat" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Recipes</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_recipes.Length recipes · @_recipes.Count(r => r.Status == "published") published
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Recipe
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search recipes..."
                         @bind-Value="_search" />
            </div>
            <div class="flex gap-1">
                @foreach (var filterOpt in new[] { "all", "easy", "medium", "hard" })
                {
                    var opt = filterOpt;
                    <button type="button" @onclick="@(() => _filter = opt)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == opt ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(char.ToUpper(opt[0]) + opt[1..])
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var recipe in _filtered)
            {
                var diffColor = recipe.Difficulty switch { "easy" => "bg-emerald-500", "medium" => "bg-amber-500", _ => "bg-red-500" };
                var recipeId = recipe.Id;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", diffColor)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@recipe.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                    @recipe.Cuisine
                                </BadgeCn>
                                @if (recipe.Rating > 0)
                                {
                                    <span class="text-xs font-medium tabular-nums">@recipe.Rating</span>
                                }
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">
                                @recipe.Description
                            </p>
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var tag in recipe.Tags)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">
                                        @tag
                                    </span>
                                }
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>Prep: @recipe.PrepTime</span>
                                <span>·</span>
                                <span>Cook: @recipe.CookTime</span>
                                <span>·</span>
                                <span>@recipe.Servings servings</span>
                                <span>·</span>
                                <span>@recipe.Ingredients ingredients</span>
                                <span>·</span>
                                <span class="capitalize">@recipe.Difficulty</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                @if (recipe.Status == "draft")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandlePublish(recipeId))">Publish</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Print</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(recipeId))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (_filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No recipes found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Recipe(int Id, string Name, string Description, string Cuisine, string Difficulty,
        string PrepTime, string CookTime, int Servings, int Ingredients, string[] Tags,
        string Status, double Rating);

    private string _search = "";
    private string _filter = "all";

    private Recipe[] _recipes = _initial.ToArray();

    private Recipe[] _filtered => _recipes
        .Where(r => _filter == "all" || r.Difficulty == _filter)
        .Where(r => r.Name.ToLower().Contains(_search.ToLower()) || r.Cuisine.ToLower().Contains(_search.ToLower()))
        .ToArray();

    private void HandleDelete(int id)
    {
        _recipes = _recipes.Where(r => r.Id != id).ToArray();
    }

    private void HandlePublish(int id)
    {
        _recipes = _recipes.Select(r => r.Id == id ? r with { Status = "published" } : r).ToArray();
    }

    private static readonly Recipe[] _initial =
    [
        new(1, "Pan-Seared Salmon with Miso Glaze", "Crispy-skin salmon with a sweet white miso glaze, served with sesame bok choy",
            "Japanese Fusion", "medium", "15 min", "12 min", 4, 12, ["Gluten-Free", "High Protein"], "published", 4.8),
        new(2, "Classic Margherita Pizza", "Neapolitan-style pizza with San Marzano tomatoes, fresh mozzarella, and basil",
            "Italian", "hard", "2 hr", "8 min", 2, 8, ["Vegetarian"], "published", 4.9),
        new(3, "Thai Green Curry", "Aromatic coconut curry with chicken, bamboo shoots, Thai basil, and jasmine rice",
            "Thai", "medium", "20 min", "25 min", 6, 18, ["Dairy-Free", "Gluten-Free"], "published", 4.7),
        new(4, "Avocado Toast with Poached Eggs", "Sourdough toast with smashed avocado, perfectly poached eggs, and chili flakes",
            "Brunch", "easy", "5 min", "10 min", 2, 6, ["Vegetarian"], "published", 4.5),
        new(5, "Beef Wellington", "Tenderloin wrapped in mushroom duxelles and puff pastry with red wine jus",
            "British", "hard", "45 min", "30 min", 8, 15, ["Special Occasion"], "draft", 0),
        new(6, "Chickpea Buddha Bowl", "Roasted chickpeas with quinoa, roasted vegetables, tahini dressing, and pickled onions",
            "Health", "easy", "10 min", "25 min", 2, 14, ["Vegan", "Gluten-Free", "High Protein"], "published", 4.6),
    ];
}
