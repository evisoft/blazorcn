@* ============================================================
   Block: crud-audit-log
   Title: Crud Audit Log
   Description: Complete audit log showing all CRUD operations with filtering and user tracking
   Dependencies: BadgeCn, ButtonCn, DropdownMenuCn
   Source: original/blocks/crud/crud-audit-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Audit Trail</h2>
                    <p class="mt-1 text-xs text-muted-foreground">Track all system changes and actions</p>
                </div>
                <div class="flex items-center gap-2">
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm h-7 gap-1.5 text-xs" data-variant="outline" data-size="sm">
                                <LucideFunnelCn Class="size-3.5" Size="14" />
                                Actions
                                <LucideChevronDownCn Class="size-3.5" Size="14" />
                            </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuCheckboxItemCn Checked="@_actionFilter.Contains("Created")" CheckedChanged="@((bool _) => ToggleFilter("Created"))">
                                <span class="mr-2 size-1.5 rounded-full bg-emerald-500"></span>
                                Created
                            </DropdownMenuCheckboxItemCn>
                            <DropdownMenuCheckboxItemCn Checked="@_actionFilter.Contains("Updated")" CheckedChanged="@((bool _) => ToggleFilter("Updated"))">
                                <span class="mr-2 size-1.5 rounded-full bg-blue-500"></span>
                                Updated
                            </DropdownMenuCheckboxItemCn>
                            <DropdownMenuCheckboxItemCn Checked="@_actionFilter.Contains("Deleted")" CheckedChanged="@((bool _) => ToggleFilter("Deleted"))">
                                <span class="mr-2 size-1.5 rounded-full bg-red-500"></span>
                                Deleted
                            </DropdownMenuCheckboxItemCn>
                            <DropdownMenuCheckboxItemCn Checked="@_actionFilter.Contains("Exported")" CheckedChanged="@((bool _) => ToggleFilter("Exported"))">
                                <span class="mr-2 size-1.5 rounded-full bg-amber-500"></span>
                                Exported
                            </DropdownMenuCheckboxItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideCalendarCn Class="size-3.5" Size="14" />
                        Last 7 days
                        <LucideChevronDownCn Class="size-3.5" Size="14" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div>
            @if (_filtered.Length == 0)
            {
                <div class="px-6 py-12 text-center">
                    <LucideFileTextCn Class="mx-auto size-8 text-muted-foreground/40" Size="32" />
                    <p class="mt-2 text-sm text-muted-foreground">No audit entries match your filters</p>
                </div>
            }
            else
            {
                @for (var i = 0; i < _filtered.Length; i++)
                {
                    var entry = _filtered[i];
                    <div class="@Cn.Merge("px-6 py-4", i != _filtered.Length - 1 ? "border-b" : "")">
                        <div class="flex items-start gap-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                @GetInitials(entry.User)
                            </div>
                            <span class="@Cn.Merge("mt-2.5 size-1.5 shrink-0 rounded-full", GetActionColor(entry.Action))"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@entry.User</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-xs">@entry.Action</BadgeCn>
                                    <span class="text-sm text-muted-foreground">@entry.Resource</span>
                                </div>
                                <p class="mt-1 text-xs text-muted-foreground">@entry.Details</p>
                                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                                    <span>@entry.Timestamp</span>
                                    <span>&bull;</span>
                                    <span class="font-mono">@entry.IpAddress</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="border-t bg-muted/30 px-6 py-3">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideFileTextCn Class="size-3.5" Size="14" />
                <span>Showing @_filtered.Length of @_entries.Length entries</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record AuditEntry(string Id, string User, string Action, string Resource, string Timestamp, string IpAddress, string Details);

    private HashSet<string> _actionFilter = new(["Created", "Updated", "Deleted", "Exported"]);

    private AuditEntry[] _filtered => _entries.Where(e => _actionFilter.Contains(e.Action)).ToArray();

    private void ToggleFilter(string action)
    {
        if (!_actionFilter.Remove(action)) _actionFilter.Add(action);
    }

    private static string GetActionColor(string action) => action switch
    {
        "Created" => "bg-emerald-500",
        "Updated" => "bg-blue-500",
        "Deleted" => "bg-red-500",
        "Exported" => "bg-amber-500",
        _ => "bg-muted-foreground"
    };

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static readonly AuditEntry[] _entries =
    [
        new("1", "Sarah Chen", "Created", "User Account", "Mar 16, 2024 at 2:34 PM", "192.168.1.45", "john.doe@@example.com"),
        new("2", "Mike Johnson", "Updated", "Blog Post", "Mar 16, 2024 at 1:22 PM", "192.168.1.67", "Changed title and content"),
        new("3", "Admin", "Deleted", "Comment", "Mar 16, 2024 at 11:15 AM", "192.168.1.12", "Spam comment removed"),
        new("4", "Emily Rodriguez", "Exported", "User List", "Mar 16, 2024 at 10:45 AM", "192.168.1.89", "Exported 1,247 users to CSV"),
        new("5", "Tom Anderson", "Created", "API Key", "Mar 15, 2024 at 4:18 PM", "192.168.1.23", "Production API key"),
        new("6", "Lisa Park", "Updated", "Settings", "Mar 15, 2024 at 3:02 PM", "192.168.1.34", "Changed notification preferences"),
        new("7", "Chris Lee", "Deleted", "Project", "Mar 15, 2024 at 1:30 PM", "192.168.1.56", "Legacy Project Archive"),
        new("8", "Sarah Chen", "Created", "Team", "Mar 15, 2024 at 11:20 AM", "192.168.1.45", "Engineering Team"),
        new("9", "Mike Johnson", "Updated", "User Role", "Mar 14, 2024 at 5:45 PM", "192.168.1.67", "Changed role from Viewer to Editor"),
        new("10", "Admin", "Exported", "Audit Log", "Mar 14, 2024 at 2:15 PM", "192.168.1.12", "Exported last 30 days"),
    ];
}
