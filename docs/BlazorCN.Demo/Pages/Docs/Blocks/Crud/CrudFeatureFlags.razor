@* ============================================================
   Block: crud-feature-flags
   Title: Feature Flag Manager
   Description: Toggle and configure feature flags across environments
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/crud/crud-feature-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideFlagCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">Feature Flags</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">Create Flag</ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            @{
                var filteredFlags = _filterEnv == "All"
                    ? _flags
                    : _flags.Where(f => _filterEnv == "Production" ? f.Production : _filterEnv == "Staging" ? f.Staging : f.Dev).ToList();
            }
            <div class="mb-3 flex items-center justify-between">
                <p class="text-xs text-muted-foreground">@filteredFlags.Count flag@(filteredFlags.Count != 1 ? "s" : "")</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideFunnelCn Size="14" Class="size-3.5" />
                    Filter
                </ButtonCn>
            </div>

            <div class="flex flex-wrap gap-2">
                @foreach (var env in _environments)
                {
                    <button type="button"
                            @onclick="@(() => _filterEnv = env)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filterEnv == env ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                        @env
                    </button>
                }
            </div>
        </div>

        <div>
            @if (filteredFlags.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <p class="text-sm text-muted-foreground">No flags found for this environment</p>
                </div>
            }
            else
            {
                <div>
                    @for (var i = 0; i < filteredFlags.Count; i++)
                    {
                        var flag = filteredFlags[i];
                        var isLast = i == filteredFlags.Count - 1;
                        <div class="@Cn.Merge("px-4 py-3", !isLast ? "border-b" : "")">
                            <div class="mb-2 flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="mb-1 flex items-center gap-2">
                                        <span class="text-sm font-medium">@flag.Name</span>
                                        <span class="text-xs text-muted-foreground">@flag.RolloutPercent% rollout</span>
                                    </div>
                                    <p class="mb-1.5 text-xs text-muted-foreground">@flag.Description</p>
                                    <code class="text-xs text-muted-foreground">@flag.Key</code>
                                </div>
                                <ButtonCn aria-label="@($"More options for {flag.Name}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0">
                                    <LucideEllipsisVerticalCn Size="16" Class="size-4" />
                                </ButtonCn>
                            </div>

                            <div class="mb-2 flex flex-wrap gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-5 rounded-md px-1.5 text-xs {(flag.Production ? "bg-emerald-500/10 text-emerald-700" : "bg-zinc-500/10 text-zinc-600")}")">
                                    Production
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-5 rounded-md px-1.5 text-xs {(flag.Staging ? "bg-amber-500/10 text-amber-700" : "bg-zinc-500/10 text-zinc-600")}")">
                                    Staging
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-5 rounded-md px-1.5 text-xs {(flag.Dev ? "bg-blue-500/10 text-blue-700" : "bg-zinc-500/10 text-zinc-600")}")">
                                    Dev
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">&#x2022; Updated @flag.LastModified</span>
                            </div>

                            <div class="flex flex-wrap items-center gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">Production</span>
                                    <SwitchCn Checked="@flag.Production" CheckedChanged="@(_ => flag.Production = !flag.Production)" aria-label="@($"{flag.Name} in Production")" />
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">Staging</span>
                                    <SwitchCn Checked="@flag.Staging" CheckedChanged="@(_ => flag.Staging = !flag.Staging)" aria-label="@($"{flag.Name} in Staging")" />
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">Dev</span>
                                    <SwitchCn Checked="@flag.Dev" CheckedChanged="@(_ => flag.Dev = !flag.Dev)" aria-label="@($"{flag.Name} in Dev")" />
                                </div>
                                <div class="ml-auto flex gap-1">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">Edit Rules</ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                        <LucideCodeCn Size="12" Class="size-3" />
                                        View Usage
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                        <LucideArchiveCn Size="12" Class="size-3" />
                                        Archive
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class FlagItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Key { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Production { get; set; }
        public bool Staging { get; set; }
        public bool Dev { get; set; }
        public int RolloutPercent { get; set; }
        public string LastModified { get; set; } = "";
    }

    private string _filterEnv = "All";
    private static readonly string[] _environments = ["All", "Production", "Staging", "Dev"];

    private readonly List<FlagItem> _flags =
    [
        new() { Id = "1", Name = "New Dashboard Layout", Key = "new_dashboard_v2", Description = "Redesigned dashboard with improved navigation and metrics", Production = false, Staging = true, Dev = true, RolloutPercent = 25, LastModified = "2 hours ago" },
        new() { Id = "2", Name = "AI-Powered Search", Key = "ai_search_beta", Description = "Semantic search with natural language understanding", Production = true, Staging = true, Dev = true, RolloutPercent = 10, LastModified = "1 day ago" },
        new() { Id = "3", Name = "Dark Mode Support", Key = "dark_mode_toggle", Description = "User-selectable dark theme for the entire application", Production = true, Staging = true, Dev = true, RolloutPercent = 100, LastModified = "3 days ago" },
        new() { Id = "4", Name = "Real-time Collaboration", Key = "realtime_collab", Description = "Live cursors and presence indicators for team editing", Production = false, Staging = true, Dev = true, RolloutPercent = 0, LastModified = "5 hours ago" },
        new() { Id = "5", Name = "Advanced Analytics", Key = "analytics_v3", Description = "Enhanced analytics dashboard with custom reporting", Production = true, Staging = true, Dev = true, RolloutPercent = 50, LastModified = "1 week ago" },
        new() { Id = "6", Name = "Export to PDF", Key = "pdf_export", Description = "Generate PDF reports from dashboard data", Production = false, Staging = false, Dev = true, RolloutPercent = 0, LastModified = "2 days ago" },
        new() { Id = "7", Name = "Two-Factor Auth", Key = "mfa_required", Description = "Mandatory 2FA for all user accounts", Production = false, Staging = true, Dev = true, RolloutPercent = 0, LastModified = "4 days ago" },
        new() { Id = "8", Name = "Webhook Integration", Key = "webhooks_enabled", Description = "Send real-time events to external services", Production = true, Staging = true, Dev = true, RolloutPercent = 75, LastModified = "6 days ago" },
    ];
}
