@* ============================================================
   Block: crud-project-board
   Title: CrudProjectBoard
   Description: Project board management with task columns, priority levels, assignees, and progress tracking
   Source: original/blocks/crud/crud-project-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="kanban" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Projects</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_projects.Count projects · @_projects.Count(p => p.Status == "active") active
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Project
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search projects..."
                         @bind-Value="_search" aria-label="Search projects" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterVal = s;
                    <button type="button"
                            @onclick="@(() => _filter = filterVal)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(filterVal == "on-hold" ? "On Hold" : char.ToUpperInvariant(filterVal[0]) + filterVal.Substring(1))
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _projects
                    .Where(p => _filter == "all" || p.Status == _filter)
                    .Where(p => p.Name.ToLowerInvariant().Contains(_search.ToLowerInvariant()) ||
                                p.Lead.ToLowerInvariant().Contains(_search.ToLowerInvariant()))
                    .ToList();
            }
            @foreach (var project in filtered)
            {
                var progress = project.Tasks > 0 ? (int)Math.Round((double)project.CompletedTasks / project.Tasks * 100) : 0;
                var statusColor = _statusColors.TryGetValue(project.Status, out var sc) ? sc : "bg-muted-foreground/40";
                var priorityColor = _priorityColors.TryGetValue(project.Priority, out var pc) ? pc : "bg-muted-foreground/40";
                var proj = project;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", statusColor)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@proj.Name</span>
                                <span class="@Cn.Merge("size-1.5 rounded-full", priorityColor)"></span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">@proj.Priority</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">@proj.Description</p>
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var tag in proj.Tags)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">@tag</span>
                                }
                            </div>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@proj.Lead</span>
                                <span>·</span>
                                <span>@proj.Members members</span>
                                <span>·</span>
                                <span class="tabular-nums">@proj.CompletedTasks/@proj.Tasks tasks</span>
                                <span>·</span>
                                <span>Due @proj.Deadline</span>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/20" style="@($"width:{progress}%")"></div>
                                </div>
                                <span class="text-xs font-medium tabular-nums">@progress%</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="Ellipsis">
                                    <LucideIconCn Name="ellipsis" Size="16" Class="size-4" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>View Board</DropdownMenuItemCn>
                                @if (proj.Status != "completed")
                                {
                                    <DropdownMenuItemCn @onclick="@(() => HandleComplete(proj.Id))">Mark Complete</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => HandleDelete(proj.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No projects found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Project(int Id, string Name, string Description, string Status, string Priority,
        string Lead, int Members, int Tasks, int CompletedTasks, string Deadline, string[] Tags);

    private static readonly string[] _filterOptions = ["all", "active", "planning", "on-hold", "completed"];

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["active"] = "bg-emerald-500",
        ["planning"] = "bg-blue-500",
        ["on-hold"] = "bg-amber-500",
        ["completed"] = "bg-muted-foreground/40",
    };

    private static readonly Dictionary<string, string> _priorityColors = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-muted-foreground/40",
    };

    private List<Project> _projects =
    [
        new(1, "Platform Migration v3", "Migrate core platform from monolith to microservices architecture",
            "active", "high", "Sarah Chen", 8, 45, 32, "Apr 30, 2026", ["Backend", "Infrastructure"]),
        new(2, "Design System Refresh", "Update component library with new tokens, accessibility improvements, and dark mode",
            "active", "high", "Emma Davis", 4, 28, 22, "Mar 31, 2026", ["Frontend", "Design"]),
        new(3, "Mobile App v2.0", "Major mobile app update with offline support and push notifications",
            "planning", "medium", "Mike Johnson", 6, 35, 0, "Jun 30, 2026", ["Mobile", "iOS", "Android"]),
        new(4, "Analytics Dashboard", "Custom analytics dashboard with real-time metrics and export capabilities",
            "active", "medium", "David Lee", 3, 18, 12, "Apr 15, 2026", ["Frontend", "Data"]),
        new(5, "SOC 2 Certification", "Complete SOC 2 Type II certification process and documentation",
            "on-hold", "high", "Tom Bradley", 5, 32, 8, "May 31, 2026", ["Security", "Compliance"]),
        new(6, "Customer Portal Redesign", "Redesign the customer-facing portal with improved UX and self-service features",
            "completed", "low", "Lisa Wang", 4, 22, 22, "Mar 15, 2026", ["Frontend", "UX"]),
    ];

    private string _search = "";
    private string _filter = "all";

    private void HandleDelete(int id) =>
        _projects = _projects.Where(p => p.Id != id).ToList();

    private void HandleComplete(int id) =>
        _projects = _projects.Select(p =>
            p.Id == id ? p with { Status = "completed", CompletedTasks = p.Tasks } : p).ToList();
}
