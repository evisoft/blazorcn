@* ============================================================
   Block: crud-email-templates
   Title: Email Template Manager
   Description: Manage transactional email templates with preview and testing
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/crud/crud-email-templates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">Email Templates</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">Create Template</ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3">
                <div class="relative">
                    <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                    <InputCn type="text" Placeholder="Search templates..." Value="@_searchQuery" Class="h-8 pl-8 text-xs" />
                </div>
            </div>

            <div class="flex flex-wrap gap-2">
                @foreach (var trigger in _triggers)
                {
                    <button type="button"
                            @onclick="@(() => _selectedTrigger = trigger)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _selectedTrigger == trigger ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                        @trigger
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _templates.Where(t =>
                    (string.IsNullOrEmpty(_searchQuery) ||
                     t.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     t.Subject.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                    (_selectedTrigger == "All" || t.Trigger == _selectedTrigger)).ToList();
            }
            @if (filtered.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <p class="text-sm text-muted-foreground">No templates found</p>
                </div>
            }
            else
            {
                <div>
                    @for (var i = 0; i < filtered.Count; i++)
                    {
                        var template = filtered[i];
                        var isLast = i == filtered.Count - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", !template.IsActive ? "opacity-60" : "")">
                            <div class="min-w-0 flex-1">
                                <div class="mb-1 flex items-center gap-2">
                                    <span class="text-sm font-medium">@template.Name</span>
                                    @if (!template.IsActive)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 rounded-md px-1.5 text-xs text-zinc-600">Inactive</BadgeCn>
                                    }
                                </div>
                                <p class="mb-1.5 truncate text-xs text-muted-foreground">@template.Subject</p>
                                <div class="flex flex-wrap items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-5 rounded-md px-1.5 text-xs {GetTriggerColor(template.Trigger)}")">
                                        @template.Trigger
                                    </BadgeCn>
                                    <span class="text-xs text-muted-foreground">@template.SendCount.ToString("N0") sent</span>
                                    <span class="text-xs text-muted-foreground">&#x2022;</span>
                                    <span class="text-xs text-muted-foreground">Edited @template.LastEdited</span>
                                </div>
                            </div>

                            <div class="flex shrink-0 items-center gap-1">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                    <LucideSendCn Size="12" Class="size-3" />
                                    Test
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                    <LucideCopyCn Size="12" Class="size-3" />
                                    Duplicate
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                                    <LucideMoreVerticalCn Size="16" Class="size-4" />
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                @filtered.Count template@(filtered.Count != 1 ? "s" : "") &#x2022; @filtered.Count(t => t.IsActive) active
            </p>
        </div>
    </div>
</section>

@code {
    private record EmailTemplate(string Id, string Name, string Subject, string Trigger, string LastEdited, int SendCount, bool IsActive);

    private string _searchQuery = "";
    private string _selectedTrigger = "All";
    private static readonly string[] _triggers = ["All", "Welcome", "Reset", "Invoice", "Notification"];

    private readonly List<EmailTemplate> _templates =
    [
        new("1", "Welcome Email", "Welcome to our platform, {{user.name}}!", "Welcome", "2 days ago", 1245, true),
        new("2", "Password Reset Request", "Reset your password", "Reset", "1 week ago", 432, true),
        new("3", "Monthly Invoice", "Your invoice for {{month}} is ready", "Invoice", "3 days ago", 3890, true),
        new("4", "System Notification", "Important update about your account", "Notification", "5 days ago", 156, true),
        new("5", "Welcome Onboarding Series - Day 1", "Get started with these resources", "Welcome", "1 week ago", 1089, true),
        new("6", "Payment Failed", "We couldn't process your payment", "Notification", "2 weeks ago", 67, false),
        new("7", "Trial Expiration Notice", "Your trial ends in 3 days", "Notification", "4 days ago", 234, true),
        new("8", "Annual Receipt", "Receipt for your annual subscription", "Invoice", "1 month ago", 892, true),
    ];

    private static string GetTriggerColor(string trigger) => trigger switch
    {
        "Welcome" => "bg-blue-500/10 text-blue-700",
        "Reset" => "bg-amber-500/10 text-amber-700",
        "Invoice" => "bg-emerald-500/10 text-emerald-700",
        "Notification" => "bg-purple-500/10 text-purple-700",
        _ => "bg-muted text-muted-foreground",
    };
}
