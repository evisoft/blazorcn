@* ============================================================
   Block: crud-sort-reorder
   Title: Crud Sort Reorder
   Description: Manual drag-free reordering interface with position tracking and visual feedback
   Long Description: Reorder list items with up/down arrows, position tracking, and change indicators. Perfect for navigation menus, FAQ ordering, or any sortable content that needs manual arrangement.
   Dependencies: ButtonCn
   Source: original/blocks/crud/crud-sort-reorder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-sm font-medium">Navigation Menu Order</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Arrange menu items in your preferred order
                    </p>
                </div>
            </div>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _items.Count; i++)
            {
                var item = _items[i];
                var currentPosition = i + 1;
                var moved = item.OriginalPosition != currentPosition;
                <div class="@Cn.Merge("px-4 py-3 transition-colors", moved ? "bg-blue-500/5" : "")">
                    <div class="flex items-center gap-3">
                        <div class="shrink-0 text-muted-foreground/40">
                            <LucideGripVerticalCn Size="16" Class="size-4" />
                        </div>

                        <div class="flex size-7 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                            <span class="font-mono text-xs font-medium">@currentPosition</span>
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@item.Title</span>
                                @if (moved)
                                {
                                    <span class="text-xs text-muted-foreground">
                                        (was #@item.OriginalPosition)
                                    </span>
                                }
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@item.Description</p>
                        </div>

                        <div class="flex shrink-0 gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" Disabled="@(i == 0)">
                                <LucideArrowUpCn Size="14" Class="size-3.5" />
                                <span class="sr-only">Move up</span>
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" Disabled="@(i == _items.Count - 1)">
                                <LucideArrowDownCn Size="14" Class="size-3.5" />
                                <span class="sr-only">Move down</span>
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">@_items.Count menu items</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record SortableItem(string Id, string Title, string Description, int OriginalPosition);

    private readonly List<SortableItem> _items =
    [
        new("nav_1", "Dashboard", "Main overview and analytics", 1),
        new("nav_2", "Products", "Product catalog and inventory", 2),
        new("nav_3", "Orders", "Order management and fulfillment", 3),
        new("nav_4", "Customers", "Customer database and profiles", 4),
        new("nav_5", "Analytics", "Reports and business insights", 5),
        new("nav_6", "Marketing", "Campaigns and promotions", 6),
        new("nav_7", "Settings", "Account and system configuration", 7),
    ];
}
