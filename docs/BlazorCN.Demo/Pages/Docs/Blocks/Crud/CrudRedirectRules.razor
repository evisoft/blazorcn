@* ============================================================
   Block: crud-redirect-rules
   Title: CrudRedirectRules
   Description: URL redirect rule manager with pattern matching, status codes, priority ordering, and hit tracking
   Source: original/blocks/crud/crud-redirect-rules.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Redirect Rules</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_rules.Count rules · @_rules.Count(r => r.Status == "active") active
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Rule
                </ButtonCn>
            </div>
        </div>

        @* Search + Filter Bar *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search URLs..."
                         @bind-Value="_search" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterVal = s;
                    <button type="button"
                            @onclick="@(() => _filter = filterVal)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(filterVal.Length > 0 ? char.ToUpperInvariant(filterVal[0]) + filterVal.Substring(1) : filterVal)
                    </button>
                }
            </div>
        </div>

        @* Rules List *@
        <div>
            @foreach (var rule in Filtered)
            {
                var ruleItem = rule;
                var dotColor = rule.Status switch { "active" => "bg-emerald-500", "disabled" => "bg-muted-foreground/40", "testing" => "bg-amber-500", _ => "bg-muted-foreground/40" };
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {dotColor}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-xs text-foreground">@rule.Source</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                <span class="truncate font-mono text-xs text-muted-foreground">@rule.Destination</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto shrink-0 text-[10px] px-1.5 py-0 tabular-nums">@rule.StatusCode</BadgeCn>
                            </div>
                            @if (!string.IsNullOrEmpty(rule.Note))
                            {
                                <p class="mt-0.5 text-xs text-muted-foreground">@rule.Note</p>
                            }
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span class="tabular-nums">Priority @rule.Priority</span>
                                <span>·</span>
                                <span class="tabular-nums">@rule.Hits.ToString("N0") hits</span>
                                <span>·</span>
                                <span>Last: @rule.LastHit</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn @onclick="@(() => HandleToggle(ruleItem.Id))">
                                    @(ruleItem.Status == "active" ? "Disable" : "Enable")
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>Test</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => HandleDelete(ruleItem.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No redirect rules found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class RedirectRule
    {
        public int Id { get; set; }
        public string Source { get; set; } = "";
        public string Destination { get; set; } = "";
        public int StatusCode { get; set; }
        public string Status { get; set; } = "active";
        public int Hits { get; set; }
        public string LastHit { get; set; } = "";
        public int Priority { get; set; }
        public string Note { get; set; } = "";
    }

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "active", "disabled", "testing"];

    private readonly List<RedirectRule> _rules = [
        new() { Id = 1, Source = "/blog/old-post-slug", Destination = "/blog/updated-post-slug", StatusCode = 301, Status = "active", Hits = 3420, LastHit = "2 min ago", Priority = 1, Note = "SEO migration - old blog URL structure" },
        new() { Id = 2, Source = "/docs/v1/*", Destination = "/docs/v2/$1", StatusCode = 301, Status = "active", Hits = 12800, LastHit = "30 sec ago", Priority = 2, Note = "Documentation v1 to v2 migration" },
        new() { Id = 3, Source = "/pricing-old", Destination = "/pricing", StatusCode = 301, Status = "active", Hits = 890, LastHit = "15 min ago", Priority = 3, Note = "Page rename after redesign" },
        new() { Id = 4, Source = "/temp-promo", Destination = "/deals/spring-2026", StatusCode = 302, Status = "active", Hits = 5600, LastHit = "1 min ago", Priority = 4, Note = "Temporary promotional redirect" },
        new() { Id = 5, Source = "/api/v1/users", Destination = "/api/v2/users", StatusCode = 308, Status = "testing", Hits = 45, LastHit = "5 min ago", Priority = 5, Note = "API migration - testing before full rollout" },
        new() { Id = 6, Source = "/legacy-dashboard", Destination = "/dashboard", StatusCode = 301, Status = "disabled", Hits = 2300, LastHit = "3 days ago", Priority = 6, Note = "Old dashboard URL - disabled after migration complete" },
    ];

    private IEnumerable<RedirectRule> Filtered =>
        _rules
            .Where(r => _filter == "all" || r.Status == _filter)
            .Where(r => r.Source.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        r.Destination.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleDelete(int id) => _rules.RemoveAll(r => r.Id == id);

    private void HandleToggle(int id)
    {
        var rule = _rules.FirstOrDefault(r => r.Id == id);
        if (rule is not null)
            rule.Status = rule.Status == "active" ? "disabled" : "active";
    }
}
