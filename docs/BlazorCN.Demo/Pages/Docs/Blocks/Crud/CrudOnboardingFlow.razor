@* ============================================================
   Block: crud-onboarding-flow
   Title: CrudOnboardingFlow
   Description: Onboarding flow editor with step management, content editing, completion tracking, and A/B testing
   Source: original/blocks/crud/crud-onboarding-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="play" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Onboarding Flows</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_flows.Count flows · @_flows.Count(f => f.Status == "active") active
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Flow
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search flows..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterVal = s;
                    <button type="button"
                            @onclick="@(() => _filter = filterVal)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(filterVal.Substring(0, 1).ToUpper() + filterVal.Substring(1))
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _flows
                    .Where(f => _filter == "all" || f.Status == _filter)
                    .Where(f => f.Name.ToLower().Contains(_search.ToLower()) || f.Trigger.ToLower().Contains(_search.ToLower()))
                    .ToList();
            }
            @if (filtered.Count == 0)
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No flows found
                </div>
            }
            else
            {
                @for (var i = 0; i < filtered.Count; i++)
                {
                    var flow = filtered[i];
                    var isLast = i == filtered.Count - 1;
                    <div class="@Cn.Merge("border-b px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "border-b-0" : "")">
                        <div class="flex items-start gap-3">
                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", _statusColors[flow.Status])"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@flow.Name</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                        @flow.Steps steps
                                    </BadgeCn>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">
                                    @flow.Description
                                </p>
                                <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                    <span>Trigger: @flow.Trigger</span>
                                    <span>·</span>
                                    <span class="tabular-nums">@flow.TotalUsers.ToString("N0") users</span>
                                    @if (flow.CompletionRate > 0)
                                    {
                                        <span>·</span>
                                        <span class="tabular-nums">@flow.CompletionRate% completion</span>
                                        <span>·</span>
                                        <span>Avg: @flow.AvgTime</span>
                                    }
                                </div>
                                @if (flow.CompletionRate > 0)
                                {
                                    <div class="mt-2 flex items-center gap-2">
                                        <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                            <div class="h-full rounded-full bg-foreground/20"
                                                 style="@($"width:{flow.CompletionRate}%")">
                                            </div>
                                        </div>
                                        <span class="text-xs font-medium tabular-nums">@flow.CompletionRate%</span>
                                    </div>
                                }
                            </div>
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn>
                                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                        <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                    </ButtonCn>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                    <DropdownMenuItemCn>Edit Flow</DropdownMenuItemCn>
                                    <DropdownMenuItemCn OnClick="@(() => HandleToggle(flow.Id))">
                                        @(flow.Status == "active" ? "Pause" : "Activate")
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                    <DropdownMenuItemCn>View Analytics</DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(flow.Id))">
                                        <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                        Delete
                                    </DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private class FlowItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Trigger { get; set; } = "";
        public string Status { get; set; } = "";
        public int Steps { get; set; }
        public int CompletionRate { get; set; }
        public int TotalUsers { get; set; }
        public string AvgTime { get; set; } = "";
        public string LastModified { get; set; } = "";
    }

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["active"]   = "bg-emerald-500",
        ["draft"]    = "bg-amber-500",
        ["paused"]   = "bg-blue-500",
        ["archived"] = "bg-muted-foreground/40",
    };

    private static readonly string[] _filterOptions = ["all", "active", "draft", "paused", "archived"];

    private string _search = "";
    private string _filter = "all";

    private readonly List<FlowItem> _flows =
    [
        new() { Id = 1, Name = "New User Welcome", Description = "Welcome flow for new signups with profile setup, team invite, and first project creation", Trigger = "On signup", Status = "active", Steps = 5, CompletionRate = 72, TotalUsers = 8450, AvgTime = "4 min 30s", LastModified = "Mar 22, 2026" },
        new() { Id = 2, Name = "Enterprise Onboarding", Description = "Guided setup for enterprise customers including SSO, team setup, and data import", Trigger = "On enterprise plan activation", Status = "active", Steps = 8, CompletionRate = 85, TotalUsers = 320, AvgTime = "12 min", LastModified = "Mar 20, 2026" },
        new() { Id = 3, Name = "Feature Discovery - Analytics", Description = "Introduce analytics dashboard features after first week of usage", Trigger = "7 days after signup", Status = "active", Steps = 3, CompletionRate = 45, TotalUsers = 5200, AvgTime = "2 min 15s", LastModified = "Mar 18, 2026" },
        new() { Id = 4, Name = "API Integration Guide", Description = "Step-by-step walkthrough for setting up API keys and making first API call", Trigger = "On API page visit", Status = "draft", Steps = 6, CompletionRate = 0, TotalUsers = 0, AvgTime = "—", LastModified = "Mar 24, 2026" },
        new() { Id = 5, Name = "Team Collaboration Setup", Description = "Guide for team admins to configure permissions, channels, and workflows", Trigger = "On team creation", Status = "paused", Steps = 4, CompletionRate = 62, TotalUsers = 1890, AvgTime = "5 min", LastModified = "Mar 10, 2026" },
        new() { Id = 6, Name = "Mobile App Intro (v1)", Description = "First-launch tour for the mobile app covering navigation and key features", Trigger = "On app install", Status = "archived", Steps = 4, CompletionRate = 58, TotalUsers = 12300, AvgTime = "1 min 45s", LastModified = "Feb 15, 2026" },
    ];

    private void HandleDelete(int id)
    {
        _flows.RemoveAll(f => f.Id == id);
    }

    private void HandleToggle(int id)
    {
        var flow = _flows.FirstOrDefault(f => f.Id == id);
        if (flow is not null)
        {
            flow.Status = flow.Status == "active" ? "paused" : "active";
        }
    }
}
