@* ============================================================
   Block: crud-note-organizer
   Title: CrudNoteOrganizer
   Description: Note taking and organizing with folders, tags, pinning, and full-text search
   Source: original/blocks/crud/crud-note-organizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideStickyNoteCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Notes</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_notes.Count notes · @_notes.Count(n => n.Pinned) pinned
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    New Note
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search notes..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" aria-label="Search notes" />
            </div>
            <div class="flex gap-1">
                <button type="button" @onclick="@(() => _filter = "all")"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "all" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                    All
                </button>
                @foreach (var folder in _folders)
                {
                    var f = folder;
                    <button type="button" @onclick="@(() => _filter = f)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == f ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @f
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var note in Filtered)
            {
                var n = note;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        @if (n.Pinned)
                        {
                            <LucidePinCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                        }
                        else
                        {
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@n.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">
                                    @n.Folder
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 line-clamp-2 text-xs text-muted-foreground">
                                @n.Preview
                            </p>
                            <div class="mt-2 flex flex-wrap items-center gap-1.5">
                                @foreach (var tag in n.Tags)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">@tag</span>
                                }
                                <span class="ml-1 text-xs text-muted-foreground">
                                    @n.WordCount words · @n.LastEdited
                                </span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                    <LucideEllipsisCn Size="16" Class="size-4" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn @onclick="@(() => TogglePin(n.Id))">
                                    @(n.Pinned ? "Unpin" : "Pin")
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>Move to Folder</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => DeleteNote(n.Id))">
                                    <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No notes found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class NoteItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Preview { get; set; } = "";
        public string Folder { get; set; } = "";
        public string[] Tags { get; set; } = [];
        public bool Pinned { get; set; }
        public int WordCount { get; set; }
        public string LastEdited { get; set; } = "";
    }

    private readonly List<NoteItem> _notes =
    [
        new() { Id = 1, Title = "Q1 Planning Meeting Notes", Preview = "Discussed roadmap priorities for Q1. Key decisions: focus on enterprise features, defer mobile to Q2. Action items assigned to...", Folder = "Meetings", Tags = ["planning", "q1"], Pinned = true, WordCount = 842, LastEdited = "Mar 24, 2026" },
        new() { Id = 2, Title = "Architecture Decision: Event Sourcing", Preview = "Evaluated event sourcing vs CRUD for the order service. Pros: audit trail, replay capability. Cons: complexity, storage costs...", Folder = "Engineering", Tags = ["architecture", "backend"], Pinned = true, WordCount = 1250, LastEdited = "Mar 22, 2026" },
        new() { Id = 3, Title = "Interview Questions - Senior Frontend", Preview = "Technical: React performance optimization, state management patterns, accessibility. System design: design a real-time dashboard...", Folder = "Hiring", Tags = ["interviews", "frontend"], Pinned = false, WordCount = 560, LastEdited = "Mar 20, 2026" },
        new() { Id = 4, Title = "API Rate Limiting Strategy", Preview = "Token bucket algorithm with per-user and per-IP limits. Tiers: free (100/min), pro (1000/min), enterprise (custom). Redis...", Folder = "Engineering", Tags = ["api", "infrastructure"], Pinned = false, WordCount = 920, LastEdited = "Mar 19, 2026" },
        new() { Id = 5, Title = "Customer Feedback Synthesis - March", Preview = "Top themes: search performance (mentioned 23x), mobile experience (18x), export capabilities (15x). NPS trend: 52 → 58...", Folder = "Product", Tags = ["feedback", "research"], Pinned = false, WordCount = 1580, LastEdited = "Mar 23, 2026" },
        new() { Id = 6, Title = "Onboarding Flow Improvements", Preview = "Current drop-off at step 3 (team invite): 34%. Proposed changes: skip option, async invite, progress indicator. A/B test plan...", Folder = "Product", Tags = ["onboarding", "conversion"], Pinned = false, WordCount = 670, LastEdited = "Mar 18, 2026" },
    ];

    private string _search = "";
    private string _filter = "all";

    private string[] _folders => _notes.Select(n => n.Folder).Distinct().ToArray();

    private IEnumerable<NoteItem> Filtered =>
        _notes
            .Where(n => _filter == "all" || n.Folder == _filter)
            .Where(n =>
                string.IsNullOrEmpty(_search) ||
                n.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                n.Preview.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(n => n.Pinned ? 0 : 1);

    private void DeleteNote(int id) => _notes.RemoveAll(n => n.Id == id);

    private void TogglePin(int id)
    {
        var note = _notes.Find(n => n.Id == id);
        if (note != null) note.Pinned = !note.Pinned;
    }
}
