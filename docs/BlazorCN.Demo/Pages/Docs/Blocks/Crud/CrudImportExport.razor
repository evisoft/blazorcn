@* ============================================================
   Block: crud-import-export
   Title: Crud Import Export
   Description: CRUD import/export interface with file upload, format selection, mapping configuration, export filters, and download options
   Dependencies: AlertCn, ButtonCn, CheckboxCn, LabelCn, ProgressCn, SelectCn, TabsCn
   Source: original/blocks/crud/crud-import-export.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Import &amp; Export</h2>
            <p class="mt-1 text-xs text-muted-foreground">Bulk import data or export your records for backup and analysis</p>
        </div>

        <div class="px-6 py-5">
            <TabsCn DefaultValue="import" Class="space-y-6">
                <TabsListCn Class="grid w-full max-w-md grid-cols-2">
                    <TabsTriggerCn Value="import">Import Data</TabsTriggerCn>
                    <TabsTriggerCn Value="export">Export Data</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="import" Class="space-y-6">
                    <div class="grid gap-6 lg:grid-cols-3">
                        <div class="space-y-6 lg:col-span-2">
                            <div class="border-b pb-4">
                                <h3 class="text-sm font-medium">Upload File</h3>
                            </div>

                            <div class="space-y-2">
                                <LabelCn>File Format</LabelCn>
                                <SelectCn Value="csv" ValueChanged="@((string _) => { })">
                                    <SelectTriggerCn>
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="csv">CSV File (.csv)</SelectItemCn>
                                        <SelectItemCn Value="excel">Excel File (.xlsx)</SelectItemCn>
                                        <SelectItemCn Value="json">JSON File (.json)</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            <div class="cursor-pointer rounded-lg border-2 border-dashed p-12 text-center transition-colors hover:border-primary">
                                <LucideUploadCn Class="mx-auto mb-4 h-12 w-12 text-muted-foreground" Size="48" />
                                <p class="mb-1 text-sm font-medium">Click to upload or drag and drop</p>
                                <p class="mb-4 text-xs text-muted-foreground">CSV, Excel, or JSON files up to 50MB</p>
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Select File</ButtonCn>
                            </div>

                            <AlertCn>
                                <LucideAlertCircleCn Class="h-4 w-4" Size="16" />
                                <AlertDescriptionCn>
                                    <strong>Before importing:</strong> Make sure your file includes headers and matches our
                                    <button type="button" class="underline">template format</button>.
                                </AlertDescriptionCn>
                            </AlertCn>

                            <ButtonCn Class="w-full" Disabled="true">
                                <LucideUploadCn Class="mr-2 h-4 w-4" Size="16" />
                                Import Data
                            </ButtonCn>
                        </div>

                        <div class="space-y-4">
                            <div class="border-b pb-4">
                                <h3 class="text-sm font-medium">Import Guide</h3>
                            </div>

                            <div class="space-y-2">
                                <span class="flex items-center gap-2 text-sm font-medium">
                                    <LucideFileTextCn Class="h-4 w-4" Size="16" />
                                    Template Files
                                </span>
                                <div class="space-y-1">
                                    <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">Download CSV Template</ButtonCn>
                                    <br />
                                    <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">Download Excel Template</ButtonCn>
                                </div>
                            </div>

                            <div class="space-y-2 border-t pt-4">
                                <span class="text-sm font-medium">Required Fields</span>
                                <ul class="space-y-1 text-xs text-muted-foreground">
                                    <li>Name (text)</li>
                                    <li>Email (valid email)</li>
                                    <li>Role (admin/user/guest)</li>
                                </ul>
                            </div>

                            <div class="space-y-2 border-t pt-4">
                                <span class="text-sm font-medium">Tips</span>
                                <ul class="space-y-1 text-xs text-muted-foreground">
                                    <li>First row must contain headers</li>
                                    <li>Date format: YYYY-MM-DD</li>
                                    <li>Max 10,000 rows per file</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="export" Class="space-y-6">
                    <div class="grid gap-6 lg:grid-cols-3">
                        <div class="space-y-6 lg:col-span-2">
                            <div class="border-b pb-4">
                                <h3 class="text-sm font-medium">Export Settings</h3>
                            </div>

                            <div class="space-y-2">
                                <LabelCn>Export Format</LabelCn>
                                <SelectCn Value="csv" ValueChanged="@((string _) => { })">
                                    <SelectTriggerCn>
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="csv">CSV File (.csv)</SelectItemCn>
                                        <SelectItemCn Value="excel">Excel File (.xlsx)</SelectItemCn>
                                        <SelectItemCn Value="json">JSON File (.json)</SelectItemCn>
                                        <SelectItemCn Value="pdf">PDF Report (.pdf)</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            <div class="space-y-3">
                                <LabelCn>Columns to Include</LabelCn>
                                <div class="grid grid-cols-2 gap-3">
                                    @foreach (var column in _exportColumnOptions)
                                    {
                                        <div class="flex items-center space-x-2">
                                            <CheckboxCn Checked="@_exportColumns.Contains(column.Id)"
                                                        CheckedChanged="@((bool _) => ToggleColumn(column.Id))"
                                                        id="@column.Id" />
                                            <LabelCn For="@column.Id" Class="cursor-pointer text-sm font-normal">@column.Label</LabelCn>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="space-y-2">
                                <LabelCn>Filter by Status</LabelCn>
                                <SelectCn Value="all" ValueChanged="@((string _) => { })">
                                    <SelectTriggerCn>
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="all">All Users (156)</SelectItemCn>
                                        <SelectItemCn Value="active">Active Only (132)</SelectItemCn>
                                        <SelectItemCn Value="inactive">Inactive Only (24)</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            <AlertCn>
                                <LucideAlertCircleCn Class="h-4 w-4" Size="16" />
                                <AlertDescriptionCn>
                                    This will export <strong>156 records</strong> with @_exportColumns.Count columns selected.
                                </AlertDescriptionCn>
                            </AlertCn>

                            <ButtonCn Class="w-full">
                                <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                                Export Data
                            </ButtonCn>
                        </div>

                        <div class="space-y-4">
                            <div class="border-b pb-4">
                                <h3 class="text-sm font-medium">Recent Exports</h3>
                            </div>

                            @foreach (var file in _recentExports)
                            {
                                <div class="space-y-1 rounded-md border p-3">
                                    <p class="text-sm font-medium">@file.Name</p>
                                    <div class="flex justify-between text-xs text-muted-foreground">
                                        <span>@file.Date</span>
                                        <span>@file.Size</span>
                                    </div>
                                    <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">Download Again</ButtonCn>
                                </div>
                            }
                        </div>
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record ColumnOption(string Id, string Label);
    private record RecentExport(string Name, string Date, string Size);

    private HashSet<string> _exportColumns = new(["name", "email", "role", "status"]);

    private void ToggleColumn(string column) { if (!_exportColumns.Remove(column)) _exportColumns.Add(column); }

    private static readonly ColumnOption[] _exportColumnOptions =
    [
        new("name", "Name"), new("email", "Email"), new("role", "Role"),
        new("status", "Status"), new("created", "Created Date"), new("lastActive", "Last Active"),
    ];

    private static readonly RecentExport[] _recentExports =
    [
        new("users_export.csv", "Today, 2:45 PM", "2.4 MB"),
        new("users_export.xlsx", "Yesterday", "3.1 MB"),
        new("users_filtered.csv", "Dec 10", "1.8 MB"),
    ];
}
