@* ============================================================
   Block: crud-draft-publish
   Title: Crud Draft Publish
   Description: Content management with multi-stage publishing workflow
   Long Description: Manage content lifecycle from draft to publication with a structured workflow system. Track review stages, collaborate with editors, and maintain version control across articles, pages, and products with confidence and transparency.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/crud/crud-draft-publish.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">Content Management</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    Create New
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex gap-1">
                @foreach (var tab in _tabs)
                {
                    <button
                        type="button"
                        @onclick="() => _selectedTab = tab"
                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs font-medium transition-colors", _selectedTab == tab ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        @tab
                        <span class="ml-1.5 text-xs text-muted-foreground">(@GetCount(tab))</span>
                    </button>
                }
            </div>
        </div>

        <div>
            @{ var filtered = GetFilteredItems(); }
            @if (filtered.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <p class="text-sm text-muted-foreground">No content in this status</p>
                </div>
            }
            else
            {
                <div>
                    @for (var i = 0; i < filtered.Count; i++)
                    {
                        var item = filtered[i];
                        var statusColor = GetStatusColor(item.Status);
                        var statusBadge = GetStatusBadge(item.Status);
                        var isLast = i == filtered.Count - 1;
                        <div class="@(isLast ? "" : "border-b")">
                            <div class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", statusColor)"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="mb-1 flex items-start justify-between gap-3">
                                        <span class="text-sm font-medium">@item.Title</span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 rounded-md px-1.5 text-xs">
                                            @item.Type
                                        </BadgeCn>
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-5 rounded-md px-1.5 text-xs {statusBadge}")">
                                            @item.Status
                                        </BadgeCn>
                                        <span class="text-xs text-muted-foreground">@item.Author</span>
                                        <span class="text-xs text-muted-foreground">•</span>
                                        <span class="text-xs text-muted-foreground">@item.LastEdited</span>
                                        @if (item.WordCount > 0)
                                        {
                                            <span class="text-xs text-muted-foreground">•</span>
                                            <span class="text-xs text-muted-foreground">@item.WordCount.ToString("N0") words</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _selectedTab = "All";
    private readonly string[] _tabs = ["All", "Draft", "Review", "Published"];

    private record ContentItem(string Id, string Title, string Type, string Status, string Author, string LastEdited, int WordCount = 0);

    private readonly List<ContentItem> _contentItems =
    [
        new("1", "Getting Started with React Server Components", "Article", "Review", "Alex Rivera", "2 hours ago", 2840),
        new("2", "Product Pricing Page Redesign", "Page", "Draft", "Sam Cooper", "5 hours ago"),
        new("3", "Enterprise Plan Features", "Product", "Published", "Jordan Lee", "Yesterday"),
        new("4", "API Authentication Best Practices", "Article", "Draft", "Alex Rivera", "Yesterday", 1520),
        new("5", "Customer Success Stories Landing", "Page", "Review", "Sam Cooper", "2 days ago"),
        new("6", "Premium Subscription Tier", "Product", "Published", "Jordan Lee", "3 days ago"),
        new("7", "Database Migration Guide", "Article", "Draft", "Taylor Kim", "4 days ago", 3200),
        new("8", "About Us Company Overview", "Page", "Published", "Sam Cooper", "1 week ago"),
    ];

    private int GetCount(string tab) => tab == "All"
        ? _contentItems.Count
        : _contentItems.Count(i => i.Status == tab);

    private List<ContentItem> GetFilteredItems() => _selectedTab == "All"
        ? _contentItems
        : _contentItems.Where(i => i.Status == _selectedTab).ToList();

    private static string GetStatusColor(string status) => status switch
    {
        "Draft" => "bg-zinc-400",
        "Review" => "bg-amber-500",
        "Published" => "bg-emerald-500",
        _ => "bg-muted",
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "Draft" => "text-zinc-700 bg-zinc-500/10",
        "Review" => "text-amber-700 bg-amber-500/10",
        "Published" => "text-emerald-700 bg-emerald-500/10",
        _ => "",
    };
}
