@* ============================================================
   Block: crud-data-table
   Title: Crud Data Table
   Description: CRUD data table with column sorting, row selection, filters, pagination, and bulk actions for managing tabular data
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, DropdownMenuCn, InputCn, SelectCn, TableCn
   Source: original/blocks/crud/crud-data-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <h2 class="text-sm font-medium">All Records (@_data.Length)</h2>
                    <p class="mt-1 text-xs text-muted-foreground">Manage records with sorting, filtering, and bulk actions</p>
                </div>
                <div class="flex flex-col gap-2 sm:flex-row">
                    <div class="relative flex-1 sm:w-64">
                        <LucideSearchCn Class="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" Size="16" />
                        <InputCn Class="border-0 bg-transparent pl-10 shadow-none focus-visible:ring-0"
                                 placeholder="Search records..." @bind-Value="_searchQuery" />
                    </div>
                    @if (_selected.Count > 0)
                    {
                        <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Destructive">
                            <LucideTrashCn Class="size-3.5" Size="14" />
                            Delete (@_selected.Count)
                        </ButtonCn>
                    }
                </div>
            </div>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="w-12">
                        <CheckboxCn Checked="@(_selected.Count == _data.Length)" CheckedChanged="@((bool _) => ToggleAll())" />
                    </TableHeadCn>
                    <TableHeadCn>
                        <button type="button" class="flex items-center gap-2 hover:text-foreground" @onclick="@(() => HandleSort("name"))">
                            Name
                            @if (_sortColumn == "name")
                            {
                                @if (_sortDirection == "asc")
                                {
                                    <LucideChevronUpCn Class="size-4" Size="16" />
                                }
                                else
                                {
                                    <LucideChevronDownCn Class="size-4" Size="16" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn>Email</TableHeadCn>
                    <TableHeadCn>
                        <button type="button" class="flex items-center gap-2 hover:text-foreground" @onclick="@(() => HandleSort("role"))">
                            Role
                            @if (_sortColumn == "role")
                            {
                                @if (_sortDirection == "asc")
                                {
                                    <LucideChevronUpCn Class="size-4" Size="16" />
                                }
                                else
                                {
                                    <LucideChevronDownCn Class="size-4" Size="16" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn>Status</TableHeadCn>
                    <TableHeadCn>Joined</TableHeadCn>
                    <TableHeadCn Class="w-12"></TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var item in _data)
                {
                    var statusColor = item.Status switch { "active" => "bg-emerald-500", "pending" => "bg-amber-500", _ => "bg-muted-foreground/40" };
                    <TableRowCn>
                        <TableCellCn>
                            <CheckboxCn Checked="@_selected.Contains(item.Id)" CheckedChanged="@((bool _) => ToggleRow(item.Id))" />
                        </TableCellCn>
                        <TableCellCn Class="text-sm font-medium">@item.Name</TableCellCn>
                        <TableCellCn Class="text-sm text-muted-foreground">@item.Email</TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Outline">@item.Role</BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 rounded-full", statusColor)"></span>
                                <span class="text-xs text-muted-foreground">@item.Status</span>
                            </span>
                        </TableCellCn>
                        <TableCellCn Class="text-xs text-muted-foreground">@item.Joined</TableCellCn>
                        <TableCellCn>
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn>
                                    <ButtonCn Class="size-7" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                                        <LucideEllipsisCn Class="size-4" Size="16" />
                                    </ButtonCn>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                    <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                    <DropdownMenuItemCn>View Details</DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-destructive">Delete</DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>

        <div class="flex flex-col items-center justify-between gap-4 border-t px-6 py-3 sm:flex-row">
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">Rows per page:</span>
                <SelectCn Value="@_pageSize" ValueChanged="@((string v) => _pageSize = v)">
                    <SelectTriggerCn Class="h-7 w-20 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="10">10</SelectItemCn>
                        <SelectItemCn Value="25">25</SelectItemCn>
                        <SelectItemCn Value="50">50</SelectItemCn>
                        <SelectItemCn Value="100">100</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">Showing 1-@_data.Length of @_data.Length</span>
                <div class="flex gap-1">
                    <ButtonCn Class="h-7 text-xs" Disabled="true" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Previous</ButtonCn>
                    <ButtonCn Class="h-7 text-xs" Disabled="true" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Next</ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record DataItem(int Id, string Name, string Email, string Role, string Status, string Joined);

    private HashSet<int> _selected = new();
    private string _sortColumn = "name";
    private string _sortDirection = "asc";
    private string _searchQuery = "";
    private string _pageSize = "10";

    private static readonly DataItem[] _data =
    [
        new(1, "Sarah Chen", "sarah@@example.com", "Admin", "active", "2024-01-15"),
        new(2, "Mike Johnson", "mike@@example.com", "Editor", "active", "2024-02-03"),
        new(3, "Emma Davis", "emma@@example.com", "Viewer", "inactive", "2024-01-28"),
        new(4, "David Lee", "david@@example.com", "Admin", "active", "2024-03-12"),
        new(5, "Alex Morgan", "alex@@example.com", "Editor", "active", "2024-02-20"),
        new(6, "Lisa Wang", "lisa@@example.com", "Viewer", "pending", "2024-03-05"),
        new(7, "Tom Brown", "tom@@example.com", "Editor", "active", "2024-01-10"),
        new(8, "Rachel Green", "rachel@@example.com", "Admin", "active", "2024-02-14"),
    ];

    private void ToggleAll()
    {
        if (_selected.Count == _data.Length) _selected.Clear();
        else { foreach (var d in _data) _selected.Add(d.Id); }
    }

    private void ToggleRow(int id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
    }

    private void HandleSort(string column)
    {
        if (_sortColumn == column)
            _sortDirection = _sortDirection == "asc" ? "desc" : "asc";
        else
        {
            _sortColumn = column;
            _sortDirection = "asc";
        }
    }
}
