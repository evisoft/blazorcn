@* ============================================================
   Block: crud-view-details
   Title: Crud View Details
   Description: CRUD detail view with tabs for overview, activity history, related items, and settings
   Dependencies: AvatarCn, BadgeCn, ButtonCn, DropdownMenuCn, TabsCn
   Source: original/blocks/crud/crud-view-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <ButtonCn Class="mb-3 h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                <LucideArrowLeftCn Class="size-3" Size="12" />
                Back to Products
            </ButtonCn>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-sm font-medium">Wireless Noise-Canceling Headphones</h2>
                        <BadgeCn Variant="BadgeVariant.Outline">Active</BadgeCn>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">Premium audio experience with industry-leading noise cancellation</p>
                </div>

                <div class="flex gap-2">
                    <ButtonCn Class="h-8 gap-1.5 text-xs" Size="ButtonSize.Sm">
                        <LucideSquarePenCn Class="size-3.5" Size="14" />
                        Edit
                    </ButtonCn>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-icon size-8" data-variant="outline" data-size="icon" aria-label="More options">
                                <LucideEllipsisCn Class="size-4" Size="16" />
                            </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuItemCn>
                                <LucideShare2Cn Class="mr-2 size-3.5" Size="14" />
                                Share
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                            <DropdownMenuItemCn>Export</DropdownMenuItemCn>
                            <DropdownMenuSeparatorCn />
                            <DropdownMenuItemCn Class="text-destructive">
                                <LucideTrash2Cn Class="mr-2 size-3.5" Size="14" />
                                Delete
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            </div>
        </div>

        <TabsCn DefaultValue="overview">
            <div class="border-b px-4">
                <TabsListCn Class="h-9 bg-transparent p-0">
                    <TabsTriggerCn Class="text-xs" Value="overview">Overview</TabsTriggerCn>
                    <TabsTriggerCn Class="text-xs" Value="activity">Activity</TabsTriggerCn>
                    <TabsTriggerCn Class="text-xs" Value="related">Related Items</TabsTriggerCn>
                    <TabsTriggerCn Class="text-xs" Value="settings">Settings</TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Class="mt-0" Value="overview">
                <div class="grid lg:grid-cols-3">
                    <div class="lg:col-span-2 lg:border-r">
                        <div class="border-b px-4 py-3">
                            <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                                <p class="text-xs text-muted-foreground">Product Image</p>
                            </div>
                        </div>

                        <div class="grid gap-0 sm:grid-cols-2">
                            <div class="border-b px-4 py-3 sm:border-r">
                                <p class="text-xs text-muted-foreground">SKU</p>
                                <p class="mt-0.5 font-mono text-xs">WH-1000XM5</p>
                            </div>
                            <div class="border-b px-4 py-3">
                                <p class="text-xs text-muted-foreground">Category</p>
                                <p class="mt-0.5 text-sm font-medium">Electronics</p>
                            </div>
                            <div class="border-b px-4 py-3 sm:border-r">
                                <p class="text-xs text-muted-foreground">Price</p>
                                <p class="mt-0.5 text-sm font-medium">$399.99</p>
                            </div>
                            <div class="border-b px-4 py-3">
                                <p class="text-xs text-muted-foreground">Stock</p>
                                <p class="mt-0.5 text-sm font-medium">156 units</p>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <p class="mb-1 text-xs text-muted-foreground">Description</p>
                            <p class="text-xs text-muted-foreground">
                                Experience legendary noise cancellation with our premium wireless headphones.
                                Featuring industry-leading technology, exceptional sound quality, and all-day
                                comfort. Perfect for travel, work, and everything in between.
                            </p>
                        </div>

                        <div class="px-4 py-3">
                            <p class="mb-1.5 text-xs text-muted-foreground">Features</p>
                            <ul class="space-y-1">
                                @foreach (var feature in _features)
                                {
                                    <li class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <span class="size-1 rounded-full bg-foreground"></span>
                                        @feature
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div>
                        <div class="border-b px-4 py-3">
                            <p class="mb-2 text-xs font-medium text-muted-foreground">Metadata</p>
                            <div class="space-y-2.5 text-xs">
                                <div>
                                    <p class="text-muted-foreground">Created</p>
                                    <p class="font-medium">Dec 10, 2024</p>
                                </div>
                                <div>
                                    <p class="text-muted-foreground">Last Modified</p>
                                    <p class="font-medium">Dec 14, 2024</p>
                                </div>
                                <div>
                                    <p class="text-muted-foreground">Created By</p>
                                    <p class="font-medium">Emma Davis</p>
                                </div>
                                <div>
                                    <p class="text-muted-foreground">Product ID</p>
                                    <p class="font-mono">prod_abc123xyz</p>
                                </div>
                            </div>
                        </div>

                        <div class="px-4 py-3">
                            <p class="mb-2 text-xs font-medium text-muted-foreground">Tags</p>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var tag in _tags)
                                {
                                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@tag</BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </TabsContentCn>

            <TabsContentCn Class="mt-0" Value="activity">
                <div class="px-4 py-3">
                    <p class="mb-3 text-xs font-medium text-muted-foreground">Activity Timeline</p>
                    <div class="space-y-4">
                        @foreach (var evt in _activity)
                        {
                            <div class="flex gap-3">
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn>@evt.User[0]</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="flex-1 space-y-0.5">
                                    <p class="text-xs">
                                        <span class="font-medium">@evt.User</span>
                                        <span class="text-muted-foreground"> @evt.Action</span>
                                    </p>
                                    <p class="text-xs text-muted-foreground">@evt.Time</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </TabsContentCn>

            <TabsContentCn Class="mt-0" Value="related">
                <div class="px-4 py-3">
                    <p class="mb-3 text-xs font-medium text-muted-foreground">Related Products</p>
                    <div class="space-y-0">
                        @foreach (var name in _relatedProducts)
                        {
                            <div class="flex items-center justify-between border-b py-2.5 last:border-b-0">
                                <div class="flex items-center gap-3">
                                    <div class="flex size-10 items-center justify-center rounded-md bg-muted/50">
                                        <span class="text-xs text-muted-foreground">IMG</span>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium">@name</p>
                                        <p class="text-xs text-muted-foreground">$299.99</p>
                                    </div>
                                </div>
                                <ButtonCn Class="h-7 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">View</ButtonCn>
                            </div>
                        }
                    </div>
                </div>
            </TabsContentCn>

            <TabsContentCn Class="mt-0" Value="settings">
                <div class="px-4 py-3">
                    <p class="text-xs text-muted-foreground">Configure product-specific settings and preferences</p>
                </div>
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record ActivityEvent(string User, string Action, string Time);

    private static readonly string[] _features = ["30-hour battery life", "Quick charge capability", "Multi-device pairing", "Touch sensor controls"];
    private static readonly string[] _tags = ["Wireless", "Audio", "Premium", "Bestseller"];
    private static readonly string[] _relatedProducts = ["Wireless Earbuds Pro", "Portable Speaker X", "USB-C Audio Adapter"];

    private static readonly ActivityEvent[] _activity =
    [
        new("Sarah Chen", "updated product details", "2 hours ago"),
        new("Mike Johnson", "changed status to Active", "1 day ago"),
        new("Emma Davis", "created this product", "3 days ago"),
    ];
}
