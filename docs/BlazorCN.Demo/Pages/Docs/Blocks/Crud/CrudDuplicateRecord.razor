                    <p class="mt-0.5 text-sm">$299.99</p>
                </div>
                <div class="sm:col-span-2">
                    <span class="text-xs font-medium text-muted-foreground">Description</span>
                    <p class="mt-0.5 text-sm text-muted-foreground">High-quality wireless headphones with noise cancellation</p>
                </div>
            </div>
        </div>

        <div class="px-6 py-4">
            <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline">
                <LucideCopyCn Size="14" Class="size-3.5" />
