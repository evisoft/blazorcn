<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-6 py-5">
            <div>
                <h2 class="text-sm font-medium">Premium Wireless Headphones</h2>
                <p class="mt-1 text-xs text-muted-foreground">SKU: WH-001</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline">active</BadgeCn>
