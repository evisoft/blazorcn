@* ============================================================
   Block: crud-address-book
   Title: CrudAddressBook
   Description: Contact address book with search, grouping by letter, and inline edit for managing personal and business contacts
   Source: original/blocks/crud/crud-address-book.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Address Book</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_contacts.Count contacts</p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs" OnClick="@(() => _showAdd = !_showAdd)">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Contact
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                    <InputCn Class="h-8 text-xs" Placeholder="Name" @bind-Value="_newName" aria-label="Name" />
                    <InputCn Class="h-8 text-xs" Placeholder="Email" @bind-Value="_newEmail" aria-label="Email" />
                    <InputCn Class="h-8 text-xs" Placeholder="Phone" @bind-Value="_newPhone" aria-label="Phone" />
                    <InputCn Class="h-8 text-xs" Placeholder="Company" @bind-Value="_newCompany" aria-label="Company" />
                    <InputCn Class="h-8 text-xs" Placeholder="City" @bind-Value="_newCity" aria-label="City" />
                    <div class="flex gap-1">
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs" OnClick="HandleAdd">Save</ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs" OnClick="@(() => _showAdd = false)">Cancel</ButtonCn>
                    </div>
                </div>
            </div>
        }

        <div class="border-b px-4 py-2">
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0" Placeholder="Search contacts..." @bind-Value="_search" aria-label="Search contacts" />
            </div>
        </div>

        <div class="max-h-[500px] overflow-y-auto">
            @{
                var filtered = _contacts.Where(c =>
                    c.Name.Contains(_search, System.StringComparison.OrdinalIgnoreCase) ||
                    c.Email.Contains(_search, System.StringComparison.OrdinalIgnoreCase) ||
                    c.Company.Contains(_search, System.StringComparison.OrdinalIgnoreCase)
                ).ToList();

                var grouped = filtered
                    .GroupBy(c => char.ToUpper(c.Name[0]))
                    .OrderBy(g => g.Key)
                    .ToList();
            }

            @foreach (var grp in grouped)
            {
                <div>
                    <div class="sticky top-0 z-10 border-b bg-muted/50 px-4 py-1.5">
                        <span class="text-xs font-medium text-muted-foreground">@grp.Key</span>
                    </div>
                    @foreach (var contact in grp)
                    {
                        var item = contact;
                        <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors hover:bg-muted/50">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                                <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                            @if (_editingId == item.Id && _editForm != null)
                            {
                                <div class="flex flex-1 flex-wrap gap-2">
                                    <InputCn Class="h-7 w-32 text-xs" @bind-Value="_editForm.Name" aria-label="Name" />
                                    <InputCn Class="h-7 w-40 text-xs" @bind-Value="_editForm.Email" aria-label="Email" />
                                    <InputCn Class="h-7 w-32 text-xs" @bind-Value="_editForm.Phone" aria-label="Phone" />
                                    <div class="flex gap-1">
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleSave">Save</ButtonCn>
                                        <ButtonCn aria-label="Cancel editing" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs" OnClick="@(() => { _editingId = null; _editForm = null; })">
                                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium">@item.Name</p>
                                    <p class="text-xs text-muted-foreground">@item.Company</p>
                                </div>
                                <div class="hidden items-center gap-4 sm:flex">
                                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                        <LucideIconCn Name="mail" Size="12" Class="size-3" />
                                        @item.Email
                                    </span>
                                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                        <LucideIconCn Name="phone" Size="12" Class="size-3" />
                                        @item.Phone
                                    </span>
                                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                        @item.City
                                    </span>
                                </div>
                                <div class="flex gap-1">
                                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7" OnClick="@(() => HandleEdit(item))" aria-label="Edit">
                                        <LucideIconCn Name="pencil" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 text-destructive" OnClick="@(() => HandleDelete(item.Id))" aria-label="Delete">
                                        <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (!grouped.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No contacts found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class Contact
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Company { get; set; } = "";
        public string City { get; set; } = "";

        public Contact Clone() => new()
        {
            Id = Id,
            Name = Name,
            Email = Email,
            Phone = Phone,
            Company = Company,
            City = City,
        };
    }

    private List<Contact> _contacts =
    [
        new() { Id = 1, Name = "Alice Chen",    Email = "alice@acme.com",     Phone = "+1 (555) 123-4567", Company = "Acme Corp",          City = "San Francisco" },
        new() { Id = 2, Name = "Bob Martinez",  Email = "bob@techstart.io",   Phone = "+1 (555) 234-5678", Company = "TechStart",          City = "Austin"        },
        new() { Id = 3, Name = "Clara Jensen",  Email = "clara@designco.com", Phone = "+1 (555) 345-6789", Company = "DesignCo",           City = "Portland"      },
        new() { Id = 4, Name = "David Kim",     Email = "david@globalent.com",Phone = "+1 (555) 456-7890", Company = "Global Enterprises", City = "New York"      },
        new() { Id = 5, Name = "Emma Wilson",   Email = "emma@startup.io",    Phone = "+1 (555) 567-8901", Company = "Startup Labs",       City = "Seattle"       },
        new() { Id = 6, Name = "Frank Liu",     Email = "frank@fintech.com",  Phone = "+1 (555) 678-9012", Company = "FinTech Inc",        City = "Chicago"       },
        new() { Id = 7, Name = "Grace Park",    Email = "grace@media.co",     Phone = "+1 (555) 789-0123", Company = "Media Group",        City = "Los Angeles"   },
        new() { Id = 8, Name = "Henry Nguyen",  Email = "henry@retail.com",   Phone = "+1 (555) 890-1234", Company = "Retail Corp",        City = "Miami"         },
    ];

    private string _search = "";
    private int? _editingId = null;
    private Contact? _editForm = null;
    private bool _showAdd = false;

    private string _newName = "";
    private string _newEmail = "";
    private string _newPhone = "";
    private string _newCompany = "";
    private string _newCity = "";

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        var newId = _contacts.Count > 0 ? _contacts.Max(c => c.Id) + 1 : 1;
        _contacts.Add(new Contact
        {
            Id = newId,
            Name = _newName,
            Email = _newEmail,
            Phone = _newPhone,
            Company = _newCompany,
            City = _newCity,
        });
        _newName = _newEmail = _newPhone = _newCompany = _newCity = "";
        _showAdd = false;
    }

    private void HandleDelete(int id)
    {
        _contacts.RemoveAll(c => c.Id == id);
    }

    private void HandleEdit(Contact contact)
    {
        _editingId = contact.Id;
        _editForm = contact.Clone();
    }

    private void HandleSave()
    {
        if (_editForm == null) return;
        var idx = _contacts.FindIndex(c => c.Id == _editForm.Id);
        if (idx >= 0) _contacts[idx] = _editForm;
        _editingId = null;
        _editForm = null;
    }
}
