@* ============================================================
   Block: crud-branch-manager
   Title: CrudBranchManager
   Description: Git branch management UI with status indicators, merge actions, and protection rules for repository administration
   Source: original/blocks/crud/crud-branch-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideGitBranchCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Branches</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_branches.Count branches &middot; @_branches.Count(b => b.IsProtected) protected
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    New Branch
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search branches..."
                         @bind-Value="_search" aria-label="Search branches" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterVal = s;
                    <button type="button" @onclick="@(() => _filter = filterVal)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(filterVal.Substring(0, 1).ToUpper() + filterVal.Substring(1))
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var branch in Filtered)
            {
                var br = branch;
                <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <span class="@($"size-1.5 shrink-0 rounded-full {StatusColor(br.Status)}")"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-mono text-sm font-medium">@br.Name</span>
                            @if (br.IsDefault)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">default</BadgeCn>
                            }
                            @if (br.IsProtected)
                            {
                                <LucideLockCn Size="12" Class="size-3 text-muted-foreground" />
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@br.LastCommit</span>
                            <span>&middot;</span>
                            <span>@br.Author</span>
                            <span>&middot;</span>
                            <span>@br.LastCommitDate</span>
                        </div>
                    </div>
                    <span class="hidden text-xs text-muted-foreground sm:inline">@br.AheadBehind</span>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                <LucideEllipsisCn Size="16" Class="size-4" />
                            </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            @if (br.Status == "active" && !br.IsDefault)
                            {
                                <DropdownMenuItemCn>Create Pull Request</DropdownMenuItemCn>
                            }
                            <DropdownMenuItemCn OnClick="@(() => ToggleProtect(br.Id))">
                                @(br.IsProtected ? "Remove Protection" : "Protect Branch")
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn>Compare</DropdownMenuItemCn>
                            @if (!br.IsDefault && !br.IsProtected)
                            {
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(br.Id))">
                                    <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            }
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No branches found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class Branch
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Author { get; set; } = "";
        public string LastCommit { get; set; } = "";
        public string LastCommitDate { get; set; } = "";
        public string AheadBehind { get; set; } = "";
        public string Status { get; set; } = "active";
        public bool IsProtected { get; set; }
        public bool IsDefault { get; set; }
    }

    private static readonly string[] _filterOptions = ["all", "active", "stale", "merged"];

    private List<Branch> _branches =
    [
        new() { Id = 1, Name = "main", Author = "Sarah Chen", LastCommit = "feat: add user dashboard", LastCommitDate = "2 hours ago", AheadBehind = "—", Status = "active", IsProtected = true, IsDefault = true },
        new() { Id = 2, Name = "develop", Author = "Mike Johnson", LastCommit = "merge: feature/auth into develop", LastCommitDate = "4 hours ago", AheadBehind = "3 ahead", Status = "active", IsProtected = true, IsDefault = false },
        new() { Id = 3, Name = "feature/payment-integration", Author = "Emma Davis", LastCommit = "feat: add Stripe checkout flow", LastCommitDate = "1 day ago", AheadBehind = "12 ahead, 2 behind", Status = "active", IsProtected = false, IsDefault = false },
        new() { Id = 4, Name = "feature/dark-mode", Author = "David Lee", LastCommit = "style: update theme tokens", LastCommitDate = "3 days ago", AheadBehind = "8 ahead, 5 behind", Status = "active", IsProtected = false, IsDefault = false },
        new() { Id = 5, Name = "fix/login-redirect", Author = "Alex Morgan", LastCommit = "fix: handle OAuth callback URL", LastCommitDate = "5 days ago", AheadBehind = "2 ahead", Status = "merged", IsProtected = false, IsDefault = false },
        new() { Id = 6, Name = "feature/old-dashboard", Author = "Lisa Wang", LastCommit = "wip: dashboard layout", LastCommitDate = "3 weeks ago", AheadBehind = "24 ahead, 47 behind", Status = "stale", IsProtected = false, IsDefault = false },
        new() { Id = 7, Name = "hotfix/api-rate-limit", Author = "Tom Brown", LastCommit = "fix: increase rate limit threshold", LastCommitDate = "1 week ago", AheadBehind = "1 ahead", Status = "merged", IsProtected = false, IsDefault = false },
        new() { Id = 8, Name = "release/v2.1.0", Author = "Sarah Chen", LastCommit = "chore: bump version to 2.1.0", LastCommitDate = "2 days ago", AheadBehind = "0 ahead, 1 behind", Status = "active", IsProtected = true, IsDefault = false },
    ];

    private string _search = "";
    private string _filter = "all";

    private IEnumerable<Branch> Filtered => _branches
        .Where(b => _filter == "all" || b.Status == _filter)
        .Where(b => b.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static string StatusColor(string status) => status switch
    {
        "active" => "bg-emerald-500",
        "stale" => "bg-amber-500",
        "merged" => "bg-purple-500",
        _ => "bg-muted",
    };

    private void HandleDelete(int id) => _branches.RemoveAll(b => b.Id == id);

    private void ToggleProtect(int id)
    {
        var branch = _branches.FirstOrDefault(b => b.Id == id);
        if (branch != null) branch.IsProtected = !branch.IsProtected;
    }
}
