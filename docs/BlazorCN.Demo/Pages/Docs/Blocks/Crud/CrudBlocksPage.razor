        public string Date { get; set; } = """";
        public string Priority { get; set; } = ""normal"";
        public bool Pinned { get; set; }
        public string Status { get; set; } = ""published"";
    }

    private readonly List<Announcement> _items =
    [
        new() { Id = 1, Title = ""System Maintenance Scheduled"", Body = ""Our servers will undergo maintenance on Saturday from 2:00 AM to 6:00 AM EST. Expect brief downtime."", Author = ""IT Operations"", Date = ""Mar 22, 2026"", Priority = ""urgent"", Pinned = true, Status = ""published"" },
        new() { Id = 2, Title = ""Q1 All-Hands Meeting"", Body = ""Join us for the quarterly all-hands this Friday at 3 PM in the main auditorium. Remote link will be shared via email."", Author = ""HR Team"", Date = ""Mar 20, 2026"", Priority = ""normal"", Pinned = true, Status = ""published"" },
        new() { Id = 3, Title = ""New PTO Policy Update"", Body = ""Starting April 1st, the updated PTO policy allows rollover of up to 5 unused days. Please review the full policy in the handbook."", Author = ""People Ops"", Date = ""Mar 18, 2026"", Priority = ""normal"", Pinned = false, Status = ""published"" },
        new() { Id = 4, Title = ""Office Kitchen Renovation"", Body = ""The 3rd floor kitchen will be closed for renovation next week. Please use the 2nd floor kitchen."", Author = ""Facilities"", Date = ""Mar 15, 2026"", Priority = ""low"", Pinned = false, Status = ""published"" },
        new() { Id = 5, Title = ""Security Training Reminder"", Body = ""Annual security awareness training is due by March 31st. Complete it in the learning portal."", Author = ""Security Team"", Date = ""Mar 12, 2026"", Priority = ""urgent"", Pinned = false, Status = ""draft"" },
    ];

    private bool _showAdd;
    private string _newTitle = """";
    private string _newBody = """";
    private string _filter = ""all"";

    private List<Announcement> GetFiltered()
    {
        var sorted = _items.OrderByDescending(a => a.Pinned).ToList();
        return _filter == ""all"" ? sorted : sorted.Where(a => a.Status == _filter).ToList();
    }

    private void HandleAdd(string status)
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;
        var newId = _items.Count > 0 ? _items.Max(i => i.Id) + 1 : 1;
        _items.Insert(0, new Announcement
        {
            Id = newId,
            Title = _newTitle,
            Body = _newBody,
            Author = ""You"",
            Date = ""Mar 24, 2026"",
            Priority = ""normal"",
            Pinned = false,
            Status = status,
        });
        _newTitle = """";
        _newBody = """";
        _showAdd = false;
    }

    private void TogglePin(int id)
    {
        var item = _items.Find(i => i.Id == id);
        if (item != null) item.Pinned = !item.Pinned;
    }

    private void HandleDelete(int id)
    {
        _items.RemoveAll(i => i.Id == id);
    }

    private static string GetPriorityColor(string priority) => priority switch
    {
        ""urgent"" => ""bg-red-500"",
        ""normal"" => ""bg-blue-500"",
        ""low"" => ""bg-muted-foreground/40"",
        _ => ""bg-muted-foreground/40"",
    };
}";

