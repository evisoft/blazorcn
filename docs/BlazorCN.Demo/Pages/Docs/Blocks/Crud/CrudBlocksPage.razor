    private readonly List<WidgetItem> _widgets =
    [
        new() { Id = ""revenue"", Name = ""Revenue Chart"", Description = ""Monthly revenue trends with year-over-year comparison"", Size = ""2x1"", Enabled = true, Category = ""Analytics"" },
        new() { Id = ""users"", Name = ""Active Users"", Description = ""Real-time active user count and session duration"", Size = ""1x1"", Enabled = true, Category = ""Analytics"" },
        new() { Id = ""orders"", Name = ""Recent Orders"", Description = ""Latest orders with status and fulfillment tracking"", Size = ""Full Width"", Enabled = true, Category = ""Sales"" },
        new() { Id = ""health"", Name = ""System Health"", Description = ""Server uptime, response time, and error rates"", Size = ""2x1"", Enabled = false, Category = ""Operations"" },
        new() { Id = ""tasks"", Name = ""Task Overview"", Description = ""Pending tasks, deadlines, and team assignments"", Size = ""1x1"", Enabled = true, Category = ""Productivity"" },
        new() { Id = ""notifications"", Name = ""Recent Notifications"", Description = ""System alerts and user activity notifications"", Size = ""1x1"", Enabled = false, Category = ""System"" },
        new() { Id = ""conversion"", Name = ""Conversion Funnel"", Description = ""User journey stages with drop-off analysis"", Size = ""Full Width"", Enabled = true, Category = ""Analytics"" },
        new() { Id = ""support"", Name = ""Support Tickets"", Description = ""Open tickets by priority and average response time"", Size = ""2x1"", Enabled = false, Category = ""Support"" },
    ];

    private void ToggleWidget(string id)
    {
        var w = _widgets.Find(x => x.Id == id);
        if (w != null) w.Enabled = !w.Enabled;
    }

    private void MoveWidget(int index, int direction)
    {
        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= _widgets.Count) return;
        (_widgets[index], _widgets[newIndex]) = (_widgets[newIndex], _widgets[index]);
    }

    private static string GetSizeColor(string size) => size switch
    {
        ""1x1"" => ""bg-blue-500/10 text-blue-700"",
        ""2x1"" => ""bg-purple-500/10 text-purple-700"",
        ""Full Width"" => ""bg-emerald-500/10 text-emerald-700"",
        _ => ""bg-muted text-muted-foreground"",
    };
}";
