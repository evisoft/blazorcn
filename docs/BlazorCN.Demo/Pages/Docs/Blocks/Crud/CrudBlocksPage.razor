    private record Asset(int Id, string Name, string Type, string Size, string[] Tags, string Uploaded, string Author);

    private static readonly string[] _filterTypes = [""all"", ""image"", ""document"", ""video""];

    private List<Asset> _assets = new List<Asset>
    {
        new(1, ""hero-banner.png"",       ""image"",    ""2.4 MB"",  [""marketing"", ""homepage""],  ""Mar 20, 2026"", ""Sarah Chen""),
        new(2, ""brand-guidelines.pdf"",  ""document"", ""8.1 MB"",  [""brand"", ""design""],         ""Mar 18, 2026"", ""Mike Johnson""),
        new(3, ""product-demo.mp4"",      ""video"",    ""156 MB"",  [""product"", ""demo""],         ""Mar 15, 2026"", ""Emma Davis""),
        new(4, ""team-photo.jpg"",        ""image"",    ""3.7 MB"",  [""team"", ""about""],           ""Mar 12, 2026"", ""David Lee""),
        new(5, ""api-docs.pdf"",          ""document"", ""1.2 MB"",  [""docs"", ""api""],             ""Mar 10, 2026"", ""Alex Morgan""),
        new(6, ""onboarding-video.mp4"",  ""video"",    ""89 MB"",   [""onboarding"", ""training""],  ""Mar 8, 2026"",  ""Lisa Wang""),
        new(7, ""logo-dark.svg"",         ""image"",    ""24 KB"",   [""brand"", ""logo""],           ""Mar 5, 2026"",  ""Sarah Chen""),
        new(8, ""quarterly-report.xlsx"", ""other"",    ""540 KB"",  [""finance"", ""report""],       ""Mar 3, 2026"",  ""Tom Brown""),
    };

    private string _search = """";
    private string _typeFilter = ""all"";
    private int? _editingId = null;
    private string _editName = """";

    private int _totalSize => _assets.Count;

    private IEnumerable<Asset> Filtered =>
        _assets
            .Where(a => _typeFilter == ""all"" || a.Type == _typeFilter)
            .Where(a => a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || a.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private void HandleDelete(int id)
    {
        _assets.RemoveAll(a => a.Id == id);
    }

    private void HandleRename(int id)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        var idx = _assets.FindIndex(a => a.Id == id);
        if (idx >= 0)
        {
            var old = _assets[idx];
            _assets[idx] = old with { Name = _editName };
        }
        _editingId = null;
    }
}
";

