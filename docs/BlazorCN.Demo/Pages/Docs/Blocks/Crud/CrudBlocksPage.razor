                                      @onclick=""@(() => _addingToSection = null)"">
                                Cancel
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class ChecklistItem
    {
        public int Id { get; set; }
        public string Text { get; set; } = """";
        public bool Completed { get; set; }
        public string Section { get; set; } = """";
    }

    private readonly List<ChecklistItem> _items =
    [
        new() { Id = 1,  Text = ""Create project repository"",          Completed = true,  Section = ""Setup"" },
        new() { Id = 2,  Text = ""Configure CI/CD pipeline"",           Completed = true,  Section = ""Setup"" },
        new() { Id = 3,  Text = ""Set up staging environment"",         Completed = false, Section = ""Setup"" },
        new() { Id = 4,  Text = ""Write unit tests for core modules"",  Completed = false, Section = ""Testing"" },
        new() { Id = 5,  Text = ""Run integration test suite"",         Completed = false, Section = ""Testing"" },
        new() { Id = 6,  Text = ""Perform load testing"",               Completed = false, Section = ""Testing"" },
        new() { Id = 7,  Text = ""Security audit review"",              Completed = false, Section = ""Testing"" },
        new() { Id = 8,  Text = ""Update API documentation"",           Completed = true,  Section = ""Documentation"" },
        new() { Id = 9,  Text = ""Write migration guide"",              Completed = false, Section = ""Documentation"" },
        new() { Id = 10, Text = ""Update changelog"",                   Completed = false, Section = ""Documentation"" },
        new() { Id = 11, Text = ""Tag release version"",                Completed = false, Section = ""Release"" },
        new() { Id = 12, Text = ""Deploy to production"",               Completed = false, Section = ""Release"" },
        new() { Id = 13, Text = ""Monitor error rates"",                Completed = false, Section = ""Release"" },
        new() { Id = 14, Text = ""Send launch announcement"",           Completed = false, Section = ""Release"" },
    ];

    // Ordered list of unique section names preserving insertion order
    private List<string> _sections => _items.Select(i => i.Section).Distinct().ToList();

    private string? _addingToSection = null;
    private string _newItemText = """";
    private int? _editingId = null;
    private string _editText = """";
    private int _nextId => _items.Count > 0 ? _items.Max(i => i.Id) + 1 : 1;

    private void ToggleItem(int id)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item is not null) item.Completed = !item.Completed;
    }

    private void ToggleAddingSection(string sec)
    {
        _addingToSection = _addingToSection == sec ? null : sec;
        _newItemText = """";
    }

    private void HandleAddItem(string sec)
    {
        if (string.IsNullOrWhiteSpace(_newItemText)) return;
        _items.Add(new ChecklistItem
        {
            Id = _nextId,
            Text = _newItemText.Trim(),
            Completed = false,
            Section = sec,
        });
        _newItemText = """";
        _addingToSection = null;
    }

    private void HandleDelete(int id)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item is not null) _items.Remove(item);
    }

    private void StartEdit(int id, string text)
    {
        _editingId = id;
        _editText = text;
    }

    private void HandleEdit(int id)
    {
        if (string.IsNullOrWhiteSpace(_editText)) return;
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item is not null) item.Text = _editText.Trim();
        _editingId = null;
    }
}";

