                    .Where(t => t.Name.ToLower().Contains(_search.ToLower()))
                    .ToList();
            }
            @foreach (var tmpl in filtered)
            {
                var template = tmpl;
                var statusColor = template.Status switch { ""active"" => ""bg-emerald-500"", ""draft"" => ""bg-amber-500"", _ => ""bg-muted-foreground/40"" };
                <div class=""border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50"">
                    <div class=""flex items-start gap-3"">
