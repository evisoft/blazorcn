    private class RedirectRule
    {
        public int Id { get; set; }
        public string Source { get; set; } = """";
        public string Destination { get; set; } = """";
        public int StatusCode { get; set; }
        public string Status { get; set; } = ""active"";
        public int Hits { get; set; }
        public string LastHit { get; set; } = """";
        public int Priority { get; set; }
        public string Note { get; set; } = """";
    }

    private string _search = """";
    private string _filter = ""all"";

    private static readonly string[] _filterOptions = [""all"", ""active"", ""disabled"", ""testing""];

    private readonly List<RedirectRule> _rules = [
        new() { Id = 1, Source = ""/blog/old-post-slug"", Destination = ""/blog/updated-post-slug"", StatusCode = 301, Status = ""active"", Hits = 3420, LastHit = ""2 min ago"", Priority = 1, Note = ""SEO migration - old blog URL structure"" },
        new() { Id = 2, Source = ""/docs/v1/*"", Destination = ""/docs/v2/$1"", StatusCode = 301, Status = ""active"", Hits = 12800, LastHit = ""30 sec ago"", Priority = 2, Note = ""Documentation v1 to v2 migration"" },
        new() { Id = 3, Source = ""/pricing-old"", Destination = ""/pricing"", StatusCode = 301, Status = ""active"", Hits = 890, LastHit = ""15 min ago"", Priority = 3, Note = ""Page rename after redesign"" },
        new() { Id = 4, Source = ""/temp-promo"", Destination = ""/deals/spring-2026"", StatusCode = 302, Status = ""active"", Hits = 5600, LastHit = ""1 min ago"", Priority = 4, Note = ""Temporary promotional redirect"" },
        new() { Id = 5, Source = ""/api/v1/users"", Destination = ""/api/v2/users"", StatusCode = 308, Status = ""testing"", Hits = 45, LastHit = ""5 min ago"", Priority = 5, Note = ""API migration - testing before full rollout"" },
        new() { Id = 6, Source = ""/legacy-dashboard"", Destination = ""/dashboard"", StatusCode = 301, Status = ""disabled"", Hits = 2300, LastHit = ""3 days ago"", Priority = 6, Note = ""Old dashboard URL - disabled after migration complete"" },
    ];

    private IEnumerable<RedirectRule> Filtered =>
        _rules
            .Where(r => _filter == ""all"" || r.Status == _filter)
            .Where(r => r.Source.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        r.Destination.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleDelete(int id) => _rules.RemoveAll(r => r.Id == id);

    private void HandleToggle(int id)
    {
        var rule = _rules.FirstOrDefault(r => r.Id == id);
        if (rule is not null)
            rule.Status = rule.Status == ""active"" ? ""disabled"" : ""active"";
    }
}";

