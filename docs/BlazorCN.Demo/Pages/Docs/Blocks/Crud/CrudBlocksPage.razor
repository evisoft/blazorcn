@code {
    private class CustomField
    {
        public int Id { get; set; }
        public string Label { get; set; } = """";
        public string FieldKey { get; set; } = """";
        public string Type { get; set; } = ""text"";
        public bool Required { get; set; }
        public string Placeholder { get; set; } = """";
        public string Options { get; set; } = """";
        public int Order { get; set; }
    }

    private static readonly Dictionary<string, string> _fieldTypeLabels = new()
    {
        [""text""] = ""Text"",
        [""number""] = ""Number"",
        [""dropdown""] = ""Dropdown"",
        [""checkbox""] = ""Checkbox"",
        [""date""] = ""Date"",
        [""textarea""] = ""Text Area"",
        [""email""] = ""Email"",
        [""url""] = ""URL"",
    };

    private readonly List<CustomField> _fields =
    [
        new() { Id = 1, Label = ""Company Size"", FieldKey = ""company_size"", Type = ""dropdown"", Required = true, Placeholder = """", Options = ""1-10, 11-50, 51-200, 201-500, 500+"", Order = 1 },
        new() { Id = 2, Label = ""Website URL"", FieldKey = ""website_url"", Type = ""url"", Required = false, Placeholder = ""https://example.com"", Options = """", Order = 2 },
        new() { Id = 3, Label = ""Annual Revenue"", FieldKey = ""annual_revenue"", Type = ""number"", Required = false, Placeholder = ""Enter amount"", Options = """", Order = 3 },
        new() { Id = 4, Label = ""Industry"", FieldKey = ""industry"", Type = ""dropdown"", Required = true, Placeholder = """", Options = ""Technology, Healthcare, Finance, Education, Retail, Other"", Order = 4 },
        new() { Id = 5, Label = ""Newsletter Opt-in"", FieldKey = ""newsletter_optin"", Type = ""checkbox"", Required = false, Placeholder = """", Options = """", Order = 5 },
        new() { Id = 6, Label = ""Start Date"", FieldKey = ""start_date"", Type = ""date"", Required = false, Placeholder = ""Select date"", Options = """", Order = 6 },
        new() { Id = 7, Label = ""Notes"", FieldKey = ""notes"", Type = ""textarea"", Required = false, Placeholder = ""Additional notes..."", Options = """", Order = 7 },
        new() { Id = 8, Label = ""Contact Email"", FieldKey = ""contact_email"", Type = ""email"", Required = true, Placeholder = ""name@@company.com"", Options = """", Order = 8 },
    ];

    private bool _showAdd;
    private string _newLabel = """";
    private string _newType = ""text"";
    private bool _newRequired;

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newLabel)) return;
        var id = _fields.Count > 0 ? _fields.Max(f => f.Id) + 1 : 1;
        var key = _newLabel.ToLowerInvariant().Replace("" "", ""_"");
        _fields.Add(new CustomField
        {
            Id = id,
            Label = _newLabel,
            FieldKey = key,
            Type = _newType,
            Required = _newRequired,
            Placeholder = """",
            Options = """",
            Order = _fields.Count + 1,
        });
        _newLabel = """";
        _newType = ""text"";
        _newRequired = false;
        _showAdd = false;
    }

    private void ToggleRequired(int id)
    {
        var f = _fields.FirstOrDefault(x => x.Id == id);
        if (f is not null) f.Required = !f.Required;
    }

    private void HandleDelete(int id) => _fields.RemoveAll(f => f.Id == id);
}";

