                <div class=""flex items-center gap-2"">
                    <div class=""h-1.5 w-24 overflow-hidden rounded-full bg-muted"">
                        <div class=""h-full rounded-full bg-emerald-500 transition-all""
                             style=""@($""width:{progressPct:F1}%"")"">
                        </div>
                    </div>
                    <span class=""text-xs font-medium tabular-nums"">@progressRounded%</span>
                </div>
            </div>
        </div>

        <div>
            @foreach (var sec in _sections)
            {
                var sectionName = sec;
                var sectionItems = _items.Where(i => i.Section == sectionName).ToList();
                var sectionCompleted = sectionItems.Count(i => i.Completed);
                <div>
                    <div class=""flex items-center justify-between border-b bg-muted/30 px-4 py-2"">
                        <div class=""flex items-center gap-2"">
                            <span class=""text-xs font-medium"">@sectionName</span>
                            <span class=""text-xs text-muted-foreground"">
                                (@sectionCompleted/@sectionItems.Count)
                            </span>
                        </div>
                        <ButtonCn aria-label=""@($""Add item to {sectionName}"")"" Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Ghost""
                                  Class=""h-6 gap-1 px-1.5 text-xs""
                                  @onclick=""@(() => ToggleAddingSection(sectionName))"">
                            <LucideIconCn Name=""plus"" Size=""12"" Class=""size-3"" />
                        </ButtonCn>
                    </div>
                    @foreach (var it in sectionItems)
                    {
                        var item = it;
                        <div class=""flex items-center gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50"">
                            <LucideIconCn Name=""grip-vertical"" Size=""14"" Class=""size-3.5 shrink-0 cursor-grab text-muted-foreground/40"" />
                            <span class=""flex flex-1 cursor-pointer items-center gap-3"">
                                <CheckboxCn Checked=""@item.Completed"" CheckedChanged=""@(_ => ToggleItem(item.Id))"" aria-label=""@item.Text"" />
                                @if (_editingId == item.Id)
                                {
                                    <div class=""flex flex-1 items-center gap-2"">
                                        <InputCn Class=""h-7 text-xs"" Value=""@_editText""
                                                 ValueChanged=""@((string v) => _editText = v)""
                                                 @onkeydown=""@((KeyboardEventArgs e) => { if (e.Key == ""Enter"") HandleEdit(item.Id); })"" aria-label=""Edit item"" />
                                        <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost""
                                                  Class=""size-6"" @onclick=""@(() => HandleEdit(item.Id))"" aria-label=""Confirm"">
                                            <LucideIconCn Name=""check"" Size=""14"" Class=""size-3.5"" />
                                        </ButtonCn>
                                        <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost""
                                                  Class=""size-6"" @onclick=""@(() => _editingId = null)"" aria-label=""Close"">
                                            <LucideIconCn Name=""x"" Size=""14"" Class=""size-3.5"" />
                                        </ButtonCn>
                                    </div>
                                }
                                else
                                {
                                    <span class=""@Cn.Merge(""flex-1 text-sm"", item.Completed ? ""text-muted-foreground line-through"" : """")"">
                                        @item.Text
