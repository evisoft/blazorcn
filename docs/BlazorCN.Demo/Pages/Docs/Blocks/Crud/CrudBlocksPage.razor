        new() { Id = 4, Title = ""SOC 2 Compliance"", Description = ""Complete SOC 2 Type II audit preparation and documentation"", Project = ""Security"", Status = ""delayed"", Progress = 35, Owner = ""Tom Bradley"", Tasks = 40, CompletedTasks = 14, Deadline = ""Apr 30, 2026"", Priority = ""high"" },
