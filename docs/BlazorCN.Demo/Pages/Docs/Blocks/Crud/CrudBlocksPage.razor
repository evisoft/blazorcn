@code {
    private class CommentItem
    {
        public string Id { get; set; } = """";
        public string Author { get; set; } = """";
        public string AuthorInitial { get; set; } = """";
        public string Timestamp { get; set; } = """";
        public string Text { get; set; } = """";
        public bool Pinned { get; set; }
        public List<CommentItem>? Replies { get; set; }
    }

    private string? _replyingTo;
    private string _replyText = """";
    private string _newCommentText = """";
    private int _nextId = 6;

    private readonly List<CommentItem> _comments =
    [
        new()
        {
            Id = ""1"", Author = ""Sarah Chen"", AuthorInitial = ""S"", Timestamp = ""2 hours ago"",
            Text = ""I'm seeing intermittent timeout errors when calling the /api/users endpoint during peak hours. Is this a known issue?"",
            Pinned = false,
            Replies =
            [
                new() { Id = ""2"", Author = ""Alex Kim"", AuthorInitial = ""A"", Timestamp = ""1 hour ago"", Text = ""We've identified the issue. The connection pool was exhausted due to a memory leak in the database driver. Deploying a fix now."", Pinned = false },
                new() { Id = ""3"", Author = ""Sarah Chen"", AuthorInitial = ""S"", Timestamp = ""45 min ago"", Text = ""Thanks for the quick response! Let me know when the fix is live so I can verify on our end."", Pinned = false },
            ]
        },
        new() { Id = ""4"", Author = ""Marcus Lee"", AuthorInitial = ""M"", Timestamp = ""3 hours ago"", Text = ""Resolved: Database connection pool settings have been optimized. Monitoring shows stable response times under load."", Pinned = true },
        new() { Id = ""5"", Author = ""Jordan Taylor"", AuthorInitial = ""J"", Timestamp = ""5 hours ago"", Text = ""Can we add rate limiting documentation to the API reference? Current docs don't mention the 100 req/min limit."", Pinned = false },
    ];

    private void AddComment()
    {
        if (string.IsNullOrWhiteSpace(_newCommentText)) return;
        _comments.Insert(0, new CommentItem
        {
            Id = (_nextId++).ToString(),
            Author = ""Current User"",
            AuthorInitial = ""C"",
            Timestamp = ""Just now"",
            Text = _newCommentText,
            Pinned = false,
        });
        _newCommentText = """";
    }

    private void AddReply(string parentId)
    {
        if (string.IsNullOrWhiteSpace(_replyText)) return;
        var reply = new CommentItem
        {
            Id = (_nextId++).ToString(),
            Author = ""Current User"",
            AuthorInitial = ""C"",
            Timestamp = ""Just now"",
            Text = _replyText,
            Pinned = false,
        };
        AddReplyToParent(_comments, parentId, reply);
        _replyText = """";
        _replyingTo = null;
    }

    private static bool AddReplyToParent(List<CommentItem> comments, string parentId, CommentItem reply)
    {
        foreach (var c in comments)
        {
            if (c.Id == parentId)
            {
                c.Replies ??= [];
                c.Replies.Add(reply);
                return true;
            }
            if (c.Replies != null && AddReplyToParent(c.Replies, parentId, reply)) return true;
        }
        return false;
    }

    private void DeleteComment(string id) { RemoveById(_comments, id); }

    private static bool RemoveById(List<CommentItem> comments, string id)
    {
        var removed = comments.RemoveAll(c => c.Id == id) > 0;
        if (!removed)
        {
            foreach (var c in comments)
            {
                if (c.Replies != null && RemoveById(c.Replies, id)) return true;
            }
        }
        return removed;
    }

    private void TogglePin(string id) { TogglePinRecursive(_comments, id); }

    private static bool TogglePinRecursive(List<CommentItem> comments, string id)
    {
        foreach (var c in comments)
        {
            if (c.Id == id) { c.Pinned = !c.Pinned; return true; }
            if (c.Replies != null && TogglePinRecursive(c.Replies, id)) return true;
        }
        return false;
    }

    private RenderFragment RenderComment(CommentItem comment, int level) => __builder =>
    {
        var isReplying = _replyingTo == comment.Id;

        <div class=""border-b px-4 py-3 transition-colors last:border-0 hover:bg-muted/50""
             style=""@($""padding-left: {level * 24 + 16}px"")"">
            <div class=""flex items-start gap-3"">
