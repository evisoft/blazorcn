                            @_templates.Count templates &middot; @(_templates.Sum(t => t.Clones).ToString(""N0"")) total clones
                        </p>
                    </div>
                </div>
                <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 gap-1 px-2 text-xs"">
                    <LucideIconCn Name=""plus"" Size=""14"" Class=""size-3.5"" />
                    New Template
                </ButtonCn>
            </div>
        </div>

        <div class=""flex items-center gap-2 border-b px-4 py-2"">
            <div class=""relative flex-1"">
                <LucideIconCn Name=""search"" Size=""14"" Class=""absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground"" />
                <InputCn type=""text"" Placeholder=""Search templates..."" @bind-Value=""_search"" Class=""h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"" aria-label=""Search templates"" />
            </div>
            <div class=""flex gap-1"">
                <button type=""button"" @onclick=""@(() => _filter = ""all"")""
                        class=""@Cn.Merge(""rounded-md px-2.5 py-1 text-xs font-medium transition-colors"", _filter == ""all"" ? ""bg-foreground text-background"" : ""text-muted-foreground hover:text-foreground"")"">
                    All
                </button>
                @foreach (var cat in _categories)
                {
                    var c = cat;
                    <button type=""button"" @onclick=""@(() => _filter = c)""
                            class=""@Cn.Merge(""rounded-md px-2.5 py-1 text-xs font-medium transition-colors"", _filter == c ? ""bg-foreground text-background"" : ""text-muted-foreground hover:text-foreground"")"">
                        @c
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _templates
                    .Where(t => _filter == ""all"" || t.Category == _filter)
                    .Where(t =>
                        t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        t.Tags.Any(tag => tag.Contains(_search, StringComparison.OrdinalIgnoreCase)))
                    .ToList();
            }
            @foreach (var tmpl in filtered)
            {
                var template = tmpl;
                <div class=""border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50"">
                    <div class=""flex items-start gap-3"">
                        <span class=""@Cn.Merge(""mt-1.5 size-1.5 shrink-0 rounded-full"", GetStatusColor(template.Status))""></span>
                        <div class=""min-w-0 flex-1"">
                            <div class=""flex items-center gap-2"">
                                <span class=""text-sm font-medium"">@template.Name</span>
                                <BadgeCn Variant=""BadgeVariant.Outline"" Class=""px-1.5 py-0 text-[10px]"">
                                    @template.Category
                                </BadgeCn>
                                <span class=""font-mono text-[10px] text-muted-foreground"">@template.Version</span>
                            </div>
                            <p class=""mt-0.5 line-clamp-1 text-xs text-muted-foreground"">@template.Description</p>
                            <div class=""mt-1.5 flex flex-wrap gap-1"">
                                @foreach (var tag in template.Tags)
                                {
                                    <span class=""rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground"">@tag</span>
                                }
                            </div>
                            <div class=""mt-1.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground"">
                                <span>@template.Creator</span>
                                <span>&middot;</span>
                                <span class=""tabular-nums"">@template.Clones.ToString(""N0"") clones</span>
                                <span>&middot;</span>
                                <span>Updated @template.LastUpdated</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0"" data-variant=""ghost"" data-size=""icon"" aria-label=""More options"">
                                    <LucideIconCn Name=""more-horizontal"" Size=""16"" Class=""size-4"" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align=""FloatingAlign.End"">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Preview</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Clone</DropdownMenuItemCn>
                                @if (template.Status == ""draft"")
                                {
                                    <DropdownMenuItemCn OnClick=""@(() => HandlePublish(template.Id))"">Publish</DropdownMenuItemCn>
                                }
                                @if (template.Status == ""published"")
                                {
                                    <DropdownMenuItemCn OnClick=""@(() => HandleArchive(template.Id))"">Archive</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class=""text-destructive"" OnClick=""@(() => HandleDelete(template.Id))"">
                                    <LucideIconCn Name=""trash"" Size=""16"" Class=""mr-2 size-4"" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!filtered.Any())
            {
                <div class=""px-4 py-8 text-center text-xs text-muted-foreground"">
                    No templates found
                </div>
            }
        </div>
    </div>
</section>

