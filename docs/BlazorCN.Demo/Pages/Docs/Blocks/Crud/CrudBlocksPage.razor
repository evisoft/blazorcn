        new() { Id = ""4"", Name = ""Guest"", UserCount = 28, Permissions = new() { [""Users""] = new(), [""Posts""] = new() { View = true }, [""Settings""] = new(), [""Billing""] = new() } },
    };

    private void AddRole()
    {
        if (string.IsNullOrWhiteSpace(_newRoleName)) return;
        var perms = new Dictionary<string, Permission>();
        foreach (var r in _resources) perms[r] = new Permission();
        _roles.Add(new Role { Id = $""role-{_roles.Count + 1}"", Name = _newRoleName, UserCount = 0, Permissions = perms });
        _newRoleName = """";
        _showAddRole = false;
    }

    private void DuplicateRole(Role source)
    {
        var perms = new Dictionary<string, Permission>();
        foreach (var (k, v) in source.Permissions)
            perms[k] = new Permission { View = v.View, Create = v.Create, Edit = v.Edit, CanDelete = v.CanDelete };
        _roles.Add(new Role { Id = $""dup-{_roles.Count + 1}"", Name = $""{source.Name} Copy"", UserCount = 0, Permissions = perms });
    }
}";

