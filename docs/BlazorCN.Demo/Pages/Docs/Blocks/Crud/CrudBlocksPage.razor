@code {
    private record Coupon(
        int Id,
        string Code,
        string Description,
        string DiscountType,
        int DiscountValue,
        int UsageCount,
        int UsageLimit,
        string ExpiresAt,
        bool Active,
        int MinOrderValue);

    private bool _showAdd;
    private string _newCode = """";
    private string _newDescription = """";
    private string _newDiscountValue = """";

    private List<Coupon> _coupons =
    [
        new(1, ""SPRING25"",  ""Spring sale 25% off"",        ""percentage"", 25, 342,  1000, ""Apr 30, 2026"", true,  50),
        new(2, ""WELCOME10"", ""New customer discount"",       ""percentage"", 10, 1567, 0,    ""Dec 31, 2026"", true,  0),
        new(3, ""FLAT20"",    ""$20 off any order"",           ""fixed"",      20, 89,   500,  ""May 15, 2026"", true,  100),
        new(4, ""VIP50"",     ""VIP exclusive 50% off"",       ""percentage"", 50, 23,   50,   ""Mar 31, 2026"", false, 200),
        new(5, ""FREESHIP"",  ""Free shipping on orders"",     ""fixed"",      15, 2340, 0,    ""Jun 30, 2026"", true,  75),
        new(6, ""LOYALTY15"", ""Loyalty program discount"",    ""percentage"", 15, 456,  2000, ""Dec 31, 2026"", true,  0),
    ];

    private void ToggleActive(int id)
    {
        var idx = _coupons.FindIndex(c => c.Id == id);
        if (idx >= 0)
        {
            var c = _coupons[idx];
            _coupons[idx] = c with { Active = !c.Active };
        }
    }

    private void HandleDelete(int id) => _coupons.RemoveAll(c => c.Id == id);

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newCode)) return;
        var newId = _coupons.Count > 0 ? _coupons.Max(c => c.Id) + 1 : 1;
        var discount = int.TryParse(_newDiscountValue, out var d) ? d : 10;
        _coupons.Add(new Coupon(
            newId,
            _newCode.ToUpperInvariant(),
            _newDescription,
            ""percentage"",
            discount,
            0,
            0,
            ""Dec 31, 2026"",
            true,
            0));
        _newCode = """";
        _newDescription = """";
        _newDiscountValue = """";
        _showAdd = false;
    }
}";

