@code {
    private class DnsRecord
    {
        public int Id { get; set; }
        public string Type { get; set; } = """";
        public string Name { get; set; } = """";
        public string Value { get; set; } = """";
        public int Ttl { get; set; }
        public int? Priority { get; set; }
    }

    private static readonly string[] _recordTypes = [""A"", ""AAAA"", ""CNAME"", ""MX"", ""TXT"", ""NS""];
    private static readonly string[] _filterOptions = [""all"", ""A"", ""AAAA"", ""CNAME"", ""MX"", ""TXT""];

    private static readonly Dictionary<string, string> _typeColors = new()
    {
        [""A""]     = ""bg-blue-500/10 text-blue-700 dark:text-blue-400"",
        [""AAAA""]  = ""bg-purple-500/10 text-purple-700 dark:text-purple-400"",
        [""CNAME""] = ""bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"",
        [""MX""]    = ""bg-amber-500/10 text-amber-700 dark:text-amber-400"",
        [""TXT""]   = ""bg-pink-500/10 text-pink-700 dark:text-pink-400"",
        [""NS""]    = ""bg-muted text-muted-foreground"",
    };

    private readonly List<DnsRecord> _records =
    [
        new() { Id = 1,  Type = ""A"",     Name = ""@"",     Value = ""76.76.21.21"",                            Ttl = 300   },
        new() { Id = 2,  Type = ""A"",     Name = ""www"",   Value = ""76.76.21.21"",                            Ttl = 300   },
        new() { Id = 3,  Type = ""CNAME"", Name = ""api"",   Value = ""api-gateway.example.com"",                Ttl = 3600  },
        new() { Id = 4,  Type = ""CNAME"", Name = ""docs"",  Value = ""docs.example.pages.dev"",                 Ttl = 3600  },
        new() { Id = 5,  Type = ""MX"",    Name = ""@"",     Value = ""mx1.example.com"",                        Ttl = 3600, Priority = 10 },
        new() { Id = 6,  Type = ""MX"",    Name = ""@"",     Value = ""mx2.example.com"",                        Ttl = 3600, Priority = 20 },
        new() { Id = 7,  Type = ""TXT"",   Name = ""@"",     Value = ""v=spf1 include:_spf.google.com ~all"",    Ttl = 3600  },
        new() { Id = 8,  Type = ""TXT"",   Name = ""_dmarc"",Value = ""v=DMARC1; p=quarantine; rua=mailto:dmarc@example.com"",  Ttl = 3600  },
        new() { Id = 9,  Type = ""AAAA"",  Name = ""@"",     Value = ""2606:4700:3030::6815:1"",                 Ttl = 300   },
        new() { Id = 10, Type = ""NS"",    Name = ""@"",     Value = ""ns1.example-dns.com"",                    Ttl = 86400 },
    ];

    private string _filter  = ""all"";
    private bool   _showAdd = false;
    private string _newType  = ""A"";
    private string _newName  = """";
    private string _newValue = """";
    private string _newTtl   = ""3600"";

    private static string FormatTtl(int ttl)
    {
        if (ttl >= 86400) return $""{ttl / 86400}d"";
        if (ttl >= 3600)  return $""{ttl / 3600}h"";
        return $""{ttl}s"";
    }

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newValue)) return;
        var id = _records.Count > 0 ? _records.Max(r => r.Id) + 1 : 1;
        _records.Add(new DnsRecord
        {
            Id    = id,
            Type  = _newType,
            Name  = _newName,
            Value = _newValue,
