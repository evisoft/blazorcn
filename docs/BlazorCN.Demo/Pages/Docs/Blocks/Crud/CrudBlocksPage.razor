    private readonly HashSet<string> _selected = [];

    private readonly List<BookmarkItem> _bookmarks =
    [
        new() { Id = ""1"", Title = ""Figma Component Library"", Url = ""https://figma.com/file/abc123"", Category = ""Design"", Saved = ""2 days ago"", Starred = true },
        new() { Id = ""2"", Title = ""React Best Practices 2026"", Url = ""https://react.dev/learn/best-practices"", Category = ""Dev"", Saved = ""1 week ago"", Starred = false },
        new() { Id = ""3"", Title = ""Content Marketing Guide"", Url = ""https://example.com/marketing-guide"", Category = ""Marketing"", Saved = ""3 days ago"", Starred = true },
        new() { Id = ""4"", Title = ""Tailwind CSS Documentation"", Url = ""https://tailwindcss.com/docs"", Category = ""Dev"", Saved = ""5 days ago"", Starred = false },
        new() { Id = ""5"", Title = ""Typography Inspiration"", Url = ""https://fonts.google.com/knowledge"", Category = ""Design"", Saved = ""1 week ago"", Starred = false },
        new() { Id = ""6"", Title = ""SEO Checklist 2026"", Url = ""https://example.com/seo-checklist"", Category = ""Marketing"", Saved = ""4 days ago"", Starred = true },
    ];

    private List<BookmarkItem> _filteredBookmarks => _bookmarks.Where(b =>
        string.IsNullOrEmpty(_searchQuery) ||
        b.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
        b.Url.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    private void ToggleStar(string id)
    {
        var b = _bookmarks.Find(x => x.Id == id);
        if (b != null) b.Starred = !b.Starred;
    }

    private void ToggleSelect(string id) { if (!_selected.Remove(id)) _selected.Add(id); }

    private void ToggleSelectAll()
    {
        var filtered = _filteredBookmarks;
        if (_selected.Count == filtered.Count) _selected.Clear();
        else foreach (var b in filtered) _selected.Add(b.Id);
    }

    private void DeleteSelected()
    {
        _bookmarks.RemoveAll(b => _selected.Contains(b.Id));
        _selected.Clear();
    }

    private static string GetCategoryColor(string category) => category switch
    {
        ""Design"" => ""bg-purple-500/10 text-purple-700 dark:text-purple-400"",
        ""Dev"" => ""bg-blue-500/10 text-blue-700 dark:text-blue-400"",
        ""Marketing"" => ""bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"",
        _ => ""bg-muted text-muted-foreground"",
    };
}";

