    private string _filter = ""all"";

    private List<Subscription> _subscriptions = new(InitialData);

    private IEnumerable<Subscription> _filtered => _subscriptions
        .Where(s => _filter == ""all"" || s.Status == _filter)
        .Where(s => s.Customer.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || s.Plan.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private int _totalMRR => _subscriptions.Where(s => s.Status == ""active"").Sum(s => s.Mrr);

