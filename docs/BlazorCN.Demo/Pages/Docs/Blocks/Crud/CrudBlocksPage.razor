            Author = ""Tom Bradley"", Email = ""tom@example.com"", Sentiment = ""neutral"", Category = ""UI/UX"", Status = ""new"", Date = ""Mar 24, 2026"", Votes = 31 },
    ];

    private string _search = """";
    private string _filter = ""all"";

    private IEnumerable<FeedbackItem> Filtered =>
        _items
            .Where(f => _filter == ""all"" || f.Status == _filter)
            .Where(f => f.Title.ToLower().Contains(_search.ToLower()) || f.Author.ToLower().Contains(_search.ToLower()));

    private void HandleDelete(int id)
    {
        _items = _items.Where(f => f.Id != id).ToArray();
    }

    private void HandleStatusChange(int id, string status)
    {
        foreach (var item in _items)
        {
            if (item.Id == id)
