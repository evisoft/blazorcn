    private const string CrudActivityFeedCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div>
                <h2 class=""text-sm font-medium"">Activity Feed</h2>
                <p class=""mt-0.5 text-xs text-muted-foreground"">
                    Track changes across your workspace
                </p>
            </div>
            <div class=""flex items-center gap-2"">
                <SelectCn Value=""all"">
                    <SelectTriggerCn Class=""h-7 w-28 text-xs"">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value=""all"">All Types</SelectItemCn>
                        <SelectItemCn Value=""edit"">Edits</SelectItemCn>
                        <SelectItemCn Value=""create"">Created</SelectItemCn>
                        <SelectItemCn Value=""delete"">Deleted</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                <SelectCn>
                    <SelectTriggerCn Class=""h-7 w-28 text-xs"">
                        <SelectValueCn Placeholder=""All users"" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value=""all"">All Users</SelectItemCn>
                        <SelectItemCn Value=""sarah"">Sarah Chen</SelectItemCn>
                        <SelectItemCn Value=""mike"">Mike Johnson</SelectItemCn>
                        <SelectItemCn Value=""emma"">Emma Davis</SelectItemCn>
                        <SelectItemCn Value=""david"">David Lee</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Today *@
        <div>
            <div class=""border-b bg-muted/30 px-4 py-1.5"">
                <span class=""text-xs font-medium text-muted-foreground"">Today</span>
            </div>
            @for (var i = 0; i < 3 && i < _activities.Length; i++)
            {
                var activity = _activities[i];
                var showLine = i < 2;
                <div class=""flex gap-3 px-4 py-3"">
                    <div class=""relative flex flex-col items-center"">
                        @if (!string.IsNullOrEmpty(activity.Avatar))
                        {
                            <AvatarCn Class=""size-8"">
                                <AvatarImageCn Alt=""@activity.UserName"" Src=""@activity.Avatar"" />
                                <AvatarFallbackCn>@activity.UserName[0]</AvatarFallbackCn>
                            </AvatarCn>
                        }
