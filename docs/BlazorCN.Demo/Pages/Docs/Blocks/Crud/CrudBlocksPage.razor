    private class CategoryItem
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public int ItemCount { get; set; }
        public string Status { get; set; } = ""active"";
        public List<CategoryItem>? Children { get; set; }
    }

    private readonly HashSet<string> _expanded = [""1"", ""2"", ""10"", ""14""];
    private string _newCategoryName = """";

    private readonly List<CategoryItem> _categories =
    [
        new() { Id = ""1"", Name = ""Electronics"", ItemCount = 342, Status = ""active"", Children =
        [
            new() { Id = ""2"", Name = ""Computers"", ItemCount = 128, Status = ""active"", Children =
            [
                new() { Id = ""3"", Name = ""Laptops"", ItemCount = 64, Status = ""active"" },
                new() { Id = ""4"", Name = ""Desktops"", ItemCount = 32, Status = ""active"" },
                new() { Id = ""5"", Name = ""Accessories"", ItemCount = 32, Status = ""draft"" },
            ]},
            new() { Id = ""6"", Name = ""Mobile Devices"", ItemCount = 94, Status = ""active"", Children =
            [
                new() { Id = ""7"", Name = ""Smartphones"", ItemCount = 72, Status = ""active"" },
                new() { Id = ""8"", Name = ""Tablets"", ItemCount = 22, Status = ""active"" },
            ]},
            new() { Id = ""9"", Name = ""Audio"", ItemCount = 120, Status = ""active"" },
        ]},
        new() { Id = ""10"", Name = ""Clothing"", ItemCount = 856, Status = ""active"", Children =
        [
            new() { Id = ""11"", Name = ""Men"", ItemCount = 312, Status = ""active"" },
            new() { Id = ""12"", Name = ""Women"", ItemCount = 428, Status = ""active"" },
            new() { Id = ""13"", Name = ""Kids"", ItemCount = 116, Status = ""draft"" },
        ]},
        new() { Id = ""14"", Name = ""Home & Garden"", ItemCount = 524, Status = ""active"", Children =
        [
            new() { Id = ""15"", Name = ""Furniture"", ItemCount = 243, Status = ""active"" },
            new() { Id = ""16"", Name = ""Decor"", ItemCount = 281, Status = ""active"" },
        ]},
    ];

    private void ToggleExpand(string id) { if (!_expanded.Remove(id)) _expanded.Add(id); }

    private void AddRootCategory()
    {
        if (string.IsNullOrWhiteSpace(_newCategoryName)) return;
        _categories.Add(new CategoryItem { Id = $""cat-{_categories.Count + 20}"", Name = _newCategoryName, ItemCount = 0, Status = ""draft"" });
        _newCategoryName = """";
    }

    private void DeleteCategory(string id)
    {
        RemoveById(_categories, id);
    }

    private static bool RemoveById(List<CategoryItem> cats, string id)
    {
        var removed = cats.RemoveAll(c => c.Id == id) > 0;
        if (!removed)
        {
            foreach (var cat in cats)
            {
                if (cat.Children != null && RemoveById(cat.Children, id)) return true;
            }
        }
        return removed;
    }

    private RenderFragment RenderCategory(CategoryItem cat, int level) => __builder =>
    {
        var hasChildren = cat.Children != null && cat.Children.Count > 0;
        var isExpanded = _expanded.Contains(cat.Id);

        <div class=""flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-0 hover:bg-muted/50""
             style=""@($""padding-left: {level * 24 + 16}px"")"">
            <button type=""button"" class=""shrink-0"" disabled=""@(!hasChildren)""
                    @onclick=""@(() => ToggleExpand(cat.Id))"">
                @if (hasChildren)
                {
                    <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""size-4 text-muted-foreground transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                }
                else
                {
                    <span class=""inline-block size-4""></span>
                }
            </button>
            <span class=""@Cn.Merge(""size-1.5 shrink-0 rounded-full"", cat.Status == ""active"" ? ""bg-emerald-500"" : ""bg-muted"")""></span>
            <div class=""min-w-0 flex-1"">
                <div class=""flex items-center gap-2"">
                    <span class=""font-medium text-sm"">@cat.Name</span>
                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""text-xs"">
                        @cat.ItemCount
                    </BadgeCn>
                </div>
            </div>
            <div class=""flex shrink-0 items-center gap-1"">
                <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-6 gap-1 px-2 text-xs"">
                    <LucidePlusCn Size=""12"" Class=""size-3"" />
                    Add child
                </ButtonCn>
                <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""size-6 p-0"">
                    <LucideEdit2Cn Size=""12"" Class=""size-3 text-muted-foreground"" />
                </ButtonCn>
                <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""size-6 p-0""
                          @onclick=""@(() => DeleteCategory(cat.Id))"">
                    <LucideTrash2Cn Size=""12"" Class=""size-3 text-muted-foreground"" />
                </ButtonCn>
            </div>
        </div>

        @if (isExpanded && hasChildren)
        {
