    private void HandleDelete(int id)
    {
        _templates = _templates.Where(t => t.Id != id).ToList();
    }

    private void HandlePublish(int id)
    {
        _templates = _templates.Select(t => t.Id == id ? t with { Status = ""published"" } : t).ToList();
    }

    private void HandleArchive(int id)
    {
        _templates = _templates.Select(t => t.Id == id ? t with { Status = ""archived"" } : t).ToList();
    }
}";

