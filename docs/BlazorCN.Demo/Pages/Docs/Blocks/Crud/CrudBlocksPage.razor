        new() { Id = 11, Name = ""Border"",         Hex = ""#E2E8F0"", Group = ""Neutral""  },
        new() { Id = 12, Name = ""Muted"",          Hex = ""#94A3B8"", Group = ""Neutral""  },
    ];

    private int? _copiedId;
    private int? _editingId;
    private string _editName = """";
    private string _editHex = """";
    private bool _showAdd;
    private string _newName = """";
    private string _newHex = ""#000000"";
    private string _newGroup = ""Brand"";

    private IEnumerable<string> Groups => _colors.Select(c => c.Group).Distinct();

    private void HandleCopy(int id, string hex)
    {
        _copiedId = id;
        // Note: clipboard API is not invoked here to keep the demo self-contained
        // In production, inject IJSRuntime and call navigator.clipboard.writeText(hex)
    }

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        var nextId = _colors.Count > 0 ? _colors.Max(c => c.Id) + 1 : 1;
        _colors.Add(new ColorItem { Id = nextId, Name = _newName, Hex = _newHex, Group = _newGroup });
        _newName = """";
        _newHex = ""#000000"";
        _newGroup = ""Brand"";
        _showAdd = false;
    }

    private void HandleEdit(ColorItem color)
    {
        _editingId = color.Id;
        _editName = color.Name;
        _editHex = color.Hex;
    }

    private void HandleSave(int id)
    {
        var item = _colors.FirstOrDefault(c => c.Id == id);
        if (item != null)
        {
            item.Name = _editName;
            item.Hex = _editHex;
        }
        _editingId = null;
    }

    private void HandleDelete(int id)
    {
        var item = _colors.FirstOrDefault(c => c.Id == id);
        if (item != null) _colors.Remove(item);
    }
}
