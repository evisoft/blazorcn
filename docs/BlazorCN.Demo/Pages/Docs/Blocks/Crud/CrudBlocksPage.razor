                    <InputCn type=""text"" Placeholder=""Search content or author..."" Value=""@_searchQuery"" Class=""h-8 pl-8 text-xs"" />
                </div>
                <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-8 gap-1.5 text-xs"">
                    <LucideFilterCn Size=""14"" Class=""size-3.5"" />
                    Filter
                </ButtonCn>
            </div>

            <div class=""flex flex-wrap gap-2"">
                @foreach (var platform in _platforms)
                {
                    <button type=""button""
                            @onclick=""@(() => _selectedPlatform = platform)""
                            class=""@Cn.Merge(""rounded-md px-2.5 py-1 text-xs font-medium transition-colors"", _selectedPlatform == platform ? ""bg-foreground text-background"" : ""bg-muted/50 text-muted-foreground hover:bg-muted"")"">
                        @platform
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filteredContent = _contentItems.Where(item =>
                    (_selectedPlatform == ""All"" || item.Platform == _selectedPlatform) &&
                    (string.IsNullOrEmpty(_searchQuery) ||
                     item.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     item.Author.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
            }
            @if (filteredContent.Count == 0)
            {
                <div class=""px-4 py-12 text-center"">
                    <p class=""text-sm text-muted-foreground"">No content found matching your filters</p>
                </div>
            }
            else
            {
                <div>
                    @for (var i = 0; i < filteredContent.Count; i++)
                    {
                        var item = filteredContent[i];
                        var isLast = i == filteredContent.Count - 1;
                        <button type=""button""
                                class=""@Cn.Merge(""flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"", !isLast ? ""border-b"" : """")"">
