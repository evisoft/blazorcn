                            </span>
                        }
                    </div>
                </div>
                <div class=""flex shrink-0 items-center gap-1"">
                    <ButtonCn aria-label=""@($""Pin comment by {comment.Author}"")"" Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""size-6 p-0""
                              @onclick=""@(() => TogglePin(comment.Id))"">
                        <LucidePinCn Size=""12"" Class=""@Cn.Merge(""size-3"", comment.Pinned ? ""fill-amber-500 text-amber-500"" : ""text-muted-foreground"")"" />
                    </ButtonCn>
                    <ButtonCn aria-label=""@($""Edit comment by {comment.Author}"")"" Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""size-6 p-0"">
                        <LucideSquarePenCn Size=""12"" Class=""size-3 text-muted-foreground"" />
                    </ButtonCn>
                    <ButtonCn aria-label=""@($""Delete comment by {comment.Author}"")"" Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""size-6 p-0""
                              @onclick=""@(() => DeleteComment(comment.Id))"">
                        <LucideTrash2Cn Size=""12"" Class=""size-3 text-muted-foreground"" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @if (isReplying)
        {
            <div class=""border-b bg-muted/50 px-4 py-3""
                 style=""@($""padding-left: {(level + 1) * 24 + 16}px"")"">
                <TextareaCn Placeholder=""Write a reply...""
                            Value=""@_replyText""
                            Class=""min-h-20 resize-none border-0 bg-background shadow-none focus-visible:ring-0"" aria-label=""Write a reply"" />
                <div class=""mt-2 flex items-center gap-2"">
                    <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm""
                              Disabled=""@string.IsNullOrWhiteSpace(_replyText)""
