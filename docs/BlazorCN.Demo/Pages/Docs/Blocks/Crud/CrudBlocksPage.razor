            </div>
            <DialogFooterCn>
                <ButtonCn Variant=""ButtonVariant.Outline"" @onclick=""@(() => _showDialog = false)"">Cancel</ButtonCn>
                <ButtonCn Variant=""@(_targetStatus == ""rejected"" ? ButtonVariant.Destructive : ButtonVariant.Default)""
                          Disabled=""@(_targetStatus == ""rejected"" && string.IsNullOrWhiteSpace(_notes))""
                          @onclick=""HandleTransition"">
                    Confirm
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private class HistoryEntry
    {
        public string Status { get; set; } = """";
        public string User { get; set; } = """";
        public string Timestamp { get; set; } = """";
        public string? Notes { get; set; }
    }

    private string _currentStatus = ""approved"";
    private string _notes = """";
    private bool _showDialog;
    private string _targetStatus = """";

    private readonly List<HistoryEntry> _history =
    [
        new() { Status = ""draft"", User = ""Sarah Chen"", Timestamp = ""Mar 10, 2024 at 9:00 AM"", Notes = ""Initial draft created"" },
        new() { Status = ""review"", User = ""Sarah Chen"", Timestamp = ""Mar 12, 2024 at 2:30 PM"", Notes = ""Submitted for review"" },
        new() { Status = ""approved"", User = ""Mike Johnson"", Timestamp = ""Mar 13, 2024 at 10:15 AM"", Notes = ""Looks good, approved for publishing"" },
    ];

    private void HandleTransition()
    {
        if (string.IsNullOrEmpty(_targetStatus)) return;
        _history.Add(new HistoryEntry
        {
            Status = _targetStatus,
            User = ""Current User"",
            Timestamp = ""Just now"",
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes,
        });
        _currentStatus = _targetStatus;
        _notes = """";
        _showDialog = false;
        _targetStatus = """";
    }

    private static string GetStatusLabel(string status) => status switch
    {
        ""draft"" => ""Draft"",
        ""review"" => ""In Review"",
        ""approved"" => ""Approved"",
        ""published"" => ""Published"",
        ""rejected"" => ""Rejected"",
        _ => status,
    };

    private static string GetTransitionLabel(string status) => status switch
    {
        ""review"" => ""Submit for Review"",
        ""approved"" => ""Approve"",
        ""published"" => ""Publish"",
        ""rejected"" => ""Reject"",
        ""draft"" => ""Move to Draft"",
        _ => status,
    };

    private static string GetTransitionDescription(string status) => status switch
    {
        ""published"" => ""This will make the post visible to all users."",
        ""review"" => ""This will notify reviewers to check the content."",
        ""approved"" => ""This will approve the post for publishing."",
        ""rejected"" => ""This will send the post back to draft."",
        ""draft"" => ""This will move the post back to draft status."",
