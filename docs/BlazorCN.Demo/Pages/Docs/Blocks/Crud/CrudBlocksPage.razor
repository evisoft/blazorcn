                                <div class=""flex gap-1"">
                                    <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost""
                                              Class=""size-6""
                                              @onclick=""@(() => StartEdit(item.Id, item.Text))"" aria-label=""Edit item"">
                                        <span class=""text-[10px]"">Edit</span>
                                    </ButtonCn>
                                    <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost""
                                              Class=""size-6 text-destructive""
                                              @onclick=""@(() => HandleDelete(item.Id))"" aria-label=""Delete"">
                                        <LucideIconCn Name=""trash"" Size=""12"" Class=""size-3"" />
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
