@* ============================================================
   Block: crud-menu-editor
   Title: CrudMenuEditor
   Description: Restaurant and app menu editor with categories, pricing, dietary tags, availability toggles, and item reordering
   Source: original/blocks/crud/crud-menu-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="utensils" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Menu Editor</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_items.Count items · @_items.Count(i => i.Status == "available") available
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Item
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search menu items..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" aria-label="Search menu items" />
            </div>
            <div class="flex gap-1">
                <button type="button"
                        @onclick="@(() => _filter = "all")"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "all" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                    All
                </button>
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <button type="button"
                            @onclick="@(() => _filter = category)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == category ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @category
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var it in _filtered)
            {
                var item = it;
                var statusColor = item.Status switch { "available" => "bg-emerald-500", "seasonal" => "bg-amber-500", _ => "bg-muted-foreground/40" };
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", statusColor)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@item.Name</span>
                                <span class="text-sm font-medium tabular-nums text-foreground">@FormatPrice(item.Price)</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">@item.Description</p>
                            <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">@item.Category</BadgeCn>
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">@tag</span>
                                }
                            </div>
                            <div class="mt-1.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="tabular-nums">@item.Calories cal</span>
                                <span>·</span>
                                <span>@item.PrepTime</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn OnClick="@(() => ToggleAvailability(item.Id))">
                                    @(item.Status == "available" ? "Mark Unavailable" : "Mark Available")
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => DeleteItem(item.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!_filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No menu items found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MenuItem(int Id, string Name, string Description, string Category, double Price, string[] Tags, string Status, int Calories, string PrepTime);

    private string _search = "";
    private string _filter = "all";

    private static readonly MenuItem[] _initial =
    [
        new(1, "Grilled Atlantic Salmon", "Pan-seared salmon with lemon butter sauce, asparagus, and wild rice", "Entrees", 28.5, ["Gluten-Free", "High Protein"], "available", 520, "18 min"),
        new(2, "Truffle Mushroom Risotto", "Arborio rice with wild mushrooms, truffle oil, and aged parmesan", "Entrees", 24.0, ["Vegetarian"], "available", 680, "22 min"),
        new(3, "Caesar Salad", "Romaine hearts, croutons, shaved parmesan, and house-made Caesar dressing", "Starters", 14.5, [], "available", 320, "8 min"),
        new(4, "Wagyu Burger", "8oz wagyu patty with caramelized onions, gruyere, and brioche bun", "Entrees", 32.0, ["High Protein"], "available", 890, "15 min"),
        new(5, "Lobster Bisque", "Creamy New England style bisque with lobster chunks and chive oil", "Starters", 16.0, ["Gluten-Free"], "seasonal", 280, "10 min"),
        new(6, "Chocolate Lava Cake", "Warm dark chocolate cake with molten center and vanilla bean ice cream", "Desserts", 14.0, ["Vegetarian"], "available", 560, "12 min"),
        new(7, "Tuna Tartare", "Yellowfin tuna with avocado, sesame, crispy wontons, and ponzu", "Starters", 18.0, ["Gluten-Free", "Dairy-Free"], "unavailable", 240, "10 min"),
    ];

    private List<MenuItem> _items = _initial.ToList();

    private string[] _categories = _initial.Select(i => i.Category).Distinct().ToArray();

    private IEnumerable<MenuItem> _filtered => _items
        .Where(i => _filter == "all" || i.Category == _filter)
        .Where(i => i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    i.Description.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static string FormatPrice(double price) => $"${price:F2}";

    private void DeleteItem(int id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
    }

    private void ToggleAvailability(int id)
    {
        _items = _items.Select(i =>
            i.Id == id
                ? i with { Status = i.Status == "available" ? "unavailable" : "available" }
                : i
        ).ToList();
    }
}
