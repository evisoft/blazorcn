@* ============================================================
   Block: crud-file-manager
   Title: Crud File Manager
   Description: File browser with list view, breadcrumb navigation, and bulk actions
   Dependencies: ButtonCn, CheckboxCn, DropdownMenuCn
   Source: original/blocks/crud/crud-file-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-1 text-sm">
                <button type="button" class="text-muted-foreground transition-colors hover:text-foreground">Home</button>
                <LucideChevronRightCn Class="size-4 text-muted-foreground" Size="16" />
                <button type="button" class="font-medium text-foreground">My Files</button>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideUploadCn Class="size-3.5" Size="14" />
                Upload
            </ButtonCn>
        </div>

        @if (_selected.Count > 0)
        {
            <div class="flex items-center justify-between border-b bg-muted/50 px-4 py-2">
                <span class="text-sm text-muted-foreground">@_selected.Count selected</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-7 gap-1.5 text-xs text-red-600 hover:text-red-700"
                          OnClick="@(() => _selected.Clear())">
                    <LucideTrash2Cn Class="size-3.5" Size="14" />
                    Delete
                </ButtonCn>
            </div>
        }

        <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto] items-center gap-4 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <CheckboxCn Checked="@(_selected.Count == _files.Length)" CheckedChanged="@((bool _) => ToggleSelectAll())" aria-label="Select all files" />
            <span>Name</span>
            <span>Type</span>
            <span>Size</span>
            <span>Modified</span>
            <span class="w-8"></span>
        </div>

        <div>
            @foreach (var file in _files)
            {
                var iconClass = file.Type == "folder" ? "text-blue-500" : "text-muted-foreground";
                var badge = GetTypeBadge(file.Type);
                <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto] items-center gap-4 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <CheckboxCn Checked="@_selected.Contains(file.Id)" CheckedChanged="@((bool _) => ToggleSelect(file.Id))" aria-label="@($"Select {file.Name}")" />

                    <div class="flex min-w-0 items-center gap-2.5">
                        @if (file.Type == "folder")
                        {
                            <LucideFolderOpenCn Class="@Cn.Merge("size-4 shrink-0", iconClass)" Size="16" />
                        }
                        else if (file.Type is "pdf" or "document")
                        {
                            <LucideFileTextCn Class="@Cn.Merge("size-4 shrink-0", iconClass)" Size="16" />
                        }
                        else if (file.Type == "image")
                        {
                            <LucideImageCn Class="@Cn.Merge("size-4 shrink-0", iconClass)" Size="16" />
                        }
                        else if (file.Type == "spreadsheet")
                        {
                            <LucideSheetCn Class="@Cn.Merge("size-4 shrink-0", iconClass)" Size="16" />
                        }
                        else
                        {
                            <LucideFileCn Class="@Cn.Merge("size-4 shrink-0", iconClass)" Size="16" />
                        }
                        <div class="min-w-0">
                            <p class="truncate text-sm font-medium">@file.Name</p>
                            @if (file.SharedWith > 0)
                            {
                                <p class="text-xs text-muted-foreground">Shared with @file.SharedWith</p>
                            }
                        </div>
                    </div>

                    <div>
                        @if (badge != null)
                        {
                            <span class="inline-flex rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">@badge</span>
                        }
                    </div>

                    <span class="text-sm text-muted-foreground">@(file.Size ?? "—")</span>

                    <span class="text-sm text-muted-foreground">@file.Modified</span>

                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm size-8 p-0" data-variant="ghost" data-size="sm" aria-label="More options">
                                <LucideEllipsisVerticalCn Class="size-4" Size="16" />
                            </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            @if (file.Type != "folder")
                            {
                                <DropdownMenuItemCn>
                                    <LucideDownloadCn Class="mr-2 size-4" Size="16" />
                                    Download
                                </DropdownMenuItemCn>
                            }
                            <DropdownMenuItemCn>
                                <LucideSquarePenCn Class="mr-2 size-4" Size="16" />
                                Rename
                            </DropdownMenuItemCn>
                            @if (file.Type != "folder")
                            {
                                <DropdownMenuItemCn>
                                    <LucideMoveCn Class="mr-2 size-4" Size="16" />
                                    Move
                                </DropdownMenuItemCn>
                            }
                            <DropdownMenuItemCn Class="text-red-600">
                                <LucideTrash2Cn Class="mr-2 size-4" Size="16" />
                                Delete
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FileItem(string Id, string Name, string Type, string? Size, string Modified, int SharedWith);

    private HashSet<string> _selected = new();

    private static string? GetTypeBadge(string type) => type switch
    {
        "pdf" => "PDF",
        "image" => "Image",
        "document" => "Document",
        "spreadsheet" => "Spreadsheet",
        _ => null,
    };

    private void ToggleSelect(string id) { if (!_selected.Remove(id)) _selected.Add(id); }
    private void ToggleSelectAll() { if (_selected.Count == _files.Length) _selected.Clear(); else { foreach (var f in _files) _selected.Add(f.Id); } }

    private static readonly FileItem[] _files =
    [
        new("f1", "Documents", "folder", null, "2 days ago", 0),
        new("f2", "Images", "folder", null, "1 week ago", 3),
        new("f3", "Q4_Report_2025.pdf", "pdf", "2.4 MB", "3 hours ago", 5),
        new("f4", "Product_Mockup.png", "image", "1.8 MB", "Yesterday", 2),
        new("f5", "Meeting_Notes.docx", "document", "145 KB", "5 hours ago", 8),
        new("f6", "Budget_2026.xlsx", "spreadsheet", "892 KB", "2 days ago", 4),
        new("f7", "Presentation.pptx", "document", "5.2 MB", "1 week ago", 12),
        new("f8", "Archive", "folder", null, "3 weeks ago", 0),
    ];
}
