@* ============================================================
   Block: crud-advanced-filters
   Title: Crud Advanced Filters
   Description: CRUD advanced filters panel with multiple criteria, condition operators, value inputs, and filter management for complex data queries
   Long Description: CRUD user list with search and actions
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn
   Source: original/blocks/crud/crud-advanced-filters.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Advanced Filters</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Build queries with multiple criteria
                </p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline">
                    <LucideSaveCn Size="12" Class="size-3" />
                    Save Preset
                </ButtonCn>
                @if (_filters.Count > 0)
                {
                    <ButtonCn Class="h-7 px-2 text-xs" Variant="ButtonVariant.Ghost"
                              @onclick="ClearAll">
                        Clear All
                    </ButtonCn>
                }
            </div>
        </div>

        @* Filter rows *@
        <div class="divide-y">
            @foreach (var filter in _filters)
            {
                <div class="grid items-end gap-3 px-4 py-3 sm:grid-cols-[1fr,1fr,1.5fr,auto]">
                    <div class="space-y-1">
                        <span class="text-xs text-muted-foreground">Field</span>
                        <SelectCn Value="@filter.Field">
                            <SelectTriggerCn>
                                <SelectValueCn Placeholder="Select field" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="status">Status</SelectItemCn>
                                <SelectItemCn Value="role">Role</SelectItemCn>
                                <SelectItemCn Value="created">Created Date</SelectItemCn>
                                <SelectItemCn Value="email">Email</SelectItemCn>
                                <SelectItemCn Value="name">Name</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="space-y-1">
                        <span class="text-xs text-muted-foreground">Operator</span>
                        <SelectCn Value="@filter.Operator">
                            <SelectTriggerCn>
                                <SelectValueCn Placeholder="Operator" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="equals">Equals</SelectItemCn>
                                <SelectItemCn Value="contains">Contains</SelectItemCn>
                                <SelectItemCn Value="after">After</SelectItemCn>
                                <SelectItemCn Value="before">Before</SelectItemCn>
                                <SelectItemCn Value="greater">Greater than</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="space-y-1">
                        <span class="text-xs text-muted-foreground">Value</span>
                        <InputCn Value="@filter.Value" Placeholder="Enter value" />
                    </div>

                    <ButtonCn Class="size-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              @onclick="@(() => RemoveFilter(filter.Id))">
                        <LucideXCn Size="12" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
        </div>

        @* Add filter *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                      @onclick="AddFilter">
                <LucidePlusCn Size="12" Class="mr-1.5 size-3.5" />
                Add Filter
            </ButtonCn>
        </div>

        @* Active filter chips *@
        @{ var activeFilters = _filters.Where(f => !string.IsNullOrEmpty(f.Field) && !string.IsNullOrEmpty(f.Operator) && !string.IsNullOrEmpty(f.Value)).ToList(); }
        @if (activeFilters.Count > 0)
        {
            <div class="border-t px-4 py-3">
                <span class="mb-2 block text-xs text-muted-foreground">Active Filters</span>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var filter in activeFilters)
                    {
                        <BadgeCn Class="gap-1 text-xs" Variant="BadgeVariant.Secondary">
                            @filter.Field @filter.Operator @filter.Value
                            <button class="hover:text-destructive" type="button"
                                    @onclick="@(() => RemoveFilter(filter.Id))">
                                <LucideXCn Size="12" Class="size-3" />
                            </button>
                        </BadgeCn>
                    }
                </div>
            </div>
        }

        @* Actions *@
        <div class="flex gap-2 border-t px-4 py-3">
            <ButtonCn Class="flex-1" Size="ButtonSize.Sm">
                Apply Filters
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="ClearAll">
                Reset
            </ButtonCn>
        </div>

        @* Saved presets *@
        <div class="border-t">
            <div class="border-b bg-muted/30 px-4 py-1.5">
                <span class="text-xs font-medium text-muted-foreground">Saved Presets</span>
            </div>
            @foreach (var preset in _presets)
            {
                <button class="flex w-full items-center justify-between px-4 py-2.5 text-left transition-colors hover:bg-muted/50"
                        type="button">
                    <span class="text-sm font-medium">@preset.Name</span>
                    <span class="font-mono text-xs text-muted-foreground">@preset.Count</span>
                </button>
            }
        </div>

        @* Results summary *@
        <div class="border-t bg-muted/30 px-4 py-2.5">
            <p class="text-xs text-muted-foreground">
                @(_filters.Count > 0 ? "156 items match your filters" : "No filters applied")
            </p>
        </div>
    </div>
</section>

@code {
    private class FilterItem
    {
        public string Id { get; set; } = "";
        public string Field { get; set; } = "";
        public string Operator { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private record PresetItem(string Name, int Count);

    private int _nextFilterId = 3;

    private readonly List<FilterItem> _filters =
    [
        new() { Id = "1", Field = "status", Operator = "equals", Value = "active" },
        new() { Id = "2", Field = "created", Operator = "after", Value = "2024-01-01" },
    ];

    private readonly PresetItem[] _presets =
    [
        new("Active Users", 156),
        new("New This Month", 42),
        new("Premium Members", 89),
        new("Inactive 30+ Days", 23),
    ];

    private void RemoveFilter(string id) => _filters.RemoveAll(f => f.Id == id);
    private void ClearAll() => _filters.Clear();
    private void AddFilter()
    {
        _filters.Add(new FilterItem { Id = $"{_nextFilterId++}", Field = "", Operator = "", Value = "" });
    }
}
