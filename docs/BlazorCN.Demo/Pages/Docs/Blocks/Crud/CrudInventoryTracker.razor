@* ============================================================
   Block: crud-inventory-tracker
   Title: Crud Inventory Tracker
   Description: Stock management table with low stock alerts and adjustment controls
   Dependencies: ButtonCn, DropdownMenuCn
   Source: original/blocks/crud/crud-inventory-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Inventory Tracker</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_items.Count products
                    @{ var lowStockCount = _items.Count(it => it.CurrentStock < it.ReorderPoint); }
                    @if (lowStockCount > 0)
                    {
                        <span class="ml-2 inline-flex items-center gap-1 text-red-600">
                            <LucideAlertTriangleCn Class="size-3" Size="12" />
                            @lowStockCount low stock
                        </span>
                    }
                </p>
            </div>
            <DropdownMenuCn>
                <DropdownMenuTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        @_selectedCategory
                        <LucideChevronDownCn Class="size-3.5" Size="14" />
                    </ButtonCn>
                </DropdownMenuTriggerCn>
                <DropdownMenuContentCn Align="FloatingAlign.End">
                    @foreach (var category in _categories)
                    {
                        <DropdownMenuItemCn OnClick="@(() => _selectedCategory = category)">@category</DropdownMenuItemCn>
                    }
                </DropdownMenuContentCn>
            </DropdownMenuCn>
        </div>

        <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto_auto] items-center gap-4 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <span>SKU</span>
            <span>Product Name</span>
            <span>Category</span>
            <span>Current Stock</span>
            <span>Reorder Point</span>
            <span>Supplier</span>
            <span class="w-32 text-center">Actions</span>
        </div>

        <div>
            @foreach (var item in _filteredItems)
            {
                var isLowStock = item.CurrentStock < item.ReorderPoint;
                <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto_auto] items-center gap-4 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <span class="font-mono text-xs text-muted-foreground">@item.Sku</span>

                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium">@item.Name</p>
                    </div>

                    <span class="inline-flex rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">@item.Category</span>

                    <div class="flex items-center gap-2">
                        @if (isLowStock)
                        {
                            <LucideAlertTriangleCn Class="size-3.5 shrink-0 text-red-500" Size="14" />
                        }
                        <span class="@Cn.Merge("text-sm font-medium tabular-nums", isLowStock ? "text-red-600" : "text-foreground")">@item.CurrentStock</span>
                    </div>

                    <span class="text-sm tabular-nums text-muted-foreground">@item.ReorderPoint</span>

                    <span class="text-sm text-muted-foreground">@item.Supplier</span>

                    <div class="flex items-center justify-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                                  OnClick="@(() => AdjustStock(item.Id, -1))">
                            <LucideMinusCn Class="size-4" Size="16" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                                  OnClick="@(() => AdjustStock(item.Id, 1))">
                            <LucidePlusCn Class="size-4" Size="16" />
                        </ButtonCn>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                                    <LucideEllipsisVerticalCn Class="size-4" Size="16" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>
                                    <LucideEdit2Cn Class="mr-2 size-4" Size="16" />
                                    Edit
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>
                                    <LucideRefreshCwCn Class="mr-2 size-4" Size="16" />
                                    Reorder
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class InventoryItem
    {
        public string Id { get; set; } = "";
        public string Sku { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public int CurrentStock { get; set; }
        public int ReorderPoint { get; set; }
        public string Supplier { get; set; } = "";
    }

    private string _selectedCategory = "All Categories";

    private static readonly string[] _categories = ["All Categories", "Electronics", "Apparel", "Home Goods", "Office Supplies"];

    private List<InventoryItem> _filteredItems => _selectedCategory == "All Categories"
        ? _items
        : _items.Where(i => i.Category == _selectedCategory).ToList();

    private void AdjustStock(string id, int delta)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item != null) item.CurrentStock = Math.Max(0, item.CurrentStock + delta);
    }

    private List<InventoryItem> _items =
    [
        new() { Id = "1", Sku = "ELEC-1001", Name = "Wireless Keyboard", Category = "Electronics", CurrentStock = 45, ReorderPoint = 20, Supplier = "TechSupply Co" },
        new() { Id = "2", Sku = "APRL-2003", Name = "Cotton T-Shirt (Black)", Category = "Apparel", CurrentStock = 8, ReorderPoint = 25, Supplier = "Fabric Direct" },
        new() { Id = "3", Sku = "HOME-3012", Name = "Ceramic Coffee Mug", Category = "Home Goods", CurrentStock = 120, ReorderPoint = 50, Supplier = "HomeWares Inc" },
        new() { Id = "4", Sku = "OFFC-4005", Name = "A4 Paper (500 sheets)", Category = "Office Supplies", CurrentStock = 15, ReorderPoint = 30, Supplier = "Office Depot" },
        new() { Id = "5", Sku = "ELEC-1008", Name = "USB-C Cable (2m)", Category = "Electronics", CurrentStock = 62, ReorderPoint = 40, Supplier = "TechSupply Co" },
        new() { Id = "6", Sku = "APRL-2015", Name = "Denim Jeans", Category = "Apparel", CurrentStock = 34, ReorderPoint = 20, Supplier = "Fabric Direct" },
        new() { Id = "7", Sku = "HOME-3024", Name = "Desk Lamp", Category = "Home Goods", CurrentStock = 5, ReorderPoint = 15, Supplier = "HomeWares Inc" },
        new() { Id = "8", Sku = "OFFC-4018", Name = "Ballpoint Pens (12pk)", Category = "Office Supplies", CurrentStock = 88, ReorderPoint = 30, Supplier = "Office Depot" },
    ];
}
