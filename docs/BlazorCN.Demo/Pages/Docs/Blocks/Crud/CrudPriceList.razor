@* ============================================================
   Block: crud-price-list
   Title: Crud Price List
   Description: Manage product pricing across multiple tiers with currency options
   Dependencies: ButtonCn, DropdownMenuCn, SelectCn
   Source: original/blocks/crud/crud-price-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Price List</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Manage product pricing across tiers</p>
                </div>
                <div class="flex items-center gap-2">
                    <SelectCn Value="@_currency" ValueChanged="@((string v) => _currency = v)">
                        <SelectTriggerCn Class="h-7 w-20 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="USD">USD</SelectItemCn>
                            <SelectItemCn Value="EUR">EUR</SelectItemCn>
                            <SelectItemCn Value="GBP">GBP</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <SelectCn Value="@_sortBy" ValueChanged="@((string v) => _sortBy = v)">
                        <SelectTriggerCn Class="h-7 w-28 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="name">Sort by Name</SelectItemCn>
                            <SelectItemCn Value="price">Sort by Price</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <ButtonCn Class="h-7 gap-1.5 text-xs">
                        <LucidePlusCn Class="size-3.5" Size="14" />
                        Add Product
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b bg-muted/30">
                        <th class="px-4 py-2 text-left">
                            <span class="text-xs font-medium text-muted-foreground">Product</span>
                        </th>
                        <th class="px-3 py-2 text-right">
                            <span class="text-xs font-medium text-muted-foreground">Basic</span>
                        </th>
                        <th class="px-3 py-2 text-right">
                            <span class="text-xs font-medium text-muted-foreground">Pro</span>
                        </th>
                        <th class="px-3 py-2 text-right">
                            <span class="text-xs font-medium text-muted-foreground">Enterprise</span>
                        </th>
                        <th class="px-3 py-2 text-left">
                            <span class="text-xs font-medium text-muted-foreground">Effective</span>
                        </th>
                        <th class="px-3 py-2 text-left">
                            <span class="text-xs font-medium text-muted-foreground">Status</span>
                        </th>
                        <th class="w-12 px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var item in _sortedPrices)
                    {
                        var statusColor = item.Status switch { "active" => "bg-emerald-500", "scheduled" => "bg-blue-500", _ => "bg-muted-foreground/40" };
                        <tr class="hover:bg-muted/50">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <LucideDollarSignCn Class="size-3.5 text-muted-foreground" Size="14" />
                                    <span class="text-sm font-medium">@item.Name</span>
                                </div>
                            </td>
                            <td class="px-3 py-3 text-right">
                                <span class="font-mono text-sm">@FormatPrice(item.BasicPrice)</span>
                            </td>
                            <td class="px-3 py-3 text-right">
                                <span class="font-mono text-sm">@FormatPrice(item.ProPrice)</span>
                            </td>
                            <td class="px-3 py-3 text-right">
                                <span class="font-mono text-sm">@FormatPrice(item.EnterprisePrice)</span>
                            </td>
                            <td class="px-3 py-3">
                                <span class="text-xs text-muted-foreground">@item.EffectiveDate</span>
                            </td>
                            <td class="px-3 py-3">
                                <div class="flex items-center gap-1.5">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", statusColor)"></span>
                                    <span class="text-xs capitalize">@item.Status</span>
                                </div>
                            </td>
                            <td class="px-3 py-3">
                                <DropdownMenuCn>
                                    <DropdownMenuTriggerCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Class="size-6 p-0">
                                            <LucideEllipsisVerticalCn Class="size-3.5" Size="14" />
                                        </ButtonCn>
                                    </DropdownMenuTriggerCn>
                                    <DropdownMenuContentCn Align="FloatingAlign.End">
                                        <DropdownMenuItemCn Class="text-xs">
                                            <LucideEditCn Class="mr-2 size-3" Size="12" />
                                            Edit Prices
                                        </DropdownMenuItemCn>
                                        <DropdownMenuItemCn Class="text-xs">
                                            <LucideTrendingUpCn Class="mr-2 size-3" Size="12" />
                                            Price History
                                        </DropdownMenuItemCn>
                                        <DropdownMenuItemCn Class="text-xs">
                                            <LucideArchiveCn Class="mr-2 size-3" Size="12" />
                                            Archive
                                        </DropdownMenuItemCn>
                                    </DropdownMenuContentCn>
                                </DropdownMenuCn>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="border-t bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground">Active</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span class="text-muted-foreground">Scheduled</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="text-muted-foreground">Archived</span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between px-4 py-3">
            <div class="text-xs text-muted-foreground">@_prices.Count(p => p.Status == "active") active products</div>
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 text-xs">Bulk Edit Prices</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PriceItem(string Id, string Name, int BasePrice, int BasicPrice, int ProPrice, int EnterprisePrice, string EffectiveDate, string Status);

    private string _currency = "USD";
    private string _sortBy = "name";

    private PriceItem[] _sortedPrices => _sortBy == "name"
        ? _prices.OrderBy(p => p.Name).ToArray()
        : _prices.OrderBy(p => p.BasePrice).ToArray();

    private string FormatPrice(int amount) => _currency switch
    {
        "EUR" => $"\u20ac{amount:N0}",
        "GBP" => $"\u00a3{amount:N0}",
        _ => $"${amount:N0}",
    };

    private static readonly PriceItem[] _prices =
    [
        new("prod-1", "Premium Support", 199, 199, 399, 799, "2026-01-01", "active"),
        new("prod-2", "API Access", 49, 49, 99, 249, "2026-01-01", "active"),
        new("prod-3", "Advanced Analytics", 299, 299, 599, 1199, "2026-04-01", "scheduled"),
        new("prod-4", "Custom Integration", 999, 999, 1999, 3999, "2026-01-01", "active"),
        new("prod-5", "Training Workshop", 499, 499, 899, 1499, "2025-12-01", "archived"),
    ];
}
