@* ============================================================
   Block: crud-media-gallery
   Title: Media Gallery
   Description: Media library list view with thumbnails, metadata, and file management
   Dependencies: ButtonCn, CheckboxCn, DropdownMenuCn, InputCn
   Source: original/blocks/crud/crud-media-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Media Library</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">@_media.Length files</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <LucideSearchCn Class="pointer-events-none absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" Size="14" />
                    <InputCn type="text" placeholder="Search files..." @bind-Value="_searchQuery"
                             Class="h-7 w-48 pl-8 text-xs" />
                </div>
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                            @(_typeFilter == "all" ? "All Types" : _typeFilter)
                            <LucideChevronDownCn Class="size-3.5" Size="14" />
                        </ButtonCn>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.End">
                        <DropdownMenuItemCn OnClick="@(() => _typeFilter = "all")">All Types</DropdownMenuItemCn>
                        <DropdownMenuItemCn OnClick="@(() => _typeFilter = "image")">Image</DropdownMenuItemCn>
                        <DropdownMenuItemCn OnClick="@(() => _typeFilter = "video")">Video</DropdownMenuItemCn>
                        <DropdownMenuItemCn OnClick="@(() => _typeFilter = "audio")">Audio</DropdownMenuItemCn>
                        <DropdownMenuItemCn OnClick="@(() => _typeFilter = "document")">Document</DropdownMenuItemCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>
            </div>
        </div>

        @if (_selected.Count > 0)
        {
            <div class="flex items-center justify-between border-b bg-muted/50 px-4 py-2">
                <span class="text-sm text-muted-foreground">@_selected.Count selected</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-7 gap-1.5 text-xs text-red-600 hover:text-red-700"
                          OnClick="@(() => _selected.Clear())">
                    <LucideTrash2Cn Class="size-3.5" Size="14" />
                    Delete
                </ButtonCn>
            </div>
        }

        <div class="grid grid-cols-[auto_auto_1fr_auto_auto_auto_auto] items-center gap-4 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <CheckboxCn Checked="@(_filtered.Length > 0 && _selected.Count == _filtered.Length)"
                        CheckedChanged="@((bool _) => ToggleSelectAll())" />
            <span class="w-16"></span>
            <span>File Name</span>
            <span>Type</span>
            <span>Dimensions</span>
            <span>Size</span>
            <span class="w-12 text-center">Actions</span>
        </div>

        <div>
            @foreach (var item in _filtered)
            {
                var badgeLabel = item.Type switch { "image" => "Image", "video" => "Video", "audio" => "Audio", "document" => "Document", _ => item.Type };
                <div class="grid grid-cols-[auto_auto_1fr_auto_auto_auto_auto] items-center gap-4 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <CheckboxCn Checked="@_selected.Contains(item.Id)" CheckedChanged="@((bool _) => ToggleSelect(item.Id))" />

                    <div class="@Cn.Merge("flex size-16 shrink-0 items-center justify-center rounded", item.ThumbnailColor)">
                        <span class="text-xs font-medium uppercase text-muted-foreground">@item.Type[..3]</span>
                    </div>

                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium">@item.Name</p>
                        <p class="text-xs text-muted-foreground">Uploaded @item.UploadDate</p>
                    </div>

                    <span class="inline-flex rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">@badgeLabel</span>

                    <span class="text-sm text-muted-foreground">@(item.Dimensions ?? "—")</span>

                    <span class="text-sm text-muted-foreground">@item.Size</span>

                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                                <LucideEllipsisVerticalCn Class="size-4" Size="16" />
                            </ButtonCn>
                        </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuItemCn OnClick="@(() => _copiedId = item.Id)">
                                @if (_copiedId == item.Id)
                                {
                                    <LucideCheckCn Class="mr-2 size-4" Size="16" />
                                    <text>Copied!</text>
                                }
                                else
                                {
                                    <LucideCopyCn Class="mr-2 size-4" Size="16" />
                                    <text>Copy URL</text>
                                }
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn>
                                <LucideEdit2Cn Class="mr-2 size-4" Size="16" />
                                Rename
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn Class="text-red-600">
                                <LucideTrash2Cn Class="mr-2 size-4" Size="16" />
                                Delete
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-2.5">
            <span class="text-xs text-muted-foreground">Showing @_filtered.Length of @_media.Length files</span>
        </div>
    </div>
</section>

@code {
    private record MediaItem(string Id, string Name, string Type, string? Dimensions, string Size, string UploadDate, string ThumbnailColor);

    private HashSet<string> _selected = new();
    private string _typeFilter = "all";
    private string _searchQuery = "";
    private string? _copiedId;

    private MediaItem[] _filtered => _media
        .Where(m => (_typeFilter == "all" || m.Type == _typeFilter) && m.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private void ToggleSelect(string id) { if (!_selected.Remove(id)) _selected.Add(id); }
    private void ToggleSelectAll()
    {
        var f = _filtered;
        if (_selected.Count == f.Length) _selected.Clear();
        else { foreach (var m in f) _selected.Add(m.Id); }
    }

    private static readonly MediaItem[] _media =
    [
        new("1", "hero-banner.jpg", "image", "1920x1080", "2.4 MB", "2 hours ago", "bg-blue-500/20"),
        new("2", "product-demo.mp4", "video", "1280x720", "15.8 MB", "Yesterday", "bg-purple-500/20"),
        new("3", "background-music.mp3", "audio", null, "4.2 MB", "3 days ago", "bg-emerald-500/20"),
        new("4", "user-guide.pdf", "document", null, "892 KB", "1 week ago", "bg-red-500/20"),
        new("5", "team-photo.png", "image", "2400x1600", "5.1 MB", "5 days ago", "bg-blue-500/20"),
        new("6", "tutorial-part-1.mp4", "video", "1920x1080", "28.5 MB", "1 week ago", "bg-purple-500/20"),
        new("7", "logo-variations.svg", "image", "500x500", "45 KB", "2 weeks ago", "bg-blue-500/20"),
        new("8", "presentation.pptx", "document", null, "3.2 MB", "3 weeks ago", "bg-red-500/20"),
    ];
}
