@* ============================================================
   Block: crud-revision-history
   Title: Crud Revision History
   Description: Document revision comparison with diff preview, author info, and restore functionality
   Long Description: Track every change to your documents with a comprehensive revision history. Compare versions, view detailed diffs, and restore previous versions with one click. Perfect for collaborative editing workflows.
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/crud/crud-revision-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Revision History</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">View and restore previous versions</p>
        </div>

        <div>
            @foreach (var revision in _revisions)
            {
                <div class="border-b last:border-0">
                    <div class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <AvatarCn Class="mt-0.5 size-8 shrink-0">
                            <AvatarFallbackCn Class="bg-muted text-xs">
                                @revision.AuthorInitials
                            </AvatarFallbackCn>
                        </AvatarCn>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">
                                    @revision.Version
                                </span>
                                @if (revision.IsCurrent)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-blue-500/20 bg-blue-500/10 px-1.5 text-blue-500 text-xs">
                                        Current
                                    </BadgeCn>
                                }
                                <span class="text-muted-foreground text-xs">@revision.Timestamp</span>
                            </div>

                            <p class="mt-0.5 text-sm">@revision.Summary</p>

                            <div class="mt-1 flex items-center gap-3 text-xs">
                                @if (revision.LinesAdded > 0)
                                {
                                    <span class="text-emerald-600">+@revision.LinesAdded</span>
                                }
                                @if (revision.LinesRemoved > 0)
                                {
                                    <span class="text-red-600">-@revision.LinesRemoved</span>
                                }
                            </div>
                        </div>

                        <LucideChevronRightCn Size="16" Class="mt-1 size-4 shrink-0 text-muted-foreground/60" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RevisionItem(string Id, string Version, string AuthorName, string AuthorInitials, string Summary, string Timestamp, int LinesAdded, int LinesRemoved, bool IsCurrent, string DiffBefore, string DiffAfter);

    private readonly List<RevisionItem> _revisions =
    [
        new("rev-7", "v7", "Sarah Chen", "SC", "Updated pricing structure for enterprise tier", "2 hours ago", 8, 3, true, "Enterprise: $99/month", "Enterprise: $149/month with advanced analytics"),
        new("rev-6", "v6", "Mike Johnson", "MJ", "Added API rate limits section", "5 hours ago", 12, 0, false, "", "API Rate Limits: 1000 requests/hour for Pro tier"),
        new("rev-5", "v5", "Emily Davis", "ED", "Fixed typos in introduction", "Yesterday", 2, 2, false, "We're commited to providing the best service.", "We're committed to providing the best service."),
        new("rev-4", "v4", "Alex Rodriguez", "AR", "Restructured feature comparison table", "2 days ago", 15, 8, false, "Basic plan includes limited features", "Starter plan includes core features with usage limits"),
        new("rev-3", "v3", "Sarah Chen", "SC", "Updated support contact information", "3 days ago", 4, 4, false, "Contact: support@example.com", "Contact: help@example.com or call 1-800-SUPPORT"),
        new("rev-2", "v2", "Mike Johnson", "MJ", "Added security compliance section", "1 week ago", 20, 1, false, "", "SOC 2 Type II certified with annual audits"),
        new("rev-1", "v1", "Emily Davis", "ED", "Initial document creation", "2 weeks ago", 45, 0, false, "", "Initial document content created"),
    ];
}
