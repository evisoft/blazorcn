@* ============================================================
   Block: crud-list-users
   Title: Crud List Users
   Description: CRUD user list with table layout, search, filters, sorting, row actions including edit/delete, and bulk operations
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CheckboxCn, DropdownMenuCn, InputCn, SelectCn, TableCn
   Source: original/blocks/crud/crud-list-users.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Users</h2>
            <p class="mt-1 text-xs text-muted-foreground">Manage your team members and their account permissions</p>
        </div>

        <div class="flex flex-col gap-3 border-b px-4 py-3 sm:flex-row sm:items-center">
            <div class="relative flex-1">
                <LucideSearchCn Class="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" Size="16" />
                <InputCn Class="border-0 bg-transparent pl-10 shadow-none focus-visible:ring-0"
                         placeholder="Search users by name or email..." aria-label="Search users by name or email" />
            </div>
            <div class="flex gap-2">
                <SelectCn Value="all" ValueChanged="@((string _) => { })">
                    <SelectTriggerCn aria-label="Filter by role" Class="h-8 w-full text-xs sm:w-36">
                        <LucideFunnelCn Class="mr-1.5 size-3" Size="12" />
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="all">All Roles</SelectItemCn>
                        <SelectItemCn Value="admin">Admin</SelectItemCn>
                        <SelectItemCn Value="manager">Manager</SelectItemCn>
                        <SelectItemCn Value="user">User</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                <ButtonCn Class="h-8 gap-1.5 px-3 text-xs" Size="ButtonSize.Sm">
                    <LucideUserPlusCn Class="size-3.5" Size="14" />
                    Add User
                </ButtonCn>
            </div>
        </div>

        @if (_selectedUsers.Count > 0)
        {
            <div class="flex items-center justify-between border-b bg-muted/50 px-4 py-2.5">
                <span class="text-xs font-medium">@_selectedUsers.Count user@(_selectedUsers.Count != 1 ? "s" : "") selected</span>
                <div class="flex gap-2">
                    <ButtonCn Class="h-7 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Change Role</ButtonCn>
                    <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        <LucideDownloadCn Class="size-3" Size="12" />
                        Export
                    </ButtonCn>
                    <ButtonCn Class="h-7 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Destructive">Delete</ButtonCn>
                </div>
            </div>
        }

        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="w-12">
                        <CheckboxCn Checked="@(_selectedUsers.Count == _users.Length)" CheckedChanged="@((bool _) => ToggleAll())" aria-label="Select all users" />
                    </TableHeadCn>
                    <TableHeadCn Class="text-xs">User</TableHeadCn>
                    <TableHeadCn Class="text-xs">Role</TableHeadCn>
                    <TableHeadCn Class="text-xs">Status</TableHeadCn>
                    <TableHeadCn Class="text-xs">Last Active</TableHeadCn>
                    <TableHeadCn Class="w-12"><span class="sr-only">Actions</span></TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var user in _users)
                {
                    <TableRowCn>
                        <TableCellCn>
                            <CheckboxCn Checked="@_selectedUsers.Contains(user.Id)" CheckedChanged="@((bool _) => ToggleUser(user.Id))" aria-label="@($"Select {user.Name}")" />
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-3">
                                <AvatarCn Class="size-8">
                                    <AvatarFallbackCn>@user.Name[0]</AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <div class="text-sm font-medium">@user.Name</div>
                                    <div class="text-xs text-muted-foreground">@user.Email</div>
                                </div>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Outline">@user.Role</BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 rounded-full", user.Status == "active" ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                                <span class="text-xs text-muted-foreground">@user.Status</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-xs text-muted-foreground">@user.LastActive</TableCellCn>
                        <TableCellCn>
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm size-7" data-variant="ghost" data-size="sm" aria-label="More options">
                                        <LucideEllipsisCn Class="size-4" Size="16" />
                                    </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                    <DropdownMenuLabelCn>Actions</DropdownMenuLabelCn>
                                    <DropdownMenuItemCn>View Details</DropdownMenuItemCn>
                                    <DropdownMenuItemCn>Edit User</DropdownMenuItemCn>
                                    <DropdownMenuItemCn>Send Email</DropdownMenuItemCn>
                                    <DropdownMenuSeparatorCn />
                                    <DropdownMenuItemCn>@(user.Status == "active" ? "Deactivate" : "Activate")</DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-destructive">Delete User</DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">Showing 1-@_users.Length of @_users.Length users</p>
            <div class="flex gap-2">
                <ButtonCn Class="h-7 px-2 text-xs" Disabled="true" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Previous</ButtonCn>
                <ButtonCn Class="h-7 px-2 text-xs" Disabled="true" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Next</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record User(int Id, string Name, string Email, string Role, string Status, string LastActive);

    private HashSet<int> _selectedUsers = new();

    private void ToggleUser(int userId) { if (!_selectedUsers.Remove(userId)) _selectedUsers.Add(userId); }
    private void ToggleAll()
    {
        if (_selectedUsers.Count == _users.Length) _selectedUsers.Clear();
        else { foreach (var u in _users) _selectedUsers.Add(u.Id); }
    }

    private static readonly User[] _users =
    [
        new(1, "Alice Johnson", "alice@@example.com", "Admin", "active", "2 hours ago"),
        new(2, "Bob Smith", "bob@@example.com", "Manager", "active", "1 day ago"),
        new(3, "Carol White", "carol@@example.com", "User", "inactive", "1 week ago"),
        new(4, "David Brown", "david@@example.com", "User", "active", "5 minutes ago"),
        new(5, "Emma Davis", "emma@@example.com", "Manager", "active", "3 hours ago"),
    ];
}
