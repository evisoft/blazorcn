@* ============================================================
   Block: crud-permission-matrix
   Title: Crud Permission Matrix
   Description: Edit role-based permissions across resources in a visual matrix
   Long Description: A comprehensive permission matrix for managing role-based access control. Configure granular permissions across all resources and roles with bulk selection and visual feedback.
   Dependencies: ButtonCn, CheckboxCn
   Source: original/blocks/crud/crud-permission-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Permission Matrix</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Configure role-based access control across resources
                    </p>
                </div>
                <ButtonCn Class="h-7 gap-1.5 text-xs">
                    <LucideSaveCn Size="14" Class="size-3.5" />
                    Save Changes
                </ButtonCn>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b bg-muted/30">
                        <th class="px-4 py-2 text-left">
                            <span class="text-xs font-medium text-muted-foreground">Resource</span>
                        </th>
                        @foreach (var role in _roles)
                        {
                            <th class="px-3 py-2 text-center">
                                <div class="flex flex-col items-center gap-1">
                                    <span class="@Cn.Merge("text-xs font-medium", role.Color)">@role.Name</span>
                                </div>
                            </th>
                        }
                        <th class="px-3 py-2 text-center">
                            <span class="text-xs font-medium text-muted-foreground">All</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var resource in _resources)
                    {
                        <tr class="hover:bg-muted/50">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <LucideShieldCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="font-medium text-sm">@resource.Name</span>
                                </div>
                            </td>
                            @foreach (var role in _roles)
                            {
                                var key = $"{resource.Id}-{role.Id}";
                                <td class="px-3 py-3 text-center">
                                    <div class="flex justify-center">
                                        <CheckboxCn Checked="@(GetPermission(key))" />
                                    </div>
                                </td>
                            }
                            <td class="px-3 py-3 text-center">
                                <div class="flex justify-center">
                                    <CheckboxCn Class="size-3.5" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="border-t bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideCheckCn Size="14" Class="size-3.5" />
                <span>Click column headers to enable/disable all permissions for a role</span>
            </div>
        </div>

        <div class="flex items-center justify-between px-4 py-3">
            <div class="text-xs text-muted-foreground">
                @_permissions.Count(p => p.Value) of @_permissions.Count permissions enabled
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Reset to Defaults
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record RoleItem(string Id, string Name, string Color);
    private record ResourceItem(string Id, string Name);

    private readonly List<RoleItem> _roles =
    [
        new("admin", "Admin", "text-red-500"),
        new("manager", "Manager", "text-amber-500"),
        new("editor", "Editor", "text-blue-500"),
        new("viewer", "Viewer", "text-muted-foreground"),
    ];

    private readonly List<ResourceItem> _resources =
    [
        new("users", "Users"),
        new("posts", "Posts"),
        new("settings", "Settings"),
        new("billing", "Billing"),
        new("analytics", "Analytics"),
    ];

    private readonly Dictionary<string, bool> _permissions = new()
    {
        ["users-admin"] = true, ["users-manager"] = true, ["users-editor"] = false, ["users-viewer"] = false,
        ["posts-admin"] = true, ["posts-manager"] = true, ["posts-editor"] = true, ["posts-viewer"] = true,
        ["settings-admin"] = true, ["settings-manager"] = true, ["settings-editor"] = false, ["settings-viewer"] = false,
        ["billing-admin"] = true, ["billing-manager"] = false, ["billing-editor"] = false, ["billing-viewer"] = false,
        ["analytics-admin"] = true, ["analytics-manager"] = true, ["analytics-editor"] = true, ["analytics-viewer"] = true,
    };

    private bool GetPermission(string key) => _permissions.TryGetValue(key, out var val) && val;
}
