@* ============================================================
   Block: crud-attribute-editor
   Title: CrudAttributeEditor
   Description: Dynamic attribute editor with key-value pairs, type selection, and inline editing for flexible metadata management
   Source: original/blocks/crud/crud-attribute-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Attributes</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_attrs.Count attributes defined</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" @onclick="@(() => _showAdd = !_showAdd)">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Add Attribute
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                    <InputCn Placeholder="Key" Class="h-8 font-mono text-xs" @bind-Value="_newKey" />
                    <InputCn Placeholder="Value" Class="h-8 text-xs" @bind-Value="_newValue" />
                    <SelectCn Value="@_newType" ValueChanged="@((string? v) => { if (v != null) _newType = v; })">
                        <SelectTriggerCn Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="text" Class="text-xs">Text</SelectItemCn>
                            <SelectItemCn Value="number" Class="text-xs">Number</SelectItemCn>
                            <SelectItemCn Value="boolean" Class="text-xs">Boolean</SelectItemCn>
                            <SelectItemCn Value="date" Class="text-xs">Date</SelectItemCn>
                            <SelectItemCn Value="url" Class="text-xs">URL</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <div class="flex gap-1">
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs" @onclick="HandleAdd">Add</ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs" @onclick="@(() => _showAdd = false)">Cancel</ButtonCn>
                    </div>
                </div>
            </div>
        }

        <div class="grid grid-cols-[auto_1fr_1fr_auto_auto_auto] items-center gap-3 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <span class="w-4"></span>
            <span>Key</span>
            <span>Value</span>
            <span>Type</span>
            <span>Required</span>
            <span class="w-16"></span>
        </div>

        <div>
            @foreach (var attr in _attrs)
            {
                var attrItem = attr;
                <div class="grid grid-cols-[auto_1fr_1fr_auto_auto_auto] items-center gap-3 border-b px-4 py-2.5 transition-colors last:border-b-0 hover:bg-muted/50">
                    <LucideGripVerticalCn Size="14" Class="size-3.5 cursor-grab text-muted-foreground/40" />
                    @if (_editingId == attrItem.Id && _editForm != null)
                    {
                        <InputCn Class="h-7 font-mono text-xs" @bind-Value="_editForm.Key" />
                        <InputCn Class="h-7 text-xs" @bind-Value="_editForm.Value" />
                        <SelectCn Value="@_editForm.Type" ValueChanged="@((string? v) => { if (v != null && _editForm != null) _editForm.Type = v; })">
                            <SelectTriggerCn Class="h-7 w-24 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="text" Class="text-xs">Text</SelectItemCn>
                                <SelectItemCn Value="number" Class="text-xs">Number</SelectItemCn>
                                <SelectItemCn Value="boolean" Class="text-xs">Boolean</SelectItemCn>
                                <SelectItemCn Value="date" Class="text-xs">Date</SelectItemCn>
                                <SelectItemCn Value="url" Class="text-xs">URL</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        <span class="text-center text-xs">@(_editForm.Required ? "Yes" : "No")</span>
                        <div class="flex gap-1">
                            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7" @onclick="HandleSave">
                                <LucideCheckCn Size="14" Class="size-3.5" />
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7" @onclick="@(() => { _editingId = null; _editForm = null; })">
                                <LucideXCn Size="14" Class="size-3.5" />
                            </ButtonCn>
                        </div>
                    }
                    else
                    {
                        <span class="truncate font-mono text-xs text-muted-foreground">@attrItem.Key</span>
                        <span class="truncate text-sm font-medium">@attrItem.Value</span>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-[10px] px-1.5 py-0 {TypeColor(attrItem.Type)}")">@attrItem.Type</BadgeCn>
                        <span class="text-center">
                            @if (attrItem.Required)
                            {
                                <span class="size-1.5 inline-block rounded-full bg-amber-500"></span>
                            }
                        </span>
                        <div class="flex gap-1">
                            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7" @onclick="@(() => HandleEdit(attrItem))">
                                <span class="text-xs">Edit</span>
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 text-destructive" @onclick="@(() => HandleDelete(attrItem.Id))">
                                <LucideTrashCn Size="14" Class="size-3.5" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-2">
            <span class="text-xs text-muted-foreground">
                @(_attrs.Count(a => a.Required)) required · @_attrs.Count total
            </span>
        </div>
    </div>
</section>

@code {
    private class AttrItem
    {
        public int Id { get; set; }
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
        public string Type { get; set; } = "text";
        public bool Required { get; set; }
    }

    private List<AttrItem> _attrs = [
        new() { Id = 1, Key = "product_name", Value = "Premium Widget", Type = "text", Required = true },
        new() { Id = 2, Key = "price", Value = "49.99", Type = "number", Required = true },
        new() { Id = 3, Key = "in_stock", Value = "true", Type = "boolean", Required = false },
        new() { Id = 4, Key = "release_date", Value = "2026-04-01", Type = "date", Required = false },
        new() { Id = 5, Key = "weight_kg", Value = "0.85", Type = "number", Required = false },
        new() { Id = 6, Key = "documentation_url", Value = "https://docs.example.com/widget", Type = "url", Required = false },
        new() { Id = 7, Key = "sku", Value = "WDG-PRO-001", Type = "text", Required = true },
        new() { Id = 8, Key = "max_quantity", Value = "500", Type = "number", Required = false },
    ];

    private int? _editingId = null;
    private AttrItem? _editForm = null;
    private bool _showAdd = false;
    private string _newKey = "";
    private string _newValue = "";
    private string _newType = "text";

    private static string TypeColor(string type) => type switch
    {
        "text" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "number" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "boolean" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "date" => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        "url" => "bg-pink-500/10 text-pink-700 dark:text-pink-400",
        _ => ""
    };

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newKey)) return;
        var newId = _attrs.Count > 0 ? _attrs.Max(a => a.Id) + 1 : 1;
        _attrs.Add(new AttrItem { Id = newId, Key = _newKey, Value = _newValue, Type = _newType, Required = false });
        _newKey = "";
        _newValue = "";
        _newType = "text";
        _showAdd = false;
    }

    private void HandleEdit(AttrItem attr)
    {
        _editingId = attr.Id;
        _editForm = new AttrItem { Id = attr.Id, Key = attr.Key, Value = attr.Value, Type = attr.Type, Required = attr.Required };
    }

    private void HandleSave()
    {
        if (_editForm == null) return;
        var idx = _attrs.FindIndex(a => a.Id == _editForm.Id);
        if (idx >= 0) _attrs[idx] = _editForm;
        _editingId = null;
        _editForm = null;
    }

    private void HandleDelete(int id)
    {
        _attrs.RemoveAll(a => a.Id == id);
    }
}
