@* ============================================================
   Block: crud-bulk-edit
   Title: Crud Bulk Edit
   Description: CRUD bulk edit form for updating multiple items simultaneously with field selectors, value inputs, and preview of affected items
   Long Description: CRUD user list with search and bulk actions
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn
   Source: original/blocks/crud/crud-bulk-edit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Bulk Edit</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Update multiple items at once to save time
            </p>
        </div>

        @if (_showSuccess)
        {
            <div class="flex items-center gap-2 border-b bg-emerald-500/10 px-4 py-2.5">
                <LucideCircleCheckBigCn Size="16" Class="size-4 text-emerald-600" />
                <span class="text-sm text-emerald-600">
                    Updated @_selectedItems.Length items.
                    <button class="font-medium underline" type="button">Undo</button>
                </span>
            </div>
        }

        <div class="grid lg:grid-cols-[1fr,280px]">
            <div class="border-b px-4 py-4 lg:border-b-0 lg:border-r">
                <div class="mb-4 flex items-center gap-2 rounded-md bg-muted/50 p-3">
                    <LucideCircleAlertCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">
                        <span class="font-medium text-foreground">
                            @_selectedItems.Length items selected.
                        </span>
                        Changes will be applied to all selected items.
                    </p>
                </div>

                <div class="space-y-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-medium text-muted-foreground">Field to Update</span>
                        <SelectCn Value="@_field">
                            <SelectTriggerCn aria-label="Choose a field">
                                <SelectValueCn Placeholder="Choose a field" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="category">Category</SelectItemCn>
                                <SelectItemCn Value="status">Status</SelectItemCn>
                                <SelectItemCn Value="price">Price Adjustment</SelectItemCn>
                                <SelectItemCn Value="tags">Tags</SelectItemCn>
                                <SelectItemCn Value="featured">Featured Status</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    @if (_field == "category")
                    {
                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">New Category</span>
                            <SelectCn Value="@_value">
                                <SelectTriggerCn aria-label="Select category">
                                    <SelectValueCn Placeholder="Select category" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="electronics">Electronics</SelectItemCn>
                                    <SelectItemCn Value="sports">Sports</SelectItemCn>
                                    <SelectItemCn Value="home">Home</SelectItemCn>
                                    <SelectItemCn Value="fashion">Fashion</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    }

                    @if (_field == "status")
                    {
                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">New Status</span>
                            <SelectCn Value="@_value">
                                <SelectTriggerCn aria-label="Select status">
                                    <SelectValueCn Placeholder="Select status" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="active">Active</SelectItemCn>
                                    <SelectItemCn Value="inactive">Inactive</SelectItemCn>
                                    <SelectItemCn Value="draft">Draft</SelectItemCn>
                                    <SelectItemCn Value="archived">Archived</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    }

                    @if (_field == "price")
                    {
                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">Price Adjustment</span>
                            <div class="flex gap-2">
                                <SelectCn Value="increase">
                                    <SelectTriggerCn aria-label="Adjustment direction" Class="w-28">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="increase">Increase</SelectItemCn>
                                        <SelectItemCn Value="decrease">Decrease</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                                <InputCn Class="flex-1" Placeholder="10" type="number" Value="@_value" aria-label="Amount" />
                                <SelectCn Value="percent">
                                    <SelectTriggerCn aria-label="Adjustment unit" Class="w-20">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="percent">%</SelectItemCn>
                                        <SelectItemCn Value="amount">$</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                        </div>
                    }

                    @if (_field == "tags")
                    {
                        <div class="space-y-1.5">
                            <span class="text-xs font-medium text-muted-foreground">Add Tags</span>
                            <InputCn Placeholder="Enter tags separated by commas" Value="@_value" aria-label="Add tags" />
                            <p class="text-xs text-muted-foreground">
                                Tags will be added to existing tags (not replaced)
                            </p>
                        </div>
                    }

                    <div class="flex gap-2 pt-2">
                        <ButtonCn Class="flex-1"
                                  Disabled="@(string.IsNullOrEmpty(_field) || string.IsNullOrEmpty(_value))"
                                  Size="ButtonSize.Sm">
                            Apply to All
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            Cancel
                        </ButtonCn>
                    </div>
                </div>
            </div>

            <div>
                <div class="border-b bg-muted/30 px-4 py-1.5">
                    <span class="text-xs font-medium text-muted-foreground">Selected Items</span>
                </div>
                @foreach (var item in _selectedItems)
                {
                    <div class="flex items-center justify-between border-b px-4 py-2.5 last:border-b-0">
                        <span class="text-sm font-medium">@item.Name</span>
                        <div class="flex gap-1.5">
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">
                                @item.Category
                            </BadgeCn>
                            <span class="@Cn.Merge("size-1.5 shrink-0 self-center rounded-full", item.Status == "active" ? "bg-emerald-500" : item.Status == "draft" ? "bg-amber-500" : "bg-zinc-400")"></span>
                        </div>
                    </div>
                }
                <div class="bg-muted/30 px-4 py-2">
                    <p class="text-xs text-muted-foreground">
                        Changes apply to all @_selectedItems.Length items
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SelectedItem(int Id, string Name, string Category, string Status);

    private string _field = "";
    private string _value = "";
    private bool _showSuccess;

    private readonly SelectedItem[] _selectedItems =
    [
        new(1, "Wireless Headphones", "Electronics", "active"),
        new(2, "Running Shoes", "Sports", "active"),
        new(3, "Coffee Maker", "Home", "draft"),
        new(4, "Yoga Mat", "Sports", "active"),
        new(5, "Desk Lamp", "Home", "inactive"),
    ];
}
