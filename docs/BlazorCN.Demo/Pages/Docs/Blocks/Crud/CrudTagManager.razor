@* ============================================================
   Block: crud-tag-manager
   Title: Crud Tag Manager
   Description: Tag and label management system with color coding, usage tracking, and merge functionality
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideEdit2Cn, LucideMergeCn, LucidePlusCn, LucideSearchCn, LucideTrashCn
   Source: original/blocks/crud/crud-tag-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Tag Manager</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_tags.Count tags total</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs" @onclick="() => _showNewTagForm = !_showNewTagForm">
                    <LucidePlusCn Size="12" />
                    New tag
                </ButtonCn>
            </div>
        </div>

        @if (_showNewTagForm)
        {
            <div class="border-b bg-muted/50 px-4 py-3">
                <div class="space-y-3">
                    <div>
                        <LabelCn For="tag-name" Class="text-xs">Tag name</LabelCn>
                        <InputCn Id="tag-name" Placeholder="e.g., development" @bind-Value="_newTagName" Class="mt-1 h-8 text-sm" />
                    </div>

                    <div>
                        <LabelCn Class="text-xs">Color</LabelCn>
                        <div class="mt-2 flex gap-2">
                            @foreach (var color in _tagColors)
                            {
                                <button type="button" @onclick="() => _newTagColor = color.Class"
                                        class="@Cn.Merge($"size-6 rounded-full {color.Class}", _newTagColor == color.Class ? "ring-2 ring-foreground ring-offset-2" : "")"
                                        aria-label="@($"Select {color.Id} color")"></button>
                            }
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <ButtonCn @onclick="HandleCreateTag" Class="h-7 text-xs" Size="ButtonSize.Sm">Create tag</ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" @onclick="HandleCancelNewTag" Class="h-7 text-xs" Size="ButtonSize.Sm">Cancel</ButtonCn>
                    </div>
                </div>
            </div>
        }

        <div class="border-b px-4 py-3">
            <div class="flex gap-2">
                <div class="relative flex-1">
                    <LucideSearchCn Size="14" Class="absolute top-2 left-2.5 text-muted-foreground" />
                    <InputCn Type="search" Placeholder="Search tags..." @bind-Value="_searchQuery" Class="h-8 border-0 bg-muted/50 pl-8 text-sm shadow-none focus-visible:ring-0" />
                </div>
                <SelectCn Value="@_sortBy" ValueChanged="@((string? v) => { if (v != null) _sortBy = v; })">
                    <SelectTriggerCn Class="h-8 w-[140px] text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="name" Class="text-xs">Sort by name</SelectItemCn>
                        <SelectItemCn Value="usage" Class="text-xs">Sort by usage</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        <div>
            @foreach (var tag in FilteredTags)
            {
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-0">
                    <span class="@($"size-2 shrink-0 rounded-full {tag.Color}")"></span>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm">@tag.Name</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1.5 text-xs">@tag.UsageCount</BadgeCn>
                        </div>
                        @if (!string.IsNullOrEmpty(tag.Description))
                        {
                            <p class="mt-0.5 text-muted-foreground text-xs">@tag.Description</p>
                        }
                        <p class="mt-0.5 text-muted-foreground text-xs">Created @tag.CreatedDate</p>
                    </div>

                    <div class="flex gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="size-7 p-0">
                            <LucideEdit2Cn Size="14" />
                            <span class="sr-only">Edit tag</span>
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="size-7 p-0">
                            <LucideMergeCn Size="14" />
                            <span class="sr-only">Merge tag</span>
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="size-7 p-0">
                            <LucideTrashCn Size="14" />
                            <span class="sr-only">Delete tag</span>
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TagColor(string Id, string Class);
    private class TagItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Color { get; set; } = "";
        public int UsageCount { get; set; }
        public string Description { get; set; } = "";
        public string CreatedDate { get; set; } = "";
    }

    private string _searchQuery = "";
    private string _sortBy = "name";
    private bool _showNewTagForm;
    private string _newTagName = "";
    private string _newTagColor = "bg-blue-500";

    private readonly TagColor[] _tagColors = [
        new("blue", "bg-blue-500"), new("emerald", "bg-emerald-500"), new("amber", "bg-amber-500"),
        new("red", "bg-red-500"), new("purple", "bg-purple-500"), new("pink", "bg-pink-500"),
    ];

    private readonly List<TagItem> _tags = [
        new() { Id = "1", Name = "frontend", Color = "bg-blue-500", UsageCount = 145, Description = "Frontend development and UI/UX topics", CreatedDate = "3 months ago" },
        new() { Id = "2", Name = "backend", Color = "bg-emerald-500", UsageCount = 98, Description = "Backend services, APIs, and databases", CreatedDate = "3 months ago" },
        new() { Id = "3", Name = "urgent", Color = "bg-red-500", UsageCount = 23, Description = "High priority items requiring immediate attention", CreatedDate = "2 months ago" },
        new() { Id = "4", Name = "documentation", Color = "bg-purple-500", UsageCount = 67, Description = "Documentation and guides", CreatedDate = "2 months ago" },
        new() { Id = "5", Name = "bug", Color = "bg-amber-500", UsageCount = 54, Description = "Bug reports and issues", CreatedDate = "1 month ago" },
        new() { Id = "6", Name = "feature-request", Color = "bg-pink-500", UsageCount = 89, Description = "New feature requests from users", CreatedDate = "1 month ago" },
        new() { Id = "7", Name = "security", Color = "bg-red-500", UsageCount = 12, Description = "Security-related issues and improvements", CreatedDate = "2 weeks ago" },
        new() { Id = "8", Name = "performance", Color = "bg-emerald-500", UsageCount = 34, Description = "Performance optimization and monitoring", CreatedDate = "1 week ago" },
    ];

    private IEnumerable<TagItem> FilteredTags => _tags
        .Where(t => t.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .OrderBy(t => _sortBy == "name" ? t.Name : "")
        .ThenByDescending(t => _sortBy == "usage" ? t.UsageCount : 0);

    private void HandleCreateTag()
    {
        if (string.IsNullOrWhiteSpace(_newTagName)) return;
        _tags.Add(new TagItem
        {
            Id = (_tags.Count + 1).ToString(),
            Name = _newTagName.Trim().ToLower().Replace(" ", "-"),
            Color = _newTagColor,
            UsageCount = 0,
            Description = "",
            CreatedDate = "Just now",
        });
        _newTagName = "";
        _newTagColor = "bg-blue-500";
        _showNewTagForm = false;
    }

    private void HandleCancelNewTag()
    {
        _showNewTagForm = false;
        _newTagName = "";
    }
}
