@* ============================================================
   Block: crud-invoice-manager
   Title: Crud Invoice Manager
   Description: Invoice list with status tracking, filtering, and bulk actions
   Dependencies: ButtonCn, DropdownMenuCn
   Source: original/blocks/crud/crud-invoice-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-medium">Invoices</h2>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Total Amount</p>
                    <p class="text-2xl font-semibold tabular-nums">@FormatCurrency(_filtered.Sum(i => i.Amount))</p>
                </div>
            </div>
        </div>

        <div class="flex border-b">
            @foreach (var status in new[] { "all", "paid", "pending", "overdue", "draft" })
            {
                var count = status == "all" ? _invoices.Length : _invoices.Count(i => i.Status == status);
                <button type="button" @onclick="@(() => _statusFilter = status)"
                        class="@Cn.Merge("flex-1 border-b-2 px-4 py-2.5 text-xs font-medium transition-colors", _statusFilter == status ? "border-foreground text-foreground" : "border-transparent text-muted-foreground hover:text-foreground")">
                    @(char.ToUpper(status[0]) + status[1..])
                    <span class="ml-1.5 text-muted-foreground">(@count)</span>
                </button>
            }
        </div>

        <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto] items-center gap-4 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <span>Invoice #</span>
            <span>Client</span>
            <span>Amount</span>
            <span>Status</span>
            <span>Due Date</span>
            <span class="w-12 text-center">Actions</span>
        </div>

        <div>
            @foreach (var invoice in _filtered)
            {
                var statusColor = invoice.Status switch { "paid" => "bg-emerald-500", "pending" => "bg-blue-500", "overdue" => "bg-red-500", _ => "bg-muted-foreground" };
                var statusLabel = invoice.Status switch { "paid" => "Paid", "pending" => "Pending", "overdue" => "Overdue", _ => "Draft" };
                <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto] items-center gap-4 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <span class="font-mono text-xs text-muted-foreground">@invoice.Number</span>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium">@invoice.Client</p>
                        <p class="text-xs text-muted-foreground">Issued @invoice.IssuedDate</p>
                    </div>
                    <span class="text-sm font-medium tabular-nums">@FormatCurrency(invoice.Amount)</span>
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", statusColor)"></span>
                        <span class="text-xs text-muted-foreground">@statusLabel</span>
                    </div>
                    <span class="text-sm text-muted-foreground">@invoice.DueDate</span>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0">
                                <LucideEllipsisVerticalCn Class="size-4" Size="16" />
                            </ButtonCn>
                        </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuItemCn>
                                <LucideEyeCn Class="mr-2 size-4" Size="16" />
                                View
                            </DropdownMenuItemCn>
                            @if (invoice.Status != "paid")
                            {
                                <DropdownMenuItemCn>
                                    <LucideSendCn Class="mr-2 size-4" Size="16" />
                                    @(invoice.Status == "draft" ? "Send" : "Resend")
                                </DropdownMenuItemCn>
                            }
                            @if (invoice.Status is "pending" or "overdue")
                            {
                                <DropdownMenuItemCn>Mark Paid</DropdownMenuItemCn>
                            }
                            <DropdownMenuItemCn>
                                <LucideCopyCn Class="mr-2 size-4" Size="16" />
                                Duplicate
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Showing @_filtered.Length of @_invoices.Length invoices</span>
                <span class="font-medium text-foreground">Total: @FormatCurrency(_filtered.Sum(i => i.Amount))</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Invoice(string Id, string Number, string Client, int Amount, string Status, string DueDate, string IssuedDate);

    private string _statusFilter = "all";

    private Invoice[] _filtered => _statusFilter == "all"
        ? _invoices
        : _invoices.Where(i => i.Status == _statusFilter).ToArray();

    private static string FormatCurrency(int amount) => $"${amount:N0}";

    private static readonly Invoice[] _invoices =
    [
        new("1", "INV-2024-001", "Acme Corporation", 12500, "paid", "Feb 15, 2024", "Jan 15, 2024"),
        new("2", "INV-2024-002", "TechStart Inc", 8750, "pending", "Mar 20, 2024", "Feb 18, 2024"),
        new("3", "INV-2024-003", "Global Enterprises", 24000, "overdue", "Feb 28, 2024", "Jan 28, 2024"),
        new("4", "INV-2024-004", "Design Studio", 5500, "draft", "Apr 10, 2024", "Mar 10, 2024"),
        new("5", "INV-2024-005", "Marketing Pro", 15000, "paid", "Mar 5, 2024", "Feb 5, 2024"),
        new("6", "INV-2024-006", "Startup Labs", 9200, "pending", "Mar 25, 2024", "Feb 25, 2024"),
        new("7", "INV-2024-007", "Retail Group", 18500, "overdue", "Mar 1, 2024", "Feb 1, 2024"),
        new("8", "INV-2024-008", "Finance Corp", 32000, "paid", "Feb 20, 2024", "Jan 20, 2024"),
    ];
}
