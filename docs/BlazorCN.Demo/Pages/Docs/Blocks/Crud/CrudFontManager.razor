@* ============================================================
   Block: crud-font-manager
   Title: CrudFontManager
   Description: Font library management with preview, categorization, weight variants, and usage tracking
   Source: original/blocks/crud/crud-font-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideTypeCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Font Library</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_fonts.Count fonts · @_fonts.Count(f => f.Status == "active") active
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Add Font
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search fonts..."
                         @bind-Value="_search" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in _filterOptions)
                {
                    var filterVal = s;
                    <button type="button" @onclick="@(() => _filter = filterVal)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(filterVal == "all" ? "All" : char.ToUpper(filterVal[0]) + filterVal.Substring(1))
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var font in FilteredFonts)
            {
                var fontItem = font;
                var statusColor = _statusConfig.TryGetValue(fontItem.Status, out var cfg) ? cfg : "bg-muted-foreground/40";
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {statusColor}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@fontItem.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                    @fontItem.Category
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @fontItem.Designer · @fontItem.License
                            </p>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span class="tabular-nums">@fontItem.Weights.Length weights</span>
                                <span>·</span>
                                <span>@fontItem.FileSize</span>
                                <span>·</span>
                                <span>Used in @fontItem.UsedIn projects</span>
                            </div>
                            <div class="mt-1.5 flex gap-1">
                                @foreach (var w in fontItem.Weights)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">@w</span>
                                }
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideMoreHorizontalCn Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Preview</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn OnClick="@(() => HandleToggleStatus(fontItem.Id))">
                                    @(fontItem.Status == "active" ? "Deactivate" : "Activate")
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>Download</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(fontItem.Id))">
                                    <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!FilteredFonts.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No fonts found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class FontItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public string[] Weights { get; set; } = [];
        public string Designer { get; set; } = "";
        public string License { get; set; } = "";
        public int UsedIn { get; set; }
        public string Status { get; set; } = "active";
        public string FileSize { get; set; } = "";
    }

    private static readonly Dictionary<string, string> _statusConfig = new()
    {
        ["active"] = "bg-emerald-500",
        ["inactive"] = "bg-muted-foreground/40",
        ["review"] = "bg-amber-500",
    };

    private static readonly string[] _filterOptions = ["all", "sans-serif", "serif", "monospace", "display"];

    private string _search = "";
    private string _filter = "all";

    private readonly List<FontItem> _fonts =
    [
        new() { Id = 1, Name = "Inter", Category = "sans-serif", Weights = ["300", "400", "500", "600", "700"], Designer = "Rasmus Andersson", License = "SIL Open Font", UsedIn = 42, Status = "active", FileSize = "245 KB" },
        new() { Id = 2, Name = "Playfair Display", Category = "serif", Weights = ["400", "600", "700", "900"], Designer = "Claus Eggers Sorensen", License = "SIL Open Font", UsedIn = 18, Status = "active", FileSize = "198 KB" },
        new() { Id = 3, Name = "JetBrains Mono", Category = "monospace", Weights = ["300", "400", "500", "700"], Designer = "JetBrains", License = "SIL Open Font", UsedIn = 15, Status = "active", FileSize = "167 KB" },
        new() { Id = 4, Name = "Clash Display", Category = "display", Weights = ["400", "500", "600", "700"], Designer = "Indian Type Foundry", License = "Commercial", UsedIn = 8, Status = "active", FileSize = "312 KB" },
        new() { Id = 5, Name = "Source Serif Pro", Category = "serif", Weights = ["300", "400", "600", "700"], Designer = "Frank Grießhammer", License = "SIL Open Font", UsedIn = 0, Status = "review", FileSize = "220 KB" },
        new() { Id = 6, Name = "Space Grotesk", Category = "sans-serif", Weights = ["300", "400", "500", "600", "700"], Designer = "Florian Karsten", License = "SIL Open Font", UsedIn = 3, Status = "inactive", FileSize = "178 KB" },
    ];

    private IEnumerable<FontItem> FilteredFonts => _fonts
        .Where(f => _filter == "all" || f.Category == _filter)
        .Where(f => f.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleDelete(int id) => _fonts.RemoveAll(f => f.Id == id);

    private void HandleToggleStatus(int id)
    {
        var font = _fonts.FirstOrDefault(f => f.Id == id);
        if (font is null) return;
        font.Status = font.Status == "active" ? "inactive" : "active";
    }
}
