@* ============================================================
   Block: crud-automation-rules
   Title: CrudAutomationRules
   Description: Automation rule builder with trigger-action pairs, conditions, and enable/disable toggles for workflow automation
   Source: original/blocks/crud/crud-automation-rules.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Automation Rules</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_activeCount active &middot; @_rules.Count total
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs"
                          OnClick="@(() => _showAdd = !_showAdd)">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    New Rule
                </ButtonCn>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
                    <InputCn Placeholder="Rule name" Class="h-8 text-xs" @bind-Value="_newName" />
                    <SelectCn Value="@_newTrigger" ValueChanged="@((string v) => _newTrigger = v)">
                        <SelectTriggerCn Class="h-8 text-xs">
                            <SelectValueCn Placeholder="Select trigger" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="User signs up">User signs up</SelectItemCn>
                            <SelectItemCn Value="Form submission">Form submission</SelectItemCn>
                            <SelectItemCn Value="Ticket created">Ticket created</SelectItemCn>
                            <SelectItemCn Value="Invoice past due">Invoice past due</SelectItemCn>
                            <SelectItemCn Value="Daily schedule">Daily schedule</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <SelectCn Value="@_newAction" ValueChanged="@((string v) => _newAction = v)">
                        <SelectTriggerCn Class="h-8 text-xs">
                            <SelectValueCn Placeholder="Select action" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="Send email">Send email</SelectItemCn>
                            <SelectItemCn Value="Notify Slack">Notify Slack</SelectItemCn>
                            <SelectItemCn Value="Create task">Create task</SelectItemCn>
                            <SelectItemCn Value="Run script">Run script</SelectItemCn>
                            <SelectItemCn Value="Update record">Update record</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="mt-2 flex gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleAdd">
                        Create Rule
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs"
                              OnClick="@(() => _showAdd = false)">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        <div>
            @foreach (var r in _rules)
            {
                var rule = r;
                <div class="@Cn.Merge("flex items-center gap-4 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50", !rule.Enabled ? "opacity-50" : "")">
                    <SwitchCn Checked="@rule.Enabled" CheckedChanged="@(_ => ToggleRule(rule.Id))" Class="shrink-0" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@rule.Name</span>
                            @if (!rule.Enabled)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                    Paused
                                </BadgeCn>
                            }
                        </div>
                        <div class="mt-1 flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
                            <span class="rounded bg-muted/80 px-1.5 py-0.5">When: @rule.Trigger</span>
                            <span>@("→")</span>
                            <span class="rounded bg-muted/80 px-1.5 py-0.5">Then: @rule.Action</span>
                            @if (rule.Condition != "None")
                            {
                                <span>&middot;</span>
                                <span>If: @rule.Condition</span>
                            }
                        </div>
                    </div>
                    <div class="hidden text-right sm:block">
                        <p class="text-xs tabular-nums text-muted-foreground">
                            @rule.RunCount.ToString("N0") runs
                        </p>
                        <p class="text-xs text-muted-foreground">@rule.LastRun</p>
                    </div>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn>
                            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                <LucideMoreHorizontalCn Size="16" Class="size-4" />
                            </ButtonCn>
                        </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.End">
                            <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                            <DropdownMenuItemCn>View History</DropdownMenuItemCn>
                            <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                            <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(rule.Id))">
                                <LucideTrashCn Size="16" Class="mr-2 size-4" />
                                Delete
                            </DropdownMenuItemCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class Rule
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Trigger { get; set; } = "";
        public string Action { get; set; } = "";
        public string Condition { get; set; } = "None";
        public bool Enabled { get; set; }
        public string LastRun { get; set; } = "";
        public int RunCount { get; set; }
    }

    private List<Rule> _rules =
    [
        new() { Id = 1, Name = "Welcome Email", Trigger = "User signs up", Action = "Send welcome email", Condition = "Email verified", Enabled = true, LastRun = "2 hours ago", RunCount = 1245 },
        new() { Id = 2, Name = "Overdue Invoice Alert", Trigger = "Invoice past due", Action = "Send reminder email", Condition = "Amount > $100", Enabled = true, LastRun = "4 hours ago", RunCount = 389 },
        new() { Id = 3, Name = "High Priority Ticket", Trigger = "Ticket created", Action = "Notify Slack channel", Condition = "Priority is urgent", Enabled = true, LastRun = "1 hour ago", RunCount = 756 },
        new() { Id = 4, Name = "Weekly Report", Trigger = "Every Monday 9 AM", Action = "Generate and email report", Condition = "None", Enabled = false, LastRun = "3 days ago", RunCount = 52 },
        new() { Id = 5, Name = "Low Stock Alert", Trigger = "Inventory below threshold", Action = "Create purchase order", Condition = "Stock < 10 units", Enabled = true, LastRun = "6 hours ago", RunCount = 124 },
        new() { Id = 6, Name = "New Lead Assignment", Trigger = "Form submission", Action = "Assign to sales rep", Condition = "Company size > 50", Enabled = true, LastRun = "30 min ago", RunCount = 2103 },
        new() { Id = 7, Name = "Backup Database", Trigger = "Daily at 2 AM", Action = "Run backup script", Condition = "None", Enabled = false, LastRun = "1 day ago", RunCount = 365 },
    ];

    private bool _showAdd;
    private string _newName = "";
    private string _newTrigger = "";
    private string _newAction = "";

    private int _activeCount => _rules.Count(r => r.Enabled);

    private void ToggleRule(int id)
    {
        var rule = _rules.FirstOrDefault(r => r.Id == id);
        if (rule != null) rule.Enabled = !rule.Enabled;
    }

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        var newId = _rules.Count > 0 ? _rules.Max(r => r.Id) + 1 : 1;
        _rules.Add(new Rule
        {
            Id = newId,
            Name = _newName,
            Trigger = _newTrigger,
            Action = _newAction,
            Condition = "None",
            Enabled = true,
            LastRun = "Never",
            RunCount = 0,
        });
        _newName = "";
        _newTrigger = "";
        _newAction = "";
        _showAdd = false;
    }

    private void HandleDelete(int id) => _rules.RemoveAll(r => r.Id == id);
}
