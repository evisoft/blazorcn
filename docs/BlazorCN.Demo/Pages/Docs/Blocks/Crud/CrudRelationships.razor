@* ============================================================
   Block: crud-relationships
   Title: Manage Relationships
   Description: CRUD relationship manager for linking records with search, selection, and management of foreign key associations and many-to-many relationships
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/crud/crud-relationships.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Blog Post: Getting Started with React</h2>
            <p class="mt-1 text-xs text-muted-foreground">Manage related categories and tags</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Category (Required)</span>
                <ButtonCn Class="h-7 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                          @onclick="@(() => _showCategoryPicker = !_showCategoryPicker)">
                    Change Category
                </ButtonCn>
            </div>

            @if (_showCategoryPicker)
            {
                <div class="mb-3 space-y-2">
                    @foreach (var category in _availableCategories)
                    {
                        <button type="button"
                                class="@Cn.Merge("w-full rounded-md border p-3 text-left transition-colors hover:bg-muted/50", _selectedCategory == category.Id ? "border-primary bg-muted/50" : "")"
                                @onclick="@(() => { _selectedCategory = category.Id; _showCategoryPicker = false; })">
                            <p class="text-sm font-medium">@category.Name</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@category.Description</p>
                        </button>
                    }
                </div>
            }

            @{
                var currentCategory = _availableCategories.FirstOrDefault(c => c.Id == _selectedCategory);
            }
            @if (currentCategory != null)
            {
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm font-medium">@currentCategory.Name</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@currentCategory.Description</p>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Tags (@_selectedTags.Count)</span>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                          @onclick="@(() => _showTagPicker = !_showTagPicker)">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add Tags
                </ButtonCn>
            </div>

            @if (_showTagPicker)
            {
                <div class="mb-3 space-y-3">
                    <div class="relative">
                        <LucideSearchCn Size="16" Class="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
                        <InputCn Class="pl-10" Placeholder="Search tags..." Value="@_tagSearch" aria-label="Search tags" />
                    </div>
                    <div class="max-h-64 space-y-2 overflow-y-auto">
                        @{
                            var availableTags = _availableTags.Where(t =>
                                (string.IsNullOrEmpty(_tagSearch) || t.Name.Contains(_tagSearch, StringComparison.OrdinalIgnoreCase)) &&
                                !_selectedTags.Contains(t.Id)).ToList();
                        }
                        @if (availableTags.Count == 0)
                        {
                            <p class="py-8 text-center text-xs text-muted-foreground">
                                @(!string.IsNullOrEmpty(_tagSearch) ? "No tags found" : "All available tags are already added")
                            </p>
                        }
                        else
                        {
                            @foreach (var tag in availableTags)
                            {
                                <button type="button"
                                        class="flex w-full items-center justify-between rounded-md border p-3 text-left transition-colors hover:bg-muted/50"
                                        @onclick="@(() => { if (!_selectedTags.Contains(tag.Id)) _selectedTags.Add(tag.Id); })">
                                    <span class="text-sm font-medium">@tag.Name</span>
                                    <span class="text-xs text-muted-foreground">@tag.Count posts</span>
                                </button>
                            }
                        }
                    </div>
                </div>
            }

            @{
                var currentTags = _availableTags.Where(t => _selectedTags.Contains(t.Id)).ToList();
            }
            @if (currentTags.Count > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var tag in currentTags)
                    {
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                            @tag.Name
                            <button type="button" class="ml-1 hover:text-destructive" aria-label="@($"Remove {tag.Name}")"
                                    @onclick="@(() => _selectedTags.Remove(tag.Id))">
                                <LucideXCn Size="12" Class="size-3" />
                            </button>
                        </BadgeCn>
                    }
                </div>
            }
            else
            {
                <p class="text-xs text-muted-foreground">No tags added yet. Click "Add Tags" to get started.</p>
            }
        </div>

        <div class="px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="mb-1.5 text-xs font-medium">Relationship Information</p>
                <ul class="space-y-0.5 text-xs text-muted-foreground">
                    <li>Category: One-to-many (post belongs to one category)</li>
                    <li>Tags: Many-to-many (post can have multiple tags)</li>
                    <li>Changes are saved automatically when modified</li>
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private record TagItem(int Id, string Name, int Count);
    private record CategoryItem(int Id, string Name, string Description);

    private int _selectedCategory = 1;
    private readonly List<int> _selectedTags = [1, 2];
    private string _tagSearch = "";
    private bool _showTagPicker;
    private bool _showCategoryPicker;

    private static readonly TagItem[] _availableTags =
    [
        new(1, "React", 234),
        new(2, "TypeScript", 189),
        new(3, "Next.js", 156),
        new(4, "Tailwind", 145),
        new(5, "JavaScript", 298),
        new(6, "Node.js", 167),
        new(7, "CSS", 201),
        new(8, "HTML", 178),
    ];

    private static readonly CategoryItem[] _availableCategories =
    [
        new(1, "Tutorial", "Step-by-step guides"),
        new(2, "News", "Latest updates and announcements"),
        new(3, "Opinion", "Thoughts and perspectives"),
        new(4, "Review", "Product and tool reviews"),
    ];
}
