@* ============================================================
   Block: crud-template-gallery
   Title: CrudTemplateGallery
   Description: Template gallery manager with categories, preview, cloning, and version tracking
   Source: original/blocks/crud/crud-template-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Template Gallery</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_templates.Count templates &middot; @(_templates.Sum(t => t.Clones).ToString("N0")) total clones
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Template
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn type="text" Placeholder="Search templates..." @bind-Value="_search" Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0" />
            </div>
            <div class="flex gap-1">
                <button type="button" @onclick="@(() => _filter = "all")"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "all" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                    All
                </button>
                @foreach (var cat in _categories)
                {
                    var c = cat;
                    <button type="button" @onclick="@(() => _filter = c)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == c ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @c
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _templates
                    .Where(t => _filter == "all" || t.Category == _filter)
                    .Where(t =>
                        t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        t.Tags.Any(tag => tag.Contains(_search, StringComparison.OrdinalIgnoreCase)))
                    .ToList();
            }
            @foreach (var tmpl in filtered)
            {
                var template = tmpl;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetStatusColor(template.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@template.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">
                                    @template.Category
                                </BadgeCn>
                                <span class="font-mono text-[10px] text-muted-foreground">@template.Version</span>
                            </div>
                            <p class="mt-0.5 line-clamp-1 text-xs text-muted-foreground">@template.Description</p>
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var tag in template.Tags)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">@tag</span>
                                }
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span>@template.Creator</span>
                                <span>&middot;</span>
                                <span class="tabular-nums">@template.Clones.ToString("N0") clones</span>
                                <span>&middot;</span>
                                <span>Updated @template.LastUpdated</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 shrink-0">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </ButtonCn>
                            </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Preview</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Clone</DropdownMenuItemCn>
                                @if (template.Status == "draft")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandlePublish(template.Id))">Publish</DropdownMenuItemCn>
                                }
                                @if (template.Status == "published")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => HandleArchive(template.Id))">Archive</DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => HandleDelete(template.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No templates found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Template(int Id, string Name, string Description, string Category, string Status, string Version, int Clones, string Creator, string[] Tags, string LastUpdated);

    private string _search = "";
    private string _filter = "all";

    private static readonly string[] _categories = ["Marketing", "Application", "E-commerce", "Content", "Email"];

    private List<Template> _templates =
    [
        new(1, "SaaS Landing Page", "Hero section, feature grid, pricing table, testimonials, and CTA footer", "Marketing", "published", "v2.4", 3420, "Design Team", ["landing", "saas", "responsive"], "Mar 22, 2026"),
        new(2, "Admin Dashboard", "Sidebar navigation, stats cards, data tables, and chart widgets", "Application", "published", "v3.1", 5670, "Engineering", ["dashboard", "admin", "charts"], "Mar 20, 2026"),
        new(3, "E-commerce Product Page", "Product gallery, variant selector, reviews section, and related products", "E-commerce", "published", "v1.8", 2890, "Design Team", ["ecommerce", "product", "gallery"], "Mar 18, 2026"),
        new(4, "Blog Article Layout", "Article header, content body with TOC, author bio, and related posts", "Content", "published", "v2.0", 1560, "Content Team", ["blog", "article", "reading"], "Mar 15, 2026"),
        new(5, "Onboarding Wizard", "Multi-step form with progress bar, validation, and success screen", "Application", "draft", "v1.0", 0, "Product Team", ["onboarding", "wizard", "forms"], "Mar 24, 2026"),
        new(6, "Email Newsletter", "Responsive email template with header, content blocks, and footer", "Email", "published", "v1.5", 890, "Marketing", ["email", "newsletter", "responsive"], "Mar 12, 2026"),
        new(7, "Portfolio Showcase", "Filterable project grid, lightbox gallery, and contact form", "Marketing", "archived", "v1.2", 2100, "Design Team", ["portfolio", "gallery", "creative"], "Jan 20, 2026"),
    ];

    private static string GetStatusColor(string status) => status switch
    {
        "published" => "bg-emerald-500",
        "draft" => "bg-amber-500",
        "archived" => "bg-muted-foreground/40",
        _ => "bg-muted-foreground/40",
    };

    private void HandleDelete(int id)
    {
        _templates = _templates.Where(t => t.Id != id).ToList();
    }

    private void HandlePublish(int id)
    {
        _templates = _templates.Select(t => t.Id == id ? t with { Status = "published" } : t).ToList();
    }

    private void HandleArchive(int id)
    {
        _templates = _templates.Select(t => t.Id == id ? t with { Status = "archived" } : t).ToList();
    }
}
