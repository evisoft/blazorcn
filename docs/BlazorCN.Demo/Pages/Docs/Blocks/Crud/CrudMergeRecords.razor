@* ============================================================
   Block: crud-merge-records
   Title: Crud Merge Records
   Description: Compare and merge duplicate records by selecting preferred field values
   Dependencies: ButtonCn, LabelCn, RadioGroupCn
   Source: original/blocks/crud/crud-merge-records.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Merge Duplicate Records</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Select which values to keep for each field</p>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="text-muted-foreground">Primary:</span>
                    <span class="font-medium">@_primary.Id</span>
                </div>
            </div>
        </div>

        <div class="border-b bg-muted/30 px-4 py-2">
            <div class="grid grid-cols-2 gap-4">
                <div class="text-xs text-muted-foreground">
                    <span class="size-1.5 inline-block rounded-full bg-blue-500 align-middle"></span>
                    Primary Record
                </div>
                <div class="text-xs text-muted-foreground">
                    <span class="size-1.5 inline-block rounded-full bg-muted-foreground/40 align-middle"></span>
                    Secondary Record
                </div>
            </div>
        </div>

        <div class="divide-y">
            <div class="px-4 py-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucideUserCn Class="size-3.5 text-muted-foreground" Size="14" />
                    <LabelCn Class="text-xs font-medium">Name</LabelCn>
                </div>
                <RadioGroupCn Value="@_selectedName" ValueChanged="@(v => _selectedName = v ?? "primary")">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="primary" Id="name-primary" />
                            <LabelCn For="name-primary" Class="flex-1 cursor-pointer text-sm">@_primary.Name</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="secondary" Id="name-secondary" />
                            <LabelCn For="name-secondary" Class="flex-1 cursor-pointer text-sm">@_secondary.Name</LabelCn>
                        </div>
                    </div>
                </RadioGroupCn>
            </div>

            <div class="px-4 py-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucideMailCn Class="size-3.5 text-muted-foreground" Size="14" />
                    <LabelCn Class="text-xs font-medium">Email</LabelCn>
                </div>
                <RadioGroupCn Value="@_selectedEmail" ValueChanged="@(v => _selectedEmail = v ?? "primary")">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="primary" Id="email-primary" />
                            <LabelCn For="email-primary" Class="flex-1 cursor-pointer font-mono text-sm">@_primary.Email</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="secondary" Id="email-secondary" />
                            <LabelCn For="email-secondary" Class="flex-1 cursor-pointer font-mono text-sm">@_secondary.Email</LabelCn>
                        </div>
                    </div>
                </RadioGroupCn>
            </div>

            <div class="px-4 py-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucidePhoneCn Class="size-3.5 text-muted-foreground" Size="14" />
                    <LabelCn Class="text-xs font-medium">Phone</LabelCn>
                </div>
                <RadioGroupCn Value="@_selectedPhone" ValueChanged="@(v => _selectedPhone = v ?? "primary")">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="primary" Id="phone-primary" />
                            <LabelCn For="phone-primary" Class="flex-1 cursor-pointer font-mono text-sm">@_primary.Phone</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="secondary" Id="phone-secondary" />
                            <LabelCn For="phone-secondary" Class="flex-1 cursor-pointer font-mono text-sm">@_secondary.Phone</LabelCn>
                        </div>
                    </div>
                </RadioGroupCn>
            </div>

            <div class="px-4 py-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucideMapPinCn Class="size-3.5 text-muted-foreground" Size="14" />
                    <LabelCn Class="text-xs font-medium">Address</LabelCn>
                </div>
                <RadioGroupCn Value="@_selectedAddress" ValueChanged="@(v => _selectedAddress = v ?? "primary")">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="primary" Id="address-primary" />
                            <LabelCn For="address-primary" Class="flex-1 cursor-pointer text-sm">@_primary.Address</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="secondary" Id="address-secondary" Disabled="@string.IsNullOrEmpty(_secondary.Address)" />
                            <LabelCn For="address-secondary" Class="flex-1 cursor-pointer text-sm text-muted-foreground">@(string.IsNullOrEmpty(_secondary.Address) ? "Not set" : _secondary.Address)</LabelCn>
                        </div>
                    </div>
                </RadioGroupCn>
            </div>

            <div class="px-4 py-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucideCalendarCn Class="size-3.5 text-muted-foreground" Size="14" />
                    <LabelCn Class="text-xs font-medium">Created Date</LabelCn>
                </div>
                <RadioGroupCn Value="@_selectedCreatedAt" ValueChanged="@(v => _selectedCreatedAt = v ?? "primary")">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="primary" Id="created-primary" />
                            <LabelCn For="created-primary" Class="flex-1 cursor-pointer text-sm">@_primary.CreatedAt</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="secondary" Id="created-secondary" />
                            <LabelCn For="created-secondary" Class="flex-1 cursor-pointer text-sm">@_secondary.CreatedAt</LabelCn>
                        </div>
                    </div>
                </RadioGroupCn>
            </div>
        </div>

        <div class="border-t bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2 rounded-md bg-blue-500/10 px-3 py-2 text-xs">
                <LucideAlertCircleCn Class="size-3.5 text-blue-500" Size="14" />
                <span class="text-muted-foreground">
                    The merged record will use ID
                    <span class="font-medium text-foreground">@_primary.Id</span>. The secondary record will be archived.
                </span>
            </div>
        </div>

        <div class="flex items-center justify-between gap-3 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 text-xs">Cancel</ButtonCn>
            <ButtonCn Class="h-7 text-xs">Merge Records</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MergeRecord(string Id, string Name, string Email, string Phone, string Address, string CreatedAt);

    private string _selectedName = "primary";
    private string _selectedEmail = "primary";
    private string _selectedPhone = "primary";
    private string _selectedAddress = "primary";
    private string _selectedCreatedAt = "primary";

    private static readonly MergeRecord _primary = new("USR-1001", "Sarah Chen", "sarah.chen@@company.com", "+1 (555) 123-4567", "123 Market St, San Francisco, CA 94103", "2024-01-15");
    private static readonly MergeRecord _secondary = new("USR-1847", "Sarah Chen", "s.chen@@company.com", "+1 (555) 123-4567", "", "2024-08-22");
}
