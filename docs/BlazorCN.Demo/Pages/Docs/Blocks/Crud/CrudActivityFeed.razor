@* ============================================================
   Block: crud-activity-feed
   Title: Crud Activity Feed
   Description: CRUD activity feed with timeline showing record changes, user actions, system events, and timestamps for audit trail and collaboration
   Long Description: Detail view with activity timeline
   Dependencies: AvatarCn, ButtonCn, SelectCn
   Source: original/blocks/crud/crud-activity-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Activity Feed</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Track changes across your workspace
                </p>
            </div>
            <div class="flex items-center gap-2">
                <SelectCn Value="all">
                    <SelectTriggerCn aria-label="Filter by type" Class="h-7 w-28 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="all">All Types</SelectItemCn>
                        <SelectItemCn Value="edit">Edits</SelectItemCn>
                        <SelectItemCn Value="create">Created</SelectItemCn>
                        <SelectItemCn Value="delete">Deleted</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                <SelectCn>
                    <SelectTriggerCn aria-label="Filter by user" Class="h-7 w-28 text-xs">
                        <SelectValueCn Placeholder="All users" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="all">All Users</SelectItemCn>
                        <SelectItemCn Value="sarah">Sarah Chen</SelectItemCn>
                        <SelectItemCn Value="mike">Mike Johnson</SelectItemCn>
                        <SelectItemCn Value="emma">Emma Davis</SelectItemCn>
                        <SelectItemCn Value="david">David Lee</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Today *@
        <div>
            <div class="border-b bg-muted/30 px-4 py-1.5">
                <span class="text-xs font-medium text-muted-foreground">Today</span>
            </div>
            @for (var i = 0; i < 3 && i < _activities.Length; i++)
            {
                var activity = _activities[i];
                var showLine = i < 2;
                <div class="flex gap-3 px-4 py-3">
                    <div class="relative flex flex-col items-center">
                        @if (!string.IsNullOrEmpty(activity.Avatar))
                        {
                            <AvatarCn Class="size-8">
                                <AvatarImageCn Alt="@activity.UserName" Src="@activity.Avatar" />
                                <AvatarFallbackCn>@activity.UserName[0]</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        else
                        {
                            <div class="flex size-8 items-center justify-center rounded-full bg-muted/50">
                                <LucideIconCn Name="@activity.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                        }
                        @if (showLine)
                        {
                            <div class="absolute top-8 mt-1 h-[calc(100%-2rem)] w-px bg-border"></div>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm">
                            <span class="font-medium">@activity.UserName</span>
                            <span class="text-muted-foreground"> @activity.Action </span>
                            <span class="font-medium">@activity.Resource</span>
                        </p>
                        @if (!string.IsNullOrEmpty(activity.Details))
                        {
                            <p class="mt-0.5 text-xs text-muted-foreground">@activity.Details</p>
                        }
                        <p class="mt-0.5 text-xs text-muted-foreground/60">@activity.Time</p>
                    </div>
                </div>
            }
        </div>

        @* Yesterday *@
        <div>
            <div class="border-b border-t bg-muted/30 px-4 py-1.5">
                <span class="text-xs font-medium text-muted-foreground">Yesterday</span>
            </div>
            @for (var i = 3; i < _activities.Length; i++)
            {
                var activity = _activities[i];
                var showLine = i < _activities.Length - 1;
                <div class="flex gap-3 px-4 py-3">
                    <div class="relative flex flex-col items-center">
                        @if (!string.IsNullOrEmpty(activity.Avatar))
                        {
                            <AvatarCn Class="size-8">
                                <AvatarImageCn Alt="@activity.UserName" Src="@activity.Avatar" />
                                <AvatarFallbackCn>@activity.UserName[0]</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        else
                        {
                            <div class="flex size-8 items-center justify-center rounded-full bg-muted/50">
                                <LucideIconCn Name="@activity.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                        }
                        @if (showLine)
                        {
                            <div class="absolute top-8 mt-1 h-[calc(100%-2rem)] w-px bg-border"></div>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm">
                            <span class="font-medium">@activity.UserName</span>
                            <span class="text-muted-foreground"> @activity.Action </span>
                            <span class="font-medium">@activity.Resource</span>
                        </p>
                        @if (!string.IsNullOrEmpty(activity.Details))
                        {
                            <p class="mt-0.5 text-xs text-muted-foreground">@activity.Details</p>
                        }
                        <p class="mt-0.5 text-xs text-muted-foreground/60">@activity.Time</p>
                    </div>
                </div>
            }
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-t bg-muted/30 px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                Today <span class="font-medium text-foreground">23</span>
            </span>
            <span class="size-1 rounded-full bg-border"></span>
            <span class="text-xs text-muted-foreground">
                This week <span class="font-medium text-foreground">156</span>
            </span>
            <span class="size-1 rounded-full bg-border"></span>
            <span class="text-xs text-muted-foreground">
                This month <span class="font-medium text-foreground">847</span>
            </span>
        </div>

        <div class="border-t px-4 py-2">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                <LucideChevronDownCn Size="12" Class="mr-1.5 size-3.5" />
                Load More
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ActivityItem(string UserName, string Avatar, string Action, string Resource, string Type, string Time, string? Details, string Icon);

    private readonly ActivityItem[] _activities =
    [
        new("Sarah Chen", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&auto=format&fit=crop", "updated", "Premium Headphones", "edit", "2 hours ago", "Changed price from $399 to $349", "pencil"),
        new("Mike Johnson", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&auto=format&fit=crop", "created", "Wireless Mouse", "create", "4 hours ago", null, "plus"),
        new("Emma Davis", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&auto=format&fit=crop", "assigned", "Order #1234", "assign", "6 hours ago", "Assigned to David Lee", "user-plus"),
        new("David Lee", "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&h=100&auto=format&fit=crop", "commented on", "Design Review", "comment", "1 day ago", "Looks great! Ready to proceed.", "file-text"),
        new("Admin System", "", "deleted", "Old Product SKU-123", "delete", "2 days ago", null, "trash"),
    ];
}
