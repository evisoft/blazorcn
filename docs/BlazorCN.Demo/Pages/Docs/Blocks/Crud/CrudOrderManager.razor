@* ============================================================
   Block: crud-order-manager
   Title: CrudOrderManager
   Description: Order processing management with status tracking, customer details, payment info, and fulfillment workflow
   Source: original/blocks/crud/crud-order-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucidePackageCn Class="size-4 text-muted-foreground" Size="16" />
                    <div>
                        <h2 class="text-sm font-medium">Orders</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_orders.Count orders · @FormatCurrency(_totalRevenue) revenue
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucidePlusCn Class="size-3.5" Size="14" />
                    Create Order
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" Size="14" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search orders..."
                         @bind-Value="_search" aria-label="Search orders" />
            </div>
            <div class="flex gap-1">
                @foreach (var s in new[] { "all", "pending", "processing", "shipped", "delivered" })
                {
                    var filterVal = s;
                    <button type="button" @onclick="@(() => _filter = filterVal)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == filterVal ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @(char.ToUpper(s[0]) + s[1..])
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var order in _filtered)
            {
                var statusColor = _statusConfig.TryGetValue(order.Status, out var cfg) ? cfg : "bg-muted-foreground";
                var ord = order;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", statusColor)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-medium">@order.OrderNumber</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">
                                    @order.Status
                                </BadgeCn>
                                <span class="ml-auto text-sm font-medium tabular-nums">
                                    @FormatCurrency(order.Total)
                                </span>
                            </div>
                            <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@order.Customer</span>
                                <span>·</span>
                                <span>@order.Email</span>
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                <span class="tabular-nums">@order.Items items</span>
                                <span>·</span>
                                <span>@order.Payment</span>
                                <span>·</span>
                                <span>@order.ShippingMethod</span>
                                <span>·</span>
                                <span>@order.Date</span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                    <LucideEllipsisCn Class="size-4" Size="16" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>View Details</DropdownMenuItemCn>
                                @if (ord.Status == "pending")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => UpdateStatus(ord.Id, "processing"))">
                                        Process Order
                                    </DropdownMenuItemCn>
                                }
                                @if (ord.Status == "processing")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => UpdateStatus(ord.Id, "shipped"))">
                                        Mark Shipped
                                    </DropdownMenuItemCn>
                                }
                                @if (ord.Status == "shipped")
                                {
                                    <DropdownMenuItemCn OnClick="@(() => UpdateStatus(ord.Id, "delivered"))">
                                        Mark Delivered
                                    </DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn>Print Label</DropdownMenuItemCn>
                                @if (ord.Status != "cancelled" && ord.Status != "delivered")
                                {
                                    <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => UpdateStatus(ord.Id, "cancelled"))">
                                        Cancel Order
                                    </DropdownMenuItemCn>
                                }
                                <DropdownMenuItemCn Class="text-destructive" OnClick="@(() => DeleteOrder(ord.Id))">
                                    <LucideTrashCn Class="mr-2 size-4" Size="16" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (_filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No orders found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Order(int Id, string OrderNumber, string Customer, string Email, string Status, int Items, double Total, string Payment, string Date, string ShippingMethod);

    private string _search = "";
    private string _filter = "all";

    private List<Order> _orders = new(InitialOrders);

    private Order[] _filtered => _orders
        .Where(o => _filter == "all" || o.Status == _filter)
        .Where(o => o.OrderNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || o.Customer.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private double _totalRevenue => _orders
        .Where(o => o.Status != "cancelled")
        .Sum(o => o.Total);

    private static string FormatCurrency(double n) => $"${n:F2}";

    private void DeleteOrder(int id) => _orders.RemoveAll(o => o.Id == id);

    private void UpdateStatus(int id, string status)
    {
        var idx = _orders.FindIndex(o => o.Id == id);
        if (idx >= 0)
            _orders[idx] = _orders[idx] with { Status = status };
    }

    private static readonly Dictionary<string, string> _statusConfig = new()
    {
        ["pending"]    = "bg-amber-500",
        ["processing"] = "bg-blue-500",
        ["shipped"]    = "bg-emerald-500",
        ["delivered"]  = "bg-emerald-500",
        ["cancelled"]  = "bg-red-500",
    };

    private static readonly Order[] InitialOrders =
    [
        new(1, "ORD-2026-1847", "Rachel Kim",   "rachel@example.com", "processing", 3, 189.97, "Visa ****4242",        "Mar 24, 2026", "Express 2-day"),
        new(2, "ORD-2026-1846", "James Porter", "james@example.com",  "shipped",    1,  49.99, "PayPal",               "Mar 23, 2026", "Standard 5-7 days"),
        new(3, "ORD-2026-1845", "Mia Zhang",    "mia@example.com",    "pending",    5, 324.50, "Mastercard ****8888",  "Mar 24, 2026", "Express 2-day"),
        new(4, "ORD-2026-1844", "David Chen",   "david@example.com",  "delivered",  2,  89.98, "Visa ****1234",        "Mar 20, 2026", "Standard 5-7 days"),
        new(5, "ORD-2026-1843", "Sarah Lewis",  "sarah@example.com",  "cancelled",  1, 149.00, "Amex ****3456",        "Mar 19, 2026", "Overnight"),
        new(6, "ORD-2026-1842", "Tom Bradley",  "tom@example.com",    "processing", 4, 267.96, "Visa ****7890",        "Mar 23, 2026", "Express 2-day"),
    ];
}
