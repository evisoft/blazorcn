@* ============================================================
   Block: crud-content-calendar
   Title: Content Calendar List
   Description: Content scheduling in list view with platform filters and status tracking
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/crud/crud-content-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">Content Calendar</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Schedule New
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <div class="relative flex-1">
                    <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                    <InputCn type="text" Placeholder="Search content or author..." Value="@_searchQuery" Class="h-8 pl-8 text-xs" />
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideFilterCn Size="14" Class="size-3.5" />
                    Filter
                </ButtonCn>
            </div>

            <div class="flex flex-wrap gap-2">
                @foreach (var platform in _platforms)
                {
                    <button type="button"
                            @onclick="@(() => _selectedPlatform = platform)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _selectedPlatform == platform ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                        @platform
                    </button>
                }
            </div>
        </div>

        <div>
            @{
                var filteredContent = _contentItems.Where(item =>
                    (_selectedPlatform == "All" || item.Platform == _selectedPlatform) &&
                    (string.IsNullOrEmpty(_searchQuery) ||
                     item.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     item.Author.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
            }
            @if (filteredContent.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <p class="text-sm text-muted-foreground">No content found matching your filters</p>
                </div>
            }
            else
            {
                <div>
                    @for (var i = 0; i < filteredContent.Count; i++)
                    {
                        var item = filteredContent[i];
                        var isLast = i == filteredContent.Count - 1;
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetStatusColor(item.Status))"></span>
                            <div class="min-w-0 flex-1">
                                <div class="mb-1 flex items-start justify-between gap-3">
                                    <span class="text-sm font-medium">@item.Title</span>
                                    <span class="shrink-0 text-xs text-muted-foreground">@item.ScheduledDate</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 rounded-md px-1.5 text-xs">
                                        @item.Platform
                                    </BadgeCn>
                                    <span class="text-xs text-muted-foreground">@item.Author</span>
                                    <span class="text-xs text-muted-foreground">&#x2022;</span>
                                    <span class="text-xs text-muted-foreground">@item.Status</span>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ContentItem(string Id, string Title, string Platform, string Status, string Author, string ScheduledDate);

    private string _selectedPlatform = "All";
    private string _searchQuery = "";
    private static readonly string[] _platforms = ["All", "Blog", "Twitter", "LinkedIn", "Instagram"];

    private readonly List<ContentItem> _contentItems =
    [
        new("1", "Q1 Product Roadmap Announcement", "Blog", "Scheduled", "Sarah Chen", "Today, 2:00 PM"),
        new("2", "New feature launch thread", "Twitter", "Scheduled", "Mike Torres", "Today, 4:30 PM"),
        new("3", "Engineering team hiring post", "LinkedIn", "Draft", "Emily Rodriguez", "Tomorrow, 9:00 AM"),
        new("4", "Customer success story", "Blog", "Published", "Sarah Chen", "Yesterday, 10:00 AM"),
        new("5", "Behind the scenes team photo", "Instagram", "Scheduled", "Alex Kim", "Tomorrow, 3:00 PM"),
        new("6", "Industry insights newsletter", "Blog", "Draft", "Sarah Chen", "Mar 18, 8:00 AM"),
        new("7", "Product tip of the day", "Twitter", "Scheduled", "Mike Torres", "Mar 19, 11:00 AM"),
        new("8", "Thought leadership article", "LinkedIn", "Draft", "Emily Rodriguez", "Mar 20, 2:00 PM"),
    ];

    private static string GetStatusColor(string status) => status switch
    {
        "Scheduled" => "bg-amber-500",
        "Draft" => "bg-zinc-400",
        "Published" => "bg-emerald-500",
        _ => "bg-zinc-400",
    };
}
