@* ============================================================
   Block: crud-notification-rules
   Title: Crud Notification Rules
   Description: Configure notification rules with triggers, channels, and conditions
   Long Description: A comprehensive notification rule management interface. Define when and how users receive notifications across multiple channels with conditional logic and priority settings.
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/crud/crud-notification-rules.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Notification Rules</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Configure when and how notifications are sent
                    </p>
                </div>
                <ButtonCn Class="h-7 gap-1.5 text-xs">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Add Rule
                </ButtonCn>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var rule in _rules)
            {
                <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetPriorityColor(rule.Priority))"></span>
                                <span class="font-medium text-sm">@rule.Name</span>
                                <span class="text-muted-foreground text-xs">on @rule.Trigger</span>
                            </div>

                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                @foreach (var channel in rule.Channels)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 gap-1 text-xs">
                                        @channel
                                    </BadgeCn>
                                }
                            </div>

                            <div class="mt-2 font-mono text-muted-foreground text-xs">
                                @rule.Conditions
                            </div>
                        </div>

                        <div class="flex shrink-0 items-center gap-2">
                            <ButtonCn Variant="ButtonVariant.Ghost" Class="h-6 px-2 text-xs">
                                Edit
                            </ButtonCn>
                            <SwitchCn Checked="@rule.Enabled" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-muted-foreground">Critical</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-muted-foreground">High</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span class="text-muted-foreground">Medium</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="text-muted-foreground">Low</span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideBellCn Size="14" Class="size-3.5" />
                <span>
                    @_rules.Count(r => r.Enabled) of @_rules.Count rules active
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Test Rules
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record NotificationRule(string Id, string Name, string Trigger, string[] Channels, string Conditions, string Priority, bool Enabled);

    private readonly List<NotificationRule> _rules =
    [
        new("rule-1", "High-Value Orders", "New Order", ["email", "slack"], "Amount > $5,000", "high", true),
        new("rule-2", "Critical Stock Alert", "Low Stock", ["email", "slack", "sms"], "Quantity < 10 units", "critical", true),
        new("rule-3", "New User Welcome", "User Signup", ["email"], "Always", "medium", true),
        new("rule-4", "System Error Alert", "Error", ["slack", "sms"], "Severity = critical", "critical", true),
        new("rule-5", "Weekly Reports", "Scheduled", ["email"], "Every Monday 9am", "low", false),
    ];

    private static string GetPriorityColor(string priority) => priority switch
    {
        "critical" => "bg-red-500",
        "high" => "bg-amber-500",
        "medium" => "bg-blue-500",
        "low" => "bg-muted-foreground/40",
        _ => "bg-muted",
    };
}
