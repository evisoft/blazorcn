@* ============================================================
   Block: crud-kanban-board
   Title: Crud Kanban Board
   Description: CRUD kanban board with columns for status management, card preview, and inline actions
   Dependencies: AvatarCn, BadgeCn, ButtonCn, DropdownMenuCn
   Source: original/blocks/crud/crud-kanban-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-6 py-5">
            <div>
                <h2 class="text-sm font-medium">Project Board</h2>
                <p class="mt-1 text-xs text-muted-foreground">Drag cards between columns to update status</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                <LucidePlusCn Class="mr-2 h-4 w-4" Size="16" />
                New Task
            </ButtonCn>
        </div>

        <div class="grid grid-cols-1 gap-4 p-6 md:grid-cols-2 lg:grid-cols-4">
            @foreach (var column in _columns)
            {
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="@Cn.Merge("h-2 w-2 rounded-full", column.Color)"></div>
                            <span class="text-sm font-medium">@column.Title</span>
                            <span class="text-xs text-muted-foreground">@column.Items.Length</span>
                        </div>
                        <ButtonCn Class="h-7 w-7" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Add">
                            <LucidePlusCn Class="h-4 w-4" Size="16" />
                        </ButtonCn>
                    </div>

                    <div class="space-y-3">
                        @foreach (var item in column.Items)
                        {
                            <div class="cursor-move rounded-lg border bg-card p-4 transition-colors hover:bg-muted/50">
                                <div class="flex items-start justify-between gap-2">
                                    <span class="line-clamp-2 text-sm font-medium">@item.Title</span>
                                    <DropdownMenuCn>
                                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon -mt-1 h-6 w-6" data-variant="ghost" data-size="icon" aria-label="More options">
                                                <LucideEllipsisCn Class="h-4 w-4" Size="16" />
                                            </DropdownMenuTriggerCn>
                                        <DropdownMenuContentCn Align="FloatingAlign.End">
                                            <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                            <DropdownMenuItemCn>Assign</DropdownMenuItemCn>
                                            <DropdownMenuItemCn>Move to...</DropdownMenuItemCn>
                                            <DropdownMenuItemCn Class="text-destructive">Delete</DropdownMenuItemCn>
                                        </DropdownMenuContentCn>
                                    </DropdownMenuCn>
                                </div>

                                <div class="mt-3 flex flex-wrap gap-1">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@tag</BadgeCn>
                                    }
                                </div>

                                <div class="mt-3 flex items-center justify-between">
                                    <AvatarCn Class="h-6 w-6">
                                        <AvatarFallbackCn Class="text-xs">@item.AssigneeInitial</AvatarFallbackCn>
                                    </AvatarCn>
                                    <BadgeCn Class="text-xs" Variant="@(item.Priority == "high" ? BadgeVariant.Destructive : item.Priority == "medium" ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                        @item.Priority
                                    </BadgeCn>
                                </div>
                            </div>
                        }

                        @if (column.Items.Length == 0)
                        {
                            <div class="rounded-lg border border-dashed p-8 text-center">
                                <p class="text-xs text-muted-foreground">Drop items here</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record KanbanItem(int Id, string Title, string AssigneeName, string AssigneeInitial, string Priority, string[] Tags);
    private record KanbanColumn(string Id, string Title, string Color, KanbanItem[] Items);

    private static readonly KanbanColumn[] _columns =
    [
        new("todo", "To Do", "bg-slate-500",
        [
            new(1, "Design new landing page", "Sarah Chen", "S", "high", ["Design", "Marketing"]),
            new(2, "Update documentation", "Mike Johnson", "M", "medium", ["Docs"]),
        ]),
        new("progress", "In Progress", "bg-blue-500",
        [
            new(3, "Implement user authentication", "Emma Davis", "E", "high", ["Backend", "Security"]),
        ]),
        new("review", "Review", "bg-orange-500",
        [
            new(4, "API endpoint optimization", "David Lee", "D", "medium", ["Backend"]),
        ]),
        new("done", "Done", "bg-green-500",
        [
            new(5, "Set up CI/CD pipeline", "Alex Morgan", "A", "low", ["DevOps"]),
            new(6, "Database migration", "Sarah Chen", "S", "high", ["Backend"]),
        ]),
    ];
}
