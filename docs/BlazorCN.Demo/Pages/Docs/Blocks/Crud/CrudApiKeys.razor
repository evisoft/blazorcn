@* ============================================================
   Block: crud-api-keys
   Title: Crud Api Keys
   Description: Secure API key manager with creation, revocation, and usage tracking
   Dependencies: BadgeCn, ButtonCn, DropdownMenuCn, InputCn, SelectCn
   Source: original/blocks/crud/crud-api-keys.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">API Keys</h2>
                    <p class="mt-1 text-xs text-muted-foreground">Manage API keys for secure application access</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs"
                          OnClick="@(() => _showCreate = !_showCreate)">
                    <LucidePlusCn Class="size-3.5" Size="14" />
                    Create Key
                </ButtonCn>
            </div>
        </div>

        @if (_showCreate)
        {
            <div class="border-b bg-muted/50 px-6 py-4">
                <div class="space-y-3">
                    <div>
                        <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Key Name</span>
                        <InputCn placeholder="e.g., Production API, Mobile App" @bind-Value="_newKeyName"
                                 Class="h-8 border-0 bg-background text-xs shadow-none focus-visible:ring-1" />
                    </div>
                    <div>
                        <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Scope</span>
                        <SelectCn Value="@_newKeyScope" ValueChanged="@((string v) => _newKeyScope = v)">
                            <SelectTriggerCn Class="h-8 border-0 bg-background text-xs shadow-none focus:ring-1">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="read-only">Read Only</SelectItemCn>
                                <SelectItemCn Value="read-write">Read &amp; Write</SelectItemCn>
                                <SelectItemCn Value="admin">Admin</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="CreateKey">
                            <LucideCheckCn Class="size-3.5" Size="14" />
                            Create
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs"
                                  OnClick="@(() => { _showCreate = false; _newKeyName = ""; _newKeyScope = "read-only"; })">
                            Cancel
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        <div>
            @for (var i = 0; i < _keys.Count; i++)
            {
                var key = _keys[i];
                <div class="@Cn.Merge("px-6 py-4", i != _keys.Count - 1 ? "border-b" : "")">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@key.Name</span>
                                @if (key.Status == "active")
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                                else
                                {
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                }
                            </div>
                            <div class="mt-1.5 flex items-center gap-3">
                                <code class="font-mono text-xs text-muted-foreground">@key.Prefix</code>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-xs">@key.Scope</BadgeCn>
                            </div>
                            <div class="mt-2 flex items-center gap-4 text-xs text-muted-foreground">
                                <span>Created @key.Created</span>
                                <span>&bull;</span>
                                <span>Last used @(key.LastUsed ?? "Never")</span>
                                <span>&bull;</span>
                                <span>@key.Requests.ToString("N0") requests</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1">
                            @if (key.Status == "active")
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                                          OnClick="@(() => CopyKey(key.Id))">
                                    @if (_copiedId == key.Id)
                                    {
                                        <LucideCheckCn Class="size-3.5" Size="14" />
                                        <text>Copied</text>
                                    }
                                    else
                                    {
                                        <LucideCopyCn Class="size-3.5" Size="14" />
                                        <text>Copy</text>
                                    }
                                </ButtonCn>
                            }
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                                        <LucideChevronDownCn Class="size-4" Size="16" />
                                    </ButtonCn>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                    @if (key.Status == "active")
                                    {
                                        <DropdownMenuItemCn Class="text-red-600" OnClick="@(() => RevokeKey(key.Id))">
                                            <LucideTrashCn Class="mr-2 size-3.5" Size="14" />
                                            Revoke
                                        </DropdownMenuItemCn>
                                    }
                                    @if (key.Status == "revoked")
                                    {
                                        <DropdownMenuItemCn Disabled="true">
                                            <LucideTrashCn Class="mr-2 size-3.5" Size="14" />
                                            Already Revoked
                                        </DropdownMenuItemCn>
                                    }
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-6 py-3">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideKeyCn Class="size-3.5" Size="14" />
                <span>@_keys.Count(k => k.Status == "active") active keys &bull; @_keys.Sum(k => k.Requests).ToString("N0") total requests</span>
            </div>
        </div>
    </div>
</section>

@code {
    private class ApiKey
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Prefix { get; set; } = "";
        public string Created { get; set; } = "";
        public string? LastUsed { get; set; }
        public string Status { get; set; } = "active";
        public string Scope { get; set; } = "read-only";
        public int Requests { get; set; }
    }

    private bool _showCreate;
    private string _newKeyName = "";
    private string _newKeyScope = "read-only";
    private string? _copiedId;

    private List<ApiKey> _keys =
    [
        new() { Id = "1", Name = "Production API", Prefix = "sk-prod...x7k2", Created = "Feb 15, 2024", LastUsed = "2 hours ago", Status = "active", Scope = "read-write", Requests = 1247 },
        new() { Id = "2", Name = "Mobile App", Prefix = "sk-mob...j9m4", Created = "Jan 28, 2024", LastUsed = "5 min ago", Status = "active", Scope = "read-only", Requests = 8932 },
        new() { Id = "3", Name = "Analytics Service", Prefix = "sk-anl...p3w1", Created = "Jan 10, 2024", LastUsed = "Yesterday", Status = "active", Scope = "read-only", Requests = 4521 },
        new() { Id = "4", Name = "Legacy Integration", Prefix = "sk-leg...h8n6", Created = "Dec 5, 2023", LastUsed = "Never", Status = "revoked", Scope = "admin", Requests = 0 },
    ];

    private void CopyKey(string id) => _copiedId = id;

    private void RevokeKey(string id)
    {
        var key = _keys.FirstOrDefault(k => k.Id == id);
        if (key != null) key.Status = "revoked";
    }

    private void CreateKey()
    {
        if (string.IsNullOrWhiteSpace(_newKeyName)) return;
        _keys.Insert(0, new ApiKey
        {
            Id = $"key-{_keys.Count + 1}",
            Name = _newKeyName,
            Prefix = $"sk-new...{Random.Shared.Next(1000, 9999)}",
            Created = "Just now",
            LastUsed = null,
            Status = "active",
            Scope = _newKeyScope,
            Requests = 0,
        });
        _newKeyName = "";
        _newKeyScope = "read-only";
        _showCreate = false;
    }
}
