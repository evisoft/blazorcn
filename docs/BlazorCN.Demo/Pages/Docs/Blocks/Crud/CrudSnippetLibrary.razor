@* ============================================================
   Block: crud-snippet-library
   Title: CrudSnippetLibrary
   Description: Code snippet library with syntax highlighting labels, language tags, copy functionality, and favorites
   Source: original/blocks/crud/crud-snippet-library.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Snippet Library</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_snippets.Count snippets · @_snippets.Count(s => s.Favorite) favorites
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    New Snippet
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search snippets..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" aria-label="Search snippets" />
            </div>
            <div class="flex gap-1">
                <button type="button"
                        @onclick="@(() => _filter = "all")"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "all" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                    All
                </button>
                @foreach (var folder in _folders)
                {
                    var f = folder;
                    <button type="button"
                            @onclick="@(() => _filter = f)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == f ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @f
                    </button>
                }
            </div>
        </div>

        <div>
            @foreach (var snippet in _filtered)
            {
                var snip = snippet;
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        @if (snip.Favorite)
                        {
                            <LucideIconCn Name="star" Size="14" Class="mt-0.5 size-3.5 shrink-0 fill-amber-500 text-amber-500" />
                        }
                        else
                        {
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@snip.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">
                                    @snip.Language
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="px-1.5 py-0 text-[10px]">
                                    @snip.Folder
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@snip.Description</p>
                            <div class="mt-1.5 rounded-md bg-zinc-950 p-2">
                                <code class="font-mono text-xs text-zinc-300">@snip.Code</code>
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                                @foreach (var tag in snip.Tags)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">
                                        @tag
                                    </span>
                                }
                                <span class="ml-1 text-xs text-muted-foreground">
                                    @snip.Uses uses · @snip.Author · @snip.LastUsed
                                </span>
                            </div>
                        </div>
                        <DropdownMenuCn>
                            <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon size-7 shrink-0" data-variant="ghost" data-size="icon" aria-label="More options">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                </DropdownMenuTriggerCn>
                            <DropdownMenuContentCn Align="FloatingAlign.End">
                                <DropdownMenuItemCn>Edit</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Copy Code</DropdownMenuItemCn>
                                <DropdownMenuItemCn @onclick="@(() => ToggleFavorite(snip.Id))">
                                    @(snip.Favorite ? "Unfavorite" : "Favorite")
                                </DropdownMenuItemCn>
                                <DropdownMenuItemCn>Move to Folder</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Duplicate</DropdownMenuItemCn>
                                <DropdownMenuItemCn Class="text-destructive" @onclick="@(() => DeleteSnippet(snip.Id))">
                                    <LucideIconCn Name="trash" Size="16" Class="mr-2 size-4" />
                                    Delete
                                </DropdownMenuItemCn>
                            </DropdownMenuContentCn>
                        </DropdownMenuCn>
                    </div>
                </div>
            }
            @if (!_filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No snippets found
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class SnippetItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Language { get; set; } = "";
        public string Code { get; set; } = "";
        public string Folder { get; set; } = "";
        public string[] Tags { get; set; } = [];
        public bool Favorite { get; set; }
        public int Uses { get; set; }
        public string LastUsed { get; set; } = "";
        public string Author { get; set; } = "";
    }

    private string _search = "";
    private string _filter = "all";

    private readonly List<SnippetItem> _snippets =
    [
        new() { Id = 1, Title = "React useDebounce Hook", Description = "Custom hook for debouncing values with configurable delay", Language = "TypeScript", Code = "function useDebounce<T>(value: T, delay: number): T { ... }", Folder = "Hooks", Tags = ["react", "hooks", "performance"], Favorite = true, Uses = 48, LastUsed = "Mar 24, 2026", Author = "Sarah Chen" },
        new() { Id = 2, Title = "Prisma Pagination Helper", Description = "Cursor-based pagination utility for Prisma queries", Language = "TypeScript", Code = "async function paginate<T>(model: any, options: PaginateOptions) { ... }", Folder = "Database", Tags = ["prisma", "pagination", "api"], Favorite = true, Uses = 32, LastUsed = "Mar 23, 2026", Author = "David Lee" },
        new() { Id = 3, Title = "Tailwind Container Query", Description = "Responsive container query setup with Tailwind CSS", Language = "CSS", Code = "@container (min-width: 640px) { .card { grid-template-columns: 1fr 1fr; } }", Folder = "Styles", Tags = ["tailwind", "css", "responsive"], Favorite = false, Uses = 15, LastUsed = "Mar 20, 2026", Author = "Emma Davis" },
        new() { Id = 4, Title = "Zod Form Schema Pattern", Description = "Reusable form validation schema with Zod and refinements", Language = "TypeScript", Code = "const formSchema = z.object({ email: z.string().email(), ... })", Folder = "Validation", Tags = ["zod", "forms", "validation"], Favorite = false, Uses = 28, LastUsed = "Mar 22, 2026", Author = "Mike Johnson" },
        new() { Id = 5, Title = "Next.js API Route with Auth", Description = "Authenticated API route handler with error handling and rate limiting", Language = "TypeScript", Code = "export async function POST(req: NextRequest) { const session = await auth(); ... }", Folder = "API", Tags = ["nextjs", "auth", "api"], Favorite = true, Uses = 56, LastUsed = "Mar 24, 2026", Author = "Sarah Chen" },
        new() { Id = 6, Title = "Docker Compose PostgreSQL", Description = "Docker Compose configuration for PostgreSQL with pgAdmin", Language = "YAML", Code = "services:\n  postgres:\n    image: postgres:16\n    ...", Folder = "DevOps", Tags = ["docker", "postgres", "devops"], Favorite = false, Uses = 12, LastUsed = "Mar 18, 2026", Author = "Tom Bradley" },
    ];

    private string[] _folders => _snippets.Select(s => s.Folder).Distinct().ToArray();

    private IEnumerable<SnippetItem> _filtered =>
        _snippets
            .Where(s => _filter == "all" || s.Folder == _filter)
            .Where(s =>
                s.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                s.Language.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                s.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(s => s.Favorite);

    private void DeleteSnippet(int id) => _snippets.RemoveAll(s => s.Id == id);

    private void ToggleFavorite(int id)
    {
        var s = _snippets.Find(x => x.Id == id);
        if (s != null) s.Favorite = !s.Favorite;
    }
}
