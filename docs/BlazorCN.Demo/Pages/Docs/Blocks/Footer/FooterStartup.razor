@* ============================================================
   Block: footer-startup
   Title: FooterStartup
   Description: A startup footer block for React and Next.js with bold brand statement, single-row navigation links, trust indicator badge, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-startup.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Brand statement *@
        <div class="border-b px-4 py-4 text-center">
            <p class="font-medium text-sm">
                Building the future of collaborative design
            </p>
        </div>

        @* Navigation links *@
        <div class="flex flex-wrap items-center justify-center gap-4 border-b px-4 py-3">
            @foreach (var link in _navLinks)
            {
                <a href="@link.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                    @link.Label
                </a>
            }
        </div>

        @* Trust note + copyright *@
        <div class="flex flex-col items-center gap-2 px-4 py-3">
            <p class="text-muted-foreground/70 text-xs">Backed by Y Combinator</p>
            <p class="text-muted-foreground text-xs">
                &copy; 2026 Acme Labs. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("Product", "#"),
        new("Pricing", "#"),
        new("Docs", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
    ];
}
