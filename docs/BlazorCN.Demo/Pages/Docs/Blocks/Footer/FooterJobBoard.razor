@* ============================================================
   Block: footer-job-board
   Title: FooterJobBoard
   Description: A hiring-focused footer block for React and Next.js with a we're hiring banner, open position badge, three link columns for jobs and company info, view all positions button, and copyright text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-job-board.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Hiring banner *@
        <div class="flex flex-col items-center gap-2 border-b px-4 py-3 text-center sm:flex-row sm:text-left">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">
                    We&apos;re hiring!
                </span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                    @_positionCount open positions
                </BadgeCn>
            </div>
            <p class="text-muted-foreground text-xs sm:ml-auto">
                Join our team and build the future of developer tools.
            </p>
        </div>

        @* Link columns *@
        <nav aria-label="Footer navigation" class="grid grid-cols-3 gap-6 border-b px-4 py-3">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@col.Heading</p>
                    <ul class="flex flex-col gap-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* CTA + Copyright *@
        <div class="flex flex-col items-center justify-between gap-3 px-4 py-3 sm:flex-row">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" AsChild="true">
                <a href="#">View all positions</a>
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const int _positionCount = 12;

    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Jobs", [new("Engineering", "#"), new("Design", "#"), new("Marketing", "#"), new("Sales", "#")]),
        new("Company", [new("About", "#"), new("Blog", "#"), new("Careers", "#"), new("Press", "#")]),
        new("Legal", [new("Privacy", "#"), new("Terms", "#"), new("Security", "#"), new("Cookies", "#")]),
    ];
}
