@* ============================================================
   Block: footer-badge-row
   Title: FooterBadgeRow
   Description: A React badge row footer block for Next.js with trust and technology chip indicators, two link columns, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-badge-row.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Badge row *@
    <div class="flex flex-wrap items-center gap-2 border-b px-4 py-4">
      <span class="mr-1 text-xs text-muted-foreground">Built with</span>
      @foreach (var badge in _badges)
      {
        <span class="inline-flex items-center rounded-md bg-muted/50 px-2 py-0.5 text-xs font-medium text-muted-foreground">
          @badge.Label
        </span>
      }
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Title
          </p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var link in col.Links)
            {
              <li>
                <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @link.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record BadgeItem(string Label);
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly BadgeItem[] _badges =
    [
        new("React"),
        new("Next.js"),
        new("TypeScript"),
        new("Tailwind"),
        new("Vercel"),
        new("AWS"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
    ];
}
