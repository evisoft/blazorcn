@* ============================================================
   Block: footer-map-location
   Title: FooterMapLocation
   Description: A location footer block for React and Next.js with visit us section, office hours, placeholder map area, navigation link columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-map-location.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Visit us header *@
    <div class="border-b px-4 py-3">
      <p class="text-sm font-medium">Visit us</p>
    </div>

    @* Address and hours *@
    <div class="flex flex-col gap-4 border-b px-4 py-3 sm:flex-row sm:gap-12">
      <div>
        <p class="mb-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Address
        </p>
        <p class="text-sm text-muted-foreground">123 Market Street</p>
        <p class="text-sm text-muted-foreground">San Francisco, CA 94105</p>
      </div>
      <div>
        <p class="mb-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Office hours
        </p>
        <p class="text-sm text-muted-foreground">Mon - Fri: 9:00 AM - 6:00 PM</p>
        <p class="text-sm text-muted-foreground">Sat - Sun: Closed</p>
      </div>
    </div>

    @* Map placeholder *@
    <div class="border-b px-4 py-4">
      <div class="flex h-40 items-center justify-center rounded-md border border-dashed bg-muted/30">
        <div class="flex flex-col items-center gap-1.5">
          <LucideIconCn Name="map-pin" Size="20" Class="size-5 text-muted-foreground/40" />
          <span class="text-xs text-muted-foreground/60">Map</span>
        </div>
      </div>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Heading
          </p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("API", "#"),
            new("Documentation", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
    ];
}
