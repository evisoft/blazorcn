@* ============================================================
   Block: footer-changelog
   Title: FooterChangelog
   Description: A React changelog footer block for Next.js with latest version updates, version badges, release descriptions, view all link, and navigation columns using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Changelog entries *@
        <div class="border-b px-4 py-3">
            <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Latest Updates
            </p>
            <div class="space-y-2.5">
                @foreach (var entry in _changelog)
                {
                    <div class="flex items-start gap-2.5">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono text-xs">@entry.Version</BadgeCn>
                        <p class="min-w-0 flex-1 text-sm text-muted-foreground">@entry.Description</p>
                        <span class="shrink-0 text-xs text-muted-foreground/60">@entry.Date</span>
                    </div>
                }
            </div>
            <div class="mt-3">
                <a href="#" class="inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                    View all updates
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </a>
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _columns)
            {
                <div>
                    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Heading
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Description, string Date);
    private record NavLink(string Label, string Href);
    private record NavColumn(string Heading, NavLink[] Links);

    private static readonly ChangelogEntry[] _changelog =
    [
        new("v3.2.0", "Added team collaboration with real-time cursors and presence indicators", "Mar 20"),
        new("v3.1.4", "Fixed webhook delivery retry logic and improved error reporting", "Mar 14"),
        new("v3.1.3", "Optimized dashboard query performance for large datasets", "Mar 8"),
    ];

    private static readonly NavColumn[] _columns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Documentation", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Blog", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];
}
