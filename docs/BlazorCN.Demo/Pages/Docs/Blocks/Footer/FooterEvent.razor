@* ============================================================
   Block: footer-event
   Title: FooterEvent
   Description: An event and conference footer block for React and Next.js with event details, three navigation columns, ticket button, sponsor acknowledgment, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-event.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Event name + link columns *@
    <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 md:grid-cols-2">

      @* Event details *@
      <div>
        <span class="font-medium text-sm">DevSummit 2026</span>
        <div class="mt-1 flex items-center gap-1.5">
          <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
          <span class="text-muted-foreground text-xs">
            September 15-17, 2026 &middot; San Francisco, CA
          </span>
        </div>
      </div>

      @* Link columns *@
      <div class="grid grid-cols-3 gap-6">
        @foreach (var col in _linkColumns)
        {
          var column = col;
          <div>
            <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
              @column.Title
            </p>
            <ul class="space-y-1.5">
              @foreach (var lnk in column.Items)
              {
                <li>
                  <a href="@lnk.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                    @lnk.Label
                  </a>
                </li>
              }
            </ul>
          </div>
        }
      </div>
    </div>

    @* Get Tickets button *@
    <div class="flex items-center gap-3 border-b px-4 py-3">
      <ButtonCn AsChild="true" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 px-4 text-xs">
        <a href="#">
          <LucideIconCn Name="ticket" Size="14" Class="size-3.5" />
          Get Tickets
        </a>
      </ButtonCn>
      <span class="text-muted-foreground text-xs">
        Early bird pricing available through August 1
      </span>
    </div>

    @* Sponsors *@
    <div class="flex flex-wrap items-center gap-2 border-b px-4 py-3">
      <span class="text-muted-foreground text-xs">Sponsored by</span>
      @foreach (var sponsor in _sponsors)
      {
        <span class="inline-flex items-center rounded-md bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground">
          @sponsor
        </span>
      }
    </div>

    @* Copyright *@
    <div class="flex items-center justify-between px-4 py-3">
      <p class="text-muted-foreground text-xs">
        &copy; 2026 DevSummit. All rights reserved.
      </p>
      <div class="flex items-center gap-3">
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Code of Conduct
        </a>
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Privacy
        </a>
      </div>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Schedule",
        [
            new("Day 1 Talks", "#"),
            new("Day 2 Workshops", "#"),
            new("Day 3 Keynotes", "#"),
            new("After Parties", "#"),
        ]),
        new("Speakers",
        [
            new("Keynote Speakers", "#"),
            new("Session Speakers", "#"),
            new("Panel Discussions", "#"),
            new("Call for Speakers", "#"),
        ]),
        new("Venue",
        [
            new("Directions", "#"),
            new("Hotels", "#"),
            new("Parking", "#"),
            new("FAQ", "#"),
        ]),
    ];

    private static readonly string[] _sponsors = ["Acme Corp", "TechFlow", "Nexus AI", "BuildKit"];
}
