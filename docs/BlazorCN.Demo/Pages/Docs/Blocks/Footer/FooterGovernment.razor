@* ============================================================
   Block: footer-government
   Title: FooterGovernment
   Description: A government and civic organization footer block for React and Next.js with official banner, three navigation columns, accessibility compliance note, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-government.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Official banner *@
    <div class="flex items-center gap-2 border-b bg-muted/50 px-4 py-2.5">
      <LucideIconCn Name="landmark" Size="14" Class="size-3.5 text-muted-foreground" />
      <span class="text-xs text-muted-foreground">
        An official website of the City of Greenfield
      </span>
    </div>

    @* Navigation columns *@
    <div class="border-b px-4 py-4">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        @foreach (var col in _linkColumns)
        {
          <div>
            <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@col.Title</p>
            <ul class="space-y-1.5">
              @foreach (var item in col.Items)
              {
                <li>
                  <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                    @item.Label
                  </a>
                </li>
              }
            </ul>
          </div>
        }
      </div>
    </div>

    @* Accessibility compliance *@
    <div class="border-b px-4 py-3">
      <p class="text-muted-foreground text-xs leading-relaxed">
        This website is committed to accessibility. We strive to meet WCAG 2.1 Level AA
        standards. If you experience difficulty accessing any content, please contact our
        accessibility coordinator.
      </p>
    </div>

    @* Copyright *@
    <div class="flex flex-col items-center justify-between gap-2 px-4 py-3 sm:flex-row">
      <p class="text-muted-foreground text-xs">
        &copy; 2026 City of Greenfield. All rights reserved.
      </p>
      <div class="flex items-center gap-3">
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Accessibility
        </a>
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Privacy Policy
        </a>
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          FOIA
        </a>
      </div>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Services",
        [
            new("Permits & Licenses", "#"),
            new("Pay Bills", "#"),
            new("Report an Issue", "#"),
            new("Public Records", "#"),
        ]),
        new("Citizens",
        [
            new("Voting", "#"),
            new("Public Safety", "#"),
            new("Transportation", "#"),
            new("Community Events", "#"),
        ]),
        new("About",
        [
            new("Leadership", "#"),
            new("Departments", "#"),
            new("Budget & Finance", "#"),
            new("Careers", "#"),
        ]),
    ];
}
