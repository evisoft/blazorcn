@* ========================================
   Block: footer-social-feed
   Title: Footer Social Feed
   Description: Footer with social media follower counts, recent post previews, and navigation links
   Long Description: Footer with call-to-action card
   Dependencies: AvatarCn, AvatarFallbackCn, CardCn, LucideGithubCn, LucideInstagramCn, LucideTwitterCn, LucideUsersCn, LucideYoutubeCn
   Source: original/blocks/footer/footer-social-feed.tsx
   ======================================== *@

<footer class="w-full border-t pb-8 pt-16">
    <div class="container mx-auto px-4">
        <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var social in _socials)
            {
                <CardCn Class="p-5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <AvatarCn Class="bg-muted h-9 w-9">
                                <AvatarFallbackCn Class="bg-muted">
                                    @if (social.Name == "Twitter")
                                    {
                                        <LucideTwitterCn Size="16" Class="h-4 w-4" />
                                    }
                                    else if (social.Name == "GitHub")
                                    {
                                        <LucideGithubCn Size="16" Class="h-4 w-4" />
                                    }
                                    else
                                    {
                                        <LucideYoutubeCn Size="16" Class="h-4 w-4" />
                                    }
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class="text-sm font-semibold">@social.Name</p>
                                <p class="text-muted-foreground text-xs">@social.Handle</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <LucideUsersCn Size="14" Class="text-muted-foreground h-3.5 w-3.5" />
                            <span class="text-sm font-medium">@social.Followers</span>
                        </div>
                    </div>
                    <p class="text-muted-foreground mt-4 line-clamp-2 text-sm">@social.RecentPost</p>
                    <p class="text-muted-foreground/60 mt-2 text-xs">@social.TimeAgo</p>
                </CardCn>
            }
        </div>
        <div class="flex flex-col items-center justify-between gap-6 border-t pt-8 md:flex-row">
            <div class="flex items-center gap-3">
                <LucideInstagramCn Size="16" Class="text-muted-foreground h-4 w-4" />
                <span class="text-muted-foreground text-sm">
                    Follow us for daily design inspiration
                </span>
            </div>
            <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
                @foreach (var link in _links)
                {
                    <li>
                        <a class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                           href="@link.Href">
                            @link.Title
                        </a>
                    </li>
                }
            </ul>
        </div>
        <p class="text-muted-foreground mt-6 text-center text-sm">
            &copy; @DateTime.Now.Year shadcn.io. All rights reserved.
        </p>
    </div>
</footer>

@code {
    private record SocialPlatform(string Name, string Handle, string Followers, string RecentPost, string TimeAgo);

    private readonly List<SocialPlatform> _socials =
    [
        new("Twitter", "@@shadcnio", "24.5K",
            "Just shipped v3.0 with 200+ new components. Dark mode, animations, and more.", "2h ago"),
        new("GitHub", "shadcn-io", "18.2K",
            "New release: Performance improvements across all components. 40% faster renders.", "1d ago"),
        new("YouTube", "shadcn.io", "8.7K",
            "Building a dashboard from scratch in 15 minutes with shadcn/ui components.", "3d ago"),
    ];

    private record NavLink(string Title, string Href);

    private readonly NavLink[] _links =
    [
        new("About", "#"), new("Blog", "#"), new("Careers", "#"),
        new("Privacy", "#"), new("Terms", "#"),
    ];
}
