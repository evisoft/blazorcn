@* ============================================================
   Block: footer-contact-info
   Title: FooterContactInfo
   Description: A contact information footer block for React and Next.js with email, phone, and address details, navigation link columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-contact-info.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Contact items *@
    <div class="grid grid-cols-1 gap-px border-b bg-border sm:grid-cols-3">
      @foreach (var item in _contactItems)
      {
        <a href="@item.Href"
           class="flex items-center gap-2.5 bg-card px-4 py-3 transition-colors hover:bg-muted/50">
          <LucideIconCn Name="@item.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
          <span class="text-sm text-muted-foreground transition-colors hover:text-foreground">
            @item.Label
          </span>
        </a>
      }
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Heading
          </p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href"
                   class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record ContactItem(string IconName, string Label, string Href);
    private record NavLink(string Label, string Href);
    private record LinkColumn(string Heading, NavLink[] Links);

    private static readonly ContactItem[] _contactItems =
    [
        new("mail", "hello@@acme.com", "mailto:hello@acme.com"),
        new("phone", "+1 (555) 012-3456", "tel:+15550123456"),
        new("map-pin", "San Francisco, CA", "#"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Security", "#"),
            new("Changelog", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Press", "#"),
        ]),
    ];
}
