@* ============================================================
   Block: footer-testimonial
   Title: FooterTestimonial
   Description: A testimonial footer block for React and Next.js with a featured italic quote, author attribution, two navigation link columns, and copyright text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-testimonial.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Testimonial quote *@
        <div class="flex flex-col items-center gap-3 border-b px-4 py-4 text-center">
            <blockquote class="max-w-lg text-muted-foreground text-sm italic leading-relaxed">
                &ldquo;Switching to Acme cut our deployment time in half. The developer experience is
                unmatched &mdash; our team ships with confidence every single day. It&apos;s become the
                backbone of our engineering workflow.&rdquo;
            </blockquote>
            <div class="flex flex-col items-center gap-0.5">
                <span class="font-medium text-sm">Sarah Chen</span>
                <span class="text-muted-foreground text-xs">VP of Engineering, Meridian Labs</span>
            </div>
        </div>

        @* Link columns *@
        <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-6 border-b px-4 py-3">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        @col.Heading
                    </p>
                    <ul class="flex flex-col gap-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* Copyright *@
        <div class="flex items-center px-4 py-3">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Documentation", "#"),
            new("Integrations", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Blog", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];
}
