@* ============================================================
   Block: footer-podcast
   Title: FooterPodcast
   Description: A React podcast footer block for Next.js with latest episode preview, platform links, two navigation columns, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-podcast.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Podcast section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Listen to our podcast</p>
            </div>
            <div class="mt-3 rounded-md bg-muted/50 p-3">
                <p class="text-sm font-medium">@_episode.Title</p>
                <p class="mt-1 text-xs text-muted-foreground">@_episode.Duration</p>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-3">
                @foreach (var platform in _platforms)
                {
                    <a href="@platform.Href" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                        @platform.Label
                    </a>
                }
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            <div>
                <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Product
                </p>
                <ul class="space-y-1.5">
                    @foreach (var lnk in _productLinks)
                    {
                        <li>
                            <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @lnk.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div>
                <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Company
                </p>
                <ul class="space-y-1.5">
                    @foreach (var lnk in _companyLinks)
                    {
                        <li>
                            <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @lnk.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record EpisodeItem(string Title, string Duration);
    private record NavLink(string Label, string Href);

    private static readonly EpisodeItem _episode = new(
        "Scaling React Server Components in Production",
        "42 min"
    );

    private static readonly NavLink[] _platforms =
    [
        new("Apple Podcasts", "#"),
        new("Spotify", "#"),
        new("Google Podcasts", "#"),
    ];

    private static readonly NavLink[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("Documentation", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
        new("Contact", "#"),
    ];
}
