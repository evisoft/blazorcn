@* ============================================================
   Block: footer-restaurant
   Title: FooterRestaurant
   Description: A React restaurant footer block for Next.js with brand tagline, hours of operation, location, two navigation columns, order online button, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-restaurant.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + tagline *@
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="utensils" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Acme Kitchen</p>
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        Farm-to-table dining crafted with seasonal ingredients and local produce.
      </p>
    </div>

    @* Hours + location + links *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-10">

      @* Hours *@
      <div class="shrink-0">
        <div class="mb-2.5 flex items-center gap-1.5">
          <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            Hours
          </p>
        </div>
        <div class="space-y-1">
          @foreach (var item in _hoursData)
          {
            <div class="flex items-baseline gap-3 text-sm">
              <span class="w-20 shrink-0 text-muted-foreground">@item.Days</span>
              <span class="text-muted-foreground">@item.Time</span>
            </div>
          }
        </div>
      </div>

      @* Location *@
      <div class="shrink-0">
        <div class="mb-2.5 flex items-center gap-1.5">
          <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            Location
          </p>
        </div>
        <p class="text-sm text-muted-foreground">123 Main Street</p>
        <p class="text-sm text-muted-foreground">San Francisco, CA 94105</p>
      </div>

      @* Link columns *@
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Title
          </p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }

    </div>

    @* Order online + copyright *@
    <div class="flex items-center justify-between px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Kitchen. All rights reserved.
      </p>
      <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 px-3 text-xs">
        <a href="#">Order Online</a>
      </ButtonCn>
    </div>

  </div>
</section>

@code {
    private record HoursRow(string Days, string Time);
    private record NavLink(string Label, string Href);
    private record LinkColumn(string Title, NavLink[] Links);

    private static readonly HoursRow[] _hoursData =
    [
        new("Mon — Fri", "11:00 AM — 10:00 PM"),
        new("Sat — Sun", "10:00 AM — 11:00 PM"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Menu", [
            new("Dinner", "#"),
            new("Lunch", "#"),
            new("Brunch", "#"),
            new("Drinks", "#"),
        ]),
        new("About", [
            new("Our Story", "#"),
            new("The Chef", "#"),
            new("Private Events", "#"),
            new("Gift Cards", "#"),
        ]),
    ];
}
