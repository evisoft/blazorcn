@code {
    private const string FooterAccordionMobileCode = @"<footer class=""w-full border-t pb-8 pt-16"">
    <div class=""container mx-auto px-4"">
        <div class=""mb-8 flex items-center justify-between"">
            <h6 class=""text-lg font-semibold"">shadcn.io</h6>
            <p class=""text-muted-foreground text-sm"">The next generation of design systems.</p>
        </div>

        @* Mobile: Accordion *@
        <div class=""md:hidden"">
            <AccordionCn Type=""AccordionType.Multiple"">
                @foreach (var group in _links)
                {
                    <AccordionItemCn Value=""@group.Title"">
                        <AccordionTriggerCn Class=""text-sm font-semibold"">@group.Title</AccordionTriggerCn>
                        <AccordionContentCn>
                            <ul class=""space-y-3 pb-2"">
                                @foreach (var item in group.Items)
                                {
                                    <li>
                                        <a class=""text-muted-foreground hover:text-foreground text-sm transition-colors""
                                           href=""@item.Href"">
                                            @item.Title
                                        </a>
                                    </li>
                                }
                            </ul>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

        @* Desktop: Grid columns *@
        <div class=""hidden grid-cols-4 gap-8 md:grid"">
            @foreach (var group in _links)
            {
                <ul class=""space-y-3"">
                    <p class=""mb-3 text-sm font-semibold"">@group.Title</p>
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <a class=""text-muted-foreground hover:text-foreground text-sm transition-colors""
                               href=""@item.Href"">
                                @item.Title
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class=""mt-10 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row"">
            <p class=""text-muted-foreground text-sm"">
                &copy; @DateTime.Now.Year shadcn.io. All rights reserved.
            </p>
            <ul class=""flex items-center gap-6"">
                <li>
                    <a class=""text-muted-foreground hover:text-foreground text-sm"" href=""#"">Privacy</a>
                </li>
                <li>
                    <a class=""text-muted-foreground hover:text-foreground text-sm"" href=""#"">Terms</a>
                </li>
                <li>
                    <a class=""text-muted-foreground hover:text-foreground text-sm"" href=""#"">Sitemap</a>
                </li>
            </ul>
        </div>
    </div>
</footer>

