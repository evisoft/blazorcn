@code {
    private const string FooterAccessibilityCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">

        @* Accessibility statement *@
        <div class=""border-b px-4 py-4"">
            <div class=""flex items-start gap-3"">
                <LucideIconCn Name=""accessibility"" Size=""16"" Class=""mt-0.5 size-4 shrink-0 text-muted-foreground"" />
                <div class=""min-w-0 flex-1"">
                    <p class=""text-sm font-medium"">Accessibility Statement</p>
                    <p class=""mt-1 text-xs text-muted-foreground"">
                        We are committed to making our platform accessible to everyone. Our site conforms
                        to WCAG 2.1 Level AA guidelines and is regularly tested with assistive
                        technologies including screen readers and keyboard-only navigation.
