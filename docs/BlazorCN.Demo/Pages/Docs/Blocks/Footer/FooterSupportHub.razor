@* ============================================================
   Block: footer-support-hub
   Title: FooterSupportHub
   Description: A support-focused React footer block for Next.js with live chat, email, and phone support options, navigation columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-support-hub.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Support section *@
        <div class="border-b px-4 py-4">
            <p class="text-sm font-medium">Need help?</p>
            <p class="mt-1 text-xs text-muted-foreground">Reach out through any of our support channels.</p>
            <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
                @foreach (var option in _supportOptions)
                {
                    <div class="flex items-start gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                        <LucideIconCn Name="@option.Icon" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0">
                            <p class="text-sm font-medium">@option.Label</p>
                            <p class="text-xs text-muted-foreground">@option.Description</p>
                            <p class="mt-1 font-mono text-xs text-muted-foreground">@option.Availability</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product</p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var link in _productLinks)
                    {
                        <li>
                            <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Company</p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var link in _companyLinks)
                    {
                        <li>
                            <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
        </div>
    </div>
</section>

@code {
    private record SupportOption(string Icon, string Label, string Description, string Availability);
    private record NavLink(string Label, string Href);

    private static readonly SupportOption[] _supportOptions =
    [
        new("message-circle", "Live Chat", "Chat with our team in real time", "Available 24/7"),
        new("mail", "Email", "Get a response within 4 hours", "support@@acme.com"),
        new("phone", "Phone", "Talk to a support specialist", "Mon-Fri, 9am-6pm EST"),
    ];

    private static readonly NavLink[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("Changelog", "#"),
        new("Documentation", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
        new("Contact", "#"),
        new("Press", "#"),
    ];
}
