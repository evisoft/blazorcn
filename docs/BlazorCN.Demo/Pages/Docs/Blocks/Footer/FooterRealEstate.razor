@* ============================================================
   Block: footer-real-estate
   Title: FooterRealEstate
   Description: A React real estate footer block for Next.js with three navigation columns, licensed badge, Equal Housing notice, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-real-estate.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + licensed badge *@
    <div class="flex items-center justify-between border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="house" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Acme Realty</p>
      </div>
      <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5">
        <LucideIconCn Name="badge-check" Size="14" Class="size-3.5 text-muted-foreground" />
        <span class="text-xs font-medium text-muted-foreground">Licensed in 50 states</span>
      </div>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Title</p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Equal Housing notice *@
    <div class="flex items-center gap-2.5 border-b px-4 py-3">
      <LucideIconCn Name="scale" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
      <p class="text-xs text-muted-foreground">
        Equal Housing Opportunity. All real estate advertised herein is subject to the Federal
        Fair Housing Act, which makes it illegal to discriminate based on race, color,
        religion, sex, handicap, familial status, or national origin.
      </p>
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Realty LLC. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Properties",
        [
            new("Buy", "#"),
            new("Rent", "#"),
            new("Sell", "#"),
            new("Commercial", "#"),
        ]),
        new("Resources",
        [
            new("Market Report", "#"),
            new("Mortgage Calculator", "#"),
            new("Buyer Guides", "#"),
            new("Seller Guides", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Agents", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];
}
