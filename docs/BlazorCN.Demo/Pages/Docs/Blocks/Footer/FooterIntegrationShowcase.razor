@* ============================================================
   Block: footer-integration-showcase
   Title: FooterIntegrationShowcase
   Description: An integration showcase React footer block for Next.js with connected services badges, navigation columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-integration-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Integration badges *@
        <div class="border-b px-4 py-4">
            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Connects with
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
                @foreach (var integration in _integrations)
                {
                    <span class="rounded-md bg-muted/50 px-3 py-1.5 text-sm text-muted-foreground">
                        @integration.Label
                    </span>
                }
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Product
                </p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var link in _productLinks)
                    {
                        <li>
                            <a
                                href="@link.Href"
                                class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Company
                </p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var link in _companyLinks)
                    {
                        <li>
                            <a
                                href="@link.Href"
                                class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record Integration(string Label);
    private record LinkItem(string Label, string Href);

    private static readonly Integration[] _integrations =
    [
        new("Slack"),
        new("Zapier"),
        new("GitHub"),
        new("Jira"),
        new("Figma"),
        new("Notion"),
    ];

    private static readonly LinkItem[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("API", "#"),
        new("Changelog", "#"),
    ];

    private static readonly LinkItem[] _companyLinks =
    [
        new("About", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
        new("Contact", "#"),
        new("Press", "#"),
    ];
}
