@* ============================================================
   Block: footer-theme-toggle
   Title: FooterThemeToggle
   Description: A React theme toggle footer block for Next.js with dark mode sun/moon icon switcher, three link columns, and copyright bar using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-theme-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Link columns *@
    <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
      @foreach (var col in _linkColumns)
      {
        var column = col;
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @column.Title
          </p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in column.Links)
            {
              var link = lnk;
              <li>
                <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @link.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright + theme toggle *@
    <div class="flex items-center justify-between px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
      <ButtonCn Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Sm"
                Class="relative h-7 w-7 overflow-hidden p-0"
                OnClick="@(() => _isDark = !_isDark)"
                aria-label="@(_isDark ? "Switch to light mode" : "Switch to dark mode")">
        @if (_isDark)
        {
          <span class="absolute inset-0 flex items-center justify-center">
            <LucideIconCn Name="moon" Size="14" Class="size-3.5" />
          </span>
        }
        else
        {
          <span class="absolute inset-0 flex items-center justify-center">
            <LucideIconCn Name="sun" Size="14" Class="size-3.5" />
          </span>
        }
      </ButtonCn>
    </div>

  </div>
</section>

@code {
    private bool _isDark = false;

    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Developers",
        [
            new("Documentation", "#"),
            new("API Reference", "#"),
            new("SDKs", "#"),
            new("Examples", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
    ];
}
