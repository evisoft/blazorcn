@* ========================================
   Block: footer-columns
   Title: Footer Columns
   Description: Footer with company branding, social media icons, and four columns of navigation links
   Long Description: Minimal footer with social links
   Dependencies: LucideGithubCn, LucideInstagramCn, LucideTwitterCn, LucideYoutubeCn
   Source: original/blocks/footer/footer-columns.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 justify-between gap-4 md:grid-cols-2">
          <div>
            <h3 class="text-xl font-semibold">shadcn.io</h3>
            <p class="text-foreground my-4 text-sm">The next generation of design systems.</p>
            <div class="flex gap-1">
              <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Twitter">
                <a aria-label="Twitter" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideTwitterCn Size="16" />
                </a>
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="YouTube">
                <a aria-label="YouTube" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideYoutubeCn Size="16" />
                </a>
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Instagram">
                <a aria-label="Instagram" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideInstagramCn Size="16" />
                </a>
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="GitHub">
                <a aria-label="GitHub" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideGithubCn Size="16" />
                </a>
              </ButtonCn>
            </div>
          </div>
          <div class="grid grid-cols-2 justify-between gap-6 lg:grid-cols-4">
            @foreach (var item in _links)
            {
                <ul class="space-y-2">
                <li><p class="mb-2 font-semibold">@item.Title</p></li>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-foreground hover:text-primary text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
        </div>
        <p class="text-foreground mt-20 text-center text-sm">
          &copy; @_year shadcn.io. All Rights Reserved.
        </p>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Company", [new("About Us", "#"), new("Careers", "#"), new("Premium Tools", "#"), new("Blogs", "#")]),
        new("Pages", [new("Login", "#"), new("Register", "#"), new("Add List", "#"), new("Contact", "#")]),
        new("Legal", [new("Terms", "#"), new("Privacy", "#"), new("Teams", "#"), new("About Us", "#")]),
        new("Resources", [new("Blog", "#"), new("Services", "#"), new("Products", "#"), new("Pricing", "#")]),
    ];
}
