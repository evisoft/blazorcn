@* ============================================================
   Block: footer-api-status
   Title: FooterApiStatus
   Description: A React API status footer block for Next.js with service health indicators, operational status dots, subscribe to updates link, and navigation columns using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-api-status.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Service status rows *@
    <div class="border-b px-4 py-3">
      <div class="space-y-2">
        @foreach (var svc in _services)
        {
          <div class="flex items-center justify-between">
            <span class="text-sm text-muted-foreground">@svc.Name</span>
            <div class="flex items-center gap-2">
              <span class="text-xs text-muted-foreground">@svc.Label</span>
              <span class="@($"size-1.5 rounded-full {StatusColor(svc.Status)}")"></span>
            </div>
          </div>
        }
      </div>
    </div>

    @* Overall status + subscribe *@
    <div class="flex items-center justify-between border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <span class="@($"size-1.5 rounded-full {StatusColor(_overallStatus)}")"></span>
        <span class="text-sm font-medium">
          @(_overallStatus == "operational"
            ? "All Systems Operational"
            : _overallStatus == "degraded"
              ? "Partial Degradation"
              : "Major Outage")
        </span>
      </div>
      <a
        href="#"
        class="inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
      >
        <LucideIconCn Name="bell" Size="12" Class="size-3" />
        Subscribe to updates
      </a>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Heading
          </p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a
                  href="@lnk.Href"
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record Service(string Name, string Status, string Label);

    private record LinkItem(string Label, string Href);

    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly Service[] _services =
    [
        new("API",       "operational", "Operational"),
        new("Dashboard", "operational", "Operational"),
        new("CDN",       "degraded",    "Degraded"),
        new("Webhooks",  "operational", "Operational"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Developers",
        [
            new("API Reference", "#"),
            new("SDKs",          "#"),
            new("Changelog",     "#"),
            new("Status Page",   "#"),
        ]),
        new("Company",
        [
            new("About",   "#"),
            new("Blog",    "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];

    private static readonly string _overallStatus =
        Array.Exists(_services, s => s.Status == "down")      ? "down"        :
        Array.Exists(_services, s => s.Status == "degraded")  ? "degraded"    :
                                                                 "operational";

    private static string StatusColor(string status) => status switch
    {
        "operational" => "bg-emerald-500",
        "degraded"    => "bg-amber-500",
        "down"        => "bg-red-500",
        _             => "bg-emerald-500",
    };
}
