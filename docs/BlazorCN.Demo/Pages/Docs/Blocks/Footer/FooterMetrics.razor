@* ============================================================
   Block: footer-metrics
   Title: FooterMetrics
   Description: A metrics footer block for React and Next.js with four stat counters in a row, three navigation link columns, and copyright text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-metrics.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Metrics row *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-3 sm:grid-cols-4">
            @foreach (var metric in _metrics)
            {
                <div class="flex flex-col items-center gap-0.5 text-center">
                    <span class="font-semibold text-2xl tabular-nums">@metric.Value</span>
                    <span class="text-muted-foreground text-xs">@metric.Label</span>
                </div>
            }
        </div>

        @* Link columns *@
        <nav aria-label="Footer navigation" class="grid grid-cols-3 gap-6 border-b px-4 py-3">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@col.Heading</p>
                    <ul class="flex flex-col gap-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* Copyright *@
        <div class="flex items-center px-4 py-3">
            <p class="text-muted-foreground text-xs">&copy; 2026 Acme Inc. All rights reserved.</p>
        </div>

    </div>
</section>

@code {
    private record Metric(string Value, string Label);
    private record FooterLink(string Label, string Href);
    private record LinkColumn(string Heading, FooterLink[] Links);

    private static readonly Metric[] _metrics =
    [
        new("10K+", "Customers"),
        new("99.9%", "Uptime"),
        new("150+", "Countries"),
        new("4.9", "Rating"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Integrations", "#")]),
        new("Resources", [new("Documentation", "#"), new("API Reference", "#"), new("Community", "#")]),
        new("Company", [new("About", "#"), new("Blog", "#"), new("Careers", "#")]),
    ];
}
