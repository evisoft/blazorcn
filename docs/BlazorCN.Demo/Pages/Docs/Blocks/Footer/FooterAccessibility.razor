@* ============================================================
   Block: footer-accessibility
   Title: FooterAccessibility
   Description: A React accessibility-focused footer block for Next.js with WCAG compliance badge, accessibility statement, report link, and navigation columns using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-accessibility.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Accessibility statement *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="accessibility" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">Accessibility Statement</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We are committed to making our platform accessible to everyone. Our site conforms
                        to WCAG 2.1 Level AA guidelines and is regularly tested with assistive
                        technologies including screen readers and keyboard-only navigation.
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-3">
                        <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1">
                            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-xs font-medium">WCAG 2.1 AA</span>
                        </div>
                        <a href="#"
                           class="inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                            Report accessibility issue
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Link columns *@
        <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 sm:grid-cols-3">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Heading
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href"
                                   class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record FooterLink(string Label, string Href);
    private record LinkColumn(string Heading, FooterLink[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Documentation", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
        new("Legal",
        [
            new("Privacy Policy", "#"),
            new("Terms of Service", "#"),
            new("Cookie Policy", "#"),
            new("Accessibility", "#"),
        ]),
    ];
}
