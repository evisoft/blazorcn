@* ============================================================
   Block: footer-newsletter-minimal
   Title: FooterNewsletterMinimal
   Description: A React minimal newsletter footer block for Next.js with centered email input, subscribe button, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-newsletter-minimal.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    @* Newsletter signup *@
    <div class="border-b px-4 py-4">
      <div class="flex items-center gap-2">
        <InputCn type="email" Placeholder="@("you@example.com")" aria-label="Email address" Class="h-8 text-xs" />
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">
          Subscribe
        </ButtonCn>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">
        No spam. Unsubscribe anytime.
      </p>
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>
  </div>
</section>
