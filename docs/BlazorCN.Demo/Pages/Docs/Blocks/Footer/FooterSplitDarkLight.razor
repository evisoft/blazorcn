@* ============================================================
   Block: footer-split-dark-light
   Title: FooterSplitDarkLight
   Description: A React split theme footer block for Next.js with dark brand section, light link columns, visual contrast grid layout, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-split-dark-light.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Split content *@
        <div class="grid grid-cols-1 border-b lg:grid-cols-2">
            @* Dark brand section *@
            <div class="border-b bg-zinc-950 px-4 py-4 text-zinc-100 lg:border-b-0 lg:border-r lg:border-zinc-800">
                <p class="text-sm font-medium text-zinc-100">Acme</p>
                <p class="mt-1 text-xs text-zinc-400">Build better products, faster.</p>
                <p class="mt-3 text-sm leading-relaxed text-zinc-400">
                    We craft accessible, beautiful components that developers love to use. Since 2021,
                    powering interfaces for thousands of teams worldwide.
                </p>
            </div>

            @* Light link columns *@
            <div class="flex gap-12 px-4 py-4">
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Product
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in _productLinks)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Company
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in _companyLinks)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("Changelog", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
        new("Contact", "#"),
    ];
}
