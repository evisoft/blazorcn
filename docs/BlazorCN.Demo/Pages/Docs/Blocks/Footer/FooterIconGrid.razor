@* ============================================================
   Block: footer-icon-grid
   Title: FooterIconGrid
   Description: An icon-driven footer block for React and Next.js with a 2x3 grid of Lucide icon feature items, navigation links, and copyright text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-icon-grid.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Icon grid *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-3 sm:grid-cols-3">
            @foreach (var item in _featureItems)
            {
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">@item.Label</span>
                </div>
            }
        </div>

        @* Links + copyright *@
        <div class="flex flex-col items-center justify-between gap-3 px-4 py-3 sm:flex-row">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
            <nav aria-label="Footer navigation" class="flex items-center gap-4">
                @foreach (var link in _navLinks)
                {
                    <a href="@link.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                        @link.Label
                    </a>
                }
            </nav>
        </div>
    </div>
</section>

@code {
    private record FeatureItem(string Label, string Icon);
    private record NavLink(string Label, string Href);

    private static readonly FeatureItem[] _featureItems =
    [
        new("Lightning Fast", "zap"),
        new("Secure by Default", "shield"),
        new("Cloud Native", "cloud"),
        new("Easy Setup", "rocket"),
        new("Encrypted", "lock"),
        new("Configurable", "settings"),
    ];

    private static readonly NavLink[] _navLinks =
    [
        new("Privacy", "#"),
        new("Terms", "#"),
        new("Docs", "#"),
        new("Support", "#"),
    ];
}
