@* ============================================================
   Block: footer-progress-bar
   Title: FooterProgressBar
   Description: A React reading progress footer block for Next.js with animated percentage bar indicator, two link columns, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-progress-bar.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Progress bar *@
    <div class="border-b px-4 py-4">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium text-muted-foreground">Reading progress</p>
        <p class="text-xs font-medium tabular-nums text-muted-foreground">
          @_progress% read
        </p>
      </div>
      <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
        <div class="h-full rounded-full bg-foreground" style="@($"width:{_progress}%")"></div>
      </div>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Title
          </p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private const int _progress = 75;

    private record FooterLink(string Label, string Href);
    private record FooterLinkColumn(string Title, FooterLink[] Links);

    private static readonly FooterLinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("Blog", "#"),
            new("Guides", "#"),
            new("Support", "#"),
        ]),
    ];
}
