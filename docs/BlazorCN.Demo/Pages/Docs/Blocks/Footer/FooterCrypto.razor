@* ============================================================
   Block: footer-crypto
   Title: FooterCrypto
   Description: A crypto and web3 exchange footer block for React and Next.js with brand section, three navigation columns, regulatory notice, network status indicator, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-crypto.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Brand + link columns *@
        <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 md:grid-cols-2">
            @* Brand section *@
            <div>
                <span class="font-medium text-sm">ChainVault</span>
                <p class="mt-1 text-muted-foreground text-xs">
                    Trade, earn, and build on the decentralized web.
                </p>
            </div>

            @* Link columns *@
            <div class="grid grid-cols-3 gap-6">
                @foreach (var col in _linkColumns)
                {
                    var column = col;
                    <div>
                        <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            @column.Title
                        </p>
                        <ul class="space-y-1.5">
                            @foreach (var it in column.Items)
                            {
                                var item = it;
                                <li>
                                    <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                        @item.Label
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        @* Regulatory notice *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-xs leading-relaxed">
                Not financial advice. Digital asset trading involves substantial risk of loss and is
                not suitable for all investors. Past performance does not guarantee future results.
                Please trade responsibly.
            </p>
        </div>

        @* Network status + copyright *@
        <div class="flex flex-col items-center justify-between gap-3 px-4 py-3 sm:flex-row">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 ChainVault Labs. All rights reserved.
            </p>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground text-xs">Mainnet</span>
                </div>
                <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
                    Terms
                </a>
                <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
                    Privacy
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Trade",
        [
            new("Spot", "#"),
            new("Futures", "#"),
            new("Earn", "#"),
            new("NFT", "#"),
        ]),
        new("Learn",
        [
            new("Academy", "#"),
            new("Blog", "#"),
            new("Research", "#"),
            new("Glossary", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Security", "#"),
            new("Contact", "#"),
        ]),
    ];
}
