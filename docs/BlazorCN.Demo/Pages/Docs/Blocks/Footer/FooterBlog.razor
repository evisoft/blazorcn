@* ============================================================
   Block: footer-blog
   Title: FooterBlog
   Description: A blog footer block for React and Next.js with popular topic badges, two navigation columns for blog and about links, and a copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-blog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Popular topics *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                Popular Topics
            </p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var topic in _topics)
                {
                    <a href="@topic.Href">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="cursor-pointer text-xs transition-colors hover:bg-muted/50">
                            @topic.Label
                        </BadgeCn>
                    </a>
                }
            </div>
        </div>

        @* Link columns *@
        <div class="grid grid-cols-2 gap-6 border-b px-4 py-4">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        @col.Title
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var item in col.Items)
                        {
                            <li>
                                <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                    @item.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 The Dev Blog. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record TopicLink(string Label, string Href);
    private record NavLink(string Label, string Href);
    private record LinkColumn(string Title, NavLink[] Items);

    private static readonly TopicLink[] _topics =
    [
        new("React", "#"),
        new("TypeScript", "#"),
        new("Design Systems", "#"),
        new("Performance", "#"),
        new("Accessibility", "#"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Blog",
        [
            new("Latest", "#"),
            new("Archive", "#"),
            new("Newsletter", "#"),
            new("RSS", "#"),
        ]),
        new("About",
        [
            new("Author", "#"),
            new("Contact", "#"),
            new("Colophon", "#"),
        ]),
    ];
}
