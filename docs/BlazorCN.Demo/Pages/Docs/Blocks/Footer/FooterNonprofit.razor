@* ============================================================
   Block: footer-nonprofit
   Title: FooterNonprofit
   Description: A React nonprofit footer block for Next.js with mission statement, three navigation columns, tax-exempt notice, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-nonprofit.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    @* Mission statement *@
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="heart-handshake" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Acme Foundation</p>
      </div>
      <p class="mt-1 max-w-md text-xs text-muted-foreground">
        Empowering underserved communities through education, health programs, and sustainable
        development initiatives that create lasting change.
      </p>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Title
          </p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a
                  href="@lnk.Href"
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Tax-exempt notice *@
    <div class="flex items-center gap-2.5 border-b px-4 py-3">
      <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
      <p class="text-xs text-muted-foreground">
        Acme Foundation is a 501(c)(3) tax-exempt organization. Tax ID: 12-3456789. Donations
        are tax-deductible to the fullest extent allowed by law.
      </p>
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Foundation. All rights reserved.
      </p>
    </div>
  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Programs",
        [
            new("Education", "#"),
            new("Community Health", "#"),
            new("Food Security", "#"),
            new("Youth Development", "#"),
        ]),
        new("Get Involved",
        [
            new("Donate", "#"),
            new("Volunteer", "#"),
            new("Partner", "#"),
            new("Events", "#"),
        ]),
        new("About",
        [
            new("Our Story", "#"),
            new("Team", "#"),
            new("Annual Report", "#"),
            new("Contact", "#"),
        ]),
    ];
}
