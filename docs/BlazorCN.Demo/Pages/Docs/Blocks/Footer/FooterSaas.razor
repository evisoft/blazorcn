@* ============================================================
   Block: footer-saas
   Title: FooterSaas
   Description: A SaaS product footer block for React and Next.js with brand tagline, three navigation link columns, social media icons, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-saas.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + link columns *@
    <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 md:grid-cols-2">

      @* Brand section *@
      <div>
        <span class="font-medium text-sm">Acme Cloud</span>
        <p class="mt-1 text-muted-foreground text-xs">
          Infrastructure that scales with your team. Ship faster, monitor smarter.
        </p>
      </div>

      @* Link columns *@
      <div class="grid grid-cols-3 gap-6">
        @foreach (var col in _linkColumns)
        {
          <div>
            <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@col.Title</p>
            <ul class="space-y-1.5">
              @foreach (var item in col.Items)
              {
                <li>
                  <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                    @item.Label
                  </a>
                </li>
              }
            </ul>
          </div>
        }
      </div>

    </div>

    @* Social icons + copyright *@
    <div class="flex flex-col items-center justify-between gap-3 px-4 py-3 sm:flex-row">
      <div class="flex items-center gap-1">
        @foreach (var link in _socialLinks)
        {
          <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
            <a href="@link.Href" aria-label="@link.Label" rel="noopener noreferrer" target="_blank">
              <LucideIconCn Name="@link.Icon" Size="14" Class="size-3.5" />
            </a>
          </ButtonCn>
        }
      </div>
      <p class="text-muted-foreground text-xs">
        &copy; 2026 Acme Cloud. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);
    private record SocialLink(string Label, string Href, string Icon);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("API", "#"),
        ]),
        new("Resources",
        [
            new("Docs", "#"),
            new("Blog", "#"),
            new("Changelog", "#"),
            new("Community", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Press", "#"),
            new("Contact", "#"),
        ]),
    ];

    private static readonly SocialLink[] _socialLinks =
    [
        new("Twitter", "#", "twitter"),
        new("GitHub", "#", "github"),
        new("LinkedIn", "#", "linkedin"),
        new("YouTube", "#", "youtube"),
    ];
}
