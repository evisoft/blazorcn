@* ========================================
   Block: footer-newsletter
   Title: Footer Newsletter
   Description: Footer with multi-column navigation links and newsletter subscription form with checkbox consent
   Long Description: Footer with copyright and social links
   Dependencies: 
   Source: original/blocks/footer/footer-newsletter.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 justify-between gap-10 md:grid-cols-2">
          <div class="grid grid-cols-3 justify-between gap-x-6 gap-y-4">
            @foreach (var item in _links)
            {
                <ul>
                <p class="mb-2 font-semibold">@item.Title</p>
                @foreach (var subItem in item.Items)
            {
                <li class="mb-1">
                    <a
                      class="text-foreground hover:text-primary text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
          <div class="lg:ml-auto">
            <p class="mb-2 font-semibold">Subscribe</p>
            <p class="text-foreground max-w-sm text-sm [text-wrap:_balance]">
              Get access to subscriber exclusive deals and be the first who gets informed about
              fresh sales.
            </p>
            <div class="mt-4 flex w-full max-w-sm items-end gap-2">
              <div class="w-full">
                <LabelCn Class="mb-2 inline-block text-sm font-semibold" for="email">
                  Your Email
                </LabelCn>
                <InputCn id="email" Placeholder="@("someone@example.com")" type="email" />
              </div>
              <ButtonCn Class="shrink-0">Subscribe</ButtonCn>
            </div>
            <div class="mt-3 flex items-center gap-2">
              <CheckboxCn id="checkbox-link" />
              <LabelCn
                Class="text-foreground flex gap-1 select-none text-sm"
                for="checkbox-link"
              >
                I agree with the
                <a class="text-primary hover:underline" href="#">
                  terms and conditions
                </a>
              </LabelCn>
            </div>
          </div>
        </div>
        <p class="text-foreground mt-10 text-center text-sm">
          &copy; @_year shadcn.io. All Rights Reserved.
        </p>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Company", [new("About Us", "#"), new("Careers", "#"), new("Premium Tools", "#"), new("Blogs", "#")]),
        new("Pages", [new("Login", "#"), new("Register", "#"), new("Add List", "#"), new("Contact", "#")]),
        new("Legal", [new("Terms", "#"), new("Privacy", "#"), new("Teams", "#"), new("About Us", "#")]),
    ];
}
