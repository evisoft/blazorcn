@* ============================================================
   Block: footer-comparison
   Title: FooterComparison
   Description: A comparison footer block for React and Next.js with a why-choose-us comparison table, navigation link columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-comparison.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Comparison header *@
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Why choose us?</p>
        </div>

        @* Comparison table *@
        <div class="border-b">
            @* Table header *@
            <div class="flex items-center gap-3 border-b px-4 py-2">
                <span class="flex-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Feature
                </span>
                <span class="w-16 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Us
                </span>
                <span class="w-16 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Others
                </span>
            </div>

            @* Comparison rows *@
            @foreach (var row in _comparisonRows)
            {
                var isLast = row == _comparisonRows[_comparisonRows.Length - 1];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="flex-1 text-sm text-muted-foreground">@row.Feature</span>
                    <span class="flex w-16 items-center justify-center">
                        @if (row.Us)
                        {
                            <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="x" Size="16" Class="size-4 text-muted-foreground/40" />
                        }
                    </span>
                    <span class="flex w-16 items-center justify-center">
                        @if (row.Competitor)
                        {
                            <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="x" Size="16" Class="size-4 text-muted-foreground/40" />
                        }
                    </span>
                </div>
            }
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Heading
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
        </div>

    </div>
</section>

@code {
    private record ComparisonRow(string Feature, bool Us, bool Competitor);
    private record FooterLink(string Label, string Href);
    private record LinkColumn(string Heading, FooterLink[] Links);

    private static readonly ComparisonRow[] _comparisonRows =
    [
        new("Unlimited API calls", true, false),
        new("Self-hosted option", true, false),
        new("Priority support included", true, false),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Documentation", "#"),
        ]),
        new("Resources",
        [
            new("Blog", "#"),
            new("Guides", "#"),
            new("Support", "#"),
            new("Status", "#"),
        ]),
    ];
}
