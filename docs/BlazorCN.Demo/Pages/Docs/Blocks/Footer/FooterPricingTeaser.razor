@* ============================================================
   Block: footer-pricing-teaser
   Title: FooterPricingTeaser
   Description: A pricing teaser React footer block for Next.js with mini plan pills, compare link, navigation columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-pricing-teaser.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Pricing teaser *@
        <div class="border-b px-4 py-4">
            <p class="text-sm font-medium">
                Start free, upgrade anytime
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
                @foreach (var plan in _plans)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5 text-sm">
                        <span class="text-muted-foreground">@plan.Name</span>
                        <span class="font-medium tabular-nums">@plan.Price</span>
                    </span>
                }
            </div>
            <div class="mt-2">
                <a href="#" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    Compare plans &rarr;
                </a>
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Product
                </p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var lnk in _productLinks)
                    {
                        <li>
                            <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @lnk.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Company
                </p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var lnk in _companyLinks)
                    {
                        <li>
                            <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @lnk.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record PlanItem(string Name, string Price);
    private record NavLink(string Label, string Href);

    private static readonly PlanItem[] _plans =
    [
        new("Free",  "$0"),
        new("Pro",   "$19"),
        new("Team",  "$49"),
    ];

    private static readonly NavLink[] _productLinks =
    [
        new("Features",      "#"),
        new("Pricing",       "#"),
        new("Integrations",  "#"),
        new("Changelog",     "#"),
        new("Documentation", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About",   "#"),
        new("Blog",    "#"),
        new("Careers", "#"),
        new("Contact", "#"),
        new("Press",   "#"),
    ];
}
