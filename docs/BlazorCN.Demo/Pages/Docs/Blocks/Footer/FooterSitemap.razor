@* ========================================
   Block: footer-sitemap
   Title: Footer Sitemap
   Description: Comprehensive sitemap footer with six link columns and legal row for large websites
   Long Description: Map every corner of your site. This footer presents a full sitemap across six organized link columns with bottom legal links row and copyright.
   Dependencies: None
   Source: original/blocks/footer/footer-sitemap.tsx
   ======================================== *@

<footer class="w-full border-t pb-8 pt-16">
    <div class="container mx-auto px-4">
        <div class="mb-12 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
            @foreach (var group in _links)
            {
                <ul class="space-y-2">
                    <li><p class="mb-3 text-sm font-semibold">@group.Title</p></li>
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <a
                                class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                                href="@item.Href">
                                @item.Title
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
            <p class="text-muted-foreground text-sm">
                &copy; @_year shadcn.io. All rights reserved.
            </p>
            <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
                @foreach (var item in _legalLinks)
                {
                    <li>
                        <a
                            class="text-muted-foreground hover:text-muted-foreground/80 text-sm transition-colors"
                            href="@item.Href">
                            @item.Title
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</footer>

@code {
    private static readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private static readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Integrations", "#"), new("Changelog", "#"), new("Roadmap", "#")]),
        new("Solutions", [new("For Startups", "#"), new("For Enterprise", "#"), new("For Agencies", "#"), new("For Developers", "#"), new("For Designers", "#")]),
        new("Resources", [new("Documentation", "#"), new("API Reference", "#"), new("Guides", "#"), new("Blog", "#"), new("Webinars", "#")]),
        new("Company", [new("About Us", "#"), new("Careers", "#"), new("Press", "#"), new("Partners", "#"), new("Contact", "#")]),
        new("Support", [new("Help Center", "#"), new("Community", "#"), new("Status", "#"), new("Bug Reports", "#"), new("Feedback", "#")]),
        new("Developers", [new("Open Source", "#"), new("GitHub", "#"), new("SDKs", "#"), new("Plugins", "#"), new("Templates", "#")]),
    ];

    private static readonly LinkItem[] _legalLinks =
    [
        new("Privacy Policy", "#"),
        new("Terms of Service", "#"),
        new("Cookie Policy", "#"),
        new("Accessibility", "#"),
        new("Sitemap", "#"),
    ];
}
