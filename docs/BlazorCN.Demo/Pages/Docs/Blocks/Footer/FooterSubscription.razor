@* ============================================================
   Block: footer-subscription
   Title: FooterSubscription
   Description: A React subscription service footer block for Next.js with plan banner, usage stats, seat counter, manage subscription button, and link columns using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Plan banner *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="credit-card" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div>
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">Your Plan</p>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @_plan.Name
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">Renews @_plan.RenewalDate</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">
                            @_plan.SeatsUsed of @_plan.SeatsTotal seats
                        </span>
                    </div>
                    <div class="h-4 w-24 rounded-full bg-muted/50">
                        <div
                            class="h-full rounded-full bg-foreground/20"
                            style="@($"width:{(double)_plan.SeatsUsed / _plan.SeatsTotal * 100:F0}%")"
                        ></div>
                    </div>
                </div>
            </div>
        </div>

        @* Link columns + manage button *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex gap-12">
                @foreach (var col in _columns)
                {
                    <div>
                        <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @col.Heading
                        </p>
                        <ul class="space-y-1.5">
                            @foreach (var lnk in col.Links)
                            {
                                <li>
                                    <a
                                        href="@lnk.Href"
                                        class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                                    >
                                        @lnk.Label
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Manage Subscription
                </ButtonCn>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record PlanInfo(string Name, int SeatsUsed, int SeatsTotal, string RenewalDate);
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly PlanInfo _plan = new("Pro", 3, 5, "Apr 15, 2026");

    private static readonly LinkItem[] _accountLinks =
    [
        new("Profile Settings", "#"),
        new("Billing History", "#"),
        new("Team Members", "#"),
        new("API Keys", "#"),
    ];

    private static readonly LinkItem[] _supportLinks =
    [
        new("Help Center", "#"),
        new("Documentation", "#"),
        new("Status Page", "#"),
        new("Contact Support", "#"),
    ];

    private static readonly LinkColumn[] _columns =
    [
        new("Account", _accountLinks),
        new("Support", _supportLinks),
    ];
}
