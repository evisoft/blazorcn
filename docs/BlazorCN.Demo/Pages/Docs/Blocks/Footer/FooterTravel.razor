@* ============================================================
   Block: footer-travel
   Title: FooterTravel
   Description: A travel and booking platform footer block for React and Next.js with four navigation columns, 24/7 support phone display, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-travel.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + link columns *@
    <div class="border-b px-4 py-4">
      <div class="mb-4">
        <span class="font-medium text-sm">Voyager Travel</span>
        <p class="mt-1 text-muted-foreground text-xs">
          Book flights, hotels, and experiences worldwide.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        @foreach (var col in _linkColumns)
        {
          var column = col;
          <div>
            <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@column.Title</p>
            <ul class="space-y-1.5">
              @foreach (var lnk in column.Items)
              {
                var item = lnk;
                <li>
                  <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                    @item.Label
                  </a>
                </li>
              }
            </ul>
          </div>
        }
      </div>
    </div>

    @* 24/7 Support phone *@
    <div class="flex items-center gap-3 border-b px-4 py-3">
      <LucideIconCn Name="phone" Size="14" Class="size-3.5 text-muted-foreground" />
      <div class="flex items-center gap-2">
        <span class="font-medium text-sm tabular-nums">1-800-555-0199</span>
        <span class="rounded-md bg-muted/50 px-2 py-0.5 text-xs font-medium text-muted-foreground">
          24/7 Support
        </span>
      </div>
    </div>

    @* Copyright *@
    <div class="flex items-center justify-between px-4 py-3">
      <p class="text-muted-foreground text-xs">
        &copy; 2026 Voyager Travel Ltd. All rights reserved.
      </p>
      <div class="flex items-center gap-3">
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Terms
        </a>
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Privacy
        </a>
      </div>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Destinations",
        [
            new("Europe", "#"),
            new("Asia Pacific", "#"),
            new("Americas", "#"),
            new("Middle East", "#"),
        ]),
        new("Book",
        [
            new("Flights", "#"),
            new("Hotels", "#"),
            new("Cars", "#"),
            new("Packages", "#"),
        ]),
        new("Travelers",
        [
            new("Reviews", "#"),
            new("Guides", "#"),
            new("Insurance", "#"),
            new("Loyalty", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Press", "#"),
            new("Contact", "#"),
        ]),
    ];
}
