@* ============================================================
   Block: footer-documentation
   Title: FooterDocumentation
   Description: A React documentation site footer block for Next.js with four navigation columns, GitHub edit link, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-documentation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + edit link *@
    <div class="flex items-center justify-between border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Documentation</p>
      </div>
      <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
        <a href="#" target="_blank" rel="noopener noreferrer">
          <LucideIconCn Name="github" Size="14" Class="size-3.5" />
          Edit this page on GitHub
        </a>
      </ButtonCn>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-2 gap-6 border-b px-4 py-4 sm:grid-cols-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Title</p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var link in col.Links)
            {
              <li>
                <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @link.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
    </div>

  </div>
</section>

@code {
    private record FooterLink(string Label, string Href);
    private record FooterColumn(string Title, FooterLink[] Links);

    private static readonly FooterColumn[] _linkColumns =
    [
        new("Getting Started", [
            new("Introduction", "#"),
            new("Installation", "#"),
            new("Quick Start", "#"),
            new("Project Structure", "#"),
        ]),
        new("Guides", [
            new("Authentication", "#"),
            new("Data Fetching", "#"),
            new("Deployment", "#"),
            new("Testing", "#"),
        ]),
        new("API Reference", [
            new("Components", "#"),
            new("Hooks", "#"),
            new("Utilities", "#"),
            new("Configuration", "#"),
        ]),
        new("Examples", [
            new("Basic Usage", "#"),
            new("With TypeScript", "#"),
            new("Dashboard", "#"),
            new("E-commerce", "#"),
        ]),
    ];
}
