@* ============================================================
   Block: footer-feature-grid
   Title: FooterFeatureGrid
   Description: A feature highlights footer block for React and Next.js with three feature cards, navigation link columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-feature-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Feature grid *@
        <div class="grid grid-cols-1 gap-px border-b bg-border sm:grid-cols-3">
            @foreach (var feat in _features)
            {
                <div class="flex items-start gap-3 bg-card px-4 py-3">
                    <LucideIconCn Name="@feat.Icon" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <p class="text-sm font-medium">@feat.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@feat.Description</p>
                    </div>
                </div>
            }
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Heading</p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
        </div>
    </div>
</section>

@code {
    private record Feature(string Icon, string Title, string Description);
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly Feature[] _features =
    [
        new("zap", "Fast", "Sub-50ms response times across all endpoints globally."),
        new("shield", "Secure", "End-to-end encryption with SOC 2 Type II compliance."),
        new("server", "Reliable", "99.99% uptime SLA backed by multi-region redundancy."),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Integrations", "#"),
            new("Pricing", "#"),
            new("Changelog", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Blog", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];
}
