@* ============================================================
   Block: footer-multilingual
   Title: FooterMultilingual
   Description: A React multilingual footer block for Next.js with language switcher, three navigation columns, and localized copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-multilingual.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Language switcher *@
    <div class="flex items-center gap-3 border-b px-4 py-3">
      <LucideIconCn Name="globe" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
      <div class="flex items-center gap-1.5">
        @foreach (var lang in _languages)
        {
          var l = lang;
          <ButtonCn
            Variant="@(_selectedLang == l.Code ? ButtonVariant.Default : ButtonVariant.Outline)"
            Size="ButtonSize.Sm"
            Class="@Cn.Merge("h-7 px-2.5 text-xs", _selectedLang == l.Code ? "bg-foreground text-background hover:bg-foreground/90" : "")"
            @onclick="@(() => _selectedLang = l.Code)">
            @l.Code
          </ButtonCn>
        }
      </div>
      <span class="text-xs text-muted-foreground">
        @(_languages.FirstOrDefault(l => l.Code == _selectedLang)?.Label ?? "")
      </span>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 sm:grid-cols-3">
      @foreach (var col in _columns)
      {
        <div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Heading
          </p>
          <ul class="space-y-1.5">
            @foreach (var link in col.Links)
            {
              <li>
                <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @link.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private string _selectedLang = "EN";

    private record Language(string Code, string Label);
    private record NavLink(string Label, string Href);
    private record NavColumn(string Heading, NavLink[] Links);

    private static readonly Language[] _languages =
    [
        new("EN", "English"),
        new("ES", "Espanol"),
        new("FR", "Francais"),
        new("DE", "Deutsch"),
    ];

    private static readonly NavLink[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("API Reference", "#"),
    ];

    private static readonly NavLink[] _resourceLinks =
    [
        new("Documentation", "#"),
        new("Blog", "#"),
        new("Guides", "#"),
        new("Community", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About", "#"),
        new("Careers", "#"),
        new("Press", "#"),
        new("Contact", "#"),
    ];

    private static readonly NavColumn[] _columns =
    [
        new("Product", _productLinks),
        new("Resources", _resourceLinks),
        new("Company", _companyLinks),
    ];
}
