@* ============================================================
   Block: footer-command-palette
   Title: FooterCommandPalette
   Description: A command palette React footer block for Next.js with centered keyboard shortcut hint, three navigation link columns, and copyright bar built with shadcn/ui Kbd component and Tailwind CSS
   Source: original/blocks/footer/footer-command-palette.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Command palette hint *@
    <div class="flex items-center justify-center gap-2 border-b px-4 py-4">
      <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
      <p class="text-sm text-muted-foreground">
        Press <kbd class="pointer-events-none mx-0.5 inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground opacity-100">&#8984;K</kbd> to search
      </p>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-2 gap-6 border-b px-4 py-4 sm:grid-cols-3">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Title</p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">@lnk.Label</a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record FooterLink(string Label, string Href);
    private record FooterColumn(string Title, FooterLink[] Links);

    private static readonly FooterColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("API Reference", "#"),
            new("Guides", "#"),
            new("Community", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
    ];
}
