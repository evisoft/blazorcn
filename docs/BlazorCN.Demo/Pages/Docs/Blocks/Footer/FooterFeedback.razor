@* ============================================================
   Block: footer-feedback
   Title: FooterFeedback
   Description: A React feedback footer block for Next.js with thumbs up/down helpfulness rating, expandable feedback input, two link columns, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-feedback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Feedback section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium">
                    Was this page helpful?
                </p>
                <div class="flex items-center gap-1.5">
                    <ButtonCn Variant="@(_rating == "up" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1 px-2 text-xs"
                              OnClick="@(() => SetRating("up"))">
                        <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                        Yes
                    </ButtonCn>
                    <ButtonCn Variant="@(_rating == "down" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1 px-2 text-xs"
                              OnClick="@(() => SetRating("down"))">
                        <LucideIconCn Name="thumbs-down" Size="12" Class="size-3" />
                        No
                    </ButtonCn>
                </div>
            </div>

            @if (_rating != null && !_submitted)
            {
                <div class="mt-3 flex items-center gap-2">
                    <InputCn Placeholder="@(_rating == "up" ? "What was most helpful?" : "How can we improve this page?")"
                             aria-label="Feedback" Class="h-8 text-xs" />
                    <ButtonCn Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm"
                              Class="h-8 shrink-0 gap-1 text-xs"
                              OnClick="@(() => _submitted = true)">
                        <LucideIconCn Name="send" Size="12" Class="size-3" />
                        Send
                    </ButtonCn>
                </div>
            }

            @if (_submitted)
            {
                <p class="mt-2 text-xs text-muted-foreground">
                    Thanks for your feedback.
                </p>
            }
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Title
                    </p>
                    <ul class="mt-2.5 space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href"
                                   class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private string? _rating = null;
    private bool _submitted = false;

    private void SetRating(string value)
    {
        _rating = _rating == value ? null : value;
        _submitted = false;
    }

    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Support",
        [
            new("Documentation", "#"),
            new("Help Center", "#"),
            new("Community", "#"),
            new("Status", "#"),
        ]),
    ];
}
