@* ============================================================
   Block: footer-animated-links
   Title: FooterAnimatedLinks
   Description: An animated links React footer block for Next.js with three navigation columns where each link reveals an ArrowRightIcon and slides right on hover built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-animated-links.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand *@
    <div class="border-b px-4 py-4">
      <p class="text-sm font-medium">Acme Inc</p>
      <p class="mt-1 max-w-sm text-xs text-muted-foreground">
        Modern developer tools for teams that ship fast.
      </p>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-2 gap-6 border-b px-4 py-4 sm:grid-cols-3">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Title
          </p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a
                  href="@lnk.Href"
                  class="group inline-flex items-center gap-1 text-sm text-muted-foreground transition-all duration-200 hover:translate-x-1 hover:text-foreground"
                >
                  <LucideIconCn Name="arrow-right" Size="12" Class="size-3 -translate-x-1 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100" />
                  <span>@lnk.Label</span>
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record FooterLink(string Label, string Href);
    private record FooterLinkColumn(string Title, FooterLink[] Links);

    private static readonly FooterLinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
            new("Roadmap", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("API Reference", "#"),
            new("Guides", "#"),
            new("Blog", "#"),
            new("Community", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
            new("Press", "#"),
            new("Partners", "#"),
        ]),
    ];
}
