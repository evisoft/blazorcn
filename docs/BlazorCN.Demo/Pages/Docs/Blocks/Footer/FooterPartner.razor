@* ============================================================
   Block: footer-partner
   Title: FooterPartner
   Description: A partner program React footer block for Next.js with partner type rows, apply button, navigation columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-partner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Partner section *@
    <div class="border-b px-4 py-4">
      <p class="text-sm font-medium">Partner with us</p>
      <p class="mt-1 text-xs text-muted-foreground">Join our ecosystem and grow together.</p>
      <div class="mt-3 space-y-1">
        @foreach (var partner in _partnerTypes)
        {
          <div class="flex items-start gap-3 rounded-md px-2 py-2 transition-colors hover:bg-muted/50">
            <LucideIconCn Name="@partner.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0">
              <p class="text-sm font-medium">@partner.Label</p>
              <p class="text-xs text-muted-foreground">@partner.Description</p>
            </div>
          </div>
        }
      </div>
      <div class="mt-3">
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
          Apply Now
        </ButtonCn>
      </div>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product</p>
        <ul class="mt-3 space-y-1.5">
          @foreach (var link in _productLinks)
          {
            <li>
              <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                @link.Label
              </a>
            </li>
          }
        </ul>
      </div>
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Company</p>
        <ul class="mt-3 space-y-1.5">
          @foreach (var link in _companyLinks)
          {
            <li>
              <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                @link.Label
              </a>
            </li>
          }
        </ul>
      </div>
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
    </div>

  </div>
</section>

@code {
    private record PartnerType(string IconName, string Label, string Description);
    private record NavLink(string Label, string Href);

    private static readonly PartnerType[] _partnerTypes =
    [
        new("code", "Technology Partner", "Build integrations and extend the platform with your tools"),
        new("handshake", "Solution Partner", "Deliver implementation services and consulting to shared customers"),
        new("megaphone", "Affiliate Partner", "Earn commissions by referring new customers to our platform"),
    ];

    private static readonly NavLink[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("API", "#"),
        new("Changelog", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
        new("Contact", "#"),
        new("Press", "#"),
    ];
}
