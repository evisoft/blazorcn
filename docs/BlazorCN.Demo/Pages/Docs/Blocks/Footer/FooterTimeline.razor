@* ============================================================
   Block: footer-timeline
   Title: FooterTimeline
   Description: A timeline footer block for React and Next.js with a horizontal milestone timeline showing company journey, two link columns, and copyright text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-timeline.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Timeline section *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                Our Journey
            </p>
            <div class="flex items-center justify-between">
                @foreach (var ms in _milestones)
                {
                    var isLast = ms.Year == _milestones[_milestones.Length - 1].Year;
                    <div class="flex flex-1 items-center">
                        <div class="flex flex-col items-center gap-1">
                            <span class="@Cn.Merge("size-2.5 shrink-0 rounded-full", isLast ? "bg-foreground" : "bg-muted-foreground/40")"
                                  aria-hidden="true"></span>
                            <span class="font-medium text-xs">@ms.Year</span>
                            <span class="text-muted-foreground text-xs">@ms.Label</span>
                        </div>
                        @if (!isLast)
                        {
                            <div class="mx-1 h-px flex-1 bg-muted-foreground/20" aria-hidden="true"></div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Link columns *@
        <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-6 border-b px-4 py-3">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        @col.Heading
                    </p>
                    <ul class="flex flex-col gap-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href"
                                   class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* Copyright *@
        <div class="flex items-center px-4 py-3">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record Milestone(string Year, string Label);
    private record FooterLink(string Label, string Href);
    private record LinkColumn(string Heading, FooterLink[] Links);

    private static readonly Milestone[] _milestones =
    [
        new("2020", "Founded"),
        new("2022", "Series A"),
        new("2024", "1M Users"),
        new("2026", "Global Launch"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
    ];
}
