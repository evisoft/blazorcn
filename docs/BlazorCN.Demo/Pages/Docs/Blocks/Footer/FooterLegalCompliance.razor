@* ========================================
   Block: footer-legal-compliance
   Title: Footer Legal Compliance
   Description: Compliance-focused footer with certification badges, data residency info, encryption details, and regulatory disclaimers for regulated industries
   Long Description: A compliance-first footer built for regulated industries
   Dependencies: None
   Source: original/blocks/footer/footer-legal-compliance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Compliance certifications *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-3">
            <span class="mr-1 text-xs font-medium text-muted-foreground">Certifications</span>
            @foreach (var cert in _certifications)
            {
                <span class="rounded border px-2 py-0.5 font-mono text-[10px] text-muted-foreground">
                    @cert
                </span>
            }
        </div>

        @* Data & Privacy *@
        <div class="grid grid-cols-1 gap-4 border-b px-4 py-3 sm:grid-cols-3">
            <div>
                <p class="text-xs font-medium text-muted-foreground">Data Residency</p>
                <div class="mt-1.5 space-y-1">
                    @foreach (var region in _regions)
                    {
                        <div class="flex items-center gap-2">
                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                            <span class="text-xs text-foreground/80">@region.Name</span>
                            <span class="font-mono text-xs text-muted-foreground">
                                @string.Join(", ", region.Locations)
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div>
                <p class="text-xs font-medium text-muted-foreground">Encryption</p>
                <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                    AES-256 at rest, TLS 1.3 in transit. All keys managed via hardware security modules
                    with automatic rotation.
                </p>
            </div>

            <div>
                <p class="text-xs font-medium text-muted-foreground">Retention</p>
                <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                    Configurable 30-day to 7-year retention policies. Automated purge with audit trail and
                    compliance hold support.
                </p>
            </div>
        </div>

        @* Legal links *@
        <div class="space-y-1.5 border-b px-4 py-3">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                @foreach (var link in _legalLinksRow1)
                {
                    <a href="@link.Href"
                       class="inline-flex min-h-6 items-center text-xs text-foreground/80 transition-colors hover:text-foreground">
                        @link.Label
                    </a>
                }
            </div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                @foreach (var link in _legalLinksRow2)
                {
                    <a href="@link.Href"
                       class="inline-flex min-h-6 items-center text-xs text-foreground/80 transition-colors hover:text-foreground">
                        @link.Label
                    </a>
                }
            </div>
        </div>

        @* Regulatory disclaimer *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground leading-relaxed">
                    Compliance certifications and attestations are maintained through independent
                    third-party audits. This information is provided for transparency purposes and does
                    not constitute legal advice. Organizations operating in regulated industries should
                    consult qualified legal counsel to determine applicable requirements. Certification
                    scope and audit reports are available upon request under NDA.
                </p>
            </div>
        </div>

        @* Bottom bar *@
        <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-muted-foreground">
                &copy; @DateTime.Now.Year Acme Inc. All rights reserved.
            </p>
            <p class="text-xs text-muted-foreground">Last security audit: January @DateTime.Now.Year</p>
        </div>
    </div>
</section>

@code {
    private readonly string[] _certifications = ["SOC 2 Type II", "HIPAA", "GDPR", "CCPA", "ISO 27001", "PCI DSS"];

    private record Region(string Name, string[] Locations);

    private readonly List<Region> _regions =
    [
        new("US", ["us-east-1", "us-west-2"]),
        new("EU", ["eu-west-1", "eu-central-1"]),
        new("APAC", ["ap-southeast-1"]),
    ];

    private record LegalLink(string Label, string Href);

    private readonly LegalLink[] _legalLinksRow1 =
    [
        new("Privacy Policy", "#"), new("Terms of Service", "#"),
        new("Data Processing Agreement", "#"), new("Acceptable Use Policy", "#"),
    ];

    private readonly LegalLink[] _legalLinksRow2 =
    [
        new("Cookie Policy", "#"), new("Accessibility Statement", "#"),
        new("Security Whitepaper", "#"), new("Responsible Disclosure", "#"),
    ];
}
