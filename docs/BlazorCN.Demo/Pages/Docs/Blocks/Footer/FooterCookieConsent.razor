@* ============================================================
   Block: footer-cookie-consent
   Title: FooterCookieConsent
   Description: A cookie consent React footer block for Next.js with cookie notice banner, accept and manage buttons, three navigation columns, and privacy-focused copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-cookie-consent.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Cookie consent banner *@
    <div class="flex flex-col gap-3 border-b px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2.5">
        <LucideIconCn Name="cookie" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
        <p class="text-sm text-muted-foreground">We use cookies to improve your experience.</p>
      </div>
      <div class="flex items-center gap-2">
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
          Manage
        </ButtonCn>
        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
          Accept
        </ButtonCn>
      </div>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Heading
          </p>
          <ul class="mt-3 space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved. Your privacy is important to us.
      </p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("Guides", "#"),
            new("API Reference", "#"),
            new("Community", "#"),
        ]),
        new("Legal",
        [
            new("Privacy Policy", "#"),
            new("Terms of Service", "#"),
            new("Cookie Policy", "#"),
            new("GDPR", "#"),
        ]),
    ];
}
