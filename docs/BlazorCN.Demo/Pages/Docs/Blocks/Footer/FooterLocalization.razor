@* ========================================
   Block: footer-localization
   Title: Footer Localization
   Description: Footer with language and currency selectors for international sites with newsletter subscription
   Long Description: Footer with newsletter subscription
   Dependencies: 
   Source: original/blocks/footer/footer-localization.tsx
   ======================================== *@
<footer class="bg-primary w-full pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 justify-between gap-10 sm:grid-cols-2">
          <div class="row-start-2 grid grid-cols-2 justify-between gap-6 sm:row-auto lg:grid-cols-4">
            @foreach (var item in _links)
            {
                <ul class="space-y-2">
                <p class="text-primary-foreground mb-2 font-semibold">@item.Title</p>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-primary-foreground/80 hover:text-primary-foreground text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
          <div class="lg:ml-auto">
            <p class="text-primary-foreground mb-4 flex font-semibold lg:justify-end">
              Language & Currency
            </p>
            <SelectCn>
              <SelectTriggerCn class="mb-4 border-white/20 bg-white/10 text-white placeholder:text-white/60 lg:w-72">
                <SelectValueCn Placeholder="Select Language" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="english">English</SelectItemCn>
                <SelectItemCn Value="spanish">Spanish</SelectItemCn>
                <SelectItemCn Value="hindi">Hindi</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
            <SelectCn>
              <SelectTriggerCn class="border-white/20 bg-white/10 text-white placeholder:text-white/60 lg:w-72">
                <SelectValueCn Placeholder="Select Currency" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="usd">USD</SelectItemCn>
                <SelectItemCn Value="euro">Euro</SelectItemCn>
                <SelectItemCn Value="rupee">Rupee</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>
        </div>
        <div class="mt-10 flex flex-col justify-between gap-4 border-t border-white/20 pb-8 pt-6 md:flex-row lg:items-end">
          <div>
            <p class="text-primary-foreground mb-2 font-semibold">
              Subscribe to our newsletters
            </p>
            <p class="text-primary-foreground/80 text-sm">
              The latest news, articles and resources sent to your inbox weekly.
            </p>
          </div>
          <div class="flex w-full items-end gap-2 md:max-w-sm">
            <div class="w-full">
              <LabelCn
                Class="text-primary-foreground mb-2 inline-block text-sm font-semibold"
                for="email"
              >
                Your Email
              </LabelCn>
              <InputCn
                Class="border-white/20 bg-white/10 text-white placeholder:text-white/60"
                id="email"
                Placeholder="@("someone@example.com")"
                type="email"
              />
            </div>
            <ButtonCn Class="shrink-0" Variant="ButtonVariant.Secondary">
              subscribe
            </ButtonCn>
          </div>
        </div>
        <p class="text-primary-foreground/80 mt-8 text-sm">
          All rights reserved. &copy; @_year shadcn.io
        </p>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Company", [new("About Us", "#"), new("Careers", "#"), new("Premium Tools", "#"), new("Blogs", "#")]),
        new("Pages", [new("Login", "#"), new("Register", "#"), new("Add List", "#"), new("Contact", "#")]),
        new("Legal", [new("Terms", "#"), new("Privacy", "#"), new("Teams", "#"), new("About Us", "#")]),
        new("Resources", [new("Blog", "#"), new("Services", "#"), new("Products", "#"), new("Pricing", "#")]),
    ];
}
