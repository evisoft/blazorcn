@* ========================================
   Block: footer-stacked-minimal
   Title: Footer Stacked Minimal
   Description: Ultra-minimal single-column centered footer with stacked link rows and brand tagline for clean Next.js landing pages
   Long Description: Strip the footer down to its essence. This ultra-minimal footer stacks a brand tagline, navigation links, legal links, and copyright into clean centered rows separated by subtle borders.
   Dependencies: None
   Source: original/blocks/footer/footer-stacked-minimal.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Brand *@
        <div class="border-b px-4 py-3 text-center">
            <p class="text-sm font-medium">Acme</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Build better products, faster.</p>
        </div>

        @* Primary links *@
        <div class="border-b px-4 py-3 text-center">
            <nav class="flex flex-wrap items-center justify-center gap-x-1 gap-y-1" aria-label="Footer">
                @for (var i = 0; i < _primaryLinks.Length; i++)
                {
                    var link = _primaryLinks[i];
                    <span class="flex items-center gap-1">
                        <a
                            href="@link.Href"
                            class="text-xs text-foreground transition-colors hover:text-muted-foreground">
                            @link.Label
                        </a>
                        @if (i < _primaryLinks.Length - 1)
                        {
                            <span class="text-xs text-muted-foreground/40">&#xB7;</span>
                        }
                    </span>
                }
            </nav>
        </div>

        @* Legal links *@
        <div class="border-b px-4 py-3 text-center">
            <nav class="flex flex-wrap items-center justify-center gap-x-1 gap-y-1" aria-label="Legal">
                @for (var i = 0; i < _legalLinks.Length; i++)
                {
                    var link = _legalLinks[i];
                    <span class="flex items-center gap-1">
                        <a
                            href="@link.Href"
                            class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                            @link.Label
                        </a>
                        @if (i < _legalLinks.Length - 1)
                        {
                            <span class="text-xs text-muted-foreground/40">&#xB7;</span>
                        }
                    </span>
                }
            </nav>
        </div>

        @* Copyright + Social *@
        <div class="px-4 py-3 text-center">
            <div class="flex flex-wrap items-center justify-center gap-x-1 gap-y-1">
                <span class="text-xs text-muted-foreground">&copy; 2026 Acme Inc</span>
                <span class="text-xs text-muted-foreground/40">&#xB7;</span>
                @for (var i = 0; i < _socialLinks.Length; i++)
                {
                    var link = _socialLinks[i];
                    <span class="flex items-center gap-1">
                        <a
                            href="@link.Href"
                            class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                            @link.Label
                        </a>
                        @if (i < _socialLinks.Length - 1)
                        {
                            <span class="text-xs text-muted-foreground/40">&#xB7;</span>
                        }
                    </span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record LinkItem(string Label, string Href);

    private static readonly LinkItem[] _primaryLinks =
    [
        new("Product", "#"),
        new("Pricing", "#"),
        new("Docs", "#"),
        new("Blog", "#"),
        new("Changelog", "#"),
        new("Careers", "#"),
    ];

    private static readonly LinkItem[] _legalLinks =
    [
        new("Privacy", "#"),
        new("Terms", "#"),
        new("Cookies", "#"),
    ];

    private static readonly LinkItem[] _socialLinks =
    [
        new("GitHub", "#"),
        new("X", "#"),
        new("Discord", "#"),
    ];
}
