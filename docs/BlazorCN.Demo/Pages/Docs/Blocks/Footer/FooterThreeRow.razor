@* ============================================================
   Block: footer-three-row
   Title: FooterThreeRow
   Description: A three-row footer block for React and Next.js with a four-column link grid, centered newsletter signup form, and copyright bar with social icons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-three-row.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Row 1: Link columns *@
    <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-6 border-b px-4 py-3 sm:grid-cols-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@col.Heading</p>
          <ul class="flex flex-col gap-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">@lnk.Label</a>
              </li>
            }
          </ul>
        </div>
      }
    </nav>

    @* Row 2: Newsletter form *@
    <div class="flex flex-col items-center gap-2 border-b px-4 py-3">
      <p class="font-medium text-sm">Subscribe to our newsletter</p>
      <p class="text-muted-foreground text-xs">Get product updates and engineering insights delivered weekly.</p>
      <form class="mt-1 flex w-full max-w-sm items-center gap-2" @onsubmit:preventDefault="true">
        <InputCn type="email" Placeholder="@("you@example.com")" Class="h-8 text-sm" aria-label="Email address" />
        <ButtonCn type="submit" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">Subscribe</ButtonCn>
      </form>
    </div>

    @* Row 3: Copyright + social icons *@
    <div class="flex flex-col items-center justify-between gap-3 px-4 py-3 sm:flex-row">
      <p class="text-muted-foreground text-xs">&copy; 2026 Acme Inc. All rights reserved.</p>
      <div class="flex items-center gap-3">
        <a href="#" aria-label="Twitter" class="text-muted-foreground transition-colors hover:text-foreground">
          <LucideTwitterCn Size="16" Class="size-4" />
        </a>
        <a href="#" aria-label="GitHub" class="text-muted-foreground transition-colors hover:text-foreground">
          <LucideGithubCn Size="16" Class="size-4" />
        </a>
        <a href="#" aria-label="LinkedIn" class="text-muted-foreground transition-colors hover:text-foreground">
          <LucideLinkedinCn Size="16" Class="size-4" />
        </a>
      </div>
    </div>

  </div>
</section>

@code {
    private record FooterLink(string Label, string Href);
    private record FooterColumn(string Heading, FooterLink[] Links);

    private static readonly FooterColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Blog", "#"),
            new("Careers", "#"),
            new("Press", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("Guides", "#"),
            new("API Reference", "#"),
            new("Community", "#"),
        ]),
        new("Legal",
        [
            new("Privacy", "#"),
            new("Terms", "#"),
            new("Security", "#"),
            new("Cookies", "#"),
        ]),
    ];
}
