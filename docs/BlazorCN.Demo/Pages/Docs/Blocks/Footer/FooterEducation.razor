@* ============================================================
   Block: footer-education
   Title: FooterEducation
   Description: A React education platform footer block for Next.js with four navigation columns, accreditation badge, learning support notice, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-education.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Brand + accreditation *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Acme Academy</p>
            </div>
            <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5">
                <LucideIconCn Name="award" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">
                    Accredited Institution
                </span>
            </div>
        </div>

        @* Link columns *@
        <div class="grid grid-cols-2 gap-6 border-b px-4 py-4 sm:grid-cols-4">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Title
                    </p>
                    <ul class="mt-2.5 space-y-1.5">
                        @foreach (var link in col.Links)
                        {
                            <li>
                                <a
                                    href="@link.Href"
                                    class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                                >
                                    @link.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Learning support notice *@
        <div class="flex items-center gap-2.5 border-b px-4 py-3">
            <LucideIconCn Name="headset" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <p class="text-xs text-muted-foreground">
                24/7 Learning Support available via live chat and email for all enrolled students.
            </p>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Academy Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Courses", [
            new("Browse Catalog", "#"),
            new("Learning Paths", "#"),
            new("Certifications", "#"),
            new("Free Courses", "#"),
        ]),
        new("Students", [
            new("Dashboard", "#"),
            new("Transcripts", "#"),
            new("Community", "#"),
            new("Career Services", "#"),
        ]),
        new("Teachers", [
            new("Teach on Acme", "#"),
            new("Instructor Dashboard", "#"),
            new("Resources", "#"),
            new("Guidelines", "#"),
        ]),
        new("About", [
            new("Our Mission", "#"),
            new("Blog", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];
}
