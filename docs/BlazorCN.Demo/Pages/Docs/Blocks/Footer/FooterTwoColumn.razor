@* ============================================================
   Block: footer-two-column
   Title: FooterTwoColumn
   Description: A clean two-column footer block for React and Next.js with brand name, description, social icons on the left and a single navigation link list on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-two-column.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Two-column content *@
        <div class="grid grid-cols-1 gap-6 border-b px-4 py-3 md:grid-cols-2">
            @* Left: Brand + description + socials *@
            <div class="flex flex-col gap-3">
                <span class="font-medium text-sm">Acme Inc</span>
                <p class="text-muted-foreground text-sm">
                    Building modern developer tools that help teams ship faster and with more
                    confidence.
                </p>
                <div class="flex items-center gap-3">
                    @foreach (var lnk in _socialLinks)
                    {
                        var link = lnk;
                        <a href="@link.Href"
                           aria-label="@link.Label"
                           class="text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="@link.Icon" Size="16" Class="size-4" />
                        </a>
                    }
                </div>
            </div>

            @* Right: Link list *@
            <nav aria-label="Footer navigation">
                <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                    Navigation
                </p>
                <ul class="flex flex-col gap-1.5">
                    @foreach (var lnk in _navLinks)
                    {
                        var link = lnk;
                        <li>
                            <a href="@link.Href"
                               class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>

        @* Copyright *@
        <div class="flex items-center px-4 py-3">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);
    private record SocialLink(string Label, string Href, string Icon);

    private static readonly NavLink[] _navLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Documentation", "#"),
        new("Blog", "#"),
        new("Changelog", "#"),
        new("Support", "#"),
    ];

    private static readonly SocialLink[] _socialLinks =
    [
        new("Twitter", "#", "twitter"),
        new("GitHub", "#", "github"),
        new("LinkedIn", "#", "linkedin"),
        new("Email", "#", "mail"),
    ];
}
