<footer class="w-full border-t pb-8 pt-20">
      <div class="container mx-auto px-4">
        <div class="mb-12 grid grid-cols-1 items-start justify-between gap-8 md:grid-cols-2 lg:gap-12">
          <div>
            <h6 class="text-2xl font-semibold">shadcn.io</h6>
            <p class="text-muted-foreground mt-3 max-w-md text-sm">
              The reward for getting on the stage is fame.
            </p>
          </div>
          <div class="grid grid-cols-3 gap-x-8 gap-y-6 md:ml-auto">
            @foreach (var item in _links)
            {
                <ul class="space-y-3">
                <p class="mb-3 font-semibold">@item.Title</p>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
        </div>
        <div class="border-border flex flex-col items-start justify-between gap-6 border-t pt-8 md:flex-row md:items-center">
          <p class="text-muted-foreground max-w-2xl text-sm">
            The price of fame is you can&apos;t get off the stage.
          </p>
          <p class="text-muted-foreground whitespace-nowrap text-sm">
            &copy; @_year shadcn.io. All Rights Reserved.
          </p>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Company", [new("About Us", "#"), new("Careers", "#")]),
        new("Pages", [new("Login", "#"), new("Register", "#")]),
        new("Legal", [new("Terms", "#"), new("Privacy", "#")]),
    ];
}
