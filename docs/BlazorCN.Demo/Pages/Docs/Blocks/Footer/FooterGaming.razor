@* ============================================================
   Block: footer-gaming
   Title: FooterGaming
   Description: A gaming platform footer block for React and Next.js with brand tagline, three navigation columns, platform badges row, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-gaming.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Brand + link columns *@
        <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 md:grid-cols-2">

            @* Brand section *@
            <div>
                <span class="font-medium text-sm">NexusPlay</span>
                <p class="mt-1 text-muted-foreground text-xs">
                    Join 2M+ players worldwide. Play, compete, and connect.
                </p>
            </div>

            @* Link columns *@
            <div class="grid grid-cols-3 gap-6">
                @foreach (var col in _linkColumns)
                {
                    <div>
                        <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@col.Title</p>
                        <ul class="space-y-1.5">
                            @foreach (var item in col.Items)
                            {
                                <li>
                                    <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                                        @item.Label
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        @* Platform badges *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Available on</span>
            @foreach (var platform in _platforms)
            {
                <span class="inline-flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="@platform.IconName" Size="12" Class="size-3" />
                    @platform.Label
                </span>
            }
        </div>

        @* Copyright *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 NexusPlay Inc. All rights reserved.
            </p>
            <div class="flex items-center gap-3">
                <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
                    Terms
                </a>
                <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
                    Privacy
                </a>
            </div>
        </div>

    </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Games",
        [
            new("New Releases", "#"),
            new("Top Rated", "#"),
            new("Free to Play", "#"),
            new("Early Access", "#"),
        ]),
        new("Community",
        [
            new("Discord", "#"),
            new("Forums", "#"),
            new("Tournaments", "#"),
            new("Leaderboards", "#"),
        ]),
        new("Support",
        [
            new("Help Center", "#"),
            new("Bug Reports", "#"),
            new("Account Recovery", "#"),
            new("Contact Us", "#"),
        ]),
    ];

    private record PlatformBadge(string Label, string IconName);

    private static readonly PlatformBadge[] _platforms =
    [
        new("PC", "monitor"),
        new("Console", "gamepad"),
        new("Mobile", "smartphone"),
    ];
}
