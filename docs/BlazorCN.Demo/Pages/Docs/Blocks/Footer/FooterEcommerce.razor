@* ============================================================
   Block: footer-ecommerce
   Title: FooterEcommerce
   Description: An e-commerce footer block for React and Next.js with four navigation columns for shop, support, company, and legal links plus a payment methods badge row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-ecommerce.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Link columns *@
    <div class="grid grid-cols-2 gap-6 border-b px-4 py-4 md:grid-cols-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@col.Title</p>
          <ul class="space-y-1.5">
            @foreach (var item in col.Items)
            {
              <li>
                <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                  @item.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Payment methods + copyright *@
    <div class="flex flex-col items-center justify-between gap-3 px-4 py-3 sm:flex-row">
      <div class="flex items-center gap-1.5">
        @foreach (var method in _paymentMethods)
        {
          <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono text-muted-foreground text-xs">@method</BadgeCn>
        }
      </div>
      <p class="text-muted-foreground text-xs">&copy; 2026 Acme Store. All rights reserved.</p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Shop", [new("New Arrivals", "#"), new("Best Sellers", "#"), new("Sale", "#"), new("Gift Cards", "#")]),
        new("Support", [new("Shipping", "#"), new("Returns", "#"), new("Size Guide", "#"), new("FAQ", "#")]),
        new("Company", [new("About", "#"), new("Sustainability", "#"), new("Press", "#")]),
        new("Legal", [new("Terms", "#"), new("Privacy", "#"), new("Cookies", "#"), new("Accessibility", "#")]),
    ];

    private static readonly string[] _paymentMethods = ["Visa", "Mastercard", "Amex", "PayPal"];
}
