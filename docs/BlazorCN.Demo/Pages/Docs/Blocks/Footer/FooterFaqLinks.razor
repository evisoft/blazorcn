@* ============================================================
   Block: footer-faq-links
   Title: FooterFaqLinks
   Description: A FAQ links footer block for React and Next.js with common questions section, navigation link columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-faq-links.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* FAQ header *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Common questions
            </p>
        </div>

        @* FAQ links *@
        <div class="border-b">
            @foreach (var faq in _faqLinks)
            {
                var isLast = faq == _faqLinks[_faqLinks.Length - 1];
                <a href="@faq.Href"
                   class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    <span class="flex-1 text-sm text-muted-foreground transition-colors group-hover:text-foreground">
                        @faq.Label
                    </span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground/40 transition-transform group-hover:translate-x-0.5" />
                </a>
            }
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Heading
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href"
                                   class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record FaqLink(string Label, string Href);
    private record NavLink(string Label, string Href);
    private record LinkColumn(string Heading, NavLink[] Links);

    private static readonly FaqLink[] _faqLinks =
    [
        new("How to get started", "#"),
        new("Pricing explained", "#"),
        new("Cancellation policy", "#"),
        new("Data security", "#"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("API", "#"),
            new("Integrations", "#"),
        ]),
        new("Support",
        [
            new("Help Center", "#"),
            new("Community", "#"),
            new("Status", "#"),
            new("Contact", "#"),
        ]),
    ];
}
