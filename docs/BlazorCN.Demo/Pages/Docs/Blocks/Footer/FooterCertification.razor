@* ============================================================
   Block: footer-certification
   Title: FooterCertification
   Description: A React certification footer block for Next.js with four compliance badges, audit date, three navigation columns, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-certification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Certification badges *@
    <div class="border-b px-4 py-4">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        @foreach (var cert in _certifications)
        {
          <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2.5">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <span class="text-sm font-medium">@cert.Label</span>
          </div>
        }
      </div>
      <p class="mt-3 text-xs text-muted-foreground">Last audited: Jan 2026</p>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Heading
          </p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record CertEntry(string Label);
    private record LinkEntry(string Label, string Href);
    private record LinkColumn(string Heading, LinkEntry[] Links);

    private static readonly CertEntry[] _certifications =
    [
        new("ISO 27001"),
        new("SOC 2"),
        new("GDPR"),
        new("PCI DSS"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Security", "#"),
            new("Enterprise", "#"),
            new("Pricing", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
        new("Legal",
        [
            new("Privacy Policy", "#"),
            new("Terms of Service", "#"),
            new("Cookie Policy", "#"),
            new("DPA", "#"),
        ]),
    ];
}
