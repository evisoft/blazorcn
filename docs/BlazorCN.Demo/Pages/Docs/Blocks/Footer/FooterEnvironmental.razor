@* ============================================================
   Block: footer-environmental
   Title: FooterEnvironmental
   Description: An environmental sustainability React footer block for Next.js with carbon neutral banner, green metrics, navigation columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-environmental.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Carbon neutral banner *@
        <div class="flex items-center gap-2.5 border-b px-4 py-3">
            <LucideIconCn Name="leaf" Size="16" Class="size-4 shrink-0 text-emerald-500" />
            <p class="text-sm font-medium">Carbon neutral since 2024</p>
        </div>

        @* Sustainability metrics *@
        <div class="grid grid-cols-1 gap-px border-b bg-border sm:grid-cols-3">
            @foreach (var metric in _metrics)
            {
                <div class="flex items-center gap-3 bg-card px-4 py-3">
                    <LucideIconCn Name="@metric.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <p class="text-sm font-medium tabular-nums">@metric.Value</p>
                        <p class="text-xs text-muted-foreground">@metric.Label</p>
                    </div>
                </div>
            }
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product</p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var lnk in _productLinks)
                    {
                        <li>
                            <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @lnk.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Company</p>
                <ul class="mt-3 space-y-1.5">
                    @foreach (var lnk in _companyLinks)
                    {
                        <li>
                            <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @lnk.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
        </div>

    </div>
</section>

@code {
    private record SustainabilityMetric(string IconName, string Label, string Value);
    private record NavLink(string Label, string Href);

    private static readonly SustainabilityMetric[] _metrics =
    [
        new("battery-charging", "Renewable energy", "100%"),
        new("recycle",          "Carbon offset",    "2,400 tons"),
        new("trees",            "Paperless since",  "2022"),
    ];

    private static readonly NavLink[] _productLinks =
    [
        new("Features",      "#"),
        new("Pricing",       "#"),
        new("Integrations",  "#"),
        new("Changelog",     "#"),
        new("Documentation", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About",          "#"),
        new("Sustainability", "#"),
        new("Careers",        "#"),
        new("Blog",           "#"),
        new("Contact",        "#"),
    ];
}
