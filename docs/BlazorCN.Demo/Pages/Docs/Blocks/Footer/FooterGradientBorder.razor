@* ============================================================
   Block: footer-gradient-border
   Title: FooterGradientBorder
   Description: A React gradient border footer block for Next.js with top border accent, brand section, three link columns, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-gradient-border.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border border-t-2 border-t-foreground bg-card">
        @* Brand *@
        <div class="border-b px-4 py-4">
            <p class="text-sm font-medium">Acme</p>
            <p class="mt-1 max-w-sm text-xs text-muted-foreground">
                Developer tools for modern teams. Ship faster with production-ready components and
                workflows.
            </p>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Heading
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href"
                                   class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("API Reference", "#"),
            new("Blog", "#"),
            new("Community", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
            new("Press", "#"),
        ]),
    ];
}
