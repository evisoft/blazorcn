@* ============================================================
   Block: footer-countdown
   Title: FooterCountdown
   Description: A React countdown launch footer block for Next.js with static time boxes, email signup form, two link columns, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Countdown *@
        <div class="border-b px-4 py-5">
            <p class="text-sm font-medium">
                Launching in
            </p>
            <div class="mt-3 grid grid-cols-4 gap-3 sm:max-w-xs">
                @foreach (var unit in _timeUnits)
                {
                    <div class="flex flex-col items-center rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-mono text-2xl font-semibold tabular-nums">@unit.Value</span>
                        <span class="mt-0.5 text-xs text-muted-foreground">@unit.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Email signup *@
        <div class="border-b px-4 py-4">
            <p class="text-xs text-muted-foreground">
                Get notified when we launch. No spam, just one email.
            </p>
            <div class="mt-2.5 flex items-center gap-2 sm:max-w-sm">
                <InputCn type="email" Placeholder="@("you@example.com")" aria-label="Email address" Class="h-8 text-xs" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">
                    Notify me
                </ButtonCn>
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            <div>
                <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Product
                </p>
                <ul class="space-y-1.5">
                    @foreach (var link in _productLinks)
                    {
                        <li>
                            <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div>
                <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Company
                </p>
                <ul class="space-y-1.5">
                    @foreach (var link in _companyLinks)
                    {
                        <li>
                            <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record TimeUnit(string Value, string Label);
    private record NavLink(string Label, string Href);

    private static readonly TimeUnit[] _timeUnits =
    [
        new("12", "Days"),
        new("08", "Hours"),
        new("45", "Min"),
        new("30", "Sec"),
    ];

    private static readonly NavLink[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("Changelog", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
        new("Contact", "#"),
    ];
}
