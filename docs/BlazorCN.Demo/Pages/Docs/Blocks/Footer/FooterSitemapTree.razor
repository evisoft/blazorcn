@* ============================================================
   Block: footer-sitemap-tree
   Title: FooterSitemapTree
   Description: A React sitemap tree footer block for Next.js with hierarchical navigation tree, vertical connector lines, indented child items, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-sitemap-tree.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Sitemap header *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Sitemap
            </p>
        </div>

        @* Tree *@
        <div class="space-y-1 border-b px-4 py-4">
            @foreach (var node in _sitemapTree)
            {
                <div>
                    <div class="flex items-center gap-2">
                        <div class="flex w-4 items-center justify-center">
                            <span class="block h-px w-3 border-t border-border"></span>
                        </div>
                        <a href="@node.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                            @node.Label
                        </a>
                    </div>
                    @if (node.Children != null && node.Children.Length > 0)
                    {
                        <div class="ml-2 border-l border-border pl-0">
                            @foreach (var child in node.Children)
                            {
                                <div class="flex items-center gap-0">
                                    <div class="flex w-4 items-center justify-center">
                                        <span class="block h-px w-3 border-t border-border"></span>
                                    </div>
                                    <a href="@child.Href" class="py-1 text-sm text-muted-foreground transition-colors hover:text-foreground">
                                        @child.Label
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record TreeNode(string Label, string Href, TreeNode[]? Children = null);

    private static readonly TreeNode[] _sitemapTree =
    [
        new("Home", "#"),
        new("Products", "#", [
            new("Features", "#"),
            new("Pricing", "#"),
            new("API", "#"),
        ]),
        new("Resources", "#", [
            new("Blog", "#"),
            new("Docs", "#"),
            new("Community", "#"),
        ]),
        new("Company", "#", [
            new("About", "#"),
            new("Careers", "#"),
        ]),
    ];
}
