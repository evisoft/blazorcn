@* ============================================================
   Block: footer-minimal-dark
   Title: FooterMinimalDark
   Description: A minimal dark React footer block for Next.js with zinc-950 background, copyright text, and three inline legal links in a single compact row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-minimal-dark.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-100">
    <div class="flex flex-col items-start gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-zinc-500">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        @foreach (var link in _legalLinks)
        {
          <a href="@link.Href" class="text-xs text-zinc-400 transition-colors hover:text-zinc-100">
            @link.Label
          </a>
        }
      </div>
    </div>
  </div>
</section>

@code {
    private record LegalLink(string Label, string Href);

    private static readonly LegalLink[] _legalLinks =
    [
        new("Privacy", "#"),
        new("Terms", "#"),
        new("Status", "#"),
    ];
}
