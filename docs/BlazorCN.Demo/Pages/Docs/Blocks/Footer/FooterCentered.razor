<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto grid place-items-center px-4">
        <ul class="mb-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          @foreach (var item in _links)
            {
                <li>
              <a
                class="text-foreground hover:text-primary text-sm font-semibold transition-colors"
                href="@item.Href"
              >
                @item.Title
              </a>
            </li>
            }
        </ul>
        <p class="text-foreground text-sm">Copyright &copy; @_year shadcn.io</p>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);

    private readonly LinkItem[] _links =
    [
        new("Company", "#"),
        new("About Us", "#"),
        new("Team", "#"),
        new("Products", "#"),
        new("Blogs", "#"),
        new("Pricing", "#"),
    ];
}
