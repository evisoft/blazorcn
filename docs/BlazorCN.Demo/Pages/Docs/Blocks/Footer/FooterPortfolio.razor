@* ============================================================
   Block: footer-portfolio
   Title: FooterPortfolio
   Description: A portfolio footer block for React and Next.js with centered name, bio, social links, availability badge, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-portfolio.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Name + bio *@
    <div class="border-b px-4 py-4 text-center">
      <p class="font-medium text-sm">Alex Chen</p>
      <p class="mt-1 text-muted-foreground text-xs">
        Design engineer crafting interfaces that feel inevitable
      </p>
    </div>

    @* Social links *@
    <div class="flex items-center justify-center gap-1 border-b px-4 py-3">
      @foreach (var link in _socialLinks)
      {
        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="@link.Label">
          <a href="@link.Href" aria-label="@link.Label" rel="noopener noreferrer" target="_blank">
            <LucideIconCn Name="@link.Icon" Size="14" Class="size-3.5" />
          </a>
        </ButtonCn>
      }
    </div>

    @* Availability badge + copyright *@
    <div class="flex flex-col items-center gap-2 px-4 py-3">
      <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
        <span class="size-1.5 rounded-full bg-emerald-500"></span>
        Available for freelance
      </BadgeCn>
      <p class="text-muted-foreground text-xs">&copy; 2026 Alex Chen</p>
    </div>

  </div>
</section>

@code {
    private record SocialLink(string Label, string Href, string Icon);

    private static readonly SocialLink[] _socialLinks =
    [
        new("Twitter",  "#", "twitter"),
        new("GitHub",   "#", "github"),
        new("Dribbble", "#", "dribbble"),
        new("LinkedIn", "#", "linkedin"),
    ];
}
