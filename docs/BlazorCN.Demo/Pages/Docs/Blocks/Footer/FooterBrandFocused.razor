@* ============================================================
   Block: footer-brand-focused
   Title: FooterBrandFocused
   Description: A brand-heavy footer block for React and Next.js with large brand name, multi-line mission statement, single row of navigation links, and copyright text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-brand-focused.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand section *@
    <div class="flex flex-col items-center gap-3 border-b px-4 py-6 text-center">
      <span class="font-semibold text-2xl tabular-nums">Acme</span>
      <p class="max-w-md text-muted-foreground text-sm leading-relaxed">
        We believe great software starts with great developer experience. Our mission is to
        build tools that empower teams to ship faster, iterate with confidence, and focus on
        what matters most — creating value for their users.
      </p>
    </div>

    @* Navigation links row *@
    <nav aria-label="Footer navigation"
         class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 border-b px-4 py-3">
      @foreach (var link in _navLinks)
      {
        <a href="@link.Href"
           class="text-muted-foreground text-sm transition-colors hover:text-foreground">
          @link.Label
        </a>
      }
    </nav>

    @* Copyright *@
    <div class="flex items-center justify-center px-4 py-3">
      <p class="text-muted-foreground text-xs">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _navLinks =
    [
        new("About",   "#"),
        new("Careers", "#"),
        new("Blog",    "#"),
        new("Press",   "#"),
        new("Contact", "#"),
    ];
}
