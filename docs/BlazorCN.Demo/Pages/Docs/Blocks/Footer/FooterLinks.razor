@* ========================================
   Block: footer-links
   Title: Footer Links
   Description: Footer with navigation links and sign-in button in clean horizontal layout
   Long Description: Footer with copyright and social links
   Dependencies: 
   Source: original/blocks/footer/footer-links.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="flex flex-row flex-wrap items-center justify-center gap-x-10 gap-y-3 border-t border-border pt-8 text-center md:justify-between">
          <p class="text-foreground text-sm">Copyright &copy; @_year shadcn.io</p>
          <ul class="flex flex-wrap items-center justify-center gap-6">
            @foreach (var item in _links)
            {
                <li>
                <a
                  class="text-foreground hover:text-primary text-sm transition-colors"
                  href="@item.Href"
                >
                  @item.Title
                </a>
              </li>
            }
            <ButtonCn Class="w-full sm:max-w-fit">Sign in</ButtonCn>
          </ul>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);

    private readonly LinkItem[] _links =
    [
        new("Home", "#"),
        new("About Us", "#"),
        new("Blog", "#"),
        new("Service", "#"),
    ];
}
