@* ============================================================
   Block: footer-social-proof
   Title: FooterSocialProof
   Description: A social proof React footer block for Next.js with trusted-by heading, company logos, three navigation columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-social-proof.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Social proof banner *@
        <div class="border-b px-4 py-4">
            <p class="text-sm font-medium">
                Trusted by 50,000+ teams
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-4">
                @foreach (var company in _companies)
                {
                    <span class="text-sm font-medium text-muted-foreground">@company</span>
                }
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Heading</p>
                    <ul class="mt-3 space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _companies = ["Google", "Stripe", "Vercel", "Linear", "Notion"];

    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Security", "#"),
            new("Enterprise", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("Guides", "#"),
            new("API Reference", "#"),
            new("Changelog", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Blog", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];
}
