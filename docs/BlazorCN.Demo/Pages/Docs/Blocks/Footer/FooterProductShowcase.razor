@* ========================================
   Block: footer-product-showcase
   Title: Footer Product Showcase
   Description: Product-led footer with descriptive navigation sections, connected grid layout, and resource links for SaaS landing pages
   Long Description: Footer with multi-column navigation links and newsletter subscription form with checkbox consent
   Dependencies: None
   Source: original/blocks/footer/footer-product-showcase.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Explore our platform</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Everything you need to build, measure, and scale your product
            </p>
        </div>

        @* Product areas -- connected grid *@
        <div class="grid grid-cols-2 gap-px border-b bg-border lg:grid-cols-4">
            @foreach (var area in _productAreas)
            {
                <div class="bg-card px-4 py-3">
                    <p class="text-sm font-medium">@area.Name</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@area.Description</p>
                    <ul class="mt-3 space-y-1.5">
                        @foreach (var link in area.Links)
                        {
                            <li>
                                <a
                                    href="@link.Href"
                                    class="text-xs text-foreground/80 transition-colors hover:text-foreground">
                                    @link.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Resources row *@
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b px-4 py-3">
            @foreach (var link in _resourceLinks)
            {
                <a
                    href="@link.Href"
                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    @link.Label
                </a>
            }
        </div>

        @* Bottom bar *@
        <div class="flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc</p>
            <div class="flex items-center gap-4">
                @foreach (var link in _socialLinks)
                {
                    <a
                        href="@link.Href"
                        class="text-xs text-muted-foreground/60 transition-colors hover:text-foreground"
                        target="_blank"
                        rel="noopener noreferrer">
                        @link.Label
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record ProductArea(string Name, string Description, LinkItem[] Links);

    private static readonly ProductArea[] _productAreas =
    [
        new("Analytics", "Real-time dashboards and custom reports",
        [
            new("Dashboards", "#"),
            new("Custom Reports", "#"),
            new("Funnels", "#"),
            new("Cohorts", "#"),
        ]),
        new("Automation", "Workflows that run on autopilot",
        [
            new("Workflow Builder", "#"),
            new("Triggers", "#"),
            new("Templates", "#"),
        ]),
        new("Security", "Enterprise-grade access controls",
        [
            new("SSO & SAML", "#"),
            new("Audit Logs", "#"),
            new("Permissions", "#"),
            new("Compliance", "#"),
        ]),
        new("Integrations", "Connect your entire tool stack",
        [
            new("API", "#"),
            new("Webhooks", "#"),
            new("Marketplace", "#"),
        ]),
    ];

    private static readonly LinkItem[] _resourceLinks =
    [
        new("Help Center", "#"),
        new("API Docs", "#"),
        new("Community", "#"),
        new("Status", "#"),
        new("Careers", "#"),
    ];

    private static readonly LinkItem[] _socialLinks =
    [
        new("GitHub", "#"),
        new("X", "#"),
        new("LinkedIn", "#"),
        new("YouTube", "#"),
    ];
}
