@* ========================================
   Block: footer-upgrade
   Title: Footer Upgrade
   Description: Footer with prominent upgrade CTA and navigation links for freemium SaaS products
   Long Description: Footer with CTA card for newsletter
   Dependencies: 
   Source: original/blocks/footer/footer-upgrade.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-20">
      <div class="container mx-auto px-4">
        <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
          <div class="space-y-3">
            <p class="text-lg font-semibold">New Features available! Upgrade to v3.0.0</p>
            <ButtonCn Class="w-full md:w-auto" Size="ButtonSize.Default">
              Upgrade Now
            </ButtonCn>
          </div>
          <div class="flex flex-col gap-4 md:items-end">
            <ul class="flex flex-wrap items-center gap-x-8 gap-y-2">
              @foreach (var item in _links)
            {
                <li>
                  <a
                    class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                    href="@item.Href"
                  >
                    @item.Title
                  </a>
                </li>
            }
            </ul>
            <p class="text-muted-foreground text-sm">
              &copy; @_year shadcn.io. All rights reserved.
            </p>
          </div>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);

    private readonly LinkItem[] _links =
    [
        new("About Us", "#"),
        new("Contact Information", "#"),
        new("Privacy Policy", "#"),
    ];
}
