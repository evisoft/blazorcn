@* ============================================================
   Block: footer-open-source
   Title: FooterOpenSource
   Description: A React open source project footer block for Next.js with GitHub stars count, three navigation columns, MIT license badge, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-open-source.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + stars *@
    <div class="flex items-center justify-between border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="github" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">acme/framework</p>
      </div>
      <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs">
        <a href="#" target="_blank" rel="noopener noreferrer">
          <LucideIconCn Name="star" Size="14" Class="size-3.5" />
          12.4k stars
        </a>
      </ButtonCn>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Title</p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* License + copyright *@
    <div class="flex items-center justify-between px-4 py-3">
      <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
      <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5">
        <LucideIconCn Name="scale" Size="12" Class="size-3 text-muted-foreground" />
        <span class="text-xs font-medium text-muted-foreground">MIT License</span>
      </div>
    </div>

  </div>
</section>

@code {
    private record FooterLink(string Label, string Href);
    private record FooterColumn(string Title, FooterLink[] Links);

    private static readonly FooterColumn[] _linkColumns =
    [
        new("Project", [
            new("Documentation", "#"),
            new("Contributing", "#"),
            new("Changelog", "#"),
            new("License", "#"),
        ]),
        new("Community", [
            new("Discord", "#"),
            new("Discussions", "#"),
            new("Twitter", "#"),
            new("Blog", "#"),
        ]),
        new("Support", [
            new("Issues", "#"),
            new("Sponsors", "#"),
            new("Stack Overflow", "#"),
            new("Security", "#"),
        ]),
    ];
}
