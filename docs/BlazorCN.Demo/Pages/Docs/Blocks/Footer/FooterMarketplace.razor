@* ============================================================
   Block: footer-marketplace
   Title: FooterMarketplace
   Description: A marketplace footer block for React and Next.js with buyer and seller navigation sections, trust indicator badges, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Buyer + Seller columns *@
    <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 sm:grid-cols-2">
      @foreach (var grp in _linkGroups)
      {
        <div>
          <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
            @grp.Title
          </p>
          <ul class="space-y-1.5">
            @foreach (var item in grp.Items)
            {
              <li>
                <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                  @item.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Trust indicators *@
    <div class="flex flex-wrap items-center justify-center gap-4 border-b px-4 py-3">
      @foreach (var indicator in _trustIndicators)
      {
        <div class="flex items-center gap-1.5">
          <LucideIconCn Name="@indicator.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
          <span class="text-muted-foreground text-xs">@indicator.Label</span>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3 text-center">
      <p class="text-muted-foreground text-xs">
        &copy; 2026 Acme Market. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkGroup(string Title, LinkItem[] Items);
    private record TrustIndicator(string Label, string Icon);

    private static readonly LinkGroup[] _linkGroups =
    [
        new("For Buyers",
        [
            new("Browse Categories", "#"),
            new("How to Buy", "#"),
            new("Buyer Protection", "#"),
            new("Order Tracking", "#"),
            new("Returns", "#"),
        ]),
        new("For Sellers",
        [
            new("Start Selling", "#"),
            new("Seller Handbook", "#"),
            new("Fees & Pricing", "#"),
            new("Analytics Dashboard", "#"),
            new("Seller Community", "#"),
        ]),
    ];

    private static readonly TrustIndicator[] _trustIndicators =
    [
        new("Buyer Protection", "shield-check"),
        new("Secure Payments", "lock"),
        new("24/7 Support", "headphones"),
    ];
}
