@* ============================================================
   Block: footer-version-info
   Title: FooterVersionInfo
   Description: A version info footer block for React and Next.js with system version, last updated date, environment indicator, navigation link columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-version-info.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* System header *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                System
            </p>
        </div>

        @* System info rows *@
        <div class="border-b">
            @foreach (var info in _systemInfo)
            {
                var isLast = info == _systemInfo[_systemInfo.Length - 1];
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="text-sm text-muted-foreground">@info.Label</span>
                    <span class="font-mono text-xs text-muted-foreground">@info.Value</span>
                </div>
            }
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Heading
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record SystemInfoItem(string Label, string Value);
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly SystemInfoItem[] _systemInfo =
    [
        new("Version", "v4.2.0"),
        new("Last updated", "March 2026"),
        new("Environment", "Production"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("API Reference", "#"),
            new("Changelog", "#"),
            new("Status", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("Guides", "#"),
            new("Community", "#"),
            new("Support", "#"),
        ]),
    ];
}
