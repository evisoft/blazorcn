@* ============================================================
   Block: footer-language-selector
   Title: FooterLanguageSelector
   Description: A language selector footer block for React and Next.js with toggleable language buttons, three navigation link columns, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-language-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Language selector *@
        <div class="border-b px-4 py-3">
            <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Language
            </p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var lang in _languages)
                {
                    var langItem = lang;
                    <button
                        type="button"
                        @onclick="@(() => _selectedLanguage = langItem.Code)"
                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs font-medium transition-colors", _selectedLanguage == langItem.Code ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted hover:text-foreground")"
                    >
                        @langItem.Code
                    </button>
                }
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Heading
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a
                                    href="@lnk.Href"
                                    class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                                >
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private string _selectedLanguage = "EN";

    private record Language(string Code, string Label);
    private record NavLink(string Label, string Href);
    private record LinkColumn(string Heading, NavLink[] Links);

    private static readonly Language[] _languages =
    [
        new("EN", "English"),
        new("ES", "Espanol"),
        new("FR", "Francais"),
        new("DE", "Deutsch"),
        new("JA", "Japanese"),
        new("KO", "Korean"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Integrations", "#"), new("API", "#")]),
        new("Resources", [new("Documentation", "#"), new("Guides", "#"), new("Blog", "#"), new("Community", "#")]),
        new("Company", [new("About", "#"), new("Careers", "#"), new("Contact", "#"), new("Legal", "#")]),
    ];
}
