@* ========================================
   Block: footer-cta
   Title: Footer Cta
   Description: Footer with prominent CTA card for newsletter subscription above navigation links and social icons
   Long Description: Footer with newsletter in sidebar
   Dependencies: LucideGithubCn, LucideInstagramCn, LucideTwitterCn, LucideYoutubeCn
   Source: original/blocks/footer/footer-cta.tsx
   ======================================== *@
<section class="w-full pb-8 pt-16">
      <div class="container mx-auto px-4 text-center">
        <CardCn Class="bg-primary border-primary grid justify-center px-6 py-12 text-center shadow-none">
          <h2 class="text-primary-foreground text-2xl font-semibold">
            Be the first who see the news
          </h2>
          <p class="text-primary-foreground/90 mt-4 max-w-lg [text-wrap:_balance]">
            Your company may not be in the software business, but eventually, a software company
            will be in your business.
          </p>
          <div class="mx-auto mt-10 flex w-full max-w-sm flex-col gap-x-2 gap-y-4 sm:flex-row">
            <InputCn
              Class="border-white/20 bg-white/10 text-white placeholder:text-white/60"
              id="email"
              Placeholder="@("someone@example.com")"
              type="email"
            />
            <ButtonCn Class="shrink-0" Variant="ButtonVariant.Secondary">
              Subscribe
            </ButtonCn>
          </div>
        </CardCn>
        <div class="mt-16 mb-6 flex flex-col items-center justify-center gap-x-10 gap-y-3 lg:flex-row lg:justify-between">
          <p class="font-semibold">shadcn.io</p>
          <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
            @foreach (var item in _links)
            {
                <li>
                <a
                  class="text-foreground hover:text-primary text-sm transition-colors"
                  href="@item.Href"
                >
                  @item.Title
                </a>
              </li>
            }
          </ul>
          <div class="flex gap-1">
            <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
              <a aria-label="Twitter" href="#" rel="noopener noreferrer" target="_blank">
                <LucideTwitterCn Size="20" />
              </a>
            </ButtonCn>
            <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
              <a aria-label="YouTube" href="#" rel="noopener noreferrer" target="_blank">
                <LucideYoutubeCn Size="20" />
              </a>
            </ButtonCn>
            <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
              <a aria-label="Instagram" href="#" rel="noopener noreferrer" target="_blank">
                <LucideInstagramCn Size="20" />
              </a>
            </ButtonCn>
            <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
              <a aria-label="GitHub" href="#" rel="noopener noreferrer" target="_blank">
                <LucideGithubCn Size="20" />
              </a>
            </ButtonCn>
          </div>
        </div>
        <p class="text-foreground text-sm">
          All rights reserved. Copyright &copy; @_year shadcn.io
        </p>
      </div>
    </section>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);

    private readonly LinkItem[] _links =
    [
        new("About Us", "#"),
        new("Careers", "#"),
        new("Press", "#"),
        new("Blog", "#"),
        new("Pricing", "#"),
    ];
}
