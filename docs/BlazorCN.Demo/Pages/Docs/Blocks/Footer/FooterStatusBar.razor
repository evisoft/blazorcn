@* ========================================
   Block: footer-status-bar
   Title: Footer Status Bar
   Description: Footer with system status indicator, uptime percentage, and navigation links for SaaS products
   Long Description: Ultra-minimal footer with version badge
   Dependencies: LucideActivityCn, LucideExternalLinkCn
   Source: original/blocks/footer/footer-status-bar.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <h3 class="text-lg font-semibold">shadcn.io</h3>
            <p class="text-muted-foreground mt-2 text-sm">
              Enterprise-grade infrastructure for modern applications.
            </p>
            <div class="mt-6 rounded-lg border p-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="relative flex h-2.5 w-2.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75" ></span>
                    <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
                  </span>
                  <span class="text-sm font-medium">All Systems Operational</span>
                </div>
                <a
                  href="#"
                  class="text-muted-foreground hover:text-foreground flex items-center gap-1 text-xs transition-colors"
                >
                  Status
                  <LucideExternalLinkCn Size="12" />
                </a>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-3">
                @foreach (var item in _services)
            {
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">@item.Name</span>
                    <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                  </div>
            }
              </div>
              <div class="mt-4 flex items-center justify-between border-t pt-3">
                <div class="flex items-center gap-1.5">
                  <LucideActivityCn Size="14" Class="text-muted-foreground" />
                  <span class="text-muted-foreground text-xs">Uptime last 90 days</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                  99.99%
                </BadgeCn>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-8 lg:col-span-7 lg:justify-items-end">
            @foreach (var item in _links)
            {
                <ul class="space-y-3">
                <li><p class="mb-3 font-semibold">@item.Title</p></li>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
        </div>
        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
          <p class="text-muted-foreground text-sm">
            &copy; @_year shadcn.io. All rights reserved.
          </p>
          <p class="text-muted-foreground text-xs">Last checked: just now</p>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record ServiceItem(string Name, string Status);

    private readonly ServiceItem[] _services =
    [
        new("API", "operational"),
        new("Dashboard", "operational"),
        new("CDN", "operational"),
        new("Webhooks", "operational"),
    ];

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("API Docs", "#"), new("SDKs", "#")]),
        new("Support", [new("Help Center", "#"), new("Status Page", "#"), new("Community", "#"), new("Contact", "#")]),
        new("Legal", [new("Privacy", "#"), new("Terms", "#"), new("SLA", "#"), new("DPA", "#")]),
    ];
}
