@* ========================================
   Block: footer-mega
   Title: Footer Mega
   Description: Kitchen-sink enterprise footer with newsletter, link columns, social icons, legal links, and copyright
   Long Description: Footer with newsletter subscription
   Dependencies: ButtonCn, InputCn, SeparatorCn, LucideGithubCn, LucideInstagramCn, LucideLinkedinCn, LucideTwitterCn, LucideYoutubeCn
   Source: original/blocks/footer/footer-mega.tsx
   ======================================== *@

<footer class="w-full border-t pb-8 pt-16">
    <div class="container mx-auto px-4">
        @* Brand + Newsletter Row *@
        <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
            <div>
                <h6 class="text-xl font-semibold">shadcn.io</h6>
                <p class="text-muted-foreground mt-2 max-w-md text-sm">
                    The complete component library for modern web development. Production-ready,
                    accessible, and customizable.
                </p>
            </div>
            <div class="w-full md:w-auto">
                <p class="mb-2 text-sm font-semibold">Stay up to date</p>
                <div class="flex w-full gap-2 md:w-80">
                    <InputCn Placeholder="Enter your email" type="email" />
                    <ButtonCn Class="shrink-0">Subscribe</ButtonCn>
                </div>
            </div>
        </div>

        <SeparatorCn Class="my-10" />

        @* Link Columns *@
        <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
            @foreach (var group in _links)
            {
                <ul class="space-y-3">
                    <p class="mb-3 text-sm font-semibold">@group.Title</p>
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <a
                                class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                                href="@item.Href">
                                @item.Title
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>

        <SeparatorCn Class="my-10" />

        @* Bottom Row *@
        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
            <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
                <p class="text-muted-foreground text-sm">
                    &copy; @_year shadcn.io. All rights reserved.
                </p>
                <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
                    @foreach (var item in _legalLinks)
                    {
                        <li>
                            <a
                                class="text-muted-foreground hover:text-foreground text-xs transition-colors"
                                href="@item.Href">
                                @item.Title
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div class="flex gap-1">
                <a aria-label="Twitter" href="#" rel="noopener noreferrer" target="_blank"
                   class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50">
                    <LucideTwitterCn Size="16" />
                </a>
                <a aria-label="GitHub" href="#" rel="noopener noreferrer" target="_blank"
                   class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50">
                    <LucideGithubCn Size="16" />
                </a>
                <a aria-label="YouTube" href="#" rel="noopener noreferrer" target="_blank"
                   class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50">
                    <LucideYoutubeCn Size="16" />
                </a>
                <a aria-label="LinkedIn" href="#" rel="noopener noreferrer" target="_blank"
                   class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50">
                    <LucideLinkedinCn Size="16" />
                </a>
                <a aria-label="Instagram" href="#" rel="noopener noreferrer" target="_blank"
                   class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50">
                    <LucideInstagramCn Size="16" />
                </a>
            </div>
        </div>
    </div>
</footer>

@code {
    private static readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private static readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Integrations", "#"), new("Changelog", "#"), new("Roadmap", "#")]),
        new("Solutions", [new("For Startups", "#"), new("For Enterprise", "#"), new("For Agencies", "#"), new("For Education", "#")]),
        new("Resources", [new("Documentation", "#"), new("API Reference", "#"), new("Blog", "#"), new("Guides", "#"), new("Community", "#")]),
        new("Company", [new("About Us", "#"), new("Careers", "#"), new("Press", "#"), new("Partners", "#"), new("Contact", "#")]),
        new("Support", [new("Help Center", "#"), new("Status", "#"), new("Bug Reports", "#"), new("Feature Requests", "#")]),
    ];

    private static readonly LinkItem[] _legalLinks =
    [
        new("Privacy Policy", "#"),
        new("Terms of Service", "#"),
        new("Cookie Policy", "#"),
        new("Accessibility", "#"),
        new("Sitemap", "#"),
    ];
}
