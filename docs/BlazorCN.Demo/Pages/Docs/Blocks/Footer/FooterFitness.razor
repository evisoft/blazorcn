@* ============================================================
   Block: footer-fitness
   Title: FooterFitness
   Description: A fitness app footer block for React and Next.js with brand tagline, three navigation columns, app download buttons, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-fitness.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + link columns *@
    <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 md:grid-cols-2">

      @* Brand section *@
      <div>
        <span class="font-medium text-sm">FitForge</span>
        <p class="mt-1 text-muted-foreground text-xs">
          Your personal trainer, anywhere. Build strength, track nutrition, reach your goals.
        </p>
      </div>

      @* Link columns *@
      <div class="grid grid-cols-3 gap-6">
        @foreach (var col in _linkColumns)
        {
          <div>
            <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
              @col.Title
            </p>
            <ul class="space-y-1.5">
              @foreach (var item in col.Items)
              {
                <li>
                  <a href="@item.Href"
                     class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                    @item.Label
                  </a>
                </li>
              }
            </ul>
          </div>
        }
      </div>
    </div>

    @* Download app buttons *@
    <div class="flex flex-wrap items-center gap-2 border-b px-4 py-3">
      <span class="text-muted-foreground text-xs">Download the app</span>
      @foreach (var link in _downloadLinks)
      {
        <a href="@link.Href"
           class="inline-flex h-8 items-center gap-1.5 rounded-md border bg-background px-3 text-xs font-medium ring-offset-background transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
          <LucideIconCn Name="@link.Icon" Size="14" Class="size-3.5" />
          <span>
            <span class="text-muted-foreground">@link.Subtitle </span>@link.Label
          </span>
        </a>
      }
    </div>

    @* Copyright *@
    <div class="flex items-center justify-between px-4 py-3">
      <p class="text-muted-foreground text-xs">
        &copy; 2026 FitForge Inc. All rights reserved.
      </p>
      <div class="flex items-center gap-3">
        <a href="#"
           class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Terms
        </a>
        <a href="#"
           class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Privacy
        </a>
      </div>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);
    private record DownloadLink(string Label, string Subtitle, string Href, string Icon);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Workouts",
        [
            new("Programs", "#"),
            new("HIIT", "#"),
            new("Strength", "#"),
            new("Recovery", "#"),
        ]),
        new("Nutrition",
        [
            new("Meal Plans", "#"),
            new("Recipes", "#"),
            new("Supplements", "#"),
            new("Calculators", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Trainers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
    ];

    private static readonly DownloadLink[] _downloadLinks =
    [
        new("App Store", "Download on the", "#", "apple"),
        new("Google Play", "Get it on", "#", "play"),
    ];
}
