@* ============================================================
   Block: footer-media
   Title: FooterMedia
   Description: A media and news publication footer block for React and Next.js with four topic columns, newsletter subscription form, editorial note, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-media.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Topic columns *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
                @foreach (var col in _topicColumns)
                {
                    <div>
                        <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            @col.Title
                        </p>
                        <ul class="space-y-1.5">
                            @foreach (var item in col.Items)
                            {
                                <li>
                                    <a
                                        href="@item.Href"
                                        class="text-muted-foreground text-sm transition-colors hover:text-foreground"
                                    >
                                        @item.Label
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        @* Newsletter subscribe *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <span class="shrink-0 text-sm font-medium">
                    Subscribe to our newsletter
                </span>
                <div class="flex flex-1 items-center gap-2">
                    <InputCn type="email" Placeholder="@("you@example.com")" aria-label="Email address" Class="h-8 max-w-xs text-sm" />
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 px-3 text-xs">
                        Subscribe
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Editorial note *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-xs leading-relaxed">
                Independent journalism since 2012. Our reporting is fact-checked and editorially
                independent. We are funded by our readers, not advertisers.
            </p>
        </div>

        @* Copyright *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">
                &copy; 2026 The Chronicle. All rights reserved.
            </p>
            <div class="flex items-center gap-3">
                <a
                    href="#"
                    class="text-muted-foreground text-xs transition-colors hover:text-foreground"
                >
                    Ethics Policy
                </a>
                <a
                    href="#"
                    class="text-muted-foreground text-xs transition-colors hover:text-foreground"
                >
                    Privacy
                </a>
            </div>
        </div>

    </div>
</section>

@code {
    private record TopicItem(string Label, string Href);
    private record TopicColumn(string Title, TopicItem[] Items);

    private static readonly TopicColumn[] _topicColumns =
    [
        new("Politics",
        [
            new("Elections & Policy", "#"),
            new("World Leaders", "#"),
            new("Legislation", "#"),
            new("Analysis", "#"),
        ]),
        new("Technology",
        [
            new("AI & Machine Learning", "#"),
            new("Startups", "#"),
            new("Cybersecurity", "#"),
            new("Reviews", "#"),
        ]),
        new("Business",
        [
            new("Markets & Finance", "#"),
            new("Economy", "#"),
            new("Real Estate", "#"),
            new("Earnings", "#"),
        ]),
        new("Culture",
        [
            new("Arts & Entertainment", "#"),
            new("Books", "#"),
            new("Film & TV", "#"),
            new("Travel", "#"),
        ]),
    ];
}
