@* ========================================
   Block: footer-accordion-mobile
   Title: Footer Accordion Mobile
   Description: Mobile-optimized footer with collapsible accordion link groups that expand on desktop
   Long Description: Footer with company description
   Dependencies: AccordionCn, AccordionContentCn, AccordionItemCn, AccordionTriggerCn
   Source: original/blocks/footer/footer-accordion-mobile.tsx
   ======================================== *@

<footer class="w-full border-t pb-8 pt-16">
    <div class="container mx-auto px-4">
        <div class="mb-8 flex items-center justify-between">
            <h3 class="text-lg font-semibold">shadcn.io</h3>
            <p class="text-muted-foreground text-sm">The next generation of design systems.</p>
        </div>

        @* Mobile: Accordion *@
        <div class="md:hidden">
            <AccordionCn Type="AccordionType.Multiple">
                @foreach (var group in _links)
                {
                    <AccordionItemCn>
                        <AccordionTriggerCn Class="text-sm font-semibold">@group.Title</AccordionTriggerCn>
                        <AccordionContentCn>
                            <ul class="space-y-3 pb-2">
                                @foreach (var item in group.Items)
                                {
                                    <li>
                                        <a class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                                           href="@item.Href">
                                            @item.Title
                                        </a>
                                    </li>
                                }
                            </ul>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

        @* Desktop: Grid columns *@
        <div class="hidden grid-cols-4 gap-8 md:grid">
            @foreach (var group in _links)
            {
                <ul class="space-y-3">
                    <li><p class="mb-3 text-sm font-semibold">@group.Title</p></li>
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <a class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                               href="@item.Href">
                                @item.Title
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
            <p class="text-muted-foreground text-sm">
                &copy; @DateTime.Now.Year shadcn.io. All rights reserved.
            </p>
            <ul class="flex items-center gap-6">
                <li>
                    <a class="text-muted-foreground hover:text-foreground text-sm" href="#">Privacy</a>
                </li>
                <li>
                    <a class="text-muted-foreground hover:text-foreground text-sm" href="#">Terms</a>
                </li>
                <li>
                    <a class="text-muted-foreground hover:text-foreground text-sm" href="#">Sitemap</a>
                </li>
            </ul>
        </div>
    </div>
</footer>

@code {
    private record LinkItem(string Title, string Href);
    private record LinkGroup(string Title, LinkItem[] Items);

    private readonly List<LinkGroup> _links =
    [
        new("Product", [
            new("Features", "#"), new("Pricing", "#"), new("Integrations", "#"),
            new("Changelog", "#"), new("Roadmap", "#"),
        ]),
        new("Company", [
            new("About Us", "#"), new("Careers", "#"), new("Blog", "#"),
            new("Press Kit", "#"), new("Partners", "#"),
        ]),
        new("Resources", [
            new("Documentation", "#"), new("Help Center", "#"), new("Community", "#"),
            new("Webinars", "#"), new("Templates", "#"),
        ]),
        new("Legal", [
            new("Privacy Policy", "#"), new("Terms of Service", "#"), new("Cookie Policy", "#"),
            new("Accessibility", "#"), new("Security", "#"),
        ]),
    ];
}
