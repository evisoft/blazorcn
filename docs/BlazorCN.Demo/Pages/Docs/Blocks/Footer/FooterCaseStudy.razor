@* ============================================================
   Block: footer-case-study
   Title: FooterCaseStudy
   Description: A React case study CTA footer block for Next.js with featured result teaser, read more link, two navigation columns, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-case-study.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Case study teaser *@
        <div class="border-b px-4 py-4">
            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Featured case study
            </p>
            <div class="mt-3 rounded-md bg-muted/50 p-3">
                <p class="text-sm font-medium">
                    See how Veritas Health grew 300% in 6 months
                </p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Migrated from a legacy CMS to our platform and tripled their patient onboarding rate
                    with automated workflows.
                </p>
                <a
                    href="#"
                    class="mt-2.5 inline-flex items-center gap-1 text-xs font-medium text-foreground transition-colors hover:text-muted-foreground"
                >
                    Read case study
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </a>
            </div>
        </div>

        @* Link columns *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
            <div>
                <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Product
                </p>
                <ul class="space-y-1.5">
                    @foreach (var link in _productLinks)
                    {
                        <li>
                            <a
                                href="@link.Href"
                                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                            >
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div>
                <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Company
                </p>
                <ul class="space-y-1.5">
                    @foreach (var link in _companyLinks)
                    {
                        <li>
                            <a
                                href="@link.Href"
                                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                            >
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Label, string Href);

    private static readonly NavLink[] _productLinks =
    [
        new("Features", "#"),
        new("Pricing", "#"),
        new("Integrations", "#"),
        new("Documentation", "#"),
    ];

    private static readonly NavLink[] _companyLinks =
    [
        new("About", "#"),
        new("Blog", "#"),
        new("Careers", "#"),
        new("Contact", "#"),
    ];
}
