@* ========================================
   Block: footer-dark
   Title: Footer Dark
   Description: Dark-themed footer with gradient accent line, link columns, and social icons on inverted background
   Long Description: Dark footers anchor the page with authority. This React footer uses a dark background with a gradient accent border, organized link columns, social icons, and newsletter signup. Built with Tailwind CSS and Lucide React icons, the high-contrast inverted design creates visual weight at the page bottomâ€”perfect for modern SaaS sites, creative agencies, or tech products where dark footer contrasts with light content and gradient accent adds premium polish.
   Dependencies: LucideGithubCn, LucideInstagramCn, LucideTwitterCn, LucideYoutubeCn
   Source: original/blocks/footer/footer-dark.tsx
   ======================================== *@
<footer class="w-full">
      <div class="h-1 w-full bg-gradient-to-r from-purple-500 via-pink-500 to-orange-500" ></div>
      <div class="bg-zinc-950 pb-8 pt-16">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <h6 class="text-xl font-semibold text-white">shadcn.io</h6>
              <p class="mt-3 max-w-xs text-sm text-zinc-400">
                Build beautiful interfaces with production-ready components. Open source and free to
                use.
              </p>
              <div class="mt-6 flex gap-1">
                <ButtonCn
                  AsChild="true"
                  Class="h-8 w-8 text-zinc-400 hover:bg-zinc-800 hover:text-white"
                  Size="ButtonSize.Icon"
                  Variant="ButtonVariant.Ghost"
                >
                  <a aria-label="Twitter" href="#" rel="noopener noreferrer" target="_blank">
                    <LucideTwitterCn Size="16" />
                  </a>
                </ButtonCn>
                <ButtonCn
                  AsChild="true"
                  Class="h-8 w-8 text-zinc-400 hover:bg-zinc-800 hover:text-white"
                  Size="ButtonSize.Icon"
                  Variant="ButtonVariant.Ghost"
                >
                  <a aria-label="GitHub" href="#" rel="noopener noreferrer" target="_blank">
                    <LucideGithubCn Size="16" />
                  </a>
                </ButtonCn>
                <ButtonCn
                  AsChild="true"
                  Class="h-8 w-8 text-zinc-400 hover:bg-zinc-800 hover:text-white"
                  Size="ButtonSize.Icon"
                  Variant="ButtonVariant.Ghost"
                >
                  <a aria-label="YouTube" href="#" rel="noopener noreferrer" target="_blank">
                    <LucideYoutubeCn Size="16" />
                  </a>
                </ButtonCn>
                <ButtonCn
                  AsChild="true"
                  Class="h-8 w-8 text-zinc-400 hover:bg-zinc-800 hover:text-white"
                  Size="ButtonSize.Icon"
                  Variant="ButtonVariant.Ghost"
                >
                  <a aria-label="Instagram" href="#" rel="noopener noreferrer" target="_blank">
                    <LucideInstagramCn Size="16" />
                  </a>
                </ButtonCn>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-8">
              @foreach (var item in _links)
            {
                <ul class="space-y-3">
                  <p class="mb-3 text-sm font-semibold text-white">@item.Title</p>
                  @foreach (var subItem in item.Items)
            {
                <li>
                      <a
                        class="text-sm text-zinc-400 transition-colors hover:text-white"
                        href="@subItem.Href"
                      >
                        @subItem.Title
                      </a>
                    </li>
            }
                </ul>
            }
            </div>
          </div>
          <div class="mt-16 border-t border-zinc-800 pt-8">
            <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
              <p class="text-sm text-zinc-500">&copy; @_year shadcn.io. All rights reserved.</p>
              <div class="flex w-full max-w-sm gap-2">
                <InputCn
                  Class="border-zinc-800 bg-zinc-900 text-white placeholder:text-zinc-600"
                  Placeholder="Enter your email"
                  type="email"
                />
                <ButtonCn Class="shrink-0 bg-white text-zinc-950 hover:bg-zinc-200">
                  Subscribe
                </ButtonCn>
              </div>
            </div>
          </div>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Integrations", "#"), new("Changelog", "#")]),
        new("Company", [new("About", "#"), new("Careers", "#"), new("Blog", "#"), new("Press", "#")]),
        new("Resources", [new("Documentation", "#"), new("Help Center", "#"), new("Community", "#"), new("Templates", "#")]),
        new("Legal", [new("Privacy", "#"), new("Terms", "#"), new("Cookie Policy", "#"), new("Licenses", "#")]),
    ];
}
