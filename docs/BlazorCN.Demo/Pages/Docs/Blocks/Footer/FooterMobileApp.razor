@* ============================================================
   Block: footer-mobile-app
   Title: FooterMobileApp
   Description: A React mobile app download footer block for Next.js with QR code placeholder, app store download buttons, two link columns, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-mobile-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Mobile app promotion *@
    <div class="flex flex-col items-start gap-5 border-b px-4 py-5 sm:flex-row sm:items-center">

      @* QR code placeholder *@
      <div class="flex size-20 shrink-0 items-center justify-center rounded-md border-2 border-dashed border-muted-foreground/25">
        <LucideIconCn Name="smartphone" Size="24" Class="size-6 text-muted-foreground/40" />
      </div>

      @* Text + buttons *@
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium">
          Get the mobile experience
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Scan the QR code or download directly. Access your dashboard, receive notifications,
          and manage your account on the go.
        </p>
        <div class="mt-3 flex items-center gap-2">
          <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
            App Store
          </ButtonCn>
          <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
            Google Play
          </ButtonCn>
        </div>
      </div>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Title
          </p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a
                  href="@lnk.Href"
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Blog", "#"),
            new("Contact", "#"),
        ]),
    ];
}
