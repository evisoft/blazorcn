@* ========================================
   Block: footer-split-brand
   Title: Footer Split Brand
   Description: Split layout footer with brand story and mission on the left, navigation links on the right
   Long Description: Footer with company description
   Dependencies: LucideGithubCn, LucideInstagramCn, LucideTwitterCn, LucideYoutubeCn
   Source: original/blocks/footer/footer-split-brand.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="flex flex-col gap-12 lg:flex-row">
          <div class="lg:w-5/12">
            <h6 class="text-xl font-semibold">shadcn.io</h6>
            <p class="text-muted-foreground mt-4 max-w-md text-sm leading-relaxed">
              We started with a simple idea: building user interfaces should be a joy, not a chore.
              Since 2023, we've been crafting beautiful, accessible components that developers love
              to use and designers love to spec.
            </p>
            <p class="text-muted-foreground mt-3 max-w-md text-sm leading-relaxed">
              Our mission is to make the web more beautiful, one component at a time.
            </p>
            <div class="mt-6 flex gap-1">
              <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                <a aria-label="Twitter" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideTwitterCn Size="16" />
                </a>
              </ButtonCn>
              <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                <a aria-label="GitHub" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideGithubCn Size="16" />
                </a>
              </ButtonCn>
              <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                <a aria-label="YouTube" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideYoutubeCn Size="16" />
                </a>
              </ButtonCn>
              <ButtonCn AsChild="true" Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                <a aria-label="Instagram" href="#" rel="noopener noreferrer" target="_blank">
                  <LucideInstagramCn Size="16" />
                </a>
              </ButtonCn>
            </div>
          </div>
          <SeparatorCn Orientation="Orientation.Vertical" Class="hidden h-auto lg:block" />
          <div class="grid flex-1 grid-cols-2 gap-8 sm:grid-cols-3">
            @foreach (var item in _links)
            {
                <ul class="space-y-3">
                <p class="mb-3 font-semibold">@item.Title</p>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
        </div>
        <SeparatorCn Class="my-8" />
        <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
          <p class="text-muted-foreground text-sm">
            &copy; @_year shadcn.io. All rights reserved.
          </p>
          <ul class="flex items-center gap-6">
            <li>
              <a class="text-muted-foreground hover:text-foreground text-sm" href="#">
                Privacy
              </a>
            </li>
            <li>
              <a class="text-muted-foreground hover:text-foreground text-sm" href="#">
                Terms
              </a>
            </li>
            <li>
              <a class="text-muted-foreground hover:text-foreground text-sm" href="#">
                Accessibility
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Templates", "#"), new("Integrations", "#")]),
        new("Resources", [new("Documentation", "#"), new("Blog", "#"), new("Guides", "#"), new("Community", "#")]),
        new("Company", [new("About", "#"), new("Careers", "#"), new("Contact", "#"), new("Press", "#")]),
    ];
}
