@* ========================================
   Block: footer-detailed-enterprise
   Title: Footer Detailed Enterprise
   Description: Comprehensive enterprise footer with navigation columns, newsletter signup, status indicator, social links, and legal section for Next.js SaaS pages
   Long Description: Dark-themed footer with gradient accent line, link columns, and social icons on inverted background
   Dependencies:
   Source: original/blocks/footer/footer-detailed-enterprise.tsx
   ======================================== *@
    <section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        @* Brand + Newsletter *@
        <div class="flex flex-col gap-4 border-b px-4 py-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0">
            <p class="text-sm font-medium">Acme Inc</p>
            <p class="mt-1 max-w-xs text-xs text-muted-foreground leading-relaxed">
              The developer platform for building, deploying, and scaling modern applications.
              Trusted by 50,000+ teams worldwide.
            </p>
            @* Status indicator *@
            <a href="#" class="mt-3 inline-flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground">
              <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
              All systems operational
            </a>
          </div>
          <div class="w-full shrink-0 sm:w-56">
            <p class="text-xs font-medium">Stay updated</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
              Product news and engineering updates
            </p>
            @if (_subscribed)
            {
                <div class="mt-2 rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs text-emerald-600 dark:text-emerald-400">
                        Subscribed -- check your inbox to confirm
                    </p>
                </div>
            }
            else
            {
                <form class="mt-2 flex gap-1.5" @onsubmit="HandleSubscribe" @onsubmit:preventDefault>
                    <InputCn Type="email" @bind-Value="_email" Placeholder="@("you@company.com")"
                             Class="flex-1" />
                    <button type="submit" class="h-7 shrink-0 rounded-md bg-primary px-3 text-xs font-medium text-primary-foreground transition-colors hover:bg-primary/90">
                        Subscribe
                    </button>
                </form>
            }
          </div>
        </div>

        @* Navigation Columns *@
        <div class="grid grid-cols-2 gap-x-4 gap-y-6 border-b px-4 py-4 lg:grid-cols-4">
          @foreach (var column in _navigation)
          {
              <div>
                  <p class="text-xs font-medium text-muted-foreground">@column.Heading</p>
                  <ul class="mt-2 space-y-1.5">
                      @foreach (var link in column.Links)
                      {
                          <li>
                              <a href="@link.Href" class="group inline-flex items-center gap-1.5 text-xs text-foreground/80 transition-colors hover:text-foreground">
                                  @link.Label
                                  @if (link.Badge is not null)
                                  {
                                      <span class="rounded bg-primary/10 px-1 py-0.5 font-mono text-[10px] font-medium text-primary">
                                          @link.Badge
                                      </span>
                                  }
                              </a>
                          </li>
                      }
                  </ul>
              </div>
          }
        </div>

        @* Compliance badges *@
        <div class="flex flex-wrap items-center gap-3 border-b px-4 py-3">
          @foreach (var cert in _certifications)
          {
              <span class="rounded border px-2 py-0.5 font-mono text-[10px] text-muted-foreground">
                  @cert
              </span>
          }
          <span class="text-xs text-muted-foreground/50">
            Enterprise-grade security and compliance
          </span>
        </div>

        @* Bottom bar *@
        <div class="flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-muted-foreground">
            &copy; @_year Acme Inc. All rights reserved.
          </p>
          <div class="flex items-center gap-4">
            @foreach (var link in _socialLinks)
            {
                <a href="@link.Href" class="text-xs text-muted-foreground/60 transition-colors hover:text-foreground" target="_blank" rel="noopener noreferrer">
                    @link.Name
                </a>
            }
          </div>
        </div>
      </div>
    </section>
@code {
    private readonly int _year = DateTime.Now.Year;
    private bool _subscribed;
    private string _email = "";

    private void HandleSubscribe()
    {
        if (!string.IsNullOrWhiteSpace(_email))
            _subscribed = true;
    }

    private readonly string[] _certifications = ["SOC 2 Type II", "GDPR", "HIPAA", "ISO 27001"];

    private record NavLink(string Label, string Href, string? Badge = null);
    private record NavColumn(string Heading, NavLink[] Links);

    private readonly NavColumn[] _navigation =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Integrations", "#"), new("Changelog", "#", "New"), new("Roadmap", "#"), new("Compare", "#")]),
        new("Developers", [new("Documentation", "#"), new("API Reference", "#"), new("SDKs", "#"), new("CLI", "#"), new("Examples", "#"), new("Status", "#")]),
        new("Company", [new("About", "#"), new("Blog", "#"), new("Careers", "#", "Hiring"), new("Customers", "#"), new("Brand", "#"), new("Contact", "#")]),
        new("Legal", [new("Privacy Policy", "#"), new("Terms of Service", "#"), new("Cookie Policy", "#"), new("Acceptable Use", "#"), new("DPA", "#"), new("SLA", "#")]),
    ];

    private record SocialLink(string Name, string Href);

    private readonly SocialLink[] _socialLinks =
    [
        new("GitHub", "#"), new("X", "#"), new("Discord", "#"), new("LinkedIn", "#"),
    ];
}
