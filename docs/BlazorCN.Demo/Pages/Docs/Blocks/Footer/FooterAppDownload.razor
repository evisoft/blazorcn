@* ========================================
   Block: footer-app-download
   Title: Footer App Download
   Description: Footer with mobile app download badges, QR code area, and navigation links for app-first products
   Long Description: Footer with call-to-action card
   Dependencies: LucideAppleCn, LucideQrCodeCn, LucideSmartphoneCn, LucideStarCn
   Source: original/blocks/footer/footer-app-download.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <h3 class="text-lg font-semibold">Get the App</h3>
            <p class="text-muted-foreground mt-2 max-w-sm text-sm">
              Take your workflow anywhere. Download the mobile app and stay productive on the go.
            </p>
            <div class="mt-6 flex flex-col gap-4 sm:flex-row">
              <a
                href="#"
                class="bg-foreground text-background hover:bg-foreground/90 inline-flex items-center gap-3 rounded-lg px-5 py-3 transition-colors"
              >
                <LucideAppleCn Size="28" />
                <div>
                  <p class="text-[10px] leading-none opacity-80">Download on the</p>
                  <p class="text-sm font-semibold">App Store</p>
                </div>
              </a>
              <a
                href="#"
                class="bg-foreground text-background hover:bg-foreground/90 inline-flex items-center gap-3 rounded-lg px-5 py-3 transition-colors"
              >
                <LucideSmartphoneCn Size="28" />
                <div>
                  <p class="text-[10px] leading-none opacity-80">Get it on</p>
                  <p class="text-sm font-semibold">Google Play</p>
                </div>
              </a>
            </div>
            <div class="mt-4 flex items-center gap-2">
              <div class="flex">
                @for (var i = 0; i < 5; i++)
              {
                  <LucideStarCn Class="h-3.5 w-3.5 fill-yellow-400 text-yellow-400" />
              }
              </div>
              <span class="text-muted-foreground text-xs">4.9 rating · 12K+ reviews</span>
            </div>
            <CardCn Class="mt-6 flex w-fit items-center gap-4 p-4">
              <div class="bg-muted flex h-24 w-24 items-center justify-center rounded-lg">
                <LucideQrCodeCn Size="64" Class="text-muted-foreground" />
              </div>
              <div>
                <p class="text-sm font-medium">Scan to download</p>
                <p class="text-muted-foreground mt-1 text-xs">
                  Point your camera at the
                  <br />
                  QR code to get the app
                </p>
                <BadgeCn Class="mt-2" Variant="BadgeVariant.Secondary">
                  iOS & Android
                </BadgeCn>
              </div>
            </CardCn>
          </div>
          <div class="grid grid-cols-3 gap-8 lg:col-span-7 lg:justify-items-end">
            @foreach (var item in _links)
            {
                <ul class="space-y-3">
                <li><p class="mb-3 font-semibold">@item.Title</p></li>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
        </div>
        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
          <p class="text-muted-foreground text-sm">
            &copy; @_year shadcn.io. All rights reserved.
          </p>
          <ul class="flex items-center gap-6">
            <li>
              <a class="text-muted-foreground hover:text-foreground text-sm" href="#">
                Privacy
              </a>
            </li>
            <li>
              <a class="text-muted-foreground hover:text-foreground text-sm" href="#">
                Terms
              </a>
            </li>
            <li>
              <a class="text-muted-foreground hover:text-foreground text-sm" href="#">
                Cookies
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Security", "#")]),
        new("Company", [new("About", "#"), new("Blog", "#"), new("Careers", "#")]),
        new("Support", [new("Help Center", "#"), new("Contact", "#"), new("Status", "#")]),
    ];
}
