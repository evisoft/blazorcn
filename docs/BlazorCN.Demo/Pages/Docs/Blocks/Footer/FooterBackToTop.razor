@* ============================================================
   Block: footer-back-to-top
   Title: FooterBackToTop
   Description: A React back-to-top footer block for Next.js with smooth scroll button, three link columns, and copyright bar using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-back-to-top.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Back to top *@
    <div class="flex items-center justify-center border-b px-4 py-4">
      <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="ScrollToTop">
        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
        Back to top
      </ButtonCn>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
      @foreach (var col in _linkColumns)
      {
        var column = col;
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @column.Title
          </p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in column.Links)
            {
              var link = lnk;
              <li>
                <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  @link.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product", [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Resources", [
            new("Documentation", "#"),
            new("Blog", "#"),
            new("Guides", "#"),
            new("API Reference", "#"),
        ]),
        new("Company", [
            new("About", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
            new("Press", "#"),
        ]),
    ];

    private void ScrollToTop()
    {
        // No-op in static demo; real implementation would call JS scrollTo
    }
}
