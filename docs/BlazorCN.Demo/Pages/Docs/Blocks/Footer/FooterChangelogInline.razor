@* ============================================================
   Block: footer-changelog-inline
   Title: FooterChangelogInline
   Description: An inline changelog React footer block for Next.js with latest version entries displayed as compact rows with Badge components, two navigation link columns, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-changelog-inline.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Changelog entries *@
    <div class="border-b">
      @foreach (var entry in _changelogEntries)
      {
        var isLast = entry == _changelogEntries[^1];
        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
          <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px]">@entry.Version</BadgeCn>
          <p class="min-w-0 flex-1 truncate text-sm text-muted-foreground">@entry.Description</p>
          <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
        </div>
      }
    </div>

    @* Link columns *@
    <div class="grid grid-cols-2 gap-6 border-b px-4 py-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Title</p>
          <ul class="space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">@lnk.Label</a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
    </div>

  </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Description, string Date);
    private record NavLink(string Label, string Href);
    private record LinkColumn(string Title, NavLink[] Links);

    private static readonly ChangelogEntry[] _changelogEntries =
    [
        new("v4.2", "Added dark mode support", "Mar 18, 2026"),
        new("v4.1", "Performance improvements", "Mar 4, 2026"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("API Reference", "#"),
            new("Blog", "#"),
            new("Community", "#"),
        ]),
    ];
}
