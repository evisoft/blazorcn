@* ========================================
   Block: footer-contact-form
   Title: Footer Contact Form
   Description: Footer with inline contact form, navigation link columns, and copyright for direct engagement
   Long Description: Footer with newsletter subscription
   Dependencies: LucideSendCn
   Source: original/blocks/footer/footer-contact-form.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <h6 class="text-lg font-semibold">Get in Touch</h6>
            <p class="text-muted-foreground mt-2 text-sm">
              Have a question or want to work together? Drop us a message.
            </p>
            <form
              class="mt-6 space-y-4"
            >
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <LabelCn Class="mb-2 inline-block text-sm" for="contact-name">
                    Name
                  </LabelCn>
                  <InputCn id="contact-name" Placeholder="Your name" />
                </div>
                <div>
                  <LabelCn Class="mb-2 inline-block text-sm" for="contact-email">
                    Email
                  </LabelCn>
                  <InputCn id="contact-email" Placeholder="@("you@example.com")" type="email" />
                </div>
              </div>
              <div>
                <LabelCn Class="mb-2 inline-block text-sm" for="contact-message">
                  Message
                </LabelCn>
                <TextareaCn
                  id="contact-message"
                  Placeholder="How can we help?"
                  rows="3"
                  Class="resize-none"
                />
              </div>
              <ButtonCn type="submit" Class="w-full sm:w-auto">
                <LucideSendCn Size="16" Class="mr-2" />
                Send Message
              </ButtonCn>
            </form>
          </div>
          <div class="grid grid-cols-3 gap-8 lg:col-span-7 lg:justify-items-end">
            @foreach (var item in _links)
            {
                <ul class="space-y-3">
                <p class="mb-3 font-semibold">@item.Title</p>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
        </div>
        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
          <p class="text-muted-foreground text-sm">
            &copy; @_year shadcn.io. All rights reserved.
          </p>
          <p class="text-muted-foreground text-sm">We typically respond within 24 hours.</p>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Pricing", "#"), new("Integrations", "#"), new("Changelog", "#")]),
        new("Company", [new("About", "#"), new("Blog", "#"), new("Careers", "#"), new("Press", "#")]),
        new("Legal", [new("Privacy", "#"), new("Terms", "#"), new("Cookies", "#"), new("Licenses", "#")]),
    ];
}
