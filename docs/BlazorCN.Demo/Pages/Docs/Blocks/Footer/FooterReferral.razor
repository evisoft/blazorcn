@* ============================================================
   Block: footer-referral
   Title: FooterReferral
   Description: A React referral program footer block for Next.js with invite banner, referral code display, copy button, share link, and navigation columns using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-referral.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Referral banner *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="gift" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">Invite friends, earn rewards</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Share your referral code and both you and your friend get one month free when they subscribe.
                    </p>
                    <div class="mt-3 flex items-center gap-2">
                        <div class="flex items-center gap-2 rounded-md bg-zinc-950 p-3">
                            <code class="font-mono text-sm text-zinc-100">@_referralCode</code>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800" OnClick="HandleCopy">
                                @if (_copied)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    <span>Copied</span>
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                    <span>Copy</span>
                                }
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Link columns + share button *@
        <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex gap-12">
                @foreach (var col in _columns)
                {
                    var column = col;
                    <div>
                        <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @column.Heading
                        </p>
                        <ul class="space-y-1.5">
                            @foreach (var lnk in column.Links)
                            {
                                var link = lnk;
                                <li>
                                    <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                        @link.Label
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="share" Size="12" Class="size-3" />
                    Share your link
                </ButtonCn>
            </div>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
        </div>

    </div>
</section>

@code {
    private const string _referralCode = "ACME-X7K9M2";
    private bool _copied = false;

    private record NavLink(string Label, string Href);
    private record NavColumn(string Heading, NavLink[] Links);

    private static readonly NavLink[] _accountLinks =
    [
        new("Dashboard", "#"),
        new("Settings", "#"),
        new("Billing", "#"),
        new("Team", "#"),
    ];

    private static readonly NavLink[] _supportLinks =
    [
        new("Help Center", "#"),
        new("Documentation", "#"),
        new("Community", "#"),
        new("Contact", "#"),
    ];

    private static readonly NavColumn[] _columns =
    [
        new("Account", _accountLinks),
        new("Support", _supportLinks),
    ];

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
