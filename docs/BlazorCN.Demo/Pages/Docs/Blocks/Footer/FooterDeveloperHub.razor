@* ========================================
   Block: footer-developer-hub
   Title: Footer Developer Hub
   Description: Developer-focused footer with install commands, SDK language support badges, API version, and community links for open-source projects
   Long Description: Comprehensive enterprise footer with navigation columns, newsletter signup, status indicator, social links, and legal section for Next.js SaaS pages
   Dependencies: LucideCheckCn, LucideCopyCn
   Source: original/blocks/footer/footer-developer-hub.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">acme-sdk</span>
                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-muted-foreground">
                    v4.1.0
                </span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                The official SDK for building on the Acme platform. Type-safe, tree-shakeable, and zero
                dependencies.
            </p>
        </div>

        @* Install Commands *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Quick install</p>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
                @foreach (var cmd in _installCommands)
                {
                    <div class="flex items-center justify-between gap-2 rounded-md bg-zinc-950 p-3">
                        <code class="min-w-0 truncate font-mono text-xs text-zinc-100">
                            @cmd.Command
                        </code>
                        <button
                            type="button"
                            aria-label="Copy @cmd.Manager install command"
                            class="shrink-0 text-zinc-500 transition-colors hover:text-zinc-300"
                            @onclick="@(() => CopyCommand(cmd.Manager))">
                            @if (_copiedManager == cmd.Manager)
                            {
                                <LucideCheckCn Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <LucideCopyCn Size="14" Class="size-3.5" />
                            }
                        </button>
                    </div>
                }
            </div>
        </div>

        @* SDK Languages *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SDK support</p>
            <div class="flex flex-wrap items-center gap-3">
                @foreach (var lang in _sdkLanguages)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", lang.Status == "supported" ? "bg-emerald-500" : "bg-muted-foreground/40"))"></span>
                        <span class="@(Cn.Merge("text-xs", lang.Status == "supported" ? "text-foreground" : "text-muted-foreground"))">
                            @lang.Name
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Developer Links *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-6">
                <div>
                    <p class="mb-2 text-xs font-medium text-muted-foreground">Resources</p>
                    <ul class="space-y-1.5">
                        @foreach (var link in _resourceLinks)
                        {
                            <li>
                                <a
                                    href="@link.Href"
                                    class="text-sm text-foreground transition-colors hover:text-muted-foreground">
                                    @link.Title
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div>
                    <p class="mb-2 text-xs font-medium text-muted-foreground">Community</p>
                    <ul class="space-y-1.5">
                        @foreach (var link in _communityLinks)
                        {
                            <li>
                                <a
                                    href="@link.Href"
                                    class="text-sm text-foreground transition-colors hover:text-muted-foreground">
                                    @link.Title
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @* Bottom Bar *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="text-xs text-muted-foreground">MIT License</span>
                <span class="text-muted-foreground/40">|</span>
                <span class="font-mono text-xs text-muted-foreground">API v3.2</span>
            </div>
            <span class="text-xs text-muted-foreground">&copy; 2026 Acme Inc</span>
        </div>
    </div>
</section>

@code {
    private string? _copiedManager;

    private async Task CopyCommand(string manager)
    {
        _copiedManager = manager;
        StateHasChanged();
        await Task.Delay(1500);
        _copiedManager = null;
        StateHasChanged();
    }

    private record InstallCommandItem(string Manager, string Command);
    private record SdkLanguageItem(string Name, string Status);
    private record LinkItem(string Title, string Href);

    private static readonly InstallCommandItem[] _installCommands =
    [
        new("npm", "npm install acme-sdk"),
        new("yarn", "yarn add acme-sdk"),
        new("pnpm", "pnpm add acme-sdk"),
    ];

    private static readonly SdkLanguageItem[] _sdkLanguages =
    [
        new("TypeScript", "supported"),
        new("Python", "supported"),
        new("Go", "supported"),
        new("Ruby", "supported"),
        new("Java", "coming-soon"),
        new("Rust", "coming-soon"),
    ];

    private static readonly LinkItem[] _resourceLinks =
    [
        new("Docs", "#"),
        new("API Reference", "#"),
        new("Playground", "#"),
        new("Changelog", "#"),
    ];

    private static readonly LinkItem[] _communityLinks =
    [
        new("GitHub", "#"),
        new("Discord", "#"),
        new("Stack Overflow", "#"),
        new("Forum", "#"),
    ];
}
