@* ========================================
   Block: footer-trust-badges
   Title: Footer Trust Badges
   Description: Footer with security badges, compliance certifications, partner logos, and link columns for enterprise trust
   Long Description: Footer with company description
   Dependencies: LucideCheckCircleCn, LucideLockCn, LucideShieldCn, LucideShieldCheckCn
   Source: original/blocks/footer/footer-trust-badges.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <h6 class="text-lg font-semibold">Security & Compliance</h6>
            <p class="text-muted-foreground mt-2 text-sm">
              Your data is protected with enterprise-grade security. We maintain the highest
              standards of compliance.
            </p>
            <div class="mt-6 grid grid-cols-2 gap-3">
              @foreach (var item in _certifications)
            {
                <div
                  class="border-border flex items-center gap-3 rounded-lg border p-3"
                >
                  <Icon class="text-primary h-5 w-5 shrink-0" />
                  <div>
                    <p class="text-sm font-semibold">@item.Name</p>
                    <p class="text-muted-foreground text-xs">@item.Label</p>
                  </div>
                </div>
            }
            </div>
            <SeparatorCn Class="my-6" />
            <p class="text-muted-foreground mb-3 text-xs font-medium uppercase tracking-wider">
              Trusted Partners
            </p>
            <div class="flex flex-wrap gap-2">
              @foreach (var partner in _partners)
            {
                <BadgeCn
                  Variant="BadgeVariant.Outline"
                  Class="text-muted-foreground font-normal"
                >
                  @partner
                </BadgeCn>
            }
            </div>
          </div>
          <div class="grid grid-cols-3 gap-8 lg:col-span-7 lg:justify-items-end">
            @foreach (var item in _links)
            {
                <ul class="space-y-3">
                <p class="mb-3 font-semibold">@item.Title</p>
                @foreach (var subItem in item.Items)
            {
                <li>
                    <a
                      class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                      href="@subItem.Href"
                    >
                      @subItem.Title
                    </a>
                  </li>
            }
              </ul>
            }
          </div>
        </div>
        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
          <p class="text-muted-foreground text-sm">
            &copy; @_year shadcn.io. All rights reserved.
          </p>
          <div class="flex items-center gap-2">
            <LucideLockCn Size="14" Class="text-muted-foreground" />
            <span class="text-muted-foreground text-sm">
              256-bit SSL encryption on all connections
            </span>
          </div>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record CertItem(string Name, string Label);

    private readonly CertItem[] _certifications =
    [
        new("SOC 2", "Type II Certified"),
        new("GDPR", "Compliant"),
        new("ISO 27001", "Certified"),
        new("HIPAA", "Compliant"),
    ];

    private readonly string[] _partners =
    [
        "Amazon Web Services", "Google Cloud", "Microsoft Azure", "Stripe", "Okta",
    ];

    private record LinkItem(string Title, string Href);
    private record LinkSection(string Title, LinkItem[] Items);

    private readonly LinkSection[] _links =
    [
        new("Product", [new("Features", "#"), new("Security", "#"), new("Enterprise", "#"), new("Pricing", "#")]),
        new("Company", [new("About", "#"), new("Careers", "#"), new("Blog", "#"), new("Contact", "#")]),
        new("Legal", [new("Privacy Policy", "#"), new("Terms of Service", "#"), new("Cookie Policy", "#"), new("DPA", "#")]),
    ];
}
