@* ============================================================
   Block: footer-dual-cta
   Title: FooterDualCta
   Description: A React dual call-to-action footer block for Next.js with side-by-side primary and secondary CTA buttons, three link columns, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-dual-cta.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Dual CTAs *@
    <div class="grid grid-cols-1 gap-px border-b bg-border sm:grid-cols-2">
      <div class="bg-card px-4 py-5 text-center">
        <p class="text-sm font-medium">
          Ready to get started?
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Free for individuals. No credit card required.
        </p>
        <ButtonCn Size="ButtonSize.Sm" Class="mt-3 h-8 gap-1.5 text-xs">
          Start free trial
          <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
        </ButtonCn>
      </div>
      <div class="bg-card px-4 py-5 text-center">
        <p class="text-sm font-medium">
          Need a guided walkthrough?
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Talk to our team for a personalized demo.
        </p>
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-8 gap-1.5 text-xs">
          <LucideIconCn Name="calendar" Size="12" Class="size-3" />
          Schedule demo
        </ButtonCn>
      </div>
    </div>

    @* Link columns *@
    <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
      @foreach (var col in _linkColumns)
      {
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            @col.Title
          </p>
          <ul class="mt-2.5 space-y-1.5">
            @foreach (var lnk in col.Links)
            {
              <li>
                <a
                  href="@lnk.Href"
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  @lnk.Label
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",
        [
            new("Features", "#"),
            new("Pricing", "#"),
            new("Integrations", "#"),
            new("Changelog", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("Blog", "#"),
            new("Guides", "#"),
            new("API Reference", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
            new("Press", "#"),
        ]),
    ];
}
