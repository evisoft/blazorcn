@* ============================================================
   Block: footer-community
   Title: FooterCommunity
   Description: A React community footer block for Next.js with community stats, contributor count, engagement metrics, three navigation columns, and social links using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-community.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Community stats *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var stat in _stats)
            {
                <div class="bg-card px-4 py-3 text-center">
                    <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@stat.Label</p>
                </div>
            }
        </div>

        @* Link columns *@
        <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 sm:grid-cols-3">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Heading</p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">@lnk.Label</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">&copy; 2026 Acme Inc. All rights reserved.</p>
        </div>

    </div>
</section>

@code {
    private record CommunityStat(string Label, string Value);
    private record FooterLink(string Label, string Href);
    private record LinkColumn(string Heading, FooterLink[] Links);

    private static readonly CommunityStat[] _stats =
    [
        new("Members", "12K"),
        new("Contributors", "500+"),
        new("Stars", "8K"),
        new("Packages", "200+"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Community",
        [
            new("Discord", "#"),
            new("Forum", "#"),
            new("Events", "#"),
            new("Showcase", "#"),
        ]),
        new("Contribute",
        [
            new("Issues", "#"),
            new("Pull Requests", "#"),
            new("Documentation", "#"),
            new("Translations", "#"),
        ]),
        new("Follow",
        [
            new("Twitter", "#"),
            new("GitHub", "#"),
            new("YouTube", "#"),
            new("Blog", "#"),
        ]),
    ];
}
