@* ============================================================
   Block: footer-product-hunt
   Title: FooterProductHunt
   Description: A React Product Hunt style footer block for Next.js with upvote count badge, rating display, support button, two navigation columns, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-product-hunt.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Product Hunt section *@
    <div class="border-b px-4 py-4">
      <p class="text-sm font-medium">Launched on Product Hunt</p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
          <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
          2.4K upvotes
        </BadgeCn>
        <span class="flex items-center gap-1 text-xs text-muted-foreground">
          <LucideIconCn Name="star" Size="12" Class="size-3 fill-current" />
          4.9/5
        </span>
      </div>
      <div class="mt-3">
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" AsChild="true">
          <a href="#" target="_blank" rel="noopener noreferrer">
            Support us
          </a>
        </ButtonCn>
      </div>
    </div>

    @* Link columns *@
    <div class="flex flex-col gap-6 border-b px-4 py-4 sm:flex-row sm:gap-12">
      <div>
        <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Product
        </p>
        <ul class="space-y-1.5">
          @foreach (var lnk in _productLinks)
          {
            <li>
              <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                @lnk.Label
              </a>
            </li>
          }
        </ul>
      </div>
      <div>
        <p class="mb-2.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Company
        </p>
        <ul class="space-y-1.5">
          @foreach (var lnk in _companyLinks)
          {
            <li>
              <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                @lnk.Label
              </a>
            </li>
          }
        </ul>
      </div>
    </div>

    @* Copyright *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc. All rights reserved.
      </p>
    </div>

  </div>
</section>

@code {
  private record NavLink(string Label, string Href);

  private static readonly NavLink[] _productLinks =
  [
    new("Features", "#"),
    new("Pricing", "#"),
    new("Integrations", "#"),
    new("Documentation", "#"),
  ];

  private static readonly NavLink[] _companyLinks =
  [
    new("About", "#"),
    new("Blog", "#"),
    new("Careers", "#"),
    new("Contact", "#"),
  ];
}
