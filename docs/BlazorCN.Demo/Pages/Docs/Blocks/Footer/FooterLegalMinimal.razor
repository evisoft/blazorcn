@* ============================================================
   Block: footer-legal-minimal
   Title: FooterLegalMinimal
   Description: A legal-focused minimal React footer block for Next.js with compliance links row, legal entity info, and copyright built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-legal-minimal.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    @* Legal links row *@
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 border-b px-4 py-3">
      @foreach (var link in _legalLinks)
      {
        <a href="@link.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          @link.Label
        </a>
      }
    </div>

    @* Copyright with legal entity *@
    <div class="px-4 py-3">
      <p class="text-xs text-muted-foreground">
        &copy; 2026 Acme Inc., a Delaware corporation. All rights reserved. Registered at 123
        Market Street, San Francisco, CA 94105.
      </p>
    </div>
  </div>
</section>

@code {
    private record LegalLink(string Label, string Href);

    private static readonly LegalLink[] _legalLinks =
    [
        new("Terms of Service", "#"),
        new("Privacy Policy", "#"),
        new("Cookie Policy", "#"),
        new("GDPR", "#"),
        new("Accessibility", "#"),
    ];
}
