@* ============================================================
   Block: footer-fintech
   Title: FooterFintech
   Description: A React fintech footer block for Next.js with compliance badges, regulatory disclaimer, three navigation columns, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-fintech.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Compliance badges *@
        <div class="flex flex-wrap items-center gap-3 border-b px-4 py-3">
            @foreach (var badge in _complianceBadges)
            {
                <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5">
                    <LucideIconCn Name="@badge.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">@badge.Label</span>
                </div>
            }
        </div>

        @* Link columns *@
        <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Title
                    </p>
                    <ul class="mt-2.5 space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href"
                                   class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Regulatory disclaimer *@
        <div class="border-b px-4 py-3">
            <p class="text-xs leading-relaxed text-muted-foreground">
                Securities are offered through Acme Financial LLC, a registered broker-dealer and
                member of FINRA/SIPC. Investment products are not FDIC insured, have no bank
                guarantee, and may lose value. Advisory services offered through Acme Advisors LLC, an
                SEC-registered investment advisor. Past performance does not guarantee future results.
            </p>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Financial LLC. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record ComplianceBadge(string IconName, string Label);

    private static readonly ComplianceBadge[] _complianceBadges =
    [
        new("landmark", "SEC Registered"),
        new("shield-check", "SIPC Member"),
        new("building", "FDIC Insured"),
    ];

    private record NavLink(string Label, string Href);
    private record LinkColumn(string Title, NavLink[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Products",
        [
            new("Investing", "#"),
            new("Retirement", "#"),
            new("Savings", "#"),
            new("Crypto", "#"),
        ]),
        new("Resources",
        [
            new("Learn", "#"),
            new("Market News", "#"),
            new("Calculators", "#"),
            new("Glossary", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Press", "#"),
            new("Contact", "#"),
        ]),
    ];
}
