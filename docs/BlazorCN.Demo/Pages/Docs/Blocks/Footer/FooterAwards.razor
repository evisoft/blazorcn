@* ============================================================
   Block: footer-awards
   Title: FooterAwards
   Description: A React awards and recognition footer block for Next.js with award badges, industry accolades, three navigation columns, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-awards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Award badges *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var award in _awards)
            {
                <div class="flex items-center gap-2.5 bg-card px-4 py-3">
                    <LucideIconCn Name="@award.Icon" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium">@award.Title</p>
                        <p class="truncate text-xs text-muted-foreground">@award.Subtitle</p>
                    </div>
                </div>
            }
        </div>

        @* Link columns *@
        <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 sm:grid-cols-3">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">@col.Heading</p>
                    <ul class="space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record AwardItem(string Icon, string Title, string Subtitle);
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Heading, LinkItem[] Links);

    private static readonly AwardItem[] _awards =
    [
        new("trophy",  "Product Hunt #1",      "Product of the Day"),
        new("star",    "G2 Leader",             "Winter 2026"),
        new("award",   "Gartner Cool Vendor",   "Developer Tools"),
        new("flame",   "Fast Company",          "Most Innovative"),
    ];

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Product",   [new("Features", "#"), new("Pricing", "#"), new("Enterprise", "#"), new("Security", "#")]),
        new("Resources", [new("Documentation", "#"), new("Blog", "#"), new("Guides", "#"), new("Changelog", "#")]),
        new("Company",   [new("About", "#"), new("Careers", "#"), new("Press", "#"), new("Contact", "#")]),
    ];
}
