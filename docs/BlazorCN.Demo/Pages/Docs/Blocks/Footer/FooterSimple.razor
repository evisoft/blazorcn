@* ========================================
   Block: footer-simple
   Title: Footer Simple
   Description: Simple footer with copyright text and social media icon links in centered layout
   Long Description: Footer with navigation link columns
   Dependencies: LucideGithubCn, LucideInstagramCn, LucideTwitterCn, LucideYoutubeCn
   Source: original/blocks/footer/footer-simple.tsx
   ======================================== *@
<footer class="w-full border-t pb-8 pt-16">
      <div class="container mx-auto px-4">
        <div class="flex flex-row flex-wrap items-center justify-center gap-x-10 gap-y-2 md:justify-between">
          <p class="text-foreground text-center text-sm font-medium">
            All rights reserved. Copyright &copy; @_year shadcn.io
          </p>
          <div class="flex gap-1">
            <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Twitter">
              <a aria-label="Twitter" href="#" rel="noopener noreferrer" target="_blank">
                <LucideTwitterCn Size="16" />
              </a>
            </ButtonCn>
            <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="YouTube">
              <a aria-label="YouTube" href="#" rel="noopener noreferrer" target="_blank">
                <LucideYoutubeCn Size="16" />
              </a>
            </ButtonCn>
            <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Instagram">
              <a aria-label="Instagram" href="#" rel="noopener noreferrer" target="_blank">
                <LucideInstagramCn Size="16" />
              </a>
            </ButtonCn>
            <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="GitHub">
              <a aria-label="GitHub" href="#" rel="noopener noreferrer" target="_blank">
                <LucideGithubCn Size="16" />
              </a>
            </ButtonCn>
          </div>
        </div>
      </div>
    </footer>
  
@code {
    private readonly int _year = DateTime.Now.Year;
}
