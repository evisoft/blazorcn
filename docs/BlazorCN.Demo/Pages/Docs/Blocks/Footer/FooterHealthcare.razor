@* ============================================================
   Block: footer-healthcare
   Title: FooterHealthcare
   Description: A React healthcare footer block for Next.js with HIPAA compliance badge, three navigation columns, emergency contact notice, and copyright using shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-healthcare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Brand + HIPAA badge *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart-pulse" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Acme Health</p>
            </div>
            <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">HIPAA Compliant</span>
            </div>
        </div>

        @* Link columns *@
        <div class="grid grid-cols-3 gap-6 border-b px-4 py-4">
            @foreach (var col in _linkColumns)
            {
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @col.Title
                    </p>
                    <ul class="mt-2.5 space-y-1.5">
                        @foreach (var lnk in col.Links)
                        {
                            <li>
                                <a href="@lnk.Href"
                                   class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                                    @lnk.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Emergency notice *@
        <div class="flex items-center gap-2.5 border-b px-4 py-3">
            <LucideIconCn Name="phone" Size="14" Class="size-3.5 shrink-0 text-red-500" />
            <p class="text-xs text-muted-foreground">
                If this is a medical emergency, please call
                <span class="font-medium text-foreground">911</span> immediately. Do not use this
                platform for urgent medical concerns.
            </p>
        </div>

        @* Copyright *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                &copy; 2026 Acme Health Inc. All rights reserved.
            </p>
        </div>

    </div>
</section>

@code {
    private record FooterLink(string Label, string Href);
    private record LinkColumn(string Title, FooterLink[] Links);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Services",
        [
            new("Primary Care", "#"),
            new("Telehealth", "#"),
            new("Prescriptions", "#"),
            new("Lab Results", "#"),
        ]),
        new("Patients",
        [
            new("Patient Portal", "#"),
            new("Book Appointment", "#"),
            new("Billing", "#"),
            new("Insurance", "#"),
        ]),
        new("About",
        [
            new("Our Providers", "#"),
            new("Locations", "#"),
            new("Careers", "#"),
            new("Contact", "#"),
        ]),
    ];
}
