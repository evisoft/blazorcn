@* ============================================================
   Block: footer-music
   Title: FooterMusic
   Description: A music and streaming platform footer block for React and Next.js with brand section, three navigation columns, platform labels row, and copyright bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/footer/footer-music.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Brand + link columns *@
    <div class="grid grid-cols-1 gap-6 border-b px-4 py-4 md:grid-cols-2">

      @* Brand section *@
      <div>
        <div class="flex items-center gap-2">
          <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
          <span class="font-medium text-sm">Wavelength</span>
        </div>
        <p class="mt-1 text-muted-foreground text-xs">
          Discover, stream, and share music from artists around the world.
        </p>
      </div>

      @* Link columns *@
      <div class="grid grid-cols-3 gap-6">
        @foreach (var col in _linkColumns)
        {
          var column = col;
          <div>
            <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">@column.Title</p>
            <ul class="space-y-1.5">
              @foreach (var lnk in column.Items)
              {
                var item = lnk;
                <li>
                  <a href="@item.Href" class="text-muted-foreground text-sm transition-colors hover:text-foreground">
                    @item.Label
                  </a>
                </li>
              }
            </ul>
          </div>
        }
      </div>
    </div>

    @* Listen on platforms *@
    <div class="flex flex-wrap items-center gap-2 border-b px-4 py-3">
      <span class="text-muted-foreground text-xs">Listen on</span>
      @foreach (var platform in _platforms)
      {
        <span class="inline-flex items-center rounded-md bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground">
          @platform
        </span>
      }
    </div>

    @* Copyright *@
    <div class="flex items-center justify-between px-4 py-3">
      <p class="text-muted-foreground text-xs">
        &copy; 2026 Wavelength Inc. All rights reserved.
      </p>
      <div class="flex items-center gap-3">
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Terms
        </a>
        <a href="#" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
          Privacy
        </a>
      </div>
    </div>

  </div>
</section>

@code {
    private record LinkItem(string Label, string Href);
    private record LinkColumn(string Title, LinkItem[] Items);

    private static readonly LinkColumn[] _linkColumns =
    [
        new("Discover",
        [
            new("New Releases", "#"),
            new("Top Charts", "#"),
            new("Genres", "#"),
            new("Playlists", "#"),
        ]),
        new("Artists",
        [
            new("Featured", "#"),
            new("Emerging", "#"),
            new("For Artists", "#"),
            new("Submit Music", "#"),
        ]),
        new("Company",
        [
            new("About", "#"),
            new("Careers", "#"),
            new("Press", "#"),
            new("Contact", "#"),
        ]),
    ];

    private static readonly string[] _platforms = ["Spotify", "Apple Music", "YouTube Music", "SoundCloud"];
}
