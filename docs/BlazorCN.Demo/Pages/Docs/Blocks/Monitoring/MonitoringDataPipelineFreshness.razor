@* ============================================================
   Block: monitoring-data-pipeline-freshness
   Title: MonitoringDataPipelineFreshness
   Description: Real-time data monitoring dashboard featuring pipeline latency tracking, data arrival trends, and SLA compliance scores with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-data-pipeline-freshness.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-blue-500/10">
                    <LucideIconCn Name="refresh-ccw" Size="16" Class="size-4 text-blue-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Pipeline Freshness</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Core Data Warehouse Sync</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">SLA Met</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var isLast = idx == _stats.Length - 1;
                <div class="@($"p-4{(isLast ? "" : " md:border-r border-b md:border-b-0")}")">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@stat.Label</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        <span class="text-xs text-muted-foreground font-medium">@stat.Unit</span>
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Freshness Trend (min behind)</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal border-amber-500/20 text-amber-600">1 Incident Today</BadgeCn>
            </div>
            <div class="h-32 w-full">
                @{
                    var data = _freshnessTrend;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 128;
                    var allLags = data.Select(d => d.Lag).ToArray();
                    var minLag = allLags.Min();
                    var maxLag = allLags.Max();
                    var lagRange = maxLag - minLag == 0 ? 1 : maxLag - minLag;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double StepY(int v) => chartH - (double)(v - minLag) / lagRange * chartH * 0.9 - chartH * 0.05;

                    var lagPoints = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{StepY(data[i].Lag):F1}"));
                    var fillPoints = $"0,{chartH} " + lagPoints + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="freshnessGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#3b82f6" stop-opacity="0.1" />
                            <stop offset="95%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@fillPoints" fill="url(#freshnessGradient)" />
                    <polyline points="@lagPoints" fill="none" stroke="#3b82f6" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="database" Size="12" Class="size-3" />
                <span class="font-medium">Source: Snowflake Core</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Lineage Map →
            </button>
        </div>
    </div>
</section>

@code {
    private record TrendPoint(string Time, int Lag);
    private record StatItem(string Label, int Value, string Unit);

    private static readonly TrendPoint[] _freshnessTrend =
    [
        new("08:00", 2),
        new("09:00", 5),
        new("10:00", 45),
        new("11:00", 12),
        new("12:00", 3),
        new("13:00", 4),
        new("14:00", 2),
        new("15:00", 5),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Current Lag", 4, "min"),
        new("P95 Lag", 12, "min"),
        new("SLA Target", 15, "min"),
    ];
}
