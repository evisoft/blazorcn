@* ============================================================
   Block: monitoring-broken-link-checker
   Title: MonitoringBrokenLinkChecker
   Description: Real-time site integrity monitoring dashboard featuring automated broken link detection, HTTP response codes, and source page tracking using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-broken-link-checker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="link-2-off" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Link Integrity</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Broken Link Scanner · 24h Crawl
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <div class="text-[10px] font-semibold uppercase text-muted-foreground">Broken Links</div>
                    <div class="text-sm font-bold text-red-600">4</div>
                </div>
                <div class="size-1.5 rounded-full bg-red-500 animate-pulse"></div>
            </div>
        </div>

        <div class="grid grid-cols-2 divide-x border-b bg-muted/10">
            <div class="p-3 text-center">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-0.5">Scanned</div>
                <div class="text-lg font-semibold">1240</div>
            </div>
            <div class="p-3 text-center">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-0.5">Integrity</div>
                <div class="text-lg font-semibold text-emerald-600">99.7%</div>
            </div>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-5">TARGET URL</span>
                <span class="col-span-3 text-center">SOURCE</span>
                <span class="col-span-2 text-center">CODE</span>
                <span class="col-span-2 text-right">TYPE</span>
            </div>
            @foreach (var lnk in _brokenLinks)
            {
                var link = lnk;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-5 flex items-center gap-2 pr-2">
                        <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-red-500 shrink-0" />
                        <code class="text-[10px] font-mono text-muted-foreground truncate">@link.Url</code>
                    </div>
                    <div class="col-span-3 text-center">
                        <span class="text-[10px] font-medium text-foreground truncate block">@link.Source</span>
                    </div>
                    <div class="col-span-2 text-center">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1 text-[9px] font-mono text-red-600 border-red-500/20 bg-red-500/5">
                            @link.Status
                        </BadgeCn>
                    </div>
                    <div class="col-span-2 text-right">
                        <span class="text-[10px] text-muted-foreground uppercase font-semibold">@link.Type</span>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="history" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Last crawl: 2h ago</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="file-search" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">42 Pages Scanned</span>
                </div>
            </div>
            <button type="button" class="flex items-center gap-1 text-[10px] font-medium hover:underline text-foreground">
                Full Audit Log
                <LucideIconCn Name="external-link" Size="10" Class="size-2.5" />
            </button>
        </div>
    </div>
</section>

@code {
    private record BrokenLink(string Url, int Status, string Source, string Type);

    private static readonly BrokenLink[] _brokenLinks =
    [
        new("https://example.com/docs/v1", 404, "/docs/getting-started", "internal"),
        new("https://twitter.com/old-handle", 404, "/footer", "external"),
        new("https://api.partner.com/v2", 503, "/integrations", "external"),
        new("https://example.com/assets/logo.png", 404, "/about", "internal"),
    ];
}
