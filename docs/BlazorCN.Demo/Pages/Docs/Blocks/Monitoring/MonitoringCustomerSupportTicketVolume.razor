@* ============================================================
   Block: monitoring-customer-support-ticket-volume
   Title: MonitoringCustomerSupportTicketVolume
   Description: Professional support dashboard for monitoring ticket volume, resolution rates, and response times using shadcn/ui, Recharts, and Framer Motion.
   Source: original/blocks/monitoring/monitoring-customer-support-ticket-volume.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="life-buoy" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Support Workload</h3>
                    <p class="mt-1 text-muted-foreground text-xs">General Support · Active Queue</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-amber-600 dark:text-amber-400">
                    High Volume
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var isLast = idx == _stats.Length - 1;
                var borderClass = isLast ? "" : "md:border-r border-b md:border-b-0";
                var badgeClass = stat.Status == "warning"
                    ? "h-5 px-1.5 font-normal text-[10px] bg-amber-500/10 text-amber-600 border-amber-500/20"
                    : "h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20";
                var strokeColor = stat.Status == "warning" ? "#f59e0b" : "#10b981";
                var gradientId = $"gradient-tkt-{idx}";
                var linePoints = BuildLinePoints(stat.Trend);
                var fillPoints = BuildFillPoints(stat.Trend);

                <div class="@($"p-4 {borderClass}")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                            @(stat.Status == "warning" ? "SLA Alert" : "Stable")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.DisplayValue</span>
                        <span class="text-muted-foreground text-xs font-medium">@stat.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@stat.Label</p>

                    <div class="h-10 w-full mt-4">
                        <svg viewBox="0 0 @SvgW @SvgH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradientId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Last Resolution: 4m ago
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Active Queue →
            </button>
        </div>
    </div>
</section>

@code {
    private record TrendPoint(double Value);

    private record StatItem(string Label, string DisplayValue, string Unit, string Icon, string Status, TrendPoint[] Trend);

    private static readonly TrendPoint[] _baseTrend =
    [
        new(12), new(18), new(24), new(32), new(45),
        new(38), new(30), new(25), new(22), new(18),
    ];

    private static readonly StatItem[] _stats =
    [
        new(
            "Open Tickets",
            "142",
            "tkts",
            "ticket",
            "warning",
            _baseTrend
        ),
        new(
            "Avg. Response",
            "14",
            "min",
            "clock",
            "healthy",
            [new(48), new(42), new(36), new(28), new(15), new(22), new(30), new(35), new(38), new(42)]
        ),
        new(
            "Resolved",
            "98.4",
            "%",
            "check-circle",
            "healthy",
            [new(76), new(79), new(82), new(86), new(92), new(89), new(85), new(82), new(81), new(79)]
        ),
    ];

    private const int SvgW = 200;
    private const int SvgH = 40;

    private static string BuildLinePoints(TrendPoint[] trend)
    {
        int count = trend.Length;
        double minVal = trend.Min(d => d.Value);
        double maxVal = trend.Max(d => d.Value);
        double range = (maxVal - minVal) == 0 ? 1.0 : maxVal - minVal;
        return string.Join(" ", Enumerable.Range(0, count).Select(n =>
        {
            double x = count <= 1 ? 0 : (double)SvgW / (count - 1) * n;
            double y = SvgH - (trend[n].Value - minVal) / range * SvgH;
            return FormattableString.Invariant($"{x:F1},{y:F1}");
        }));
    }

    private static string BuildFillPoints(TrendPoint[] trend)
    {
        var line = BuildLinePoints(trend);
        return $"0,{SvgH} " + line + $" {SvgW},{SvgH}";
    }
}
