@* ============================================================
   Block: monitoring-fraud-detection-score
   Title: MonitoringFraudDetectionScore
   Description: Specialized monitoring dashboard for tracking transaction risk scores, blocked fraud attempts, and risk distribution metrics with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-fraud-detection-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="activity" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Fraud Sentinel</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Real-time Risk · Global Transactions</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Low Threat
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var i = idx;
                var borderClass = i != _stats.Length - 1 ? "md:border-r border-b md:border-b-0" : "";
                <div class="@($"p-4 {borderClass}")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"h-5 px-1.5 font-normal text-[10px] {(stat.Status == "warning" ? "bg-amber-500/10 text-amber-600 border-amber-500/20" : "bg-emerald-500/10 text-emerald-600 border-emerald-500/20")}")">
                            @(stat.Status == "warning" ? "Peaking" : "Stable")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        <span class="text-muted-foreground text-xs font-medium">@stat.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@stat.Label</p>

                    <div class="h-10 w-full mt-4">
                        @{
                            var trendData = stat.Trend;
                            var chartW = 200;
                            var chartH = 40;
                            var count = trendData.Length;
                            var minV = trendData.Min() - 2;
                            var maxV = trendData.Max() + 2;
                            var valRange = maxV - minV == 0 ? 1 : maxV - minV;
                            double Sx(int k) => count <= 1 ? 0 : (double)chartW / (count - 1) * k;
                            double Sy(int v) => chartH - (double)(v - minV) / valRange * chartH;
                            var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(k => FormattableString.Invariant($"{Sx(k):F1},{Sy(trendData[k]):F1}")));
                            var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                            var strokeColor = stat.Status == "warning" ? "#f59e0b" : "#10b981";
                            var gradId = $"gradient-fraud-{i}";
                        }
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="border-t"></div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Latest Block: 4s ago (Risk: 98)
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Review Queue →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, double Value, string Unit, string Icon, string Status, int[] Trend);

    private static readonly int[] _baseData = [12, 15, 18, 24, 32, 28, 20, 15, 12, 14];

    private static readonly StatItem[] _stats =
    [
        new("Avg Risk Score", 18.4, "/100", "search", "healthy", [12, 15, 18, 24, 32, 28, 20, 15, 12, 14]),
        new("Blocked Events", 142, "cnt", "shield-alert", "warning", [24, 30, 36, 48, 64, 56, 40, 30, 24, 28]),
        new("Risk Analysts", 8, "on", "users", "healthy", [8, 9, 8, 6, 6, 6, 6, 7, 6, 8]),
    ];
}
