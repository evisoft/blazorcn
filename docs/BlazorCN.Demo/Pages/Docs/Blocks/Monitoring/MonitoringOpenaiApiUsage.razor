@* ============================================================
   Block: monitoring-openai-api-usage
   Title: MonitoringOpenaiApiUsage
   Description: Professional AI monitoring dashboard featuring OpenAI token consumption, model spend tracking, and rate limit analysis with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-openai-api-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">OpenAI Usage</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Organization: org-af21-prod
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Tier: 4</span>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var statObj = stat;
                var isLast = statObj.Label == "Remaining";
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@statObj.Label</p>
                    <div class="flex items-baseline gap-1">
                        @if (statObj.IsCurrency)
                        {
                            <span class="text-sm font-medium text-muted-foreground">$</span>
                        }
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@statObj.Value</span>
                        @if (!statObj.IsCurrency && !string.IsNullOrEmpty(statObj.Unit))
                        {
                            <span class="text-xs text-muted-foreground font-medium">@statObj.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Bar Chart *@
        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Token Consumption (7d)</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] h-5 font-normal">gpt-4o primary</BadgeCn>
            </div>
            <div class="h-32 w-full">
                @{
                    var maxTokens = _spendData.Max(d => d.Tokens);
                    var barCount = _spendData.Length;
                    var svgW = 400.0;
                    var svgH = 128.0;
                    var barAreaH = 100.0;
                    var barW = svgW / barCount * 0.6;
                    var barGap = svgW / barCount;
                }
                <svg viewBox="0 0 400 128" preserveAspectRatio="none" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    @for (var idx = 0; idx < _spendData.Length; idx++)
                    {
                        var d = _spendData[idx];
                        var barH = d.Tokens / (double)maxTokens * barAreaH;
                        var x = idx * barGap + barGap * 0.2;
                        var y = barAreaH - barH;
                        @((MarkupString)FormattableString.Invariant($"<rect x=\"{x:F1}\" y=\"{y:F1}\" width=\"{barW:F1}\" height=\"{barH:F1}\" rx=\"2\" ry=\"2\" fill=\"currentColor\" class=\"text-foreground\" />"))
                    }
                </svg>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                <span class="font-medium">Avg Latency: 1.2s</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Usage Dashboard @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string Value, bool IsCurrency, string Unit);
    private record SpendPoint(string Day, int Tokens);

    private static readonly StatItem[] _stats =
    [
        new("Daily Spend",    "12.45", true,  ""),
        new("Total Tokens",   "451",   false, "k"),
        new("Remaining",      "82",    false, "%"),
    ];

    private static readonly SpendPoint[] _spendData =
    [
        new("Mon", 45000),
        new("Tue", 52000),
        new("Wed", 89000),
        new("Thu", 120000),
        new("Fri", 65000),
        new("Sat", 42000),
        new("Sun", 38000),
    ];
}
