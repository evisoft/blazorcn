@* ============================================================
   Block: monitoring-kubernetes-pod-logs
   Title: MonitoringKubernetesPodLogs
   Description: Real-time log streaming dashboard for Kubernetes pods featuring log severity highlighting, search filtering, and pod selection using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-kubernetes-pod-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-background">
                    <LucideIconCn Name="terminal" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Pod Logs</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] font-mono">
                        pod/api-gateway-84fb7969db-q2j5w
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Live</span>
            </div>
        </div>

        @* Filter toolbar *@
        <div class="flex items-center gap-2 px-4 py-2 border-b bg-muted/10">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="12" Class="absolute left-2.5 top-1/2 -translate-y-1/2 size-3 text-muted-foreground" />
                <input
                    type="text"
                    placeholder="Filter logs..."
                    class="h-7 w-full rounded-md border bg-background pl-7 pr-2 text-[11px] focus:outline-none focus:ring-1 focus:ring-ring" />
            </div>
            <button type="button" class="p-1.5 rounded-md hover:bg-muted border transition-colors">
                <LucideIconCn Name="filter" Size="12" Class="size-3 text-muted-foreground" />
            </button>
            <button type="button" class="p-1.5 rounded-md hover:bg-muted border transition-colors">
                <LucideIconCn Name="trash-2" Size="12" Class="size-3 text-muted-foreground" />
            </button>
        </div>

        @* Log lines *@
        <div class="h-[300px] overflow-y-auto p-4 font-mono text-[11px] leading-relaxed bg-black/5 dark:bg-black/20">
            <div class="space-y-1.5">
                @foreach (var log in _logs)
                {
                    var timeOnly = log.Timestamp.Contains(' ') ? log.Timestamp.Split(' ')[1] : log.Timestamp;
                    var levelClass = log.Level == "error" ? "text-red-500"
                                   : log.Level == "warn"  ? "text-amber-500"
                                   : "text-blue-500";
                    <div class="flex gap-3 break-all">
                        <span class="text-muted-foreground shrink-0 select-none">@timeOnly</span>
                        <span class="@($"uppercase font-bold shrink-0 select-none {levelClass}")">[<span>@log.Level</span>]</span>
                        <span class="text-foreground/90">@log.Message</span>
                    </div>
                }
            </div>
        </div>

        <hr class="border-t border-border" />

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="activity" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Streaming 124 lines/min</span>
                </div>
            </div>
            <button type="button" class="flex items-center gap-1.5 text-[10px] font-medium hover:underline text-foreground">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Download Full Log
            </button>
        </div>

    </div>
</section>

@code {
    private record LogEntry(string Timestamp, string Level, string Message, string Pod);

    private static readonly LogEntry[] _logs =
    [
        new("2024-03-20 14:20:01", "info",  "Successfully connected to redis:6379",                           "api-v1-84fb"),
        new("2024-03-20 14:20:05", "warn",  "Degraded performance detected in upstream-auth",                 "api-v1-84fb"),
        new("2024-03-20 14:20:12", "error", "Unhandled exception: Connection timeout at database:5432",        "api-v1-84fb"),
        new("2024-03-20 14:20:15", "info",  "Retrying connection in 500ms...",                                "api-v1-84fb"),
        new("2024-03-20 14:20:20", "info",  "Health check passed for /ready",                                 "api-v1-84fb"),
    ];
}
