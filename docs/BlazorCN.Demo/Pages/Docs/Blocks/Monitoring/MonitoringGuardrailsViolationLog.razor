@* ============================================================
   Block: monitoring-guardrails-violation-log
   Title: MonitoringGuardrailsViolationLog
   Description: Professional AI safety monitoring dashboard featuring LLM guardrail violations, toxicity detection, and PII leakage logs with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-guardrails-violation-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-red-500/10">
                    <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-red-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Guardrail Violations</h3>
                    <p class="mt-1 text-xs text-muted-foreground">Safety Policy: Enterprise_V2</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-red-500 animate-pulse"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-red-600">Action Required</span>
            </div>
        </div>

        @* Stats *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var statItem = stat;
                <div class="@statItem.CellClass">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@statItem.Icon" Size="12" Class="@($"size-3 {statItem.IconColor}")" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@statItem.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@statItem.Value</span>
                    </div>
                </div>
            }
        </div>

        @* Violation Frequency Chart (SVG sparkline) *@
        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Violation Frequency (7d)</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] h-5 font-normal">SLA: &lt;1%</BadgeCn>
            </div>
            <div class="h-32 w-full">
                <svg viewBox="0 0 280 128" class="w-full h-full" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="violationFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#dc2626" stop-opacity="0.05" />
                            <stop offset="100%" stop-color="#dc2626" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <path d="@_areaPath" fill="url(#violationFill)" />
                    <path d="@_linePath" fill="none" stroke="#dc2626" stroke-width="2" />
                </svg>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                <span class="font-medium">All sensitive data redacted</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Safety Report →
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, int Value, string Icon, string IconColor, string CellClass);

    private static readonly StatItem[] _stats =
    [
        new("PII Detected",    12, "user-x",       "",              "p-4 md:border-r border-b md:border-b-0"),
        new("Toxicity Block",   4, "alert-circle",  "",              "p-4 md:border-r border-b md:border-b-0"),
        new("Injection Try",   45, "shield-alert",  "text-red-500",  "p-4"),
    ];

    // Violation trend data: Mon-Sun counts: 2,5,12,45,18,8,10
    // Chart is 280 wide x 128 tall; min=2, max=45 mapped to y=[8,120]
    private static readonly (string Time, int Count)[] _trend =
    [
        ("Mon",  2),
        ("Tue",  5),
        ("Wed", 12),
        ("Thu", 45),
        ("Fri", 18),
        ("Sat",  8),
        ("Sun", 10),
    ];

    private static string _linePath = BuildLinePath();
    private static string _areaPath = BuildAreaPath();

    private static string BuildLinePath()
    {
        const int w = 280;
        const int h = 128;
        const int padTop = 8;
        const int padBottom = 8;
        int minVal = 2;
        int maxVal = 45;
        int n = _trend.Length;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double x = i * (w - 1.0) / (n - 1);
            double y = padTop + (1.0 - (double)(_trend[i].Count - minVal) / (maxVal - minVal)) * (h - padTop - padBottom);
            sb.Append(i == 0 ? $"M{x:F1},{y:F1}" : $" L{x:F1},{y:F1}");
        }
        return sb.ToString();
    }

    private static string BuildAreaPath()
    {
        const int w = 280;
        const int h = 128;
        const int padTop = 8;
        const int padBottom = 8;
        int minVal = 2;
        int maxVal = 45;
        int n = _trend.Length;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double x = i * (w - 1.0) / (n - 1);
            double y = padTop + (1.0 - (double)(_trend[i].Count - minVal) / (maxVal - minVal)) * (h - padTop - padBottom);
            sb.Append(i == 0 ? $"M{x:F1},{y:F1}" : $" L{x:F1},{y:F1}");
        }
        // close area to bottom
        double lastX = (n - 1) * (w - 1.0) / (n - 1);
        double bottom = h - padBottom;
        sb.Append($" L{lastX:F1},{bottom:F1} L0,{bottom:F1} Z");
        return sb.ToString();
    }
}
