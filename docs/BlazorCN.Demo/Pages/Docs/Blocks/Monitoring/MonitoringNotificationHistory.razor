@* ============================================================
   Block: monitoring-notification-history
   Title: MonitoringNotificationHistory
   Description: Operational alert audit block featuring a historical log of sent notifications, delivery status tracking, and channel-specific performance metrics with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-notification-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted text-foreground">
                    <LucideIconCn Name="history" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">Notification History</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Last 24 Hours · 1,242 Sent
                    </p>
                </div>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline uppercase tracking-tight">
                Clear Audit Log
            </button>
        </div>

        <div class="divide-y">
            @foreach (var notif in _history)
            {
                var n = notif;
                var statusStyle = _statusStyles.TryGetValue(n.Status, out var ss) ? ss : "";
                <div class="p-4 flex items-start justify-between hover:bg-muted/30 transition-colors">
                    <div class="flex items-start gap-3.5">
                        <div class="mt-1 flex size-8 items-center justify-center rounded-full border bg-background text-muted-foreground">
                            <LucideIconCn Name="@n.IconName" Size="14" Class="size-3.5" />
                        </div>
                        <div class="space-y-1">
                            <h4 class="text-sm font-bold text-foreground leading-tight">@n.Title</h4>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground font-medium">
                                <span class="font-bold text-[11px] uppercase">@n.Channel</span>
                                <span>·</span>
                                <span>@n.Recipient</span>
                            </div>
                            @if (!string.IsNullOrEmpty(n.Error))
                            {
                                <p class="text-[10px] text-red-600 font-mono font-medium pt-1">
                                    Error: @n.Error
                                </p>
                            }
                        </div>
                    </div>

                    <div class="flex flex-col items-end gap-2 shrink-0">
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-mono font-medium text-muted-foreground">
                                @n.Time
                            </span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-[9px] h-4 font-bold uppercase tracking-tight", statusStyle)">
                                @if (n.Status == "delivered")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5 mr-1" />
                                }
                                else
                                {
                                    <LucideIconCn Name="x-circle" Size="10" Class="size-2.5 mr-1" />
                                }
                                @n.Status
                            </BadgeCn>
                        </div>
                        <button type="button" aria-label="@($"Open {n.Title}")" class="text-muted-foreground/50 hover:text-foreground transition-colors">
                            <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-medium uppercase tracking-widest">
                    Pipeline Operational
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                Advanced Delivery Metrics →
            </button>
        </div>
    </div>
</section>

@code {
    private record NotifEntry(string Id, string Title, string Channel, string Recipient, string Status, string Time, string IconName, string Error = "");

    private static readonly NotifEntry[] _history =
    [
        new("NOTIF-842", "Critical: High API Error Rate", "PagerDuty", "On-Call Primary", "delivered", "14:45:02", "phone"),
        new("NOTIF-841", "Critical: High API Error Rate", "Slack", "#ops-alerts", "delivered", "14:45:01", "message-square"),
        new("NOTIF-840", "Warning: Redis Memory > 80%", "Email", "ops-team@acme.com", "failed", "12:30:15", "mail", "Invalid SMTP response"),
        new("NOTIF-839", "Resolved: Node-04 Recovered", "Slack", "#ops-alerts", "delivered", "11:12:45", "message-square"),
    ];

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["delivered"] = "text-emerald-600 bg-emerald-500/10 border-emerald-500/20",
        ["failed"] = "text-red-600 bg-red-500/10 border-red-500/20",
        ["sent"] = "text-blue-600 bg-blue-500/10 border-blue-500/20",
    };
}
