@* ============================================================
   Block: monitoring-cpu-usage
   Title: MonitoringCpuUsage
   Description: In-depth processor monitoring block featuring multi-core utilization charts, load averages, and process-level CPU tracking with Recharts and shadcn/ui.
   Source: original/blocks/monitoring/monitoring-cpu-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="cpu" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">CPU Utilization</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        8 Cores · Intel(R) Xeon(R) Platinum
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-[10px] font-medium text-muted-foreground uppercase">Load Avg</p>
                    <p class="text-xs font-mono font-bold">1.24 · 0.85 · 0.72</p>
                </div>
            </div>
        </div>

        <div class="p-4 border-b">
            <div class="mb-6 flex items-end justify-between">
                <div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-3xl font-bold tabular-nums tracking-tight">62.4</span>
                        <span class="text-sm font-medium text-muted-foreground">%</span>
                    </div>
                    <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground mt-1">
                        Total Processor Load
                    </p>
                </div>
                <div class="grid grid-cols-4 gap-1">
                    @foreach (var core in _cores)
                    {
                        var c = core;
                        <div class="w-6 h-6 rounded-sm bg-muted relative overflow-hidden">
                            <div class="absolute bottom-0 w-full bg-emerald-500/40"
                                 style="@(FormattableString.Invariant($"height:{c.Usage}%"))">
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="h-[140px] w-full">
                @{
                    var data = _cpuHistory;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 140;
                    var maxVal = 100.0;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double PtY(int i) => chartH - (double)data[i].Usage / maxVal * chartH;
                    var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{StepX(i):F1},{PtY(i):F1}")));
                    var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="cpuGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#10b981" stop-opacity="0.1" />
                            <stop offset="95%" stop-color="#10b981" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@fillPoints" fill="url(#cpuGradient)" />
                    <polyline points="@linePoints" fill="none" stroke="#10b981" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                    Top Processes
                </p>
                <button type="button" class="text-[10px] font-medium text-foreground hover:underline flex items-center gap-1">
                    <LucideIconCn Name="list" Size="12" Class="size-3" /> All Tasks
                </button>
            </div>
            <div class="space-y-3">
                @foreach (var proc in _processes)
                {
                    var p = proc;
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-medium">
                            <div class="flex items-center gap-2">
                                <span class="text-foreground">@p.Name</span>
                                <span class="text-muted-foreground/60 font-mono text-[10px]">
                                    PID: @p.Pid
                                </span>
                            </div>
                            <span class="text-foreground">@p.Usage%</span>
                        </div>
                        <ProgressCn Value="@p.Usage" Class="h-1" aria-label="Progress" />
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="info" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium">Context Switches: 1.2k/s</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                System Diagnostics →
            </button>
        </div>
    </div>
</section>

@code {
    private record CpuPoint(string Time, int Usage);
    private record CoreItem(int Id, int Usage);
    private record ProcessItem(string Name, double Usage, int Pid);

    private static readonly CpuPoint[] _cpuHistory =
    [
        new("10:00", 42),
        new("10:05", 38),
        new("10:10", 65),
        new("10:15", 82),
        new("10:20", 74),
        new("10:25", 55),
        new("10:30", 62),
    ];

    private static readonly CoreItem[] _cores =
    [
        new(0, 58),
        new(1, 42),
        new(2, 75),
        new(3, 31),
        new(4, 64),
        new(5, 47),
        new(6, 53),
        new(7, 69),
    ];

    private static readonly ProcessItem[] _processes =
    [
        new("node-server", 24.5, 1842),
        new("postgres", 12.2, 928),
        new("redis-server", 4.8, 1042),
    ];
}
