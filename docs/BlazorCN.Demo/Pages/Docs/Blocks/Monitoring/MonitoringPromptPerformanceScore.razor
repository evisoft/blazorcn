@* ============================================================
   Block: monitoring-prompt-performance-score
   Title: MonitoringPromptPerformanceScore
   Description: Professional AI monitoring dashboard featuring prompt version comparison, output quality scores, and latency metrics with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-prompt-performance-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10">
                    <LucideIconCn Name="target" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Prompt Scores</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Template: customer_service_reply
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="bg-emerald-500/10 text-emerald-600 border-emerald-500/20 px-2 py-0 h-5 font-medium">
                    VERSION: 2.1
                </BadgeCn>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var isLast = stat == _stats[2];
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@stat.Icon" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@stat.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        @if (!string.IsNullOrEmpty(stat.Unit))
                        {
                            <span class="text-xs text-muted-foreground font-medium">@stat.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Chart area *@
        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Version Comparison (v1 vs v2)</span>
                <div class="flex gap-4">
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-foreground"></div>
                        <span class="text-[10px] text-muted-foreground">v2.1</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-muted-foreground"></div>
                        <span class="text-[10px] text-muted-foreground">v1.4</span>
                    </div>
                </div>
            </div>

            @* Horizontal grouped bar chart rendered as pure HTML/CSS *@
            <div class="h-40 w-full flex flex-col justify-around">
                @foreach (var metric in _promptMetrics)
                {
                    var v2Pct = metric.V2;
                    var v1Pct = metric.V1;
                    <div class="flex items-center gap-2">
                        <span class="w-[70px] shrink-0 text-[10px] text-muted-foreground text-right">@metric.Metric</span>
                        <div class="flex-1 flex flex-col gap-0.5">
                            <div class="h-3 bg-muted/40 rounded-sm overflow-hidden">
                                <div class="h-full bg-foreground rounded-r-[4px]" style="@($"width:{v2Pct}%")"></div>
                            </div>
                            <div class="h-3 bg-muted/40 rounded-sm overflow-hidden">
                                <div class="h-full bg-muted-foreground rounded-r-[4px]" style="@($"width:{v1Pct}%")"></div>
                            </div>
                        </div>
                        <span class="w-8 shrink-0 text-[10px] text-muted-foreground text-right">@v2Pct</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                <span class="font-medium">1.2k Samples Evaluated</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Playground @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string Unit, string Icon);
    private record PromptMetric(string Metric, int V1, int V2);

    private static readonly StatItem[] _stats =
    [
        new("Quality Score", "91", "%", "star"),
        new("Valid JSON",     "98", "%", "check-circle-2"),
        new("Avg Latency",    "1.1", "s", "zap"),
    ];

    private static readonly PromptMetric[] _promptMetrics =
    [
        new("Quality",   82, 91),
        new("Adherence", 75, 95),
        new("Latency",   65, 72),
    ];
}
