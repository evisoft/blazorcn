@* ============================================================
   Block: monitoring-cors-error-log
   Title: MonitoringCorsErrorLog
   Description: Real-time monitoring dashboard for Cross-Origin Resource Sharing (CORS) errors featuring origin tracking, endpoint analysis, and policy validation using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-cors-error-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="share-2" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">CORS Error Log</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Cross-Origin Policy Monitoring</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <div class="text-[10px] font-semibold uppercase text-muted-foreground">Error Rate</div>
                    <div class="text-sm font-bold text-red-600">2.4%</div>
                </div>
                <div class="size-1.5 rounded-full bg-red-500 animate-pulse"></div>
            </div>
        </div>

        <div class="grid grid-cols-2 divide-x border-b bg-muted/10">
            <div class="p-3 text-center">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Blocked Origins</div>
                <div class="text-lg font-semibold">12</div>
            </div>
            <div class="p-3 text-center">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Total Blocks</div>
                <div class="text-lg font-semibold">983</div>
            </div>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-4">ORIGIN</span>
                <span class="col-span-4">ENDPOINT</span>
                <span class="col-span-2 text-center">COUNT</span>
                <span class="col-span-2 text-right">ERROR</span>
            </div>
            @foreach (var entry in _corsErrors)
            {
                var item = entry;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-4 flex items-center gap-2 pr-2">
                        <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground shrink-0" />
                        <code class="text-[10px] font-mono text-muted-foreground truncate">@item.Origin</code>
                    </div>
                    <div class="col-span-4 pr-2">
                        <code class="text-[10px] font-mono font-medium truncate block">@item.Endpoint</code>
                    </div>
                    <div class="col-span-2 text-center">
                        <span class="text-xs font-mono font-medium">@item.Count</span>
                    </div>
                    <div class="col-span-2 flex justify-end">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1 text-[8px] font-bold uppercase border-red-500/20 text-red-600 bg-red-500/5 whitespace-nowrap overflow-hidden text-ellipsis max-w-full">
                            @item.Error
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>

        <SeparatorCn />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="history" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Last error: 4s ago</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="server" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Policy: Restricted</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Adjust Headers →
            </button>
        </div>
    </div>
</section>

@code {
    private record CorsErrorEntry(string Origin, string Endpoint, string Error, int Count);

    private static readonly CorsErrorEntry[] _corsErrors =
    [
        new("https://unauthorized.app", "/api/v1/user", "Missing Allow-Origin", 842),
        new("https://localhost:3000", "/api/v1/auth", "Invalid Method", 124),
        new("https://test-env.io", "/api/v1/data", "Wildcard not allowed", 12),
        new("https://partner-portal.com", "/api/v1/orders", "Invalid Headers", 5),
    ];
}
