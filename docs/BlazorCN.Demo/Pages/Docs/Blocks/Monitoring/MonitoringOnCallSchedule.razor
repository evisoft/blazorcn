@* ============================================================
   Block: monitoring-on-call-schedule
   Title: MonitoringOnCallSchedule
   Description: Operational team management block featuring current on-call personnel, rotation timelines, and contact information for incident response with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-on-call-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-background">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">On-Call Rotation</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        SRE Team · Platform Operations
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-600">
                    Active
                </span>
            </div>
        </div>

        <div class="p-5 flex flex-col md:flex-row items-start md:items-center gap-6 border-b">
            <AvatarCn Class="size-16 border-2 border-muted">
                <AvatarImageCn Src="@_activeOnCall.Avatar" Alt="@_activeOnCall.Name" />
                <AvatarFallbackCn Class="bg-muted text-lg font-bold">
                    @_activeOnCall.Initials
                </AvatarFallbackCn>
            </AvatarCn>

            <div class="flex-1 space-y-1">
                <div class="flex items-center gap-2">
                    <h4 class="text-base font-bold text-foreground">@_activeOnCall.Name</h4>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-[10px] font-bold uppercase bg-blue-500/10 text-blue-600 border-blue-500/20">
                        Primary
                    </BadgeCn>
                </div>
                <p class="text-sm text-muted-foreground font-medium">
                    Platform Reliability Engineer
                </p>
                <div class="flex items-center gap-3 pt-1 text-muted-foreground">
                    <span class="flex items-center gap-1.5 text-xs">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                        Until @_activeOnCall.Ends
                    </span>
                </div>
            </div>

            <div class="flex gap-2 shrink-0">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs font-semibold">
                    <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
                    Slack
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs font-semibold">
                    <LucideIconCn Name="phone" Size="14" Class="size-3.5" />
                    Page
                </ButtonCn>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/80">
                Upcoming Rotation
            </p>
            <div class="grid gap-2">
                @foreach (var person in _rotation)
                {
                    <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30 hover:bg-muted/50 transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="size-7 rounded-full bg-muted border flex items-center justify-center text-[10px] font-bold text-muted-foreground">
                                @person.Initials
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-foreground">@person.Name</p>
                                <p class="text-[10px] text-muted-foreground font-medium">@person.Date</p>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Ghost" Class="text-[9px] font-bold uppercase tracking-tight text-muted-foreground/70">
                            @person.Level
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium uppercase tracking-wide">
                    Syncing with PagerDuty
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                View Full Calendar →
            </button>
        </div>
    </div>
</section>

@code {
    private record OnCallPerson(string Name, string Role, string Avatar, string Initials, string Slack, string Phone, string Ends);
    private record RotationEntry(string Name, string Date, string Initials, string Level);

    private static readonly OnCallPerson _activeOnCall = new(
        "Alex Rivera",
        "SRE / Primary",
        "/avatars/alex.jpg",
        "AR",
        "@@arivera",
        "+1 (555) 012-3456",
        "Oct 15, 09:00 UTC"
    );

    private static readonly RotationEntry[] _rotation =
    [
        new("Sarah Chen", "Oct 15 - Oct 22", "SC", "Secondary"),
        new("Marcus Wright", "Oct 22 - Oct 29", "MW", "Shadow"),
        new("Elena Rossi", "Oct 29 - Nov 05", "ER", "Primary"),
    ];
}
