@* ============================================================
   Block: monitoring-s3-usage
   Title: MonitoringS3Usage
   Description: A cloud storage monitoring dashboard for AWS S3, tracking storage capacity, request volumes, and data transfer rates.
   Source: original/blocks/monitoring/monitoring-s3-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card shadow-sm">

        @* Header *@
        <div class="flex items-center justify-between border-b px-6 py-4 bg-orange-500/[0.02]">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-xl bg-orange-500/10 border border-orange-500/20">
                    <LucideIconCn Name="hard-drive" Size="20" Class="size-5 text-orange-600 dark:text-orange-400" />
                </div>
                <div>
                    <h3 class="text-sm font-bold tracking-tight">S3 Storage Metrics</h3>
                    <p class="mt-0.5 text-muted-foreground text-[11px] font-semibold">
                        Global Assets · production-us-east-1
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-bold uppercase tracking-widest bg-orange-500/5 text-orange-600 border-orange-500/20">
                    Standard
                </BadgeCn>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @for (var i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                var isLast = i == _stats.Length - 1;
                var cellClass = isLast ? "p-6" : "p-6 md:border-r border-b md:border-b-0";
                <div class="@cellClass">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[10px] font-black text-muted-foreground uppercase tracking-widest">@stat.Label</span>
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-muted-foreground/40" />
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-black tabular-nums tracking-tighter">@stat.DisplayValue</span>
                        <span class="text-muted-foreground text-[10px] font-bold uppercase">@stat.Unit</span>
                    </div>

                    @* Sparkline — pure HTML/CSS bars *@
                    <div class="h-10 w-full mt-6 flex items-end gap-0.5">
                        @foreach (var pt in stat.Trend)
                        {
                            var heightPct = (int)Math.Round(pt / stat.TrendMax * 100);
                            var color = stat.Status == "warning" ? "#f59e0b" : "#f97316";
                            <div class="flex-1 rounded-t-[1px] opacity-[0.15]" style="@($"height:{heightPct}%; background:{color}")"></div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-6 py-4 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-4 text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                <div class="flex flex-col">
                    <span class="opacity-60">Total Objects</span>
                    <span class="text-foreground text-xs font-black">14.2M</span>
                </div>
                <div class="flex flex-col">
                    <span class="opacity-60">Avg. Object Size</span>
                    <span class="text-foreground text-xs font-black">84.5 KB</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-black uppercase text-orange-600 dark:text-orange-400 hover:underline">
                Storage Lens @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string DisplayValue, string Unit, string IconName, string Status, double[] Trend)
    {
        public double TrendMax => Trend.Length > 0 ? Trend.Max() : 1;
    }

    private static readonly double[] _baseTrend =
    [
        840, 852, 865, 880, 875, 890, 910, 925, 940, 955, 980, 1024
    ];

    private static readonly double[] _requestsTrend =
    [
        840 / 20.0, 852 / 20.0, 865 / 20.0, 880 / 20.0,
        875 / 20.0, 890 / 20.0, 910 / 20.0, 925 / 20.0,
        940 / 20.0, 955 / 20.0, 980 / 20.0, 1024 / 20.0
    ];

    private static readonly double[] _bandwidthTrend =
    [
        (840 - 800) * 2.0, (852 - 800) * 2.0, (865 - 800) * 2.0, (880 - 800) * 2.0,
        (875 - 800) * 2.0, (890 - 800) * 2.0, (910 - 800) * 2.0, (925 - 800) * 2.0,
        (940 - 800) * 2.0, (955 - 800) * 2.0, (980 - 800) * 2.0, (1024 - 800) * 2.0
    ];

    private static readonly StatItem[] _stats =
    [
        new("Total Storage",  "1.2",  "TB",    "box",                 "healthy", _baseTrend),
        new("Requests",       "48.5", "k/hr",  "mouse-pointer-click", "healthy", _requestsTrend),
        new("Bandwidth Out",  "242",  "GB",    "arrow-up-right",      "warning", _bandwidthTrend),
    ];
}
