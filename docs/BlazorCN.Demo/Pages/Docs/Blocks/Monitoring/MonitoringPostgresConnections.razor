@* ============================================================
   Block: monitoring-postgres-connections
   Title: MonitoringPostgresConnections
   Description: A specialized monitoring dashboard for PostgreSQL connection pools, tracking active vs idle connections, transaction throughput, and pool saturation.
   Source: original/blocks/monitoring/monitoring-postgres-connections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card/50 backdrop-blur-sm shadow-sm">
        <div class="flex items-center justify-between border-b px-6 py-4 bg-blue-500/[0.03]">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-xl bg-blue-500/10 border border-blue-500/20">
                    <LucideIconCn Name="database" Size="20" Class="size-5 text-blue-600 dark:text-blue-400" />
                </div>
                <div>
                    <h3 class="text-sm font-bold tracking-tight">PostgreSQL Cluster</h3>
                    <p class="mt-0.5 text-muted-foreground text-[11px] font-semibold opacity-70">
                        Primary Node · AWS RDS Large
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-black uppercase tracking-widest bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20">
                    Connected
                </BadgeCn>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <LucideIconCn Name="@s.IconName" Size="14" Class="size-3.5 text-muted-foreground/50" />
                        <span class="text-[10px] font-black text-muted-foreground uppercase tracking-wider">@s.Label</span>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-black tabular-nums tracking-tighter">@s.DisplayValue</span>
                        <span class="text-muted-foreground text-[10px] font-bold uppercase">@s.Unit</span>
                    </div>

                    <div class="h-10 w-full mt-6">
                        @{
                            var stroke = s.Status == "warning" ? "#f59e0b" : "#3b82f6";
                            var fill = s.Status == "warning" ? "#f59e0b" : "#3b82f6";
                            var points = s.Trend;
                            var maxVal = points.Max();
                            var minVal = points.Min();
                            var range = maxVal - minVal == 0 ? 1.0 : maxVal - minVal;
                            var w = 200;
                            var h = 40;
                            var step = (double)w / (points.Length - 1);
                            var polylinePoints = string.Join(" ", System.Linq.Enumerable.Range(0, points.Length)
                                .Select(idx => $"{idx * step:F1},{h - (points[idx] - minVal) / range * h:F1}"));
                            var polyFillPoints = $"0,{h} " + polylinePoints + $" {w},{h}";
                        }
                        <svg viewBox="0 0 @w @h" preserveAspectRatio="none" class="w-full h-full">
                            <polygon points="@polyFillPoints" fill="@fill" fill-opacity="0.05" />
                            <polyline points="@polylinePoints" fill="none" stroke="@stroke" stroke-width="2.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="px-6 py-4 bg-muted/10 flex items-center justify-between">
            <div class="flex items-center gap-6">
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">Idle Conns</span>
                    <span class="text-xs font-bold tabular-nums">142</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">Max Limit</span>
                    <span class="text-xs font-bold tabular-nums text-muted-foreground">1,000</span>
                </div>
            </div>
            <button type="button" class="group flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-primary">
                View Queries
                <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string DisplayValue, string Unit, string IconName, string Status, double[] Trend);

    private static readonly double[] _connData =
        [45, 52, 58, 65, 62, 70, 82, 75, 68, 72, 85, 78];

    private static readonly StatItem[] _stats =
    [
        new("Active Conns", "78", "sessions", "users", "healthy",
            [45, 52, 58, 65, 62, 70, 82, 75, 68, 72, 85, 78]),
        new("TPS (Commits)", "420", "txn/s", "activity", "healthy",
            [270, 312, 348, 390, 372, 420, 492, 450, 408, 432, 510, 468]),
        new("Pool Saturation", "62.4", "%", "link", "warning",
            [37.5, 43.3, 48.3, 54.2, 51.7, 58.3, 68.3, 62.5, 56.7, 60, 70.8, 65]),
    ];
}
