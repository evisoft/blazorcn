@* ============================================================
   Block: monitoring-zendesk-integration-status
   Title: MonitoringZendeskIntegrationStatus
   Description: Real-time monitoring for Zendesk API connectivity, webhook delivery, and synchronization health using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-zendesk-integration-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="help-circle" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Zendesk Connector</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Production Sync · v2.4.0 API</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Synchronized
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var i = idx;
                var borderClass = i != _stats.Length - 1 ? "md:border-r border-b md:border-b-0" : "";
                <div class="@($"p-4 {borderClass}")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20">
                            Active
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        <span class="text-muted-foreground text-xs font-medium">@stat.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@stat.Label</p>

                    <div class="h-10 w-full mt-4">
                        @{
                            var trend = stat.Trend;
                            var chartW = 200;
                            var chartH = 40;
                            var minV = trend.Min() - 1.0;
                            var maxV = trend.Max() + 1.0;
                            var valRange = maxV - minV == 0 ? 1.0 : maxV - minV;
                            var count = trend.Length;
                            double sx(int ci) => count <= 1 ? 0.0 : (double)chartW / (count - 1) * ci;
                            double sy(double v) => chartH - (v - minV) / valRange * chartH;
                            var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(ci => $"{sx(ci):F1},{sy(trend[ci]):F1}"));
                            var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                            var gradId = $"gradient-zen-{i}";
                        }
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="#10b981" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="#10b981" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradId})")" />
                            <polyline points="@linePoints" fill="none" stroke="#10b981" stroke-width="2" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Last Successful Sync: 12s ago
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Connection Settings →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string Unit, string IconName, double[] Trend);

    private static readonly double[] _baseTrend = [98, 99, 100, 97, 99, 100, 98, 99, 100, 100];

    private static readonly StatItem[] _stats =
    [
        new("API Connectivity", "99.9", "%",     "link",         _baseTrend),
        new("Sync Latency",     "1.2",  "sec",   "refresh-cw",   [7, 6, 5, 8, 6, 5, 7, 6, 5, 5]),
        new("Webhook Rate",     "124",  "req/m", "shield-check",  [100, 101, 102, 100, 101, 102, 100, 101, 102, 100]),
    ];
}
