@* ============================================================
   Block: monitoring-console-log-aggregator
   Title: MonitoringConsoleLogAggregator
   Description: Real-time console log aggregation dashboard featuring log level distribution, error frequency tracking, and live stream visualization with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-console-log-aggregator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="terminal" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Console Log Aggregator</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Centralized application logging</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600">Active</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var isLast = idx == _stats.Length - 1;
                <div class="@($"p-4{(!isLast ? " md:border-r border-b md:border-b-0" : "")}")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">@stat.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                    </div>
                    <div class="h-8 w-full mt-3">
                        @{
                            var trendData = _logTrend;
                            var trendCount = trendData.Length;
                            var chartW = 200;
                            var chartH = 32;
                            var minV = trendData.Min(d => d.Value);
                            var maxV = trendData.Max(d => d.Value);
                            var vRange = maxV - minV == 0 ? 1 : maxV - minV;
                            double Tx(int i) => trendCount <= 1 ? 0 : (double)chartW / (trendCount - 1) * i;
                            double Ty(int v) => chartH - (double)(v - minV) / vRange * chartH;
                            var linePoints = string.Join(" ", Enumerable.Range(0, trendCount).Select(i => $"{Tx(i):F1},{Ty(trendData[i].Value):F1}"));
                            var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                            var gradId = $"logGrad{idx}";
                        }
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@stat.Color" stop-opacity="0.05" />
                                    <stop offset="95%" stop-color="@stat.Color" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="url(#@gradId)" />
                            <polyline points="@linePoints" fill="none" stroke="@stat.Color" stroke-width="1" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="p-0">
            <div class="bg-muted/30 px-4 py-2 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground border-b">
                Live Stream
            </div>
            <div class="divide-y">
                @foreach (var log in _logs)
                {
                    var dotClass = log.Level == "error" ? "bg-red-500" : log.Level == "warn" ? "bg-amber-500" : "bg-blue-500";
                    <div class="flex items-start gap-3 p-3 hover:bg-muted/50 transition-colors">
                        <div class="@($"mt-0.5 size-1.5 rounded-full shrink-0 {dotClass}")"></div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-mono truncate text-foreground">@log.Message</p>
                        </div>
                        <span class="text-[10px] text-muted-foreground whitespace-nowrap">@log.Timestamp</span>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Buffer: 1,000 Entries
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Full Logs →
            </button>
        </div>
    </div>
</section>

@code {
    private record TrendPoint(int Value);
    private record LogEntry(int Id, string Level, string Message, string Timestamp);
    private record StatItem(string Label, int Value, string Color, string Icon);

    private static readonly TrendPoint[] _logTrend =
    [
        new(12), new(15), new(10), new(25), new(18),
        new(30), new(22), new(35), new(40), new(32),
        new(28), new(45)
    ];

    private static readonly LogEntry[] _logs =
    [
        new(1, "error", "Failed to fetch user profile: 500 Internal Server Error", "2s ago"),
        new(2, "warn", "Deprecated API called: /v1/auth/verify", "12s ago"),
        new(3, "info", "User session started: user_9823", "45s ago"),
        new(4, "info", "Cache refreshed for 'dashboard-config'", "1m ago"),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Errors", 42, "#ef4444", "alert-circle"),
        new("Warnings", 128, "#f59e0b", "info"),
        new("Info", 1240, "#3b82f6", "search"),
    ];
}
