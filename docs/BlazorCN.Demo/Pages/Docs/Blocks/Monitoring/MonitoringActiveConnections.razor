@* ============================================================
   Block: monitoring-active-connections
   Title: MonitoringActiveConnections
   Description: A real-time infrastructure dashboard tracking concurrent network connections, WebSocket health, and protocol distribution.
   Source: original/blocks/monitoring/monitoring-active-connections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card/80 backdrop-blur-md shadow-xl">
        <div class="flex items-center justify-between border-b px-6 py-5 bg-indigo-500/[0.02]">
            <div class="flex items-center gap-3.5">
                <div class="flex size-11 items-center justify-center rounded-xl bg-indigo-500/10 border border-indigo-500/20 shadow-inner">
                    <LucideIconCn Name="activity" Size="24" Class="size-6 text-indigo-600 dark:text-indigo-400" />
                </div>
                <div>
                    <h3 class="text-base font-bold tracking-tight">Edge Concurrency</h3>
                    <p class="mt-0.5 text-muted-foreground text-xs font-semibold opacity-70">
                        Global Gateway · US-East Cluster
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-indigo-500/5 border border-indigo-500/10">
                    <span class="text-[10px] font-black text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">HTTP/3</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="p-6 transition-colors duration-300 hover:bg-indigo-500/[0.02]">
                    <div class="flex items-center gap-2 mb-4">
                        <LucideIconCn Name="@s.IconName" Size="14" Class="size-3.5 text-muted-foreground/60" />
                        <span class="text-[10px] font-black text-muted-foreground uppercase tracking-wider">@s.Label</span>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-black tabular-nums tracking-tighter">@s.Value</span>
                        <span class="text-muted-foreground text-[10px] font-bold uppercase">@s.Unit</span>
                    </div>

                    <div class="h-10 w-full mt-6">
                        @{
                            var stroke = s.Status == "warning" ? "#f59e0b" : "#6366f1";
                            var fill = s.Status == "warning" ? "#f59e0b" : "#6366f1";
                            var points = s.Trend;
                            var maxVal = points.Max();
                            var minVal = points.Min();
                            var range = maxVal - minVal == 0 ? 1 : maxVal - minVal;
                            var w = 200;
                            var h = 40;
                            var step = (double)w / (points.Length - 1);
                            var polylinePoints = string.Join(" ", System.Linq.Enumerable.Range(0, points.Length)
                                .Select(idx => FormattableString.Invariant($"{idx * step:F1},{h - (points[idx] - minVal) / (double)range * h:F1}")));
                            var polyFillPoints = $"0,{h} " + polylinePoints + $" {w},{h}";
                        }
                        <svg viewBox="0 0 @w @h" preserveAspectRatio="none" class="w-full h-full">
                            <polygon points="@polyFillPoints" fill="@fill" fill-opacity="0.03" />
                            <polyline points="@polylinePoints" fill="none" stroke="@stroke" stroke-width="2" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="px-6 py-4 bg-muted/10 flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-2">
                    <span class="opacity-50 text-[8px]">Active Pool</span>
                    <span class="text-foreground">94.2%</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="opacity-50 text-[8px]">Idle Pool</span>
                    <span class="text-foreground">5.8%</span>
                </div>
            </div>
            <button type="button" class="text-indigo-600 dark:text-indigo-400 hover:tracking-[0.2em] transition-all">
                Drain node →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, int Value, string Unit, string IconName, string Status, int[] Trend);

    private static readonly int[] _connectionTrend =
        [8400, 8900, 9200, 9100, 9500, 10200, 11400, 10800, 10100, 10500, 11200, 11800];

    private static readonly StatItem[] _stats =
    [
        new("Concurrent Conns", 11842, "active", "link", "healthy",
            [8400, 8900, 9200, 9100, 9500, 10200, 11400, 10800, 10100, 10500, 11200, 11800]),
        new("WebSocket Hits", 4210, "msgs/s", "wifi", "healthy",
            [3360, 3560, 3680, 3640, 3800, 4080, 4560, 4320, 4040, 4200, 4480, 4720]),
        new("Failed Handshakes", 14, "errors", "share-2", "warning",
            [10, 11, 11, 11, 11, 12, 14, 13, 12, 13, 14, 14]),
    ];
}
