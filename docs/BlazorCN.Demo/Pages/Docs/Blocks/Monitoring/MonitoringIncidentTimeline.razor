@* ============================================================
   Block: monitoring-incident-timeline
   Title: MonitoringIncidentTimeline
   Description: Operational incident tracking block featuring vertical event timelines, status updates, and historical outage logs for public or internal status pages with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-incident-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-6">
        @foreach (var inc in _incidents)
        {
            var incident = inc;
            var impact = _impactLabels.TryGetValue(incident.Impact, out var imp) ? imp : new ImpactInfo("Unknown", "bg-gray-500");
            var statusStyle = _statusStyles.TryGetValue(incident.Status, out var ss) ? ss : "";
            var pulseClass = incident.Status != "resolved" ? "animate-pulse" : "";
            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("size-2 rounded-full", impact.Color, pulseClass)"></div>
                        <h3 class="text-sm font-semibold">@incident.Title</h3>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-[10px] uppercase font-bold", statusStyle)">
                        @incident.Status
                    </BadgeCn>
                </div>

                <div class="p-4 bg-card">
                    <div class="flex items-center gap-2 mb-4 text-muted-foreground">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                        <span class="text-[10px] font-medium uppercase tracking-wider">@incident.Timestamp</span>
                        <span class="text-xs">·</span>
                        <span class="text-[10px] font-bold uppercase tracking-tight">@incident.Id</span>
                    </div>

                    <div class="space-y-6 relative pl-4 border-l ml-1.5">
                        @foreach (var upd in incident.Updates)
                        {
                            var update = upd;
                            <div class="relative">
                                <div class="absolute -left-[21px] top-1 size-2.5 rounded-full border-2 border-card bg-muted-foreground/30"></div>
                                <div class="space-y-1.5">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[11px] font-bold uppercase text-foreground">@update.Status</span>
                                        <span class="text-[10px] text-muted-foreground">— @update.Time UTC</span>
                                    </div>
                                    <p class="text-sm text-muted-foreground leading-relaxed">@update.Message</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (incident.Status != "resolved")
                {
                    <div class="px-4 py-2.5 bg-amber-50/50 dark:bg-amber-950/10 border-t flex items-center gap-2">
                        <LucideIconCn Name="info" Size="14" Class="size-3.5 text-amber-600" />
                        <p class="text-[10px] font-medium text-amber-700 dark:text-amber-500 uppercase tracking-wide">
                            Next update expected within 30 minutes
                        </p>
                    </div>
                }
            </div>
        }

        <div class="flex justify-center pt-2">
            <button type="button" class="text-xs font-medium text-muted-foreground hover:text-foreground flex items-center gap-1.5 transition-colors">
                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                View Incident Archive
            </button>
        </div>
    </div>
</section>

@code {
    private record IncidentUpdate(string Time, string Status, string Message);
    private record Incident(string Id, string Title, string Status, string Impact, string Timestamp, IncidentUpdate[] Updates);
    private record ImpactInfo(string Label, string Color);

    private static readonly Incident[] _incidents =
    [
        new("INC-942", "API Latency Degradation in US-East-1", "investigating", "partial_outage", "Oct 12, 2023 · 14:45 UTC",
        [
            new("15:20", "Investigating", "We have identified a network bottleneck in the primary availability zone and are currently re-routing traffic to secondary nodes."),
            new("14:50", "Identified", "Increased response times detected across all v1 endpoints. Our engineering team is looking into the root cause."),
        ]),
        new("INC-941", "Database Connection Pooling Issues", "resolved", "minor_outage", "Oct 10, 2023 · 09:12 UTC",
        [
            new("10:30", "Resolved", "Connection pool limits have been increased and service has returned to normal operational levels."),
        ]),
    ];

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["investigating"] = "bg-amber-500/10 text-amber-600 border-amber-500/20",
        ["resolved"] = "bg-emerald-500/10 text-emerald-600 border-emerald-500/20",
        ["identified"] = "bg-blue-500/10 text-blue-600 border-blue-500/20",
    };

    private static readonly Dictionary<string, ImpactInfo> _impactLabels = new()
    {
        ["partial_outage"] = new ImpactInfo("Partial Outage", "bg-amber-500"),
        ["minor_outage"] = new ImpactInfo("Minor Outage", "bg-blue-500"),
        ["major_outage"] = new ImpactInfo("Major Outage", "bg-red-500"),
    };
}
