@* ============================================================
   Block: monitoring-stripe-webhook-delivery-status
   Title: MonitoringStripeWebhookDeliveryStatus
   Description: Real-time monitoring of Stripe webhook delivery success, processing latency, and event volumes using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-stripe-webhook-delivery-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Stripe Webhooks</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Billing Integration · Live Mode
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Processing
                </span>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (var i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                var idx = i;
                var isLast = idx == _stats.Length - 1;
                var cellClass = isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0";
                <div class="@cellClass">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20">
                            Reliable
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.DisplayValue</span>
                        <span class="text-muted-foreground text-xs font-medium">@stat.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@stat.Label</p>

                    <div class="h-10 w-full mt-4">
                        @{
                            var points = stat.Trend;
                            var minV = 0.0;
                            var maxV = points.Max();
                            var range = maxV - minV;
                            if (range < 0.001) range = 1.0;
                            var svgW = 100.0;
                            var svgH = 40.0;
                            var step = svgW / (points.Length - 1);
                            var linePts = "";
                            var areaPts = $"0,{svgH}";
                            for (var pi = 0; pi < points.Length; pi++)
                            {
                                var px = pi * step;
                                var py = svgH - (points[pi] - minV) / range * svgH;
                                linePts += $"{px:F2},{py:F2} ";
                                areaPts += $" {px:F2},{py:F2}";
                            }
                            areaPts += $" {svgW},{svgH}";
                            var gradId = $"gradient-stripe-{idx}";
                        }
                        <svg viewBox="0 0 100 40" preserveAspectRatio="none" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                @((MarkupString)$"<linearGradient id=\"{gradId}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"5%\" stop-color=\"#10b981\" stop-opacity=\"0.1\"/><stop offset=\"95%\" stop-color=\"#10b981\" stop-opacity=\"0\"/></linearGradient>")
                            </defs>
                            @((MarkupString)$"<polygon points=\"{areaPts}\" fill=\"url(#{gradId})\" />")
                            @((MarkupString)$"<polyline points=\"{linePts.Trim()}\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" />")
                        </svg>
                    </div>
                </div>
            }
        </div>

        @* Separator *@
        <div class="w-full h-px bg-border"></div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Latest Event: invoice.payment_succeeded
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Stripe Dashboard @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string DisplayValue, string Unit, string IconName, double[] Trend);

    private static readonly double[] _baseTrend = [99.8, 100.0, 100.0, 99.5, 99.2, 99.9, 100.0, 100.0, 99.7, 100.0];

    private static readonly StatItem[] _stats =
    [
        new("Delivery Success", "99.9", "%",  "check-circle",
            [99.8, 100.0, 100.0, 99.5, 99.2, 99.9, 100.0, 100.0, 99.7, 100.0]),
        new("Avg. Latency",     "142",  "ms", "activity",
            [150.2, 150.0, 150.0, 155.0, 158.0, 151.0, 150.0, 150.0, 153.0, 150.0]),
        new("Event Volume",     "12.4", "k/h", "zap",
            [9.98, 10.0, 10.0, 10.05, 10.08, 10.01, 10.0, 10.0, 10.03, 10.0]),
    ];
}
