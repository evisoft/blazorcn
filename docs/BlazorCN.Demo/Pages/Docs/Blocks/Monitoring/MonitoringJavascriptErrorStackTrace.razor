@* ============================================================
   Block: monitoring-javascript-error-stack-trace
   Title: MonitoringJavascriptErrorStackTrace
   Description: Real-time frontend error monitoring dashboard featuring automated stack trace capture, error grouping, and device telemetry using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-javascript-error-stack-trace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3 bg-red-500/5">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-red-500/10 text-red-600">
                    <LucideIconCn Name="bug" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none text-red-950 dark:text-red-100">Client Exceptions</h3>
                    <p class="mt-1 text-red-900/60 dark:text-red-100/60 text-xs">
                        Runtime Errors · Production
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <div class="text-[10px] font-semibold uppercase text-red-900/50 dark:text-red-100/50">Stability</div>
                    <div class="text-sm font-bold text-red-600">98.2%</div>
                </div>
                <div class="size-1.5 rounded-full bg-red-500 animate-pulse"></div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var err in _errors)
            {
                var error = err;
                var badgeClass = error.Status == "resolved"
                    ? "h-5 px-1.5 text-[9px] uppercase font-bold bg-emerald-500/10 text-emerald-600 border-emerald-500/20"
                    : "h-5 px-1.5 text-[9px] uppercase font-bold bg-red-500/10 text-red-600 border-red-500/20";
                <div class="p-4 hover:bg-muted/20 transition-colors">
                    <div class="flex items-start justify-between gap-4 mb-2">
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-mono font-bold text-foreground truncate">@error.Message</h4>
                            <div class="flex items-center gap-2 mt-1">
                                <LucideIconCn Name="terminal" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-[10px] text-muted-foreground font-mono">@error.Location</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                            @error.Status
                        </BadgeCn>
                    </div>

                    <div class="flex items-center gap-6">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="layers" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-[10px] font-mono text-muted-foreground">@error.Count Events</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-[10px] font-mono text-muted-foreground">@error.Users Users</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="chrome" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-[10px] text-muted-foreground">v124.0.1</span>
                        </div>
                    </div>

                    <div class="mt-3 p-2 rounded bg-muted/30 font-mono text-[9px] text-muted-foreground overflow-x-auto whitespace-nowrap">
                        <div class="flex gap-2">
                            <span class="text-red-500 opacity-50">41 |</span>
                            <span>const items = data.results;</span>
                        </div>
                        <div class="flex gap-2 bg-red-500/10 -mx-2 px-2 py-0.5 my-0.5">
                            <span class="text-red-500 font-bold">42 |</span>
                            <span class="text-foreground font-medium underline decoration-red-500/50">return items.map((item) =&gt; (</span>
                        </div>
                        <div class="flex gap-2">
                            <span class="text-red-500 opacity-50">43 |</span>
                            <span>  &lt;div key="item.id"&gt;item.name&lt;/div&gt;</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Last event: 12s ago</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Error Details →
            </button>
        </div>
    </div>
</section>

@code {
    private record ErrorItem(string Id, string Message, string Location, int Count, int Users, string Status);

    private static readonly ErrorItem[] _errors =
    [
        new("e1", "TypeError: Cannot read property 'map' of undefined", "ProductList.tsx:42:15", 1240, 850, "active"),
        new("e2", "ReferenceError: analytics is not defined", "useAnalytics.ts:12:8", 452, 410, "active"),
        new("e3", "ChunkLoadError: Loading chunk 4 failed", "webpack/runtime.js:2:1", 85, 42, "resolved"),
    ];
}
