@* ============================================================
   Block: monitoring-ssh-login-activity
   Title: MonitoringSshLoginActivity
   Description: Real-time monitoring of SSH login attempts, active server sessions, and authentication failure trends using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-ssh-login-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="terminal" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">SSH Access Monitor</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Production Fleet · Global Logins
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-amber-600 dark:text-amber-400">
                    High Attempts
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isLast = s.Label == _stats[_stats.Length - 1].Label;
                <div class="@Cn.Merge("p-4", !isLast ? "md:border-r border-b md:border-b-0" : "")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@s.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary"
                                 Class="@Cn.Merge("h-5 px-1.5 font-normal text-[10px]", s.Status == "warning" ? "bg-amber-500/10 text-amber-600 border-amber-500/20" : "bg-emerald-500/10 text-emerald-600 border-emerald-500/20")">
                            @(s.Status == "warning" ? "Caution" : "Stable")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.DisplayValue</span>
                        <span class="text-muted-foreground text-xs font-medium">@s.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@s.Label</p>

                    <div class="h-10 w-full mt-4">
                        @{
                            var trendData = s.Trend;
                            var tCount = trendData.Length;
                            var chartW = 200;
                            var chartH = 40;
                            double minVal = 0;
                            double maxVal = trendData.Max(p => p);
                            if (maxVal <= minVal) maxVal = minVal + 1;
                            double StepX(int idx) => tCount <= 1 ? 0 : (double)chartW / (tCount - 1) * idx;
                            double PtY(int idx) => chartH - (trendData[idx] - minVal) / (maxVal - minVal) * chartH;
                            var linePoints = string.Join(" ", Enumerable.Range(0, tCount).Select(idx => $"{StepX(idx):F1},{PtY(idx):F1}"));
                            var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                            var strokeColor = s.Status == "warning" ? "#f59e0b" : "#10b981";
                            var gradId = $"gradient-ssh-{s.GradIndex}";
                        }
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Top Attacker IP: 192.168.1.104
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Access Logs →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string DisplayValue, string Unit, string IconName, string Status, double[] Trend, int GradIndex);

    private static readonly double[] _baseData = [12, 8, 15, 45, 92, 30, 12, 10, 8, 14];

    private static readonly StatItem[] _stats =
    [
        new("Active Sessions", "8", "usr", "log-in", "healthy",
            _baseData.Select(v => v / 10.0 + 2).ToArray(), 0),
        new("Failed Auth", "142", "err", "alert-circle", "warning",
            _baseData.ToArray(), 1),
        new("Auth Success", "94.8", "%", "shield", "healthy",
            _baseData.Select(v => 100 - v / 10.0).ToArray(), 2),
    ];
}
