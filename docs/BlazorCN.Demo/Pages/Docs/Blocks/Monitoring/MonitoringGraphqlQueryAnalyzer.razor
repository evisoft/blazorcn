@* ============================================================
   Block: monitoring-graphql-query-analyzer
   Title: MonitoringGraphqlQueryAnalyzer
   Description: Advanced GraphQL monitoring dashboard featuring query complexity scores, resolver latency tracking, and schema usage analytics with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-graphql-query-analyzer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="code-2" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">GraphQL Analyzer</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Query performance &amp; complexity</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Healthy</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var isLast = idx == _stats.Length - 1;
                <div class="@($"p-4{(!isLast ? " md:border-r border-b md:border-b-0" : "")}")">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@stat.Icon" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@stat.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        @if (!string.IsNullOrEmpty(stat.Unit))
                        {
                            <span class="text-xs text-muted-foreground">@stat.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-4">Top Slow Queries (ms)</p>
            <div class="h-48 w-full">
                @{
                    var data = _queryData;
                    var maxTime = data.Max(d => d.Time);
                    var barHeight = 24;
                    var gap = 14;
                    var labelWidth = 80;
                    var chartPaddingRight = 10;
                    var svgWidth = 400;
                    var svgHeight = data.Length * (barHeight + gap) - gap;
                    var barMaxWidth = svgWidth - labelWidth - chartPaddingRight;
                }
                <svg viewBox="0 0 @svgWidth @svgHeight" preserveAspectRatio="none" class="w-full h-full">
                    @for (int i = 0; i < data.Length; i++)
                    {
                        var item = data[i];
                        var y = i * (barHeight + gap);
                        var barW = maxTime == 0 ? 0 : (double)item.Time / maxTime * barMaxWidth;
                        var barX = labelWidth;
                        var labelY = y + barHeight / 2.0 + 4;
                        <g key="@item.Name">
                            @((MarkupString)FormattableString.Invariant($"<text x=\"{labelWidth - 6}\" y=\"{labelY:F1}\" text-anchor=\"end\" font-size=\"10\" fill=\"#888\">{item.Name}</text>"))
                            <rect x="@($"{barX}")" y="@($"{y}")" width="@(FormattableString.Invariant($"{barW:F1}"))" height="@($"{barHeight}")" rx="0" ry="4" fill="currentColor" class="text-foreground" />
                        </g>
                    }
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal py-0">98% Success Rate</BadgeCn>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Analyze Schema →
            </button>
        </div>
    </div>
</section>

@code {
    private record QueryItem(string Name, int Time, int Complexity);
    private record StatItem(string Label, int Value, string Icon, string Unit = "");

    private static readonly QueryItem[] _queryData =
    [
        new("getUser", 45, 12),
        new("listProducts", 120, 45),
        new("getOrders", 85, 32),
        new("searchItems", 210, 68),
        new("updateProfile", 65, 15),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Avg Complexity", 34, "database"),
        new("Queries / sec", 125, "zap"),
        new("Cache Hit Rate", 82, "bar-chart-3", "%"),
    ];
}
