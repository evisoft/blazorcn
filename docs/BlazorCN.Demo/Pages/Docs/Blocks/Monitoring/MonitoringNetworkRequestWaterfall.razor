@* ============================================================
   Block: monitoring-network-request-waterfall
   Title: MonitoringNetworkRequestWaterfall
   Description: Professional network timing visualization dashboard featuring request waterfall charts, resource size analysis, and TTFB tracking with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-network-request-waterfall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="globe" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Network Waterfall</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Real-time request timing</p>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                <span>2.4s Load</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var isLast = idx == _stats.Length - 1;
                <div class="@($"p-4{(!isLast ? " md:border-r border-b md:border-b-0" : "")}")">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@stat.Label</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        <span class="text-xs text-muted-foreground font-medium">@stat.Unit</span>
                    </div>
                </div>
            }
        </div>

        <div class="p-4 space-y-4">
            <div class="space-y-3">
                @foreach (var req in _requests)
                {
                    var barWidthPct = (req.Duration / 2500.0) * 100.0;
                    var barOffsetPct = (req.Start / 2500.0) * 100.0;
                    var barColor = req.Type == "fetch" ? "bg-blue-500"
                                 : req.Type == "script" ? "bg-amber-500"
                                 : req.Type == "image" ? "bg-emerald-500"
                                 : "bg-muted-foreground";
                    <div class="relative">
                        <div class="flex items-center justify-between text-[10px] mb-1">
                            <span class="font-mono text-foreground truncate max-w-[150px]">@req.Name</span>
                            <span class="text-muted-foreground">@(req.Duration)ms</span>
                        </div>
                        <div class="h-2 w-full bg-muted rounded-full overflow-hidden">
                            <div class="@($"h-full rounded-full {barColor}")"
                                 style="@($"width:{barWidthPct:F1}%; margin-left:{barOffsetPct:F1}%")">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex gap-3">
                @foreach (var legendType in _legendTypes)
                {
                    var lt = legendType;
                    var dotColor = lt == "fetch" ? "bg-blue-500" : lt == "script" ? "bg-amber-500" : "bg-emerald-500";
                    <div class="flex items-center gap-1.5">
                        <div class="@($"size-1.5 rounded-full {dotColor}")"></div>
                        <span class="text-[10px] capitalize text-muted-foreground font-medium">@lt</span>
                    </div>
                }
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Performance →
            </button>
        </div>
    </div>
</section>

@code {
    private record RequestItem(string Name, string Type, int Start, int Duration, string Size, int Status);
    private record StatItem(string Label, string Value, string Unit);

    private static readonly RequestItem[] _requests =
    [
        new("main.js",      "script", 0,   450,  "124kb", 200),
        new("api/user",     "fetch",  120, 890,  "1.2kb", 200),
        new("styles.css",   "style",  40,  210,  "45kb",  200),
        new("hero.webp",    "image",  480, 1200, "890kb", 200),
        new("analytics.js", "script", 900, 340,  "12kb",  200),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Total Requests", "48",  ""),
        new("Transferred",    "1.2", "MB"),
        new("Avg. Latency",   "342", "ms"),
    ];

    private static readonly string[] _legendTypes = ["fetch", "script", "image"];
}
