@* ============================================================
   Block: monitoring-uptime-status
   Title: MonitoringUptimeStatus
   Description: Service availability monitoring block featuring multi-region status bars, historical uptime tracking, and real-time operational state using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-uptime-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">System Status</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        All systems operational
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary"
                     Class="bg-emerald-500/10 text-emerald-600 hover:bg-emerald-500/10 border-emerald-500/20 px-2 py-0.5 text-[10px] font-bold">
                99.98% Uptime
            </BadgeCn>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-foreground">Service Availability</span>
                    <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-tight">
                        Last 40 Days
                    </span>
                </div>

                <TooltipProviderCn DelayDuration="0">
                    <div class="flex gap-[3px] h-8 items-end">
                        @foreach (var day in _history)
                        {
                            var d = day;
                            var barColor = d.Status == "operational" ? "bg-emerald-500"
                                         : d.Status == "degraded"    ? "bg-amber-500"
                                                                     : "bg-red-500";
                            var barHeight = d.Status == "operational" ? "h-6" : "h-8";
                            <TooltipCn>
                                <TooltipTriggerCn>
                                    <div class="@Cn.Merge("flex-1 rounded-sm cursor-pointer transition-opacity hover:opacity-80", barColor, barHeight)"></div>
                                </TooltipTriggerCn>
                                <TooltipContentCn Class="text-[10px] font-medium py-1 px-2">
                                    <p>@d.Date</p>
                                    <p class="capitalize font-bold">@d.Status</p>
                                </TooltipContentCn>
                            </TooltipCn>
                        }
                    </div>
                </TooltipProviderCn>

                <div class="flex justify-between text-[10px] text-muted-foreground font-medium pt-1">
                    <span>40 days ago</span>
                    <span>Today</span>
                </div>
            </div>

            <div class="space-y-2.5 pt-2">
                <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/80">
                    Regional Availability
                </p>
                <div class="grid gap-2">
                    @foreach (var region in _regions)
                    {
                        var r = region;
                        var dotColor = r.Status == "operational" ? "bg-emerald-500"
                                      : r.Status == "degraded"   ? "bg-amber-500"
                                                                 : "bg-red-500";
                        var textColor = r.Status == "degraded" ? "text-amber-600" : "text-emerald-600";
                        var pulseClass = r.Status == "degraded" ? "animate-pulse" : "";
                        <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                            <div class="flex items-center gap-3">
                                <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-xs font-medium">@r.Name</span>
                            </div>
                            <div class="flex items-center gap-4">
                                <span class="text-[10px] font-mono text-muted-foreground">@r.Uptime</span>
                                <div class="flex items-center gap-1.5">
                                    <div class="@Cn.Merge("size-1.5 rounded-full", dotColor, pulseClass)"></div>
                                    <span class="@Cn.Merge("text-[10px] font-bold uppercase", textColor)">@r.Status</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="refresh-ccw" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium">Auto-refreshing every 60s</span>
            </div>
            <button type="button" class="flex items-center gap-1.5 text-[10px] font-bold text-foreground hover:underline">
                <LucideIconCn Name="info" Size="12" Class="size-3" />
                Uptime Methodology
            </button>
        </div>
    </div>
</section>

@code {
    private record HistoryDay(int Id, string Status, string Date);
    private record RegionItem(string Id, string Name, string Status, string Uptime);

    private static readonly RegionItem[] _regions =
    [
        new("us-east",     "US East (N. Virginia)",       "operational", "99.99%"),
        new("eu-central",  "Europe (Frankfurt)",          "operational", "100%"),
        new("ap-southeast","Asia Pacific (Singapore)",    "degraded",    "98.50%"),
    ];

    // Deterministic stand-in for the TSX's Math.random() history (mostly operational, a few degraded/outage)
    private static readonly string[] _statusPattern =
    [
        "operational","operational","operational","operational","operational",
        "operational","operational","operational","operational","degraded",
        "operational","operational","operational","operational","operational",
        "operational","operational","outage",     "operational","operational",
        "operational","operational","operational","operational","operational",
        "operational","degraded",   "operational","operational","operational",
        "operational","operational","operational","operational","operational",
        "operational","operational","operational","operational","operational",
    ];

    private static readonly HistoryDay[] _history = BuildHistory();

    private static HistoryDay[] BuildHistory()
    {
        var baseDate = new DateTime(2026, 6, 9);
        var days = new HistoryDay[40];
        for (var i = 0; i < 40; i++)
        {
            var date = baseDate.AddDays(-(39 - i)).ToString("M/d/yyyy");
            days[i] = new HistoryDay(i, _statusPattern[i], date);
        }
        return days;
    }
}
