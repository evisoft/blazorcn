@* ============================================================
   Block: monitoring-error-rate
   Title: MonitoringErrorRate
   Description: Real-time error rate tracking dashboard featuring error frequency charts, status code distribution, and critical exception alerts with Recharts and shadcn/ui.
   Source: original/blocks/monitoring/monitoring-error-rate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-red-500/10">
                    <LucideIconCn Name="bug" Size="16" Class="size-4 text-red-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Error Rate</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Last 24 hours · All services
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-red-600">Elevated</span>
                <div class="size-1.5 rounded-full bg-red-500 animate-pulse"></div>
            </div>
        </div>

        <div class="p-4 border-b">
            <div class="flex items-end justify-between mb-6">
                <div>
                    <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground mb-1">
                        Global Error Rate
                    </p>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-3xl font-bold tabular-nums tracking-tight">0.42</span>
                        <span class="text-sm font-medium text-muted-foreground">%</span>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground mb-1">
                        Total Exceptions
                    </p>
                    <span class="text-xl font-semibold tabular-nums">128</span>
                </div>
            </div>

            <div class="h-[120px] w-full">
                @{
                    var data = _errorTrend;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 120;
                    var maxVal = _errorTrend.Max(d => d.Errors) + 5.0;
                    double BarX(int i) => count == 0 ? 0 : (double)chartW / count * i + 4;
                    double BarW() => count == 0 ? 0 : (double)chartW / count - 8;
                    double BarH(int errors) => (double)errors / maxVal * chartH;
                    double BarY(int errors) => chartH - BarH(errors);
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    @for (int i = 0; i < count; i++)
                    {
                        var idx = i;
                        var bh = BarH(data[idx].Errors);
                        var by = BarY(data[idx].Errors);
                        var bx = BarX(idx);
                        var bw = BarW();
                        <rect x="@(FormattableString.Invariant($"{bx:F1}"))" y="@(FormattableString.Invariant($"{by:F1}"))" width="@(FormattableString.Invariant($"{bw:F1}"))" height="@(FormattableString.Invariant($"{bh:F1}"))"
                              fill="#ef4444" rx="2" ry="2" />
                    }
                </svg>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                Status Code Distribution
            </p>
            @foreach (var item in _statusCodes)
            {
                var sc = item;
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-xs font-medium">
                        <span class="text-foreground">@sc.Code</span>
                        <span class="text-muted-foreground">@sc.Count events</span>
                    </div>
                    <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@($"h-full {sc.Color}")" style="@($"width:{sc.Percentage}%")"></div>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-2.5 bg-red-50/50 dark:bg-red-950/20 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-red-600">
                <LucideIconCn Name="shield-alert" Size="14" Class="size-3.5" />
                <span class="text-[10px] font-semibold uppercase tracking-wide">
                    Critical Alert: High 5xx Frequency
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-red-600 hover:underline">
                View Stack Trace →
            </button>
        </div>
    </div>
</section>

@code {
    private record ErrorPoint(string Time, int Errors);
    private record StatusCodeItem(string Code, int Count, int Percentage, string Color);

    private static readonly ErrorPoint[] _errorTrend =
    [
        new("09:00", 12),
        new("10:00", 8),
        new("11:00", 15),
        new("12:00", 42),
        new("13:00", 28),
        new("14:00", 14),
        new("15:00", 10),
    ];

    private static readonly StatusCodeItem[] _statusCodes =
    [
        new("500 Internal Error", 84, 65, "bg-red-500"),
        new("404 Not Found", 32, 25, "bg-amber-500"),
        new("403 Forbidden", 12, 10, "bg-blue-500"),
    ];
}
