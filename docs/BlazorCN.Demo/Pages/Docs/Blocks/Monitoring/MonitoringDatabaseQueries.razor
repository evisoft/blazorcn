@* ============================================================
   Block: monitoring-database-queries
   Title: MonitoringDatabaseQueries
   Description: Database performance monitoring block featuring query volume charts, slow query tracking, and connection pool utilization with Recharts and shadcn/ui.
   Source: original/blocks/monitoring/monitoring-database-queries.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-indigo-500/10 text-indigo-600">
                    <LucideIconCn Name="database" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Database Performance</h3>
                    <p class="mt-1 text-muted-foreground text-xs font-medium">PostgreSQL · primary-db-cluster</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <p class="text-[10px] font-bold text-muted-foreground uppercase">Pool Usage</p>
                    <p class="text-xs font-mono font-bold">24 / 100</p>
                </div>
                <div class="size-2 rounded-full bg-emerald-500"></div>
            </div>
        </div>

        <div class="p-4 border-b">
            <div class="mb-6 flex items-end justify-between">
                <div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-3xl font-bold tabular-nums tracking-tight">1284</span>
                        <span class="text-xs font-medium text-muted-foreground">req/s</span>
                    </div>
                    <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground mt-1">
                        Transaction Volume
                    </p>
                </div>
                <div class="text-right">
                    <div class="flex items-baseline justify-end gap-1.5">
                        <span class="text-xl font-bold tabular-nums text-amber-600">14.2</span>
                        <span class="text-xs font-medium text-muted-foreground">ms</span>
                    </div>
                    <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground mt-1">
                        Avg Latency
                    </p>
                </div>
            </div>

            <div class="h-[120px] w-full">
                @{
                    var data = _queryTrend;
                    var chartW = 400;
                    var chartH = 120;
                    var maxQ = data.Max(d => d.Queries);
                    var barCount = data.Length;
                    var barGap = 4;
                    var totalGap = barGap * (barCount - 1);
                    var barW = barCount > 0 ? (chartW - totalGap) / barCount : 0;
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    @for (int i = 0; i < data.Length; i++)
                    {
                        var item = data[i];
                        var barH = maxQ > 0 ? (double)item.Queries / maxQ * chartH : 0;
                        var x = i * (barW + barGap);
                        var y = chartH - barH;
                        <rect x="@x" y="@(y.ToString("F1"))" width="@barW" height="@(barH.ToString("F1"))" fill="#6366f1" rx="2" ry="2" />
                    }
                </svg>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                    Slow Queries
                </p>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-bold text-red-600 border-red-200 bg-red-50">
                    3 Detected
                </BadgeCn>
            </div>
            <div class="space-y-2">
                @foreach (var query in _slowQueries)
                {
                    var q = query;
                    <div class="group p-2 rounded-md border bg-muted/30 hover:bg-muted/50 transition-colors">
                        <div class="flex items-start justify-between gap-4">
                            <p class="text-[11px] font-mono text-foreground line-clamp-1 flex-1">
                                @q.Sql
                            </p>
                            <div class="flex items-center gap-2 shrink-0">
                                <span class="@($"text-[10px] font-bold {(q.Status == "critical" ? "text-red-600" : "text-amber-600")}")">
                                    @(q.Duration)ms
                                </span>
                                <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                    <LucideIconCn Name="zap" Size="12" Class="size-3" />
                    99.2% Uptime
                </span>
                <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                    <LucideIconCn Name="activity" Size="12" Class="size-3" />
                    1.2k Active
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                Explain Plan →
            </button>
        </div>
    </div>
</section>

@code {
    private record QueryTrendPoint(string Time, int Queries);
    private record SlowQuery(string Sql, int Duration, string Status);

    private static readonly QueryTrendPoint[] _queryTrend =
    [
        new("13:00", 1240),
        new("13:05", 1180),
        new("13:10", 2450),
        new("13:15", 1890),
        new("13:20", 1320),
        new("13:25", 1450),
        new("13:30", 1280),
    ];

    private static readonly SlowQuery[] _slowQueries =
    [
        new("SELECT * FROM orders WHERE status = 'pending' AND created_at > ...", 452, "critical"),
        new("UPDATE users SET last_login = NOW() WHERE id IN (...)", 128, "warning"),
        new("SELECT count(*) FROM analytics_events GROUP BY type", 842, "critical"),
    ];
}
