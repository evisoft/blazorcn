@* ============================================================
   Block: monitoring-pipeline-visualizer
   Title: MonitoringPipelineVisualizer
   Description: Operational CI/CD workflow monitoring block featuring multi-stage pipeline visualization, stage-specific timing, and real-time step status with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-pipeline-visualizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted text-foreground border shadow-sm">
                    <LucideIconCn Name="terminal" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">CI/CD Pipeline</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Pipeline #1842 · trigger: push by @@arivera
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-blue-500/10 text-blue-600 border-blue-500/20 px-2 py-0.5 text-[10px] font-bold">
                Running
            </BadgeCn>
        </div>

        <div class="p-8">
            <div class="relative flex flex-col md:flex-row items-center justify-between gap-8 md:gap-0">
                @* Horizontal line for desktop *@
                <div class="absolute top-1/2 left-0 w-full h-0.5 bg-border -translate-y-1/2 hidden md:block"></div>

                @foreach (var stg in _stages)
                {
                    var stage = stg;
                    var dotClass = stage.Status == "success"
                        ? "size-10 rounded-full border-4 border-card flex items-center justify-center shadow-sm bg-emerald-500 text-white"
                        : stage.Status == "running"
                            ? "size-10 rounded-full border-4 border-card flex items-center justify-center shadow-sm bg-blue-500 text-white animate-pulse"
                            : stage.Status == "failed"
                                ? "size-10 rounded-full border-4 border-card flex items-center justify-center shadow-sm bg-red-500 text-white"
                                : "size-10 rounded-full border-4 border-card flex items-center justify-center shadow-sm bg-muted text-muted-foreground";
                    <div class="relative z-10 flex flex-col items-center group">
                        <div class="@dotClass">
                            @if (stage.Status == "success")
                            {
                                <LucideIconCn Name="check-circle-2" Size="20" Class="size-5" />
                            }
                            else if (stage.Status == "running")
                            {
                                <LucideIconCn Name="loader-2" Size="20" Class="size-5 animate-spin" />
                            }
                            else if (stage.Status == "failed")
                            {
                                <LucideIconCn Name="x-circle" Size="20" Class="size-5" />
                            }
                            else
                            {
                                <LucideIconCn Name="play" Size="16" Class="size-4 fill-current" />
                            }
                        </div>

                        <div class="mt-3 text-center md:absolute md:top-12 md:left-1/2 md:-translate-x-1/2 md:w-32">
                            <p class="text-xs font-bold text-foreground leading-tight group-hover:underline cursor-pointer">
                                @stage.Name
                            </p>
                            <p class="text-[10px] text-muted-foreground font-mono mt-1">
                                @stage.Duration
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-4 bg-muted/10 border-t space-y-3">
            <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                    Active Step Output
                </p>
                <span class="text-[10px] font-mono text-muted-foreground">
                    step: docker-push --tag v2.4.12
                </span>
            </div>
            <div class="bg-[#0a0a0a] rounded-md p-3 font-mono text-[11px] text-slate-300 space-y-1 border shadow-inner">
                <p>
                    <span class="text-slate-500">[14:22:10]</span> Initializing build context...
                </p>
                <p>
                    <span class="text-slate-500">[14:22:15]</span> Step 1/12 : FROM node:18-alpine
                </p>
                <p>
                    <span class="text-slate-500">[14:22:18]</span> ---&gt; Using cache
                </p>
                <p>
                    <span class="text-blue-400 font-bold">●</span> Pushing image to registry.hub.docker.com...
                </p>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-[10px] font-medium uppercase tracking-wide">
                    Last Successful Run: 4h ago
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                View Stage Details →
            </button>
        </div>
    </div>
</section>

@code {
    private record Stage(string Id, string Name, string Status, string Duration);

    private static readonly Stage[] _stages =
    [
        new("lint",   "Lint & Typecheck", "success", "12s"),
        new("test",   "Unit Tests",       "success", "1m 45s"),
        new("build",  "Docker Build",     "running", "2m 10s"),
        new("deploy", "Deploy to Prod",   "pending", "-"),
    ];
}
