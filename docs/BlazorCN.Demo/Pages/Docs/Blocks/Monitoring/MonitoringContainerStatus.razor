@* ============================================================
   Block: monitoring-container-status
   Title: MonitoringContainerStatus
   Description: Real-time container monitoring dashboard featuring resource utilization metrics, health checks, and lifecycle status for Docker and Kubernetes environments using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-container-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="box" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Containers</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Runtime Health · Resource Fleet
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <div class="text-[10px] font-semibold uppercase text-muted-foreground">Global CPU</div>
                    <div class="text-sm font-bold">24.5%</div>
                </div>
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
            </div>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-5">CONTAINER</span>
                <span class="col-span-3 text-right">CPU</span>
                <span class="col-span-2 text-right">MEM</span>
                <span class="col-span-2 text-right">STATUS</span>
            </div>
            @foreach (var container in _containers)
            {
                var c = container;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-5 flex items-center gap-2">
                        <LucideIconCn Name="layers" Size="14" Class="size-3.5 text-muted-foreground" />
                        <div class="flex flex-col">
                            <span class="text-xs font-medium truncate">@c.Name</span>
                            <span class="text-[9px] text-muted-foreground font-mono">@c.Image</span>
                        </div>
                    </div>
                    <div class="col-span-3 text-right">
                        <div class="flex items-center justify-end gap-1.5">
                            <span class="text-xs font-mono">@c.Cpu%</span>
                            <div class="w-12 h-1 bg-muted rounded-full overflow-hidden">
                                <div class="@Cn.Merge("h-full", c.Cpu > 40 ? "bg-amber-500" : "bg-emerald-500")"
                                     style="@($"width:{c.Cpu}%")">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-span-2 text-right">
                        <span class="text-xs font-mono">@(c.Mem)MB</span>
                    </div>
                    <div class="col-span-2 flex justify-end">
                        <div class="flex items-center gap-1.5">
                            <div class="@Cn.Merge("size-1.5 rounded-full", c.Status == "warning" ? "bg-amber-500" : "bg-emerald-500")"></div>
                            <span class="@Cn.Merge("text-[10px] font-medium uppercase", c.Status == "warning" ? "text-amber-600" : "text-emerald-600")">
                                @c.Status
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="database" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">4 Active Containers</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3 text-muted-foreground animate-spin" />
                    <span class="text-[10px] text-muted-foreground">Auto-syncing</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Manage Infrastructure →
            </button>
        </div>
    </div>
</section>

@code {
    private record Container(string Id, string Name, string Image, int Cpu, int Mem, string Status);

    private static readonly Container[] _containers =
    [
        new("c1", "api-gateway", "gateway:v2.4", 12, 256, "running"),
        new("c2", "auth-service", "auth:v1.8", 45, 512, "warning"),
        new("c3", "order-worker", "worker:latest", 8, 128, "running"),
        new("c4", "redis-cache", "redis:7.0", 4, 1024, "running"),
    ];
}
