@* ============================================================
   Block: monitoring-agent-reasoning-log
   Title: MonitoringAgentReasoningLog
   Description: Advanced AI monitoring dashboard featuring LLM agent reasoning traces, thought-action-observation loops, and decision-making logs with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-agent-reasoning-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-purple-500/10">
                    <LucideIconCn Name="brain-circuit" Size="16" Class="size-4 text-purple-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Agent Reasoning</h3>
                    <p class="mt-1 text-xs text-muted-foreground">Session: sess_af21_agent_01</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-[10px] font-normal">STEP 4/10</BadgeCn>
            </div>
        </div>

        @* Steps *@
        <div class="space-y-4 p-4">
            <div class="space-y-3">
                @foreach (var step in _steps)
                {
                    var stepItem = step;
                    var isLast = stepItem == _steps[_steps.Length - 1];
                    var iconBoxClass = stepItem.Type == "thought"
                        ? "flex size-6 items-center justify-center rounded border bg-purple-500/5 border-purple-500/20"
                        : stepItem.Type == "action"
                            ? "flex size-6 items-center justify-center rounded border bg-amber-500/5 border-amber-500/20"
                            : "flex size-6 items-center justify-center rounded border bg-blue-500/5 border-blue-500/20";
                    <div class="flex gap-3">
                        <div class="flex shrink-0 flex-col items-center gap-1">
                            <div class="@iconBoxClass">
                                @if (stepItem.Type == "thought")
                                {
                                    <LucideIconCn Name="brain-circuit" Size="12" Class="size-3 text-purple-600" />
                                }
                                else if (stepItem.Type == "action")
                                {
                                    <LucideIconCn Name="wrench" Size="12" Class="size-3 text-amber-600" />
                                }
                                else
                                {
                                    <LucideIconCn Name="eye" Size="12" Class="size-3 text-blue-600" />
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>
                        <div class="flex-1 pb-4">
                            <div class="mb-1 flex items-center justify-between">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">@stepItem.Type</span>
                                <span class="font-mono text-[10px] text-muted-foreground">@stepItem.Timestamp</span>
                            </div>
                            <p class="text-xs leading-relaxed text-foreground">@stepItem.Content</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="play" Size="12" Class="size-3 fill-emerald-500 text-emerald-500" />
                <span class="font-medium">Final Answer Generated</span>
            </div>
            <button type="button" class="text-[10px] font-medium text-foreground hover:underline">
                Debug Session →
            </button>
        </div>

    </div>
</section>

@code {
    private record ReasoningStep(string Type, string Content, string Timestamp);

    private static readonly ReasoningStep[] _steps =
    [
        new("thought", "The user wants to know the current weather in San Francisco. I need to use the weather tool.", "0ms"),
        new("action", "get_weather(location='San Francisco')", "+120ms"),
        new("observation", "Current weather in SF is 62°F and sunny.", "+450ms"),
        new("thought", "I have the weather info. Now I can formulate the final answer.", "+480ms"),
    ];
}
