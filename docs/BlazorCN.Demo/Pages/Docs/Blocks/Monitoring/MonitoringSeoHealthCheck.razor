@* ============================================================
   Block: monitoring-seo-health-check
   Title: MonitoringSeoHealthCheck
   Description: Real-time technical SEO monitoring dashboard featuring meta tag validation, indexability status, and content optimization scores using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-seo-health-check.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="search" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">SEO Health</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Technical SEO · Indexability Audit
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <div class="text-[10px] font-semibold uppercase text-muted-foreground">SEO Score</div>
                    <div class="text-sm font-bold text-amber-600">84</div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b bg-muted/10">
            <div class="p-3 text-center border-r">
                <div class="text-[10px] uppercase font-bold text-muted-foreground mb-1">Indexable</div>
                <div class="text-lg font-semibold text-emerald-600">Yes</div>
            </div>
            <div class="p-3 text-center border-r">
                <div class="text-[10px] uppercase font-bold text-muted-foreground mb-1">Crawlable</div>
                <div class="text-lg font-semibold text-emerald-600">Yes</div>
            </div>
            <div class="p-3 text-center">
                <div class="text-[10px] uppercase font-bold text-muted-foreground mb-1">Warnings</div>
                <div class="text-lg font-semibold text-amber-600">2</div>
            </div>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-5">METRIC</span>
                <span class="col-span-4 text-center">STATUS</span>
                <span class="col-span-3 text-right">SCORE</span>
            </div>
            @foreach (var met in _seoMetrics)
            {
                var metric = met;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-5 flex flex-col">
                        <span class="text-xs font-medium">@metric.Name</span>
                        <span class="text-[10px] text-muted-foreground">@metric.Detail</span>
                    </div>
                    <div class="col-span-4 flex justify-center">
                        @if (metric.Status == "pass")
                        {
                            <div class="flex items-center gap-1.5 text-emerald-600">
                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                                <span class="text-[10px] font-bold uppercase">Pass</span>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center gap-1.5 text-amber-600">
                                <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5" />
                                <span class="text-[10px] font-bold uppercase">Review</span>
                            </div>
                        }
                    </div>
                    <div class="col-span-3 flex justify-end items-center gap-2">
                        <div class="w-16 h-1 bg-muted rounded-full overflow-hidden">
                            <div class="@(metric.Score == 100 ? "h-full bg-emerald-500" : "h-full bg-amber-500")" style="@($"width:{metric.Score}%")"></div>
                        </div>
                        <span class="text-xs font-mono font-medium">@metric.Score</span>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">+2.4k impressions</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Mobile First</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Search Console →
            </button>
        </div>
    </div>
</section>

@code {
    private record SeoMetric(string Name, string Status, int Score, string Detail);

    private static readonly SeoMetric[] _seoMetrics =
    [
        new("Meta Titles", "pass", 100, "Optimal length"),
        new("Meta Descriptions", "warning", 65, "Too short (85 chars)"),
        new("Canonical Tags", "pass", 100, "Correctly set"),
        new("H1 Tags", "pass", 100, "Unique & present"),
        new("Image Alt Text", "warning", 42, "12 images missing alt"),
        new("Sitemap Status", "pass", 100, "Valid XML"),
    ];
}
