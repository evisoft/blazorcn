@* ============================================================
   Block: monitoring-log-stream
   Title: MonitoringLogStream
   Description: Real-time log visualization block featuring live tailing, level-based filtering, and auto-scrolling terminal interface for application observability.
   Source: original/blocks/monitoring/monitoring-log-stream.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card flex flex-col h-[500px]">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-background">
                    <LucideIconCn Name="terminal" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Log Stream</h3>
                    <p class="mt-1 text-muted-foreground text-xs font-medium">
                        prod-cluster-01 · tail -f
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 px-2 gap-1.5 text-xs font-semibold" OnClick="@(() => _isPaused = !_isPaused)">
                    @if (_isPaused)
                    {
                        <LucideIconCn Name="play" Size="12" Class="size-3" />
                        <span>Resume</span>
                    }
                    else
                    {
                        <LucideIconCn Name="pause" Size="12" Class="size-3" />
                        <span>Pause</span>
                    }
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs font-semibold text-red-600" aria-label="Clear logs">
                    <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Search / Filter toolbar *@
        <div class="flex items-center gap-2 border-b px-3 py-2 bg-muted/10">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="12" Class="absolute left-2.5 top-1/2 -translate-y-1/2 size-3 text-muted-foreground" />
                <input
                    type="text"
                    value="@_search"
                    @oninput="@((ChangeEventArgs e) => _search = e.Value?.ToString() ?? "")"
                    aria-label="Filter logs"
                    placeholder="Filter logs..."
                    class="h-7 w-full rounded-md border bg-background pl-8 pr-2 text-xs shadow-none focus:outline-none focus:ring-1 focus:ring-ring" />
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="filter" Size="12" Class="size-3" />
                Levels
            </ButtonCn>
        </div>

        @* Log lines *@
        <div class="flex-1 overflow-y-auto bg-[#0a0a0a] p-3 font-mono text-[11px] leading-relaxed selection:bg-white/20">
            <div class="space-y-1">
                @foreach (var log in _logs)
                {
                    var levelClass = log.Level == "error" ? "text-red-500"
                                   : log.Level == "warn"  ? "text-amber-500"
                                   : log.Level == "debug" ? "text-slate-500"
                                   : "text-blue-500";
                    <div class="group flex gap-3 hover:bg-white/5 px-1 py-0.5 rounded transition-colors">
                        <span class="text-slate-600 shrink-0 select-none">@log.Timestamp</span>
                        <span class="@($"uppercase font-bold shrink-0 w-10 {levelClass}")">@log.Level</span>
                        <span class="text-emerald-500 shrink-0">[@("{")@log.Service@("}")]</span>
                        <span class="text-slate-300 break-all">@log.Message</span>
                    </div>
                }
                @if (!_isPaused)
                {
                    <div class="flex gap-2 text-slate-500 pl-1 py-0.5">
                        <span class="animate-pulse">_</span>
                        <span>Waiting for events...</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2 bg-muted/30 border-t flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                Viewing 128 of 1,024 events
            </span>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[10px] font-bold text-emerald-600">Connected</span>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record LogEntry(string Id, string Timestamp, string Level, string Service, string Message);

    private static readonly LogEntry[] _logs =
    [
        new("1", "14:20:01", "info",  "api-gateway",  "Successfully authenticated user 8429"),
        new("2", "14:20:05", "warn",  "auth-svc",     "Rate limit reached for IP 192.168.1.1"),
        new("3", "14:20:12", "info",  "worker-prod",  "Job 928 completed in 452ms"),
        new("4", "14:20:18", "error", "db-primary",   "Connection timeout on pool 'read-replica-01'"),
        new("5", "14:20:22", "debug", "api-gateway",  "Request headers: { 'x-request-id': 'abc-123' }"),
        new("6", "14:20:30", "info",  "cdn-edge",     "Cache hit for /assets/main.css"),
    ];

    private bool _isPaused = false;
    private string _search = "";
}
