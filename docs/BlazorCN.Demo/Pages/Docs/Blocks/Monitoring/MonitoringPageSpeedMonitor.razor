@* ============================================================
   Block: monitoring-page-speed-monitor
   Title: MonitoringPageSpeedMonitor
   Description: Real-time page load speed monitoring dashboard featuring TTFB, FCP, and interactive trends with global geographic distribution using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-page-speed-monitor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="timer" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Page Speed</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Real-time Load Monitoring · Global</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Optimal</span>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b bg-muted/10">
            <div class="p-4 border-r">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Avg TTFB</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-bold">120</span>
                    <span class="text-[10px] text-muted-foreground font-medium">ms</span>
                </div>
            </div>
            <div class="p-4 border-r">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Avg FCP</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-bold">0.8</span>
                    <span class="text-[10px] text-muted-foreground font-medium">s</span>
                </div>
            </div>
            <div class="p-4">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Load Time</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-bold text-emerald-600">1.4</span>
                    <span class="text-[10px] text-muted-foreground font-medium">s</span>
                </div>
            </div>
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-1.5 text-xs font-medium">
                    <LucideIconCn Name="activity" Size="14" Class="size-3.5 text-muted-foreground" />
                    Page Load Trend (24h)
                </div>
                <div class="flex items-center gap-1">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[9px] h-4">Mobile</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[9px] h-4">Desktop</BadgeCn>
                </div>
            </div>
            <div class="h-28 w-full">
                @{
                    var chartData = _trendData;
                    var cnt = chartData.Length;
                    var chartW = 400;
                    var chartH = 112;
                    var minLoad = chartData.Min(d => d.Load) - 0.2;
                    var maxLoad = chartData.Max(d => d.Load) + 0.2;
                    var loadRange = maxLoad - minLoad == 0 ? 1.0 : maxLoad - minLoad;
                    double PtX(int i) => cnt <= 1 ? 0 : (double)chartW / (cnt - 1) * i;
                    double PtY(double v) => chartH - (v - minLoad) / loadRange * chartH;

                    var linePts = string.Join(" ", Enumerable.Range(0, cnt).Select(i => FormattableString.Invariant($"{PtX(i):F1},{PtY(chartData[i].Load):F1}")));
                    var fillPts = $"0,{chartH} " + linePts + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="speedGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#10b981" stop-opacity="0.1" />
                            <stop offset="95%" stop-color="#10b981" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@fillPts" fill="url(#speedGradient)" />
                    <polyline points="@linePts" fill="none" stroke="#10b981" stroke-width="2" />
                </svg>
            </div>
        </div>

        <hr class="border-t" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Fastest: US-East (0.8s)</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="mouse-pointer-2" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Interactive in 1.2s</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Full Speed Audit →
            </button>
        </div>
    </div>
</section>

@code {
    private record TrendPoint(string Time, double Load);

    private static readonly TrendPoint[] _trendData =
    [
        new("00:00", 1.2),
        new("04:00", 1.1),
        new("08:00", 1.8),
        new("12:00", 1.4),
        new("16:00", 1.3),
        new("20:00", 1.1),
    ];
}
