@* ============================================================
   Block: monitoring-domain-status
   Title: MonitoringDomainStatus
   Description: Comprehensive domain monitoring block featuring DNS health checks, WHOIS expiry tracking, and global propagation status with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-domain-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted text-foreground border shadow-sm">
                    <LucideIconCn Name="globe" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">Domain Inventory</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Asset Management · 2 Managed Domains
                    </p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs font-semibold">
                <LucideIconCn Name="search" Size="14" Class="size-3.5" /> Domain Lookup
            </ButtonCn>
        </div>

        <div class="divide-y">
            @foreach (var dom in _domains)
            {
                var domain = dom;
                <div class="p-4 space-y-4 hover:bg-muted/30 transition-colors">
                    <div class="flex items-start justify-between">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <h4 class="text-sm font-bold text-foreground">@domain.Name</h4>
                                <div class="@($"size-1.5 rounded-full {(domain.Status == "healthy" ? "bg-emerald-500" : "bg-amber-500")}")"></div>
                            </div>
                            <div class="flex items-center gap-3 text-[10px] font-medium text-muted-foreground uppercase tracking-tight">
                                <span>@domain.Registrar</span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="shield-check" Size="12" Class="@($"size-3 {(domain.Dnssec ? "text-emerald-500" : "text-muted-foreground/30")}")" />
                                    DNSSEC @(domain.Dnssec ? "Active" : "Disabled")
                                </span>
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 text-muted-foreground hover:text-foreground">
                            <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-2.5 rounded-md border bg-background flex items-center gap-3">
                            <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                            <div>
                                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none">
                                    Expires
                                </p>
                                <p class="text-xs font-semibold mt-1">@domain.Expires</p>
                            </div>
                        </div>
                        <div class="p-2.5 rounded-md border bg-background flex items-center gap-3">
                            <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                            <div>
                                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none">
                                    DNS Provider
                                </p>
                                <p class="text-xs font-semibold mt-1">@domain.Dns</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-[10px] font-medium uppercase tracking-wide">
                    Propagation: 99.2% consistent
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                Manage DNS Records →
            </button>
        </div>
    </div>
</section>

@code {
    private record Domain(string Name, string Registrar, string Expires, string Dns, string Status, bool Dnssec);

    private static readonly Domain[] _domains =
    [
        new("shadcn.io", "Namecheap", "2028-04-12", "Cloudflare", "healthy", true),
        new("ui.shadcn.com", "Route 53", "2024-12-05", "AWS DNS", "warning", false),
    ];
}
