@* ============================================================
   Block: monitoring-firewall-block-log
   Title: MonitoringFirewallBlockLog
   Description: Real-time dashboard for monitoring firewall activity, blocked IP volumes, and traffic security trends using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-firewall-block-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="activity" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Edge Firewall</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        WAF Protection · Global Edge
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Filtering
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var idx = System.Array.IndexOf(_stats, s);
                var borderClass = idx != _stats.Length - 1 ? "md:border-r border-b md:border-b-0" : "";
                var maxVal = s.Trend.Max();
                var minVal = s.Trend.Min();
                var range = maxVal - minVal == 0 ? 1.0 : maxVal - minVal;
                var w = 200;
                var h = 40;
                var step = (double)w / (s.Trend.Length - 1);
                var polylinePoints = string.Join(" ", System.Linq.Enumerable.Range(0, s.Trend.Length)
                    .Select(i2 => $"{i2 * step:F1},{h - (s.Trend[i2] - minVal) / range * h:F1}"));
                var polyFillPoints = $"0,{h} " + polylinePoints + $" {w},{h}";
                <div class="@($"p-4 {borderClass}")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@s.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20">
                            Secured
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">
                            @s.DisplayValue
                        </span>
                        <span class="text-muted-foreground text-xs font-medium">@s.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@s.Label</p>

                    <div class="h-10 w-full mt-4">
                        <svg viewBox="0 0 @w @h" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@($"gradient-fire-{idx}")" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="#10b981" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="#10b981" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@polyFillPoints" fill="@($"url(#gradient-fire-{idx})")" />
                            <polyline points="@polylinePoints" fill="none" stroke="#10b981" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Top Source: AS13335 (Cloudflare)
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Security Insights →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string DisplayValue, string Unit, string IconName, double[] Trend);

    private static readonly double[] _baseData =
        [1240, 1380, 1520, 1490, 1850, 2410, 2180, 1600, 1420, 1350];

    private static readonly StatItem[] _stats =
    [
        new("Total Blocked", "24.2", "k", "shield-x",
            [1240, 1380, 1520, 1490, 1850, 2410, 2180, 1600, 1420, 1350]),
        new("Threat Level", "12", "/100", "zap",
            [62.0, 69.0, 76.0, 74.5, 92.5, 120.5, 109.0, 80.0, 71.0, 67.5]),
        new("Active Rules", "142", "cnt", "globe",
            [141.0, 141.0, 142.0, 141.0, 140.0, 141.0, 142.0, 140.0, 141.0, 140.0]),
    ];
}
