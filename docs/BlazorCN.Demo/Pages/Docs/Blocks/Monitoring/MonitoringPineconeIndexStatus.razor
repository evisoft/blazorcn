@* ============================================================
   Block: monitoring-pinecone-index-status
   Title: MonitoringPineconeIndexStatus
   Description: Advanced vector database monitoring dashboard featuring Pinecone index health, vector count tracking, and pod utilization metrics with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-pinecone-index-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10">
                    <LucideIconCn Name="database" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Pinecone Index</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Host: prod-semantic-821.pinecone.io
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Operational</span>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var statItem = stat;
                var isLast = statItem.Label == "Index Dims";
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@statItem.Label</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@statItem.Value</span>
                        @if (!string.IsNullOrEmpty(statItem.Unit))
                        {
                            <span class="text-xs text-muted-foreground font-medium">@statItem.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Chart area *@
        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Vector Growth (7d)</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">p1.x1 pods</BadgeCn>
            </div>

            @* Area chart rendered as pure SVG *@
            <div class="h-32 w-full">
                <svg viewBox="0 0 400 128" preserveAspectRatio="none" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    @{
                        var maxCount = _vectorTrend.Max(t => t.Count);
                        var ptCount = _vectorTrend.Length;
                        var chartH = 120.0;
                        var chartW = 400.0;

                        var pts = _vectorTrend.Select((t, idx) =>
                            (x: idx * chartW / (ptCount - 1), y: chartH - (t.Count / (double)maxCount * chartH))).ToArray();
                        var lineSegments = string.Join(" L ", pts.Select(p => $"{p.x:F1},{p.y:F1}"));
                        var areaPath = $"M {pts[0].x:F1},{pts[0].y:F1} L {lineSegments} L {pts[^1].x:F1},{chartH} L {pts[0].x:F1},{chartH} Z";
                        var strokePath = $"M {pts[0].x:F1},{pts[0].y:F1} L {lineSegments}";
                    }
                    @((MarkupString)$"<path d=\"{areaPath}\" fill=\"#10b981\" fill-opacity=\"0.05\" stroke=\"none\" />")
                    @((MarkupString)$"<path d=\"{strokePath}\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2\" />")
                </svg>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="layers" Size="12" Class="size-3" />
                <span class="font-medium">Namespace: default (82%)</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Manage Index @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string Unit);
    private record VectorPoint(string Time, int Count);

    private static readonly StatItem[] _stats =
    [
        new("Total Vectors", "1.55", "M"),
        new("Pod Fill",      "62",   "%"),
        new("Index Dims",    "1536", ""),
    ];

    private static readonly VectorPoint[] _vectorTrend =
    [
        new("Mon", 1200000),
        new("Tue", 1250000),
        new("Wed", 1400000),
        new("Thu", 1420000),
        new("Fri", 1500000),
        new("Sat", 1520000),
        new("Sun", 1550000),
    ];
}
