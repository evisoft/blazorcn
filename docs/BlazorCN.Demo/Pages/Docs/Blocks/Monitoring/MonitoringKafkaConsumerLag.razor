@* ============================================================
   Block: monitoring-kafka-consumer-lag
   Title: MonitoringKafkaConsumerLag
   Description: Real-time Kafka monitoring dashboard featuring consumer group lag tracking, partition offset analysis, and message throughput metrics with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-kafka-consumer-lag.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="database" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Kafka Consumer Lag</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Group: orders-processor-v2
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-600">Lagging</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="@(s.BorderClass) p-4">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@s.Label</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                        <span class="text-xs text-muted-foreground font-medium">@s.Unit</span>
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-4">Lag by Partition</p>
            <div class="h-48 w-full">
                @{
                    var chartW = 400;
                    var chartH = 192;
                    var maxLag = _lagData.Max(d => d.Lag);
                    var barCount = _lagData.Length;
                    var barW = chartW / barCount;
                    var barPad = (int)(barW * 0.25);
                    var radius = 4;
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    @foreach (var (item, idx) in _lagData.Select((d, i) => (d, i)))
                    {
                        var barHeight = maxLag > 0 ? (double)item.Lag / maxLag * (chartH - 20) : 0;
                        var x = idx * barW + barPad;
                        var w = barW - barPad * 2;
                        var y = chartH - 20 - barHeight;
                        var labelX = idx * barW + barW / 2;
                        @((MarkupString)$"<rect x=\"{x:F1}\" y=\"{y:F1}\" width=\"{w:F1}\" height=\"{barHeight:F1}\" rx=\"{radius}\" ry=\"{radius}\" fill=\"currentColor\" class=\"text-foreground\" />")
                        @((MarkupString)$"<text x=\"{labelX:F1}\" y=\"{chartH - 4}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#888\">{item.Partition}</text>")
                    }
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="zap" Size="12" Class="size-3" />
                <span>Last commit: 2s ago</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Rebalance History →
            </button>
        </div>
    </div>
</section>

@code {
    private record LagPoint(string Partition, int Lag);
    private record StatItem(string Label, string Value, string Unit, string BorderClass);

    private static readonly LagPoint[] _lagData =
    [
        new("P0", 1240),
        new("P1", 850),
        new("P2", 4200),
        new("P3", 980),
        new("P4", 1100),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Total Lag",     "8370", "msgs", "p-4 md:border-r border-b md:border-b-0"),
        new("Throughput",    "12.4", "k/s",  "p-4 md:border-r border-b md:border-b-0"),
        new("Active Nodes",  "5",    "pods",  "p-4"),
    ];
}
