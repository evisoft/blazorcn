@* ============================================================
   Block: monitoring-discord-webhook-status
   Title: MonitoringDiscordWebhookStatus
   Description: Real-time monitoring of Discord webhook connectivity, payload delivery status, and rate limit health using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-discord-webhook-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="gamepad-2" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Discord Webhooks</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Community Alerts · Dev Channel
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Connected
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isLast = s.Label == _stats[_stats.Length - 1].Label;
                var borderClass = isLast ? "" : "md:border-r border-b md:border-b-0";
                var badgeClass = s.Status == "info"
                    ? "h-5 px-1.5 font-normal text-[10px] bg-blue-500/10 text-blue-600 border-blue-500/20"
                    : "h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20";
                var strokeColor = s.Status == "info" ? "#3b82f6" : "#10b981";
                var gradientId = $"gradient-discord-{s.Index}";

                @* build SVG chart *@
                var chartW = 200;
                var chartH = 40;
                var count = s.Trend.Length;
                var maxVal = 100.0;

                @* compute polyline/polygon points *@
                var pts = new System.Text.StringBuilder();
                for (var i = 0; i < count; i++)
                {
                    var px = count <= 1 ? 0.0 : (double)chartW / (count - 1) * i;
                    var py = chartH - s.Trend[i] / maxVal * chartH;
                    if (i > 0) pts.Append(' ');
                    pts.Append($"{px:F1},{py:F1}");
                }
                var linePoints = pts.ToString();
                var fillPoints = $"0,{chartH} {linePoints} {chartW},{chartH}";

                <div class="@Cn.Merge("p-4", borderClass)">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@s.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                            @(s.Status == "info" ? "Buffer" : "Active")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                        <span class="text-muted-foreground text-xs font-medium">@s.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@s.Label</p>

                    <div class="h-10 w-full mt-4">
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradientId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="border-t"></div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Last Hook: 8s ago
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Webhook Management →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(int Index, string Label, double Value, string Unit, string IconName, string Status, double[] Trend);

    private static readonly double[] _baseTrend = [95, 98, 100, 92, 85, 90, 98, 100, 100, 99];

    private static readonly StatItem[] _stats =
    [
        new(0, "Delivery Success", 99.2, "%",   "link",     "healthy", _baseTrend),
        new(1, "Avg. Latency",     245,   "ms",  "activity", "healthy", [200 + (100 - 95) * 5, 200 + (100 - 98) * 5, 200 + (100 - 100) * 5, 200 + (100 - 92) * 5, 200 + (100 - 85) * 5, 200 + (100 - 90) * 5, 200 + (100 - 98) * 5, 200 + (100 - 100) * 5, 200 + (100 - 100) * 5, 200 + (100 - 99) * 5]),
        new(2, "Rate Limit Rem.",  42,    "/50", "shield",   "info",    [95.0/2, 98.0/2, 100.0/2, 92.0/2, 85.0/2, 90.0/2, 98.0/2, 100.0/2, 100.0/2, 99.0/2]),
    ];
}
