@* ============================================================
   Block: monitoring-user-session-count
   Title: MonitoringUserSessionCount
   Description: A real-time user activity dashboard tracking active sessions, concurrent users, and session duration trends.
   Source: original/blocks/monitoring/monitoring-user-session-count.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card shadow-sm">
        <div class="flex items-center justify-between border-b px-6 py-4 bg-blue-500/[0.02]">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-xl bg-blue-500/10 border border-blue-500/20">
                    <LucideIconCn Name="zap" Size="20" Class="size-5 text-blue-600 dark:text-blue-400" />
                </div>
                <div>
                    <h3 class="text-sm font-bold tracking-tight">Real-time Traffic</h3>
                    <p class="mt-0.5 text-muted-foreground text-[11px] font-semibold opacity-80">
                        Live Sessions · All Platforms
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-2 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.4)]"></div>
                <span class="text-[10px] font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
                    Live
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="p-6 group hover:bg-muted/5 transition-colors">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[10px] font-black text-muted-foreground uppercase tracking-widest">@s.Label</span>
                        <LucideIconCn Name="@s.Icon" Size="14" Class="size-3.5 text-muted-foreground/40 group-hover:text-blue-500/50 transition-colors" />
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-black tabular-nums tracking-tighter">@s.ValueDisplay</span>
                        <span class="text-muted-foreground text-[10px] font-bold uppercase">@s.Unit</span>
                    </div>

                    <div class="h-10 w-full mt-6">
                        @{
                            var trend = s.Trend;
                            var tCount = trend.Length;
                            var chartW = 200;
                            var chartH = 40;
                            var minVal = trend.Min();
                            var maxVal = trend.Max();
                            var range = maxVal - minVal;
                            if (range == 0.0) { range = 1.0; }
                            double StepX(int idx) => tCount <= 1 ? 0 : (double)chartW / (tCount - 1) * idx;
                            double PtY(int idx) => chartH - ((trend[idx] - minVal) / range) * (chartH - 4) - 2;
                            var linePoints = string.Join(" ", Enumerable.Range(0, tCount).Select(i => FormattableString.Invariant($"{StepX(i):F1},{PtY(i):F1}")));
                            var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                            var strokeColor = s.Status == "warning" ? "#f59e0b" : "#3b82f6";
                            var fillColor = s.Status == "warning" ? "#f59e0b" : "#3b82f6";
                            var gradientId = $"gradient-sess-{s.Label.Replace(" ", "").Replace(".", "")}";
                        }
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@fillColor" stop-opacity="0.08" />
                                    <stop offset="95%" stop-color="@fillColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradientId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="2" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="px-6 py-3.5 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-6">
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">Peak Today</span>
                    <span class="text-xs font-black">4,812</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">Desktop vs Mobile</span>
                    <span class="text-xs font-black">62% / 38%</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-black uppercase tracking-widest text-blue-600 dark:text-blue-400 hover:tracking-widest transition-all">
                Audience Insights →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string ValueDisplay, string Unit, string Icon, string Status, double[] Trend);

    private static readonly double[] _sessionData =
    [
        1240, 1350, 1420, 1580, 1840, 2100, 2420, 2260, 1980, 2050, 2300, 2540
    ];

    private static readonly StatItem[] _stats =
    [
        new("Active Users", "2,542", "online", "users", "healthy", _sessionData),
        new("Avg. Duration", "12.4", "min", "clock", "healthy",
            [.. _sessionData.Select(d => (d / 200) + 8)]),
        new("Bounce Rate", "34.2", "%", "mouse-pointer-2", "warning",
            [.. _sessionData.Select(d => 40 - (d / 300))]),
    ];
}
