@* ============================================================
   Block: monitoring-worker-queue
   Title: MonitoringWorkerQueue
   Description: A professional worker queue monitoring dashboard for tracking background jobs, worker health, and throughput with real-time sparklines.
   Source: original/blocks/monitoring/monitoring-worker-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-xl border bg-card shadow-sm">
        <div class="flex items-center justify-between border-b px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-indigo-500/10">
                    <LucideIconCn Name="list" Size="20" Class="size-5 text-indigo-600 dark:text-indigo-400" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">Worker Queue</h3>
                    <p class="mt-1 text-muted-foreground text-xs font-medium">
                        Default Processing Pipeline · Cluster-01
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-2 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
                    Processing
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isWarning = s.Status == "warning";
                var badgeClass = isWarning
                    ? "h-5 px-1.5 text-[10px] font-semibold tracking-tight bg-amber-50 text-amber-600 border-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/20"
                    : "h-5 px-1.5 text-[10px] font-semibold tracking-tight bg-emerald-50 text-emerald-600 border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20";
                var strokeColor = isWarning ? "#f59e0b" : "#6366f1";
                var gradId = $"gradient-queue-{s.Index}";

                // Build SVG sparkline
                var pts = s.Trend;
                var n = pts.Length;
                var svgW = 200;
                var svgH = 48;
                var maxV = 0.0;
                var minV = double.MaxValue;
                foreach (var p in pts) { if (p > maxV) maxV = p; if (p < minV) minV = p; }
                var range = maxV - minV;
                if (range == 0) range = 1;
                var padTop = 4;
                var padBottom = 4;
                var usableH = svgH - padTop - padBottom;
                var stepX = n > 1 ? (double)svgW / (n - 1) : svgW;

                var lineParts = new System.Text.StringBuilder();
                for (var i = 0; i < n; i++)
                {
                    var x = i * stepX;
                    var y = padTop + usableH * (1.0 - (pts[i] - minV) / range);
                    lineParts.Append(i == 0 ? FormattableString.Invariant($"M {x:F1},{y:F1}") : FormattableString.Invariant($" L {x:F1},{y:F1}"));
                }
                var lineD = lineParts.ToString();
                var lastX = (n - 1) * stepX;
                var fillD = lineD + FormattableString.Invariant($" L {lastX:F1},{svgH} L 0,{svgH} Z");

                <div class="@s.BorderClass p-5">
                    <div class="flex items-center justify-between mb-3">
                        <LucideIconCn Name="@s.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Outline" Class="@badgeClass">
                            @(isWarning ? "High Load" : "Healthy")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-bold tabular-nums tracking-tighter">@s.DisplayValue</span>
                        <span class="text-muted-foreground text-xs font-semibold">@s.Unit</span>
                    </div>
                    <p class="text-[11px] font-medium text-muted-foreground mt-1 uppercase tracking-wider">@s.Label</p>

                    <div class="h-12 w-full mt-4">
                        <svg viewBox="0 0 @svgW @svgH" preserveAspectRatio="none" class="w-full h-full">
                            @((MarkupString)$"<defs><linearGradient id=\"{gradId}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"5%\" stop-color=\"{strokeColor}\" stop-opacity=\"0.15\"/><stop offset=\"95%\" stop-color=\"{strokeColor}\" stop-opacity=\"0\"/></linearGradient></defs>")
                            @((MarkupString)$"<path d=\"{fillD}\" fill=\"url(#{gradId})\" />")
                            @((MarkupString)$"<path d=\"{lineD}\" fill=\"none\" stroke=\"{strokeColor}\" stroke-width=\"2\" />")
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t border-border" />

        <div class="px-5 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                <span class="text-[11px] text-muted-foreground font-medium">
                    42,891 jobs completed today
                </span>
            </div>
            <button type="button" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
                Manage Queue
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(
        int Index,
        string Label,
        string DisplayValue,
        string Unit,
        string IconName,
        string Status,
        string BorderClass,
        double[] Trend
    );

    private static readonly double[] _baseTrend = [120, 145, 132, 168, 154, 189, 210, 176, 198, 185, 220, 215];

    private static readonly StatItem[] _stats =
    [
        new(0, "Pending Jobs",    "1,248", "jobs",  "list",  "warning", "sm:border-r border-b sm:border-b-0",
            _baseTrend),
        new(1, "Active Workers",  "24",    "units", "zap",   "healthy", "sm:border-r border-b sm:border-b-0",
            [120/8.0+15, 145/8.0+15, 132/8.0+15, 168/8.0+15, 154/8.0+15, 189/8.0+15, 210/8.0+15, 176/8.0+15, 198/8.0+15, 185/8.0+15, 220/8.0+15, 215/8.0+15]),
        new(2, "Avg. Wait Time",  "1.2",   "sec",   "clock", "healthy", "",
            [120/100.0+0.8, 145/100.0+0.8, 132/100.0+0.8, 168/100.0+0.8, 154/100.0+0.8, 189/100.0+0.8, 210/100.0+0.8, 176/100.0+0.8, 198/100.0+0.8, 185/100.0+0.8, 220/100.0+0.8, 215/100.0+0.8]),
    ];
}
