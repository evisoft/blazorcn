@* ============================================================
   Block: monitoring-environment-variables-check
   Title: MonitoringEnvironmentVariablesCheck
   Description: Secure monitoring dashboard for environment variable consistency across deployments featuring status validation, masking, and drift detection using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-environment-variables-check.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="key" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Environment Health</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Config Integrity · Drift Detection</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-6 px-2 text-[10px] font-semibold bg-amber-500/10 text-amber-600 border-amber-500/20">
                1 Drift Detected
            </BadgeCn>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-5">VARIABLE KEY</span>
                <span class="col-span-2 text-center">TYPE</span>
                <span class="col-span-2 text-center">STAGING</span>
                <span class="col-span-3 text-right">PRODUCTION</span>
            </div>
            @foreach (var envVar in _envVars)
            {
                var env = envVar;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-5 flex items-center gap-2">
                        <code class="text-[11px] font-mono font-medium truncate">@env.Key</code>
                        @if (env.Type == "Secret")
                        {
                            <LucideIconCn Name="eye-off" Size="12" Class="size-3 text-muted-foreground/50" />
                        }
                    </div>
                    <div class="col-span-2 text-center">
                        <span class="text-[10px] text-muted-foreground">@env.Type</span>
                    </div>
                    <div class="col-span-2 flex justify-center">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                    </div>
                    <div class="col-span-3 flex justify-end items-center gap-1.5">
                        @if (env.Production == "present")
                        {
                            <span class="text-[10px] font-medium text-emerald-600 uppercase">Synced</span>
                            <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        }
                        else
                        {
                            <span class="text-[10px] font-medium text-red-600 uppercase">Missing</span>
                            <LucideIconCn Name="triangle-alert" Size="14" Class="size-3.5 text-red-500" />
                        }
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">3 Environments</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">SOC2 Compliant</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Manage Secrets →
            </button>
        </div>
    </div>
</section>

@code {
    private record EnvVar(string Key, string Status, string Staging, string Production, string Type);

    private static readonly EnvVar[] _envVars =
    [
        new("DATABASE_URL",        "match", "present", "present", "Secret"),
        new("NEXTAUTH_SECRET",     "match", "present", "present", "Secret"),
        new("STRIPE_API_KEY",      "drift", "present", "missing", "Secret"),
        new("NEXT_PUBLIC_API_URL", "match", "present", "present", "Config"),
        new("REDIS_HOST",          "match", "present", "present", "Config"),
    ];
}
