@* ============================================================
   Block: monitoring-cloudflare-stats
   Title: MonitoringCloudflareStats
   Description: An edge-network monitoring dashboard for Cloudflare, tracking request traffic, cache performance, and security threats in real-time.
   Source: original/blocks/monitoring/monitoring-cloudflare-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card shadow-lg">
        <div class="flex items-center justify-between border-b px-6 py-5 bg-orange-500/[0.03]">
            <div class="flex items-center gap-3.5">
                <div class="flex size-11 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg shadow-orange-500/20">
                    <LucideIconCn Name="cloud" Size="24" Class="size-6" />
                </div>
                <div>
                    <h3 class="text-base font-bold tracking-tight">Cloudflare Edge</h3>
                    <p class="mt-0.5 text-muted-foreground text-xs font-semibold">
                        shadcn.io · Enterprise Plan
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20">
                    <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
                        Protected
                    </span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="p-6 relative group">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[10px] font-black text-muted-foreground uppercase tracking-widest">@s.Label</span>
                        <LucideIconCn Name="@s.IconName" Size="16" Class="size-4 text-muted-foreground/30 group-hover:text-orange-500/50 transition-colors" />
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-black tabular-nums tracking-tighter">@s.DisplayValue</span>
                        <span class="text-muted-foreground text-[10px] font-bold uppercase">@s.Unit</span>
                    </div>

                    <div class="h-10 w-full mt-6">
                        @{
                            var stroke = s.Status == "warning" ? "#f59e0b" : "#f97316";
                            var fill = s.Status == "warning" ? "#f59e0b" : "#f97316";
                            var points = s.Trend;
                            var maxVal = points.Max();
                            var minVal = points.Min();
                            var range = maxVal - minVal == 0 ? 1.0 : maxVal - minVal;
                            var w = 200;
                            var h = 40;
                            var step = (double)w / (points.Length - 1);
                            var polylinePoints = string.Join(" ", System.Linq.Enumerable.Range(0, points.Length)
                                .Select(idx => $"{idx * step:F1},{h - (points[idx] - minVal) / range * h:F1}"));
                            var polyFillPoints = $"0,{h} " + polylinePoints + $" {w},{h}";
                        }
                        <svg viewBox="0 0 @w @h" preserveAspectRatio="none" class="w-full h-full">
                            <polygon points="@polyFillPoints" fill="@fill" fill-opacity="0.03" />
                            <polyline points="@polylinePoints" fill="none" stroke="@stroke" stroke-width="2" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="px-6 py-4 flex items-center justify-between bg-muted/5">
            <div class="flex items-center gap-6">
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">Bandwidth Saved</span>
                    <span class="text-xs font-black text-emerald-600">4.2 TB</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">WAF Events</span>
                    <span class="text-xs font-black">2.1k</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-black uppercase tracking-widest text-orange-600 dark:text-orange-400 hover:tracking-[0.15em] transition-all">
                Analytics Engine →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string DisplayValue, string Unit, string IconName, string Status, double[] Trend);

    private static readonly double[] _cfData =
        [1240, 1450, 1320, 1680, 1540, 1890, 2100, 1760, 1980, 1850, 2200, 2150];

    private static readonly StatItem[] _stats =
    [
        new("Total Requests", "842.5", "k/24h", "globe", "healthy",
            [1240, 1450, 1320, 1680, 1540, 1890, 2100, 1760, 1980, 1850, 2200, 2150]),
        new("Cache Ratio", "88.4", "%", "zap", "healthy",
            [87.48, 87.90, 87.64, 88.36, 88.08, 88.78, 89.20, 88.52, 88.96, 88.70, 89.40, 89.30]),
        new("Threats Blocked", "124", "events", "shield-check", "warning",
            [12, 14, 13, 16, 15, 18, 21, 17, 19, 18, 22, 21]),
    ];
}
