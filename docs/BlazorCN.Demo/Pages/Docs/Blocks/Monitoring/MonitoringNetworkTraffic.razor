@* ============================================================
   Block: monitoring-network-traffic
   Title: MonitoringNetworkTraffic
   Description: Real-time network monitoring block featuring mirrored area charts for inbound/outbound traffic, bandwidth utilization tracking, and packet loss metrics with Recharts and shadcn/ui.
   Source: original/blocks/monitoring/monitoring-network-traffic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-background">
                    <LucideIconCn Name="network" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Network Traffic</h3>
                    <p class="mt-1 text-muted-foreground text-xs font-medium">
                        eth0 · 10 Gbps Public Interface
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-mono border-emerald-500/20 text-emerald-600 bg-emerald-500/5">
                    Operational
                </BadgeCn>
            </div>
        </div>

        <div class="p-4 border-b">
            <div class="grid grid-cols-2 gap-8 mb-6">
                <div>
                    <div class="flex items-center gap-1.5 text-blue-500 mb-1">
                        <LucideIconCn Name="arrow-down-left" Size="14" Class="size-3.5" />
                        <span class="text-[10px] font-bold uppercase tracking-widest">Inbound</span>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-2xl font-bold tabular-nums">54.8</span>
                        <span class="text-xs font-medium text-muted-foreground">Mb/s</span>
                    </div>
                </div>
                <div class="text-right">
                    <div class="flex items-center justify-end gap-1.5 text-indigo-500 mb-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest">Outbound</span>
                        <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5" />
                    </div>
                    <div class="flex items-baseline justify-end gap-1.5">
                        <span class="text-2xl font-bold tabular-nums">152.4</span>
                        <span class="text-xs font-medium text-muted-foreground">Mb/s</span>
                    </div>
                </div>
            </div>

            <div class="h-[200px] w-full">
                @{
                    var data = _mirroredData;
                    var count = data.Length;
                    int chartW = 400;
                    int chartH = 200;
                    // domain: find max absolute value for symmetric axis
                    double maxAbs = 0;
                    foreach (var pt in data)
                    {
                        if (pt.In > maxAbs) maxAbs = pt.In;
                        double absOut = pt.Out < 0 ? -pt.Out : pt.Out;
                        if (absOut > maxAbs) maxAbs = absOut;
                    }
                    if (maxAbs == 0) maxAbs = 1;
                    double midY = chartH / 2.0;
                    double scale = midY / maxAbs;

                    double PtXd(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    // inbound goes up from midline (positive in SVG means down, so subtract)
                    double PtYIn(int i) => midY - data[i].In * scale;
                    // outbound is negative value, goes down from midline
                    double PtYOut(int i) => midY - data[i].Out * scale;

                    var inLinePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{PtXd(i):F1},{PtYIn(i):F1}")));
                    var inFillPoints = FormattableString.Invariant($"0,{midY:F1} ") + inLinePoints + FormattableString.Invariant($" {chartW},{midY:F1}");

                    var outLinePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{PtXd(i):F1},{PtYOut(i):F1}")));
                    var outFillPoints = FormattableString.Invariant($"0,{midY:F1} ") + outLinePoints + FormattableString.Invariant($" {chartW},{midY:F1}");
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="inGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#3b82f6" stop-opacity="0.2" />
                            <stop offset="95%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="outGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#6366f1" stop-opacity="0" />
                            <stop offset="95%" stop-color="#6366f1" stop-opacity="0.2" />
                        </linearGradient>
                    </defs>
                    <line x1="0" y1="@(FormattableString.Invariant($"{midY:F1}"))" x2="@chartW" y2="@(FormattableString.Invariant($"{midY:F1}"))" stroke="currentColor" stroke-opacity="0.1" stroke-width="1" />
                    <polygon points="@inFillPoints" fill="url(#inGradient)" />
                    <polyline points="@inLinePoints" fill="none" stroke="#3b82f6" stroke-width="2" />
                    <polygon points="@outFillPoints" fill="url(#outGradient)" />
                    <polyline points="@outLinePoints" fill="none" stroke="#6366f1" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="grid grid-cols-3 divide-x">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="p-3 text-center">
                    <p class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider mb-1">
                        @s.Label
                    </p>
                    <p class="text-sm font-bold">@s.Value</p>
                </div>
            }
        </div>

        <div class="px-4 py-2 bg-muted/30 border-t flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                Total Egress (Today): 1.4 TB
            </span>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                Network Topology →
            </button>
        </div>
    </div>
</section>

@code {
    private record NetworkPoint(string Time, double In, double Out);
    private record StatItem(string Label, string Value);

    private static readonly NetworkPoint[] _networkData =
    [
        new("14:00", 45, 120),
        new("14:05", 52, 145),
        new("14:10", 85, 210),
        new("14:15", 120, 340),
        new("14:20", 65, 180),
        new("14:25", 48, 135),
        new("14:30", 55, 155),
    ];

    // Mirrored: negate out values so they appear below the midline
    private static readonly NetworkPoint[] _mirroredData =
    [
        new("14:00", 45, -120),
        new("14:05", 52, -145),
        new("14:10", 85, -210),
        new("14:15", 120, -340),
        new("14:20", 65, -180),
        new("14:25", 48, -135),
        new("14:30", 55, -155),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Packets/s", "12.4k"),
        new("Loss", "0.00%"),
        new("Latency", "12ms"),
    ];
}
