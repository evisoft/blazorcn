            </div>
            <div class=""h-32 w-full"">
                @{
                    var svgW = 400;
                    var svgH = 128;
                    var pts = _queueData;
                    var maxDepth = pts.Max(d => d.Depth);
                    var minDepth = pts.Min(d => d.Depth);
                    var range = maxDepth - minDepth;
                    if (range == 0) range = 1;
                    var padTop = 8;
                    var padBottom = 8;
                    var usableH = svgH - padTop - padBottom;
                    var n = pts.Length;
                    var stepX = n > 1 ? (double)svgW / (n - 1) : svgW;

                    // Build path points
                    var lineParts = new System.Text.StringBuilder();
                    for (var i = 0; i < n; i++)
                    {
                        var x = i * stepX;
                        var y = padTop + usableH * (1.0 - (double)(pts[i].Depth - minDepth) / range);
                        lineParts.Append(i == 0 ? $""M {x:F1},{y:F1}"" : $"" L {x:F1},{y:F1}"");
                    }
                    var lineD = lineParts.ToString();

                    // Build fill path (close to bottom)
                    var firstX = 0.0;
                    var firstY = padTop + usableH * (1.0 - (double)(pts[0].Depth - minDepth) / range);
                    var lastX = (n - 1) * stepX;
                    var fillD = lineD + $"" L {lastX:F1},{svgH} L {firstX:F1},{svgH} Z"";
                }
                <svg viewBox=""0 0 @svgW @svgH"" preserveAspectRatio=""none"" class=""w-full h-full"">
                    @((MarkupString)$""<path d=\""{fillD}\"" fill=\""currentColor\"" fill-opacity=\""0.05\"" class=\""text-foreground\"" />"")
                    @((MarkupString)$""<path d=\""{lineD}\"" fill=\""none\"" stroke=\""currentColor\"" stroke-width=\""2\"" class=\""text-foreground\"" />"")
                </svg>
            </div>
