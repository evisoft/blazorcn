@code {
    private record P99DataPoint(int P50, int P95, int P99);
    private record ChartPaths(string Line, string Fill);

    private record StatItem(string Label, int Value, string Unit, string IconName, string Status, string DataKey);

    private static readonly P99DataPoint[] _p99Data =
    [
        new(12, 45, 124),
        new(14, 48, 132),
        new(13, 52, 128),
        new(15, 68, 245),
        new(12, 55, 184),
        new(14, 49, 156),
        new(16, 51, 142),
        new(15, 47, 138),
    ];

    private static readonly StatItem[] _stats =
    [
        new(""P50 (Median)"", 15, ""ms"", ""timer"", ""healthy"", ""p50""),
        new(""P95 Latency"", 47, ""ms"", ""activity"", ""healthy"", ""p95""),
        new(""P99 (Tail)"", 138, ""ms"", ""zap"", ""warning"", ""p99""),
    ];

    private ChartPaths BuildMiniChartPoints(string dataKey)
    {
        const int chartW = 100;
        const int chartH = 40;
        var vals = _p99Data.Select(d => dataKey switch
        {
            ""p50"" => d.P50,
            ""p95"" => d.P95,
            _ => d.P99
        }).ToArray();

        var minVal = vals.Min();
        var maxVal = vals.Max();
        var range = maxVal - minVal == 0 ? 1 : maxVal - minVal;
        int count = vals.Length;

        double sx(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
        double sy(int v) => chartH - (double)(v - minVal) / range * (chartH - 4) - 2;

        var linePoints = string.Join("" "", Enumerable.Range(0, count).Select(i => $""{sx(i):F1},{sy(vals[i]):F1}""));
        var fillPoints = $""0,{chartH} "" + linePoints + $"" {chartW},{chartH}"";

        return new ChartPaths(linePoints, fillPoints);
    }
}
";

