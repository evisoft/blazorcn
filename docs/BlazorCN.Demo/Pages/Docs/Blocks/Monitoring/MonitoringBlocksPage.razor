            ""check-circle"",
            ""healthy"",
            [new(76), new(79), new(82), new(86), new(92), new(89), new(85), new(82), new(81), new(79)]
        ),
    ];

    private const int SvgW = 200;
    private const int SvgH = 40;

    private static string BuildLinePoints(TrendPoint[] trend)
    {
        int count = trend.Length;
        double minVal = trend.Min(d => d.Value);
        double maxVal = trend.Max(d => d.Value);
        double range = (maxVal - minVal) == 0 ? 1.0 : maxVal - minVal;
        return string.Join("" "", Enumerable.Range(0, count).Select(n =>
        {
            double x = count <= 1 ? 0 : (double)SvgW / (count - 1) * n;
            double y = SvgH - (trend[n].Value - minVal) / range * SvgH;
            return $""{x:F1},{y:F1}"";
        }));
    }

    private static string BuildFillPoints(TrendPoint[] trend)
    {
        var line = BuildLinePoints(trend);
        return $""0,{SvgH} "" + line + $"" {SvgW},{SvgH}"";
    }
}";

