            </div>
        </div>

        <div class=""grid grid-cols-1 sm:grid-cols-3"">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isWarning = s.Status == ""warning"";
                var badgeClass = isWarning
                    ? ""h-5 px-1.5 text-[10px] font-semibold tracking-tight bg-amber-50 text-amber-600 border-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/20""
                    : ""h-5 px-1.5 text-[10px] font-semibold tracking-tight bg-emerald-50 text-emerald-600 border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20"";
                var strokeColor = isWarning ? ""#f59e0b"" : ""#6366f1"";
                var gradId = $""gradient-queue-{s.Index}"";

                // Build SVG sparkline
                var pts = s.Trend;
                var n = pts.Length;
                var svgW = 200;
                var svgH = 48;
                var maxV = 0.0;
                var minV = double.MaxValue;
                foreach (var p in pts) { if (p > maxV) maxV = p; if (p < minV) minV = p; }
                var range = maxV - minV;
                if (range == 0) range = 1;
                var padTop = 4;
                var padBottom = 4;
                var usableH = svgH - padTop - padBottom;
                var stepX = n > 1 ? (double)svgW / (n - 1) : svgW;

                var lineParts = new System.Text.StringBuilder();
                for (var i = 0; i < n; i++)
                {
                    var x = i * stepX;
                    var y = padTop + usableH * (1.0 - (pts[i] - minV) / range);
                    lineParts.Append(i == 0 ? $""M {x:F1},{y:F1}"" : $"" L {x:F1},{y:F1}"");
                }
                var lineD = lineParts.ToString();
                var lastX = (n - 1) * stepX;
                var fillD = lineD + $"" L {lastX:F1},{svgH} L 0,{svgH} Z"";

                <div class=""@s.BorderClass p-5"">
                    <div class=""flex items-center justify-between mb-3"">
                        <LucideIconCn Name=""@s.IconName"" Size=""16"" Class=""size-4 text-muted-foreground"" />
                        <BadgeCn Variant=""BadgeVariant.Outline"" Class=""@badgeClass"">
                            @(isWarning ? ""High Load"" : ""Healthy"")
                        </BadgeCn>
                    </div>

                    <div class=""flex items-baseline gap-1"">
                        <span class=""text-2xl font-bold tabular-nums tracking-tighter"">@s.DisplayValue</span>
                        <span class=""text-muted-foreground text-xs font-semibold"">@s.Unit</span>
                    </div>
                    <p class=""text-[11px] font-medium text-muted-foreground mt-1 uppercase tracking-wider"">@s.Label</p>

                    <div class=""h-12 w-full mt-4"">
                        <svg viewBox=""0 0 @svgW @svgH"" preserveAspectRatio=""none"" class=""w-full h-full"">
                            @((MarkupString)$""<defs><linearGradient id=\""{gradId}\"" x1=\""0\"" y1=\""0\"" x2=\""0\"" y2=\""1\""><stop offset=\""5%\"" stop-color=\""{strokeColor}\"" stop-opacity=\""0.15\""/><stop offset=\""95%\"" stop-color=\""{strokeColor}\"" stop-opacity=\""0\""/></linearGradient></defs>"")
                            @((MarkupString)$""<path d=\""{fillD}\"" fill=\""url(#{gradId})\"" />"")
                            @((MarkupString)$""<path d=\""{lineD}\"" fill=\""none\"" stroke=\""{strokeColor}\"" stroke-width=\""2\"" />"")
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class=""border-t border-border"" />

        <div class=""px-5 py-3 bg-muted/20 flex items-center justify-between"">
            <div class=""flex items-center gap-2"">
                <LucideIconCn Name=""check-circle-2"" Size=""14"" Class=""size-3.5 text-emerald-500"" />
                <span class=""text-[11px] text-muted-foreground font-medium"">
                    42,891 jobs completed today
                </span>
            </div>
            <button type=""button"" class=""text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"">
                Manage Queue
            </button>
        </div>
    </div>
</section>

