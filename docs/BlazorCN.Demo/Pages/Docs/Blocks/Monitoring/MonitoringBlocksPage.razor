            [new(6), new(9), new(7), new(12), new(10), new(14), new(16), new(12), new(11), new(15), new(17), new(15)]),
    ];

    private static string BuildPolylinePoints(TrendPoint[] data, int width, int height)
    {
        if (data.Length == 0) return """";
        var minVal = data.Min(d => d.Value);
        var maxVal = data.Max(d => d.Value);
        var range = maxVal - minVal == 0 ? 1 : maxVal - minVal;
        var count = data.Length;
        var parts = new System.Text.StringBuilder();
        for (int i = 0; i < count; i++)
        {
            double x = count <= 1 ? 0 : (double)width / (count - 1) * i;
            double y = height - (double)(data[i].Value - minVal) / range * (height - 4) - 2;
            if (i > 0) parts.Append(' ');
            parts.Append($""{x:F1},{y:F1}"");
        }
        return parts.ToString();
    }

    private static string BuildFillPoints(TrendPoint[] data, int width, int height)
    {
        if (data.Length == 0) return """";
        var line = BuildPolylinePoints(data, width, height);
        return $""0,{height} {line} {width},{height}"";
    }
}
";

