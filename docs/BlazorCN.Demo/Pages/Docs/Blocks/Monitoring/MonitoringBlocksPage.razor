@code {
    private record StatItem(string Label, int Value, string Unit, string IconName, string Status, int[] Trend);

    private record PolylineData(string LinePoints, string FillPoints);

    private record StatWithIndex(StatItem Stat, int Index);

    private static readonly int[] _baseData = [4, 2, 5, 8, 3, 12, 6, 4, 2, 5];

    private static readonly StatItem[] _stats =
    [
        new(""Role Changes"",  12, ""cnt"", ""users"",     ""healthy"", _baseData),
        new(""Admins Added"",   2, ""new"", ""user-plus"",  ""warning"", [1, 2, 2, 2, 0, 0, 0, 1, 2, 2]),
        new(""Access Revoked"", 8, ""cnt"", ""user-minus"", ""healthy"", [2, 1, 2, 4, 1, 6, 3, 2, 1, 2]),
    ];

    private IEnumerable<StatWithIndex> _statsWithIndex =>
        _stats.Select((s, idx) => new StatWithIndex(s, idx));

    private static string StatCellClass(int i) =>
        i != _stats.Length - 1
            ? ""p-4 md:border-r border-b md:border-b-0""
            : ""p-4"";

    private static string BadgeClass(bool isWarning) =>
        Cn.Merge(
            ""h-5 px-1.5 font-normal text-[10px]"",
            isWarning
                ? ""bg-amber-500/10 text-amber-600 border-amber-500/20""
                : ""bg-emerald-500/10 text-emerald-600 border-emerald-500/20"");

    private static string BuildGradientMarkup(string id, string color)
    {
        var escapedId = System.Net.WebUtility.HtmlEncode(id);
        var escapedColor = System.Net.WebUtility.HtmlEncode(color);
        return $""<linearGradient id=\""{escapedId}\"" x1=\""0\"" y1=\""0\"" x2=\""0\"" y2=\""1\"">"" +
               $""<stop offset=\""5%\"" stop-color=\""{escapedColor}\"" stop-opacity=\""0.1\""/>"" +
               $""<stop offset=\""95%\"" stop-color=\""{escapedColor}\"" stop-opacity=\""0\""/>"" +
               ""</linearGradient>"";
    }

    private static PolylineData BuildPolylinePoints(int[] trend)
    {
        if (trend.Length == 0)
            return new PolylineData("""", """");

        var maxVal = trend.Max();
        if (maxVal == 0) maxVal = 1;

        var count = trend.Length;
        var linePoints = new System.Text.StringBuilder();
        var fillPoints = new System.Text.StringBuilder();

        for (var idx = 0; idx < count; idx++)
        {
            var x = (double)idx / (count - 1) * 100.0;
            var y = 40.0 - ((double)trend[idx] / maxVal * 36.0);
            if (idx > 0)
            {
                linePoints.Append(' ');
                fillPoints.Append(' ');
            }
            linePoints.Append($""{x:F1},{y:F1}"");
            fillPoints.Append($""{x:F1},{y:F1}"");
        }

        fillPoints.Append("" 100,40 0,40"");

        return new PolylineData(linePoints.ToString(), fillPoints.ToString());
    }
}";

