    private static string BuildAreaChart(int[] trend, string gradientId)
    {
        if (trend == null || trend.Length == 0)
            return string.Empty;

        const int W = 200;
        const int H = 40;

        var min = trend.Min();
        var max = trend.Max();
        var range = max == min ? 1 : (max - min);

        double XPos(int i) => (double)i / (trend.Length - 1) * W;
        double YPos(int v) => H - ((double)(v - min) / range) * (H - 4) - 2;

        var points = string.Join("" "", trend.Select((v, i) => $""{XPos(i):F1},{YPos(v):F1}""));
        var areaPoints = $""0,{H} "" + points + $"" {W},{H}"";

        return $@""<svg viewBox=""""0 0 {W} {H}"""" xmlns=""""http://www.w3.org/2000/svg"""" width=""""100%"""" height=""""100%"""" preserveAspectRatio=""""none"""">
  <defs>
