                        <div class=""flex-1 min-w-0"">
                            <p class=""text-xs font-mono truncate text-foreground"">@log.Message</p>
                        </div>
                        <span class=""text-[10px] text-muted-foreground whitespace-nowrap"">@log.Timestamp</span>
                    </div>
                }
            </div>
        </div>

        <div class=""px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t"">
            <span class=""text-[10px] text-muted-foreground uppercase font-semibold tracking-wider"">
