      <stop offset=""""95%"""" stop-color=""""#10b981"""" stop-opacity=""""0"""" />
    </linearGradient>
  </defs>
  <polygon points=""""{areaPoints}"""" fill=""""url(#{gradientId})"""" />
  <polyline points=""""{points}"""" fill=""""none"""" stroke=""""#10b981"""" stroke-width=""""1.5"""" stroke-linejoin=""""round"""" stroke-linecap=""""round"""" />
</svg>"";
