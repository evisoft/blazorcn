        new(""PII Detected"",    12, ""user-x"",       """",              ""p-4 md:border-r border-b md:border-b-0""),
        new(""Toxicity Block"",   4, ""alert-circle"",  """",              ""p-4 md:border-r border-b md:border-b-0""),
        new(""Injection Try"",   45, ""shield-alert"",  ""text-red-500"",  ""p-4""),
    ];

    // Violation trend data: Mon-Sun counts: 2,5,12,45,18,8,10
    // Chart is 280 wide x 128 tall; min=2, max=45 mapped to y=[8,120]
    private static readonly (string Time, int Count)[] _trend =
    [
        (""Mon"",  2),
        (""Tue"",  5),
        (""Wed"", 12),
        (""Thu"", 45),
        (""Fri"", 18),
        (""Sat"",  8),
        (""Sun"", 10),
    ];

    private static string _linePath = BuildLinePath();
    private static string _areaPath = BuildAreaPath();

    private static string BuildLinePath()
    {
        const int w = 280;
        const int h = 128;
        const int padTop = 8;
        const int padBottom = 8;
        int minVal = 2;
        int maxVal = 45;
        int n = _trend.Length;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double x = i * (w - 1.0) / (n - 1);
            double y = padTop + (1.0 - (double)(_trend[i].Count - minVal) / (maxVal - minVal)) * (h - padTop - padBottom);
            sb.Append(i == 0 ? $""M{x:F1},{y:F1}"" : $"" L{x:F1},{y:F1}"");
        }
        return sb.ToString();
    }

    private static string BuildAreaPath()
    {
        const int w = 280;
        const int h = 128;
        const int padTop = 8;
        const int padBottom = 8;
        int minVal = 2;
        int maxVal = 45;
        int n = _trend.Length;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double x = i * (w - 1.0) / (n - 1);
            double y = padTop + (1.0 - (double)(_trend[i].Count - minVal) / (maxVal - minVal)) * (h - padTop - padBottom);
            sb.Append(i == 0 ? $""M{x:F1},{y:F1}"" : $"" L{x:F1},{y:F1}"");
        }
        // close area to bottom
        double lastX = (n - 1) * (w - 1.0) / (n - 1);
        double bottom = h - padBottom;
        sb.Append($"" L{lastX:F1},{bottom:F1} L0,{bottom:F1} Z"");
        return sb.ToString();
    }
}";

