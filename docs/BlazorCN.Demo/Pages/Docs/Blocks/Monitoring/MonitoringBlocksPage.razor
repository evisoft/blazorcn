    private record StatItem(string Label, string DisplayValue, string Unit, string IconName, string Status, double[] Trend);

    private static readonly double[] _buildData = [45, 42, 58, 48, 52, 41, 39, 44, 46, 43, 40, 38];

    private static readonly double[] _latencyData = [162.5, 155, 195, 170, 180, 152.5, 147.5, 160, 165, 157.5, 150, 145];

    private static readonly double[] _bundleData = [1.2, 1.22, 1.24, 1.26, 1.28, 1.30, 1.32, 1.34, 1.36, 1.38, 1.40, 1.42];

    private static readonly StatItem[] _stats =
    [
        new(""Avg. Build Time"",  ""42"",   ""sec"", ""timer"",  ""healthy"", _buildData),
        new(""Func. Latency"",    ""124"",  ""ms"",  ""cpu"",    ""healthy"", _latencyData),
        new(""Bundle Size"",      ""1.42"", ""MB"",  ""box"",    ""warning"", _bundleData),
    ];

    private static string RenderSparkline(double[] values, string color)
    {
        if (values.Length == 0) return string.Empty;

        double min = double.MaxValue;
        double max = double.MinValue;
        foreach (var v in values)
        {
            if (v < min) min = v;
            if (v > max) max = v;
        }
        double range = max - min;
        if (range == 0) range = 1;

        double svgWidth = 200;
        double svgHeight = 40;
        double stepX = svgWidth / (values.Length - 1);

        var points = new System.Text.StringBuilder();
        for (int i = 0; i < values.Length; i++)
        {
            double x = i * stepX;
            double y = svgHeight - ((values[i] - min) / range) * (svgHeight * 0.8) - svgHeight * 0.1;
            if (i == 0)
                points.Append($""M{x:F1},{y:F1}"");
            else
                points.Append($"" L{x:F1},{y:F1}"");
        }

        // Build fill path (close to bottom)
        var fillPoints = new System.Text.StringBuilder();
        fillPoints.Append(points.ToString());
        fillPoints.Append($"" L{svgWidth:F1},{svgHeight:F1} L0,{svgHeight:F1} Z"");

        // Escape for attribute string (no quotes inside attribute — use single-quote SVG)
        string stroke = color;
        string escapedStroke = stroke.Replace(""\"""", ""&quot;"");
        string fillOpacityVal = ""0.03"";

        return $""<svg viewBox='0 0 {svgWidth} {svgHeight}' preserveAspectRatio='none' width='100%' height='100%' xmlns='http://www.w3.org/2000/svg'>"" +
               $""<path d='{fillPoints}' fill='{escapedStroke}' fill-opacity='{fillOpacityVal}' stroke='none'/>"" +
               $""<path d='{points}' fill='none' stroke='{escapedStroke}' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>"" +
               $""</svg>"";
    }
}";

