@* ============================================================
   Block: monitoring-memory-usage
   Title: MonitoringMemoryUsage
   Description: Comprehensive memory monitoring block featuring stacked area charts for heap and resident set size (RSS), memory leak detection, and cache efficiency metrics with Recharts and shadcn/ui.
   Source: original/blocks/monitoring/monitoring-memory-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-blue-500/10 text-blue-600">
                    <LucideIconCn Name="layers" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Memory Statistics</h3>
                    <p class="mt-1 text-muted-foreground text-xs font-medium">
                        8.4 GB Used of 16 GB Total
                    </p>
                </div>
            </div>
            <div class="text-right">
                <span class="text-xs font-bold tabular-nums text-blue-600">52.5%</span>
            </div>
        </div>

        <div class="p-4 border-b">
            <div class="mb-6 grid grid-cols-2 gap-8">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">
                        Heap Used
                    </p>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-2xl font-bold tabular-nums">1.64</span>
                        <span class="text-xs font-medium text-muted-foreground">GB</span>
                    </div>
                </div>
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">
                        RSS Total
                    </p>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-2xl font-bold tabular-nums text-blue-600">2.92</span>
                        <span class="text-xs font-medium text-muted-foreground">GB</span>
                    </div>
                </div>
            </div>

            <div class="h-[160px] w-full">
                @{
                    var data = _memoryHistory;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 160;
                    var maxVal = 5.0;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double HeapY(int i) => chartH - data[i].Heap / maxVal * chartH;
                    double RssY(int i) => chartH - data[i].Rss / maxVal * chartH;
                    var heapLine = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{HeapY(i):F1}"));
                    var heapFill = $"0,{chartH} " + heapLine + $" {chartW},{chartH}";
                    var rssLine = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{RssY(i):F1}"));
                    var rssFill = $"0,{chartH} " + rssLine + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="heapGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#3b82f6" stop-opacity="0.2" />
                            <stop offset="95%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="rssGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#3b82f6" stop-opacity="0.1" />
                            <stop offset="95%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@rssFill" fill="url(#rssGradient)" />
                    <polyline points="@rssLine" fill="none" stroke="#3b82f6" stroke-width="1" stroke-dasharray="4 4" />
                    <polygon points="@heapFill" fill="url(#heapGradient)" />
                    <polyline points="@heapLine" fill="none" stroke="#3b82f6" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                Cache Performance
            </p>
            <div class="grid grid-cols-2 gap-4">
                <div class="p-3 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-2 mb-2">
                        <LucideIconCn Name="database" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-[11px] font-medium">Memory Cache</span>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-lg font-bold tabular-nums">92</span>
                        <span class="text-[10px] font-medium text-muted-foreground">% Hit</span>
                    </div>
                    <ProgressCn Value="92" Class="h-1 mt-2" aria-label="Progress" />
                </div>
                <div class="p-3 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-2 mb-2">
                        <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-[11px] font-medium">Buffer Swap</span>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-lg font-bold tabular-nums">0.4</span>
                        <span class="text-[10px] font-medium text-muted-foreground">MB/s</span>
                    </div>
                    <ProgressCn Value="5" Class="h-1 mt-2" aria-label="Progress" />
                </div>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase">
                    GC Healthy · last run 4s ago
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                Heap Snapshot →
            </button>
        </div>
    </div>
</section>

@code {
    private record MemoryPoint(string Time, double Heap, double Rss);

    private static readonly MemoryPoint[] _memoryHistory =
    [
        new("10:00", 1.2, 2.4),
        new("10:05", 1.5, 2.8),
        new("10:10", 1.3, 2.6),
        new("10:15", 2.1, 3.4),
        new("10:20", 2.8, 4.2),
        new("10:25", 1.4, 2.7),
        new("10:30", 1.6, 2.9),
    ];
}
