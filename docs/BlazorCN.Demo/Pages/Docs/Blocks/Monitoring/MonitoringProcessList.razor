@* ============================================================
   Block: monitoring-process-list
   Title: MonitoringProcessList
   Description: Real-time system process monitor featuring CPU and memory utilization per process with status indicators and search functionality using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-process-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="terminal" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Process Monitor</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        5 Active Processes · System Root
                    </p>
                </div>
            </div>
            <div class="relative group">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 -translate-y-1/2 size-3.5 text-muted-foreground" />
                <input
                    type="text"
                    aria-label="Search processes"
                    placeholder="Search..."
                    class="h-8 w-32 rounded-md border bg-muted/50 pl-8 pr-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring transition-all" />
            </div>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-1">PID</span>
                <span class="col-span-5">PROCESS</span>
                <span class="col-span-2 text-right">CPU</span>
                <span class="col-span-2 text-right">MEM</span>
                <span class="col-span-2 text-right">STATUS</span>
            </div>
            @foreach (var proc in _processes)
            {
                var p = proc;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <span class="col-span-1 text-[11px] font-mono text-muted-foreground">@p.Pid</span>
                    <div class="col-span-5 flex flex-col">
                        <span class="text-xs font-medium truncate">@p.Name</span>
                        <span class="text-[10px] text-muted-foreground">@p.User</span>
                    </div>
                    <div class="col-span-2 text-right">
                        <span class="text-xs font-mono">@($"{p.Cpu:F1}")%</span>
                    </div>
                    <div class="col-span-2 text-right">
                        <span class="text-xs font-mono">@($"{p.Mem:F1}")MB</span>
                    </div>
                    <div class="col-span-2 flex justify-end">
                        <div class="flex items-center gap-1.5">
                            <div class="@(p.Status == "warning" ? "size-1.5 rounded-full bg-amber-500" : "size-1.5 rounded-full bg-emerald-500")"></div>
                            <span class="@(p.Status == "warning" ? "text-[10px] font-medium uppercase text-amber-600" : "text-[10px] font-medium uppercase text-emerald-600")">
                                @p.Status
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="activity" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">System Load: 0.84</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="command" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Threads: 124</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View All Processes →
            </button>
        </div>
    </div>
</section>

@code {
    private record ProcessItem(int Pid, string Name, string User, double Cpu, double Mem, string Status);

    private static readonly ProcessItem[] _processes =
    [
        new(48291, "node (next-server)", "root",     12.4,  420.5, "running"),
        new(48312, "python3 (worker)",   "app",      45.2, 1280.2, "warning"),
        new(48102, "postgres",           "postgres",  2.1,  850.4, "running"),
        new(48055, "nginx",              "www-data",  0.8,   45.2, "running"),
        new(48992, "redis-server",       "redis",     1.5,  124.8, "running"),
    ];
}
