@* ============================================================
   Block: monitoring-audit-log-viewer
   Title: MonitoringAuditLogViewer
   Description: Compact monitoring block for visualizing system audit logs, user action frequencies, and security event trends using shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-audit-log-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="activity" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">System Audit Log</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Enterprise Compliance · All Actors
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Capturing
                </span>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var idx = Array.IndexOf(_stats, stat);
                var isLast = idx == _stats.Length - 1;
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20">
                            Active
                        </BadgeCn>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        <span class="text-muted-foreground text-xs font-medium">@stat.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@stat.Label</p>

                    @* Inline SVG area chart *@
                    <div class="h-10 w-full mt-4">
                        @((MarkupString)BuildAreaChart(stat.Trend, $"gradient-audit-{idx}"))
                    </div>
                </div>
            }
        </div>

        <hr class="border-t border-border" />

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Retention Policy: 365 Days
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Full Audit History @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, int Value, string Unit, string Icon, int[] Trend);

    private static readonly int[] _baseTrend = [120, 145, 132, 168, 190, 155, 142, 138, 150, 162];

    private static readonly StatItem[] _stats =
    [
        new("Total Actions", 4820, "act", "history",
            _baseTrend),
        new("Admin Events",   42,  "cnt", "shield",
            [17, 19, 18, 21, 24, 20, 19, 18, 20, 21]),
        new("Search Volume", 1240, "req", "search",
            [240, 290, 264, 336, 380, 310, 284, 276, 300, 324]),
    ];

    private static string BuildAreaChart(int[] trend, string gradientId)
    {
        if (trend == null || trend.Length == 0)
            return string.Empty;

        const int W = 200;
        const int H = 40;

        var min = trend.Min();
        var max = trend.Max();
        var range = max == min ? 1 : (max - min);

        double XPos(int i) => (double)i / (trend.Length - 1) * W;
        double YPos(int v) => H - ((double)(v - min) / range) * (H - 4) - 2;

        var points = string.Join(" ", trend.Select((v, i) => FormattableString.Invariant($"{XPos(i):F1},{YPos(v):F1}")));
        var areaPoints = $"0,{H} " + points + $" {W},{H}";

        return $@"<svg viewBox=""0 0 {W} {H}"" xmlns=""http://www.w3.org/2000/svg"" width=""100%"" height=""100%"" preserveAspectRatio=""none"">
  <defs>
    <linearGradient id=""{gradientId}"" x1=""0"" y1=""0"" x2=""0"" y2=""1"">
      <stop offset=""5%"" stop-color=""#10b981"" stop-opacity=""0.1"" />
      <stop offset=""95%"" stop-color=""#10b981"" stop-opacity=""0"" />
    </linearGradient>
  </defs>
  <polygon points=""{areaPoints}"" fill=""url(#{gradientId})"" />
  <polyline points=""{points}"" fill=""none"" stroke=""#10b981"" stroke-width=""1.5"" stroke-linejoin=""round"" stroke-linecap=""round"" />
</svg>";
    }
}
