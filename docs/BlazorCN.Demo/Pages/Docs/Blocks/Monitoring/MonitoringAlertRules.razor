@* ============================================================
   Block: monitoring-alert-rules
   Title: MonitoringAlertRules
   Description: Operational alerting configuration block featuring rule definitions, threshold management, and current firing state with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-alert-rules.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted text-foreground">
                    <LucideIconCn Name="bell" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">Alerting Rules</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Infrastructure · Global Policies
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs font-semibold">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" /> New Rule
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-3 py-2 bg-muted/10">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 gap-1.5 text-xs text-muted-foreground font-medium">
                <LucideIconCn Name="filter" Size="12" Class="size-3" />
                Filter
            </ButtonCn>
            <div class="h-3 w-px bg-border"></div>
            <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">
                @_rules.Length Rules Active
            </p>
        </div>

        <div class="divide-y">
            @foreach (var rule in _rules)
            {
                var r = rule;
                var severityClass = _severityStyles.TryGetValue(r.Severity, out var sev) ? sev : "";
                var statusDot = _statusColors.TryGetValue(r.Status, out var sc) ? sc : "";
                var pulseClass = r.Status == "firing" ? "animate-pulse" : "";
                var disabledClass = !r.Enabled ? "opacity-60" : "";
                <div class="@Cn.Merge("group flex items-center justify-between p-4 hover:bg-muted/30 transition-colors", disabledClass)">
                    <div class="flex items-start gap-4 flex-1">
                        <div class="@Cn.Merge("mt-1 size-2 rounded-full shrink-0", statusDot, pulseClass)"></div>
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <h4 class="text-sm font-bold text-foreground leading-none">@r.Name</h4>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-[9px] h-4 font-bold uppercase tracking-tight", severityClass)">
                                    @r.Severity
                                </BadgeCn>
                            </div>
                            <p class="font-mono text-[11px] text-muted-foreground">@r.Condition</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="flex flex-col items-end gap-1.5 mr-2">
                            <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest">
                                @(r.Enabled ? "Enabled" : "Paused")
                            </span>
                            <div class="scale-75 origin-right">
                                <SwitchCn Checked="@r.Enabled" />
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 text-muted-foreground hover:text-foreground">
                            <LucideIconCn Name="more-vertical" Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="settings-2" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium uppercase tracking-wide">
                    Syncing with Prometheus
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                Manage Destinations →
            </button>
        </div>
    </div>
</section>

@code {
    private record AlertRule(string Id, string Name, string Condition, string Severity, string Status, bool Enabled);

    private static readonly AlertRule[] _rules =
    [
        new("RULE-01", "High API Error Rate", "error_rate > 1% for 5m", "critical", "firing", true),
        new("RULE-02", "Slow DB Queries", "p95_latency > 500ms for 10m", "warning", "normal", true),
        new("RULE-03", "Low Disk Space", "disk_free < 10% on root", "warning", "pending", true),
        new("RULE-04", "Node Down", "up == 0", "critical", "normal", false),
    ];

    private static readonly Dictionary<string, string> _severityStyles = new()
    {
        ["critical"] = "text-red-600 bg-red-500/10 border-red-500/20",
        ["warning"] = "text-amber-600 bg-amber-500/10 border-amber-500/20",
        ["info"] = "text-blue-600 bg-blue-500/10 border-blue-500/20",
    };

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["firing"] = "bg-red-500",
        ["pending"] = "bg-amber-500",
        ["normal"] = "bg-emerald-500",
    };
}
