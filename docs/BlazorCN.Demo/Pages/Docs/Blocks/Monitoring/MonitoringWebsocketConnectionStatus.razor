@* ============================================================
   Block: monitoring-websocket-connection-status
   Title: MonitoringWebsocketConnectionStatus
   Description: Real-time WebSocket monitoring dashboard featuring connection lifecycle tracking, message throughput, and latency analysis with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-websocket-connection-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="link" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">WebSocket Status</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Real-time socket monitoring
                    </p>
                </div>
            </div>
            <BadgeCn Class="bg-emerald-500/10 text-emerald-600 hover:bg-emerald-500/10 border-emerald-500/20 px-2 py-0 h-5 font-medium">
                CONNECTED
            </BadgeCn>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="@Cn.Merge("p-4", s.IsLast ? "" : "md:border-r border-b md:border-b-0")">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@s.IconName" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@s.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                        @if (!string.IsNullOrEmpty(s.Unit))
                        {
                            <span class="text-xs text-muted-foreground">@s.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Throughput (msg/s)</span>
                <div class="flex gap-4">
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-blue-500"></div>
                        <span class="text-[10px] text-muted-foreground">IN</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-amber-500"></div>
                        <span class="text-[10px] text-muted-foreground">OUT</span>
                    </div>
                </div>
            </div>
            <div class="h-32 w-full">
                @{
                    var inData = _throughputData.Select(d => d.In).ToArray();
                    var outData = _throughputData.Select(d => d.Out).ToArray();
                    var allVals = inData.Concat(outData).ToArray();
                    var maxV = allVals.Max();
                    var minV = allVals.Min();
                    var rangeV = maxV - minV == 0 ? 1 : maxV - minV;
                    var svgW = 400;
                    var svgH = 128;
                    var stepX = (double)svgW / (_throughputData.Length - 1);

                    var inPoints = string.Join(" ", System.Linq.Enumerable.Range(0, inData.Length)
                        .Select(idx => FormattableString.Invariant($"{idx * stepX:F1},{svgH - (inData[idx] - minV) / (double)rangeV * svgH:F1}")));
                    var outPoints = string.Join(" ", System.Linq.Enumerable.Range(0, outData.Length)
                        .Select(idx => FormattableString.Invariant($"{idx * stepX:F1},{svgH - (outData[idx] - minV) / (double)rangeV * svgH:F1}")));
                }
                <svg viewBox="0 0 @svgW @svgH" preserveAspectRatio="none" class="w-full h-full">
                    <polyline points="@inPoints" fill="none" stroke="#3b82f6" stroke-width="2" />
                    <polyline points="@outPoints" fill="none" stroke="#f59e0b" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] text-muted-foreground">Uptime: 14d 2h 12m</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Socket Inspector →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, int Value, string IconName, string Unit, bool IsLast);
    private record ThroughputPoint(int In, int Out);

    private static readonly StatItem[] _stats =
    [
        new("Active Channels", 12, "activity", "", false),
        new("Avg Latency", 42, "zap", "ms", false),
        new("Msgs / Sec", 850, "arrow-down-up", "", true),
    ];

    private static readonly ThroughputPoint[] _throughputData =
    [
        new(12, 8), new(18, 12), new(15, 10),
        new(25, 15), new(20, 18), new(30, 22),
        new(35, 25), new(28, 20), new(40, 30),
    ];
}
