@* ============================================================
   Block: monitoring-lighthouse-audit-history
   Title: MonitoringLighthouseAuditHistory
   Description: Historical monitoring dashboard for synthetic performance audits featuring Lighthouse scores, regression detection, and audit deep-dives using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-lighthouse-audit-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-background">
                    <LucideIconCn Name="landmark" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Lighthouse History</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Synthetic Audits · mobile-profile
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-6 px-2 text-[10px] font-bold bg-emerald-500/10 text-emerald-600 border-emerald-500/20">
                    Optimal Score
                </BadgeCn>
            </div>
        </div>

        @* Score Grid *@
        <div class="grid grid-cols-4 divide-x border-b">
            <div class="p-3 text-center">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5 mx-auto mb-1 text-orange-500" />
                <div class="text-[9px] uppercase font-bold text-muted-foreground">Performance</div>
                <div class="text-sm font-bold mt-0.5">98</div>
            </div>
            <div class="p-3 text-center">
                <LucideIconCn Name="accessibility" Size="14" Class="size-3.5 mx-auto mb-1 text-blue-500" />
                <div class="text-[9px] uppercase font-bold text-muted-foreground">Accessibility</div>
                <div class="text-sm font-bold mt-0.5">100</div>
            </div>
            <div class="p-3 text-center">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 mx-auto mb-1 text-emerald-500" />
                <div class="text-[9px] uppercase font-bold text-muted-foreground">Best Practices</div>
                <div class="text-sm font-bold mt-0.5">95</div>
            </div>
            <div class="p-3 text-center">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 mx-auto mb-1 text-purple-500" />
                <div class="text-[9px] uppercase font-bold text-muted-foreground">SEO</div>
                <div class="text-sm font-bold mt-0.5">100</div>
            </div>
        </div>

        @* Audit Table *@
        <div class="divide-y">
            @* Column Headers *@
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-3">DATE</span>
                <span class="col-span-2 text-center">PERF</span>
                <span class="col-span-2 text-center">ACC</span>
                <span class="col-span-2 text-center">SEO</span>
                <span class="col-span-3 text-right">TREND</span>
            </div>

            @* Audit Rows *@
            @foreach (var audit in _auditHistory)
            {
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-3">
                        <span class="text-xs font-medium">@audit.Date</span>
                    </div>
                    <div class="col-span-2 text-center">
                        <span class="@($"text-[11px] font-mono {(audit.Perf >= 90 ? "text-emerald-600" : "text-amber-600")}")">@audit.Perf</span>
                    </div>
                    <div class="col-span-2 text-center">
                        <span class="text-[11px] font-mono">@audit.Acc</span>
                    </div>
                    <div class="col-span-2 text-center">
                        <span class="text-[11px] font-mono">@audit.Seo</span>
                    </div>
                    <div class="col-span-3 flex justify-end">
                        @if (audit.Trend == "up")
                        {
                            <div class="flex items-center gap-1 text-[10px] text-emerald-600 font-bold uppercase">
                                <LucideIconCn Name="arrow-up" Size="10" Class="size-2.5" /> Improved
                            </div>
                        }
                        else if (audit.Trend == "down")
                        {
                            <div class="flex items-center gap-1 text-[10px] text-red-600 font-bold uppercase">
                                <LucideIconCn Name="arrow-down" Size="10" Class="size-2.5" /> Regression
                            </div>
                        }
                        else
                        {
                            <div class="text-[10px] text-muted-foreground font-bold uppercase">Stable</div>
                        }
                    </div>
                </div>
            }
        </div>

        <hr class="border-t border-border" />

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="history" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">30-day Retention</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Full Audit Details @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record AuditEntry(string Date, int Perf, int Acc, int Bp, int Seo, string Trend);

    private static readonly AuditEntry[] _auditHistory =
    [
        new("Oct 12", 98, 100, 95, 100, "up"),
        new("Oct 10", 92,  98, 92, 100, "down"),
        new("Oct 05", 95,  98, 92,  92, "stable"),
    ];
}
