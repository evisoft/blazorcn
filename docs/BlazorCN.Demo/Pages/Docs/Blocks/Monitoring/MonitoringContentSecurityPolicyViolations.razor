@* ============================================================
   Block: monitoring-content-security-policy-violations
   Title: MonitoringContentSecurityPolicyViolations
   Description: Real-time security monitoring dashboard for Content Security Policy violations featuring threat analysis, source tracking, and policy validation using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-content-security-policy-violations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="lock" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">CSP Violations</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Security Policy Monitoring · Real-time
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-6 px-2 text-[10px] font-bold bg-red-500/10 text-red-600 border-red-500/20">
                1 High Threat
            </BadgeCn>
        </div>

        <div class="grid grid-cols-3 divide-x border-b bg-muted/10">
            <div class="p-3 text-center">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Total Events</div>
                <div class="text-lg font-semibold">219</div>
            </div>
            <div class="p-3 text-center">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Unique Sources</div>
                <div class="text-lg font-semibold">4</div>
            </div>
            <div class="p-3 text-center">
                <div class="text-[10px] font-bold uppercase text-muted-foreground mb-1">Policy Status</div>
                <div class="text-[11px] font-bold text-emerald-600 uppercase mt-1.5 flex items-center justify-center gap-1">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3" /> Enforced
                </div>
            </div>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-4">DIRECTIVE</span>
                <span class="col-span-4">BLOCKED URI</span>
                <span class="col-span-2 text-center">COUNT</span>
                <span class="col-span-2 text-right">RISK</span>
            </div>
            @foreach (var v in _violations)
            {
                var violation = v;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-4 flex flex-col">
                        <code class="text-[11px] font-mono font-medium">@violation.Directive</code>
                        <span class="text-[9px] text-muted-foreground">Source: @violation.Source</span>
                    </div>
                    <div class="col-span-4 pr-2">
                        <code class="text-[10px] font-mono text-muted-foreground truncate block" title="@violation.Blocked">
                            @violation.Blocked
                        </code>
                    </div>
                    <div class="col-span-2 text-center">
                        <span class="text-xs font-mono font-medium">@violation.Count</span>
                    </div>
                    <div class="col-span-2 flex justify-end">
                        <div class="@Cn.Merge("size-1.5 rounded-full", violation.Severity == "high" ? "bg-red-500 animate-pulse" : violation.Severity == "medium" ? "bg-amber-500" : "bg-blue-500")"></div>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="history" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Updates every 30s</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Global Reporting</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Refine Policy →
            </button>
        </div>
    </div>
</section>

@code {
    private record Violation(string Directive, string Blocked, string Source, string Severity, int Count);

    private static readonly Violation[] _violations =
    [
        new("script-src", "https://evil.com/malicious.js", "/checkout", "high", 12),
        new("img-src", "https://untrusted-cdn.net/logo.png", "/blog/post-1", "low", 45),
        new("connect-src", "wss://unknown-tracker.io", "/dashboard", "medium", 8),
        new("style-src", "inline-style", "/settings", "low", 154),
    ];
}
