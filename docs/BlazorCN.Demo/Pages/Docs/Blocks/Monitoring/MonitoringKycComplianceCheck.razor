@* ============================================================
   Block: monitoring-kyc-compliance-check
   Title: MonitoringKycComplianceCheck
   Description: Real-time monitoring of Know Your Customer (KYC) compliance status, user verification throughput, and compliance health using shadcn/ui.
   Source: original/blocks/monitoring/monitoring-kyc-compliance-check.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="user" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">KYC Compliance</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        AML/KYC · Global Operations
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Compliant
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isLast = s.Label == _stats[_stats.Length - 1].Label;
                var isWarning = s.Status == "warning";
                var strokeColor = isWarning ? "#f59e0b" : "#10b981";
                var gradientId = $"gradient-kyc-{s.Label.Replace(" ", "")}";
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@s.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary"
                                 Class="@(isWarning
                                     ? "h-5 px-1.5 font-normal text-[10px] bg-amber-500/10 text-amber-600 border-amber-500/20"
                                     : "h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20")">
                            @(isWarning ? "Attention" : "Verified")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.ValueDisplay</span>
                        <span class="text-muted-foreground text-xs font-medium">@s.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@s.Label</p>

                    <div class="h-10 w-full mt-4">
                        @{
                            var trend = s.Trend;
                            var count = trend.Length;
                            var chartW = 200;
                            var chartH = 40;
                            var minVal = trend.Min();
                            var maxVal = trend.Max();
                            var range = maxVal - minVal;
                            if (range == 0.0) { range = 1.0; }
                            double StepX(int idx) => count <= 1 ? 0 : (double)chartW / (count - 1) * idx;
                            double PtY(int idx) => chartH - ((trend[idx] - minVal) / range) * (chartH - 4) - 2;
                            var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{PtY(i):F1}"));
                            var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                            var gradOpacity = isWarning ? "#f59e0b" : "#10b981";
                        }
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@gradOpacity" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@gradOpacity" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradientId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                SLA: 24h Verification Goal
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Compliance Review →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string ValueDisplay, string Unit, string Icon, string Status, double[] Trend);

    private static readonly double[] _baseTrend = [96, 97, 98, 97.5, 98.2, 98.8, 99.1, 99.4, 99.2, 99.5];

    private static readonly StatItem[] _stats =
    [
        new("User Compliance", "99.5", "%", "shield-check", "healthy", _baseTrend),
        new("Pending Checks", "142", "cnt", "file-check", "info", [44, 44.25, 44.5, 44.375, 44.55, 44.7, 44.775, 44.85, 44.8, 44.875]),
        new("AML Hits", "3", "act", "gavel", "warning", [1, 2, 3, 2.5, 3.2, 3.8, 4.1, 4.4, 4.2, 4.5]),
    ];
}
