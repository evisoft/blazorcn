@* ============================================================
   Block: monitoring-tpu-usage-monitor
   Title: MonitoringTpuUsageMonitor
   Description: Specialized Google Cloud TPU monitoring dashboard featuring tensor core utilization, HBM usage, and MXU execution analytics with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-tpu-usage-monitor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-blue-500/10">
                    <LucideIconCn Name="cpu" Size="16" Class="size-4 text-blue-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">TPU Usage</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Google Cloud TPU v3-8
                    </p>
                </div>
            </div>
            <BadgeCn Class="bg-blue-500/10 text-blue-600 hover:bg-blue-500/10 border-blue-500/20 px-2 py-0 h-5 font-medium">
                PROCESSING
            </BadgeCn>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="@Cn.Merge("p-4", s.BorderClass)">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@s.Icon" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@s.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                        <span class="text-xs text-muted-foreground font-medium">@s.Unit</span>
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Tensor Core Utilization</span>
                <div class="flex gap-4">
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-blue-500"></div>
                        <span class="text-[10px] text-muted-foreground">MXU</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-muted-foreground"></div>
                        <span class="text-[10px] text-muted-foreground">HBM</span>
                    </div>
                </div>
            </div>
            <div class="h-32 w-full">
                @{
                    var data = _tpuData;
                    var count = data.Length;
                    const int chartW = 400;
                    const int chartH = 128;
                    const double maxVal = 100.0;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double MxuY(int i) => chartH - data[i].Mxu / maxVal * chartH;
                    double HbmY(int i) => chartH - data[i].Hbm / maxVal * chartH;
                    var mxuLine = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{MxuY(i):F1}"));
                    var mxuFill = $"0,{chartH} " + mxuLine + $" {chartW},{chartH}";
                    var hbmLine = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{HbmY(i):F1}"));
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="tpuMxuGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#3b82f6" stop-opacity="0.05" />
                            <stop offset="95%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@mxuFill" fill="url(#tpuMxuGradient)" />
                    <polyline points="@mxuLine" fill="none" stroke="#3b82f6" stroke-width="2" />
                    <polyline points="@hbmLine" fill="none" stroke="#888" stroke-width="1" stroke-dasharray="3 3" />
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium">Cluster: us-central1-b</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Cloud Monitor →
            </button>
        </div>
    </div>
</section>

@code {
    private record TpuPoint(string Time, double Mxu, double Hbm);
    private record StatItem(string Label, string Value, string Unit, string Icon, string BorderClass);

    private static readonly TpuPoint[] _tpuData =
    [
        new("0s",  75, 42),
        new("10s", 82, 45),
        new("20s", 95, 78),
        new("30s", 88, 82),
        new("40s", 45, 35),
        new("50s", 40, 30),
        new("60s", 94, 85),
    ];

    private static readonly StatItem[] _stats =
    [
        new("MXU Load",   "88",   "%",    "zap",      "md:border-r border-b md:border-b-0"),
        new("HBM Memory", "24.5", "GB",   "layers",   "md:border-r border-b md:border-b-0"),
        new("Throughput", "1240", "img/s","activity", ""),
    ];
}
