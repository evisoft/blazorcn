@* ============================================================
   Block: monitoring-airflow-dag-status
   Title: MonitoringAirflowDagStatus
   Description: Advanced workflow monitoring dashboard featuring Airflow DAG execution history, task duration analysis, and pipeline health scores with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-airflow-dag-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="play" Size="16" Class="size-4 text-foreground fill-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Airflow DAGs</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Production Workflow Health
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-emerald-600 border-emerald-500/20 text-[10px]">
                    92% SUCCESS RATE
                </BadgeCn>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var isLast = stat == _stats[_stats.Length - 1];
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@stat.Label</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                    </div>
                </div>
            }
        </div>

        @* Chart area — Recent Run Durations *@
        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Recent Run Durations (min)</span>
                <div class="flex gap-2">
                    @foreach (var run in _runHistory)
                    {
                        <div class="@($"size-2 rounded-full {(run.Status == "success" ? "bg-emerald-500" : "bg-red-500")}")"></div>
                    }
                </div>
            </div>
            @* Bar chart rendered as pure HTML/CSS — heights scaled to max duration *@
            <div class="h-32 w-full flex items-end gap-1">
                @foreach (var run in _runHistory)
                {
                    var heightPct = (int)Math.Round((double)run.Duration / _maxDuration * 100);
                    <div class="flex-1 flex flex-col items-center gap-1">
                        <div class="w-full bg-foreground rounded-t-[2px]" style="@($"height:{heightPct}%")"></div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                <span>Next run: in 12 mins</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Open Airflow UI @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, int Value);
    private record RunItem(int Run, string Status, int Duration);

    private static readonly StatItem[] _stats =
    [
        new("Active DAGs", 42),
        new("Tasks Running", 128),
        new("Failures (24h)", 3),
    ];

    private static readonly RunItem[] _runHistory =
    [
        new(1, "success", 45),
        new(2, "success", 42),
        new(3, "failed",  12),
        new(4, "success", 48),
        new(5, "success", 50),
        new(6, "success", 46),
        new(7, "success", 44),
    ];

    private static readonly int _maxDuration = 50;
}
