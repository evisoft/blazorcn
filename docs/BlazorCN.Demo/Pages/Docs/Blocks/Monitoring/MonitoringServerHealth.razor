@* ============================================================
   Block: monitoring-server-health
   Title: MonitoringServerHealth
   Description: Real-time server monitoring dashboard featuring CPU, memory, and disk utilization metrics with live sparklines using shadcn/ui, Recharts, and Framer Motion.
   Source: original/blocks/monitoring/monitoring-server-health.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="server" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Production Cluster</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        US-East-1 · Primary Fleet
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Operational
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isLast = s.Label == _stats[_stats.Length - 1].Label;
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@s.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary"
                                 Class="@($"h-5 px-1.5 font-normal text-[10px] {(s.Status == "warning" ? "bg-amber-500/10 text-amber-600 border-amber-500/20" : "bg-emerald-500/10 text-emerald-600 border-emerald-500/20")}")">
                            @(s.Status == "warning" ? "Caution" : "Stable")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.ValueDisplay</span>
                        <span class="text-muted-foreground text-xs font-medium">@s.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@s.Label</p>

                    <div class="h-10 w-full mt-4">
                        @{
                            var trend = s.Trend;
                            var count = trend.Length;
                            var chartW = 200;
                            var chartH = 40;
                            var minVal = trend.Min();
                            var maxVal = trend.Max();
                            var range = maxVal - minVal;
                            if (range == 0) { range = 1; }
                            double StepX(int idx) => count <= 1 ? 0 : (double)chartW / (count - 1) * idx;
                            double PtY(int idx) => chartH - ((double)(trend[idx] - minVal) / range) * (chartH - 4) - 2;
                            var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{StepX(i):F1},{PtY(i):F1}")));
                            var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                            var strokeColor = s.Status == "warning" ? "#f59e0b" : "#10b981";
                            var stopColor = s.Status == "warning" ? "#f59e0b" : "#10b981";
                            var gradientId = $"gradient-{s.Label.Replace(" ", "")}";
                        }
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@stopColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@stopColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradientId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Up Since: Oct 12, 2023
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Node Details →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string ValueDisplay, string Unit, string Icon, string Status, int[] Trend);

    private static readonly StatItem[] _stats =
    [
        new("CPU Usage", "68", "%", "activity", "healthy", [45, 52, 48, 61, 55, 67, 72, 65, 58, 63, 70, 68]),
        new("Memory", "8.2", "GB", "layers", "warning", [55, 62, 58, 71, 65, 77, 82, 75, 68, 73, 80, 78]),
        new("Disk I/O", "124", "MB/s", "hard-drive", "healthy", [40, 47, 43, 56, 50, 62, 67, 60, 53, 58, 65, 63]),
    ];
}
