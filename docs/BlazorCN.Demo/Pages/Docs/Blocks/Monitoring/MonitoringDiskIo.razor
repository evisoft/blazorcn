@* ============================================================
   Block: monitoring-disk-io
   Title: MonitoringDiskIo
   Description: Real-time storage performance monitoring block featuring dual-axis charts for read/write throughput, IOPS tracking, and disk latency metrics with Recharts and shadcn/ui.
   Source: original/blocks/monitoring/monitoring-disk-io.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="hard-drive" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Disk I/O Throughput</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        /dev/nvme0n1p3 · Primary SSD
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono text-[10px] bg-emerald-500/5 text-emerald-600 border-emerald-500/20">
                Healthy
            </BadgeCn>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="p-3 rounded-md border bg-muted/20">
                    <div class="flex items-center gap-2 text-blue-600 mb-1">
                        <LucideIconCn Name="arrow-down" Size="14" Class="size-3.5" />
                        <span class="text-[10px] font-bold uppercase tracking-widest">Read</span>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-2xl font-bold tabular-nums">110.4</span>
                        <span class="text-xs font-medium text-muted-foreground">MB/s</span>
                    </div>
                </div>
                <div class="p-3 rounded-md border bg-muted/20">
                    <div class="flex items-center gap-2 text-emerald-600 mb-1">
                        <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                        <span class="text-[10px] font-bold uppercase tracking-widest">Write</span>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-2xl font-bold tabular-nums">48.2</span>
                        <span class="text-xs font-medium text-muted-foreground">MB/s</span>
                    </div>
                </div>
            </div>

            <div class="h-[180px] w-full">
                @{
                    var chartW = 400;
                    var chartH = 180;
                    var count = _ioHistory.Length;
                    double maxVal = 160.0;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double ReadY(int i) => chartH - (double)_ioHistory[i].Read / maxVal * chartH;
                    double WriteY(int i) => chartH - (double)_ioHistory[i].Write / maxVal * chartH;
                    var readPoints = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{ReadY(i):F1}"));
                    var writePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{WriteY(i):F1}"));
                    var readFill = $"0,{chartH} " + readPoints + $" {chartW},{chartH}";
                    var writeFill = $"0,{chartH} " + writePoints + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="diskReadGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#3b82f6" stop-opacity="0.15" />
                            <stop offset="95%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="diskWriteGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#10b981" stop-opacity="0.15" />
                            <stop offset="95%" stop-color="#10b981" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@readFill" fill="url(#diskReadGradient)" />
                    <polygon points="@writeFill" fill="url(#diskWriteGradient)" />
                    <polyline points="@readPoints" fill="none" stroke="#3b82f6" stroke-width="2" />
                    <polyline points="@writePoints" fill="none" stroke="#10b981" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="grid grid-cols-3 border-t divide-x">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="p-3 text-center">
                    <p class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider mb-1">
                        @s.Label
                    </p>
                    <p class="text-sm font-bold text-foreground">@s.Value</p>
                </div>
            }
        </div>

        <div class="px-4 py-2 bg-muted/30 border-t flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                Total Data Written: 4.2 TB
            </span>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                Performance Settings →
            </button>
        </div>
    </div>
</section>

@code {
    private record IoPoint(string Time, int Read, int Write);
    private record StatItem(string Label, string Value);

    private static readonly IoPoint[] _ioHistory =
    [
        new("12:00", 45, 12),
        new("12:05", 52, 18),
        new("12:10", 142, 45),
        new("12:15", 85, 32),
        new("12:20", 64, 24),
        new("12:25", 98, 56),
        new("12:30", 110, 48),
    ];

    private static readonly StatItem[] _stats =
    [
        new("IOPS", "2.4k"),
        new("Latency", "0.8ms"),
        new("Utilization", "14%"),
    ];
}
