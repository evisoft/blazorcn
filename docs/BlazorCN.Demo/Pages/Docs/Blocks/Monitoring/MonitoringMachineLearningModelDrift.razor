@* ============================================================
   Block: monitoring-machine-learning-model-drift
   Title: MonitoringMachineLearningModelDrift
   Description: Advanced ML monitoring dashboard featuring feature drift tracking, label distribution shifts, and model performance decay with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-machine-learning-model-drift.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-purple-500/10">
                    <LucideIconCn Name="brain-circuit" Size="16" Class="size-4 text-purple-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Model Drift</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Feature &amp; Prediction Stability
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-600">Retrain Recommended</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isLast = s.Label == "Feature Shift";
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@s.Label</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                        @if (!string.IsNullOrEmpty(s.Unit))
                        {
                            <span class="text-xs text-muted-foreground font-medium">@s.Unit</span>
                        }
                    </div>
                    <div class="mt-2">
                        <div class="h-1 w-full bg-muted rounded-full overflow-hidden">
                            <div class="@(s.IsWarning ? "h-full bg-amber-500" : "h-full bg-emerald-500")"
                                 style="@(FormattableString.Invariant($"width:{s.Value * 100}%"))"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">PSI (Population Stability Index) Trend</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] h-5 font-normal">Threshold: 0.2</BadgeCn>
            </div>
            <div class="h-32 w-full">
                @{
                    var data = _driftTrend;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 128;
                    var maxVal = 0.5;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double PtY(int i) => chartH - data[i].Score / maxVal * chartH;
                    var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{StepX(i):F1},{PtY(i):F1}")));
                    var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="driftGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#9333ea" stop-opacity="0.15" />
                            <stop offset="95%" stop-color="#9333ea" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@fillPoints" fill="url(#driftGradient)" />
                    <polyline points="@linePoints" fill="none" stroke="#9333ea" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-amber-500" />
                <span class="font-medium">User_Region shift detected</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Feature Breakdown →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, double Value, string Unit, bool IsWarning);
    private record DriftPoint(string Time, double Score);

    private static readonly StatItem[] _stats =
    [
        new("Drift Score", 0.42, "", true),
        new("Accuracy Decay", 4.5, "%", true),
        new("Feature Shift", 12, "cols", false),
    ];

    private static readonly DriftPoint[] _driftTrend =
    [
        new("Day 1", 0.02),
        new("Day 2", 0.05),
        new("Day 3", 0.08),
        new("Day 4", 0.25),
        new("Day 5", 0.32),
        new("Day 6", 0.45),
        new("Day 7", 0.42),
        new("Day 8", 0.38),
    ];
}
