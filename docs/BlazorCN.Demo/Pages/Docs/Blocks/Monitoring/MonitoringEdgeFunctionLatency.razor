@* ============================================================
   Block: monitoring-edge-function-latency
   Title: MonitoringEdgeFunctionLatency
   Description: Real-time global latency monitoring dashboard for edge functions featuring regional performance tracking and p99 distribution using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-edge-function-latency.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-blue-500/10 text-blue-600">
                    <LucideIconCn Name="signal" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Edge Latency</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Global Distribution · 152 PoPs</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <div class="text-[10px] font-semibold uppercase text-muted-foreground">Global P99</div>
                    <div class="text-sm font-bold text-emerald-600">42ms</div>
                </div>
            </div>
        </div>

        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-5">REGION</span>
                <span class="col-span-5 text-center">LATENCY DISTRIBUTION</span>
                <span class="col-span-2 text-right">TIME</span>
            </div>
            @foreach (var rgn in _regions)
            {
                var region = rgn;
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-5 flex items-center gap-2">
                        <LucideIconCn Name="map" Size="14" Class="size-3.5 text-muted-foreground" />
                        <div class="flex flex-col">
                            <span class="text-xs font-medium">@region.Name</span>
                            <span class="text-[9px] text-muted-foreground font-mono uppercase">@region.Code</span>
                        </div>
                    </div>
                    <div class="col-span-5 px-2">
                        <div class="w-full h-1.5 bg-muted rounded-full overflow-hidden flex">
                            <div class="@($"h-full {(region.Status == "warning" ? "bg-amber-500" : "bg-emerald-500")}")"
                                 style="@($"width:{Math.Min(region.Latency, 100)}%")">
                            </div>
                        </div>
                    </div>
                    <div class="col-span-2 text-right">
                        <span class="@($"text-xs font-mono font-medium {(region.Status == "warning" ? "text-amber-600" : "text-foreground")}")">
                            @(region.Latency)ms
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t"></div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Global Availability: 99.99%</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="history" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Real-time updates</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Edge Topology Map →
            </button>
        </div>
    </div>
</section>

@code {
    private record RegionItem(string Name, string Code, int Latency, string Status);

    private static readonly RegionItem[] _regions =
    [
        new("North America", "us-east",     12,  "healthy"),
        new("Europe",        "eu-west",     45,  "healthy"),
        new("Asia Pacific",  "ap-southeast", 128, "warning"),
        new("South America", "sa-east",     85,  "healthy"),
    ];
}
