@* ============================================================
   Block: monitoring-gpu-utilization
   Title: MonitoringGpuUtilization
   Description: Professional GPU monitoring dashboard featuring compute utilization, VRAM usage, and power consumption tracking with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-gpu-utilization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10">
                    <LucideIconCn Name="cpu" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">GPU Utilization</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        NVIDIA A100-SXM4-40GB
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Active Training</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="@Cn.Merge("p-4", s.BorderClass)">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@s.Icon" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@s.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                        <span class="text-xs text-muted-foreground font-medium">@s.Unit</span>
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Performance Trend (1m)</span>
                <div class="flex gap-4">
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        <span class="text-[10px] text-muted-foreground">Compute</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-blue-500"></div>
                        <span class="text-[10px] text-muted-foreground">VRAM</span>
                    </div>
                </div>
            </div>
            <div class="h-32 w-full">
                @{
                    var data = _gpuData;
                    var count = data.Length;
                    const int chartW = 400;
                    const int chartH = 128;
                    const double maxVal = 100.0;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double ComputeY(int i) => chartH - data[i].Compute / maxVal * chartH;
                    double VramY(int i) => chartH - data[i].Vram / maxVal * chartH;
                    var computeLine = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{StepX(i):F1},{ComputeY(i):F1}")));
                    var computeFill = $"0,{chartH} " + computeLine + $" {chartW},{chartH}";
                    var vramLine = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{StepX(i):F1},{VramY(i):F1}")));
                    var vramFill = $"0,{chartH} " + vramLine + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="gpuComputeGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#10b981" stop-opacity="0.05" />
                            <stop offset="95%" stop-color="#10b981" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="gpuVramGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#3b82f6" stop-opacity="0.05" />
                            <stop offset="95%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@computeFill" fill="url(#gpuComputeGradient)" />
                    <polyline points="@computeLine" fill="none" stroke="#10b981" stroke-width="2" />
                    <polygon points="@vramFill" fill="url(#gpuVramGradient)" />
                    <polyline points="@vramLine" fill="none" stroke="#3b82f6" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium">Power: 245W / 400W</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                SMI Dashboard →
            </button>
        </div>
    </div>
</section>

@code {
    private record GpuPoint(string Time, double Compute, double Vram);
    private record StatItem(string Label, string Value, string Unit, string Icon, string BorderClass);

    private static readonly GpuPoint[] _gpuData =
    [
        new("0s",  45, 12),
        new("10s", 85, 45),
        new("20s", 98, 78),
        new("30s", 95, 82),
        new("40s", 42, 35),
        new("50s", 38, 30),
        new("60s", 92, 85),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Compute Load", "92",   "%",  "gauge",       "md:border-r border-b md:border-b-0"),
        new("VRAM Used",    "32.4", "GB", "activity",    "md:border-r border-b md:border-b-0"),
        new("Temp",         "68",   "°C", "thermometer", ""),
    ];
}
