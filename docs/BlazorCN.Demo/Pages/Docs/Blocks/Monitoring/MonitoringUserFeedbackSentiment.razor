@* ============================================================
   Block: monitoring-user-feedback-sentiment
   Title: MonitoringUserFeedbackSentiment
   Description: Real-time sentiment analysis dashboard for monitoring user feedback trends and customer satisfaction metrics with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-user-feedback-sentiment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="message-square" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Customer Sentiment</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Product Feedback · All Regions</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    High Satisfaction
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var i = idx;
                var borderClass = i != _stats.Length - 1 ? "md:border-r border-b md:border-b-0" : "";
                var badgeClass = stat.Status == "warning"
                    ? "h-5 px-1.5 font-normal text-[10px] bg-amber-500/10 text-amber-600 border-amber-500/20"
                    : stat.Status == "info"
                        ? "h-5 px-1.5 font-normal text-[10px] bg-blue-500/10 text-blue-600 border-blue-500/20"
                        : "h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20";
                var badgeLabel = stat.Status == "warning" ? "Needs Attention" : stat.Status == "info" ? "Stable" : "Excellent";
                var strokeColor = stat.Status == "warning" ? "#f59e0b" : stat.Status == "info" ? "#3b82f6" : "#10b981";
                var gradientId = $"gradient-sent-{i}";

                var trendData = stat.Trend;
                var tCount = trendData.Length;
                const int chartW = 200;
                const int chartH = 40;
                var tMin = trendData.Min();
                var tMax = trendData.Max();
                var tRange = tMax - tMin == 0 ? 1.0 : tMax - tMin;
                var pts = string.Join(" ", Enumerable.Range(0, tCount).Select(j =>
                {
                    double x = tCount <= 1 ? 0 : (double)chartW / (tCount - 1) * j;
                    double y = chartH - (trendData[j] - tMin) / tRange * chartH;
                    return $"{x:F1},{y:F1}";
                }));
                var fillPts = $"0,{chartH} {pts} {chartW},{chartH}";

                <div class="@($"p-4 {borderClass}")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">@badgeLabel</BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        <span class="text-muted-foreground text-xs font-medium">@stat.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@stat.Label</p>

                    <div class="h-10 w-full mt-4">
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPts" fill="@($"url(#{gradientId})")" />
                            <polyline points="@pts" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t border-border" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Latest: @("\"")The new UI is incredibly fast!@("\"")
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Analysis Dashboard →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, int Value, string Unit, string IconName, string Status, double[] Trend);

    private static readonly StatItem[] _stats =
    [
        new("Positivity Score", 92, "%", "smile", "healthy",
            [85, 82, 78, 75, 72, 78, 84, 88, 92, 94]),
        new("Neutral Feed", 124, "cnt", "meh", "info",
            [52.5, 51, 49, 47.5, 46, 49, 52, 54, 56, 57]),
        new("Recent Alerts", 4, "err", "frown", "warning",
            [2, 2, 3, 5, 2, 3, 4, 3, 2, 4]),
    ];
}
