@* ============================================================
   Block: monitoring-aws-cost-monitor
   Title: MonitoringAwsCostMonitor
   Description: A financial monitoring dashboard for AWS infrastructure, tracking real-time spending, cost projections, and service-level budget distribution.
   Source: original/blocks/monitoring/monitoring-aws-cost-monitor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card shadow-sm">

        @* Header *@
        <div class="flex items-center justify-between border-b px-6 py-5 bg-emerald-500/[0.02]">
            <div class="flex items-center gap-3.5">
                <div class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
                    <LucideIconCn Name="credit-card" Size="24" Class="size-6" />
                </div>
                <div>
                    <h3 class="text-base font-bold tracking-tight">AWS Cost Explorer</h3>
                    <p class="mt-0.5 text-muted-foreground text-xs font-semibold">
                        Production Account · Monthly Overview
                    </p>
                </div>
            </div>
            <div class="flex flex-col items-end gap-1">
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-black uppercase tracking-widest bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/20">
                    +12.4% vs Last Month
                </BadgeCn>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x border-b">
            @foreach (var stat in _stats)
            {
                <div class="p-6 hover:bg-muted/5 transition-colors">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[10px] font-black text-muted-foreground uppercase tracking-widest">@stat.Label</span>
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-muted-foreground/40" />
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-xs font-bold text-muted-foreground">$</span>
                        <span class="text-3xl font-black tabular-nums tracking-tighter">@stat.Value.ToString("F2")</span>
                    </div>

                    @* Sparkline — pure HTML/CSS bars scaled to max value in trend *@
                    <div class="h-10 w-full mt-6 flex items-end gap-0.5">
                        @foreach (var pt in stat.Trend)
                        {
                            var heightPct = (int)Math.Round(pt / stat.TrendMax * 100);
                            var color = stat.Status == "warning" ? "#f59e0b" : "#10b981";
                            <div class="flex-1 rounded-t-[1px] opacity-[0.15]" style="@($"height:{heightPct}%; background:{color}")"></div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-6 py-4 flex items-center justify-between bg-muted/20">
            <div class="flex items-center gap-6">
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">Top Service</span>
                    <span class="text-xs font-black">Amazon EC2 ($842)</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-0.5">Budget Alert</span>
                    <span class="text-xs font-black text-amber-600">85% Reached</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-black uppercase tracking-widest text-primary hover:underline">
                Cost Reports @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, double Value, string Unit, string IconName, string Status, double[] Trend)
    {
        public double TrendMax => Trend.Length > 0 ? Trend.Max() : 1;
    }

    private static readonly double[] _baseTrend =
    [
        42.5, 44.8, 41.2, 48.6, 52.4, 51.0, 55.2, 58.4, 57.8, 62.4, 65.0, 68.2
    ];

    private static readonly double[] _mtdTrend =
    [
        42.5 * 1 / 2.0,
        44.8 * 2 / 2.0,
        41.2 * 3 / 2.0,
        48.6 * 4 / 2.0,
        52.4 * 5 / 2.0,
        51.0 * 6 / 2.0,
        55.2 * 7 / 2.0,
        58.4 * 8 / 2.0,
        57.8 * 9 / 2.0,
        62.4 * 10 / 2.0,
        65.0 * 11 / 2.0,
        68.2 * 12 / 2.0,
    ];

    private static readonly double[] _projectedTrend =
    [
        42.5 * 1.1, 44.8 * 1.1, 41.2 * 1.1, 48.6 * 1.1,
        52.4 * 1.1, 51.0 * 1.1, 55.2 * 1.1, 58.4 * 1.1,
        57.8 * 1.1, 62.4 * 1.1, 65.0 * 1.1, 68.2 * 1.1,
    ];

    private static readonly StatItem[] _stats =
    [
        new("Daily Spend",  68.20,    "USD", "dollar-sign",  "warning", _baseTrend),
        new("MTD Total",    1424.50,  "USD", "bar-chart-3",  "healthy", _mtdTrend),
        new("Projected",    2150.00,  "USD", "trending-up",  "healthy", _projectedTrend),
    ];
}
