@* ============================================================
   Block: monitoring-ab-test-performance
   Title: MonitoringAbTestPerformance
   Description: Advanced product monitoring dashboard featuring experiment conversion tracking, statistical significance analysis, and variant performance comparison with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-ab-test-performance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-blue-500/10">
                    <LucideIconCn Name="target" Size="16" Class="size-4 text-blue-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">A/B Test Results</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Exp: new_onboarding_flow_v2
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="bg-blue-500/10 text-blue-600 border-blue-500/20 px-2 py-0 h-5 font-medium">
                    SIGNIFICANT
                </BadgeCn>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var isLast = stat.Label == "Confidence";
                <div class="@(isLast ? "p-4" : "p-4 md:border-r border-b md:border-b-0")">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@stat.Icon" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@stat.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        <span class="text-xs text-muted-foreground font-medium">@stat.Unit</span>
                    </div>
                </div>
            }
        </div>

        @* Chart area *@
        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Conversion Lift by Variant</span>
                <div class="flex gap-4">
                    <div class="flex items-center gap-1.5">
                        <div class="size-1.5 rounded-full bg-blue-500"></div>
                        <span class="text-[10px] text-muted-foreground">Statistically Significant</span>
                    </div>
                </div>
            </div>

            @* Horizontal bar chart rendered as pure HTML/CSS *@
            <div class="h-40 w-full flex flex-col justify-around">
                @foreach (var exp in _experimentData)
                {
                    var barPct = (int)Math.Round(exp.Conv / 6.0 * 100);
                    <div class="flex items-center gap-2">
                        <span class="w-20 shrink-0 text-[10px] text-muted-foreground text-right">@exp.Variant</span>
                        <div class="flex-1 h-5 bg-muted/40 rounded-sm overflow-hidden">
                            <div class="h-full bg-foreground rounded-r-[4px]" style="@($"width:{barPct}%")"></div>
                        </div>
                        <span class="w-8 shrink-0 text-[10px] text-muted-foreground text-right">@exp.Conv.ToString("F1")%</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium">Primary Metric: Sign-up Rate</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Analytics @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string Unit, string Icon);
    private record ExperimentItem(string Variant, double Conv, double Lift);

    private static readonly StatItem[] _stats =
    [
        new("Total Users", "124.5", "k", "users"),
        new("Avg Conversion", "4.7", "%", "bar-chart-3"),
        new("Confidence", "98.2", "%", "trending-up"),
    ];

    private static readonly ExperimentItem[] _experimentData =
    [
        new("Control",   4.2, 0),
        new("Variant A", 4.8, 14.2),
        new("Variant B", 5.1, 21.4),
    ];
}
