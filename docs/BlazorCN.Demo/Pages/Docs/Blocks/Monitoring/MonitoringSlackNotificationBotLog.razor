@* ============================================================
   Block: monitoring-slack-notification-bot-log
   Title: MonitoringSlackNotificationBotLog
   Description: Real-time monitoring for Slack bot notifications, message delivery rates, and channel activity logs using shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-slack-notification-bot-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="hash" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Slack Bot Monitor</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Alerts &amp; Notifications · Production
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    Operational
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                var isLast = s.Index == _stats.Length - 1;
                var borderClass = isLast ? "" : "md:border-r border-b md:border-b-0";
                var badgeClass = s.Status == "warning"
                    ? "h-5 px-1.5 font-normal text-[10px] bg-amber-500/10 text-amber-600 border-amber-500/20"
                    : "h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20";
                var strokeColor = s.Status == "warning" ? "#f59e0b" : "#10b981";
                var gradientId = $"gradient-slack-{s.Index}";

                var chartW = 200;
                var chartH = 40;
                var count = s.Trend.Length;
                var maxVal = s.Trend[0];
                for (var ti = 1; ti < count; ti++) { if (s.Trend[ti] > maxVal) maxVal = s.Trend[ti]; }
                if (maxVal <= 0) maxVal = 1;

                var pts = new System.Text.StringBuilder();
                for (var i = 0; i < count; i++)
                {
                    var px = count <= 1 ? 0.0 : (double)chartW / (count - 1) * i;
                    var py = chartH - s.Trend[i] / maxVal * chartH;
                    if (i > 0) pts.Append(' ');
                    pts.Append($"{px:F1},{py:F1}");
                }
                var linePoints = pts.ToString();
                var fillPoints = $"0,{chartH} {linePoints} {chartW},{chartH}";

                <div class="@Cn.Merge("p-4", borderClass)">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@s.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                            @(s.Status == "warning" ? "Attention" : "Healthy")
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.DisplayValue</span>
                        <span class="text-muted-foreground text-xs font-medium">@s.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@s.Label</p>

                    <div class="h-10 w-full mt-4">
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradientId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="border-t"></div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Last Message: #ops-critical
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Detailed Logs →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(int Index, string Label, string DisplayValue, string Unit, string IconName, string Status, double[] Trend);

    private static readonly double[] _baseTrend = [450, 480, 520, 490, 550, 610, 580, 600, 620, 650];

    private static readonly StatItem[] _stats =
    [
        new(0, "Messages Sent",    "6420", "msg", "send",          "healthy", _baseTrend),
        new(1, "Success Rate",     "99.8", "%",   "check",         "healthy", [95 + 450.0/200, 95 + 480.0/200, 95 + 520.0/200, 95 + 490.0/200, 95 + 550.0/200, 95 + 610.0/200, 95 + 580.0/200, 95 + 600.0/200, 95 + 620.0/200, 95 + 650.0/200]),
        new(2, "Failed Deliveries","12",   "err", "alert-circle",  "warning", [450%5+1, 480%5+1, 520%5+1, 490%5+1, 550%5+1, 610%5+1, 580%5+1, 600%5+1, 620%5+1, 650%5+1]),
    ];
}
