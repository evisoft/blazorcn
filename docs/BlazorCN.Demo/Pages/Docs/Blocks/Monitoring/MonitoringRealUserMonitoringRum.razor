@* ============================================================
   Block: monitoring-real-user-monitoring-rum
   Title: MonitoringRealUserMonitoringRum
   Description: Real-time dashboard for tracking actual user experience metrics including page load times, interaction latency, and device distribution using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-real-user-monitoring-rum.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Real User Monitoring</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Live Experience · 2.4k Active Sessions</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Collecting</span>
            </div>
        </div>

        <div class="grid grid-cols-2 divide-x border-b">
            <div class="p-4 flex flex-col items-center justify-center">
                <div class="text-[10px] font-semibold uppercase text-muted-foreground mb-1">Avg Load Time</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl font-bold">1.4</span>
                    <span class="text-xs text-muted-foreground font-medium">seconds</span>
                </div>
                <div class="mt-1 flex items-center gap-1 text-[10px] text-emerald-600 font-medium">
                    <LucideIconCn Name="timer" Size="12" Class="size-3" />
                    -12% vs last hour
                </div>
            </div>
            <div class="p-4 flex flex-col items-center justify-center">
                <div class="text-[10px] font-semibold uppercase text-muted-foreground mb-1">Interactive Latency</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl font-bold">42</span>
                    <span class="text-xs text-muted-foreground font-medium">ms</span>
                </div>
                <div class="mt-1 flex items-center gap-1 text-[10px] text-emerald-600 font-medium">
                    <LucideIconCn Name="mouse-pointer-2" Size="12" Class="size-3" />
                    Healthy (P95)
                </div>
            </div>
        </div>

        <div class="p-4">
            <h4 class="text-[10px] font-bold uppercase text-muted-foreground mb-3 tracking-wider">Device Distribution</h4>
            <div class="space-y-4">
                @foreach (var stat in _deviceStats)
                {
                    var s = stat;
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-medium">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="@s.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                                @s.Label
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground">@(s.Percentage)%</span>
                                <span class="font-mono">@(s.AvgLoad.ToString("F1"))s avg</span>
                            </div>
                        </div>
                        <div class="w-full h-1.5 bg-muted rounded-full overflow-hidden">
                            <div class="h-full bg-foreground" style="@($"width:{s.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <hr class="border-t" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="globe-2" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">42 Countries</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Regional Breakdown →
            </button>
        </div>
    </div>
</section>

@code {
    private record DeviceStat(string Label, string Icon, int Percentage, double AvgLoad);

    private static readonly DeviceStat[] _deviceStats =
    [
        new("Desktop", "monitor", 65, 1.2),
        new("Mobile", "smartphone", 32, 2.8),
        new("Tablet", "globe-2", 3, 1.8),
    ];
}
