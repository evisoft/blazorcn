@* ============================================================
   Block: monitoring-web-vitals-score
   Title: MonitoringWebVitalsScore
   Description: Real-time Core Web Vitals monitoring dashboard featuring LCP, FID, and CLS scores with optimization recommendations using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-web-vitals-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="gauge" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Web Vitals</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Real-world Performance Metrics</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <div class="text-[10px] font-semibold uppercase text-muted-foreground">Overall Score</div>
                    <div class="text-sm font-bold text-emerald-600">92</div>
                </div>
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x border-b">
            @foreach (var vital in _vitals)
            {
                var rowIndex = Array.IndexOf(_vitals, vital);
                var borderClass = rowIndex < 2 ? "md:border-b" : "";
                <div class="@($"p-4 flex flex-col justify-between {borderClass}")">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold uppercase text-muted-foreground tracking-wider">@vital.Name</span>
                            <div class="flex items-baseline gap-1 mt-1">
                                <span class="text-xl font-bold">@vital.FormattedValue</span>
                                <span class="text-xs text-muted-foreground font-medium">@vital.Unit</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"h-5 px-1.5 text-[9px] uppercase font-bold {(vital.Status == "good" ? "bg-emerald-500/10 text-emerald-600 border-emerald-500/20" : "bg-amber-500/10 text-amber-600 border-amber-500/20")}")">
                            @(vital.Status == "good" ? "Passing" : "Caution")
                        </BadgeCn>
                    </div>
                    <div class="w-full h-1 bg-muted rounded-full overflow-hidden">
                        <div class="@($"h-full {(vital.Status == "good" ? "bg-emerald-500" : "bg-amber-500")}")" style="@($"width:{vital.Score}%")"></div>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">+4pts vs last month</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="info" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">P75 Aggregated Data</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Optimization Guide →
            </button>
        </div>
    </div>
</section>

@code {
    private record Vital(string Id, string Name, double Value, string Unit, int Score, string Status)
    {
        public string FormattedValue => Id == "cls"
            ? Value.ToString("F2")
            : Value % 1 == 0 ? ((int)Value).ToString() : Value.ToString("G");
    }

    private static readonly Vital[] _vitals =
    [
        new("lcp", "Largest Contentful Paint", 1.2, "s",  98, "good"),
        new("fid", "First Input Delay",        12,  "ms", 99, "good"),
        new("cls", "Cumulative Layout Shift",  0.04, "",  92, "good"),
        new("inp", "Interaction to Next Paint", 145, "ms", 74, "needs-improvement"),
    ];
}
