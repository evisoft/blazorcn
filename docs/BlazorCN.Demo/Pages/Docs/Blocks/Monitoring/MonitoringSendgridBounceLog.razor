@* ============================================================
   Block: monitoring-sendgrid-bounce-log
   Title: MonitoringSendgridBounceLog
   Description: Real-time monitoring for SendGrid email bounces, spam complaints, and delivery failures using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-sendgrid-bounce-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">SendGrid Bounces</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Delivery Failures · Last 24h
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-amber-600 dark:text-amber-400">
                    Review Needed
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var (stat, i) in _stats.Select((s, idx) => (s, idx)))
            {
                var item = stat;
                var idx = i;
                var badgeClass = item.Status == "warning"
                    ? "h-5 px-1.5 font-normal text-[10px] bg-amber-500/10 text-amber-600 border-amber-500/20"
                    : item.Status == "info"
                        ? "h-5 px-1.5 font-normal text-[10px] bg-blue-500/10 text-blue-600 border-blue-500/20"
                        : "h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20";
                var badgeLabel = item.Status == "warning" ? "Critical" : item.Status == "info" ? "Volume" : "Stable";
                var strokeColor = item.Status == "warning" ? "#f59e0b" : item.Status == "info" ? "#3b82f6" : "#10b981";
                <div class="@Cn.Merge("p-4", idx != _stats.Length - 1 ? "md:border-r border-b md:border-b-0" : "")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@item.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                            @badgeLabel
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">
                            @item.Value
                        </span>
                        <span class="text-muted-foreground text-xs font-medium">@item.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@item.Label</p>

                    <div class="h-10 w-full mt-4">
                        @{
                            var trendData = item.Trend;
                            var tCount = trendData.Length;
                            var cW = 200;
                            var cH = 40;
                            double minVal = trendData.Min(d => d);
                            double maxVal = trendData.Max(d => d);
                            double range = maxVal - minVal;
                            if (range < 0.001) range = 1.0;
                            double StepX(int n) => tCount <= 1 ? 0 : (double)cW / (tCount - 1) * n;
                            double PtY(int n) => cH - (trendData[n] - minVal) / range * cH;
                            var linePts = string.Join(" ", Enumerable.Range(0, tCount).Select(n => $"{StepX(n):F1},{PtY(n):F1}"));
                            var fillPts = $"0,{cH} " + linePts + $" {cW},{cH}";
                            var gradId = $"gradient-sg-{idx}";
                        }
                        <svg viewBox="0 0 @cW @cH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPts" fill="@($"url(#{gradId})")" />
                            <polyline points="@linePts" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <div class="border-t"></div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Highest Bounce Domain: hotmail.com
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Suppression List →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, int Value, string Unit, string IconName, string Status, double[] Trend);

    private static readonly double[] _baseData = [2, 5, 3, 8, 4, 12, 15, 10, 6, 4];

    private static readonly StatItem[] _stats =
    [
        new("Hard Bounces", 42, "cnt", "flame", "warning", _baseData),
        new("Soft Bounces", 124, "cnt", "mail", "info", _baseData.Select(d => d * 2).ToArray()),
        new("Spam Reports", 2, "cnt", "trash", "healthy", _baseData.Select(d => (double)(d % 3)).ToArray()),
    ];
}
