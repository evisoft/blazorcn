@* ============================================================
   Block: monitoring-identity-verification-status
   Title: MonitoringIdentityVerificationStatus
   Description: Professional monitoring block for identity verification workflows, showing completion rates, pending reviews, and failure trends with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-identity-verification-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="fingerprint" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Identity Check</h3>
                    <p class="mt-1 text-muted-foreground text-xs">User Onboarding · KYC Pipeline</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-blue-500 animate-pulse"></div>
                <span class="text-xs font-medium uppercase tracking-wider text-blue-600 dark:text-blue-400">
                    Active Flow
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var i = idx;
                var isLast = i == _stats.Length - 1;
                var borderClass = isLast ? "" : " md:border-r border-b md:border-b-0";
                var strokeColor = stat.Status == "info" ? "#3b82f6" : "#10b981";
                var badgeClass = stat.Status == "info"
                    ? "h-5 px-1.5 font-normal text-[10px] bg-blue-500/10 text-blue-600 border-blue-500/20"
                    : "h-5 px-1.5 font-normal text-[10px] bg-emerald-500/10 text-emerald-600 border-emerald-500/20";
                var badgeText = stat.Status == "info" ? "Growing" : "Healthy";

                var chartW = 200;
                var chartH = 40;
                var trendData = stat.Trend;
                var count = trendData.Length;
                double minVal = trendData.Min() - 1;
                double maxVal = trendData.Max() + 1;
                double valRange = maxVal - minVal == 0 ? 1 : maxVal - minVal;
                double StepX(int n) => count <= 1 ? 0 : (double)chartW / (count - 1) * n;
                double StepY(double v) => chartH - (v - minVal) / valRange * chartH;

                var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(n => $"{StepX(n):F1},{StepY(trendData[n]):F1}"));
                var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                var gradId = $"idv-gradient-{i}";

                <div class="@($"p-4{borderClass}")">
                    <div class="flex items-center justify-between mb-2">
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                            @badgeText
                        </BadgeCn>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.ValueDisplay</span>
                        <span class="text-muted-foreground text-xs font-medium">@stat.Unit</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">@stat.Label</p>

                    <div class="h-10 w-full mt-4">
                        <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="5%" stop-color="@strokeColor" stop-opacity="0.1" />
                                    <stop offset="95%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@fillPoints" fill="@($"url(#{gradId})")" />
                            <polyline points="@linePoints" fill="none" stroke="@strokeColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <hr class="border-t" />

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">
                Last Verified: 12m ago
            </span>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Verification Queue →
            </button>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string ValueDisplay, string Unit, string IconName, string Status, double[] Trend);

    private static readonly StatItem[] _stats =
    [
        new("Success Rate", "94.2", "%", "user-check", "healthy", [82, 85, 88, 92, 95, 94, 90, 88, 92, 96]),
        new("Pending Review", "24", "cnt", "clock", "info", [25.5, 26.25, 27, 28, 28.75, 28.5, 27.5, 27, 28, 29]),
        new("Avg. Duration", "1.5", "min", "camera", "healthy", [0.9, 0.75, 0.6, 0.4, 0.25, 0.3, 0.5, 0.6, 0.4, 0.2]),
    ];
}
