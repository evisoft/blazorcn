@* ============================================================
   Block: monitoring-vector-database-latency
   Title: MonitoringVectorDatabaseLatency
   Description: Advanced RAG monitoring dashboard featuring vector search latency, index retrieval speed, and embedding dimensions tracking with shadcn/ui and Recharts.
   Source: original/blocks/monitoring/monitoring-vector-database-latency.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10">
                    <LucideIconCn Name="search" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Vector DB Latency</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Index: semantic-search-prod</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Low Latency</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var isLast = idx == _stats.Length - 1;
                <div class="@($"p-4{(isLast ? "" : " md:border-r border-b md:border-b-0")}")">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@stat.IconName" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@stat.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        @if (!string.IsNullOrEmpty(stat.Unit))
                        {
                            <span class="text-xs text-muted-foreground font-medium">@stat.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Retrieval Trend (ms)</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">cosine similarity</BadgeCn>
            </div>
            <div class="h-32 w-full">
                @{
                    var data = _latencyData;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 128;
                    var minVal = data.Min(d => d.Latency) - 10;
                    var maxVal = data.Max(d => d.Latency) + 10;
                    var valRange = maxVal - minVal == 0 ? 1 : maxVal - minVal;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double StepY(int v) => chartH - (double)(v - minVal) / valRange * chartH;
                    var areaPoints = string.Join(" ", Enumerable.Range(0, count).Select(i => FormattableString.Invariant($"{StepX(i):F1},{StepY(data[i].Latency):F1}")));
                    var fillPoints = $"0,{chartH} " + areaPoints + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="vectorLatencyGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#10b981" stop-opacity="0.2" />
                            <stop offset="95%" stop-color="#10b981" stop-opacity="0.05" />
                        </linearGradient>
                    </defs>
                    <polygon points="@fillPoints" fill="url(#vectorLatencyGradient)" />
                    <polyline points="@areaPoints" fill="none" stroke="#10b981" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium">Provider: Pinecone (s1-pod)</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Index Details →
            </button>
        </div>
    </div>
</section>

@code {
    private record LatencyPoint(string Time, int Latency);
    private record StatItem(string Label, int Value, string Unit, string IconName);

    private static readonly LatencyPoint[] _latencyData =
    [
        new("10:00", 45),
        new("10:05", 52),
        new("10:10", 120),
        new("10:15", 85),
        new("10:20", 65),
        new("10:25", 40),
        new("10:30", 38),
        new("10:35", 42),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Search Latency", 42, "ms", "zap"),
        new("Queries / sec", 125, "", "activity"),
        new("Vector Dims", 1536, "", "database"),
    ];
}
