@* ============================================================
   Block: monitoring-dependency-updates
   Title: MonitoringDependencyUpdates
   Description: Real-time project dependency monitoring dashboard featuring version tracking, security patch alerts, and automated update recommendations using shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-dependency-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="boxes" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Dependencies</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Package Health · Version Tracking
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-6 px-2 text-[10px] font-semibold bg-red-500/10 text-red-600 border-red-500/20">
                1 Vulnerability
            </BadgeCn>
        </div>

        @* Stats Row *@
        <div class="grid grid-cols-3 divide-x border-b">
            <div class="p-3 text-center">
                <div class="text-[10px] uppercase font-bold text-muted-foreground">Up to Date</div>
                <div class="text-lg font-semibold text-emerald-600">84%</div>
            </div>
            <div class="p-3 text-center">
                <div class="text-[10px] uppercase font-bold text-muted-foreground">Outdated</div>
                <div class="text-lg font-semibold text-amber-600">12</div>
            </div>
            <div class="p-3 text-center">
                <div class="text-[10px] uppercase font-bold text-muted-foreground">Security</div>
                <div class="text-lg font-semibold text-red-600">1</div>
            </div>
        </div>

        @* Table *@
        <div class="divide-y">
            <div class="grid grid-cols-12 px-4 py-2 bg-muted/30 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span class="col-span-5">PACKAGE</span>
                <span class="col-span-3 text-center">VERSION</span>
                <span class="col-span-2 text-center">LATEST</span>
                <span class="col-span-2 text-right">STATUS</span>
            </div>
            @foreach (var dep in _dependencies)
            {
                <div class="grid grid-cols-12 items-center px-4 py-3 hover:bg-muted/20 transition-colors">
                    <div class="col-span-5 flex items-center gap-2">
                        <LucideIconCn Name="package" Size="14" Class="size-3.5 text-muted-foreground" />
                        <div class="flex flex-col">
                            <span class="text-xs font-medium truncate">@dep.Name</span>
                            <span class="text-[9px] text-muted-foreground uppercase">@dep.Type</span>
                        </div>
                    </div>
                    <div class="col-span-3 text-center">
                        <code class="text-[11px] font-mono text-muted-foreground">@dep.Current</code>
                    </div>
                    <div class="col-span-2 text-center">
                        <code class="text-[11px] font-mono font-medium">@dep.Latest</code>
                    </div>
                    <div class="col-span-2 flex justify-end">
                        @if (dep.Status == "current")
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                        }
                        else if (dep.Status == "vulnerable")
                        {
                            <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-red-500 animate-pulse" />
                        }
                        else
                        {
                            <LucideIconCn Name="arrow-up-circle" Size="16" Class="size-4 text-amber-500" />
                        }
                    </div>
                </div>
            }
        </div>

        @* Separator *@
        <div class="border-t"></div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Last check: 1h ago</span>
                </div>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Generate Update Plan @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record Dependency(string Name, string Current, string Latest, string Status, string Type);

    private static readonly Dependency[] _dependencies =
    [
        new("next",           "15.0.1",  "15.1.0",        "outdated",   "dep"),
        new("framer-motion",  "11.1.7",  "11.2.0",        "outdated",   "dep"),
        new("lucide-react",   "0.454.0", "0.454.0",       "current",    "dep"),
        new("typescript",     "5.4.5",   "5.5.2",         "vulnerable", "dev"),
        new("tailwindcss",    "3.4.1",   "4.0.0-alpha",   "outdated",   "dev"),
    ];
}
