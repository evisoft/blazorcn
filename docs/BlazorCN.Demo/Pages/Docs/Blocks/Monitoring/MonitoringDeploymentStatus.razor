@* ============================================================
   Block: monitoring-deployment-status
   Title: MonitoringDeploymentStatus
   Description: Operational CI/CD monitoring block featuring recent deployment history, environment-specific versions, and real-time build status with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-deployment-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-background">
                    <LucideIconCn Name="rocket" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">Deployments</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Production &amp; Staging · main branch
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-bold uppercase border-blue-500/20 text-blue-600 bg-blue-500/5">
                Auto-deploy On
            </BadgeCn>
        </div>

        <div class="divide-y">
            @foreach (var dep in _deployments)
            {
                var item = dep;
                var config = _statusConfig[item.Status];
                <div class="p-4 space-y-3 hover:bg-muted/30 transition-colors">
                    <div class="flex items-start justify-between">
                        <div class="flex items-center gap-3">
                            <div class="flex flex-col">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-bold">@item.Version</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[9px] h-4 font-bold uppercase tracking-tight bg-muted">
                                        @item.Env
                                    </BadgeCn>
                                </div>
                                <div class="flex items-center gap-2 mt-1 text-xs text-muted-foreground">
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                                        @item.Commit
                                    </span>
                                    <span>·</span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="user" Size="12" Class="size-3" />
                                        @item.Author
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col items-end gap-1.5">
                            <div class="@($"flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider {config.Color}")">
                                <LucideIconCn Name="@config.IconName" Size="12" Class="@($"size-3{(item.Status == "running" ? " animate-spin" : "")}")" />
                                @config.Label
                            </div>
                            <span class="text-[10px] font-medium text-muted-foreground">
                                @item.Time
                            </span>
                        </div>
                    </div>

                    @if (item.Status == "running")
                    {
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between text-[10px] font-bold text-muted-foreground uppercase">
                                <span>Rollout Progress</span>
                                <span>@(item.Progress)%</span>
                            </div>
                            <ProgressCn Value="@item.Progress" Class="h-1.5 bg-muted" aria-label="Progress" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium uppercase tracking-wide">
                    Mean Time to Recovery: 12m
                </span>
            </div>
            <button type="button" class="text-[10px] font-bold text-foreground hover:underline">
                View Deployment Logs →
            </button>
        </div>
    </div>
</section>

@code {
    private record Deployment(string Id, string Env, string Version, string Status, double Progress, string Commit, string Author, string Time);
    private record StatusConfig(string IconName, string Color, string Label);

    private static readonly Deployment[] _deployments =
    [
        new("dep-842", "Production", "v2.4.12", "running", 65, "8f4a2d1", "arivera", "3m ago"),
        new("dep-841", "Production", "v2.4.11", "success", 0,  "2d1f4a8", "schen",   "2h ago"),
        new("dep-840", "Staging",    "v2.5.0-rc1", "failed", 0, "a4f2d18", "mwright", "5h ago"),
    ];

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["success"] = new("check-circle-2", "text-emerald-500", "Deployed"),
        ["failed"]  = new("x-circle",       "text-red-500",     "Failed"),
        ["running"] = new("loader-2",        "text-blue-500",    "In Progress"),
    };
}
