@* ============================================================
   Block: monitoring-celery-worker-activity
   Title: MonitoringCeleryWorkerActivity
   Description: Distributed task monitoring dashboard featuring Celery worker status, task latency, and concurrency metrics with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-celery-worker-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Celery Workers</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Distributed task execution</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">8 Workers Online</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var isLast = idx == _stats.Length - 1;
                <div class="@($"p-4{(isLast ? "" : " md:border-r border-b md:border-b-0")}")">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@stat.Icon" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@stat.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</span>
                        @if (!string.IsNullOrEmpty(stat.Unit))
                        {
                            <span class="text-xs text-muted-foreground font-medium">@stat.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-4">Worker Task Distribution</p>
            <div class="h-48 w-full">
                @{
                    var data = _workerData;
                    var count = data.Length;
                    var svgW = 360;
                    var svgH = 192;
                    var labelW = 60;
                    var barAreaW = svgW - labelW;
                    var barH = 20;
                    var rowH = svgH / count;
                    var maxTasks = data.Max(d => d.Tasks);
                }
                <svg viewBox="0 0 @svgW @svgH" preserveAspectRatio="none" class="w-full h-full">
                    @for (int i = 0; i < count; i++)
                    {
                        var worker = data[i];
                        var barWidth = maxTasks == 0 ? 0 : (int)((double)worker.Tasks / maxTasks * barAreaW);
                        var y = i * rowH + (rowH - barH) / 2;
                        var labelY = i * rowH + rowH / 2 + 4;
                        <g>
                            @((MarkupString)$"<text x=\"0\" y=\"{labelY}\" font-size=\"10\" fill=\"#888\" text-anchor=\"start\">{worker.Name}</text>")
                            <rect x="@labelW" y="@y" width="@barWidth" height="@barH" rx="0" ry="0" style="fill:currentColor" class="text-foreground" />
                        </g>
                    }
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="layers" Size="12" Class="size-3" />
                <span>Broker: Redis://localhost:6379</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Task Inspector →
            </button>
        </div>
    </div>
</section>

@code {
    private record WorkerItem(string Name, int Tasks, int Load);
    private record StatItem(string Label, string Value, string Icon, string Unit);

    private static readonly WorkerItem[] _workerData =
    [
        new("worker-1", 450, 68),
        new("worker-2", 380, 45),
        new("worker-3", 520, 82),
        new("worker-4", 410, 55),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Active Tasks", "124", "activity", ""),
        new("Avg Execution", "1.2", "zap", "s"),
        new("Total Load", "62", "cpu", "%"),
    ];
}
