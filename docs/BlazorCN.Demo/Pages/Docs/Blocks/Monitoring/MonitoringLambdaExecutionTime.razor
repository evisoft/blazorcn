@* ============================================================
   Block: monitoring-lambda-execution-time
   Title: MonitoringLambdaExecutionTime
   Description: Real-time serverless function monitoring dashboard featuring execution time trends, cold start analysis, and memory utilization using shadcn/ui, Recharts, and Framer Motion.
   Source: original/blocks/monitoring/monitoring-lambda-execution-time.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-orange-500/10 text-orange-600">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 fill-current" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">process-payment-v3</h3>
                    <p class="mt-1 text-muted-foreground text-xs">AWS Lambda · us-east-1</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Active</span>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="p-4 border-r">
                <div class="text-[10px] font-semibold uppercase text-muted-foreground mb-1">P99 Latency</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-bold">142</span>
                    <span class="text-[10px] text-muted-foreground font-medium">ms</span>
                </div>
            </div>
            <div class="p-4 border-r">
                <div class="text-[10px] font-semibold uppercase text-muted-foreground mb-1">Cold Starts</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-bold text-amber-600">2.4%</span>
                </div>
            </div>
            <div class="p-4">
                <div class="text-[10px] font-semibold uppercase text-muted-foreground mb-1">Avg Memory</div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-bold">128</span>
                    <span class="text-[10px] text-muted-foreground font-medium">MB</span>
                </div>
            </div>
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-1.5 text-xs font-medium">
                    <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5 text-muted-foreground" />
                    Execution Time Trend (ms)
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[9px] h-4 font-mono">1h window</BadgeCn>
            </div>
            <div class="h-32 w-full">
                @{
                    var data = _executionData;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 128;
                    var minVal = data.Min(d => d.Ms) - 20;
                    var maxVal = data.Max(d => d.Ms) + 20;
                    var valRange = maxVal - minVal == 0 ? 1 : maxVal - minVal;
                    double StepX(int i) => count <= 1 ? 0 : (double)chartW / (count - 1) * i;
                    double StepY(int v) => chartH - (double)(v - minVal) / valRange * chartH;

                    var linePoints = string.Join(" ", Enumerable.Range(0, count).Select(i => $"{StepX(i):F1},{StepY(data[i].Ms):F1}"));
                    var fillPoints = $"0,{chartH} " + linePoints + $" {chartW},{chartH}";
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    <defs>
                        <linearGradient id="lambdaLatencyGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#f97316" stop-opacity="0.1" />
                            <stop offset="95%" stop-color="#f97316" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@fillPoints" fill="url(#lambdaLatencyGradient)" />
                    <polyline points="@linePoints" fill="none" stroke="#f97316" stroke-width="2" />
                </svg>
            </div>
        </div>

        <div class="border-t"></div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Updated 2m ago</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="cpu" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Node.js 20.x</span>
                </div>
            </div>
            <button type="button" class="flex items-center gap-1 text-[10px] font-medium hover:underline text-foreground">
                CloudWatch Logs
                <LucideIconCn Name="external-link" Size="10" Class="size-2.5" />
            </button>
        </div>
    </div>
</section>

@code {
    private record ExecutionPoint(string Time, int Ms);

    private static readonly ExecutionPoint[] _executionData =
    [
        new("10:00", 120),
        new("10:05", 450),
        new("10:10", 115),
        new("10:15", 132),
        new("10:20", 128),
        new("10:25", 142),
        new("10:30", 118),
        new("10:35", 122),
        new("10:40", 135),
        new("10:45", 125),
    ];
}
