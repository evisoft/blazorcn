@* ============================================================
   Block: monitoring-ssl-certificate-expiry
   Title: MonitoringSslCertificateExpiry
   Description: Operational security monitoring block featuring SSL/TLS certificate expiry tracking, domain-specific health checks, and automated renewal alerts with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-ssl-certificate-expiry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10 text-emerald-600 border shadow-sm">
                    <LucideIconCn Name="lock" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">SSL Certificates</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Security Monitoring · 12 Active Certs
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-bold uppercase border-emerald-500/20 text-emerald-600 bg-emerald-500/5">
                All Secure
            </BadgeCn>
        </div>

        <div class="divide-y">
            @foreach (var cert in _certificates)
            {
                var isCritical = cert.Status == "critical";
                var isWarning = cert.Status == "warning";
                var progressValue = Math.Max(0.0, Math.Min(100.0, (cert.DaysRemaining / 90.0) * 100.0));
                <div class="p-4 space-y-3 hover:bg-muted/30 transition-colors">
                    <div class="flex items-start justify-between">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <h4 class="text-sm font-bold text-foreground">@cert.Domain</h4>
                                @if (isCritical)
                                {
                                    <LucideIconCn Name="shield-alert" Size="14" Class="size-3.5 text-red-500 animate-pulse" />
                                }
                                else if (isWarning)
                                {
                                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-amber-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                            </div>
                            <p class="text-[10px] font-medium text-muted-foreground uppercase tracking-tight">
                                Issuer: @cert.Issuer
                            </p>
                        </div>

                        <div class="text-right space-y-1">
                            <p class="@($"text-sm font-bold tabular-nums {(isCritical ? "text-red-600" : isWarning ? "text-amber-600" : "text-emerald-600")}")">
                                @cert.DaysRemaining Days
                            </p>
                            <p class="text-[10px] font-medium text-muted-foreground uppercase">
                                Remaining
                            </p>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <ProgressCn Value="@progressValue" Class="@($"h-1.5 bg-muted {(isCritical ? "[&>div]:bg-red-500" : isWarning ? "[&>div]:bg-amber-500" : "[&>div]:bg-emerald-500")}")" />
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium uppercase tracking-wide">
                    Next Auto-Scan in 12h
                </span>
            </div>
            <button type="button" class="flex items-center gap-1 text-[10px] font-bold text-foreground hover:underline">
                Manage Renewal Tasks <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </button>
        </div>
    </div>
</section>

@code {
    private record Certificate(string Domain, string Issuer, int DaysRemaining, string Status);

    private static readonly Certificate[] _certificates =
    [
        new("api.shadcn.io", "Let's Encrypt", 64, "healthy"),
        new("dashboard.shadcn.io", "DigiCert SHA2 High Assurance", 12, "warning"),
        new("assets.shadcn.io", "Let's Encrypt", 2, "critical"),
    ];
}
