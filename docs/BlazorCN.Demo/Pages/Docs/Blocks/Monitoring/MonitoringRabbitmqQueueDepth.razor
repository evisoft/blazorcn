@* ============================================================
   Block: monitoring-rabbitmq-queue-depth
   Title: MonitoringRabbitmqQueueDepth
   Description: Real-time RabbitMQ monitoring dashboard featuring queue depth tracking, message rates, and consumer count analytics with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-rabbitmq-queue-depth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="message-square" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">RabbitMQ Depth</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Queue: email-notifications
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Stable</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="@s.BorderClass p-4">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@s.IconName" Size="12" Class="size-3" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider">@s.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Message Backlog Trend</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] h-5 font-normal">-12% vs last hour</BadgeCn>
            </div>
            <div class="h-32 w-full">
                @{
                    var svgW = 400;
                    var svgH = 128;
                    var pts = _queueData;
                    var maxDepth = pts.Max(d => d.Depth);
                    var minDepth = pts.Min(d => d.Depth);
                    var range = maxDepth - minDepth;
                    if (range == 0) range = 1;
                    var padTop = 8;
                    var padBottom = 8;
                    var usableH = svgH - padTop - padBottom;
                    var n = pts.Length;
                    var stepX = n > 1 ? (double)svgW / (n - 1) : svgW;

                    // Build path points
                    var lineParts = new System.Text.StringBuilder();
                    for (var i = 0; i < n; i++)
                    {
                        var x = i * stepX;
                        var y = padTop + usableH * (1.0 - (double)(pts[i].Depth - minDepth) / range);
                        lineParts.Append(i == 0 ? FormattableString.Invariant($"M {x:F1},{y:F1}") : FormattableString.Invariant($" L {x:F1},{y:F1}"));
                    }
                    var lineD = lineParts.ToString();

                    // Build fill path (close to bottom)
                    var firstX = 0.0;
                    var firstY = padTop + usableH * (1.0 - (double)(pts[0].Depth - minDepth) / range);
                    var lastX = (n - 1) * stepX;
                    var fillD = lineD + FormattableString.Invariant($" L {lastX:F1},{svgH} L {firstX:F1},{svgH} Z");
                }
                <svg viewBox="0 0 @svgW @svgH" preserveAspectRatio="none" class="w-full h-full">
                    @((MarkupString)$"<path d=\"{fillD}\" fill=\"currentColor\" fill-opacity=\"0.05\" class=\"text-foreground\" />")
                    @((MarkupString)$"<path d=\"{lineD}\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"text-foreground\" />")
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium">Vhost: /production</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Manage Queue →
            </button>
        </div>
    </div>
</section>

@code {
    private record QueuePoint(string Time, int Depth);
    private record StatItem(string Label, string Value, string IconName, string BorderClass);

    private static readonly QueuePoint[] _queueData =
    [
        new("10:00", 450),
        new("10:05", 520),
        new("10:10", 480),
        new("10:15", 1200),
        new("10:20", 850),
        new("10:25", 650),
        new("10:30", 400),
        new("10:35", 320),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Messages Ready", "320",  "layers",        "md:border-r border-b md:border-b-0"),
        new("Consumers",      "12",   "users",         "md:border-r border-b md:border-b-0"),
        new("Rate (msg/s)",   "45.2", "arrow-down-up", ""),
    ];
}
