@* ============================================================
   Block: monitoring-endpoint-check
   Title: MonitoringEndpointCheck
   Description: Operational synthetic monitoring block featuring global endpoint health checks, response time trends, and regional availability status with shadcn/ui.
   Source: original/blocks/monitoring/monitoring-endpoint-check.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3 bg-muted/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-background shadow-sm">
                    <LucideIconCn Name="activity" Size="16" Class="size-4" />
                </div>
                <div>
                    <h3 class="text-sm font-semibold leading-none">https://api.shadcn.io</h3>
                    <p class="mt-1 text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Synthetic Monitor · 60s frequency
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold text-amber-600 uppercase tracking-widest">
                    Partial Failure
                </span>
                <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
            </div>
        </div>

        <div class="p-4 grid grid-cols-2 gap-4 border-b">
            <div class="space-y-1">
                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none">
                    Global Latency
                </p>
                <div class="flex items-baseline gap-1.5">
                    <span class="text-2xl font-bold tabular-nums">475</span>
                    <span class="text-xs font-medium text-muted-foreground">ms</span>
                </div>
            </div>
            <div class="space-y-1 text-right">
                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none">
                    Success Rate
                </p>
                <div class="flex items-baseline justify-end gap-1.5">
                    <span class="text-2xl font-bold tabular-nums text-amber-600">75</span>
                    <span class="text-xs font-medium text-muted-foreground">%</span>
                </div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var check in _endpointChecks)
            {
                var item = check;
                <div class="p-3.5 flex items-center justify-between hover:bg-muted/30 transition-colors">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                        <div>
                            <p class="text-xs font-bold text-foreground">@item.Region</p>
                            <p class="text-[10px] text-muted-foreground font-medium uppercase">
                                Last check: 12s ago
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-6">
                        <div class="text-right">
                            <p class="@($"text-xs font-bold tabular-nums {(item.Latency > 1000 ? "text-red-600" : "text-foreground")}")">
                                @(item.Latency)ms
                            </p>
                            <p class="text-[10px] font-medium text-muted-foreground uppercase tracking-tight">
                                Latency
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-6 min-w-14 justify-center font-mono text-[10px] font-bold {(item.Healthy ? "border-emerald-500/20 text-emerald-600 bg-emerald-500/5" : "border-red-500/20 text-red-600 bg-red-50")}")">
                            @if (item.Healthy)
                            {
                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 mr-1" />
                            }
                            else
                            {
                                <LucideIconCn Name="x-circle" Size="12" Class="size-3 mr-1" />
                            }
                            @item.Status
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-2.5 bg-muted/50 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium uppercase tracking-wide">
                    Next Check in 48s
                </span>
            </div>
            <button type="button" class="flex items-center gap-1 text-[10px] font-bold text-foreground hover:underline">
                Global Check History <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </button>
        </div>

    </div>
</section>

@code {
    private record EndpointCheck(string Region, int Latency, int Status, bool Healthy);

    private static readonly EndpointCheck[] _endpointChecks =
    [
        new("US East (N. Virginia)", 124, 200, true),
        new("Europe (London)", 84, 200, true),
        new("Asia Pacific (Tokyo)", 452, 200, true),
        new("South America (São Paulo)", 1240, 504, false),
    ];
}
