@* ============================================================
   Block: monitoring-job-scheduler
   Title: MonitoringJobScheduler
   Description: A comprehensive dashboard for monitoring scheduled tasks and cron jobs with execution history and success rate tracking.
   Source: original/blocks/monitoring/monitoring-job-scheduler.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-background shadow-xl">

        @* Header *@
        <div class="flex items-center justify-between border-b bg-muted/5 px-6 py-5">
            <div class="flex items-center gap-3.5">
                <div class="flex size-10 items-center justify-center rounded-xl bg-amber-500/10 shadow-inner">
                    <LucideIconCn Name="calendar" Size="20" Class="size-5 text-amber-600 dark:text-amber-400" />
                </div>
                <div>
                    <h3 class="text-base font-bold tracking-tight">Job Scheduler</h3>
                    <p class="text-muted-foreground text-xs font-medium">
                        System Maintenance &amp; Periodic Tasks
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-emerald-600 border-emerald-500/20 hover:bg-emerald-500/20 transition-colors">
                    <div class="size-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></div>
                    Active
                </BadgeCn>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x">
            @foreach (var stat in _stats)
            {
                <div class="p-6 hover:bg-muted/5 transition-colors">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest">@stat.Label</span>
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-muted-foreground/70" />
                    </div>

                    <div class="flex items-baseline gap-1.5">
                        <span class="text-3xl font-black tabular-nums tracking-tighter">@stat.Value</span>
                        <span class="text-muted-foreground text-xs font-bold uppercase">@stat.Unit</span>
                    </div>

                    @* Sparkline chart rendered as CSS bars *@
                    <div class="h-10 w-full mt-6 opacity-80 flex items-end gap-0.5">
                        @foreach (var pt in stat.Trend)
                        {
                            var heightPct = (int)Math.Round(pt / stat.TrendMax * 100);
                            var color = stat.Status == "warning" ? "bg-amber-400" : "bg-emerald-500";
                            <div class="flex-1 @(color) rounded-t-[1px] opacity-60" style="@($"height:{heightPct}%")"></div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Separator *@
        <div class="h-px bg-border w-full"></div>

        @* Next Scheduled Task *@
        <div class="p-6 space-y-4">
            <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-muted-foreground uppercase tracking-tighter">Next Scheduled Task</span>
                <span class="font-mono text-amber-600 dark:text-amber-400 bg-amber-500/5 px-2 py-0.5 rounded">In 14m 22s</span>
            </div>
            <div class="flex items-center gap-3 rounded-lg border bg-muted/30 p-3">
                <div class="size-8 rounded bg-background border flex items-center justify-center shadow-sm">
                    <LucideIconCn Name="play" Size="12" Class="size-3 text-muted-foreground" />
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold truncate">backup_production_db_hourly</p>
                    <p class="text-[10px] text-muted-foreground font-medium">Cron: 0 * * * *</p>
                </div>
                <button type="button" class="text-[10px] font-black uppercase text-primary hover:tracking-widest transition-all">
                    Details
                </button>
            </div>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string Unit, string IconName, string Status, double[] Trend, double TrendMax);

    private static readonly StatItem[] _stats =
    [
        new("Success Rate", "99.4", "%", "refresh-ccw", "healthy",
            [98, 100, 95, 100, 100, 92, 100, 100, 97, 100, 100, 99], 100),
        new("Active Jobs", "124", "tasks", "calendar", "healthy",
            [109, 110, 107.5, 110, 110, 106, 110, 110, 108.5, 110, 110, 109.5], 110),
        new("Avg. Duration", "4.8", "min", "timer", "warning",
            [3.4, 3.0, 3.8, 3.0, 3.0, 4.2, 3.0, 3.0, 3.4, 3.0, 3.0, 3.2], 4.2),
    ];
}
