@* ============================================================
   Block: monitoring-snowflake-query-cost
   Title: MonitoringSnowflakeQueryCost
   Description: Professional Snowflake monitoring dashboard featuring query cost analysis, warehouse credit usage, and expensive query tracking with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-snowflake-query-cost.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-blue-500/10">
                    <LucideIconCn Name="coins" Size="16" Class="size-4 text-blue-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">Snowflake Cost</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Warehouse Credit Utilization
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-amber-500" />
                <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-600">+12% vs LW</span>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var borderClass = stat.Index != 2 ? "md:border-r border-b md:border-b-0" : "";
                <div class="p-4 @borderClass">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">@stat.Label</p>
                    <div class="flex items-baseline gap-1">
                        @if (stat.IsCurrency)
                        {
                            <span class="text-sm font-medium text-muted-foreground">$</span>
                        }
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@stat.DisplayValue</span>
                        @if (!stat.IsCurrency && !string.IsNullOrEmpty(stat.Unit))
                        {
                            <span class="text-xs text-muted-foreground font-medium">@stat.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Bar Chart — Weekly Credit Consumption *@
        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Weekly Credit Consumption</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">COMPUTE_WH_XL</BadgeCn>
            </div>
            <div class="h-40 w-full flex items-end gap-1">
                @foreach (var bar in _costData)
                {
                    var heightPct = (int)Math.Round(bar.Credits / _maxCredits * 100);
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-t-sm bg-foreground" style="@($"height:{heightPct}%")"></div>
                        <span class="text-[10px] text-muted-foreground">@bar.Day</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="database" Size="12" Class="size-3" />
                <span class="font-medium">Account: prod-us-east-1</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                Cost Explorer @("→")
            </button>
        </div>

    </div>
</section>

@code {
    private record StatItem(int Index, string Label, string DisplayValue, string Unit, bool IsCurrency);

    private record CostBar(string Day, double Credits);

    private static readonly CostBar[] _costData =
    [
        new("Mon", 12.5),
        new("Tue", 15.2),
        new("Wed", 28.4),
        new("Thu", 18.1),
        new("Fri", 14.2),
        new("Sat", 8.5),
        new("Sun", 7.2),
    ];

    private static readonly double _maxCredits = 28.4;

    private static readonly StatItem[] _stats =
    [
        new(0, "Daily Credits", "14.2", "",      false),
        new(1, "MTD Spend",     "412.50", "$",   true),
        new(2, "Active Wh",     "3",      "units", false),
    ];
}
