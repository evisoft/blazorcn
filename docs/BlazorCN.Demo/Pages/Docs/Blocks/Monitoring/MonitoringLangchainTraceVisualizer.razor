@* ============================================================
   Block: monitoring-langchain-trace-visualizer
   Title: MonitoringLangchainTraceVisualizer
   Description: Advanced AI monitoring dashboard featuring LangChain trace visualization, chain execution timing, and tool-use analytics with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-langchain-trace-visualizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-emerald-500/10">
                    <LucideIconCn Name="layers" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">LangChain Trace</h3>
                    <p class="mt-1 text-xs text-muted-foreground">Trace ID: trace_9823_af21</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Success</span>
            </div>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-1 border-b md:grid-cols-3">
            @foreach (var stat in _stats)
            {
                var s = stat;
                <div class="@Cn.Merge("p-4", s.BorderClass)">
                    <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">@s.Label</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">@s.Value</span>
                        <span class="text-xs font-medium text-muted-foreground">@s.Unit</span>
                    </div>
                </div>
            }
        </div>

        @* Steps *@
        <div class="divide-y p-0">
            @for (var i = 0; i < _steps.Length; i++)
            {
                var idx = i;
                var step = _steps[idx];
                var mlClass = idx == 0 ? "ml-0" : "ml-4";
                <div class="flex items-center gap-3 p-3 transition-colors hover:bg-muted/50">
                    <div class="@Cn.Merge("flex size-6 items-center justify-center rounded bg-muted", mlClass)">
                        @if (step.Type == "chain")
                        {
                            <LucideIconCn Name="play" Size="12" Class="size-3 fill-blue-500 text-blue-500" />
                        }
                        else if (step.Type == "llm")
                        {
                            <LucideIconCn Name="zap" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="search" Size="12" Class="size-3 text-muted-foreground" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-xs font-medium text-foreground">@step.Name</p>
                        <p class="text-[10px] uppercase tracking-tight text-muted-foreground">@step.Type</p>
                    </div>
                    <div class="font-mono text-[10px] text-muted-foreground">@(step.Duration)ms</div>
                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground" />
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-mono text-[10px] font-medium">main_qa_chain</span>
            </div>
            <button type="button" class="text-[10px] font-medium text-foreground hover:underline">
                Full LangSmith Trace →
            </button>
        </div>

    </div>
</section>

@code {
    private record TraceStep(string Name, string Type, int Duration, string Status);

    private record StatItem(string Label, string Value, string Unit, string BorderClass);

    private static readonly TraceStep[] _steps =
    [
        new("RetrievalQA",      "chain",  1200, "success"),
        new("VectorDBRetriever","tool",    450, "success"),
        new("ChatOpenAI",       "llm",     750, "success"),
        new("OutputParser",     "parser",   10, "success"),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Total Latency", "1.2", "s",      "md:border-r border-b md:border-b-0"),
        new("Steps",         "4",   "calls",  "md:border-r border-b md:border-b-0"),
        new("Total Tokens",  "850", "tokens", ""),
    ];
}
