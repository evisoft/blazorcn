@* ============================================================
   Block: monitoring-dbt-run-history
   Title: MonitoringDbtRunHistory
   Description: Professional dbt monitoring dashboard featuring model execution status, test results, and transformation latency trends with shadcn/ui and Framer Motion.
   Source: original/blocks/monitoring/monitoring-dbt-run-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-orange-500/10">
                    <LucideIconCn Name="database" Size="16" Class="size-4 text-orange-600" />
                </div>
                <div>
                    <h3 class="text-sm font-medium leading-none">dbt Runs</h3>
                    <p class="mt-1 text-muted-foreground text-xs">Transformation Pipeline Health</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] h-5 font-normal">v1.7.4</BadgeCn>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 border-b">
            @for (int idx = 0; idx < _stats.Length; idx++)
            {
                var stat = _stats[idx];
                var i = idx;
                <div class="@($"p-4{(i != 3 ? " border-r" : "")}{(i > 1 ? " md:border-t-0 border-t" : "")}")">
                    <div class="flex items-center gap-1.5 mb-1">
                        <LucideIconCn Name="@stat.IconName" Size="12" Class="@($"size-3 {stat.Color}")" />
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">@stat.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-xl font-semibold tabular-nums tracking-tight">@stat.ValueDisplay</span>
                        @if (!string.IsNullOrEmpty(stat.Unit))
                        {
                            <span class="text-xs text-muted-foreground">@stat.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="p-4">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Run Duration Trend (seconds)</span>
                <div class="flex gap-1.5">
                    @foreach (var run in _runData)
                    {
                        var dotColor = run.Status == "success" ? "bg-emerald-500"
                                     : run.Status == "warning" ? "bg-amber-500"
                                     : "bg-red-500";
                        <div class="@($"size-2 rounded-full {dotColor}")"></div>
                    }
                </div>
            </div>
            <div class="h-32 w-full">
                @{
                    var data = _runData;
                    var count = data.Length;
                    var chartW = 400;
                    var chartH = 128;
                    var maxDur = data.Max(d => d.Duration);
                    var barWidth = count > 0 ? (double)chartW / count * 0.6 : 30;
                    var barSpacing = count > 0 ? (double)chartW / count : 0;
                }
                <svg viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" class="w-full h-full">
                    @for (int bi = 0; bi < count; bi++)
                    {
                        var run = data[bi];
                        var barH = maxDur > 0 ? (double)run.Duration / maxDur * chartH : 0;
                        var x = bi * barSpacing + (barSpacing - barWidth) / 2;
                        var y = chartH - barH;
                        var barFill = run.Status == "success" ? "var(--foreground)"
                                    : run.Status == "warning" ? "#f59e0b"
                                    : "#ef4444";
                        <rect x="@($"{x:F1}")" y="@($"{y:F1}")" width="@($"{barWidth:F1}")" height="@($"{barH:F1}")" fill="@barFill" rx="2" ry="2" />
                    }
                </svg>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between border-t">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium">Project: analytics_prod</span>
            </div>
            <button type="button" class="text-[10px] font-medium hover:underline text-foreground">
                View Manifest →
            </button>
        </div>
    </div>
</section>

@code {
    private record RunPoint(int Run, int Duration, string Status);

    private record StatItem(string Label, string ValueDisplay, string IconName, string Color, string Unit);

    private static readonly RunPoint[] _runData =
    [
        new(1, 240, "success"),
        new(2, 210, "success"),
        new(3, 320, "warning"),
        new(4, 250, "success"),
        new(5, 280, "failed"),
        new(6, 230, "success"),
        new(7, 245, "success"),
    ];

    private static readonly StatItem[] _stats =
    [
        new("Total Models",  "412",  "file-text",      "text-muted-foreground", ""),
        new("Tests Passed",  "1240", "check-circle-2", "text-emerald-500",      ""),
        new("Failures",      "2",    "x-circle",       "text-red-500",          ""),
        new("Avg Run",       "12.4", "play",           "text-muted-foreground", "m"),
    ];
}
