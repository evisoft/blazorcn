@* ============================================================
   Block: pricing-slide-deck-carousel
   Title: PricingSlideDeckCarousel
   Description: A horizontal scroll-snap carousel pricing section for React and Next.js with four full-width presentation-slide plan panels prev and next arrow buttons progress dot pagination and a slide counter indicator built with shadcn/ui motion/react and Tailwind CSS
   Source: original/blocks/pricing/pricing-slide-deck-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Plan deck
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Walk through every plan
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Each plan gets its own slide. Swipe or use the arrow keys to browse the deck and find the
            one that fits.
        </p>
    </div>

    @* Controls row *@
    <div class="mt-8 flex items-center justify-between gap-4">
        <div class="text-xs font-medium text-muted-foreground tabular-nums"
             aria-live="polite"
             aria-atomic="true">
            Slide <span class="text-foreground">@(_activeIndex + 1)</span>
            <span class="mx-1 text-muted-foreground/40">/</span>
            @_plans.Length
        </div>
        <div class="flex items-center gap-2">
            <button type="button"
                    @onclick="GoPrev"
                    disabled="@(_activeIndex == 0)"
                    aria-label="Previous slide"
                    class="flex size-9 items-center justify-center rounded-full border bg-background text-muted-foreground transition-colors hover:border-foreground/40 hover:text-foreground disabled:cursor-not-allowed disabled:opacity-40">
                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" aria-hidden="true" />
            </button>
            <button type="button"
                    @onclick="GoNext"
                    disabled="@(_activeIndex == _plans.Length - 1)"
                    aria-label="Next slide"
                    class="flex size-9 items-center justify-center rounded-full border bg-background text-muted-foreground transition-colors hover:border-foreground/40 hover:text-foreground disabled:cursor-not-allowed disabled:opacity-40">
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" aria-hidden="true" />
            </button>
        </div>
    </div>

    @* Scroll-snap carousel *@
    <div role="region"
         aria-roledescription="carousel"
         aria-label="Pricing plan deck"
         class="mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        @foreach (var plan in _plans)
        {
            var idx = System.Array.IndexOf(_plans, plan);
            <article data-slide-index="@idx"
                     aria-roledescription="slide"
                     aria-label="@($"{plan.Name} — slide {idx + 1} of {_plans.Length}")"
                     class="@Cn.Merge("relative flex min-w-full shrink-0 snap-start flex-col overflow-hidden rounded-2xl bg-muted p-6 sm:p-8", plan.IsPopular ? "ring-2 ring-foreground/15" : "")">
                @* Header row: badge + slide number *@
                <div class="flex h-7 items-start justify-between">
                    @if (plan.IsPopular)
                    {
                        <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                    else
                    {
                        <span></span>
                    }
                    <span class="rounded-full border bg-background px-2.5 py-1 text-[10px] font-mono font-semibold tabular-nums text-muted-foreground">
                        @((idx + 1).ToString().PadLeft(2, '0')) / @(_plans.Length.ToString().PadLeft(2, '0'))
                    </span>
                </div>

                @* Slide body — two columns on desktop *@
                <div class="mt-6 grid flex-1 gap-6 md:grid-cols-[1.1fr_1fr] md:gap-10">
                    @* Left: identity + price *@
                    <div class="flex flex-col">
                        <div class="flex size-12 items-center justify-center rounded-xl border bg-background">
                            <LucideIconCn Name="@plan.IconName" Size="20" Class="size-5 text-foreground" aria-hidden="true" />
                        </div>
                        <h3 class="mt-5 text-3xl font-bold tracking-tight">@plan.Name</h3>
                        <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted-foreground">
                            @plan.Tagline
                        </p>

                        <div class="mt-6 flex items-baseline gap-1.5">
                            @if (plan.MonthlyPrice == null)
                            {
                                <span class="text-5xl font-bold leading-none tracking-tight">Custom</span>
                            }
                            else if (plan.MonthlyPrice == 0)
                            {
                                <span class="text-5xl font-bold leading-none tracking-tight">Free</span>
                            }
                            else
                            {
                                <span class="text-5xl font-bold leading-none tracking-tight tabular-nums">$@plan.MonthlyPrice</span>
                                <span class="text-sm text-muted-foreground">/month</span>
                            }
                        </div>
                        @if (plan.PriceLabel != null)
                        {
                            <p class="mt-2 text-xs text-muted-foreground">@plan.PriceLabel</p>
                        }

                        @* SLA chip *@
                        <div class="mt-5 inline-flex w-fit items-center gap-1.5 rounded-full border border-emerald-600/20 bg-emerald-500/5 px-3 py-1.5">
                            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                            <span class="text-[11px] font-medium text-foreground">@plan.Sla</span>
                        </div>

                        <div class="mt-auto pt-6">
                            <ButtonCn Class="w-full sm:w-[220px]">@plan.Cta</ButtonCn>
                        </div>
                    </div>

                    @* Right: features *@
                    <div class="flex flex-col">
                        <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                            What's included
                        </p>
                        <ul class="mt-4 grid gap-2.5 sm:grid-cols-2 md:grid-cols-1">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-2.5">
                                    <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                    <span class="text-sm font-medium text-foreground">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </article>
        }
    </div>

    @* Progress dots *@
    <div class="mt-5 flex items-center justify-center gap-2"
         role="tablist"
         aria-label="Carousel navigation">
        @foreach (var plan in _plans)
        {
            var dotIdx = System.Array.IndexOf(_plans, plan);
            var dotPlan = plan;
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeIndex == dotIdx ? "true" : "false")"
                    aria-label="@($"Go to {dotPlan.Name} slide")"
                    @onclick="@(() => _activeIndex = dotIdx)"
                    class="@Cn.Merge("h-1.5 rounded-full transition-all", _activeIndex == dotIdx ? "w-8 bg-foreground" : "w-1.5 bg-muted-foreground/30 hover:bg-muted-foreground/60")">
            </button>
        }
    </div>

    @* Trust text *@
    <p class="mt-7 text-center text-xs text-muted-foreground">
        All paid plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private int _activeIndex = 2;

    private void GoPrev() => _activeIndex = Math.Max(0, _activeIndex - 1);
    private void GoNext() => _activeIndex = Math.Min(_plans.Length - 1, _activeIndex + 1);

    private record SlideItem(
        string Id,
        string Name,
        string Tagline,
        string IconName,
        int? MonthlyPrice,
        string? PriceLabel,
        string Sla,
        string[] Features,
        string Cta,
        bool IsPopular
    );

    private static readonly SlideItem[] _plans =
    [
        new("starter", "Starter", "For makers shipping their first project.", "sparkles", 0, "Forever free", "Community support",
            ["Up to 3 active projects", "1 GB storage with CDN", "Community Discord channel", "Public deploy previews", "Basic usage analytics", "1 team member"],
            "Get started free", false),
        new("growth", "Growth", "For indie hackers scaling past side-project revenue.", "rocket", 29, null, "48h email support",
            ["Unlimited projects", "50 GB storage with CDN", "Email support (48h SLA)", "Custom domains with SSL", "Advanced analytics dashboard", "Up to 3 team members"],
            "Start 14-day trial", false),
        new("team", "Team", "For growing teams that ship production software daily.", "zap", 79, null, "4h priority SLA",
            ["Everything in Growth", "250 GB storage with edge cache", "Priority chat & email (4h SLA)", "Up to 15 team members", "Custom workflows and webhooks", "Audit logs (90-day retention)"],
            "Start 14-day trial", true),
        new("enterprise", "Enterprise", "For organizations with SSO, compliance, and scale needs.", "building", null, "Custom quote", "99.99% uptime SLA",
            ["Unlimited team members", "Unlimited storage, global CDN", "Dedicated account manager", "SAML SSO with SCIM sync", "1-year audit log retention", "SOC 2 Type II under NDA"],
            "Contact sales", false),
    ];
}
