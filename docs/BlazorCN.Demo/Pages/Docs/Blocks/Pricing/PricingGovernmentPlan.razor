@* ============================================================
   Block: pricing-government-plan
   Title: PricingGovernmentPlan
   Description: A government and public sector pricing comparison table for React and Next.js with marketing headline, compliance badges row, three plan column headers showing Department, Agency, and Federal tiers with annual pricing and ShadcnioButton CTAs, feature comparison matrix grouped by Compliance, Identity, Support, and Procurement categories with emerald checkmarks, and procurement trust messaging built with shadcn/ui Table and Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-government-plan.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <div class="flex items-center justify-center gap-2">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Government &amp; Public Sector
            </p>
        </div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Built for government compliance
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground leading-relaxed">
            Purpose-built for federal, state, and local agencies. Procurement-friendly pricing with
            GSA Schedule, annual billing, and full compliance documentation.
        </p>

        @* Compliance badges *@
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            @foreach (var badge in _complianceBadges)
            {
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted px-3 py-1 text-xs font-medium text-foreground">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                    @badge
                </span>
            }
        </div>
    </div>

    @* Comparison table *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-background">
        <TableCn Class="w-full min-w-[910px] table-fixed">
            @* Header: plan columns with name, price, CTA *@
            <TableHeaderCn>
                <TableRowCn Class="hover:bg-transparent">
                    <TableHeadCn Class="w-[280px] bg-muted/50 px-6 py-6 align-bottom">
                        <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                            Compare plans
                        </p>
                        <p class="mt-1 text-sm text-muted-foreground">
                            All plans billed annually with full ATO support.
                        </p>
                    </TableHeadCn>

                    @foreach (var plan in _planColumns)
                    {
                        <TableHeadCn Class="@Cn.Merge("relative w-[210px] px-5 py-6 align-top text-left", plan.IsHighlighted ? "bg-muted" : "")">
                            @if (!string.IsNullOrEmpty(plan.Badge))
                            {
                                <span class="absolute right-5 top-5 rounded-full bg-red-500 px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                    @plan.Badge
                                </span>
                            }

                            <h3 class="text-xl font-bold tracking-tight text-foreground">
                                @plan.Name
                            </h3>
                            <p class="mt-1 text-xs text-muted-foreground">@plan.Description</p>

                            <div class="mt-4 flex items-baseline gap-1">
                                <span class="text-3xl font-bold tracking-tight tabular-nums text-foreground">
                                    @FormatPrice(plan.AnnualPrice)
                                </span>
                                @if (plan.AnnualPrice.HasValue)
                                {
                                    <span class="text-xs text-muted-foreground">/year</span>
                                }
                            </div>

                            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 w-full min-w-0">
                                @plan.Cta
                            </ButtonCn>
                        </TableHeadCn>
                    }
                </TableRowCn>
            </TableHeaderCn>

            @* Body: feature rows grouped by category *@
            <TableBodyCn>
                @foreach (var cat in _featureCategories)
                {
                    @* Category header row *@
                    <TableRowCn Class="border-t bg-muted/30 hover:bg-muted/30">
                        <TableCellCn Colspan="4" Class="px-6 py-2.5 text-[11px] font-bold uppercase tracking-widest text-muted-foreground">
                            @cat.Name
                        </TableCellCn>
                    </TableRowCn>

                    @* Feature rows *@
                    @foreach (var feature in cat.Features)
                    {
                        <TableRowCn Class="border-t">
                            <TableCellCn Class="px-6 py-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium text-foreground">
                                        @feature.Name
                                    </span>
                                    @if (!string.IsNullOrEmpty(feature.Tooltip))
                                    {
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <button type="button" aria-label="@($"More info about {feature.Name}")">
                                                    <LucideIconCn Name="info" Size="14" Class="size-3.5 cursor-help text-muted-foreground/40 transition-colors hover:text-muted-foreground" />
                                                </button>
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[260px]">
                                                <p class="text-xs">@feature.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    }
                                </div>
                            </TableCellCn>

                            @foreach (var plan in _planColumns)
                            {
                                var cellVal = feature.Values.GetValueOrDefault(plan.Id, "false");
                                <TableCellCn Class="@Cn.Merge("px-5 py-3 text-center", plan.IsHighlighted ? "bg-muted/40" : "")">
                                    @if (cellVal == "true")
                                    {
                                        <LucideIconCn Name="check" Size="20" StrokeWidth="3" Class="mx-auto size-5 text-emerald-600 dark:text-emerald-500" aria-label="Included" />
                                    }
                                    else if (cellVal == "false")
                                    {
                                        <LucideIconCn Name="minus" Size="16" Class="mx-auto size-4 text-muted-foreground/30" aria-label="Not included" />
                                    }
                                    else
                                    {
                                        <span class="text-sm font-semibold tabular-nums text-foreground">@cellVal</span>
                                    }
                                </TableCellCn>
                            }
                        </TableRowCn>
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans billed annually · Available via GSA Schedule and direct procurement · BAA and SOW
        available upon request
    </p>
</section>

@code {
    private record PlanColumn(string Id, string Name, string Description, int? AnnualPrice, string Cta, bool IsHighlighted, string? Badge = null);
    private record ComparisonFeature(string Name, string? Tooltip, Dictionary<string, string> Values);
    private record FeatureCategory(string Name, ComparisonFeature[] Features);

    private static readonly string[] _complianceBadges =
    [
        "FedRAMP Authorized",
