@* ============================================================
   Block: pricing-treemap-quota
   Title: PricingTreemapQuota
   Description: A treemap quota pricing section for React and Next.js with three plan cards each containing a treemap visualization where rectangle area represents relative quota allocation across compute storage bandwidth and seats plus a NumberFlow animated price and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-treemap-quota.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Resource allocation
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            See how each plan splits the pie
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
            Every card below is a resource treemap. Rectangle area shows how much of each plan goes to
            compute, storage, bandwidth, and team seats.
        </p>
    </div>

    @* Legend *@
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        @foreach (var cat in _categories)
        {
            <div class="flex items-center gap-2">
                <svg class="size-3" viewBox="0 0 12 12" aria-hidden="true">
                    <rect x="0" y="0" width="12" height="12" rx="2" class="@cat.FillClass" />
                </svg>
                <span class="text-[11px] font-medium text-muted-foreground">@cat.Label</span>
            </div>
        }
    </div>

    @* Plan cards *@
    <div class="mx-auto mt-8 grid max-w-lg gap-4 md:max-w-none md:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var rects = ComputeTreemap(plan);
            var ariaLabel = BuildAriaLabel(plan);
            <article class="@Cn.Merge("flex h-full flex-col overflow-hidden rounded-2xl bg-muted", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                <div class="flex flex-1 flex-col px-6 pb-6 pt-6">
                    @* Badge slot *@
                    <div class="mb-4 flex h-6 items-center">
                        @if (plan.IsPopular)
                        {
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        }
                    </div>

                    <h3 class="text-lg font-bold tracking-tight">@plan.Name</h3>
                    <p class="mt-1 text-xs uppercase tracking-wider text-muted-foreground">
                        @plan.Tagline
                    </p>

                    @* Treemap *@
                    <div class="mt-5 overflow-hidden rounded-xl border border-foreground/10 bg-background/40 p-3">
                        <svg viewBox="@(FormattableString.Invariant($"0 0 {TreemapWidth} {TreemapHeight}"))"
                             class="h-auto w-full"
                             role="img"
                             aria-label="@ariaLabel">
                            @foreach (var rect in rects)
                            {
                                var rx = rect.X + 2;
                                var ry = rect.Y + 2;
                                var rw = Math.Max(0, rect.Width - 4);
                                var rh = Math.Max(0, rect.Height - 4);
                                var showLabel = rect.Width > 60 && rect.Height > 32;
                                <rect x="@rx.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                      y="@ry.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                      width="@rw.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                      height="@rh.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                      rx="6"
                                      class="@Cn.Merge(rect.Category.FillClass, "transition-opacity opacity-90")" />
                                @if (showLabel)
                                {
                                    var lx = rect.X + 12;
                                    var ly1 = rect.Y + 22;
                                    var ly2 = rect.Y + 40;
                                    @((MarkupString)FormattableString.Invariant($"<text x=\"{lx:F2}\" y=\"{ly1:F2}\" class=\"text-[9px] font-semibold uppercase tracking-wider {rect.Category.TextClass}\">{rect.Category.Label}</text>"))
                                    @((MarkupString)FormattableString.Invariant($"<text x=\"{lx:F2}\" y=\"{ly2:F2}\" class=\"text-sm font-bold tabular-nums {rect.Category.TextClass}\">{rect.Display}</text>"))
                                }
                            }
                        </svg>
                    </div>

                    @* Compact quota list *@
                    <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-1.5">
                        @foreach (var cat in _categories)
                        {
                            var displayVal = plan.Allocations.TryGetValue(cat.Key, out var alloc) ? alloc.Display : "—";
                            <div class="flex items-baseline justify-between gap-1">
                                <dt class="text-[10px] uppercase tracking-wider text-muted-foreground">@cat.Label</dt>
                                <dd class="font-mono text-xs tabular-nums text-foreground">@displayVal</dd>
                            </div>
                        }
                    </dl>

                    @* Price *@
                    <div class="mt-5 flex h-12 items-baseline gap-1 sm:h-14">
                        <span class="text-4xl font-bold tracking-tight tabular-nums">$@plan.MonthlyPrice</span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>
                    <p class="text-xs text-muted-foreground">Billed monthly, cancel anytime</p>

                    @* CTA *@
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full">@plan.Cta</ButtonCn>

                    @* Features *@
                    <ul class="mt-5 flex-1 space-y-2">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start gap-2">
                                <LucideIconCn Name="check" Size="14" Class="mt-0.5 size-3.5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                <span class="text-xs font-medium text-foreground">@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    // ── Treemap constants ───────────────────────────────────────────────
    private const double TreemapWidth  = 300;
    private const double TreemapHeight = 200;

    // ── Data types ──────────────────────────────────────────────────────
    private record Category(string Key, string Label, string FillClass, string TextClass);

    private record Allocation(int Weight, string Display);

    private record Plan(
        string Id,
        string Name,
        string Tagline,
        int MonthlyPrice,
        Dictionary<string, Allocation> Allocations,
        string[] Features,
        string Cta,
        bool IsPopular
    );

    private record TreemapRect(
        double X,
        double Y,
        double Width,
        double Height,
        Category Category,
        string Display
    );

    // ── Static data ─────────────────────────────────────────────────────
    private static readonly Category[] _categories =
    [
        new("compute",   "Compute",   "fill-foreground",     "fill-background"),
        new("storage",   "Storage",   "fill-foreground/60",  "fill-background"),
        new("bandwidth", "Bandwidth", "fill-foreground/35",  "fill-foreground"),
        new("seats",     "Seats",     "fill-foreground/15",  "fill-foreground"),
    ];

    private static readonly Plan[] _plans =
    [
        new(
            "starter",
            "Starter",
            "Solo builders",
            29,
            new Dictionary<string, Allocation>
            {
                ["compute"]   = new(4, "4 vCPU"),
                ["storage"]   = new(3, "40 GB"),
                ["bandwidth"] = new(3, "200 GB"),
                ["seats"]     = new(2, "3 seats"),
            },
            ["Community support", "10 integrations", "SSL and 2FA"],
            "Start free trial",
            false
        ),
        new(
            "pro",
            "Pro",
            "Scaling teams",
            149,
            new Dictionary<string, Allocation>
            {
                ["compute"]   = new(9, "16 vCPU"),
                ["storage"]   = new(6, "500 GB"),
                ["bandwidth"] = new(5, "2 TB"),
                ["seats"]     = new(5, "25 seats"),
            },
            ["Priority support, 4h SLA", "Unlimited integrations", "SSO + audit logs", "99.95% uptime SLA"],
            "Start free trial",
            true
        ),
        new(
            "enterprise",
            "Enterprise",
            "Mission-critical",
            599,
            new Dictionary<string, Allocation>
            {
                ["compute"]   = new(14, "64 vCPU"),
                ["storage"]   = new(10, "5 TB"),
                ["bandwidth"] = new(9, "20 TB"),
                ["seats"]     = new(8, "Unlimited"),
            },
            ["Dedicated success manager", "Custom integrations", "SOC2, HIPAA, DPA", "99.99% uptime with credits"],
            "Contact sales",
            false
        ),
    ];

    // ── Treemap algorithm ───────────────────────────────────────────────
    // Squarified treemap (simplified slice-and-dice). Largest category gets
    // the biggest slice; remaining categories laid out in descending order.
    private static TreemapRect[] ComputeTreemap(Plan plan)
    {
        var items = new List<(Category Category, int Weight, string Display)>();
        foreach (var cat in _categories)
        {
            if (plan.Allocations.TryGetValue(cat.Key, out var alloc))
                items.Add((cat, alloc.Weight, alloc.Display));
            else
                items.Add((cat, 0, ""));
        }
        items.Sort((a, b) => b.Weight - a.Weight);

        var totalWeight = 0;
        foreach (var it in items) totalWeight += it.Weight;
        if (totalWeight == 0) return [];

        var rects = new List<TreemapRect>();
        var rx = 0.0;
        var ry = 0.0;
        var rw = TreemapWidth;
        var rh = TreemapHeight;
        var remainingWeight = (double)totalWeight;

        for (int i = 0; i < items.Count; i++)
        {
            var item = items[i];
            var isLast = i == items.Count - 1;

            if (isLast)
            {
                rects.Add(new TreemapRect(rx, ry, rw, rh, item.Category, item.Display));
                break;
            }

            var ratio = item.Weight / remainingWeight;
            var sliceLong = rw >= rh;

            if (sliceLong)
            {
                var sliceWidth = rw * ratio;
                rects.Add(new TreemapRect(rx, ry, sliceWidth, rh, item.Category, item.Display));
                rx += sliceWidth;
                rw -= sliceWidth;
            }
            else
            {
                var sliceHeight = rh * ratio;
                rects.Add(new TreemapRect(rx, ry, rw, sliceHeight, item.Category, item.Display));
                ry += sliceHeight;
                rh -= sliceHeight;
            }

            remainingWeight -= item.Weight;
        }

        return [.. rects];
    }

    // ── Aria label builder ──────────────────────────────────────────────
    private static string BuildAriaLabel(Plan plan)
    {
        var parts = new System.Text.StringBuilder();
        parts.Append(plan.Name);
        parts.Append(" plan resource allocation: ");
        var first = true;
        foreach (var cat in _categories)
        {
            if (!first) parts.Append(", ");
            first = false;
            var display = plan.Allocations.TryGetValue(cat.Key, out var alloc) ? alloc.Display : "";
            parts.Append(cat.Label);
            parts.Append(' ');
            parts.Append(display);
        }
        return parts.ToString();
    }
}
