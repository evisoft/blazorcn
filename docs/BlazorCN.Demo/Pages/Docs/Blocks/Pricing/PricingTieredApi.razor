@* ============================================================
   Block: pricing-tiered-api
   Title: PricingTieredApi
   Description: A four-column pricing comparison table for React and Next.js with embedded CTA header cells showing plan name price primary quantity metric per-unit pricing and ShadcnioButton together, grouped feature rows with quantity values and checkmark or dash cells, a highlighted popular middle column with red Best Value badge, and horizontal scroll on mobile built with shadcn/ui Table and Tailwind CSS
   Source: original/blocks/pricing/pricing-tiered-api.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            API Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Scale from prototype to production
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Start free with 10,000 requests per month. Upgrade as your traffic grows. Every tier
            includes REST, SDK libraries, and real-time monitoring.
        </p>
    </div>

    @* Comparison table *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
        <div class="overflow-x-auto">
            <TableCn Class="w-full min-w-[1020px] table-fixed">
                <TableHeaderCn>
                    <TableRowCn Class="hover:bg-transparent">
                        <TableHeadCn Class="w-[220px] border-r border-border bg-card py-6 pl-6 align-bottom font-normal text-muted-foreground">
                            <span class="text-xs font-semibold uppercase tracking-widest">
                                Compare plans
                            </span>
                        </TableHeadCn>
                        @foreach (var plan in _planColumns)
                        {
                            <TableHeadCn Class="@Cn.Merge("w-[200px] border-r border-border py-6 text-center align-top last:border-r-0", plan.IsPopular ? "bg-muted" : "")">
                                @* Reserved badge slot — rendered on every column for Y-alignment *@
                                <div class="mb-2 flex h-6 items-start justify-center">
                                    @if (plan.IsPopular)
                                    {
                                        <span class="inline-block rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                            Best Value
                                        </span>
                                    }
                                </div>
                                <div class="flex flex-col items-center gap-2 px-3">
                                    <span class="text-base font-bold text-foreground">@plan.Name</span>
                                    <div class="flex items-baseline gap-0.5">
                                        @if (plan.Price != null)
                                        {
                                            <span class="text-3xl font-bold tracking-tight tabular-nums text-foreground">
                                                @(plan.Price == 0 ? "$0" : $"${plan.Price}")
                                            </span>
                                            <span class="text-xs text-muted-foreground">@plan.Period</span>
                                        }
                                        else
                                        {
                                            <span class="text-3xl font-bold tracking-tight text-foreground">
                                                Custom
                                            </span>
                                        }
                                    </div>
                                    <p class="text-xs font-semibold text-foreground tabular-nums">
                                        @plan.Requests
                                    </p>
                                    <p class="text-[10px] text-muted-foreground">@plan.PerRequest</p>
                                    <ButtonCn Size="ButtonSize.Sm" Class="mt-2 w-full">
                                        @plan.Cta
                                    </ButtonCn>
                                </div>
                            </TableHeadCn>
                        }
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var category in _categories)
                    {
                        var categoryFeatures = _featureRows.Where(f => f.Category == category).ToArray();
                        @* Category header *@
                        <TableRowCn Class="hover:bg-transparent">
                            <TableCellCn Colspan="@(_planColumns.Length + 1)" Class="border-y border-border bg-muted/40 py-2.5 pl-6">
                                <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                    @category
                                </span>
                            </TableCellCn>
                        </TableRowCn>
                        @* Feature rows *@
                        @foreach (var feature in categoryFeatures)
                        {
                            <TableRowCn Class="hover:bg-muted/20">
                                <TableCellCn Class="border-r border-border py-3 pl-6 text-sm font-medium text-foreground">
                                    @feature.Name
                                </TableCellCn>
                                @foreach (var plan in _planColumns)
                                {
                                    var value = feature.Values.GetValueOrDefault(plan.Id, "");
                                    <TableCellCn Class="@Cn.Merge("border-r border-border py-3 text-center last:border-r-0", plan.IsPopular ? "bg-muted" : "")">
                                        @if (value == "true")
                                        {
                                            <LucideIconCn Name="check" Size="16" Class="mx-auto size-4 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-label="Included" />
                                        }
                                        else if (value == "false" || value == "")
                                        {
                                            <LucideIconCn Name="minus" Size="16" Class="mx-auto size-4 text-muted-foreground/30" aria-label="Not included" />
                                        }
                                        else
                                        {
                                            <span class="text-sm font-medium tabular-nums text-foreground">@value</span>
                                        }
                                    </TableCellCn>
                                }
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        @* Footer *@
        <div class="border-t border-border bg-card px-6 py-4 text-center">
            <p class="text-xs text-muted-foreground">
                Free tier requires no credit card. All paid plans include a 14-day trial. SDKs available
                for Python, Node.js, Go, Ruby, and Java.
            </p>
        </div>
    </div>
</section>

@code {
    private record PlanColumn(string Id, string Name, int? Price, string Period, string Requests, string PerRequest, string Cta, bool IsPopular);
    private record ComparisonFeature(string Name, string Category, Dictionary<string, string> Values);

    private static readonly PlanColumn[] _planColumns =
    [
        new("free", "Free", 0, "/mo", "10K req/mo", "Free tier", "Get API key", false),
        new("developer", "Developer", 29, "/mo", "100K req/mo", "$0.29 per 1K extra", "Start trial", false),
        new("business", "Business", 199, "/mo", "1M req/mo", "$0.20 per 1K extra", "Start trial", true),
        new("enterprise", "Enterprise", null, "", "10M+ req/mo", "Volume pricing", "Contact sales", false),
    ];

    private static readonly ComparisonFeature[] _featureRows =
    [
        new("Requests per second", "Rate Limits", new() { ["free"] = "10/sec", ["developer"] = "100/sec", ["business"] = "1,000/sec", ["enterprise"] = "Custom" }),
        new("Burst limit (10s window)", "Rate Limits", new() { ["free"] = "20", ["developer"] = "500", ["business"] = "5,000", ["enterprise"] = "Custom" }),
        new("Concurrent connections", "Rate Limits", new() { ["free"] = "5", ["developer"] = "50", ["business"] = "500", ["enterprise"] = "Unlimited" }),
        new("Overage handling", "Rate Limits", new() { ["free"] = "Hard cap, 429", ["developer"] = "Auto-scale + bill", ["business"] = "Auto-scale + bill", ["enterprise"] = "Custom SLA" }),
        new("API key authentication", "Authentication", new() { ["free"] = "true", ["developer"] = "true", ["business"] = "true", ["enterprise"] = "true" }),
        new("OAuth 2.0 / OIDC", "Authentication", new() { ["free"] = "false", ["developer"] = "true", ["business"] = "true", ["enterprise"] = "true" }),
        new("Mutual TLS (mTLS)", "Authentication", new() { ["free"] = "false", ["developer"] = "false", ["business"] = "true", ["enterprise"] = "true" }),
        new("IP allowlisting", "Authentication", new() { ["free"] = "false", ["developer"] = "false", ["business"] = "50 IPs", ["enterprise"] = "Unlimited" }),
        new("REST API", "Endpoints", new() { ["free"] = "true", ["developer"] = "true", ["business"] = "true", ["enterprise"] = "true" }),
        new("GraphQL API", "Endpoints", new() { ["free"] = "false", ["developer"] = "true", ["business"] = "true", ["enterprise"] = "true" }),
        new("Webhook delivery", "Endpoints", new() { ["free"] = "5 endpoints", ["developer"] = "25 endpoints", ["business"] = "100 endpoints", ["enterprise"] = "Unlimited" }),
        new("Streaming / SSE", "Endpoints", new() { ["free"] = "false", ["developer"] = "false", ["business"] = "true", ["enterprise"] = "true" }),
        new("Uptime SLA", "Support", new() { ["free"] = "99.0%", ["developer"] = "99.9%", ["business"] = "99.95%", ["enterprise"] = "99.99%" }),
        new("Support channel", "Support", new() { ["free"] = "Community", ["developer"] = "Email, 24h", ["business"] = "Slack, 4h", ["enterprise"] = "Dedicated" }),
    ];

    private static readonly string[] _categories =
        _featureRows.Select(f => f.Category).Distinct().ToArray();
}
