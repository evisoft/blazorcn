@* ========================================
   Block: pricing-stacked-cards
   Title: Pricing Stacked Cards
   Description: Overlapping stacked pricing cards with depth effect where the featured plan rises above secondary options
   Long Description: Cards with gradient border accents
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideCrownCn
   Source: original/blocks/pricing/pricing-stacked-cards.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-20">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Choose your creative edge
            </h2>
            <p class="text-muted-foreground text-lg">
                Every plan unlocks powerful tools. Go Pro for the full experience.
            </p>
        </div>

        <div class="mx-auto max-w-5xl">
            @* Mobile: stacked vertically, popular first *@
            <div class="flex flex-col gap-6 md:hidden">
                @foreach (var plan in new[] { _plans[1], _plans[0], _plans[2] })
                {
                    <CardCn Class="@Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20" : "border-border")">
                        @if (plan.IsPopular)
                        {
                            <div class="absolute -top-3 right-4">
                                <BadgeCn Class="gap-1">
                                    <LucideCrownCn Class="h-3 w-3" Size="12" />
                                    Recommended
                                </BadgeCn>
                            </div>
                        }
                        <CardHeaderCn Class="pb-4">
                            <h3 class="text-lg font-semibold">@plan.Name</h3>
                            <div class="mt-2 flex items-baseline gap-1">
                                <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                                <span class="text-muted-foreground text-sm">@plan.Period</span>
                            </div>
                            <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                        </CardHeaderCn>
                        <CardContentCn Class="flex-1">
                            <ul class="space-y-3">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-start gap-3">
                                        <LucideCheckCn Class="text-primary mt-0.5 h-4 w-4 shrink-0" Size="16" />
                                        <span class="text-sm">@feature</span>
                                    </li>
                                }
                            </ul>
                        </CardContentCn>
                        <CardFooterCn Class="pt-4">
                            <ButtonCn Class="w-full" Size="ButtonSize.Lg"
                                      Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                                @plan.Cta
                            </ButtonCn>
                        </CardFooterCn>
                    </CardCn>
                }
            </div>

            @* Desktop: overlapping layout *@
            <div class="hidden items-center md:flex">
                @for (var i = 0; i < _plans.Length; i++)
                {
                    var plan = _plans[i];
                    var idx = i;
                    <CardCn Class="@Cn.Merge("relative flex flex-col", plan.IsPopular ? "z-10 -mx-2 scale-105 border-primary shadow-2xl ring-1 ring-primary/20 lg:-mx-4" : "border-border shadow-sm", idx == 0 ? "z-0" : "", idx == 2 ? "z-0" : "")"
                            style="@(plan.IsPopular ? "flex: 1.15" : "flex: 1")">
                        @if (plan.IsPopular)
                        {
                            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                                <BadgeCn Class="gap-1 px-3">
                                    <LucideCrownCn Class="h-3 w-3" Size="12" />
                                    Recommended
                                </BadgeCn>
                            </div>
                        }
                        <CardHeaderCn Class="@Cn.Merge("pb-4", plan.IsPopular ? "pt-6" : "")">
                            <h3 class="@Cn.Merge("font-semibold", plan.IsPopular ? "text-xl" : "text-lg")">@plan.Name</h3>
                            <div class="mt-2 flex items-baseline gap-1">
                                <span class="@Cn.Merge("font-bold tracking-tight", plan.IsPopular ? "text-5xl" : "text-4xl")">$@plan.Price</span>
                                <span class="text-muted-foreground text-sm">@plan.Period</span>
                            </div>
                            <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                        </CardHeaderCn>
                        <CardContentCn Class="flex-1">
                            <ul class="space-y-3">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-start gap-3">
                                        <LucideCheckCn Class="@Cn.Merge("mt-0.5 h-4 w-4 shrink-0", plan.IsPopular ? "text-primary" : "text-muted-foreground")" Size="16" />
                                        <span class="text-sm">@feature</span>
                                    </li>
                                }
                            </ul>
                        </CardContentCn>
                        <CardFooterCn Class="pt-4">
                            <ButtonCn Class="@Cn.Merge("w-full gap-2", plan.IsPopular ? "shadow-md" : "")"
                                      Size="ButtonSize.Lg"
                                      Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                                @plan.Cta
                                @if (plan.IsPopular)
                                {
                                    <LucideArrowRightCn Class="h-4 w-4" Size="16" />
                                }
                            </ButtonCn>
                        </CardFooterCn>
                    </CardCn>
                }
            </div>
        </div>

        <p class="text-muted-foreground mt-8 text-center text-sm">
            All plans include 14-day free trial. No credit card required.
        </p>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, string Period, string Description, string[] Features, bool IsPopular, string Cta);

    private static readonly Plan[] _plans =
    [
        new("Basic", 15, "/month", "Essential tools for personal use.", ["5 projects", "5 GB storage", "Email support", "Basic templates", "Standard exports"], false, "Get Started"),
        new("Professional", 45, "/month", "Full toolkit for serious creators.", ["Unlimited projects", "100 GB storage", "Priority support", "Premium templates", "Custom branding", "Advanced exports", "Collaboration tools", "Analytics dashboard"], true, "Start Free Trial"),
        new("Studio", 89, "/month", "For teams and agencies.", ["Everything in Pro", "Unlimited storage", "Dedicated support", "White-label option", "Team management", "Client portals", "API access"], false, "Contact Sales"),
    ];
}
