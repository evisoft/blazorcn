@* ============================================================
   Block: pricing-commitment-discount
   Title: PricingCommitmentDiscount
   Description: A single card configurator pricing section for React and Next.js with a PillTabs selector that drives a unified card showing NumberFlow animated monthly price, savings percentage, horizontal meter bar, total billed amount, and a static feature grid built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-commitment-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Commit longer, save more
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            One plan, four commitment lengths. Pick a commitment and watch the price drop — save up to
            38% on a 24-month commit.
        </p>
    </div>

    @* Unified configurator card *@
    <div class="mt-10 rounded-2xl border bg-muted/40 p-6 shadow-sm sm:p-8">
        @* Commitment selector (PillTabs rendered as raw pill buttons) *@
        <div class="flex items-center justify-center">
            <div class="inline-flex items-center gap-1 rounded-full border bg-background p-1" role="tablist" aria-label="Commitment length">
                @foreach (var c in _commitments)
                {
                    var commitment = c;
                    <button role="tab"
                            aria-selected="@(_selectedId == commitment.Id ? "true" : "false")"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", _selectedId == commitment.Id ? "bg-foreground text-background shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _selectedId = commitment.Id)">
                        @commitment.Label
                    </button>
                }
            </div>
        </div>

        @* Big price + savings display *@
        <div class="mt-8 grid grid-cols-1 items-start gap-6 sm:grid-cols-2 sm:gap-8">
            @* Left: effective monthly price *@
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Effective monthly price
                </p>
                <div class="mt-2 flex items-baseline gap-2">
                    <s aria-hidden="true"
                       class="@Cn.Merge("text-base font-medium tabular-nums text-muted-foreground transition-opacity", Selected.HasDiscount ? "opacity-100" : "opacity-0")">
                        $@Selected.OriginalPrice
                    </s>
                    <div class="flex min-w-[120px] items-baseline justify-start tabular-nums">
                        <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">$@Selected.MonthlyPrice</span>
                    </div>
                    <span class="text-sm font-medium text-muted-foreground">/mo</span>
                </div>
                <p class="mt-3 text-xs text-muted-foreground leading-relaxed">
                    <span class="font-semibold text-foreground">@Selected.CommitmentLabel</span>
                    @(" · ")
                    @Selected.BillingNote
                </p>
            </div>

            @* Right: savings metric *@
            <div class="flex flex-col items-center text-center sm:items-end sm:text-right">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    You save
                </p>
                <div class="mt-2 flex items-baseline gap-1">
                    <LucideIconCn Name="trending-down"
                                  Size="24"
                                  StrokeWidth="2"
                                  Class="@Cn.Merge("mr-1 size-6 shrink-0 stroke-[2.5] transition-colors sm:size-7", Selected.HasDiscount ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground/40")" />
                    <span class="@Cn.Merge("text-5xl font-bold tracking-tight tabular-nums transition-colors sm:text-6xl", Selected.HasDiscount ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground/50")">
                        @Selected.SavingsPercent
                    </span>
                    <span class="@Cn.Merge("text-3xl font-bold tracking-tight transition-colors sm:text-4xl", Selected.HasDiscount ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground/50")">
                        %
                    </span>
                </div>
                <p class="mt-3 text-xs text-muted-foreground leading-relaxed">
                    <span class="@Cn.Merge("font-semibold tabular-nums transition-colors", Selected.HasDiscount ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground")">
                        $@TotalSavings
                    </span>
                    @(" saved over ")
                    @Selected.Months @(Selected.Months == 1 ? "month" : "months")
                </p>
            </div>
        </div>

        @* Savings meter bar *@
        <div class="mt-8 px-1">
            <div class="relative h-2 rounded-full bg-foreground/[0.08]" aria-hidden="true">
                <div class="absolute inset-y-0 left-0 rounded-full bg-emerald-500 transition-all duration-500"
                     style="@(FormattableString.Invariant($"width:{SavingsRatio * 100:F1}%"))">
                </div>
            </div>
            <div class="mt-3 flex justify-between text-[10px] font-semibold uppercase tracking-wider">
                @foreach (var c in _commitments)
                {
                    var cm = c;
                    <div class="@Cn.Merge("flex flex-col items-center gap-0.5 tabular-nums transition-colors", cm.Id == _selectedId ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground")">
                        <span>@(cm.SavingsPercent > 0 ? $"-{cm.SavingsPercent}%" : "0%")</span>
                        <span class="text-[9px] font-medium normal-case tracking-normal text-muted-foreground/80">
                            @cm.Label
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Total billed + CTA row *@
        <div class="mt-8 flex flex-col gap-4 border-t pt-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="text-center sm:text-left">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Total billed
                </p>
                <div class="mt-1 flex items-baseline justify-center gap-2 sm:justify-start">
                    <span class="text-2xl font-bold tracking-tight tabular-nums sm:text-3xl">$@TotalCommitment</span>
                    <span class="text-xs text-muted-foreground">
                        over @Selected.Months @(Selected.Months == 1 ? "month" : "months")
                    </span>
                </div>
            </div>
            <ButtonCn Class="w-full shrink-0 sm:w-[260px]">
                Start 14-day trial
            </ButtonCn>
        </div>
    </div>

    @* Feature grid — what's included at every commitment *@
    <div class="mt-8">
        <p class="text-center text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
            Every commitment includes
        </p>
        <ul class="mx-auto mt-4 grid max-w-2xl grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
            @foreach (var feature in _features)
            {
                <li class="flex items-center gap-2.5">
                    <LucideIconCn Name="check"
                                  Size="16"
                                  StrokeWidth="3"
                                  Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                    <span class="text-sm font-medium text-foreground">@feature</span>
                </li>
            }
        </ul>
    </div>

    @* Footer trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All commitment lengths include a 14-day free trial · No credit card required · Upgrade,
        downgrade, or cancel before your commitment ends
    </p>
</section>

@code {
    private string _selectedId = "annual";

    private const int MaxSavingsPercent = 38;

    private record Commitment(string Id, string Label, int MonthlyPrice, int OriginalPrice, int SavingsPercent, int Months, string BillingNote, string CommitmentLabel)
    {
        public bool HasDiscount => SavingsPercent > 0;
    }

    private static readonly Commitment[] _commitments =
    [
        new("monthly",  "Monthly",   79, 79,  0,  1, "Billed monthly, cancel anytime",         "No commitment"),
        new("quarterly","3 months",  67, 79, 15,  3, "Billed as $201 every 3 months",           "3-month commitment"),
        new("annual",   "12 months", 59, 79, 25, 12, "Billed as $708 per year",                 "12-month commitment"),
        new("biennial", "24 months", 49, 79, 38, 24, "Billed as $1,176 every 2 years",          "24-month commitment"),
    ];

    private static readonly string[] _features =
    [
        "Unlimited projects and workspaces",
        "200GB storage with global CDN",
        "Up to 25 team members",
        "Priority email support (4h SLA)",
        "Custom domains with auto-SSL",
        "Staging and preview environments",
        "SAML SSO with directory sync",
        "REST and GraphQL API access",
    ];

    private Commitment Selected => Array.Find(_commitments, c => c.Id == _selectedId) ?? _commitments[0];
    private int TotalCommitment => Selected.MonthlyPrice * Selected.Months;
    private int TotalSavings => (Selected.OriginalPrice - Selected.MonthlyPrice) * Selected.Months;
    private double SavingsRatio => (double)Selected.SavingsPercent / MaxSavingsPercent;
}
