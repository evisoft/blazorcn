@* ============================================================
   Block: pricing-testimonial-inline
   Title: PricingTestimonialInline
   Description: A stacked horizontal pricing section for React and Next.js with three full-width plan cards each pairing plan details with an inline customer testimonial featuring avatar quote and company NumberFlow animated prices PillTabs billing toggle progressive feature lists with emerald checkmarks and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-testimonial-inline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Trusted by teams who ship fast
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Hear from real customers on every plan. 14-day free trial, no credit card required.
        </p>

        <div class="mt-6 flex items-center justify-center">
            @* PillTabs billing toggle — rendered as inline pill button group *@
            <div class="inline-flex items-center rounded-full bg-muted p-1 text-sm">
                <button type="button"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 font-medium transition-colors", _billing == "monthly" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _billing = "monthly")">
                    Monthly
                </button>
                <button type="button"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 font-medium transition-colors", _billing == "annually" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _billing = "annually")">
                    Annually
                </button>
            </div>
        </div>
    </div>

    @* Stacked horizontal cards *@
    <div class="mt-10 space-y-4">
        @foreach (var plan in _plans)
        {
            var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
            <article class="@Cn.Merge("overflow-hidden rounded-2xl bg-muted p-6 md:p-8", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                @* Reserved badge slot — rendered on every card for Y-alignment *@
                <div class="mb-5 flex h-6 items-center">
                    @if (plan.IsPopular)
                    {
                        <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>

                <div class="grid gap-6 md:grid-cols-[1.4fr_1fr] md:gap-8">
                    @* Left: plan details *@
                    <div class="flex flex-col">
                        <div class="flex items-baseline justify-between gap-4">
                            <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                            <div class="flex items-baseline gap-1">
                                <span class="text-3xl font-bold tracking-tight tabular-nums">$@price</span>
                                <span class="text-xs text-muted-foreground">/mo</span>
                            </div>
                        </div>
                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                            @plan.Description
                        </p>

                        <div class="mt-5">
                            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                @plan.FeatureHeading
                            </p>
                            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-start gap-2">
                                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                        <span class="text-sm font-medium text-foreground">@feature</span>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="mt-6">
                            <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 sm:w-[230px]">
                                @plan.Cta
                            </ButtonCn>
                        </div>
                    </div>

                    @* Right: testimonial *@
                    <figure class="relative flex flex-col rounded-xl border border-foreground/10 bg-background/40 p-5">
                        <LucideIconCn Name="quote" Size="24" Class="absolute right-4 top-4 size-6 text-muted-foreground/20" />
                        <blockquote class="text-sm leading-relaxed text-foreground">
                            &ldquo;@plan.Testimonial.Quote&rdquo;
                        </blockquote>
                        <figcaption class="mt-auto flex items-center gap-3 pt-4">
                            <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-foreground text-background">
                                <span class="text-xs font-semibold">@plan.Testimonial.Initials</span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">
                                    @plan.Testimonial.Author
                                </p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @plan.Testimonial.Role, @plan.Testimonial.Company
                                </p>
                            </div>
                        </figcaption>
                    </figure>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
