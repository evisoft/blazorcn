@* ============================================================
   Block: pricing-metric-toggle-tiles
   Title: PricingMetricToggleTiles
   Description: A metric switching pricing section for React and Next.js with PillTabs metric selector at the top three plan tiles each displaying a massive NumberFlow animated hero quota that morphs when you change the metric a static price row and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-metric-toggle-tiles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Plans by quota
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Compare on what matters to you
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
            Pick your most important quota and see exactly how each plan stacks up. Switch metrics
            anytime — every tier scales across the dimensions you care about.
        </p>

        <div class="mt-6 flex items-center justify-center">
            @* PillTabs — rendered as a styled button group since PillTabs is not a BlazorCN component *@
            <div class="inline-flex items-center rounded-full bg-muted p-1 gap-0.5" role="tablist" aria-label="Quota metric">
                @foreach (var metricKey in _metricOptions)
                {
                    var key = metricKey;
                    var isActive = _activeMetric == key;
                    <button type="button"
                            role="tab"
                            aria-selected="@isActive.ToString().ToLower()"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", isActive ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => SetActiveMetric(key))">
                        @GetMetricLabel(key)
                    </button>
                }
            </div>
        </div>
    </div>

    @* Plan tiles *@
    <div class="mx-auto mt-10 grid max-w-lg gap-4 md:max-w-none md:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var heroValue = GetHeroValue(plan.Id);
            var caption = GetCaption(plan.Id);
            var displayValue = FormatHeroValue(heroValue);
            <article class="@Cn.Merge("flex h-full flex-col overflow-hidden rounded-2xl bg-muted", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                <div class="flex flex-1 flex-col px-7 pb-7 pt-6">
                    @* Reserved badge slot — rendered on every card for Y-alignment *@
                    <div class="mb-5 flex h-6 items-center">
                        @if (plan.IsPopular)
                        {
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        }
                    </div>

                    @* Plan title *@
                    <h3 class="text-lg font-bold tracking-tight">@plan.Name</h3>
                    <p class="mt-1.5 min-h-[2.75rem] text-sm leading-relaxed text-muted-foreground">
                        @plan.Tagline
                    </p>

                    @* Hero metric tile *@
                    <div class="mt-5 rounded-xl border border-foreground/10 bg-background/40 p-5">
                        <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                            @_activeMetricData.Label
                        </p>
                        <div class="mt-2 flex items-baseline gap-1.5">
                            <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">@displayValue</span>
                            <span class="text-sm font-medium text-muted-foreground">@_activeMetricData.Unit</span>
                        </div>
                        <p class="mt-2 text-xs text-muted-foreground">@caption</p>
                    </div>

                    @* Static monthly price *@
                    <div class="mt-5 flex items-baseline justify-between border-t border-foreground/10 pt-5">
                        <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            Starts at
                        </span>
                        <div class="flex items-baseline gap-1">
                            <span class="text-2xl font-bold tracking-tight tabular-nums">
                                $@plan.MonthlyPrice
                            </span>
                            <span class="text-xs text-muted-foreground">/mo</span>
                        </div>
                    </div>

                    @* CTA *@
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full">
                        @plan.Cta
                    </ButtonCn>

                    @* Features *@
                    <ul class="mt-6 flex-1 space-y-2.5">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start gap-2.5">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                <span class="text-sm font-medium text-foreground">@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private string _activeMetric = "api";

    private record Metric(string Key, string Label, string Unit, string Format, Dictionary<string, int> Values, Dictionary<string, string> Caption);

    private record Plan(string Id, string Name, string Tagline, int MonthlyPrice, string[] Features, string Cta, bool IsPopular);

    private static readonly Metric[] _metrics =
    [
        new("api", "API Requests", "/mo", "compact",
            new() { ["starter"] = 100000, ["growth"] = 2000000, ["enterprise"] = 50000000 },
            new() { ["starter"] = "Up to 100K calls per month", ["growth"] = "Up to 2M calls per month", ["enterprise"] = "Up to 50M calls per month" }),
        new("storage", "Storage", "GB", "plain",
            new() { ["starter"] = 25, ["growth"] = 500, ["enterprise"] = 10000 },
            new() { ["starter"] = "25 GB SSD with daily backups", ["growth"] = "500 GB SSD with global CDN", ["enterprise"] = "10 TB SSD with multi-region" }),
        new("bandwidth", "Bandwidth", "GB", "plain",
            new() { ["starter"] = 100, ["growth"] = 2500, ["enterprise"] = 50000 },
            new() { ["starter"] = "100 GB egress per month", ["growth"] = "2.5 TB egress per month", ["enterprise"] = "50 TB egress per month" }),
        new("seats", "Team Seats", "users", "plain",
            new() { ["starter"] = 3, ["growth"] = 25, ["enterprise"] = 500 },
            new() { ["starter"] = "Up to 3 team members", ["growth"] = "Up to 25 team members", ["enterprise"] = "Up to 500 team members" }),
    ];

    private static readonly Plan[] _plans =
    [
        new("starter", "Starter", "For builders shipping their first project.", 19,
            ["All core API endpoints", "Community Discord support", "99.9% uptime SLA", "Basic analytics dashboard"],
            "Start free trial", false),
        new("growth", "Growth", "For scaling teams shipping production workloads.", 99,
            ["All Starter features", "Priority email support, 4h SLA", "99.95% uptime SLA", "Advanced analytics with funnels", "REST and GraphQL access", "Custom integrations"],
            "Start free trial", true),
        new("enterprise", "Enterprise", "For mission-critical platforms with compliance needs.", 499,
            ["All Growth features", "Dedicated success manager", "99.99% uptime SLA with credits", "SAML SSO and audit logs", "Data residency (US, EU, APAC)", "Custom contracts and DPA"],
            "Contact sales", false),
    ];

    private static readonly string[] _metricOptions = _metrics.Select(m => m.Key).ToArray();

    private Metric _activeMetricData => _metrics.FirstOrDefault(m => m.Key == _activeMetric) ?? _metrics[0];

    private void SetActiveMetric(string key) => _activeMetric = key;

    private string GetMetricLabel(string key) => _metrics.FirstOrDefault(m => m.Key == key)?.Label ?? key;

    private int GetHeroValue(string planId)
    {
        var vals = _activeMetricData.Values;
        return vals.TryGetValue(planId, out var v) ? v : 0;
    }

    private string GetCaption(string planId)
    {
        var caps = _activeMetricData.Caption;
        return caps.TryGetValue(planId, out var c) ? c : "";
    }

    private string FormatHeroValue(int value)
    {
        if (_activeMetricData.Format == "compact")
        {
            if (value >= 1_000_000) return $"{value / 1_000_000.0:0.#}M";
            if (value >= 1_000) return $"{value / 1000.0:0.#}K";
            return value.ToString();
        }
        return value >= 1000 ? $"{value / 1000.0:0.#}K" : value.ToString();
    }
}
