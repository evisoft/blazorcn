@* ========================================
   Block: pricing-usage-slider
   Title: Pricing Usage Slider
   Description: Interactive usage-based pricing with draggable slider that dynamically calculates cost based on API calls or usage volume
   Long Description: Pricing with billing period switch
   Dependencies: LucideCheckCn, LucideZapCn
   Source: original/blocks/pricing/pricing-usage-slider.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Class="mb-4 gap-1" Variant="BadgeVariant.Secondary">
                <LucideZapCn Class="h-3 w-3" Size="12" />
                Usage-Based Pricing
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Pay for what you use
            </h2>
            <p class="text-muted-foreground text-lg">
                Start free, scale seamlessly. Only pay when you grow beyond the free tier.
            </p>
        </div>

        <div class="mx-auto max-w-2xl">
            <CardCn>
                <CardHeaderCn Class="text-center">
                    <div class="mb-1 text-sm font-medium">
                        @_tier.Label requests/month
                    </div>
                    <div class="flex items-baseline justify-center gap-1">
                        <span class="text-5xl font-bold tracking-tight transition-all duration-300">
                            $@_tier.Price
                        </span>
                        <span class="text-muted-foreground text-sm">/month</span>
                    </div>
                    <p class="text-muted-foreground text-sm">@_tier.PerUnit</p>
                </CardHeaderCn>
                <CardContentCn Class="space-y-8">
                    @* Slider *@
                    <div class="space-y-4 px-2">
                        <SliderCn Value="@_tierIndex" ValueChanged="@((double v) => _tierIndex = v)"
                                  Max="@(_usageTiers.Length - 1)" Min="0" Step="1" aria-label="Monthly usage tier" />
                        <div class="flex justify-between">
                            @for (var i = 0; i < _usageTiers.Length; i++)
                            {
                                var idx = i;
                                <button type="button" @onclick="@(() => _tierIndex = idx)"
                                        class="@Cn.Merge("text-xs font-medium transition-colors", idx == (int)_tierIndex ? "text-primary" : "text-muted-foreground hover:text-foreground")">
                                    @_usageTiers[idx].Label
                                </button>
                            }
                        </div>
                    </div>

                    <SeparatorCn />

                    @* Features *@
                    <div>
                        <h3 class="mb-4 text-sm font-semibold">What's included</h3>
                        <ul class="grid gap-3 sm:grid-cols-2">
                            @foreach (var feature in _tier.Features)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Class="text-primary mt-0.5 h-4 w-4 shrink-0" Size="16" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>

                    @* CTA *@
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <ButtonCn Class="flex-1" Size="ButtonSize.Lg">
                            @(_tier.Price == 0 ? "Get Started Free" : "Start Free Trial")
                        </ButtonCn>
                        @if (_tier.Price > 0)
                        {
                            <ButtonCn Class="flex-1" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                                Talk to Sales
                            </ButtonCn>
                        }
                    </div>

                    <p class="text-muted-foreground text-center text-xs">
                        @(_tier.Price == 0 ? "No credit card required." : "14-day free trial. Overage billed at the per-request rate.")
                    </p>
                </CardContentCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private record UsageTier(string Label, int Price, string PerUnit, string[] Features);

    private static readonly UsageTier[] _usageTiers =
    [
        new("1K", 0, "Free forever", ["1,000 API requests/month", "Community support", "Basic rate limiting", "Public documentation"]),
        new("10K", 29, "$0.0029/request", ["10,000 API requests/month", "Email support", "Standard rate limiting", "Webhooks", "Basic analytics"]),
        new("100K", 99, "$0.00099/request", ["100,000 API requests/month", "Priority support", "Custom rate limits", "Webhooks & streaming", "Advanced analytics", "Multiple API keys"]),
        new("500K", 299, "$0.0006/request", ["500,000 API requests/month", "Priority support (4h SLA)", "No rate limiting", "Webhooks & streaming", "Real-time analytics", "Unlimited API keys", "Dedicated endpoints"]),
        new("1M", 499, "$0.0005/request", ["1,000,000 API requests/month", "Dedicated support engineer", "No rate limiting", "All integrations", "Real-time analytics", "Unlimited API keys", "Dedicated endpoints", "Custom SLA"]),
    ];

    private double _tierIndex = 2;
    private UsageTier _tier => _usageTiers[(int)_tierIndex];
}
