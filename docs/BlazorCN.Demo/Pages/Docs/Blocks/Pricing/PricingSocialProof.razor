@* ========================================
   Block: pricing-social-proof
   Title: Pricing Social Proof
   Description: Pricing cards with customer testimonial quotes, avatar badges, and user count social proof per tier
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideCheckCn, LucideQuoteCn, LucideUsersCn
   Source: original/blocks/pricing/pricing-social-proof.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Trusted by 17,000+ teams
            </h2>
            <p class="text-muted-foreground text-lg">
                Join thousands of developers and teams who ship faster with us.
            </p>
        </div>

        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                <CardCn
                    Class="@(Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20 md:scale-105" : "border-border"))">
                    @if (plan.IsPopular)
                    {
                        <div class="absolute -top-3 right-4">
                            <BadgeCn>Most Popular</BadgeCn>
                        </div>
                    }
                    <CardHeaderCn Class="pb-4">
                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                        <div class="mt-2 flex items-baseline gap-1">
                            <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                            @if (plan.Price > 0)
                            {
                                <span class="text-muted-foreground text-sm">/month</span>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-sm">forever</span>
                            }
                        </div>
                        <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                    </CardHeaderCn>
                    <CardContentCn Class="flex-1 space-y-6">
                        <ul class="space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Size="16" Class="text-primary mt-0.5 shrink-0" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>

                        <SeparatorCn />

                        @* Testimonial *@
                        <div class="space-y-3">
                            <LucideQuoteCn Size="20" Class="text-muted-foreground/30" />
                            <p class="text-muted-foreground text-sm italic leading-relaxed">
                                &ldquo;@plan.Testimonial.Quote&rdquo;
                            </p>
                            <div class="flex items-center gap-3">
                                <AvatarCn Class="h-8 w-8">
                                    <AvatarFallbackCn Class="text-xs">
                                        @GetInitials(plan.Testimonial.Name)
                                    </AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <p class="text-xs font-medium">@plan.Testimonial.Name</p>
                                    <p class="text-muted-foreground text-xs">
                                        @plan.Testimonial.Role, @plan.Testimonial.Company
                                    </p>
                                </div>
                            </div>
                        </div>

                        @* User Count *@
                        <div class="flex items-center gap-2">
                            <LucideUsersCn Size="14" Class="text-muted-foreground" />
                            <span class="text-muted-foreground text-xs">
                                @plan.UserCount teams on this plan
                            </span>
                        </div>
                    </CardContentCn>
                    <CardFooterCn Class="pt-4">
                        <ButtonCn
                            Class="w-full"
                            Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)"
                            Size="ButtonSize.Lg"
                            AsChild="true">
                            <a href="#">@plan.Cta</a>
                        </ButtonCn>
                    </CardFooterCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    private record TestimonialItem(string Quote, string Name, string Role, string Company);

    private record PlanItem(string Name, int Price, string Description, string[] Features, bool IsPopular, string Cta, string UserCount, TestimonialItem Testimonial);

    private static readonly PlanItem[] _plans =
    [
        new("Starter", 0, "For individuals and side projects.",
            ["Up to 3 projects", "1 GB storage", "Community support", "Basic analytics"],
            false, "Get Started Free", "12,000+",
            new("Perfect for my weekend projects. I built three prototypes before committing to a paid plan.", "Alex Rivera", "Indie Developer", "Self-employed")),
        new("Pro", 39, "For teams shipping real products.",
            ["Unlimited projects", "100 GB storage", "Priority support", "Advanced analytics", "Custom domains", "API access", "Team collaboration"],
            true, "Start Free Trial", "4,200+",
            new("Switching to Pro cut our dev cycle by 40%. The team collaboration features alone are worth twice the price.", "Sarah Chen", "CTO", "Stackwise")),
        new("Enterprise", 149, "For organizations at scale.",
            ["Everything in Pro", "Unlimited storage", "SSO & audit logs", "Dedicated CSM", "Custom SLA", "Advanced permissions", "On-premise option"],
            false, "Contact Sales", "800+",
            new("The security features and dedicated support gave our compliance team the confidence to go all in.", "Michael Park", "VP Engineering", "NovaCorp")),
    ];
}
