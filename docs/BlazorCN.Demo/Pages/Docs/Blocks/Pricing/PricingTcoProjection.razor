@* ============================================================
   Block: pricing-tco-projection
   Title: PricingTcoProjection
   Description: A total cost of ownership projection pricing section for React and Next.js with a SVG line chart showing cumulative cost curves for three plans over one three or five year horizons PillTabs horizon selector NumberFlow animated total cost stats and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-tco-projection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Total cost of ownership
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Project the true cost
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Don't just look at this month's bill. Project what every plan will cost over the full
            contract horizon, setup fees and annual discounts included.
        </p>
        <div class="mt-6 flex items-center justify-center">
            @* Horizon selector pill tabs *@
            <div class="inline-flex items-center rounded-full bg-muted p-1 text-sm" role="tablist" aria-label="Projection horizon">
                @foreach (var horizon in _horizons)
                {
                    var h = horizon;
                    var isActive = _horizonKey == h.Key;
                    var tabClass = isActive
                        ? "rounded-full bg-background px-4 py-1.5 text-xs font-semibold text-foreground shadow-sm transition-colors"
                        : "rounded-full px-4 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground";
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@isActive.ToString().ToLowerInvariant()"
                        class="@tabClass"
                        @onclick="@(() => SetHorizon(h.Key))">
                        @h.Label
                    </button>
                }
            </div>
        </div>
    </div>

    @* Chart card *@
    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        @* Legend *@
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-foreground/10 bg-foreground/5 px-5 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" aria-hidden="true" />
                <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Cumulative cost
                </span>
            </div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                @foreach (var plan in _plans)
                {
                    var p = plan;
                    var legendLineColor = p.Id == "starter" ? "bg-blue-500" : p.Id == "growth" ? "bg-foreground" : "bg-red-500";
                    var legendSpanClass = $"h-0.5 w-4 rounded-full {legendLineColor}";
                    <button
                        type="button"
                        class="flex items-center gap-1.5 text-[11px] font-medium text-muted-foreground transition-colors hover:text-foreground focus:outline-none focus-visible:text-foreground"
                        @onmouseenter="@(() => _hoveredPlan = p.Id)"
                        @onmouseleave="@(() => _hoveredPlan = null)"
                        @onfocus="@(() => _hoveredPlan = p.Id)"
                        @onblur="@(() => _hoveredPlan = null)">
                        <span class="@legendSpanClass" />
                        @p.Name
                    </button>
                }
            </div>
        </div>

        @* Chart area *@
        <div class="px-2 pb-2 pt-4 sm:px-4">
            @{
                var viewBox = $"0 0 {ChartWidth} {ChartHeight}";
                var ariaLabel = $"Cumulative cost projection over {CurrentHorizon.Label} for Starter, Growth, and Enterprise plans";
                var baselineY = (ChartHeight - PadBottom).ToString("F1");
                var baselineX2 = (ChartWidth - PadRight).ToString("F1");
                var padLeftStr = PadLeft.ToString("F1");
            }
            <svg
                viewBox="@viewBox"
                class="h-auto w-full"
                role="img"
                aria-label="@ariaLabel">
                <title>Total cost of ownership projection</title>

                @* Y-axis grid lines and labels *@
                @foreach (var tick in YTicks)
                {
                    var tickVal = tick;
                    var yVal = YScale(tickVal);
                    var tickLabel = tickVal >= 1000 ? $"{(tickVal / 1000.0):0}k" : tickVal.ToString();
                    var yStr = yVal.ToString("F1");
                    var gridX2 = (ChartWidth - PadRight).ToString("F1");
                    var textX = (PadLeft - 8).ToString("F1");
                    <line
                        x1="@padLeftStr"
                        y1="@yStr"
                        x2="@gridX2"
                        y2="@yStr"
                        class="stroke-foreground/10"
                        stroke-width="1"
                        stroke-dasharray="3 4" />
                    @((MarkupString)$"<text x=\"{textX}\" y=\"{yStr}\" text-anchor=\"end\" dominant-baseline=\"middle\" class=\"fill-muted-foreground font-mono text-[10px] tabular-nums\">${tickLabel}</text>")
                }

                @* X-axis tick labels *@
                @foreach (var month in XTickMonths)
                {
                    var m = month;
                    var xVal = XScale(m);
                    var year = m / 12;
                    var xLabel = year == 0 ? "Start" : $"Yr {year}";
                    var xStr = xVal.ToString("F1");
                    var tickY1 = (ChartHeight - PadBottom).ToString("F1");
                    var tickY2 = (ChartHeight - PadBottom + 4).ToString("F1");
                    var textY = (ChartHeight - PadBottom + 16).ToString("F1");
                    <line
                        x1="@xStr"
                        y1="@tickY1"
                        x2="@xStr"
                        y2="@tickY2"
                        class="stroke-foreground/20"
                        stroke-width="1" />
                    @((MarkupString)$"<text x=\"{xStr}\" y=\"{textY}\" text-anchor=\"middle\" class=\"fill-muted-foreground font-mono text-[10px] tabular-nums\">{xLabel}</text>")
                }

                @* Baseline (x-axis line) *@
                <line
                    x1="@padLeftStr"
                    y1="@baselineY"
                    x2="@baselineX2"
                    y2="@baselineY"
                    class="stroke-foreground/20"
                    stroke-width="1" />

                @* Plan curves *@
                @foreach (var curve in Curves)
                {
                    var curveItem = curve;
                    var isHovered = _hoveredPlan == curveItem.Plan.Id;
                    var isOtherHovered = _hoveredPlan != null && _hoveredPlan != curveItem.Plan.Id;
                    var strokeColorClass = curveItem.Plan.Id == "starter" ? "stroke-blue-500" : curveItem.Plan.Id == "growth" ? "stroke-foreground" : "stroke-red-500";
                    var opacityClass = isOtherHovered ? "opacity-30" : "";
                    var sw = isHovered ? 3.5 : curveItem.Plan.IsPopular ? 2.5 : 2.0;
                    var pathD = BuildPath(curveItem.Points);
                    var pathClass = Cn.Merge("fill-none transition-opacity", strokeColorClass, opacityClass);
                    var swStr = sw.ToString("F1");
                    <path
                        d="@pathD"
                        class="@pathClass"
                        stroke-width="@swStr"
                        stroke-linejoin="round"
                        stroke-linecap="round" />

                    @* End-of-horizon dot *@
                    @if (curveItem.Points.Length > 0)
                    {
                        var last = curveItem.Points[curveItem.Points.Length - 1];
                        var dotCx = XScale(last.Month).ToString("F1");
                        var dotCy = YScale(last.Cost).ToString("F1");
                        var dotStrokeClass = curveItem.Plan.Id == "starter" ? "stroke-blue-500" : curveItem.Plan.Id == "growth" ? "stroke-foreground" : "stroke-red-500";
                        var dotR = (isHovered ? 5.0 : curveItem.Plan.IsPopular ? 4.0 : 3.5).ToString("F1");
                        var dotClass = Cn.Merge("fill-background transition-all", dotStrokeClass);
                        <circle
                            cx="@dotCx"
                            cy="@dotCy"
                            r="@dotR"
                            class="@dotClass"
                            stroke-width="2" />
                    }
                }
            </svg>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-1 border-t border-foreground/10 sm:grid-cols-3 sm:divide-x sm:divide-foreground/10">
            @foreach (var plan in _plans)
            {
                var p = plan;
                var endCost = CumulativeCost(p, TotalMonths);
                var isHov = _hoveredPlan == p.Id;
                var divClass = Cn.Merge("px-5 py-5 transition-colors",
                    p.IsPopular ? "bg-foreground/5" : "",
                    isHov ? "bg-foreground/10" : "");
                var statLineColor = p.Id == "starter" ? "bg-blue-500" : p.Id == "growth" ? "bg-foreground" : "bg-red-500";
                var statSpanClass = $"h-0.5 w-4 rounded-full {statLineColor}";
                <div
                    class="@divClass"
                    @onmouseenter="@(() => _hoveredPlan = p.Id)"
                    @onmouseleave="@(() => _hoveredPlan = null)">
                    <div class="flex items-center gap-2">
                        <span class="@statSpanClass" aria-hidden="true" />
                        <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                            @p.Name
                        </p>
                    </div>
                    <div class="mt-2 flex items-baseline gap-1">
                        <span class="text-2xl font-bold tracking-tight tabular-nums">
                            $@(_isAnimated ? endCost : 0)
                        </span>
                    </div>
                    <p class="mt-1 text-[10px] uppercase tracking-wider text-muted-foreground">
                        @CurrentHorizon.Label total
                    </p>
                </div>
            }
        </div>
    </div>

    @* Plan picker row *@
    <div class="mt-4 grid gap-3 md:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var p = plan;
            var cardClass = Cn.Merge("flex h-full flex-col overflow-hidden rounded-xl bg-muted p-5",
                p.IsPopular ? "ring-2 ring-foreground/10" : "");
            <div class="@cardClass">
                <div class="mb-3 flex h-5 items-center">
                    @if (p.IsPopular)
                    {
                        <span class="inline-flex items-center rounded-full bg-red-500 px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>
                <h3 class="text-base font-bold tracking-tight">@p.Name</h3>
                <div class="mt-2 flex items-baseline gap-1">
                    <span class="text-2xl font-bold tracking-tight tabular-nums">
                        $@p.MonthlyPrice
                    </span>
                    <span class="text-xs text-muted-foreground">/mo</span>
                </div>
                <p class="mt-1 text-[10px] uppercase tracking-wider text-muted-foreground">
                    @(p.AnnualDiscount > 0 ? $"{(int)Math.Round(p.AnnualDiscount * 100)}% off year 2+" : "No discount")
                </p>
                <ul class="mt-3 flex-1 space-y-1.5">
                    @foreach (var feature in p.Features)
                    {
                        <li class="flex items-start gap-2">
                            <LucideIconCn Name="check" Size="14" StrokeWidth="3" Class="mt-0.5 size-3.5 shrink-0 text-emerald-600 dark:text-emerald-500" />
                            <span class="text-xs font-medium text-foreground">@feature</span>
                        </li>
                    }
                </ul>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 w-full">
                    @p.Cta
                </ButtonCn>
            </div>
        }
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private record PlanData(
        string Id,
        string Name,
        string Tagline,
        int MonthlyPrice,
        double AnnualDiscount,
        int Setup,
        string[] Features,
        string Cta,
        bool IsPopular
    );

    private record HorizonData(string Key, string Label, int Months);

    private record ChartPoint(int Month, int Cost);

    private record CurveData(PlanData Plan, ChartPoint[] Points);

    private static readonly PlanData[] _plans =
    [
        new("starter", "Starter", "Solo builders", 29, 0.15, 0,
            ["25 GB storage", "Community support", "10 integrations"],
            "Start free trial", false),
        new("growth", "Growth", "Scaling teams", 149, 0.20, 0,
            ["500 GB storage", "Priority support, 4h", "Unlimited integrations", "SSO + audit"],
            "Start free trial", true),
        new("enterprise", "Enterprise", "Mission-critical", 599, 0.25, 2500,
            ["Unlimited storage", "Dedicated success team", "Custom integrations", "SOC2 + HIPAA"],
            "Contact sales", false),
    ];

    private static readonly HorizonData[] _horizons =
    [
        new("1yr", "1 year", 12),
        new("3yr", "3 years", 36),
        new("5yr", "5 years", 60),
    ];

    // Chart geometry constants
    private const double ChartWidth = 640;
    private const double ChartHeight = 280;
    private const double PadLeft = 56;
    private const double PadRight = 16;
    private const double PadTop = 16;
    private const double PadBottom = 36;

    private string _horizonKey = "3yr";
    private bool _isAnimated = false;
    private string? _hoveredPlan = null;

    private HorizonData CurrentHorizon => Array.Find(_horizons, h => h.Key == _horizonKey) ?? _horizons[1];
    private int TotalMonths => CurrentHorizon.Months;

    private static int CumulativeCost(PlanData plan, int monthIndex)
    {
        double total = plan.Setup;
        for (int m = 1; m <= monthIndex; m++)
        {
            bool isSubsequentYear = m > 12;
            double rate = isSubsequentYear
                ? plan.MonthlyPrice * (1.0 - plan.AnnualDiscount)
                : plan.MonthlyPrice;
            total += rate;
        }
        return (int)Math.Round(total);
    }

    private CurveData[] Curves
    {
        get
        {
            var totalMonths = TotalMonths;
            var result = new CurveData[_plans.Length];
            for (int i = 0; i < _plans.Length; i++)
            {
                var plan = _plans[i];
                var points = new ChartPoint[totalMonths + 1];
                for (int m = 0; m <= totalMonths; m++)
                {
                    points[m] = new ChartPoint(m, CumulativeCost(plan, m));
                }
                result[i] = new CurveData(plan, points);
            }
            return result;
        }
    }

    private int MaxCost
    {
        get
        {
            int max = 0;
            foreach (var curve in Curves)
            {
                foreach (var pt in curve.Points)
                {
                    if (pt.Cost > max) max = pt.Cost;
                }
            }
            return max;
        }
    }

    private double XScale(int month)
    {
        return PadLeft + (month / (double)TotalMonths) * (ChartWidth - PadLeft - PadRight);
    }

    private double YScale(int cost)
    {
        var safeMax = MaxCost > 0 ? MaxCost : 1;
        return PadTop + (1.0 - cost / (double)safeMax) * (ChartHeight - PadTop - PadBottom);
    }

    private string BuildPath(ChartPoint[] points)
    {
        var parts = new System.Text.StringBuilder();
        for (int i = 0; i < points.Length; i++)
        {
            var pt = points[i];
            var cmd = i == 0 ? "M" : "L";
            parts.Append($"{cmd}{XScale(pt.Month):F1},{YScale(pt.Cost):F1} ");
        }
        return parts.ToString().TrimEnd();
    }

    private int[] YTicks
    {
        get
        {
            var max = MaxCost;
            return [0, (int)Math.Round(max * 0.25), (int)Math.Round(max * 0.5), (int)Math.Round(max * 0.75), max];
        }
    }

    private int[] XTickMonths
    {
        get
        {
            var ticks = new System.Collections.Generic.List<int>();
            for (int y = 0; y * 12 <= TotalMonths; y++)
            {
                ticks.Add(y * 12);
            }
            return ticks.ToArray();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(120);
            _isAnimated = true;
            StateHasChanged();
        }
    }

    private void SetHorizon(string key)
    {
        _horizonKey = key;
    }
}
