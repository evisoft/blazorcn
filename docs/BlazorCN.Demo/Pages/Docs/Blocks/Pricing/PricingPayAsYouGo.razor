@* ============================================================
   Block: pricing-pay-as-you-go
   Title: PricingPayAsYouGo
   Description: A comparison table pay-as-you-go pricing section for React and Next.js with usage-based resource rows for API calls, storage, compute, and bandwidth showing free tier, base rate, volume tier breakpoints, and a single ShadcnioButton CTA built with shadcn/ui Table and Tailwind CSS
   Source: original/blocks/pricing/pricing-pay-as-you-go.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Usage-Based Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pay only for what you use
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
            No monthly commitment, no upfront fees. Every resource includes a generous free tier so
            you can build without a credit card.
        </p>
    </div>

    @* Comparison table *@
    <div class="mt-10 overflow-hidden rounded-2xl bg-muted">
        <div class="overflow-x-auto">
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn Class="border-b border-border/60 hover:bg-transparent">
                        <TableHeadCn Class="w-[200px] py-5 pl-6 text-xs font-semibold uppercase tracking-wider text-muted-foreground sm:pl-8">
                            Resource
                        </TableHeadCn>
                        <TableHeadCn Class="py-5 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            Free tier
                        </TableHeadCn>
                        <TableHeadCn Class="py-5 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            Starting rate
                        </TableHeadCn>
                        <TableHeadCn Class="py-5 pr-6 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground sm:pr-8">
                            Volume tiers
                        </TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var res in _resources)
                    {
                        <TableRowCn Class="@Cn.Merge("border-b border-border/60 hover:bg-transparent", res.IsPopular ? "bg-foreground/[0.03]" : "")">
                            @* Resource cell *@
                            <TableCellCn Class="py-6 pl-6 align-top sm:pl-8">
                                <div class="flex items-start gap-3">
                                    <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-background">
                                        <LucideIconCn Name="@res.IconName" Size="16" Class="size-4 text-foreground" />
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2">
                                            <p class="text-base font-bold tracking-tight">@res.Name</p>
                                            @if (res.IsPopular)
                                            {
                                                <span class="rounded-full bg-red-500 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white">
                                                    Popular
                                                </span>
                                            }
                                        </div>
                                        <p class="mt-0.5 text-xs text-muted-foreground">
                                            @res.StartingRateUnit
                                        </p>
                                    </div>
                                </div>
                            </TableCellCn>

                            @* Free tier cell *@
                            <TableCellCn Class="py-6 align-top">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-base font-bold tabular-nums text-emerald-600 dark:text-emerald-500">
                                        @res.FreeTier
                                    </span>
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <LucideIconCn Name="info" Size="12" Class="size-3 shrink-0 cursor-help text-muted-foreground/40" />
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="max-w-[240px]">
                                            <p class="text-xs">@res.FreeTierTooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">no card needed</p>
                            </TableCellCn>

                            @* Starting rate cell *@
                            <TableCellCn Class="py-6 align-top">
                                <div class="flex items-baseline gap-1">
                                    <span class="text-2xl font-bold tracking-tight tabular-nums">
                                        @res.StartingRate
                                    </span>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">after free tier</p>
                            </TableCellCn>

                            @* Volume tiers cell *@
                            <TableCellCn Class="py-6 pr-6 align-top sm:pr-8">
                                <div class="space-y-1">
                                    @foreach (var tier in res.VolumeTiers)
                                    {
                                        <div class="flex items-center justify-between gap-3 text-xs">
                                            <span class="font-mono text-muted-foreground">@tier.Range</span>
                                            <span class="@Cn.Merge("font-semibold tabular-nums", tier.IsFree ? "text-emerald-600 dark:text-emerald-500" : "")">
                                                @tier.Rate
                                            </span>
                                        </div>
                                    }
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        @* Footer CTA *@
        <div class="flex flex-col items-center gap-3 border-t border-border/60 bg-background/40 px-6 py-6 sm:px-8">
            <ButtonCn Class="w-full shrink-0 sm:w-[260px]">
                Start building free
            </ButtonCn>
            <p class="text-xs text-muted-foreground">
                Volume discounts applied automatically. Enterprise commitments available for predictable
                workloads.
            </p>
        </div>
    </div>
</section>

@code {
    private record VolumeTier(string Range, string Rate, bool IsFree = false);

    private record Resource(
        string Id,
        string Name,
        string IconName,
        string FreeTier,
        string FreeTierTooltip,
        string StartingRate,
        string StartingRateUnit,
        VolumeTier[] VolumeTiers,
        bool IsPopular
    );

    private static readonly Resource[] _resources =
    [
        new(
            "api",
            "API Calls",
            "zap",
            "10K / mo",
            "10,000 requests/month free across REST and GraphQL endpoints. Resets monthly.",
            "$0.50",
            "per 1K requests",
            [
                new("0 – 10K", "Free", true),
                new("10K – 1M", "$0.50"),
                new("1M – 10M", "$0.35"),
                new("10M+", "$0.20"),
            ],
            false
        ),
        new(
            "compute",
            "Compute",
            "cpu",
            "100 hrs / mo",
            "100 vCPU-hours/month free with auto-scaling to zero and sub-second cold starts.",
            "$0.05",
            "per vCPU-hour",
            [
                new("0 – 100 hrs", "Free", true),
                new("100 – 1K hrs", "$0.05"),
                new("1K – 10K hrs", "$0.035"),
                new("10K+", "$0.020"),
            ],
            true
        ),
        new(
            "storage",
            "Storage",
            "database",
            "5 GB",
            "5 GB included with auto-replication across 3 zones, point-in-time recovery, and AES-256 encryption.",
            "$0.10",
            "per GB-month",
            [
                new("0 – 5 GB", "Free", true),
                new("5 – 100 GB", "$0.10"),
                new("100 GB – 1 TB", "$0.07"),
                new("1 TB+", "$0.04"),
            ],
            false
