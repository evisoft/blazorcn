@* ============================================================
   Block: pricing-bundle-deal
   Title: PricingBundleDeal
   Description: A split layout pricing section for React and Next.js with two stacked light product cards on the left and a dramatic dark bg-foreground highlight card on the right showing strikethrough total, NumberFlow-free big price, emerald savings callout, per-row value breakdown, ShadcnioButton CTAs, and a red discount badge built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-bundle-deal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Bundle &amp; Save
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Better together</h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Get both products in a single plan and save
            <span class="font-semibold text-foreground">$@_yearlySavings per year</span>. One
            subscription, one invoice, full access.
        </p>
    </div>

    @* Layout: individual stack + bundle highlight *@
    <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-[1fr_1.1fr] lg:items-stretch">
        @* LEFT — Individual product cards stacked *@
        <div class="flex h-full flex-col gap-4">
            @foreach (var prod in _products)
            {
                var product = prod;
                <article class="flex flex-1 flex-col rounded-2xl bg-muted p-6 sm:p-7">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <h3 class="text-2xl font-bold tracking-tight">@product.Name</h3>
                            <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">
                                @product.Description
                            </p>
                        </div>
                        <div class="shrink-0 text-right">
                            <div class="flex items-baseline justify-end gap-1">
                                <span class="text-3xl font-bold tracking-tight tabular-nums">
                                    $@product.MonthlyPrice
                                </span>
                                <span class="text-xs text-muted-foreground">/mo</span>
                            </div>
                        </div>
                    </div>

                    <ul class="mt-5 grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2">
                        @foreach (var feat in product.Features)
                        {
                            <li class="flex items-start gap-2.5 text-sm font-medium text-foreground">
                                <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                @feat.Name
                            </li>
                        }
                    </ul>

                    <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full">@product.Cta</ButtonCn>
                </article>
            }
        </div>

        @* RIGHT — Dark bundle highlight card *@
        <article class="relative flex h-full flex-col overflow-hidden rounded-2xl bg-foreground p-6 sm:p-8">
            @* Save badge *@
            <div class="flex items-start justify-between gap-3">
                <div class="inline-flex items-center gap-1.5 rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" aria-hidden="true" />
                    Save @_savingsPercent%
                </div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-background/40">
                    Limited Bundle
                </span>
            </div>

            @* Title *@
            <h3 class="mt-6 text-3xl font-bold tracking-tight text-background sm:text-4xl">
                @_bundle.Name
            </h3>
            <p class="mt-2 text-sm text-background/60 leading-relaxed">@_bundle.Description</p>

            @* Price block *@
            <div class="mt-7">
                <div class="flex items-baseline gap-2">
                    <s aria-hidden="true" class="text-2xl font-semibold tabular-nums text-background/40">
                        $@_individualTotal
                    </s>
                    <span class="text-5xl font-bold tracking-tight tabular-nums text-background sm:text-6xl">
                        $@_bundle.MonthlyPrice
                    </span>
                    <span class="text-sm text-background/60">/month</span>
                </div>
                <p class="mt-2 text-sm font-medium text-emerald-400">
                    Save $@_monthlySavings/mo · $@_yearlySavings per year
                </p>
            </div>

            @* CTA *@
            <ButtonCn Class="mt-6 w-full bg-background text-foreground hover:bg-background/90">@_bundle.Cta</ButtonCn>

            @* Per-product breakdown *@
            <div class="mt-6 space-y-2 rounded-xl border border-background/10 bg-background/5 p-4">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-background/60">
                    Includes per product
                </p>
                @foreach (var prod in _products)
                {
                    var product = prod;
                    <div class="flex items-center justify-between text-sm text-background/80">
                        <span class="flex items-center gap-2">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-400" aria-hidden="true" />
                            @product.Name
                        </span>
                        <span class="text-xs tabular-nums text-background/50">
                            $@product.MonthlyPrice/mo value
                        </span>
                    </div>
                }
            </div>

            @* Bundle-only extras *@
            <div class="mt-6 flex-1">
                <p class="text-sm font-semibold text-background">Bundle-only extras:</p>
                <ul class="mt-4 space-y-3">
                    @foreach (var feat in _bundle.BonusFeatures)
                    {
                        <li class="flex items-start gap-2.5 text-base font-medium text-background/90">
                            <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-400" aria-hidden="true" />
                            @feat.Name
                        </li>
                    }
                </ul>
            </div>
        </article>
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. 30-day money-back guarantee.
    </p>
</section>

@code {
    private record ProductFeature(string Name);

    private record Product(string Id, string Name, string Description, int MonthlyPrice, ProductFeature[] Features, string Cta);

    private record Bundle(string Name, string Description, int MonthlyPrice, ProductFeature[] BonusFeatures, string Cta);

    private static readonly Product[] _products =
    [
        new("analytics", "Analytics Pro", "Real-time dashboards, custom reports, and funnel analysis for your product.", 39,
            [
                new("Real-time event streaming"),
                new("Unlimited custom dashboards"),
                new("Funnel and retention analysis"),
                new("SQL query editor"),
                new("Data export to S3 or BigQuery"),
                new("Up to 10M events/month"),
            ],
            "Get Analytics Pro"),
        new("monitoring", "Uptime Monitor", "Synthetic monitoring, alerting, and status pages for your infrastructure.", 29,
            [
                new("60-second check intervals"),
                new("Multi-region probes (12 cities)"),
                new("Slack, PagerDuty, webhook alerts"),
                new("Public and private status pages"),
                new("SSL certificate monitoring"),
                new("Up to 50 monitors"),
            ],
            "Get Uptime Monitor"),
    ];

    private static readonly Bundle _bundle = new(
        "Complete Bundle",
        "Get both products together and save. Everything you need to ship and monitor with confidence.",
        49,
        [
            new("Unified dashboard across both products"),
            new("Cross-product alerting rules"),
            new("Shared team workspace with SSO"),
            new("Priority support (4h SLA)"),
            new("Custom onboarding session"),
        ],
        "Get the bundle");

    private static readonly int _individualTotal = _products.Sum(p => p.MonthlyPrice);
    private static readonly int _monthlySavings = _individualTotal - _bundle.MonthlyPrice;
    private static readonly int _yearlySavings = _monthlySavings * 12;
    private static readonly int _savingsPercent = (int)Math.Round((double)_monthlySavings / _individualTotal * 100);
}
