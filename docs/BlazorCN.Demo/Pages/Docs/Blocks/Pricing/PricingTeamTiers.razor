@* ============================================================
   Block: pricing-team-tiers
   Title: PricingTeamTiers
   Description: A three-tier team pricing section for React and Next.js with prominent seat-bracket headers per-seat NumberFlow animated pricing PillTabs billing toggle progressive feature lists with emerald checkmarks ShadcnioButton CTAs and Tooltip info icons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-team-tiers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Team Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Plans that grow with your team
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Volume discounts at every tier. The more seats you add, the less you pay per person.
        </p>

        <div class="mt-6 flex items-center justify-center">
            @* PillTabs billing toggle *@
            <div class="inline-flex items-center gap-1 rounded-full border border-border bg-muted p-1">
                @foreach (var opt in _billingOptions)
                {
                    var option = opt;
                    <button type="button"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == option ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _billing = option)">
                        @(option == "monthly" ? "Monthly" : "Annually")
                    </button>
                }
            </div>
        </div>
    </div>

    @* Plan grid *@
    <div class="mx-auto mt-10 grid max-w-lg gap-4 lg:max-w-none lg:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var perSeat = _billing == "monthly" ? plan.MonthlyPerSeat : plan.AnnualPerSeat;
            var isCustom = perSeat == null;
            <article class="@Cn.Merge("flex h-full flex-col overflow-hidden rounded-2xl bg-muted", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">

                @* Seat-bracket header tile with reserved badge slot *@
                <div class="border-b border-foreground/10 bg-foreground/5 px-6 pb-5 pt-4 text-center">
                    @* Reserved badge slot — rendered on every card for Y-alignment *@
                    <div class="mb-2 flex h-6 items-center justify-center">
                        @if (plan.IsPopular)
                        {
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        }
                    </div>
                    <div class="flex items-center justify-center gap-2">
                        <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" aria-hidden="true" />
                        <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                            @plan.SeatLabel
                        </span>
                    </div>
                    <p class="mt-1 text-3xl font-bold tabular-nums tracking-tight">
                        @plan.TeamRange
                    </p>
                </div>

                @* Card body *@
                <div class="flex flex-1 flex-col p-6 lg:p-7">
                    <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                    <p class="mt-2 min-h-[2.75rem] text-sm leading-relaxed text-muted-foreground">
                        @plan.Description
                    </p>

                    @* Price *@
                    <div class="mt-6 flex h-12 items-baseline gap-1.5 sm:h-14">
                        @if (isCustom)
                        {
                            <span class="text-4xl font-bold tracking-tight">Custom</span>
                        }
                        else
                        {
                            <span class="text-4xl font-bold tracking-tight tabular-nums">$@perSeat</span>
                            <span class="text-sm text-muted-foreground">/seat/mo</span>
                        }
                    </div>
                    <p class="mt-1 min-h-[16px] text-xs text-muted-foreground">
                        @if (isCustom)
                        {
                            <text>Volume pricing, contact sales</text>
                        }
                        else if (_billing == "annually")
                        {
                            <text>Billed annually at $@(perSeat * 12)/seat/year</text>
                        }
                        else
                        {
                            <text>Billed monthly per active seat</text>
                        }
                    </p>

                    @* CTA *@
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full">
                        @plan.Cta
                    </ButtonCn>

                    @* Features *@
                    <div class="mt-6 flex-1">
                        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            @plan.FeatureHeading
                        </p>
                        <ul class="mt-4 space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start justify-between gap-2">
                                    <span class="flex items-start gap-2.5">
                                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                        <span class="text-sm font-medium text-foreground">
                                            @feature.Name
                                        </span>
                                    </span>
                                    @if (!string.IsNullOrEmpty(feature.Tooltip))
                                    {
                                        <TooltipProviderCn DelayDuration="200">
                                            <TooltipCn>
                                                <TooltipTriggerCn>
                                                    <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 cursor-help text-muted-foreground/40" />
                                                </TooltipTriggerCn>
                                                <TooltipContentCn Class="max-w-[220px]">
                                                    <p class="text-xs">@feature.Tooltip</p>
                                                </TooltipContentCn>
                                            </TooltipCn>
                                        </TooltipProviderCn>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Volume discounts available
        for 50+ seats.
    </p>
</section>

