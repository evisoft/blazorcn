@* ============================================================
   Block: pricing-per-transaction
   Title: PricingPerTransaction
   Description: A per-transaction pricing block for React and Next.js with stacked horizontal rate rows showing percentage and flat fees per transaction type, animated NumberFlow rate comparison, PillTabs region toggle, ShadcnioButton CTAs, emerald checkmarks, and no monthly fee callout built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-per-transaction.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="space-y-6">

        @* Headline *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Transaction pricing
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Pay only for what you process
            </h2>
            <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
                Simple, transparent rates with no monthly fees, no setup costs, and no hidden charges.
                Volume discounts kick in automatically.
            </p>
        </div>

        @* Region toggle — PillTabs rendered as styled pill button group *@
        <div class="flex items-center justify-center">
            <div class="inline-flex rounded-full border bg-muted p-1 gap-1" role="tablist" aria-label="Pricing region">
                @foreach (var reg in _regions)
                {
                    var r = reg;
                    <button role="tab"
                            aria-selected="@(_region == r ? "true" : "false")"
                            class="@Cn.Merge("rounded-full px-4 py-1 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", _region == r ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _region = r)">
                        @RegionLabel(r)
                    </button>
                }
            </div>
        </div>

        @* Unified rate card *@
        <div class="overflow-hidden rounded-2xl border bg-card">

            @* Zero monthly fee bar *@
            <div class="flex items-center justify-between border-b bg-muted/40 px-6 py-3.5 sm:px-8">
                <div class="flex items-center gap-2.5">
                    <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                    <span class="text-sm font-semibold">No monthly fee. No setup cost.</span>
                </div>
                <span class="hidden text-xs text-muted-foreground sm:inline">
                    Billed in @ActiveRegion.Currency
                </span>
            </div>

            @* Transaction rate rows *@
            @foreach (var txType in _transactionTypes)
            {
                var t = txType;
                var rate = ActiveRegion.Rates[t.Id];
                <div class="flex flex-col gap-3 border-t px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
                    @* Left: name + description *@
                    <div class="flex min-w-0 flex-1 items-start gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <h3 class="text-base font-semibold">@t.Label</h3>
                                <TooltipProviderCn DelayDuration="200">
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <LucideIconCn Name="info" Size="14" Class="size-3.5 shrink-0 cursor-help text-muted-foreground/40" />
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="max-w-[220px]">
                                            <p class="text-xs">@t.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TooltipProviderCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@t.Description</p>
                        </div>
                    </div>

                    @* Right: rate display *@
                    <div class="flex items-baseline justify-end gap-1.5 sm:min-w-[200px]">
                        <span class="text-2xl font-bold tabular-nums">@rate.Percent.ToString("0.#")</span>
                        <span class="text-2xl font-bold tabular-nums">%</span>
                        @if (rate.Fixed > 0)
                        {
                            <span class="text-base font-medium text-muted-foreground">+</span>
                            <span class="text-base font-semibold tabular-nums">@CurrencySymbol@rate.Fixed.ToString("0.00")</span>
                        }
                    </div>
                </div>
            }

            @* Included section *@
            <div class="border-t bg-muted/20 px-6 py-5 sm:px-8">
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Every transaction includes
                </p>
                <ul class="mt-3 grid gap-2.5 sm:grid-cols-2">
                    @foreach (var feature in _includedFeatures)
                    {
                        <li class="flex items-center gap-2.5">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm font-medium text-foreground">@feature</span>
                        </li>
                    }
                </ul>
            </div>

            @* CTA footer *@
            <div class="flex flex-col items-center gap-3 border-t px-6 py-5 sm:flex-row sm:justify-between sm:px-8">
                <p class="text-xs text-muted-foreground">
                    Volume discounts apply automatically above $80K/month
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 sm:w-[240px]">
                    Start accepting payments
                </ButtonCn>
            </div>

        </div>
    </div>
</section>

@code {
    private string _region = "us";

    private static readonly string[] _regions = ["us", "eu", "uk"];

    private static string RegionLabel(string region) => region switch
    {
        "us" => "United States",
        "eu" => "Europe",
        "uk" => "United Kingdom",
        _ => region
    };

    private record TransactionType(string Id, string Label, string Description, string Tooltip);

    private record RateEntry(double Percent, double Fixed);

    private record RegionRates(string Id, string Label, string Currency, Dictionary<string, RateEntry> Rates);

    private static readonly TransactionType[] _transactionTypes =
    [
        new("domestic", "Domestic cards", "Cards issued in the same country",
            "Standard Visa, Mastercard, Discover, and American Express cards issued domestically."),
        new("international", "International cards", "Cross-border card payments",
            "Cards issued outside the merchant country. Includes a 1% cross-border fee plus standard processing."),
        new("wallet", "Digital wallets", "Apple Pay, Google Pay, Link",
            "One-click payments via tokenized wallets. Same blended rate as domestic cards with no extra wallet fee."),
        new("ach", "ACH direct debit", "Bank transfers and SEPA",
            "Direct bank debits via ACH (US), SEPA (EU), or BACS (UK). Capped fee per transaction with 3-5 business day settlement."),
    ];

    private static readonly Dictionary<string, RegionRates> _rateRegions = new()
    {
        ["us"] = new("us", "us", "USD", new()
        {
            ["domestic"]      = new(2.9, 0.3),
            ["international"] = new(3.9, 0.3),
            ["wallet"]        = new(2.9, 0.3),
            ["ach"]           = new(0.8, 0.0),
        }),
        ["eu"] = new("eu", "eu", "EUR", new()
        {
            ["domestic"]      = new(1.5, 0.25),
            ["international"] = new(2.5, 0.25),
            ["wallet"]        = new(1.5, 0.25),
            ["ach"]           = new(0.35, 0.0),
        }),
        ["uk"] = new("uk", "uk", "GBP", new()
        {
            ["domestic"]      = new(1.5, 0.2),
            ["international"] = new(2.9, 0.2),
            ["wallet"]        = new(1.5, 0.2),
            ["ach"]           = new(0.5, 0.0),
        }),
    };

    private static readonly Dictionary<string, string> _currencySymbols = new()
    {
        ["us"] = "$",
        ["eu"] = "€",
        ["uk"] = "£",
    };

    private static readonly string[] _includedFeatures =
    [
        "Built-in fraud protection (Radar ML)",
        "PCI DSS Level 1 compliance",
        "Instant payouts to debit cards",
        "Dispute and chargeback handling",
    ];

    private RegionRates ActiveRegion => _rateRegions[_region];
    private string CurrencySymbol => _currencySymbols[_region];
}
