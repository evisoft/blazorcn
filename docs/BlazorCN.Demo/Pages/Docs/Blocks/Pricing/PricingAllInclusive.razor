@* ============================================================
   Block: pricing-all-inclusive
   Title: PricingAllInclusive
   Description: A premium all-inclusive pricing section for React and Next.js featuring a single centered plan card, NumberFlow animated prices with PillTabs billing toggle, categorized feature groups with tooltips, and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-all-inclusive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <TooltipProviderCn>
        @* Header *@
        <div class="text-center">
            <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                Simple Pricing
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                No tiers. No upsells. Just everything.
            </h2>
            <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
                @_plan.Tagline Stop comparing checkboxes — get the whole platform from day one.
            </p>
        </div>

        @* Single highlighted card *@
        <article class="relative mx-auto mt-10 max-w-3xl overflow-hidden rounded-2xl bg-muted p-6 sm:p-10">
            @* Top: name + price + CTA *@
            <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-3">
                        <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">@_plan.Name</h3>
                        <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    </div>
                    <p class="mt-3 text-sm text-muted-foreground leading-relaxed max-w-sm">
                        @_plan.Description
                    </p>

                    @* Billing toggle *@
                    <div class="mt-5 flex justify-start">
                        <div class="inline-flex rounded-full bg-background p-1 shadow-sm border border-border">
                            @foreach (var opt in _billingOptions)
                            {
                                var option = opt;
                                <button
                                    type="button"
                                    class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == option ? "bg-foreground text-background shadow" : "text-muted-foreground hover:text-foreground")"
                                    @onclick="@(() => _billing = option)">
                                    @(option == "monthly" ? "Monthly" : "Annually")
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @* Price block *@
                <div class="flex flex-col items-stretch gap-4 sm:items-end sm:shrink-0">
                    <div class="flex items-baseline gap-1.5 sm:min-w-[140px] sm:justify-end">
                        <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">
                            $@CurrentPrice
                        </span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>
                    <p class="text-xs text-muted-foreground sm:text-right">
                        @(_billing == "annually"
                            ? $"Billed annually at ${_plan.AnnualPrice * 12}/year"
                            : "Billed monthly, cancel anytime")
                    </p>
                </div>
            </div>

            @* CTA *@
            <ButtonCn Class="mt-8 w-full" Size="ButtonSize.Lg">Start your 14-day free trial</ButtonCn>

            @* Feature groups *@
            <div class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2">
                @foreach (var grp in _featureGroups)
                {
                    <div>
                        <h4 class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
                            @grp.Heading
                        </h4>
                        <ul class="mt-4 flex flex-col gap-3.5">
                            @foreach (var feat in grp.Features)
                            {
                                var feature = feat;
                                <li class="flex items-center justify-between gap-2">
                                    <div class="flex min-w-0 items-start gap-3">
                                        <LucideIconCn Name="check" Size="20" Class="mt-0.5 h-5 w-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                        <span class="text-base font-medium text-foreground leading-tight">
                                            @feature.Name
                                        </span>
                                    </div>
                                    @if (feature.Tooltip != null)
                                    {
                                        <TooltipCn>
                                            <TooltipTriggerCn Tabbable="false">
                                                <button
                                                    type="button"
                                                    class="-m-1 inline-flex shrink-0 cursor-help items-center justify-center rounded p-1 text-muted-foreground/40 transition-colors hover:text-foreground">
                                                    <LucideIconCn Name="info" Size="14" Class="size-3.5" aria-hidden="true" />
                                                    <span class="sr-only">More info</span>
                                                </button>
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Side="FloatingSide.Top" Class="max-w-[200px]">
                                                <p class="text-xs">@feature.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </article>

        @* Trust footer *@
        <div class="mt-6 flex items-center justify-center gap-2 text-xs text-muted-foreground">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-500 stroke-[2.5]" aria-hidden="true" />
            <span>30-day money-back guarantee. No questions asked. Cancel anytime.</span>
        </div>
    </TooltipProviderCn>
</section>

@code {
    private string _billing = "annually";

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private int CurrentPrice => _billing == "monthly" ? _plan.MonthlyPrice : _plan.AnnualPrice;

    private record PlanInfo(string Name, string Tagline, int MonthlyPrice, int AnnualPrice, string Description);
    private record PlanFeature(string Name, string? Tooltip = null);
    private record FeatureGroup(string Heading, PlanFeature[] Features);

    private static readonly PlanInfo _plan = new(
        "All-Access Pro",
        "Stop comparing. Start building.",
        99,
        79,
        "Every feature, every integration, every add-on. One price covers everything — for as long as you stay subscribed."
    );

    private static readonly FeatureGroup[] _featureGroups =
    [
        new("Platform",
        [
            new("Unlimited projects & workspaces", "Create as many isolated environments as your team needs."),
            new("Unlimited team members"),
            new("500GB storage with global CDN", "Content served from 40+ edge locations worldwide for sub-100ms latency."),
            new("Custom domains with auto-SSL"),
        ]),
        new("Collaboration",
        [
            new("Real-time multiplayer editing"),
            new("Branching & merge workflows", "Collaborate on features without stepping on each other's toes."),
            new("Comment threads & mentions"),
            new("Guest access (view-only)"),
        ]),
        new("Security",
        [
            new("SAML SSO & directory sync", "Connect Okta, Azure AD, or Google Workspace effortlessly."),
            new("Audit logs (1-year retention)"),
            new("Custom RBAC & permissions"),
            new("SOC 2 Type II compliance"),
        ]),
        new("Support",
        [
            new("24/7 priority chat support"),
            new("Dedicated onboarding specialist"),
            new("99.99% uptime SLA", "Financial guarantees for platform availability."),
            new("Quarterly business reviews"),
        ]),
    ];
}
