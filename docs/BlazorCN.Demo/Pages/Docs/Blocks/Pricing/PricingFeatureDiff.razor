@* ============================================================
   Block: pricing-feature-diff
   Title: PricingFeatureDiff
   Description: A single hero feature diff pricing section for React and Next.js with two plan pills connected by an arrow at the top, NumberFlow animated upgrade price, a vertical diff list showing per-feature before to after value progression with arrow connectors and optional highlight badges, and a single ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-feature-diff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Upgrade
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Here&rsquo;s exactly what changes
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
            Every limit lifted, every feature unlocked. See the difference per feature instead of
            comparing two flat cards.
        </p>
    </div>

    @* Single hero diff card *@
    <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
        @* Top: from → to plan pills + price *@
        <div class="border-b px-6 py-7 sm:px-8">
            <div class="flex flex-wrap items-center justify-center gap-3">
                <span class="rounded-full border bg-muted px-4 py-1.5 text-sm font-semibold text-muted-foreground">
                    @_fromPlan
                </span>
                <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground" aria-hidden="true" />
                <span class="rounded-full bg-foreground px-4 py-1.5 text-sm font-semibold text-background">
                    @_toPlan
                </span>
            </div>

            <div class="mt-5 flex items-baseline justify-center gap-1.5">
                <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">$@_upgradePrice</span>
                <span class="text-base text-muted-foreground">/month</span>
            </div>
            <p class="mt-2 text-center text-xs text-muted-foreground">
                Billed monthly · Cancel anytime · 14-day free trial
            </p>
        </div>

        @* Diff list *@
        <div class="divide-y">
            @foreach (var diff in _diffs)
            {
                <div class="grid grid-cols-1 gap-2 px-6 py-4 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-4 sm:px-8">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        @diff.Name
                    </p>
                    <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                        <span class="text-sm tabular-nums text-muted-foreground/70 line-through decoration-muted-foreground/30">
                            @diff.FromValue
                        </span>
                        <LucideIconCn Name="move-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
                        <span class="text-sm font-semibold tabular-nums text-foreground">
                            @diff.ToValue
                        </span>
                        @if (diff.Badge != null)
                        {
                            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 ring-1 ring-emerald-500/20 dark:text-emerald-400">
                                @diff.Badge
                            </span>
                        }
                    </div>
                </div>
            }
        </div>

        @* CTA *@
        <div class="border-t bg-muted/30 px-6 py-6 sm:px-8">
            <ButtonCn Class="w-full">Upgrade to @_toPlan</ButtonCn>
        </div>
    </div>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Money-back guarantee for 30 days. Downgrade or cancel anytime from settings.
    </p>
</section>

@code {
    private const string _fromPlan = "Free";
    private const string _toPlan = "Pro";
    private const int _upgradePrice = 39;

    private record FeatureDiff(string Name, string FromValue, string ToValue, string? Badge = null);

    private static readonly FeatureDiff[] _diffs =
    [
        new("Storage", "1 GB", "100 GB", "100× more"),
        new("Projects", "3", "Unlimited", "no cap"),
        new("Team members", "Solo", "Up to 10"),
        new("Build minutes", "200 / mo", "5,000 / mo", "25× more"),
        new("Custom domains", "—", "Auto-SSL"),
        new("API access", "Read-only", "REST + GraphQL"),
        new("Analytics", "Last 7 days", "Full history"),
        new("Support", "Community", "Priority 4h SLA"),
    ];
}
