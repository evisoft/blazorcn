@* ============================================================
   Block: pricing-annual-savings
   Title: PricingAnnualSavings
   Description: A 3-column dark highlight pricing section for React and Next.js with PillTabs billing toggle, NumberFlow animated prices, ShadcnioButton CTAs, and the middle Pro card using dark bg-foreground styling to drive annual upgrades built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-annual-savings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Save up to 30% with annual billing
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground leading-relaxed">
            Commit annually and lock in your rate for the year. Switch billing periods anytime — no
            penalty, no fine print.
        </p>

        @* Billing toggle — PillTabs rendered as raw pill-style segmented control *@
        <div class="mt-6 flex items-center justify-center">
            <div id="annual-savings-billing" role="tablist" aria-label="Billing period"
                 class="inline-flex rounded-full bg-muted p-1 gap-1">
                @foreach (var opt in _billingOptions)
                {
                    var option = opt;
                    <button role="tab"
                            aria-selected="@(_billing == option ? "true" : "false")"
                            @onclick="@(() => _billing = option)"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == option ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @(option == "monthly" ? "Monthly" : "Annually")
                    </button>
                }
            </div>
        </div>
    </div>

    @* Plan cards — default stretch alignment equalizes heights across all cards *@
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
        @foreach (var pl in _plans)
        {
            var plan = pl;
            var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
            var isDark = plan.Highlight == "dark";
            var savingsPercent = (int)Math.Round((double)(plan.MonthlyPrice - plan.AnnualPrice) / plan.MonthlyPrice * 100);

            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl p-6 sm:p-7", isDark ? "bg-foreground text-background shadow-2xl" : "bg-muted text-foreground")">
                @if (isDark)
                {
                    <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-emerald-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                        Save @(savingsPercent)% Annually
                    </span>
                }

                @* Plan name + description *@
                <h3 class="@Cn.Merge("text-2xl font-bold tracking-tight", isDark ? "text-background" : "text-foreground")">
                    @plan.Name
                </h3>
                <p class="@Cn.Merge("mt-2 min-h-[2.75rem] text-sm leading-relaxed", isDark ? "text-background/65" : "text-muted-foreground")">
                    @plan.Description
                </p>

                @* Price — static value (no NumberFlow animation in Blazor) *@
                <div class="mt-6 flex h-14 items-baseline gap-1.5 sm:h-16">
                    <span class="inline-flex min-w-[120px] justify-start">
                        <span class="@Cn.Merge("text-4xl font-bold tracking-tight tabular-nums sm:text-5xl", isDark ? "text-background" : "text-foreground")">
                            $@price
                        </span>
                    </span>
                    <span class="@Cn.Merge("text-sm", isDark ? "text-background/60" : "text-muted-foreground")">
                        /mo
                    </span>
                </div>
                <p class="@Cn.Merge("mt-1 h-4 text-xs", isDark ? "text-background/60" : "text-muted-foreground")">
                    @(_billing == "annually"
                        ? $"Billed annually at ${price * 12}/year"
                        : "Billed monthly, cancel anytime")
                </p>

                @* CTA *@
                @if (isDark)
                {
                    <ButtonCn Class="mt-6 w-full bg-background text-foreground hover:bg-background/90">
                        @plan.Cta
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Class="mt-6 w-full">
                        @plan.Cta
                    </ButtonCn>
                }

                @* Features *@
                <div class="@Cn.Merge("mt-6 border-t pt-6", isDark ? "border-background/15" : "border-border")">
                    <p class="@Cn.Merge("text-xs font-semibold uppercase tracking-wider", isDark ? "text-background/55" : "text-muted-foreground")">
                        @plan.FeatureHeading
                    </p>
                    <ul class="mt-4 flex flex-col gap-3">
                        @foreach (var feat in plan.Features)
                        {
                            var feature = feat;
                            <li class="@Cn.Merge("flex items-start gap-2.5 text-base font-medium", isDark ? "text-background" : "text-foreground")">
                                <LucideIconCn Name="check" Size="20" Class="@Cn.Merge("mt-0.5 size-5 shrink-0 stroke-[3]", isDark ? "text-emerald-400" : "text-emerald-600 dark:text-emerald-500")" aria-hidden="true" />
                                @feature.Name
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Switch periods anytime.
    </p>
</section>

@code {
    private record PlanFeature(string Name);

    private record Plan(
        string Id,
        string Name,
        string Description,
        int MonthlyPrice,
        int AnnualPrice,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta,
        string Highlight
    );

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private string _billing = "annually";

    private static readonly Plan[] _plans =
    [
        new(
            "starter",
            "Starter",
            "For individuals and side projects.",
            19,
            15,
            "What's included:",
            [
                new("Up to 5 projects"),
                new("10GB storage with CDN"),
                new("Basic analytics dashboard"),
                new("Community support"),
                new("Standard integrations"),
            ],
            "Get started",
            "none"
        ),
        new(
            "pro",
            "Pro",
            "For growing teams shipping every week.",
            50,
            35,
            "Everything in Starter, plus:",
            [
                new("Unlimited projects"),
