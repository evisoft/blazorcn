@* ============================================================
   Block: pricing-minimal-single
   Title: PricingMinimalSingle
   Description: An ultra-minimal single plan pricing section for React and Next.js with a centered bg-muted card, hero-scale price display, two-column feature grid with emerald checkmarks, full-width ShadcnioButton CTA, and trust text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-minimal-single.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Headline (above card, centered) *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            One plan. Everything included.
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Simple pricing, no surprises
        </h2>
    </div>

    @* Single hero card *@
    <article class="relative mt-8 overflow-hidden rounded-2xl bg-muted p-8 sm:p-10">
        @* Tiny accent strip *@
        <div aria-hidden="true" class="absolute left-0 top-0 h-1 w-full bg-foreground"></div>

        @* Plan label *@
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                    The @_plan.Name plan
                </p>
                <h3 class="mt-1 text-2xl font-bold tracking-tight">For builders who ship fast</h3>
            </div>
            <span class="hidden rounded-full bg-emerald-500/10 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-emerald-600 sm:inline-block dark:text-emerald-500">
                Save @_discountPercent%
            </span>
        </div>

        <p class="mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            @_plan.Description
        </p>

        @* Hero price row *@
        <div class="mt-7 flex items-baseline gap-3">
            <s aria-hidden="true" class="text-2xl font-medium tabular-nums text-muted-foreground/60">
                $@_plan.OriginalPrice
            </s>
            <span class="text-6xl font-bold tracking-tight tabular-nums sm:text-7xl">
                $@_plan.Price
            </span>
            <span class="text-base text-muted-foreground">@_plan.Period</span>
        </div>
        <p class="mt-2 text-sm font-bold text-emerald-600 dark:text-emerald-500">
            −@_discountPercent% — limited launch pricing
        </p>

        @* Two-column feature grid *@
        <ul class="mt-7 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
            @foreach (var feature in _plan.Features)
            {
                <li class="flex items-center gap-2.5">
                    <LucideIconCn Name="check" Size="16" aria-hidden="true" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                    <span class="text-sm font-medium text-foreground">@feature</span>
                </li>
            }
        </ul>

        @* CTA *@
        <ButtonCn Class="mt-8 w-full">@_plan.Cta</ButtonCn>

        <p class="mt-4 text-center text-xs text-muted-foreground">
            No credit card required · 14-day free trial · Cancel anytime
        </p>
    </article>
</section>

@code {
    private record PlanData(
        string Name,
        string Description,
        int OriginalPrice,
        int Price,
        string Period,
        string Cta,
        string[] Features
    );

    private static readonly PlanData _plan = new(
        Name: "Pro",
        Description: "Everything you need to build, ship, and scale — in one focused plan.",
        OriginalPrice: 79,
        Price: 49,
        Period: "/month",
        Cta: "Get started for free",
        Features:
        [
            "Unlimited projects and deployments",
            "100GB storage with global CDN",
            "Up to 10 team members",
            "Priority support (4h SLA)",
            "Custom domains with auto-SSL",
            "Full REST and GraphQL API",
            "Advanced analytics and funnels",
            "99.95% uptime SLA",
        ]
    );

    private static readonly int _discountPercent = (int)Math.Round(((double)(_plan.OriginalPrice - _plan.Price) / _plan.OriginalPrice) * 100);
}
