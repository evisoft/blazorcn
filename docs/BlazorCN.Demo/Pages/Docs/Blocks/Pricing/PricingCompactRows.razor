@* ========================================
   Block: pricing-compact-rows
   Title: Pricing Compact Rows
   Description: Ultra-minimal horizontal row layout for pricing tiers with inline features and call-to-action buttons
   Long Description: Clean side-by-side free vs pro layout
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideCircleDotCn
   Source: original/blocks/pricing/pricing-compact-rows.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">Pricing</h2>
            <p class="text-muted-foreground text-lg">
                Simple plans. Predictable costs. Scale when ready.
            </p>
        </div>

        <div class="mx-auto max-w-3xl">
            <div class="rounded-lg border">
                @for (var i = 0; i < _plans.Length; i++)
                {
                    var plan = _plans[i];
                    @if (i > 0)
                    {
                        <SeparatorCn />
                    }
                    <div class="@Cn.Merge("flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:gap-6 md:p-5", plan.IsPopular ? "bg-primary/[0.03]" : "")">
                        @* Plan name *@
                        <div class="flex items-center gap-3 sm:w-44 sm:shrink-0">
                            <div class="flex items-center gap-2">
                                <LucideCircleDotCn Class="@Cn.Merge("h-4 w-4", plan.IsPopular ? "text-primary" : "text-muted-foreground/50")" Size="16" />
                                <span class="font-semibold">@plan.Name</span>
                            </div>
                            @if (plan.IsPopular)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Popular</BadgeCn>
                            }
                        </div>

                        @* Price *@
                        <div class="flex items-baseline gap-0.5 sm:w-28 sm:shrink-0">
                            <span class="text-2xl font-bold tracking-tight">@plan.PriceDisplay</span>
                            @if (plan.Price > 0)
                            {
                                <span class="text-muted-foreground text-sm">@plan.Period</span>
                            }
                        </div>

                        @* Highlights *@
                        <div class="flex flex-1 flex-wrap gap-x-4 gap-y-1">
                            @foreach (var highlight in plan.Highlights)
                            {
                                <span class="text-muted-foreground flex items-center gap-1.5 text-sm">
                                    <LucideCheckCn Class="h-3 w-3 shrink-0" Size="12" />
                                    @highlight
                                </span>
                            }
                        </div>

                        @* CTA *@
                        <div class="shrink-0">
                            <ButtonCn Class="w-full gap-1.5 sm:w-auto" Size="ButtonSize.Sm"
                                      Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                                @plan.Cta
                                <LucideArrowRightCn Class="h-3.5 w-3.5" Size="14" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>

            <p class="text-muted-foreground mt-6 text-center text-sm">
                All paid plans include a 14-day free trial. No credit card required.
            </p>
        </div>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, string Period, string PriceDisplay, string[] Highlights, bool IsPopular, string Cta);

    private static readonly Plan[] _plans =
    [
        new("Free", 0, "", "Free", ["3 projects", "1 GB storage", "Community support"], false, "Get Started"),
        new("Pro", 29, "/mo", "$29", ["Unlimited projects", "50 GB storage", "Priority support", "API access"], true, "Start Trial"),
        new("Team", 79, "/mo", "$79", ["Everything in Pro", "25 seats", "SSO", "Audit logs"], false, "Start Trial"),
        new("Enterprise", 0, "", "Custom", ["Unlimited everything", "Dedicated support", "Custom SLA", "On-premise"], false, "Contact Us"),
    ];
}
