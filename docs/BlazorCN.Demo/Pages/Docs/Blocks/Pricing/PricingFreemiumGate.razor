@* ============================================================
   Block: pricing-freemium-gate
   Title: PricingFreemiumGate
   Description: A freemium gate split-layout pricing section for React and Next.js with left-aligned marketing headline and right-side stacked plan cards comparing a free tier with locked features against a highlighted premium tier with NumberFlow animated prices, PillTabs billing toggle, lock and emerald check icons, ShadcnioButton CTAs, and trust messaging built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-freemium-gate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start lg:gap-12">

        @* Left: marketing headline + stats *@
        <div class="lg:sticky lg:top-8">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Pricing · Freemium
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Unlock your full<br />potential
            </h2>
            <p class="mt-4 max-w-md text-base text-muted-foreground leading-relaxed">
                The free plan gets you started. Premium removes every limit and unlocks every feature
                our customers love.
            </p>

            @* Billing toggle *@
            <div class="mt-6">
                <div class="inline-flex items-center gap-1 rounded-full bg-muted p-1">
                    @foreach (var opt in _billingOptions)
                    {
                        var option = opt;
                        <button
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == option ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _billing = option)"
                            aria-label="@($"Switch to {option} billing")">
                            @(option == "monthly" ? "Monthly" : "Annually")
                        </button>
                    }
                </div>
            </div>

            @* Stats *@
            <dl class="mt-8 grid grid-cols-2 gap-4 border-t pt-6">
                @foreach (var stat in _stats)
                {
                    <div>
                        <dt class="sr-only">@stat.Label</dt>
                        <dd>
                            <p class="text-2xl font-bold tracking-tight tabular-nums">@stat.Value</p>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@stat.Label</p>
                        </dd>
                    </div>
                }
            </dl>
        </div>

        @* Right: stacked plan cards *@
        <div class="space-y-4">
            @foreach (var plan in _plans)
            {
                var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
                <article class="@Cn.Merge("relative flex h-full flex-col overflow-hidden rounded-2xl bg-muted p-6 sm:p-7", plan.IsHighlighted ? "ring-2 ring-foreground/10" : "")">

                    @* Reserved badge slot — rendered on every card so headings align *@
                    <div class="mb-4 flex h-7 items-start">
                        @if (plan.Badge != null)
                        {
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                @plan.Badge
                            </span>
                        }
                    </div>

                    @* Header row: name + price *@
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
                        <div>
                            <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                            <p class="mt-1.5 min-h-[2.75rem] text-sm text-muted-foreground leading-relaxed">
                                @plan.Description
                            </p>
                        </div>

                        <div class="flex h-12 items-baseline gap-1.5 sm:h-14 sm:justify-end">
                            @if (price == 0)
                            {
                                <span class="text-4xl font-bold tracking-tight tabular-nums">$0</span>
                            }
                            else
                            {
                                <span class="text-4xl font-bold tracking-tight tabular-nums">$@price</span>
                            }
                            <span class="text-sm text-muted-foreground">/mo</span>
                        </div>
                    </div>

                    @* Features grid *@
                    <ul class="mt-6 grid flex-1 gap-2.5 sm:grid-cols-2">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start gap-2 text-sm font-medium leading-snug">
                                @if (feature.Locked)
                                {
                                    <LucideIconCn Name="lock" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground/40" aria-hidden="true" />
                                    <span class="text-muted-foreground/40 line-through">@feature.Name</span>
                                }
                                else
                                {
                                    <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                    <span class="text-foreground">@feature.Name</span>
                                }
                            </li>
                        }
                    </ul>

                    @* CTA *@
                    <ButtonCn Class="mt-6 w-full">
                        @plan.Cta
                        @if (plan.IsHighlighted)
                        {
                            <LucideIconCn Name="arrow-up-right" Size="16" Class="size-4" aria-hidden="true" />
                        }
                    </ButtonCn>
                </article>
            }

            @* Trust text *@
            <p class="text-center text-xs text-muted-foreground">
                14-day free trial on Premium · No credit card required · Cancel anytime
            </p>
        </div>
    </div>
</section>

@code {
    private string _billing = "monthly";

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private record PlanFeatureItem(string Name, bool Locked);

    private record PlanItem(
        string Id,
        string Name,
        string Description,
        int MonthlyPrice,
        int AnnualPrice,
        PlanFeatureItem[] Features,
        string Cta,
        bool IsHighlighted,
        string? Badge = null);

    private static readonly PlanItem[] _plans =
    [
        new(
            Id: "free",
            Name: "Free",
            Description: "Get started with the basics. No credit card required.",
            MonthlyPrice: 0,
            AnnualPrice: 0,
            Features:
            [
                new("Up to 3 projects", false),
                new("500MB storage", false),
                new("Community forum support", false),
                new("1 team member", false),
                new("Advanced analytics", true),
                new("Custom domains", true),
                new("API and webhook access", true),
                new("Priority support", true),
            ],
            Cta: "Continue with Free",
            IsHighlighted: false),
        new(
            Id: "premium",
            Name: "Premium",
            Description: "Unlock everything. No limits, no locked features.",
            MonthlyPrice: 39,
            AnnualPrice: 29,
            Features:
            [
                new("Unlimited projects and 100GB storage", false),
                new("Priority email and chat support (4h SLA)", false),
                new("Advanced analytics with funnels", false),
                new("Up to 25 team members", false),
                new("Custom domains with auto-SSL", false),
                new("REST and GraphQL API access", false),
                new("Webhooks and custom integrations", false),
                new("SAML SSO and audit logs", false),
            ],
            Cta: "Unlock everything",
            IsHighlighted: true,
            Badge: "Best Value"),
    ];

    private record StatItem(string Value, string Label);

    private static readonly StatItem[] _stats =
    [
        new("92%", "of users upgrade within 30 days"),
        new("4.9/5", "average rating from 12k+ teams"),
    ];
}
