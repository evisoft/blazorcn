@* ============================================================
   Block: pricing-storage-plans
   Title: PricingStoragePlans
   Description: A three-column pricing section for React and Next.js with oversized hero capacity numbers dominating each card, NumberFlow animated prices, PillTabs billing toggle, split metric bars for two secondary stats, progressive feature lists with emerald checkmarks, and ShadcnioButton CTAs built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-storage-plans.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Marketing header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Cloud storage plans
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Storage that scales with you
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            From terabytes to petabytes. Enterprise-grade encryption and global CDN included with
            every plan.
        </p>

        <div class="mt-6 flex justify-center">
            <div class="inline-flex items-center rounded-full bg-muted p-1 text-sm font-medium">
                <button
                    class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _billing == "monthly" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = "monthly")">
                    Monthly
                </button>
                <button
                    class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _billing == "annually" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = "annually")">
                    Annually
                </button>
            </div>
        </div>
    </div>

    @* Plan grid *@
    <div class="mt-10 grid gap-4 md:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
            <article class="@Cn.Merge("relative flex h-full flex-col overflow-hidden rounded-2xl bg-muted p-6 sm:p-7", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                @* Reserved badge slot — rendered on every card for Y-alignment *@
                <div class="mb-3 flex h-7 items-start justify-center">
                    @if (plan.IsPopular)
                    {
                        <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>

                @* Plan name + description *@
                <div class="text-center">
                    <h3 class="text-lg font-bold tracking-tight">@plan.Name</h3>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                        @plan.Description
                    </p>
                </div>

                @* HERO storage number — visual centerpiece *@
                <div class="mt-6 flex items-baseline justify-center gap-2">
                    <span class="text-7xl font-black tracking-tighter tabular-nums leading-none">
                        @plan.StorageNumber
                    </span>
                    <span class="text-3xl font-bold tracking-tight text-muted-foreground">
                        @plan.StorageUnit
                    </span>
                </div>
                <p class="mt-1 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Total storage
                </p>

                @* Bandwidth + retention metric bar *@
                <div class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-border">
                    <div class="bg-background/70 px-3 py-3 text-center">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            Bandwidth
                        </p>
                        <p class="mt-1 text-xs font-semibold text-foreground">
                            @plan.BandwidthLabel
                        </p>
                    </div>
                    <div class="bg-background/70 px-3 py-3 text-center">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            Retention
                        </p>
                        <p class="mt-1 text-xs font-semibold text-foreground">
                            @plan.RetentionLabel
                        </p>
                    </div>
                </div>

                @* Price *@
                <div class="mt-5 flex items-baseline justify-center gap-1.5">
                    <span class="text-3xl font-bold tracking-tight tabular-nums">
                        $@price
                    </span>
                    <span class="text-sm text-muted-foreground">/month</span>
                </div>

                @* CTA *@
                <ButtonCn Class="mt-5 w-full">@plan.Cta</ButtonCn>

                @* Feature list *@
                <div class="mt-6 flex-1">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        @plan.FeatureHeading
                    </p>
                    <ul class="mt-3 space-y-2.5">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-center justify-between gap-2">
                                <span class="flex items-center gap-2.5">
                                    <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                    <span class="text-sm font-medium text-foreground">
                                        @feature.Name
                                    </span>
                                </span>
                                @if (feature.Tooltip != null)
                                {
                                    <TooltipProviderCn Delay="200">
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <LucideIconCn Name="info" Size="12" Class="size-3 shrink-0 cursor-help text-muted-foreground/30" />
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[220px]">
                                                <p class="text-xs">@feature.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    </TooltipProviderCn>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 7-day free trial. Overage billed at $0.05/GB beyond your plan's
        bandwidth. Cancel anytime.
    </p>
</section>

