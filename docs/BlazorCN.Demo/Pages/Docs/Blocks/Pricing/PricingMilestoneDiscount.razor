@* ============================================================
   Block: pricing-milestone-discount
   Title: PricingMilestoneDiscount
   Description: A three-column dark highlight pricing section for React and Next.js with per-card milestone progress bars, PillTabs billing toggle, and NumberFlow animated prices built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-milestone-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Grow more, pay less</h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Every plan unlocks milestone discounts. Hit your usage threshold and your rate drops
            automatically — no action needed.
        </p>

        <div class="mt-7 flex items-center justify-center">
            <div class="inline-flex items-center rounded-full border bg-muted p-1 text-muted-foreground">
                @foreach (var tab in _billingOptions)
                {
                    var t = tab;
                    <button type="button"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == t ? "bg-background text-foreground shadow-sm" : "hover:text-foreground")"
                            @onclick="@(() => _billing = t)">
                        @(t == "monthly" ? "Monthly" : "Annually")
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
            var isDark = plan.Highlight == "dark";
            var progressWidth = (int)Math.Round((double)plan.MilestoneDiscount / _maxDiscount * 100);

            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl p-6", isDark ? "bg-foreground text-background" : "bg-muted")">
                @* Reserved badge slot on every card so headings align *@
                <div class="mb-4 flex h-7 items-start">
                    @if (isDark)
                    {
                        <span class="inline-block rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>

                <h3 class="@Cn.Merge("text-2xl font-bold tracking-tight", isDark ? "text-background" : "")">
                    @plan.Name
                </h3>
                <p class="@Cn.Merge("mt-1.5 min-h-[2.75rem] text-sm leading-relaxed", isDark ? "text-background/60" : "text-muted-foreground")">
                    @plan.Description
                </p>

                <div class="mt-5 flex h-12 items-baseline gap-1 sm:h-14">
                    <span class="@Cn.Merge("text-4xl font-bold tracking-tight tabular-nums sm:text-5xl", isDark ? "text-background" : "")">
                        $@price
                    </span>
                    <span class="@Cn.Merge("text-sm", isDark ? "text-background/60" : "text-muted-foreground")">
                        /mo
                    </span>
                </div>
                <p class="@Cn.Merge("mt-1 h-4 text-xs", isDark ? "text-background/50" : "text-muted-foreground")">
                    @(_billing == "annually" ? $"Billed ${plan.AnnualPrice * 12}/year" : "Billed monthly")
                </p>

                @* Milestone discount panel *@
                <div class="@Cn.Merge("mt-5 rounded-xl p-3.5", isDark ? "bg-background/10" : "bg-background/60")">
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="trending-up" Size="16" aria-hidden="true"
                                          Class="@Cn.Merge("size-4", isDark ? "text-background/80" : "text-foreground")" />
                            <span class="@Cn.Merge("text-xs font-semibold uppercase tracking-wider", isDark ? "text-background" : "text-foreground")">
                                Milestone unlock
                            </span>
                        </div>
                        <span class="@Cn.Merge("text-base font-bold tabular-nums", isDark ? "text-background" : "text-emerald-600 dark:text-emerald-500")">
                            −@(plan.MilestoneDiscount)%
                        </span>
                    </div>

                    <div class="@Cn.Merge("mt-2.5 h-1.5 w-full overflow-hidden rounded-full", isDark ? "bg-background/15" : "bg-muted-foreground/20")">
                        <div class="@Cn.Merge("h-full rounded-full", isDark ? "bg-background" : "bg-emerald-600 dark:bg-emerald-500")"
                             style="@($"width:{progressWidth}%")">
                        </div>
                    </div>
                    <p class="@Cn.Merge("mt-2 text-[11px]", isDark ? "text-background/60" : "text-muted-foreground")">
                        Unlocks at @plan.MilestoneThreshold
                    </p>
                </div>

                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(isDark ? ButtonVariant.Outline : ButtonVariant.Default)"
                          Class="@Cn.Merge("mt-5 w-full", isDark ? "border-background/30 bg-background text-foreground hover:bg-background/90" : "")">
                    @plan.Cta
                </ButtonCn>

                <div class="mt-6 flex-1">
                    <p class="@Cn.Merge("text-xs font-semibold uppercase tracking-wider", isDark ? "text-background/70" : "text-muted-foreground")">
                        @plan.FeatureHeading
                    </p>
                    <ul class="mt-3.5 space-y-2.5">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start justify-between gap-2">
                                <span class="flex items-start gap-2.5">
                                    <LucideIconCn Name="check" Size="16" aria-hidden="true"
                                                  Class="@Cn.Merge("mt-0.5 size-4 shrink-0 stroke-[3]", isDark ? "text-background" : "text-emerald-600 dark:text-emerald-500")" />
                                    <span class="@Cn.Merge("text-sm font-medium", isDark ? "text-background/90" : "text-foreground")">
                                        @feature.Name
                                    </span>
                                </span>
                                @if (feature.Tooltip != null && !isDark)
                                {
                                    <TooltipProviderCn DelayDuration="200">
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <button type="button" class="mt-0.5 shrink-0"
                                                        aria-label="@($"More info about {feature.Name}")">
                                                    <LucideIconCn Name="info" Size="14"
                                                                  Class="size-3.5 cursor-help text-muted-foreground/40" />
                                                </button>
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[200px]">
                                                <p class="text-xs">@feature.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    </TooltipProviderCn>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. Milestone discounts apply automatically. Prices in
        USD.
    </p>
</section>

@code {
