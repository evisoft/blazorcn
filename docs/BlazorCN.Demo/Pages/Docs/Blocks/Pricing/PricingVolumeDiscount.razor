@* ============================================================
   Block: pricing-volume-discount
   Title: PricingVolumeDiscount
   Description: A volume discount pricing section for React and Next.js with compact horizontal tier rows showing per-seat price brackets, savings percentage indicators, the best-value tier highlighted with red Best Value badge, NumberFlow animated total estimator, ShadcnioButton CTAs, and trust text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-volume-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="flex items-center justify-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
            <LucideIconCn Name="trending-down" Size="14" Class="size-3.5" aria-hidden="true" />
            Volume pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            The bigger your team, the more you save
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Per-seat pricing drops automatically as your team grows. Save up to 62% on your largest
            rollouts.
        </p>
    </div>

    @* Tier rows *@
    <div class="mt-10 overflow-hidden rounded-2xl bg-muted">
        @foreach (var (tier, i) in _tiers.Select((t, idx) => (t, idx)))
        {
            <div class="@Cn.Merge("relative flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:p-6", i > 0 ? "border-t" : "", tier.IsBestValue ? "bg-background/60 ring-1 ring-inset ring-foreground/15" : "")">
                @* Left: identity *@
                <div class="flex items-center gap-4">
                    <div class="@Cn.Merge("flex size-12 shrink-0 items-center justify-center rounded-xl text-sm font-bold tabular-nums", tier.IsBestValue ? "bg-foreground text-background" : "bg-background text-foreground ring-1 ring-border")">
                        <LucideIconCn Name="users" Size="20" Class="size-5" aria-hidden="true" />
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2">
                            <h3 class="text-lg font-bold tracking-tight">@tier.Label</h3>
                            @if (tier.IsBestValue)
                            {
                                <span class="rounded-full bg-red-500 px-2.5 py-0.5 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                    Best Value
                                </span>
                            }
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            <span class="font-semibold text-foreground tabular-nums">
                                @FormatRange(tier)
                            </span>
                            &#160;· @tier.Description
                        </p>
                    </div>
                </div>

                @* Right: price + CTA *@
                <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-end sm:gap-5">
                    <div class="flex flex-col items-start gap-0.5 sm:items-end sm:min-w-[140px]">
                        <div class="flex items-baseline gap-1.5">
                            @if (tier.SavingsPercent > 0)
                            {
                                <s aria-hidden="true" class="text-sm text-muted-foreground/60 tabular-nums">
                                    $@tier.OriginalPricePerSeat
                                </s>
                            }
                            <span class="text-xl font-bold tabular-nums">$</span>
                            <span class="text-3xl font-bold tracking-tight tabular-nums">@tier.PricePerSeat</span>
                            <span class="text-xs text-muted-foreground">/seat</span>
                        </div>
                        @if (tier.SavingsPercent > 0)
                        {
                            <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 tabular-nums dark:text-emerald-500">
                                Save @(tier.SavingsPercent)% per seat
                            </p>
                        }
                        else
                        {
                            <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                                Base rate
                            </p>
                        }
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 sm:w-[200px]">
                        @tier.Cta
                    </ButtonCn>
                </div>
            </div>
        }
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Prices in USD. All tiers include SSO, audit logs, and 24/7 support. Custom enterprise
        pricing available for 1,000+ seats.
    </p>
</section>

@code {
    private record VolumeTier(
        string Id,
        string Label,
        int MinSeats,
        int? MaxSeats,
        int PricePerSeat,
        int OriginalPricePerSeat,
        int SavingsPercent,
        int ExampleSeats,
        string Description,
        string Cta,
        bool IsBestValue
    );

    private static readonly VolumeTier[] _tiers =
    [
        new("starter", "Starter", 1, 10, 24, 24, 0, 5, "For small teams getting started.", "Get started", false),
        new("growth", "Growth", 11, 50, 18, 24, 25, 25, "For growing teams that need collaboration.", "Get started", false),
        new("scale", "Scale", 51, 200, 12, 24, 50, 100, "For mid-sized teams ready to scale.", "Start trial", true),
        new("enterprise", "Enterprise", 201, null, 9, 24, 62, 500, "For large orgs with custom requirements.", "Contact sales", false),
    ];

    private static string FormatRange(VolumeTier tier)
    {
        if (tier.MaxSeats is null) return $"{tier.MinSeats}+ seats";
        return $"{tier.MinSeats}–{tier.MaxSeats} seats";
    }
}
