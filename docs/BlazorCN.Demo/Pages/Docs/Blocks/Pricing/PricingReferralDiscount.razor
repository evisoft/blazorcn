@* ============================================================
   Block: pricing-referral-discount
   Title: PricingReferralDiscount
   Description: A single highlighted plan pricing section for React and Next.js with a referral hero card showing 3 months free, NumberFlow animated savings, friend referrer name and avatar, bidirectional benefit breakdown, ShadcnioButton claim CTA, and a small comparison strip linking to other plans built with shadcn/ui Avatar and Tailwind CSS
   Source: original/blocks/pricing/pricing-referral-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Header — referrer attribution *@
    <div class="text-center">
        <div class="inline-flex items-center gap-2.5 rounded-full border bg-muted/40 py-1.5 pl-1.5 pr-4">
            <AvatarCn Class="size-7 border bg-background">
                <AvatarImageCn Src="@_referral.ReferrerAvatar" Alt="@_referral.ReferrerName" />
                <AvatarFallbackCn Class="text-[10px] font-semibold">@_referral.ReferrerInitials</AvatarFallbackCn>
            </AvatarCn>
            <span class="text-xs font-medium text-foreground">
                <span class="font-semibold">@_referral.ReferrerName</span> invited you
            </span>
        </div>

        <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Get
            <span class="inline-block">
                <span class="tabular-nums">@_referral.MonthsFree</span> months free
            </span>
            <br />
            <span class="text-muted-foreground/60">on Pro.</span>
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
            Maya thinks you'll love it. Try it free for 3 months &mdash; she'll get a free month too
            when you stick around.
        </p>
    </div>

    @* Hero plan card *@
    <article class="relative mt-8 overflow-hidden rounded-2xl bg-muted p-6 sm:p-8">
        @* Top ribbon *@
        <div class="flex items-center justify-between gap-3 border-b border-border/60 pb-5">
            <div class="flex items-center gap-2.5">
                <span class="flex size-9 items-center justify-center rounded-full bg-foreground text-background">
                    <LucideIconCn Name="gift" Size="16" Class="size-4" aria-hidden="true" />
                </span>
                <div>
                    <h3 class="text-xl font-bold tracking-tight">@_proPlan.Name plan</h3>
                    <p class="text-xs text-muted-foreground">@_proPlan.Description</p>
                </div>
            </div>
            <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                Friend Offer
            </span>
        </div>

        @* Price block — strikethrough + free *@
        <div class="mt-6 flex flex-wrap items-end gap-x-4 gap-y-2">
            <div class="flex items-baseline gap-2">
                <s aria-hidden="true" class="text-2xl font-bold tabular-nums text-muted-foreground/50">
                    $@_proPlan.MonthlyPrice
                </s>
                <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">$0</span>
                <span class="text-base text-muted-foreground">/month</span>
            </div>
            <div class="flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-3 py-1">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-emerald-700 dark:text-emerald-400" aria-hidden="true" />
                <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400">
                    You save $@_totalSavings over @_referral.MonthsFree months
                </span>
            </div>
        </div>
        <p class="mt-2 text-xs text-muted-foreground">
            Free for @_referral.MonthsFree months, then $@_proPlan.MonthlyPrice/month. Cancel anytime
            &mdash; no charge if you cancel before the trial ends.
        </p>

        @* CTA *@
        <div class="mt-6">
            <ButtonCn Class="w-full">Claim @_referral.MonthsFree months free</ButtonCn>
        </div>

        @* Bidirectional benefits *@
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
            @foreach (var benefit in _benefits)
            {
                var ben = benefit;
                <div class="@Cn.Merge("rounded-xl border p-4", ben.Recipient == "you" ? "border-emerald-500/30 bg-emerald-500/5" : "border-border bg-background/40")">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="16" Class="@Cn.Merge("size-4 shrink-0 stroke-[3]", ben.Recipient == "you" ? "text-emerald-600 dark:text-emerald-500" : "text-foreground")" aria-hidden="true" />
                        <p class="text-sm font-semibold text-foreground">@ben.Label</p>
                    </div>
                    <p class="mt-1.5 pl-6 text-xs leading-relaxed text-muted-foreground">
                        @ben.Detail
                    </p>
                </div>
            }
        </div>

        @* Feature inclusion *@
        <div class="mt-6 border-t border-border/60 pt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                What you get on Pro
            </p>
            <ul class="mt-3 grid gap-2.5 sm:grid-cols-2">
                @foreach (var feature in _proPlan.Features)
                {
                    <li class="flex items-start gap-2">
                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                        <span class="text-sm font-medium text-foreground">@feature</span>
                    </li>
                }
            </ul>
        </div>
    </article>

    @* Alternative plans strip *@
    <div class="mt-6">
        <p class="text-center text-xs font-medium text-muted-foreground">
            Not the right fit? Browse other plans:
        </p>
        <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:gap-3">
            @foreach (var plan in _altPlans)
            {
                var altPlan = plan;
                <button type="button"
                        class="group flex flex-1 items-center justify-between rounded-xl border bg-card px-4 py-3 text-left transition-colors hover:border-foreground/30 hover:bg-muted/40">
                    <div>
                        <p class="text-sm font-semibold text-foreground">@altPlan.Name</p>
                        <p class="text-xs text-muted-foreground">@altPlan.Description</p>
                    </div>
                    <span class="text-sm font-bold tabular-nums text-foreground">
                        @altPlan.Price<span class="ml-0.5 text-xs font-normal text-muted-foreground">/mo</span>
                    </span>
                </button>
            }
        </div>
    </div>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Referral credit applied automatically at checkout. Both you and Maya benefit. No credit card
        required to start.
    </p>
</section>

@code {
    private record ReferralInfo(
        int MonthsFree,
        string ReferrerName,
        string ReferrerHandle,
        string ReferrerInitials,
        string ReferrerAvatar);

    private record ReferralBenefit(string Recipient, string Label, string Detail);

    private record ProPlanInfo(string Name, int MonthlyPrice, string Description, string[] Features);

    private record AltPlan(string Id, string Name, string Price, string Description);

    private static readonly ReferralInfo _referral = new(
        MonthsFree: 3,
        ReferrerName: "Maya Tanaka",
        ReferrerHandle: "@maya",
        ReferrerInitials: "MT",
        ReferrerAvatar: "https://i.pravatar.cc/120?img=47");

    private static readonly ReferralBenefit[] _benefits =
    [
        new("you", "You get 3 months free", "Full Pro access, no credit card required to start."),
        new("friend", "Maya gets 1 month credit", "Applied automatically when you upgrade after the trial."),
    ];

    private static readonly ProPlanInfo _proPlan = new(
        Name: "Pro",
        MonthlyPrice: 49,
        Description: "Everything Maya uses, ready for your next project.",
        Features:
        [
            "Unlimited projects and storage",
            "Priority support with 4h SLA",
            "Advanced analytics and funnels",
            "Custom domains with auto-SSL",
            "Up to 15 team members",
            "REST and GraphQL API access",
        ]);

    private static readonly AltPlan[] _altPlans =
    [
        new("starter", "Starter", "$15", "For solo side projects"),
        new("business", "Business", "$99", "SSO and compliance"),
    ];

    private static readonly int _totalSavings = 3 * 49;
}
