@* ============================================================
   Block: pricing-feature-matrix
   Title: PricingFeatureMatrix
   Description: A detailed comparison table pricing section for React and Next.js with 4 plan columns from Free to Enterprise, 20+ feature rows organized into 5 categories with full-width category headers, emerald checkmarks for booleans, quantities for limits, dashes for unavailable items, and ShadcnioButton CTAs in the header built with shadcn/ui Table and Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-feature-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Compare Plans
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Every feature, side by side
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            See exactly what is included in each plan. All plans include SSL, global CDN, and
            automatic backups.
        </p>
    </div>

    @* Table card *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-background">
        <div class="overflow-x-auto">
            <TableCn Class="w-full min-w-[1060px] table-fixed">
                @* Plan header *@
                <TableHeaderCn>
                    <TableRowCn Class="border-b hover:bg-transparent">
                        <TableHeadCn Class="w-[260px] p-5 align-bottom">
                            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                Features
                            </span>
                        </TableHeadCn>
                        @foreach (var plan in _plans)
                        {
                            <TableHeadCn Class="@Cn.Merge("w-[200px] p-5 align-bottom text-center", plan.IsPopular ? "bg-muted" : "")">
                                @* Reserved badge slot — rendered on every column for Y-alignment *@
                                <div class="mb-2 flex h-6 items-start justify-center">
                                    @if (plan.IsPopular)
                                    {
                                        <span class="inline-block rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                            Best Value
                                        </span>
                                    }
                                </div>
                                <div class="flex flex-col items-center gap-2">
                                    <div class="text-center">
                                        <h3 class="text-base font-bold tracking-tight text-foreground">
                                            @plan.Name
                                        </h3>
                                        <p class="mt-0.5 text-[11px] text-muted-foreground">
                                            @plan.Description
                                        </p>
                                    </div>
                                    <div class="flex items-baseline gap-1">
                                        <span class="text-3xl font-bold tabular-nums tracking-tight">
                                            @(plan.Price == 0 ? "Free" : $"${plan.Price}")
                                        </span>
                                        @if (plan.Price > 0)
                                        {
                                            <span class="text-xs text-muted-foreground">@plan.Period</span>
                                        }
                                    </div>
                                    <ButtonCn Size="ButtonSize.Sm" Class="mt-1 w-full min-w-0">
                                        @plan.Cta
                                    </ButtonCn>
                                </div>
                            </TableHeadCn>
                        }
                    </TableRowCn>
                </TableHeaderCn>

                <TableBodyCn>
                    @foreach (var cat in _featureCategories)
                    {
                        @* Category header row *@
                        <TableRowCn Class="bg-muted/60 hover:bg-muted/60">
                            <TableCellCn Colspan="@(_plans.Length + 1)" Class="px-5 py-3">
                                <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                                    @cat.Name
                                </span>
                            </TableCellCn>
                        </TableRowCn>

                        @* Feature rows *@
                        @foreach (var feat in cat.Features)
                        {
                            <TableRowCn Class="border-b transition-colors hover:bg-muted/20">
                                <TableCellCn Class="px-5 py-3.5">
                                    <span class="flex items-center gap-1.5 text-sm font-medium text-foreground">
                                        @feat.Name
                                        @if (!string.IsNullOrEmpty(feat.Tooltip))
                                        {
                                            <TooltipCn>
                                                <TooltipTriggerCn Tabbable="false">
                                                    <button type="button" aria-label="@($"More info about {feat.Name}")" class="cursor-help">
                                                        <LucideIconCn Name="info" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40 transition-colors hover:text-muted-foreground" />
                                                    </button>
                                                </TooltipTriggerCn>
                                                <TooltipContentCn Class="max-w-[220px]">
                                                    <p class="text-xs">@feat.Tooltip</p>
                                                </TooltipContentCn>
                                            </TooltipCn>
                                        }
                                    </span>
                                </TableCellCn>
                                @foreach (var plan in _plans)
                                {
                                    var cellVal = feat.Values.GetValueOrDefault(plan.Id);
                                    <TableCellCn Class="@Cn.Merge("px-5 py-3.5 text-center", plan.IsPopular ? "bg-muted" : "")">
                                        @if (cellVal == "true")
                                        {
                                            <LucideIconCn Name="check" Size="20" Class="mx-auto size-5 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                            <span class="sr-only">Included</span>
                                        }
                                        else if (cellVal == null)
                                        {
                                            <LucideIconCn Name="minus" Size="16" Class="mx-auto size-4 text-muted-foreground/30" aria-hidden="true" />
                                            <span class="sr-only">Not included</span>
                                        }
                                        else
                                        {
                                            <span class="text-sm font-semibold tabular-nums text-foreground">@cellVal</span>
                                        }
                                    </TableCellCn>
                                }
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>

    @* Footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All paid plans include a 14-day free trial · No credit card required · Prices in USD
    </p>
</section>

@code {
