@* ============================================================
   Block: pricing-unlimited-plan
   Title: PricingUnlimitedPlan
   Description: A single unlimited plan pricing section for React and Next.js with massive UNLIMITED wordmark, NumberFlow animated price, comprehensive list of unlimited capabilities with quantity highlights, emerald checkmarks, ShadcnioButton CTA, and trust text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-unlimited-plan.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Massive UNLIMITED wordmark headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            One plan. Zero limits.
        </p>
        <h2 class="mt-3 flex items-center justify-center gap-2 font-black text-6xl tracking-tighter sm:text-7xl lg:text-8xl">
            <LucideIconCn Name="infinity" Size="48" Class="size-12 stroke-[3] sm:size-14 lg:size-16" aria-hidden="true" />
            <span>UNLIMITED</span>
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Everything your team needs to ship, scale, and sleep at night. No usage caps. No surprise
            invoices. Ever.
        </p>
    </div>

    @* Card *@
    <article class="mt-10 overflow-hidden rounded-2xl bg-muted p-6 sm:p-10">
        @* Price + CTA row *@
        <div class="flex flex-col gap-6 border-b pb-8 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    Flat rate, per workspace
                </p>
                <div class="mt-2 flex items-baseline gap-2">
                    <span class="text-3xl font-bold tabular-nums">$</span>
                    <span class="text-6xl font-bold tracking-tight tabular-nums sm:text-7xl">@_price</span>
                    <span class="text-base text-muted-foreground">/month</span>
                </div>
                <p class="mt-2 text-sm text-muted-foreground">
                    No per-user fees. No per-usage charges. Just one number.
                </p>
            </div>
            <ButtonCn Class="w-full shrink-0 sm:w-[260px]">
                Start 14-day trial
            </ButtonCn>
        </div>

        @* Feature grid *@
        <div class="pt-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Everything included, with no asterisks
            </p>
            <ul class="mt-5 grid gap-x-6 gap-y-4 sm:grid-cols-2">
                @foreach (var feature in _features)
                {
                    var feat = feature;
                    <li class="flex items-start gap-3">
                        <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-foreground">@feat.Name</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@feat.Detail</p>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </article>

    @* Trust strip *@
    <div class="mt-6 flex flex-col items-center justify-center gap-1.5 text-xs text-muted-foreground sm:flex-row sm:gap-4">
        <span class="flex items-center gap-1.5">
            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" aria-hidden="true" />
            30-day money-back guarantee
        </span>
        <span class="hidden sm:inline">·</span>
        <span>No credit card to start</span>
        <span class="hidden sm:inline">·</span>
        <span>Cancel anytime</span>
    </div>
</section>

@code {
    private const int _price = 99;

    private record Feature(string Name, string Detail);

    private static readonly Feature[] _features =
    [
        new("Unlimited projects", "No project caps or workspace limits"),
        new("Unlimited storage", "Files, assets, and databases on global CDN"),
        new("Unlimited team members", "Invite your entire org at no extra cost"),
        new("Unlimited API calls", "No rate limits, no overage charges"),
        new("Unlimited custom domains", "Auto-SSL provisioning and renewal"),
        new("Unlimited integrations", "Connect every tool in your workflow"),
        new("Priority support, 4h SLA", "Dedicated engineer for your account"),
        new("SAML SSO and audit logs", "Enterprise-grade security and compliance"),
    ];
}
