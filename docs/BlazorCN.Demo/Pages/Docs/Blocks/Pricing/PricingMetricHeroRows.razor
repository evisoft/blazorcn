@* ============================================================
   Block: pricing-metric-hero-rows
   Title: PricingMetricHeroRows
   Description: A vertical stack of wide horizontal metric-hero row pricing section for React and Next.js with four full-width rows each leading with a massive left-aligned numeric metric, NumberFlow animated base prices, inline feature pill rows, semantic plan icons, ShadcnioButton CTAs, and a ring highlight on the recommended tier built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-metric-hero-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pick the tier that fits your traffic
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground leading-relaxed">
            Every plan lists its headline metric first. Scan the left column to find the capacity that
            matches your scale, then upgrade or contact sales when you outgrow it.
        </p>
    </div>

    @* Stacked rows — each is a full-width horizontal 3-panel layout *@
    <div class="mt-9 space-y-3">
        @foreach (var plan in _plans)
        {
            <article class="@Cn.Merge("grid grid-cols-1 gap-5 rounded-2xl border bg-card p-6 sm:grid-cols-[minmax(200px,240px)_1fr_minmax(160px,200px)] sm:items-center sm:gap-6 sm:p-7", plan.IsRecommended ? "border-foreground/20 ring-2 ring-foreground/10" : "")">
                @* LEFT: hero metric + proportional bar *@
                <div class="relative">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        Data transfer
                    </p>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">
                            @plan.MetricValue
                        </span>
                        <span class="text-sm font-semibold text-muted-foreground">
                            @plan.MetricUnit
                        </span>
                    </div>
                    @* Proportional scale bar — shows this tier's weight vs the category max *@
                    <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@Cn.Merge("h-full rounded-full", plan.IsRecommended ? "bg-foreground" : "bg-foreground/40")"
                             style="@(FormattableString.Invariant($"width:{BarWidthPercent(plan.MetricBarValue):F1}%"))">
                        </div>
                    </div>
                </div>

                @* MIDDLE: name, tagline, feature pills *@
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@plan.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <h3 class="text-xl font-bold tracking-tight">@plan.Name</h3>
                        @if (plan.IsRecommended)
                        {
                            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 ring-1 ring-emerald-500/20 dark:text-emerald-400">
                                Recommended
                            </span>
                        }
                    </div>
                    <p class="mt-1 text-sm text-muted-foreground leading-relaxed">@plan.Tagline</p>
                    <ul class="mt-3 flex flex-wrap gap-1.5">
                        @foreach (var pill in plan.FeaturePills)
                        {
                            <li class="rounded-full border bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                                @pill
                            </li>
                        }
                    </ul>
                </div>

                @* RIGHT: price + CTA stacked *@
                <div class="flex flex-col items-stretch gap-2 sm:items-end">
                    <div class="flex items-baseline gap-1 sm:justify-end">
                        @if (plan.MonthlyPrice == null)
                        {
                            <span class="text-2xl font-bold tracking-tight">@plan.PriceLabel</span>
                        }
                        else if (plan.MonthlyPrice == 0)
                        {
                            <span class="text-2xl font-bold tracking-tight">@plan.PriceLabel</span>
                        }
                        else
                        {
                            <span class="text-2xl font-bold tracking-tight tabular-nums">$@plan.MonthlyPrice</span>
                            <span class="text-xs text-muted-foreground">/mo</span>
                        }
                    </div>
                    <ButtonCn Size="ButtonSize.Sm"
                              Variant="@(plan.IsRecommended ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Class="w-full sm:w-auto">
                        @plan.Cta
                    </ButtonCn>
                </div>
            </article>
        }
    </div>

    @* Trust footer *@
    <p class="mt-7 text-center text-xs text-muted-foreground">
        Overage billed at $0.04/GB. All plans include SSL, DDoS protection, and HTTP/3 support.
        Volume discounts available for 500TB+ accounts.
    </p>
</section>

@code {
    private record PlanRow(
        string Id,
        string Name,
        string Tagline,
        string IconName,
        string MetricValue,
        string MetricUnit,
        int MetricBarValue,
        int? MonthlyPrice,
        string? PriceLabel,
        string[] FeaturePills,
        string Cta,
        bool IsRecommended = false
    );

    private static readonly PlanRow[] _plans =
    [
        new("starter", "Starter", "For side projects and low-traffic sites", "rocket", "100", "GB / mo", 100, 0, "Free",
            ["3 edge locations", "Standard SSL", "Community support"], "Get started free"),
        new("growth", "Growth", "For early-stage products with growing traffic", "zap", "1", "TB / mo", 1000, 49, null,
            ["25 edge locations", "Wildcard SSL", "Email support"], "Start 14-day trial"),
        new("scale", "Scale", "For high-traffic apps needing global edge delivery", "sparkles", "10", "TB / mo", 10000, 199, null,
            ["80+ edge locations", "Origin shield 95%+", "Priority 4h SLA"], "Start 14-day trial", IsRecommended: true),
        new("enterprise", "Enterprise", "For mission-critical platforms at global scale", "building", "100", "TB+ / mo", 100000, null, "Custom",
            ["150+ edge locations", "Dedicated IPs", "24/7 phone 1h SLA"], "Contact sales"),
    ];

    private static readonly double _maxBar = Math.Log10(_plans.Max(p => p.MetricBarValue));

    private static double BarWidthPercent(int value)
    {
        if (value <= 0) return 4;
        var percent = (Math.Log10(value) / _maxBar) * 100;
        return Math.Max(8, Math.Min(100, percent));
    }
}
