@* ============================================================
   Block: pricing-vertical-tabs-panels
   Title: PricingVerticalTabsPanels
   Description: A vertical tabs pricing section for React and Next.js with a left sidebar listing plan tabs and a right detail panel that morphs on selection showing a NumberFlow animated price benefit highlights feature list and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-vertical-tabs-panels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Plans and pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pick the plan that fits how you ship
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Browse each plan in depth without losing your place. Select a tier on the left to morph
            the detail panel on the right.
        </p>
    </div>

    @* Main card *@
    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        <div class="grid md:grid-cols-[220px_1fr]">
            @* Tab sidebar *@
            <div role="tablist"
                 aria-label="Plan tiers"
                 aria-orientation="vertical"
                 class="relative border-b border-foreground/10 md:border-b-0 md:border-r">
                <div class="flex md:flex-col">
                    @foreach (var plan in _plans)
                    {
                        var planItem = plan;
                        var isActive = planItem.Id == _activeId;
                        <button type="button"
                                role="tab"
                                id="@($"tab-{planItem.Id}")"
                                aria-selected="@(isActive ? "true" : "false")"
                                aria-controls="@($"panel-{planItem.Id}")"
                                tabindex="@(isActive ? "0" : "-1")"
                                @onclick="@(() => _activeId = planItem.Id)"
                                class="@Cn.Merge("relative flex flex-1 flex-col items-start gap-0.5 px-4 py-4 text-left transition-colors focus:outline-none focus-visible:bg-foreground/5 md:flex-none", isActive ? "bg-background" : "hover:bg-foreground/5")">
                            @if (isActive)
                            {
                                <span class="absolute inset-x-0 bottom-0 h-0.5 bg-foreground md:inset-y-0 md:left-0 md:h-auto md:w-0.5 md:bg-foreground"></span>
                            }
                            <div class="flex w-full items-center justify-between gap-2">
                                <span class="@Cn.Merge("text-sm font-semibold tracking-tight", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @planItem.Name
                                </span>
                                @if (planItem.IsPopular)
                                {
                                    <span class="inline-flex items-center rounded-full bg-red-500 px-2 py-0.5 text-[9px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                        Best
                                    </span>
                                }
                            </div>
                            <span class="hidden text-[11px] text-muted-foreground md:block">
                                @planItem.Tagline
                            </span>
                            <div class="mt-0.5 flex items-baseline gap-0.5">
                                <span class="@Cn.Merge("font-mono text-xs tabular-nums", isActive ? "text-foreground" : "text-muted-foreground")">
                                    $@planItem.MonthlyPrice
                                </span>
                                <span class="text-[10px] text-muted-foreground">/mo</span>
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* Detail panel *@
            <div class="relative overflow-hidden">
                @{
                    var activePlan = _plans.FirstOrDefault(p => p.Id == _activeId) ?? _plans[0];
                }
                <div role="tabpanel"
                     id="@($"panel-{activePlan.Id}")"
                     aria-labelledby="@($"tab-{activePlan.Id}")"
                     class="flex flex-col p-6 sm:p-8">
                    @* Top row: title + optional badge *@
                    <div class="flex flex-wrap items-center gap-2">
                        <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                            @activePlan.Tagline
                        </p>
                        @if (activePlan.IsPopular)
                        {
                            <span class="inline-flex items-center rounded-full bg-red-500 px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        }
                    </div>
                    <h3 class="mt-2 text-3xl font-bold tracking-tight">@activePlan.Name</h3>
                    <p class="mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">
                        @activePlan.Description
                    </p>

                    @* Price *@
                    <div class="mt-5 flex items-baseline gap-1.5">
                        <span class="text-5xl font-bold tracking-tight tabular-nums">
                            $@activePlan.MonthlyPrice
                        </span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>

                    @* Highlight tiles *@
                    <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-3">
                        @foreach (var highlight in activePlan.Highlights)
                        {
                            <div class="rounded-xl border border-foreground/10 bg-background/40 p-3">
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="@highlight.Icon" Size="14" Class="size-3.5 text-muted-foreground" aria-hidden="true" />
                                    <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                                        @highlight.Label
                                    </p>
                                </div>
                                <p class="mt-1.5 text-xs font-semibold text-foreground">
                                    @highlight.Value
                                </p>
                            </div>
                        }
                    </div>

                    @* CTA *@
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full sm:w-[230px]">
                        @activePlan.Cta
                    </ButtonCn>

                    @* Features *@
                    <div class="mt-6 border-t border-foreground/10 pt-5">
                        <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                            Everything included
                        </p>
                        <ul class="mt-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                            @foreach (var feature in activePlan.Features)
                            {
                                <li class="flex items-start gap-2.5">
                                    <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                    <span class="text-sm font-medium text-foreground">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

