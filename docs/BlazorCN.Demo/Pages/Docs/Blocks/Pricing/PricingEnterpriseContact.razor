@* ========================================
   Block: pricing-enterprise-contact
   Title: Pricing Enterprise Contact
   Description: Pricing layout with two self-serve plan cards and an enterprise card featuring an inline contact sales form
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideArrowRightCn, LucideBuilding2Cn, LucideCheckCn, LucideShieldCn
   Source: original/blocks/pricing/pricing-enterprise-contact.tsx
   ======================================== *@
<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Plans that scale with you
            </h2>
            <p class="text-muted-foreground text-lg">
                Self-serve plans for small teams. Custom solutions for enterprise.
            </p>
        </div>

        <div class="mx-auto max-w-6xl">
            <div class="grid gap-6 lg:grid-cols-3">
                @* Self-Serve Plans *@
                @foreach (var plan in _selfServePlans)
                {
                    <CardCn Class="@Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20" : "border-border")">
                        @if (plan.IsPopular)
                        {
                            <div class="absolute -top-3 right-4">
                                <BadgeCn>Popular</BadgeCn>
                            </div>
                        }
                        <CardHeaderCn Class="pb-4">
                            <h3 class="text-lg font-semibold">@plan.Name</h3>
                            <div class="mt-2 flex items-baseline gap-1">
                                <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                                @if (plan.Price > 0)
                                {
                                    <span class="text-muted-foreground text-sm">/month</span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-sm">forever</span>
                                }
                            </div>
                            <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                        </CardHeaderCn>
                        <CardContentCn Class="flex-1">
                            <ul class="space-y-3">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-start gap-3">
                                        <LucideCheckCn Size="16" Class="text-primary mt-0.5 shrink-0" />
                                        <span class="text-sm">@feature</span>
                                    </li>
                                }
                            </ul>
                        </CardContentCn>
                        <CardFooterCn Class="pt-4">
                            <ButtonCn Class="w-full" Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Lg">
                                <a href="#">@plan.Cta</a>
                            </ButtonCn>
                        </CardFooterCn>
                    </CardCn>
                }

                @* Enterprise Card with Contact Form *@
                <CardCn Class="bg-muted/30 flex flex-col border-2">
                    <CardHeaderCn Class="pb-4">
                        <div class="mb-2 flex items-center gap-2">
                            <LucideBuilding2Cn Size="20" Class="text-muted-foreground" />
                            <h3 class="text-lg font-semibold">Enterprise</h3>
                        </div>
                        <div class="mt-2">
                            <span class="text-4xl font-bold tracking-tight">Custom</span>
                        </div>
                        <p class="text-muted-foreground mt-2 text-sm">
                            Tailored for your organization's needs.
                        </p>
                    </CardHeaderCn>
                    <CardContentCn Class="flex-1 space-y-6">
                        @* Enterprise Features *@
                        <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
                            @foreach (var feature in _enterpriseFeatures.Take(5))
                            {
                                <li class="flex items-start gap-2">
                                    <LucideCheckCn Size="16" Class="text-primary mt-0.5 shrink-0" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>

                        <SeparatorCn />

                        @* Contact Form *@
                        @if (_submitted)
                        {
                            <div class="space-y-3 py-4 text-center">
                                <div class="bg-primary/10 mx-auto flex h-12 w-12 items-center justify-center rounded-full">
                                    <LucideCheckCn Size="24" Class="text-primary" />
                                </div>
                                <h4 class="font-semibold">Request received</h4>
                                <p class="text-muted-foreground text-sm">
                                    Our team will reach out within one business day.
                                </p>
                            </div>
                        }
                        else
                        {
                            <form class="space-y-3" @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
                                    <div class="space-y-1.5">
                                        <LabelCn For="name" Class="text-xs">Name</LabelCn>
                                        <InputCn id="name" Placeholder="Jane Smith" />
                                    </div>
                                    <div class="space-y-1.5">
                                        <LabelCn For="email" Class="text-xs">Work email</LabelCn>
                                        <InputCn id="email" Type="email" Placeholder="@("jane@company.com")" />
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    <LabelCn For="company" Class="text-xs">Company</LabelCn>
                                    <InputCn id="company" Placeholder="Acme Inc" />
                                </div>
                                <div class="space-y-1.5">
                                    <LabelCn For="enterprise-contact-message" Class="text-xs">How can we help?</LabelCn>
                                    <TextareaCn id="enterprise-contact-message" Placeholder="Tell us about your team and requirements..." rows="3" />
                                </div>
                                <ButtonCn Type="submit" Class="w-full gap-2">
                                    Contact Sales
                                    <LucideArrowRightCn Size="16" />
                                </ButtonCn>
                            </form>
                        }

                        @* Trust Badges *@
                        <div class="flex items-center gap-2 pt-2">
                            <LucideShieldCn Size="14" Class="text-muted-foreground" />
                            <span class="text-muted-foreground text-xs">
                                SOC 2 Type II &middot; GDPR &middot; HIPAA
                            </span>
                        </div>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly int _year = DateTime.Now.Year;

    private bool _submitted;

    private void HandleSubmit() => _submitted = true;

    private record PlanInfo(string Name, int Price, string Description, string[] Features, bool IsPopular, string Cta);

    private readonly PlanInfo[] _selfServePlans =
    [
        new("Starter", 0, "For individuals getting started.",
            ["Up to 3 projects", "1 GB storage", "Community support", "Basic analytics", "Standard API access"],
            false, "Get Started Free"),
        new("Pro", 49, "For teams shipping products.",
            ["Unlimited projects", "100 GB storage", "Priority support", "Advanced analytics", "Custom domains", "Team collaboration (10 seats)", "Full API access"],
            true, "Start Free Trial"),
    ];

    private readonly string[] _enterpriseFeatures =
    [
        "Unlimited everything", "SSO & SAML authentication", "Advanced audit logs",
        "Custom SLA (99.99%)", "Dedicated account manager", "Custom integrations",
        "On-premise deployment", "24/7 phone support", "SOC 2 & HIPAA compliance",
    ];
}
