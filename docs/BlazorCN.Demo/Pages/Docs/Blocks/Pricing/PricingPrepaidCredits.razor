@* ============================================================
   Block: pricing-prepaid-credits
   Title: PricingPrepaidCredits
   Description: A four-column prepaid credit pack pricing section for React and Next.js with NumberFlow animated credit amounts and prices, progressive savings percentages, an emerald-ringed Best Value pack, ShadcnioButton purchase CTAs with sliding arrow hover effect, and a trust footer built with shadcn/ui Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-prepaid-credits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Credits
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Buy credits once. Use them whenever.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
            No subscriptions. No expiration. Larger packs unlock significantly lower per-credit rates
            &mdash; up to 60% off.
        </p>

        @* Inline trust *@
        <div class="mt-5 inline-flex items-center gap-2 rounded-full border bg-muted/40 px-4 py-1.5">
            <LucideIconCn Name="infinity" Size="14" Class="size-3.5 text-foreground" />
            <span class="text-xs font-medium text-foreground">Credits never expire</span>
        </div>
    </div>

    @* Pack grid *@
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var pack in _packs)
        {
            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl bg-muted p-6", pack.IsPopular ? "ring-2 ring-emerald-500/20" : "")">
                @* Reserved badge slot — rendered on every card for Y-alignment *@
                <div class="mb-3 flex h-7 items-start">
                    @if (pack.Badge != null)
                    {
                        <span class="inline-block rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            @pack.Badge
                        </span>
                    }
                </div>

                @* Highlight tagline *@
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="zap" Size="14" Class="@Cn.Merge("size-3.5", pack.IsPopular ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground")" />
                    <span class="@Cn.Merge("text-[11px] font-semibold uppercase tracking-wider", pack.IsPopular ? "text-emerald-700 dark:text-emerald-400" : "text-muted-foreground")">
                        @pack.Highlight
                    </span>
                </div>

                @* Credit count — hero number *@
                <div class="mt-4">
                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                            @pack.Credits.ToString("N0")
                        </span>
                    </div>
                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Credits
                    </p>
                </div>

                @* Price block *@
                <div class="mt-5 rounded-xl bg-background/60 p-3.5">
                    <div class="flex items-baseline gap-1">
                        <span class="text-xs text-muted-foreground">Pay</span>
                        <span class="text-lg font-bold tabular-nums">$@pack.Price</span>
                    </div>
                    <div class="mt-1 flex items-center gap-2">
                        <span class="text-xs text-muted-foreground">
                            $@pack.PerCredit.ToString("F3")/credit
                        </span>
                        @if (pack.SavingsPercent > 0)
                        {
                            <span aria-hidden="true" class="h-3 w-px bg-border"></span>
                            <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400">
                                Save @pack.SavingsPercent%
                            </span>
                        }
                    </div>
                </div>

                @* CTA *@
                <div class="mt-5">
                    <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                        Buy @(pack.Credits >= 1000 ? $"{pack.Credits / 1000}K" : pack.Credits.ToString()) credits
                    </ButtonCn>
                </div>

                @* Features *@
                <ul class="mt-6 flex-1 space-y-2.5">
                    @foreach (var feature in pack.Features)
                    {
                        <li class="flex items-start justify-between gap-2">
                            <span class="flex items-start gap-2">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                <span class="text-sm font-medium text-foreground">@feature.Name</span>
                            </span>
                            @if (feature.Tooltip != null)
                            {
                                <TooltipProviderCn Delay="200">
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <LucideIconCn Name="info" Size="12" Class="mt-0.5 size-3 shrink-0 cursor-help text-muted-foreground/40" />
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="max-w-[200px]">
                                            <p class="text-xs">@feature.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TooltipProviderCn>
                            }
                        </li>
                    }
                </ul>
            </article>
        }
    </div>

    @* Footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        One-time purchase. Instant delivery to your account. Volume discounts available for 50,000+
        credits.
    </p>
</section>

@code {
    private record PackFeature(string Name, string? Tooltip = null);

    private record CreditPack(
        string Id,
        int Credits,
        int Price,
        double PerCredit,
        double BaseRate,
        int SavingsPercent,
        string? Badge,
        bool IsPopular,
        string Highlight,
        PackFeature[] Features);

    private static readonly CreditPack[] _packs =
    [
        new("starter", 100, 10, 0.1, 0.1, 0, null, false, "Try the platform",
        [
            new("100 API credits"),
            new("Never expires"),
            new("Instant delivery"),
        ]),
        new("growth", 500, 40, 0.08, 0.1, 20, null, false, "For solo builders",
        [
            new("500 API credits"),
            new("Never expires"),
            new("Email support"),
        ]),
        new("scale", 2000, 120, 0.06, 0.1, 40, "Best Value", true, "What 7 in 10 teams pick",
        [
            new("2,000 API credits"),
            new("Priority queue access", "Skip the queue and process up to 4x faster."),
            new("Email support"),
            new("Usage analytics dashboard"),
        ]),
        new("enterprise", 10000, 400, 0.04, 0.1, 60, null, false, "For high-volume workloads",
        [
            new("10,000 API credits"),
            new("Priority queue access"),
            new("Dedicated support engineer"),
            new("Custom rate limits"),
        ]),
    ];
}
