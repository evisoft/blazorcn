@* ============================================================
   Block: pricing-seasonal-sale
   Title: PricingSeasonalSale
   Description: A seasonal sale pricing section for React and Next.js with sale countdown banner, three-column plan cards, strikethrough original prices with NumberFlow animated sale prices, PillTabs billing toggle, dark featured tier, emerald savings badges, and ShadcnioButton CTAs built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-seasonal-sale.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Sale banner *@
    <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-center gap-2 rounded-full border border-red-500/20 bg-red-500/10 px-4 py-2 sm:gap-3">
        <span class="flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-red-600 dark:text-red-400">
            <LucideIconCn Name="flame" Size="14" Class="size-3.5" />
            @_saleName
        </span>
        <span class="hidden h-3 w-px bg-red-500/30 sm:block"></span>
        <span class="flex items-center gap-1.5 text-xs font-medium text-red-600/90 dark:text-red-400/90">
            <LucideIconCn Name="timer" Size="14" Class="size-3.5" />
            Ends @_saleEndDate
        </span>
    </div>

    @* Header *@
    <div class="mt-6 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Save up to 51% this week
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Lock in the lowest prices of the year. Cancel anytime, keep the discount as long as you
            stay subscribed.
        </p>

        <div class="mt-6 flex items-center justify-center">
            <div class="flex items-center rounded-full border border-border bg-muted p-1 gap-1">
                @foreach (var tab in _billingOptions)
                {
                    var isActive = _billing == tab;
                    var tabVal = tab;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", isActive ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _billing = tabVal)">
                        @(tab == "monthly" ? "Monthly" : "Annually")
                    </button>
                }
            </div>
        </div>
    </div>

    @* Plan grid *@
    <div class="mt-10 grid gap-4 md:grid-cols-3 md:items-stretch">
        @foreach (var plan in _plans)
        {
            var originalPrice = _billing == "monthly" ? plan.OriginalMonthlyPrice : plan.OriginalAnnualPrice;
            var salePrice = _billing == "monthly" ? plan.SaleMonthlyPrice : plan.SaleAnnualPrice;
            var discountPercent = (int)Math.Round(((double)(originalPrice - salePrice) / originalPrice) * 100);
            var planRef = plan;
            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl p-6", plan.IsFeatured ? "bg-foreground text-background ring-2 ring-foreground/10" : "bg-muted text-foreground")">
                @if (plan.IsFeatured)
                {
                    <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                        Best Value
                    </span>
                }

                @* Plan header *@
                <div>
                    <h3 class="@Cn.Merge("text-2xl font-bold tracking-tight", plan.IsFeatured ? "text-background" : "text-foreground")">
                        @plan.Name
                    </h3>
                    <p class="@Cn.Merge("mt-2 text-sm leading-relaxed", plan.IsFeatured ? "text-background/70" : "text-muted-foreground")">
                        @plan.Description
                    </p>
                </div>

                @* Price *@
                <div class="mt-6">
                    <div class="flex items-center gap-2">
                        <s class="@Cn.Merge("text-lg font-medium tabular-nums", plan.IsFeatured ? "text-background/40" : "text-muted-foreground/60")">
                            <span class="sr-only">Original price </span>$@originalPrice
                        </s>
                        <span class="@Cn.Merge("rounded-full px-2 py-0.5 text-[11px] font-extrabold tracking-wider", plan.IsFeatured ? "bg-emerald-500/20 text-emerald-300" : "bg-emerald-500/15 text-emerald-700 dark:text-emerald-400")">
                            -@(discountPercent)%
                        </span>
                    </div>
                    <div class="mt-1 flex items-baseline gap-1.5">
                        <span class="@Cn.Merge("text-4xl font-bold tracking-tight tabular-nums", plan.IsFeatured ? "text-background" : "text-foreground")">
                            $@salePrice
                        </span>
                        <span class="@Cn.Merge("text-sm", plan.IsFeatured ? "text-background/60" : "text-muted-foreground")">
                            /mo
                        </span>
                    </div>
                    @if (_billing == "annually")
                    {
                        <p class="@Cn.Merge("mt-1.5 text-xs", plan.IsFeatured ? "text-background/50" : "text-muted-foreground")">
                            Billed at $@(salePrice * 12)/year
                        </p>
                    }
                </div>

                @* CTA *@
                <ButtonCn
                    Size="ButtonSize.Sm"
                    Class="@Cn.Merge("mt-6 w-full", plan.IsFeatured ? "bg-background text-foreground hover:bg-background/90" : "")">
                    @plan.Cta
                </ButtonCn>

                @* Features *@
                <div class="mt-6 flex-1">
                    <p class="@Cn.Merge("text-xs font-semibold uppercase tracking-wider", plan.IsFeatured ? "text-background/60" : "text-muted-foreground")">
                        @plan.FeatureHeading
                    </p>
                    <ul class="mt-3 space-y-2.5">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-center gap-2.5">
                                <LucideIconCn
                                    Name="check"
                                    Size="16"
                                    Class="@Cn.Merge("size-4 shrink-0 stroke-[3]", plan.IsFeatured ? "text-emerald-400" : "text-emerald-600 dark:text-emerald-500")"
                                    StrokeWidth="3" />
                                <span class="@Cn.Merge("text-sm font-medium", plan.IsFeatured ? "text-background/90" : "text-foreground")">
                                    @feature.Name
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        Sale price locks in for 12 months from purchase. 30-day money-back guarantee on all paid
        plans. No coupon code required.
    </p>
</section>

@code {
