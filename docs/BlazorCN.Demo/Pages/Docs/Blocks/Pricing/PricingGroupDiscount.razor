@* ============================================================
   Block: pricing-group-discount
   Title: PricingGroupDiscount
   Description: A team-size tab pricing section for React and Next.js with PillTabs audience switcher between three group sizes that swaps the visible plan card showing per-seat rate with NumberFlow animation, total monthly range, savings versus base rate, ShadcnioButton CTA, emerald checkmark feature list, and trust text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-group-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Team Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Bigger teams, better rates
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Per-seat pricing that scales down as you grow. Pick your team size and see the rate we'll
            lock in for everyone.
        </p>

        @* Team size tabs *@
        <div class="mt-6 flex items-center justify-center">
            <div class="inline-flex items-center gap-1 rounded-full bg-muted p-1">
                @foreach (var size in _teamSizes)
                {
                    var s = size;
                    <button
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _teamSize == s ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => SelectSize(s))">
                        @FormatTeamSize(s)
                    </button>
                }
            </div>
        </div>
    </div>

    @* Tier card *@
    <div class="mt-8">
        <article class="@Cn.Merge("relative overflow-hidden rounded-2xl bg-muted p-6 sm:p-8", _activeTier.IsRecommended ? "ring-2 ring-foreground/10" : "")">
            @* Reserved badge slot — rendered every card so headings align *@
            <div class="mb-4 flex h-7 items-start">
                @if (_activeTier.IsRecommended)
                {
                    <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                        Best Value
                    </span>
                }
            </div>

            @* Header: icon + name + seat range *@
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                <div class="flex items-start gap-4">
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-foreground/5">
                        <LucideIconCn Name="@_activeTier.IconName" Size="24" Class="size-6 text-foreground" />
                    </div>
                    <div class="min-w-0">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            @_activeTier.MinSeats–@_activeTier.MaxSeats seats
                        </p>
                        <h3 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
                            @_activeTier.Name
                        </h3>
                        <p class="mt-2 max-w-md text-sm text-muted-foreground leading-relaxed">
                            @_activeTier.Description
                        </p>
                    </div>
                </div>

                @* Price + total *@
                <div class="flex flex-col items-start gap-2 lg:items-end lg:text-right">
                    <div class="flex min-w-[140px] items-baseline gap-1.5 lg:justify-end">
                        <span class="text-5xl font-bold tracking-tight tabular-nums">
                            $@_activeTier.PerSeatPrice
                        </span>
                        <span class="text-sm text-muted-foreground">/seat/mo</span>
                    </div>
                    <p class="text-xs text-muted-foreground tabular-nums">
                        $@(_activeTier.MinSeats * _activeTier.PerSeatPrice)–$@(_activeTier.MaxSeats * _activeTier.PerSeatPrice) per month total
                    </p>
                    @if (_savingsPercent > 0)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
                            <LucideIconCn Name="arrow-down" Size="12" Class="size-3 stroke-[3]" StrokeWidth="3" />
                            @_savingsPercent% vs Small Team
                        </span>
                    }
                </div>
            </div>

            @* CTA *@
            <ButtonCn Class="mt-8 w-full">@_activeTier.Cta</ButtonCn>

            @* Feature list *@
            <div class="mt-8 border-t pt-6">
                <p class="text-sm font-semibold">@_activeTier.FeatureHeading</p>
                <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                    @foreach (var feature in _activeTier.Features)
                    {
                        <li class="flex items-start gap-2.5 text-sm font-medium">
                            <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span>@feature.Name</span>
                        </li>
                    }
                </ul>
            </div>
        </article>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. Volume discounts for 200+ seats available on request.
    </p>
</section>

@code {
    private record TierFeature(string Name);

    private record GroupTier(
        string Id,
        string Name,
        string IconName,
        int MinSeats,
        int MaxSeats,
        int PerSeatPrice,
        string Description,
        string FeatureHeading,
        TierFeature[] Features,
        string Cta,
        bool IsRecommended);

    private static readonly string[] _teamSizes = ["small", "medium", "large"];

    private static readonly GroupTier[] _tiers =
    [
        new("small", "Small Team", "users", 5, 10, 29,
            "For startups and tight-knit teams shipping their first product together.",
            "What's included for every seat:",
            [
                new("Unlimited projects across the team"),
                new("10GB storage per seat with CDN"),
                new("Email support (24h SLA)"),
                new("Shared workspace + comments"),
                new("Basic usage analytics"),
                new("Standard API access"),
            ],
            "Get started", false),
        new("medium", "Medium Team", "rocket", 11, 50, 22,
            "For growing teams that need collaboration, SSO, and finer access controls.",
            "Everything in Small Team, plus:",
            [
                new("50GB storage per seat with global CDN"),
                new("Priority support (4h SLA)"),
                new("Advanced analytics with funnels"),
                new("Custom domains with auto-SSL"),
                new("SAML SSO via Okta or Google"),
                new("Role-based access control (RBAC)"),
                new("Webhook integrations"),
            ],
            "Start 14-day trial", true),
        new("large", "Large Team", "building", 51, 200, 16,
            "For organizations that need enterprise security, dedicated support, and SLAs.",
            "Everything in Medium Team, plus:",
            [
                new("Unlimited storage across the workspace"),
                new("24/7 phone and chat support"),
                new("Directory sync with provisioning"),
                new("Audit logs (1-year retention)"),
                new("Dedicated account manager"),
                new("99.95% uptime SLA"),
                new("Custom onboarding program"),
            ],
            "Contact sales", false),
    ];

    private static readonly int _baseRate = 29; // TIERS.small.perSeatPrice

    private string _teamSize = "medium";

    private GroupTier _activeTier => _tiers[Array.FindIndex(_tiers, t => t.Id == _teamSize)];

    private int _savingsPercent => (int)Math.Round(((double)(_baseRate - _activeTier.PerSeatPrice) / _baseRate) * 100);

    private void SelectSize(string size)
    {
        _teamSize = size;
    }

    private static string FormatTeamSize(string size) => size switch
    {
        "small" => "Small (5–10)",
        "medium" => "Medium (11–50)",
        "large" => "Large (51–200)",
        _ => size,
    };
}
