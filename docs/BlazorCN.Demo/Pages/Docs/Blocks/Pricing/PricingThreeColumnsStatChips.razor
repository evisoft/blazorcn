    private record Plan(
        string Id,
        string Name,
        string Description,
        int? MonthlyPrice,
        int? AnnualPrice,
        string ClientsLimit,
        string SeatsLimit,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta,
        string IconName,
        bool IsPopular
