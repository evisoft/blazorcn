@* ============================================================
   Block: pricing-two-plan-comparison
   Title: PricingTwoPlanComparison
   Description: A two plan comparison pricing section for React and Next.js with paired plan headers in a unified rounded card, an inverted dark panel on the recommended side, a shared attribute matrix below the headers, ShadcnioButton CTAs, and a red Recommended badge built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-two-plan-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Deployment
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            One product. Two ways to run it.
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Same APIs, same features. Choose the operating model that fits your team — migrate between
            them anytime.
        </p>
    </div>

    @* Unified comparison card *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-background shadow-sm">
        @* Paired plan headers *@
        <div class="grid grid-cols-1 md:grid-cols-2">
            @foreach (var plan in _plans)
            {
                <div class="@Cn.Merge("relative flex flex-col p-6 sm:p-8", plan.IsDark ? "bg-foreground text-background" : "bg-muted/40")">
                    @* Recommended badge *@
                    @if (plan.Badge != null)
                    {
                        <span class="absolute right-5 top-5 inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                            @plan.Badge
                        </span>
                    }

                    @* Icon + plan name *@
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("flex size-10 items-center justify-center rounded-xl", plan.IsDark ? "bg-background/10" : "bg-foreground/5")">
                            @if (plan.Icon == "cloud")
                            {
                                <LucideIconCn Name="cloud" Size="20" Class="size-5" />
                            }
                            else
                            {
                                <LucideIconCn Name="server" Size="20" Class="size-5" />
                            }
                        </div>
                        <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                    </div>

                    @* Description *@
                    <p class="@Cn.Merge("mt-4 max-w-xs text-sm leading-relaxed", plan.IsDark ? "text-background/70" : "text-muted-foreground")">
                        @plan.Description
                    </p>

                    @* Price *@
                    <div class="mt-6 flex items-baseline gap-1.5">
                        <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                            @plan.Price
                        </span>
                        <span class="@Cn.Merge("text-sm", plan.IsDark ? "text-background/60" : "text-muted-foreground")">
                            @plan.PriceNote
                        </span>
                    </div>

                    @* CTA *@
                    <ButtonCn
                        Variant="@(plan.IsDark ? ButtonVariant.Outline : ButtonVariant.Default)"
                        Class="@Cn.Merge("mt-6 w-full", plan.IsDark ? "border-background/20 bg-background text-foreground hover:bg-background/90" : "")">
                        @plan.Cta
                    </ButtonCn>
                </div>
            }
        </div>

        @* Spec matrix header strip *@
        <div class="flex items-center gap-3 border-y bg-muted/20 px-6 py-3 sm:px-8">
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                Compared side by side
            </p>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </div>

        @* Shared attribute matrix *@
        <dl class="divide-y">
            @foreach (var spec in _specs)
            {
                <div class="grid grid-cols-1 gap-x-6 gap-y-4 px-6 py-5 sm:px-8 md:grid-cols-[minmax(140px,180px)_1fr_1fr] md:items-start md:gap-y-0">
                    <dt class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-widest text-muted-foreground md:pt-0.5">
                        <span>@spec.Label</span>
                        @if (spec.Winner == "right")
                        {
                            <LucideIconCn Name="arrow-right" Size="12" Class="hidden size-3 text-muted-foreground/50 md:inline" />
                        }
                    </dt>

                    @* Left value — Self-Hosted *@
                    <dd class="@Cn.Merge("flex flex-col gap-1", spec.Winner == "left" ? "md:font-semibold" : "")">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground md:hidden">
                            Self-Hosted
                        </span>
                        <p class="text-sm font-medium text-foreground">@spec.Left.Value</p>
                        @if (spec.Left.Note != null)
                        {
                            <p class="text-xs font-normal text-muted-foreground leading-relaxed">@spec.Left.Note</p>
                        }
                    </dd>

                    @* Right value — Cloud *@
                    <dd class="flex flex-col gap-1 md:border-l md:pl-6">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground md:hidden">
                            Cloud
                        </span>
                        <p class="@Cn.Merge("text-sm font-medium text-foreground", spec.Winner == "right" ? "md:font-semibold" : "")">
                            @spec.Right.Value
                        </p>
                        @if (spec.Right.Note != null)
                        {
                            <p class="text-xs font-normal text-muted-foreground leading-relaxed">@spec.Right.Note</p>
                        }
                    </dd>
                </div>
            }
        </dl>
    </div>

    @* Footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Migration tools available for switching between deployments at any time · Same codebase,
        same API, same CLI
    </p>
</section>

@code {
    private record SpecValue(string Value, string? Note = null);
    private record Spec(string Label, SpecValue Left, SpecValue Right, string Winner);
    private record Plan(string Id, string Name, string Icon, string Price, string PriceNote, string Description, string Cta, bool IsDark, string? Badge = null);

    private static readonly Plan[] _plans =
    [
        new("self-hosted", "Self-Hosted", "server", "$0", "/ forever",
            "Deploy on your own infrastructure with full data sovereignty and no per-seat fees.",
            "Download latest release", false),
        new("cloud", "Cloud", "cloud", "$49", "/ month per seat",
            "Fully managed infrastructure with global scale, daily backups, and 24/7 support.",
            "Start 14-day free trial", true, "Recommended"),
    ];

    private static readonly Spec[] _specs =
    [
        new("Setup time",
            new("1–2 hours", "Docker Compose, Helm, or Terraform"),
            new("5 minutes", "Provisioned automatically on signup"),
            "right"),
        new("Infrastructure",
            new("Your servers", "AWS, GCP, bare metal, air-gapped OK"),
            new("Auto-scaling", "Zero-downtime up to 10K concurrent users"),
            "neutral"),
        new("Data residency",
            new("Your choice", "Anywhere, including on-prem and sovereign cloud"),
            new("US, EU, APAC", "Pick your region at signup"),
            "left"),
        new("Backups",
            new("DIY strategy", "Bring your own backup tooling"),
            new("Daily encrypted", "30-day retention with one-click restore"),
            "right"),
        new("Compliance",
            new("Your audit", "Inherit your org's controls and frameworks"),
            new("SOC 2 + HIPAA", "Annual third-party audits, BAA available"),
            "right"),
        new("Updates",
            new("Manual upgrade", "Ship on your schedule, pin any version"),
            new("Zero-downtime", "Rolling deployments, no maintenance windows"),
            "neutral"),
        new("Support",
            new("Community", "GitHub Discussions, Discord, 2K+ members"),
            new("24/7 SLA", "4-hour response, dedicated account manager"),
            "right"),
        new("Licensing",
            new("MIT open source", "Full source code, unlimited users"),
            new("Per seat", "Volume discounts starting at 25 seats"),
            "left"),
    ];
}
