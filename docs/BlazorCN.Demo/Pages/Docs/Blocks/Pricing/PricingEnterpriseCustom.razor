@* ============================================================
   Block: pricing-enterprise-custom
   Title: PricingEnterpriseCustom
   Description: A single dark highlighted enterprise pricing card for React and Next.js with bg-foreground inverted theme, Custom price label, three feature category columns for Platform, Security, and Support, ShadcnioButton CTA with sliding arrow, and trust logos footer built with shadcn/ui Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-enterprise-custom.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-4xl p-4">
    <article class="relative overflow-hidden rounded-3xl bg-foreground p-6 text-background sm:p-10">
        @* Decorative grid background *@
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 opacity-[0.04]"
            style="background-image:radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0);background-size:24px 24px;color:var(--background);"
        />

        <div class="relative">
            @* Header *@
            <div class="text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-background/60">
                    Enterprise
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                    Your infrastructure,
                    <br />
                    your terms
                </h2>
                <p class="mx-auto mt-4 max-w-xl text-base text-background/70 leading-relaxed">
                    Dedicated infrastructure, advanced security, and white-glove support tailored to your
                    organization.
                </p>

                @* Price + CTA cluster *@
                <div class="mt-8 flex flex-col items-center gap-4">
                    <div class="flex items-baseline gap-2">
                        <span class="text-5xl font-bold tracking-tight sm:text-6xl">Custom</span>
                    </div>
                    <p class="text-sm text-background/60">
                        Pricing tailored to your team size, usage, and requirements
                    </p>
                    <ButtonCn Class="mt-2 bg-background text-foreground hover:bg-background/90">
                        Talk to sales
                    </ButtonCn>
                    <p class="text-xs text-background/50">
                        No commitment · Most teams onboarded within 2 weeks
                    </p>
                </div>
            </div>

            @* Divider *@
            <div class="mt-10 h-px bg-background/15"></div>

            @* Feature categories — three columns *@
            <TooltipProviderCn DelayDuration="200">
                <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6 lg:gap-10">
                    @foreach (var cat in _featureCategories)
                    {
                        <div>
                            <p class="text-[11px] font-semibold uppercase tracking-widest text-background/50">
                                @cat.Name
                            </p>
                            <ul class="mt-4 space-y-3">
                                @foreach (var feat in cat.Features)
                                {
                                    <li class="flex items-start justify-between gap-2">
                                        <span class="flex items-start gap-2.5">
                                            <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-400 dark:text-emerald-400" StrokeWidth="3" />
                                            <span class="text-sm font-medium leading-snug text-background/90">
                                                @feat.Name
                                            </span>
                                        </span>
                                        @if (feat.Tooltip != null)
                                        {
                                            <TooltipCn>
                                                <TooltipTriggerCn AsChild="true">
                                                    <button
                                                        type="button"
                                                        aria-label="@($"More info about {feat.Name}")"
                                                        class="mt-1 cursor-help"
                                                    >
                                                        <LucideIconCn Name="info" Size="14" Class="size-3.5 shrink-0 text-background/40 transition-colors hover:text-background/70" />
                                                    </button>
                                                </TooltipTriggerCn>
                                                <TooltipContentCn Class="max-w-[220px]">
                                                    <p class="text-xs">@feat.Tooltip</p>
                                                </TooltipContentCn>
                                            </TooltipCn>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </TooltipProviderCn>

            @* Divider *@
            <div class="mt-12 h-px bg-background/15"></div>

            @* Trust logos *@
            <div class="mt-8 text-center">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-background/50">
                    Trusted by engineering teams at
                </p>
                <div class="mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
                    @foreach (var logo in _trustLogos)
                    {
                        <span class="text-base font-bold tracking-tight text-background/70">@logo</span>
                    }
                </div>
            </div>
        </div>
    </article>
</section>

@code {
    private record Feature(string Name, string? Tooltip = null);
    private record FeatureCategory(string Id, string Name, Feature[] Features);

    private static readonly FeatureCategory[] _featureCategories =
    [
        new("platform", "Platform",
        [
            new("Unlimited users & workspaces"),
            new("Custom API rate limits", "Configure request limits per endpoint to match your infrastructure needs."),
            new("Multi-region (US, EU, APAC)"),
            new("Custom retention policies"),
            new("Dedicated infrastructure", "Isolated compute and storage resources for maximum performance."),
        ]),
        new("security", "Security & Compliance",
        [
            new("SAML SSO + SCIM provisioning", "Full SAML 2.0 with Okta, Azure AD, OneLogin, and Google Workspace."),
            new("SOC 2 Type II & ISO 27001"),
            new("HIPAA BAA available"),
            new("Custom RBAC + audit log export", "Granular roles. Export logs to Splunk, Datadog, or any SIEM via webhook."),
            new("AES-256 encryption"),
        ]),
        new("support", "Support & Services",
        [
            new("Dedicated success engineer", "Named engineer for onboarding, migration, and quarterly business reviews."),
            new("99.99% uptime SLA + credits"),
            new("24/7 phone & Slack support"),
            new("Custom onboarding + migration"),
            new("Early access to beta features", "Direct input into our product roadmap with early access to upcoming features."),
        ]),
    ];

    private static readonly string[] _trustLogos = ["Vercel", "Stripe", "Linear", "Notion", "Figma", "Anthropic"];
}
