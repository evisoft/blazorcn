@* ========================================
   Block: pricing-with-guarantee
   Title: Pricing With Guarantee
   Description: Pricing cards with integrated money-back guarantee section, trust badges, and risk-reversal messaging
   Long Description: Lifetime pricing with urgency indicators
   Dependencies: LucideCheckCn, LucideCreditCardCn, LucideLockCn, LucideRefreshCwCn, LucideShieldCn
   Source: original/blocks/pricing/pricing-with-guarantee.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Risk-free pricing
            </h2>
            <p class="text-muted-foreground text-lg">
                Try any plan free for 14 days. Not happy? Get a full refund within 30 days.
            </p>
        </div>

        @* Pricing cards *@
        <div class="mx-auto mb-12 grid max-w-5xl gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                <CardCn
                    Class="@(Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20 md:scale-105" : "border-border"))">
                    @if (plan.IsPopular)
                    {
                        <div class="absolute -top-3 right-4">
                            <BadgeCn>Most Popular</BadgeCn>
                        </div>
                    }
                    <CardHeaderCn Class="pb-4">
                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                        <div class="mt-2 flex items-baseline gap-1">
                            <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                            <span class="text-muted-foreground text-sm">/month</span>
                        </div>
                        <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                    </CardHeaderCn>
                    <CardContentCn Class="flex-1">
                        <ul class="space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Size="16" Class="text-primary mt-0.5 shrink-0" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </CardContentCn>
                    <CardFooterCn Class="flex-col gap-2 pt-4">
                        <ButtonCn
                            Class="w-full"
                            Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)"
                            Size="ButtonSize.Lg"
                            AsChild="true">
                            <a href="#">@plan.Cta</a>
                        </ButtonCn>
                        <span class="text-muted-foreground flex items-center gap-1 text-xs">
                            <LucideShieldCn Size="12" />
                            30-day money-back guarantee
                        </span>
                    </CardFooterCn>
                </CardCn>
            }
        </div>

        @* Guarantee section *@
        <div class="mx-auto max-w-2xl">
            <CardCn Class="border-2 border-dashed">
                <CardContentCn Class="p-6 text-center sm:p-8">
                    <div class="bg-primary/10 mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full">
                        <LucideShieldCn Size="28" Class="text-primary" />
                    </div>
                    <h3 class="mb-2 text-xl font-bold">30-Day Money-Back Guarantee</h3>
                    <p class="text-muted-foreground mx-auto mb-6 max-w-lg text-sm leading-relaxed">
                        Try any paid plan risk-free. If you are not completely satisfied within 30 days,
                        contact us for a full refund. No questions asked. No hoops to jump through. We
                        believe in our product that much.
                    </p>

                    <SeparatorCn Class="mb-6" />

                    <div class="flex flex-wrap items-center justify-center gap-6">
                        @foreach (var signal in _trustSignals)
                        {
                            <div class="flex items-center gap-2">
                                @signal.IconFragment
                                <span class="text-muted-foreground text-xs font-medium">
                                    @signal.Label
                                </span>
                            </div>
                        }
                    </div>
                </CardContentCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private record PlanItem(string Name, int Price, string Description, string[] Features, bool IsPopular, string Cta);

    private static readonly PlanItem[] _plans =
    [
        new("Starter", 19, "For individuals getting started.",
            ["Up to 5 projects", "5 GB storage", "Email support", "Basic analytics"], false, "Get Started"),
        new("Pro", 49, "For professionals and small teams.",
            ["Unlimited projects", "100 GB storage", "Priority support (4h SLA)", "Advanced analytics", "Custom domains", "API access", "Team collaboration"], true, "Start Free Trial"),
        new("Business", 129, "For growing organizations.",
            ["Everything in Pro", "Unlimited storage", "SSO authentication", "Audit logs", "Dedicated CSM", "Custom integrations", "On-premise option"], false, "Contact Sales"),
    ];

    private record TrustSignalItem(string Label, RenderFragment IconFragment);

    private readonly TrustSignalItem[] _trustSignals =
    [
        new("256-bit SSL encrypted", @<LucideLockCn Size="16" Class="text-muted-foreground" />),
        new("Secure payments via Stripe", @<LucideCreditCardCn Size="16" Class="text-muted-foreground" />),
        new("Cancel anytime, no lock-in", @<LucideRefreshCwCn Size="16" Class="text-muted-foreground" />),
    ];
}
