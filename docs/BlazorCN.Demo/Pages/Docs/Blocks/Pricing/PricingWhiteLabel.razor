@* ============================================================
   Block: pricing-white-label
   Title: PricingWhiteLabel
   Description: A 2-column split pricing section for React and Next.js with brand benefit tiles grid on the left and a single dark featured plan card on the right with PillTabs billing toggle, NumberFlow animated price, feature list with tooltips, and ShadcnioButton CTA built with shadcn/ui Tooltip and PillTabs and Tailwind CSS
   Source: original/blocks/pricing/pricing-white-label.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-stretch gap-6 lg:grid-cols-[1.1fr_1fr]">

        @* LEFT — Headline + brand benefits tiles *@
        <div class="flex flex-col justify-between gap-8 rounded-2xl border bg-card p-6 sm:p-10">
            <div>
                <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    <span class="inline-block size-1.5 rounded-full bg-emerald-500"></span>
                    Partner program
                </p>
                <h2 class="mt-4 text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl lg:text-5xl">
                    Resell our platform.
                    <br />
                    <span class="text-muted-foreground">Keep the spotlight.</span>
                </h2>
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    One partnership fee. Unlimited client workspaces under your brand. Set your own
                    prices, bill your customers directly, and never share margin with us.
                </p>
            </div>

            @* Brand benefits tile grid *@
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                @foreach (var benefit in _brandBenefits)
                {
                    <div class="flex gap-3 rounded-xl border bg-muted/40 p-4">
                        <div class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border bg-background">
                            <LucideIconCn Name="@benefit.IconName" Size="16" Class="size-4 text-foreground" />
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold">@benefit.Title</p>
                            <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                                @benefit.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* RIGHT — Dark featured partnership card *@
        <article class="relative flex flex-col gap-6 overflow-hidden rounded-2xl bg-foreground p-6 text-background sm:p-10">

            @* Decorative corner accent *@
            <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-background/[0.04]"></div>

            @* Top — badge + name *@
            <div class="relative flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-background/20 bg-background/10 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider">
                    <LucideIconCn Name="shield" Size="12" Class="size-3" />
                    Partnership
                </span>
                <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                    Best Value
                </span>
            </div>

            @* Plan name + description *@
            <div class="relative">
                <h3 class="text-3xl font-bold tracking-tight">@_plan.Name</h3>
                <p class="mt-2 text-sm leading-relaxed text-background/60">
                    @_plan.Description
                </p>
            </div>

            @* Billing toggle *@
            <div class="relative flex justify-start">
                <div class="rounded-full bg-background/10 p-0.5">
                    <div class="flex rounded-full">
                        @foreach (var option in _billingOptions)
                        {
                            var opt = option;
                            <button @onclick="@(() => _billing = opt)"
                                    class="@Cn.Merge("rounded-full px-4 py-1.5 text-xs font-semibold transition-colors", _billing == opt ? "bg-background text-foreground" : "text-background/60 hover:text-background/90")">
                                @(opt == "monthly" ? "Monthly" : "Annually")
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Price *@
            <div class="relative">
                <div class="flex items-baseline gap-2">
                    <span class="text-5xl font-bold tabular-nums tracking-tight text-background sm:text-6xl">
                        $@(_billing == "monthly" ? _plan.MonthlyPrice : _plan.AnnualPrice)
                    </span>
                    <span class="text-sm text-background/60">/mo</span>
                </div>
                <p class="mt-2 text-xs text-background/60">
                    @if (_billing == "annually")
                    {
                        @($"Billed annually at ${(_plan.AnnualPrice * 12)}/year. Save ${(_plan.MonthlyPrice - _plan.AnnualPrice) * 12}/year.")
                    }
                    else
                    {
                        @("Switch to annual billing to save 20%.")
                    }
                </p>
            </div>

            @* CTA *@
            <ButtonCn Variant="ButtonVariant.Outline" Class="relative w-full border-background/30 bg-background text-foreground hover:bg-background/90">
                @_plan.Cta
            </ButtonCn>

            @* Feature list *@
            <div class="relative mt-2 border-t border-background/10 pt-6">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-background/60">
                    @_plan.FeatureHeading
                </p>
                <ul class="mt-4 space-y-3">
                    @foreach (var feature in _plan.Features)
                    {
                        <li class="flex items-center justify-between gap-3">
                            <span class="flex items-center gap-2.5">
                                <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-500 dark:text-emerald-400" />
                                <span class="text-sm font-medium leading-snug">@feature.Name</span>
                            </span>
                            @if (feature.Tooltip != null)
                            {
                                <TooltipProviderCn Delay="200">
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <LucideIconCn Name="info" Size="14" Class="size-3.5 shrink-0 cursor-help text-background/30" />
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Align="FloatingAlign.End" Class="max-w-[220px]">
                                            <p class="text-xs">@feature.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TooltipProviderCn>
                            }
                        </li>
                    }
                </ul>
            </div>

            @* Trust footer *@
            <p class="relative text-center text-[11px] text-background/50">
                14-day partner pilot. No setup fees. Cancel anytime.
            </p>
        </article>
    </div>
</section>

@code {
    private string _billing = "annually";

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private record PlanFeature(string Name, string? Tooltip = null);

    private record WhiteLabelPlan(
        string Name,
        string Description,
        int MonthlyPrice,
        int AnnualPrice,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta
    );

    private record BrandBenefit(string IconName, string Title, string Description);

    private static readonly BrandBenefit[] _brandBenefits =
    [
        new("palette", "Your brand kit", "Logo, colors, typography. Zero traces of us."),
        new("globe", "Your domain", "CNAME with auto-SSL on app.yourbrand.com."),
        new("users", "Your clients", "Direct billing. 100% margin retention."),
        new("zap", "Your roadmap", "Custom features prioritized for partners."),
    ];

    private static readonly WhiteLabelPlan _plan = new(
        Name: "Partner",
        Description: "Resell our platform under your brand. One flat partnership fee.",
        MonthlyPrice: 499,
        AnnualPrice: 399,
        FeatureHeading: "Partnership includes:",
        Features:
        [
            new("Unlimited client workspaces"),
            new("Removable Powered-by badge", "Strip every reference to our company across the dashboard, emails, and PDFs."),
            new("White-labeled email + transactional templates"),
            new("GraphQL and REST API with no rate limits", "Programmatically provision client workspaces, billing, and configurations. Webhooks for real-time events."),
            new("SAML SSO for your client portal", "Connect Okta, Azure AD, or Google Workspace for your clients' single sign-on."),
            new("iOS + Android branded mobile apps", "Submit-ready binaries with your icon and splash screen for the App Store and Play Store."),
            new("Dedicated partner success manager"),
            new("99.99% uptime SLA + 1h critical response", "Phone and chat support 24/7 with named escalation contacts on your partner team."),
        ],
        Cta: "Become a partner"
    );
}
