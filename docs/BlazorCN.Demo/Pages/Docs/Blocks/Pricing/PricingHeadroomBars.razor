@* ============================================================
   Block: pricing-headroom-bars
   Title: PricingHeadroomBars
   Description: A single hero card headroom bars pricing section for React and Next.js with vertical stack of horizontal capacity-to-headroom bar rows per limit, Free capacity as a small anchor segment extending into a larger Pro segment, NumberFlow animated multiplier chips floating at the bar end, semantic icons per row, a price summary row, and a ShadcnioButton upgrade CTA built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-headroom-bars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Free vs Pro
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            See how much headroom you gain
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
            Every bar below compares your current Free limit to the Pro capacity. The longer the
            bar, the bigger the jump.
        </p>
    </div>

    @* Hero headroom card *@
    <div class="mt-8 overflow-hidden rounded-2xl border bg-card p-5 sm:p-7">
        @* Column headers *@
        <div class="flex items-center justify-between border-b pb-3">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                Limit
            </p>
            <div class="flex items-center gap-6 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                <span>Free</span>
                <span>Pro</span>
            </div>
        </div>

        @* Headroom bar rows *@
        <ul class="mt-4 space-y-5">
            @foreach (var limit in _limits)
            {
                var targetWidth = BarWidthPercent(limit.Multiplier);
                var chipLeft = FormattableString.Invariant($"calc({Math.Min(targetWidth, 92)}% + 4px)");
                <li class="space-y-2">
                    @* Label row with icon + values *@
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex min-w-0 items-center gap-2">
                            <LucideIconCn Name="@limit.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                            <span class="truncate text-sm font-medium text-foreground">
                                @limit.Label
                            </span>
                            @if (limit.Tooltip != null)
                            {
                                <TooltipProviderCn Delay="200">
                                    <TooltipCn>
                                        <TooltipTriggerCn Tabbable="false">
                                            <button type="button"
                                                    aria-label="@($"More info about {limit.Label}")"
                                                    class="shrink-0 cursor-help text-muted-foreground/40 hover:text-muted-foreground">
                                                <LucideIconCn Name="info" Size="12" Class="size-3" />
                                            </button>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="max-w-[220px]">
                                            <p class="text-xs leading-relaxed">@limit.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TooltipProviderCn>
                            }
                        </div>
                        <div class="flex shrink-0 items-baseline gap-4 text-xs tabular-nums">
                            <span class="text-muted-foreground/60">@limit.FreeValue</span>
                            <span class="w-16 text-right font-bold text-foreground">
                                @limit.ProValue
                            </span>
                        </div>
                    </div>

                    @* The headroom bar — Free anchor + Pro expansion + multiplier chip *@
                    <div role="img"
                         aria-label="@($"{limit.Label}: {limit.FreeValue} on Free, {limit.ProValue} on Pro — {limit.Multiplier} times more")"
                         class="relative h-6 w-full">
                        @* Track background *@
                        <div class="absolute inset-0 rounded-full bg-muted"></div>

                        @* Free anchor segment (always visible, small) *@
                        <div class="absolute top-0 bottom-0 left-0 rounded-full bg-muted-foreground/30"
                             style="@(FormattableString.Invariant($"width:{_freeAnchorPercent}%"))"></div>

                        @* Pro expansion segment *@
                        <div class="absolute top-0 bottom-0 left-0 rounded-full bg-foreground"
                             style="@(FormattableString.Invariant($"width:{targetWidth}%"))"></div>

                        @* Multiplier chip floating at the end of the Pro segment *@
                        <div class="absolute top-1/2 -translate-y-1/2 rounded-full bg-emerald-500 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm tabular-nums"
                             style="@(FormattableString.Invariant($"left:{chipLeft}"))">
                            @limit.Multiplier@("×")
                        </div>
                    </div>
                </li>
            }
        </ul>

        @* Price summary row *@
        <div class="mt-8 flex flex-col gap-4 border-t pt-5 sm:flex-row sm:items-end sm:justify-between">
            <div class="flex items-baseline gap-5">
                <div>
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        Free
                    </p>
                    <p class="text-xl font-bold tracking-tight tabular-nums text-muted-foreground">
                        $@_freePrice
                    </p>
                </div>
                <div>
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        Pro
                    </p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold tracking-tight tabular-nums">
                            $@_proPrice
                        </span>
                        <span class="text-xs text-muted-foreground">/mo</span>
                    </div>
                </div>
            </div>

            <ButtonCn Class="w-full sm:w-auto">Upgrade to Pro</ButtonCn>
        </div>
    </div>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        14-day free trial. No credit card required. Cancel or downgrade anytime from settings.
    </p>
</section>

@code {
    private const int _freePrice = 0;
    private const int _proPrice = 29;
    private const double _freeAnchorPercent = 12.0;

    private record HeadroomLimit(
        string Id,
        string Label,
        string IconName,
        string FreeValue,
        string ProValue,
        int Multiplier,
        string? Tooltip = null);

    private static readonly HeadroomLimit[] _limits =
    [
        new(
            Id: "projects",
            Label: "Active projects",
            IconName: "folder",
            FreeValue: "3",
            ProValue: "Unlimited",
            Multiplier: 50,
            Tooltip: "Pro removes the 3-project cap. Create as many projects and preview branches as you need."
        ),
        new(
            Id: "storage",
            Label: "Storage",
            IconName: "database",
            FreeValue: "1 GB",
            ProValue: "100 GB",
            Multiplier: 100,
            Tooltip: "Object storage for assets, exports, and backups. Served from 50+ edge locations on Pro."
        ),
        new(
            Id: "api",
            Label: "API calls / mo",
            IconName: "zap",
            FreeValue: "1K",
            ProValue: "500K",
            Multiplier: 500,
            Tooltip: "Combined REST and GraphQL request volume. Burst capacity included on Pro."
        ),
        new(
            Id: "team",
            Label: "Team members",
            IconName: "users-round",
            FreeValue: "Solo",
            ProValue: "Up to 10",
            Multiplier: 10
        ),
        new(
            Id: "bandwidth",
            Label: "Bandwidth / mo",
            IconName: "network",
            FreeValue: "5 GB",
            ProValue: "200 GB",
            Multiplier: 40,
            Tooltip: "Outbound data transfer. Pro includes the global CDN with sub-80ms latency."
        ),
    ];

    private static readonly double _maxLog = Math.Log10(_limits.Max(l => l.Multiplier));

    private static double BarWidthPercent(int multiplier)
    {
        if (multiplier <= 1) return 10.0;
        var percent = (Math.Log10(multiplier) / _maxLog) * 100.0;
        return Math.Max(20.0, Math.Min(100.0, percent));
    }
}
