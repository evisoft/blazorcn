@* ============================================================
   Block: pricing-negotiable
   Title: PricingNegotiable
   Description: A split-panel pricing section for React and Next.js with a left marketing headline, value props, anchor price and base features paired with a right interactive addon builder using shadcn Checkbox toggles, NumberFlow animated running total, and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-negotiable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-10">

        @* Left: marketing pitch *@
        <div class="flex flex-col">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Enterprise pricing
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Flexible pricing,<br />
                built around you
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Start with the base plan and add the capabilities you need. Every contract is custom,
                every quote is honest, and every team gets a dedicated success engineer.
            </p>

            @* Value props *@
            <ul class="mt-7 space-y-3.5">
                @foreach (var prop in _valueProps)
                {
                    <li class="flex items-start gap-3">
                        <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                        <span class="text-base font-medium text-foreground">@prop</span>
                    </li>
                }
            </ul>

            @* Anchor price *@
            <div class="mt-8 rounded-2xl border border-dashed bg-muted/40 p-5">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    Starting at
                </p>
                <div class="mt-1.5 flex items-baseline gap-1.5">
                    <span class="text-4xl font-bold tracking-tight tabular-nums">$@_basePrice</span>
                    <span class="text-sm text-muted-foreground">/seat/month</span>
                </div>
                <p class="mt-1.5 text-xs text-muted-foreground">
                    Billed annually. Volume discounts kick in at 100+ seats.
                </p>

                @* Base features *@
                <div class="mt-5 border-t pt-4">
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Included in base
                    </p>
                    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                        @foreach (var feature in _baseFeatures)
                        {
                            <li class="flex items-start gap-2">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                <span class="text-sm font-medium text-foreground">@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @* Right: interactive addon builder *@
        <div class="flex flex-col rounded-2xl bg-muted p-6">
            <div class="flex items-baseline justify-between gap-3">
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Build your plan
                    </p>
                    <h3 class="mt-1 text-2xl font-bold tracking-tight">Add capabilities</h3>
                </div>
                <span class="rounded-full bg-foreground px-2.5 py-1 text-[10px] font-bold tabular-nums uppercase tracking-wider text-background">
                    @_selectedAddons.Count selected
                </span>
            </div>

            @* Addon list *@
            <ul class="mt-6 space-y-2">
                @foreach (var addon in _addons)
                {
                    var item = addon;
                    var isSelected = _selectedAddons.Contains(item.Id);
                    <li class="@Cn.Merge("flex cursor-pointer items-start gap-3 rounded-xl border bg-background px-4 py-3.5 transition-colors hover:border-foreground/30", isSelected ? "border-foreground/40 bg-background" : "")"
                        @onclick="@(() => ToggleAddon(item.Id))">
                        <CheckboxCn
                            Checked="@isSelected"
                            Class="mt-0.5" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <span class="text-sm font-semibold text-foreground">@item.Name</span>
                                <span class="shrink-0 font-mono text-xs font-medium tabular-nums text-muted-foreground">+$@item.MonthlyPrice/mo</span>
                            </div>
                            <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                                @item.Description
                            </p>
                        </div>
                    </li>
                }
            </ul>

            @* Estimated total *@
            <div class="mt-6 rounded-xl bg-foreground p-5 text-background">
                <div class="flex items-baseline justify-between gap-3">
                    <div>
                        <p class="text-[11px] font-medium uppercase tracking-wider text-background/60">
                            Estimated total
                        </p>
                        <p class="mt-0.5 text-[11px] text-background/60">per seat / month</p>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-sm text-background/60">$</span>
                        <span class="text-4xl font-bold tracking-tight tabular-nums text-background">@EstimatedTotal</span>
                    </div>
                </div>
            </div>

            @* CTA *@
            <div class="mt-4">
                <ButtonCn Class="w-full">Talk to sales for a custom quote</ButtonCn>
            </div>
            <p class="mt-3 text-center text-xs text-muted-foreground">
                No commitment required. Quote ready in under 24 hours.
            </p>
        </div>

    </div>
</section>

@code {
    private const int _basePrice = 29;

    private HashSet<string> _selectedAddons = new();

    private int AddonTotal => _addons.Where(a => _selectedAddons.Contains(a.Id)).Sum(a => a.MonthlyPrice);
    private int EstimatedTotal => _basePrice + AddonTotal;

    private void ToggleAddon(string id)
    {
        if (!_selectedAddons.Remove(id))
            _selectedAddons.Add(id);
    }

    private static readonly string[] _valueProps =
    [
        "No per-seat minimums or hidden fees",
        "Dedicated onboarding and migration support",
        "Flexible annual or multi-year contracts",
        "Custom SLAs tailored to your compliance needs",
    ];

    private static readonly string[] _baseFeatures =
    [
        "Unlimited projects and workspaces",
        "Up to 50 team members",
        "100GB storage with global CDN",
        "REST and GraphQL API access",
        "Email support with 24-hour SLA",
    ];

    private record Addon(string Id, string Name, string Description, int MonthlyPrice);

    private static readonly Addon[] _addons =
    [
        new("sso", "SAML SSO and directory sync", "Connect Okta, Azure AD, or Google Workspace", 15),
        new("audit", "Audit logs and compliance", "SOC 2 reporting with 1-year log retention", 20),
        new("support", "Priority support (1h SLA)", "24/7 phone and Slack with named engineer", 35),
        new("compute", "Dedicated compute", "Isolated 8 vCPU, 32GB RAM infrastructure", 50),
        new("sla", "99.99% uptime SLA", "Enterprise-grade availability guarantee", 25),
    ];
}
