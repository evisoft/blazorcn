@* ============================================================
   Block: pricing-spec-sheet-columns
   Title: PricingSpecSheetColumns
   Description: A technical datasheet pricing section for React and Next.js with three plan columns displaying grouped spec rows for compute storage network support and security using monospace values a NumberFlow animated price header and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-spec-sheet-columns.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Technical specifications
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Engineered for every scale
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
            No marketing fluff — just the raw numbers. Compare compute storage network and support
            specs the way your SREs would read a datasheet.
        </p>
    </div>

    @* Desktop datasheet — visible at md+ *@
    <div class="mt-10 hidden overflow-hidden rounded-2xl border border-foreground/10 bg-muted md:block">
        <table class="w-full table-fixed">
            <colgroup>
                <col class="w-[22%]" />
                <col class="w-[26%]" />
                <col class="w-[26%]" />
                <col class="w-[26%]" />
            </colgroup>
            <thead>
                <tr class="border-b border-foreground/10">
                    <th scope="col" class="px-6 pb-6 pt-7 text-left align-top">
                        <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                            Datasheet
                        </p>
                        <p class="mt-3 max-w-[180px] text-xs leading-relaxed text-muted-foreground">
                            All values are per workspace unless noted otherwise.
                        </p>
                    </th>
                    @foreach (var plan in _plans)
                    {
                        <th scope="col" class="@Cn.Merge("px-6 pb-6 pt-7 text-left align-top", plan.IsPopular ? "bg-foreground/5" : "")">
                            <div class="flex h-6 items-center">
                                @if (plan.IsPopular)
                                {
                                    <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                        Best Value
                                    </span>
                                }
                            </div>
                            <h3 class="mt-3 text-xl font-bold tracking-tight">@plan.Name</h3>
                            <p class="mt-1 text-xs text-muted-foreground">@plan.Tagline</p>
                            <div class="mt-4 flex items-baseline gap-1">
                                <span class="text-3xl font-bold tracking-tight tabular-nums">$@plan.MonthlyPrice</span>
                                <span class="text-xs text-muted-foreground">/mo</span>
                            </div>
                            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 w-full">@plan.Cta</ButtonCn>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var grp in _specGroups)
                {
                    @* Group header row *@
                    <tr class="border-b border-foreground/10 bg-foreground/5">
                        <th scope="rowgroup" colspan="4" class="px-6 py-2.5 text-left text-[10px] font-extrabold uppercase tracking-widest text-muted-foreground">
                            @grp.Title
                        </th>
                    </tr>
                    @foreach (var row in grp.Rows)
                    {
                        var isLast = row.Label == grp.Rows[grp.Rows.Length - 1].Label;
                        <tr class="@Cn.Merge("border-b border-foreground/5", isLast ? "border-b-foreground/10" : "")">
                            <th scope="row" class="px-6 py-3 text-left align-middle text-xs font-medium text-muted-foreground">
                                @row.Label
                            </th>
                            @foreach (var plan in _plans)
                            {
                                var cellVal = row.Values.GetValueOrDefault(plan.Id, "—");
                                <td class="@Cn.Merge("px-6 py-3 font-mono text-sm tabular-nums", plan.IsPopular ? "bg-foreground/5 font-semibold text-foreground" : "text-foreground")">
                                    @cellVal
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    @foreach (var plan in _plans)
                    {
                        <td class="@Cn.Merge("px-6 pb-7 pt-6", plan.IsPopular ? "bg-foreground/5" : "")">
                            <ButtonCn Size="ButtonSize.Sm" Class="w-full">@plan.Cta</ButtonCn>
                        </td>
                    }
                </tr>
            </tfoot>
        </table>
    </div>

    @* Mobile stacked layout *@
    <div class="mt-8 space-y-4 md:hidden">
        @foreach (var plan in _plans)
        {
            <article class="@Cn.Merge("overflow-hidden rounded-2xl bg-muted", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                <div class="px-6 pb-6 pt-6">
                    <div class="mb-4 flex h-6 items-center">
                        @if (plan.IsPopular)
                        {
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        }
                    </div>
                    <h3 class="text-xl font-bold tracking-tight">@plan.Name</h3>
                    <p class="mt-1 text-xs text-muted-foreground">@plan.Tagline</p>
                    <div class="mt-4 flex items-baseline gap-1">
                        <span class="text-3xl font-bold tracking-tight tabular-nums">$@plan.MonthlyPrice</span>
                        <span class="text-xs text-muted-foreground">/mo</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-4 w-full">@plan.Cta</ButtonCn>
                </div>
                <div class="divide-y divide-foreground/10 border-t border-foreground/10">
                    @foreach (var grp in _specGroups)
                    {
                        <div class="px-6 py-4">
                            <p class="text-[10px] font-extrabold uppercase tracking-widest text-muted-foreground">
                                @grp.Title
                            </p>
                            <dl class="mt-3 space-y-2">
                                @foreach (var row in grp.Rows)
                                {
                                    var mobileVal = row.Values.GetValueOrDefault(plan.Id, "—");
                                    <div class="flex items-baseline justify-between gap-4">
                                        <dt class="text-xs text-muted-foreground">@row.Label</dt>
                                        <dd class="font-mono text-sm tabular-nums text-foreground">@mobileVal</dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    }
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private record Plan(string Id, string Name, string Tagline, int MonthlyPrice, string Cta, bool IsPopular);
    private record SpecRow(string Label, Dictionary<string, string> Values);
    private record SpecGroup(string Title, SpecRow[] Rows);

    private static readonly Plan[] _plans =
    [
        new("dev", "Dev", "Single-instance dev box", 29, "Start free trial", false),
        new("pro", "Pro", "Production workloads", 199, "Start free trial", true),
        new("scale", "Scale", "Mission-critical platforms", 799, "Contact sales", false),
    ];

    private static readonly SpecGroup[] _specGroups =
    [
        new("Compute",
        [
            new("vCPU", new() { ["dev"] = "2 cores", ["pro"] = "8 cores", ["scale"] = "32 cores" }),
            new("Memory", new() { ["dev"] = "4 GB RAM", ["pro"] = "32 GB RAM", ["scale"] = "128 GB RAM" }),
            new("GPU", new() { ["dev"] = "—", ["pro"] = "1x A10", ["scale"] = "4x A100" }),
        ]),
        new("Storage",
        [
            new("Block storage", new() { ["dev"] = "40 GB NVMe", ["pro"] = "500 GB NVMe", ["scale"] = "4 TB NVMe" }),
            new("Object storage", new() { ["dev"] = "50 GB", ["pro"] = "1 TB", ["scale"] = "Unlimited" }),
            new("Backups", new() { ["dev"] = "Daily × 7", ["pro"] = "Hourly × 30", ["scale"] = "Continuous" }),
        ]),
        new("Network",
        [
            new("Bandwidth", new() { ["dev"] = "500 GB/mo", ["pro"] = "5 TB/mo", ["scale"] = "50 TB/mo" }),
            new("Edge locations", new() { ["dev"] = "1 region", ["pro"] = "12 regions", ["scale"] = "40 regions" }),
            new("Private network", new() { ["dev"] = "—", ["pro"] = "VPC peering", ["scale"] = "Multi-region VPC" }),
        ]),
        new("Support",
        [
            new("Response time", new() { ["dev"] = "Community", ["pro"] = "4h business", ["scale"] = "15 min 24/7" }),
            new("Uptime SLA", new() { ["dev"] = "99.9%", ["pro"] = "99.95%", ["scale"] = "99.99%" }),
            new("Success manager", new() { ["dev"] = "—", ["pro"] = "Shared", ["scale"] = "Dedicated" }),
        ]),
        new("Security",
        [
            new("Encryption", new() { ["dev"] = "AES-256", ["pro"] = "AES-256 + KMS", ["scale"] = "BYOK + HSM" }),
            new("Compliance", new() { ["dev"] = "SOC 2", ["pro"] = "SOC 2 + ISO", ["scale"] = "SOC 2 + HIPAA" }),
            new("SSO", new() { ["dev"] = "—", ["pro"] = "SAML / OIDC", ["scale"] = "SAML / SCIM" }),
        ]),
    ];
}
