@* ============================================================
   Block: pricing-stepper-wizard
   Title: PricingStepperWizard
   Description: A multi step wizard pricing section for React and Next.js with a numbered stepper bar three questions with radio cards answer selection and a final plan recommendation screen showing the matched plan with NumberFlow animated price and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-stepper-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Find your plan
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Three questions, one plan
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            Answer a few questions and we'll match you to the plan that fits your team's workload and
            support needs.
        </p>
    </div>

    @* Main card *@
    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        @* Stepper bar *@
        <div class="border-b border-foreground/10 bg-foreground/5 px-5 py-4 sm:px-7">
            <ol class="flex items-center justify-between gap-2">
                @foreach (var qi in _questions.Select((q, i) => new { q, i }))
                {
                    var q = qi.q;
                    var i = qi.i;
                    var isActive = i == _stepIndex;
                    var isComplete = _selections.ContainsKey(q.Id) && i < _stepIndex;
                    var isReachable = i <= _stepIndex || isComplete;
                    <li class="flex flex-1 items-center">
                        <button
                            type="button"
                            @onclick="@(() => { if (isReachable) _stepIndex = i; })"
                            disabled="@(!isReachable)"
                            aria-current="@(isActive ? "step" : null)"
                            class="@Cn.Merge("group flex items-center gap-2.5 text-left focus:outline-none", !isReachable ? "cursor-not-allowed opacity-50" : "")">
                            <span
                                class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full border text-[11px] font-bold tabular-nums transition-colors", isActive ? "border-foreground bg-foreground text-background" : "", isComplete ? "border-foreground bg-foreground/90 text-background" : "", !isActive && !isComplete ? "border-foreground/20 bg-background text-muted-foreground" : "")"
                                aria-hidden="true">
                                @if (isComplete)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 stroke-[3]" />
                                }
                                else
                                {
                                    @(i + 1)
                                }
                            </span>
                            <span
                                class="@Cn.Merge("hidden text-[11px] font-semibold uppercase tracking-wider transition-colors sm:inline", isActive ? "text-foreground" : "text-muted-foreground")">
                                @q.Step
                            </span>
                        </button>
                        @if (i < _questions.Length - 1)
                        {
                            <div
                                class="@Cn.Merge("ml-2 h-px flex-1 transition-colors", i < _stepIndex ? "bg-foreground/70" : "bg-foreground/10")"
                                aria-hidden="true">
                            </div>
                        }
                    </li>
                }
            </ol>
        </div>

        @* Step body *@
        <div class="relative min-h-[360px] px-6 py-7 sm:px-8">
            @if (_isResultStep)
            {
                @* Result screen *@
                <div class="flex flex-col" aria-live="polite">
                    <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                        Your match
                    </p>
                    <div class="mt-2 flex flex-wrap items-baseline gap-2">
                        <h3 class="text-3xl font-bold tracking-tight">@_recommendedPlan.Name</h3>
                        <span class="inline-flex items-center rounded-full bg-red-500 px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Recommended
                        </span>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        @_recommendedPlan.Tagline
                    </p>

                    <div class="mt-5 flex items-baseline gap-1.5">
                        <span class="text-5xl font-bold tracking-tight tabular-nums">
                            $@_recommendedPlan.MonthlyPrice
                        </span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">Billed monthly, cancel anytime</p>

                    <ul class="mt-5 space-y-2.5">
                        @foreach (var feature in _recommendedPlan.Features)
                        {
                            <li class="flex items-start gap-2.5">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                <span class="text-sm font-medium text-foreground">@feature</span>
                            </li>
                        }
                    </ul>

                    <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
                        <ButtonCn Size="ButtonSize.Sm" Class="w-full sm:w-[230px]">
                            @_recommendedPlan.Cta
                        </ButtonCn>
                        <button
                            type="button"
                            @onclick="HandleReset"
                            class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground focus:outline-none focus-visible:text-foreground">
                            <LucideIconCn Name="rotate-ccw" Size="14" Class="size-3.5" />
                            Retake wizard
                        </button>
                    </div>
                </div>
            }
            else if (_currentQuestion != null)
            {
                var cq = _currentQuestion;
                var currentAnswer = _selections.TryGetValue(cq.Id, out var sel) ? sel : null;
                <fieldset class="flex flex-col">
                    <legend class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                        Question @(_stepIndex + 1) of @_questions.Length
                    </legend>
                    <p class="mt-2 text-2xl font-bold tracking-tight">@cq.Prompt</p>
                    <p class="mt-1.5 text-sm text-muted-foreground">@cq.Helper</p>

                    <div class="mt-5 grid gap-2.5 sm:grid-cols-2">
                        @foreach (var answer in cq.Answers)
                        {
                            var ans = answer;
                            var isSelected = currentAnswer == ans.Id;
                            <label class="@Cn.Merge("group relative flex cursor-pointer items-start gap-3 rounded-xl border p-4 transition-all focus-within:ring-2 focus-within:ring-foreground/40", isSelected ? "border-foreground bg-background shadow-sm" : "border-foreground/10 bg-background/40 hover:border-foreground/30 hover:bg-background/60")">
                                <input
                                    type="radio"
                                    name="@cq.Id"
                                    value="@ans.Id"
                                    checked="@isSelected"
                                    @onchange="@(() => HandleSelect(cq.Id, ans.Id))"
                                    class="sr-only" />
                                <span
                                    class="@Cn.Merge("mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full border-2 transition-colors", isSelected ? "border-foreground bg-foreground" : "border-foreground/30 bg-transparent")"
                                    aria-hidden="true">
                                    @if (isSelected)
                                    {
                                        <span class="size-1.5 rounded-full bg-background"></span>
                                    }
                                </span>
                                <span class="flex flex-col gap-0.5">
                                    <span class="text-sm font-semibold text-foreground">@ans.Label</span>
                                    <span class="text-xs text-muted-foreground">@ans.Sublabel</span>
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>
            }
        </div>

        @* Navigation footer *@
        @if (!_isResultStep)
        {
            <div class="flex flex-col-reverse items-stretch gap-3 border-t border-foreground/10 bg-background/40 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
                <button
                    type="button"
                    @onclick="HandleBack"
                    disabled="@(!_canGoBack)"
                    class="@Cn.Merge("inline-flex items-center justify-center gap-1.5 text-xs font-semibold uppercase tracking-wider transition-colors focus:outline-none focus-visible:text-foreground", _canGoBack ? "text-muted-foreground hover:text-foreground" : "cursor-not-allowed text-muted-foreground/40")">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Back
                </button>
                <ButtonCn
                    Size="ButtonSize.Sm"
                    Disabled="@(!_canGoForward)"
                    Class="w-full sm:w-[170px]"
                    OnClick="HandleNext">
                    @if (_stepIndex == _questions.Length - 1)
                    {
                        @("See my plan")
                    }
                    else
                    {
                        @("Next")
                        <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>
        }
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private int _stepIndex = 0;
    private Dictionary<string, string> _selections = new();

    private record PlanItem(string Id, string Name, string Tagline, int MonthlyPrice, string[] Features, string Cta);
    private record AnswerItem(string Id, string Label, string Sublabel, Dictionary<string, int> Scores);
    private record QuestionItem(string Id, string Step, string Prompt, string Helper, AnswerItem[] Answers);

    private static readonly PlanItem[] _plans =
    [
        new("starter", "Starter", "For solo builders and side projects.", 19,
            ["Up to 3 team members", "25 GB storage with daily backups", "Community Discord support", "Core integrations included"],
            "Start free trial"),
        new("growth", "Growth", "For scaling teams shipping production.", 99,
            ["Up to 25 team members", "500 GB storage with global CDN", "Priority email support, 4h SLA", "SSO, audit logs, role-based access", "Advanced analytics and webhooks"],
            "Start free trial"),
        new("enterprise", "Enterprise", "For mission-critical platforms.", 499,
            ["Unlimited team members", "Unlimited storage, multi-region", "Dedicated success manager", "SAML SSO, SOC2, HIPAA, custom DPA", "99.99% uptime SLA with credits", "Custom integrations and white-label"],
            "Contact sales"),
    ];

    private static readonly QuestionItem[] _questions =
    [
        new("team", "Team size", "How many people on your team?", "Count everyone who will log in or get mentioned in projects.",
        [
            new("solo", "Just me", "1 person", new Dictionary<string, int> { { "starter", 3 }, { "growth", 0 }, { "enterprise", 0 } }),
            new("small", "Small team", "2-10 people", new Dictionary<string, int> { { "starter", 2 }, { "growth", 2 }, { "enterprise", 0 } }),
            new("medium", "Medium team", "11-50 people", new Dictionary<string, int> { { "starter", 0 }, { "growth", 3 }, { "enterprise", 1 } }),
            new("large", "Large org", "50+ people", new Dictionary<string, int> { { "starter", 0 }, { "growth", 1 }, { "enterprise", 3 } }),
        ]),
        new("workload", "Workload", "How much data will you process each month?", "Rough order of magnitude — you can always upgrade later.",
        [
            new("light", "Light", "Under 50 GB", new Dictionary<string, int> { { "starter", 3 }, { "growth", 1 }, { "enterprise", 0 } }),
            new("moderate", "Moderate", "50-500 GB", new Dictionary<string, int> { { "starter", 1 }, { "growth", 3 }, { "enterprise", 1 } }),
            new("heavy", "Heavy", "500 GB-5 TB", new Dictionary<string, int> { { "starter", 0 }, { "growth", 2 }, { "enterprise", 2 } }),
            new("massive", "Massive", "5 TB and beyond", new Dictionary<string, int> { { "starter", 0 }, { "growth", 0 }, { "enterprise", 3 } }),
        ]),
        new("support", "Support needs", "How important is support and SLAs?", "We'll match you to the right tier so you're never stuck.",
        [
            new("community", "Community only", "Discord + docs is fine", new Dictionary<string, int> { { "starter", 3 }, { "growth", 1 }, { "enterprise", 0 } }),
            new("business", "Business hours", "Email response in 4h", new Dictionary<string, int> { { "starter", 1 }, { "growth", 3 }, { "enterprise", 1 } }),
            new("priority", "Priority 24/7", "Dedicated account team", new Dictionary<string, int> { { "starter", 0 }, { "growth", 1 }, { "enterprise", 3 } }),
            new("compliance", "Compliance heavy", "SOC2, HIPAA, custom DPA", new Dictionary<string, int> { { "starter", 0 }, { "growth", 0 }, { "enterprise", 3 } }),
        ]),
    ];

    private bool _isResultStep => _stepIndex >= _questions.Length;
    private QuestionItem? _currentQuestion => _isResultStep ? null : _questions[_stepIndex];
    private bool _canGoBack => _stepIndex > 0;
    private bool _canGoForward => !_isResultStep && (_currentQuestion != null && _selections.ContainsKey(_currentQuestion.Id));

    private string _recommendedId
    {
        get
        {
            var totals = new Dictionary<string, int> { { "starter", 0 }, { "growth", 0 }, { "enterprise", 0 } };
            foreach (var question in _questions)
            {
                if (!_selections.TryGetValue(question.Id, out var answerId)) continue;
                var ans = Array.Find(question.Answers, a => a.Id == answerId);
                if (ans == null) continue;
                foreach (var kv in ans.Scores)
                    totals[kv.Key] = totals.GetValueOrDefault(kv.Key) + kv.Value;
            }
            var best = "growth";
            var bestScore = -1;
            foreach (var kv in totals)
            {
                if (kv.Value > bestScore) { bestScore = kv.Value; best = kv.Key; }
            }
            return best;
        }
    }

    private PlanItem _recommendedPlan => Array.Find(_plans, p => p.Id == _recommendedId) ?? _plans[1];

    private void HandleSelect(string questionId, string answerId)
    {
        _selections[questionId] = answerId;
    }

    private void HandleNext()
    {
        if (_stepIndex < _questions.Length)
            _stepIndex++;
    }

    private void HandleBack()
    {
        if (_canGoBack)
            _stepIndex--;
    }

    private void HandleReset()
    {
        _selections = new();
        _stepIndex = 0;
    }
}
