@* ============================================================
   Block: pricing-platform-fee
   Title: PricingPlatformFee
   Description: A split layout pricing section for React and Next.js with a marketing headline on the left and stacked platform fee tier rows on the right showing animated take-rate percentages with NumberFlow, transaction caps, payout speed, and ShadcnioButton CTAs with a dark Business tier highlight built with shadcn/ui Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-platform-fee.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-12">
        @* LEFT: Marketing headline + trust signals *@
        <div class="flex flex-col lg:sticky lg:top-8 lg:self-start">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Platform fees
            </p>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Take rates that
                <br />
                <span class="text-muted-foreground/60">scale down</span>
                <br />
                as you grow.
            </h2>
            <p class="mt-5 max-w-md text-base text-muted-foreground leading-relaxed">
                Start at 8% and drop to 1.5% as your marketplace scales. No hidden fees, no monthly
                minimums until you're ready, and instant payouts when you need them.
            </p>

            @* Trust signals *@
            <ul class="mt-8 space-y-3">
                @foreach (var signal in _trustSignals)
                {
                    <li class="flex items-center gap-3">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                            <LucideIconCn Name="@signal.IconName" Size="16" Class="size-4 text-foreground" />
                        </span>
                        <span class="text-sm font-medium text-foreground">@signal.Label</span>
                    </li>
                }
            </ul>

            <p class="mt-8 text-xs text-muted-foreground">
                Volume discounts available for platforms processing $10M+/month.
            </p>
        </div>

        @* RIGHT: Stacked tier rows *@
        <div class="space-y-3">
            @foreach (var tier in _tiers)
            {
                var tierItem = tier;
                <article
                    class="@Cn.Merge("relative overflow-hidden rounded-2xl p-5 transition-colors sm:p-6", tierItem.IsDark ? "bg-foreground text-background" : "bg-muted", _hoveredTier == tierItem.Id && !tierItem.IsDark ? "bg-muted/80" : "")"
                    @onmouseenter="@(() => _hoveredTier = tierItem.Id)"
                    @onmouseleave="@(() => _hoveredTier = null)">

                    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                        @* Left: tier name + description *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2.5">
                                <h3 class="@Cn.Merge("text-xl font-bold tracking-tight", tierItem.IsDark ? "text-background" : "text-foreground")">
                                    @tierItem.Name
                                </h3>
                                @if (tierItem.SavingsLabel != null)
                                {
                                    <span class="@Cn.Merge("rounded-full px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider", tierItem.IsDark ? "bg-emerald-500/20 text-emerald-300" : "bg-emerald-500/15 text-emerald-700 dark:text-emerald-400")">
                                        @tierItem.SavingsLabel
                                    </span>
                                }
                            </div>
                            <p class="@Cn.Merge("mt-1.5 text-sm leading-relaxed", tierItem.IsDark ? "text-background/70" : "text-muted-foreground")">
                                @tierItem.Description
                            </p>

                            @* Inline metrics *@
                            <div class="@Cn.Merge("mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs", tierItem.IsDark ? "text-background/60" : "text-muted-foreground")">
                                <span class="flex items-center gap-1.5">
                                    <span class="font-semibold uppercase tracking-wider">Per txn</span>
                                    <span class="font-mono tabular-nums">@tierItem.PerTxn</span>
                                </span>
                                <span aria-hidden="true" class="@Cn.Merge("h-3 w-px", tierItem.IsDark ? "bg-background/20" : "bg-border")"></span>
                                <span class="flex items-center gap-1.5">
                                    <span class="font-semibold uppercase tracking-wider">Cap</span>
                                    <span class="font-mono tabular-nums">@tierItem.MonthlyCap/mo</span>
                                    <TooltipProviderCn DelayDuration="200">
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <LucideIconCn Name="info" Size="12" Class="@Cn.Merge("size-3 shrink-0 cursor-help", tierItem.IsDark ? "text-background/40" : "text-muted-foreground/40")" />
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[200px]">
                                                <p class="text-xs">
                                                    Maximum transaction volume per month before overage rates apply.
                                                </p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    </TooltipProviderCn>
                                </span>
                                <span aria-hidden="true" class="@Cn.Merge("h-3 w-px", tierItem.IsDark ? "bg-background/20" : "bg-border")"></span>
                                <span class="flex items-center gap-1.5">
                                    <span class="font-semibold uppercase tracking-wider">Payouts</span>
                                    <span>@tierItem.PayoutSpeed</span>
                                </span>
                            </div>
                        </div>

                        @* Right: take rate + CTA *@
                        <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-end sm:gap-5">
                            <div class="flex items-baseline gap-1 sm:w-[110px] sm:justify-end">
                                <span class="@Cn.Merge("text-4xl font-bold tabular-nums tracking-tight sm:text-5xl", tierItem.IsDark ? "text-background" : "text-foreground")">
                                    @(tierItem.TakeRate % 1 != 0 ? $"{tierItem.TakeRate:0.0}" : $"{(int)tierItem.TakeRate}")
                                </span>
                                <span class="@Cn.Merge("text-xl font-semibold", tierItem.IsDark ? "text-background/70" : "text-muted-foreground")">
                                    %
                                </span>
                            </div>
                            <ButtonCn
                                Size="ButtonSize.Sm"
                                Class="@Cn.Merge("w-full shrink-0 sm:w-[200px]", tierItem.IsDark ? "bg-background text-foreground hover:bg-background/90" : "")">
                                @tierItem.Cta
                            </ButtonCn>
                        </div>
                    </div>

                    @* Recommended ribbon for dark tier *@
                    @if (tierItem.IsDark)
                    {
                        <div class="mt-4 flex items-center gap-2 border-t border-background/10 pt-4">
                            <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-400" StrokeWidth="3" />
                            <p class="text-xs font-medium text-background/80">
                                Recommended for marketplaces processing $500K&ndash;$5M monthly
                            </p>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>

@code {
    private string? _hoveredTier = null;

    private record TrustSignal(string IconName, string Label);
    private record Tier(string Id, string Name, string Description, double TakeRate, string PerTxn, string MonthlyCap, string PayoutSpeed, string Cta, bool IsDark, string? SavingsLabel);

    private static readonly TrustSignal[] _trustSignals =
    [
        new("shield-check", "PCI-DSS Level 1 certified"),
        new("trending-down", "Take rate drops as you grow"),
        new("zap", "Same-day payouts on Enterprise"),
    ];

    private static readonly Tier[] _tiers =
    [
        new("starter", "Starter", "Launch your marketplace with zero upfront cost.", 8, "+ $0.50", "$25K", "Weekly", "Get started", false, null),
        new("growth", "Growth", "Lower your take rate as transaction volume grows.", 5, "+ $0.30", "$250K", "Every 2 days", "Start free trial", false, "Save 38%"),
        new("business", "Business", "The sweet spot for high-volume marketplaces.", 3, "+ $0.15", "$2.5M", "Next-day", "Start free trial", true, "Save 63%"),
        new("enterprise", "Enterprise", "Custom rates and white-glove account management.", 1.5, "Negotiable", "Unlimited", "Same-day", "Contact sales", false, "Save 81%"),
    ];
}
