@* ============================================================
   Block: pricing-dynamic-tiers
   Title: PricingDynamicTiers
   Description: A tabbed pricing section for React and Next.js with audience PillTabs for Startup, Growth, and Enterprise segments showing different plan card sets per tab, secondary PillTabs billing toggle, NumberFlow animated prices, ShadcnioButton CTAs, AnimatePresence transitions, emerald checkmarks, and red Best Value badges built with shadcn/ui Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-dynamic-tiers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Plans for every stage
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Whether you are launching an MVP or scaling to millions of users, choose the segment that
            matches where you are today.
        </p>

        @* Controls *@
        <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
            @* Audience PillTabs *@
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted p-1" role="tablist" aria-label="Audience segment">
                @foreach (var aud in _audiences)
                {
                    var audience = aud;
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@(_activeAudience == audience.Id ? "true" : "false")"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _activeAudience == audience.Id ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _activeAudience = audience.Id)">
                        @audience.Label
                    </button>
                }
            </div>
            @* Billing PillTabs *@
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted p-1" role="tablist" aria-label="Billing period">
                <button
                    type="button"
                    role="tab"
                    aria-selected="@(_billing == "monthly" ? "true" : "false")"
                    class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "monthly" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = "monthly")">
                    Monthly
                </button>
                <button
                    type="button"
                    role="tab"
                    aria-selected="@(_billing == "annually" ? "true" : "false")"
                    class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "annually" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = "annually")">
                    Annually
                </button>
            </div>
        </div>
    </div>

    @* Plan grid *@
    <TooltipProviderCn Delay="200">
        <div class="mt-10">
            @{
                var activePlans = _plansByAudience[_activeAudience];
                var gridClass = activePlans.Length == 2
                    ? "grid gap-4 mx-auto max-w-4xl grid-cols-1 md:grid-cols-2"
                    : "grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";
            }
            <div class="@gridClass">
                @foreach (var pl in activePlans)
                {
                    var plan = pl;
                    int? price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
                    <article class="@Cn.Merge("relative flex h-full flex-col overflow-hidden rounded-2xl bg-muted p-6 sm:p-7", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                        @* Reserved badge slot — rendered on every card so headings align *@
                        <div class="mb-4 flex h-7 items-start">
                            @if (plan.IsPopular)
                            {
                                <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                    Best Value
                                </span>
                            }
                        </div>

                        @* Plan name *@
                        <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>

                        @* Description *@
                        <p class="mt-1.5 min-h-[2.75rem] text-sm text-muted-foreground leading-relaxed">
                            @plan.Description
                        </p>

                        @* Price — fixed height row for layout stability *@
                        <div class="mt-6 flex flex-col">
                            <div class="flex h-12 items-baseline gap-1.5 sm:h-14">
                                @if (price == null)
                                {
                                    <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                                        Custom
                                    </span>
                                }
                                else if (price == 0)
                                {
                                    <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                                        Free
                                    </span>
                                }
                                else
                                {
                                    <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                                        $@price
                                    </span>
                                    <span class="text-sm text-muted-foreground">/mo</span>
                                }
                            </div>
                            <p class="mt-1.5 text-xs text-muted-foreground">
                                @if (price == null)
                                {
                                    <text>Contact us for pricing</text>
                                }
                                else if (price == 0)
                                {
                                    <text>Free forever. No credit card.</text>
                                }
                                else if (_billing == "annually")
                                {
                                    <text>Billed annually at $@(price * 12)/year</text>
                                }
                                else
                                {
                                    <text>Billed monthly. Cancel anytime.</text>
                                }
                            </p>
                        </div>

                        @* CTA *@
                        <div class="mt-6">
                            <ButtonCn Class="w-full">@plan.Cta</ButtonCn>
                        </div>

                        @* Features *@
                        <div class="mt-7 flex-1">
                            <p class="text-sm font-semibold">@plan.FeatureHeading</p>
                            <ul class="mt-4 space-y-3">
                                @foreach (var feat in plan.Features)
                                {
                                    var feature = feat;
                                    <li class="flex items-start justify-between gap-2">
                                        <span class="flex items-start gap-2.5">
                                            <LucideIconCn Name="check" Size="20" StrokeWidth="3" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                            <span class="text-sm font-medium text-foreground">
                                                @feature.Name
                                            </span>
                                        </span>
                                        @if (feature.Tooltip != null)
                                        {
                                            <TooltipCn>
                                                <TooltipTriggerCn Tabbable="false">
                                                    <button
                                                        type="button"
                                                        aria-label="@($"More info about {feature.Name}")"
                                                        class="inline-flex shrink-0">
                                                        <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 cursor-help text-muted-foreground/40" />
                                                    </button>
                                                </TooltipTriggerCn>
                                                <TooltipContentCn Class="max-w-[220px]">
                                                    <p class="text-xs">@feature.Tooltip</p>
                                                </TooltipContentCn>
                                            </TooltipCn>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </article>
                }
            </div>
        </div>
    </TooltipProviderCn>

    @* Trust footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All paid plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

