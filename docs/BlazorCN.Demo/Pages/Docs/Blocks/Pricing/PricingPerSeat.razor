@* ========================================
   Block: pricing-per-seat
   Title: Pricing Per Seat
   Description: Per-seat pricing with interactive team size selector that dynamically calculates total cost and volume discounts
   Long Description: Dynamic pricing with usage slider
   Dependencies: BadgeCn, ButtonCn, CardCn, SeparatorCn
   Source: original/blocks/pricing/pricing-per-seat.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-4 gap-1.5">
                <LucideUsersCn Size="12" Class="h-3 w-3" />
                Per-Seat Pricing
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                One plan. Pay per seat.
            </h2>
            <p class="text-muted-foreground text-lg">
                Everyone gets the full experience. The more seats you add, the more you save.
            </p>
        </div>

        <div class="mx-auto max-w-2xl">
            <CardCn>
                <CardHeaderCn Class="text-center">
                    @* Seat selector *@
                    <div class="mb-6">
                        <label class="text-muted-foreground mb-3 block text-sm font-medium">
                            Team size
                        </label>
                        <div class="flex items-center justify-center gap-3">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                      @onclick="@(() => AdjustSeats(-1))"
                                      Disabled="@(_seats <= 1)">
                                <LucideMinusCn Size="16" />
                            </ButtonCn>
                            <div class="bg-muted flex h-12 w-24 items-center justify-center rounded-lg">
                                <span class="text-2xl font-bold">@_seats</span>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                      @onclick="@(() => AdjustSeats(1))"
                                      Disabled="@(_seats >= 100)">
                                <LucidePlusCn Size="16" />
                            </ButtonCn>
                        </div>
                        @if (_seats >= 100)
                        {
                            <div class="mt-2 flex items-center justify-center gap-1">
                                <span class="text-muted-foreground text-xs">
                                    Need more?
                                    <a href="#" class="text-primary hover:underline">Contact sales</a>
                                </span>
                            </div>
                        }
                    </div>

                    @* Price display *@
                    <div class="space-y-1">
                        <div class="flex items-baseline justify-center gap-2">
                            <span class="text-5xl font-bold tracking-tight">$@_totalMonthly</span>
                            <span class="text-muted-foreground text-sm">/month</span>
                        </div>
                        <div class="flex items-center justify-center gap-2">
                            <span class="text-muted-foreground text-sm">
                                $@(_currentTier.PricePerSeat)/seat/month
                            </span>
                            @if (!string.IsNullOrEmpty(_currentTier.Savings))
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                    @_currentTier.Savings
                                </BadgeCn>
                            }
                        </div>
                    </div>
                </CardHeaderCn>

                <CardContentCn Class="space-y-6">
                    @* Discount tiers *@
                    <div class="grid grid-cols-4 gap-2">
                        @foreach (var tier in _discountTiers)
                        {
                            var isActive = _seats >= tier.MinSeats && _seats <= tier.MaxSeats;
                            <button type="button" @onclick="@(() => { _seats = tier.MinSeats; })"
                                    class="@Cn.Merge("rounded-lg border p-2 text-center transition-colors", isActive ? "border-primary bg-primary/5" : "border-border hover:border-primary/50")">
                                <div class="text-xs font-semibold">@tier.Label</div>
                                <div class="@Cn.Merge("text-lg font-bold", isActive ? "text-primary" : "text-foreground")">
                                    $@tier.PricePerSeat
                                </div>
                                <div class="text-muted-foreground text-xs">
                                    @(tier.MinSeats == tier.MaxSeats ? $"{tier.MinSeats} seats" : $"{tier.MinSeats}-{tier.MaxSeats} seats")
                                </div>
                            </button>
                        }
                    </div>

                    <SeparatorCn />

                    @* Features *@
                    <div>
                        <h3 class="mb-4 text-sm font-semibold">Every seat includes</h3>
                        <ul class="grid gap-3 sm:grid-cols-2">
                            @foreach (var feature in _allFeatures)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Size="16" Class="text-primary mt-0.5 shrink-0" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>

                    @* CTA *@
                    <ButtonCn Size="ButtonSize.Lg" Class="w-full">
                        Start Free Trial with @_seats @(_seats == 1 ? "seat" : "seats")
                    </ButtonCn>

                    <p class="text-muted-foreground text-center text-xs">
                        14-day free trial. No credit card required. Add or remove seats anytime.
                    </p>
                </CardContentCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private int _seats = 5;

    private record DiscountTier(int MinSeats, int MaxSeats, int PricePerSeat, string Label, string Savings);

    private readonly DiscountTier[] _discountTiers =
    [
        new(1, 4, 29, "Standard", ""),
        new(5, 14, 25, "Team", "Save 14%"),
        new(15, 49, 20, "Business", "Save 31%"),
        new(50, 100, 15, "Enterprise", "Save 48%"),
    ];

    private DiscountTier _currentTier => _discountTiers.FirstOrDefault(t => _seats >= t.MinSeats && _seats <= t.MaxSeats) ?? _discountTiers[^1];
    private int _totalMonthly => _currentTier.PricePerSeat * _seats;

    private void AdjustSeats(int delta)
    {
        _seats = Math.Max(1, Math.Min(100, _seats + delta));
    }

    private readonly string[] _allFeatures =
    [
        "Unlimited projects & workspaces",
        "Advanced analytics dashboard",
        "Custom domains & branding",
        "Priority email support",
        "API access with webhooks",
        "Third-party integrations",
        "Role-based access control",
        "Shared team library",
    ];
}
