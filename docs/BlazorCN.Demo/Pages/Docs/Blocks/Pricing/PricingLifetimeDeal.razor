@* ========================================
   Block: pricing-lifetime-deal
   Title: Pricing Lifetime Deal
   Description: Lifetime pricing offer with one-time payment highlight, savings comparison against monthly billing, and urgency indicators
   Long Description: Pricing with billing period switch
   Dependencies: LucideCheckCn, LucideGiftCn, LucideInfinityCn, LucideZapCn
   Source: original/blocks/pricing/pricing-lifetime-deal.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Class="mb-4 gap-1.5" Variant="BadgeVariant.Secondary">
                <LucideGiftCn Class="h-3 w-3" Size="12" />
                Limited Time Offer
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Pay once. Use forever.
            </h2>
            <p class="text-muted-foreground text-lg">
                Lock in lifetime access at our launch price. No subscriptions, no renewals.
            </p>
        </div>

        <div class="mx-auto grid max-w-5xl items-center gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                <CardCn Class="@Cn.Merge("relative flex flex-col", plan.IsLifetime ? "border-primary shadow-lg ring-1 ring-primary/20 md:scale-105" : "border-border")">
                    @if (plan.IsLifetime)
                    {
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                            <BadgeCn Class="gap-1.5 px-3">
                                <LucideInfinityCn Class="h-3 w-3" Size="12" />
                                Best Value
                            </BadgeCn>
                        </div>
                    }

                    <CardHeaderCn Class="pb-4">
                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                        <div class="mt-3">
                            <div class="flex items-baseline gap-1.5">
                                @if (plan.OriginalPrice.HasValue)
                                {
                                    <span class="text-muted-foreground text-xl font-medium line-through">
                                        $@plan.OriginalPrice
                                    </span>
                                }
                                <span class="@Cn.Merge("font-bold tracking-tight", plan.IsLifetime ? "text-5xl" : "text-4xl")">
                                    $@plan.Price
                                </span>
                                @if (!plan.IsLifetime)
                                {
                                    <span class="text-muted-foreground text-sm">@plan.Period</span>
                                }
                            </div>
                            <p class="text-muted-foreground mt-1 text-sm">@plan.Billing</p>
                        </div>

                        @if (plan.IsLifetime)
                        {
                            <div class="bg-primary/5 mt-3 rounded-md p-3">
                                <div class="flex items-center gap-2">
                                    <LucideZapCn Class="text-primary h-4 w-4" Size="16" />
                                    <span class="text-sm font-medium">
                                        Pays for itself in 17 months vs monthly
                                    </span>
                                </div>
                            </div>
                        }
                    </CardHeaderCn>

                    <CardContentCn Class="flex-1">
                        @if (plan.IsLifetime)
                        {
                            <SeparatorCn Class="mb-4" />
                        }
                        <ul class="space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Class="@Cn.Merge("mt-0.5 h-4 w-4 shrink-0", plan.IsLifetime ? "text-primary" : "text-muted-foreground")" Size="16" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </CardContentCn>

                    <CardFooterCn Class="pt-4">
                        <ButtonCn Class="w-full" Size="ButtonSize.Lg"
                                  Variant="@(plan.IsLifetime ? ButtonVariant.Default : ButtonVariant.Outline)">
                            @plan.Cta
                        </ButtonCn>
                    </CardFooterCn>
                </CardCn>
            }
        </div>

        <p class="text-muted-foreground mt-8 text-center text-sm">
            60-day money-back guarantee on all plans. No questions asked.
        </p>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, int? OriginalPrice, string Period, string Billing, string[] Features, bool IsLifetime, string Cta);

    private static readonly Plan[] _plans =
    [
        new("Monthly", 29, null, "/month", "Billed monthly", ["All Pro features", "Unlimited projects", "Priority support", "Regular updates"], false, "Subscribe Monthly"),
        new("Lifetime", 499, 899, "one-time", "Pay once, own forever", ["All Pro features forever", "Unlimited projects", "Priority support", "All future updates", "Early access to new features", "Founder badge on profile", "Private community access", "No recurring charges ever"], true, "Get Lifetime Access"),
        new("Annual", 19, null, "/month", "Billed annually ($228/year)", ["All Pro features", "Unlimited projects", "Priority support", "Regular updates", "2 months free"], false, "Subscribe Annually"),
    ];
}
