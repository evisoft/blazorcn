@* ============================================================
   Block: pricing-countdown-offer
   Title: PricingCountdownOffer
   Description: A limited-time countdown offer pricing section for React and Next.js with three plan cards where the discounted Pro tier uses a dark bg-foreground card with live countdown timer, strikethrough original price, emerald savings badge, ShadcnioButton CTAs, progressive feature lists with emerald checkmarks, and trust text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-countdown-offer.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Limited Time Launch
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Lock in your rate before it expires
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Save @_discountPercent% on Pro when you sign up before the launch promo ends. Rate
            locked for 12 months after signup.
        </p>
    </div>

    @* Plan grid *@
    <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-stretch">
        @foreach (var plan in _plans)
        {
            var isOffer = plan.IsLimitedOffer;
            <article class="@Cn.Merge("relative flex flex-col overflow-hidden rounded-2xl p-6 sm:p-8", isOffer ? "bg-foreground text-background" : "bg-muted text-foreground")">

                @* Plan name *@
                <h3 class="@Cn.Merge("text-2xl font-bold tracking-tight", isOffer ? "text-background" : "text-foreground")">
                    @plan.Name
                </h3>
                <p class="@Cn.Merge("mt-1.5 text-sm leading-relaxed", isOffer ? "text-background/60" : "text-muted-foreground")">
                    @plan.Description
                </p>

                @* Price *@
                <div class="mt-6">
                    <div class="flex items-baseline gap-2">
                        @if (plan.OriginalPrice.HasValue)
                        {
                            <s aria-hidden="true" class="@Cn.Merge("text-lg tabular-nums", isOffer ? "text-background/40" : "text-muted-foreground")">
                                $@plan.OriginalPrice.Value
                            </s>
                        }
                        <span class="@Cn.Merge("text-4xl font-bold tracking-tight tabular-nums sm:text-5xl", isOffer ? "text-background" : "text-foreground")">
                            $@plan.MonthlyPrice
                        </span>
                        <span class="@Cn.Merge("text-sm", isOffer ? "text-background/60" : "text-muted-foreground")">
                            /month
                        </span>
                    </div>
                    @if (plan.OriginalPrice.HasValue)
                    {
                        <p class="mt-2 text-sm font-bold text-emerald-400">
                            Save @_discountPercent% — $@(plan.OriginalPrice.Value - plan.MonthlyPrice) off every month
                        </p>
                    }
                </div>

                @* Countdown — only on offer card *@
                @if (isOffer)
                {
                    <div class="mt-5 rounded-xl border border-background/15 bg-background/5 px-4 py-3.5">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-background/60">
                            Offer ends in
                        </p>
                        <div class="mt-2 flex items-end gap-2">
                            @foreach (var seg in _countdownSegments)
                            {
                                var segItem = seg;
                                <div class="flex items-end gap-2">
                                    @if (segItem.ShowColon)
                                    {
                                        <span aria-hidden="true" class="text-2xl font-bold leading-none text-background/30">:</span>
                                    }
                                    <div class="text-center">
                                        <span aria-hidden="true" class="text-2xl font-bold leading-none tabular-nums text-background">
                                            @segItem.PaddedValue
                                        </span>
                                        <span class="sr-only">@segItem.Value @segItem.Label</span>
                                        <p class="mt-1 text-[10px] font-medium uppercase tracking-wider text-background/50">
                                            @segItem.Label
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* CTA *@
                <ButtonCn Class="@Cn.Merge("mt-6 w-full", isOffer ? "bg-background text-foreground hover:bg-background/90" : "bg-foreground text-background")">
                    @plan.Cta
                </ButtonCn>

                @* Features *@
                <div class="mt-6 flex-1">
                    <p class="@Cn.Merge("text-sm font-semibold", isOffer ? "text-background" : "text-foreground")">
                        @plan.FeatureHeading
                    </p>
                    <ul class="mt-4 space-y-3">
                        @foreach (var feature in plan.Features)
                        {
                            var feat = feature;
                            var featIsOffer = isOffer;
                            <li class="flex items-start justify-between gap-3">
                                <span class="flex items-start gap-2.5">
                                    <LucideIconCn Name="check" Size="16" StrokeWidth="3"
                                        Class="@Cn.Merge("mt-0.5 size-4 shrink-0 stroke-[3]", featIsOffer ? "text-emerald-400" : "text-emerald-600 dark:text-emerald-500")" />
                                    <span class="@Cn.Merge("text-sm font-medium leading-snug", featIsOffer ? "text-background/90" : "text-foreground")">
                                        @feat.Name
                                    </span>
                                </span>
                                @if (feat.Tooltip != null)
                                {
                                    <TooltipCn OpenDelay="200">
                                        <TooltipTriggerCn Tabbable="false">
                                            <button type="button" aria-label="@($"More info about {feat.Name}")" class="mt-0.5">
                                                <LucideIconCn Name="info" Size="14"
                                                    Class="@Cn.Merge("size-3.5 shrink-0 cursor-help", featIsOffer ? "text-background/40" : "text-muted-foreground/40")" />
                                            </button>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Side="FloatingSide.Top" Class="max-w-[220px]">
                                            <p class="text-xs">@feat.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private record PlanFeature(string Name, string? Tooltip = null);

    private record Plan(
        string Id,
        string Name,
        string Description,
        int MonthlyPrice,
        int? OriginalPrice,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta,
        bool IsLimitedOffer
    );

    private record CountdownSegment(int Value, string Label, bool ShowColon)
    {
        public string PaddedValue => Value.ToString().PadLeft(2, '0');
    }

    private static readonly Plan[] _plans =
    [
        new(
            "starter", "Starter",
            "For individuals and side projects getting started.",
            19, null,
            "What's included:",
            [
                new("Up to 3 projects"),
                new("5GB storage with CDN"),
                new("Community support", "Access to community forums and knowledge base with best-effort response times."),
                new("Basic usage analytics"),
                new("Single-user workspace"),
            ],
            "Get started",
            false
        ),
        new(
            "pro-limited", "Pro",
            "Everything you need to ship fast. Limited-time launch rate.",
            29, 49,
            "Everything in Starter, plus:",
            [
                new("Unlimited projects"),
                new("100GB storage with global CDN", "Content served from 50+ edge locations worldwide for sub-80ms latency."),
                new("Priority support (4h SLA)", "Guaranteed first response within 4 business hours, Monday through Friday."),
                new("Advanced analytics with funnels"),
                new("Up to 10 team members"),
                new("Custom domains with auto-SSL", "Connect your own domain with automatic SSL certificate provisioning and renewal."),
                new("REST and GraphQL API access"),
            ],
            "Claim this deal",
            true
        ),
        new(
            "team", "Team",
            "For scaling teams that need SSO and compliance.",
            79, null,
            "Everything in Pro, plus:",
            [
                new("Unlimited storage", "No storage caps. Fair use policy applies for accounts exceeding 500GB."),
                new("24/7 phone and chat support"),
                new("SAML SSO with directory sync", "Connect Okta, Azure AD, or Google Workspace with automatic user provisioning."),
                new("Up to 50 team members"),
                new("Audit logs with 1-year retention", "Full activity trail for compliance. Export to SIEM tools via webhook."),
                new("Role-based access control (RBAC)"),
            ],
            "Start free trial",
            false
        ),
    ];

    private int _days = 2;
    private int _hours = 14;
    private int _minutes = 32;
    private int _seconds = 0;
    private int _discountPercent = 0;
    private System.Threading.Timer? _timer;

    private CountdownSegment[] _countdownSegments =>
    [
        new(_days,    "days", false),
        new(_hours,   "hrs",  true),
        new(_minutes, "min",  true),
        new(_seconds, "sec",  true),
    ];

    protected override void OnInitialized()
    {
        var proPlan = _plans[1];
        _discountPercent = proPlan.OriginalPrice.HasValue
            ? (int)Math.Round(((double)(proPlan.OriginalPrice.Value - proPlan.MonthlyPrice) / proPlan.OriginalPrice.Value) * 100)
            : 0;

        _timer = new System.Threading.Timer(_ =>
        {
            _seconds--;
            if (_seconds < 0) { _seconds = 59; _minutes--; }
            if (_minutes < 0) { _minutes = 59; _hours--; }
            if (_hours < 0) { _hours = 23; _days--; }
            if (_days < 0)
            {
                _days = 0; _hours = 0; _minutes = 0; _seconds = 0;
                _timer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
            }
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
