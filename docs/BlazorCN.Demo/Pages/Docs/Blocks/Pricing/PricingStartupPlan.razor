@* ============================================================
   Block: pricing-startup-plan
   Title: PricingStartupPlan
   Description: A single featured startup pricing section for React and Next.js with one bold qualifying plan card showing animated price with NumberFlow, eligibility checklist, progressive feature list, and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-startup-plan.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Marketing header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Built for founders
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            One plan. 80% off. For startups only.
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            We built this for the founders we wish we had supported earlier. Apply once, locked in for
            two years.
        </p>
    </div>

    @* Hero card *@
    <article class="relative mt-8 overflow-hidden rounded-2xl bg-muted p-6 sm:p-8">
        @* Top row: badge + plan name *@
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-2xl font-bold tracking-tight">@_plan.Name</h3>
            <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                @_plan.Badge
            </span>
        </div>

        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">@_plan.Description</p>

        @* Billing toggle *@
        <div class="mt-6 flex justify-center">
            <div class="inline-flex items-center rounded-full border bg-background p-1 text-sm">
                @foreach (var opt in _billingOptions)
                {
                    var optVal = opt;
                    <button
                        type="button"
                        class="@(_billing == optVal ? "rounded-full bg-foreground px-4 py-1 text-background font-medium" : "rounded-full px-4 py-1 text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _billing = optVal)"
                        aria-pressed="@(_billing == optVal ? "true" : "false")">
                        @(optVal == "monthly" ? "Monthly" : "Annually")
                    </button>
                }
            </div>
        </div>

        @* Price block *@
        <div class="mt-6 flex flex-col items-center text-center">
            <div class="flex items-baseline gap-2">
                <s aria-hidden="true" class="text-xl text-muted-foreground/60">
                    $@_plan.OriginalMonthlyPrice
                </s>
                <span class="text-5xl font-bold tracking-tight tabular-nums">
                    $@(_billing == "monthly" ? _plan.MonthlyPrice : _plan.AnnualPrice)
                </span>
                <span class="text-base text-muted-foreground">/month</span>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                @if (_billing == "annually")
                {
                    @($"Billed annually at ${_plan.AnnualPrice * 12}/year. Locked for 24 months.")
                }
                else
                {
                    @("Billed monthly. Switch to annual for additional savings.")
                }
            </p>
        </div>

        @* CTA — full width below price *@
        <ButtonCn Class="mt-6 w-full">@_plan.Cta</ButtonCn>

        @* Eligibility — qualification gate *@
        <div class="mt-8 rounded-xl border border-dashed bg-background/60 p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                You qualify if you are
            </p>
            <ul class="mt-4 space-y-3.5">
                @foreach (var item in _plan.Eligibility)
                {
                    var elig = item;
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-foreground text-background">
                            <LucideIconCn Name="@elig.Icon" Size="14" Class="size-3.5" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-semibold text-foreground">@elig.Label</p>
                            <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                                @elig.Detail
                            </p>
                        </div>
                    </li>
                }
            </ul>
        </div>

        @* Feature list *@
        <div class="mt-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                @_plan.FeatureHeading
            </p>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                @foreach (var feature in _plan.Features)
                {
                    var feat = feature;
                    <li class="flex items-center justify-between gap-2">
                        <span class="flex items-center gap-2.5">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm font-medium text-foreground">@feat.Name</span>
                        </span>
                        @if (!string.IsNullOrEmpty(feat.Tooltip))
                        {
                            <TooltipProviderCn DelayDuration="200">
                                <TooltipCn>
                                    <TooltipTriggerCn>
                                        <LucideIconCn Name="info" Size="12" Class="size-3 shrink-0 cursor-help text-muted-foreground/30" />
                                    </TooltipTriggerCn>
                                    <TooltipContentCn Class="max-w-[220px]">
                                        <p class="text-xs">@feat.Tooltip</p>
                                    </TooltipContentCn>
                                </TooltipCn>
                            </TooltipProviderCn>
                        }
                    </li>
                }
            </ul>
        </div>
    </article>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Verification takes under 24 hours. No credit card required to apply. Approved founders
        receive a coupon code by email.
    </p>
</section>

@code {
    private record EligibilityItem(string Icon, string Label, string Detail);
    private record PlanFeature(string Name, string? Tooltip = null);
    private record StartupPlan(
        string Id,
        string Name,
        string Description,
        int MonthlyPrice,
        int AnnualPrice,
        int OriginalMonthlyPrice,
        string Badge,
        EligibilityItem[] Eligibility,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta
    );

    private string _billing = "annually";

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private static readonly StartupPlan _plan = new(
        Id: "founders",
        Name: "Founders Edition",
        Description: "Our complete platform at 80% off for verified early-stage startups. Built with founders for founders.",
        MonthlyPrice: 29,
        AnnualPrice: 19,
        OriginalMonthlyPrice: 149,
        Badge: "Best Value",
        Eligibility:
        [
            new("rocket", "Less than 5 employees", "Solo founders, technical co-founders, and early teams."),
            new("zap", "Under $1M in funding", "Pre-seed through seed stage. Self-funded welcome."),
            new("users", "Incorporated within 24 months", "Verified through your incorporation documents."),
        ],
        FeatureHeading: "Everything in Pro, plus founder perks:",
        Features:
        [
            new("Unlimited projects and team members"),
            new("100GB storage with global CDN", "Files served from 50+ edge locations worldwide for sub-80ms latency."),
            new("Priority email support (4h SLA)", "Guaranteed first response within 4 business hours, Monday through Friday."),
            new("Investor reporting dashboard", "Auto-generate monthly investor updates with MRR, churn, and runway metrics. Export as PDF."),
            new("Direct Slack channel with our CEO", "Shared Slack workspace with our founding team. Get product feedback and roadmap input."),
            new("Free credits for partner tools", "Up to $50,000 in credits across AWS, Stripe, Notion, and 30+ other startup partner programs."),
            new("Locked pricing for 24 months"),
        ],
        Cta: "Apply for Founders Edition"
    );
}
