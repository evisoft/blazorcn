@* ========================================
   Block: pricing-featured-plan
   Title: Pricing Featured Plan
   Description: Horizontal pricing layout with one featured plan prominently displayed alongside feature breakdown and secondary tier options
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideZapCn
   Source: original/blocks/pricing/pricing-featured-plan.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                One plan. Everything you need.
            </h2>
            <p class="text-muted-foreground text-lg">
                Most teams choose Pro. Get started in minutes.
            </p>
        </div>

        <div class="mx-auto max-w-4xl space-y-6">
            @* Featured Plan *@
            <CardCn Class="border-primary relative overflow-hidden shadow-lg ring-1 ring-primary/20">
                <div class="bg-primary absolute top-0 right-0 left-0 h-1"></div>
                <CardHeaderCn Class="pb-0">
                    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
                        <div>
                            <div class="mb-2 flex items-center gap-2">
                                <BadgeCn Class="gap-1">
                                    <LucideZapCn Class="h-3 w-3" Size="12" />
                                    Most Popular
                                </BadgeCn>
                            </div>
                            <h3 class="text-2xl font-bold">Pro</h3>
                            <p class="text-muted-foreground mt-1 text-sm">
                                For growing teams that need more power and flexibility
                            </p>
                        </div>
                        <div class="text-right">
                            <div class="flex items-baseline gap-1">
                                <span class="text-5xl font-bold tracking-tight">$39</span>
                                <span class="text-muted-foreground text-sm">/month</span>
                            </div>
                            <p class="text-muted-foreground mt-1 text-xs">Billed annually at $468/year</p>
                        </div>
                    </div>
                </CardHeaderCn>
                <CardContentCn Class="pt-6">
                    <SeparatorCn Class="mb-6" />
                    <div class="grid gap-3 sm:grid-cols-2">
                        @foreach (var feature in _featuredFeatures)
                        {
                            <div class="flex items-start gap-3">
                                <LucideCheckCn Class="text-primary mt-0.5 h-4 w-4 shrink-0" Size="16" />
                                <span class="text-sm">@feature</span>
                            </div>
                        }
                    </div>
                    <div class="mt-8">
                        <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                            Start Free Trial
                            <LucideArrowRightCn Class="h-4 w-4" Size="16" />
                        </ButtonCn>
                        <p class="text-muted-foreground mt-2 text-xs">
                            14-day free trial. No credit card required.
                        </p>
                    </div>
                </CardContentCn>
            </CardCn>

            @* Alternative Plans *@
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var plan in _alternatives)
                {
                    <CardCn Class="flex flex-col">
                        <CardHeaderCn Class="pb-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h3 class="font-semibold">@plan.Name</h3>
                                    <p class="text-muted-foreground text-xs">@plan.Description</p>
                                </div>
                                <div class="text-right">
                                    <span class="text-2xl font-bold">@plan.PriceDisplay</span>
                                    @if (plan.Price > 0)
                                    {
                                        <span class="text-muted-foreground text-xs">/mo</span>
                                    }
                                </div>
                            </div>
                        </CardHeaderCn>
                        <CardContentCn Class="flex flex-1 flex-col">
                            <ul class="mb-6 flex-1 space-y-2">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-center gap-2">
                                        <LucideCheckCn Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" Size="14" />
                                        <span class="text-muted-foreground text-sm">@feature</span>
                                    </li>
                                }
                            </ul>
                            <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">@plan.Cta</ButtonCn>
                        </CardContentCn>
                    </CardCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record AltPlan(string Name, int Price, string PriceDisplay, string Description, string[] Features, string Cta);

    private static readonly string[] _featuredFeatures =
    [
        "Unlimited projects & workspaces", "100 GB cloud storage", "Up to 20 team members",
        "Priority email support", "Advanced analytics dashboard", "Custom domains & branding",
        "API access & webhooks", "Third-party integrations",
    ];

    private static readonly AltPlan[] _alternatives =
    [
        new("Free", 0, "Free", "For personal projects", ["3 projects", "1 GB storage", "Community support"], "Get Started"),
        new("Business", 79, "$79", "For scaling organizations", ["Unlimited everything", "SSO & audit logs", "Dedicated support"], "Contact Sales"),
    ];
}
