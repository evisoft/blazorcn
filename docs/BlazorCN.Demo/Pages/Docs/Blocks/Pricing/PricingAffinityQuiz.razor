@* ============================================================
   Block: pricing-affinity-quiz
   Title: PricingAffinityQuiz
   Description: A personality quiz pricing section for React and Next.js with four multiple choice questions a progress bar that fills as you answer and a final plan match screen that tallies answer affinities and reveals the winning plan with NumberFlow animated price and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-affinity-quiz.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Find your plan persona
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Which one of these are you?
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            Answer four quick questions and we'll match you to the plan that fits how you actually
            work.
        </p>
    </div>

    @* Main card *@
    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        @* Progress bar *@
        <div
            class="h-1 w-full overflow-hidden bg-foreground/10"
            role="progressbar"
            aria-valuenow="@_answeredCount"
            aria-valuemin="0"
            aria-valuemax="@_questions.Length"
            aria-label="Quiz progress">
            <div
                class="h-full bg-foreground transition-all duration-500"
                style="@(FormattableString.Invariant($"width:{_progressPct}%"))">
            </div>
        </div>

        @* Body *@
        <div class="relative min-h-[420px] px-6 py-7 sm:px-8">
            @if (_isResultStep)
            {
                @* Result screen *@
                <div class="flex flex-col items-center text-center" aria-live="polite">
                    @* Match badge *@
                    <div class="inline-flex items-center gap-1.5 rounded-full border border-foreground/10 bg-background/60 px-3 py-1 shadow-sm">
                        <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-red-500" />
                        <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                            You matched @_matchPct%
                        </span>
                    </div>

                    @* Plan name + vibe *@
                    <h3 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
                        @_matchedPlan.Name
                    </h3>
                    <p class="mt-2 text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                        @_matchedPlan.Vibe
                    </p>
                    <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">
                        @_matchedPlan.Signature
                    </p>

                    @* Price *@
                    <div class="mt-6 flex items-baseline justify-center gap-1.5">
                        <span class="text-5xl font-bold tracking-tight tabular-nums">
                            $@_matchedPlan.MonthlyPrice
                        </span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">Billed monthly, cancel anytime</p>

                    @* Bullets — 2-col grid in a centered max-width container *@
                    <ul class="mt-6 grid w-full max-w-md grid-cols-1 gap-x-5 gap-y-2.5 sm:grid-cols-2">
                        @foreach (var bullet in _matchedPlan.Bullets)
                        {
                            <li class="flex items-start gap-2.5 text-left">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                <span class="text-sm font-medium text-foreground">@bullet</span>
                            </li>
                        }
                    </ul>

                    @* Mini tally of other plans *@
                    <div class="mt-7 w-full max-w-md rounded-xl border border-foreground/10 bg-background/40 p-4 text-left">
                        <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                            Your affinity breakdown
                        </p>
                        <div class="mt-3 space-y-2">
                            @foreach (var plan in _plans)
                            {
                                var score = _tally.TryGetValue(plan.Id, out var s) ? s : 0;
                                var pct = (int)Math.Round((double)score / _questions.Length * 100);
                                var isMatch = plan.Id == _matchedPlan.Id;
                                <div class="flex items-center gap-3 text-xs">
                                    <span class="@Cn.Merge("w-28 shrink-0 truncate", isMatch ? "font-semibold text-foreground" : "text-muted-foreground")">
                                        @plan.Name
                                    </span>
                                    <div class="relative h-1.5 flex-1 overflow-hidden rounded-full bg-foreground/10">
                                        <div
                                            class="@Cn.Merge("absolute inset-y-0 left-0 rounded-full transition-all duration-500", isMatch ? "bg-foreground" : "bg-foreground/30")"
                                            style="@($"width:{pct}%")">
                                        </div>
                                    </div>
                                    <span class="@Cn.Merge("w-8 shrink-0 text-right font-mono tabular-nums", isMatch ? "text-foreground" : "text-muted-foreground")">
                                        @pct%
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    @* CTA + retake *@
                    <div class="mt-7 flex w-full max-w-md flex-col items-center gap-3 sm:flex-row sm:justify-center">
                        <ButtonCn Size="ButtonSize.Sm" Class="w-full sm:w-[230px]">
                            @_matchedPlan.Cta
                        </ButtonCn>
                        <button
                            type="button"
                            @onclick="HandleReset"
                            class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground focus:outline-none focus-visible:text-foreground">
                            <LucideIconCn Name="rotate-ccw" Size="14" Class="size-3.5" />
                            Retake quiz
                        </button>
                    </div>
                </div>
            }
            else if (_currentQuestion != null)
            {
                var q = _currentQuestion;
                <fieldset class="flex flex-col">
                    <legend class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                        Question @(_stepIndex + 1) of @_questions.Length
                    </legend>
                    <p class="mt-2 text-xl font-bold tracking-tight sm:text-2xl">
                        @q.Prompt
                    </p>
                    <p class="mt-1.5 text-sm text-muted-foreground">@q.Helper</p>

                    <div class="mt-5 grid gap-2.5 sm:grid-cols-2">
                        @foreach (var answer in q.Answers)
                        {
                            var ans = answer;
                            var isSelected = _selections.TryGetValue(q.Id, out var sel) && sel == ans.Letter;
                            <label class="@Cn.Merge("group relative flex cursor-pointer items-start gap-3 rounded-xl border p-4 transition-all focus-within:ring-2 focus-within:ring-foreground/40", isSelected ? "border-foreground bg-background shadow-sm" : "border-foreground/10 bg-background/40 hover:border-foreground/30 hover:bg-background/60")">
                                <input
                                    type="radio"
                                    name="@q.Id"
                                    value="@ans.Letter"
                                    checked="@isSelected"
                                    @onchange="@(() => HandleSelect(ans.Letter))"
                                    class="sr-only" />
                                <span
                                    class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full border font-mono text-xs font-bold tabular-nums transition-colors", isSelected ? "border-foreground bg-foreground text-background" : "border-foreground/20 bg-background text-muted-foreground")"
                                    aria-hidden="true">
                                    @ans.Letter
                                </span>
                                <span class="text-sm font-medium leading-snug text-foreground">
                                    @ans.Label
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>
            }
        </div>

        @* Footer — live tally dots or answer count *@
        @if (!_isResultStep)
        {
            <div class="flex items-center justify-between border-t border-foreground/10 bg-background/40 px-6 py-4 sm:px-8">
                <div class="flex items-center gap-1.5">
                    @foreach (var qi in _questions.Select((q, i) => new { q, i }))
                    {
                        var answered = _selections.ContainsKey(qi.q.Id);
                        var isCurrent = qi.i == _stepIndex;
                        <span
                            class="@Cn.Merge("h-1.5 rounded-full transition-all", answered ? "w-4 bg-foreground" : isCurrent ? "w-4 bg-foreground/40" : "w-1.5 bg-foreground/20")"
                            aria-hidden="true">
                        </span>
                    }
                </div>
                <span class="text-[11px] text-muted-foreground">
                    @_answeredCount of @_questions.Length answered
                </span>
            </div>
        }
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private int _stepIndex = 0;
    private Dictionary<string, string> _selections = new();

    private record PlanItem(string Id, string Name, string Vibe, int MonthlyPrice, string Signature, string[] Bullets, string Cta);
    private record AnswerItem(string Letter, string Label, string PlanId);
    private record QuestionItem(string Id, string Prompt, string Helper, AnswerItem[] Answers);

    private static readonly PlanItem[] _plans =
    [
        new("maker", "The Maker", "Fast, simple, solo", 19, "Build and ship without the bloat.",
            ["Clean, uncluttered workspace", "Instant deploy, no config", "Community peer support", "Core integrations only"],
            "Start free trial"),
        new("team", "The Team", "Collaborative, structured, scaling", 99, "Ship together without losing structure.",
            ["Real-time collaboration", "Role-based permissions", "Priority support, 4h SLA", "Advanced integrations + webhooks"],
            "Start free trial"),
        new("pro", "The Power User", "Advanced, customizable, deep", 199, "Tune every knob and automate everything.",
            ["Full API access and automation", "Custom workflows and macros", "Advanced analytics and exports", "Dedicated success manager"],
            "Start free trial"),
        new("enterprise", "The Enterprise", "Secure, compliant, mission-critical", 599, "Run the whole organization with confidence.",
            ["SOC2, HIPAA, custom DPA", "SAML SSO and audit logs", "99.99% uptime with credits", "White-glove migration team"],
            "Contact sales"),
    ];

    private static readonly QuestionItem[] _questions =
    [
        new("morning", "It's Monday morning. What does your ideal workday look like?", "Be honest — what actually gives you energy?",
        [
            new("A", "Coffee, coding, flow state. Alone.", "maker"),
            new("B", "Stand-up with the team, shared sprint goals.", "team"),
            new("C", "Deep dive into dashboards and automation.", "pro"),
            new("D", "Aligning with stakeholders and compliance reviews.", "enterprise"),
        ]),
        new("tool", "How do you feel about settings panels with fifty toggles?", "There's no wrong answer — just a real one.",
        [
            new("A", "Bury them. Sane defaults please.", "maker"),
            new("B", "Show the ones my team actually uses.", "team"),
            new("C", "Give me every knob — I'll tune it myself.", "pro"),
            new("D", "Put them behind role-based permissions.", "enterprise"),
        ]),
        new("success", "What does success look like a year from now?", "Paint the picture in one sentence.",
        [
            new("A", "I shipped a thing people actually use.", "maker"),
            new("B", "My team doubled our output without burnout.", "team"),
            new("C", "Everything is automated. I manage exceptions.", "pro"),
            new("D", "We passed our audit and landed a Fortune 500.", "enterprise"),
        ]),
        new("support", "Your support expectations when things go sideways?", "This one tends to be decisive.",
        [
            new("A", "Discord is fine, I'll figure it out.", "maker"),
            new("B", "Business hours email with a human, please.", "team"),
            new("C", "Priority chat with engineers who know the product.", "pro"),
            new("D", "24/7 account team with a phone tree, SLAs in writing.", "enterprise"),
        ]),
    ];

    private int _answeredCount => _selections.Count;
    private bool _isResultStep => _stepIndex >= _questions.Length;
    private QuestionItem? _currentQuestion => _isResultStep ? null : _questions[_stepIndex];
    private double _progressPct => (double)_answeredCount / _questions.Length * 100;

    private Dictionary<string, int> _tally
    {
        get
        {
            var tally = new Dictionary<string, int>();
            foreach (var plan in _plans) tally[plan.Id] = 0;
            foreach (var question in _questions)
            {
                if (_selections.TryGetValue(question.Id, out var letter))
                {
                    var ans = Array.Find(question.Answers, a => a.Letter == letter);
                    if (ans != null)
                        tally[ans.PlanId] = tally.GetValueOrDefault(ans.PlanId) + 1;
                }
            }
            return tally;
        }
    }

    private PlanItem _matchedPlan
    {
        get
        {
            var tally = _tally;
            var leadingId = _plans[0].Id;
            var maxScore = -1;
            foreach (var kv in tally)
            {
                if (kv.Value > maxScore) { maxScore = kv.Value; leadingId = kv.Key; }
            }
            return Array.Find(_plans, p => p.Id == leadingId) ?? _plans[0];
        }
    }

    private int _matchPct
    {
        get
        {
            var tally = _tally;
            var plan = _matchedPlan;
            var score = tally.TryGetValue(plan.Id, out var s) ? s : 0;
            return (int)Math.Round((double)score / _questions.Length * 100);
        }
    }

    private async Task HandleSelect(string letter)
    {
        if (_currentQuestion == null) return;
        _selections[_currentQuestion.Id] = letter;
        StateHasChanged();
        await Task.Delay(350);
        _stepIndex = Math.Min(_stepIndex + 1, _questions.Length);
    }

    private void HandleReset()
    {
        _selections = new();
        _stepIndex = 0;
    }
}
