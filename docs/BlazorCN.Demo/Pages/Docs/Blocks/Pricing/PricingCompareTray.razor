@* ============================================================
   Block: pricing-compare-tray
   Title: PricingCompareTray
   Description: A four-column interactive compare tray pricing section for React and Next.js with add-to-compare checkbox toggles on each plan card and an expandable sticky comparison drawer that reveals side-by-side difference rows for the selected plans with emerald checkmarks muted dashes and quantity cells built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-compare-tray.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Compare &amp; Choose
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pick plans to compare side by side
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Toggle any two or more plans into the comparison tray to see a detailed feature-by-feature
            breakdown.
        </p>

        <div class="mt-6 flex items-center justify-center">
            <div class="inline-flex rounded-full border bg-muted p-1" role="tablist" aria-label="Billing period">
                @foreach (var tab in _billingOptions)
                {
                    var tabVal = tab;
                    <button type="button"
                            role="tab"
                            aria-selected="@(_billing == tabVal ? "true" : "false")"
                            @onclick="@(() => _billing = tabVal)"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == tabVal ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @(tabVal == "monthly" ? "Monthly" : "Annually")
                    </button>
                }
            </div>
        </div>
    </div>

    @* Plan grid *@
    <div class="mx-auto mt-10 grid max-w-md gap-4 sm:max-w-2xl sm:grid-cols-2 lg:max-w-none lg:grid-cols-4">
        @foreach (var plan in _plans)
        {
            var planItem = plan;
            var price = _billing == "monthly" ? planItem.MonthlyPrice : planItem.AnnualPrice;
            var isSelected = _selected.Contains(planItem.Id);
            <article class="@Cn.Merge("flex h-full flex-col overflow-hidden rounded-2xl bg-muted p-5 transition-all", planItem.IsPopular ? "ring-2 ring-foreground/10" : "", isSelected ? "ring-2 ring-foreground/40" : "")">
                @* Reserved badge + compare toggle slot *@
                <div class="flex h-7 items-start justify-between gap-2">
                    @if (planItem.IsPopular)
                    {
                        <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                    else
                    {
                        <span></span>
                    }
                </div>

                <h3 class="mt-4 text-xl font-bold tracking-tight">@planItem.Name</h3>
                <p class="mt-1 min-h-[2.25rem] text-xs leading-relaxed text-muted-foreground">
                    @planItem.Description
                </p>

                @* Price *@
                <div class="mt-4 flex h-10 items-baseline gap-1 sm:h-12">
                    @if (price == 0)
                    {
                        <span class="text-3xl font-bold tracking-tight">Free</span>
                    }
                    else
                    {
                        <span class="text-3xl font-bold tracking-tight tabular-nums">$@price</span>
                        <span class="text-xs text-muted-foreground">/mo</span>
                    }
                </div>
                <p class="mt-1 h-4 text-[11px] text-muted-foreground">
                    @if (price == 0)
                    {
                        <span>Forever free</span>
                    }
                    else if (_billing == "annually")
                    {
                        <span>$@(price * 12)/year</span>
                    }
                    else
                    {
                        <span>Per month</span>
                    }
                </p>

                @* CTA *@
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 w-full">@planItem.Cta</ButtonCn>

                @* Add to compare toggle *@
                <button type="button"
                        @onclick="@(() => ToggleSelect(planItem.Id))"
                        aria-pressed="@(isSelected ? "true" : "false")"
                        class="@Cn.Merge("mt-3 flex w-full items-center justify-center gap-1.5 rounded-full border px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider transition-colors", isSelected ? "border-foreground bg-foreground text-background hover:bg-foreground/90" : "border-dashed border-foreground/20 text-muted-foreground hover:border-foreground/40 hover:text-foreground")">
                    @if (isSelected)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" aria-hidden="true" />
                        <span>Selected</span>
                    }
                    else
                    {
                        <LucideIconCn Name="plus" Size="12" Class="size-3" aria-hidden="true" />
                        <span>Add to compare</span>
                    }
                </button>

                @* Top features preview *@
                <ul class="mt-5 flex-1 space-y-2 border-t pt-4">
                    @foreach (var feature in planItem.Features)
                    {
                        <li class="flex items-start gap-2">
                            <LucideIconCn Name="check" Size="14" StrokeWidth="3" Class="mt-0.5 size-3.5 shrink-0 text-emerald-600 dark:text-emerald-500" />
                            <span class="text-xs font-medium text-foreground">@feature</span>
                        </li>
                    }
                </ul>
            </article>
        }
    </div>

    @* Comparison tray *@
    <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
        @* Tray header *@
        <div class="flex flex-wrap items-center justify-between gap-3 border-b px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                    <span class="text-xs font-bold tabular-nums text-foreground">
                        @_selected.Count
                    </span>
                </div>
                <div>
                    <p class="text-sm font-semibold text-foreground">Comparison tray</p>
                    <p class="text-[11px] text-muted-foreground">
                        @if (_showDrawer)
                        {
                            <span>Comparing @_selected.Count of 4 plans</span>
                        }
                        else
                        {
                            <span>Select @(2 - _selected.Count) more plan@(_selected.Count == 1 ? "" : "s") to compare</span>
                        }
                    </p>
                </div>
            </div>
            @if (_selected.Count > 0)
            {
                <button type="button"
                        @onclick="ClearAll"
                        class="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="x" Size="12" Class="size-3" aria-hidden="true" />
                    Clear all
                </button>
            }
        </div>

        @* Expandable drawer *@
        @if (_showDrawer)
        {
            <div role="region" aria-live="polite" aria-label="Plan comparison" class="overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[540px] table-fixed">
                        <thead>
                            <tr class="border-b">
                                <th scope="col" class="w-[180px] px-5 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                                    Feature
                                </th>
                                @foreach (var colPlan in _comparingPlans)
                                {
                                    <th scope="col" class="@Cn.Merge("px-4 py-3 text-center text-sm font-bold text-foreground", colPlan.IsPopular ? "bg-muted/40" : "")">
                                        @colPlan.Name
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _compareRows)
                            {
                                var compareRow = row;
                                <tr class="border-b last:border-0">
                                    <th scope="row" class="px-5 py-3 text-left text-xs font-medium text-foreground">
                                        @compareRow.Label
                                    </th>
                                    @foreach (var colPlan in _comparingPlans)
                                    {
                                        var cellPlan = colPlan;
                                        var cellValue = compareRow.Values.GetValueOrDefault(cellPlan.Id);
                                        <td class="@Cn.Merge("px-4 py-3 text-center", cellPlan.IsPopular ? "bg-muted/40" : "")">
                                            @if (cellValue == "true")
                                            {
                                                <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="mx-auto size-4 text-emerald-600 dark:text-emerald-500" aria-label="Included" />
                                            }
                                            else if (string.IsNullOrEmpty(cellValue))
                                            {
                                                <LucideIconCn Name="minus" Size="16" StrokeWidth="2" Class="mx-auto size-4 text-muted-foreground/30" aria-label="Not included" />
                                            }
                                            else
                                            {
                                                <span class="text-xs font-semibold tabular-nums text-foreground">@cellValue</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Switch plans anytime.
    </p>
</section>

@code {
    private record Plan(string Id, string Name, string Description, int MonthlyPrice, int AnnualPrice, string[] Features, string Cta, bool IsPopular);
    private record CompareRow(string Label, Dictionary<string, string?> Values);

    private static readonly Plan[] _plans =
    [
        new("free",     "Free",     "For side projects",      0,   0,   ["3 projects", "1 GB storage", "Community support"],       "Get started",    false),
        new("solo",     "Solo",     "For indie developers",   19,  15,  ["25 projects", "25 GB storage", "Email support"],          "Start trial",    false),
        new("team",     "Team",     "For growing companies",  49,  39,  ["Unlimited projects", "250 GB storage", "Priority 4h SLA"], "Start trial",   true),
        new("business", "Business", "For enterprises",        149, 119, ["SAML SSO", "Audit logs, 1 yr", "Dedicated CSM"],          "Contact sales",  false),
    ];

    private static readonly CompareRow[] _compareRows =
    [
        new("Projects",         new() { ["free"] = "3",      ["solo"] = "25",    ["team"] = "Unlimited", ["business"] = "Unlimited" }),
        new("Team members",     new() { ["free"] = "1",      ["solo"] = "3",     ["team"] = "25",        ["business"] = "Unlimited" }),
        new("Storage with CDN", new() { ["free"] = "1 GB",   ["solo"] = "25 GB", ["team"] = "250 GB",    ["business"] = "2 TB" }),
        new("Custom domains",   new() { ["free"] = null,     ["solo"] = "1",     ["team"] = "10",        ["business"] = "Unlimited" }),
        new("Priority support", new() { ["free"] = null,     ["solo"] = null,    ["team"] = "true",      ["business"] = "true" }),
        new("SAML SSO",         new() { ["free"] = null,     ["solo"] = null,    ["team"] = null,        ["business"] = "true" }),
        new("Audit logs",       new() { ["free"] = null,     ["solo"] = null,    ["team"] = "90 days",   ["business"] = "1 year" }),
        new("Uptime SLA",       new() { ["free"] = null,     ["solo"] = "99.9%", ["team"] = "99.95%",    ["business"] = "99.99%" }),
    ];

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private string _billing = "monthly";
    private HashSet<string> _selected = ["solo", "team"];

    private bool _showDrawer => _selected.Count >= 2;
    private IEnumerable<Plan> _comparingPlans => _plans.Where(p => _selected.Contains(p.Id));

    private void ToggleSelect(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else if (_selected.Count < 4)
            _selected.Add(id);
    }

    private void ClearAll() => _selected.Clear();
}
