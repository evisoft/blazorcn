@* ============================================================
   Block: pricing-bento-grid
   Title: PricingBentoGrid
   Description: An asymmetric bento grid pricing section for React and Next.js with five plan tiles arranged in a 3-column 2-row layout where the featured Pro tile spans both rows as the visual anchor, NumberFlow animated prices, ShadcnioButton CTAs, semantic icon headers, and quick highlight bullets per tile built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-bento-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pick a plan that fits how you build
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground leading-relaxed">
            Start free, scale to a featured Pro tier, or talk to sales for dedicated infrastructure.
            Every plan includes the core platform.
        </p>
    </div>

    @* Bento grid — 3 cols × 2 rows on lg+, single col on mobile *@
    <div class="mt-10 grid grid-cols-1 gap-3 lg:grid-cols-3 lg:grid-rows-2">
        @foreach (var plan in _plans)
        {
            var p = plan;
            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl border bg-card p-6 sm:p-7", p.Position, p.IsFeatured ? "border-foreground/15 bg-foreground text-background shadow-2xl" : "")">
                @* Featured badge *@
                @if (p.IsFeatured)
                {
                    <span class="absolute -top-3 left-6 inline-flex w-fit items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                        Best Value
                    </span>
                }

                @* Icon + name row *@
                <div class="flex items-center gap-3">
                    <span class="@Cn.Merge("flex size-9 items-center justify-center rounded-xl border", p.IsFeatured ? "border-background/15 bg-background/10" : "border-border bg-muted")">
                        <LucideIconCn Name="@p.Icon" Size="16" aria-hidden="true"
                            Class="@Cn.Merge("size-4", p.IsFeatured ? "text-background" : "text-foreground")" />
                    </span>
                    <h3 class="@Cn.Merge("text-xl font-bold tracking-tight", p.IsFeatured ? "text-background" : "text-foreground")">
                        @p.Name
                    </h3>
                </div>

                @* Tagline *@
                <p class="@Cn.Merge("mt-2 text-sm leading-relaxed", p.IsFeatured ? "text-background/65" : "text-muted-foreground")">
                    @p.Tagline
                </p>

                @* Price *@
                <div class="mt-5 flex h-12 items-baseline gap-1.5 sm:h-14">
                    @if (p.Price == null)
                    {
                        <span class="@Cn.Merge("text-3xl font-bold tracking-tight sm:text-4xl", p.IsFeatured ? "text-background" : "text-foreground")">
                            @p.PriceLabel
                        </span>
                    }
                    else if (p.Price == 0)
                    {
                        <span class="@Cn.Merge("text-3xl font-bold tracking-tight sm:text-4xl", p.IsFeatured ? "text-background" : "text-foreground")">
                            @p.PriceLabel
                        </span>
                    }
                    else
                    {
                        <span class="@Cn.Merge("text-3xl font-bold tracking-tight tabular-nums sm:text-4xl", p.IsFeatured ? "text-background" : "text-foreground")">
                            $@p.Price
                        </span>
                        <span class="@Cn.Merge("text-sm", p.IsFeatured ? "text-background/60" : "text-muted-foreground")">
                            /mo
                        </span>
                    }
                </div>

                @* Highlights *@
                <ul class="mt-5 flex flex-1 flex-col gap-2.5">
                    @foreach (var highlight in p.Highlights)
                    {
                        <li class="@Cn.Merge("flex items-start gap-2 text-sm", p.IsFeatured ? "text-background" : "text-foreground")">
                            <LucideIconCn Name="check" Size="16" aria-hidden="true"
                                Class="@Cn.Merge("mt-0.5 size-4 shrink-0 stroke-[3]", p.IsFeatured ? "text-emerald-400" : "text-emerald-600 dark:text-emerald-500")" />
                            <span class="leading-snug">@highlight</span>
                        </li>
                    }
                </ul>

                @* CTA pinned to bottom *@
                <div class="mt-6">
                    @if (p.IsFeatured)
                    {
                        <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90">@p.Cta</ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Class="w-full">@p.Cta</ButtonCn>
                    }
                </div>
            </article>
        }
    </div>

    @* Trust footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All paid plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private record PlanTile(
        string Id,
        string Name,
        string Tagline,
        int? Price,
        string? PriceLabel,
        string Icon,
        string[] Highlights,
        string Cta,
        string Position,
        bool IsFeatured = false
    );

    private static readonly PlanTile[] _plans =
    [
        new("starter", "Starter", "For solo developers shipping side projects", 19, null, "rocket", ["3 projects", "10 GB storage", "Community support"], "Get started", "lg:col-start-1 lg:row-start-1"),
        new("pro", "Pro", "For growing teams that ship every week", 99, null, "sparkles", ["Unlimited projects", "100 GB storage with global CDN", "Up to 10 team members", "Advanced analytics with funnels", "Priority chat support (4h SLA)", "Custom domains with auto-SSL"], "Start free trial", "lg:col-start-2 lg:row-start-1 lg:row-span-2", true),
        new("business", "Business", "For organizations with compliance needs", 249, null, "users-round", ["Unlimited team", "SAML SSO", "1-year audit logs"], "Start trial", "lg:col-start-3 lg:row-start-1"),
        new("free", "Free", "Try the platform with no time limit", 0, "Free", "zap", ["1 project", "1 GB storage", "Community forum"], "Sign up free", "lg:col-start-1 lg:row-start-2"),
        new("enterprise", "Enterprise", "For platforms needing dedicated infra", null, "Custom", "building", ["Dedicated VPC", "99.95% SLA", "Named CSM"], "Talk to sales", "lg:col-start-3 lg:row-start-2"),
    ];
}
