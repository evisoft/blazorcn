@* ============================================================
   Block: pricing-early-bird
   Title: PricingEarlyBird
   Description: A single hero plan early-bird pricing section for React and Next.js with a centered Founder card showing strikethrough original price next to discounted launch price, an animated spots remaining progress bar, two-column comprehensive feature grid with emerald checkmarks, ShadcnioButton CTA, red Best Value badge, and trust footer built with shadcn/ui Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-early-bird.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-muted-foreground">
            <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-red-500" aria-hidden="true" />
            Launch Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Early-bird pricing for founding members
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Be one of the first @_totalSpots customers and lock in @_savingsPercent% off forever.
            This price will never increase for early members.
        </p>
    </div>

    @* Hero plan card *@
    <article class="relative mt-10 flex flex-col overflow-hidden rounded-2xl bg-muted p-6 ring-2 ring-foreground/10 sm:p-10">
        @* Top row: name + badge *@
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-2xl font-bold tracking-tight">@_founderPlan.Name</h3>
            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                Best Value
            </span>
        </div>

        @* Description *@
        <p class="mt-3 max-w-md text-sm text-muted-foreground leading-relaxed">
            @_founderPlan.Description
        </p>

        @* Price *@
        <div class="mt-7 flex flex-col gap-2">
            <div class="flex flex-wrap items-baseline gap-3">
                <s aria-hidden="true" class="text-2xl font-medium text-muted-foreground tabular-nums sm:text-3xl">
                    $@_founderPlan.OriginalPrice
                </s>
                <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">
                    $@_founderPlan.EarlyBirdPrice
                </span>
                <span class="text-base text-muted-foreground">/month</span>
                <span class="rounded-full bg-emerald-600/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
                    Save @_savingsPercent%
                </span>
            </div>
            <p class="text-xs text-muted-foreground">
                That's $@_savingsDollars/month off the standard price — locked in forever.
            </p>
        </div>

        @* Spots remaining progress *@
        <div class="mt-7 rounded-xl border border-foreground/10 bg-background/60 p-4">
            <div class="flex items-baseline justify-between">
                <span class="text-sm font-semibold text-foreground">
                    @_spotsClaimed <span class="font-medium text-muted-foreground">of @_totalSpots spots claimed</span>
                </span>
                <span class="text-xs font-bold uppercase tracking-wider text-red-600 dark:text-red-500">
                    Only @_spotsRemaining left
                </span>
            </div>
            <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-muted-foreground/10"
                 role="progressbar"
                 aria-valuenow="@_spotsPercent"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-label="Founder spots claimed">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{_spotsPercent}%")"></div>
            </div>
        </div>

        @* CTA *@
        <div class="mt-7">
            <ButtonCn Class="w-full">@_founderPlan.Cta</ButtonCn>
        </div>

        @* Features grid *@
        <div class="mt-8">
            <p class="text-sm font-semibold">@_founderPlan.FeatureHeading</p>
            <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                @foreach (var feature in _founderPlan.Features)
                {
                    <li class="flex items-start justify-between gap-2">
                        <span class="flex items-start gap-2.5">
                            <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                            <span class="text-sm font-medium text-foreground">@feature.Name</span>
                        </span>
                        @if (feature.Tooltip != null)
                        {
                            <TooltipProviderCn DelayDuration="200">
                                <TooltipCn>
                                    <TooltipTriggerCn AsChild="true">
                                        <button type="button" aria-label="@($"More info about {feature.Name}")" class="inline-flex shrink-0">
                                            <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 cursor-help text-muted-foreground/40" />
                                        </button>
                                    </TooltipTriggerCn>
                                    <TooltipContentCn Class="max-w-[220px]">
                                        <p class="text-xs">@feature.Tooltip</p>
                                    </TooltipContentCn>
                                </TooltipCn>
                            </TooltipProviderCn>
                        }
                    </li>
                }
            </ul>
        </div>
    </article>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Early-bird price locks in forever. No price increases for founding members. 30-day
        money-back guarantee.
    </p>
</section>

@code {
    private record PlanFeature(string Name, string? Tooltip = null);

    private record FounderPlan(
        string Name,
        string Description,
        int OriginalPrice,
        int EarlyBirdPrice,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta);

    private const int _spotsClaimed = 47;
    private const int _totalSpots = 100;
    private const int _spotsPercent = (_spotsClaimed * 100) / _totalSpots;
    private const int _spotsRemaining = _totalSpots - _spotsClaimed;

    private static readonly FounderPlan _founderPlan = new(
        Name: "Founder",
        Description: "Lock in the launch price forever. Limited to the first 100 customers — once they're gone, the price returns to standard.",
        OriginalPrice: 59,
        EarlyBirdPrice: 29,
        FeatureHeading: "Everything in the platform, plus founder perks:",
        Features:
        [
            new("Unlimited projects"),
            new("100GB storage with global CDN", "Content delivered from 50+ edge locations for sub-80ms latency."),
            new("Priority support (4h SLA)", "Guaranteed first response within 4 business hours, Monday through Friday."),
            new("Advanced analytics with funnels"),
            new("Up to 10 team members"),
            new("Custom domains with auto-SSL", "Connect your own domain with automatic SSL provisioning and renewal."),
            new("REST and GraphQL API access"),
            new("Founder Discord access"),
            new("Early access to all new features"),
            new("All future updates included"),
            new("Locked-in price forever", "Your price will never increase, even when standard pricing changes."),
            new("Founders badge on your profile"),
        ],
        Cta: "Claim your founder spot"
    );

    private static readonly int _savingsPercent = (int)Math.Round((1.0 - (double)_founderPlan.EarlyBirdPrice / _founderPlan.OriginalPrice) * 100);
    private static readonly int _savingsDollars = _founderPlan.OriginalPrice - _founderPlan.EarlyBirdPrice;
}
