@* ============================================================
   Block: pricing-ticket-stub
   Title: PricingTicketStub
   Description: A horizontal perforated ticket-stub pricing section for React and Next.js with a wide split-panel card resembling a real ticket, dashed vertical perforation between two stubs with scalloped notches at top and bottom, sequential scarcity number on the left stub, NumberFlow animated price on the right stub, decorative barcode strip, semantic emerald checkmark feature list, and a ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-ticket-stub.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-muted-foreground">
            <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
            Founders ticket
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            One ticket. Lifetime access.
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
            Tear off your founders ticket below. Pay once, own it forever, and skip the recurring
            subscription entirely.
        </p>
    </div>

    @* Ticket card — perforated horizontal split *@
    <article class="relative mt-9">
        <div class="grid grid-cols-1 overflow-hidden rounded-2xl border bg-card md:grid-cols-[1.6fr_1fr]">
            @* LEFT MAIN STUB *@
            <div class="relative p-6 sm:p-8">
                @* Top header row: stub number + plan badge *@
                <div class="flex items-center justify-between gap-3">
                    <span class="inline-flex items-center rounded-full bg-foreground px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-background">
                        Lifetime Access
                    </span>
                    <span class="font-mono text-[10px] text-muted-foreground tabular-nums">
                        NO. @FormatStubNumber(_stubNumber) / @FormatStubNumber(_stubTotal)
                    </span>
                </div>

                @* Plan name + tagline *@
                <div class="mt-5">
                    <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">Lifetime Pro</h3>
                    <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">
                        Everything in Pro, paid once. Includes every future update at no extra cost.
                    </p>
                </div>

                @* Feature list *@
                <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-start gap-2 text-sm text-foreground">
                            <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" StrokeWidth="3" />
                            <span class="leading-snug">@feature</span>
                        </li>
                    }
                </ul>

                @* Bottom serial line *@
                <div class="mt-6 flex items-center justify-between gap-3 border-t border-dashed pt-3 font-mono text-[10px] text-muted-foreground/70 uppercase tracking-wider">
                    <span>Issued for one workspace</span>
                    <span>Non-transferable</span>
                </div>
            </div>

            @* PERFORATION — vertical dashed line + scalloped notches at top and bottom *@
            <div aria-hidden="true" class="-translate-x-1/2 pointer-events-none absolute top-0 bottom-0 left-[61.5%] hidden md:block">
                @* Top notch — half circle cut into the card from the top edge *@
                <div class="-translate-x-1/2 absolute top-0 left-1/2 size-5 rounded-full border bg-background"></div>
                @* Bottom notch — half circle cut into the card from the bottom edge *@
                <div class="-translate-x-1/2 -translate-y-0 absolute bottom-0 left-1/2 size-5 translate-y-2.5 rounded-full border bg-background"></div>
                @* Dashed line between notches *@
                <div class="absolute top-3 bottom-3 left-1/2 w-px border-border border-l border-dashed"></div>
            </div>

            @* RIGHT TEAR-OFF STUB *@
            <div class="relative bg-muted/30 p-6 sm:p-8">
                @* Mobile-only horizontal perforation hint *@
                <div aria-hidden="true" class="-mt-4 mb-4 border-border border-t border-dashed md:hidden"></div>

                <div class="flex h-full flex-col">
                    @* Mini header *@
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        Total due today
                    </p>

                    @* Price block *@
                    <div class="mt-2">
                        <div class="flex items-baseline gap-2">
                            <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">
                                $@_lifetimePrice
                            </span>
                        </div>
                        <div class="mt-2 flex items-baseline gap-2">
                            <s aria-hidden="true" class="text-sm tabular-nums text-muted-foreground/60">
                                $@_annualEquivalent/yr
                            </s>
                            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 ring-1 ring-emerald-500/20 dark:text-emerald-400">
                                Save @_savingsPercent%
                            </span>
                        </div>
                        <p class="mt-2 text-xs text-muted-foreground">One-time payment, no renewals</p>
                    </div>

                    @* Decorative monospace barcode strip *@
                    <div aria-hidden="true" class="my-5 flex h-10 items-end gap-[2px] overflow-hidden">
                        @foreach (var bar in _barWeights)
                        {
                            <span class="block h-full bg-foreground" style="@($"width:{bar}px")"></span>
                        }
                    </div>

                    @* CTA pinned to bottom *@
                    <div class="mt-auto">
                        <ButtonCn Class="w-full">Claim ticket</ButtonCn>
                        <p class="mt-3 text-center font-mono text-[10px] text-muted-foreground/70 uppercase tracking-wider">
                            Valid until sold out
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </article>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        60-day money back guarantee. No questions asked. Workspace provisioned the moment your
        payment clears.
    </p>
</section>

@code {
    private const int _lifetimePrice = 299;
    private const int _monthlyEquivalent = 29;
    private const int _annualEquivalent = _monthlyEquivalent * 12; // 348
    private const int _savingsPercent = 14; // Math.Round((348-299)/348*100)
    private const int _stubNumber = 47;
    private const int _stubTotal = 500;

    private static readonly string[] _features =
    [
        "Unlimited projects and environments",
        "100 GB storage with global edge CDN",
        "Up to 15 team members included",
        "Priority chat with 4-hour SLA",
        "All future updates, forever",
        "Full data export anytime",
    ];

    private static readonly int[] _barWeights =
    [
        3, 1, 2, 1, 3, 2, 1, 3, 1, 2, 3, 1, 2, 1, 3, 2, 3, 1, 2, 1, 3, 2, 1, 2, 3, 1, 2,
        1, 3, 2, 1, 3,
    ];

    private static string FormatStubNumber(int n) => n.ToString().PadLeft(3, '0');
}
