@* ============================================================
   Block: pricing-flip-reveal-cards
   Title: PricingFlipRevealCards
   Description: A three-column flip-reveal pricing section for React and Next.js with 3D rotateY click-to-flip plan cards that swap between a front summary view and a back detail view with extended feature lists customer testimonials and SLA badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-flip-reveal-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Flip any card to see the full story
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Click the refresh icon on any plan to reveal extended features, customer stories, and
            uptime guarantees.
        </p>

        <div class="mt-6 flex items-center justify-center">
            @* PillTabs rendered as a simple segmented control *@
            <div class="inline-flex items-center rounded-full border bg-muted p-1">
                <button type="button"
                        @onclick="@(() => _billing = "monthly")"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "monthly" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                    Monthly
                </button>
                <button type="button"
                        @onclick="@(() => _billing = "annually")"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "annually" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                    Annually
                </button>
            </div>
        </div>
    </div>

    @* Flip card grid *@
    <div class="mx-auto mt-10 grid max-w-lg gap-5 md:max-w-none md:grid-cols-3"
         style="perspective:1600px">
        @foreach (var plan in _plans)
        {
            var planItem = plan;
            var price = _billing == "monthly" ? planItem.MonthlyPrice : planItem.AnnualPrice;
            var isFlipped = _flipped.Contains(planItem.Id);
            <div class="relative h-[560px] w-full" style="transform-style:preserve-3d">
                @* Flip wrapper *@
                <div class="relative h-full w-full"
                     style="@($"transform-style:preserve-3d;transition:transform 0.5s;transform:{(isFlipped ? "rotateY(180deg)" : "rotateY(0deg)")}")">

                    @* FRONT FACE *@
                    <article class="@Cn.Merge("absolute inset-0 flex flex-col overflow-hidden rounded-2xl bg-muted p-6 sm:p-7", planItem.IsPopular ? "ring-2 ring-foreground/10" : "")"
                             style="backface-visibility:hidden;-webkit-backface-visibility:hidden"
                             aria-hidden="@isFlipped.ToString().ToLower()">
                        @* Reserved badge slot *@
                        <div class="flex h-7 items-start justify-between">
                            @if (planItem.IsPopular)
                            {
                                <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                    Best Value
                                </span>
                            }
                            else
                            {
                                <span></span>
                            }
                            <button type="button"
                                    @onclick="@(() => ToggleFlip(planItem.Id))"
                                    aria-expanded="@isFlipped.ToString().ToLower()"
                                    aria-controls="@($"flip-back-{planItem.Id}")"
                                    aria-label="@($"See extended details for {planItem.Name}")"
                                    class="group flex size-8 items-center justify-center rounded-full border bg-background text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground">
                                <LucideIconCn Name="rotate-cw" Size="14" Class="size-3.5 transition-transform duration-300 group-hover:rotate-45" />
                            </button>
                        </div>

                        <h3 class="mt-4 text-2xl font-bold tracking-tight">@planItem.Name</h3>
                        <p class="mt-1.5 min-h-[2.75rem] text-sm leading-relaxed text-muted-foreground">
                            @planItem.Tagline
                        </p>

                        @* Price *@
                        <div class="mt-5 flex h-12 items-baseline gap-1.5 sm:h-14">
                            <span class="text-4xl font-bold tracking-tight tabular-nums">$@price</span>
                            <span class="text-sm text-muted-foreground">/mo</span>
                        </div>
                        <p class="mt-1 h-4 text-xs text-muted-foreground">
                            @(_billing == "annually"
                                ? $"Billed annually at ${price * 12}/year"
                                : "Billed monthly, cancel anytime")
                        </p>

                        @* CTA *@
                        <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full">
                            @planItem.Cta
                        </ButtonCn>

                        @* Summary features *@
                        <div class="mt-6 flex-1">
                            <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                                @planItem.FrontHeadline
                            </p>
                            <ul class="mt-3 space-y-2.5">
                                @foreach (var feature in planItem.SummaryFeatures)
                                {
                                    <li class="flex items-start gap-2.5">
                                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                        <span class="text-sm font-medium text-foreground">@feature</span>
                                    </li>
                                }
                            </ul>
                        </div>

                        @* Flip hint *@
                        <button type="button"
                                @onclick="@(() => ToggleFlip(planItem.Id))"
                                class="mt-5 inline-flex items-center justify-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                            See extended details
                        </button>
                    </article>

                    @* BACK FACE *@
                    <article id="@($"flip-back-{planItem.Id}")"
                             class="@Cn.Merge("absolute inset-0 flex flex-col overflow-hidden rounded-2xl bg-muted p-6 sm:p-7", planItem.IsPopular ? "ring-2 ring-foreground/10" : "")"
                             style="backface-visibility:hidden;-webkit-backface-visibility:hidden;transform:rotateY(180deg)"
                             aria-hidden="@((!isFlipped).ToString().ToLower())">
                        @* Header row *@
                        <div class="flex h-7 items-start justify-between">
                            <span class="inline-flex items-center gap-1.5 rounded-full border bg-background px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                                Full details
                            </span>
                            <button type="button"
                                    @onclick="@(() => ToggleFlip(planItem.Id))"
                                    tabindex="@(isFlipped ? null : "-1")"
                                    aria-expanded="@isFlipped.ToString().ToLower()"
                                    aria-label="@($"Return to {planItem.Name} summary")"
                                    class="group flex size-8 items-center justify-center rounded-full border bg-background text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground">
                                <LucideIconCn Name="rotate-cw" Size="14" Class="size-3.5 -scale-x-100 transition-transform duration-300 group-hover:-rotate-45" />
                            </button>
                        </div>

                        <h3 class="mt-4 text-xl font-bold tracking-tight">@planItem.Name details</h3>

                        @* Full features *@
                        <div class="mt-4 flex-1 overflow-y-auto" role="region" aria-label="@($"{planItem.Name} full feature list")" tabindex="@(isFlipped ? "0" : "-1")">
                            <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                                @planItem.BackFullHeading
                            </p>
                            <ul class="mt-2.5 space-y-2">
                                @foreach (var feat in planItem.FullFeatures)
                                {
                                    <li class="flex items-start gap-2">
                                        <LucideIconCn Name="check" Size="14" Class="mt-0.5 size-3.5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                        <span class="text-xs font-medium leading-relaxed text-foreground">
                                            @feat
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>

                        @* SLA badge *@
                        <div class="mt-4 flex items-center gap-2 rounded-md border border-emerald-600/20 bg-emerald-500/5 px-3 py-2">
                            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-500" />
                            <p class="text-[11px] font-medium leading-tight text-foreground">
                                @planItem.Sla
                            </p>
                        </div>

                        @* Testimonial *@
                        <figure class="mt-3 rounded-md border bg-background/60 p-3">
                            <LucideIconCn Name="quote" Size="14" Class="mb-1 size-3.5 text-muted-foreground/40" />
                            <blockquote class="text-[11px] leading-relaxed text-foreground/90">
                                &ldquo;@planItem.TestimonialQuote&rdquo;
                            </blockquote>
                            <figcaption class="mt-2 flex items-center gap-2">
                                <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-foreground text-background">
                                    <span class="text-[9px] font-semibold">@planItem.TestimonialInitials</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-[10px] font-semibold text-foreground">
                                        @planItem.TestimonialAuthor
                                    </p>
                                    <p class="truncate text-[10px] text-muted-foreground">
                                        @planItem.TestimonialRole
                                    </p>
                                </div>
                            </figcaption>
                        </figure>
                    </article>
                </div>
            </div>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
