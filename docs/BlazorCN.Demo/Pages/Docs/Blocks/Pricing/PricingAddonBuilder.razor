@* ========================================
   Block: pricing-addon-builder
   Title: Pricing Addon Builder
   Description: Build-your-own pricing with a base plan and toggleable add-on features that dynamically update the total cost
   Long Description: Per-seat pricing with team size calculator
   Dependencies: LucideCheckCn, LucidePackageCn
   Source: original/blocks/pricing/pricing-addon-builder.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-4 gap-1.5">
                <LucidePackageCn Size="12" />
                Build Your Plan
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Pay only for what you need
            </h2>
            <p class="text-muted-foreground text-lg">
                Start with the essentials. Add features as your needs grow.
            </p>
        </div>

        <div class="mx-auto max-w-2xl space-y-6">
            @* Base plan *@
            <CardCn>
                <CardHeaderCn>
                    <div class="flex items-start justify-between">
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="text-lg font-semibold">Base Plan</h3>
                                <BadgeCn Variant="BadgeVariant.Secondary">Included</BadgeCn>
                            </div>
                            <p class="text-muted-foreground mt-1 text-sm">
                                Everything you need to get started
                            </p>
                        </div>
                        <div class="text-right">
                            <span class="text-2xl font-bold">$@_basePrice</span>
                            <span class="text-muted-foreground text-sm">/mo</span>
                        </div>
                    </div>
                </CardHeaderCn>
                <CardContentCn>
                    <ul class="grid gap-2 sm:grid-cols-2">
                        @foreach (var feature in _baseFeatures)
                        {
                            <li class="flex items-center gap-2">
                                <LucideCheckCn Size="16" Class="text-primary shrink-0" />
                                <span class="text-sm">@feature</span>
                            </li>
                        }
                    </ul>
                </CardContentCn>
            </CardCn>

            @* Add-ons *@
            <div class="space-y-2">
                <h3 class="text-sm font-semibold">Add-ons</h3>
                <CardCn>
                    <CardContentCn Class="divide-y p-0">
                        @foreach (var addon in _addons)
                        {
                            var a = addon;
                            var isEnabled = _enabled.Contains(a.Id);
                            <div class="flex items-center gap-4 px-4 py-3 sm:px-6">
                                <SwitchCn aria-label="@a.Name"
                                    Checked="@isEnabled"
                                    CheckedChanged="@(v => ToggleAddon(a.Id))" />
                                <div class="flex-1">
                                    <div class="text-sm font-medium">@a.Name</div>
                                    <div class="text-muted-foreground text-xs">@a.Description</div>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="text-sm font-semibold">+$@a.Price</span>
                                    <span class="text-muted-foreground text-xs">/mo</span>
                                </div>
                            </div>
                        }
                    </CardContentCn>
                </CardCn>
            </div>

            @* Total *@
            <CardCn>
                <CardContentCn Class="p-4 sm:p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-sm font-medium">Your plan</div>
                            <div class="text-muted-foreground text-xs">
                                Base + @_enabled.Count add-on@(_enabled.Count != 1 ? "s" : "")
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="flex items-baseline gap-1">
                                <span class="text-3xl font-bold tracking-tight">$@Total</span>
                                <span class="text-muted-foreground text-sm">/month</span>
                            </div>
                            <div class="text-muted-foreground text-xs">Billed monthly</div>
                        </div>
                    </div>

                    <SeparatorCn Class="my-4" />

                    <ButtonCn Size="ButtonSize.Lg" Class="w-full">
                        <a href="#">Start Free Trial</a>
                    </ButtonCn>

                    <p class="text-muted-foreground mt-3 text-center text-xs">
                        14-day free trial. Add or remove add-ons anytime. Cancel with one click.
                    </p>
                </CardContentCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private const int _basePrice = 29;

    private HashSet<string> _enabled = new(["priority-support", "custom-domains"]);

    private int AddonTotal => _addons.Where(a => _enabled.Contains(a.Id)).Sum(a => a.Price);
    private int Total => _basePrice + AddonTotal;

    private void ToggleAddon(string id)
    {
        if (!_enabled.Remove(id))
            _enabled.Add(id);
    }

    private static readonly string[] _baseFeatures =
    [
        "Unlimited projects", "10 GB storage", "Email support", "Core analytics", "Standard integrations",
    ];

    private record AddonItem(string Id, string Name, string Description, int Price);

    private static readonly AddonItem[] _addons =
    [
        new("advanced-analytics", "Advanced Analytics", "Custom dashboards, funnels, and retention reports", 15),
        new("priority-support", "Priority Support", "4-hour response SLA with dedicated agent", 19),
        new("custom-domains", "Custom Domains", "Use your own domain with SSL certificates", 9),
        new("team-seats", "Team Collaboration", "Up to 10 team members with role-based access", 25),
        new("api-access", "API & Webhooks", "REST API, GraphQL, and real-time webhooks", 12),
        new("white-label", "White Label", "Remove branding, custom logo, and colors", 29),
    ];
}
