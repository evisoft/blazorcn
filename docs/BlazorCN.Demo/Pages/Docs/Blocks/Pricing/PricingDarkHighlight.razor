@* ========================================
   Block: pricing-dark-highlight
   Title: Pricing Dark Highlight
   Description: Dark themed pricing section with accent glow effects, inverted card styling, and luminous highlighted plan
   Long Description: Cards with gradient border accents
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideSparklesCn
   Source: original/blocks/pricing/pricing-dark-highlight.tsx
   ======================================== *@

<section class="bg-zinc-950 py-16 text-white md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Class="mb-4 gap-1.5 border-zinc-700 bg-zinc-800/80 text-zinc-200 hover:bg-zinc-800">
                <LucideSparklesCn Class="h-3 w-3" Size="12" />
                Pricing
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Power up your workflow
            </h2>
            <p class="text-zinc-400 text-lg">Start free. Upgrade to unlock the full potential.</p>
        </div>

        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                <div class="@Cn.Merge("relative flex flex-col rounded-xl border p-6", plan.IsPopular ? "border-primary/50 bg-zinc-900 shadow-[0_0_40px_-12px] shadow-primary/20 ring-1 ring-primary/20 md:scale-105" : "border-zinc-800 bg-zinc-900/50")">
                    @if (plan.IsPopular)
                    {
                        <div class="absolute -top-3 right-4">
                            <BadgeCn Class="bg-primary text-primary-foreground">Most Popular</BadgeCn>
                        </div>
                    }

                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-white">@plan.Name</h3>
                        <div class="mt-3 flex items-baseline gap-1">
                            <span class="text-4xl font-bold tracking-tight text-white">$@plan.Price</span>
                            <span class="text-zinc-500 text-sm">@plan.Period</span>
                        </div>
                        <p class="mt-2 text-sm text-zinc-400">@plan.Description</p>
                    </div>

                    <ul class="mb-8 flex-1 space-y-3">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start gap-3">
                                <LucideCheckCn Class="@Cn.Merge("mt-0.5 h-4 w-4 shrink-0", plan.IsPopular ? "text-primary" : "text-zinc-500")" Size="16" />
                                <span class="text-sm text-zinc-300">@feature</span>
                            </li>
                        }
                    </ul>

                    <ButtonCn Class="@Cn.Merge("w-full gap-2", plan.IsPopular ? "" : "border-zinc-700 bg-zinc-800 text-zinc-200 hover:bg-zinc-700 hover:text-white")"
                              Size="ButtonSize.Lg"
                              Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                        @plan.Cta
                        @if (plan.IsPopular)
                        {
                            <LucideArrowRightCn Class="h-4 w-4" Size="16" />
                        }
                    </ButtonCn>
                </div>
            }
        </div>

        <p class="mt-8 text-center text-sm text-zinc-500">
            All plans include a 14-day free trial. No credit card required.
        </p>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, string Period, string Description, string[] Features, bool IsPopular, string Cta);

    private static readonly Plan[] _plans =
    [
        new("Hobby", 0, "forever", "Free for personal projects.", ["3 projects", "1 GB storage", "Community support", "Basic features"], false, "Get Started"),
        new("Pro", 39, "/month", "Full power for professionals.", ["Unlimited projects", "100 GB storage", "Priority support (4h SLA)", "Advanced features", "Custom domains", "API access", "Team (up to 10)"], true, "Start Free Trial"),
        new("Enterprise", 149, "/month", "For large-scale operations.", ["Everything in Pro", "Unlimited storage", "Dedicated support", "SSO & audit logs", "Custom SLA", "On-premise option"], false, "Contact Sales"),
    ];
}
