@* ============================================================
   Block: pricing-contract-length-slider
   Title: PricingContractLengthSlider
   Description: A continuous contract length slider pricing section for React and Next.js with a draggable slider from one month to twenty four months that live updates a NumberFlow animated monthly price discount percentage and total contract value plus a ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-contract-length-slider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Commit and save
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Longer term, lower rate
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            Drag the slider to pick your contract length and watch the monthly price drop as your
            commitment grows.
        </p>
    </div>

    @* Main card *@
    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        @* Hero price + badge *@
        <div class="relative px-6 pb-6 pt-7 sm:px-8 sm:pt-8">
            @* Badge slot *@
            <div class="flex h-6 items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    @(_months == 1 ? "Monthly rate" : $"{_months}-month rate")
                </span>
                <span class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-full bg-red-500 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm transition-opacity duration-300", _showBadge ? "opacity-100" : "opacity-0 pointer-events-none")"
                      aria-hidden="@(!_showBadge ? "true" : "false")">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    Best Savings
                </span>
            </div>

            @* Price row *@
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-6xl font-bold tracking-tight tabular-nums">
                    $@_monthlyPrice
                </span>
                <span class="text-lg font-medium text-muted-foreground">/mo</span>
                @if (_discount > 0)
                {
                    <span class="ml-auto inline-flex items-center rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-600 dark:text-emerald-500"
                          aria-live="polite">
                        −@_discount%
                    </span>
                }
            </div>

            @* Reference price *@
            @if (_discount > 0)
            {
                <p class="mt-1.5 text-xs text-muted-foreground">
                    Normally <span class="font-mono tabular-nums line-through">$@BasePriceDisplay</span>
                    /mo — save
                    <span class="font-semibold tabular-nums text-foreground">$@_savingsTotal</span>
                    over @_months months
                </p>
            }
            else
            {
                <p class="mt-1.5 text-xs text-muted-foreground">
                    Billed monthly, cancel anytime. Commit longer to unlock savings.
                </p>
            }
        </div>

        @* Slider block *@
        <div class="border-t border-foreground/10 px-6 pb-6 pt-6 sm:px-8">
            <div class="mb-2 flex items-baseline justify-between">
                <span class="text-xs font-medium text-muted-foreground">Contract length</span>
                <span class="font-mono text-xs tabular-nums text-muted-foreground">
                    @_months month@(_months == 1 ? "" : "s")
                </span>
            </div>

            <SliderCn Value="@((double)_months)"
                      ValueChanged="@((double v) => { _months = (int)v; })"
                      Min="1" Max="24" Step="1"
                      Class="mt-2"
                      aria-label="Contract length in months" />

            @* Savings fill bar *@
            <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-foreground/10">
                <div class="h-full rounded-full bg-foreground transition-all duration-300"
                     style="@($"width:{(_discount * 100 / MaxDiscountPct)}%")">
                </div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-[10px] uppercase tracking-wider text-muted-foreground">
                    Savings unlocked
                </span>
                <span class="font-mono text-[10px] tabular-nums text-muted-foreground">
                    @_discount / @MaxDiscountPct%
                </span>
            </div>

            @* Anchor ticks — desktop *@
            <div class="relative mt-5 hidden h-8 sm:block">
                @foreach (var anchor in _anchors)
                {
                    var anch = anchor;
                    var leftPct = (anch.Months - 1) * 100 / (24 - 1);
                    var isActive = anch.Months == _months;
                    <button type="button"
                            @onclick="@(() => _months = anch.Months)"
                            aria-label="@($"Set contract length to {anch.Sublabel}")"
                            class="@Cn.Merge("absolute flex -translate-x-1/2 flex-col items-center transition-colors focus:outline-none focus-visible:text-foreground", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            style="@($"left:{leftPct}%")">
                        <span class="font-mono text-[10px] tabular-nums">@anch.Label</span>
                        <span class="mt-0.5 text-[9px] uppercase tracking-wider">@anch.Sublabel</span>
                    </button>
                }
            </div>

            @* Mobile anchors — compact *@
            <div class="mt-4 flex items-center justify-between sm:hidden">
                @foreach (var anchor in _mobileAnchors)
                {
                    var anch = anchor;
                    var isActive = anch.Months == _months;
                    <button type="button"
                            @onclick="@(() => _months = anch.Months)"
                            class="@Cn.Merge("font-mono text-[10px] tabular-nums transition-colors", isActive ? "text-foreground" : "text-muted-foreground")">
                        @anch.Label
                    </button>
                }
            </div>
        </div>

        @* Stats grid *@
        <div class="grid grid-cols-1 border-t border-foreground/10 sm:grid-cols-3 sm:divide-x sm:divide-foreground/10">
            <div class="px-6 py-5 sm:px-5">
                <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Monthly
                </p>
                <div class="mt-1.5 flex items-baseline gap-1">
                    <span class="text-xl font-bold tabular-nums">$@_monthlyPrice</span>
                    <span class="text-xs text-muted-foreground">/mo</span>
                </div>
            </div>
            <div class="border-t border-foreground/10 px-6 py-5 sm:border-t-0 sm:px-5">
                <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Total contract
                </p>
                <div class="mt-1.5 flex items-baseline gap-1">
                    <span class="text-xl font-bold tabular-nums">$@_totalContract</span>
                    <span class="text-xs text-muted-foreground">/ @(_months)mo</span>
                </div>
            </div>
            <div class="border-t border-foreground/10 px-6 py-5 sm:border-t-0 sm:px-5">
                <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                    You save
                </p>
                <div class="mt-1.5 flex items-baseline gap-1">
                    <span class="@Cn.Merge("text-xl font-bold tabular-nums", _savingsTotal > 0 ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground")">
                        $@_savingsTotal
                    </span>
                    <span class="text-xs text-muted-foreground">total</span>
                </div>
            </div>
        </div>

        @* Features + CTA *@
        <div class="border-t border-foreground/10 bg-background/40 px-6 pb-7 pt-6 sm:px-8">
            <ul class="space-y-2.5">
                @foreach (var feature in _features)
                {
                    <li class="flex items-start gap-2.5">
                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        <span class="text-sm font-medium text-foreground">@feature</span>
                    </li>
                }
            </ul>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-6 w-full sm:w-[230px]">
                Lock in @(_months)-month rate
            </ButtonCn>
        </div>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime during trial.
    </p>
</section>

@code {
    private const int MinMonths = 1;
    private const int MaxMonths = 24;
    private const int BasePrice = 79;
    private const int MaxDiscountPct = 35;
    private const int BasePriceDisplay = BasePrice;

    private record Anchor(int Months, string Label, string Sublabel);

    private static readonly Anchor[] _anchors =
    [
        new(1, "1 mo", "Monthly"),
        new(6, "6 mo", "Quarterly"),
        new(12, "12 mo", "Annual"),
        new(18, "18 mo", "Extended"),
        new(24, "24 mo", "Multi-year"),
    ];

    private static readonly Anchor[] _mobileAnchors =
    [
        new(1, "1 mo", "Monthly"),
        new(12, "12 mo", "Annual"),
        new(24, "24 mo", "Multi-year"),
    ];

    private static readonly string[] _features =
    [
        "Unlimited projects and collaborators",
        "Priority email support with 4h SLA",
        "99.95% uptime SLA with credits",
        "Advanced analytics and audit logs",
        "Single sign-on and role-based access",
    ];

    private int _months = 12;

    private int _discount
    {
        get
        {
            if (_months <= MinMonths) return 0;
            var t = (double)(_months - MinMonths) / (MaxMonths - MinMonths);
            var eased = Math.Pow(t, 0.75);
            return (int)Math.Round(eased * MaxDiscountPct);
        }
    }

    private int _monthlyPrice => (int)Math.Round(BasePrice * (1.0 - _discount / 100.0));
    private int _totalContract => _monthlyPrice * _months;
    private int _savingsTotal => BasePrice * _months - _totalContract;
    private bool _showBadge => _months >= 12;
}
