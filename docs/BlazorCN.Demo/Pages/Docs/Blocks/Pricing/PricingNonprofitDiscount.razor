@* ============================================================
   Block: pricing-nonprofit-discount
   Title: PricingNonprofitDiscount
   Description: A nonprofit discount three-column pricing section for React and Next.js with Starter, Growth, and Impact plan cards showing strikethrough original prices, inline emerald 50% discount badges, ShadcnioButton apply CTAs, nonprofit-specific features like donor management, grant tracking, and volunteer coordination, red Best Value badge on the Impact plan, and 501(c)(3) verification trust footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-nonprofit-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <span class="inline-flex items-center gap-2 rounded-full border bg-muted/60 px-3.5 py-1.5">
            <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
            <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                Nonprofit &amp; Education
            </span>
        </span>
        <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
            @DiscountPercent% off, for the work that matters
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            Registered nonprofits, NGOs, and accredited educational institutions qualify for
            half-price access to every plan. No feature restrictions, no expiration date.
        </p>
    </div>

    @* Plan grid *@
    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var savings = plan.OriginalMonthly - plan.DiscountedMonthly;
            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl bg-muted p-6", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                @* Reserved badge slot on every card *@
                <div class="mb-4 flex h-7 items-start">
                    @if (plan.IsPopular)
                    {
                        <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>

                <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                <p class="mt-2 min-h-[2.75rem] text-sm leading-relaxed text-muted-foreground">
                    @plan.Description
                </p>

                @* Price with strikethrough + discount — fixed height *@
                <div class="mt-5">
                    <div class="flex h-12 items-baseline gap-2.5 sm:h-14">
                        <s aria-hidden="true" class="text-lg text-muted-foreground tabular-nums">
                            $@plan.OriginalMonthly
                        </s>
                        <span class="text-5xl font-bold tracking-tight tabular-nums">
                            $@plan.DiscountedMonthly
                        </span>
                        <span class="text-base font-bold text-emerald-600 dark:text-emerald-500">
                            -@DiscountPercent%
                        </span>
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground">
                        per month, you save <span class="font-semibold text-foreground">$@savings</span> with nonprofit
                        pricing
                    </p>
                </div>

                @* CTA *@
                <div class="mt-6">
                    <ButtonCn Class="w-full">@plan.Cta</ButtonCn>
                </div>

                @* Features *@
                <div class="mt-6 flex-1">
                    <p class="text-sm font-medium text-foreground">@plan.FeatureHeading</p>
                    <ul class="mt-4 space-y-3">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start justify-between gap-2">
                                <span class="flex items-start gap-2.5">
                                    <LucideIconCn Name="check" Size="20" StrokeWidth="3" Class="mt-0.5 size-5 shrink-0 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                    <span class="text-sm font-medium leading-snug text-foreground">
                                        @feature.Name
                                    </span>
                                </span>
                                @if (!string.IsNullOrEmpty(feature.Tooltip))
                                {
                                    <TooltipCn>
                                        <TooltipTriggerCn Tabbable="false">
                                            <button type="button" aria-label="@($"More info about {feature.Name}")">
                                                <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 cursor-help text-muted-foreground/40" aria-hidden="true" />
                                            </button>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="max-w-[220px]">
                                            <p class="text-xs">@feature.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust footer *@
    <div class="mt-8 space-y-1 text-center">
        <p class="text-xs text-muted-foreground">
            Verification via .org domain or 501(c)(3) documentation. Approved within 2 business days.
        </p>
        <p class="text-xs text-muted-foreground">
            14-day free trial on all plans. No credit card required until verification clears.
        </p>
    </div>
</section>

@code {
    private const int DiscountPercent = 50;

    private record PlanFeature(string Name, string? Tooltip = null);

    private record NonprofitPlan(
        string Id,
        string Name,
        string Description,
        int OriginalMonthly,
        int DiscountedMonthly,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta,
        bool IsPopular);

    private static readonly NonprofitPlan[] _plans =
    [
        new(
            Id: "starter",
            Name: "Starter",
            Description: "For small nonprofits and grassroots organizations.",
            OriginalMonthly: 29,
            DiscountedMonthly: 15,
            FeatureHeading: "What's included:",
            Features:
            [
                new("Up to 500 donor contacts"),
                new("Basic donation tracking"),
                new("1K monthly email sends",
                    "Send donation receipts, newsletters, and event invitations to your donor list."),
                new("Volunteer sign-up forms"),
                new("3 events per month with ticketing"),
            ],
            Cta: "Apply for nonprofit pricing",
            IsPopular: false),

        new(
            Id: "growth",
            Name: "Growth",
            Description: "For growing nonprofits with active fundraising.",
            OriginalMonthly: 79,
            DiscountedMonthly: 40,
            FeatureHeading: "Everything in Starter, plus:",
            Features:
            [
                new("Up to 10K donor contacts"),
                new("Grant tracking and pipeline",
                    "Track grant applications from submission through award with deadline reminders and reporting templates."),
                new("Recurring donation management"),
                new("Volunteer coordination dashboard"),
                new("Unlimited events with check-in"),
                new("QuickBooks and Xero integration"),
            ],
            Cta: "Apply for nonprofit pricing",
            IsPopular: true),

        new(
            Id: "impact",
            Name: "Impact",
            Description: "For established nonprofits managing complex programs.",
            OriginalMonthly: 199,
            DiscountedMonthly: 100,
            FeatureHeading: "Everything in Growth, plus:",
            Features:
            [
                new("Unlimited donor contacts"),
                new("Multi-program fund accounting",
                    "Track restricted and unrestricted funds across programs with automated allocation and reporting."),
                new("Impact measurement and reporting"),
                new("Board portal with document sharing"),
                new("Multi-org and chapter management",
                    "Manage chapters, affiliates, or fiscal sponsorships from a single admin console."),
                new("Dedicated nonprofit success manager"),
            ],
            Cta: "Apply for nonprofit pricing",
            IsPopular: false),
    ];
}
