@* ============================================================
   Block: pricing-flat-rate
   Title: PricingFlatRate
   Description: A flat rate single-plan pricing section for React and Next.js with marketing headline, large NumberFlow animated price, PillTabs billing toggle, four-column feature category grid with emerald checkmarks, ShadcnioButton CTA, and money-back guarantee built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-flat-rate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            One price, everything included
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            No tiers. No limits. No surprises. One simple plan with every feature for your entire
            team.
        </p>

        @* Billing toggle *@
        <div class="mt-6 flex items-center justify-center gap-1">
            <div class="inline-flex rounded-full bg-muted p-1 text-sm" role="tablist" aria-label="Billing period" id="flat-rate-billing">
                @foreach (var option in _billingOptions)
                {
                    var opt = option;
                    <button role="tab"
                            aria-selected="@(_billing == opt ? "true" : "false")"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", _billing == opt ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => SetBilling(opt))">
                        @(opt == "monthly" ? "Monthly" : "Annually")
                    </button>
                }
            </div>
        </div>
    </div>

    @* Hero price + CTA card *@
    <div class="mt-8 overflow-hidden rounded-2xl bg-muted p-6 sm:p-10">
        <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-center">
            @* Left: name + price *@
            <div>
                <div class="flex items-center gap-3">
                    <h3 class="text-2xl font-bold tracking-tight">Everything Plan</h3>
                    <span class="rounded-full border bg-background px-2.5 py-0.5 text-[11px] font-semibold tabular-nums text-foreground">
                        @TotalFeatures features
                    </span>
                </div>
                <p class="mt-2 text-sm text-muted-foreground">
                    Flat rate, no surprises. Every feature, every integration, every seat.
                </p>

                <div class="mt-5 flex h-14 items-baseline gap-1.5 sm:h-16">
                    <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">
                        $@DisplayPrice
                    </span>
                    <span class="text-base text-muted-foreground">/month</span>
                </div>
                <p class="mt-2 text-xs text-muted-foreground">
                    @if (_billing == "annually")
                    {
                        @($"Billed annually at ${AnnualPrice * 12}/year · Save ${(MonthlyPrice - AnnualPrice) * 12}")
                    }
                    else
                    {
                        @("Billed monthly · Cancel anytime")
                    }
                </p>
            </div>

            @* Right: CTA *@
            <div class="flex flex-col items-stretch gap-3 sm:items-end">
                <ButtonCn Class="w-full sm:w-[260px]">Start 14-day free trial</ButtonCn>
                <p class="text-center text-xs text-muted-foreground sm:text-right">
                    No credit card required
                </p>
            </div>
        </div>
    </div>

    @* Feature categories grid *@
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var category in _featureCategories)
        {
            var cat = category;
            <div class="rounded-2xl bg-muted p-5">
                <div class="flex items-center gap-2.5">
                    <span class="flex size-7 items-center justify-center rounded-lg border bg-background">
                        <LucideIconCn Name="@cat.IconName" Size="14" Class="size-3.5" aria-hidden="true" />
                    </span>
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        @cat.Name
                    </p>
                </div>
                <ul class="mt-4 space-y-2.5">
                    @foreach (var feature in cat.Features)
                    {
                        <li class="flex items-start gap-2 text-sm font-medium text-foreground">
                            <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                            <span class="leading-snug">@feature</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        30-day money-back guarantee · No setup fees · Cancel anytime
    </p>
</section>

@code {
    private const int MonthlyPrice = 49;
    private const int AnnualPrice = 39;

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private string _billing = "monthly";

    private int DisplayPrice => _billing == "monthly" ? MonthlyPrice : AnnualPrice;

    private static int TotalFeatures => _featureCategories.Sum(c => c.Features.Length);

    private void SetBilling(string value)
    {
        _billing = value;
    }

    private record FeatureCategory(string Name, string IconName, string[] Features);

    private static readonly FeatureCategory[] _featureCategories =
    [
        new("Core", "zap",
        [
            "Unlimited projects",
            "Unlimited workspaces",
            "Unlimited storage with CDN",
            "Unlimited API requests",
        ]),
        new("Collaboration", "users-round",
        [
            "Real-time multiplayer editing",
            "Shared workspaces with permissions",
            "Threaded comments and mentions",
            "Full version history with restore",
        ]),
        new("Integrations", "code",
        [
            "Slack, Discord and Teams",
            "GitHub, GitLab and Bitbucket",
            "Webhooks and REST API access",
            "Custom OAuth2 integrations",
        ]),
        new("Security", "shield-check",
        [
            "SAML SSO with directory sync",
            "Audit logs (1-year retention)",
            "Priority email and chat support",
            "99.95% uptime SLA",
        ]),
    ];
}
