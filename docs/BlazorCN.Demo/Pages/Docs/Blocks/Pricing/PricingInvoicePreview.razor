@* ============================================================
   Block: pricing-invoice-preview
   Title: PricingInvoicePreview
   Description: A categorized totals comparison table pricing section for React and Next.js with grouped line items, popular column tint, Best Value badge, and totals row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-invoice-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Transparent Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Every line on your invoice
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            See exactly where every dollar goes. No hidden fees, no surprises, no bait-and-switch when
            the renewal hits.
        </p>
    </div>

    @* Comparison table card *@
    <div class="mt-8 overflow-hidden rounded-2xl bg-muted">
        <div class="overflow-x-auto">
            <TableCn Class="w-full min-w-[950px] table-fixed">
                <TableHeaderCn>
                    <TableRowCn Class="border-b-0 hover:bg-transparent">
                        <TableHeadCn Class="w-[260px] py-6 pl-6 align-bottom">
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                Cost component
                            </p>
                            <p class="mt-1 text-xs text-muted-foreground">Itemized monthly invoice</p>
                        </TableHeadCn>
                        @foreach (var plan in _plans)
                        {
                            <TableHeadCn Class="@Cn.Merge("w-[230px] py-6 px-4 text-center align-bottom", plan.IsPopular ? "bg-background" : "")">
                                <div class="flex flex-col items-center gap-1.5">
                                    @if (plan.IsPopular)
                                    {
                                        <span class="rounded-full bg-red-500 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                            Best Value
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="h-[22px]" aria-hidden="true"></span>
                                    }
                                    <p class="text-base font-bold tracking-tight text-foreground">
                                        @plan.Name
                                    </p>
                                    <p class="text-[11px] text-muted-foreground">@plan.Tagline</p>
                                </div>
                            </TableHeadCn>
                        }
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var category in _categories)
                    {
                        var items = _lineItems.Where(i => i.Category == category).ToList();
                        <TableRowCn Class="border-y bg-foreground/[0.03] hover:bg-foreground/[0.03]">
                            <TableCellCn Colspan="@(1 + _plans.Length)" Class="py-2 pl-6 text-[10px] font-extrabold uppercase tracking-wider text-muted-foreground">
                                @category
                            </TableCellCn>
                        </TableRowCn>
                        @foreach (var item in items)
                        {
                            <TableRowCn Class="border-b hover:bg-transparent">
                                <TableCellCn Class="py-4 pl-6">
                                    <p class="text-sm font-semibold text-foreground">@item.Label</p>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@item.Unit</p>
                                </TableCellCn>
                                @foreach (var plan in _plans)
                                {
                                    var lineVal = item.Values.GetValueOrDefault(plan.Id);
                                    var isFalse = lineVal is LineValue { IsFalse: true };
                                    <TableCellCn Class="@Cn.Merge("px-4 py-4 text-center text-sm font-medium", plan.IsPopular ? "bg-background text-foreground" : "text-muted-foreground", isFalse ? "text-muted-foreground/40" : "")">
                                        @RenderLineValue(lineVal)
                                    </TableCellCn>
                                }
                            </TableRowCn>
                        }
                    }

                    @* Total row *@
                    <TableRowCn Class="border-t-2 border-foreground/20 hover:bg-transparent">
                        <TableCellCn Class="py-5 pl-6">
                            <p class="text-sm font-bold uppercase tracking-wider">Monthly total</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                Billed on the 1st of each month
                            </p>
                        </TableCellCn>
                        @foreach (var plan in _plans)
                        {
                            <TableCellCn Class="@Cn.Merge("px-4 py-5 text-center", plan.IsPopular ? "bg-background" : "")">
                                <div class="flex items-baseline justify-center gap-0.5">
                                    <span class="text-3xl font-bold tracking-tight tabular-nums sm:text-4xl">
                                        $@plan.Total
                                    </span>
                                    <span class="text-xs text-muted-foreground">/mo</span>
                                </div>
                            </TableCellCn>
                        }
                    </TableRowCn>

                    @* CTA row *@
                    <TableRowCn Class="hover:bg-transparent">
                        <TableCellCn Class="py-5 pl-6">
                            <p class="text-xs text-muted-foreground">
                                All plans include a 14-day free trial.
                            </p>
                        </TableCellCn>
                        @foreach (var plan in _plans)
                        {
                            <TableCellCn Class="@Cn.Merge("px-4 py-5", plan.IsPopular ? "bg-background" : "")">
                                <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                                    @plan.Cta
                                </ButtonCn>
                            </TableCellCn>
                        }
                    </TableRowCn>
                </TableBodyCn>
            </TableCn>
        </div>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Prices in USD. No setup fees. Annual billing saves up to 20% on every line item.
    </p>
</section>

@code {
    private class LineValue
    {
        public bool IsFalse { get; init; }
        public bool IsTrue { get; init; }
        public string? Text { get; init; }

        public static LineValue False => new() { IsFalse = true };
        public static LineValue True => new() { IsTrue = true };
        public static LineValue FromText(string text) => new() { Text = text };
    }

    private RenderFragment RenderLineValue(LineValue? value)
    {
        if (value is null || value.IsFalse)
        {
            return @<LucideIconCn Name="minus" Size="16" Class="mx-auto size-4 text-muted-foreground/30" aria-hidden="true" />;
        }
        if (value.IsTrue)
        {
            return @<LucideIconCn Name="check" Size="20" StrokeWidth="3" Class="mx-auto size-5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />;
        }
        return @<span class="tabular-nums">@value.Text</span>;
    }

    private record PlanColumn(string Id, string Name, string Tagline, int Total, string Cta, bool IsPopular);

    private record LineItemRow(string Category, string Label, string Unit, Dictionary<string, LineValue> Values);

    private static readonly PlanColumn[] _plans =
    [
        new("starter", "Starter", "For solo builders", 29, "Get started", false),
        new("team", "Team", "For growing squads", 179, "Start 14-day trial", true),
        new("business", "Business", "For scaling orgs", 499, "Contact sales", false),
    ];

    private static readonly string[] _categories = ["Platform", "Add-ons", "Support"];

    private static readonly LineItemRow[] _lineItems =
    [
        new("Platform", "Platform fee", "Flat monthly fee", new()
        {
            ["starter"] = LineValue.FromText("$29 /mo"),
            ["team"] = LineValue.FromText("$49 /mo"),
            ["business"] = LineValue.FromText("$149 /mo"),
        }),
        new("Platform", "Team seats", "Per seat per month", new()
        {
            ["starter"] = LineValue.FromText("1 included"),
            ["team"] = LineValue.FromText("10 × $8 = $80"),
            ["business"] = LineValue.FromText("25 × $10 = $250"),
        }),
        new("Add-ons", "Storage", "Distributed across CDN", new()
        {
            ["starter"] = LineValue.FromText("5GB included"),
            ["team"] = LineValue.FromText("100GB ($25 /mo)"),
            ["business"] = LineValue.FromText("1TB ($50 /mo)"),
        }),
        new("Add-ons", "Bandwidth", "Outbound transfer", new()
        {
            ["starter"] = LineValue.FromText("10GB included"),
            ["team"] = LineValue.FromText("200GB included"),
            ["business"] = LineValue.FromText("Unlimited"),
        }),
        new("Add-ons", "Custom domains", "Verified TLS-secured", new()
        {
            ["starter"] = LineValue.False,
            ["team"] = LineValue.FromText("3 included"),
            ["business"] = LineValue.FromText("Unlimited"),
        }),
        new("Support", "Support tier", "Channel and SLA", new()
        {
            ["starter"] = LineValue.FromText("Community"),
            ["team"] = LineValue.FromText("Priority email ($25 /mo)"),
            ["business"] = LineValue.FromText("Dedicated CSM ($50 /mo)"),
        }),
        new("Support", "Uptime SLA", "Guaranteed availability", new()
        {
            ["starter"] = LineValue.FromText("99.5%"),
            ["team"] = LineValue.FromText("99.9%"),
            ["business"] = LineValue.FromText("99.99%"),
        }),
    ];
}
