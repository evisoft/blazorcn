@* ============================================================
   Block: pricing-region-pricing
   Title: PricingRegionPricing
   Description: A region-based pricing section for React and Next.js with tabbed region selector for Americas, Europe, and Asia-Pacific showing local currency NumberFlow animated prices, region-specific compliance features, and three plan cards per region with PillTabs navigation, ShadcnioButton CTAs, emerald checkmarks, and red Best Value badge built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-region-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Global Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pricing localized to your region
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Same product, same features, fair prices for every market. Switch your region to see local
            currency, data centers, and applicable compliance.
        </p>

        @* Region tabs + meta *@
        <div class="mt-7 flex flex-col items-center gap-3">
            @* PillTabs — rendered as inline tab buttons *@
            <div class="inline-flex items-center rounded-full bg-muted p-1 text-muted-foreground" role="tablist" aria-label="Pricing region">
                @foreach (var key in _regionKeys)
                {
                    var rKey = key;
                    <button role="tab"
                            aria-selected="@(_activeRegion == rKey ? "true" : "false")"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _activeRegion == rKey ? "bg-background text-foreground shadow-sm" : "hover:text-foreground")"
                            @onclick="@(() => _activeRegion = rKey)">
                        @_regions[rKey].Label
                    </button>
                }
            </div>
            <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="globe" Size="12" Class="size-3" />
                Prices shown in @_regions[_activeRegion].CurrencyCode · Data centers: @_regions[_activeRegion].DataCenter
            </p>
        </div>
    </div>

    @* Plan grid *@
    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
        @foreach (var plan in _regions[_activeRegion].Plans)
        {
            var p = plan;
            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl bg-muted p-6 sm:p-7", p.IsPopular ? "order-first ring-2 ring-foreground/10 md:order-none" : "")">
                @* Reserved badge slot — rendered on every card for Y-alignment *@
                <div class="mb-4 flex h-7 items-start">
                    @if (p.IsPopular)
                    {
                        <span class="inline-block rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>

                @* Plan header *@
                <h3 class="text-2xl font-bold tracking-tight">@p.Name</h3>
                <p class="mt-1.5 min-h-[2.75rem] text-sm text-muted-foreground leading-relaxed">
                    @p.Description
                </p>

                @* Price *@
                <div class="mt-5 flex h-12 items-baseline gap-1.5 sm:h-14">
                    @if (p.Price.HasValue)
                    {
                        <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                            @(_regions[_activeRegion].Currency == "EUR" ? "€" : "$")@p.Price
                        </span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    }
                    else
                    {
                        <div>
                            <span class="text-4xl font-bold tracking-tight sm:text-5xl">Custom</span>
                            <p class="mt-1 text-xs text-muted-foreground">Talk to our sales team</p>
                        </div>
                    }
                </div>

                @* CTA *@
                <ButtonCn Class="mt-6 w-full">@p.Cta</ButtonCn>

                @* Features *@
                <div class="mt-7">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        @p.FeatureHeading
                    </p>
                    <ul class="mt-4 space-y-3">
                        @foreach (var feature in p.Features)
                        {
                            <li class="flex items-start gap-2.5 text-sm font-medium text-foreground">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                <span>@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        14-day free trial on all plans · No credit card required · Prices exclude local taxes
    </p>
</section>

