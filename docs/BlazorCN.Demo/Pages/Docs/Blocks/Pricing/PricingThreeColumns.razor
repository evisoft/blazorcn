@* ========================================
   Block: pricing-three-columns
   Title: Pricing Three Columns
   Description: Three column pricing cards with feature lists, popular plan highlight, and call-to-action buttons for React SaaS pricing pages
   Long Description: Pricing with billing period switch and savings badge
   Dependencies: LucideCheckCn
   Source: original/blocks/pricing/pricing-three-columns.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Class="mb-4" Variant="BadgeVariant.Secondary">Pricing</BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Simple, transparent pricing
            </h2>
            <p class="text-muted-foreground text-lg">
                No hidden fees. No surprises. Pick a plan that fits your needs and scale as you grow.
            </p>
        </div>

        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                <CardCn Class="@Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20 md:scale-105" : "border-border")">
                    @if (plan.IsPopular)
                    {
                        <div class="absolute -top-3 right-4">
                            <BadgeCn>Most Popular</BadgeCn>
                        </div>
                    }
                    <CardHeaderCn Class="pb-4">
                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                        <div class="mt-2 flex items-baseline gap-1">
                            <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                            @if (plan.Price > 0)
                            {
                                <span class="text-muted-foreground text-sm">/month</span>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-sm">forever</span>
                            }
                        </div>
                        <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                    </CardHeaderCn>
                    <CardContentCn Class="flex-1">
                        <ul class="space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Class="text-primary mt-0.5 h-4 w-4 shrink-0" Size="16" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </CardContentCn>
                    <CardFooterCn Class="pt-4">
                        <ButtonCn Class="w-full" Size="ButtonSize.Lg"
                                  Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                            @plan.Cta
                        </ButtonCn>
                    </CardFooterCn>
                </CardCn>
            }
        </div>

        <p class="text-muted-foreground mt-8 text-center text-sm">
            All plans include a 14-day free trial. No credit card required.
        </p>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, string Description, string[] Features, bool IsPopular, string Cta);

    private static readonly Plan[] _plans =
    [
        new("Starter", 0, "Everything you need to get started with your first project.", ["Up to 3 projects", "1 GB storage", "Community support", "Basic analytics", "48-hour response time"], false, "Get Started Free"),
        new("Pro", 29, "For growing teams that need more power and flexibility.", ["Unlimited projects", "50 GB storage", "Priority email support", "Advanced analytics", "Custom domains", "Team collaboration", "API access"], true, "Start Free Trial"),
        new("Enterprise", 99, "Advanced features for organizations at scale.", ["Everything in Pro", "Unlimited storage", "Dedicated account manager", "SSO authentication", "Custom integrations", "SLA guarantee", "Audit logs", "Priority phone support"], false, "Contact Sales"),
    ];
}
