@* ============================================================
   Block: pricing-currency-select
   Title: PricingCurrencySelect
   Description: A three-column pricing section with currency selector for React and Next.js featuring PillTabs billing toggle, shadcn Select for USD EUR GBP and JPY currencies, NumberFlow animated localized prices, three plan cards with red Best Value badge on Pro tier, ShadcnioButton CTAs, emerald checkmarks, and trust text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-currency-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <TooltipProviderCn Delay="200">
        @* Header *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Pricing
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Simple pricing, global reach
            </h2>
            <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
                Transparent pricing that scales with your team. Pay in your local currency with no
                hidden conversion fees.
            </p>

            @* Controls: PillTabs billing + currency Select *@
            <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
                @* PillTabs billing toggle — rendered as styled buttons *@
                <div class="flex h-10 items-center rounded-full border border-muted bg-muted/50 p-1 gap-1">
                    @foreach (var tab in _billingOptions)
                    {
                        var billingTab = tab;
                        <button type="button"
                                @onclick="@(() => _billing = billingTab)"
                                class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == billingTab ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                            @(billingTab == "monthly" ? "Monthly" : "Annually")
                        </button>
                    }
                </div>
                <SelectCn Value="@_currencyCode" ValueChanged="@((string v) => _currencyCode = v)">
                    <SelectTriggerCn aria-label="Select currency" Class="h-10 w-[140px] rounded-full border-muted bg-muted/50">
                        <LucideIconCn Name="globe" Size="16" Class="mr-1.5 size-4 text-muted-foreground" />
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var cur in _currencies)
                        {
                            var c = cur;
                            <SelectItemCn Value="@c.Code">
                                <span class="font-medium">@c.Symbol</span>
                                <span class="ml-2 text-muted-foreground">@c.Code</span>
                            </SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Plan grid *@
        <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-stretch">
            @foreach (var plan in _plans)
            {
                var currentPlan = plan;
                var currency = _currencies.FirstOrDefault(c => c.Code == _currencyCode) ?? _currencies[0];
                var usdPrice = _billing == "monthly" ? currentPlan.MonthlyUsd : currentPlan.AnnualUsd;
                var localizedPrice = ConvertPrice(usdPrice, currency);
                <article class="@Cn.Merge("relative flex flex-col overflow-hidden rounded-2xl bg-muted p-6", currentPlan.IsPopular ? "ring-2 ring-foreground/10" : "")">
                    @* Best Value badge *@
                    @if (currentPlan.IsPopular)
                    {
                        <div class="absolute right-5 top-5">
                            <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        </div>
                    }

                    @* Plan name *@
                    <h3 class="text-2xl font-bold tracking-tight">@currentPlan.Name</h3>
                    <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">
                        @currentPlan.Description
                    </p>

                    @* Price *@
                    <div class="mt-6">
                        <div class="flex min-h-[48px] items-baseline gap-1.5">
                            <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                                @($"{currency.Symbol}{localizedPrice}")
                            </span>
                            <span class="text-sm font-medium text-muted-foreground">/month</span>
                        </div>
                        <p class="mt-1.5 min-h-[18px] text-xs font-medium text-muted-foreground">
                            @(_billing == "annually"
                                ? $"Billed annually in {currency.Code}"
                                : $"Prices in {currency.Code}, taxes excluded")
                        </p>
                    </div>

                    @* CTA *@
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full">
                        @currentPlan.Cta
                    </ButtonCn>

                    @* Features *@
                    <div class="mt-6 flex-1 border-t border-border/60 pt-5">
                        <p class="text-sm font-semibold">@currentPlan.FeatureHeading</p>
                        <ul class="mt-3.5 space-y-2.5">
                            @foreach (var feature in currentPlan.Features)
                            {
                                var feat = feature;
                                <li class="flex items-start justify-between gap-3">
                                    <span class="flex items-start gap-2.5">
                                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" aria-hidden="true" />
                                        <span class="text-sm font-medium leading-snug text-foreground">
                                            @feat.Name
                                        </span>
                                    </span>
                                    @if (!string.IsNullOrEmpty(feat.Tooltip))
                                    {
                                        <TooltipCn>
                                            <TooltipTriggerCn Tabbable="false">
                                                <button type="button"
                                                        aria-label="@($"More info about {feat.Name}")"
                                                        class="mt-0.5">
                                                    <LucideIconCn Name="info" Size="14" Class="size-3.5 shrink-0 cursor-help text-muted-foreground/40" />
                                                </button>
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[220px]" Align="FloatingAlign.Center">
                                                <p class="text-xs">@feat.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>

        @* Trust text *@
        <p class="mt-8 text-center text-xs text-muted-foreground">
            All plans include a 14-day free trial. No credit card required. Prices in @(_currencies.FirstOrDefault(c => c.Code == _currencyCode)?.Code ?? "USD")
            exclude local taxes.
        </p>
    </TooltipProviderCn>
</section>

@code {
    private string _billing = "monthly";
    private string _currencyCode = "USD";

    private readonly string[] _billingOptions = ["monthly", "annually"];

    private record CurrencyItem(string Code, string Symbol, double Rate, string Locale, int FractionDigits);

    private record PlanFeatureItem(string Name, string Tooltip = "");

    private record PlanItem(
        string Id,
        string Name,
        string Description,
        int MonthlyUsd,
        int AnnualUsd,
        string FeatureHeading,
        PlanFeatureItem[] Features,
        string Cta,
        bool IsPopular);

    private readonly CurrencyItem[] _currencies =
    [
        new("USD", "$", 1.0, "en-US", 0),
        new("EUR", "€", 0.92, "de-DE", 0),
        new("GBP", "£", 0.79, "en-GB", 0),
        new("JPY", "¥", 149.5, "ja-JP", 0),
    ];

    private readonly PlanItem[] _plans =
    [
        new("starter", "Starter", "For individuals and small projects getting started.",
            19, 15, "What's included:",
            [
                new("Up to 3 projects"),
                new("5GB storage with CDN"),
                new("Community support", "Access to community forums and knowledge base with best-effort response times."),
                new("Basic usage analytics"),
                new("Single-user workspace"),
            ],
            "Get started", false),
        new("pro", "Pro", "For growing teams that need collaboration and scale.",
            49, 39, "Everything in Starter, plus:",
            [
                new("Unlimited projects"),
                new("100GB storage with global CDN", "Content served from 50+ edge locations for sub-80ms latency worldwide."),
                new("Priority email support (4h SLA)", "Guaranteed first response within 4 business hours, Monday through Friday."),
                new("Advanced analytics with funnels"),
                new("Up to 10 team members"),
                new("Custom domains with auto-SSL"),
                new("REST and GraphQL API access"),
            ],
            "Start free trial", true),
        new("enterprise", "Enterprise", "For large organizations with compliance requirements.",
            99, 79, "Everything in Pro, plus:",
            [
                new("Unlimited storage", "No storage caps. Fair use policy applies for accounts exceeding 500GB."),
                new("24/7 phone and chat support"),
                new("SAML SSO with directory sync", "Connect Okta, Azure AD, or Google Workspace with automatic user provisioning."),
                new("Up to 100 team members"),
                new("Audit logs with 1-year retention"),
                new("Custom RBAC policies"),
            ],
            "Contact sales", false),
    ];

    private static int ConvertPrice(int usdAmount, CurrencyItem currency)
    {
        return (int)Math.Round(usdAmount * currency.Rate);
    }
}
