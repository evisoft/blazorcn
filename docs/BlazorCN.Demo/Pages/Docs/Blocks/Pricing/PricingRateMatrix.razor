@* ============================================================
   Block: pricing-rate-matrix
   Title: PricingRateMatrix
   Description: A wide rate matrix table pricing section for React and Next.js with shadcn Table layout, per-cell NumberFlow animated unit rates, column plan headers with base prices, included allocation above each rate, semantic row grouping for metrics features and support, a sticky ring-highlighted recommended column, and ShadcnioButton CTAs in the footer row built with shadcn/ui Table Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-rate-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Rate matrix
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Compare unit rates across every tier
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground leading-relaxed">
            Every cell shows the included allowance plus the per-unit overage rate. Scan rows to
            compare a single metric across tiers, or columns to price out your expected usage.
        </p>
    </div>

    @* Rate matrix table *@
    <div class="mt-9 overflow-x-auto rounded-2xl border bg-card">
        <TableCn>
            @* Plan headers with base price *@
            <TableHeaderCn>
                <TableRowCn Class="border-b hover:bg-transparent">
                    <TableHeadCn Class="sticky left-0 z-10 min-w-[180px] bg-card text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        Usage metric
                    </TableHeadCn>
                    @foreach (var plan in _plans)
                    {
                        <TableHeadCn Class="@Cn.Merge("min-w-[170px] px-5 py-5 align-top", plan.IsRecommended ? "bg-muted/40" : "")">
                            <div class="relative flex flex-col items-start gap-1">
                                @if (plan.IsRecommended)
                                {
                                    <span class="-top-2 -translate-y-full absolute left-0 inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 ring-1 ring-emerald-500/20 dark:text-emerald-400">
                                        Recommended
                                    </span>
                                }
                                <span class="text-base font-bold tracking-tight text-foreground">
                                    @plan.Name
                                </span>
                                <div class="flex items-baseline gap-1">
                                    @if (plan.BasePrice == null)
                                    {
                                        <span class="text-xl font-bold tracking-tight tabular-nums">
                                            Custom
                                        </span>
                                    }
                                    else if (plan.BasePrice == 0)
                                    {
                                        <span class="text-xl font-bold tracking-tight">
                                            $0
                                            <span class="ml-1 text-[10px] font-medium text-muted-foreground">
                                                @plan.BasePriceLabel
                                            </span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xl font-bold tracking-tight tabular-nums">$@plan.BasePrice</span>
                                        <span class="text-[10px] font-medium text-muted-foreground">
                                            @plan.BasePriceLabel
                                        </span>
                                    }
                                </div>
                            </div>
                        </TableHeadCn>
                    }
                </TableRowCn>
            </TableHeaderCn>

            @* Metric rows — included + overage rate per cell *@
            <TableBodyCn>
                <TableRowCn Class="hover:bg-transparent">
                    <TableCellCn Colspan="@(_plans.Length + 1)" Class="bg-muted/20 px-5 py-2 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        Metered usage
                    </TableCellCn>
                </TableRowCn>
                @foreach (var metric in _metrics)
                {
                    <TableRowCn Class="border-b last:border-b-0">
                        <TableCellCn Class="sticky left-0 z-10 bg-card align-top font-medium">
                            <div class="flex items-start gap-2">
                                <LucideIconCn Name="@metric.Icon" Size="16" aria-hidden="true" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                                <div class="flex min-w-0 flex-col gap-0.5">
                                    <span class="flex items-center gap-1 text-sm">
                                        @metric.Label
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <button type="button"
                                                        aria-label="@($"More info about {metric.Label}")"
                                                        class="cursor-help text-muted-foreground/40 hover:text-muted-foreground">
                                                    <LucideIconCn Name="info" Size="12" Class="size-3" />
                                                </button>
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[220px]">
                                                <p class="text-xs leading-relaxed">@metric.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    </span>
                                    <span class="text-[10px] text-muted-foreground">Incl / overage</span>
                                </div>
                            </div>
                        </TableCellCn>
                        @foreach (var plan in _plans)
                        {
                            var cell = plan.Cells[metric.Id];
                            <TableCellCn Class="@Cn.Merge("align-top", plan.IsRecommended ? "bg-muted/40" : "")">
                                <div class="flex flex-col gap-0.5">
                                    <span class="text-sm font-bold tabular-nums text-foreground">
                                        @cell.Included
                                    </span>
                                    <span class="text-[11px] text-muted-foreground tabular-nums">
                                        then <span class="font-semibold text-foreground">@FormatCurrency(cell.OverageRate, cell.OverageDecimals)</span>@cell.OverageUnit
                                    </span>
                                </div>
                            </TableCellCn>
                        }
                    </TableRowCn>
                }

                @* Quality rows — features and SLA *@
                <TableRowCn Class="hover:bg-transparent">
                    <TableCellCn Colspan="@(_plans.Length + 1)" Class="bg-muted/20 px-5 py-2 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        Platform &amp; support
                    </TableCellCn>
                </TableRowCn>
                @foreach (var row in _qualityRows)
                {
                    <TableRowCn Class="border-b last:border-b-0">
                        <TableCellCn Class="sticky left-0 z-10 bg-card text-sm font-medium">
                            @row.Label
                        </TableCellCn>
                        @for (int i = 0; i < row.Values.Length; i++)
                        {
                            var plan = _plans[i];
                            var value = row.Values[i];
                            <TableCellCn Class="@Cn.Merge("text-sm", plan.IsRecommended ? "bg-muted/40" : "")">
                                @if (value == "true")
                                {
                                    <LucideIconCn Name="check" Size="16" aria-hidden="true" Class="size-4 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                }
                                else if (value == "false")
                                {
                                    <span class="text-muted-foreground/40">—</span>
                                }
                                else
                                {
                                    <span class="tabular-nums">@value</span>
                                }
                            </TableCellCn>
                        }
                    </TableRowCn>
                }
            </TableBodyCn>

            @* CTA footer row *@
            <TableFooterCn Class="border-t bg-card">
                <TableRowCn Class="hover:bg-transparent">
                    <TableCellCn Class="sticky left-0 z-10 bg-card text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        Get started
                    </TableCellCn>
                    @foreach (var plan in _plans)
                    {
                        <TableCellCn Class="@Cn.Merge("py-5", plan.IsRecommended ? "bg-muted/40" : "")">
                            <ButtonCn Size="ButtonSize.Sm"
                                      Variant="@(plan.IsRecommended ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      Class="w-full">
                                @plan.Cta
                            </ButtonCn>
                        </TableCellCn>
                    }
                </TableRowCn>
            </TableFooterCn>
        </TableCn>
    </div>

    @* Trust footer *@
    <p class="mt-7 text-center text-xs text-muted-foreground">
        Usage tracked in real-time and billed at the end of each period with a detailed invoice
        breakdown. Volume discounts available for committed annual usage above the Scale tier.
    </p>
</section>

@code {
    private record Metric(string Id, string Label, string Icon, string Tooltip);
    private record MetricCell(string Included, double OverageRate, int OverageDecimals, string OverageUnit);
    private record Plan(string Id, string Name, int? BasePrice, string BasePriceLabel, string Cta, bool IsRecommended, Dictionary<string, MetricCell> Cells);
    private record QualityRow(string Id, string Label, string[] Values);

    private static readonly Metric[] _metrics =
    [
        new("api", "API calls", "zap", "Combined REST and GraphQL request volume. Burst capacity included on all paid plans."),
        new("compute", "Compute hours", "cpu", "Billed per second of compute with a 1-minute minimum per invocation."),
        new("storage", "Storage", "database", "Object storage with global edge replication. Egress billed separately above the included allowance."),
    ];

    private static readonly Plan[] _plans =
    [
        new("payg", "Pay-as-you-go", 0, "no base", "Start free", false, new Dictionary<string, MetricCell>
        {
            ["api"] = new("1K free", 0.005, 3, "/call"),
            ["compute"] = new("10 free", 0.15, 2, "/hr"),
            ["storage"] = new("1 GB free", 0.1, 2, "/GB"),
        }),
        new("starter", "Starter", 49, "/mo", "Start 14-day trial", false, new Dictionary<string, MetricCell>
        {
            ["api"] = new("50K", 0.003, 3, "/call"),
            ["compute"] = new("100", 0.12, 2, "/hr"),
            ["storage"] = new("25 GB", 0.08, 2, "/GB"),
        }),
        new("growth", "Growth", 199, "/mo", "Start 14-day trial", true, new Dictionary<string, MetricCell>
        {
            ["api"] = new("500K", 0.002, 3, "/call"),
            ["compute"] = new("500", 0.1, 2, "/hr"),
            ["storage"] = new("100 GB", 0.06, 2, "/GB"),
        }),
        new("scale", "Scale", 599, "/mo", "Contact sales", false, new Dictionary<string, MetricCell>
        {
            ["api"] = new("2M", 0.001, 3, "/call"),
            ["compute"] = new("2K", 0.08, 2, "/hr"),
            ["storage"] = new("500 GB", 0.04, 2, "/GB"),
        }),
    ];

    private static readonly QualityRow[] _qualityRows =
    [
        new("regions", "Regions", ["us-east only", "2 regions", "All regions", "All + dedicated"]),
        new("support", "Support", ["Community", "Email 8h SLA", "Priority 2h SLA", "24/7 1h SLA"]),
        new("sso", "SAML SSO", ["false", "false", "true", "true"]),
        new("audit", "Audit logs", ["false", "false", "30 days", "1 year"]),
        new("sla", "Uptime SLA", ["—", "99.5%", "99.9%", "99.99%"]),
    ];

    private static string FormatCurrency(double value, int decimals)
    {
        return "$" + value.ToString("F" + decimals);
    }
}
