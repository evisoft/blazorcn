@* ============================================================
   Block: pricing-grouped-comparison-table
   Title: PricingGroupedComparisonTable
   Description: A grouped feature comparison table pricing section for React and Next.js with a shadcn Table showing four plan columns feature category section header rows CheckIcon and MinusIcon cell values a tinted background on the popular column and fixed column widths to prevent hover reflow built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-grouped-comparison-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            API Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Built for every scale
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            From prototyping to production at global scale. Pay only for what you use with
            volume-based rate limits and enterprise-grade SLAs.
        </p>
    </div>

    @* Comparison table *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-muted">
        <div class="overflow-x-auto">
            @* table-fixed + explicit column widths lock the layout so the Button's
               hover-state arrow growth cannot reflow the column widths *@
            <TableCn Class="min-w-[940px] table-fixed">
                <TableHeaderCn>
                    <TableRowCn Class="border-b-0 hover:bg-transparent">
                        <TableHeadCn Class="w-[220px] border-r border-border/60 py-7 pl-6 align-bottom">
                            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                Compare plans
                            </span>
                        </TableHeadCn>
                        @for (var pi = 0; pi < _plans.Length; pi++)
                        {
                            var plan = _plans[pi];
                            var notLast = pi < _plans.Length - 1;
                            <TableHeadCn Class="@Cn.Merge("w-[180px] py-7 text-center align-bottom", plan.IsPopular ? "bg-background/60" : "", notLast ? "border-r border-border/60" : "")">
                                <div class="flex flex-col items-center gap-3 px-3">
                                    <div class="flex flex-col items-center gap-1.5">
                                        @if (plan.IsPopular)
                                        {
                                            <span class="inline-block rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                                Best Value
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="h-[22px]" aria-hidden="true"></span>
                                        }
                                        <span class="text-2xl font-bold tracking-tight text-foreground">
                                            @plan.Name
                                        </span>
                                        <span class="text-xs text-muted-foreground">@plan.Description</span>
                                    </div>
                                    <div class="flex items-baseline gap-1">
                                        <span class="text-3xl font-bold tracking-tight tabular-nums text-foreground">
                                            @plan.PriceLabel
                                        </span>
                                        @if (plan.MonthlyPrice != null)
                                        {
                                            <span class="text-xs text-muted-foreground">/mo</span>
                                        }
                                    </div>
                                    <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                                        @plan.Cta
                                    </ButtonCn>
                                </div>
                            </TableHeadCn>
                        }
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @for (var gi = 0; gi < _featureGroups.Length; gi++)
                    {
                        var grp = _featureGroups[gi];
                        @* Category header *@
                        <TableRowCn Class="hover:bg-transparent">
                            <TableCellCn Colspan="5" Class="@Cn.Merge("border-r-0 bg-background/40 py-2.5 pl-6", gi == 0 ? "border-t border-border/60" : "")">
                                <span class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                                    @grp.Category
                                </span>
                            </TableCellCn>
                        </TableRowCn>
                        @* Feature rows *@
                        @foreach (var feature in grp.Features)
                        {
                            <TableRowCn Class="hover:bg-transparent">
                                <TableCellCn Class="border-r border-border/60 py-3.5 pl-6 text-sm font-medium text-foreground">
                                    @feature.Name
                                </TableCellCn>
                                @for (var pj = 0; pj < _plans.Length; pj++)
                                {
                                    var plan = _plans[pj];
                                    var notLastP = pj < _plans.Length - 1;
                                    var cellVal = feature.Values.GetValueOrDefault(plan.Id, "");
                                    <TableCellCn Class="@Cn.Merge("py-3.5 text-center", plan.IsPopular ? "bg-background/60" : "", notLastP ? "border-r border-border/60" : "")">
                                        @if (cellVal == "true")
                                        {
                                            <LucideIconCn Name="check" Size="20" Class="mx-auto size-5 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                        }
                                        else if (cellVal == "false")
                                        {
                                            <LucideIconCn Name="minus" Size="16" Class="mx-auto size-4 text-muted-foreground/30" aria-hidden="true" />
                                        }
                                        else
                                        {
                                            <span class="text-sm font-medium tabular-nums text-foreground">@cellVal</span>
                                        }
                                    </TableCellCn>
                                }
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include global edge routing, DDoS protection, and real-time analytics. Volume
        discounts available for 50M+ requests.
    </p>
</section>

@code {
    private record PlanColumn(string Id, string Name, int? MonthlyPrice, string PriceLabel, string Description, string Cta, bool IsPopular);
    private record ComparisonFeature(string Name, Dictionary<string, string> Values);
    private record FeatureGroup(string Category, ComparisonFeature[] Features);

    private static readonly PlanColumn[] _plans =
    [
        new("free",       "Free",       0,    "$0",     "For prototyping",       "Get started",   false),
        new("developer",  "Developer",  29,   "$29",    "For solo builders",     "Start trial",   false),
