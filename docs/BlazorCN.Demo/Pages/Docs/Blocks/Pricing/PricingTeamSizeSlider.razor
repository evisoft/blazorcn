@* ============================================================
   Block: pricing-team-size-slider
   Title: PricingTeamSizeSlider
   Description: An interactive team-size slider pricing section for React and Next.js with a horizontal Radix Slider that drags from 1 to 100 seats, NumberFlow animated total price computed from per-seat cost with volume discount tiers, key included features, and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-team-size-slider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Marketing header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Team pricing calculator
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pricing that fits your team
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            Drag the slider to see your exact monthly cost. Volume discounts unlock automatically as
            your team grows.
        </p>
    </div>

    @* Pricing card *@
    <article class="mt-8 overflow-hidden rounded-2xl bg-muted p-6 sm:p-8">
        @* Slider section *@
        <div>
            <div class="flex items-baseline justify-between gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" aria-hidden="true" />
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        Team size
                    </p>
                </div>
                <div class="flex items-baseline gap-1.5">
                    <span class="text-2xl font-bold tracking-tight tabular-nums">@_teamSize</span>
                    <span class="text-sm text-muted-foreground">
                        @(_teamSize == 1 ? "seat" : "seats")
                    </span>
                </div>
            </div>

            <div class="mt-4">
                <SliderCn Value="@((double)_teamSize)" ValueChanged="@((double v) => { _teamSize = (int)v; })"
                          Min="1" Max="100" Step="1" Class="cursor-pointer" aria-label="Team size in seats" />
                @* Tick markers *@
                <div class="relative mt-3 h-5">
                    @foreach (var tick in _tickMarkers)
                    {
                        var t = tick;
                        var percent = ((t - MinSeats) / (double)(MaxSeats - MinSeats)) * 100;
                        var isActive = _teamSize >= t;
                        <button type="button"
                                @onclick="@(() => _teamSize = t)"
                                aria-label="@($"Set team size to {t} seats")"
                                class="absolute -translate-x-1/2 cursor-pointer text-[10px] font-semibold tabular-nums tracking-wide transition-colors"
                                style="@(FormattableString.Invariant($"left:{percent:0.##}%"))">
                            <span aria-hidden="true"
                                  class="@(isActive ? "text-foreground" : "text-muted-foreground/50")">
                                @t
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Divider *@
        <div class="my-6 border-t border-border/60"></div>

        @* Price block *@
        <div class="text-center">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Your monthly total
            </p>
            <div class="mt-2 flex items-baseline justify-center gap-1.5">
                <span class="text-6xl font-black tracking-tight tabular-nums">$@TotalMonthly</span>
                <span class="text-base text-muted-foreground">/month</span>
            </div>

            <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-xs">
                <span class="rounded-full border border-border/70 bg-background/80 px-2.5 py-1 font-medium text-foreground">
                    <span class="font-bold tabular-nums">$@PerSeat</span>
                    <span class="ml-0.5 text-muted-foreground"> per seat</span>
                </span>
                @if (GetDiscount(_teamSize).Discount > 0)
                {
                    <span class="rounded-full bg-emerald-500/15 px-2.5 py-1 font-bold text-emerald-700 dark:text-emerald-400">
                        @GetDiscount(_teamSize).Label
                    </span>
                }
            </div>

            @if (GetDiscount(_teamSize).Discount > 0)
            {
                <p class="mt-3 text-xs text-muted-foreground">
                    You save <span class="font-bold tabular-nums text-foreground">$@AnnualSavings</span> per year vs the base rate
                </p>
            }
        </div>

        @* CTA *@
        <ButtonCn Class="mt-6 w-full">
            @(_teamSize >= 50 ? "Talk to sales" : "Start 14-day trial")
        </ButtonCn>

        @* Included features *@
        <div class="mt-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Every seat includes
            </p>
            <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
                @foreach (var feature in _features)
                {
                    <li class="flex items-center gap-2.5">
                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        <span class="text-sm font-medium text-foreground">@feature.Name</span>
                    </li>
                }
            </ul>
        </div>
    </article>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        14-day free trial. No credit card required. Add or remove seats anytime with prorated
        billing.
    </p>
</section>

@code {
    private const int MinSeats = 1;
    private const int MaxSeats = 100;
    private const int BasePricePerSeat = 18;

    private int _teamSize = 15;

    private static readonly int[] _tickMarkers = [1, 10, 25, 50, 100];

    private record IncludedFeature(string Name);

    private static readonly IncludedFeature[] _features =
    [
        new("Unlimited projects and workspaces"),
        new("100GB storage per seat with global CDN"),
        new("Advanced analytics with funnels"),
        new("Priority email support (4h SLA)"),
        new("REST and GraphQL API access"),
        new("SAML SSO with directory sync"),
        new("Audit logs with 1-year retention"),
        new("99.95% uptime SLA"),
    ];

    private record DiscountTier(int Threshold, double Discount, string Label);

    private static readonly DiscountTier[] _discountTiers =
    [
        new(100, 0.3, "Save 30%"),
        new(50,  0.2, "Save 20%"),
        new(25,  0.15, "Save 15%"),
        new(10,  0.1, "Save 10%"),
        new(0,   0,   ""),
    ];

    private DiscountTier GetDiscount(int seats)
    {
        foreach (var tier in _discountTiers)
        {
            if (seats >= tier.Threshold)
                return tier;
        }
        return _discountTiers[_discountTiers.Length - 1];
    }

    private int PerSeat => (int)Math.Round(BasePricePerSeat * (1 - GetDiscount(_teamSize).Discount));
    private int TotalMonthly => PerSeat * _teamSize;
    private int AnnualSavings => (int)Math.Round(BasePricePerSeat * _teamSize * 12.0 - PerSeat * _teamSize * 12.0);
}
