@* ============================================================
   Block: pricing-popular-choice
   Title: PricingPopularChoice
   Description: A classic three-column pricing section for React and Next.js with PillTabs billing toggle, NumberFlow animated prices, an emerald-ringed Most Popular middle card with red Best Value badge, progressive feature lists with emerald checkmarks and tooltips, ShadcnioButton CTAs, and a trust footer built with shadcn/ui Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-popular-choice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Pick the plan everyone picks.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
            83% of teams choose Pro. Start free, upgrade when you need more, and only pay for what
            actually moves the needle.
        </p>

        @* Billing toggle *@
        <div class="mt-7 flex items-center justify-center gap-1 rounded-full border bg-muted p-1">
            @foreach (var opt in _billingOptions)
            {
                var isActive = _billing == opt;
                <button
                    type="button"
                    class="@Cn.Merge("rounded-full px-5 py-1.5 text-sm font-medium transition-colors", isActive ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = opt)">
                    @(opt == "monthly" ? "Monthly" : "Annually")
                </button>
            }
        </div>
    </div>

    @* Plan cards *@
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
        @foreach (var plan in _plans)
        {
            var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl bg-muted p-6 sm:p-7", plan.IsPopular ? "ring-2 ring-emerald-500/20" : "")">

                @* Reserved badge slot — rendered on every card for Y-alignment *@
                <div class="mb-4 flex h-7 items-start">
                    @if (plan.IsPopular)
                    {
                        <span class="inline-block rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>

                @* Plan header *@
                <div>
                    <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                    <p class="mt-1.5 min-h-[2.75rem] text-sm leading-relaxed text-muted-foreground">
                        @plan.Description
                    </p>
                </div>

                @* Price *@
                <div class="mt-6 flex h-12 items-baseline gap-1.5 sm:h-14">
                    @if (price == 0)
                    {
                        <span class="text-5xl font-bold tracking-tight tabular-nums">Free</span>
                    }
                    else
                    {
                        <span class="text-5xl font-bold tracking-tight tabular-nums">$@price</span>
                        <span class="text-base text-muted-foreground">/month</span>
                    }
                </div>
                <p class="mt-1.5 text-xs text-muted-foreground">
                    @if (price == 0)
                    {
                        @:Free forever, no credit card.
                    }
                    else if (_billing == "annually")
                    {
                        @($"Billed annually at ${price * 12}/year")
                    }
                    else
                    {
                        @:Billed monthly, cancel anytime
                    }
                </p>

                @* CTA *@
                <div class="mt-6">
                    <ButtonCn Class="w-full">@plan.Cta</ButtonCn>
                </div>

                @* Features *@
                <div class="mt-7 flex-1">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        @plan.FeatureHeading
                    </p>
                    <ul class="mt-4 space-y-3">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start justify-between gap-2">
                                <span class="flex items-start gap-2.5">
                                    <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                    <span class="text-sm font-medium text-foreground">
                                        @feature.Name
                                    </span>
                                </span>
                                @if (!string.IsNullOrEmpty(feature.Tooltip))
                                {
                                    <TooltipProviderCn DelayDuration="200">
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <LucideIconCn Name="info" Size="14" Class="mt-1 size-3.5 shrink-0 cursor-help text-muted-foreground/40" />
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[220px]">
                                                <p class="text-xs">@feature.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    </TooltipProviderCn>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All paid plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

