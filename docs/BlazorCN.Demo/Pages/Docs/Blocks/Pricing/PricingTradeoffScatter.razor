@* ============================================================
   Block: pricing-tradeoff-scatter
   Title: PricingTradeoffScatter
   Description: An XY scatter plot pricing picker for React and Next.js with four plans plotted as bubbles on a price-versus-value chart bubble size encoding capacity click any bubble to select and morph the detail panel below with NumberFlow animated price feature list and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-tradeoff-scatter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Find your sweet spot</h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Plot every plan against price and value. Tap a bubble to compare. The bigger the bubble,
            the more capacity you get.
        </p>
    </div>

    @* Scatter chart card *@
    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        @* Axis legend strip *@
        <div class="flex items-center justify-between border-b border-foreground/10 bg-foreground/5 px-6 py-3">
            <div class="flex items-center gap-2">
                <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Value vs price
                </span>
            </div>
            <div class="flex items-center gap-3">
                <span class="size-2.5 rounded-full bg-foreground/30" aria-hidden="true"></span>
                <span class="text-[11px] text-muted-foreground">bubble = capacity</span>
            </div>
        </div>

        @* SVG chart *@
        <div class="px-4 py-6 sm:px-8 sm:py-8">
            <svg viewBox="@(FormattableString.Invariant($"0 0 {_chartW} {_chartH}"))"
                 class="h-auto w-full"
                 role="group"
                 aria-label="Price versus value scatter plot of pricing plans">
                <title>Price vs value scatter plot</title>

                @* Grid lines — horizontal *@
                @foreach (var t in _yTicks)
                {
                    var y1h = YScale(t);
                    <line x1="@_padLeft" x2="@(_chartW - _padRight)"
                          y1="@y1h.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" y2="@y1h.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                          stroke="currentColor"
                          stroke-width="1"
                          stroke-dasharray="3 4"
                          class="text-foreground/10" />
                }

                @* Grid lines — vertical *@
                @foreach (var t in _xTicks)
                {
                    var x1v = XScale(t);
                    <line y1="@_padTop" y2="@(_chartH - _padBottom)"
                          x1="@x1v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" x2="@x1v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                          stroke="currentColor"
                          stroke-width="1"
                          stroke-dasharray="3 4"
                          class="text-foreground/10" />
                }

                @* Y-axis labels *@
                @foreach (var t in _yTicks)
                {
                    var yl = YScale(t) + 4;
                    @((MarkupString)FormattableString.Invariant($"<text x=\"{_padLeft - 10}\" y=\"{yl:F1}\" text-anchor=\"end\" class=\"fill-muted-foreground text-[11px] font-medium tabular-nums\">{t}</text>"))
                }

                @* Y-axis title *@
                @{
                    var yTitleY = _padTop + _plotH / 2.0;
                }
                @((MarkupString)FormattableString.Invariant($"<text x=\"14\" y=\"{yTitleY:F1}\" text-anchor=\"middle\" transform=\"rotate(-90 14 {yTitleY:F1})\" class=\"fill-muted-foreground text-[10px] font-semibold uppercase tracking-widest\">Value score</text>"))

                @* X-axis labels *@
                @foreach (var t in _xTicks)
                {
                    var xl = XScale(t);
                    var xlY = _chartH - _padBottom + 18;
                    @((MarkupString)FormattableString.Invariant($"<text x=\"{xl:F1}\" y=\"{xlY}\" text-anchor=\"middle\" class=\"fill-muted-foreground text-[11px] font-medium tabular-nums\">${t}</text>"))
                }

                @* X-axis title *@
                @{
                    var xTitleX = _padLeft + _plotW / 2.0;
                    var xTitleY = _chartH - 10;
                }
                @((MarkupString)FormattableString.Invariant($"<text x=\"{xTitleX:F1}\" y=\"{xTitleY}\" text-anchor=\"middle\" class=\"fill-muted-foreground text-[10px] font-semibold uppercase tracking-widest\">Monthly price</text>"))

                @* Bubbles *@
                @for (int i = 0; i < _plans.Length; i++)
                {
                    var plan = _plans[i];
                    var cx = XScale(plan.MonthlyPrice);
                    var cy = YScale(plan.ValueScore);
                    var r = plan.Capacity;
                    var isSelected = plan.Id == _selectedId;

                    @* Flip label above the bubble when the bubble sits near the bottom of the plot *@
                    var labelBelow = cy + r + 30 < _chartH - _padBottom - 4;
                    var labelY = labelBelow ? cy + r + 16 : cy - r - 18;
                    var priceY = labelBelow ? cy + r + 28 : cy - r - 6;

                    var circleCssClass = isSelected
                        ? "cursor-pointer transition-all fill-foreground stroke-foreground"
                        : "cursor-pointer transition-all fill-foreground/25 stroke-foreground/60 hover:fill-foreground/40";
                    var strokeWidth = isSelected ? "2" : "1.5";

                    var nameCssClass = isSelected
                        ? "text-[12px] uppercase tracking-wider fill-foreground font-extrabold"
                        : "text-[12px] uppercase tracking-wider fill-foreground font-bold";

                    var planId = plan.Id;

                    <g>
                        @* Outer ring for popular plan *@
                        @if (plan.IsPopular)
                        {
                            <circle cx="@cx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" cy="@cy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    r="@(r + 6)"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-dasharray="3 3"
                                    class="text-red-500/60" />
                        }
                        @* The bubble *@
                        <circle cx="@cx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" cy="@cy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                r="@r"
                                class="@circleCssClass"
                                stroke-width="@strokeWidth"
                                @onclick="@(() => SelectPlan(planId))" />
                        @* Plan name label outside the bubble *@
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{cx:F1}\" y=\"{labelY:F1}\" text-anchor=\"middle\" pointer-events=\"none\" class=\"{nameCssClass}\">{plan.Name}</text>"))
                        @* Price label *@
                        @{
                            var priceLabel = plan.MonthlyPrice == 0 ? "Free" : $"${plan.MonthlyPrice}/mo";
                        }
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{cx:F1}\" y=\"{priceY:F1}\" text-anchor=\"middle\" pointer-events=\"none\" class=\"fill-muted-foreground text-[10px] font-mono tabular-nums\">{priceLabel}</text>"))
                    </g>
                }
            </svg>

            @* Hidden buttons for keyboard accessibility *@
            <div class="sr-only">
                @foreach (var plan in _plans)
                {
                    var planId = plan.Id;
                    var isPressed = plan.Id == _selectedId;
                    <button type="button"
                            @onclick="@(() => SelectPlan(planId))"
                            aria-pressed="@isPressed.ToString().ToLowerInvariant()"
                            aria-label="@($"Select {plan.Name} plan, ${plan.MonthlyPrice} per month, value score {plan.ValueScore} out of 10")">
                        @plan.Name
                    </button>
                }
            </div>
        </div>
    </div>

    @* Detail panel *@
    <div class="mt-4 overflow-hidden rounded-2xl border border-foreground/10 bg-card">
        <div class="grid gap-6 p-6 sm:grid-cols-[1.3fr_1fr] sm:p-8"
             aria-live="polite">

            @* Left: title + price + CTA *@
            <div class="flex flex-col">
                <div class="flex items-center gap-3">
                    <h3 class="text-2xl font-bold tracking-tight">@_selectedPlan.Name</h3>
                    @if (_selectedPlan.IsPopular)
                    {
                        <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    @_selectedPlan.Tagline
                </p>

                <div class="mt-5 flex items-baseline gap-1.5">
                    @if (_selectedPlan.MonthlyPrice == 0)
                    {
                        <span class="text-5xl font-bold tracking-tight tabular-nums">Free</span>
                    }
                    else
                    {
                        <span class="text-5xl font-bold tracking-tight tabular-nums">$@_selectedPlan.MonthlyPrice</span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    }
                </div>
                <p class="mt-1 text-xs text-muted-foreground">
                    Value score @_selectedPlan.ValueScore / 10
                </p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full sm:w-[230px]">
                    @_selectedPlan.Cta
                </ButtonCn>
            </div>

            @* Right: features *@
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    What&apos;s included
                </p>
                <ul class="mt-3 space-y-2.5">
                    @foreach (var feature in _selectedPlan.Features)
                    {
                        <li class="flex items-start gap-2.5">
                            <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm font-medium text-foreground">@feature</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    // ── Chart geometry constants ────────────────────────────────────────
    private const double _chartW     = 600;
    private const double _chartH     = 320;
    private const double _padLeft    = 50;
    private const double _padRight   = 24;
    private const double _padTop     = 24;
    private const double _padBottom  = 44;

    private static readonly double _plotW = _chartW - _padLeft - _padRight;
    private static readonly double _plotH = _chartH - _padTop - _padBottom;

    private const double _xMin = 0;
    private const double _xMax = 320;
    private const double _yMin = 0;
    private const double _yMax = 10;

    private static double XScale(double price) =>
        _padLeft + ((price - _xMin) / (_xMax - _xMin)) * _plotW;

    private static double YScale(double score) =>
        _padTop + (1.0 - (score - _yMin) / (_yMax - _yMin)) * _plotH;

    private static readonly double[] _xTicks = [0, 100, 200, 300];
    private static readonly double[] _yTicks = [0, 2.5, 5, 7.5, 10];

    // ── State ───────────────────────────────────────────────────────────
    private string _selectedId = "pro";

    private Plan _selectedPlan => Array.Find(_plans, p => p.Id == _selectedId) ?? _plans[0];

    private void SelectPlan(string id)
    {
        _selectedId = id;
    }

    // ── Data ────────────────────────────────────────────────────────────
    private record Plan(
        string Id,
        string Name,
        int MonthlyPrice,
        double ValueScore,
        int Capacity,
        string Tagline,
        string[] Features,
        string Cta,
        bool IsPopular
    );

