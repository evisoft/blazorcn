@* ============================================================
   Block: pricing-partner-discount
   Title: PricingPartnerDiscount
   Description: A split layout partner pricing section for React and Next.js with left-aligned headline and program benefits beside three stacked partner tier rows showing strikethrough original price, discounted price, emerald discount badge, ShadcnioButton CTAs, and progressive partner perks built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-partner-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid gap-10 lg:grid-cols-[2fr_3fr] lg:gap-12">
        @* LEFT — Headline + benefits *@
        <div class="lg:sticky lg:top-8 lg:self-start">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Partner Program
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Grow with us.
                <br />
                Earn more together.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Unlock deeper discounts, lifetime commissions, and exclusive benefits as you advance
                through our channel partner tiers.
            </p>

            <div class="mt-8 rounded-2xl bg-muted p-6">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                    <p class="text-sm font-semibold">Every partner gets</p>
                </div>
                <ul class="mt-4 space-y-3">
                    @foreach (var benefit in _programBenefits)
                    {
                        <li class="flex items-start gap-2.5 text-sm font-medium text-foreground">
                            <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="mt-0.5 size-4 shrink-0 text-emerald-600 stroke-[3] dark:text-emerald-500" aria-hidden="true" />
                            @benefit
                        </li>
                    }
                </ul>
            </div>

            <p class="mt-6 text-xs text-muted-foreground">
                Tier qualification reviewed quarterly based on referral revenue.
            </p>
        </div>

        @* RIGHT — Tier rows *@
        <div class="flex flex-col gap-4">
            @foreach (var t in _partnerTiers)
            {
                var tier = t;
                <article class="@Cn.Merge("relative overflow-hidden rounded-2xl bg-muted p-6", tier.IsPopular ? "ring-2 ring-foreground/10" : "")">
                    @* Top: name + description + in-flow badge *@
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="text-xl font-bold tracking-tight">@tier.Name</h3>
                            <p class="mt-1 text-sm text-muted-foreground">@tier.Description</p>
                        </div>
                        @if (tier.IsPopular)
                        {
                            <span class="shrink-0 rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        }
                    </div>

                    @* Middle: price row + CTA *@
                    <div class="mt-5 flex flex-col items-stretch gap-4 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <div class="flex items-baseline gap-2">
                                <s aria-hidden="true" class="text-base text-muted-foreground/70 tabular-nums">
                                    $@tier.BasePrice
                                </s>
                                <span class="text-4xl font-bold tracking-tight tabular-nums">
                                    $@tier.DiscountedPrice
                                </span>
                                <span class="text-sm text-muted-foreground">/seat/mo</span>
                                <span class="ml-1 text-base font-bold text-emerald-600 dark:text-emerald-500">
                                    -@(tier.DiscountPercent)%
                                </span>
                            </div>
                            <p class="mt-1 text-xs font-medium text-muted-foreground">
                                @tier.MinRevenue
                            </p>
                        </div>
                        <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 sm:w-[210px]">
                            @tier.Cta
                        </ButtonCn>
                    </div>

                    @* Bottom: perks *@
                    <ul class="mt-5 grid gap-2.5 border-t pt-5 sm:grid-cols-2">
                        @foreach (var p in tier.Perks)
                        {
                            var perk = p;
                            <li class="flex items-center justify-between gap-2 text-sm font-medium text-foreground">
                                <span class="flex items-center gap-2">
                                    <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="size-4 shrink-0 text-emerald-600 stroke-[3] dark:text-emerald-500" aria-hidden="true" />
                                    @perk.Name
                                </span>
                                @if (perk.Tooltip != null)
                                {
                                    <TooltipCn OpenDelay="200">
                                        <TooltipTriggerCn>
                                            <LucideIconCn Name="info" Size="12" Class="size-3 shrink-0 cursor-help text-muted-foreground/40" aria-hidden="true" />
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Side="FloatingSide.Top" Class="max-w-[220px]">
                                            <p class="text-xs">@perk.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                }
                            </li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

