@* ============================================================
   Block: pricing-usage-profile
   Title: PricingUsageProfile
   Description: A single-hero usage profile pricing section for React and Next.js with PillTabs profile selector morphing one card, NumberFlow animated total, a stacked horizontal proportional cost bar splitting spend by category, animated bar width transitions, per-category detail rows with usage values and dollar contribution, and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-usage-profile.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Usage profile
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            See where your bill comes from
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground leading-relaxed">
            Pick a usage profile that sounds like you. Watch the proportional bar reveal exactly which
            features drive your monthly cost — before you ever sign up.
        </p>

        @* Profile selector (PillTabs rendered as raw HTML) *@
        <div class="mt-7 flex items-center justify-center">
            <div id="usage-profile-selector" role="tablist" aria-label="Usage profile"
                 class="inline-flex rounded-full border bg-muted p-1 gap-1">
                @foreach (var pid in _profileIds)
                {
                    var profileId = pid;
                    <button type="button"
                            role="tab"
                            aria-selected="@(profileId == _profileId ? "true" : "false")"
                            @onclick="@(() => _profileId = profileId)"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", profileId == _profileId ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @(profileId.Substring(0, 1).ToUpper() + profileId.Substring(1))
                    </button>
                }
            </div>
        </div>
    </div>

    @* Single hero forecast card *@
    <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
        @* Top: total + CTA *@
        <div class="flex flex-col gap-6 p-6 sm:flex-row sm:items-end sm:justify-between sm:p-8">
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    Estimated monthly
                </p>
                <div class="mt-2 flex items-baseline gap-1.5">
                    <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">
                        $@TotalRounded.ToString("N0")
                    </span>
                    <span class="text-base text-muted-foreground">/mo</span>
                </div>
                <p class="mt-2 text-sm text-muted-foreground">@ActiveProfile.Tagline</p>
            </div>

            <div class="flex flex-col items-stretch gap-2 sm:items-end">
                <ButtonCn Class="w-full sm:w-[240px]">
                    Start with @ActiveProfile.Name
                </ButtonCn>
                <p class="text-center text-xs text-muted-foreground sm:text-right">
                    14-day free trial · No credit card
                </p>
            </div>
        </div>

        @* Stacked proportional cost bar *@
        <div class="border-t bg-muted/30 px-6 py-7 sm:px-8">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Where your bill comes from
                </p>
                <p class="text-[11px] tabular-nums text-muted-foreground">
                    @Breakdown.Length cost categories
                </p>
            </div>

            @* The bar itself *@
            <div role="img"
                 aria-label="@AriaSplit"
                 class="mt-4 flex h-3 w-full overflow-hidden rounded-full bg-muted">
                @foreach (var seg in Segments)
                {
                    var marginLeft = seg.Index == 0 ? "" : "margin-left:1px;";
                    <div class="@seg.Category.BarClass"
                         style="@($"{marginLeft}width:{seg.Percent:F2}%;transition:width 0.5s ease-out")">
                    </div>
                }
            </div>

            @* Per-category detail rows *@
            <ul class="mt-6 space-y-3">
                @foreach (var seg in Segments)
                {
                    <li class="flex items-center justify-between gap-3 text-sm">
                        <div class="flex min-w-0 items-center gap-3">
                            <span aria-hidden="true"
                                  class="@($"size-2 shrink-0 rounded-full {seg.Category.DotClass}")">
                            </span>
                            <LucideIconCn Name="@seg.Category.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <span class="truncate font-medium text-foreground">
                                @seg.Category.Name
                            </span>
                        </div>
                        <div class="flex shrink-0 items-baseline gap-3">
                            <span class="hidden text-xs tabular-nums text-muted-foreground sm:inline">
                                @FormatUsage(seg.Usage, seg.Category.Unit)
                            </span>
                            <span class="w-12 text-right text-xs font-semibold tabular-nums text-muted-foreground">
                                @((int)Math.Round(seg.Percent))%
                            </span>
                            <span class="w-14 text-right text-sm font-semibold tabular-nums text-foreground">
                                $@((int)Math.Round(seg.Cost))
                            </span>
                        </div>
                    </li>
                }
            </ul>
        </div>

        @* Included features pill row *@
        <div class="border-t px-6 py-5 sm:px-8">
            <div class="flex flex-wrap items-center gap-2">
                <p class="mr-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                    Includes:
                </p>
                @foreach (var feature in ActiveProfile.Features)
                {
                    <span class="rounded-full border bg-background px-2.5 py-1 text-xs font-medium text-foreground">
                        @feature
                    </span>
                }
            </div>
        </div>
    </div>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Estimates based on your selected profile. Actual usage is metered to the request — you only
        pay for what you use.
    </p>
</section>

@code {
    private record UsageCategory(
        string Id,
        string Name,
        string IconName,
        string Unit,
        string DotClass,
        string BarClass,
        double PerUnitCost
    );

    private record UsageProfile(
        string Id,
        string Name,
        string Tagline,
        Dictionary<string, int> Usage,
        string[] Features
    );

    private record BreakdownRow(UsageCategory Category, int Usage, double Cost);

    private record SegmentRow(UsageCategory Category, int Usage, double Cost, double Percent, int Index);

    private static readonly UsageCategory[] _categories =
    [
        new("ai", "AI generations", "sparkles", "generations", "bg-violet-500", "bg-violet-500", 0.02),
        new("api", "API requests", "zap", "requests", "bg-blue-500", "bg-blue-500", 0.0001),
        new("storage", "Storage", "database", "GB", "bg-emerald-500", "bg-emerald-500", 0.5),
    ];

    private static readonly UsageProfile[] _profiles =
    [
        new("light", "Light", "Solo developers and side projects",
            new Dictionary<string, int> { ["ai"] = 500, ["api"] = 50000, ["storage"] = 10 },
            ["1 workspace", "Email support", "Community forum"]),
        new("standard", "Standard", "Growing teams shipping every week",
            new Dictionary<string, int> { ["ai"] = 5000, ["api"] = 500000, ["storage"] = 50 },
            ["10 workspaces", "Priority chat", "Custom domains", "Webhook events"]),
        new("heavy", "Heavy", "Production workloads at scale",
            new Dictionary<string, int> { ["ai"] = 50000, ["api"] = 5000000, ["storage"] = 500 },
            ["Unlimited workspaces", "Dedicated CSM", "SAML SSO", "99.95% SLA"]),
    ];

    private static readonly string[] _profileIds = ["light", "standard", "heavy"];

    private string _profileId = "standard";

    private UsageProfile ActiveProfile => Array.Find(_profiles, p => p.Id == _profileId) ?? _profiles[1];

    private BreakdownRow[] Breakdown => _categories
        .Select(cat =>
        {
            int usage = ActiveProfile.Usage.TryGetValue(cat.Id, out var u) ? u : 0;
            double cost = usage * cat.PerUnitCost;
            return new BreakdownRow(cat, usage, cost);
        })
        .ToArray();

    private double Total => Breakdown.Sum(r => r.Cost);

    private int TotalRounded => (int)Math.Round(Total);

    private SegmentRow[] Segments
    {
        get
        {
            var rows = Breakdown;
            double total = Total;
            return rows
                .Select((r, i) => new SegmentRow(r.Category, r.Usage, r.Cost, total > 0 ? (r.Cost / total) * 100.0 : 0, i))
                .ToArray();
        }
    }

    private string AriaSplit => string.Join(", ",
        Segments.Select(s => $"{s.Category.Name}: {(int)Math.Round(s.Percent)}%"));

    private static string FormatUsage(int value, string unit)
    {
        if (unit == "GB") return $"{value:N0} GB";
        if (value >= 1_000_000) return $"{(value / 1_000_000.0):F1}M {unit}";
        if (value >= 10_000) return $"{(value / 1_000.0):F0}K {unit}";
        if (value >= 1_000) return $"{(value / 1_000.0):F1}K {unit}";
        return $"{value:N0} {unit}";
    }
}
