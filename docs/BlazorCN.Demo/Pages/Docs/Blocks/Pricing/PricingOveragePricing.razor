@* ============================================================
   Block: pricing-overage-pricing
   Title: PricingOveragePricing
   Description: A grouped comparison table pricing section for React and Next.js with four plan tier columns, PillTabs billing toggle, NumberFlow animated prices, category-grouped usage rows showing included allowances and per-unit overage rates in monospaced badges, ShadcnioButton CTAs in the table header, and a highlighted popular column built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-overage-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Usage-based pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Transparent pricing, no surprises
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
            Every plan includes generous allowances. If you go over, overage rates are clear and
            predictable. No hidden fees, no throttling.
        </p>
    </div>

    @* Billing toggle *@
    <div class="mt-7 flex items-center justify-center">
        <div class="inline-flex rounded-full bg-muted p-1 gap-1">
            @foreach (var opt in _billingOptions)
            {
                var option = opt;
                <button
                    type="button"
                    class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == option ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = option)">
                    @(option == "monthly" ? "Monthly" : "Annually")
                </button>
            }
        </div>
    </div>

    @* Comparison table *@
    <div class="mt-8 overflow-hidden rounded-2xl bg-muted">
        <div class="overflow-x-auto">
            <TableCn Class="w-full min-w-[1000px] table-fixed">
                <TableHeaderCn>
                    <TableRowCn Class="border-b-0 hover:bg-transparent">
                        <TableHeadCn Class="w-[200px] py-7 pl-6 align-top" />
                        @foreach (var plan in _plans)
                        {
                            var p = plan;
                            int? price = _billing == "monthly" ? p.MonthlyPrice : p.AnnualPrice;
                            <TableHeadCn Class="@Cn.Merge("w-[200px] py-7 px-4 text-center align-top", p.IsPopular ? "bg-background/60" : "")">
                                <div class="flex flex-col items-center gap-2.5">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-base font-bold tracking-tight text-foreground">
                                            @p.Name
                                        </h3>
                                        @if (p.IsPopular)
                                        {
                                            <span class="rounded-full bg-red-500 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                                Popular
                                            </span>
                                        }
                                    </div>

                                    @* Price *@
                                    <div class="flex min-h-[40px] items-baseline gap-1">
                                        @if (price == null)
                                        {
                                            <span class="text-3xl font-bold tracking-tight text-foreground">
                                                Custom
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-3xl font-bold tracking-tight tabular-nums text-foreground">$@price</span>
                                            <span class="text-xs text-muted-foreground">/mo</span>
                                        }
                                    </div>

                                    <p class="text-xs text-muted-foreground">@p.Description</p>

                                    <ButtonCn Size="ButtonSize.Sm" Class="mt-1 w-full min-w-0">
                                        @p.Cta
                                    </ButtonCn>
                                </div>
                            </TableHeadCn>
                        }
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var category in _usageCategories)
                    {
                        var cat = category;
                        @* Category header row *@
                        <TableRowCn Class="border-t hover:bg-transparent">
                            <TableCellCn Colspan="@(_plans.Length + 1)" Class="bg-background/60 px-6 py-2.5">
                                <span class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
                                    @cat.Name
                                </span>
                            </TableCellCn>
                        </TableRowCn>

                        @* Category rows *@
                        @foreach (var row in cat.Rows)
                        {
                            var r = row;
                            bool isOverageRow = r.Label.ToLower().Contains("overage");
                            <TableRowCn Class="border-t hover:bg-transparent">
                                <TableCellCn Class="py-3.5 pl-6 text-sm font-medium text-foreground">
                                    @r.Label
                                </TableCellCn>
                                @foreach (var plan in _plans)
                                {
                                    var pl = plan;
                                    var value = r.Values.GetValueOrDefault(pl.Id, new UsageValue("", ""));
                                    string displayValue = isOverageRow ? value.Overage : value.Included;
                                    bool isUnlimited = displayValue == "Unlimited" || displayValue == "Custom";
                                    bool isUnavailable = displayValue == "N/A";
                                    <TableCellCn Class="@Cn.Merge("py-3.5 px-4 text-center", pl.IsPopular ? "bg-background/60" : "")">
                                        @if (isUnavailable)
                                        {
                                            <span class="text-sm text-muted-foreground/40">—</span>
                                        }
                                        else if (isUnlimited)
                                        {
                                            <div class="inline-flex items-center gap-1.5">
                                                <LucideIconCn Name="check" Size="16" Class="size-4 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                                <span class="text-sm font-semibold text-foreground">
                                                    @displayValue
                                                </span>
                                            </div>
                                        }
                                        else if (isOverageRow && !string.IsNullOrEmpty(displayValue))
                                        {
                                            <span class="rounded-md bg-background px-2 py-1 font-mono text-xs font-medium text-foreground">
                                                @displayValue
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-sm font-semibold tabular-nums text-foreground">
                                                @displayValue
                                            </span>
                                        }
                                    </TableCellCn>
                                }
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>

    @* Trust footer *@
    <div class="mt-6 space-y-1 text-center">
        <p class="text-xs text-muted-foreground">
            Overages billed at the end of each billing cycle. Usage alerts at 80% and 100% of included
            allowances.
        </p>
        <p class="text-xs text-muted-foreground">
            14-day free trial on all plans. Enterprise includes custom overage agreements.
        </p>
    </div>
</section>

@code {
