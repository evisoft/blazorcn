    private record UsageValue(string Included, string Overage);
    private record UsageRow(string Label, Dictionary<string, UsageValue> Values);
    private record UsageCategory(string Name, UsageRow[] Rows);

    private string _billing = "monthly";
    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private static readonly PlanColumn[] _plans =
    [
