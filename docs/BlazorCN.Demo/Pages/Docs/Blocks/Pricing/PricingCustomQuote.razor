@* ============================================================
   Block: pricing-custom-quote
   Title: PricingCustomQuote
   Description: A split layout enterprise pricing section for React and Next.js with a left panel featuring marketing headline, key selling points with emerald checkmarks, and trust indicators alongside a right panel with structured contact form for company name, team size select, work email, message textarea, and ShadcnioButton submit with success state built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-custom-quote.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1.05fr_1fr]">

        @* Left panel — selling points *@
        <div class="flex flex-col justify-center rounded-2xl bg-muted p-8 sm:p-10">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Enterprise
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Enterprise-grade<br />at your scale
            </h2>
            <p class="mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
                Custom pricing tailored to your organization. No fixed tiers, no feature limitations.
                Get exactly what you need.
            </p>

            @* Selling points *@
            <ul class="mt-8 space-y-5">
                @foreach (var point in _sellingPoints)
                {
                    <li class="flex gap-4">
                        <div class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-xl bg-foreground text-background">
                            <LucideIconCn Name="@point.IconName" Size="16" Class="size-4" />
                        </div>
                        <div>
                            <p class="text-base font-semibold text-foreground">@point.Title</p>
                            <p class="mt-0.5 text-sm text-muted-foreground leading-relaxed">
                                @point.Description
                            </p>
                        </div>
                    </li>
                }
            </ul>

            @* Trust indicators *@
            <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border/60 pt-6">
                @foreach (var label in _trustBadges)
                {
                    <div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        <span>@label</span>
                    </div>
                }
            </div>
        </div>

        @* Right panel — form *@
        <div class="rounded-2xl border bg-card p-8 sm:p-10">
            @if (_submitted)
            {
                <div class="flex h-full min-h-[440px] flex-col items-center justify-center text-center">
                    <div class="flex size-14 items-center justify-center rounded-full bg-emerald-600 dark:bg-emerald-500">
                        <LucideIconCn Name="check" Size="28" Class="size-7 stroke-[3] text-white" />
                    </div>
                    <h3 class="mt-5 text-2xl font-bold tracking-tight">Request received</h3>
                    <p class="mt-2 max-w-xs text-sm text-muted-foreground leading-relaxed">
                        Our enterprise team will review your requirements and reach out within one
                        business day with a tailored proposal.
                    </p>
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-6 w-auto" @onclick="@(() => _submitted = false)">
                        Submit another request
                    </ButtonCn>
                </div>
            }
            else
            {
                <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                    <div class="flex items-center gap-2.5">
                        <div class="flex size-9 items-center justify-center rounded-xl bg-foreground text-background">
                            <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                        </div>
                        <h3 class="text-2xl font-bold tracking-tight">Get a custom quote</h3>
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                        Tell us about your team and requirements. We will prepare a tailored proposal
                        within one business day.
                    </p>

                    <div class="mt-6 space-y-4">
                        <div class="space-y-1.5">
                            <LabelCn For="company-name" Class="text-xs font-semibold">Company name</LabelCn>
                            <InputCn id="company-name" Type="text" Placeholder="Acme Inc." Class="h-11" />
                        </div>

                        <div class="space-y-1.5">
                            <LabelCn For="team-size" Class="text-xs font-semibold">Team size</LabelCn>
                            <SelectCn @bind-Value="_teamSize">
                                <SelectTriggerCn id="team-size" Class="h-11">
                                    <SelectValueCn Placeholder="Select team size" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var sz in _teamSizes)
                                    {
                                        <SelectItemCn Value="@sz.Value">@sz.Label</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        <div class="space-y-1.5">
                            <LabelCn For="work-email" Class="text-xs font-semibold">Work email</LabelCn>
                            <InputCn id="work-email" Type="email" Placeholder="@("you@company.com")" Class="h-11" />
                        </div>

                        <div class="space-y-1.5">
                            <LabelCn For="custom-quote-message" Class="text-xs font-semibold">Tell us about your requirements</LabelCn>
                            <TextareaCn id="custom-quote-message" Placeholder="Describe your use case, team structure, compliance needs, or any specific requirements..." Class="min-h-[110px] resize-none" />
                        </div>

                        <ButtonCn Type="submit" Class="mt-2 w-full">
                            Request custom quote
                        </ButtonCn>

                        <p class="text-center text-xs text-muted-foreground">
                            No commitment required. We typically respond within 24 hours.
                        </p>
                    </div>
                </form>
            }
        </div>

    </div>
</section>

@code {
    private bool _submitted;
    private string _teamSize = "";

    private void HandleSubmit() => _submitted = true;

    private record SellingPoint(string IconName, string Title, string Description);

    private static readonly SellingPoint[] _sellingPoints =
    [
        new("users", "Scales to 10,000+ seats", "Volume pricing that decreases as your team grows, with no per-seat caps."),
        new("shield-check", "SOC 2 Type II certified", "Enterprise-grade security with SAML SSO, audit logs, and data residency options."),
        new("zap", "99.99% uptime SLA", "Financially-backed uptime guarantee with dedicated infrastructure and priority routing."),
        new("building", "Dedicated account team", "Named account manager, solutions architect, and 24/7 priority support channel."),
    ];

    private static readonly string[] _trustBadges =
    [
        "Custom contracts",
        "Volume discounts",
        "Invoice billing",
        "DPA available",
    ];

    private record TeamSizeOption(string Value, string Label);

    private static readonly TeamSizeOption[] _teamSizes =
    [
        new("10-50", "10 - 50 employees"),
        new("51-200", "51 - 200 employees"),
        new("201-1000", "201 - 1,000 employees"),
        new("1001-5000", "1,001 - 5,000 employees"),
        new("5001+", "5,001+ employees"),
    ];
}
