@* ============================================================
   Block: pricing-column-chart-picker
   Title: PricingColumnChartPicker
   Description: A bar chart pricing picker for React and Next.js with four ascending column bars representing plans that animate from zero on mount click to select and update a detail panel below showing NumberFlow animated price feature list and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-column-chart-picker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pick a plan
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            See your scale at a glance
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Tap a column to compare plans. Every tier scales storage compute and team capacity for the
            next stage of your product.
        </p>
    </div>

    @* Chart card *@
    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        @* Y-axis indicator stripe *@
        <div class="flex items-center justify-between border-b border-foreground/10 bg-foreground/5 px-6 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-muted-foreground" aria-hidden="true" />
                <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Storage capacity
                </span>
            </div>
            <span class="font-mono text-[11px] tabular-nums text-muted-foreground">0 → 3 TB</span>
        </div>

        @* Chart bars *@
        <div class="px-6 pb-4 pt-12 sm:px-10 sm:pt-14">
            <div
                class="relative flex h-72 items-end justify-center gap-3 sm:h-80 sm:gap-6"
                role="group"
                aria-label="Plan comparison chart">

                @* Horizontal grid lines *@
                <div class="pointer-events-none absolute inset-x-0 top-0 h-full">
                    @foreach (var pct in _gridLines)
                    {
                        <div
                            class="absolute inset-x-0 border-t border-dashed border-foreground/10"
                            style="@($"top:{pct}%")">
                        </div>
                    }
                </div>

                @foreach (var plan in _plans)
                {
                    var isSelected = plan.Id == _selectedId;
                    var rawHeight = (plan.Capacity / (double)_maxCapacity) * 100.0;
                    var targetHeight = Math.Max(rawHeight, 22.0);
                    var animatedHeight = _isAnimated ? targetHeight : 0.0;
                    var barClass = isSelected
                        ? "relative w-full overflow-hidden rounded-t-md transition-colors bg-foreground"
                        : "relative w-full overflow-hidden rounded-t-md transition-colors bg-foreground/15 group-hover:bg-foreground/30";
                    var labelClass = isSelected
                        ? "absolute left-1/2 z-10 -translate-x-1/2 whitespace-nowrap text-[11px] font-bold tabular-nums text-foreground"
                        : "absolute left-1/2 z-10 -translate-x-1/2 whitespace-nowrap text-[11px] font-bold tabular-nums text-muted-foreground";
                    var nameClass = isSelected
                        ? "mt-4 text-xs font-semibold uppercase tracking-wider transition-colors text-foreground"
                        : "mt-4 text-xs font-semibold uppercase tracking-wider transition-colors text-muted-foreground group-hover:text-foreground";
                    var planCapacity = plan.Capacity;
                    var planId = plan.Id;

                    <button
                        type="button"
                        @onclick="@(() => SelectPlan(planId))"
                        aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                        aria-label="@($"Select {plan.Name} plan, {plan.CapacityLabel}, ${plan.MonthlyPrice} per month")"
                        class="group relative flex h-full w-full max-w-[88px] flex-col items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-muted">

                        @* Chart area *@
                        <div class="relative flex w-full flex-1 flex-col items-center justify-end">
                            @* Best Value badge *@
                            @if (plan.IsPopular)
                            {
                                <span class="absolute -top-9 left-1/2 z-20 -translate-x-1/2 whitespace-nowrap rounded-full bg-red-500 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                    Best Value
                                </span>
                            }

                            @* Capacity label above bar *@
                            <span
                                class="@labelClass"
                                style="@($"bottom:calc({animatedHeight}% + 6px)")">
                                @plan.CapacityLabel
                            </span>

                            @* The bar *@
                            <div
                                class="@barClass"
                                style="@($"height:{animatedHeight}%;transition:height 0.6s cubic-bezier(0.34,1.56,0.64,1)")">
                                @* Inner shine line *@
                                <div class="absolute inset-x-0 top-0 h-px bg-background/40"></div>
                            </div>

                            @* Active dot connector *@
                            @if (isSelected)
                            {
                                <div class="absolute -bottom-1 size-2 rounded-full bg-foreground"></div>
                            }
                        </div>

                        @* Plan label below chart area *@
                        <span class="@nameClass">
                            @plan.Name
                        </span>
                    </button>
                }
            </div>
        </div>
    </div>

    @* Detail panel *@
    <div class="mt-4 overflow-hidden rounded-2xl border border-foreground/10 bg-card">
        <div
            class="grid gap-6 p-6 sm:grid-cols-[1.3fr_1fr] sm:p-8"
            aria-live="polite">

            @* Left: title + price + CTA *@
            <div class="flex flex-col">
                <div class="flex items-baseline justify-between gap-3">
                    <h3 class="text-2xl font-bold tracking-tight">@_selectedPlan.Name</h3>
                    @if (_selectedPlan.IsPopular)
                    {
                        <span class="inline-flex items-center rounded-full bg-red-500 px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    @_selectedPlan.Tagline
                </p>

                <div class="mt-5 flex items-baseline gap-1.5">
                    <span class="text-5xl font-bold tracking-tight tabular-nums">
                        $@(_isAnimated ? _selectedPlan.MonthlyPrice : 0)
                    </span>
                    <span class="text-sm text-muted-foreground">/mo</span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">Billed monthly, cancel anytime</p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full sm:w-[230px]">
                    @_selectedPlan.Cta
                </ButtonCn>
            </div>

            @* Right: features *@
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    What's included
                </p>
                <ul class="mt-3 space-y-2.5">
                    @foreach (var feature in _selectedPlan.Features)
                    {
                        <li class="flex items-start gap-2.5">
                            <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm font-medium text-foreground">@feature</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private record Plan(
        string Id,
        string Name,
        string Tagline,
        int MonthlyPrice,
        int Capacity,
        string CapacityLabel,
        string[] Features,
        string Cta,
        bool IsPopular
    );

    private static readonly Plan[] _plans =
    [
        new("starter", "Starter", "For solo builders and weekend projects.", 12, 25, "25 GB",
            ["1 project workspace", "25 GB SSD storage", "Community support", "99.9% uptime SLA"],
            "Start free trial", false),
        new("growth", "Growth", "For independent makers shipping production.", 39, 150, "150 GB",
            ["10 project workspaces", "150 GB SSD with CDN", "Email support, 24h SLA", "99.95% uptime SLA", "Advanced analytics"],
            "Start free trial", false),
        new("team", "Team", "For collaborating teams that need control.", 99, 750, "750 GB",
            ["Unlimited workspaces", "750 GB SSD with global CDN", "Priority support, 4h SLA", "99.99% uptime SLA", "SAML SSO and audit logs", "Up to 25 team members"],
            "Start free trial", true),
        new("enterprise", "Enterprise", "For mission-critical platforms at scale.", 399, 3000, "3 TB",
            ["Everything in Team", "3 TB SSD with multi-region", "Dedicated success manager", "99.99% uptime with credits", "Data residency (US, EU, APAC)", "Custom contracts and DPA"],
            "Contact sales", false),
    ];

    private static readonly int[] _gridLines = [0, 25, 50, 75];

    private static readonly int _maxCapacity = 3000;

    private string _selectedId = "team";
    private bool _isAnimated = false;

    private Plan _selectedPlan => Array.Find(_plans, p => p.Id == _selectedId) ?? _plans[0];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(150);
            _isAnimated = true;
            StateHasChanged();
        }
    }

    private void SelectPlan(string id)
    {
        _selectedId = id;
    }
}
