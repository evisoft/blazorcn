@* ============================================================
   Block: pricing-money-back-hero
   Title: PricingMoneyBackHero
   Description: A trust-led single plan pricing section for React and Next.js featuring a prominent shield-icon money-back guarantee, hero card with bold headline, large price display, two-column emerald feature grid, ShadcnioButton CTA, payment trust signals row, and bg-muted card built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-money-back-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Floating shield + headline above the card *@
    <div class="text-center">
        <div class="mx-auto flex size-16 items-center justify-center rounded-2xl bg-emerald-500/10 ring-1 ring-emerald-500/20">
            <LucideIconCn Name="shield-check" Size="32" Class="size-8 stroke-[2.5] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
        </div>

        <p class="mt-5 text-xs font-medium uppercase tracking-widest text-emerald-600 dark:text-emerald-500">
            @_guaranteeDays-Day Money-Back Guarantee
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Try it completely risk-free
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            If you are not completely satisfied within @_guaranteeDays days, we will refund every
            penny. No questions, no forms, no hassle.
        </p>
    </div>

    @* Hero card *@
    <article class="relative mt-8 overflow-hidden rounded-2xl bg-muted p-8 sm:p-10">
        @* Plan label *@
        <div class="flex items-center justify-between gap-3">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                The @_plan.Name plan
            </p>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-500">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3 stroke-[3]" aria-hidden="true" />
                Guaranteed
            </span>
        </div>

        <p class="mt-3 text-base leading-relaxed text-muted-foreground">@_plan.Description</p>

        @* Hero price *@
        <div class="mt-7 flex items-baseline gap-2">
            <span class="text-6xl font-bold tracking-tight tabular-nums sm:text-7xl">
                $@_plan.Price
            </span>
            <span class="text-base text-muted-foreground">@_plan.Period</span>
        </div>

        @* Feature grid *@
        <ul class="mt-7 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
            @foreach (var feature in _plan.Features)
            {
                <li class="flex items-center gap-2.5">
                    <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                    <span class="text-sm font-medium text-foreground">@feature</span>
                </li>
            }
        </ul>

        @* CTA *@
        <ButtonCn Class="mt-8 w-full">@_plan.Cta</ButtonCn>

        @* Inline guarantee strip *@
        <div class="mt-5 flex items-start gap-2.5 rounded-xl bg-background/60 p-3.5">
            <LucideIconCn Name="shield-check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[2.5] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
            <p class="text-xs leading-relaxed text-muted-foreground">
                <span class="font-semibold text-foreground">Our promise:</span> Not satisfied within
                @_guaranteeDays days? Email us and we will process a full refund within 3-5 business
                days. No forms, no friction.
            </p>
        </div>
    </article>

    @* Trust signals row *@
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        @foreach (var signal in _trustSignals)
        {
            <div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="@signal.Icon" Size="14" Class="size-3.5" aria-hidden="true" />
                <span>@signal.Label</span>
            </div>
        }
    </div>
</section>

@code {
    private const int _guaranteeDays = 30;

    private record PlanData(string Name, string Description, int Price, string Period, string Cta, string[] Features);

    private static readonly PlanData _plan = new(
        Name: "Pro",
        Description: "Full access to every feature. No usage caps. No upgrade gates.",
        Price: 79,
        Period: "/month",
        Cta: "Start risk-free today",
        Features:
        [
            "Unlimited projects and team members",
            "Advanced analytics with dashboards",
            "Priority support (1h SLA)",
            "Custom integrations and full API",
            "SAML SSO with directory sync",
            "99.99% uptime SLA",
        ]
    );

    private record TrustSignal(string Icon, string Label);

    private static readonly TrustSignal[] _trustSignals =
    [
        new("lock", "256-bit encryption"),
        new("credit-card", "Secure Stripe checkout"),
        new("x-circle", "Cancel anytime"),
    ];
}
