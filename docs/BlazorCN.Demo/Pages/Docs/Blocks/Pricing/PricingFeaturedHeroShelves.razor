@* ============================================================
   Block: pricing-featured-hero-shelves
   Title: PricingFeaturedHeroShelves
   Description: A featured hero plus category shelves pricing section for React and Next.js with one flagship item rendered as a high-contrast hero card horizontal shelf headers stacked 3-column tile grids per shelf and a shop-style browsing layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-featured-hero-shelves.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header — editorial asymmetry: left title + right subtitle (not centered) *@
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
        <div class="min-w-0">
            <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                Marketplace
            </p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl">
                Grow your stack, one add-on at a time
            </h2>
        </div>
        <p class="max-w-sm text-sm text-muted-foreground leading-relaxed sm:text-right">
            Hand-picked add-ons from our partner network. Every extension runs standalone — install
            only what you need.
        </p>
    </header>

    @* Featured Editor's Pick — horizontal card with high-contrast foreground icon panel.
       Mobile: icon panel stacks on top as a horizontal banner (icon + label side by side).
       Desktop: icon panel is a 180px vertical column on the left. *@
    <article class="mt-8 overflow-hidden rounded-2xl border bg-muted">
        <div class="grid grid-cols-1 sm:grid-cols-[180px_1fr]">
            @* LEFT — foreground bg with icon and Editor's Pick label *@
            <div class="flex items-center gap-4 bg-foreground p-6 text-background sm:flex-col sm:justify-center sm:gap-4 sm:p-8">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-background/10 ring-1 ring-background/20 sm:size-16">
                    <LucideIconCn Name="bar-chart-3" Size="28" Class="size-7 sm:size-8" aria-hidden="true" />
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" aria-hidden="true" />
                    <p class="text-[11px] font-extrabold uppercase tracking-[0.18em]">
                        Editor's Pick
                    </p>
                </div>
            </div>

            @* RIGHT — content *@
            <div class="flex flex-col gap-4 p-6 sm:p-7">
                @* Byline — publisher · updated · tag *@
                <div>
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-muted-foreground">
                        <span class="font-semibold text-foreground">by @_featured.Publisher</span>
                        <span aria-hidden="true">·</span>
                        <span>@_featured.Updated</span>
                        <span aria-hidden="true">·</span>
                        <span class="rounded-full border bg-muted/40 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide">
                            @_featured.Tag
                        </span>
                    </div>
                    <h3 class="mt-2 text-xl font-bold tracking-tight sm:text-2xl">@_featured.Name</h3>
                    <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                        @_featured.Description
                    </p>
                </div>

                @* Metrics row — rating stars + numeric + reviews + install count *@
                <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-xs">
                    <div class="flex items-center gap-1.5">
                        <div class="flex gap-0.5">
                            @foreach (var n in _starPositions)
                            {
                                var starN = n;
                                <LucideIconCn
                                    Name="star"
                                    Size="14"
                                    Class="@Cn.Merge("size-3.5", starN <= (int)Math.Round(_featured.Rating) ? "fill-amber-400 text-amber-400" : "fill-none text-muted-foreground/30")"
                                    aria-hidden="true" />
                            }
                        </div>
                        <span class="font-semibold tabular-nums">@_featured.Rating</span>
                        <span class="text-muted-foreground tabular-nums">
                            (@_featured.Reviews reviews)
                        </span>
                    </div>
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideIconCn Name="download" Size="14" Class="size-3.5" aria-hidden="true" />
                        <span class="tabular-nums">@_featured.Installs installs</span>
                    </div>
                </div>

                @* Feature tag chips *@
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var tag in _featured.Tags)
                    {
                        <span class="rounded-full border bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                            @tag
                        </span>
                    }
                </div>

                @* Price + install CTA — divider above for weight.
                   Mobile: stacked price above full-width button. Desktop: inline. *@
                <div class="flex flex-col gap-3 border-t pt-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold tracking-tight tabular-nums sm:text-4xl">
                            $@_featured.Price
                        </span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 sm:w-[200px]">
                        Install add-on
                    </ButtonCn>
                </div>
            </div>
        </div>
    </article>

    @* Category shelves — editorial "shelf" pattern like an app store home page *@
    <div class="mt-10 space-y-10">
        @foreach (var cat in _categories)
        {
            var category = cat;
            <section>
                @* Shelf header with "See all" link *@
                <div class="flex items-end justify-between gap-4">
                    <div class="min-w-0">
                        <h3 class="text-sm font-semibold tracking-tight">@category.Label</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">@category.Description</p>
                    </div>
                    <button
                        type="button"
                        class="group inline-flex shrink-0 items-center gap-1 text-[11px] font-medium text-muted-foreground transition-colors hover:text-foreground">
                        See all
                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                    </button>
                </div>

                @* Tile grid — 3-col on lg, single column on smaller screens. *@
                <div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-3">
                    @foreach (var ad in category.Addons)
                    {
                        var addon = ad;
                        <article class="flex h-full flex-col gap-3 rounded-xl border bg-muted/60 p-4 transition-colors hover:border-foreground/30">
                            @* Top row: icon + (name + publisher) + tag *@
                            <div class="flex items-start gap-3">
                                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-muted/50">
                                    <LucideIconCn Name="@addon.IconName" Size="20" Class="size-5 text-foreground" aria-hidden="true" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="truncate text-sm font-semibold tracking-tight">
                                        @addon.Name
                                    </h4>
                                    <p class="truncate text-[11px] text-muted-foreground">
                                        by @addon.Publisher
                                    </p>
                                </div>
                                <span class="shrink-0 rounded-full border bg-muted/40 px-1.5 py-0.5 text-[9px] font-medium uppercase tracking-wide text-muted-foreground">
                                    @addon.Tag
                                </span>
                            </div>

                            @* Tagline — min-h keeps baselines aligned across tiles *@
                            <p class="min-h-[2rem] text-xs text-muted-foreground leading-relaxed">
                                @addon.Tagline
                            </p>

                            @* Rating + reviews + installs *@
                            <div class="flex items-center gap-2 text-[11px] text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" aria-hidden="true" />
                                    <span class="font-semibold text-foreground tabular-nums">
                                        @addon.Rating
                                    </span>
                                    <span class="tabular-nums">(@addon.Reviews)</span>
                                </span>
                                <span aria-hidden="true">·</span>
                                <span class="flex items-center gap-1 tabular-nums">
                                    <LucideIconCn Name="download" Size="12" Class="size-3" aria-hidden="true" />
                                    @addon.Installs
                                </span>
                            </div>

                            @* Price row — mt-auto pins to bottom, border-t divides *@
                            <div class="mt-auto flex items-baseline gap-0.5 border-t pt-3">
                                <span class="text-lg font-bold tracking-tight tabular-nums">
                                    $@addon.Price
                                </span>
                                <span class="text-[11px] text-muted-foreground">/mo</span>
                            </div>

                            @* Full-width install CTA *@
                            <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                                Install
                            </ButtonCn>
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    @* Footer trust text *@
    <p class="mt-10 text-center text-xs text-muted-foreground">
        Every add-on ships with a 14-day free trial. Bundle any three and save 15%.
    </p>
</section>

@code {
    private static readonly int[] _starPositions = [1, 2, 3, 4, 5];

    private record FeaturedAddon(
        string Id, string Name, string Publisher, string Tagline, string Description,
        string IconName, double Rating, string Reviews, string Installs,
        int Price, string Tag, string[] Tags, string Updated);

    private record MarketplaceAddon(
        string Id, string Name, string Publisher, string Tagline,
        string IconName, double Rating, string Reviews, string Installs,
        int Price, string Tag);

    private record CategoryShelf(string Id, string Label, string Description, MarketplaceAddon[] Addons);

    private static readonly FeaturedAddon _featured = new(
