@* ============================================================
   Block: pricing-roi-calculator
   Title: PricingRoiCalculator
   Description: An interactive ROI calculator pricing section for React and Next.js with split layout featuring marketing headline and three key stat highlights on the left, an interactive calculator card with team size and hours saved sliders on the right computing NumberFlow animated monthly savings versus product cost, and a ShadcnioButton CTA built with shadcn/ui Slider, Input, and Tailwind CSS
   Source: original/blocks/pricing/pricing-roi-calculator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid gap-10 lg:grid-cols-5 lg:gap-12">
        @* Left side: headline + stats — 2 of 5 columns *@
        <div class="flex flex-col justify-center lg:col-span-2">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                ROI Calculator
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                See the dollar value of every hour saved
            </h2>
            <p class="mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
                Drag the sliders to model your team. We'll show the real monthly return based on a $@HourlyCost/hr fully-loaded cost.
            </p>

            @* Key stats — vertical list with bold numbers *@
            <div class="mt-8 space-y-5">
                @foreach (var stat in _stats)
                {
                    <div class="flex items-baseline gap-4 border-l-2 border-foreground/10 pl-4">
                        <div class="flex items-baseline tabular-nums">
                            <span class="text-3xl font-bold tracking-tight">@stat.Value</span>
                            <span class="text-2xl font-bold">@stat.Suffix</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-semibold">@stat.Label</p>
                            <p class="text-xs text-muted-foreground">@stat.Description</p>
                        </div>
                    </div>
                }
            </div>

            @* Trust indicators *@
            <ul class="mt-8 space-y-2">
                @foreach (var point in _trustPoints)
                {
                    <li class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        @point
                    </li>
                }
            </ul>
        </div>

        @* Right side: calculator card — 3 of 5 columns *@
        <div class="lg:col-span-3">
            <div class="rounded-2xl bg-muted p-6 sm:p-8">
                @* Card header *@
                <div class="flex items-center gap-2.5">
                    <div class="flex size-9 items-center justify-center rounded-xl bg-foreground/5">
                        <LucideIconCn Name="calculator" Size="16" Class="size-4" />
                    </div>
                    <div>
                        <h3 class="text-lg font-bold tracking-tight">Calculate your savings</h3>
                        <p class="text-xs text-muted-foreground">Adjust to match your team</p>
                    </div>
                </div>

                @* Sliders *@
                <div class="mt-7 space-y-6">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5 text-sm font-semibold">
                                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                                Team size
                            </span>
                            <span class="text-base font-bold tabular-nums">
                                @_teamSize <span class="text-xs font-medium text-muted-foreground">@(_teamSize == 1 ? "member" : "members")</span>
                            </span>
                        </div>
                        <SliderCn Class="mt-3"
                                  Value="@((double)_teamSize)"
                                  ValueChanged="@((double v) => { _teamSize = (int)v; })"
                                  Min="1" Max="50" Step="1" />
                        <div class="mt-1.5 flex justify-between text-[10px] font-medium text-muted-foreground">
                            <span>1</span>
                            <span>50</span>
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5 text-sm font-semibold">
                                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                                Hours saved per person / week
                            </span>
                            <span class="text-base font-bold tabular-nums">
                                @_hoursSaved <span class="text-xs font-medium text-muted-foreground">hrs</span>
                            </span>
                        </div>
                        <SliderCn Class="mt-3"
                                  Value="@((double)_hoursSaved)"
                                  ValueChanged="@((double v) => { _hoursSaved = (int)v; })"
                                  Min="1" Max="20" Step="1" />
                        <div class="mt-1.5 flex justify-between text-[10px] font-medium text-muted-foreground">
                            <span>1</span>
                            <span>20</span>
                        </div>
                    </div>
                </div>

                @* Result breakdown *@
                <div class="mt-7 rounded-xl bg-background p-5 ring-1 ring-inset ring-border">
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-muted-foreground">Monthly time savings value</span>
                            <span class="font-semibold tabular-nums">$@((int)Math.Round(_monthlyTimeSavings)).ToString("N0")</span>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-muted-foreground">Product cost</span>
                            <span class="font-semibold tabular-nums">−$@ProductCost</span>
                        </div>
                    </div>

                    <div class="my-4 h-px bg-border"></div>

                    <div class="flex items-end justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                Net monthly savings
                            </p>
                            <div class="mt-1 flex items-baseline gap-1">
                                <span class="text-3xl font-bold tabular-nums text-emerald-600 dark:text-emerald-500">$@((int)Math.Round(_netMonthlySavings)).ToString("N0")</span>
                                <span class="text-xs text-muted-foreground">/month</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1.5 text-emerald-700 dark:text-emerald-400">
                            <LucideIconCn Name="trending-up" Size="14" Class="size-3.5" />
                            <span class="text-xs font-bold tabular-nums">@_roiMultiplier.ToString("F1")x ROI</span>
                        </div>
                    </div>

                    <p class="mt-3 text-[11px] text-muted-foreground">
                        Annual net return: <span class="font-semibold text-foreground tabular-nums">$@((int)Math.Round(_annualSavings)).ToString("N0")/yr</span>
                    </p>
                </div>

                @* CTA *@
                <ButtonCn Class="mt-6 w-full">Start free trial</ButtonCn>

                <p class="mt-3 text-center text-xs text-muted-foreground">
                    Based on $@HourlyCost/hr fully-loaded cost · No credit card required
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private const int ProductCost = 79;
    private const int HourlyCost = 65;
    private const double WeeksPerMonth = 4.33;

    private int _teamSize = 8;
    private int _hoursSaved = 5;

    private double _monthlyTimeSavings => _teamSize * _hoursSaved * WeeksPerMonth * HourlyCost;
    private double _netMonthlySavings => _monthlyTimeSavings - ProductCost;
    private double _annualSavings => _netMonthlySavings * 12;
    private double _roiMultiplier => ProductCost > 0 ? _monthlyTimeSavings / ProductCost : 0;

    private record StatItem(string Label, int Value, string Suffix, string Description);

    private static readonly StatItem[] _stats =
    [
        new("Average ROI", 12, "x", "return within the first 6 months"),
        new("Time reclaimed", 40, "%", "fewer hours on manual workflows"),
        new("Payback period", 18, "d", "for teams of 5 or more members"),
    ];

    private static readonly string[] _trustPoints =
    [
        "Used by 2,400+ engineering teams",
        "14-day free trial · No credit card",
        "Cancel anytime, refund guaranteed",
    ];
}
