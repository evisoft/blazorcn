@* ============================================================
   Block: pricing-education-discount
   Title: PricingEducationDiscount
   Description: A three-column strikethrough pricing section for React and Next.js where every card shows the original price crossed out next to a discounted price with an emerald savings line, progressive feature lists, a red Best Value badge on the middle card, and ShadcnioButton CTAs built with shadcn/ui Tooltip components and Tailwind CSS
   Source: original/blocks/pricing/pricing-education-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">

    @* Header *@
    <div class="text-center">
        <div class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1">
            <LucideIconCn Name="graduation-cap" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
            <span class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Education Pricing
            </span>
        </div>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">40% off for academia</h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Verified students, faculty, and institutions get an exclusive discount on every plan. No
            credit card required to verify.
        </p>
    </div>

    @* Plan grid *@
    <TooltipProviderCn Delay="200">
        <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
            @foreach (var plan in _plans)
            {
                var savings = plan.OriginalPrice - plan.DiscountedPrice;
                var discountPercent = (int)Math.Round((double)savings / plan.OriginalPrice * 100);
                <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl bg-muted p-6", plan.IsPopular ? "ring-2 ring-foreground/10" : "")">

                    @* Reserved badge slot — rendered on every card so headings align *@
                    <div class="mb-4 flex h-7 items-start">
                        @if (plan.IsPopular)
                        {
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                Best Value
                            </span>
                        }
                    </div>

                    @* Plan name + description *@
                    <div>
                        <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                        <p class="mt-1.5 min-h-[2.75rem] text-sm text-muted-foreground leading-relaxed">
                            @plan.Description
                        </p>
                    </div>

                    @* Price block — fixed-height price row for layout stability *@
                    <div class="mt-6">
                        <div class="flex h-12 items-baseline gap-2 sm:h-14">
                            <s aria-hidden="true" class="text-lg text-muted-foreground/70 tabular-nums">
                                $@plan.OriginalPrice
                            </s>
                            <span class="text-4xl font-bold tabular-nums tracking-tight sm:text-5xl">
                                $@plan.DiscountedPrice
                            </span>
                            <span class="text-sm text-muted-foreground">@plan.Period</span>
                        </div>
                        <p class="mt-2 text-sm font-bold text-emerald-600 dark:text-emerald-500">
                            Save $@(savings)/mo · -@(discountPercent)%
                        </p>
                    </div>

                    @* CTA *@
                    <div class="mt-6">
                        <ButtonCn Class="w-full">@plan.Cta</ButtonCn>
                    </div>

                    @* Feature heading *@
                    <p class="mt-7 text-sm font-semibold">@plan.FeatureHeading</p>

                    @* Features *@
                    <ul class="mt-4 flex-1 space-y-3">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start justify-between gap-2">
                                <span class="flex items-start gap-2.5">
                                    <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" StrokeWidth="3" />
                                    <span class="text-sm font-medium leading-snug text-foreground">
                                        @feature.Name
                                    </span>
                                </span>
                                @if (feature.Tooltip != null)
                                {
                                    <TooltipCn>
                                        <TooltipTriggerCn Tabbable="false">
                                            <button type="button" aria-label="@($"More info about {feature.Name}")" class="mt-1 cursor-help">
                                                <LucideIconCn Name="info" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40 transition-colors hover:text-muted-foreground" />
                                            </button>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Class="max-w-[220px]">
                                            <p class="text-xs">@feature.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                }
                            </li>
                        }
                    </ul>
                </article>
            }
        </div>
    </TooltipProviderCn>

    @* Footer trust line *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        Accepted: .edu, .ac.uk, .edu.au, GitHub Student Pack, ISIC cards. 14-day free trial on all
        plans.
    </p>
</section>

