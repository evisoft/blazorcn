@* ========================================
   Block: pricing-with-calculator
   Title: Pricing With Calculator
   Description: Multi-dimension cost calculator with sliders for seats, storage, and API calls that computes a dynamic total estimate
   Long Description: Dynamic pricing with usage slider
   Dependencies: LucideCalculatorCn, LucideHardDriveCn, LucideServerCn, LucideUsersCn
   Source: original/blocks/pricing/pricing-with-calculator.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Class="mb-4 gap-1.5" Variant="BadgeVariant.Secondary">
                <LucideCalculatorCn Class="h-3 w-3" Size="12" />
                Cost Calculator
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Estimate your monthly cost
            </h2>
            <p class="text-muted-foreground text-lg">
                Adjust the sliders to match your usage. Pay only for what you need.
            </p>
        </div>

        <div class="mx-auto max-w-2xl">
            <CardCn>
                <CardHeaderCn Class="text-center">
                    <div class="text-muted-foreground mb-1 text-sm font-medium">Estimated monthly cost</div>
                    <div class="flex items-baseline justify-center gap-1">
                        <span class="text-5xl font-bold tracking-tight">$@((int)Math.Round(_totalMonthly))</span>
                        <span class="text-muted-foreground text-sm">/month</span>
                    </div>
                </CardHeaderCn>

                <CardContentCn Class="space-y-8">
                    <SeparatorCn />

                    @* Seats *@
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideUsersCn Class="text-muted-foreground h-4 w-4" Size="16" />
                                <span class="text-sm font-medium">Team members</span>
                            </div>
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-semibold">@((int)_seats) seat@((int)_seats != 1 ? "s" : "")</span>
                                <span class="text-muted-foreground text-xs">($@((_seats * 12).ToString("F2"))/mo)</span>
                            </div>
                        </div>
                        <SliderCn Value="@_seats" ValueChanged="@((double v) => _seats = v)" Min="1" Max="100" Step="1" />
                        <div class="text-muted-foreground flex justify-between text-xs">
                            <span>1 seat</span>
                            <span>100 seats</span>
                        </div>
                    </div>

                    @* Storage *@
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideHardDriveCn Class="text-muted-foreground h-4 w-4" Size="16" />
                                <span class="text-sm font-medium">Storage</span>
                            </div>
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-semibold">@(_storage >= 1000 ? $"{(int)_storage / 1000} TB" : $"{(int)_storage} GB")</span>
                                <span class="text-muted-foreground text-xs">($@((_storage * 0.15).ToString("F2"))/mo)</span>
                            </div>
                        </div>
                        <SliderCn Value="@_storage" ValueChanged="@((double v) => _storage = v)" Min="10" Max="1000" Step="10" />
                        <div class="text-muted-foreground flex justify-between text-xs">
                            <span>10 GB</span>
                            <span>1 TB</span>
                        </div>
                    </div>

                    @* API calls *@
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideServerCn Class="text-muted-foreground h-4 w-4" Size="16" />
                                <span class="text-sm font-medium">API calls</span>
                            </div>
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-semibold">@(_api >= 1000 ? $"{(int)_api / 1000}M/mo" : $"{(int)_api}K/mo")</span>
                                <span class="text-muted-foreground text-xs">($@((_api * 0.05).ToString("F2"))/mo)</span>
                            </div>
                        </div>
                        <SliderCn Value="@_api" ValueChanged="@((double v) => _api = v)" Min="10" Max="1000" Step="10" />
                        <div class="text-muted-foreground flex justify-between text-xs">
                            <span>10K/mo</span>
                            <span>1M/mo</span>
                        </div>
                    </div>

                    <SeparatorCn />

                    @* Cost breakdown *@
                    <div class="space-y-2">
                        <h3 class="mb-3 text-sm font-semibold">Cost breakdown</h3>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-muted-foreground">Platform base fee</span>
                            <span class="font-medium">$29.00</span>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-muted-foreground">Team members (@((int)_seats) seat@((int)_seats != 1 ? "s" : ""))</span>
                            <span class="font-medium">$@((_seats * 12).ToString("F2"))</span>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-muted-foreground">Storage (@(_storage >= 1000 ? $"{(int)_storage / 1000} TB" : $"{(int)_storage} GB"))</span>
                            <span class="font-medium">$@((_storage * 0.15).ToString("F2"))</span>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-muted-foreground">API calls (@(_api >= 1000 ? $"{(int)_api / 1000}M/mo" : $"{(int)_api}K/mo"))</span>
                            <span class="font-medium">$@((_api * 0.05).ToString("F2"))</span>
                        </div>
                        <SeparatorCn />
                        <div class="flex items-center justify-between text-sm font-semibold">
                            <span>Total per month</span>
                            <span>$@_totalMonthly.ToString("F2")</span>
                        </div>
                    </div>

                    @* CTA *@
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <ButtonCn Class="flex-1" Size="ButtonSize.Lg">Start Free Trial</ButtonCn>
                        <ButtonCn Class="flex-1" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">Talk to Sales</ButtonCn>
                    </div>

                    <p class="text-muted-foreground text-center text-xs">
                        Estimates based on current usage. Actual costs may vary. Overages billed at standard rates.
                    </p>
                </CardContentCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private const double _baseFee = 29;
    private double _seats = 10;
    private double _storage = 100;
    private double _api = 100;

    private double _totalMonthly => _baseFee + Math.Round(_seats * 12 * 100) / 100 + Math.Round(_storage * 0.15 * 100) / 100 + Math.Round(_api * 0.05 * 100) / 100;
}
