@* ============================================================
   Block: pricing-feature-heatmap
   Title: PricingFeatureHeatmap
   Description: A feature heatmap pricing section for React and Next.js with a feature by plan grid where each cell uses graded color intensity and numeric level indicator to show inclusion depth instead of binary checkmarks plus a NumberFlow animated price row and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-feature-heatmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Depth over checkmarks
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Every plan, every feature, at a glance
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
            Most comparison tables lie — every box gets a checkmark even when the feature barely
            works. Here you see exactly how deep each plan goes.
        </p>
    </div>

    @* Legend *@
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        @foreach (var lvl in new int[] { 0, 1, 2, 3 })
        {
            <div class="flex items-center gap-2">
                <span class="@Cn.Merge("flex size-5 items-center justify-center rounded border border-foreground/10 font-mono text-[10px] font-bold tabular-nums", LevelToCell(lvl, false), LevelToText(lvl))">
                    @lvl
                </span>
                <span class="text-[11px] font-medium text-muted-foreground">
                    @_levelLabels[lvl]
                </span>
            </div>
        }
    </div>

    @* Heatmap card *@
    <div class="mt-6 overflow-hidden rounded-2xl border border-foreground/10 bg-muted">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] table-fixed">
                <colgroup>
                    <col class="w-[34%]" />
                    <col class="w-[22%]" />
                    <col class="w-[22%]" />
                    <col class="w-[22%]" />
                </colgroup>
                <thead>
                    <tr class="border-b border-foreground/10">
                        <th scope="col" class="px-5 pb-5 pt-6 text-left align-top">
                            <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                                Feature
                            </p>
                        </th>
                        @foreach (var plan in _plans)
                        {
                            <th scope="col" class="@Cn.Merge("px-4 pb-5 pt-6 text-center align-top", plan.IsPopular ? "bg-foreground/5" : "")">
                                <div class="flex h-5 items-center justify-center">
                                    @if (plan.IsPopular)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-red-500 px-2.5 py-0.5 text-[9px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                            Best Value
                                        </span>
                                    }
                                </div>
                                <h3 class="mt-2 text-base font-bold tracking-tight">@plan.Name</h3>
                                <p class="mt-0.5 text-[10px] uppercase tracking-wider text-muted-foreground">
                                    @plan.Tagline
                                </p>
                                <div class="mt-2.5 flex items-baseline justify-center gap-0.5">
                                    <span class="text-xl font-bold tracking-tight tabular-nums">$@plan.MonthlyPrice</span>
                                    <span class="text-[10px] text-muted-foreground">/mo</span>
                                </div>
                                <ButtonCn Size="ButtonSize.Sm" Class="mt-3 w-full">
                                    @plan.Cta
                                </ButtonCn>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grp in _featureGroups)
                    {
                        <tr class="border-b border-foreground/10 bg-foreground/5">
                            <th scope="rowgroup" colspan="4" class="px-5 py-2 text-left text-[10px] font-extrabold uppercase tracking-widest text-muted-foreground">
                                @grp.Title
                            </th>
                        </tr>
                        @foreach (var row in grp.Rows)
                        {
                            var rowKey = $"{grp.Title}-{row.Label}";
                            var isHovered = _hoveredRow == rowKey;
                            <tr @onmouseenter="@(() => _hoveredRow = rowKey)"
                                @onmouseleave="@(() => _hoveredRow = null)"
                                @onfocus="@(() => _hoveredRow = rowKey)"
                                @onblur="@(() => _hoveredRow = null)"
                                class="@Cn.Merge("border-b border-foreground/5 transition-colors", isHovered ? "bg-foreground/[0.03]" : "")">
                                <th scope="row" class="px-5 py-3 text-left align-middle text-xs font-medium text-foreground">
                                    @row.Label
                                </th>
                                @foreach (var plan in _plans)
                                {
                                    var level = row.Levels.GetValueOrDefault(plan.Id, 0);
                                    <td class="@Cn.Merge("px-3 py-2 text-center", plan.IsPopular ? "bg-foreground/5" : "")">
                                        <div role="img"
                                             aria-label="@($"{plan.Name} {row.Label}: {_levelLabels[level]}")"
                                             class="@Cn.Merge("mx-auto flex h-8 w-full max-w-[82px] items-center justify-center rounded-md border border-foreground/10 font-mono text-xs font-bold tabular-nums transition-transform", LevelToCell(level, plan.IsPopular), LevelToText(level), isHovered ? "scale-105" : "")">
                                            @level
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include a 14-day free trial. No credit card required. Cancel anytime.
    </p>
</section>

@code {
    private string? _hoveredRow;

    private record Plan(string Id, string Name, string Tagline, int MonthlyPrice, string Cta, bool IsPopular);
    private record FeatureRow(string Label, Dictionary<string, int> Levels);
    private record FeatureGroup(string Title, FeatureRow[] Rows);

    private static readonly Dictionary<int, string> _levelLabels = new()
    {
        [0] = "Not included",
        [1] = "Limited",
        [2] = "Standard",
        [3] = "Full",
    };

    private static readonly Plan[] _plans =
    [
        new("starter", "Starter", "Solo builders", 19, "Start free trial", false),
        new("growth", "Growth", "Scaling teams", 99, "Start free trial", true),
        new("enterprise", "Enterprise", "Mission-critical", 399, "Contact sales", false),
    ];

    private static readonly FeatureGroup[] _featureGroups =
    [
        new("Collaboration",
        [
            new("Real-time editing",   new() { ["starter"] = 1, ["growth"] = 3, ["enterprise"] = 3 }),
            new("Team members",        new() { ["starter"] = 1, ["growth"] = 2, ["enterprise"] = 3 }),
            new("Permissions and roles", new() { ["starter"] = 0, ["growth"] = 2, ["enterprise"] = 3 }),
            new("Guest access",        new() { ["starter"] = 0, ["growth"] = 1, ["enterprise"] = 3 }),
        ]),
        new("Analytics",
        [
            new("Usage dashboard",     new() { ["starter"] = 1, ["growth"] = 2, ["enterprise"] = 3 }),
            new("Event tracking",      new() { ["starter"] = 1, ["growth"] = 3, ["enterprise"] = 3 }),
            new("Custom reports",      new() { ["starter"] = 0, ["growth"] = 2, ["enterprise"] = 3 }),
            new("Data export",         new() { ["starter"] = 0, ["growth"] = 1, ["enterprise"] = 3 }),
        ]),
        new("Integrations",
        [
            new("Native integrations", new() { ["starter"] = 2, ["growth"] = 3, ["enterprise"] = 3 }),
            new("Webhooks",            new() { ["starter"] = 1, ["growth"] = 2, ["enterprise"] = 3 }),
            new("API rate limit",      new() { ["starter"] = 1, ["growth"] = 2, ["enterprise"] = 3 }),
        ]),
        new("Security",
        [
            new("SSO and SAML",        new() { ["starter"] = 0, ["growth"] = 1, ["enterprise"] = 3 }),
            new("Audit logs",          new() { ["starter"] = 0, ["growth"] = 2, ["enterprise"] = 3 }),
            new("Compliance certs",    new() { ["starter"] = 1, ["growth"] = 2, ["enterprise"] = 3 }),
            new("Encryption at rest",  new() { ["starter"] = 2, ["growth"] = 3, ["enterprise"] = 3 }),
        ]),
    ];

    private static string LevelToCell(int level, bool isPopular)
    {
        var opacityClass = level switch
        {
            0 => "bg-foreground/[0.02]",
            1 => "bg-emerald-500/10",
            2 => "bg-emerald-500/25",
            3 => "bg-emerald-500/45",
            _ => "bg-foreground/[0.02]",
        };
        var popularRing = isPopular ? "ring-1 ring-foreground/5" : "";
        return Cn.Merge(opacityClass, popularRing);
    }

    private static string LevelToText(int level)
    {
        if (level == 0) return "text-muted-foreground/50";
        if (level == 1) return "text-emerald-700 dark:text-emerald-400";
        return "text-emerald-700 dark:text-emerald-300";
    }
}
