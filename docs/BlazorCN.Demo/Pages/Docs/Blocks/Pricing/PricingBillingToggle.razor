@* ========================================
   Block: pricing-billing-toggle
   Title: Pricing Billing Toggle
   Description: Pricing section with monthly and yearly billing toggle, savings badge, and animated price transitions for React SaaS pages
   Long Description: Classic three tier pricing cards layout
   Dependencies: BadgeCn, ButtonCn, CardCn, SwitchCn
   Source: original/blocks/pricing/pricing-billing-toggle.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Invest in your workflow
            </h2>
            <p class="text-muted-foreground mb-8 text-lg">
                Start free, upgrade when you need more. Cancel anytime.
            </p>

            <div class="flex items-center justify-center gap-3">
                <span class="@Cn.Merge("text-sm font-medium transition-colors", !_isAnnual ? "text-foreground" : "text-muted-foreground")">
                    Monthly
                </span>
                <SwitchCn aria-label="Toggle annual billing" Checked="@_isAnnual" CheckedChanged="@(v => _isAnnual = v)" />
                <span class="@Cn.Merge("text-sm font-medium transition-colors", _isAnnual ? "text-foreground" : "text-muted-foreground")">
                    Annual
                </span>
                @if (_isAnnual)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1">
                        <LucideSparklesCn Size="12" />
                        Save up to 25%
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                var price = _isAnnual ? plan.AnnualPrice : plan.MonthlyPrice;
                var isFree = plan.MonthlyPrice == 0;
                <CardCn Class="@Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20 md:scale-105" : "border-border")">
                    @if (plan.IsPopular)
                    {
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                            <BadgeCn>Recommended</BadgeCn>
                        </div>
                    }
                    <CardHeaderCn Class="pb-4">
                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                        <div class="mt-3 flex items-baseline gap-1">
                            <span class="text-4xl font-bold tracking-tight transition-all duration-300">
                                $@price
                            </span>
                            @if (!isFree)
                            {
                                <span class="text-muted-foreground text-sm">/month</span>
                            }
                        </div>
                        @if (!isFree && _isAnnual)
                        {
                            <p class="text-muted-foreground mt-1 text-xs">
                                Billed annually ($@(price * 12)/year)
                            </p>
                        }
                        <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                    </CardHeaderCn>
                    <CardContentCn Class="flex-1">
                        <ul class="space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Size="16" Class="text-primary mt-0.5 shrink-0" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </CardContentCn>
                    <CardFooterCn Class="pt-4">
                        <ButtonCn Class="w-full"
                                  Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Size="ButtonSize.Lg">
                            @plan.Cta
                        </ButtonCn>
                    </CardFooterCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private bool _isAnnual = true;

    private record PlanItem(string Name, int MonthlyPrice, int AnnualPrice, string Description, string[] Features, bool IsPopular, string Cta);

    private readonly PlanItem[] _plans =
    [
        new("Hobby", 0, 0, "For side projects and experimentation.",
            ["Up to 3 projects", "1 GB storage", "Community support", "Basic analytics"],
            false, "Start for Free"),
        new("Pro", 39, 29, "Everything you need to ship faster.",
            ["Unlimited projects", "100 GB storage", "Priority support", "Advanced analytics", "Custom domains", "Team members (up to 10)", "API access"],
            true, "Start Free Trial"),
        new("Business", 99, 79, "For teams that need advanced controls.",
            ["Everything in Pro", "Unlimited storage", "SSO & SAML", "Audit logs", "Dedicated support", "Custom SLA", "Advanced permissions", "On-premise option"],
            false, "Contact Sales"),
    ];
}
