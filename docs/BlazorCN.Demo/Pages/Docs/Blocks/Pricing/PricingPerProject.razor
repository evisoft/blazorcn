@* ============================================================
   Block: pricing-per-project
   Title: PricingPerProject
   Description: A four-column capacity-badge pricing section for React and Next.js with four tier cards showing uppercase capacity pill labels, NumberFlow animated prices, PillTabs billing toggle, per-unit rate breakdowns, progressive feature lists, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-per-project.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Per-Project Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Pay for the projects you need
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
            From a single site to unlimited projects. Each tier includes everything your projects need
            to ship with confidence.
        </p>

        <div class="mt-7 flex items-center justify-center gap-2">
            <button
                class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "monthly" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")"
                @onclick="@(() => _billing = "monthly")">
                Monthly
            </button>
            <button
                class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "annually" ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")"
                @onclick="@(() => _billing = "annually")">
                Annually
            </button>
        </div>
    </div>

    @* Plan grid *@
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var tier in _projectTiers)
        {
            var price = _billing == "monthly" ? tier.MonthlyPrice : tier.AnnualPrice;
            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl bg-muted p-6", tier.IsPopular ? "ring-2 ring-foreground/10" : "")">
                @* Reserved badge slot on every card *@
                <div class="mb-3 flex h-7 items-start">
                    @if (tier.IsPopular)
                    {
                        <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }
                </div>

                @* Header *@
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        @tier.ProjectCount
                    </span>
                </div>
                <h3 class="mt-3 text-2xl font-bold tracking-tight">@tier.Name</h3>
                <p class="mt-1 min-h-[2.75rem] text-sm leading-relaxed text-muted-foreground">
                    @tier.Description
                </p>

                @* Price — layout-stable container *@
                <div class="mt-5 flex min-h-[60px] flex-col">
                    <div class="flex min-w-[110px] items-baseline gap-1 tabular-nums">
                        <span class="text-4xl font-bold tracking-tight tabular-nums">$@price</span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>
                    <p class="mt-1 text-xs font-medium text-muted-foreground">
                        @tier.PerProjectRate
                    </p>
                </div>

                @* CTA *@
                <ButtonCn Size="ButtonSize.Sm" Class="mt-6 w-full">
                    @tier.Cta
                </ButtonCn>

                @* Features *@
                <div class="mt-6 flex-1 border-t border-border/60 pt-5">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        @tier.FeatureHeading
                    </p>
                    <ul class="mt-3 space-y-2.5">
                        @foreach (var feature in tier.Features)
                        {
                            <li class="flex items-center justify-between gap-2 text-sm font-medium text-foreground">
                                <span class="flex items-center gap-2">
                                    <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 text-emerald-600 stroke-[3] dark:text-emerald-500" StrokeWidth="3" />
                                    @feature.Name
                                </span>
                                @if (feature.Tooltip != null)
                                {
                                    <TooltipProviderCn Delay="200">
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <LucideIconCn Name="info" Size="12" Class="size-3 shrink-0 cursor-help text-muted-foreground/40" />
                                            </TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-[220px]">
                                                <p class="text-xs">@feature.Tooltip</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    </TooltipProviderCn>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    <p class="mt-8 text-center text-xs text-muted-foreground">
        All tiers include a 14-day free trial. No credit card required. Upgrade or downgrade
        anytime.
    </p>
</section>

@code {
    private string _billing = "monthly";

    private record ProjectFeature(string Name, string? Tooltip = null);

    private record ProjectTier(
        string Id,
        string Name,
        string ProjectCount,
        int MonthlyPrice,
        int AnnualPrice,
        string PerProjectRate,
        string Description,
        string FeatureHeading,
        ProjectFeature[] Features,
        string Cta,
        bool IsPopular);

    private static readonly ProjectTier[] _projectTiers =
    [
        new("solo", "Solo", "1 project", 9, 7, "$9 per project",
            "Perfect for a single site or side project.",
            "What's included:",
            [
                new("1 production environment"),
                new("2 collaborators"),
                new("5 GB storage / project", "Storage for assets, uploads, and database. Includes global CDN distribution."),
                new("Custom domain & SSL"),
                new("Git deployments"),
            ],
            "Start free trial", false),
        new("starter", "Starter", "5 projects", 29, 23, "$5.80 per project",
            "For freelancers managing client sites.",
            "Everything in Solo, plus:",
            [
                new("3 environments / project", "Production, staging, and development environments with instant cloning."),
                new("5 collaborators / project"),
                new("20 GB storage / project"),
                new("Preview deployments on PRs"),
                new("Email support (24h SLA)"),
            ],
            "Start free trial", false),
        new("team", "Team", "20 projects", 69, 55, "$3.45 per project",
            "For agencies and growing product teams.",
            "Everything in Starter, plus:",
            [
                new("5 environments / project", "Production, staging, development, QA, and canary environments with branch routing."),
                new("15 collaborators / project"),
                new("100 GB storage / project"),
                new("A/B testing framework"),
                new("Priority support (4h SLA)"),
            ],
            "Start free trial", true),
        new("scale", "Scale", "Unlimited", 149, 119, "Unlimited projects",
            "For organizations with no project limits.",
            "Everything in Team, plus:",
            [
                new("Unlimited environments"),
                new("Unlimited collaborators"),
                new("500 GB storage / project"),
                new("SAML SSO & SCIM", "Connect Okta, Azure AD, or Google Workspace with automatic user provisioning."),
                new("Dedicated account manager"),
            ],
            "Contact sales", false),
    ];
}
