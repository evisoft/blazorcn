@* ============================================================
   Block: pricing-step-up
   Title: PricingStepUp
   Description: A stacked horizontal step-up pricing section for React and Next.js with sequential tier cards connected by upgrade arrows showing the progression path between tiers, animated NumberFlow prices, PillTabs billing toggle, and inline ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-step-up.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Marketing header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Step up as you grow
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            One natural upgrade path
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            Start free. Step up when you outgrow it. Every tier unlocks exactly what you need next.
        </p>

        <div class="mt-6 flex justify-center">
            <div class="inline-flex items-center rounded-full bg-muted p-1 text-sm font-medium">
                <button
                    class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _billing == "monthly" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = "monthly")"
                    aria-pressed="@(_billing == "monthly")"
                >
                    Monthly
                </button>
                <button
                    class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _billing == "annually" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _billing = "annually")"
                    aria-pressed="@(_billing == "annually")"
                >
                    Annually
                </button>
            </div>
        </div>
    </div>

    @* Stacked tier cards with step-up arrows *@
    <div class="mt-10">
        @foreach (var tier in _tiers)
        {
            var tierIndex = System.Array.IndexOf(_tiers, tier);
            var price = _billing == "monthly" ? tier.MonthlyPrice : tier.AnnualPrice;
            var isLast = tierIndex == _tiers.Length - 1;
            <div>
                <article class="@Cn.Merge("relative overflow-hidden rounded-2xl bg-muted p-6 sm:p-7", tier.IsPopular ? "ring-2 ring-foreground" : "")">
                    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-6">
                        @* Step number marker on the left *@
                        <span
                            class="flex size-10 shrink-0 items-center justify-center rounded-full bg-foreground text-base font-bold tabular-nums text-background"
                            aria-hidden="true"
                        >
                            @(tierIndex + 1)
                        </span>

                        @* Center: name + description + unlocks *@
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2.5">
                                <h3 class="text-xl font-bold tracking-tight">@tier.Name</h3>
                                @if (tier.IsPopular)
                                {
                                    <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                        Best Value
                                    </span>
                                }
                            </div>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                @tier.Description
                            </p>

                            <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                                @foreach (var unlock in tier.Unlocks)
                                {
                                    <li class="flex items-center gap-2.5">
                                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                        <span class="text-sm font-medium text-foreground">@unlock</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* Right: price + CTA — stacked on mobile, inline on sm+ *@
                    <div class="mt-6 flex flex-col items-stretch gap-3 border-t border-border/60 pt-5 sm:flex-row sm:items-center sm:justify-between sm:gap-5">
                        @if (price == null)
                        {
                            <div class="flex items-baseline gap-1.5 sm:min-w-[100px]">
                                <span class="text-3xl font-bold tracking-tight tabular-nums">Custom</span>
                            </div>
                        }
                        else if (price == 0)
                        {
                            <div class="flex items-baseline gap-1.5 sm:min-w-[100px]">
                                <span class="text-3xl font-bold tabular-nums">Free</span>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-baseline gap-1.5 sm:min-w-[100px]">
                                <span class="text-3xl font-bold tabular-nums">$@price</span>
                                <span class="text-xs text-muted-foreground">/mo</span>
                            </div>
                        }
                        <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 sm:w-[210px]">
                            @tier.Cta
                        </ButtonCn>
                    </div>
                </article>

                @* Step-up arrow + hint between cards *@
                @if (!isLast && tier.NextStepHint != null)
                {
                    <div class="flex items-center justify-center gap-3 py-4">
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-full border-2 border-dashed border-border bg-background">
                            <LucideIconCn Name="arrow-down" Size="14" Class="size-3.5 text-muted-foreground" />
                        </span>
                        <p class="text-xs italic text-muted-foreground">@tier.NextStepHint</p>
                    </div>
                }
            </div>
        }
    </div>

    @* Trust footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        All paid tiers include a 14-day free trial. Step up or down at any time. Pro-rated billing
        on every change.
    </p>
</section>

@code {
    private string _billing = "monthly";

    private record Tier(
        string Id,
        string Name,
        string Description,
        int? MonthlyPrice,
        int? AnnualPrice,
        string[] Unlocks,
        string? NextStepHint,
        string Cta,
        bool IsPopular
    );

    private static readonly Tier[] _tiers =
    [
        new("starter", "Starter",
            "Validate your idea with a working MVP. Free forever for solo builders.",
            0, 0,
            ["Up to 3 projects", "1GB storage with CDN", "Community support forum"],
            "Hit 5 team members? Step up to Growth for unlimited collaborators.",
            "Start free", false),
        new("growth", "Growth",
            "Scale your first product with your team. The most popular step up from Starter.",
            39, 29,
            ["Unlimited projects and team members", "100GB storage with global CDN", "Priority email support (4h SLA)", "Custom domains with auto-SSL"],
            "Need SSO or audit logs? Step up to Scale for compliance features.",
            "Upgrade to Growth", true),
        new("scale", "Scale",
            "Compliance and SSO for teams that handle sensitive customer data.",
            99, 79,
            ["SAML SSO with directory sync", "Audit logs with 1-year retention", "Role-based access control (RBAC)", "99.95% uptime SLA"],
            "Custom contracts or dedicated infra? Step up to Enterprise for tailored terms.",
            "Upgrade to Scale", false),
        new("enterprise", "Enterprise",
            "Custom contracts, dedicated infrastructure, and white-glove onboarding.",
            null, null,
            ["Custom contract terms and SLA", "Dedicated success engineer with QBRs", "Multi-region data residency", "SOC 2 Type II and HIPAA BAA"],
            null,
            "Contact sales", false),
    ];
}
