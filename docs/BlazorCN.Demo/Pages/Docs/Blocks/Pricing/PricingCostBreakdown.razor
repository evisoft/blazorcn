@* ============================================================
   Block: pricing-cost-breakdown
   Title: PricingCostBreakdown
   Description: A split layout pricing section for React and Next.js with a left column itemized invoice-style cost summary including line items, subtotal, annual discount, and grand total alongside a right column recommended plan card with features and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-cost-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Split layout: headline+invoice on left, recommended plan on right *@
    <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-start">
        @* LEFT: headline + invoice *@
        <div class="flex flex-col gap-8">
            @* Headline *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    Transparent Pricing
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                    No surprises,<br />
                    ever.
                </h2>
                <p class="mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
                    See exactly what you pay for. Every line item detailed so there are no hidden fees
                    or unexpected charges at renewal.
                </p>
            </div>

            @* Invoice card *@
            <div class="overflow-hidden rounded-2xl bg-muted">
                @* Invoice header *@
                <div class="flex items-center justify-between border-b border-border/60 px-6 py-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                            Estimate
                        </p>
                        <p class="mt-0.5 text-sm font-semibold">Your monthly bill</p>
                    </div>
                    <span class="rounded-full bg-foreground/5 px-2.5 py-1 font-mono text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        USD
                    </span>
                </div>

                @* Line items *@
                <ul class="divide-y divide-border/60">
                    @foreach (var item in _lineItems)
                    {
                        <li class="flex items-center justify-between gap-3 px-6 py-3.5">
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-semibold leading-snug">@item.Label</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">@item.Description</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-4">
                                <span class="font-mono text-[11px] font-medium text-muted-foreground tabular-nums">
                                    × @item.Quantity
                                </span>
                                <span class="w-14 text-right text-sm font-semibold tabular-nums">
                                    $@item.Total
                                </span>
                            </div>
                        </li>
                    }
                </ul>

                @* Subtotal + Discount *@
                <div class="space-y-2 border-t border-border/60 px-6 py-4">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="font-medium tabular-nums">$@_subtotal/mo</span>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2">
                            <span>Annual discount</span>
                            <span class="rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-bold text-emerald-700 dark:text-emerald-400">
                                -@_discountPercent%
                            </span>
                        </span>
                        <span class="font-medium tabular-nums text-emerald-600 dark:text-emerald-500">
                            -$@_discountAmount/mo
                        </span>
                    </div>
                </div>

                @* Total *@
                <div class="flex items-center justify-between border-t border-border/60 bg-foreground/5 px-6 py-5">
                    <div>
                        <p class="text-sm font-semibold">Total due monthly</p>
                        <p class="mt-0.5 text-[11px] text-muted-foreground">
                            Billed annually as $@_annualTotal.ToString("N0")/year
                        </p>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold tracking-tight tabular-nums sm:text-4xl">
                            $@_total
                        </span>
                        <span class="text-sm text-muted-foreground">/mo</span>
                    </div>
                </div>
            </div>
        </div>

        @* RIGHT: recommended plan card (dark) *@
        <article class="relative flex flex-col gap-5 rounded-2xl bg-foreground p-6 text-background sm:p-8 lg:sticky lg:top-4">
            @* Badge *@
            <span class="absolute right-6 top-6 inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                Recommended
            </span>

            @* Plan name *@
            <div>
                <h3 class="text-2xl font-bold tracking-tight">Pro Plan</h3>
                <p class="mt-1 text-sm leading-relaxed text-background/70">
                    The complete package for growing teams. Everything you need to ship with confidence.
                </p>
            </div>

            @* Price *@
            <div>
                <div class="flex items-baseline gap-1.5">
                    <span class="text-5xl font-bold tracking-tight tabular-nums">$@_total</span>
                    <span class="text-sm text-background/60">/month</span>
                </div>
                <p class="mt-1 text-xs text-background/60">With 20% annual discount applied</p>
            </div>

            @* CTA *@
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90">
                Purchase plan
            </ButtonCn>

            @* Features *@
            <div class="border-t border-background/10 pt-5">
                <p class="text-sm font-medium">What's included:</p>
                <ul class="mt-4 space-y-3">
                    @foreach (var feature in _recommendedFeatures)
                    {
                        <li class="flex items-start justify-between gap-2">
                            <span class="flex items-start gap-2.5">
                                <LucideCheckCn aria-hidden="true" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-400" Size="16" />
                                <span class="text-sm font-medium leading-snug">@feature.Name</span>
                            </span>
                            @if (!string.IsNullOrEmpty(feature.Tooltip))
                            {
                                <button type="button"
                                        aria-label="@($"More info about {feature.Name}")"
                                        class="mt-0.5 shrink-0 cursor-help text-background/40 hover:text-background/70">
                                    <LucideInfoCn Class="size-3.5" Size="14" />
                                </button>
                            }
                        </li>
                    }
                </ul>
            </div>

            @* Trust note *@
            <p class="mt-1 text-center text-[11px] text-background/50">
                14-day free trial. Cancel anytime. No credit card required.
            </p>
        </article>
    </div>
</section>

@code {
    private record LineItem(string Id, string Label, string Description, int Quantity, int UnitPrice, int Total);
    private record PlanFeature(string Name, string Tooltip = "");

    private const int _discountPercent = 20;

    private static readonly LineItem[] _lineItems =
    [
        new("base",    "Pro Plan",           "Base subscription, 1 seat included", 1, 49, 49),
        new("seats",   "Additional Seats",   "$12 per seat per month",             4, 12, 48),
        new("storage", "Storage Upgrade",    "100GB add-on block",                 2, 15, 30),
        new("support", "Priority Support",   "4-hour SLA upgrade",                 1, 29, 29),
        new("api",     "API Access",         "100K requests per month",            1, 19, 19),
    ];

    private static readonly int _subtotal = 175;        // 49+48+30+29+19
    private static readonly int _discountAmount = 35;   // round(175 * 0.20)
    private static readonly int _total = 140;           // 175 - 35
    private static readonly int _annualTotal = 1680;    // 140 * 12

    private static readonly PlanFeature[] _recommendedFeatures =
    [
        new("5 team members (1 base + 4 additional)"),
        new("250GB total storage with global CDN",    "50GB base + 200GB from add-on blocks. Served from 40+ edge locations."),
        new("Unlimited projects and deployments"),
        new("Priority support with 4-hour SLA",      "Guaranteed first response within 4 business hours. Dedicated support queue."),
        new("100K API requests per month"),
        new("Advanced analytics with funnels"),
        new("Custom domains with auto-SSL",           "Connect unlimited custom domains with automatic certificate provisioning."),
    ];
}
