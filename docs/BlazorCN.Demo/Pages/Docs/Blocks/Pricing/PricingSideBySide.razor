@* ============================================================
   Block: pricing-side-by-side
   Title: PricingSideBySide
   Description: A two-plan side-by-side comparison pricing section for React and Next.js with Free vs Pro layout, NumberFlow animated prices, PillTabs billing toggle, dark featured Pro card with inverted styling, checkmarks vs x-marks comparison, ShadcnioButton CTAs, and progressive feature lists built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-side-by-side.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Start free. Upgrade when you ship.
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            Two plans, zero gotchas. Use Hobby forever or upgrade to Pro for the features serious
            teams need.
        </p>

        <div class="mt-6 flex items-center justify-center">
            @* PillTabs billing toggle — rendered as raw styled toggle *@
            <div class="inline-flex items-center rounded-full bg-muted p-1 text-sm font-medium">
                <button type="button"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _billing == "monthly" ? "bg-background shadow text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _billing = "monthly")">
                    Monthly
                </button>
                <button type="button"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _billing == "annually" ? "bg-background shadow text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _billing = "annually")">
                    Annually
                </button>
            </div>
        </div>
    </div>

    @* Plan grid *@
    <TooltipProviderCn DelayDuration="200">
        <div class="mt-10 grid gap-4 md:grid-cols-2 md:items-stretch">
            @* Hobby card *@
            <article class="flex h-full flex-col rounded-2xl bg-muted p-6 sm:p-8">
                <div>
                    <h3 class="text-2xl font-bold tracking-tight">Hobby</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        For personal projects and learning. Free forever.
                    </p>
                </div>

                <div class="mt-6 flex items-baseline gap-1.5">
                    <span class="text-4xl font-bold tracking-tight tabular-nums">$0</span>
                    <span class="text-sm text-muted-foreground">forever</span>
                </div>
                <p class="mt-1.5 text-xs text-muted-foreground">No credit card required</p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-6 w-full">
                    Get started free
                </ButtonCn>

                <div class="mt-7 flex-1">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        What's included:
                    </p>
                    <ul class="mt-3 space-y-2.5">
                        @foreach (var feat in _comparisonFeatures)
                        {
                            <li class="flex items-center justify-between gap-2">
                                <span class="flex items-center gap-2.5">
                                    @if (feat.Free)
                                    {
                                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="x" Size="16" Class="size-4 shrink-0 text-muted-foreground/30" StrokeWidth="2" />
                                    }
                                    <span class="@Cn.Merge("text-sm font-medium", feat.Free ? "text-foreground" : "text-muted-foreground/50")">
                                        @feat.Name
                                    </span>
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </article>

            @* Pro card — featured dark *@
            <article class="relative flex h-full flex-col rounded-2xl bg-foreground p-6 text-background ring-2 ring-foreground/10 sm:p-8">
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                    Best Value
                </span>

                <div>
                    <h3 class="text-2xl font-bold tracking-tight text-background">Pro</h3>
                    <p class="mt-2 text-sm leading-relaxed text-background/70">
                        For professionals and teams shipping production work.
                    </p>
                </div>

                <div class="mt-6 flex items-baseline gap-1.5">
                    <span class="text-4xl font-bold tracking-tight tabular-nums text-background">@($"${_proPrice}")</span>
                    <span class="text-sm text-background/60">/mo</span>
                </div>
                <p class="mt-1.5 text-xs text-background/50">
                    @if (_billing == "annually")
                    {
                        @($"Billed annually at ${_proPrice * 12}/year")
                    }
                    else
                    {
                        @("Billed monthly. Cancel anytime.")
                    }
                </p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-6 w-full bg-background text-foreground hover:bg-background/90">
                    Start 14-day trial
                </ButtonCn>

                <div class="mt-7 flex-1">
                    <p class="text-xs font-semibold uppercase tracking-wider text-background/60">
                        Everything in Hobby, plus:
                    </p>
                    <ul class="mt-3 space-y-2.5">
                        @foreach (var feat in _comparisonFeatures)
                        {
                            var feature = feat;
                            <li class="flex items-center justify-between gap-2">
                                <span class="flex items-center gap-2.5">
                                    @if (feature.Pro)
                                    {
                                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 text-emerald-400" StrokeWidth="3" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="x" Size="16" Class="size-4 shrink-0 text-background/25" StrokeWidth="2" />
                                    }
                                    <span class="@Cn.Merge("text-sm font-medium", feature.Pro ? "text-background/90" : "text-background/35")">
                                        @feature.Name
                                    </span>
                                </span>
                                @if (feature.Tooltip != null && feature.Pro)
                                {
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <button type="button" class="shrink-0">
                                                <LucideIconCn Name="info" Size="12" Class="size-3 cursor-help text-background/30" StrokeWidth="2" />
                                            </button>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn Side="FloatingSide.Top" Class="max-w-[220px]">
                                            <p class="text-xs">@feature.Tooltip</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </article>
        </div>
    </TooltipProviderCn>

    @* Trust footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        Pro includes a 14-day free trial. No credit card required. Switch plans or cancel anytime.
    </p>
</section>

@code {
    private record ComparisonFeature(string Name, bool Free, bool Pro, string? Tooltip = null);

    private string _billing = "monthly";

    private int _proPrice => _billing == "monthly" ? 29 : 23;

    private static readonly ComparisonFeature[] _comparisonFeatures =
    [
        new("Up to 3 projects", true, false),
        new("Unlimited projects", false, true),
        new("1GB storage with CDN", true, false),
        new("100GB storage with global CDN", false, true, "Content served from 40+ edge locations for sub-100ms latency."),
        new("Community support", true, true),
        new("Priority email support (4h SLA)", false, true, "Guaranteed first response within 4 business hours, Monday through Friday."),
        new("Single-user workspace", true, false),
        new("Up to 10 team members", false, true),
        new("Basic analytics", true, true),
        new("Advanced analytics with funnels", false, true),
        new("Custom domains with auto-SSL", false, true, "Connect your own domain with automatic SSL certificate provisioning."),
        new("REST and GraphQL API access", false, true),
    ];
}
