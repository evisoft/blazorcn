@* ============================================================
   Block: pricing-open-source
   Title: PricingOpenSource
   Description: A single-plan pricing section for React and Next.js with a centered marketing headline, a featured card on bg-muted showing a free-forever price with a two-column feature grid, ShadcnioButton CTA, and an embedded dashed eligibility criteria panel built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-open-source.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Headline *@
    <div class="text-center">
        <span class="inline-flex items-center gap-2 rounded-full border bg-muted/60 px-3.5 py-1.5">
            <LucideIconCn Name="git-branch" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
            <span class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                Open Source Program
            </span>
        </span>
        <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
            Free forever, for open source
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            We give back to the community that makes modern software possible. Qualifying OSS projects
            get full platform access, no strings attached.
        </p>
    </div>

    @* Featured plan card *@
    <article class="mt-8 flex flex-col rounded-2xl bg-muted p-6 sm:p-8">
        @* Plan header *@
        <div class="flex items-start justify-between gap-3">
            <div>
                <h3 class="text-2xl font-bold tracking-tight">Community</h3>
                <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted-foreground">
                    Everything your project needs to build, test, and ship with confidence.
                </p>
            </div>
            <span class="shrink-0 rounded-full bg-foreground px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-background shadow-sm">
                Free forever
            </span>
        </div>

        @* Price *@
        <div class="mt-6 flex items-baseline gap-2">
            <span class="text-5xl font-bold tracking-tight tabular-nums sm:text-6xl">$0</span>
            <span class="text-sm text-muted-foreground">/forever</span>
        </div>
        <p class="mt-1.5 text-sm text-muted-foreground">
            No trial period. No credit card required.
        </p>

        @* CTA *@
        <div class="mt-6">
            <ButtonCn Class="w-full">Apply for OSS program</ButtonCn>
        </div>

        @* Features *@
        <div class="mt-7 border-t pt-6">
            <p class="text-sm font-medium text-foreground">What's included:</p>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                @foreach (var feature in _features)
                {
                    var feat = feature;
                    <li class="flex items-start justify-between gap-2">
                        <span class="flex items-start gap-2.5">
                            <LucideIconCn Name="check" Size="20" Class="mt-0.5 size-5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                            <span class="text-sm font-medium leading-snug text-foreground">
                                @if (!string.IsNullOrEmpty(feat.Quantity))
                                {
                                    <span class="font-bold">@feat.Quantity </span>
                                }
                                @feat.Name
                            </span>
                        </span>
                        @if (!string.IsNullOrEmpty(feat.Tooltip))
                        {
                            <TooltipCn>
                                <TooltipTriggerCn>
                                    <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 cursor-help text-muted-foreground/40" aria-hidden="true" />
                                </TooltipTriggerCn>
                                <TooltipContentCn>
                                    <p class="text-xs">@feat.Tooltip</p>
                                </TooltipContentCn>
                            </TooltipCn>
                        }
                    </li>
                }
            </ul>
        </div>

        @* Eligibility *@
        <div class="mt-6 rounded-xl border border-dashed bg-background/60 p-5">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                Who qualifies
            </p>
            <ul class="mt-3 space-y-2.5">
                @foreach (var item in _eligibility)
                {
                    <li class="flex items-start gap-3">
                        <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground/50"></span>
                        <span class="text-sm leading-relaxed text-muted-foreground">@item</span>
                    </li>
                }
            </ul>
        </div>
    </article>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        Applications reviewed within 48 hours. Need commercial features? Paid plans start at
        $29/month.
    </p>
</section>

@code {
    private record Feature(string Name, string? Quantity = null, string? Tooltip = null);

    private static readonly Feature[] _features =
    [
        new("public repositories", Quantity: "Unlimited"),
        new("CI/CD pipeline minutes", Quantity: "10,000/mo", Tooltip: "Shared runners for Linux, macOS, and Windows. Unused minutes do not roll over."),
        new("package registry storage", Quantity: "50GB", Tooltip: "Host npm, Docker, and Maven packages with CDN distribution across 40+ edge locations."),
        new("Contributor analytics dashboard", Tooltip: "Track commit frequency, PR review times, and contributor growth across all repositories."),
        new("Community support via Discord and forums"),
        new("Dependency vulnerability scanning", Tooltip: "Automated security alerts for known vulnerabilities in your dependency tree, updated daily."),
        new("Branch protection and review rules"),
        new("Issue and project tracking"),
    ];

    private static readonly string[] _eligibility =
    [
        "Public repository with an OSI-approved license (MIT, Apache 2.0, GPL, etc.)",
        "Active development in the last 6 months (at least 10 commits)",
        "Open-source projects of any size, from solo maintainers to large foundations",
    ];
}
