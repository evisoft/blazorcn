                                    CheckedChanged=""@(v => ToggleAddon(a.Id))"" />
                                <div class=""flex-1"">
                                    <div class=""text-sm font-medium"">@a.Name</div>
                                    <div class=""text-muted-foreground text-xs"">@a.Description</div>
                                </div>
                                <div class=""text-right shrink-0"">
                                    <span class=""text-sm font-semibold"">+$@a.Price</span>
                                    <span class=""text-muted-foreground text-xs"">/mo</span>
                                </div>
                            </div>
                        }
                    </CardContentCn>
                </CardCn>
            </div>

            @* Total *@
            <CardCn>
                <CardContentCn Class=""p-4 sm:p-6"">
                    <div class=""flex items-center justify-between"">
