@code {
    private record UsageCategory(
        string Id,
        string Name,
        string IconName,
        string Unit,
        string DotClass,
        string BarClass,
        double PerUnitCost
    );

    private record UsageProfile(
        string Id,
        string Name,
        string Tagline,
        Dictionary<string, int> Usage,
        string[] Features
    );

    private record BreakdownRow(UsageCategory Category, int Usage, double Cost);

    private record SegmentRow(UsageCategory Category, int Usage, double Cost, double Percent, int Index);

    private static readonly UsageCategory[] _categories =
    [
        new(""ai"", ""AI generations"", ""sparkles"", ""generations"", ""bg-violet-500"", ""bg-violet-500"", 0.02),
        new(""api"", ""API requests"", ""zap"", ""requests"", ""bg-blue-500"", ""bg-blue-500"", 0.0001),
        new(""storage"", ""Storage"", ""database"", ""GB"", ""bg-emerald-500"", ""bg-emerald-500"", 0.5),
    ];

    private static readonly UsageProfile[] _profiles =
    [
        new(""light"", ""Light"", ""Solo developers and side projects"",
            new Dictionary<string, int> { [""ai""] = 500, [""api""] = 50000, [""storage""] = 10 },
            [""1 workspace"", ""Email support"", ""Community forum""]),
        new(""standard"", ""Standard"", ""Growing teams shipping every week"",
            new Dictionary<string, int> { [""ai""] = 5000, [""api""] = 500000, [""storage""] = 50 },
            [""10 workspaces"", ""Priority chat"", ""Custom domains"", ""Webhook events""]),
        new(""heavy"", ""Heavy"", ""Production workloads at scale"",
            new Dictionary<string, int> { [""ai""] = 50000, [""api""] = 5000000, [""storage""] = 500 },
            [""Unlimited workspaces"", ""Dedicated CSM"", ""SAML SSO"", ""99.95% SLA""]),
    ];

    private static readonly string[] _profileIds = [""light"", ""standard"", ""heavy""];

    private string _profileId = ""standard"";

    private UsageProfile ActiveProfile => Array.Find(_profiles, p => p.Id == _profileId) ?? _profiles[1];

    private BreakdownRow[] Breakdown => _categories
        .Select(cat =>
        {
            int usage = ActiveProfile.Usage.TryGetValue(cat.Id, out var u) ? u : 0;
            double cost = usage * cat.PerUnitCost;
            return new BreakdownRow(cat, usage, cost);
        })
        .ToArray();

    private double Total => Breakdown.Sum(r => r.Cost);

    private int TotalRounded => (int)Math.Round(Total);

    private SegmentRow[] Segments
    {
        get
        {
            var rows = Breakdown;
            double total = Total;
            return rows
                .Select((r, i) => new SegmentRow(r.Category, r.Usage, r.Cost, total > 0 ? (r.Cost / total) * 100.0 : 0, i))
                .ToArray();
        }
    }

    private string AriaSplit => string.Join("", "",
        Segments.Select(s => $""{s.Category.Name}: {(int)Math.Round(s.Percent)}%""));

