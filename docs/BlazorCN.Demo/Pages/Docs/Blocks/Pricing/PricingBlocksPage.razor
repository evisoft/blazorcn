@code {
    private const string PricingAccordionPlansCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-2xl border bg-card"">

        @* Header *@
        <div class=""px-5 py-7 text-center sm:px-8 sm:py-9 lg:px-10"">
            <p class=""text-[11px] font-medium uppercase tracking-widest text-muted-foreground"">
                Pricing
            </p>
            <h2 class=""mt-2.5 text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl"">
                Choose your plan
            </h2>
            <p class=""mx-auto mt-2.5 max-w-md text-sm text-muted-foreground leading-relaxed sm:text-base"">
                Transparent pricing that scales with your team. Start free, upgrade when you need more.
            </p>

            @* Billing toggle — pill tabs rendered as raw HTML *@
            <div class=""mt-6 flex items-center justify-center"">
                <div class=""inline-flex items-center rounded-full border bg-muted p-1 text-sm"" role=""tablist"" aria-label=""Billing period"">
                    @foreach (var opt in _billingOptions)
                    {
                        var isActive = _billing == opt;
                        <button type=""button""
                                role=""tab""
                                aria-selected=""@(isActive ? ""true"" : ""false"")""
                                class=""@Cn.Merge(""rounded-full px-4 py-1.5 text-sm font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"", isActive ? ""bg-background text-foreground shadow-sm"" : ""text-muted-foreground hover:text-foreground"")""
                                @onclick=""@(() => _billing = opt)"">
                            @(opt == ""monthly"" ? ""Monthly"" : ""Annually"")
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Plan rows *@
        @foreach (var plan in _plans)
        {
            var price = _billing == ""monthly"" ? plan.MonthlyPrice : plan.AnnualPrice;
            var isExpanded = _expandedPlan == plan.Id;
            var featuresPanelId = $""plan-{plan.Id}-features"";

            <div class=""@Cn.Merge(""border-t"", plan.IsPopular ? ""bg-muted/30"" : """")"">

                @* Plan row *@
                <div class=""flex flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:px-8 sm:py-6 lg:px-10"">

                    @* LEFT — clickable expand toggle *@
                    <button type=""button""
                            aria-expanded=""@(isExpanded ? ""true"" : ""false"")""
                            aria-controls=""@featuresPanelId""
                            class=""group flex min-w-0 flex-1 flex-col items-start text-left""
                            @onclick=""@(() => _expandedPlan = isExpanded ? null : plan.Id)"">
                        <div class=""flex flex-wrap items-center gap-x-2 gap-y-1"">
                            <h3 class=""text-base font-semibold sm:text-lg"">@plan.Name</h3>
                            @if (plan.IsPopular)
                            {
                                <span class=""rounded-full bg-red-500 px-2.5 py-0.5 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm"">
                                    Best Value
                                </span>
                            }
                        </div>
                        <p class=""mt-1 text-sm text-muted-foreground"">@plan.Description</p>
                        <span class=""mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-muted-foreground transition-colors group-hover:text-foreground"">
                            <LucideIconCn Name=""chevron-down"" Size=""14"" Class=""@Cn.Merge(""size-3.5 transition-transform duration-200"", isExpanded ? ""rotate-180"" : """")"" aria-hidden=""true"" />
                            @(isExpanded ? ""Hide features"" : $""{plan.Features.Length} features included"")
                        </span>
                    </button>

                    @* RIGHT — price + CTA *@
                    <div class=""flex items-center justify-between gap-4 sm:shrink-0 sm:justify-end sm:gap-5"">
                        <div class=""flex items-baseline gap-1 sm:min-w-[88px] sm:justify-end"">
                            @if (price == 0)
                            {
                                <span class=""text-2xl font-bold tabular-nums sm:text-3xl"">Free</span>
                            }
                            else
                            {
                                <span class=""text-2xl font-bold tabular-nums sm:text-3xl"">@($""${price}"")</span>
                            }
                            @if (price != null && price > 0)
                            {
                                <span class=""text-xs text-muted-foreground"">/mo</span>
                            }
                        </div>
                        <ButtonCn Size=""ButtonSize.Sm"" Class=""w-full shrink-0 sm:w-[230px]"">
                            @plan.Cta
                        </ButtonCn>
                    </div>
                </div>

                @* Expandable feature list *@
                @if (isExpanded)
                {
                    <div id=""@featuresPanelId"" class=""overflow-hidden"">
                        <div class=""border-t bg-muted/40 px-5 py-4 sm:px-8 sm:py-5 lg:px-10"">
                            <p class=""text-[10px] font-semibold uppercase tracking-wider text-muted-foreground"">
                                @plan.FeatureHeading
                            </p>
                            <ul class=""mt-3 grid gap-2.5 sm:grid-cols-2 sm:gap-x-6"">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class=""flex items-center justify-between gap-2"">
                                        <span class=""flex min-w-0 items-center gap-2.5"">
                                            <LucideIconCn Name=""check"" Size=""16"" Class=""size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500"" />
                                            <span class=""text-sm font-medium text-foreground"">@feature.Name</span>
                                        </span>
                                        @if (feature.Tooltip != null)
                                        {
                                            <TooltipCn OpenDelay=""200"">
                                                <TooltipTriggerCn Class=""-m-1 inline-flex shrink-0 cursor-help items-center justify-center rounded p-1 text-muted-foreground/40 transition-colors hover:text-foreground""
                                                                  role=""img""
                                                                  aria-label=""@($""More info about {feature.Name}"")"">
                                                    <LucideIconCn Name=""info"" Size=""14"" Class=""size-3.5"" aria-hidden=""true"" />
                                                </TooltipTriggerCn>
                                                <TooltipContentCn Side=""FloatingSide.Top"" Class=""max-w-[200px]"">
                                                    <p class=""text-xs"">@feature.Tooltip</p>
                                                </TooltipContentCn>
                                            </TooltipCn>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class=""border-t px-5 py-3.5 sm:px-8 lg:px-10"">
            <p class=""text-center text-xs text-muted-foreground"">
                All paid plans include a 14-day free trial. No credit card required. Cancel anytime.
            </p>
        </div>
    </div>
</section>

