    private static string LevelToCell(int level, bool isPopular)
    {
        var opacityClass = level switch
        {
            0 => ""bg-foreground/[0.02]"",
            1 => ""bg-emerald-500/10"",
            2 => ""bg-emerald-500/25"",
            3 => ""bg-emerald-500/45"",
            _ => ""bg-foreground/[0.02]"",
        };
        var popularRing = isPopular ? ""ring-1 ring-foreground/5"" : """";
        return Cn.Merge(opacityClass, popularRing);
    }

    private static string LevelToText(int level)
    {
        if (level == 0) return ""text-muted-foreground/50"";
        if (level == 1) return ""text-emerald-700 dark:text-emerald-400"";
        return ""text-emerald-700 dark:text-emerald-300"";
    }
