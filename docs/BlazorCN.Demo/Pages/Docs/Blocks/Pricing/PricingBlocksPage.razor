@code {
    // ── Geometry constants ──────────────────────────────────────────────
    private const double _chartSize   = 240;
    private const double _center      = _chartSize / 2;   // 120
    private const double _radius      = 78;
    private const double _labelRadius = 98;
    private const double _viewboxPadX = 34;
    private const double _viewboxPadY = 14;

    private record Dimension(string Key, string Label);

    private static readonly Dimension[] _dimensions =
    [
        new(""storage"",      ""Storage""),
        new(""support"",      ""Support""),
        new(""integrations"", ""APIs""),
        new(""security"",     ""Security""),
        new(""scale"",        ""Scale""),
        new(""speed"",        ""Speed""),
    ];

    // ── Pre-computed geometry ───────────────────────────────────────────
    private static (double X, double Y) AxisPoint(int index, double r)
    {
        var angle = (index / (double)_dimensions.Length) * Math.PI * 2 - Math.PI / 2;
        return (_center + r * Math.Cos(angle), _center + r * Math.Sin(angle));
    }

    private static string PointsToString(double r)
    {
        var pts = new System.Text.StringBuilder();
        for (int i = 0; i < _dimensions.Length; i++)
        {
            var p = AxisPoint(i, r);
            if (i > 0) pts.Append(' ');
            pts.Append($""{p.X:F1},{p.Y:F1}"");
        }
        return pts.ToString();
    }

    private static readonly string _outerHexPoints = PointsToString(_radius);

    private static readonly string[] _hexRings =
    [
        PointsToString(_radius * 0.25),
        PointsToString(_radius * 0.50),
        PointsToString(_radius * 0.75),
        PointsToString(_radius * 1.00),
    ];

    private static string ScoresToPoints(Dictionary<string, int> scores)
    {
        var pts = new System.Text.StringBuilder();
        for (int i = 0; i < _dimensions.Length; i++)
        {
            var dim = _dimensions[i];
            var score = scores.TryGetValue(dim.Key, out var s) ? s : 0;
            var normalized = score / 10.0;
            var p = AxisPoint(i, _radius * normalized);
            if (i > 0) pts.Append(' ');
            pts.Append($""{p.X:F1},{p.Y:F1}"");
        }
        return pts.ToString();
    }

    private static string BuildAriaLabel(Plan plan)
    {
        var parts = new System.Text.StringBuilder();
        parts.Append(plan.Name);
        parts.Append("" plan capability profile: "");
        for (int i = 0; i < _dimensions.Length; i++)
        {
            var dim = _dimensions[i];
            var score = plan.Scores.TryGetValue(dim.Key, out var s) ? s : 0;
            if (i > 0) parts.Append("", "");
            parts.Append($""{dim.Label} {score} out of 10"");
        }
        return parts.ToString();
    }

