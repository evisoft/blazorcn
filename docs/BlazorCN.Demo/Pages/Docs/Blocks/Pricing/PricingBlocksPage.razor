                            <span class=""text-2xl font-bold"">$@_basePrice</span>
                            <span class=""text-muted-foreground text-sm"">/mo</span>
                        </div>
                    </div>
                </CardHeaderCn>
                <CardContentCn>
                    <ul class=""grid gap-2 sm:grid-cols-2"">
