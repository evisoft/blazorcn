                        {
                            <li class=""flex items-center gap-2"">
                                <LucideCheckCn Size=""16"" Class=""text-primary shrink-0"" />
                                <span class=""text-sm"">@feature</span>
                            </li>
                        }
                    </ul>
                </CardContentCn>
            </CardCn>

            @* Add-ons *@
            <div class=""space-y-2"">
                <h3 class=""text-sm font-semibold"">Add-ons</h3>
                <CardCn>
                    <CardContentCn Class=""divide-y p-0"">
