@code {
    private const int _basePrice = 29;

    private HashSet<string> _enabled = new([""priority-support"", ""custom-domains""]);

    private int AddonTotal => _addons.Where(a => _enabled.Contains(a.Id)).Sum(a => a.Price);
    private int Total => _basePrice + AddonTotal;

    private void ToggleAddon(string id)
    {
        if (!_enabled.Remove(id))
            _enabled.Add(id);
    }

    private static readonly string[] _baseFeatures =
    [
        ""Unlimited projects"", ""10 GB storage"", ""Email support"", ""Core analytics"", ""Standard integrations"",
    ];

    private record AddonItem(string Id, string Name, string Description, int Price);

    private static readonly AddonItem[] _addons =
    [
        new(""advanced-analytics"", ""Advanced Analytics"", ""Custom dashboards, funnels, and retention reports"", 15),
        new(""priority-support"", ""Priority Support"", ""4-hour response SLA with dedicated agent"", 19),
        new(""custom-domains"", ""Custom Domains"", ""Use your own domain with SSL certificates"", 9),
        new(""team-seats"", ""Team Collaboration"", ""Up to 10 team members with role-based access"", 25),
        new(""api-access"", ""API & Webhooks"", ""REST API, GraphQL, and real-time webhooks"", 12),
        new(""white-label"", ""White Label"", ""Remove branding, custom logo, and colors"", 29),
    ];
}";
    private const string PricingAudienceTabsCode = @"<section class=""py-16 md:py-24"">
    <div class=""container mx-auto px-4"">
        <div class=""mx-auto mb-12 max-w-2xl text-center md:mb-16"">
            <h2 class=""mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl"">
                Plans for every stage
            </h2>
            <p class=""text-muted-foreground text-lg"">
                Whether you're a solo creator or a Fortune 500 company, we have you covered.
            </p>
        </div>

        <div class=""mx-auto max-w-5xl"">
            <TabsCn DefaultValue=""startup"" Class=""space-y-8"">
                <div class=""flex justify-center"">
                    <TabsListCn Class=""grid w-full max-w-md grid-cols-3"">
                        @foreach (var audience in _audiences)
                        {
                            <TabsTriggerCn Value=""@audience.Id"" Class=""gap-1.5"">
                                @audience.IconFragment
                                <span class=""hidden sm:inline"">@audience.Label</span>
                            </TabsTriggerCn>
                        }
                    </TabsListCn>
                </div>

                @foreach (var audience in _audiences)
                {
                    <TabsContentCn Value=""@audience.Id"">
                        <p class=""text-muted-foreground mb-8 text-center text-sm"">
                            @audience.Description
                        </p>
                        <div class=""grid gap-6 md:grid-cols-3 md:gap-4 lg:gap-6"">
                            @foreach (var plan in audience.Plans)
                            {
                                <CardCn
                                    Class=""@(Cn.Merge(""relative flex flex-col"", plan.IsPopular ? ""border-primary shadow-lg ring-1 ring-primary/20 md:scale-105"" : ""border-border""))"">
                                    @if (plan.IsPopular)
                                    {
                                        <div class=""absolute -top-3 right-4"">
                                            <BadgeCn>Best Value</BadgeCn>
                                        </div>
                                    }
                                    <CardHeaderCn Class=""pb-4"">
                                        <h3 class=""text-lg font-semibold"">@plan.Name</h3>
                                        <div class=""mt-2 flex items-baseline gap-1"">
                                            @if (plan.IsNumericPrice)
                                            {
                                                <span class=""text-4xl font-bold tracking-tight"">
                                                    $@plan.Price
                                                </span>
                                                @if (plan.NumericPrice > 0)
                                                {
                                                    <span class=""text-muted-foreground text-sm"">
                                                        /@(plan.Period.Replace(""per "", """"))
                                                    </span>
                                                }
                                                @if (plan.NumericPrice == 0)
                                                {
                                                    <span class=""text-muted-foreground text-sm"">@plan.Period</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class=""text-4xl font-bold tracking-tight"">@plan.Price</span>
                                            }
                                        </div>
                                        <p class=""text-muted-foreground mt-2 text-sm"">@plan.Description</p>
                                    </CardHeaderCn>
                                    <CardContentCn Class=""flex-1"">
                                        <ul class=""space-y-3"">
                                            @foreach (var feature in plan.Features)
                                            {
                                                <li class=""flex items-start gap-3"">
                                                    <LucideCheckCn Size=""16"" Class=""text-primary mt-0.5 shrink-0"" />
                                                    <span class=""text-sm"">@feature</span>
                                                </li>
                                            }
                                        </ul>
                                    </CardContentCn>
                                    <CardFooterCn Class=""pt-4"">
                                        <ButtonCn
                                            Class=""w-full""
                                            Variant=""@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)""
                                            Size=""ButtonSize.Lg""
                                            AsChild=""true"">
                                            <a href=""#"">@plan.Cta</a>
                                        </ButtonCn>
                                    </CardFooterCn>
                                </CardCn>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>
    </div>
</section>

@code {
