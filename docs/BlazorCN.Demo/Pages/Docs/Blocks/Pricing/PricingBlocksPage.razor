            if (value >= 1_000_000) return $""{value / 1_000_000.0:0.#}M"";
            if (value >= 1_000) return $""{value / 1000.0:0.#}K"";
            return value.ToString();
        }
        return value >= 1000 ? $""{value / 1000.0:0.#}K"" : value.ToString();
    }
