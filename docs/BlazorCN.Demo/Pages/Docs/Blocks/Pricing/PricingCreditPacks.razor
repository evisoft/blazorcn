@* ============================================================
   Block: pricing-credit-packs
   Title: PricingCreditPacks
   Description: A four-column credit pack pricing section for React and Next.js with strikethrough original price comparison, bold savings chips in emerald, reserved badge slot for alignment, ring highlight on the best-value pack, ShadcnioButton CTAs with sliding arrow hover, and usage example lists built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-credit-packs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Header *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Credit Packs
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Save more with bigger packs
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            One-time bulk credit purchases with steeper discounts at every tier. Use credits anytime
            across all platform features. No subscription, no expiration.
        </p>
    </div>

    <div class="mt-10 grid grid-cols-1 justify-center gap-4 sm:grid-cols-[repeat(2,260px)] xl:grid-cols-[repeat(4,260px)]">
        @foreach (var pack in _packs)
        {
            var originalPrice = (int)Math.Round(pack.Credits * StarterRate);
            var savedAmount = originalPrice - pack.TotalPrice;
            var hasDiscount = pack.SavingsPercent != null && savedAmount > 0;

            <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl bg-muted p-6 sm:p-7", pack.IsPopular ? "ring-2 ring-foreground/10" : "")">
                @* Reserved badge slot (rendered on every card for alignment) *@
                <div class="flex h-7 items-start">
                    @if (pack.IsPopular)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                            Best Value
                        </span>
                    }
                </div>

                @* Pack name — small label so the credit count can dominate *@
                <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                    @pack.Name
                </p>

                @* Credit count — primary visual hero *@
                <div class="mt-2 flex items-baseline gap-1.5">
                    <span class="text-4xl font-bold tracking-tight tabular-nums text-foreground sm:text-5xl">
                        @pack.Credits.ToString("N0")
                    </span>
                    <span class="text-sm font-medium text-muted-foreground">credits</span>
                </div>

                @* Fixed-height price row — handles strikethrough vs no-discount without shift *@
                <div class="mt-5 flex h-12 flex-col justify-center">
                    <div class="flex items-baseline gap-2">
                        @if (hasDiscount)
                        {
                            <s aria-hidden="true" class="text-base font-medium tabular-nums text-muted-foreground/60">
                                $@originalPrice
                            </s>
                        }
                        <span class="text-3xl font-bold tracking-tight tabular-nums text-foreground">
                            $@pack.TotalPrice
                        </span>
                    </div>
                    <p class="mt-0.5 text-[11px] text-muted-foreground tabular-nums">
                        $@pack.PerCredit.ToString("F2") per credit
                    </p>
                </div>

                @* Savings chip — reserved slot on every card so CTAs align *@
                <div class="mt-4 flex h-10 items-center">
                    @if (hasDiscount)
                    {
                        <div class="flex w-full items-center justify-between rounded-lg bg-emerald-500/10 px-3 py-2 ring-1 ring-emerald-500/20 dark:bg-emerald-500/15">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 tabular-nums dark:text-emerald-400">
                                Save $@savedAmount
                            </span>
                            <span class="text-[11px] font-extrabold tabular-nums text-emerald-700 dark:text-emerald-400">
                                &minus;@pack.SavingsPercent%
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="flex w-full items-center rounded-lg border border-dashed border-border/70 px-3 py-2">
                            <span class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                                Base rate
                            </span>
                        </div>
                    }
                </div>

                @* CTA *@
                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 w-full min-w-0">
                    Purchase pack
                </ButtonCn>

                @* Divider + usage examples *@
                <div class="mt-6 border-t border-border/60 pt-5">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        Use credits for
                    </p>
                    <ul class="mt-3 space-y-2.5">
                        @foreach (var example in pack.UsageExamples)
                        {
                            <li class="flex items-start gap-2.5">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                <span class="text-sm font-medium leading-snug text-foreground">
                                    @example
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        Credits never expire. One-time purchase, no subscription. Volume discounts available for
        50,000+ credits.
    </p>
</section>

@code {
    private const double StarterRate = 0.1;

    private record CreditPack(
        string Id,
        string Name,
        int Credits,
        int TotalPrice,
        double PerCredit,
        int? SavingsPercent,
        bool IsPopular,
        string[] UsageExamples);

    private static readonly CreditPack[] _packs =
    [
        new("starter", "Starter", 100, 10, 0.1, null, false,
        [
            "50 AI image generations",
            "200 API requests",
            "10 document exports",
            "20 video transcriptions",
            "5 batch processing jobs",
        ]),
        new("growth", "Growth", 500, 40, 0.08, 20, false,
        [
            "250 AI image generations",
            "1,000 API requests",
            "50 document exports",
            "100 video transcriptions",
            "25 batch processing jobs",
        ]),
        new("professional", "Professional", 2000, 100, 0.05, 50, true,
        [
            "1,000 AI image generations",
            "4,000 API requests",
            "200 document exports",
            "400 video transcriptions",
            "100 batch processing jobs",
        ]),
        new("scale", "Scale", 10000, 400, 0.04, 60, false,
        [
            "5,000 AI image generations",
            "20,000 API requests",
            "1,000 document exports",
            "2,000 video transcriptions",
            "500 batch processing jobs",
        ]),
    ];
}
