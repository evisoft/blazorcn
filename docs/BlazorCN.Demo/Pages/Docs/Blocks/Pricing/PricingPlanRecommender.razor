@* ============================================================
   Block: pricing-plan-recommender
   Title: PricingPlanRecommender
   Description: An interactive quiz-driven plan recommender block for React and Next.js with split layout featuring three PillTabs question selectors for team size, primary use case, and budget on the left and a dynamically computed recommended plan card on the right with NumberFlow animated price, ShadcnioButton CTA, emerald checkmark feature list, and red Recommended badge built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-plan-recommender.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Plan recommender
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Find your perfect plan in 30 seconds
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Answer three quick questions and we'll match you to the plan that fits your team, your
            workflow, and your budget.
        </p>
    </div>

    @* Split layout: questions left, recommendation right *@
    <div class="mt-10 grid items-stretch gap-6 lg:grid-cols-[1fr_1.1fr]">
        @* Left: quiz questions *@
        <div class="flex h-full flex-col rounded-2xl border bg-card p-6 sm:p-8">
            @* Reserved header slot — matches recommendation card's badge slot for Y-alignment *@
            <div class="mb-6 flex h-6 items-center">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                    Answer three questions
                </p>
            </div>

            <div class="flex-1 space-y-7">
                @* Question 1 *@
                <div>
                    <div class="flex items-baseline gap-2">
                        <span class="flex size-5 items-center justify-center rounded-full bg-foreground text-[10px] font-bold text-background">
                            1
                        </span>
                        <h3 class="text-sm font-semibold">What's your team size?</h3>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                        @foreach (var t in _teamSizes)
                        {
                            var teamVal = t;
                            var isActive = _team == teamVal;
                            <button
                                type="button"
                                @onclick="@(() => _team = teamVal)"
                                class="@Cn.Merge("rounded-full border px-3 py-1 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-foreground/20 bg-background text-muted-foreground hover:border-foreground/40 hover:text-foreground")">
                                @_teamLabels[teamVal]
                            </button>
                        }
                    </div>
                </div>

                @* Question 2 *@
                <div>
                    <div class="flex items-baseline gap-2">
                        <span class="flex size-5 items-center justify-center rounded-full bg-foreground text-[10px] font-bold text-background">
                            2
                        </span>
                        <h3 class="text-sm font-semibold">What will you build?</h3>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                        @foreach (var u in _useCases)
                        {
                            var ucVal = u;
                            var isActive = _useCase == ucVal;
                            <button
                                type="button"
                                @onclick="@(() => _useCase = ucVal)"
                                class="@Cn.Merge("rounded-full border px-3 py-1 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-foreground/20 bg-background text-muted-foreground hover:border-foreground/40 hover:text-foreground")">
                                @_useCaseLabels[ucVal]
                            </button>
                        }
                    </div>
                </div>

                @* Question 3 *@
                <div>
                    <div class="flex items-baseline gap-2">
                        <span class="flex size-5 items-center justify-center rounded-full bg-foreground text-[10px] font-bold text-background">
                            3
                        </span>
                        <h3 class="text-sm font-semibold">What's your budget tier?</h3>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                        @foreach (var b in _budgets)
                        {
                            var budgetVal = b;
                            var isActive = _budget == budgetVal;
                            <button
                                type="button"
                                @onclick="@(() => _budget = budgetVal)"
                                class="@Cn.Merge("rounded-full border px-3 py-1 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-foreground/20 bg-background text-muted-foreground hover:border-foreground/40 hover:text-foreground")">
                                @_budgetLabels[budgetVal]
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-7 flex items-center gap-2 rounded-lg bg-muted/50 px-3 py-2.5">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">
                    Recommendation updates instantly as you answer.
                </p>
            </div>
        </div>

        @* Right: recommendation card *@
        @{
            var recommended = RecommendPlan(_team, _useCase, _budget);
        }
        <div class="flex h-full flex-col rounded-2xl border bg-muted p-6 ring-2 ring-foreground/10 sm:p-8">
            @* Inline badge slot — matches left column header slot for Y-alignment *@
            <div class="mb-6 flex h-6 items-center">
                <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                    Recommended For You
                </span>
            </div>

            <div aria-live="polite" class="flex flex-1 flex-col">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                    @recommended.Badge
                </p>
                <h3 class="mt-2 text-3xl font-bold tracking-tight">@recommended.Name</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                    @recommended.Tagline
                </p>

                @* Price *@
                <div class="mt-5 flex items-baseline gap-1">
                    @if (recommended.MonthlyPrice == 0)
                    {
                        <span class="text-5xl font-bold leading-none tracking-tight tabular-nums">
                            Free
                        </span>
                    }
                    else
                    {
                        <span class="text-3xl font-bold leading-none tabular-nums text-foreground/70">
                            $
                        </span>
                        <span class="text-5xl font-bold leading-none tracking-tight tabular-nums">
                            @recommended.MonthlyPrice
                        </span>
                        <span class="ml-1 text-sm text-muted-foreground">/month</span>
                    }
                </div>

                @* CTA *@
                <ButtonCn Class="mt-6 w-full">@recommended.Cta</ButtonCn>

                @* Features *@
                <div class="mt-6 flex-1">
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                        What you'll get:
                    </p>
                    <ul class="mt-3 grid gap-2.5 sm:grid-cols-2">
                        @foreach (var feature in recommended.Features)
                        {
                            <li class="flex items-start gap-2.5">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                <span class="text-sm font-medium text-foreground">@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @* Trust footer *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        14-day free trial on paid plans. No credit card required. Switch plans anytime.
    </p>
</section>

@code {
    private string _team = "small";
    private string _useCase = "client-work";
    private string _budget = "balanced";

    private static readonly string[] _teamSizes = ["solo", "small", "growing", "enterprise"];
    private static readonly string[] _useCases = ["personal", "client-work", "internal-tool", "saas-product"];
    private static readonly string[] _budgets = ["lean", "balanced", "premium"];

    private static readonly Dictionary<string, string> _teamLabels = new()
    {
        ["solo"] = "Just me",
        ["small"] = "2–10",
        ["growing"] = "11–50",
        ["enterprise"] = "50+",
    };

    private static readonly Dictionary<string, string> _useCaseLabels = new()
    {
        ["personal"] = "Personal",
        ["client-work"] = "Client work",
        ["internal-tool"] = "Internal tool",
        ["saas-product"] = "SaaS product",
    };

    private static readonly Dictionary<string, string> _budgetLabels = new()
    {
        ["lean"] = "Lean",
        ["balanced"] = "Balanced",
        ["premium"] = "Premium",
    };

    private record PlanData(string Id, string Name, string Tagline, int MonthlyPrice, string[] Features, string Cta, string Badge);

    private static readonly Dictionary<string, PlanData> _plans = new()
    {
        ["hobby"] = new PlanData("hobby", "Hobby", "Start free, upgrade only when your project takes off.", 0,
            ["3 active projects", "1GB storage with CDN", "Community support on Discord", "Basic usage analytics", "Single workspace"],
            "Get started free", "Best for solo creators"),
        ["starter"] = new PlanData("starter", "Starter", "Everything a freelancer needs to ship client work.", 19,
            ["Unlimited projects", "25GB storage with global CDN", "Custom domains with auto-SSL", "Email support (24h SLA)", "Up to 3 team members"],
            "Start 14-day trial", "Best for freelancers"),
        ["team"] = new PlanData("team", "Team", "Built for growing teams shipping production software.", 49,
            ["Up to 15 team members", "100GB storage with edge cache", "Priority support (4h SLA)", "Advanced analytics with funnels", "Custom workflows and webhooks", "Audit logs (90-day retention)"],
            "Start 14-day trial", "Best for growing teams"),
        ["business"] = new PlanData("business", "Business", "For teams that need SSO, compliance, and scale.", 99,
            ["Unlimited team members", "500GB storage with global CDN", "SAML SSO with SCIM provisioning", "24/7 phone and chat support", "Audit logs (1-year retention)", "99.95% uptime SLA"],
            "Start 14-day trial", "Best for scaling SaaS"),
        ["enterprise"] = new PlanData("enterprise", "Enterprise", "Custom deployment with dedicated support and contracts.", 299,
            ["Unlimited everything", "Dedicated account manager", "1-hour phone support SLA", "Custom contracts and invoicing", "SOC 2, HIPAA, and GDPR support", "Data residency options"],
            "Talk to sales", "Best for enterprise"),
    };

    private static PlanData RecommendPlan(string team, string useCase, string budget)
    {
        if (team == "enterprise") return _plans["enterprise"];
        if (team == "growing")
        {
            if (budget == "premium") return _plans["business"];
            return _plans["team"];
        }
        if (team == "small")
        {
            if (useCase == "saas-product" && budget != "lean") return _plans["team"];
            if (budget == "lean") return _plans["starter"];
            return _plans["team"];
        }
        // solo
        if (useCase == "personal" || budget == "lean") return _plans["hobby"];
        if (useCase == "client-work") return _plans["starter"];
        return _plans["starter"];
    }
}
