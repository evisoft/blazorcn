@* ============================================================
   Block: pricing-free-vs-pro
   Title: PricingFreeVsPro
   Description: A free versus pro pricing comparison section for React and Next.js with marketing headline, light Free card paired with dark highlight Pro card, NumberFlow animated prices with PillTabs billing toggle, progressive emerald checklist features, ShadcnioButton CTAs, and trust messaging built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-free-vs-pro.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pricing
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Free to start, Pro to scale
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
            Start building for free. Upgrade to Pro when you need more power, more storage, and
            priority support.
        </p>

        @* Billing toggle *@
        <div class="mt-6 flex items-center justify-center gap-1 rounded-full border border-border bg-muted p-1">
            @foreach (var opt in _billingOptions)
            {
                var optVal = opt;
                <button type="button"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == optVal ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _billing = optVal)">
                    @(optVal == "monthly" ? "Monthly" : "Annually")
                </button>
            }
        </div>
    </div>

    @* Plan grid *@
    <div class="mt-8 grid gap-4 md:grid-cols-2">
        @foreach (var plan in _plans)
        {
            var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
            <article class="@Cn.Merge("relative flex h-full flex-col overflow-hidden rounded-2xl p-6 sm:p-8", plan.IsDark ? "bg-foreground text-background" : "bg-muted")">
                @* Reserved badge slot — rendered on every card so headings align *@
                <div class="mb-4 flex h-7 items-start">
                    @if (plan.Badge != null)
                    {
                        <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            @plan.Badge
                        </span>
                    }
                </div>

                @* Plan name + description *@
                <div>
                    <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                    <p class="@Cn.Merge("mt-1.5 min-h-[2.75rem] text-sm leading-relaxed", plan.IsDark ? "text-background/60" : "text-muted-foreground")">
                        @plan.Description
                    </p>
                </div>

                @* Price — fixed height row for layout stability *@
                <div class="mt-6 flex h-12 items-baseline gap-1.5 sm:h-14">
                    @if (price == 0)
                    {
                        <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                            $0
                        </span>
                    }
                    else
                    {
                        <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
                            $@price
                        </span>
                    }
                    <span class="@Cn.Merge("text-base", plan.IsDark ? "text-background/60" : "text-muted-foreground")">
                        /month
                    </span>
                </div>
                <p class="@Cn.Merge("mt-2 text-xs", plan.IsDark ? "text-background/50" : "text-muted-foreground")">
                    @if (price == 0)
                    {
                        @:Free forever, no credit card required
                    }
                    else if (_billing == "annually")
                    {
                        @:Billed annually at $@(plan.AnnualPrice * 12)/year
                    }
                    else
                    {
                        @:Billed monthly, cancel anytime
                    }
                </p>

                @* CTA *@
                <ButtonCn Class="@Cn.Merge("mt-6 w-full", plan.IsDark ? "bg-background text-foreground hover:bg-background/90" : "")">
                    @plan.Cta
                </ButtonCn>

                @* Features *@
                <div class="mt-8 flex-1">
                    <p class="text-sm font-semibold">@plan.FeatureHeading</p>
                    <ul class="mt-4 space-y-3">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-start gap-2.5 text-sm font-medium leading-snug">
                                <LucideIconCn Name="check" Size="16" Class="@Cn.Merge("mt-0.5 size-4 shrink-0 stroke-[3]", plan.IsDark ? "text-emerald-400" : "text-emerald-600 dark:text-emerald-500")" aria-hidden="true" />
                                <span>@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>

    @* Trust text *@
    <p class="mt-6 text-center text-xs text-muted-foreground">
        All plans include SSL, automatic backups, and 99.9% uptime SLA · Cancel anytime
    </p>
</section>

@code {
    private string _billing = "monthly";

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private record Plan(
        string Id,
        string Name,
        string Description,
        int MonthlyPrice,
        int AnnualPrice,
        string FeatureHeading,
        string[] Features,
        string Cta,
        bool IsDark,
        string? Badge = null);

    private static readonly Plan[] _plans =
    [
        new(
            Id: "free",
            Name: "Free",
            Description: "For personal projects, indie hackers, and exploration.",
            MonthlyPrice: 0,
            AnnualPrice: 0,
            FeatureHeading: "What's included:",
            Features:
            [
                "Up to 3 projects",
                "1GB storage",
                "Community forum support",
                "Basic usage analytics",
                "Single-user workspace",
                "Public sharing links",
            ],
            Cta: "Get started free",
            IsDark: false
        ),
        new(
            Id: "pro",
            Name: "Pro",
            Description: "For professionals, freelancers, and growing teams.",
            MonthlyPrice: 29,
            AnnualPrice: 23,
            FeatureHeading: "Everything in Free, plus:",
            Features:
            [
                "Unlimited projects",
                "50GB storage with global CDN",
                "Priority email support (4h SLA)",
                "Advanced analytics with funnels",
                "Up to 10 team members",
                "Custom domains with auto-SSL",
                "REST and GraphQL API access",
                "Slack, GitHub and Jira integrations",
            ],
            Cta: "Start 14-day trial",
            IsDark: true,
            Badge: "Best Value"
        ),
    ];
}
