@* ========================================
   Block: pricing-two-plans
   Title: Pricing Two Plans
   Description: Minimalist two-plan pricing section with clean side-by-side free and pro layout for React applications
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideMinusCn
   Source: original/blocks/pricing/pricing-two-plans.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Class="mb-4" Variant="BadgeVariant.Secondary">Simple Pricing</BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Free to start. Pro to grow.
            </h2>
            <p class="text-muted-foreground text-lg">
                No complicated tiers. Just pick what works for you.
            </p>
        </div>

        <div class="mx-auto grid max-w-3xl gap-6 md:grid-cols-2">
            @* Free Plan *@
            <CardCn Class="flex flex-col">
                <CardHeaderCn>
                    <h3 class="text-lg font-semibold">Free</h3>
                    <div class="mt-3 flex items-baseline gap-1">
                        <span class="text-4xl font-bold tracking-tight">$0</span>
                        <span class="text-muted-foreground text-sm">forever</span>
                    </div>
                    <p class="text-muted-foreground mt-2 text-sm">
                        Everything you need to get started. No credit card required.
                    </p>
                </CardHeaderCn>
                <CardContentCn Class="flex-1">
                    <ul class="space-y-3">
                        @foreach (var feature in _freeFeatures)
                        {
                            <li class="flex items-center gap-3">
                                @if (feature.Included)
                                {
                                    <LucideCheckCn Class="text-muted-foreground h-4 w-4 shrink-0" Size="16" />
                                }
                                else
                                {
                                    <LucideMinusCn Class="text-muted-foreground/30 h-4 w-4 shrink-0" Size="16" />
                                }
                                <span class="@(feature.Included ? "text-sm" : "text-muted-foreground/50 text-sm line-through")">
                                    @feature.Name
                                </span>
                            </li>
                        }
                    </ul>
                </CardContentCn>
                <CardFooterCn Class="pt-4">
                    <ButtonCn Class="w-full" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">Get Started</ButtonCn>
                </CardFooterCn>
            </CardCn>

            @* Pro Plan *@
            <CardCn Class="bg-foreground text-background flex flex-col">
                <CardHeaderCn>
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-semibold">Pro</h3>
                        <BadgeCn Class="bg-background/15 text-background border-0" Variant="BadgeVariant.Secondary">Popular</BadgeCn>
                    </div>
                    <div class="mt-3 flex items-baseline gap-1">
                        <span class="text-4xl font-bold tracking-tight">$29</span>
                        <span class="text-background/60 text-sm">/month</span>
                    </div>
                    <p class="text-background/70 mt-2 text-sm">
                        Unlock the full power of the platform. Scale without limits.
                    </p>
                </CardHeaderCn>
                <CardContentCn Class="flex-1">
                    <ul class="space-y-3">
                        @foreach (var feature in _proFeatures)
                        {
                            <li class="flex items-center gap-3">
                                <LucideCheckCn Class="text-background/80 h-4 w-4 shrink-0" Size="16" />
                                <span class="text-sm">@feature</span>
                            </li>
                        }
                    </ul>
                </CardContentCn>
                <CardFooterCn Class="pt-4">
                    <ButtonCn Class="w-full gap-2" Size="ButtonSize.Lg" Variant="ButtonVariant.Secondary">
                        Start Free Trial
                        <LucideArrowRightCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </CardFooterCn>
            </CardCn>
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, bool Included);

    private static readonly Feature[] _freeFeatures =
    [
        new("Up to 3 projects", true),
        new("1 GB storage", true),
        new("Community support", true),
        new("Basic analytics", true),
        new("Custom domains", false),
        new("Team collaboration", false),
        new("API access", false),
        new("Priority support", false),
    ];

    private static readonly string[] _proFeatures =
    [
        "Unlimited projects", "100 GB storage", "Priority email support", "Advanced analytics",
        "Custom domains", "Team collaboration", "API access", "Priority support",
    ];
}
