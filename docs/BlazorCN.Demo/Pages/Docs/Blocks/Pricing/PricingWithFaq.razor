@* ========================================
   Block: pricing-with-faq
   Title: Pricing With Faq
   Description: Pricing cards section with integrated FAQ accordion below addressing common billing and plan questions
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideCheckCn
   Source: original/blocks/pricing/pricing-with-faq.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        @* Header *@
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Straightforward pricing
            </h2>
            <p class="text-muted-foreground text-lg">
                Pick a plan, start building. Questions? We've answered them below.
            </p>
        </div>

        @* Pricing Cards *@
        <div class="mx-auto mb-16 grid max-w-5xl gap-6 md:mb-24 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                <CardCn Class="@Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20 md:scale-105" : "border-border")">
                    @if (plan.IsPopular)
                    {
                        <div class="absolute -top-3 right-4">
                            <BadgeCn>Most Popular</BadgeCn>
                        </div>
                    }
                    <CardHeaderCn Class="pb-4">
                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                        <div class="mt-2 flex items-baseline gap-1">
                            <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                            @if (plan.Price > 0)
                            {
                                <span class="text-muted-foreground text-sm">/month</span>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-sm">forever</span>
                            }
                        </div>
                        <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                    </CardHeaderCn>
                    <CardContentCn Class="flex-1">
                        <ul class="space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-3">
                                    <LucideCheckCn Class="text-primary mt-0.5 h-4 w-4 shrink-0" Size="16" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </CardContentCn>
                    <CardFooterCn Class="pt-4">
                        <ButtonCn Class="w-full" Size="ButtonSize.Lg"
                                  Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                            @plan.Cta
                        </ButtonCn>
                    </CardFooterCn>
                </CardCn>
            }
        </div>

        @* FAQ Section *@
        <div class="mx-auto max-w-2xl">
            <div class="mb-8 text-center">
                <h3 class="mb-2 text-2xl font-bold tracking-tight">Frequently asked questions</h3>
                <p class="text-muted-foreground text-sm">
                    Everything you need to know about our pricing and billing.
                </p>
            </div>

            <AccordionCn Type="AccordionType.Single" Class="w-full">
                @for (var i = 0; i < _faqs.Length; i++)
                {
                    var faq = _faqs[i];
                    <AccordionItemCn>
                        <AccordionTriggerCn Class="text-left text-sm font-medium">
                            @faq.Question
                        </AccordionTriggerCn>
                        <AccordionContentCn Class="text-muted-foreground text-sm leading-relaxed">
                            @faq.Answer
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>

            <div class="mt-8 text-center">
                <p class="text-muted-foreground text-sm">
                    Still have questions?
                    <a href="#" class="text-primary hover:underline font-medium">Contact our sales team</a>
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, string Description, string[] Features, bool IsPopular, string Cta);
    private record FaqItem(string Question, string Answer);

    private static readonly Plan[] _plans =
    [
        new("Starter", 0, "For hobby projects and experimentation.", ["Up to 3 projects", "1 GB storage", "Community support", "Basic analytics"], false, "Start Free"),
        new("Pro", 39, "For professionals who need the full toolkit.", ["Unlimited projects", "100 GB storage", "Priority email support", "Advanced analytics", "Custom domains", "API access", "Team collaboration"], true, "Start Free Trial"),
        new("Enterprise", 149, "For teams with advanced security needs.", ["Everything in Pro", "Unlimited storage", "SSO & SAML", "Audit logs", "Dedicated CSM", "Custom SLA", "On-premise option", "Advanced permissions"], false, "Contact Sales"),
    ];

    private static readonly FaqItem[] _faqs =
    [
        new("Can I try before I buy?", "Absolutely. Every paid plan comes with a 14-day free trial. No credit card required to start. You get full access to all features during the trial period so you can evaluate everything before committing."),
        new("What happens when my trial ends?", "If you don't upgrade, your account automatically switches to the Free plan. You won't lose any data\u2014your projects and files stay safe. You can upgrade to a paid plan at any time to regain access to premium features."),
        new("Can I change plans later?", "Yes, you can upgrade or downgrade at any time. When upgrading, you get immediate access to new features and we prorate the cost. When downgrading, the change takes effect at the end of your current billing period."),
        new("What payment methods do you accept?", "We accept all major credit cards (Visa, Mastercard, American Express), PayPal, and wire transfers for annual Enterprise plans. All payments are securely processed through Stripe."),
        new("Is there a refund policy?", "Yes. If you're not satisfied within the first 30 days of a paid plan, we'll issue a full refund\u2014no questions asked. For annual plans, we offer a prorated refund within the first 60 days."),
        new("Do you offer discounts for nonprofits or education?", "Yes, we offer 50% off all paid plans for registered nonprofits and educational institutions. Contact our sales team with proof of status and we'll set up your discounted account."),
        new("How secure is my data?", "We use AES-256 encryption at rest and TLS 1.3 in transit. Our infrastructure is SOC 2 Type II compliant. Enterprise plans include additional security features like SSO, audit logs, and data residency options."),
    ];
}
