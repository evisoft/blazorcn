@* ========================================
   Block: pricing-gradient-cards
   Title: Pricing Gradient Cards
   Description: Pricing cards with gradient border accents and glassmorphism styling for modern React SaaS landing pages
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideStarCn
   Source: original/blocks/pricing/pricing-gradient-cards.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <BadgeCn Class="mb-4 gap-1.5" Variant="BadgeVariant.Secondary">
                <LucideStarCn Class="h-3 w-3" Size="12" />
                Pricing
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Built to scale with you
            </h2>
            <p class="text-muted-foreground text-lg">
                Start free, go Pro when you're ready. No surprises on your bill.
            </p>
        </div>

        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
            @foreach (var plan in _plans)
            {
                <div class="@Cn.Merge("relative rounded-xl", plan.IsPopular ? "md:scale-105" : "")">
                    @if (plan.IsPopular)
                    {
                        <div class="@Cn.Merge("absolute -inset-px rounded-xl bg-gradient-to-b opacity-80", plan.Gradient)"></div>
                    }

                    <CardCn Class="@Cn.Merge("relative flex h-full flex-col overflow-hidden", plan.IsPopular ? "border-0 shadow-lg" : "border-border")">
                        @* Top gradient stripe *@
                        <div class="@Cn.Merge("h-1 w-full bg-gradient-to-r", plan.Gradient)"></div>

                        @if (plan.IsPopular)
                        {
                            <div class="absolute top-4 right-4">
                                <BadgeCn Class="@Cn.Merge("bg-gradient-to-r border-0 text-white", plan.Gradient)">Most Popular</BadgeCn>
                            </div>
                        }

                        <CardHeaderCn Class="pb-4 pt-5">
                            <h3 class="text-lg font-semibold">@plan.Name</h3>
                            <div class="mt-3 flex items-baseline gap-1">
                                <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                                @if (plan.Price > 0)
                                {
                                    <span class="text-muted-foreground text-sm">/month</span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-sm">forever</span>
                                }
                            </div>
                            <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                        </CardHeaderCn>
                        <CardContentCn Class="flex-1">
                            <ul class="space-y-3">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-start gap-3">
                                        <LucideCheckCn Class="@Cn.Merge("mt-0.5 h-4 w-4 shrink-0", plan.IsPopular ? "text-purple-500" : "text-primary")" Size="16" />
                                        <span class="text-sm">@feature</span>
                                    </li>
                                }
                            </ul>
                        </CardContentCn>
                        <CardFooterCn Class="pt-4">
                            <ButtonCn Class="@Cn.Merge("w-full gap-2", plan.IsPopular ? "bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white hover:opacity-90 border-0" : "")"
                                      Size="ButtonSize.Lg"
                                      Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                                @plan.Cta
                                @if (plan.IsPopular)
                                {
                                    <LucideArrowRightCn Class="h-4 w-4" Size="16" />
                                }
                            </ButtonCn>
                        </CardFooterCn>
                    </CardCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, string Description, string[] Features, bool IsPopular, string Cta, string Gradient);

    private static readonly Plan[] _plans =
    [
        new("Starter", 0, "For individuals exploring the platform.", ["Up to 5 projects", "2 GB storage", "Community support", "Core analytics", "Standard integrations"], false, "Get Started Free", "from-blue-500 to-cyan-400"),
        new("Pro", 49, "For teams building production apps.", ["Unlimited projects", "100 GB storage", "Priority support (4h SLA)", "Advanced analytics", "All integrations", "Custom domains", "Team collaboration (15 seats)", "API access with webhooks"], true, "Start Free Trial", "from-violet-600 via-purple-500 to-fuchsia-500"),
        new("Scale", 149, "For organizations with advanced needs.", ["Everything in Pro", "Unlimited storage", "Dedicated support engineer", "SSO & SCIM provisioning", "Audit logs & compliance", "Custom SLA (99.99%)", "On-premise deployment"], false, "Contact Sales", "from-orange-500 to-rose-500"),
    ];
}
