@* ========================================
   Block: pricing-audience-tabs
   Title: Pricing Audience Tabs
   Description: Tabbed pricing section with audience-specific plan sets for freelancers, startups, and enterprise teams
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideBuilding2Cn, LucideCheckCn, LucideRocketCn, LucideUserCn
   Source: original/blocks/pricing/pricing-audience-tabs.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Plans for every stage
            </h2>
            <p class="text-muted-foreground text-lg">
                Whether you're a solo creator or a Fortune 500 company, we have you covered.
            </p>
        </div>

        <div class="mx-auto max-w-5xl">
            <TabsCn DefaultValue="startup" Class="space-y-8">
                <div class="flex justify-center">
                    <TabsListCn Class="grid w-full max-w-md grid-cols-3">
                        @foreach (var audience in _audiences)
                        {
                            <TabsTriggerCn Value="@audience.Id" Class="gap-1.5">
                                @audience.IconFragment
                                <span class="hidden sm:inline">@audience.Label</span>
                            </TabsTriggerCn>
                        }
                    </TabsListCn>
                </div>

                @foreach (var audience in _audiences)
                {
                    <TabsContentCn Value="@audience.Id">
                        <p class="text-muted-foreground mb-8 text-center text-sm">
                            @audience.Description
                        </p>
                        <div class="grid gap-6 md:grid-cols-3 md:gap-4 lg:gap-6">
                            @foreach (var plan in audience.Plans)
                            {
                                <CardCn
                                    Class="@(Cn.Merge("relative flex flex-col", plan.IsPopular ? "border-primary shadow-lg ring-1 ring-primary/20 md:scale-105" : "border-border"))">
                                    @if (plan.IsPopular)
                                    {
                                        <div class="absolute -top-3 right-4">
                                            <BadgeCn>Best Value</BadgeCn>
                                        </div>
                                    }
                                    <CardHeaderCn Class="pb-4">
                                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                                        <div class="mt-2 flex items-baseline gap-1">
                                            @if (plan.IsNumericPrice)
                                            {
                                                <span class="text-4xl font-bold tracking-tight">
                                                    $@plan.Price
                                                </span>
                                                @if (plan.NumericPrice > 0)
                                                {
                                                    <span class="text-muted-foreground text-sm">
                                                        /@(plan.Period.Replace("per ", ""))
                                                    </span>
                                                }
                                                @if (plan.NumericPrice == 0)
                                                {
                                                    <span class="text-muted-foreground text-sm">@plan.Period</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-4xl font-bold tracking-tight">@plan.Price</span>
                                            }
                                        </div>
                                        <p class="text-muted-foreground mt-2 text-sm">@plan.Description</p>
                                    </CardHeaderCn>
                                    <CardContentCn Class="flex-1">
                                        <ul class="space-y-3">
                                            @foreach (var feature in plan.Features)
                                            {
                                                <li class="flex items-start gap-3">
                                                    <LucideCheckCn Size="16" Class="text-primary mt-0.5 shrink-0" />
                                                    <span class="text-sm">@feature</span>
                                                </li>
                                            }
                                        </ul>
                                    </CardContentCn>
                                    <CardFooterCn Class="pt-4">
                                        <ButtonCn
                                            Class="w-full"
                                            Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)"
                                            Size="ButtonSize.Lg"
                                            AsChild="true">
                                            <a href="#">@plan.Cta</a>
                                        </ButtonCn>
                                    </CardFooterCn>
                                </CardCn>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record PlanItem(string Name, string Price, string Period, string Description, string[] Features, bool IsPopular, string Cta)
    {
        public bool IsNumericPrice => int.TryParse(Price, out _);
        public int NumericPrice => int.TryParse(Price, out var v) ? v : 0;
    }

    private record AudienceItem(string Id, string Label, string Description, RenderFragment IconFragment, PlanItem[] Plans);

    private readonly AudienceItem[] _audiences =
    [
        new("freelancer", "Freelancers", "For independent creators and solo builders",
            @<LucideUserCn Size="16" />,
            [
                new("Free", "0", "forever", "Get started with the basics.",
                    ["3 active projects", "1 GB storage", "Basic templates", "Community support"], false, "Start Free"),
                new("Creator", "19", "per month", "For full-time freelancers.",
                    ["Unlimited projects", "25 GB storage", "Premium templates", "Client portals", "Email support", "Custom domain"], true, "Start Free Trial"),
                new("Studio", "49", "per month", "For freelancers with subcontractors.",
                    ["Everything in Creator", "100 GB storage", "5 collaborators", "White-label exports", "Priority support", "Advanced analytics"], false, "Start Free Trial"),
            ]),
        new("startup", "Startups", "For fast-moving teams building products",
            @<LucideRocketCn Size="16" />,
            [
                new("Launch", "29", "per month", "Ship your MVP faster.",
                    ["Unlimited projects", "50 GB storage", "Up to 5 members", "Email support", "Basic integrations"], false, "Start Free Trial"),
                new("Scale", "79", "per month", "For teams finding product-market fit.",
                    ["Everything in Launch", "200 GB storage", "Up to 20 members", "Priority support", "Advanced integrations", "API access", "Custom workflows"], true, "Start Free Trial"),
                new("Growth", "149", "per month", "For scaling post-PMF teams.",
                    ["Everything in Scale", "Unlimited storage", "Unlimited members", "Dedicated CSM", "SSO & SCIM", "Audit logs", "Custom SLA", "Onboarding assistance"], false, "Contact Sales"),
            ]),
        new("enterprise", "Enterprise", "For large organizations with compliance needs",
            @<LucideBuilding2Cn Size="16" />,
            [
                new("Team", "199", "per month", "Department-level deployment.",
                    ["Up to 50 members", "500 GB storage", "SSO authentication", "Role-based access", "Audit logs (90 days)", "Priority support"], false, "Start Trial"),
                new("Organization", "499", "per month", "Company-wide deployment.",
                    ["Unlimited members", "Unlimited storage", "Advanced SSO & SCIM", "Unlimited audit logs", "Dedicated CSM", "Custom integrations", "99.99% SLA", "On-premise option"], true, "Contact Sales"),
                new("Custom", "Custom", "tailored", "Built for your requirements.",
                    ["Everything in Organization", "Custom contracts", "Dedicated infrastructure", "Custom compliance", "Professional services", "24/7 phone support"], false, "Talk to Us"),
            ]),
    ];
}
