@* ============================================================
   Block: pricing-support-tiers
   Title: PricingSupportTiers
   Description: A unified-card support tier pricing section for React and Next.js with Community, Priority, and Enterprise plans displayed as compact horizontal rows featuring SLA response time speedometers, NumberFlow animated prices with PillTabs billing toggle, inline channel and coverage features, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-support-tiers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Header *@
        <div class="px-6 py-8 text-center sm:px-10 sm:py-10">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Support plans
            </p>
            <h2 class="mt-2.5 text-3xl font-bold tracking-tight sm:text-4xl">
                Support that responds when you need it
            </h2>
            <p class="mx-auto mt-2.5 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
                Every plan includes our community. Add Priority or Enterprise for guaranteed response
                times.
            </p>

            <div class="mt-6 flex justify-center">
                <div class="inline-flex items-center rounded-full border bg-muted p-1 gap-1">
                    <button class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "monthly" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _billing = "monthly")">
                        Monthly
                    </button>
                    <button class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _billing == "annually" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _billing = "annually")">
                        Annually
                    </button>
                </div>
            </div>
        </div>

        @* Plan rows *@
        @foreach (var plan in _plans)
        {
            var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
            <div class="@Cn.Merge("border-t", plan.IsPopular ? "bg-muted/40" : "")">
                <div class="px-6 py-6 sm:px-10 sm:py-7">
                    @* Top row: icon + name + price + CTA *@
                    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                        @* Left: icon + name + description *@
                        <div class="flex min-w-0 flex-1 items-start gap-3.5">
                            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-foreground text-background">
                                <LucideIconCn Name="@plan.IconName" Size="16" Class="size-4" aria-hidden="true" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="text-lg font-bold tracking-tight">@plan.Name</h3>
                                    @if (plan.IsPopular)
                                    {
                                        <span class="rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                                            Best Value
                                        </span>
                                    }
                                </div>
                                <p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">
                                    @plan.Description
                                </p>
                            </div>
                        </div>

                        @* Right: price + CTA — stacked on mobile, inline on sm+ *@
                        <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-end sm:gap-5">
                            <div class="flex items-baseline gap-1.5 sm:min-w-[100px] sm:justify-end">
                                @if (price == 0)
                                {
                                    <span class="text-3xl font-bold tabular-nums">Free</span>
                                }
                                else
                                {
                                    <span class="text-3xl font-bold tabular-nums">$@price</span>
                                }
                                @if (price > 0)
                                {
                                    <span class="text-xs text-muted-foreground">/mo</span>
                                }
                            </div>
                            <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 sm:w-[200px]">
                                @plan.Cta
                            </ButtonCn>
                        </div>
                    </div>

                    @* SLA speedometer *@
                    <div class="mt-5 flex items-center gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline justify-between gap-2">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                    @plan.SlaSubLabel
                                </p>
                                <p class="text-sm font-bold tracking-tight tabular-nums">
                                    @plan.SlaLabel
                                </p>
                            </div>
                            <div aria-hidden="true"
                                 class="mt-2 h-2 overflow-hidden rounded-full bg-muted-foreground/15">
                                <div class="@Cn.Merge("h-full rounded-full", plan.SlaPercent >= 90 ? "bg-emerald-500" : plan.SlaPercent >= 50 ? "bg-foreground" : "bg-muted-foreground/50")"
                                     style="@($"width:{plan.SlaPercent}%")">
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Channels + coverage chips *@
                    <div class="mt-5 grid gap-4 sm:grid-cols-2">
                        <div>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                Channels
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var channel in plan.Channels)
                                {
                                    <span class="rounded-full border border-border/70 bg-background/80 px-2.5 py-1 text-xs font-medium text-foreground">
                                        @channel
                                    </span>
                                }
                            </div>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                Coverage
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var coverageItem in plan.Coverage)
                                {
                                    <span class="rounded-full border border-border/70 bg-background/80 px-2.5 py-1 text-xs font-medium text-foreground">
                                        @coverageItem
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-6 py-3.5 sm:px-10">
            <p class="text-center text-xs text-muted-foreground">
                Support add-ons apply per account, not per user. Cancel or change tiers anytime.
            </p>
        </div>
    </div>
</section>

@code {
    private string _billing = "monthly";

    private record SupportPlan(
        string Id,
        string Name,
        string Description,
        int MonthlyPrice,
        int AnnualPrice,
        string SlaLabel,
        string SlaSubLabel,
        int SlaPercent,
        string IconName,
        string[] Channels,
        string[] Coverage,
        string Cta,
        bool IsPopular
    );

    private static readonly SupportPlan[] _plans =
    [
        new(
            "community",
            "Community",
            "Self-serve docs and community forums for individual builders.",
            0, 0,
            "Best effort",
            "Critical issue response",
            25,
            "users",
            ["Forum", "Documentation", "Public Discord"],
            ["Self-serve 24/7", "Knowledge base"],
            "Get started free",
            false
        ),
        new(
            "priority",
            "Priority",
            "Guaranteed response times with shared Slack for production teams.",
            79, 59,
            "Under 1 hour",
            "Critical issue response",
            70,
            "message-square",
            ["Email", "Shared Slack", "In-app chat", "Forum"],
            ["Mon-Fri 9am-6pm ET", "Named contact", "Onboarding call"],
            "Start Priority",
            true
        ),
        new(
            "enterprise",
            "Enterprise",
            "White-glove support with a dedicated success engineer 24/7.",
            499, 399,
            "Under 15 min",
            "Critical issue response",
            100,
            "phone",
            ["Dedicated Slack", "24/7 phone", "CTO escalation", "Email"],
            ["24/7 incl. holidays", "Named engineer", "Quarterly QBRs", "Custom training"],
            "Contact sales",
            false
        ),
    ];
}
