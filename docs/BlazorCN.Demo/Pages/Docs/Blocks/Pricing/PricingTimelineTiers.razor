@* ============================================================
   Block: pricing-timeline-tiers
   Title: PricingTimelineTiers
   Description: A vertical timeline pricing section for React and Next.js with progressive tenure bracket nodes connected by a vertical line, NumberFlow animated discount percentages per node, strikethrough base price with computed discounted price, emerald unlock checkmarks, absolute-positioned node markers, and a bottom ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-timeline-tiers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-muted-foreground">
            <LucideIconCn Name="sparkles" Size="14" StrokeWidth="2" Class="size-3.5 text-emerald-600 dark:text-emerald-500" />
            Tenure rewards
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            The longer you stay, the less you pay
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
            Discounts grow automatically with your tenure. No coupons, no renewals, no action required
            — every anniversary your rate drops further.
        </p>
    </div>

    @* Vertical timeline *@
    <div class="relative mt-10 pl-16">
        @* Continuous vertical line behind the nodes *@
        <div aria-hidden="true" class="absolute top-3 bottom-3 left-6 w-px bg-border"></div>

        <ol class="space-y-4">
            @foreach (var t in _tiers)
            {
                var tier = t;
                var discountedPrice = ComputeDiscountedPrice(tier.DiscountPercent);
                <li class="relative">
                    @* Circle node marker — absolute positioned on the line *@
                    <div aria-hidden="true"
                         class="@Cn.Merge("-left-[46px] absolute top-4 flex size-12 items-center justify-center rounded-full border-2 text-[11px] font-extrabold uppercase tracking-wider shadow-sm", tier.IsCurrent ? "border-foreground bg-foreground text-background" : "border-border bg-background text-muted-foreground")">
                        @tier.TenureShort
                    </div>

                    @* Bracket card *@
                    <div class="@Cn.Merge("rounded-2xl border bg-card p-5 sm:p-6", tier.IsCurrent ? "border-foreground/20 ring-2 ring-foreground/10" : "")">
                        @* Top row: tenure label + current badge *@
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <h3 class="text-xl font-bold tracking-tight">@tier.Tenure</h3>
                                <p class="mt-0.5 text-sm text-muted-foreground">@tier.Tagline</p>
                            </div>
                            @if (tier.IsCurrent)
                            {
                                <span class="inline-flex items-center rounded-full bg-foreground px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-background">
                                    You are here
                                </span>
                            }
                        </div>

                        @* Discount + price row *@
                        <div class="mt-4 flex items-end justify-between gap-4">
                            <div>
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                    Your discount
                                </p>
                                <div class="flex items-baseline gap-1">
                                    <span class="@Cn.Merge("font-bold tracking-tight tabular-nums text-5xl", tier.DiscountPercent > 0 ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground/50")">
                                        @if (tier.DiscountPercent == 0)
                                        {
                                            @("—")
                                        }
                                        else
                                        {
                                            @("-")@(tier.DiscountPercent)@("%")
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                    Pro tier
                                </p>
                                <div class="mt-1 flex items-baseline justify-end gap-1.5">
                                    @if (tier.DiscountPercent > 0)
                                    {
                                        <s aria-hidden="true" class="text-sm tabular-nums text-muted-foreground/60">
                                            $@BasePrice
                                        </s>
                                    }
                                    <span class="text-2xl font-bold tracking-tight tabular-nums">
                                        $@discountedPrice
                                    </span>
                                    <span class="text-xs text-muted-foreground">/mo</span>
                                </div>
                            </div>
                        </div>

                        @* Unlocked benefits *@
                        <ul class="mt-5 grid gap-2 border-t pt-4 sm:grid-cols-2">
                            @foreach (var unlock in tier.Unlocks)
                            {
                                <li class="flex items-start gap-2 text-xs text-foreground">
                                    <LucideIconCn Name="check"
                                                  Size="14"
                                                  StrokeWidth="3"
                                                  Class="@Cn.Merge("mt-0.5 size-3.5 shrink-0 stroke-[3]", tier.DiscountPercent > 0 ? "text-emerald-600 dark:text-emerald-500" : "text-muted-foreground/40")" />
                                    <span class="leading-snug">@unlock</span>
                                </li>
                            }
                        </ul>

                        @* CTA only on last node *@
                        @if (tier.IsLast)
                        {
                            <div class="mt-5 border-t pt-5">
                                <ButtonCn Class="w-full">Start your journey</ButtonCn>
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>
    </div>

    @* Trust footer *@
    <p class="mt-8 text-center text-xs text-muted-foreground">
        Tenure tracked from your account creation date. Discounts apply automatically on your next
        invoice and stack with any annual billing savings.
    </p>
</section>

@code {
    private const int BasePrice = 49;

    private record TimelineTier(string Id, string Tenure, string TenureShort, int DiscountPercent, string Tagline, string[] Unlocks, bool IsCurrent = false, bool IsLast = false);

    private static readonly TimelineTier[] _tiers =
    [
        new("day-one",    "Day 1",   "D1",  0,  "Welcome to Pro",        ["Full Pro feature set", "Community support", "Core integrations"]),
        new("year-one",   "Year 1",  "1Y",  10, "Your first anniversary", ["Priority chat (4h SLA)", "Advanced analytics", "1 year of audit logs"], IsCurrent: true),
        new("year-three", "Year 3",  "3Y",  20, "Trusted member",        ["Dedicated success manager", "SAML SSO", "Priority feature requests"]),
        new("year-five",  "Year 5+", "5Y+", 30, "Lifetime ally",         ["Lifetime price lock", "Quarterly strategy calls", "99.99% custom SLA"], IsLast: true),
    ];

    private static int ComputeDiscountedPrice(int discountPercent) =>
        (int)Math.Round(BasePrice * (1.0 - discountPercent / 100.0));
}
