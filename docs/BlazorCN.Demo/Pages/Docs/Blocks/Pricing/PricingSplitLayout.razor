@* ========================================
   Block: pricing-split-layout
   Title: Pricing Split Layout
   Description: Two-column split layout with marketing copy and value proposition on the left and pricing cards on the right
   Long Description: Single featured plan spotlight layout
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideShieldCheckCn, LucideStarCn, LucideZapCn
   Source: original/blocks/pricing/pricing-split-layout.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto max-w-6xl">
            <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
                @* Left column: Value proposition *@
                <div class="lg:col-span-2">
                    <div class="lg:sticky lg:top-24">
                        <BadgeCn Class="mb-4" Variant="BadgeVariant.Secondary">Pricing</BadgeCn>
                        <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl">
                            The last platform your team will need
                        </h2>
                        <p class="text-muted-foreground mb-8 text-base">
                            Join 5,000+ teams who replaced their entire stack with a single tool that actually works.
                        </p>

                        @* Benefits *@
                        <div class="mb-8 space-y-5">
                            <div class="flex gap-3">
                                <div class="bg-primary/10 flex h-8 w-8 shrink-0 items-center justify-center rounded-md">
                                    <LucideZapCn Class="text-primary h-4 w-4" Size="16" />
                                </div>
                                <div>
                                    <div class="text-sm font-semibold">Ship 3x faster</div>
                                    <div class="text-muted-foreground text-sm">Teams report shipping features 3x faster after switching.</div>
                                </div>
                            </div>
                            <div class="flex gap-3">
                                <div class="bg-primary/10 flex h-8 w-8 shrink-0 items-center justify-center rounded-md">
                                    <LucideShieldCheckCn Class="text-primary h-4 w-4" Size="16" />
                                </div>
                                <div>
                                    <div class="text-sm font-semibold">Enterprise-grade security</div>
                                    <div class="text-muted-foreground text-sm">SOC 2 Type II compliant with 99.99% uptime SLA.</div>
                                </div>
                            </div>
                            <div class="flex gap-3">
                                <div class="bg-primary/10 flex h-8 w-8 shrink-0 items-center justify-center rounded-md">
                                    <LucideStarCn Class="text-primary h-4 w-4" Size="16" />
                                </div>
                                <div>
                                    <div class="text-sm font-semibold">Rated #1 on G2</div>
                                    <div class="text-muted-foreground text-sm">Over 500 five-star reviews from developers and teams.</div>
                                </div>
                            </div>
                        </div>

                        <SeparatorCn Class="mb-6" />

                        @* Testimonial *@
                        <blockquote class="space-y-3">
                            <p class="text-muted-foreground text-sm italic leading-relaxed">
                                &ldquo;We evaluated 12 tools before finding this one. Our deployment time dropped from weeks to hours. Worth every penny.&rdquo;
                            </p>
                            <div class="flex items-center gap-3">
                                <AvatarCn Class="h-8 w-8">
                                    <AvatarFallbackCn Class="text-xs">JK</AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <div class="text-xs font-medium">James Kim</div>
                                    <div class="text-muted-foreground text-xs">VP Engineering, Meridian Labs</div>
                                </div>
                            </div>
                        </blockquote>
                    </div>
                </div>

                @* Right column: Plans *@
                <div class="space-y-4 lg:col-span-3">
                    @foreach (var plan in _plans)
                    {
                        <CardCn Class="@Cn.Merge("relative", plan.IsPopular ? "border-primary ring-1 ring-primary/20" : "")">
                            @if (plan.IsPopular)
                            {
                                <div class="absolute -top-3 right-4">
                                    <BadgeCn>Recommended</BadgeCn>
                                </div>
                            }
                            <CardHeaderCn Class="pb-4">
                                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                                    <div>
                                        <h3 class="text-lg font-semibold">@plan.Name</h3>
                                        <p class="text-muted-foreground text-sm">@plan.Description</p>
                                    </div>
                                    <div class="flex items-baseline gap-1">
                                        <span class="text-4xl font-bold tracking-tight">$@plan.Price</span>
                                        <span class="text-muted-foreground text-sm">@plan.Period</span>
                                    </div>
                                </div>
                            </CardHeaderCn>
                            <CardContentCn>
                                <ul class="grid gap-2 sm:grid-cols-2">
                                    @foreach (var feature in plan.Features)
                                    {
                                        <li class="flex items-center gap-2">
                                            <LucideCheckCn Class="text-primary h-4 w-4 shrink-0" Size="16" />
                                            <span class="text-sm">@feature</span>
                                        </li>
                                    }
                                </ul>
                            </CardContentCn>
                            <CardFooterCn>
                                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg"
                                          Variant="@(plan.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                                    @plan.Cta
                                    <LucideArrowRightCn Class="h-4 w-4" Size="16" />
                                </ButtonCn>
                            </CardFooterCn>
                        </CardCn>
                    }

                    <p class="text-muted-foreground text-center text-sm">
                        14-day free trial on Pro. No credit card required.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Plan(string Name, int Price, string Period, string Description, string[] Features, bool IsPopular, string Cta);

    private static readonly Plan[] _plans =
    [
        new("Pro", 39, "/month", "For small teams shipping fast.", ["Unlimited projects", "50 GB storage", "Up to 10 members", "Priority support", "Advanced analytics", "API access"], true, "Start Free Trial"),
        new("Enterprise", 149, "/month", "For organizations at scale.", ["Everything in Pro", "Unlimited storage", "Unlimited members", "SSO & SCIM", "Audit logs", "Dedicated CSM", "Custom SLA"], false, "Contact Sales"),
    ];
}
