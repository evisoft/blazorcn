@* ============================================================
   Block: pricing-payment-schedule
   Title: PricingPaymentSchedule
   Description: A four-column payment schedule pricing section for React and Next.js with cards for Monthly, Quarterly, Semi-Annual, and Annual billing showing per-month equivalent, total cost, savings percentage, and a dark highlight on the recommended Semi-Annual schedule built with shadcn/ui and Tailwind CSS
   Source: original/blocks/pricing/pricing-payment-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Headline *@
    <div class="text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Payment Options
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Choose your payment schedule
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
            Same Pro plan, flexible payment. Pay monthly for flexibility, or commit longer to save up
            to <span class="font-semibold text-emerald-600 dark:text-emerald-500">30%</span> on
            your subscription.
        </p>
    </div>

    @* Schedule cards *@
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var sched in _schedules)
        {
            var isDark = sched.IsPopular;
            var hasSavings = sched.Savings > 0;
            <article class="@Cn.Merge("relative flex h-full flex-col overflow-hidden rounded-2xl p-6", isDark ? "bg-foreground text-background" : "bg-muted")">
                @* Reserved badge slot on every card *@
                <div class="mb-4 flex h-7 items-start">
                    @if (isDark)
                    {
                        <span class="inline-flex w-fit rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md">
                            Best Value
                        </span>
                    }
                </div>

                <h3 class="@Cn.Merge("text-lg font-bold tracking-tight", isDark ? "text-background" : "text-foreground")">
                    @sched.Name
                </h3>
                <p class="@Cn.Merge("mt-1 text-xs", isDark ? "text-background/60" : "text-muted-foreground")">
                    @sched.Interval
                </p>

                @* Price *@
                <div class="mt-6">
                    <div class="flex items-baseline gap-1.5">
                        @if (hasSavings)
                        {
                            <s aria-hidden="true" class="@Cn.Merge("text-sm tabular-nums", isDark ? "text-background/40" : "text-muted-foreground/60")">
                                $@_baseMonthly
                            </s>
                        }
                        <span class="@Cn.Merge("text-4xl font-bold tracking-tight tabular-nums", isDark ? "text-background" : "text-foreground")">
                            $@sched.MonthlyEquivalent
                        </span>
                        <span class="@Cn.Merge("text-sm", isDark ? "text-background/60" : "text-muted-foreground")">
                            /mo
                        </span>
                    </div>
                    @if (hasSavings)
                    {
                        <p class="@Cn.Merge("mt-1.5 text-sm font-bold", isDark ? "text-emerald-400" : "text-emerald-600 dark:text-emerald-500")">
                            Save @sched.Savings% vs monthly
                        </p>
                    }
                    else
                    {
                        <p class="@Cn.Merge("mt-1.5 text-sm font-medium", isDark ? "text-background/60" : "text-muted-foreground")">
                            Maximum flexibility
                        </p>
                    }
                </div>

                @* CTA *@
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(isDark ? ButtonVariant.Outline : ButtonVariant.Default)"
                          Class="@Cn.Merge("mt-6 w-full", isDark ? "border-background/30 bg-background text-foreground hover:bg-background/90 hover:text-foreground" : "")">
                    @sched.Cta
                </ButtonCn>

                @* Payment details *@
                <dl class="@Cn.Merge("mt-6 space-y-3 border-t pt-5 text-sm", isDark ? "border-background/15" : "border-border/60")">
                    <div class="flex items-center justify-between gap-2">
                        <dt class="@Cn.Merge("text-xs font-medium", isDark ? "text-background/60" : "text-muted-foreground")">
                            Per payment
                        </dt>
                        <dd class="@Cn.Merge("font-bold tabular-nums", isDark ? "text-background" : "text-foreground")">
                            $@sched.PaymentAmount
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <dt class="@Cn.Merge("text-xs font-medium", isDark ? "text-background/60" : "text-muted-foreground")">
                            Annual cost
                        </dt>
                        <dd class="@Cn.Merge("font-bold tabular-nums", isDark ? "text-background" : "text-foreground")">
                            $@sched.TotalAnnualCost
                        </dd>
                    </div>
                    <div class="flex items-start justify-between gap-2">
                        <dt class="@Cn.Merge("flex items-center gap-1.5 text-xs font-medium", isDark ? "text-background/60" : "text-muted-foreground")">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                            Next charge
                            <TooltipProviderCn>
                                <TooltipCn>
                                    <TooltipTriggerCn>
                                        <LucideIconCn Name="info" Size="12" Class="@Cn.Merge("size-3 shrink-0 cursor-help", isDark ? "text-background/40" : "text-muted-foreground/40")" aria-hidden="true" />
                                    </TooltipTriggerCn>
                                    <TooltipContentCn Class="max-w-[220px]">
                                        <p class="text-xs">@sched.NextPaymentTooltip</p>
                                    </TooltipContentCn>
                                </TooltipCn>
                            </TooltipProviderCn>
                        </dt>
                        <dd class="@Cn.Merge("text-right text-xs font-semibold", isDark ? "text-background" : "text-foreground")">
                            @sched.NextPayment
                        </dd>
                    </div>
                </dl>
            </article>
        }
    </div>

    <p class="mt-8 text-center text-xs text-muted-foreground">
        All schedules include a 14-day free trial and unlimited cancellation. Switch schedules
        anytime from your billing settings.
    </p>
</section>

@code {
    private const int _baseMonthly = 49;

    private record Schedule(
        string Id,
        string Name,
        int MonthlyEquivalent,
        int PaymentAmount,
        int TotalAnnualCost,
        int Savings,
        string Interval,
        string PaymentInterval,
        string NextPayment,
        string NextPaymentTooltip,
        string Cta,
        bool IsPopular);

    private static readonly Schedule[] _schedules =
    [
        new("monthly", "Monthly", 49, 49, 588, 0, "Every month", "billed monthly", "May 1, 2026",
            "Charged on the 1st of every month. Cancel anytime from your billing settings.",
            "Start monthly", false),
        new("quarterly", "Quarterly", 44, 132, 528, 10, "Every 3 months", "billed quarterly", "Jul 1, 2026",
            "Single charge of $132 every 3 months. Save 10% versus monthly billing.",
            "Start quarterly", false),
        new("semiannual", "Semi-Annual", 39, 234, 468, 20, "Every 6 months", "billed semi-annually", "Oct 1, 2026",
            "Single charge of $234 every 6 months. The sweet spot for savings without a full-year commitment.",
            "Choose Semi-Annual", true),
        new("annual", "Annual", 34, 408, 408, 30, "Every 12 months", "billed annually", "Apr 1, 2027",
            "Single charge of $408 once per year. Maximum savings for committed customers.",
            "Start annual", false),
    ];
}
