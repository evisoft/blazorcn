@* ========================================
   Block: pricing-comparison-table
   Title: Pricing Comparison Table
   Description: Feature comparison table across pricing tiers with checkmarks, category groupings, tooltips, and highlighted recommended plan
   Long Description: Classic three tier pricing cards layout
   Dependencies: LucideCheckCn, LucideHelpCircleCn, LucideMinusCn
   Source: original/blocks/pricing/pricing-comparison-table.tsx
   ======================================== *@

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
            <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
                Compare plans in detail
            </h2>
            <p class="text-muted-foreground text-lg">
                See exactly what you get with each plan. Every feature, every limit, at a glance.
            </p>
        </div>

        <div class="mx-auto max-w-4xl">
            <div class="overflow-hidden rounded-lg border">
                <TableCn>
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="text-foreground w-[200px] font-semibold">Features</TableHeadCn>
                            @foreach (var tier in _tiers)
                            {
                                <TableHeadCn Class="@Cn.Merge("text-center", tier.IsPopular ? "bg-primary/5 border-x-2 border-t-2 border-primary" : "")">
                                    <div class="space-y-2 py-3">
                                        @if (tier.IsPopular)
                                        {
                                            <BadgeCn Class="mb-1">Popular</BadgeCn>
                                        }
                                        <div class="text-lg font-bold">@tier.Name</div>
                                        <div class="text-2xl font-bold">
                                            @if (tier.Price == 0)
                                            {
                                                <span>Free</span>
                                            }
                                            else
                                            {
                                                <span>$@tier.Price</span><span class="text-muted-foreground text-xs font-normal">/mo</span>
                                            }
                                        </div>
                                        <p class="text-muted-foreground text-xs">@tier.Description</p>
                                        <ButtonCn Class="mt-2 w-full" Size="ButtonSize.Sm"
                                                  Variant="@(tier.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">
                                            @tier.Cta
                                        </ButtonCn>
                                    </div>
                                </TableHeadCn>
                            }
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var category in _categories)
                        {
                            <TableRowCn Class="bg-muted/40">
                                <TableCellCn Colspan="@(_tiers.Length + 1)" Class="py-2 text-xs font-semibold uppercase tracking-wider">
                                    @category
                                </TableCellCn>
                            </TableRowCn>
                            @foreach (var feature in _features.Where(f => f.Category == category))
                            {
                                <TableRowCn>
                                    <TableCellCn>
                                        @if (!string.IsNullOrEmpty(feature.Tooltip))
                                        {
                                            <TooltipCn>
                                                <TooltipTriggerCn>
                                                    <span class="inline-flex cursor-help items-center gap-1.5 text-sm">
                                                        @feature.Name
                                                        <LucideCircleQuestionMarkCn Class="text-muted-foreground h-3.5 w-3.5" Size="14" />
                                                    </span>
                                                </TooltipTriggerCn>
                                                <TooltipContentCn>
                                                    <p class="max-w-xs">@feature.Tooltip</p>
                                                </TooltipContentCn>
                                            </TooltipCn>
                                        }
                                        else
                                        {
                                            <span class="text-sm">@feature.Name</span>
                                        }
                                    </TableCellCn>
                                    @foreach (var tier in _tiers)
                                    {
                                        var val = feature.Values.GetValueOrDefault(tier.Id, "");
                                        <TableCellCn Class="@Cn.Merge("text-center", tier.IsPopular ? "bg-primary/5 border-x-2 border-primary" : "")">
                                            <div class="flex justify-center">
                                                @if (val is "true")
                                                {
                                                    <LucideCheckCn Class="@Cn.Merge("h-4 w-4", tier.IsPopular ? "text-primary" : "text-green-600")" Size="16" />
                                                }
                                                else if (val is "false" or "")
                                                {
                                                    <LucideMinusCn Class="text-muted-foreground/30 h-4 w-4" Size="16" />
                                                }
                                                else
                                                {
                                                    <span class="@Cn.Merge("text-sm font-medium", tier.IsPopular ? "text-primary" : "")">@val</span>
                                                }
                                            </div>
                                        </TableCellCn>
                                    }
                                </TableRowCn>
                            }
                        }
                    </TableBodyCn>
                </TableCn>
            </div>

            <p class="text-muted-foreground mt-6 text-center text-sm">
                All plans include a 14-day free trial. No credit card required. Cancel anytime.
            </p>
        </div>
    </div>
</section>

@code {
    private record Tier(string Id, string Name, int Price, string Description, bool IsPopular, string Cta);
    private record Feature(string Name, string? Tooltip, string Category, Dictionary<string, string> Values);

    private static readonly Tier[] _tiers =
    [
        new("starter", "Starter", 0, "For individuals", false, "Get Started"),
        new("pro", "Pro", 29, "For growing teams", true, "Start Free Trial"),
        new("business", "Business", 79, "For organizations", false, "Contact Sales"),
    ];

    private static readonly string[] _categories = ["Core", "Collaboration", "Security", "Support"];

    private static readonly Feature[] _features =
    [
        new("Team members", null, "Core", new() { ["starter"] = "1", ["pro"] = "Up to 10", ["business"] = "Unlimited" }),
        new("Projects", null, "Core", new() { ["starter"] = "3", ["pro"] = "Unlimited", ["business"] = "Unlimited" }),
        new("Storage", "Cloud storage for files and assets", "Core", new() { ["starter"] = "1 GB", ["pro"] = "50 GB", ["business"] = "500 GB" }),
        new("API access", "REST and GraphQL API endpoints", "Core", new() { ["starter"] = "false", ["pro"] = "true", ["business"] = "true" }),
        new("Webhooks", "Real-time event notifications", "Core", new() { ["starter"] = "false", ["pro"] = "true", ["business"] = "true" }),
        new("Real-time collaboration", null, "Collaboration", new() { ["starter"] = "false", ["pro"] = "true", ["business"] = "true" }),
        new("Comments & mentions", null, "Collaboration", new() { ["starter"] = "true", ["pro"] = "true", ["business"] = "true" }),
        new("Guest access", "Invite external collaborators", "Collaboration", new() { ["starter"] = "false", ["pro"] = "5 guests", ["business"] = "Unlimited" }),
        new("Custom roles", "Role-based access control", "Collaboration", new() { ["starter"] = "false", ["pro"] = "false", ["business"] = "true" }),
        new("SSO authentication", "SAML and OIDC support", "Security", new() { ["starter"] = "false", ["pro"] = "false", ["business"] = "true" }),
        new("Audit logs", "Track all user actions", "Security", new() { ["starter"] = "false", ["pro"] = "30 days", ["business"] = "Unlimited" }),
        new("Data encryption", null, "Security", new() { ["starter"] = "true", ["pro"] = "true", ["business"] = "true" }),
        new("Support", null, "Support", new() { ["starter"] = "Community", ["pro"] = "Email (24h)", ["business"] = "Priority (4h)" }),
        new("Onboarding assistance", null, "Support", new() { ["starter"] = "false", ["pro"] = "false", ["business"] = "true" }),
        new("Uptime SLA", null, "Support", new() { ["starter"] = "false", ["pro"] = "99.9%", ["business"] = "99.99%" }),
    ];
}
