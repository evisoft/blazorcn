@* ============================================================
   Block: pricing-per-user-simple
   Title: PricingPerUserSimple
   Description: A simple two-column per-seat pricing block for React and Next.js with Basic and Pro plan cards, prominent NumberFlow per-user prices, PillTabs billing toggle, ShadcnioButton CTAs with sliding arrow, emerald checkmarks, red Best Value badge, and progressive feature lists built with shadcn/ui Tooltip and Tailwind CSS
   Source: original/blocks/pricing/pricing-per-user-simple.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="space-y-8">

        @* Headline *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Pricing
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Simple per-seat pricing
            </h2>
            <p class="mx-auto mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
                One price per user, no surprises. Scale your team up or down anytime — only pay for
                active seats.
            </p>

            @* Billing toggle (PillTabs rendered as raw HTML) *@
            <div class="mt-6 flex items-center justify-center">
                <div class="inline-flex rounded-full border bg-muted p-1 text-sm font-medium"
                     role="tablist"
                     aria-label="Billing period"
                     id="pps-billing">
                    @foreach (var opt in _billingOptions)
                    {
                        var optItem = opt;
                        <button type="button"
                                role="tab"
                                aria-selected="@(_billing == optItem ? "true" : "false")"
                                class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _billing == optItem ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _billing = optItem)">
                            @(optItem == "monthly" ? "Monthly" : "Annually")
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Plan cards grid *@
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var plan in _plans)
            {
                var price = _billing == "monthly" ? plan.MonthlyPrice : plan.AnnualPrice;
                <article class="@Cn.Merge("relative flex h-full flex-col rounded-2xl border bg-muted p-6 sm:p-8", plan.IsPopular ? "ring-2 ring-foreground/10 md:order-2" : "md:order-1")">
                    @if (plan.IsPopular)
                    {
                        <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-red-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                            Best Value
                        </span>
                    }

                    @* Header *@
                    <div>
                        <h3 class="text-2xl font-bold tracking-tight">@plan.Name</h3>
                        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                            @plan.Description
                        </p>
                    </div>

                    @* Price *@
                    <div class="mt-6">
                        <div class="flex min-h-[60px] items-baseline gap-1.5">
                            <span class="text-2xl font-bold tabular-nums">$</span>
                            <span class="text-5xl font-bold tracking-tight tabular-nums">@price</span>
                            <span class="ml-1 text-sm text-muted-foreground">/user/mo</span>
                        </div>
                        <p class="mt-1 text-xs text-muted-foreground">
                            @(_billing == "annually"
                                ? $"Billed ${price * 12}/user annually"
                                : "Billed monthly, cancel anytime")
                        </p>
                    </div>

                    @* CTA *@
                    <ButtonCn Class="mt-6 w-full">@plan.Cta</ButtonCn>

                    @* Features *@
                    <div class="mt-7 flex-1">
                        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            @plan.FeatureHeading
                        </p>
                        <ul class="mt-4 space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start justify-between gap-2">
                                    <span class="flex items-start gap-2.5">
                                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                        <span class="text-sm font-medium text-foreground">
                                            @feature.Name
                                        </span>
                                    </span>
                                    @if (feature.Tooltip != null)
                                    {
                                        <TooltipProviderCn Delay="200">
                                            <TooltipCn>
                                                <TooltipTriggerCn>
                                                    <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 cursor-help text-muted-foreground/40" />
                                                </TooltipTriggerCn>
                                                <TooltipContentCn Align="FloatingAlign.Center" Class="max-w-[220px]">
                                                    <p class="text-xs">@feature.Tooltip</p>
                                                </TooltipContentCn>
                                            </TooltipCn>
                                        </TooltipProviderCn>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>

        @* Trust footer *@
        <p class="text-center text-xs text-muted-foreground">
            14-day free trial on Pro. No credit card required. Add or remove seats anytime — billed
            prorated.
        </p>

    </div>
</section>

@code {
    private string _billing = "monthly";

    private static readonly string[] _billingOptions = ["monthly", "annually"];

    private record PlanFeature(string Name, string? Tooltip = null);

    private record Plan(
        string Id,
        string Name,
        string Description,
        int MonthlyPrice,
        int AnnualPrice,
        string FeatureHeading,
        PlanFeature[] Features,
        string Cta,
        bool IsPopular
    );

    private static readonly Plan[] _plans =
    [
        new(
            Id: "basic",
            Name: "Basic",
            Description: "For small teams getting started with collaboration.",
            MonthlyPrice: 8,
            AnnualPrice: 6,
            FeatureHeading: "What's included:",
            Features:
            [
                new("Up to 10 team members"),
                new("5 active projects per workspace"),
                new("10GB shared storage", "Storage shared across all team members with 30-day version history on every file."),
                new("Email support (48h SLA)", "Guaranteed first response within 2 business days from our support team."),
                new("Basic reporting dashboard"),
                new("Slack and email integrations"),
            ],
            Cta: "Get started",
            IsPopular: false
        ),
        new(
            Id: "pro",
            Name: "Pro",
            Description: "For growing teams that need advanced tools and control.",
            MonthlyPrice: 16,
            AnnualPrice: 12,
            FeatureHeading: "Everything in Basic, plus:",
            Features:
            [
                new("Unlimited team members"),
                new("Unlimited projects"),
                new("100GB shared storage with CDN", "Global CDN delivery for assets with 90-day version history and instant rollback."),
                new("Priority support (4h SLA)", "Guaranteed first response within 4 business hours, Monday through Friday."),
                new("Advanced analytics with exports"),
                new("Custom workflows and automation", "Build automated workflows triggered by events, schedules, or webhook calls."),
                new("SAML SSO and SCIM provisioning"),
                new("Audit logs with 1-year retention"),
            ],
            Cta: "Start 14-day trial",
            IsPopular: true
        ),
    ];
}
