@* ===========================================================
   Block: blog-table-of-contents
   Title: Blog Table Of Contents
   Description: Article table of contents sidebar with nested sections, active state highlighting, and smooth scroll indicators
   Long Description: Navigate long-form articles with a structured table of contents. Active section highlighting and indented sub-sections help readers jump to exactly what they need.
   Dependencies: None
   Source: original/blocks/blog/blog-table-of-contents.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="list" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">Table of Contents</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">
                @_items.Count(i => i.Level == "h2") sections
            </p>
        </div>

        <nav class="px-6 py-4">
            <ul class="space-y-1">
                @foreach (var item in _items)
                {
                    var isActive = item.Id == _activeId;
                    <li>
                        <button type="button"
                                @onclick="@(() => _activeId = item.Id)"
                                class="@Cn.Merge("w-full rounded-md px-3 py-1.5 text-left text-sm transition-colors hover:bg-muted/50", item.Level == "h3" ? "ml-4" : null, isActive ? "border-l-2 border-foreground font-medium text-foreground" : "text-muted-foreground")">
                            @item.Title
                        </button>
                    </li>
                }
            </ul>
        </nav>
    </div>
</section>

@code {
    private string _activeId = "core-concepts";

    private record TocItem(string Id, string Title, string Level);

    private readonly List<TocItem> _items =
    [
        new("introduction", "Introduction", "h2"),
        new("getting-started", "Getting Started", "h2"),
        new("prerequisites", "Prerequisites", "h3"),
        new("installation", "Installation", "h3"),
        new("core-concepts", "Core Concepts", "h2"),
        new("data-fetching", "Data Fetching Patterns", "h3"),
        new("caching-strategies", "Caching Strategies", "h3"),
        new("advanced-usage", "Advanced Usage", "h2"),
        new("conclusion", "Conclusion", "h2"),
    ];
}
