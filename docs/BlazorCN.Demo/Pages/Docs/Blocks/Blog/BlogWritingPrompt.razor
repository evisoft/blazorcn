@* ===========================================================
   Block: blog-writing-prompt
   Title: Blog Writing Prompt
   Description: Daily writing prompt section with featured prompt, topic badge, word count suggestion, start button, and past prompts
   Long Description: Spark your audience's creativity with a daily writing prompt. Feature one headline prompt with a topic category and word count target, then list recent prompts below for writers who want more options.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-writing-prompt.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Writing Prompt</h2>
            <p class="mt-1 text-sm text-muted-foreground">Today&rsquo;s prompt to get you writing</p>
        </div>

        <div class="border-b px-6 py-5">
            <p class="text-base italic leading-relaxed text-foreground">&ldquo;@_featuredText&rdquo;</p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_featuredCategory
                </BadgeCn>
                <span class="text-xs text-muted-foreground">@_featuredWordCount</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="pen-line" Size="14" Class="h-3.5 w-3.5" />
                Start Writing
            </ButtonCn>
        </div>

        <div class="px-6 py-3">
            <span class="text-xs font-medium text-muted-foreground">Past Prompts</span>
        </div>

        @for (var i = 0; i < _pastPrompts.Count; i++)
        {
            var prompt = _pastPrompts[i];
            <div class="@($"cursor-pointer px-6 py-3 transition-colors hover:bg-muted/50{(i < _pastPrompts.Count - 1 ? " border-b" : "")}")">
                <span class="text-sm">@prompt.Text</span>
                <div class="mt-1">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                        @prompt.Category
                    </BadgeCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private const string _featuredText = "Describe a piece of technology you use every day but rarely think about. What would change if it disappeared tomorrow?";
    private const string _featuredCategory = "Reflection";
    private const string _featuredWordCount = "300-500 words";

    private record PastPrompt(string Text, string Category);

    private readonly List<PastPrompt> _pastPrompts =
    [
        new("Explain a complex concept to a five-year-old.", "Teaching"),
        new("Write about a bug that taught you something unexpected.", "Technical"),
    ];
}
