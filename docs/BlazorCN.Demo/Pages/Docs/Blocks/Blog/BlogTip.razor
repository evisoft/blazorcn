@* ===========================================================
   Block: blog-tip
   Title: Blog Tip
   Description: Quick tips section with categorized short tips displayed as scannable bordered cards with icons
   Long Description: Surface bite-sized advice readers can absorb in seconds. Each tip sits in its own bordered card with a category label so visitors can scan for relevance without committing to a full article.
   Dependencies: None
   Source: original/blocks/blog/blog-tip.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Quick Tips</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Short, actionable advice you can use today
            </p>
        </div>

        <div class="grid gap-3 p-4 sm:grid-cols-2">
            @foreach (var tip in _tips)
            {
                <div class="rounded-md border px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="lightbulb" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">@tip.Category</span>
                    </div>
                    <p class="mt-1.5 text-sm">@tip.Text</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Tip(string Category, string Text);

    private readonly List<Tip> _tips =
    [
        new("Performance",
            "Use dynamic imports for components that are only visible after user interaction to reduce initial bundle size."),
        new("Accessibility",
            "Always pair icon-only buttons with an aria-label so screen readers can announce the action."),
        new("TypeScript",
            "Prefer discriminated unions over optional fields when a value changes shape based on a status flag."),
        new("CSS",
            "Use gap instead of margin on flex and grid containers to avoid collapsing-margin surprises."),
    ];
}
