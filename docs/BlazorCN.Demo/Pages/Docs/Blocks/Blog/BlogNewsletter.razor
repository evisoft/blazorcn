@* ===========================================================
   Block: blog-newsletter
   Title: Blog Newsletter
   Description: Simple newsletter signup with email input, subscribe button, and success state
   Long Description: Capture subscribers with a clean newsletter form. Includes validation, loading state, and confirmation.
   Dependencies: ButtonCn, InputCn
   Source: original/blocks/blog/blog-newsletter.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Newsletter</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Get new articles delivered to your inbox every week.
            </p>
        </div>

        <div class="px-6 py-6">
            @if (_isSuccess)
            {
                <div class="flex items-center gap-3 rounded-md bg-muted/50 p-4">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="16" Class="h-4 w-4 text-emerald-500" />
                    </div>
                    <div>
                        <span class="text-sm font-medium">You are subscribed</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Check your email to confirm your subscription.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div>
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <LucideIconCn Name="mail" Size="16" Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                            <InputCn Type="email"
                                     placeholder="@("you@example.com")"
                                     aria-label="Email address"
                                     @bind-Value="_email"
                                     Class="pl-9" />
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  OnClick="HandleSubscribe"
                                  Disabled="_isLoading">
                            @(_isLoading ? "Subscribing..." : "Subscribe")
                        </ButtonCn>
                    </div>
                    <p class="mt-3 text-xs text-muted-foreground">No spam. Unsubscribe anytime.</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private bool _isLoading;
    private bool _isSuccess;

    private async Task HandleSubscribe()
    {
        if (!_email.Contains("@")) return;
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(800);
        _isSuccess = true;
        _isLoading = false;
    }
}
