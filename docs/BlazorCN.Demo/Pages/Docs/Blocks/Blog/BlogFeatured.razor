@* ===========================================================
   Block: blog-featured
   Title: Blog Featured
   Description: Featured blog layout with one prominent post and smaller posts below in a single card container
   Long Description: Highlight a featured article alongside recent posts in a single editorial card.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-featured.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Featured</h2>
        </div>

        <div class="border-b p-4">
            <div class="flex flex-col gap-4 sm:flex-row">
                <img alt="@_featured.Title"
                     class="h-40 w-full shrink-0 rounded-md object-cover sm:w-48"
                     src="@_featured.Img" />
                <div class="flex min-w-0 flex-1 flex-col">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                            @_featured.Category
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@_featured.ReadTime</span>
                    </div>
                    <span class="mt-2 text-sm font-semibold">@_featured.Title</span>
                    <p class="mt-1 line-clamp-2 text-xs text-muted-foreground">@_featured.Excerpt</p>
                    <div class="mt-auto flex items-center justify-between pt-3">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@_featured.Author</span>
                            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                            <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                            <span>@_featured.Date</span>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                            Read More
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-6 py-3">
            <span class="text-xs font-medium text-muted-foreground">More Posts</span>
        </div>
        @for (var i = 0; i < _secondaryPosts.Count; i++)
        {
            var post = _secondaryPosts[i];
            <div class="@($"px-6 py-3 transition-colors hover:bg-muted/50{(i < _secondaryPosts.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                        @post.Category
                    </BadgeCn>
                    <span class="text-xs text-muted-foreground">@post.ReadTime</span>
                </div>
                <span class="mt-1 block text-sm font-medium">@post.Title</span>
                <p class="mt-0.5 text-xs text-muted-foreground">@post.Excerpt</p>
                <div class="mt-1.5 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@post.Author</span>
                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                    <span>@post.Date</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record BlogPost(string Title, string Excerpt, string Category, string Date, string ReadTime, string Author, string? Img = null);

    private readonly BlogPost _featured = new(
        "The Complete Guide to React Server Components",
        "Server Components change how we build React apps. This guide covers streaming, suspense boundaries, and data fetching patterns that reduce client bundle size by up to 40%.",
        "React", "Nov 14, 2024", "12 min", "Sarah Chen",
        "https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=800&auto=format&fit=crop");

    private readonly List<BlogPost> _secondaryPosts =
    [
        new("TypeScript 5.3: What's New and Why It Matters",
            "Deep dive into the latest TypeScript features and how they improve developer experience.",
            "TypeScript", "Nov 10, 2024", "8 min", "James Park"),
        new("Building a Design System with Tailwind CSS",
            "A practical guide to creating consistent, scalable design systems using utility-first CSS.",
            "CSS", "Nov 5, 2024", "15 min", "Mia Torres"),
        new("Performance Optimization Techniques for React Apps",
            "Proven strategies to reduce bundle size and improve runtime performance in production.",
            "Performance", "Oct 28, 2024", "10 min", "Otto Gonzalez"),
    ];
}
