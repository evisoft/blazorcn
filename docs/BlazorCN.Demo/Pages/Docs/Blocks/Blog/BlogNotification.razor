@* ===========================================================
   Block: blog-notification
   Title: Blog Notification
   Description: Compact notification widget for new blog post alerts with bell icon, post title, author, and action buttons
   Long Description: Alert readers when a new post drops. A lightweight notification card with the post title, author, and clear call-to-action buttons keeps engagement high without being intrusive.
   Dependencies: ButtonCn
   Source: original/blocks/blog/blog-notification.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_dismissed)
        {
            <div class="px-6 py-8 text-center">
                <p class="text-sm text-muted-foreground">No new notifications</p>
            </div>
        }
        else
        {
            <div class="border-b px-6 py-5">
                <div class="flex items-center gap-2">
                    <div class="relative">
                        <LucideBellCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span class="absolute -right-0.5 -top-0.5 size-2 rounded-full bg-blue-500"></span>
                    </div>
                    <h2 class="text-xl font-semibold tracking-tight">New Post Published</h2>
                </div>
            </div>

            <div class="px-6 py-4">
                <span class="text-sm font-medium">
                    Rethinking Error Boundaries in Production Applications
                </span>
                <p class="mt-1 text-xs text-muted-foreground">By Sarah Chen -- 6 min read</p>
            </div>

            <div class="flex items-center gap-2 border-t px-6 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Read now
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="h-8 text-xs text-muted-foreground"
                          @onclick="() => _dismissed = true">
                    Dismiss
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private bool _dismissed;
}
