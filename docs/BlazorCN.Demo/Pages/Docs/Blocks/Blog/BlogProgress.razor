@* ===========================================================
   Block: blog-progress
   Title: Blog Progress
   Description: Reading progress tracker showing partially-read articles with progress bars and continue buttons
   Long Description: Track how far readers have gotten through your articles. Progress bars and continue buttons make it easy to pick up where they left off.
   Dependencies: ButtonCn, ProgressCn
   Source: original/blocks/blog/blog-progress.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Continue Reading</h2>
            <p class="mt-1 text-sm text-muted-foreground">Pick up where you left off</p>
        </div>

        @for (var i = 0; i < _articles.Count; i++)
        {
            var article = _articles[i];
            <div class="@($"px-6 py-4 transition-colors hover:bg-muted/50{(i < _articles.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                        <h3 class="text-sm font-medium">@article.Title</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @article.Author &middot; @article.ReadTime
                        </p>
                    </div>
                    <ButtonCn Class="h-7 shrink-0 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost">
                        Continue
                        <LucideIconCn Name="arrow-right" Size="12" Class="h-3 w-3" />
                    </ButtonCn>
                </div>
                <div class="mt-3 flex items-center gap-3">
                    <ProgressCn Class="h-1.5 flex-1" Value="@article.Progress" />
                    <span class="shrink-0 font-mono text-xs text-muted-foreground tabular-nums">
                        @article.Progress%
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ReadingArticle(string Title, string Author, int Progress, string ReadTime);

    private readonly List<ReadingArticle> _articles =
    [
        new("A Practical Guide to Database Sharding", "James Liu", 72, "14 min"),
        new("Intro to WebAssembly for JS Developers", "Priya Sharma", 35, "18 min"),
        new("Error Handling Patterns in TypeScript", "Noah Kim", 90, "9 min"),
    ];
}
