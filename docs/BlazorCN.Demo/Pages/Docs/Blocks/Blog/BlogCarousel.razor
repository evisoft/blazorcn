@* ===========================================================
   Block: blog-carousel
   Title: Blog Carousel
   Description: Horizontally scrollable blog post cards with snap scrolling, category badges, and publication dates
   Long Description: Scroll through recent posts in a horizontal carousel with snap-to-card behavior. Each card shows the title, category, and date.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-carousel.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recent Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">Scroll to browse the latest articles</p>
        </div>
        <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto p-4" tabindex="0" role="group" aria-label="Recent posts carousel">
            @foreach (var post in _posts)
            {
                <div class="min-w-[280px] shrink-0 snap-start cursor-pointer rounded-md border p-4 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            @post.Category
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@post.ReadTime</span>
                    </div>
                    <span class="mt-2.5 block text-sm font-medium leading-snug">@post.Title</span>
                    <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">@post.Excerpt</p>
                    <span class="mt-3 block text-xs text-muted-foreground">@post.Date</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PostItem(string Title, string Excerpt, string Category, string Date, string ReadTime);

    private static readonly PostItem[] _posts =
    [
        new("Understanding React Server Actions",
            "A practical guide to form handling and mutations with server actions in Next.js.",
            "React", "Mar 8, 2025", "7 min"),
        new("CSS Container Queries Are Here",
            "How container queries change responsive design and when to use them over media queries.",
            "CSS", "Feb 22, 2025", "5 min"),
        new("Postgres Full-Text Search",
            "Build fast, relevant search without Elasticsearch using built-in Postgres features.",
            "Database", "Feb 10, 2025", "9 min"),
        new("Optimizing Core Web Vitals",
            "Practical steps to improve LCP, CLS, and INP scores on content-heavy pages.",
            "Performance", "Jan 30, 2025", "6 min"),
        new("Building Accessible Forms",
            "Label associations, error messaging, and keyboard navigation done right.",
            "Accessibility", "Jan 15, 2025", "8 min"),
    ];
}
