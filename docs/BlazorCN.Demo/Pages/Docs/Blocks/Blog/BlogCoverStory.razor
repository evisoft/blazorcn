@* ===========================================================
   Block: blog-cover-story
   Title: Blog Cover Story
   Description: Magazine-style cover story with featured thumbnail, excerpt, and compact secondary posts
   Long Description: Present your flagship article in a magazine-style layout with a large cover image, full excerpt, and secondary picks below. Perfect for editorial homepages.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-cover-story.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">This Week's Issue</h2>
        </div>

        <div class="border-b px-6 py-5">
            <img
                alt="@CoverTitle"
                class="h-48 w-full rounded-md object-cover"
                src="https://images.unsplash.com/photo-1504639725590-34d0984388bd?w=800&h=400&auto=format&fit=crop" />
            <div class="mt-4">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                    Cover Story
                </BadgeCn>
                <h3 class="mt-2 font-semibold text-xl tracking-tight">@CoverTitle</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">@CoverExcerpt</p>
                <div class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>Sarah Chen</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>Mar 10, 2026</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>18 min read</span>
                </div>
            </div>
        </div>

        <div class="px-6 py-3">
            <span class="text-xs font-medium text-muted-foreground">Also in this issue</span>
        </div>
        @for (var i = 0; i < _secondary.Length; i++)
        {
            var post = _secondary[i];
            <div class="@Cn.Merge("flex items-center gap-4 px-6 py-3 transition-colors hover:bg-muted/50", i < _secondary.Length - 1 ? "border-b" : "")">
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@post.Title</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @post.Author &middot; @post.Date
                    </p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private const string CoverTitle = "The Future of Web Development in 2026";
    private const string CoverExcerpt = "From edge-first architectures to AI-assisted coding workflows, the web platform is evolving faster than ever. We explore the trends reshaping how developers build, deploy, and maintain modern applications.";

    private record SecondaryPost(string Title, string Author, string Date);

    private static readonly SecondaryPost[] _secondary =
    [
        new("Edge Functions Are Replacing Traditional APIs", "Marcus Johnson", "Mar 8, 2026"),
        new("How AI Copilots Changed Our Team's Workflow", "Emily Watson", "Mar 6, 2026"),
    ];
}
