@* ===========================================================
   Block: blog-checklist
   Title: Blog Checklist
   Description: A tutorial post with interactive checklist steps and completion progress tracking
   Long Description: Turn long-form tutorials into actionable checklists. Readers can track their progress through each step, making it easy to pick up where they left off and see how far they have come.
   Dependencies: BadgeCn, CheckboxCn
   Source: original/blocks/blog/blog-checklist.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center justify-between">
                <h2 class="font-semibold text-xl tracking-tight">Build a Full-Stack App</h2>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs tabular-nums">
                    @_checked.Count/@_steps.Length completed
                </BadgeCn>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">
                Follow each step to go from zero to deployed
            </p>
        </div>

        @for (var i = 0; i < _steps.Length; i++)
        {
            var step = _steps[i];
            var isChecked = _checked.Contains(step.Id);
            <label class="@Cn.Merge("flex cursor-pointer items-start gap-3 px-6 py-3.5 transition-colors hover:bg-muted/50", i < _steps.Length - 1 ? "border-b" : "")">
                <CheckboxCn
                    Checked="@(_checked.Contains(step.Id))"
                    CheckedChanged="@(_ => Toggle(step.Id))"
                    Class="mt-0.5" />
                <div class="min-w-0 flex-1">
                    <span class="@Cn.Merge("text-sm font-medium", isChecked ? "text-muted-foreground line-through" : "")">
                        @step.Title
                    </span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@step.Description</p>
                </div>
            </label>
        }
    </div>
</section>

@code {
    private HashSet<string> _checked = new() { "step-1", "step-2", "step-3" };

    private void Toggle(string id)
    {
        if (!_checked.Add(id))
        {
            _checked.Remove(id);
        }
    }

    private record StepItem(string Id, string Title, string Description);

    private static readonly StepItem[] _steps =
    [
        new("step-1", "Set up the project repository",
            "Clone the starter template and install dependencies with your package manager."),
        new("step-2", "Configure environment variables",
            "Copy .env.example to .env.local and fill in your API keys and database URL."),
        new("step-3", "Define the database schema",
            "Create your Prisma schema with User and Post models, then run the migration."),
        new("step-4", "Build the API routes",
            "Add CRUD endpoints for posts with input validation and error handling."),
        new("step-5", "Deploy to production",
            "Push to GitHub and connect to Vercel for automatic preview and production deploys."),
    ];
}
