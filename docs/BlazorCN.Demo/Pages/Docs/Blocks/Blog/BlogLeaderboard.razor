@* ===========================================================
   Block: blog-leaderboard
   Title: Blog Leaderboard
   Description: Top authors leaderboard ranked by post count with views, initials avatar, and subtle top-3 distinction
   Long Description: Celebrate your top contributors with a ranked author leaderboard. Each author shows post count and total views, with the top three receiving a subtle visual distinction.
   Dependencies: None
   Source: original/blocks/blog/blog-leaderboard.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Author Leaderboard</h2>
            <p class="mt-1 text-sm text-muted-foreground">Top contributors by post count</p>
        </div>

        @for (var i = 0; i < _authors.Count; i++)
        {
            var author = _authors[i];
            <div class="@($"flex items-center gap-4 px-6 py-3.5 transition-colors hover:bg-muted/50{(i < _authors.Count - 1 ? " border-b" : "")}")">
                <span class="@($"w-8 shrink-0 text-2xl font-semibold tabular-nums {(author.Rank <= 3 ? "text-foreground" : "text-muted-foreground")}")">
                    @author.Rank
                </span>
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @author.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@author.Name</span>
                </div>
                <div class="flex shrink-0 items-center gap-4 text-xs text-muted-foreground">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="file-text" Size="14" Class="h-3.5 w-3.5" />
                        <span class="tabular-nums">@author.Posts</span>
                    </span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="eye" Size="14" Class="h-3.5 w-3.5" />
                        <span class="tabular-nums">@author.Views</span>
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record LeaderboardAuthor(int Rank, string Name, string Initials, int Posts, string Views);

    private readonly List<LeaderboardAuthor> _authors =
    [
        new(1, "Sarah Chen", "SC", 47, "124.3K"),
        new(2, "Marcus Johnson", "MJ", 32, "89.7K"),
        new(3, "Emily Watson", "EW", 28, "71.2K"),
        new(4, "David Park", "DP", 19, "43.5K"),
        new(5, "Priya Sharma", "PS", 14, "28.1K"),
    ];
}
