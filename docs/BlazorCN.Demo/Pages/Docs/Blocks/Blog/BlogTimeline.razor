@* ===========================================================
   Block: blog-timeline
   Title: Blog Timeline
   Description: Chronological archive of posts grouped by year with simple vertical layout
   Long Description: Browse your content history organized by year. Posts are grouped chronologically with clear year markers and compact article rows.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-timeline.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Archive</h2>
            <p class="mt-1 text-sm text-muted-foreground">All posts organized by year</p>
        </div>
        <div>
            @for (var gi = 0; gi < _timeline.Count; gi++)
            {
                var group = _timeline[gi];
                <div>
                    <div class="border-b bg-muted/50 px-6 py-2.5">
                        <span class="text-xs font-medium text-muted-foreground">@group.Year</span>
                    </div>
                    @for (var pi = 0; pi < group.Posts.Count; pi++)
                    {
                        var post = group.Posts[pi];
                        <div class="@($"flex cursor-pointer items-center justify-between gap-4 px-6 py-3.5 transition-colors hover:bg-muted/50{(pi < group.Posts.Count - 1 || gi < _timeline.Count - 1 ? " border-b" : "")}")">
                            <div class="flex min-w-0 items-center gap-2">
                                <span class="text-sm font-medium">@post.Title</span>
                                <BadgeCn Class="shrink-0 text-xs" Variant="BadgeVariant.Secondary">
                                    @post.Category
                                </BadgeCn>
                            </div>
                            <div class="flex shrink-0 items-center gap-3">
                                <span class="text-xs text-muted-foreground">@post.Date</span>
                                <span class="text-xs text-muted-foreground">@post.ReadTime</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TimelinePost(string Title, string Category, string Date, string ReadTime);
    private record YearGroup(string Year, List<TimelinePost> Posts);

    private readonly List<YearGroup> _timeline =
    [
        new("2024",
        [
            new("Building Scalable React Applications", "React", "Nov 15", "12 min"),
            new("TypeScript 5.3 New Features", "TypeScript", "Oct 28", "8 min"),
        ]),
        new("2023",
        [
            new("Year in Review: Web Development 2023", "Industry", "Dec 28", "14 min"),
            new("Introduction to React Server Components", "React", "Nov 22", "16 min"),
        ]),
    ];
}
