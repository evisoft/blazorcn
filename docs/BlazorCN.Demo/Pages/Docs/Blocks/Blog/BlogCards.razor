@* ===========================================================
   Block: blog-cards
   Title: Blog Cards
   Description: Simple blog post cards without images, showing title, excerpt, category badge, and date in a vertical list
   Long Description: Clean blog post list with titles, excerpts, and metadata in a compact card layout.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-cards.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Blog</h2>
        </div>

        @for (var i = 0; i < _posts.Length; i++)
        {
            var post = _posts[i];
            <div class="@Cn.Merge("px-6 py-4 transition-colors hover:bg-muted/50", i < _posts.Length - 1 ? "border-b" : "")">
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                        @post.Category
                    </BadgeCn>
                    <span class="text-xs text-muted-foreground">@post.ReadTime</span>
                </div>
                <span class="mt-1.5 block text-sm font-medium">@post.Title</span>
                <p class="mt-1 text-xs text-muted-foreground">@post.Excerpt</p>
                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@post.Author</span>
                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                    <span>@post.Date</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record PostItem(string Title, string Excerpt, string Category, string Date, string ReadTime, string Author);

    private static readonly PostItem[] _posts =
    [
        new("Shared Coworking Spaces Are Redefining Office Culture",
            "How flexible workspaces are shifting the way teams collaborate, from hot desks to private pods in urban centers.",
            "Workplace", "May 26, 2024", "5 min", "Otto Gonzalez"),
        new("The Rise of Async-First Engineering Teams",
            "Distributed companies are rethinking meetings, standups, and documentation to support global, asynchronous collaboration.",
            "Engineering", "May 3, 2024", "7 min", "Chriss Smahos"),
        new("Designing for Accessibility from Day One",
            "Why baking a11y into your component library early saves time, reduces rework, and improves the experience for everyone.",
            "Design", "Apr 12, 2024", "6 min", "Elijah Miller"),
    ];
}
