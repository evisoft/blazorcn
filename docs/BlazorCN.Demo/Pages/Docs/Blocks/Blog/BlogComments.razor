@* ===========================================================
   Block: blog-comments
   Title: Blog Comments
   Description: Comment thread section with author avatars, timestamps, nested replies, and a reply input for blog post discussions
   Long Description: Add threaded discussions to your blog posts. Comments display with author initials, timestamps, and support nested replies.
   Dependencies: ButtonCn, InputCn
   Source: original/blocks/blog/blog-comments.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Comments</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_comments.Length comments on this post
            </p>
        </div>
        <div class="divide-y px-6">
            @foreach (var comment in _comments)
            {
                <div>
                    <div class="flex items-start gap-3 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                            @comment.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Time</span>
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground leading-relaxed">@comment.Text</p>
                        </div>
                    </div>
                    @if (comment.Reply is not null)
                    {
                        <div class="ml-8 border-l pl-4">
                            <div class="flex items-start gap-3 py-3">
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                                    @comment.Reply.Initials
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@comment.Reply.Author</span>
                                        <span class="text-xs text-muted-foreground">@comment.Reply.Time</span>
                                    </div>
                                    <p class="mt-1 text-sm text-muted-foreground leading-relaxed">@comment.Reply.Text</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="border-t px-6 py-4">
            <div class="flex items-center gap-2">
                <InputCn
                    Value="@_reply"
                    placeholder="Write a comment..."
                    Class="h-9 text-sm" />
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-9 shrink-0 text-xs">
                    Reply
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _reply = "";

    private record ReplyItem(string Id, string Author, string Initials, string Time, string Text);
    private record CommentItem(string Id, string Author, string Initials, string Time, string Text, ReplyItem? Reply);

    private static readonly CommentItem[] _comments =
    [
        new("1", "Elena Vasquez", "EV", "2 hours ago",
            "Great breakdown of server components. The mental model shift from client-first to server-first is the hardest part for teams adopting this pattern.",
            new("1r", "David Kim", "DK", "1 hour ago",
                "Agreed. We found that starting with server components by default and only adding 'use client' when needed made the transition much smoother.")),
        new("2", "Raj Patel", "RP", "5 hours ago",
            "Would love a follow-up on how this integrates with existing state management libraries. We use Zustand heavily and the boundary between server and client state is still unclear.",
            null),
        new("3", "Mia Thompson", "MT", "Yesterday",
            "The performance comparison at the end was really helpful. Seeing the before and after bundle sizes made the case for our team to prioritize the migration.",
            null),
    ];
}
