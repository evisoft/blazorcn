@* ===========================================================
   Block: blog-comparison
   Title: Blog Comparison
   Description: Side-by-side article comparison layout for contrasting two related blog posts
   Long Description: Compare two articles side by side to help readers choose what to read first. Perfect for "vs" comparisons, contrasting viewpoints, or before-and-after technical guides.
   Dependencies: BadgeCn, LucideCalendarCn, LucideClockCn, LucideTagCn, LucideUserCn
   Source: original/blocks/blog/blog-comparison.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Compare Articles</h2>
            <p class="mt-1 text-sm text-muted-foreground">Side-by-side view of related posts</p>
        </div>

        <div class="grid grid-cols-1 divide-y sm:grid-cols-2 sm:divide-x sm:divide-y-0">
            @foreach (var article in _articles)
            {
                <div class="px-6 py-5">
                    <div class="flex flex-col gap-3">
                        <h3 class="text-sm font-medium leading-snug">@article.Title</h3>
                        <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">
                            @article.Excerpt
                        </p>
                        <div class="flex flex-col gap-1.5 text-xs text-muted-foreground">
                            <span class="flex items-center gap-1.5">
                                <LucideUserCn Size="12" Class="h-3 w-3" />
                                @article.Author
                            </span>
                            <span class="flex items-center gap-1.5">
                                <LucideCalendarCn Size="12" Class="h-3 w-3" />
                                @article.Date
                            </span>
                            <span class="flex items-center gap-1.5">
                                <LucideClockCn Size="12" Class="h-3 w-3" />
                                @article.ReadTime
                            </span>
                        </div>
                        <div class="flex items-center gap-1.5 pt-1">
                            <LucideTagCn Size="12" Class="h-3 w-3 text-muted-foreground" />
                            <div class="flex flex-wrap gap-1">
                                @foreach (var topic in article.Topics)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                        @topic
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ArticleItem(string Title, string Author, string Date, string ReadTime, string Excerpt, string[] Topics);

    private static readonly ArticleItem[] _articles =
    [
        new("Why React Server Components Change Everything",
            "Sarah Chen", "Mar 8, 2026", "14 min",
            "Server Components eliminate the client-server waterfall by moving rendering to the server. This article explores the architectural shift and its impact on bundle size, data fetching, and developer experience.",
            ["React", "RSC", "Performance"]),
        new("The Case for Client-Side Rendering in 2026",
            "Marcus Johnson", "Mar 10, 2026", "11 min",
            "Client-side rendering still has a place in modern web development. This article argues for SPAs in dashboard-heavy applications where interactivity matters more than initial load time.",
            ["React", "SPA", "Interactivity"]),
    ];
}
