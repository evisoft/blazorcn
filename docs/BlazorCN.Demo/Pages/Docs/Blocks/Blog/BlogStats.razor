@* ===========================================================
   Block: blog-stats
   Title: Blog Stats
   Description: Blog stats dashboard with key metrics grid and top performing posts by view count
   Long Description: Track your blog performance at a glance. Key metrics up top, top-performing posts below, all in a single compact card.
   Dependencies: None
   Source: original/blocks/blog/blog-stats.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Blog Analytics</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Performance overview for the last 30 days
            </p>
        </div>

        <div class="grid grid-cols-2 border-b">
            @for (var i = 0; i < _metrics.Count; i++)
            {
                var metric = _metrics[i];
                <div class="@($"px-6 py-4{(i % 2 == 0 ? " border-r" : "")}{(i < 2 ? " border-b" : "")}")">
                    <span class="text-xs text-muted-foreground">@metric.Label</span>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">@metric.Value</p>
                </div>
            }
        </div>

        <div class="px-6 py-4">
            <span class="text-xs font-medium text-muted-foreground">Top Performing</span>
        </div>

        @for (var i = 0; i < _topPosts.Count; i++)
        {
            var post = _topPosts[i];
            <div class="@($"flex items-center gap-4 px-6 py-3 transition-colors hover:bg-muted/50{(i < _topPosts.Count - 1 ? " border-b" : "")}")">
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@post.Title</span>
                </div>
                <div class="flex shrink-0 items-center gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="eye" Size="14" Class="h-3.5 w-3.5" />
                    <span class="tabular-nums">@post.Views</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Metric(string Label, string Value);
    private record TopPost(string Title, string Views);

    private readonly List<Metric> _metrics =
    [
        new("Total Posts", "148"),
        new("Total Views", "52.4K"),
        new("Avg Read Time", "4.2m"),
        new("Subscribers", "3,870"),
    ];

    private readonly List<TopPost> _topPosts =
    [
        new("Understanding React Server Components", "8,241"),
        new("A Practical Guide to Database Indexing", "6,509"),
        new("Designing Accessible Color Systems", "5,122"),
    ];
}
