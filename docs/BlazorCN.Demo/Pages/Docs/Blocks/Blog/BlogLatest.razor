@* ===========================================================
   Block: blog-latest
   Title: Blog Latest
   Description: Just-published notification-style blog layout with a prominent new post featuring a pulse dot, and compact earlier posts below
   Long Description: Highlight your most recent post with a pulse indicator and prominent styling, followed by compact rows for earlier publications.
   Dependencies: None
   Source: original/blocks/blog/blog-latest.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Latest</h2>
            <p class="mt-1 text-sm text-muted-foreground">Recently published posts</p>
        </div>

        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-2">
                <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                </span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">New</span>
            </div>
            <h3 class="mt-2 text-sm font-medium">@_latest.Title</h3>
            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">@_latest.Excerpt</p>
            <div class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
                <span>@_latest.Author</span>
                <span aria-hidden="true">&middot;</span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                    @_latest.Time
                </span>
            </div>
        </div>

        <div class="bg-muted/30 px-6 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Published earlier</span>
        </div>

        @for (var i = 0; i < _earlier.Count; i++)
        {
            var post = _earlier[i];
            <div class="@($"flex items-center gap-4 px-6 py-3 transition-colors hover:bg-muted/50{(i < _earlier.Count - 1 ? " border-b" : "")}")">
                <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-medium">@post.Title</h3>
                    <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                        <span>@post.Author</span>
                        <span aria-hidden="true">&middot;</span>
                        <span>@post.Time</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record LatestPost(string Title, string Excerpt, string Author, string Time);

    private readonly LatestPost _latest = new(
        "Zero-Downtime Deployments with Database Migrations",
        "A step-by-step approach to running schema migrations alongside rolling deployments without locking tables or dropping connections.",
        "Jordan Lee", "Just published");

    private readonly List<LatestPost> _earlier =
    [
        new("Streaming SSR: Patterns and Pitfalls", "", "Nadia Petrova", "Yesterday"),
        new("Designing Type-Safe API Clients with Zod", "", "Marcus Chen", "2 days ago"),
    ];
}
