@* ===========================================================
   Block: blog-podcast
   Title: Blog Podcast
   Description: Podcast episode list with play buttons, episode numbers, duration badges, and publish dates
   Long Description: A podcast section for your blog with episode listings.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-podcast.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">The Dev Log</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">
                Weekly conversations on software engineering
            </p>
        </div>

        @for (var i = 0; i < _episodes.Count; i++)
        {
            var ep = _episodes[i];
            <div class="@($"flex items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _episodes.Count - 1 ? " border-b" : "")}")">
                <ButtonCn Class="h-8 w-8 shrink-0" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideIconCn Name="play" Size="16" Class="h-4 w-4 text-muted-foreground" />
                </ButtonCn>
                <span class="shrink-0 font-mono text-xs text-muted-foreground">#@ep.Number</span>
                <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-medium">@ep.Title</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">@ep.Date</p>
                </div>
                <BadgeCn Class="shrink-0" Variant="BadgeVariant.Secondary">
                    @ep.Duration
                </BadgeCn>
            </div>
        }
    </div>
</section>

@code {
    private record Episode(int Number, string Title, string Duration, string Date);

    private readonly List<Episode> _episodes =
    [
        new(42, "The Future of Edge Computing", "34 min", "Mar 10, 2026"),
        new(41, "Designing APIs That Developers Love", "28 min", "Mar 3, 2026"),
        new(40, "From Monolith to Microservices", "41 min", "Feb 24, 2026"),
    ];
}
