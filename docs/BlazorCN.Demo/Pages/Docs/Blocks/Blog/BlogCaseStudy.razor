@* ===========================================================
   Block: blog-case-study
   Title: Blog Case Study
   Description: A structured case study format with challenge, solution, and results metrics
   Long Description: Present customer success stories in a compelling, structured format. The case study layout guides readers through the challenge, solution, and measurable results with prominent metric numbers.
   Dependencies: BadgeCn, LucideBuildingCn, LucideCheckCircleCn, LucideTargetCn
   Source: original/blocks/blog/blog-case-study.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <h2 class="font-semibold text-xl tracking-tight">Case Study</h2>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                    SaaS
                </BadgeCn>
            </div>
            <div class="mt-1.5 flex items-center gap-1.5 text-sm text-muted-foreground">
                <LucideBuildingCn Size="14" Class="h-3.5 w-3.5" />
                Acme Analytics
            </div>
        </div>

        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                <LucideTargetCn Size="12" Class="h-3 w-3" />
                Challenge
            </div>
            <p class="mt-1.5 text-sm leading-relaxed">
                Acme Analytics struggled with a 68% drop-off rate during onboarding. New users found the dashboard overwhelming and failed to complete their first report within the trial period.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                <LucideCircleCheckCn Size="12" Class="h-3 w-3" />
                Solution
            </div>
            <p class="mt-1.5 text-sm leading-relaxed">
                We redesigned the onboarding flow with progressive disclosure, guided tours, and a simplified first-run experience. Key actions were surfaced contextually instead of shown all at once.
            </p>
        </div>

        <div class="px-6 py-4">
            <span class="text-xs font-medium text-muted-foreground">Results</span>
        </div>
        <div class="grid grid-cols-3 border-t">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@Cn.Merge("px-6 py-4", i < 2 ? "border-r" : "")">
                    <p class="text-2xl font-semibold tabular-nums">@metric.Value</p>
                    <span class="text-xs text-muted-foreground">@metric.Description</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Value, string Description);

    private static readonly MetricItem[] _metrics =
    [
        new("Drop-off Reduction", "42%", "Lower onboarding abandonment"),
        new("Trial Conversion", "3.1x", "Improvement in paid signups"),
        new("Time to First Report", "4 min", "Down from 22 minutes"),
    ];
}
