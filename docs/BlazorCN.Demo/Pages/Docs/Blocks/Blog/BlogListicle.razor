@* ===========================================================
   Block: blog-listicle
   Title: Blog Listicle
   Description: Numbered listicle article layout with circled step numbers, tip titles, and concise descriptions
   Long Description: Present actionable advice in a scannable numbered format. Each tip gets a circled number, a clear title, and a one-line description.
   Dependencies: None
   Source: original/blocks/blog/blog-listicle.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">
                10 Tips for Better React Performance
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Practical optimizations you can apply today
            </p>
        </div>

        @for (var i = 0; i < _tips.Count; i++)
        {
            var tip = _tips[i];
            <div class="@($"flex items-start gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _tips.Count - 1 ? " border-b" : "")}")">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium tabular-nums">
                    @tip.Number
                </div>
                <div class="min-w-0 flex-1 pt-0.5">
                    <span class="text-sm font-medium">@tip.Title</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@tip.Description</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Tip(int Number, string Title, string Description);

    private readonly List<Tip> _tips =
    [
        new(1, "Memoize expensive computations",
            "Wrap CPU-heavy calculations in useMemo to avoid recalculating on every render cycle."),
        new(2, "Virtualize long lists",
            "Render only visible rows with a virtualizer instead of mounting thousands of DOM nodes at once."),
        new(3, "Code-split at the route level",
            "Use dynamic imports to load page-specific bundles on demand and shrink initial JavaScript payload."),
        new(4, "Debounce rapid user input",
            "Delay state updates from search fields and sliders to prevent excessive re-renders during typing."),
        new(5, "Move state down the tree",
            "Keep state as close to where it is used as possible so parent components skip unnecessary re-renders."),
    ];
}
