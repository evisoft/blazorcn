@* ===========================================================
   Block: blog-gallery
   Title: Blog Gallery
   Description: Visual blog gallery with image thumbnails in a 2x2 grid layout and title overlays
   Long Description: Browse posts visually with a photo-forward grid layout. Each thumbnail shows the post title and category as an overlay.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-gallery.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Gallery</h2>
            <p class="mt-1 text-sm text-muted-foreground">Visual stories and photo essays</p>
        </div>

        <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2">
            @foreach (var post in _posts)
            {
                <div class="group relative cursor-pointer overflow-hidden rounded-md">
                    <div class="@($"aspect-square {post.Color} flex items-center justify-center")">
                        <LucideIconCn Name="image" Size="32" Class="h-8 w-8 text-muted-foreground/40" />
                    </div>
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-3">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-1.5 text-xs">
                            @post.Category
                        </BadgeCn>
                        <p class="text-sm font-medium text-white">@post.Title</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GalleryPost(string Title, string Category, string Color);

    private readonly List<GalleryPost> _posts =
    [
        new("Designing for Dark Mode", "Design", "bg-zinc-300 dark:bg-zinc-700"),
        new("Street Photography Tips", "Photography", "bg-stone-300 dark:bg-stone-700"),
        new("Minimal UI Patterns", "UI/UX", "bg-neutral-300 dark:bg-neutral-700"),
        new("Color Theory in Practice", "Design", "bg-slate-300 dark:bg-slate-700"),
    ];
}
