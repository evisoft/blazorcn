@* ===========================================================
   Block: blog-video
   Title: Blog Video
   Description: Video blog post listing with placeholder thumbnails, duration badges, titles, and publish dates
   Long Description: List video content alongside written posts. Each entry shows a placeholder thumbnail with a play icon, the video title, duration, and publish date so readers can estimate time commitment before clicking.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-video.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Video Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">Watch tutorials and deep-dives</p>
        </div>

        @for (var i = 0; i < _videos.Count; i++)
        {
            var video = _videos[i];
            <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _videos.Count - 1 ? " border-b" : "")}")">
                <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="play" Size="32" Class="h-8 w-8 text-muted-foreground" />
                </div>
                <div class="mt-3 flex items-center justify-between gap-3">
                    <span class="text-sm font-medium">@video.Title</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                        @video.Duration
                    </BadgeCn>
                </div>
                <div class="mt-1.5 flex items-center gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                    <span>@video.Date</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Video(string Title, string Duration, string Date);

    private readonly List<Video> _videos =
    [
        new("Building Accessible Forms from Scratch", "12:34", "Mar 8, 2025"),
        new("Server Components: A Mental Model", "8:17", "Feb 24, 2025"),
        new("Designing Tokens for Dark Mode", "15:02", "Feb 10, 2025"),
    ];
}
