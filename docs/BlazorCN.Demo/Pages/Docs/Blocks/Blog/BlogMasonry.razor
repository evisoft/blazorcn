@* ===========================================================
   Block: blog-masonry
   Title: Blog Masonry
   Description: CSS columns masonry grid with varied-height post cards for dynamic visual flow
   Long Description: A Pinterest-style masonry layout using CSS columns. Posts with different content lengths create a natural, visually interesting grid.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-masonry.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Latest Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse recent articles</p>
        </div>

        <div class="columns-1 gap-4 p-4 sm:columns-2">
            @foreach (var post in _posts)
            {
                <div class="mb-4 break-inside-avoid rounded-md border p-4 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                            @post.Category
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@post.ReadTime</span>
                    </div>
                    <h3 class="mt-2 text-sm font-medium">@post.Title</h3>
                    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@post.Excerpt</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MasonryPost(string Title, string Excerpt, string Category, string ReadTime);

    private readonly List<MasonryPost> _posts =
    [
        new("Understanding Database Sharding",
            "How to horizontally partition your database for scale. We cover hash-based and range-based strategies with real-world trade-offs.",
            "Backend", "14 min"),
        new("CSS Container Queries",
            "Component-level responsive design is finally here.",
            "CSS", "6 min"),
        new("Error Handling in Rust",
            "Rust's Result and Option types enforce error handling at compile time. Learn idiomatic patterns for propagating errors, custom error types, and the anyhow crate for application code.",
            "Rust", "18 min"),
        new("Git Worktrees Explained",
            "Work on multiple branches simultaneously without stashing.",
            "Tools", "5 min"),
        new("WebSocket vs SSE",
            "Comparing real-time communication protocols. WebSocket gives full-duplex but SSE is simpler for server-to-client streaming. Choose based on your use case.",
            "Networking", "10 min"),
    ];
}
