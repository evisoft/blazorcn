@* ===========================================================
   Block: blog-drafts
   Title: Blog Drafts
   Description: Draft posts panel with status indicators, word counts, edit timestamps, and action buttons
   Long Description: Manage your unpublished posts with a clean drafts panel. Track editing status, word count, and last-edited timestamps at a glance.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-drafts.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Drafts</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_drafts.Count unpublished posts</p>
        </div>

        @for (var i = 0; i < _drafts.Count; i++)
        {
            var draft = _drafts[i];
            <div class="@($"flex items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _drafts.Count - 1 ? " border-b" : "")}")">
                <span class="@($"size-2 shrink-0 rounded-full {GetStatusDot(draft.Status)}")"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium truncate">@draft.Title</span>
                        <BadgeCn Class="shrink-0 text-xs" Variant="BadgeVariant.Outline">
                            @draft.Status
                        </BadgeCn>
                    </div>
                    <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                        <span>@draft.LastEdited</span>
                        <span aria-hidden="true">&middot;</span>
                        <span>@draft.WordCount.ToString("N0") words</span>
                    </div>
                </div>
                <div class="flex shrink-0 gap-1">
                    <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideIconCn Name="pencil" Size="14" Class="h-3.5 w-3.5" />
                        Edit
                    </ButtonCn>
                    <ButtonCn Class="h-7 gap-1 px-2 text-xs text-muted-foreground" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideIconCn Name="trash-2" Size="14" Class="h-3.5 w-3.5" />
                        Delete
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Draft(string Title, string LastEdited, int WordCount, string Status);

    private readonly List<Draft> _drafts =
    [
        new("Getting Started with Bun 2.0", "2 hours ago", 1842, "Review"),
        new("Migrating from Webpack to Turbopack", "Yesterday", 3105, "Draft"),
        new("Building Accessible Data Tables", "3 days ago", 2460, "Ready"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "Draft" => "bg-muted-foreground/60",
        "Review" => "bg-amber-500",
        "Ready" => "bg-emerald-500",
        _ => "bg-muted-foreground/60",
    };
}
