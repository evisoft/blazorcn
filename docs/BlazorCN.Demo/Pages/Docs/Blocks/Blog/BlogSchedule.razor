@* ===========================================================
   Block: blog-schedule
   Title: Blog Schedule
   Description: Publishing calendar showing upcoming scheduled, draft, and in-review posts with dates and times
   Long Description: Plan your editorial calendar with a clear view of upcoming posts. Status indicators show which articles are scheduled, in review, or still in draft.
   Dependencies: None
   Source: original/blocks/blog/blog-schedule.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">Publishing Schedule</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">
                @_posts.Count(p => p.Status == "Scheduled") posts scheduled
            </p>
        </div>

        @for (var i = 0; i < _posts.Count; i++)
        {
            var post = _posts[i];
            <div class="@($"flex items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                <div class="w-24 shrink-0">
                    <span class="text-sm font-medium">@post.Date</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@post.Time</p>
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-medium">@post.Title</h3>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                    <span class="@($"size-1.5 rounded-full {GetStatusDot(post.Status)}")"></span>
                    <span class="text-xs text-muted-foreground">@post.Status</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ScheduledPost(string Title, string Date, string Time, string Status);

    private readonly List<ScheduledPost> _posts =
    [
        new("Getting Started with Bun 2.0", "Mar 18, 2026", "9:00 AM", "Scheduled"),
        new("Optimizing React Re-renders", "Mar 21, 2026", "10:00 AM", "Scheduled"),
        new("GraphQL vs tRPC: A Comparison", "Mar 25, 2026", "9:00 AM", "In Review"),
        new("Building CLI Tools with Node.js", "Mar 28, 2026", "10:00 AM", "Draft"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "Scheduled" => "bg-emerald-500",
        "In Review" => "bg-amber-500",
        _ => "bg-muted-foreground/40",
    };
}
