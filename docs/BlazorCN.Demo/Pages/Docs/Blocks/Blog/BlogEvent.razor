@* ===========================================================
   Block: blog-event
   Title: Blog Event
   Description: Event and meetup announcement section with dates, locations, and registration buttons for blog-hosted community events
   Long Description: Promote upcoming events directly within your blog. Each event card shows the date, location, and a clear call-to-action for registration.
   Dependencies: ButtonCn, LucideCalendarCn, LucideMapPinCn
   Source: original/blocks/blog/blog-event.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Upcoming Events</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Workshops, meetups, and community sessions
            </p>
        </div>
        <div>
            @for (var i = 0; i < _events.Length; i++)
            {
                var evt = _events[i];
                <div class="@(Cn.Merge("flex items-center gap-4 px-6 py-4", i < _events.Length - 1 ? "border-b" : ""))">
                    <div class="min-w-0 flex-1 space-y-1.5">
                        <span class="text-sm font-medium">@evt.Name</span>
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <LucideCalendarCn Size="14" Class="size-3.5" />
                                @evt.Date &middot; @evt.Time
                            </span>
                            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <LucideMapPinCn Size="14" Class="size-3.5" />
                                @evt.Location
                            </span>
                        </div>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">
                        Register
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EventItem(string Id, string Name, string Date, string Time, string Location);

    private static readonly EventItem[] _events =
    [
        new("1", "React Server Components Workshop", "Apr 12, 2026", "10:00 AM PST", "Online via Zoom"),
        new("2", "Design Systems Meetup", "Apr 25, 2026", "6:30 PM EST", "Brooklyn, NY"),
        new("3", "TypeScript Deep Dive", "May 8, 2026", "2:00 PM GMT", "London, UK"),
    ];
}
