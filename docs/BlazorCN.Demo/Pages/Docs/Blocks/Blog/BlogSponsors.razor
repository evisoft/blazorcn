@* ===========================================================
   Block: blog-sponsors
   Title: Blog Sponsors
   Description: Sponsored content listing with clear sponsor labeling, company branding, and promoted article previews
   Long Description: Monetize your blog with clearly labeled sponsored content. Each listing shows the sponsor brand, promoted article, and transparent sponsorship badges to maintain reader trust.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-sponsors.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Sponsored</h2>
            <p class="mt-1 text-sm text-muted-foreground">From our partners</p>
        </div>

        @for (var i = 0; i < _sponsors.Count; i++)
        {
            var sponsor = _sponsors[i];
            <div class="@($"flex gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _sponsors.Count - 1 ? " border-b" : "")}")">
                <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                    @sponsor.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <span>Sponsored by @sponsor.Company</span>
                    </div>
                    <div class="mt-1 flex items-center gap-2">
                        <span class="truncate text-sm font-medium">@sponsor.Title</span>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">
                            Sponsored
                        </BadgeCn>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">@sponsor.Description</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Sponsor(string Company, string Initials, string Title, string Description);

    private readonly List<Sponsor> _sponsors =
    [
        new("Vercel", "V", "How We Scaled to 10M Deployments Per Month",
            "A deep dive into the infrastructure decisions that power serverless deployments at scale."),
        new("PlanetScale", "PS", "Branching Your Database Like Code",
            "Database branching workflows that let teams iterate without breaking production."),
    ];
}
