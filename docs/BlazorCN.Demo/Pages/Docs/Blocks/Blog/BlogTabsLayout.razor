@* ===========================================================
   Block: blog-tabs-layout
   Title: Blog Tabs Layout
   Description: Tabbed blog content switcher with Latest, Popular, and Editor's Picks views
   Long Description: Switch between curated blog views with tabs. Latest, Popular, and Editor's Picks feeds keep readers engaged with different content discovery paths.
   Dependencies: TabsCn
   Source: original/blocks/blog/blog-tabs-layout.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Browse Articles</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Discover content across curated feeds
            </p>
        </div>
        <TabsCn DefaultValue="latest">
            <div class="border-b px-6 pt-2">
                <TabsListCn>
                    <TabsTriggerCn Value="latest" Class="gap-1 text-xs">
                        <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" /> Latest
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="popular" Class="gap-1 text-xs">
                        <LucideIconCn Name="star" Size="12" Class="h-3 w-3" /> Popular
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="picks" Class="gap-1 text-xs">
                        <LucideIconCn Name="user" Size="12" Class="h-3 w-3" /> Editor&rsquo;s Picks
                    </TabsTriggerCn>
                </TabsListCn>
            </div>
            <TabsContentCn Value="latest" Class="mt-0">
                <div>
                    @for (var i = 0; i < _latest.Count; i++)
                    {
                        var post = _latest[i];
                        <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _latest.Count - 1 ? " border-b" : "")}")">
                            <h3 class="text-sm font-medium">@post.Title</h3>
                            <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@post.Author</span>
                                <span aria-hidden="true">&middot;</span>
                                <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                                <span>@post.Time</span>
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>
            <TabsContentCn Value="popular" Class="mt-0">
                <div>
                    @for (var i = 0; i < _popular.Count; i++)
                    {
                        var post = _popular[i];
                        <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _popular.Count - 1 ? " border-b" : "")}")">
                            <h3 class="text-sm font-medium">@post.Title</h3>
                            <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@post.Author</span>
                                <span aria-hidden="true">&middot;</span>
                                <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                                <span>@post.Time</span>
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>
            <TabsContentCn Value="picks" Class="mt-0">
                <div>
                    @for (var i = 0; i < _picks.Count; i++)
                    {
                        var post = _picks[i];
                        <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _picks.Count - 1 ? " border-b" : "")}")">
                            <h3 class="text-sm font-medium">@post.Title</h3>
                            <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@post.Author</span>
                                <span aria-hidden="true">&middot;</span>
                                <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                                <span>@post.Time</span>
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record Post(string Title, string Author, string Time);

    private readonly List<Post> _latest =
    [
        new("What's New in Next.js 16", "Lena Park", "8 min"),
        new("Designing Accessible Color Systems", "James Liu", "6 min"),
        new("Edge Functions vs Serverless", "Maria Santos", "10 min"),
    ];

    private readonly List<Post> _popular =
    [
        new("React Server Components Explained", "Sarah Chen", "12 min"),
        new("TypeScript 5.5 Migration Guide", "Alex Morgan", "15 min"),
        new("CSS Container Queries in Production", "Emily Watson", "9 min"),
    ];

    private readonly List<Post> _picks =
    [
        new("The Art of Code Review", "David Kim", "7 min"),
        new("Building a Design System from Scratch", "Nina Patel", "14 min"),
        new("Performance Budgets That Work", "Tom Rivera", "11 min"),
    ];
}
