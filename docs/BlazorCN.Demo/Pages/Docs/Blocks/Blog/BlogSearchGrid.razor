@* ===========================================================
   Block: blog-search-grid
   Title: Blog Search Grid
   Description: Search input with filtered grid of blog post cards
   Long Description: Search and browse blog posts in a responsive grid. Filters posts by title in real time.
   Dependencies: BadgeCn, InputCn
   Source: original/blocks/blog/blog-search-grid.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Search Articles</h2>
        </div>

        <div class="border-b px-6 py-3">
            <div class="relative">
                <LucideIconCn Name="search" Size="16" Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="border-0 bg-transparent pl-9 shadow-none focus-visible:ring-0"
                         placeholder="Search by title..."
                         @bind-Value="_query"
                         @bind-Value:event="oninput" />
            </div>
        </div>

        @{
            var filtered = _posts.Where(p => p.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        @if (filtered.Count == 0)
        {
            <div class="px-6 py-10 text-center text-sm text-muted-foreground">
                No articles match your search.
            </div>
        }
        else
        {
            <div class="grid gap-px bg-border sm:grid-cols-2">
                @foreach (var post in filtered)
                {
                    <div class="flex flex-col justify-between bg-card p-5 transition-colors hover:bg-muted/50">
                        <div>
                            <span class="text-sm font-medium">@post.Title</span>
                            <p class="mt-1 line-clamp-2 text-xs text-muted-foreground">@post.Excerpt</p>
                        </div>
                        <div class="mt-3 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @post.Category
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@post.Date</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string _query = "";

    private record Post(string Title, string Excerpt, string Category, string Date);

    private readonly List<Post> _posts =
    [
        new("Incremental Static Regeneration in Practice",
            "Patterns for combining static generation with fresh data in Next.js.",
            "Engineering", "Mar 10, 2026"),
        new("Accessible Color Systems",
            "Building color palettes that meet WCAG contrast requirements at every shade.",
            "Design", "Mar 6, 2026"),
        new("Edge Functions for Personalization",
            "Serving personalized content at the edge without sacrificing cache hit rates.",
            "Engineering", "Mar 2, 2026"),
        new("Running Effective Design Critiques",
            "A framework for giving and receiving design feedback that improves outcomes.",
            "Design", "Feb 26, 2026"),
    ];
}
