@* ===========================================================
   Block: blog-shortform
   Title: Blog Shortform
   Description: Microblog feed with tweet-style short posts, author initials, timestamps, and engagement counts
   Long Description: Share quick thoughts and updates in a microblog format. Short-form posts keep your audience engaged between long-form articles with a familiar social feed layout.
   Dependencies: None
   Source: original/blocks/blog/blog-shortform.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Quick Notes</h2>
            <p class="mt-1 text-sm text-muted-foreground">Short-form thoughts and updates</p>
        </div>

        @for (var i = 0; i < _posts.Count; i++)
        {
            var post = _posts[i];
            <div class="@($"flex gap-3 px-6 py-4{(i < _posts.Count - 1 ? " border-b" : "")}")">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                    @post.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@post.Author</span>
                        <span class="text-xs text-muted-foreground">@post.Timestamp</span>
                    </div>
                    <p class="mt-1 text-sm text-foreground">@post.Content</p>
                    <div class="mt-2 flex items-center gap-4">
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="heart" Size="14" Class="h-3.5 w-3.5" />
                            <span>@post.Likes</span>
                        </div>
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="message-circle" Size="14" Class="h-3.5 w-3.5" />
                            <span>@post.Replies</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ShortPost(string Author, string Initials, string Content, string Timestamp, int Likes, int Replies);

    private readonly List<ShortPost> _posts =
    [
        new("Sarah Chen", "SC",
            "Just shipped our migration to React Server Components. Initial load times dropped by 40%. The mental model shift is real but worth it.",
            "2h ago", 24, 5),
        new("Marcus Webb", "MW",
            "Hot take: most state management libraries are solving problems that Server Components already handle. Fewer client-side stores, more server functions.",
            "5h ago", 89, 12),
        new("Anika Patel", "AP",
            "Reminder that CSS container queries have shipped in all major browsers. Stop reaching for JavaScript resize observers for layout changes.",
            "Yesterday", 142, 8),
    ];
}
