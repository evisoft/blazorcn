@* ===========================================================
   Block: blog-tag-cloud
   Title: Blog Tag Cloud
   Description: A tag cloud visualization with varying badge sizes based on post count for quick topic browsing
   Long Description: Surface your most popular topics at a glance. Tags scale in size based on post volume, giving readers an instant sense of what your blog covers most and helping them discover content by interest.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-tag-cloud.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Topics</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse posts by tag</p>
        </div>
        <div class="flex flex-wrap gap-2 px-6 py-5">
            @foreach (var tag in _tags)
            {
                <BadgeCn Class="@($"cursor-pointer transition-colors hover:bg-muted {GetTagSize(tag.Count)}")"
                         Variant="BadgeVariant.Secondary">
                    @tag.Name
                    <span class="ml-1.5 tabular-nums text-muted-foreground">@tag.Count</span>
                </BadgeCn>
            }
        </div>
    </div>
</section>

@code {
    private record Tag(string Name, int Count);

    private readonly List<Tag> _tags =
    [
        new("React", 24),
        new("TypeScript", 19),
        new("Next.js", 17),
        new("CSS", 14),
        new("Node.js", 12),
        new("Performance", 11),
        new("Testing", 9),
        new("Databases", 8),
        new("DevOps", 7),
        new("Accessibility", 7),
        new("Design Systems", 6),
        new("GraphQL", 5),
        new("Security", 5),
        new("Rust", 4),
        new("AI", 4),
        new("Web APIs", 3),
        new("Architecture", 3),
        new("Open Source", 2),
    ];

    private static string GetTagSize(int count)
    {
        if (count >= 15) return "text-sm px-3 py-1";
        if (count >= 8) return "text-xs px-2.5 py-0.5";
        return "text-xs px-2 py-0.5";
    }
}
