@* ===========================================================
   Block: blog-rectangular
   Title: Blog Rectangular
   Description: Horizontal blog post cards with side-by-side image and content showing category, title, excerpt, and author
   Long Description: Horizontal card rows with a small image on the left and content on the right.
   Dependencies: AvatarCn, BadgeCn
   Source: original/blocks/blog/blog-rectangular.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recent Posts</h2>
        </div>

        @for (var i = 0; i < _posts.Count; i++)
        {
            var post = _posts[i];
            <div class="@($"flex gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                <img alt="@post.Title"
                     class="hidden h-20 w-28 shrink-0 rounded-md object-cover sm:block"
                     height="80"
                     src="@post.Img"
                     width="112" />
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                            @post.Category
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@post.Date</span>
                    </div>
                    <h3 class="mt-1 text-sm font-medium">@post.Title</h3>
                    <p class="mt-1 text-xs text-muted-foreground line-clamp-1">@post.Excerpt</p>
                    <div class="mt-2 flex items-center gap-2">
                        <AvatarCn Class="h-5 w-5">
                            <AvatarImageCn Alt="@post.AuthorName" Src="@post.AuthorAvatar" />
                            <AvatarFallbackCn Class="text-xs">@post.AuthorName[..1]</AvatarFallbackCn>
                        </AvatarCn>
                        <span class="text-xs text-muted-foreground">@post.AuthorName</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record RectPost(string Img, string Category, string Title, string Excerpt, string AuthorName, string AuthorAvatar, string Date);

    private readonly List<RectPost> _posts =
    [
        new("https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&auto=format&fit=crop",
            "Engineering", "Autodesk Looks to the Future of 3D Printing with Project Escher",
            "How multi-head 3D printing could transform manufacturing workflows and enable new production techniques at scale.",
            "Ryan Samuel", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&h=400&auto=format&fit=crop", "Mar 10, 2026"),
        new("https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=800&auto=format&fit=crop",
            "Product", "Cross-Platform Services and the Future of Ride Sharing",
            "Breaking down platform silos to create seamless experiences across mobile, web, and emerging interfaces.",
            "Nora Hazel", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&h=400&auto=format&fit=crop", "Mar 6, 2026"),
        new("https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=800&auto=format&fit=crop",
            "Design", "Six Insights into the French Fashion Technology Landscape",
