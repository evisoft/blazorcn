@* ===========================================================
   Block: blog-sidebar
   Title: Blog Sidebar
   Description: Two-column blog layout with main content area and sidebar showing categories and recent posts
   Long Description: A classic blog layout with main content and a sidebar for discovery. Categories with post counts and recent posts help readers navigate your content.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-sidebar.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        @* Main Content *@
        <div class="md:col-span-2">
            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="border-b px-6 py-5">
                    <h2 class="font-semibold text-xl tracking-tight">Latest Articles</h2>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Insights and tutorials from our team
                    </p>
                </div>
                <div>
                    @for (var i = 0; i < _posts.Count; i++)
                    {
                        var post = _posts[i];
                        <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@post.Title</span>
                                <BadgeCn Class="shrink-0 text-xs" Variant="BadgeVariant.Secondary">
                                    @post.Category
                                </BadgeCn>
                            </div>
                            <p class="mt-1 line-clamp-1 text-xs text-muted-foreground">@post.Excerpt</p>
                            <p class="mt-1.5 text-xs text-muted-foreground">
                                @post.Author &middot; @post.Date
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Sidebar *@
        <aside class="space-y-6">
            @* Categories *@
            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="border-b px-5 py-4">
                    <h3 class="text-sm font-medium">Categories</h3>
                </div>
                <div>
                    @for (var i = 0; i < _categories.Count; i++)
                    {
                        var cat = _categories[i];
                        <div class="@($"flex cursor-pointer items-center justify-between px-5 py-3 text-sm transition-colors hover:bg-muted/50{(i < _categories.Count - 1 ? " border-b" : "")}")">
                            <span class="text-sm">@cat.Name</span>
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                @cat.Count
                            </BadgeCn>
                        </div>
                    }
                </div>
            </div>

            @* Recent Posts *@
            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="border-b px-5 py-4">
                    <h3 class="text-sm font-medium">Recent Posts</h3>
                </div>
                <div>
                    @for (var i = 0; i < _recent.Count; i++)
                    {
                        var post = _recent[i];
                        <div class="@($"cursor-pointer px-5 py-3 transition-colors hover:bg-muted/50{(i < _recent.Count - 1 ? " border-b" : "")}")">
                            <span class="text-sm font-medium">@post.Title</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@post.Date</p>
                        </div>
                    }
                </div>
            </div>
        </aside>
    </div>
</section>

@code {
    private record BlogPost(string Title, string Excerpt, string Category, string Author, string Date);
    private record Category(string Name, int Count);
    private record RecentPost(string Title, string Date);

    private readonly List<BlogPost> _posts =
    [
        new("The Future of Web Development",
            "Exploring new frameworks and tools shaping modern web development.",
            "Technology", "Sarah Chen", "Nov 10, 2024"),
        new("Minimalist Design Principles",
            "Less is more: creating impactful designs through simplicity.",
            "Design", "Alex Morgan", "Nov 8, 2024"),
        new("Building Remote Teams",
            "Strategies for managing distributed teams effectively.",
            "Business", "Jordan Lee", "Nov 5, 2024"),
    ];

    private readonly List<Category> _categories =
    [
        new("Technology", 24),
        new("Design", 18),
        new("Business", 12),
        new("Marketing", 9),
    ];

    private readonly List<RecentPost> _recent =
    [
        new("Getting Started with React", "Nov 12, 2024"),
        new("CSS Grid vs Flexbox", "Nov 11, 2024"),
        new("TypeScript Best Practices", "Nov 9, 2024"),
    ];
}
