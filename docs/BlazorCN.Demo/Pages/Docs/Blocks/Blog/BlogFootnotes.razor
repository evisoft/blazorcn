@* ===========================================================
   Block: blog-footnotes
   Title: Blog Footnotes
   Description: Article footnotes section with numbered references, source names, and optional links for citations and bibliography
   Long Description: Display numbered footnotes with source citations and optional links for article references and bibliography.
   Dependencies: None
   Source: original/blocks/blog/blog-footnotes.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">References</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_footnotes.Count sources cited in this article
            </p>
        </div>
        <div>
            @for (var i = 0; i < _footnotes.Count; i++)
            {
                var fn = _footnotes[i];
                <div class="@($"flex gap-3 px-6 py-3{(i < _footnotes.Count - 1 ? " border-b" : "")}")">
                    <span class="flex size-5 shrink-0 items-center justify-center rounded bg-muted text-[10px] font-medium text-muted-foreground tabular-nums">
                        @fn.Id
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm text-muted-foreground leading-relaxed">@fn.Text</p>
                        <div class="mt-1">
                            @if (fn.Url is not null)
                            {
                                <a href="@fn.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="text-xs font-medium text-foreground underline decoration-muted-foreground/30 underline-offset-2 hover:decoration-foreground">
                                    @fn.Source
                                </a>
                            }
                            else
                            {
                                <span class="text-xs font-medium text-foreground">@fn.Source</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Footnote(int Id, string Text, string Source, string? Url = null);

    private readonly List<Footnote> _footnotes =
    [
        new(1, "Server components reduce client-side JavaScript by up to 30% in typical Next.js applications.",
            "Next.js Documentation", "https://nextjs.org/docs"),
        new(2, "React 19 introduced the use hook for reading resources during render, replacing many useEffect patterns.",
            "React Blog", "https://react.dev/blog"),
        new(3, "TypeScript adoption among professional developers reached 78% in the 2025 Stack Overflow survey.",
            "Stack Overflow Developer Survey 2025"),
        new(4, "Core Web Vitals thresholds were updated in March 2025 to include Interaction to Next Paint as a stable metric.",
            "web.dev", "https://web.dev/vitals"),
        new(5, "Edge runtime cold start times are typically 5-10x faster than traditional serverless functions.",
            "Vercel Engineering Blog", "https://vercel.com/blog"),
    ];
}
