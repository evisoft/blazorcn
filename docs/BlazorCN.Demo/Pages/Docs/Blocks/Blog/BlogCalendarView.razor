@* ===========================================================
   Block: blog-calendar-view
   Title: Blog Calendar View
   Description: Monthly calendar grid showing days with published posts and clickable day details
   Long Description: Visualize your publishing cadence with a calendar grid. Readers can see at a glance which days had new posts and click any day to reveal the article title.
   Dependencies: None
   Source: original/blocks/blog/blog-calendar-view.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">March 2026</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_postsByDay.Count posts published
            </p>
        </div>
        <div class="border-b px-6 py-4">
            <div class="grid grid-cols-7 gap-1">
                @foreach (var d in _daysOfWeek)
                {
                    <div class="py-1 text-center text-xs font-medium text-muted-foreground">
                        @d
                    </div>
                }
                @for (var b = 0; b < MonthOffset; b++)
                {
                    <div></div>
                }
                @for (var day = 1; day <= DaysInMonth; day++)
                {
                    var currentDay = day;
                    var hasPost = _postsByDay.ContainsKey(currentDay);
                    var isSelected = _selectedDay == currentDay;
                    <button
                        type="button"
                        @onclick="() => OnDayClick(currentDay)"
                        class="@Cn.Merge("relative flex flex-col items-center rounded-md py-1.5 text-xs transition-colors", hasPost ? "cursor-pointer hover:bg-muted/50" : "cursor-default text-muted-foreground", isSelected ? "bg-muted" : "")">
                        @currentDay
                        @if (hasPost)
                        {
                            <span class="mt-0.5 size-1 rounded-full bg-foreground"></span>
                        }
                    </button>
                }
            </div>
        </div>
        <div class="px-6 py-4">
            @if (_selectedDay is not null && _postsByDay.ContainsKey(_selectedDay.Value))
            {
                <div>
                    <p class="text-xs text-muted-foreground">March @_selectedDay</p>
                    <p class="mt-1 text-sm font-medium">@_postsByDay[_selectedDay.Value]</p>
                </div>
            }
            else
            {
                <p class="text-xs text-muted-foreground">
                    Select a highlighted day to see the post
                </p>
            }
        </div>
    </div>
</section>

@code {
    private int? _selectedDay;

    private const int MonthOffset = 5;
    private const int DaysInMonth = 31;

    private static readonly string[] _daysOfWeek = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private static readonly Dictionary<int, string> _postsByDay = new()
    {
        [3] = "Getting Started with Edge Runtime",
        [7] = "Design Tokens Best Practices",
        [11] = "How We Reduced Build Times by 60%",
        [14] = "Introducing v3.0: A Complete Redesign",
        [19] = "Accessibility Audit Results",
        [24] = "TypeScript 5.5 Migration Guide",
        [28] = "Year in Review: Engineering Metrics",
    };

    private void OnDayClick(int day)
    {
        _selectedDay = _postsByDay.ContainsKey(day) ? day : null;
    }
}
