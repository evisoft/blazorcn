@* ===========================================================
   Block: blog-marquee
   Title: Blog Marquee
   Description: Dual-row scrolling ticker with post titles auto-scrolling in opposite directions, pausing on hover
   Long Description: Add a dynamic ticker to surface recent and popular posts. Two rows scroll in opposite directions, creating visual interest while pausing on hover for readability.
   Dependencies: None
   Source: original/blocks/blog/blog-marquee.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <style>
        @@keyframes ticker-left {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@keyframes ticker-right {
            from { transform: translateX(-50%); }
            to { transform: translateX(0); }
        }
    </style>
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Latest Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse recent articles</p>
        </div>

        <div class="border-b py-3">
            <div class="group flex overflow-hidden">
                <div class="flex shrink-0 items-center gap-0"
                     style="animation: ticker-left 40s linear infinite;">
                    @foreach (var title in _row1Doubled)
                    {
                        <div class="flex shrink-0 items-center">
                            <span class="shrink-0 cursor-pointer whitespace-nowrap px-4 text-sm font-medium transition-colors hover:text-foreground">
                                @title
                            </span>
                            <span class="size-1 shrink-0 rounded-full bg-muted-foreground/30"></span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="py-3">
            <div class="group flex overflow-hidden">
                <div class="flex shrink-0 items-center gap-0"
                     style="animation: ticker-right 40s linear infinite;">
                    @foreach (var title in _row2Doubled)
                    {
                        <div class="flex shrink-0 items-center">
                            <span class="shrink-0 cursor-pointer whitespace-nowrap px-4 text-sm font-medium transition-colors hover:text-foreground">
                                @title
                            </span>
                            <span class="size-1 shrink-0 rounded-full bg-muted-foreground/30"></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _row1 =
    [
        "Understanding React Server Components",
        "A Practical Guide to Database Indexing",
        "Designing Accessible Color Systems",
        "The Future of Edge Computing",
        "Building Type-Safe APIs with tRPC",
        "CSS Container Queries in Production",
    ];

    private static readonly string[] _row2 =
    [
        "Why We Migrated to Bun",
        "Micro-Frontends: Lessons Learned",
        "Real-Time Collaboration Architecture",
        "Optimizing Core Web Vitals",
        "State Management in 2026",
        "Testing Strategies for React Apps",
    ];

    private static readonly string[] _row1Doubled = [.. _row1, .. _row1];
    private static readonly string[] _row2Doubled = [.. _row2, .. _row2];
}
