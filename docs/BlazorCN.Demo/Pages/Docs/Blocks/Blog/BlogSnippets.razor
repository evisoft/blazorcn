@* ===========================================================
   Block: blog-snippets
   Title: Blog Snippets
   Description: Code-focused blog posts with language badges, inline code previews, and read times
   Long Description: Showcase code-centric tutorials with inline syntax previews. Each post displays a language badge and a compact code block so readers can judge relevance at a glance.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-snippets.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Code Snippets</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Quick tutorials and practical code examples
            </p>
        </div>

        @for (var i = 0; i < _posts.Count; i++)
        {
            var post = _posts[i];
            <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-center justify-between gap-3">
                    <span class="text-sm font-medium">@post.Title</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                        @post.Language
                    </BadgeCn>
                </div>
                <pre class="mt-2.5 overflow-x-auto rounded-md bg-zinc-950 p-3 font-mono text-xs text-zinc-100">@post.Code</pre>
                <div class="mt-2 flex items-center gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                    <span>@post.ReadTime</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record SnippetPost(string Title, string Language, string ReadTime, string Code);

    private readonly List<SnippetPost> _posts =
    [
        new("Type-Safe API Routes with Zod Validation", "TypeScript", "6 min read",
            "const schema = z.object({\n  email: z.string().email(),\n  role: z.enum([\"admin\", \"user\"]),\n})"),
        new("Building a CLI Tool with Click and Rich", "Python", "9 min read",
            "@click.command()\n@click.option(\"--name\", prompt=True)\ndef greet(name: str):\n    console.print(f\"Hello, [green]{name}[/]\")"),
        new("Streaming Responses with Server-Sent Events", "TypeScript", "7 min read",
            "const stream = new ReadableStream({\n  start(controller) {\n    controller.enqueue(\"data: hello\\n\\n\")\n  },\n})"),
    ];
}
