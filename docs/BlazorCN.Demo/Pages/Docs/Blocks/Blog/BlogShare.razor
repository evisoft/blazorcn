@* ===========================================================
   Block: blog-share
   Title: Blog Share
   Description: Social sharing widget with share buttons for Twitter, LinkedIn, Facebook, and a copy link toggle
   Long Description: Let readers spread your content with a compact share widget. Includes one-click sharing to major platforms and a copy-to-clipboard button with confirmation state.
   Dependencies: ButtonCn
   Source: original/blocks/blog/blog-share.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Share This Article</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_postTitle</p>
        </div>

        <div class="px-6 py-5">
            <div class="flex items-center gap-2">
                <a href="@($"https://twitter.com/intent/tweet?url={Uri.EscapeDataString(_postUrl)}")"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground h-8">
                    <LucideIconCn Name="twitter" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    Twitter
                </a>
                <a href="@($"https://www.linkedin.com/sharing/share-offsite/?url={Uri.EscapeDataString(_postUrl)}")"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground h-8">
                    <LucideIconCn Name="linkedin" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    LinkedIn
                </a>
                <a href="@($"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(_postUrl)}")"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground h-8">
                    <LucideIconCn Name="facebook" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    Facebook
                </a>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" @onclick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="16" Class="h-4 w-4 text-emerald-500" />
                        @:Copied!
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        @:Copy Link
                    }
                </ButtonCn>
            </div>

            <div class="mt-4 flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="share" Size="14" Class="h-3.5 w-3.5" />
                <span>@_shares shares</span>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _postTitle = "Building Accessible React Components from Scratch";
    private const string _postUrl = "https://blog.example.com/accessible-react-components";
    private const int _shares = 284;
    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
