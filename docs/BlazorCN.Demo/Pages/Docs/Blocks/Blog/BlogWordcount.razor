@* ===========================================================
   Block: blog-wordcount
   Title: Blog Wordcount
   Description: Blog post listing with word count, estimated read time, and relative length bar for each post
   Long Description: Compare post lengths at a glance. Each article shows its word count, estimated reading time, and a proportional bar so editors can spot outliers and balance their content mix.
   Dependencies: None
   Source: original/blocks/blog/blog-wordcount.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Posts by Length</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Articles sorted by word count with relative length
            </p>
        </div>

        @for (var i = 0; i < _posts.Count; i++)
        {
            var post = _posts[i];
            var pct = (int)Math.Round((double)post.Words / _maxWords * 100);
            <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-start justify-between gap-3">
                    <span class="text-sm font-medium">@post.Title</span>
                    <span class="shrink-0 text-xs text-muted-foreground">@post.ReadTime</span>
                </div>
                <div class="mt-2 flex items-center gap-2">
                    <LucideIconCn Name="file-text" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                    <span class="text-xs tabular-nums text-muted-foreground">
                        @post.Words.ToString("N0") words
                    </span>
                </div>
                <div class="mt-2 h-1.5 w-full rounded-full bg-muted/50">
                    <div class="h-full rounded-full bg-foreground/20"
                         style="@($"width: {pct}%")"></div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record WordPost(string Title, int Words, string ReadTime);

    private readonly List<WordPost> _posts =
    [
        new("Complete Guide to React Server Components", 3420, "15 min"),
        new("Database Indexing Strategies for PostgreSQL", 2180, "10 min"),
        new("Quick Tip: CSS Container Queries", 640, "3 min"),
        new("Authentication Patterns with Better Auth", 1850, "8 min"),
    ];

    private int _maxWords => _posts.Max(p => p.Words);
}
