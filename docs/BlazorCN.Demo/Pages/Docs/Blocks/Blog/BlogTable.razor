@* ===========================================================
   Block: blog-table
   Title: Blog Table
   Description: A clean data table of blog posts with columns for title, author, date, read time, and category
   Long Description: Display your blog posts in a scannable table format. Ideal for dashboards and admin views where editors need to quickly find and manage content across categories.
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/blog/blog-table.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">All Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_posts.Count articles published</p>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="px-6">Title</TableHeadCn>
                    <TableHeadCn>Author</TableHeadCn>
                    <TableHeadCn>Date</TableHeadCn>
                    <TableHeadCn>Read Time</TableHeadCn>
                    <TableHeadCn>Category</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var post in _posts)
                {
                    <TableRowCn Class="cursor-pointer">
                        <TableCellCn Class="px-6 text-sm font-medium">@post.Title</TableCellCn>
                        <TableCellCn Class="text-sm text-muted-foreground">@post.Author</TableCellCn>
                        <TableCellCn Class="text-xs text-muted-foreground">@post.Date</TableCellCn>
                        <TableCellCn Class="text-xs tabular-nums text-muted-foreground">@post.ReadTime</TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @post.Category
                            </BadgeCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record BlogPost(string Title, string Author, string Date, string ReadTime, string Category);

    private readonly List<BlogPost> _posts =
    [
        new("Understanding React Server Components", "Sarah Chen", "Mar 10, 2026", "8 min", "React"),
        new("A Practical Guide to Database Indexing", "James Park", "Mar 5, 2026", "12 min", "Database"),
        new("CSS Container Queries in Production", "Lena Mora", "Feb 28, 2026", "6 min", "CSS"),
        new("Building Type-Safe APIs with tRPC", "David Kim", "Feb 20, 2026", "10 min", "TypeScript"),
    ];
}
