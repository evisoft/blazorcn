@* ===========================================================
   Block: blog-pagination
   Title: Blog Pagination
   Description: Blog post list with page numbers, previous/next controls, and current page indicator
   Long Description: A paginated blog list with prev/next navigation and page numbers.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-pagination.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Articles</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Page @_page of @_totalPages
            </p>
        </div>

        @{
            var visible = _posts.Skip((_page - 1) * PerPage).Take(PerPage).ToList();
        }
        @for (var i = 0; i < visible.Count; i++)
        {
            var post = visible[i];
            <div class="@($"flex flex-col gap-1 px-6 py-4 transition-colors hover:bg-muted/50{(i < visible.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-center gap-2">
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                        @post.Category
                    </BadgeCn>
                    <span class="text-xs text-muted-foreground">@post.Date</span>
                </div>
                <h3 class="text-sm font-medium">@post.Title</h3>
                <p class="text-xs text-muted-foreground line-clamp-1">@post.Excerpt</p>
                <p class="mt-0.5 text-xs text-muted-foreground">By @post.Author</p>
            </div>
        }

        <div class="flex items-center justify-between border-t px-6 py-3">
            <ButtonCn Class="h-7 gap-1 px-2 text-xs"
                      Disabled="@(_page == 1)"
                      OnClick="() => _page--"
                      Variant="ButtonVariant.Outline">
                <LucideIconCn Name="chevron-left" Size="16" Class="h-4 w-4 text-muted-foreground" />
                Previous
            </ButtonCn>

            <div class="flex items-center gap-1">
                @for (var n = 1; n <= _totalPages; n++)
                {
                    var pageNum = n;
                    <ButtonCn Class="h-7 w-7 text-xs"
                              OnClick="() => _page = pageNum"
                              Variant="@(_page == pageNum ? ButtonVariant.Default : ButtonVariant.Ghost)">
                        @pageNum
                    </ButtonCn>
                }
            </div>

            <ButtonCn Class="h-7 gap-1 px-2 text-xs"
                      Disabled="@(_page == _totalPages)"
                      OnClick="() => _page++"
                      Variant="ButtonVariant.Outline">
                Next
                <LucideIconCn Name="chevron-right" Size="16" Class="h-4 w-4 text-muted-foreground" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PaginatedPost(int Id, string Title, string Excerpt, string Category, string Author, string Date);

    private const int PerPage = 3;
    private int _page = 1;
    private int _totalPages => (int)Math.Ceiling((double)_posts.Count / PerPage);

    private readonly List<PaginatedPost> _posts =
