@* ===========================================================
   Block: blog-hero-featured
   Title: Blog Hero Featured
   Description: Featured post with thumbnail and recent articles grid inside a card container
   Long Description: Highlight a featured post alongside recent articles. The hero emphasis comes from layout prominence, not a full-bleed background.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-hero-featured.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Blog</h2>
            <p class="mt-1 text-sm text-muted-foreground">Latest articles from the team.</p>
        </div>

        @* Featured post *@
        <div class="border-b p-6">
            <div class="flex flex-col gap-5 sm:flex-row">
                <img src="@_featured.Image"
                     alt="@_featured.Title"
                     class="h-40 w-full shrink-0 rounded-md object-cover sm:w-56" />
                <div class="flex min-w-0 flex-col justify-between">
                    <div>
                        <div class="mb-2 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @_featured.Category
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@_featured.Date</span>
                        </div>
                        <span class="text-sm font-medium leading-snug">@_featured.Title</span>
                        <p class="mt-1 line-clamp-2 text-xs text-muted-foreground">
                            @_featured.Excerpt
                        </p>
                    </div>
                    <div class="mt-3 flex items-center gap-3">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                            Read article
                        </ButtonCn>
                        <span class="text-xs text-muted-foreground">@_featured.ReadTime</span>
                    </div>
                </div>
            </div>
        </div>

        @* Recent posts *@
        <div class="px-6 py-3">
            <span class="text-xs font-medium text-muted-foreground">Recent</span>
        </div>
        <div>
            @for (var i = 0; i < _recent.Count; i++)
            {
                var post = _recent[i];
                <div class="@($"flex items-center justify-between gap-4 px-6 py-3 transition-colors hover:bg-muted/50{(i < _recent.Count - 1 ? " border-b" : "")}")">
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@post.Title</span>
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            @post.Category
                        </BadgeCn>
                        <span class="hidden text-xs text-muted-foreground sm:inline">
                            @post.ReadTime
                        </span>
                        <span class="text-xs text-muted-foreground">@post.Date</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedPost(string Title, string Excerpt, string Category, string Date, string ReadTime, string Image);
    private record RecentPost(int Id, string Title, string Category, string Date, string ReadTime);

    private readonly FeaturedPost _featured = new(
        "The Architecture Behind Our Real-Time Collaboration Engine",
        "A deep dive into the CRDTs, WebSocket infrastructure, and conflict resolution strategies powering our multiplayer editing experience.",
        "Engineering", "Mar 12, 2026", "11 min",
        "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&h=400&auto=format&fit=crop");

    private readonly List<RecentPost> _recent =
    [
        new(1, "Migrating 2M Rows Without Downtime", "Engineering", "Mar 9, 2026", "8 min"),
        new(2, "How We Redesigned Our Onboarding Flow", "Product", "Mar 5, 2026", "6 min"),
        new(3, "Lessons from Scaling to 100K Users", "Business", "Mar 1, 2026", "5 min"),
    ];
}
