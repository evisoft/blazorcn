@* ===========================================================
   Block: blog-trending
   Title: Blog Trending
   Description: Trending posts with numbered rankings, author attribution, and reading time
   Long Description: Surface your most popular content with a clean ranked list. Numbered posts with author and reading time help readers find proven content.
   Dependencies: None
   Source: original/blocks/blog/blog-trending.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Trending This Week</h2>
            <p class="mt-1 text-sm text-muted-foreground">Most popular articles by readership</p>
        </div>
        <div>
            @for (var i = 0; i < _posts.Count; i++)
            {
                var post = _posts[i];
                <div class="@($"flex cursor-pointer items-center gap-5 px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                    <span class="shrink-0 text-2xl font-semibold tabular-nums text-muted-foreground">
                        @post.Rank
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@post.Title</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @post.Author &middot; @post.ReadTime
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TrendingPost(int Rank, string Title, string Author, string ReadTime);

    private readonly List<TrendingPost> _posts =
    [
        new(1, "The Complete Guide to React Server Components", "Sarah Chen", "12 min read"),
        new(2, "Building a Design System from Scratch", "Marcus Johnson", "15 min read"),
        new(3, "Why TypeScript 5.3 Changes Everything", "Alex Rivera", "8 min read"),
        new(4, "Remote Work Best Practices for Engineering Teams", "Emily Watson", "10 min read"),
    ];
}
