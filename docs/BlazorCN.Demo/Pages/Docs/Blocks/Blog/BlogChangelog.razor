@* ===========================================================
   Block: blog-changelog
   Title: Blog Changelog
   Description: Version-style changelog feed with version badges, dates, and grouped bullet-point updates for blog or product changes
   Long Description: Track blog and product updates in a changelog format. Each entry groups changes by version with clear dates and bullet summaries.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-changelog.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Changelog</h2>
            <p class="mt-1 text-sm text-muted-foreground">Recent updates and improvements</p>
        </div>
        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                <div class="@Cn.Merge("px-6 py-4", i < _entries.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center gap-3">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono text-xs">
                            @entry.Version
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                    <p class="mt-2 text-sm font-medium">@entry.Summary</p>
                    <ul class="mt-2 space-y-1.5">
                        @foreach (var change in entry.Changes)
                        {
                            <li class="flex items-start gap-2 text-xs text-muted-foreground leading-relaxed">
                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                @change
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Date, string Summary, string[] Changes);

    private static readonly ChangelogEntry[] _entries =
    [
        new("v2.4", "March 2025", "Search improvements and new content types",
        [
            "Added full-text search with typo tolerance and ranking",
            "Introduced series pages for multi-part articles",
            "Fixed RSS feed missing author metadata",
        ]),
        new("v2.3", "February 2025", "Performance and accessibility updates",
        [
            "Reduced Largest Contentful Paint by 40% on archive pages",
            "Added keyboard navigation to the post carousel",
            "Updated syntax highlighting theme for better contrast",
        ]),
        new("v2.2", "January 2025", "Author profiles and analytics",
        [
            "Launched author profile pages with post history",
            "Added reading time estimates to all post cards",
            "Fixed image optimization for Open Graph previews",
        ]),
    ];
}
