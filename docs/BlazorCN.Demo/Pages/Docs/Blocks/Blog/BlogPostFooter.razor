@* ===========================================================
   Block: blog-post-footer
   Title: Blog Post Footer
   Description: Article footer section with tags, author bio, share buttons, and publication dates
   Long Description: Give every article a polished ending with tags, author bio, sharing options, and publication dates.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-post-footer.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Article Info</h2>
        </div>

        <div class="border-b px-6 py-4">
            <span class="text-xs font-medium text-muted-foreground">Tags</span>
            <div class="mt-2 flex flex-wrap gap-1.5">
                @foreach (var tag in _tags)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                        @tag
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="border-b px-6 py-4">
            <div class="flex items-start gap-3 rounded-md bg-muted/50 p-3">
                <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                    @_authorInitials
                </div>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@_authorName</span>
                    <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                        @_authorBio
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-6 py-4">
            <span class="text-xs font-medium text-muted-foreground">Share this post</span>
            <div class="mt-2 flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="twitter" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    Twitter
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="mail" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    Email
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="link" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    Copy Link
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-4 px-6 py-4">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="calendar" Size="14" Class="h-3.5 w-3.5" />
                Published @_publishedAt
            </div>
            <span class="text-xs text-muted-foreground/40">|</span>
            <span class="text-xs text-muted-foreground">Updated @_updatedAt</span>
        </div>
    </div>
</section>

@code {
    private readonly string[] _tags = ["React", "Accessibility", "Server Components", "Performance"];
    private const string _authorName = "Elena Vasquez";
    private const string _authorInitials = "EV";
    private const string _authorBio = "Frontend engineer focused on accessible design systems and React performance patterns.";
    private const string _publishedAt = "January 14, 2026";
    private const string _updatedAt = "March 8, 2026";
}
