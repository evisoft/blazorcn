@* ===========================================================
   Block: blog-newsletter-archive
   Title: Blog Newsletter Archive
   Description: Past newsletter issues with issue numbers, dates, subject lines, and open rate percentages
   Long Description: Let readers browse past newsletter issues. Each entry shows the issue number, send date, subject line, and open rate.
   Dependencies: None
   Source: original/blocks/blog/blog-newsletter-archive.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Newsletter Archive</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Browse past issues of our weekly newsletter
            </p>
        </div>

        @for (var i = 0; i < _issues.Count; i++)
        {
            var issue = _issues[i];
            <div class="@($"flex items-center gap-4 px-6 py-3.5 transition-colors hover:bg-muted/50{(i < _issues.Count - 1 ? " border-b" : "")}")">
                <LucideIconCn Name="mail" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                            #@issue.Number
                        </span>
                        <span class="truncate text-sm font-medium">@issue.Subject</span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@issue.Date</p>
                </div>
                <div class="shrink-0 text-right">
                    <span class="text-sm font-medium tabular-nums">@issue.OpenRate</span>
                    <p class="text-xs text-muted-foreground">open rate</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record NewsletterIssue(int Id, int Number, string Date, string Subject, string OpenRate);

    private readonly List<NewsletterIssue> _issues =
    [
        new(1, 42, "Mar 10, 2026", "Why We Rewrote Our Component Library", "64%"),
        new(2, 41, "Mar 3, 2026", "Accessibility Wins That Take Five Minutes", "58%"),
        new(3, 40, "Feb 24, 2026", "The Hidden Cost of Third-Party Scripts", "61%"),
        new(4, 39, "Feb 17, 2026", "Designing for Offline-First Experiences", "55%"),
    ];
}
