@* ===========================================================
   Block: blog-step-by-step
   Title: Blog Step By Step
   Description: A numbered step-by-step tutorial layout with completion status indicators and a vertical connecting line
   Long Description: Walk readers through complex topics one step at a time. Each step is clearly numbered with a completion indicator, making it easy to track progress through a tutorial.
   Dependencies: None
   Source: original/blocks/blog/blog-step-by-step.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Build a Full-Stack Form</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                5 steps to a production-ready form with validation
            </p>
        </div>
        <div class="px-6 py-4">
            @for (var i = 0; i < _steps.Count; i++)
            {
                var step = _steps[i];
                <div class="flex gap-4">
                    <div class="flex flex-col items-center">
                        <span class="text-2xl font-semibold tabular-nums text-muted-foreground">
                            @step.Number
                        </span>
                        @if (i < _steps.Count - 1)
                        {
                            <div class="my-1 w-px flex-1 bg-border"></div>
                        }
                    </div>
                    <div class="@($"{(i < _steps.Count - 1 ? "pb-5 " : "")}min-w-0 flex-1")">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@step.Title</span>
                            @if (step.Completed)
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="h-4 w-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle" Size="16" Class="h-4 w-4 text-muted-foreground" />
                            }
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@step.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Step(int Number, string Title, string Description, bool Completed);

    private readonly List<Step> _steps =
    [
        new(1, "Install dependencies",
            "Add the required packages to your project using your package manager.", true),
        new(2, "Configure the database",
            "Set up your connection string and run the initial migration.", true),
        new(3, "Create the API route",
            "Define your endpoint handler with input validation and error handling.", false),
        new(4, "Build the UI component",
            "Wire up the form to your API route with loading and error states.", false),
        new(5, "Deploy to production",
            "Push your changes and verify the deployment with a smoke test.", false),
    ];
}
