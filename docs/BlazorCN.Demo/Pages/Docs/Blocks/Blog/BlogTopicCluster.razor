@* ===========================================================
   Block: blog-topic-cluster
   Title: Blog Topic Cluster
   Description: Topic cluster visualization with pillar content and branching subtopics for content strategy planning
   Long Description: Visualize your content strategy with topic clusters. A central pillar topic branches into related subtopics, each showing post counts and linking to deeper content.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-topic-cluster.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Topic Cluster</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_subtopics.Sum(s => s.Posts) articles across @_subtopics.Count subtopics
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="network" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">Pillar: @_pillar</span>
                    <p class="text-xs text-muted-foreground">
                        Central hub article covering the full topic
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                    Pillar
                </BadgeCn>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _subtopics.Count; i++)
            {
                var subtopic = _subtopics[i];
                <div class="@($"flex cursor-pointer items-center gap-3 py-3 pr-6 pl-6 transition-colors hover:bg-muted/50{(i < _subtopics.Count - 1 ? " border-b" : "")}")">
                    <div class="ml-4 flex items-center gap-3 text-muted-foreground/40">
                        <span class="inline-block h-px w-3 bg-muted-foreground/20"></span>
                        <LucideIconCn Name="circle-dot" Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground/40" />
                    </div>
                    <span class="@($"size-1.5 shrink-0 rounded-full {GetStatusDot(subtopic.Status)}")"></span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@subtopic.Title</span>
                    </div>
                    <div class="flex shrink-0 items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="file-text" Size="12" Class="h-3 w-3" />
                        <span class="tabular-nums">@subtopic.Posts</span>
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground/60" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const string _pillar = "React Performance Optimization";

    private record Subtopic(string Title, int Posts, string Status);

    private readonly List<Subtopic> _subtopics =
    [
        new("Code Splitting & Lazy Loading", 4, "published"),
        new("Memoization with useMemo & useCallback", 3, "published"),
        new("Virtual DOM Reconciliation", 2, "published"),
        new("Bundle Size Analysis & Reduction", 3, "published"),
        new("Server-Side Rendering vs Static Generation", 1, "draft"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "published" => "bg-emerald-500",
        _ => "bg-muted-foreground/30",
    };
}
