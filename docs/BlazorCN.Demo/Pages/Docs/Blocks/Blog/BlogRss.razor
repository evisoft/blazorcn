@* ===========================================================
   Block: blog-rss
   Title: Blog Rss
   Description: RSS feed panel with feed URL, copy button, recent entries, and subscribe action
   Long Description: Preview your RSS feed contents with a copyable feed URL and recent entries list. Readers can subscribe with one click using their preferred feed reader.
   Dependencies: ButtonCn, LucideRssCn, LucideCheckCn, LucideCopyCn
   Source: original/blocks/blog/blog-rss.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideRssCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">RSS Feed</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">Last updated Mar 12, 2026</p>
        </div>

        <div class="border-b px-6 py-4">
            <span class="text-xs font-medium text-muted-foreground">Feed URL</span>
            <div class="mt-1.5 flex items-center gap-2">
                <code class="min-w-0 flex-1 truncate rounded-md bg-muted/50 px-3 py-1.5 font-mono text-xs">
                    @_feedUrl
                </code>
                <ButtonCn Class="h-7 shrink-0 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost" OnClick="CopyUrl">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="h-3 w-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="h-3 w-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        <div class="border-b">
            <div class="px-6 py-3">
                <span class="text-xs font-medium text-muted-foreground">Recent entries</span>
            </div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                <div class="@(Cn.Merge("flex items-center gap-4 px-6 py-3", i < _entries.Length - 1 ? "border-b" : ""))">
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@entry.Title</span>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                </div>
            }
        </div>

        <div class="px-6 py-4">
            <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                Subscribe via RSS
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _copied;
    private static readonly string _feedUrl = "https://example.com/blog/feed.xml";

    private async Task CopyUrl()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    private record FeedEntry(string Title, string Date);

    private static readonly FeedEntry[] _entries =
    [
        new("Migrating to Next.js App Router", "Mar 12, 2026"),
        new("Understanding Content Security Policies", "Mar 8, 2026"),
        new("Building Accessible Form Components", "Mar 3, 2026"),
    ];
}
