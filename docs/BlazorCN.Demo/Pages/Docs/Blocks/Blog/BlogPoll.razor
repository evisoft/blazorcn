@* ===========================================================
   Block: blog-poll
   Title: Blog Poll
   Description: Interactive reader poll with answer options, horizontal progress bars, vote percentages, and total vote count
   Long Description: Engage your audience with inline polls. Readers pick an option and instantly see results with percentage bars.
   Dependencies: None
   Source: original/blocks/blog/blog-poll.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Reader Poll</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_question</p>
        </div>

        <div class="space-y-2 px-6 py-4">
            @foreach (var option in _options)
            {
                var pct = (int)Math.Round((double)option.Votes / _totalVotes * 100);
                var isSelected = _selected == option.Id;
                var optionId = option.Id;
                <button type="button"
                        class="@($"relative w-full overflow-hidden rounded-md border px-4 py-2.5 text-left transition-colors {(isSelected ? "border-foreground/20 bg-muted/50" : "border-transparent bg-muted/30 hover:bg-muted/50")}")"
                        @onclick="() => _selected = optionId">
                    @if (_selected is not null)
                    {
                        <div class="absolute inset-y-0 left-0 bg-foreground/5 transition-all duration-500"
                             style="@($"width: {pct}%")"></div>
                    }
                    <div class="relative flex items-center justify-between gap-4">
                        <span class="text-sm font-medium">@option.Label</span>
                        @if (_selected is not null)
                        {
                            <span class="shrink-0 text-xs font-medium tabular-nums text-muted-foreground">
                                @pct%
                            </span>
                        }
                    </div>
                </button>
            }
        </div>

        <div class="border-t px-6 py-3">
            <span class="text-xs text-muted-foreground">
                @_totalVotes.ToString("N0") total votes
            </span>
        </div>
    </div>
</section>

@code {
    private record PollOption(string Id, string Label, int Votes);

    private const string _question = "What topic should we cover next?";
    private string? _selected;

    private readonly List<PollOption> _options =
    [
        new("a", "Advanced TypeScript Patterns", 342),
        new("b", "Database Performance Tuning", 256),
        new("c", "Design System Architecture", 189),
        new("d", "Edge Runtime Deep Dive", 127),
    ];

    private int _totalVotes => _options.Sum(o => o.Votes);
}
