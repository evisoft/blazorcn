@* ===========================================================
   Block: blog-cards-grid
   Title: Blog Cards Grid
   Description: Blog post grid with thumbnail images, author info, and dates inside a single card container
   Long Description: A responsive grid of blog post cards with thumbnails, titles, excerpts, and author metadata.
   Dependencies: AvatarCn, BadgeCn
   Source: original/blocks/blog/blog-cards-grid.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Latest Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Recent articles from our contributors
            </p>
        </div>

        <div class="grid grid-cols-1 gap-0 sm:grid-cols-3">
            @for (var i = 0; i < _posts.Length; i++)
            {
                var post = _posts[i];
                <div class="@Cn.Merge("flex flex-col p-4 transition-colors hover:bg-muted/50", i < _posts.Length - 1 ? "border-b sm:border-b-0 sm:border-r" : "")">
                    <img
                        alt="@post.Title"
                        class="h-32 w-full rounded-md object-cover"
                        src="@post.Img" />
                    <div class="mt-3 flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                            @post.Category
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@post.ReadTime</span>
                    </div>
                    <span class="mt-2 line-clamp-2 text-sm font-medium">@post.Title</span>
                    <p class="mt-1 line-clamp-2 text-xs text-muted-foreground">@post.Excerpt</p>
                    <div class="mt-3 flex items-center gap-2">
                        <AvatarCn Class="h-5 w-5">
                            <AvatarImageCn Alt="@post.AuthorName" Src="@post.AuthorImg" />
                            <AvatarFallbackCn Class="text-[10px]">@post.AuthorName[..1]</AvatarFallbackCn>
                        </AvatarCn>
                        <span class="text-xs text-muted-foreground">@post.AuthorName</span>
                        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                        <span class="text-xs text-muted-foreground">@post.Date</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PostItem(string Title, string Excerpt, string Img, string Category, string Date, string ReadTime, string AuthorName, string AuthorImg);

    private static readonly PostItem[] _posts =
    [
        new("Autodesk Looks to the Future of 3D Printing with Project Escher",
            "How additive manufacturing is transforming the product design pipeline for enterprise teams.",
            "https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&auto=format&fit=crop",
            "Enterprise", "Sep 10, 2024", "6 min", "Ryan Samuel",
            "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&h=400&auto=format&fit=crop"),
        new("Bolt Launching Cross-Platform Service This Week",
            "The ride-sharing company expands to new markets with a unified mobile and web experience.",
            "https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=800&auto=format&fit=crop",
            "Startups", "Sep 12, 2024", "4 min", "Nora Hazel",
            "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&h=400&auto=format&fit=crop"),
        new("6 Insights into the French Fashion Landscape",
            "Exploring how Parisian design houses are adapting to digital-first consumer behavior.",
            "https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=800&auto=format&fit=crop",
            "Trending", "Sep 16, 2024", "8 min", "Otto Gonzalez",
            "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&auto=format&fit=crop"),
    ];
}
