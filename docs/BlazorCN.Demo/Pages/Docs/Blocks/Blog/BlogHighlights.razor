@* ===========================================================
   Block: blog-highlights
   Title: Blog Highlights
   Description: Notable quotes and key takeaways extracted from blog posts with attribution
   Long Description: Surface the most impactful insights from your articles. Each highlight shows a pull quote with attribution to the original post and author.
   Dependencies: None
   Source: original/blocks/blog/blog-highlights.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Highlights</h2>
            <p class="mt-1 text-sm text-muted-foreground">Notable quotes from recent articles</p>
        </div>

        @for (var i = 0; i < _highlights.Count; i++)
        {
            var item = _highlights[i];
            <div class="@($"px-6 py-5{(i < _highlights.Count - 1 ? " border-b" : "")}")">
                <LucideIconCn Name="quote" Size="16" Class="mb-2 h-4 w-4 text-muted-foreground/60" />
                <p class="text-sm italic leading-relaxed text-foreground">@item.Quote</p>
                <div class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">@item.Author</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>@item.Article</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Highlight(string Quote, string Article, string Author);

    private readonly List<Highlight> _highlights =
    [
        new("The best abstractions are the ones you forget exist. A well-designed API should feel like a natural extension of the language, not a layer on top of it.",
            "On API Design Principles", "Elena Vasquez"),
        new("We reduced our bundle size by 62% simply by auditing our imports. Tree-shaking only works if your modules are structured to support it.",
            "Performance Lessons from Production", "Marcus Liu"),
        new("Accessibility is not a feature you bolt on at the end. It is a design constraint that makes everything better when applied from the start.",
            "Building Inclusive Interfaces", "Priya Sharma"),
    ];
}
