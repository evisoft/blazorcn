@* ===========================================================
   Block: blog-recommendations
   Title: Blog Recommendations
   Description: Personalized article recommendations with relevance scores, categories, and read times
   Long Description: Show readers content tailored to their interests.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-recommendations.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">Recommended for You</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">Based on your reading history</p>
        </div>

        @for (var i = 0; i < _recommendations.Count; i++)
        {
            var rec = _recommendations[i];
            <div class="@($"flex cursor-pointer items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _recommendations.Count - 1 ? " border-b" : "")}")">
                <div class="min-w-0 flex-1">
                    <h3 class="text-sm font-medium">@rec.Title</h3>
                    <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                            @rec.Category
                        </BadgeCn>
                        <span>@rec.ReadTime</span>
                    </div>
                </div>
                <span class="shrink-0 font-mono text-xs text-muted-foreground tabular-nums">
                    @rec.Match% match
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record Recommendation(string Title, string Category, string ReadTime, int Match);

    private readonly List<Recommendation> _recommendations =
    [
        new("Streaming SSR with React 19 Suspense", "React", "11 min", 95),
        new("Zero-Downtime Deployments with Docker", "DevOps", "8 min", 87),
        new("Writing Effective Integration Tests", "Testing", "13 min", 74),
    ];
}
