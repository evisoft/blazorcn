@* ===========================================================
   Block: blog-directory
   Title: Blog Directory
   Description: Alphabetical A-Z index with filterable letter buttons and post listings for quick navigation across blog content
   Long Description: Browse your entire blog library with a clean alphabetical index. Letters with matching posts are highlighted, and clicking any letter instantly filters the list.
   Dependencies: None
   Source: original/blocks/blog/blog-directory.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Directory</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse posts alphabetically</p>
        </div>
        <div class="flex flex-wrap gap-1 border-b px-6 py-3">
            @foreach (var letter in _allLetters)
            {
                var hasEntries = _posts.ContainsKey(letter);
                var letterCopy = letter;
                <button type="button"
                        disabled="@(!hasEntries)"
                        @onclick="() => _activeLetter = letterCopy"
                        class="@($"flex size-8 items-center justify-center rounded text-xs font-medium transition-colors {(_activeLetter == letter ? "bg-foreground text-background" : hasEntries ? "text-foreground hover:bg-muted/50" : "cursor-default text-muted-foreground/40")}")">
                    @letter
                </button>
            }
        </div>
        <div>
            @{
                var posts = _posts.ContainsKey(_activeLetter) ? _posts[_activeLetter] : Array.Empty<DirectoryPost>();
            }
            @if (posts.Length > 0)
            {
                @for (var i = 0; i < posts.Length; i++)
                {
                    var post = posts[i];
                    <div class="@($"flex cursor-pointer items-center justify-between gap-4 px-6 py-3 transition-colors hover:bg-muted/50{(i < posts.Length - 1 ? " border-b" : "")}")">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@post.Title</span>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                @post.Description
                            </p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@post.Date</span>
                    </div>
                }
            }
            else
            {
                <div class="px-6 py-8 text-center text-sm text-muted-foreground">
                    No posts starting with &ldquo;@_activeLetter&rdquo;
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DirectoryPost(string Title, string Description, string Date);

    private string _activeLetter = "A";

    private readonly string[] _allLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".Select(c => c.ToString()).ToArray();

    private readonly Dictionary<string, DirectoryPost[]> _posts = new()
    {
        ["A"] =
        [
            new("API Design Patterns", "REST and GraphQL best practices for modern apps", "Mar 2"),
            new("Accessible Forms Guide", "Building forms that work for everyone", "Feb 18"),
            new("Async State Management", "Handling server state with React Query", "Jan 10"),
            new("Animation Performance Tips", "GPU-accelerated CSS and JS animations", "Jan 4"),
        ],
        ["C"] =
        [
            new("CSS Container Queries", "Responsive design without media queries", "Mar 8"),
            new("Component Testing Strategies", "Unit and integration tests for UI", "Feb 22"),
            new("Caching in Next.js", "Data cache, full route, and router cache explained", "Feb 1"),
        ],
        ["R"] =
        [
            new("React Server Components", "Server-first rendering architecture", "Mar 12"),
            new("Responsive Typography", "Fluid type scales with clamp()", "Feb 14"),
            new("Runtime vs Build-time", "When to compute at each stage", "Jan 20"),
        ],
        ["T"] =
        [
            new("TypeScript 5.5 Features", "Inferred type predicates and isolated declarations", "Mar 5"),
            new("Testing Library Best Practices", "Querying, assertions, and async patterns", "Feb 9"),
        ],
    };
}
