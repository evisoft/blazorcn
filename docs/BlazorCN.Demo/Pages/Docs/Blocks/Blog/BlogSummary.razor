@* ===========================================================
   Block: blog-summary
   Title: Blog Summary
   Description: AI-generated post summaries with article titles, summary blocks, and read-more links
   Long Description: Give readers the gist before they commit. AI-generated summaries help visitors decide which articles to read in full, reducing bounce rates on long-form content.
   Dependencies: None
   Source: original/blocks/blog/blog-summary.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Article Summaries</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                AI-generated overviews of recent posts
            </p>
        </div>

        @for (var i = 0; i < _articles.Count; i++)
        {
            var article = _articles[i];
            <div class="@($"px-6 py-5{(i < _articles.Count - 1 ? " border-b" : "")}")">
                <span class="text-sm font-medium">@article.Title</span>

                <div class="mt-3 rounded-md bg-muted/50 p-3">
                    <div class="mb-1.5 flex items-center gap-1.5">
                        <LucideIconCn Name="sparkles" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">AI Summary</span>
                    </div>
                    <p class="text-sm leading-relaxed text-muted-foreground">@article.Summary</p>
                </div>

                <button type="button"
                        class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                    Read full article
                    <LucideIconCn Name="arrow-right" Size="12" Class="h-3 w-3" />
                </button>
            </div>
        }
    </div>
</section>

@code {
    private record Article(string Title, string Summary);

    private readonly List<Article> _articles =
    [
        new("Migrating a Monolith to Microservices Without Downtime",
            "This article walks through a strangler-fig migration pattern for decomposing a Rails monolith into Go microservices. The team used feature flags and dual-write strategies to maintain zero downtime across 14 months of incremental cutovers."),
        new("Why We Replaced Redux with Zustand in Production",
            "After benchmarking re-render counts and bundle size, the team swapped Redux Toolkit for Zustand across 40 connected components. The migration reduced state-related re-renders by 60% and cut the store boilerplate by half."),
    ];
}
