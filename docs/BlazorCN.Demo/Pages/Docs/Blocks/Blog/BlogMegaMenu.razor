@* ===========================================================
   Block: blog-mega-menu
   Title: Blog Mega Menu
   Description: Multi-column blog navigation with categories, popular posts, and resource links in a grid layout
   Long Description: Give readers a bird's-eye view of your blog with a mega menu. Three columns organize categories, popular posts, and resources.
   Dependencies: None
   Source: original/blocks/blog/blog-mega-menu.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Explore the Blog</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Browse by category, popularity, or resource
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3">
            <div class="border-b px-6 py-4 md:border-r md:border-b-0">
                <div class="mb-3 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="folder" Size="14" Class="h-3.5 w-3.5" />
                    Categories
                </div>
                <div class="space-y-1">
                    @foreach (var cat in _categories)
                    {
                        <div class="flex cursor-pointer items-center justify-between rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-muted/50">
                            <span class="font-medium">@cat.Name</span>
                            <span class="text-xs tabular-nums text-muted-foreground">@cat.Count</span>
                        </div>
                    }
                </div>
            </div>

            <div class="border-b px-6 py-4 md:border-r md:border-b-0">
                <div class="mb-3 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="file-text" Size="14" Class="h-3.5 w-3.5" />
                    Popular Posts
                </div>
                <div class="space-y-3">
                    @foreach (var post in _popular)
                    {
                        <div class="cursor-pointer rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                            <span class="text-sm font-medium">@post.Title</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@post.Author</p>
                        </div>
                    }
                </div>
            </div>

            <div class="px-6 py-4">
                <div class="mb-3 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="book-open" Size="14" Class="h-3.5 w-3.5" />
                    Resources
                </div>
                <div class="space-y-1">
                    @foreach (var res in _resources)
                    {
                        <div class="flex cursor-pointer items-center justify-between rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-muted/50">
                            <span class="font-medium">@res</span>
                            <LucideIconCn Name="external-link" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Category(string Name, int Count);
    private record PopularPost(string Title, string Author);

    private readonly List<Category> _categories =
    [
        new("Engineering", 48), new("Design", 32), new("Product", 27),
        new("DevOps", 19), new("Security", 14), new("Career", 11),
    ];

    private readonly List<PopularPost> _popular =
    [
        new("React Server Components Deep Dive", "Sarah Chen"),
        new("Designing for Accessibility", "Emily Watson"),
        new("Scaling PostgreSQL to 1M Queries", "David Park"),
    ];

    private readonly string[] _resources = ["Style Guide", "Writing for Developers", "RSS Feed", "Newsletter Archive"];
}
