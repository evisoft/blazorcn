@* ===========================================================
   Block: blog-announcement
   Title: Blog Announcement
   Description: Prominent announcement banner with featured post and compact past announcements
   Long Description: Highlight important blog updates with a prominent announcement banner. Feature the latest news front and center, with past announcements listed below for context.
   Dependencies: ButtonCn, LucideMegaphoneCn
   Source: original/blocks/blog/blog-announcement.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Announcements</h2>
            <p class="mt-1 text-sm text-muted-foreground">Latest updates and news</p>
        </div>
        <div class="border-b px-6 py-5">
            <div class="flex items-start gap-3">
                <LucideMegaphoneCn Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@_featured.Title</span>
                    <p class="mt-1 text-sm text-muted-foreground">@_featured.Description</p>
                    <div class="mt-3 flex items-center gap-3">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                            Read more
                        </ButtonCn>
                        <span class="text-xs text-muted-foreground">@_featured.Date</span>
                    </div>
                </div>
            </div>
        </div>
        <div>
            @for (var i = 0; i < _past.Length; i++)
            {
                var item = _past[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-6 py-3 transition-colors hover:bg-muted/50", i < _past.Length - 1 ? "border-b" : "")">
                    <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                    <span class="min-w-0 flex-1 truncate text-sm text-muted-foreground">
                        @item.Title
                    </span>
                    <span class="shrink-0 text-xs text-muted-foreground">@item.Date</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AnnouncementItem(string Title, string Description, string Date);
    private record PastItem(int Id, string Title, string Date);

    private static readonly AnnouncementItem _featured = new(
        "Introducing v3.0: A Complete Redesign",
        "We rebuilt the entire platform from the ground up with a new design system, improved performance, and better developer experience.",
        "Mar 14");

    private static readonly PastItem[] _past =
    [
        new(1, "API rate limits updated for free tier", "Mar 8"),
        new(2, "New integration: GitHub Actions support", "Feb 28"),
    ];
}
