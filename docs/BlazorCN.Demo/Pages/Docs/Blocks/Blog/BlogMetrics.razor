@* ===========================================================
   Block: blog-metrics
   Title: Blog Metrics
   Description: Detailed single-post engagement metrics with a 3x2 grid showing views, visitors, read time, completion rate, shares, and comments
   Long Description: Understand how a single article performs with granular engagement metrics.
   Dependencies: None
   Source: original/blocks/blog/blog-metrics.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Post Metrics</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_postTitle</p>
        </div>

        <div class="grid grid-cols-3">
            @for (var i = 0; i < _metrics.Count; i++)
            {
                var metric = _metrics[i];
                <div class="@($"px-6 py-4{(i % 3 != 2 ? " border-r" : "")}{(i < 3 ? " border-b" : "")}")">
                    <span class="text-xs text-muted-foreground">@metric.Label</span>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">@metric.Value</p>
                    <span class="mt-0.5 text-xs text-muted-foreground">@metric.Sub</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Value, string Sub);

    private const string _postTitle = "The Complete Guide to React Server Components";

    private readonly List<Metric> _metrics =
    [
        new("Total Views", "8,241", "+12% vs avg"),
        new("Unique Visitors", "6,103", "74% of views"),
        new("Avg Read Time", "6m 42s", "12 min article"),
        new("Completion Rate", "58%", "Above average"),
        new("Total Shares", "342", "Across platforms"),
        new("Comments", "47", "23 unique authors"),
    ];
}
