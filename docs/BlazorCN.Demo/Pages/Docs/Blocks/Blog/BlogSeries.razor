@* ===========================================================
   Block: blog-series
   Title: Blog Series
   Description: Article series tracker with progress bar, part status indicators, and sequential reading flow
   Long Description: Track multi-part article series with clear progress indicators. Readers follow tutorial sequences with part-by-part status and estimated reading times.
   Dependencies: ProgressCn
   Source: original/blocks/blog/blog-series.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">@_seriesTitle</h2>
            <div class="mt-3 flex items-center gap-3">
                <ProgressCn Class="h-1.5 flex-1" Value="@_progressPercent" aria-label="Progress" />
                <span class="shrink-0 text-xs text-muted-foreground">
                    @_completedCount of @_parts.Count completed
                </span>
            </div>
        </div>
        <div>
            @for (var i = 0; i < _parts.Count; i++)
            {
                var part = _parts[i];
                var index = i;
                <div class="@($"flex cursor-pointer items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _parts.Count - 1 ? " border-b" : "")}")">
                    <span class="text-sm font-medium tabular-nums text-muted-foreground">
                        @(index + 1)
                    </span>
                    <span class="@($"size-2 shrink-0 rounded-full {GetStatusDot(part.Status)}")"></span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@part.Title</span>
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                        @if (!string.IsNullOrEmpty(GetStatusLabel(part.Status)))
                        {
                            <span class="text-xs text-muted-foreground">@GetStatusLabel(part.Status)</span>
                        }
                        <span class="text-xs text-muted-foreground">@part.ReadTime</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Part(string Title, string ReadTime, string Status);

    private const string _seriesTitle = "Building a Full-Stack React Application";

    private readonly List<Part> _parts =
    [
        new("Project Setup & Architecture", "10 min", "completed"),
        new("Building the Component Library", "15 min", "completed"),
        new("State Management Patterns", "12 min", "completed"),
        new("API Integration & Data Fetching", "14 min", "current"),
        new("Authentication & Authorization", "12 min", "upcoming"),
    ];

    private int _completedCount => _parts.Count(p => p.Status == "completed");
    private int _progressPercent => (int)((double)_completedCount / _parts.Count * 100);

    private static string GetStatusDot(string status) => status switch
    {
        "completed" => "bg-emerald-500",
        "current" => "bg-blue-500",
        _ => "bg-muted-foreground/30",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "completed" => "Completed",
        "current" => "In progress",
        _ => "",
    };
}
