@* ===========================================================
   Block: blog-testimonials
   Title: Blog Testimonials
   Description: Reader testimonials section with quotes, star ratings, and attribution for blog social proof
   Long Description: Showcase reader testimonials to build trust and encourage new visitors. Star ratings and real quotes demonstrate the value your blog provides to the community.
   Dependencies: None
   Source: original/blocks/blog/blog-testimonials.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">What Readers Say</h2>
            <p class="mt-1 text-sm text-muted-foreground">Feedback from our community</p>
        </div>

        @for (var i = 0; i < _testimonials.Count; i++)
        {
            var item = _testimonials[i];
            <div class="@($"px-6 py-5{(i < _testimonials.Count - 1 ? " border-b" : "")}")">
                <p class="text-sm italic text-foreground/90 leading-relaxed">&ldquo;@item.Quote&rdquo;</p>
                <div class="mt-3 flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium">@item.Name</span>
                        <p class="text-xs text-muted-foreground">@item.Role</p>
                    </div>
                    <div class="flex items-center gap-0.5">
                        @for (var s = 0; s < 5; s++)
                        {
                            <LucideIconCn Name="star" Size="12"
                                          Class="@($"h-3 w-3 {(s < item.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")}")" />
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Testimonial(string Quote, string Name, string Role, int Rating);

    private readonly List<Testimonial> _testimonials =
    [
        new("The React Server Components series completely changed how I architect my applications. Went from confused to confident in a weekend.",
            "Priya Sharma", "Frontend Engineer at Vercel", 5),
        new("Best technical writing I've found online. The code examples are production-ready, not just toy demos. I reference these articles weekly.",
            "Marcus Johnson", "Senior Developer at Stripe", 5),
        new("The performance optimization guides helped us cut our bundle size by 40%. Clear explanations with measurable results every time.",
            "Elena Kowalski", "Tech Lead at Shopify", 4),
    ];
}
