@* ===========================================================
   Block: blog-author-grid
   Title: Blog Author Grid
   Description: Grid of blog authors with initials avatars, roles, post counts, and short bios in a 2x2 layout
   Long Description: Showcase your writing team with a clean author grid. Each card displays initials, role, post count, and a short bio.
   Dependencies: None
   Source: original/blocks/blog/blog-author-grid.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Writers</h2>
            <p class="mt-1 text-sm text-muted-foreground">Meet the team behind the blog</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2">
            @for (var i = 0; i < _authors.Length; i++)
            {
                var author = _authors[i];
                <div class="@Cn.Merge("px-6 py-4 transition-colors hover:bg-muted/50", i < 2 ? "border-b" : "", i % 2 == 0 ? "sm:border-r" : "")">
                    <div class="flex items-center gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                            @author.Initials
                        </div>
                        <div class="min-w-0">
                            <span class="text-sm font-medium">@author.Name</span>
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@author.Role</span>
                                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                <span class="text-xs text-muted-foreground">@author.PostCount posts</span>
                            </div>
                        </div>
                    </div>
                    <p class="mt-2.5 text-xs text-muted-foreground leading-relaxed">@author.Bio</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AuthorItem(string Name, string Initials, string Role, int PostCount, string Bio);

    private static readonly AuthorItem[] _authors =
    [
        new("Sarah Chen", "SC", "Lead Engineer", 24,
            "Writes about React architecture, performance optimization, and developer tooling."),
        new("Marcus Rivera", "MR", "Design Engineer", 18,
            "Covers design systems, CSS techniques, and the intersection of design and code."),
        new("Aisha Patel", "AP", "Staff Engineer", 31,
            "Focuses on backend architecture, database patterns, and infrastructure at scale."),
        new("James Okoro", "JO", "DevRel", 15,
            "Creates tutorials, guides, and community content for the developer ecosystem."),
    ];
}
