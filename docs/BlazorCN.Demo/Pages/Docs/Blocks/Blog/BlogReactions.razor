@* ===========================================================
   Block: blog-reactions
   Title: Blog Reactions
   Description: Emoji reaction buttons for blog posts with toggleable counts for Like, Love, Fire, Insightful, and Clap
   Long Description: Let readers express how they feel about your content with emoji reactions.
   Dependencies: None
   Source: original/blocks/blog/blog-reactions.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Reactions</h2>
            <p class="mt-1 text-sm text-muted-foreground">How did you feel about this article?</p>
        </div>

        <div class="px-6 py-5">
            <div class="flex flex-wrap gap-2">
                @foreach (var reaction in _reactions)
                {
                    var label = reaction.Label;
                    var isActive = _active.Contains(label);
                    <button type="button"
                            @onclick="() => Toggle(label)"
                            class="@($"inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm transition-colors {(isActive ? "border-foreground/20 bg-muted" : "hover:bg-muted/50")}")">
                        <span>@reaction.Emoji</span>
                        <span class="text-xs text-muted-foreground tabular-nums">@reaction.Count</span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private class ReactionItem
    {
        public string Emoji { get; set; } = "";
        public string Label { get; set; } = "";
        public int Count { get; set; }
    }

    private readonly HashSet<string> _active = [];

    private readonly List<ReactionItem> _reactions =
    [
        new() { Emoji = "\uD83D\uDC4D", Label = "Like", Count = 42 },
        new() { Emoji = "\u2764\uFE0F", Label = "Love", Count = 18 },
        new() { Emoji = "\uD83D\uDD25", Label = "Fire", Count = 27 },
        new() { Emoji = "\uD83D\uDCA1", Label = "Insightful", Count = 13 },
        new() { Emoji = "\uD83D\uDC4F", Label = "Clap", Count = 9 },
    ];

    private void Toggle(string label)
    {
        var reaction = _reactions.First(r => r.Label == label);
        if (_active.Contains(label))
        {
            _active.Remove(label);
            reaction.Count--;
        }
        else
        {
            _active.Add(label);
            reaction.Count++;
        }
    }
}
