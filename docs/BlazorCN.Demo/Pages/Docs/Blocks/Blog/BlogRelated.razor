@* ===========================================================
   Block: blog-related
   Title: Blog Related
   Description: Related posts section showing contextually relevant articles with category badges and reading time
   Long Description: Keep readers engaged with related content.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-related.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Related Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">Articles you might enjoy next</p>
        </div>
        <div>
            @for (var i = 0; i < _posts.Count; i++)
            {
                var post = _posts[i];
                <div class="@($"flex cursor-pointer items-start justify-between gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@post.Title</span>
                            <BadgeCn Class="shrink-0 text-xs" Variant="BadgeVariant.Secondary">
                                @post.Category
                            </BadgeCn>
                        </div>
                        <p class="mt-1 line-clamp-1 text-xs text-muted-foreground">@post.Excerpt</p>
                    </div>
                    <div class="shrink-0 text-right">
                        <span class="text-xs text-muted-foreground">@post.Date</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@post.ReadTime</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RelatedPost(string Title, string Excerpt, string Category, string Date, string ReadTime);

    private readonly List<RelatedPost> _posts =
    [
        new("Advanced React Patterns You Should Know",
            "Compound components, render props, and hooks patterns for scalable applications.",
            "React", "Nov 12, 2024", "10 min read"),
        new("TypeScript Best Practices in 2024",
            "Modern TypeScript patterns and configurations for production applications.",
            "TypeScript", "Nov 8, 2024", "12 min read"),
        new("Optimizing React Apps for Core Web Vitals",
            "Practical techniques to improve LCP, FID, and CLS scores in production.",
            "Performance", "Nov 5, 2024", "8 min read"),
    ];
}
