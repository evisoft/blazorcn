@* ===========================================================
   Block: blog-milestones
   Title: Blog Milestones
   Description: Blog milestone achievement cards showing post counts, total views, and anniversary dates with trophy icons
   Long Description: Celebrate your blog achievements with a clean milestone tracker.
   Dependencies: None
   Source: original/blocks/blog/blog-milestones.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Milestones</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Key achievements on our blogging journey
            </p>
        </div>

        @for (var i = 0; i < _milestones.Count; i++)
        {
            var milestone = _milestones[i];
            <div class="@($"flex items-start gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _milestones.Count - 1 ? " border-b" : "")}")">
                <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-amber-500/10">
                    <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-amber-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@milestone.Title</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@milestone.Date</p>
                    <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                        @milestone.Description
                    </p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Milestone(int Id, string Title, string Date, string Description);

    private readonly List<Milestone> _milestones =
    [
        new(1, "100th Post Published", "Mar 2, 2026",
            "A century of articles covering web development, design systems, and engineering culture."),
        new(2, "1M Total Views", "Jan 18, 2026",
            "One million page views across all posts since the blog launched."),
        new(3, "3 Years of Blogging", "Nov 5, 2025",
            "Three years of consistent weekly publishing without missing a single week."),
    ];
}
