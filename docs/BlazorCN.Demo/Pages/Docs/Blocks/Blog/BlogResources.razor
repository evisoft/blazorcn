@* ===========================================================
   Block: blog-resources
   Title: Blog Resources
   Description: Curated resource link list with external link icons, source domains, and brief descriptions
   Long Description: Surface the best external links alongside your own content.
   Dependencies: None
   Source: original/blocks/blog/blog-resources.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Curated Resources</h2>
            <p class="mt-1 text-sm text-muted-foreground">Recommended reading and references</p>
        </div>
        <div>
            @for (var i = 0; i < _resources.Count; i++)
            {
                var resource = _resources[i];
                <a href="@resource.Url"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="@($"flex items-start gap-3 px-6 py-4 transition-colors hover:bg-muted/50{(i < _resources.Count - 1 ? " border-b" : "")}")">
                    <LucideIconCn Name="external-link" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@resource.Title</span>
                        <span class="ml-2 text-xs text-muted-foreground">@resource.Domain</span>
                        <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                            @resource.Description
                        </p>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private record Resource(string Title, string Domain, string Url, string Description);

    private readonly List<Resource> _resources =
    [
        new("Web Content Accessibility Guidelines (WCAG) 2.2", "w3.org",
            "https://www.w3.org/TR/WCAG22/",
            "The official W3C specification for making web content accessible to people with disabilities."),
        new("Patterns for Building Resilient React Apps", "kentcdodds.com",
            "https://kentcdodds.com/blog/resilient-react",
            "Practical error boundary patterns and graceful degradation strategies for production applications."),
        new("Understanding Server Components Architecture", "vercel.com",
            "https://vercel.com/blog/understanding-react-server-components",
            "Deep technical overview of how server components reduce client JavaScript and improve performance."),
        new("The Complete Guide to CSS Container Queries", "developer.mozilla.org",
            "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_containment/Container_queries",
            "MDN reference for container queries with browser support tables and responsive component examples."),
    ];
}
