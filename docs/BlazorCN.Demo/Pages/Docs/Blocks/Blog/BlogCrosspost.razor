@* ===========================================================
   Block: blog-crosspost
   Title: Blog Crosspost
   Description: A list of articles originally published on external platforms with source attribution
   Long Description: Surface your cross-posted content in one place. Each article links back to its original platform, giving readers context on where it first appeared while driving traffic to your own blog.
   Dependencies: BadgeCn, LucideExternalLinkCn
   Source: original/blocks/blog/blog-crosspost.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Cross-Posted Articles</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Originally published on other platforms
            </p>
        </div>

        @for (var i = 0; i < _posts.Length; i++)
        {
            var post = _posts[i];
            <div class="@Cn.Merge("px-6 py-4 transition-colors hover:bg-muted/50", i < _posts.Length - 1 ? "border-b" : "")">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@post.Title</span>
                            <LucideExternalLinkCn Size="14" Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                        </div>
                        <p class="mt-1 text-xs text-muted-foreground leading-relaxed line-clamp-2">
                            @post.Excerpt
                        </p>
                        <div class="mt-2 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                @post.Platform
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@post.Date</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record CrossPost(string Title, string Platform, string Date, string Excerpt);

    private static readonly CrossPost[] _posts =
    [
        new("Migrating 200K Lines of CSS to Tailwind", "Dev.to", "Feb 18, 2026",
            "A step-by-step account of moving a large Rails monolith from BEM-style CSS to Tailwind utility classes without breaking production."),
        new("Why We Switched from REST to tRPC", "Medium", "Jan 30, 2026",
            "Our team replaced 47 REST endpoints with type-safe tRPC procedures. Here is what we gained, what we lost, and what surprised us."),
        new("Building Accessible Forms That Don't Suck", "Hashnode", "Jan 12, 2026",
            "Common form accessibility mistakes and how to fix them with proper ARIA attributes, focus management, and error announcements."),
    ];
}
