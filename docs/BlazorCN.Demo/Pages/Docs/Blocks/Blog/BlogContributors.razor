@* ===========================================================
   Block: blog-contributors
   Title: Blog Contributors
   Description: Team contributors panel with initials avatar, role badge, article count, and join date
   Long Description: Show the people behind your publication with a clean contributor list. Each entry features an initials avatar, role, and contribution stats.
   Dependencies: BadgeCn, LucideCalendarCn, LucideFileTextCn
   Source: original/blocks/blog/blog-contributors.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Contributors</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_contributors.Length team members</p>
        </div>

        @for (var i = 0; i < _contributors.Length; i++)
        {
            var contributor = _contributors[i];
            <div class="@Cn.Merge("flex items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50", i < _contributors.Length - 1 ? "border-b" : "")">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @contributor.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@contributor.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            @contributor.Role
                        </BadgeCn>
                    </div>
                    <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1">
                            <LucideFileTextCn Size="12" Class="h-3 w-3" />
                            @contributor.Articles articles
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideCalendarCn Size="12" Class="h-3 w-3" />
                            @contributor.Joined
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ContributorItem(string Name, string Initials, string Role, int Articles, string Joined);

    private static readonly ContributorItem[] _contributors =
    [
        new("Sarah Chen", "SC", "Editor", 47, "Jan 2023"),
        new("Marcus Johnson", "MJ", "Writer", 32, "Mar 2023"),
        new("Emily Watson", "EW", "Writer", 21, "Aug 2023"),
        new("David Park", "DP", "Guest", 5, "Nov 2024"),
    ];
}
