@* ===========================================================
   Block: blog-revision-history
   Title: Blog Revision History
   Description: Post revision history log with timestamps, authors, change descriptions, and view-diff buttons for tracking article edits
   Long Description: Show readers and editors exactly what changed and when. A revision history builds trust by making edits transparent and lets teams track who updated what across published content.
   Dependencies: ButtonCn
   Source: original/blocks/blog/blog-revision-history.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Revision History</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_revisions.Count revisions for this article
            </p>
        </div>
        <div>
            @for (var i = 0; i < _revisions.Count; i++)
            {
                var revision = _revisions[i];
                <div class="@($"flex items-start gap-3 px-6 py-4{(i < _revisions.Count - 1 ? " border-b" : "")}")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                        @revision.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@revision.Author</span>
                            <span class="text-xs text-muted-foreground">@revision.Timestamp</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@revision.Description</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs">
                        <LucideIconCn Name="file-text" Size="14" Class="h-3.5 w-3.5" />
                        View diff
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Revision(string Timestamp, string Author, string Initials, string Description);

    private readonly List<Revision> _revisions =
    [
        new("March 12, 2026 at 3:14 PM", "Elena Vasquez", "EV",
            "Updated code examples to use React 20 syntax"),
        new("March 10, 2026 at 11:02 AM", "David Kim", "DK",
            "Fixed typo in section 3 and corrected API endpoint URL"),
        new("March 5, 2026 at 9:48 AM", "Elena Vasquez", "EV",
            "Added performance benchmarks table and conclusion section"),
        new("March 1, 2026 at 2:30 PM", "Elena Vasquez", "EV",
            "Initial publication"),
    ];
}
