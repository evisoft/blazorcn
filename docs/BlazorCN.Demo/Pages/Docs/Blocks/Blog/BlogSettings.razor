@* ===========================================================
   Block: blog-settings
   Title: Blog Settings
   Description: Reader preference panel with font size, theme, notifications, and reading speed controls
   Long Description: Let readers customize their experience with adjustable font size, theme preferences, and notification controls. A clean settings panel that respects user choice.
   Dependencies: SelectCn, SwitchCn
   Source: original/blocks/blog/blog-settings.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="font-semibold text-xl tracking-tight">Reading Preferences</h2>
          <p class="mt-1 text-sm text-muted-foreground">Customize your reading experience</p>
        </div>

        <div class="flex items-center justify-between border-b px-6 py-4">
          <div>
            <span class="text-sm font-medium">{SETTINGS[0].label}</span>
            <p class="mt-0.5 text-xs text-muted-foreground">{SETTINGS[0].description}</p>
          </div>
          <SelectCn Value="medium">
            <SelectTriggerCn Class="w-28" Size="ButtonSize.Sm">
              <SelectValueCn />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="small">Small</SelectItemCn>
              <SelectItemCn Value="medium">Medium</SelectItemCn>
              <SelectItemCn Value="large">Large</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>

        <div class="flex items-center justify-between border-b px-6 py-4">
          <div>
            <span class="text-sm font-medium">{SETTINGS[1].label}</span>
            <p class="mt-0.5 text-xs text-muted-foreground">{SETTINGS[1].description}</p>
          </div>
          <SelectCn Value="system">
            <SelectTriggerCn Class="w-28" Size="ButtonSize.Sm">
              <SelectValueCn />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="system">System</SelectItemCn>
              <SelectItemCn Value="light">Light</SelectItemCn>
              <SelectItemCn Value="dark">Dark</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>

        <div class="flex items-center justify-between border-b px-6 py-4">
          <div>
            <span class="text-sm font-medium">{SETTINGS[2].label}</span>
            <p class="mt-0.5 text-xs text-muted-foreground">{SETTINGS[2].description}</p>
          </div>
          <SwitchCn defaultChecked />
        </div>

        <div class="flex items-center justify-between px-6 py-4">
          <div>
            <span class="text-sm font-medium">{SETTINGS[3].label}</span>
            <p class="mt-0.5 text-xs text-muted-foreground">{SETTINGS[3].description}</p>
          </div>
          <SelectCn Value="average">
            <SelectTriggerCn Class="w-28" Size="ButtonSize.Sm">
              <SelectValueCn />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="slow">Slow</SelectItemCn>
              <SelectItemCn Value="average">Average</SelectItemCn>
              <SelectItemCn Value="fast">Fast</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
      </div>
    </section>

