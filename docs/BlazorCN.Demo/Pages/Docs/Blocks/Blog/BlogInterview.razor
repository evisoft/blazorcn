@* ===========================================================
   Block: blog-interview
   Title: Blog Interview
   Description: Q&A interview format with alternating question-answer pairs, interviewer and interviewee attribution, and conversation-style layout
   Long Description: Present interviews in a clean Q&A format with clear speaker attribution and visual rhythm between questions and answers.
   Dependencies: None
   Source: original/blocks/blog/blog-interview.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">@_topic</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_interviewer interviews @_interviewee, @_intervieweeRole
            </p>
        </div>

        @for (var i = 0; i < _pairs.Count; i++)
        {
            var pair = _pairs[i];
            <div class="@($"px-6 py-4{(i < _pairs.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-start gap-2">
                    <span class="shrink-0 font-mono text-xs font-medium text-muted-foreground">
                        Q:
                    </span>
                    <p class="text-sm font-medium">@pair.Question</p>
                </div>
                <div class="mt-3 flex items-start gap-2">
                    <span class="shrink-0 font-mono text-xs font-medium text-muted-foreground">
                        A:
                    </span>
                    <p class="text-xs text-muted-foreground leading-relaxed">@pair.Answer</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record QaPair(string Question, string Answer);

    private const string _interviewer = "Alex Rivera";
    private const string _interviewee = "Maya Lin";
    private const string _intervieweeRole = "Staff Engineer, Vercel";
    private const string _topic = "Scaling React Server Components in Production";

    private readonly List<QaPair> _pairs =
    [
        new("What was the biggest challenge when adopting RSC at scale?",
            "Cache invalidation across server and client boundaries. We had to rethink our entire data fetching strategy because stale closures in server components behave differently than in traditional SPAs. It took about three months to build the right abstractions."),
        new("How do you handle shared state between server and client components?",
            "We use a thin serialization layer that passes only the minimal props needed. Anything interactive lives in a client component island. The key insight was treating the server-client boundary like an API contract with strict typing."),
        new("What advice would you give teams starting with RSC today?",
            "Start with your data-heavy pages first, not your interactive ones. The biggest wins come from moving database queries to server components and eliminating client-side waterfalls. Build a small proof of concept before migrating your entire app."),
    ];
}
