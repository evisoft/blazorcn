@* ===========================================================
   Block: blog-subscribe
   Title: Blog Subscribe
   Description: Topic subscription manager with toggle switches for following individual blog categories
   Long Description: Let readers subscribe to the topics they care about. Each category shows posting frequency so subscribers know what to expect in their inbox.
   Dependencies: SwitchCn
   Source: original/blocks/blog/blog-subscribe.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Topic Subscriptions</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Choose which topics to follow &middot; @_topics.Count(t => t.Enabled) active
            </p>
        </div>

        @for (var i = 0; i < _topics.Count; i++)
        {
            var topic = _topics[i];
            var index = i;
            <div class="@($"flex items-center justify-between gap-4 px-6 py-3.5{(i < _topics.Count - 1 ? " border-b" : "")}")">
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@topic.Name</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@topic.Frequency</p>
                </div>
                <SwitchCn Checked="@topic.Enabled"
                          CheckedChanged="@(() => Toggle(index))"
                          aria-label="@($"Subscribe to {topic.Name}")" />
            </div>
        }
    </div>
</section>

@code {
    private class Topic
    {
        public string Name { get; set; } = "";
        public string Frequency { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private readonly List<Topic> _topics =
    [
        new() { Name = "Engineering", Frequency = "~3 posts/week", Enabled = true },
        new() { Name = "Design", Frequency = "~2 posts/week", Enabled = true },
        new() { Name = "Product", Frequency = "~1 post/week", Enabled = false },
        new() { Name = "Culture", Frequency = "~2 posts/month", Enabled = false },
        new() { Name = "Announcements", Frequency = "~1 post/month", Enabled = true },
        new() { Name = "Security", Frequency = "~1 post/month", Enabled = false },
    ];

    private void Toggle(int index)
    {
        _topics[index].Enabled = !_topics[index].Enabled;
    }
}
