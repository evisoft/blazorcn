@* ===========================================================
   Block: blog-knowledge-base
   Title: Blog Knowledge Base
   Description: KB-style categorized articles with category headers, icons, and article rows for help and documentation sites
   Long Description: Organize help articles into browsable categories with icons and arrow indicators.
   Dependencies: None
   Source: original/blocks/blog/blog-knowledge-base.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Knowledge Base</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse articles by category</p>
        </div>

        @for (var ci = 0; ci < _categories.Count; ci++)
        {
            var category = _categories[ci];
            <div>
                <div class="flex items-center gap-2 border-b bg-muted/30 px-6 py-2.5">
                    <LucideIconCn Name="@category.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <span class="text-xs font-medium">@category.Name</span>
                    <span class="text-xs text-muted-foreground">(@category.Articles.Length)</span>
                </div>
                @for (var ai = 0; ai < category.Articles.Length; ai++)
                {
                    var article = category.Articles[ai];
                    var showBorder = ai < category.Articles.Length - 1 || ci < _categories.Count - 1;
                    <button type="button"
                            class="@($"flex w-full items-center gap-3 px-6 py-3 text-left transition-colors hover:bg-muted/50{(showBorder ? " border-b" : "")}")">
                        <LucideIconCn Name="file-text" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        <span class="min-w-0 flex-1 truncate text-sm font-medium">@article</span>
                        <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground/60" />
                    </button>
                }
            </div>
        }
    </div>
</section>

@code {
    private record KbCategory(string Name, string Icon, string[] Articles);

    private readonly List<KbCategory> _categories =
    [
        new("Getting Started", "rocket",
            ["Installation and initial setup", "Creating your first project", "Understanding the dashboard"]),
        new("Advanced", "book-open",
            ["Custom plugin development", "API rate limiting and quotas"]),
        new("Troubleshooting", "wrench",
            ["Resolving build failures", "Common authentication errors", "Performance debugging guide"]),
    ];
}
