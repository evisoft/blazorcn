@* ===========================================================
   Block: blog-recap
   Title: Blog Recap
   Description: Weekly content digest with numbered highlights, category badges, and one-line summaries
   Long Description: Curate your best content into a weekly or monthly digest.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-recap.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">This Week in Tech</h2>
            <p class="mt-1 text-sm text-muted-foreground">March 10 - March 16, 2026</p>
        </div>
        <div>
            @for (var i = 0; i < _items.Count; i++)
            {
                var item = _items[i];
                <div class="@($"flex items-start gap-3 px-6 py-4{(i < _items.Count - 1 ? " border-b" : "")}")">
                    <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md bg-muted font-mono text-xs text-muted-foreground">
                        @item.Rank
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                                @item.Category
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                            @item.Summary
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RecapItem(int Rank, string Title, string Summary, string Category);

    private readonly List<RecapItem> _items =
    [
        new(1, "React 20 Server Actions Deep Dive",
            "How server actions simplify form handling and data mutations without API routes.", "React"),
        new(2, "Designing Accessible Color Systems",
            "A practical guide to building WCAG-compliant palettes that work in dark mode.", "Design"),
        new(3, "Edge Functions vs Serverless: When to Use Each",
            "Benchmarks and decision framework for choosing the right compute model.", "Infrastructure"),
        new(4, "TypeScript 5.8 Pattern Matching Preview",
            "Early look at the match expression proposal and what it means for error handling.", "TypeScript"),
        new(5, "Building a CLI Tool with Bun",
            "From zero to published npm package using Bun as runtime and bundler.", "Tooling"),
    ];
}
