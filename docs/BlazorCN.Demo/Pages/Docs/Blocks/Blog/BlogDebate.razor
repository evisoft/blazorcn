@* ===========================================================
   Block: blog-debate
   Title: Blog Debate
   Description: Two opposing viewpoints presented side by side with author arguments and key points
   Long Description: Present both sides of a technical debate in a balanced, structured format. Readers see arguments for and against a position with each author's key points, encouraging critical thinking over dogma.
   Dependencies: None
   Source: original/blocks/blog/blog-debate.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Debate</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_topic</p>
        </div>

        <div class="grid grid-cols-1 divide-y sm:grid-cols-2 sm:divide-x sm:divide-y-0">
            @foreach (var side in new[] { _forSide, _againstSide })
            {
                <div class="px-6 py-5">
                    <div class="flex flex-col gap-3">
                        <span class="text-xs font-medium text-muted-foreground">@side.Stance</span>
                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <LucideIconCn Name="user" Size="12" Class="h-3 w-3" />
                            @side.Author
                        </div>
                        <p class="text-sm leading-relaxed">@side.Excerpt</p>
                        <ul class="flex flex-col gap-1.5">
                            @foreach (var point in side.Points)
                            {
                                <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/50"></span>
                                    @point
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DebateSide(string Stance, string Author, string Excerpt, string[] Points);

    private const string _topic = "Should you adopt a monorepo?";

    private readonly DebateSide _forSide = new("For", "Elena Torres",
        "A monorepo unifies tooling, simplifies dependency management, and makes cross-package refactors trivial. For teams shipping multiple packages, the coordination benefits outweigh the scaling challenges.",
        ["Atomic commits across packages", "Shared CI/CD configuration", "Easier code reuse and discovery"]);

    private readonly DebateSide _againstSide = new("Against", "James Park",
        "Monorepos add complexity to CI pipelines, slow down clones, and create implicit coupling between unrelated projects. Polyrepos enforce clear ownership boundaries and scale independently.",
        ["Independent deploy cycles", "Faster CI for isolated changes", "Clear ownership boundaries"]);
}
