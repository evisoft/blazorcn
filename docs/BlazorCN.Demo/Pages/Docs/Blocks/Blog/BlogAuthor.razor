@* ===========================================================
   Block: blog-author
   Title: Blog Author
   Description: Author profile with avatar, bio, social links, and recent posts in a single card layout
   Long Description: Display author profiles with bio, social links, and recent articles in a compact card.
   Dependencies: AvatarCn, BadgeCn, ButtonCn, LucideCalendarCn, LucideGithubCn, LucideLinkedinCn, LucideTwitterCn
   Source: original/blocks/blog/blog-author.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Author</h2>
        </div>

        <div class="border-b px-6 py-5">
            <div class="flex items-start gap-4">
                <AvatarCn Class="h-14 w-14 shrink-0">
                    <AvatarImageCn Alt="@AuthorName" Src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&h=400&auto=format&fit=crop" />
                    <AvatarFallbackCn>SC</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-sm">@AuthorName</span>
                        <BadgeCn Variant="BadgeVariant.Secondary">Senior Software Engineer</BadgeCn>
                    </div>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Writing about React, TypeScript, and scalable web applications. Previously at Stripe and Vercel. Making complex topics accessible through practical tutorials.
                    </p>
                    <div class="mt-3 flex items-center gap-4 text-xs text-muted-foreground">
                        <span>47 articles</span>
                        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                        <span>12.4K followers</span>
                    </div>
                    <div class="mt-3 flex gap-1">
                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="h-7 w-7" aria-label="Twitter">
                            <LucideTwitterCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="h-7 w-7" aria-label="LinkedIn">
                            <LucideLinkedinCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="h-7 w-7" aria-label="GitHub">
                            <LucideGithubCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-6 py-3">
            <span class="text-xs font-medium text-muted-foreground">Recent Posts</span>
        </div>
        @for (var i = 0; i < _recentPosts.Length; i++)
        {
            var post = _recentPosts[i];
            <div class="@Cn.Merge("flex items-center justify-between gap-4 px-6 py-3 transition-colors hover:bg-muted/50", i < _recentPosts.Length - 1 ? "border-b" : "")">
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@post.Title</span>
                    <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideCalendarCn Size="12" Class="h-3 w-3" />
                        <span>@post.Date</span>
                        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                        <span>@post.ReadTime</span>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">
                    @post.Category
                </BadgeCn>
            </div>
        }
    </div>
</section>

@code {
    private const string AuthorName = "Sarah Chen";

    private record RecentPost(string Title, string Date, string ReadTime, string Category);

    private static readonly RecentPost[] _recentPosts =
    [
        new("The Complete Guide to React Server Components", "Nov 14, 2024", "12 min", "React"),
        new("TypeScript 5.3: What's New and Why It Matters", "Nov 10, 2024", "8 min", "TypeScript"),
        new("Building a Design System with Tailwind CSS", "Nov 5, 2024", "15 min", "CSS"),
    ];
}
