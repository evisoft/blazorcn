@code {
    private const string BlogAccordionCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""border-b px-6 py-5"">
            <h2 class=""font-semibold text-xl tracking-tight"">Recent Posts</h2>
            <p class=""mt-1 text-sm text-muted-foreground"">
                @_posts.Length articles published this month
            </p>
        </div>
        <div>
            @for (var i = 0; i < _posts.Length; i++)
            {
                var post = _posts[i];
                var isOpen = _openId == post.Id;
                <CollapsibleCn Open=""@isOpen"" OpenChanged=""@(open => SetOpen(open, post.Id))"">
                    <CollapsibleTriggerCn
                        Class=""@Cn.Merge(""flex w-full items-center gap-3 px-6 py-4 text-left transition-colors hover:bg-muted/50"", i < _posts.Length - 1 || isOpen ? ""border-b"" : """")"">
                        <LucideChevronRightCn
                            Size=""16""
                            Class=""@Cn.Merge(""h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200"", isOpen ? ""rotate-90"" : """")"" />
                        <div class=""min-w-0 flex-1"">
                            <span class=""text-sm font-medium"">@post.Title</span>
                            <p class=""mt-0.5 text-xs text-muted-foreground"">
                                @post.Author &middot; @post.Date
                            </p>
                        </div>
                    </CollapsibleTriggerCn>
                    <CollapsibleContentCn Class=""@(i < _posts.Length - 1 ? ""border-b"" : """")"">
                        <div class=""bg-muted/30 px-6 py-4"">
                            <p class=""text-sm text-muted-foreground"">@post.Excerpt</p>
                            <p class=""mt-2 text-xs text-muted-foreground"">@post.ReadTime read</p>
                        </div>
                    </CollapsibleContentCn>
                </CollapsibleCn>
            }
        </div>
    </div>
</section>

@code {
    private int _openId;

    private void SetOpen(bool open, int id)
    {
        _openId = open ? id : 0;
    }

    private record PostItem(int Id, string Title, string Excerpt, string Author, string Date, string ReadTime);

    private static readonly PostItem[] _posts =
    [
        new(1, ""Why We Migrated to Server Components"",
            ""After six months of incremental adoption, our bundle size dropped 40% and initial load time improved by 1.2 seconds across all routes."",
            ""Sarah Chen"", ""Mar 12"", ""8 min""),
        new(2, ""Designing Accessible Color Systems"",
            ""A practical guide to building color palettes that meet WCAG 2.1 AA contrast requirements while maintaining brand consistency across light and dark themes."",
            ""James Okafor"", ""Mar 9"", ""11 min""),
        new(3, ""Edge Functions vs Serverless: A Cost Analysis"",
            ""We compared cold start times, memory usage, and monthly costs across three cloud providers to find the optimal deployment strategy for our API."",
            ""Mei Lin"", ""Mar 5"", ""14 min""),
        new(4, ""Building a Type-Safe ORM Layer"",
            ""How we used TypeScript generics and Prisma to create a fully type-safe data access layer that catches schema mismatches at compile time."",
            ""David Park"", ""Mar 1"", ""10 min""),
    ];
}";

    private const string BlogAnnouncementCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""border-b px-6 py-5"">
            <h2 class=""font-semibold text-xl tracking-tight"">Announcements</h2>
            <p class=""mt-1 text-sm text-muted-foreground"">Latest updates and news</p>
        </div>
        <div class=""border-b px-6 py-5"">
            <div class=""flex items-start gap-3"">
                <LucideMegaphoneCn Size=""16"" Class=""mt-0.5 h-4 w-4 shrink-0 text-muted-foreground"" />
                <div class=""min-w-0 flex-1"">
                    <span class=""text-sm font-medium"">@_featured.Title</span>
                    <p class=""mt-1 text-sm text-muted-foreground"">@_featured.Description</p>
                    <div class=""mt-3 flex items-center gap-3"">
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 text-xs"">
                            Read more
                        </ButtonCn>
                        <span class=""text-xs text-muted-foreground"">@_featured.Date</span>
                    </div>
                </div>
            </div>
        </div>
        <div>
            @for (var i = 0; i < _past.Length; i++)
            {
                var item = _past[i];
                <div class=""@Cn.Merge(""flex items-center gap-3 px-6 py-3 transition-colors hover:bg-muted/50"", i < _past.Length - 1 ? ""border-b"" : """")"">
                    <span class=""size-1.5 shrink-0 rounded-full bg-muted-foreground/40""></span>
                    <span class=""min-w-0 flex-1 truncate text-sm text-muted-foreground"">
                        @item.Title
                    </span>
                    <span class=""shrink-0 text-xs text-muted-foreground"">@item.Date</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AnnouncementItem(string Title, string Description, string Date);
    private record PastItem(int Id, string Title, string Date);

    private static readonly AnnouncementItem _featured = new(
        ""Introducing v3.0: A Complete Redesign"",
        ""We rebuilt the entire platform from the ground up with a new design system, improved performance, and better developer experience."",
        ""Mar 14"");

    private static readonly PastItem[] _past =
    [
        new(1, ""API rate limits updated for free tier"", ""Mar 8""),
        new(2, ""New integration: GitHub Actions support"", ""Feb 28""),
    ];
}";

    private const string BlogArchiveCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""border-b px-6 py-5"">
            <h2 class=""font-semibold text-xl tracking-tight"">Archive</h2>
            <p class=""mt-1 text-sm text-muted-foreground"">Browse posts by year and month</p>
        </div>
        <div>
            @for (var gi = 0; gi < _archive.Length; gi++)
            {
                var group = _archive[gi];
                var isExpanded = _expanded == group.Year;
                var groupBorderClass = gi < _archive.Length - 1 && !isExpanded ? ""border-b"" : """";
                <div class=""@groupBorderClass"">
                    <button
                        type=""button""
                        @onclick=""@(() => ToggleExpanded(group.Year))""
                        class=""flex w-full items-center gap-3 px-6 py-3.5 text-left transition-colors hover:bg-muted/50"">
                        <LucideChevronRightCn
                            Class=""@Cn.Merge(Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """"))""
                            Size=""16"" />
                        <span class=""text-sm font-medium"">@group.Year</span>
                        <span class=""text-xs text-muted-foreground"">@group.Count posts</span>
                    </button>
                    @if (isExpanded)
                    {
                        @for (var mi = 0; mi < group.Months.Length; mi++)
                        {
                            var month = group.Months[mi];
                            var monthBorderClass = mi < group.Months.Length - 1 || gi < _archive.Length - 1 ? ""border-b"" : """";
                            <div class=""@monthBorderClass"">
                                <div class=""bg-muted/50 px-6 py-2 pl-12"">
                                    <span class=""text-xs font-medium text-muted-foreground"">
                                        @month.Month
                                    </span>
                                </div>
                                @foreach (var post in month.Posts)
                                {
                                    <div class=""flex cursor-pointer items-center justify-between gap-4 px-6 py-2.5 pl-12 transition-colors hover:bg-muted/50"">
                                        <span class=""text-sm text-foreground"">@post.Title</span>
                                        <span class=""shrink-0 text-xs text-muted-foreground"">
                                            @post.Date
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = ""2025"";

