        new() { Emoji = ""\uD83D\uDCA1"", Label = ""Insightful"", Count = 13 },
        new() { Emoji = ""\uD83D\uDC4F"", Label = ""Clap"", Count = 9 },
    ];

    private void Toggle(string label)
    {
        var reaction = _reactions.First(r => r.Label == label);
        if (_active.Contains(label))
        {
            _active.Remove(label);
            reaction.Count--;
        }
        else
        {
            _active.Add(label);
            reaction.Count++;
        }
    }
}";

