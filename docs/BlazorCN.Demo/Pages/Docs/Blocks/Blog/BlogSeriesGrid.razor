@* ===========================================================
   Block: blog-series-grid
   Title: Blog Series Grid
   Description: Overview grid of multiple article series with post counts, completion progress, and latest entries
   Long Description: Browse all active article series at a glance. Each card shows series progress, total parts, and the latest published entry to help readers pick up where they left off.
   Dependencies: ProgressCn
   Source: original/blocks/blog/blog-series-grid.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Article Series</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_series.Count active series</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3">
            @for (var i = 0; i < _series.Count; i++)
            {
                var s = _series[i];
                var pct = (int)Math.Round((double)s.CompletedParts / s.Parts * 100);
                <div class="@($"cursor-pointer px-6 py-5 transition-colors hover:bg-muted/50{(i < _series.Count - 1 ? " border-b sm:border-b-0 sm:border-r" : "")}")">
                    <span class="text-sm font-medium">@s.Title</span>
                    <p class="mt-1 text-xs text-muted-foreground">@s.Parts parts</p>
                    <div class="mt-3 flex items-center gap-2">
                        <ProgressCn Class="h-1 flex-1" Value="@pct" aria-label="Progress" />
                        <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                            @(pct)%
                        </span>
                    </div>
                    <p class="mt-3 truncate text-xs text-muted-foreground">
                        Latest: @s.LatestPost
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SeriesInfo(string Title, int Parts, int CompletedParts, string LatestPost);

    private readonly List<SeriesInfo> _series =
    [
        new("Full-Stack React", 8, 5, "API Integration & Data Fetching"),
        new("TypeScript Patterns", 6, 6, "Advanced Generics & Inference"),
        new("Testing Strategies", 5, 2, "Unit Testing React Components"),
    ];
}
