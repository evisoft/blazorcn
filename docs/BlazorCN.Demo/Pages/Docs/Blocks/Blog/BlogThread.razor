@* ===========================================================
   Block: blog-thread
   Title: Blog Thread
   Description: A Twitter/X-style thread of connected posts with numbered entries, author info, and vertical connecting lines
   Long Description: Break down complex ideas into bite-sized, connected posts. The thread format makes long-form content feel approachable and encourages readers to follow the narrative step by step.
   Dependencies: AvatarCn
   Source: original/blocks/blog/blog-thread.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Thread</h2>
            <p class="mt-1 text-sm text-muted-foreground">Microservices migration lessons</p>
        </div>
        <div class="px-6 py-4">
            @for (var i = 0; i < _thread.Count; i++)
            {
                var post = _thread[i];
                <div class="flex gap-3">
                    <div class="flex flex-col items-center">
                        <AvatarCn Class="h-8 w-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@_authorInitials</AvatarFallbackCn>
                        </AvatarCn>
                        @if (i < _thread.Count - 1)
                        {
                            <div class="my-1 w-px flex-1 bg-border"></div>
                        }
                    </div>
                    <div class="@($"min-w-0 flex-1{(i < _thread.Count - 1 ? " pb-4" : "")}")">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@_authorName</span>
                            <span class="text-xs text-muted-foreground">@_authorHandle</span>
                            <span class="text-xs text-muted-foreground">
                                @post.Index/@_thread.Count
                            </span>
                        </div>
                        <p class="mt-1 text-sm text-muted-foreground">@post.Text</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const string _authorInitials = "SC";
    private const string _authorName = "Sarah Chen";
    private const string _authorHandle = "@@sarahchen";

    private record ThreadPost(int Index, string Text);

    private readonly List<ThreadPost> _thread =
    [
        new(1, "I spent the last 6 months migrating our monolith to microservices. Here's what I wish someone had told me before we started."),
        new(2, "Start with a strangler fig pattern. Don't rewrite \u2014 extract. Pick the least-coupled domain first and route traffic gradually. We chose billing and had zero downtime during the switch."),
        new(3, "The hardest part isn't the code \u2014 it's the data. Shared databases between services will haunt you. Invest in event-driven synchronization early, even if it feels like overkill."),
        new(4, "In hindsight, we should have started with better observability, not more services. Distributed tracing and structured logging would have saved us weeks of debugging. Ship the tooling before the architecture."),
    ];
}
