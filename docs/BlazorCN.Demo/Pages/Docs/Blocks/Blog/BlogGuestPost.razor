@* ===========================================================
   Block: blog-guest-post
   Title: Blog Guest Post
   Description: Guest author post format with prominent attribution badge, author bio section, and post excerpt
   Long Description: Showcase guest contributions with dedicated author attribution, a bio section, and clear visual distinction from regular posts.
   Dependencies: AvatarCn, BadgeCn
   Source: original/blocks/blog/blog-guest-post.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <h2 class="font-semibold text-xl tracking-tight">Guest Post</h2>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    Guest Author
                </BadgeCn>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">by @_guestName</p>
        </div>

        <div class="border-b bg-muted/50 px-6 py-4">
            <div class="flex items-center gap-3">
                <AvatarCn Class="h-8 w-8">
                    <AvatarFallbackCn Class="text-xs">@_guestInitials</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0">
                    <p class="text-sm font-medium">@_guestName</p>
                    <p class="text-xs text-muted-foreground">@_guestRole</p>
                </div>
            </div>
        </div>

        <div class="border-b px-6 py-4">
            <h3 class="text-sm font-medium">@_postTitle</h3>
            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">@_postExcerpt</p>
            <div class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
                <span>@_postDate</span>
                <span aria-hidden="true">&middot;</span>
                <span>@_postReadTime</span>
            </div>
        </div>

        <div class="px-6 py-4">
            <p class="text-xs font-medium text-muted-foreground">About the Guest Author</p>
            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">@_guestBio</p>
        </div>
    </div>
</section>

@code {
    private const string _postTitle = "Building Resilient APIs with Circuit Breakers";
    private const string _postExcerpt = "Circuit breakers prevent cascading failures in distributed systems by detecting downstream outages and failing fast. This guide covers implementation patterns, threshold tuning, and monitoring strategies for production Node.js services.";
    private const string _postReadTime = "9 min read";
    private const string _postDate = "March 8, 2026";
    private const string _guestName = "Priya Sharma";
    private const string _guestRole = "Senior Platform Engineer at Dataflow";
    private const string _guestBio = "Priya has spent 8 years building distributed systems at scale. She writes about reliability patterns, observability, and the operational side of backend engineering.";
    private const string _guestInitials = "PS";
}
