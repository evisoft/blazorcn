@* ===========================================================
   Block: blog-daily-digest
   Title: Blog Daily Digest
   Description: Email-style daily digest preview with post summaries, browser link, and unsubscribe footer
   Long Description: Preview your daily digest email with curated post summaries, a browser link, and standard email footer. Ideal for newsletter previews and subscriber onboarding.
   Dependencies: LucideExternalLinkCn, LucideMailCn
   Source: original/blocks/blog/blog-daily-digest.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideMailCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">Daily Digest</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">@DigestDate</p>
        </div>

        <div class="border-b px-6 py-3">
            <button
                class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
                type="button">
                <LucideExternalLinkCn Size="12" Class="h-3 w-3" />
                View in browser
            </button>
        </div>

        @for (var i = 0; i < _posts.Length; i++)
        {
            var post = _posts[i];
            <div class="@Cn.Merge("px-6 py-4 transition-colors hover:bg-muted/50", i < _posts.Length - 1 ? "border-b" : "")">
                <h3 class="text-sm font-medium">@post.Title</h3>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@post.Excerpt</p>
            </div>
        }

        <div class="border-t bg-muted/30 px-6 py-3">
            <p class="text-center text-xs text-muted-foreground">
                You received this because you subscribed to the daily digest.
                <button
                    class="underline underline-offset-2 transition-colors hover:text-foreground"
                    type="button">
                    Unsubscribe
                </button>
            </p>
        </div>
    </div>
</section>

@code {
    private const string DigestDate = "Monday, March 10, 2026";

    private record DigestPost(string Title, string Excerpt);

    private static readonly DigestPost[] _posts =
    [
        new("Understanding the New CSS Anchor Positioning API",
            "A practical walkthrough of anchor positioning and how it replaces JavaScript tooltip libraries."),
        new("PostgreSQL 17: Performance Improvements That Matter",
            "Benchmarking the query planner changes and what they mean for large-scale applications."),
        new("Why We Switched from REST to tRPC",
            "Lessons learned migrating a 200-endpoint API to end-to-end type safety."),
    ];
}
