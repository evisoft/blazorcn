@* ===========================================================
   Block: blog-filter-chips
   Title: Blog Filter Chips
   Description: Post list with category filter chips for toggling between topics
   Long Description: Filter blog posts by category with clickable chips. Supports multi-select filtering with clear all.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/blog/blog-filter-chips.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Articles</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Filter by topic to find what interests you.
            </p>
        </div>

        <div class="border-b px-6 py-3">
            <div class="flex flex-wrap items-center gap-2">
                @foreach (var cat in _categories)
                {
                    var catCopy = cat;
                    <BadgeCn Class="cursor-pointer select-none"
                             Variant="@(_selected.Contains(cat) ? BadgeVariant.Default : BadgeVariant.Outline)"
                             @onclick="() => Toggle(catCopy)">
                        @cat
                    </BadgeCn>
                }
                @if (_selected.Count > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                              OnClick="() => _selected.Clear()">
                        <LucideIconCn Name="x" Size="12" Class="h-3 w-3" />
                        Clear
                    </ButtonCn>
                }
            </div>
        </div>

        <div>
            @{
                var filtered = _selected.Count == 0 ? _posts : _posts.Where(p => _selected.Contains(p.Category)).ToList();
            }
            @if (filtered.Count == 0)
            {
                <div class="px-6 py-10 text-center text-sm text-muted-foreground">
                    No posts match the selected filters.
                </div>
            }
            else
            {
                @for (var i = 0; i < filtered.Count; i++)
                {
                    var post = filtered[i];
                    <div class="@($"flex items-start justify-between gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < filtered.Count - 1 ? " border-b" : "")}")">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@post.Title</span>
                            </div>
                            <p class="mt-1 line-clamp-1 text-xs text-muted-foreground">@post.Excerpt</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @post.Category
                            </BadgeCn>
                            <span class="hidden text-xs text-muted-foreground sm:inline">
                                @post.ReadTime
                            </span>
                            <span class="text-xs text-muted-foreground">@post.Date</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record FilterPost(int Id, string Title, string Excerpt, string Category, string Date, string ReadTime);

    private readonly string[] _categories = ["Engineering", "Design", "Product", "Culture"];
    private readonly List<string> _selected = [];

    private readonly List<FilterPost> _posts =
    [
        new(1, "Building Type-Safe APIs with tRPC and Zod",
            "How we migrated our REST endpoints to tRPC and eliminated an entire class of runtime errors.",
            "Engineering", "Mar 8, 2026", "7 min"),
        new(2, "Our Approach to Design Tokens",
            "A practical guide to implementing design tokens that scale across platforms and themes.",
            "Design", "Mar 4, 2026", "5 min"),
        new(3, "Shipping Faster with Feature Flags",
            "How feature flags changed our deployment cadence from weekly releases to continuous delivery.",
            "Product", "Feb 28, 2026", "6 min"),
        new(4, "Remote Work Rituals That Actually Work",
            "The async-first practices our distributed team relies on to stay aligned and productive.",
            "Culture", "Feb 22, 2026", "4 min"),
    ];

    private void Toggle(string category)
    {
        if (!_selected.Remove(category))
            _selected.Add(category);
    }
}
