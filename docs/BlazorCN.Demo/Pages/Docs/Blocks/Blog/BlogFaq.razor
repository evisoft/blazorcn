@* ===========================================================
   Block: blog-faq
   Title: Blog Faq
   Description: Expandable frequently asked questions section with chevron indicators for common blog reader inquiries
   Long Description: Answer common reader questions with an expandable FAQ block. Reduce support requests and improve reader experience by surfacing answers inline.
   Dependencies: None
   Source: original/blocks/blog/blog-faq.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Frequently Asked Questions</h2>
            <p class="mt-1 text-sm text-muted-foreground">Common questions about the blog</p>
        </div>
        <div>
            @for (var i = 0; i < _faqs.Count; i++)
            {
                var faq = _faqs[i];
                var isExpanded = _expanded == faq.Id;
                var faqId = faq.Id;
                <div class="@(i < _faqs.Count - 1 ? "border-b" : "")">
                    <button type="button"
                            @onclick="() => _expanded = _expanded == faqId ? null : faqId"
                            class="flex w-full items-center gap-3 px-6 py-3.5 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16"
                                      Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                        <span class="text-sm font-medium">@faq.Question</span>
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-6 pb-4 pl-[3.25rem]">
                            <p class="text-sm text-muted-foreground leading-relaxed">@faq.Answer</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private string? _expanded;

    private readonly List<FaqItem> _faqs =
    [
        new("1", "How often do you publish new articles?",
            "We publish 2-3 articles per week, typically on Tuesdays and Thursdays. Longer deep-dive posts go out on weekends. Subscribe to the newsletter to get notified."),
        new("2", "Can I contribute a guest post?",
            "Yes. We accept guest submissions on topics related to React, TypeScript, and frontend tooling. Send a brief outline to our editorial team and we will review it within 5 business days."),
        new("3", "Are code examples tested and production-ready?",
            "All code snippets are tested against the latest stable versions of their dependencies. We include version numbers and link to runnable sandboxes where possible."),
        new("4", "How do I report an error in an article?",
            "Use the feedback button at the bottom of each post or open an issue on our GitHub repository. We review corrections within 48 hours and credit contributors."),
    ];
}
