@* ===========================================================
   Block: blog-glossary
   Title: Blog Glossary
   Description: Alphabetical glossary of technical terms with definitions and category badges, grouped by first letter with dividers
   Long Description: Display technical terms in an organized glossary format with category badges and alphabetical groupings.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-glossary.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Glossary</h2>
            <p class="mt-1 text-sm text-muted-foreground">@_terms.Count terms</p>
        </div>
        @{
            var grouped = _terms.GroupBy(t => t.Term[0].ToString().ToUpper()).OrderBy(g => g.Key).ToList();
        }
        @for (var li = 0; li < grouped.Count; li++)
        {
            var group = grouped[li];
            var items = group.ToList();
            <div>
                <div class="border-b bg-muted/30 px-6 py-2">
                    <span class="font-mono text-xs font-medium text-muted-foreground">@group.Key</span>
                </div>
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    var showBorder = i < items.Count - 1 || li < grouped.Count - 1;
                    <div class="@($"px-6 py-4{(showBorder ? " border-b" : "")}")">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Term</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                @item.Category
                            </BadgeCn>
                        </div>
                        <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                            @item.Definition
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record GlossaryTerm(string Term, string Definition, string Category);

    private readonly List<GlossaryTerm> _terms =
    [
        new("API Gateway",
            "A server that acts as a single entry point for a set of microservices, handling request routing, authentication, and rate limiting.",
            "API"),
        new("Auth Token",
            "A digitally signed credential used to verify identity and grant access to protected resources without re-entering credentials.",
            "Security"),
        new("Edge Function",
            "A serverless function that runs at CDN edge locations close to users, reducing latency for dynamic content generation.",
            "Infrastructure"),
        new("Hydration",
            "The process of attaching event listeners and state to server-rendered HTML on the client, making static markup interactive.",
            "Frontend"),
        new("ORM",
            "Object-Relational Mapping translates between database rows and programming language objects, providing type-safe query building.",
            "Database"),
        new("RSC",
            "React Server Components render on the server and stream HTML to the client, reducing bundle size by keeping server-only code off the client.",
            "Frontend"),
    ];
}
