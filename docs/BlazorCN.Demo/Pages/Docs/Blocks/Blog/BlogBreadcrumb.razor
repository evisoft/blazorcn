@* ===========================================================
   Block: blog-breadcrumb
   Title: Blog Breadcrumb
   Description: Blog post view with breadcrumb path navigation, title, excerpt, and metadata
   Long Description: Help readers navigate your blog hierarchy with clear breadcrumb trails. Show the full path from home to category to post, with the article preview below for context.
   Dependencies: BreadcrumbCn, LucideCalendarCn, LucideClockCn
   Source: original/blocks/blog/blog-breadcrumb.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <BreadcrumbCn>
                <BreadcrumbListCn>
                    <BreadcrumbItemCn>
                        <BreadcrumbLinkCn Href="#">Blog</BreadcrumbLinkCn>
                    </BreadcrumbItemCn>
                    <BreadcrumbSeparatorCn />
                    <BreadcrumbItemCn>
                        <BreadcrumbLinkCn Href="#">@PostCategory</BreadcrumbLinkCn>
                    </BreadcrumbItemCn>
                    <BreadcrumbSeparatorCn />
                    <BreadcrumbItemCn>
                        <BreadcrumbPageCn>@PostTitle</BreadcrumbPageCn>
                    </BreadcrumbItemCn>
                </BreadcrumbListCn>
            </BreadcrumbCn>
        </div>
        <div class="px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">@PostTitle</h2>
            <p class="mt-2 text-sm text-muted-foreground">@PostExcerpt</p>
            <div class="mt-4 flex items-center gap-3 text-xs text-muted-foreground">
                <span>@PostAuthor</span>
                <span aria-hidden="true">&middot;</span>
                <span class="flex items-center gap-1">
                    <LucideCalendarCn Size="12" Class="h-3 w-3" />
                    @PostDate
                </span>
                <span aria-hidden="true">&middot;</span>
                <span class="flex items-center gap-1">
                    <LucideClockCn Size="12" Class="h-3 w-3" />
                    @PostReadTime
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private const string PostCategory = "Engineering";
    private const string PostTitle = "How We Reduced Build Times by 60%";
    private const string PostExcerpt = "A deep dive into the tooling changes, caching strategies, and CI pipeline optimizations that cut our average build from 8 minutes to under 3 minutes across all projects.";
    private const string PostAuthor = "Alex Rivera";
    private const string PostDate = "Mar 11";
    private const string PostReadTime = "9 min read";
}
