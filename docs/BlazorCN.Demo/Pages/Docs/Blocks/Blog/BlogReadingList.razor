@* ===========================================================
   Block: blog-reading-list
   Title: Blog Reading List
   Description: Saved articles list with bookmark toggle, author info, and read time indicators
   Long Description: A simple bookmarked articles list with save/unsave toggles, read times, and author attribution.
   Dependencies: ButtonCn
   Source: original/blocks/blog/blog-reading-list.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Reading List</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_articles.Count(a => a.Saved) saved articles
            </p>
        </div>

        @for (var i = 0; i < _articles.Count; i++)
        {
            var article = _articles[i];
            var articleId = article.Id;
            <div class="@($"flex items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _articles.Count - 1 ? " border-b" : "")}")">
                <div class="min-w-0 flex-1">
                    <h3 class="text-sm font-medium truncate">@article.Title</h3>
                    <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                        <span>@article.Author</span>
                        <span aria-hidden="true">&middot;</span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                            @article.ReadTime
                        </span>
                    </div>
                </div>
                <ButtonCn Class="h-8 w-8 shrink-0"
                          OnClick="() => ToggleSaved(articleId)"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost">
                    <LucideIconCn Name="bookmark" Size="16"
                                  Class="@($"h-4 w-4 {(article.Saved ? "fill-foreground text-foreground" : "text-muted-foreground")}")" />
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private class ReadingArticle
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Author { get; set; } = "";
        public string ReadTime { get; set; } = "";
        public bool Saved { get; set; }
    }

    private readonly List<ReadingArticle> _articles =
    [
        new() { Id = 1, Title = "Understanding React Server Components", Author = "Sarah Chen", ReadTime = "12 min", Saved = true },
        new() { Id = 2, Title = "Advanced TypeScript Patterns for Large Codebases", Author = "Alex Morgan", ReadTime = "18 min", Saved = true },
        new() { Id = 3, Title = "CSS Grid Complete Guide for Modern Layouts", Author = "Emily Watson", ReadTime = "14 min", Saved = true },
        new() { Id = 4, Title = "Database Indexing Strategies for PostgreSQL", Author = "David Park", ReadTime = "10 min", Saved = false },
    ];

    private void ToggleSaved(int id)
    {
        var article = _articles.First(a => a.Id == id);
        article.Saved = !article.Saved;
    }
}
