@* ===========================================================
   Block: blog-roadmap
   Title: Blog Roadmap
   Description: Upcoming content pipeline with status indicators for planned, in-progress, and researching articles
   Long Description: Plan your editorial pipeline with a visual content roadmap. Track upcoming articles from research through publication with clear status indicators and target dates.
   Dependencies: None
   Source: original/blocks/blog/blog-roadmap.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">Content Roadmap</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">@_items.Count upcoming articles</p>
        </div>

        @for (var i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            <div class="@($"flex items-start gap-4 px-6 py-4 transition-colors hover:bg-muted/50{(i < _items.Count - 1 ? " border-b" : "")}")">
                <span class="@($"mt-1.5 size-2 shrink-0 rounded-full {GetStatusDot(item.Status)}")"></span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@item.Title</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@item.Description</p>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-1">
                    <span class="text-xs text-muted-foreground">@item.TargetDate</span>
                    <span class="text-xs text-muted-foreground">@item.Status</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record RoadmapItem(string Title, string Description, string TargetDate, string Status);

    private readonly List<RoadmapItem> _items =
    [
        new("Server Components Deep Dive",
            "Patterns for mixing server and client components effectively",
            "Mar 22, 2026", "In Progress"),
        new("Building Design Systems with Tailwind 4",
            "Token-based theming and component architecture",
            "Mar 29, 2026", "Planned"),
        new("Edge Runtime Performance Guide",
            "Benchmarks and optimization strategies for edge deployments",
            "Apr 5, 2026", "Planned"),
        new("WebSocket Patterns in Next.js",
            "Real-time features with scalable connection management",
            "Apr 12, 2026", "Researching"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "In Progress" => "bg-blue-500",
        "Planned" => "bg-amber-500",
        _ => "bg-muted-foreground/40",
    };
}
