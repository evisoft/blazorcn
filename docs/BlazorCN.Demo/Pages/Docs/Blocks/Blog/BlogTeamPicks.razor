@* ===========================================================
   Block: blog-team-picks
   Title: Blog Team Picks
   Description: Team members each share their favorite blog post with a personal quote explaining their pick
   Long Description: Add a personal touch to your blog with curated picks from your team. Each member shares their favorite article and why it resonated, building trust and encouraging readers to explore content they might have missed.
   Dependencies: AvatarCn
   Source: original/blocks/blog/blog-team-picks.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Team Picks</h2>
            <p class="mt-1 text-sm text-muted-foreground">What our team is reading</p>
        </div>
        @for (var i = 0; i < _picks.Count; i++)
        {
            var pick = _picks[i];
            <div class="@($"cursor-pointer px-6 py-4 transition-colors hover:bg-muted/50{(i < _picks.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-center gap-3">
                    <AvatarCn Class="h-8 w-8">
                        <AvatarFallbackCn Class="text-xs">@pick.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <span class="text-sm font-medium">@pick.Name</span>
                        <span class="ml-2 text-xs text-muted-foreground">@pick.Role</span>
                    </div>
                </div>
                <div class="mt-2.5 pl-11">
                    <span class="text-sm font-medium">@pick.PostTitle</span>
                    <p class="mt-1 text-xs italic text-muted-foreground">&ldquo;@pick.Quote&rdquo;</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TeamPick(string Initials, string Name, string Role, string PostTitle, string Quote);

    private readonly List<TeamPick> _picks =
    [
        new("SC", "Sarah Chen", "Engineering Lead",
            "Understanding React Server Components",
            "This finally made RSC click for me. I share it with every new team member."),
        new("JP", "James Park", "Staff Engineer",
            "A Practical Guide to Database Indexing",
            "The performance wins from this one article saved us hours of debugging."),
        new("LM", "Lena Mora", "Design Engineer",
            "Designing Accessible Color Systems",
            "Changed how our team approaches color contrast. A must-read for any designer."),
    ];
}
