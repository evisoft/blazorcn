@* ===========================================================
   Block: blog-archive
   Title: Blog Archive
   Description: Collapsible monthly archive with year headers, post counts, and expandable month groups for navigating older blog content
   Long Description: Navigate your entire blog history with a collapsible archive organized by year and month. Expand any year to browse posts grouped by month.
   Dependencies: LucideChevronRightCn
   Source: original/blocks/blog/blog-archive.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Archive</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse posts by year and month</p>
        </div>
        <div>
            @for (var gi = 0; gi < _archive.Length; gi++)
            {
                var group = _archive[gi];
                var isExpanded = _expanded == group.Year;
                var groupBorderClass = gi < _archive.Length - 1 && !isExpanded ? "border-b" : "";
                <div class="@groupBorderClass">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(group.Year))"
                        class="flex w-full items-center gap-3 px-6 py-3.5 text-left transition-colors hover:bg-muted/50">
                        <LucideChevronRightCn
                            Class="@Cn.Merge(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))"
                            Size="16" />
                        <span class="text-sm font-medium">@group.Year</span>
                        <span class="text-xs text-muted-foreground">@group.Count posts</span>
                    </button>
                    @if (isExpanded)
                    {
                        @for (var mi = 0; mi < group.Months.Length; mi++)
                        {
                            var month = group.Months[mi];
                            var monthBorderClass = mi < group.Months.Length - 1 || gi < _archive.Length - 1 ? "border-b" : "";
                            <div class="@monthBorderClass">
                                <div class="bg-muted/50 px-6 py-2 pl-12">
                                    <span class="text-xs font-medium text-muted-foreground">
                                        @month.Month
                                    </span>
                                </div>
                                @foreach (var post in month.Posts)
                                {
                                    <div class="flex cursor-pointer items-center justify-between gap-4 px-6 py-2.5 pl-12 transition-colors hover:bg-muted/50">
                                        <span class="text-sm text-foreground">@post.Title</span>
                                        <span class="shrink-0 text-xs text-muted-foreground">
                                            @post.Date
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "2025";

    private void ToggleExpanded(string year)
    {
        _expanded = _expanded == year ? null : year;
    }

    private record PostItem(string Title, string Date);
    private record MonthGroup(string Month, PostItem[] Posts);
    private record ArchiveYear(string Year, int Count, MonthGroup[] Months);

    private static readonly ArchiveYear[] _archive =
    [
        new("2025", 4,
        [
            new("February",
            [
                new("Server Components in Production", "Feb 18"),
                new("Migrating from Pages to App Router", "Feb 4"),
            ]),
            new("January",
            [
                new("2024 Year in Review", "Jan 28"),
                new("State of CSS 2025", "Jan 12"),
            ]),
        ]),
        new("2024", 4,
        [
            new("December",
            [
                new("React 19 Release Notes", "Dec 20"),
                new("Building a Design System", "Dec 5"),
            ]),
            new("November",
            [
                new("Edge Runtime Deep Dive", "Nov 14"),
                new("TypeScript 5.4 Overview", "Nov 2"),
            ]),
        ]),
    ];
}
