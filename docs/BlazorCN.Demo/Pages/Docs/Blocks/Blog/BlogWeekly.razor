@* ===========================================================
   Block: blog-weekly
   Title: Blog Weekly
   Description: Weekly digest layout organized by weekday with post titles and category labels for each day
   Long Description: Organize your best content into a weekly digest. Each day gets a row with its post title and category, giving subscribers a calendar-style overview of what was published that week.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-weekly.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Week of March 10, 2025</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                This week&rsquo;s published articles at a glance
            </p>
        </div>

        @for (var i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            <div class="@($"flex items-center gap-4 px-6 py-3 transition-colors hover:bg-muted/50{(i < _items.Count - 1 ? " border-b" : "")}")">
                <span class="w-8 shrink-0 font-mono text-xs text-muted-foreground">@item.Day</span>
                <span class="min-w-0 flex-1 truncate text-sm font-medium">@item.Title</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                    @item.Category
                </BadgeCn>
            </div>
        }
    </div>
</section>

@code {
    private record WeeklyItem(string Day, string Title, string Category);

    private readonly List<WeeklyItem> _items =
    [
        new("Mon", "Migrating from REST to tRPC", "Backend"),
        new("Tue", "Accessible Combobox Patterns", "A11y"),
        new("Wed", "Optimizing Vercel Edge Functions", "Infra"),
        new("Thu", "Design Tokens for Multi-Brand Systems", "Design"),
        new("Fri", "Benchmarking Bun vs Node for CLI Tools", "Tooling"),
    ];
}
