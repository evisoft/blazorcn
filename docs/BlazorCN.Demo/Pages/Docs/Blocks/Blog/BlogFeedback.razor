@* ===========================================================
   Block: blog-feedback
   Title: Blog Feedback
   Description: Reader feedback widget with thumbs up/down voting, vote counts, and recent reader comments with star ratings
   Long Description: Collect reader sentiment on every article with a simple thumbs up/down widget. Pair it with recent feedback to surface what resonates with your audience.
   Dependencies: None
   Source: original/blocks/blog/blog-feedback.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Feedback</h2>
            <p class="mt-1 text-sm text-muted-foreground">Was this article helpful?</p>
        </div>
        <div class="flex items-center gap-4 border-b px-6 py-4">
            <button type="button"
                    @onclick="@(() => _vote = _vote == "up" ? null : "up")"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-colors", _vote == "up" ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                <LucideIconCn Name="thumbs-up" Size="14" Class="size-3.5" />
                @UpCount
            </button>
            <button type="button"
                    @onclick="@(() => _vote = _vote == "down" ? null : "down")"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-colors", _vote == "down" ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                <LucideIconCn Name="thumbs-down" Size="14" Class="size-3.5" />
                @DownCount
            </button>
        </div>
        <div class="px-6 py-3">
            <span class="text-xs font-medium text-muted-foreground">Recent feedback</span>
        </div>
        <div>
            @for (var i = 0; i < _comments.Count; i++)
            {
                var item = _comments[i];
                <div class="@($"flex items-start gap-3 px-6 py-3{(i < _comments.Count - 1 ? " border-b" : "")}")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                        @item.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Author</span>
                            <div class="flex items-center gap-0.5">
                                @for (var s = 0; s < 5; s++)
                                {
                                    <LucideIconCn Name="star" Size="12"
                                                  Class="@Cn.Merge("size-3", s < item.Rating ? "fill-foreground text-foreground" : "text-muted-foreground/30")" />
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">@item.Time</span>
                        </div>
                        <p class="mt-1 text-sm text-muted-foreground leading-relaxed">@item.Comment</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _vote;

    private int UpCount => 42 + (_vote == "up" ? 1 : 0);
    private int DownCount => 3 + (_vote == "down" ? 1 : 0);

    private record FeedbackComment(string Author, string Initials, string Comment, int Rating, string Time);

    private readonly List<FeedbackComment> _comments =
    [
        new("Sarah Chen", "SC",
            "Clear explanations with practical examples. Exactly what I needed for our migration.",
            5, "3 hours ago"),
        new("Marcus Okafor", "MO",
            "Good overview but would benefit from more advanced use cases and edge case handling.",
            4, "Yesterday"),
    ];
}
