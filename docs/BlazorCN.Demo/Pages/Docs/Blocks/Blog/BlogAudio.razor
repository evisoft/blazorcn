@* ===========================================================
   Block: blog-audio
   Title: Blog Audio
   Description: Article list with audio versions, play buttons, and duration badges
   Long Description: Give readers the option to listen instead of read. Each article shows its audio duration and a play button, making your blog accessible during commutes and workouts.
   Dependencies: BadgeCn, ButtonCn, LucideHeadphonesCn, LucidePlayCircleCn
   Source: original/blocks/blog/blog-audio.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Listen to Articles</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                @_articles.Length articles with audio versions
            </p>
        </div>
        <div>
            @for (var i = 0; i < _articles.Length; i++)
            {
                var article = _articles[i];
                <div class="@Cn.Merge("flex items-center gap-4 px-6 py-4 transition-colors hover:bg-muted/50", i < _articles.Length - 1 ? "border-b" : "")">
                    <LucideHeadphonesCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@article.Title</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@article.Author</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                        @article.Duration
                    </BadgeCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs">
                        <LucideCirclePlayCn Size="16" Class="h-4 w-4" />
                        Listen
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ArticleItem(int Id, string Title, string Author, string Duration);

    private static readonly ArticleItem[] _articles =
    [
        new(1, "The Future of Web Standards in 2026", "Rachel Kim", "18 min"),
        new(2, "Debugging Production Issues Under Pressure", "Tom Hartley", "12 min"),
        new(3, "Building Resilient Microservice Architectures", "Priya Sharma", "22 min"),
    ];
}
