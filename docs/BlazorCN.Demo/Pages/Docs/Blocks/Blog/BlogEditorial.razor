@* ===========================================================
   Block: blog-editorial
   Title: Blog Editorial
   Description: Curated posts with editor's notes explaining why each article was selected
   Long Description: Highlight your best content with personalized editor's notes. Each curated pick includes a short explanation of why it was selected, adding editorial voice to your blog.
   Dependencies: None
   Source: original/blocks/blog/blog-editorial.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Editor's Picks</h2>
            <div class="mt-1 flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="user" Size="12" Class="h-3 w-3" />
                <span>Curated by @_curator</span>
            </div>
        </div>

        @for (var i = 0; i < _picks.Count; i++)
        {
            var pick = _picks[i];
            <div class="@($"px-6 py-4 transition-colors hover:bg-muted/50{(i < _picks.Count - 1 ? " border-b" : "")}")">
                <span class="text-sm font-medium">@pick.Title</span>
                <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@pick.Author</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>@pick.Date</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>@pick.ReadTime</span>
                </div>
                <p class="mt-2 rounded-md bg-muted/50 px-3 py-2 text-xs italic text-muted-foreground leading-relaxed">
                    "@pick.Note"
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record EditorPick(string Title, string Author, string Date, string ReadTime, string Note);

    private const string _curator = "Sarah Chen";

    private readonly List<EditorPick> _picks =
    [
        new("Why We Rewrote Our CLI in Rust", "Marcus Johnson", "Mar 12, 2026", "14 min read",
            "A refreshingly honest post-mortem that covers the real trade-offs, not just the wins."),
        new("Designing for Slow Connections", "Emily Watson", "Mar 9, 2026", "9 min read",
            "This changed how I think about loading states and progressive enhancement."),
        new("The Hidden Cost of Over-Abstracting React Components", "David Park", "Mar 5, 2026", "11 min read",
            "Every team should read this before building their next component library."),
    ];
}
