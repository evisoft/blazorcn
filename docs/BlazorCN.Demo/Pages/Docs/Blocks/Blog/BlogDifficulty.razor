@* ===========================================================
   Block: blog-difficulty
   Title: Blog Difficulty
   Description: Blog posts grouped into beginner, intermediate, and advanced difficulty levels with colored indicators
   Long Description: Help readers find content at their level. Posts are grouped by difficulty with colored dot indicators, so beginners can start with the basics and advanced users can skip ahead to deeper material.
   Dependencies: None
   Source: original/blocks/blog/blog-difficulty.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Browse by Difficulty</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Find posts that match your experience level
            </p>
        </div>

        @for (var gi = 0; gi < _groups.Count; gi++)
        {
            var group = _groups[gi];
            <div>
                <div class="@($"flex items-center gap-2 px-6 py-3{(gi > 0 ? " border-t" : "")}")">
                    <span class="@($"size-2 shrink-0 rounded-full {group.Color}")"></span>
                    <span class="text-xs font-medium text-muted-foreground">@group.Level</span>
                </div>
                @for (var pi = 0; pi < group.Posts.Length; pi++)
                {
                    var post = group.Posts[pi];
                    var showBorder = pi < group.Posts.Length - 1 || gi < _groups.Count - 1;
                    <div class="@($"flex items-center gap-4 px-6 py-3 transition-colors hover:bg-muted/50{(showBorder ? " border-b" : "")}")">
                        <span class="min-w-0 flex-1 text-sm font-medium">@post.Title</span>
                        <div class="flex shrink-0 items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="clock" Size="14" Class="h-3.5 w-3.5" />
                            <span>@post.ReadTime</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Post(string Title, string ReadTime);
    private record DifficultyGroup(string Level, string Color, Post[] Posts);

    private readonly List<DifficultyGroup> _groups =
    [
        new("Beginner", "bg-emerald-500",
        [
            new("Getting Started with React Hooks", "5 min"),
            new("Understanding CSS Grid Basics", "7 min"),
        ]),
        new("Intermediate", "bg-amber-500",
        [
            new("Building Custom React Hook Libraries", "12 min"),
            new("Server-Side Rendering Trade-offs", "9 min"),
        ]),
        new("Advanced", "bg-red-500",
        [
            new("Compiler-Driven Optimization in React 19", "18 min"),
            new("Writing a Custom Bundler Plugin", "22 min"),
        ]),
    ];
}
