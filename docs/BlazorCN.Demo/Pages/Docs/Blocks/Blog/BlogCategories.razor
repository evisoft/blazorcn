@* ===========================================================
   Block: blog-categories
   Title: Blog Categories
   Description: Blog category list with icons, names, and post counts in a compact card layout
   Long Description: Browse blog content by category with icons and post counts in a clean list.
   Dependencies: BadgeCn, LucideBookOpenCn, LucideBriefcaseCn, LucideChevronRightCn, LucideCodeCn, LucideMegaphoneCn, LucidePaletteCn, LucideTrendingUpCn
   Source: original/blocks/blog/blog-categories.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Categories</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse articles by topic</p>
        </div>

        @for (var i = 0; i < _categories.Length; i++)
        {
            var category = _categories[i];
            <div class="@Cn.Merge("flex items-center gap-3 px-6 py-3 transition-colors hover:bg-muted/50", i < _categories.Length - 1 ? "border-b" : "")">
                @switch (category.Icon)
                {
                    case "Code":
                        <LucideCodeCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        break;
                    case "Palette":
                        <LucidePaletteCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        break;
                    case "Briefcase":
                        <LucideBriefcaseCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        break;
                    case "Megaphone":
                        <LucideMegaphoneCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        break;
                    case "BookOpen":
                        <LucideBookOpenCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        break;
                    case "TrendingUp":
                        <LucideTrendingUpCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        break;
                }
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@category.Name</span>
                    <p class="truncate text-xs text-muted-foreground">@category.Description</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 tabular-nums">
                    @category.PostCount
                </BadgeCn>
                <LucideChevronRightCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground/60" />
            </div>
        }
    </div>
</section>

@code {
    private record CategoryItem(string Name, string Description, string Icon, int PostCount);

    private static readonly CategoryItem[] _categories =
    [
        new("Technology", "Web development, programming, and software engineering", "Code", 24),
        new("Design", "UI/UX design trends, tutorials, and creative inspiration", "Palette", 18),
        new("Business", "Startup strategies, entrepreneurship, and growth", "Briefcase", 15),
        new("Marketing", "Content marketing, SEO, and digital strategies", "Megaphone", 12),
        new("Education", "Learning resources, tutorials, and skill development", "BookOpen", 20),
        new("Industry News", "Latest trends and updates from the tech industry", "TrendingUp", 16),
    ];
}
