@* ===========================================================
   Block: blog-pinned
   Title: Blog Pinned
   Description: Pinned and sticky posts section with visual indicators separating featured from regular content
   Long Description: Keep important announcements and evergreen content visible at the top of your blog.
   Dependencies: None
   Source: original/blocks/blog/blog-pinned.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Blog</h2>
            <p class="mt-1 text-sm text-muted-foreground">Latest posts and announcements</p>
        </div>

        @foreach (var post in _pinnedPosts)
        {
            <div class="border-b bg-muted/30 px-6 py-4 transition-colors hover:bg-muted/50">
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="pin" Size="12" Class="h-3 w-3" />
                    <span class="font-medium">Pinned</span>
                </div>
                <h3 class="mt-1.5 text-sm font-medium">@post.Title</h3>
                <p class="mt-1 text-xs text-muted-foreground">@post.Excerpt</p>
                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@post.Date</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>@post.ReadTime</span>
                </div>
            </div>
        }

        @for (var i = 0; i < _regularPosts.Count; i++)
        {
            var post = _regularPosts[i];
            <div class="@($"px-6 py-4 transition-colors hover:bg-muted/50{(i < _regularPosts.Count - 1 ? " border-b" : "")}")">
                <h3 class="text-sm font-medium">@post.Title</h3>
                <p class="mt-1 text-xs text-muted-foreground">@post.Excerpt</p>
                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@post.Date</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>@post.ReadTime</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record BlogPostItem(string Title, string Excerpt, string Date, string ReadTime);

    private readonly List<BlogPostItem> _pinnedPosts =
    [
        new("Getting Started with Our API",
            "Everything you need to authenticate, make your first request, and handle responses.",
            "Feb 20, 2026", "8 min"),
        new("2026 Product Roadmap",
            "What we are building this year, our priorities, and how you can influence the direction.",
            "Jan 5, 2026", "6 min"),
    ];

    private readonly List<BlogPostItem> _regularPosts =
    [
        new("Optimizing GraphQL Queries in Production",
            "Practical techniques for reducing query complexity and improving resolver performance.",
            "Mar 10, 2026", "12 min"),
        new("A Practical Guide to Feature Flags",
            "Roll out features safely with percentage-based rollouts and kill switches.",
            "Mar 3, 2026", "9 min"),
    ];
}
