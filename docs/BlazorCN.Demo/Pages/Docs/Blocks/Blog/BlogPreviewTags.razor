@* ===========================================================
   Block: blog-preview-tags
   Title: Blog Preview Tags
   Description: Blog post preview cards with tag badges, titles, excerpts, and author attribution
   Long Description: Post previews with multiple tag badges for topic-based discovery.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-preview-tags.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Latest Posts</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse by topic</p>
        </div>

        @for (var i = 0; i < _posts.Count; i++)
        {
            var post = _posts[i];
            <div class="@($"px-6 py-4 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@post.Author</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>@post.Date</span>
                </div>
                <h3 class="mt-1 text-sm font-medium">@post.Title</h3>
                <p class="mt-1 text-xs text-muted-foreground line-clamp-2">@post.Excerpt</p>
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    @foreach (var tag in post.Tags)
                    {
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                            @tag
                        </BadgeCn>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TaggedPost(string Title, string Excerpt, string Author, string Date, string[] Tags);

    private readonly List<TaggedPost> _posts =
    [
        new("Building Resilient Distributed Systems",
            "Patterns for circuit breakers, retry logic, and graceful degradation in microservice architectures that keep your application running under pressure.",
            "Sarah Chen", "Mar 10, 2026", ["Architecture", "Backend", "Reliability", "DevOps"]),
        new("CSS Container Queries in Production",
            "How container queries change component-level responsive design and practical migration strategies from media queries.",
            "Marcus Lee", "Mar 6, 2026", ["CSS", "Frontend", "Responsive"]),
    ];
}
