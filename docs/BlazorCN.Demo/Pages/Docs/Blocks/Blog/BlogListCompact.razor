@* ===========================================================
   Block: blog-list-compact
   Title: Blog List Compact
   Description: Dense list of posts with title, category, date, and read time in compact rows
   Long Description: A compact, scannable list of blog posts. Each row shows title, category, date, and read time.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-list-compact.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">All Articles</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse our complete archive.</p>
        </div>

        <div>
            @for (var i = 0; i < _posts.Count; i++)
            {
                var post = _posts[i];
                <div class="@($"flex items-center justify-between gap-4 px-6 py-3 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                    <span class="min-w-0 truncate text-sm font-medium">@post.Title</span>
                    <div class="flex shrink-0 items-center gap-3">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            @post.Category
                        </BadgeCn>
                        <span class="hidden text-xs text-muted-foreground sm:inline">
                            @post.ReadTime
                        </span>
                        <span class="text-xs text-muted-foreground">@post.Date</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CompactPost(int Id, string Title, string Category, string Date, string ReadTime);

    private readonly List<CompactPost> _posts =
    [
        new(1, "Zero-Downtime Deployments with Blue-Green Strategy", "Engineering", "Mar 11, 2026", "6 min"),
        new(2, "Why We Switched from REST to GraphQL", "Engineering", "Mar 7, 2026", "9 min"),
        new(3, "Building a Component Library from Scratch", "Design", "Mar 3, 2026", "7 min"),
        new(4, "Quarterly Planning That Actually Works", "Product", "Feb 27, 2026", "5 min"),
    ];
}
