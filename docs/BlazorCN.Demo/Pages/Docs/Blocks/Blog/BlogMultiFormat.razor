@* ===========================================================
   Block: blog-multi-format
   Title: Blog Multi Format
   Description: Mixed content type listing showing articles, videos, podcasts, and infographics with format badges and duration
   Long Description: Display diverse content formats in a single feed. Each post shows its type at a glance.
   Dependencies: BadgeCn
   Source: original/blocks/blog/blog-multi-format.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Latest Content</h2>
            <p class="mt-1 text-sm text-muted-foreground">Articles, videos, podcasts, and more</p>
        </div>

        @for (var i = 0; i < _posts.Count; i++)
        {
            var post = _posts[i];
            <div class="@($"flex items-center gap-4 px-6 py-3.5 transition-colors hover:bg-muted/50{(i < _posts.Count - 1 ? " border-b" : "")}")">
                <LucideIconCn Name="@post.Icon" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@post.Title</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                    @post.Format
                </BadgeCn>
                <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                    @post.Duration
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record FormatPost(int Id, string Title, string Format, string Duration, string Icon);

    private readonly List<FormatPost> _posts =
    [
        new(1, "Building Accessible Design Systems at Scale", "Article", "8 min read", "file-text"),
        new(2, "Live Coding a Dashboard with React Server Components", "Video", "24 min", "video"),
        new(3, "The Future of Web Performance with Core Web Vitals", "Podcast", "38 min", "headphones"),
        new(4, "State of Frontend Frameworks 2026", "Infographic", "3 min read", "bar-chart"),
    ];
}
