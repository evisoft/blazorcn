@* ============================================================
   Block: faq-restaurant
   Title: FaqRestaurant
   Description: A marketing-scale FAQ accordion block for React and Next.js with per-question icon glyphs, single-item expand, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-restaurant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Before you visit
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything to know before you book.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Reservations, dietary options, private dining, hours, and the dress code — answered
                quickly so you can get to the table sooner.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-restaurant-panel-{item.Id}";
                var triggerId = $"faq-restaurant-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground">
                            <LucideIconCn Name="@item.Icon" Size="20" Class="size-5" />
                        </span>
                        <span class="flex-1 text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-20 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-22">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Reserve a table</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">View the menu</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "reservations";

    private record FaqItem(string Id, string Icon, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("reservations",
            "calendar",
            "How do I make a reservation?",
            "Reserve online at any hour or call us at (555) 123-4567 between 10am and 9pm. We recommend booking 2-3 days ahead for weekend service. Same-day walk-ins are welcome based on availability, and reservations are held for 15 minutes past the booking time before the table is released."),
        new("vegetarian",
            "leaf",
            "Do you offer vegetarian and vegan options?",
            "Our menu features a dedicated plant-based section with eight vegetarian and vegan dishes designed by our chef, not adapted as an afterthought. Items are clearly marked (V) and (VG), and our kitchen can modify most other dishes to accommodate dairy-free, gluten-free, or nut-free preferences."),
        new("private",
            "users",
            "Can you accommodate private dining events?",
            "Our private dining room seats up to 40 guests with custom prix-fixe menus starting at $85 per person. Every booking includes a dedicated server, AV equipment, and flexible room layout. Please book at least two weeks in advance for parties of 20 or more so we can plan staffing."),
        new("catering",
            "utensils-crossed",
            "What catering services do you provide?",
            "Full-service catering for corporate events, weddings, and private parties. Menus run $45-$125 per person and include delivery, setup, and serving staff. Minimum 25 guests. We recommend submitting custom proposal requests at least three weeks ahead of your event date."),
        new("hours",
            "clock",
            "What are your hours of operation?",
            "Tuesday through Thursday from 5pm to 10pm, Friday and Saturday from 5pm to 11pm, and Sunday from 4pm to 9pm. We're closed Mondays. The kitchen stops new orders 30 minutes before close. Sunday brunch runs separately from 11am to 3pm with its own seasonal menu."),
        new("dress-code",
            "shield-check",
            "Is there a dress code?",
            "Smart casual is the standard — we ask guests to skip athletic wear, flip-flops, and baseball caps. Jackets are not required for dinner but suggested for special occasions. Private events sometimes set their own dress requirements, which we communicate at booking."),
    ];
}
