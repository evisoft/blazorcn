@* ============================================================
   Block: faq-with-anchor
   Title: FaqWithAnchor
   Description: An anchor-linkable FAQ block for React and Next.js with per-question copy-link buttons, hash-based deep linking, smooth scroll-to-anchor, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-anchor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Linkable answers, every one.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hover any question to copy a direct link. Share specific answers with teammates, support
                agents, or your community in one click.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-anchor-{item.Id}-panel";
                var triggerId = $"faq-anchor-{item.Id}-trigger";
                <div id="@($"faq-anchor-{item.Id}")" class="group/item border-b last:border-0">
                    <div class="flex items-start gap-2 px-6 py-5 sm:px-8 sm:py-6">
                        <button
                            type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen.ToString().ToLower()"
                            aria-controls="@panelId"
                            @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                            class="flex min-w-0 flex-1 items-start justify-between gap-6 text-left">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                        </button>
                        <button
                            type="button"
                            @onclick="@(() => CopyLink(item.Id))"
                            aria-label="@($"Copy link to: {item.Question}")"
                            class="flex size-9 shrink-0 items-center justify-center rounded-md text-muted-foreground opacity-0 transition-all hover:bg-muted hover:text-foreground focus-visible:opacity-100 group-hover/item:opacity-100">
                            @if (_copiedId == item.Id)
                            {
                                <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600" aria-hidden="true" />
                            }
                            else
                            {
                                <LucideIconCn Name="link" Size="16" Class="size-4" aria-hidden="true" />
                            }
                        </button>
                    </div>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }

                    <span aria-live="polite" class="sr-only">
                        @(_copiedId == item.Id ? "Link copied to clipboard" : "")
                    </span>
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Browse all docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = null;
    private string? _copiedId = null;

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("api-authentication",
            "How do I authenticate API requests?",
            "Pass your API key in the Authorization header as a Bearer token. Generate keys from Settings → API Keys. Each key has scoped permissions and can be rotated or revoked at any time without downtime."),
        new("rate-limits",
            "What are the API rate limits?",
            "Pro accounts get 1,000 requests per hour, Enterprise gets 10,000. Every response includes rate-limit headers showing current usage and the reset window. Going over returns a 429 with a retry-after value."),
        new("webhook-setup",
            "How do I set up webhooks?",
            "Open Settings → Webhooks and click Add Endpoint. Pick the events you care about, save your signing secret, and verify deliveries with HMAC-SHA256. Test mode lets you replay events before going live."),
        new("data-export",
            "Can I export all my data?",
            "Yes. Export from Settings → Data Export in JSON, CSV, or SQL. Large exports run in the background and arrive by email. Every export includes records, settings, metadata, and audit logs."),
        new("sso-configuration",
            "How do I configure SSO?",
            "SSO is available on Enterprise plans via SAML 2.0 or OIDC. Provide your IdP metadata URL and configure attribute mappings. Okta, Azure AD, Google Workspace, and OneLogin are all supported out of the box."),
        new("uptime-guarantee",
            "What's your uptime guarantee?",
            "We guarantee 99.9% uptime on paid plans and 99.99% on Enterprise. Real-time status lives at status.example.com. Any month under SLA is automatically credited to your next invoice — no support ticket required."),
        new("gdpr-compliance",
            "Are you GDPR compliant?",
            "Yes. EU data residency, signed DPAs, full data subject access requests, right-to-erasure, and SOC 2 Type II certification. We never sell or share customer data with anyone."),
        new("custom-domain",
            "Can I use a custom domain?",
            "Custom domains are available on Pro and Enterprise. Add your domain in Settings → Domains, point your DNS, and SSL is provisioned automatically via Let's Encrypt within minutes."),
    ];

    private void CopyLink(string id)
    {
        _copiedId = id;
        // Note: clipboard copy requires JS interop; the visual feedback still works
        _ = ResetCopiedAfterDelay();
    }

    private async Task ResetCopiedAfterDelay()
    {
        await Task.Delay(2000);
        _copiedId = null;
        StateHasChanged();
    }
}
