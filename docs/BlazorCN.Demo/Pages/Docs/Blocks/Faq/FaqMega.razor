@* ============================================================
   Block: faq-mega
   Title: FaqMega
   Description: A marketing-scale FAQ mega-menu multi-column block for React and Next.js with category groups across columns, semantic disclosure markup, varied stagger entrance, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-mega.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One menu, every answer.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Browse pricing, features, security, and support questions side by side. Tap any question
                to read the full answer in place.
            </p>
        </div>

        @* Mega menu columns *@
        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var cat in _categories)
            {
                var category = cat;
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                        @category.Label
                    </p>
                    <div class="mt-4 overflow-hidden rounded-2xl border bg-card">
                        @foreach (var itm in category.Items)
                        {
                            var item = itm;
                            var isOpen = _expanded == item.Id;
                            var panelId = $"mega-faq-panel-{item.Id}";
                            var triggerId = $"mega-faq-trigger-{item.Id}";
                            <div class="border-b last:border-0">
                                <button
                                    type="button"
                                    id="@triggerId"
                                    aria-expanded="@isOpen.ToString().ToLower()"
                                    aria-controls="@panelId"
                                    @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                                    class="flex w-full items-start justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-muted/40">
                                    <span class="text-base font-semibold text-foreground">
                                        @item.Question
                                    </span>
                                    <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                                </button>

                                @if (isOpen)
                                {
                                    <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                        <p class="px-5 pb-5 text-base leading-relaxed text-muted-foreground">
                                            @item.Answer
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "individual";

    private record FaqItem(string Id, string Question, string Answer);
    private record FaqCategory(string Id, string Label, FaqItem[] Items);

    private static readonly FaqCategory[] _categories =
    [
        new("pricing", "Pricing",
        [
            new("individual",
                "What's included in the Individual plan?",
                "Individual plan includes one user, unlimited projects, 10GB storage, full API access, and email support — billed monthly or annually with 20% off when you pay yearly."),
            new("team",
                "How does team billing work?",
                "Team plan covers five users with $15/month per additional seat. Billing is consolidated in one invoice with prorated charges for seat changes."),
            new("enterprise",
                "What are Enterprise pricing options?",
                "Enterprise pricing is custom based on user count, support level, and integration needs — with annual contracts and net 30 terms available."),
        ]),
        new("features", "Features",
        [
            new("api",
                "What API features are available?",
                "REST API with 10,000 req/hour rate limit, webhook support, real-time WebSockets, a GraphQL endpoint in beta, and SDKs for JavaScript, Python, and Ruby."),
            new("integrations",
