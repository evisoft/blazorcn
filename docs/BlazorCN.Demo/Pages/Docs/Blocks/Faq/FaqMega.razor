            new("mobile",
                "Are there mobile apps?",
                "Yes — native iOS and Android apps with offline support, push notifications, and biometric authentication. Feature parity with the web app."),
        ]),
        new("security", "Security",
        [
            new("encryption",
                "How is data encrypted?",
                "AES-256 encryption at rest and TLS 1.3 in transit. End-to-end encryption is available on Enterprise. Keys are managed via AWS KMS with automatic rotation."),
            new("compliance",
