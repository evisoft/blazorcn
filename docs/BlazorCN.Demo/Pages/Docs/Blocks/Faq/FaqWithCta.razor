@* ============================================================
   Block: faq-with-cta
   Title: FaqWithCta
   Description: A marketing-scale FAQ accordion block for React and Next.js with contextual inline CTA buttons inside answers, semantic disclosure markup, and a primary ShadcnioButton pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Plans &amp; pricing FAQ
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every answer has a next step.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The questions teams ask before they upgrade — and the exact buttons that take them where
                they need to go next.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-cta-panel-{item.Id}";
                var triggerId = $"faq-cta-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                @if (item.Cta != null)
                                {
                                    var cta = item.Cta;
                                    <a
                                        href="@cta.Href"
                                        aria-label="@cta.Label"
                                        class="mt-5 inline-flex items-center gap-2 rounded-lg border bg-background px-3.5 py-2 text-xs font-semibold text-foreground transition-colors hover:bg-muted/60">
                                        @cta.Label
                                        @if (cta.Icon == "mail")
                                        {
                                            <LucideIconCn Name="mail" Size="14" Class="size-3.5" aria-hidden="true" />
                                        }
                                        else if (cta.Icon == "sparkles")
                                        {
                                            <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" aria-hidden="true" />
                                        }
                                        else if (cta.Icon == "book")
                                        {
                                            <LucideIconCn Name="book-open" Size="14" Class="size-3.5" aria-hidden="true" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" aria-hidden="true" />
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Compare plans</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "team-plan";

    private record FaqCta(string Label, string Href, string Icon);
    private record FaqItem(string Id, string Question, string Answer, FaqCta? Cta = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("team-plan",
            "What is included in the Team plan?",
            "Team includes 5 developer seats, priority support with 12-hour response, shared design tokens, role-based access control, and an audit log. You also get early access to beta features and one custom component request per month from our core team.",
            new FaqCta("Upgrade to Team", "#upgrade", "sparkles")),
        new("org-plan",
            "What does the Organization plan add on top?",
            "Organization layers in unlimited seats, SSO with SAML 2.0 and OIDC, a dedicated Slack channel, a 2-hour SLA for critical issues, quarterly business reviews, and a named account manager who knows your codebase.",
            new FaqCta("Talk to sales", "#sales", "mail")),
        new("api",
            "Do you offer a programmatic API for CI pipelines?",
            "Yes. Team and Organization plans include a REST API for downloading components, querying metadata, and syncing your design system into CI. Rate limits start at 1,000 requests per hour and the API ships with a typed SDK plus webhooks.",
            new FaqCta("Read API docs", "#api", "book")),
        new("migration",
            "Will you help us migrate from another component library?",
            "Our team provides component mapping guides for Material UI, Ant Design, and Chakra UI, plus an architectural review of your current setup. We've migrated teams of 200+ engineers without freezing feature work.",
            new FaqCta("Schedule a call", "#call", "arrow")),
        new("versioning",
            "How do component updates and versioning work?",
            "We follow semver. Major versions ship breaking changes with a migration guide, minors add backwards-compatible features, and patches fix bugs. Because the code lives in your repo, you upgrade on your timeline — no surprise releases."),
        new("license",
            "What are the licensing terms for commercial work?",
            "Your subscription grants commercial rights for unlimited client projects and SaaS apps. You can modify, fork, and ship the components inside revenue-generating products. The only restriction is reselling the source as a competing library."),
    ];
}
