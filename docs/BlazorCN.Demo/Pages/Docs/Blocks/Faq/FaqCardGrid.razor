@* ============================================================
   Block: faq-card-grid
   Title: FaqCardGrid
   Description: A marketing-scale two-column card grid FAQ block for React and Next.js with bordered cards, smooth expand/collapse, accessible disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Marketing headline cluster *@
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Frequently asked questions
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Quick answers, organized by topic.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            Tap any card to read the full answer. Can't find what you're looking for? Our support
            team replies in under an hour.
        </p>
    </div>

    @* Card grid *@
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
        @foreach (var it in _faqItems)
        {
            var item = it;
            var isOpen = _expanded == item.Id;
            var panelId = $"faq-grid-panel-{item.Id}";
            var triggerId = $"faq-grid-trigger-{item.Id}";
            <div class="overflow-hidden rounded-2xl border bg-card">
                <button
                    type="button"
                    id="@triggerId"
                    aria-expanded="@isOpen.ToString().ToLowerInvariant()"
                    aria-controls="@panelId"
                    @onclick="@(() => Toggle(item.Id))"
                    class="flex w-full items-start justify-between gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40">
                    <span class="text-base font-semibold leading-snug text-foreground sm:text-lg">
                        @item.Question
                    </span>
                    <LucideIconCn Name="chevron-down" Size="20"
                        Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")"
                        aria-hidden="true" />
                </button>

                @if (isOpen)
                {
                    <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                        <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground">
                            @item.Answer
                        </p>
                    </div>
                }
            </div>
        }
    </div>

    @* CTAs *@
    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private string? _expanded = "payment";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static readonly FaqItem[] _faqItems =
    [
        new("payment",
            "What payment methods do you accept?",
            "Every major credit card (Visa, Mastercard, Amex, Discover) plus PayPal. Payments run through Stripe with PCI DSS compliance. Enterprise plans support invoicing and wire transfers with NET 30 terms."),
        new("plan-changes",
            "Can I upgrade or downgrade my plan?",
            "Change plans anytime from your account settings. Upgrades apply immediately with prorated billing. Downgrades take effect at the end of your current billing period so you keep the value of your current plan."),
        new("trial",
            "Is there a free trial available?",
            "We don't offer traditional trials but ship 1,100+ free components you can use to evaluate quality. Pro subscribers get a 14-day money-back guarantee, so you can try premium features risk-free."),
        new("education",
            "Do you offer educational discounts?",
            "Yes. Students and educators get 50% off all individual plans with a valid .edu email address. Verify your status during checkout and the discount applies automatically."),
        new("team-billing",
            "How does team billing work?",
            "Team plans include 5 seats with shared workspace access, billed as a single subscription. Add or remove members anytime and billing adjusts automatically for mid-cycle changes. Each member gets their own Pro account."),
        new("privacy",
            "What is your data privacy policy?",
            "We're GDPR and CCPA compliant. We never sell your data, analytics are anonymized and aggregated, and you can request export or deletion anytime. The full privacy policy is in our legal documentation."),
        new("open-source",
            "Can I use components in open source?",
            "Yes. You can use our components in open source projects under the MIT license. Attribution is appreciated but not required. The only restriction is redistribution as a competing component library."),
        new("migration",
            "Do you provide migration assistance?",
            "Pro subscribers get priority support including migration guidance. We ship codemods for common patterns and detailed migration guides. Enterprise customers get hands-on migration consulting from our team."),
    ];
}
