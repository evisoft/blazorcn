@* ============================================================
   Block: faq-with-related
   Title: FaqWithRelated
   Description: A marketing-scale FAQ block for React and Next.js with related question links inside each answer, smooth jump-to-question navigation, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-related.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One answer leads to the next.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer ends with two or three related questions you might need next. Tap one and
                we'll jump straight to it - no scrolling, no searching.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-related-panel-{item.Id}";
                var triggerId = $"faq-related-trigger-{item.Id}";
                <div data-faq-id="@item.Id" class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>

                                @* Related questions *@
                                <div class="mt-6 rounded-xl border bg-muted/30 px-4 py-4">
                                    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                                        Related questions
                                    </p>
                                    <ul class="mt-3 flex flex-col gap-1">
                                        @foreach (var relId in item.RelatedIds)
                                        {
                                            var relatedId = relId;
                                            var related = System.Array.Find(_faqItems, q => q.Id == relatedId);
                                            if (related != null)
                                            {
                                                <li>
                                                    <button
                                                        type="button"
                                                        @onclick="@(() => HandleRelatedClick(relatedId))"
                                                        class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm text-foreground transition-colors hover:bg-muted/60">
                                                        <LucideIconCn Name="corner-down-right" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                        <span class="line-clamp-1">@related.Question</span>
                                                    </button>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Browse guides</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "setup-account";

    private record FaqItem(string Id, string Question, string Answer, string[] RelatedIds);

    private static readonly FaqItem[] _faqItems =
    [
        new("setup-account",
            "How do I set up my account from scratch?",
            "Click Sign Up, enter your email, and choose a password with at least 12 characters including numbers and symbols. Verify your email by clicking the link we send, then complete your profile with name, company, and timezone. Enable two-factor authentication in Settings > Security for extra protection.",
            ["reset-password", "sso-setup", "invite-team"]),
        new("reset-password",
            "How do I reset a forgotten password?",
            "Click Forgot Password on the login page and enter your email. You'll receive a reset link valid for one hour. Choose a new password meeting the security requirements. If the email doesn't arrive within five minutes, check spam or contact support. Every reset is logged for auditing.",
            ["setup-account", "enable-2fa", "login-issues"]),
        new("enable-2fa",
            "How do I enable two-factor authentication?",
            "Go to Settings > Security and click Enable 2FA. Scan the QR code with Google Authenticator, Authy, or 1Password and enter the six-digit code to verify. Save your backup codes somewhere secure - you'll need them if you lose your authenticator. 2FA is required for admins on Enterprise plans.",
            ["reset-password", "backup-codes", "login-issues"]),
        new("invite-team",
            "How do I invite my team members in bulk?",
            "Navigate to Settings > Team and click Invite Member. Paste comma-separated email addresses for bulk invites and assign Admin, Member, or Viewer roles plus the projects each can access. Invitations expire after seven days and you can track pending invites from the same screen.",
            ["setup-account", "manage-permissions", "remove-member"]),
        new("manage-permissions",
            "How do I manage team permissions and roles?",
            "Open Settings > Team, click the menu next to any member, and adjust their role. Admins manage team and settings, Members create and edit content, Viewers have read-only access. Custom roles are available on Enterprise plans. Permission changes take effect immediately and appear in the audit trail.",
            ["invite-team", "remove-member", "sso-setup"]),
        new("remove-member",
            "How do I remove a team member without losing their work?",
            "Settings > Team, find the member, and click Remove. Their access is revoked immediately and they receive a notification email. Content they created stays in the workspace with ownership transferred to your account. Removed members can be re-invited later without losing their data.",
            ["invite-team", "manage-permissions", "transfer-ownership"]),
        new("sso-setup",
            "How do I configure Single Sign-On for my organization?",
            "SSO is available on Enterprise plans. Go to Settings > Authentication > SSO and choose Okta, Azure AD, or Google Workspace. Upload your SAML metadata XML or configure OAuth client credentials and test with a designated user before enabling for everyone. We support JIT provisioning and SCIM.",
            ["setup-account", "manage-permissions", "enable-2fa"]),
        new("backup-codes",
            "Where do I find my 2FA backup codes?",
            "Backup codes appeared the first time you enabled 2FA. If you didn't save them, go to Settings > Security > Two-Factor Authentication and click Regenerate Backup Codes. This invalidates the old codes. Each new code can be used once - keep them in a password manager or printed in a safe place.",
            ["enable-2fa", "login-issues", "reset-password"]),
        new("login-issues",
            "Why can't I log in even with the right password?",
            "Common causes are an account locked after failed attempts, an expired session, or a browser blocking cookies. Try resetting your password first. If you're using 2FA, make sure your authenticator app's clock is synced. Check the status page for service issues, then contact support if the problem persists.",
            ["reset-password", "enable-2fa", "backup-codes"]),
        new("transfer-ownership",
            "Can I transfer workspace ownership to someone else?",
            "Yes. Owners can transfer ownership to any Admin from Settings > General > Transfer Ownership. Confirm with your password and the new owner inherits billing and admin responsibilities. Previous owners become Admins unless removed. Transfers are immediate and irreversible.",
            ["remove-member", "manage-permissions", "invite-team"]),
    ];

    private void HandleRelatedClick(string id)
    {
        _expanded = id;
    }
}
