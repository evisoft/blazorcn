@* ============================================================
   Block: faq-nonprofit
   Title: FaqNonprofit
   Description: A marketing FAQ accordion block for React and Next.js with category labels, inline trust badges, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-nonprofit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Transparent answers, by category.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Donations, volunteering, impact, and financials — every answer is sourced from our
                audited annual reports. EIN 12-3456789.
            </p>
        </div>

        @* Trust badges *@
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
            @foreach (var badge in _trustBadges)
            {
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-card px-3 py-1.5 text-xs font-medium text-foreground">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                    @badge.Label
                </span>
            }
        </div>

        @* Accordion *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-np-panel-{item.Id}";
                var triggerId = $"faq-np-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                    @item.Category
                                </span>
                                @if (item.Badge != null)
                                {
                                    <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-700 dark:text-emerald-400">
                                        @item.Badge
                                    </span>
                                }
                            </div>
                            <span class="mt-2 block text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Donate now</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">View annual report</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "donate";

    private record TrustBadge(string Id, string Label);

    private record FaqItem(string Id, string Category, string Question, string Answer, string? Badge = null);

    private static readonly TrustBadge[] _trustBadges =
    [
        new("verified", "501(c)(3) verified"),
        new("guidestar", "GuideStar Platinum"),
        new("programs", "88% to programs"),
        new("audited", "Independently audited"),
    ];

    private static readonly FaqItem[] _faqItems =
    [
        new("donate", "Donations", "How do I make a donation?",
            "Donate securely online via card, PayPal, bank transfer, donor-advised funds, stock, or cryptocurrency. One-time gifts start at $10 and monthly recurring at $5. 100% of online donations go to programs — we cover processing fees ourselves so your full gift reaches the people we serve.",
            "Tax deductible"),
        new("tax", "Donations", "Is my donation tax deductible?",
            "Yes. We're a registered 501(c)(3) nonprofit (EIN: 12-3456789) and every gift is tax deductible to the full extent allowed by law. You'll receive an email receipt within 24 hours, and gifts of $250 or more receive a formal acknowledgment letter for your records.",
            "501(c)(3)"),
        new("where-money-goes", "Transparency", "Where does my money actually go?",
            "88% goes directly to programs and services, 8% covers administrative costs, and 4% supports fundraising. We publish detailed annual reports with audited financials, program outcomes, and impact metrics. Independent CPAs audit us every year and the reports live on our transparency page."),
        new("volunteer", "Volunteering", "How can I volunteer?",
            "We offer virtual and in-person opportunities: event support, mentoring, administrative help, and pro-bono skilled work in legal, marketing, and IT. Most positions ask for 2-4 hours a week, and we provide training and ongoing support so first-time volunteers feel welcome."),
        new("volunteer-requirements", "Volunteering", "What are the volunteer requirements?",
            "Minimum age 16 for most roles, 18+ for positions involving children or vulnerable adults. Background check and a 2-hour online orientation are required. Time commitment varies from one-time events to ongoing weekly roles, and international volunteers are welcome for virtual work."),
        new("impact", "Transparency", "How do you measure impact?",
            "We track outcome metrics tied to our mission: 15,000 people served annually, 85% client satisfaction, and 92% program completion. Annual impact reports include beneficiary stories, demographic data, longitudinal outcomes, and third-party evaluations published every quarter."),
        new("financials", "Transparency", "How can I view your financial reports?",
            "Annual reports, IRS Form 990, and audited financial statements are on our website and on GuideStar. Reports break down revenue, expenses, executive compensation, and program outcomes. Subscribe to the transparency newsletter for governance and finance updates throughout the year."),
        new("corporate", "Corporate", "Do you offer corporate partnerships?",
            "Yes — sponsorships, employee giving programs, volunteer days, and cause marketing campaigns. Partnership tiers run from $5,000 to $100,000+ with customizable benefits and CSR reporting support. Contact our development team for proposals and impact measurement frameworks."),
    ];
}
