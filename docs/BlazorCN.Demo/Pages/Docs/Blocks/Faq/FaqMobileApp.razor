@* ============================================================
   Block: faq-mobile-app
   Title: FaqMobileApp
   Description: A marketing-scale FAQ mobile-app download block for React and Next.js with single-expand accordion, platform tags, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-mobile-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Mobile app
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Take it with you, everywhere.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Everything you need to know before downloading — supported devices, offline behavior,
                sync, storage, and battery life. 4.8★ average from 50,000+ reviews.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"mobile-app-faq-panel-{item.Id}";
                var triggerId = $"mobile-app-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            @if (item.Platforms != null && item.Platforms.Length > 0)
                            {
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                    @foreach (var platform in item.Platforms)
                                    {
                                        <span class="rounded-full border bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                                            @platform
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Download for iOS</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">Download for Android</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "download";

    private record FaqItem(string Id, string Question, string Answer, string[]? Platforms = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("download",
            "How do I download the mobile app?",
            "Download our app for free from the Apple App Store (iOS 15 or later) or Google Play Store (Android 10 or later). The app requires 150MB initial download and roughly 300MB after installation. First-time setup takes 2 to 3 minutes including account creation. iOS users can also join via TestFlight for beta versions.",
            ["iOS 15+", "Android 10+"]),
        new("devices",
            "Which devices and operating systems are supported?",
            "iOS: iPhone 7 and newer running iOS 15 or later, plus iPad Air 2 and newer. Android: devices running Android 10 or higher with at least 2GB of RAM. The app is optimized for phones but adapts gracefully to tablets. We test against the top 50 devices representing 95% of users.",
            ["iPhone", "iPad", "Android"]),
        new("offline",
            "Does the app work offline?",
            "Yes — core features work offline including viewing cached content, creating drafts, and accessing saved items. The app automatically syncs changes when you reconnect. Offline storage is configurable up to 500MB, and a banner shows your pending sync count whenever you're disconnected."),
        new("notifications",
            "How do push notifications work?",
            "Push notifications cover messages, activity, and important updates. Customize categories in Settings > Notifications. Quiet hours silence non-urgent alerts between 10pm and 8am by default. Notifications work via Firebase Cloud Messaging on Android and APNs on iOS."),
        new("storage",
            "How much storage space does the app require?",
            "Initial download is 150MB, growing to 200–300MB after installation. With normal usage you can expect 500MB to 1GB over time. The cache manager in Settings > Storage shows a breakdown by category, and you can clear cache anytime without losing account data.",
            ["~300MB initial", "Up to 1GB"]),
        new("updates",
            "How do app updates work?",
            "The app updates automatically via the App Store or Google Play every 2 to 3 weeks. Critical security updates may prompt an immediate restart. Beta users can join TestFlight on iOS or our open beta on Android. Release notes live in Settings > About > Version History."),
        new("sync",
            "Does data sync between mobile and web?",
            "Yes — every change syncs in real time across mobile, tablet, and web, typically within 2 seconds. Conflicts from simultaneous edits are resolved using last-write-wins or prompted for manual review. Sync history is available in Settings > Account > Sync Activity."),
        new("battery",
            "Does the app drain battery quickly?",
            "The app is optimized for battery efficiency using background sync throttling and smart notification batching. Typical usage of 30 minutes a day consumes 2 to 4% battery. iOS Low Power Mode and Android Battery Saver are fully supported and pause non-essential sync activity."),
    ];
}
