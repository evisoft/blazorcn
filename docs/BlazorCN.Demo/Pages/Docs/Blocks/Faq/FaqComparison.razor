@* ============================================================
   Block: faq-comparison
   Title: FaqComparison
   Description: A plan-comparison FAQ block for React and Next.js with tier badges, feature availability rows, expandable answers, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Plan comparison
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Which plan is right for you?
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The honest answers about what's included on Free, Pro, and Enterprise — so you can pick
                the right plan the first time.
            </p>
        </div>

        @* Comparison list *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-compare-panel-{item.Id}";
                var triggerId = $"faq-compare-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="flex min-w-0 flex-col gap-3">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <span class="flex flex-wrap gap-1.5">
                                @foreach (var planId in item.AvailableIn)
                                {
                                    var plan = System.Array.Find(_plans, p => p.Id == planId);
                                    if (plan != null)
                                    {
                                        <span class="@($"inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold {plan.BadgeClass}")">
                                            @plan.Label
                                        </span>
                                    }
                                }
                            </span>
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>

                                @if (item.Details != null && item.Details.Length > 0)
                                {
                                    <div class="mt-5 space-y-2">
                                        @foreach (var det in item.Details)
                                        {
                                            var detail = det;
                                            var detailPlan = System.Array.Find(_plans, p => p.Id == detail.Plan);
                                            if (detailPlan != null)
                                            {
                                                <div class="flex items-start gap-3 rounded-xl border bg-muted/40 p-4">
                                                    <div class="@($"flex size-7 shrink-0 items-center justify-center rounded-full {(detail.Available ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-muted text-muted-foreground")}")">
                                                        @if (detail.Available)
                                                        {
                                                            <LucideIconCn Name="check" Size="16" Class="size-4" aria-hidden="true" />
                                                        }
                                                        else
                                                        {
                                                            <LucideIconCn Name="x" Size="16" Class="size-4" aria-hidden="true" />
                                                        }
                                                    </div>
                                                    <div class="min-w-0 flex-1">
                                                        <p class="text-sm font-semibold text-foreground">
                                                            @detailPlan.Label
                                                        </p>
                                                        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                                            @detail.Description
                                                        </p>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Compare all plans</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Talk to sales</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "free-vs-pro";

    private record Plan(string Id, string Label, string BadgeClass);

    private record DetailItem(string Plan, string Description, bool Available);

    private record FaqItem(string Id, string Question, string Answer, string[] AvailableIn, DetailItem[]? Details = null);

    private static readonly Plan[] _plans =
    [
        new("free", "Free", "border bg-muted text-muted-foreground"),
        new("pro", "Pro", "border border-blue-500/30 bg-blue-500/10 text-blue-700 dark:text-blue-300"),
        new("enterprise", "Enterprise", "border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300"),
    ];

    private static readonly FaqItem[] _faqItems =
    [
        new("free-vs-pro",
            "What is the difference between Free and Pro plans?",
            "Free is built for individuals and weekend projects shipping their first app. Pro unlocks unlimited projects, automation workflows, priority support, and full API access for teams shipping in production.",
            ["free", "pro"],
            [
                new("free", "5 projects, 5 teammates, 5GB storage, community support, basic integrations", true),
                new("pro", "Unlimited projects, unlimited teammates, 100GB per user, priority support, API access, advanced automation", true),
            ]),
        new("custom-domains",
            "Can I use custom domains on every plan?",
            "Custom domains live on Pro and Enterprise plans only. Free plans use our default subdomain format (yourname.example.com). Custom domains include managed SSL certificates and DNS configuration help.",
            ["pro", "enterprise"],
            [
                new("free", "Default subdomain only", false),
                new("pro", "Up to 3 custom domains with managed SSL", true),
                new("enterprise", "Unlimited custom domains with SSL, CDN, and edge routing", true),
            ]),
        new("support-channels",
            "What support channels are included on each plan?",
            "Free plans get the community forum and full documentation. Pro adds email support with a 24-hour response SLA, and Enterprise unlocks a dedicated account manager, 1-hour response SLA, and 24/7 phone support.",
            ["free", "pro", "enterprise"],
            [
                new("free", "Community forum, full documentation, 5-day email response", true),
                new("pro", "Email support with 24-hour SLA, live chat during business hours", true),
                new("enterprise", "Dedicated account manager, 1-hour SLA, 24/7 phone support, private Slack", true),
            ]),
        new("automation",
            "Which plans include advanced automation and workflows?",
            "Pro and Enterprise both include the full automation engine with custom triggers, conditions, and actions. Free plans get a starter set of templates with limited customization.",
            ["pro", "enterprise"],
            [
                new("free", "5 starter templates, 100 runs per month", false),
                new("pro", "Unlimited custom automations, 10,000 runs per month, webhook triggers", true),
                new("enterprise", "Unlimited automations, unlimited runs, custom integrations, dedicated automation success manager", true),
            ]),
        new("sso-security",
            "Are SSO and advanced security features available?",
            "SAML 2.0 SSO, enforced two-factor authentication, IP allowlisting, and audit logs are Enterprise-only features designed for organizations with compliance requirements like SOC 2, HIPAA, or ISO 27001.",
            ["enterprise"],
            [
                new("free", "Password authentication only", false),
                new("pro", "Optional two-factor authentication", false),
                new("enterprise", "SAML SSO, enforced 2FA, IP allowlisting, audit logs, SOC 2 Type II compliance", true),
            ]),
        new("plan-changes",
            "Can I upgrade or downgrade between plans anytime?",
            "Yes. Upgrade and downgrade from your account dashboard at any time. Upgrades apply immediately with prorated billing, and downgrades take effect at the end of your current billing period.",
            ["free", "pro", "enterprise"],
            null),
    ];
}
