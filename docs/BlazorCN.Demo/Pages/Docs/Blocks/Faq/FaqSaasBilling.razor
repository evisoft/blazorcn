@* ============================================================
   Block: faq-saas-billing
   Title: FaqSaasBilling
   Description: A marketing-scale billing FAQ accordion block for React and Next.js with single-item expand, chevron rotation, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-saas-billing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Billing &amp; subscription
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Transparent answers about your plan.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The clear answers to the billing questions we hear most. Still unsure? Our billing team
                replies in under an hour.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-billing-panel-{item.Id}";
                var triggerId = $"faq-billing-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">Manage subscription</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Contact billing</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "tiers";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("tiers",
            "How does billing work across plan tiers?",
            "Basic is $29/month, Pro is $79/month with a 20% annual discount ($756/year), and Enterprise is custom-priced. Every plan starts with a 14-day free trial — no credit card required. Billing cycles begin on your signup date and renew automatically until you cancel."),
        new("plan-changes",
            "Can I upgrade or downgrade my subscription anytime?",
            "Yes. Change plans anytime from billing settings. Upgrades take effect immediately with prorated charges for the remaining period. Downgrades take effect at the end of your current cycle so you keep the value of what you paid for. There are no penalties for switching."),
        new("payment-methods",
            "What payment methods do you accept?",
            "We accept every major credit and debit card (Visa, Mastercard, Amex, Discover), ACH bank transfers for annual plans, and invoice billing with NET 30 terms for Enterprise customers. All payments run through Stripe with PCI DSS Level 1 compliance."),
        new("refunds",
            "Do you offer refunds or cancellation credits?",
            "We offer a 30-day money-back guarantee on your first annual subscription. Monthly plans can be canceled anytime — you keep access until the end of the paid period. Cancel from Account → Billing → Subscription and your data stays available for 30 days in case you reactivate."),
        new("invoices",
            "How do I access and download my invoices?",
            "All invoices live in your billing dashboard under Account → Billing → Invoices. Download a PDF for any period. Invoices are also emailed automatically after each successful charge, and Enterprise customers receive consolidated monthly invoices with PO numbers and custom billing details."),
        new("failed-payment",
            "What happens if my payment fails?",
            "We retry your card three times over seven days and email you each time. Your account stays fully active during the grace period. If every retry fails, we drop into read-only mode for 14 days before any data is deleted — update your payment method anytime to restore full access."),
        new("discounts",
            "Do you offer discounts for nonprofits or education?",
            "Yes — verified nonprofits and educational institutions receive a 40% discount on annual plans. Submit your tax-exempt or institutional documentation to our sales team and we'll apply the discount on your next renewal. Re-verification happens once a year."),
        new("overages",
            "Are there any hidden fees or usage overages?",
            "No hidden fees. Each plan includes the stated features and usage limits. If you approach your limit, we'll notify you and offer an upgrade path — you'll never see a surprise overage charge. Enterprise plans support custom limits negotiated upfront."),
    ];
}
