@* ============================================================
   Block: faq-floating-search
   Title: FaqFloatingSearch
   Description: A category chip filter FAQ block for React and Next.js with click-to-filter chips, single-expand accordion, smooth height transitions, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-floating-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Filter by what matters.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Tap a category to narrow the list, then expand any question for the full answer. The
                short answers to the questions we hear most.
            </p>
        </div>

        @* Category chip filter *@
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
            @foreach (var cat in _categories)
            {
                var category = cat;
                var isActive = _activeCategory == category;
                <button type="button"
                        aria-pressed="@(isActive ? "true" : "false")"
                        @onclick="@(() => SelectCategory(category))"
                        class="@Cn.Merge("rounded-full border px-3.5 py-1.5 text-xs font-medium uppercase tracking-wider transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-card text-muted-foreground hover:bg-muted")">
                    @category
                </button>
            }
        </div>

        @* Accordion *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in FilteredFaqs)
            {
                var item = faqItem;
                var isOpen = _expandedId == item.Id;
                var panelId = $"floating-search-faq-panel-{item.Id}";
                var triggerId = $"floating-search-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button type="button"
                            id="@triggerId"
                            aria-expanded="@(isOpen ? "true" : "false")"
                            aria-controls="@panelId"
                            @onclick="@(() => ToggleItem(item.Id))"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="inline-flex items-center rounded-full border bg-muted px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @item.Category
                            </span>
                            <p class="mt-2 text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" aria-hidden="true"
                                      Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Read the docs
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer, string Category);

    private string? _expandedId = "upgrade";
    private string _activeCategory = "All";

    private static readonly FaqItem[] _faqItems =
    [
        new("upgrade",
            "How do I upgrade my plan?",
            "Open Settings, Billing, and click Upgrade plan. Choose monthly or annual (annual saves 20%). Payment runs through Stripe and your new limits take effect within seconds. Pro-rated credits apply when upgrading mid-cycle.",
            "Billing"),
        new("integrations",
            "What integrations do you support?",
            "We support 50+ integrations including Slack, Zapier, Salesforce, HubSpot, Google Workspace, Microsoft 365, Jira, GitHub, and Stripe. All integrations use OAuth, take under five minutes to set up, and sync automatically or via webhook.",
            "Technical"),
        new("security",
            "How secure is my data?",
            "We use AES-256 encryption at rest and TLS 1.3 in transit. Data lives in SOC 2 Type II certified data centers with backups every four hours. We're GDPR and CCPA compliant, audited annually, and we never sell customer data.",
            "Security"),
        new("export",
            "Can I export my data?",
            "Yes. Export anytime from Settings, Data export. Choose CSV, JSON, or XML, pick a date range, and we'll process the export and email a download link. Enterprise plans include automated daily backups to your S3 bucket.",
            "General"),
        new("refund",
            "What's your refund policy?",
            "We offer a 30-day money-back guarantee on every plan. Contact support and we have the refund processed within 5-7 business days back to the original payment method. Annual plans receive prorated refunds for unused months.",
            "Billing"),
        new("invite",
            "How do I invite team members?",
            "Open Settings, Team, and click Invite members. Enter emails (comma-separated for bulk) and assign roles: Admin, Member, or Viewer. Invitees receive onboarding emails. Team size limits depend on your plan tier.",
            "General"),
        new("uptime",
            "What's your uptime SLA?",
            "We guarantee 99.9% uptime on all paid plans. Our infrastructure spans multiple availability zones with automatic failover. Scheduled maintenance occurs in low-traffic windows with 48 hours notice. Enterprise plans get a 99.99% SLA.",
            "Technical"),
        new("api",
            "Do you offer API access?",
            "Yes. Every plan includes RESTful API access with full OpenAPI docs. Free tier: 1,000 requests/hour. Pro: 10,000/hour. Enterprise: custom limits. Official SDKs ship for JavaScript, Python, Ruby, and Go.",
            "Technical"),
        new("delete",
            "How do I delete my account?",
            "Account deletion is permanent. Open Settings, Account, Delete account, and confirm. Export your data first if needed. All data is permanently deleted within 30 days per GDPR. Active subscriptions cancel immediately with prorated refunds.",
            "General"),
        new("payment-methods",
            "What payment methods do you accept?",
            "All major credit cards (Visa, Mastercard, Amex, Discover), PayPal, and bank transfers for Enterprise accounts. Every payment runs through Stripe with PCI DSS compliance. Update payment methods in Settings, Billing.",
            "Billing"),
    ];

    private static readonly string[] _categories =
        ["All", "Billing", "Technical", "Security", "General"];

    private FaqItem[] FilteredFaqs =>
        _activeCategory == "All"
            ? _faqItems
            : _faqItems.Where(f => f.Category == _activeCategory).ToArray();

    private void SelectCategory(string category)
    {
        _activeCategory = category;
        _expandedId = null;
    }

    private void ToggleItem(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }
}
