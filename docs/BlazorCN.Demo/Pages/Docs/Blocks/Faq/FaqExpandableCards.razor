@* ============================================================
   Block: faq-expandable-cards
   Title: FaqExpandableCards
   Description: A marketing-scale expandable card grid FAQ block for React and Next.js with bordered cards, hover lift, single-card expand, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-expandable-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One card. One answer.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Each question lives in its own bordered card so the important ones never get buried. Tap
                any card to expand the full answer.
            </p>
        </div>

        @* Expandable cards *@
        <div class="mt-10 flex flex-col gap-4">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-card-panel-{item.Id}";
                var triggerId = $"faq-card-trigger-{item.Id}";
                <div class="overflow-hidden rounded-2xl border bg-card transition-colors hover:border-foreground/20">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="border-t px-6 pb-6 pt-5 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pt-6">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "upgrade";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("upgrade",
            "How do I upgrade from the Free plan to Pro?",
            "Click Upgrade in the top navigation or open Settings > Billing. Select your plan, choose monthly or annual billing, and enter payment details. Upgrades process immediately and your first charge is prorated against the days remaining in your current cycle."),
        new("team",
            "Can I invite team members to collaborate?",
            "Yes. Open Settings > Team Members and click Invite Member. Enter an email, assign a role (Admin, Member, or Guest), and choose which projects they can access. Free plans support 5 members and Pro and Enterprise offer unlimited seats."),
        new("security",
            "What security measures protect my data?",
            "AES-256 encryption at rest, TLS 1.3 in transit, SOC 2 Type II compliance, geographically distributed redundant data centers, hourly automated backups, quarterly third-party penetration testing, and detailed audit logs across every workspace."),
        new("integrations",
            "How do I connect third-party tools and services?",
            "Open Settings > Integrations to browse 100+ available connections. Click Connect on any service to authorize via OAuth 2.0, then configure sync settings, custom field mapping, and automation rules. Premium integrations require Pro or Enterprise."),
        new("cancel",
            "What happens to my data if I cancel?",
            "You'll keep full access until the end of the current billing period, then your account converts to the Free plan. Your data stays intact for 60 days for export or reactivation, and is permanently deleted at 90 days per our retention policy."),
        new("discounts",
            "Do you offer discounts for annual billing or nonprofits?",
            "Yes. Annual plans save 20% versus monthly billing, registered nonprofits and educational institutions receive 50% off, and student discounts ship through GitHub Student Developer Pack and similar programs."),
        new("export",
            "How do I export or back up my data?",
            "Open Settings > Data Export to generate a workspace backup. Choose what to include (projects, tasks, files, comments, team) and a format (JSON, CSV, or Excel). You'll receive a secure download link by email within 30 minutes."),
    ];
}
