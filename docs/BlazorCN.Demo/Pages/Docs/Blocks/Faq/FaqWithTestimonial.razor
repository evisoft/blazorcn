@* ============================================================
   Block: faq-with-testimonial
   Title: FaqWithTestimonial
   Description: A marketing-scale FAQ block for React and Next.js with a featured customer quote panel, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-testimonial.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                From the people who shipped it.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One customer voice and the answers behind it. The quote is real and so is the team
                shipping the product.
            </p>
        </div>

        @* Featured testimonial *@
        <figure class="mt-10 overflow-hidden rounded-2xl border bg-card px-6 py-7 sm:px-8 sm:py-8">
            <LucideIconCn Name="quote" Size="32" Class="size-8 text-muted-foreground/40" aria-hidden="true" />
            <blockquote class="mt-4 text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                "@(_testimonial.Quote)"
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-4">
                <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_testimonial.Initials
                    </span>
                </div>
                <div>
                    <p class="text-sm font-semibold text-foreground">@_testimonial.Name</p>
                    <p class="text-xs text-muted-foreground">
                        @_testimonial.Role · @_testimonial.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* Accordion *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-testimonial-panel-{item.Id}";
                var triggerId = $"faq-testimonial-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read their story</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Talk to sales</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "results";

    private record TestimonialData(string Name, string Initials, string Role, string Company, string Quote);
    private record FaqItem(string Id, string Question, string Answer);

    private static readonly TestimonialData _testimonial = new(
        "Sarah Chen",
        "SC",
        "VP of Operations",
        "Northwind",
        "We shipped our migration in three weeks instead of three months. The answers were on the FAQ page before we even thought to ask the support team."
    );

    private static readonly FaqItem[] _faqItems =
    [
        new("results",
            "How quickly can I see results?",
            "Most customers see measurable improvements in the first week. The analytics dashboard tracks key metrics in real time, so you can monitor progress from day one. Teams typically report a 35% efficiency lift within their first month."),
        new("expertise",
            "Do I need technical expertise to use this?",
            "No technical background required. The platform is designed for business users with an intuitive interface and a guided setup wizard. Free onboarding sessions and 24/7 support are included on every plan."),
        new("implementation",
            "What if I need help during implementation?",
            "Every plan includes setup support. You get the knowledge base with video tutorials, live chat, and on Enterprise a dedicated success manager. Average first-response time on tickets is under two hours."),
        new("integrations",
            "Can this integrate with my existing tools?",
            "Yes. We support 50+ integrations with Slack, Salesforce, Google Workspace, Microsoft 365, and more. Our API covers custom workflows. Most integrations take under five minutes to set up over OAuth."),
        new("cancel",
            "What happens to my data if I cancel?",
            "You retain full access for 30 days after cancellation. Export everything from your dashboard in CSV, JSON, or XML. After 30 days the data is permanently deleted to comply with GDPR."),
        new("security",
            "Is my data secure and compliant?",
            "Absolutely. We use AES-256 encryption, SOC 2 Type II certification, and comply with GDPR, CCPA, and HIPAA. Data lives in geo-distributed data centers with automatic backups every four hours and annual third-party audits."),
    ];
}
