@* ============================================================
   Block: faq-chatbot-style
   Title: FaqChatbotStyle
   Description: A marketing-scale conversational chatbot-style FAQ block for React and Next.js with alternating message bubbles, staggered entrance animations, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-chatbot-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Ask us anything.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Read the questions our customers ask most — formatted as a real conversation with our
                support bot. Need a human? The team replies in under an hour.
            </p>
        </div>

        @* Chat panel *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            <div class="flex items-center gap-3 border-b px-6 py-4 sm:px-8">
                <AvatarCn Class="size-9">
                    <AvatarFallbackCn Class="bg-muted">
                        <LucideIconCn Name="bot" Size="16" Class="size-4 text-muted-foreground" />
                    </AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-foreground">@_botName</p>
                    <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Online · replies instantly
                    </p>
                </div>
            </div>

            <div class="space-y-5 p-6 sm:p-8">
                @foreach (var msg in _messages)
                {
                    var isUser = msg.Role == "user";
                    <article class="@Cn.Merge("flex gap-3", isUser ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-9 shrink-0">
                            <AvatarFallbackCn Class="@(isUser ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @if (isUser)
                                {
                                    <LucideIconCn Name="user" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <LucideIconCn Name="bot" Size="16" Class="size-4" />
                                }
                            </AvatarFallbackCn>
                        </AvatarCn>

                        <div class="@Cn.Merge("max-w-[80%] rounded-2xl px-4 py-3", isUser ? "bg-foreground text-background" : "bg-muted/60 text-foreground")">
                            <p class="text-sm leading-relaxed">@msg.Content</p>
                        </div>
                    </article>
                }
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _botName = "Support Bot";

    private record Message(string Id, string Role, string Content);

    private static readonly Message[] _messages =
    [
        new("m1", "user", "How do I get started with your platform?"),
        new("m2", "bot", "Sign up for a free account, browse the component library, and click Copy Code on anything you like. Paste it into your React or Next.js project, install the listed dependencies, and you're shipping. The Quick Start guide walks through the whole flow in under five minutes."),
        new("m3", "user", "What's the difference between Free and Pro?"),
        new("m4", "bot", "Free includes 1,100+ patterns, 285K+ icons, and 35+ hooks. Pro unlocks 880+ premium blocks, advanced charts, shaders, AI components, and priority support. Pro also includes unlimited downloads and lifetime updates — one purchase covers every release."),
        new("m5", "user", "Can I cancel my subscription anytime?"),
        new("m6", "bot", "Yes — cancel from your account settings whenever you like. You keep Pro access until the end of your billing period. We also back every plan with a 14-day money-back guarantee. Email support if you ever need a hand."),
        new("m7", "user", "Do you provide TypeScript support?"),
        new("m8", "bot", "Every component ships with strict TypeScript types — full autocomplete, type checking, and inline JSDoc inside your IDE. Interfaces are exported for every component prop so dropping them into a typed project takes seconds."),
        new("m9", "user", "How often do you release new components?"),
        new("m10", "bot", "We ship new components every week — blocks, patterns, hooks, and tools. Pro subscribers get them the moment they land. Follow the changelog or subscribe to the email digest to never miss a release."),
    ];
}
