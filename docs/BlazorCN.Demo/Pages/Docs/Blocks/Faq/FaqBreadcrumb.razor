@* ============================================================
   Block: faq-breadcrumb
   Title: FaqBreadcrumb
   Description: A marketing-scale FAQ block for React and Next.js with breadcrumb context, category filter pills, single-expand disclosure, smooth transitions, accessible markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-breadcrumb.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Breadcrumb *@
        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                @for (var i = 0; i < _breadcrumbs.Length; i++)
                {
                    var idx = i;
                    var crumbItem = _breadcrumbs[idx];
                    var isLast = idx == _breadcrumbs.Length - 1;
                    <li class="flex items-center gap-2">
                        @if (idx == 0)
                        {
                            <button type="button" class="flex items-center gap-1 transition-colors hover:text-foreground">
                                <LucideIconCn Name="home" Size="14" Class="size-3.5" aria-hidden="true" />
                                <span>@crumbItem.Label</span>
                            </button>
                        }
                        else
                        {
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" aria-hidden="true" />
                            <button type="button"
                                    aria-current="@(isLast ? "page" : null)"
                                    class="@Cn.Merge("transition-colors hover:text-foreground", isLast ? "font-medium text-foreground" : "")">
                                @crumbItem.Label
                            </button>
                        }
                    </li>
                }
            </ol>
        </nav>

        @* Marketing headline cluster *@
        <div class="mt-6 max-w-2xl">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Find your answer by topic.
            </h2>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Filter by topic to see only the questions that match. Can't find what you need? Our
                support team replies in under an hour.
            </p>
        </div>

        @* Category filter pills *@
        <div class="mt-8 flex flex-wrap gap-2">
            <button type="button"
                    @onclick="@(() => _selectedCategory = null)"
                    aria-pressed="@(_selectedCategory == null ? "true" : "false")"
                    class="@Cn.Merge("rounded-full border px-4 py-2 text-sm font-medium transition-colors", _selectedCategory == null ? "border-foreground bg-foreground text-background" : "border-border bg-card text-foreground hover:bg-muted/60")">
                All
            </button>
            @foreach (var cat in _categories)
            {
                var category = cat;
                var isActive = _selectedCategory == category;
                <button type="button"
                        @onclick="@(() => _selectedCategory = category)"
                        aria-pressed="@(isActive ? "true" : "false")"
                        class="@Cn.Merge("rounded-full border px-4 py-2 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-card text-foreground hover:bg-muted/60")">
                    @category
                </button>
            }
        </div>

        @* Accordion *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in FilteredFaqs)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-bc-panel-{item.Id}";
                var triggerId = $"faq-bc-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button type="button"
                            id="@triggerId"
                            aria-expanded="@(isOpen ? "true" : "false")"
                            aria-controls="@panelId"
                            @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @item.Category
                            </p>
                            <p class="mt-1 text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20"
                                      Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")"
                                      aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Crumb(string Label, string Href);
    private record FaqItem(string Id, string Category, string Question, string Answer);

    private static readonly Crumb[] _breadcrumbs =
    [
        new("Home", "/"),
        new("Support", "/support"),
        new("Help Center", "/support/help"),
        new("FAQ", "/support/help/faq"),
    ];

    private static readonly FaqItem[] _faqItems =
    [
        new("billing-update", "Billing", "How do I update my billing information?",
            "Open Settings, Billing from your dashboard and click Payment Method. Updates take effect immediately for future invoices and run through Stripe's PCI-compliant processor — we never store full card numbers ourselves."),
        new("billing-charged", "Billing", "When will I be charged for my subscription?",
            "Your first charge runs immediately at signup. Renewals run on the same calendar date each month or year. If your signup date doesn't exist in a given month, we charge on the last day of that month and email an invoice 24 hours in advance."),
        new("billing-refund", "Billing", "Can I get a refund if I'm not satisfied?",
            "We offer a 30-day money-back guarantee for first-time subscribers. Contact support within 30 days of your initial purchase and we'll process the refund within 5-7 business days to your original payment method."),
        new("account-email", "Account", "How do I change my account email address?",
            "Go to Settings, Account, Change Email. Enter the new address and we'll send a verification link. Once you confirm, the new email becomes your login credential and all future notifications go there."),
        new("account-password", "Account", "What if I forget my password?",
            "Click Forgot Password on the login page and enter your email. We'll send a reset link valid for one hour. Reset links can only be used once and the new password must meet our security requirements."),
        new("account-delete", "Account", "Can I delete my account permanently?",
            "Yes. Open Settings, Account, Delete Account. Confirm by entering your password and typing DELETE. You have a 30-day grace period to restore the account by contacting support; after that, all data is permanently removed."),
        new("tech-browsers", "Technical", "Which browsers and devices are supported?",
            "Latest versions of Chrome, Firefox, Safari, and Edge on desktop. iOS Safari 15+ and Android Chrome on Android 10+. The platform is optimized for screens 320px and wider, with JavaScript and cookies enabled."),
        new("tech-bug", "Technical", "How do I report a bug?",
            "Use the Report Issue link in the help menu, or email support@example.com with what you were doing, what happened, what you expected, your browser and OS, and any error messages. Screenshots are extremely helpful."),
    ];

    private static readonly string[] _categories =
        _faqItems.Select(f => f.Category).Distinct().ToArray();

    private string? _selectedCategory = null;
    private string? _expanded = null;

    private FaqItem[] FilteredFaqs =>
        _selectedCategory == null
            ? _faqItems
            : _faqItems.Where(f => f.Category == _selectedCategory).ToArray();
}
