@* ============================================================
   Block: faq-with-diagram
   Title: FaqWithDiagram
   Description: A marketing-scale FAQ accordion block for React and Next.js with an inline SVG architecture diagram inside one featured answer, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-diagram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Architecture answers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                How the system actually works.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The technical questions our solutions engineers answer every week — illustrated where a
                picture replaces a thousand support tickets.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-diagram-panel-{item.Id}";
                var triggerId = $"faq-diagram-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                @if (item.Featured)
                                {
                                    <svg
                                        role="img"
                                        aria-labelledby="faq-diagram-title"
                                        viewBox="0 0 480 200"
                                        class="mt-5 h-auto w-full rounded-xl border bg-muted/30">
                                        <title id="faq-diagram-title">OAuth 2.0 authorization code flow diagram</title>
                                        @* Three lanes *@
                                        <g>
                                            <rect x="20" y="24" width="120" height="40" rx="8" class="fill-card stroke-border" />
                                            <rect x="180" y="24" width="120" height="40" rx="8" class="fill-card stroke-border" />
                                            <rect x="340" y="24" width="120" height="40" rx="8" class="fill-card stroke-border" />
                                            <text
                                                x="80"
                                                y="48"
                                                text-anchor="middle"
                                                class="fill-foreground text-[11px] font-semibold">
                                                Client app
                                            </text>
                                            <text
                                                x="240"
                                                y="48"
                                                text-anchor="middle"
                                                class="fill-foreground text-[11px] font-semibold">
                                                Auth server
                                            </text>
                                            <text
                                                x="400"
                                                y="48"
                                                text-anchor="middle"
                                                class="fill-foreground text-[11px] font-semibold">
                                                Resource server
                                            </text>

                                            @* Lane lines *@
                                            <line x1="80" y1="64" x2="80" y2="180" class="stroke-border" stroke-dasharray="3 3" />
                                            <line x1="240" y1="64" x2="240" y2="180" class="stroke-border" stroke-dasharray="3 3" />
                                            <line x1="400" y1="64" x2="400" y2="180" class="stroke-border" stroke-dasharray="3 3" />

                                            @* Arrows *@
                                            <line x1="80" y1="90" x2="232" y2="90" class="stroke-foreground" stroke-width="1.5" />
                                            <polygon points="232,86 240,90 232,94" class="fill-foreground" />
                                            <text x="156" y="84" text-anchor="middle" class="fill-muted-foreground text-[10px]">
                                                1. Authorize
                                            </text>

                                            <line x1="240" y1="118" x2="88" y2="118" class="stroke-foreground" stroke-width="1.5" />
                                            <polygon points="88,114 80,118 88,122" class="fill-foreground" />
                                            <text x="160" y="112" text-anchor="middle" class="fill-muted-foreground text-[10px]">
                                                2. Auth code
                                            </text>

                                            <line x1="80" y1="146" x2="232" y2="146" class="stroke-foreground" stroke-width="1.5" />
                                            <polygon points="232,142 240,146 232,150" class="fill-foreground" />
                                            <text x="160" y="140" text-anchor="middle" class="fill-muted-foreground text-[10px]">
                                                3. Token exchange
                                            </text>

                                            <line x1="80" y1="174" x2="392" y2="174" class="stroke-foreground" stroke-width="1.5" />
                                            <polygon points="392,170 400,174 392,178" class="fill-foreground" />
                                            <text x="240" y="168" text-anchor="middle" class="fill-muted-foreground text-[10px]">
                                                4. API request with bearer token
                                            </text>
                                        </g>
                                    </svg>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Talk to an engineer</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "auth-flow";

    private record FaqItem(string Id, string Question, string Answer, bool Featured = false);

    private static readonly FaqItem[] _faqItems =
    [
        new("auth-flow",
            "How does the OAuth 2.0 authentication flow work?",
            "The client app requests an authorization code from the auth server, exchanges it for an access token, and uses that token to call the resource server. Refresh tokens rotate on every exchange so a leaked token has a short blast radius.",
            Featured: true),
        new("webhook-retry",
            "How does the webhook retry policy handle failures?",
            "Failed deliveries retry with exponential backoff and jitter — 5 seconds, 25 seconds, 2 minutes, 10 minutes — for a total window of about 12 minutes. After the fifth failure the endpoint is disabled and you receive an alert email."),
        new("rate-limiting",
            "How are rate limits applied per API key?",
            "We use a sliding window with a burst allowance: 100 requests per minute and 10,000 per hour per key. Headers on every response (X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset) tell your client exactly where it stands."),
        new("data-sync",
            "How is data synchronized across regions?",
            "Writes flow into a regional message queue, get appended to the event store, and fan out to caches and the database. Eventual consistency lands inside 100ms at the p99 even when traffic crosses an ocean."),
        new("deployments",
            "What is the deployment strategy for new releases?",
            "We run blue-green deployments behind a single load balancer. Traffic shifts to the green environment in 10% increments while canary metrics watch error rate and p99 latency. A regression rolls back automatically inside 60 seconds."),
    ];
}
