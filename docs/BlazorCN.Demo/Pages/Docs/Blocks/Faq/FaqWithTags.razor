@* ============================================================
   Block: faq-with-tags
   Title: FaqWithTags
   Description: A marketing-scale FAQ accordion block for React and Next.js with category tag pills, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-tags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Tagged for fast scanning.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer is labeled by topic so you can spot the question that matches your
                situation without reading every entry on the page.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-tags-panel-{item.Id}";
                var triggerId = $"faq-tags-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <div class="mt-3 flex flex-wrap gap-1.5">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="rounded-full border bg-muted px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                                        @tag
                                    </span>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" aria-hidden="true" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Browse the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "upgrade";

    private record FaqItem(string Id, string Question, string Answer, string[] Tags);

    private static readonly FaqItem[] _faqItems =
    [
        new("upgrade",
            "How do I upgrade my subscription plan?",
            "From your account dashboard, open Billing and choose Change Plan. Upgrades take effect immediately with prorated billing for the remainder of your cycle. You get instant access to every new feature in the higher tier without re-onboarding.",
            ["Billing", "Account"]),
        new("rate-limits",
            "What API rate limits apply to my plan?",
            "Free plans get 100 requests per hour, Individual gets 1,000, Team gets 10,000, and Organization gets custom limits. Rate limits reset at the top of each hour. Track current usage in the API dashboard or via the X-RateLimit response headers.",
            ["Technical", "Billing"]),
        new("sso",
            "How do I enable SSO for my organization?",
            "SSO is available on Organization plans. Open Settings, Security, then enable Single Sign-On. We support SAML 2.0, OAuth 2.0, and OpenID Connect. Integration guides are published for Okta, Azure AD, and Google Workspace.",
            ["Security", "Account"]),
        new("export",
            "Can I export my data?",
            "Yes, anytime. From Account Settings, open Privacy and request a data export. We email a download link within 24 hours containing your profile, projects, and usage history in JSON. There is no limit on how often you can request an export.",
            ["Account", "Security"]),
        new("team-vs-org",
            "What's the difference between Team and Organization plans?",
            "Team includes 5 seats with shared workspaces and basic collaboration. Organization adds unlimited seats, SSO, advanced permissions, audit logs, priority support, and custom contracts. Organization customers also get a dedicated account manager and SLA.",
            ["Product", "Billing"]),
        new("webhooks",
            "How do webhooks work?",
            "Webhooks send real-time HTTP POST requests to your endpoint when events occur. Configure them in Settings, Integrations. Verify signatures with the secret key for security. Failed deliveries are retried automatically with exponential backoff.",
            ["Technical", "Security"]),
        new("cancel",
            "What happens to my data if I cancel?",
            "Your data remains accessible for 30 days after cancellation. Export everything during that grace period. After 30 days, all data is permanently deleted per GDPR. If you resubscribe within the grace window, everything is instantly restored.",
            ["Account", "Security", "Billing"]),
        new("enterprise",
            "Do you offer custom enterprise features?",
            "Yes. Enterprise customers can request custom features, dedicated infrastructure, on-premise deployment, white-labeling, and advanced security controls. Talk to sales to scope requirements. Every enterprise agreement includes an SLA and a named support contact.",
            ["Product", "Billing"]),
    ];
}
