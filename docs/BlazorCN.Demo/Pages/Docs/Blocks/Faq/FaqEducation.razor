@* ============================================================
   Block: faq-education
   Title: FaqEducation
   Description: A marketing-scale icon accordion FAQ block for React and Next.js with per-item lucide icons, optional highlight badges, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-education.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Student information
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything you need before you enroll.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Enrollment, certification, prerequisites, refunds, and accreditation — the answers
                future students ask the admissions team most often.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-edu-panel-{item.Id}";
                var triggerId = $"faq-edu-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex min-w-0 items-start gap-4">
                            @if (item.Icon != null)
                            {
                                <div class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border bg-muted">
                                    <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
                                </div>
                            }
                            <div class="min-w-0">
                                <span class="text-base font-semibold text-foreground sm:text-lg">
                                    @item.Question
                                </span>
                                @if (item.Highlight != null)
                                {
                                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                        @item.Highlight
                                    </p>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Browse courses</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Talk to admissions</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "enrollment";

    private record FaqItem(string Id, string Question, string Answer, string? Icon = null, string? Highlight = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("enrollment",
            "How do I enroll in a course or program?",
            "Browse the course catalog, click Enroll Now on any course page, sign in (or create a free account), submit transcripts for degree programs or a resume for professional certificates, and pay tuition or apply for financial aid. Most applications are reviewed within 3 to 5 business days, and early enrollment 30 days before start saves 10%.",
            "graduation-cap",
            "3–5 day approval"),
        new("courses",
            "What courses and programs are available?",
            "Over 500 courses across technology, business, healthcare, creative, and personal development. Formats include self-paced courses (3 to 12 weeks), live instructor-led classes, accredited degree programs from associate's through master's, professional certificates, and custom corporate training for teams.",
            "book-open"),
        new("certification",
            "Do I receive a certificate upon completion?",
            "Yes. Every course awards a certificate of completion and professional certificate programs deliver industry-recognized credentials from Google, AWS, Microsoft, and CompTIA. Certificates include a unique verification ID, a digital LinkedIn share link, and a downloadable PDF for your resume.",
            "award",
            "Industry-recognized"),
        new("prerequisites",
            "Are there prerequisites or requirements?",
            "Beginner courses are open to everyone. Intermediate and advanced courses require completion of foundational courses or an equivalency assessment. Degree programs require a high school diploma for associate's tracks and a bachelor's degree for master's tracks. Each course page lists its specific prerequisites."),
        new("refunds",
            "What's your refund and cancellation policy?",
            "Full refund within 7 days of enrollment before the course starts (minus a $50 processing fee). After the course begins: 100% refund within the first week, 50% within the second week, no refunds after 14 days. Course transfers are allowed once within 6 months for a $25 fee.",
            "credit-card"),
        new("accreditation",
            "Is the program accredited?",
            "Yes. We're accredited by the Distance Education Accrediting Commission, recognized by the U.S. Department of Education and the Council for Higher Education Accreditation. Business programs hold ACBSP accreditation, nursing programs are CCNE accredited, and engineering courses meet ABET standards.",
            "file-check",
            "DEAC accredited"),
        new("schedule",
            "How flexible is the schedule?",
            "Self-paced courses run 24/7 within your enrollment period. Live courses are scheduled in evenings and weekends with full recordings if you miss a session. Most students invest 5 to 10 hours a week per course, and the mobile app downloads lectures for offline study during your commute.",
            "calendar"),
        new("support",
            "What student support services are included?",
            "Every student gets a personal academic advisor, 24/7 technical support, free subject tutoring, career services with resume review and interview prep, library access to millions of academic journals, disability accommodations, and proactive success coaching if you fall behind.",
            "users"),
    ];
}
