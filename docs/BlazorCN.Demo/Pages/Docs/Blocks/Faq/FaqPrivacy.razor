@* ============================================================
   Block: faq-privacy
   Title: FaqPrivacy
   Description: A FAQ accordion block for React and Next.js with hero-scale headline cluster, a static last-updated timestamp, single-expand disclosure with chevron rotation, semantic aria-expanded and aria-controls markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-privacy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trust center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Your data, plainly explained.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The questions visitors ask before they sign up — answered without legalese. Every answer
                is reviewed by our compliance team and dated below.
            </p>
            <p class="mt-4 text-xs font-medium text-muted-foreground">
                Last updated @_lastUpdated
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-privacy-panel-{item.Id}";
                var triggerId = $"faq-privacy-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read full policy</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Contact our DPO</ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _lastUpdated = "April 10, 2026";
    private string? _expanded = "data-collected";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("data-collected",
            "What personal data do you collect?",
            "We collect your name, email address, and payment information at signup. Usage data includes IP address, browser type, pages visited, and feature interactions for analytics. We never sell your data to third parties, and every collection point is disclosed in our privacy policy with granular consent controls."),
        new("data-protection",
            "How is my data protected and encrypted?",
            "All data is encrypted at rest with AES-256 and in transit with TLS 1.3. Passwords are hashed with bcrypt and per-user salts. We run quarterly security audits, maintain SOC 2 Type II compliance, and follow OWASP best practices. Infrastructure runs on AWS with multi-region redundancy."),
        new("gdpr",
            "Are you GDPR compliant?",
            "Yes, fully GDPR compliant. EU customer data is stored in EU data centers. We maintain data processing agreements, support data subject access requests, enable data portability, and provide right-to-erasure functionality. Reach our DPO at privacy@@example.com for compliance inquiries."),
        new("delete-data",
            "How do I request deletion of my data?",
            "Request deletion from Account > Privacy > Delete Account or email privacy@@example.com. We delete all personal data within 30 days, except records required by law (7 years for financial transactions). You'll receive confirmation once deletion is complete. Anonymized analytics may be retained."),
        new("cookies",
            "What cookies do you use and why?",
            "Essential cookies handle authentication and session management. Analytics cookies track usage patterns to improve the product (opt-out available). No advertising or third-party tracking cookies. Our cookie banner gives you granular control over every non-essential cookie."),
        new("third-parties",
            "Do you share data with third parties?",
            "Only essential service providers: Stripe for payments, AWS for hosting, and SendGrid for transactional email. Every vendor is GDPR compliant and bound by a data processing agreement. We never sell data to advertisers, and third-party integrations always require explicit user consent."),
        new("retention",
            "How long do you retain my data?",
            "Active account data is retained while your account is active. After deletion, personal data is purged within 30 days, except for legal retention requirements. Backups are kept for 90 days. Anonymized analytics may be retained permanently to improve the product."),
        new("export",
            "How do I access or export my data?",
            "Request a data export from Account > Privacy > Download Data. You'll receive a JSON or CSV file with all your personal data within 48 hours. Includes account info, usage history, and content created. Exports arrive via encrypted email link valid for 7 days."),
    ];
}
