@* ============================================================
   Block: faq-podcast
   Title: FaqPodcast
   Description: A FAQ block for React and Next.js that pairs a marketing headline cluster with an audio player mock and an accordion of transcript-style Q&A with smooth disclosure transitions, semantic markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-podcast.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Listen + read along
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Behind the show, in your words.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The questions listeners ask most — answered in the same voice as the show. Hit play or
                jump straight into the transcript below.
            </p>
        </div>

        @* Audio player mock *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card p-6 sm:p-8">
            <div class="flex items-center gap-5">
                <button
                    type="button"
                    aria-label="Play episode preview"
                    class="flex size-14 shrink-0 items-center justify-center rounded-full bg-foreground text-background transition-transform hover:scale-105">
                    <LucideIconCn Name="play" Size="24" Class="size-6 translate-x-0.5 fill-background" />
                </button>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-foreground">
                        Episode 142 · Building tools founders actually choose
                    </p>
                    <div class="mt-3 flex items-center gap-3">
                        <span class="font-mono text-xs text-muted-foreground tabular-nums">12:04</span>
                        <div class="relative h-1 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="absolute inset-y-0 left-0 w-[35%] rounded-full bg-foreground"></div>
                        </div>
                        <span class="font-mono text-xs text-muted-foreground tabular-nums">34:20</span>
                    </div>
                </div>
            </div>
        </div>

        @* Transcript accordion *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-podcast-panel-{item.Id}";
                var triggerId = $"faq-podcast-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start gap-5 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="mt-1 shrink-0 font-mono text-xs font-medium text-muted-foreground tabular-nums">
                            @item.Timestamp
                        </span>
                        <span class="flex-1 text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">Subscribe on Apple</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Read the transcript</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "where-listen";

    private record FaqItem(string Id, string Timestamp, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("where-listen", "00:42",
            "Where can I listen to the podcast?",
            "Available on Apple Podcasts, Spotify, Google Podcasts, Amazon Music, Overcast, Pocket Casts, and YouTube. Subscribe on your preferred platform for automatic episode downloads. New episodes ship every Tuesday at 6am EST."),
        new("rss", "03:18",
            "What's the RSS feed URL?",
            "Our RSS feed is https://podcast.example.com/feed.xml. Copy and paste it into any podcast app that supports custom feeds. Feed includes full episodes, show notes, timestamps, and chapter markers, and updates the moment a new episode publishes."),
        new("guest", "07:55",
            "How do I become a guest on the show?",
            "We're always looking for guests with strong opinions and unique experiences in tech, business, or culture. Submit a pitch via our guest form with your bio, topic ideas, and links. We review submissions monthly with a 4–8 week lead time, and remote sessions run 60–90 minutes."),
        new("frequency", "12:04",
            "How often do you release episodes?",
            "Weekly episodes every Tuesday at 6am EST, 45–75 minutes long. Format is 20–30 min interview, 10–15 min analysis, 5–10 min listener Q&A. Bonus episodes drop 2–4 times a month for premium subscribers."),
        new("sponsorship", "18:30",
            "How much does sponsorship cost?",
            "Pre-roll (30s) is $800/episode, mid-roll (60s) is $1,500/episode, and post-roll (30s) is $600/episode. Bundle deals for 4+ episodes save 15%. Current reach is 25,000 downloads per episode and 80,000 monthly listeners. Media kit available on request."),
        new("transcripts", "24:11",
            "Are transcripts available?",
            "Yes — full transcripts publish within 48 hours of release. Available on our website and inside podcast apps that support transcripts. Searchable by keyword with timestamps linked to audio playback and human-corrected speaker labels."),
        new("clips", "29:47",
            "Can I share episode clips on social media?",
            "Absolutely. We publish 15–90 second audiograms and video clips for every episode in our press kit. Full episode resharing is fine with attribution, but please don't re-upload entire episodes. Clips for commercial use require written permission."),
    ];
}
