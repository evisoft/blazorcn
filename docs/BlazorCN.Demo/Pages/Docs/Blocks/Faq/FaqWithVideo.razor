@* ============================================================
   Block: faq-with-video
   Title: FaqWithVideo
   Description: A marketing-scale FAQ block for React and Next.js with featured video thumbnail answers, play button overlays, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-video.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Watch and learn
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Read the answer or watch the walkthrough.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every featured answer comes with a 2–4 minute screencast for the questions where text
                alone wouldn't do the job.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-video-panel-{item.Id}";
                var triggerId = $"faq-video-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="flex flex-1 items-start gap-3">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            @if (item.VideoDuration != null)
                            {
                                <span class="mt-1 inline-flex shrink-0 items-center gap-1 rounded-full border bg-muted/60 px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                                    <LucideIconCn Name="play" Size="12" Class="size-3 fill-current" aria-hidden="true" />
                                    @item.VideoDuration
                                </span>
                            }
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                @if (item.VideoTitle != null)
                                {
                                    <div class="relative mt-5 aspect-video overflow-hidden rounded-xl border bg-muted">
                                        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-br from-muted via-muted to-muted/40"></div>
                                        <div
                                            aria-hidden="true"
                                            class="absolute inset-0 opacity-30"
                                            style="background-image:radial-gradient(circle at 25% 30%, var(--muted-foreground) 1px, transparent 1px);background-size:14px 14px;">
                                        </div>
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <button
                                                type="button"
                                                aria-label="@($"Play video: {item.VideoTitle}")"
                                                class="flex size-14 items-center justify-center rounded-full border bg-background/90 shadow-lg backdrop-blur transition-transform hover:scale-110">
                                                <LucideIconCn Name="play" Size="24" Class="size-6 translate-x-0.5 fill-foreground text-foreground" aria-hidden="true" />
                                            </button>
                                        </div>
                                        <div class="absolute bottom-3 left-3 rounded-md border bg-background/90 px-2.5 py-1 text-xs font-medium backdrop-blur">
                                            @item.VideoTitle
                                        </div>
                                        <div class="absolute bottom-3 right-3 rounded bg-foreground/90 px-1.5 py-0.5 font-mono text-[11px] text-background">
                                            @item.VideoDuration
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">Watch all tutorials</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Contact support</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "first-deploy";

    private record FaqItem(string Id, string Question, string Answer, string? VideoTitle = null, string? VideoDuration = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("first-deploy",
            "How do I ship my first deploy?",
            "Connect a Git repository, pick a framework preset, and we'll spin up a build in under 30 seconds. The walkthrough video shows the full path from a fresh GitHub account to a live URL — no config files required.",
            "First deploy walkthrough",
            "3:45"),
        new("integrations",
            "What integrations do you support out of the box?",
            "We ship native integrations for Slack, Linear, GitHub, Sentry, Datadog, and 100+ other tools. Each integration is a one-click OAuth flow and starts syncing within five minutes. Webhooks and a REST API cover everything else."),
        new("custom-workflow",
            "How do I build a custom workflow from scratch?",
            "Start from a blank canvas in the workflow editor, drag in triggers and actions, and connect them visually. The walkthrough below covers conditionals, parallel branches, and dynamic variables for a production-ready pipeline.",
            "Build a custom workflow",
            "4:20"),
        new("free-vs-pro",
            "What's the difference between Free and Pro?",
            "Free includes unlimited projects, 5 seats, and 5 GB of storage. Pro starts at $29/seat/month and unlocks unlimited seats, 100 GB per seat, advanced automation, custom fields, priority support, and full API access."),
        new("export-data",
            "How do I export my data if I want to leave?",
            "Open Settings → Data Export, choose what you want (projects, tasks, comments, files) and a format (CSV, JSON, or Excel), and we'll email a download link within 30 minutes. Exports preserve metadata and relationships.",
            "Exporting your workspace",
            "2:15"),
        new("team-permissions",
            "How do team permissions work?",
            "Roles are Admin, Member, and Guest, with project-level overrides available on Pro and above. Admins manage billing and team settings, Members create and edit content, and Guests have read-only access to specific projects."),
    ];
}
