@* ============================================================
   Block: faq-with-status
   Title: FaqWithStatus
   Description: A marketing-scale FAQ accordion block for React and Next.js with operational status pills, semantic color badges, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Always know where it stands.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer carries an operational status so you know whether the team has shipped a
                fix, is mid-flight on the work, or just opened the ticket.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-status-panel-{item.Id}";
                var triggerId = $"faq-status-trigger-{item.Id}";
                var status = GetStatusStyle(item.Status);
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-2">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <span class="@($"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium {status.ClassName}")">
                                @status.Label
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Open a ticket</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">View status page</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "license";

    private record FaqItem(string Id, string Question, string Answer, string Status);
    private record StatusStyle(string Label, string ClassName);

    private static StatusStyle GetStatusStyle(string status) => status switch
    {
        "resolved"    => new StatusStyle("Resolved",    "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"),
        "in-progress" => new StatusStyle("In progress", "bg-amber-500/10 text-amber-700 dark:text-amber-400"),
        _             => new StatusStyle("New",         "bg-blue-500/10 text-blue-700 dark:text-blue-400"),
    };

    private static readonly FaqItem[] _faqItems =
    [
        new("license",
            "What are the licensing terms for commercial projects?",
            "Your subscription includes commercial usage rights for unlimited projects and clients. Integrate components into SaaS products, client sites, and revenue-generating apps without extra fees. The only restriction is reselling components as a standalone library.",
            "resolved"),
        new("next-15",
            "Are all components compatible with Next.js 16 and React 19?",
            "Yes — every block ships against Next.js 16 App Router and React 19. We use Server Components by default and mark client islands explicitly. Components are tested against the latest stable releases and patched within 48 hours of major updates.",
            "new"),
        new("workspaces",
            "How many workspaces can I create on the Team plan?",
            "Team plans include three workspaces with up to five members each. Use separate workspaces for different clients, projects, or internal teams. Need more? Add additional workspaces for $10 each per month, or upgrade to Organization for unlimited.",
            "resolved"),
        new("sso",
            "How long does SSO integration take to set up?",
            "SSO setup takes two to three business days from when you share your identity provider details. We support all SAML 2.0 providers including Okta, Azure AD, Google Workspace, and OneLogin. Test credentials are issued before we enable for all users.",
            "in-progress"),
        new("versions",
            "How do I manage component versions across projects?",
            "Each component carries a semver version in its JSDoc. Pin to a major version per project, review changelogs before upgrading, and use migration guides for breaking changes. For monorepos, use package versions to control which projects receive updates.",
            "resolved"),
        new("retention",
            "How long do you retain workspace data after cancellation?",
            "Workspace data is retained for 30 days after cancellation in case you reactivate. After that it moves to archived storage for another 60 days, then is permanently deleted. Components you have already downloaded remain yours per the license terms.",
            "in-progress"),
        new("migration",
            "Do you provide migration assistance from Material-UI or Ant Design?",
            "Team and Organization plans include migration support. We provide component mapping guides, prop conversion notes, and pattern translations. Organization plans can purchase consulting hours for hands-on assistance with code transformation and testing.",
            "new"),
        new("offline",
            "Can I access documentation offline?",
            "Yes. Download offline documentation bundles from Settings, Documentation. Bundles ship in HTML and Markdown formats and include search. Downloads are refreshed weekly so developers in air-gapped environments always have a recent reference on hand.",
            "new"),
    ];
}
