@* ============================================================
   Block: faq-collapsible-groups
   Title: FaqCollapsibleGroups
   Description: A marketing-scale grouped FAQ block for React and Next.js with collapsible category sections, nested AnimatePresence transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-collapsible-groups.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse questions by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Open a category to drill into the answers that matter most. Can't find what you need?
                Our support team replies in under an hour.
            </p>
        </div>

        @* Collapsible groups *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var grp in _faqGroups)
            {
                var group = grp;
                var isGroupOpen = _expandedGroup == group.Id;
                var groupTriggerId = $"faq-group-trigger-{group.Id}";
                var groupPanelId = $"faq-group-panel-{group.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@groupTriggerId"
                        aria-expanded="@isGroupOpen.ToString().ToLower()"
                        aria-controls="@groupPanelId"
                        @onclick="@(() => _expandedGroup = isGroupOpen ? null : group.Id)"
                        class="flex w-full items-center gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("size-5 shrink-0 text-muted-foreground transition-transform duration-300", isGroupOpen ? "rotate-180" : "")" aria-hidden="true" />
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @group.Title
                        </span>
                        <span class="ml-auto text-xs text-muted-foreground">
                            @group.Items.Length questions
                        </span>
                    </button>

                    @if (isGroupOpen)
                    {
                        <div id="@groupPanelId" role="region" aria-labelledby="@groupTriggerId" class="overflow-hidden bg-muted/20">
                            <div class="px-6 py-4 sm:px-8">
                                @foreach (var itm in group.Items)
                                {
                                    var item = itm;
                                    var isItemOpen = _expandedItem == item.Id;
                                    var itemTriggerId = $"collapsible-groups-faq-item-trigger-{item.Id}";
                                    var itemPanelId = $"collapsible-groups-faq-item-panel-{item.Id}";
                                    <div class="border-b border-border/60 last:border-0">
                                        <button
                                            type="button"
                                            id="@itemTriggerId"
                                            aria-expanded="@isItemOpen.ToString().ToLower()"
                                            aria-controls="@itemPanelId"
                                            @onclick="@(() => _expandedItem = isItemOpen ? null : item.Id)"
                                            class="flex w-full items-start gap-3 py-4 text-left">
                                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("mt-1 size-4 shrink-0 text-muted-foreground transition-transform duration-300", isItemOpen ? "rotate-90" : "")" aria-hidden="true" />
                                            <span class="text-base font-semibold text-foreground">
                                                @item.Question
                                            </span>
                                        </button>

                                        @if (isItemOpen)
                                        {
                                            <div id="@itemPanelId" role="region" aria-labelledby="@itemTriggerId" class="overflow-hidden">
                                                <p class="pb-5 pl-7 text-base leading-relaxed text-muted-foreground">
                                                    @item.Answer
                                                </p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expandedGroup = "getting-started";
    private string? _expandedItem = null;

    private record FaqItem(string Id, string Question, string Answer);
    private record FaqGroup(string Id, string Title, FaqItem[] Items);

    private static readonly FaqGroup[] _faqGroups =
    [
        new("getting-started", "Getting started",
        [
            new("create-account",
                "How do I create an account?",
                "Click Sign Up in the header, pick email, Google, or GitHub authentication, and complete the registration flow. Email signups receive a verification link. Once verified you have immediate access to every free component."),
            new("system-requirements",
                "What are the system requirements?",
                "Node.js 18+, React 18+, and a modern browser. Components work with Next.js 16+, Vite, or any React framework. TypeScript is recommended but optional. Windows, macOS, and Linux are all supported."),
            new("first-component",
                "How do I install my first component?",
                "Browse the library, open a component, and click Copy Code. Paste it into your project and install the dependencies listed in the docs. Our CLI tool can also automate this with a single command."),
        ]),
        new("billing", "Billing & subscription",
        [
            new("billing-cycle",
                "How does billing work?",
                "Monthly or yearly billing on your selected plan, processed on the same day each cycle. Invoices arrive immediately by email and live in your billing dashboard. All transactions run through Stripe with bank-level encryption."),
            new("refund",
                "Can I get a refund?",
                "Yes — a 14-day money-back guarantee on every plan. Contact support within 14 days of purchase for a no-questions-asked refund. Refunds process within 5–7 business days to your original payment method."),
            new("payment-failure",
                "What happens if my payment fails?",
                "We retry the payment three times across a week, with email notifications before each retry. If every attempt fails, your account drops to the free plan. Update your payment method anytime in account settings to avoid interruption."),
        ]),
        new("security", "Security & privacy",
        [
            new("data-protection",
                "How is my data protected?",
                "Encrypted in transit with TLS 1.3 and at rest with AES-256. We follow SOC 2 standards and run regular audits. Infrastructure runs on enterprise cloud with a 99.9% uptime SLA and automated backups."),
            new("data-sales",
                "Do you sell user data?",
                "Never. We don't sell, rent, or share personal data with third parties. We collect only what's needed to deliver the service. Request export or deletion anytime — full details live in our GDPR and CCPA compliant privacy policy."),
            new("two-factor",
                "How do I enable two-factor authentication?",
                "Open Account Settings → Security and enable Two-Factor Authentication. Use an authenticator app (recommended) or SMS. Save your backup codes for account recovery. We strongly recommend 2FA for every account, especially team accounts."),
        ]),
    ];
}
