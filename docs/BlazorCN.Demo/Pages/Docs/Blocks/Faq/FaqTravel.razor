@* ============================================================
   Block: faq-travel
   Title: FaqTravel
   Description: A category-tabbed FAQ block for React and Next.js with horizontal tab navigation, animated panel transitions, count badges, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-travel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse answers by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a category to jump straight to the answers you need. Can't find what you're looking
                for? Our team replies in under an hour.
            </p>
        </div>

        @* Category tabs *@
        <div class="mt-10 flex gap-2 overflow-x-auto pb-2" role="tablist" aria-label="FAQ categories">
            @foreach (var cat in _faqCategories)
            {
                var category = cat;
                var isActive = category.Id == _activeCategory;
                <button type="button"
                        role="tab"
                        aria-selected="@isActive.ToString().ToLower()"
                        aria-controls="@($"faq-panel-{category.Id}")"
                        @onclick="@(() => SelectCategory(category.Id))"
                        class="@Cn.Merge("shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "bg-card text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                    @category.Label
                    <span class="@Cn.Merge("ml-2 rounded-full px-1.5 py-0.5 text-[10px]", isActive ? "bg-background/20" : "bg-muted")">
                        @category.Items.Length
                    </span>
                </button>
            }
        </div>

        @* Active panel *@
        @{
            var activeCategory = _faqCategories.FirstOrDefault(c => c.Id == _activeCategory) ?? _faqCategories[0];
        }
        <div id="@($"faq-panel-{activeCategory.Id}")"
             role="region"
             aria-label="@($"{activeCategory.Label} questions")"
             class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in activeCategory.Items)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-{activeCategory.Id}-{item.Id}-panel";
                var triggerId = $"faq-{activeCategory.Id}-{item.Id}-trigger";
                <div class="border-b last:border-0">
                    <button type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen.ToString().ToLower()"
                            aria-controls="@panelId"
                            @onclick="@(() => ToggleExpanded(item.Id))"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down"
                                      Size="20"
                                      aria-hidden="true"
                                      Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>
                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                Browse help center
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);
    private record FaqCategory(string Id, string Label, FaqItem[] Items);

    private string _activeCategory = "booking";
    private string? _expanded = "advance";

    private void SelectCategory(string categoryId)
    {
        _activeCategory = categoryId;
        var cat = _faqCategories.FirstOrDefault(c => c.Id == categoryId);
        _expanded = cat?.Items.Length > 0 ? cat.Items[0].Id : null;
    }

    private void ToggleExpanded(string itemId)
    {
        _expanded = _expanded == itemId ? null : itemId;
    }

    private static readonly FaqCategory[] _faqCategories =
    [
        new("booking", "Booking",
        [
            new("advance",
                "How far in advance should I book?",
                "Book domestic trips 2–3 months ahead and international trips 4–6 months out for the widest selection and best fares. Hotels can usually be booked 1–2 months in advance. Last-minute deals exist but are limited and often more expensive during peak season."),
            new("hold",
                "Can I hold a reservation before paying in full?",
                "Yes. Most bookings can be held for 24–48 hours with a 20% deposit. Full payment is due 30 days before international departures and 14 days before domestic. A valid credit card is required to hold any reservation."),
            new("insurance",
                "Do you offer travel insurance?",
                "We partner with two leading travel insurers to cover trip cancellation, medical emergencies, lost baggage, and delays. Insurance typically runs 4–8% of total trip cost and must be added within 14 days of your initial deposit to qualify for pre-existing condition coverage."),
        ]),
        new("cancellation", "Cancellation",
        [
            new("policy",
                "What is your cancellation policy?",
                "Cancel 30+ days before departure for a full refund minus a $50 processing fee. From 15–29 days, you receive a 50% refund. From 7–14 days, 25%. Inside 7 days, no refund — which is exactly why we recommend trip insurance."),
            new("modify",
                "Can I change my booking dates?",
                "Date changes are allowed up to 14 days before departure subject to availability and any fare difference. A $75 per-person change fee applies. Promotional fares may be non-changeable, so always check the fare rules before booking."),
        ]),
        new("documents", "Travel Docs",
        [
            new("passport",
                "What documents do I need for international travel?",
                "A passport valid for at least 6 months beyond your return date is required for most countries. Visa requirements vary — check 8–12 weeks before departure. Carry both digital and physical copies of your passport, insurance, and itinerary."),
            new("vaccines",
                "Do I need vaccinations or health certificates?",
                "Requirements vary by destination. Yellow fever vaccination is mandatory for parts of Africa and South America. Check the CDC travel notices and consult your doctor 4–6 weeks before departure to allow time for any boosters."),
        ]),
        new("luggage", "Luggage",
        [
            new("allowance",
                "What are the baggage allowances?",
                "Most airlines allow one carry-on and one personal item free. Checked bags vary from 1–2 bags up to 50 lbs each depending on fare class. International flights typically include 2 checked bags. Overweight or oversized bags incur fees of $100–300 each."),
            new("prohibited",
                "What items are prohibited in luggage?",
                "Carry-on: no liquids over 3.4 oz, no sharp objects, no lighters. Checked: no lithium batteries, flammables, or compressed gases. International travel adds restrictions on food, plants, and agricultural products. Always review TSA guidelines before packing."),
        ]),
        new("special", "Special",
        [
            new("accessibility",
                "Do you accommodate dietary or mobility needs?",
                "Yes. We arrange special meals (vegetarian, vegan, gluten-free, kosher, halal), wheelchair assistance, accessible rooms, and medical equipment transport. Request accommodations at booking and at least 72 hours before departure."),
            new("pets",
                "Can I travel with pets?",
                "Small pets under 20 lbs can fly in-cabin on most airlines for around $125 each way with 48 hours notice. Larger pets travel as cargo for $200–500. International pet travel requires health certificates and vaccinations — start the paperwork at least 8 weeks ahead."),
        ]),
    ];
}
