@* ============================================================
   Block: faq-with-emoji
   Title: FaqWithEmoji
   Description: A marketing-scale FAQ accordion block for React and Next.js with decorative emoji prefixes per question, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-emoji.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Friendly answers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Real questions, real warmth.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The everyday things people ask before they sign up. A small emoji on each one so the
                page feels like a conversation, not a contract.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-emoji-panel-{item.Id}";
                var triggerId = $"faq-emoji-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex min-w-0 flex-1 items-start gap-3 sm:gap-4">
                            <span aria-hidden="true" class="mt-0.5 text-xl shrink-0">
                                @item.Emoji
                            </span>
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Get started</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Chat with support</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "payments";

    private record FaqItem(string Id, string Emoji, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("payments", "💳",
            "What payment methods do you accept?",
            "Every major card (Visa, Mastercard, Amex, Discover) plus PayPal, Apple Pay, and Google Pay. Enterprise teams can pay by invoice on NET 30 terms. Stripe handles all transactions with PCI DSS Level 1 compliance."),
        new("security", "🔒",
            "How do you protect my personal data?",
            "Data is encrypted in transit with TLS 1.3 and at rest with AES-256. We're SOC 2 Type II audited, GDPR compliant, and we never sell personal information to third parties. Every employee completes annual security training."),
        new("refunds", "📦",
            "What is the refund and cancellation policy?",
            "Every new subscription comes with a 30-day money-back guarantee. Cancel anytime from your account settings — you keep access until the end of the current billing period and we'll refund the unused portion within one business day."),
        new("onboarding", "🚀",
            "How long does setup and onboarding take?",
            "Most teams finish initial setup in under 10 minutes. The onboarding wizard walks you through connecting data sources, configuring your first workflow, and inviting teammates. Enterprise rollouts ship inside 2 to 4 weeks."),
        new("team", "👥",
            "Can I invite my whole team?",
            "Pro and Enterprise plans support unlimited members with role-based access (Admin, Editor, Viewer). Add or remove seats anytime — billing is prorated to the day so you never overpay for a teammate who left."),
        new("international", "🌍",
            "Do you support international teams and languages?",
            "The product ships in 15 languages including Spanish, French, German, Japanese, and Mandarin. Pricing displays in your local currency, and 24/7 chat support covers every timezone with phone support during business hours in major regions."),
        new("analytics", "📊",
            "What kind of analytics and reporting do you offer?",
            "Real-time dashboards with customizable reports for usage, performance, and ROI. Export to CSV, Excel, or PDF, or pipe data into your BI tool through our API. Enterprise plans add predictive insights and a custom report builder."),
    ];
}
