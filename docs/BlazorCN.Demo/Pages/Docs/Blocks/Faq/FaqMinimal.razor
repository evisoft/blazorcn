@* ============================================================
   Block: faq-minimal
   Title: FaqMinimal
   Description: A marketing-scale FAQ minimal type-forward block for React and Next.js with no card chrome, generous whitespace, all answers visible at once, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Plain answers, plainly written.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Common questions about pricing, trials, and policies — laid out so you can read every
                answer in a single pass.
            </p>
        </div>

        @* Items *@
        <div class="mt-12 space-y-10">
            @foreach (var it in _faqItems)
            {
                var item = it;
                <div>
                    <h3 class="text-base font-semibold text-foreground sm:text-lg">
                        @item.Question
                    </h3>
                    <p class="mt-3 text-base leading-relaxed text-muted-foreground">@item.Answer</p>
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("q1",
            "How quickly can I get started?",
            "Sign-up takes 60 seconds. Create your workspace, invite your team, and start collaborating immediately with our intuitive interface and guided setup wizard."),
        new("q2",
            "Do I need a credit card for the free trial?",
            "No credit card required. Access every Pro feature for 14 days completely free. Choose a paid plan only when you're ready to continue."),
        new("q3",
            "Can I cancel my subscription anytime?",
            "Yes — cancel with one click from your account settings. Your access continues until the end of the billing period with no early termination fees."),
        new("q4",
            "What happens to my data if I cancel?",
            "Your data remains accessible for 60 days after cancellation. Export everything in JSON or CSV before permanent deletion. Reactivate anytime to restore full access."),
        new("q5",
            "Do you offer discounts for nonprofits or education?",
            "Yes — we provide 50% discounts for registered nonprofits and educational institutions. Contact our sales team with your organization details for verification."),
        new("q6",
            "How do you ensure data privacy?",
            "We never sell your data or share it with third parties. All data is encrypted in transit and at rest, with strict access controls and regular third-party security audits."),
    ];
}
