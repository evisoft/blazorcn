@* ============================================================
   Block: faq-fintech
   Title: FaqFintech
   Description: A grouped disclosure FAQ block for React and Next.js with category sections, inline trust badges, smooth height transitions, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-fintech.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The answers that build trust.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Real answers about transfers, security, and account access — with the credentials and
                certifications that back them up.
            </p>
        </div>

        @* Grouped disclosure *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var sec in _faqSections)
            {
                var faqSection = sec;
                var isOpen = _expandedSection == faqSection.Id;
                var panelId = $"faq-section-panel-{faqSection.Id}";
                var triggerId = $"faq-section-trigger-{faqSection.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expandedSection = isOpen ? null : faqSection.Id)"
                        class="flex w-full items-center justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex items-center gap-3">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @faqSection.Title
                            </span>
                            <span class="rounded-full border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
                                @faqSection.Items.Length
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden bg-muted/20">
                            <div class="divide-y border-t">
                                @foreach (var itm in faqSection.Items)
                                {
                                    var item = itm;
                                    <div class="px-6 py-5 sm:px-8 sm:py-6">
                                        <div class="flex flex-wrap items-start justify-between gap-3">
                                            <h3 class="text-base font-semibold text-foreground sm:text-lg">
                                                @item.Question
                                            </h3>
                                            @if (item.Badge != null)
                                            {
                                                <span class="inline-flex items-center rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-0.5 text-xs font-medium text-emerald-700 dark:text-emerald-400">
                                                    @item.Badge
                                                </span>
                                            }
                                        </div>
                                        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                                            @item.Answer
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Visit security center</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expandedSection = "transfers-payments";

    private record FaqItem(string Id, string Question, string Answer, string? Badge = null);
    private record FaqSection(string Id, string Title, FaqItem[] Items);

    private static readonly FaqSection[] _faqSections =
    [
        new("transfers-payments", "Transfers and payments",
        [
            new("transfer-time",
                "How long do transfers take?",
                "Domestic ACH transfers settle in 1-2 business days. Wire transfers go out the same day if submitted before 2pm ET. International transfers take 3-5 business days depending on the destination. Real-time payments are available for participating banks 24/7, including weekends."),
            new("fees",
                "What are your transfer fees?",
                "Domestic ACH is free for standard delivery and $2.99 for instant. Domestic wires are $15 outgoing, free incoming. International wires are $45 outgoing, $15 incoming. Transfers between your own accounts are always free, and volume discounts apply for business customers."),
            new("currencies",
                "What currencies do you support?",
                "We support 135+ currencies including USD, EUR, GBP, JPY, CAD, AUD, and CHF, plus most emerging market currencies. Conversions use mid-market rates with a 0.5-1% markup that varies by currency pair and amount, locked at the moment you confirm the transfer."),
        ]),
        new("security-compliance", "Security and compliance",
        [
            new("account-protection",
                "How do you protect my account?",
                "We use 256-bit AES encryption at rest and TLS 1.3 in transit. Multi-factor authentication is required for every login (SMS, authenticator app, or biometric). Real-time fraud monitoring runs on every transaction, and accounts are insured up to $250,000 through FDIC partner banks.",
                "FDIC insured"),
            new("kyc",
                "What is your KYC process?",
                "Identity verification is required within 24 hours of account creation. Provide a government-issued ID and proof of address less than 90 days old. Automated verification typically completes in 5-10 minutes; manual review for complex cases takes 1-2 business days."),
            new("regulation",
                "Are you regulated?",
                "We're licensed as a money services business with FinCEN, hold state money transmitter licenses in all 50 states, are PCI DSS Level 1 certified, and audited annually for SOC 2 Type II. We're a NACHA member and compliant with the Bank Secrecy Act and the USA PATRIOT Act.",
                "SOC 2 Type II"),
        ]),
        new("investment-accounts", "Investment and accounts",
        [
            new("investment-options",
                "What investment options are available?",
                "Commission-free trading for US stocks and ETFs, fractional shares starting at $1, and crypto trading for 30+ assets with a 0.5% spread. High-yield savings accounts pay 4.5% APY, and our managed portfolios start at $500 with a 0.25% annual fee."),
            new("withdrawals",
                "How do I withdraw investment funds?",
                "Stock and ETF sales settle in T+2. Crypto withdrawals process within an hour for amounts under $10,000. Savings withdrawals are instant up to $25,000 per day. There are no fees for standard withdrawals; expedited same-day delivery costs $10."),
        ]),
    ];
}
