@* ============================================================
   Block: faq-infinite-scroll
   Title: FaqInfiniteScroll
   Description: A marketing-scale paginated load-more FAQ block for React and Next.js with progressive reveal in batches, scroll-triggered fade-in, single-item expand, and a ShadcnioButton load-more control built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-infinite-scroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse the full FAQ at your pace.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                We start with the questions visitors ask most. Tap Load more to reveal the next batch
                without losing your place on the page.
            </p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems.Take(_visibleCount))
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"infinite-scroll-faq-panel-{item.Id}";
                var triggerId = $"infinite-scroll-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @if (_hasMore)
        {
            <div class="mt-6 flex flex-col items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" @onclick="LoadMore" Class="w-full sm:w-[220px]">
                    Load @(Math.Min(ItemsPerPage, _remaining)) more
                </ButtonCn>
                <p class="text-xs text-muted-foreground">
                    Showing @_visibleCount of @_faqItems.Length questions
                </p>
            </div>
        }

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private const int ItemsPerPage = 5;

    private string? _expanded = null;
    private int _visibleCount = ItemsPerPage;

    private int _remaining => _faqItems.Length - _visibleCount;
    private bool _hasMore => _remaining > 0;

    private void LoadMore()
    {
        _visibleCount = Math.Min(_visibleCount + ItemsPerPage, _faqItems.Length);
    }

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("account-setup",
            "How do I create an account?",
            "Click Sign Up in the top right and choose email, Google, or GitHub. After verifying your email, the onboarding wizard takes about five minutes — workspace setup, team invites, and plan selection."),
        new("password-reset",
            "How do I reset my password?",
            "Click Forgot Password on the login page and enter your email. You'll receive a reset link valid for 24 hours. If it doesn't arrive, check spam or contact support and we'll resend within a few minutes."),
        new("two-factor",
            "How do I enable two-factor authentication?",
            "Go to Settings → Security and click Enable 2FA. Scan the QR code with Google Authenticator, Authy, or 1Password, then enter the 6-digit code to confirm. Save your recovery codes somewhere safe."),
        new("billing-cycle",
            "When will I be charged for my subscription?",
            "You're charged on the day you first subscribe and again on the same day each billing period. Mid-cycle upgrades pay a prorated amount immediately, and your renewal date stays the same."),
        new("invoices",
            "How do I download invoices?",
            "Settings → Billing → Invoice History. Click any invoice for a PDF including itemized charges and payment method. For bulk downloads or custom formats, email billing@example.com."),
        new("cancel",
            "How do I cancel my subscription?",
            "Settings → Billing → Cancel Subscription. You'll keep access until the end of your current billing period. Components you've already integrated stay in your projects forever."),
        new("team-seats",
            "How do I add team members?",
            "Settings → Team → Invite Member. Add their email and pick a role (Admin, Developer, Viewer). They get an invite email and seat changes apply immediately with prorated billing."),
        new("install",
            "How do I install components?",
            "Use the CLI: `npx shadcn@latest add [component]`. Components require Next.js 16+, React 19+, and Tailwind CSS 4+. Update import paths to match your project's path alias."),
        new("modify-source",
            "Can I modify component source code?",
            "Yes — you receive the full unobfuscated source. Modify styling, logic, structure, or dependencies as needed. Updates won't overwrite your changes because you control the code locally."),
        new("typescript",
            "Do components include TypeScript types?",
            "Yes, every component ships with complete TypeScript definitions including prop types, return types, and generic constraints. We export interfaces for every data structure."),
        new("frameworks",
            "What frameworks are supported?",
            "Next.js 16+, React 19+, and Tailwind CSS 4+. TypeScript 5.0+ recommended but optional. We test against Node.js 20+ and Bun 1.0+."),
        new("commercial",
            "Can I use components in commercial projects?",
            "Yes — your subscription includes unlimited commercial use for client projects and SaaS apps. The only restriction is reselling components as a competing component library."),
        new("sso",
            "Do you support SSO?",
            "Organization plans include SAML 2.0 and OIDC integration with Okta, Azure AD, Google Workspace, and OneLogin. Setup takes 2–3 business days from when you provide identity provider details."),
        new("data-export",
            "Can I export my workspace data?",
            "Settings → Data & Privacy → Request Export. You'll receive a JSON file with all workspace data, configurations, and analytics within 24 hours. Export links stay valid for 7 days."),
        new("support",
            "What are support response times?",
            "Individual: 48 hours. Team: 12 hours. Organization: 2 hours for critical issues. Every plan also has access to docs, video tutorials, and community forums for self-service."),
    ];
}
