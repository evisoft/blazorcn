@* ============================================================
   Block: faq-with-code
   Title: FaqWithCode
   Description: A marketing-scale developer FAQ accordion block for React and Next.js with embedded code snippet answers, single-item expand, monospace pre/code blocks, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-code.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Developer FAQ
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Code answers, not just words.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer ships with a copy-pasteable TypeScript example, so you can move from
                reading to shipping without leaving the page.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in _faqItems)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var panelId = $"with-code-faq-panel-{item.Id}";
                var triggerId = $"with-code-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        aria-controls="@panelId"
                        @onclick="@(() => Toggle(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="space-y-4 px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <div class="overflow-hidden rounded-md border bg-muted">
                                    <div class="flex items-center justify-between border-b bg-muted px-4 py-2">
                                        <span class="font-mono text-xs text-muted-foreground">
                                            @item.Language
                                        </span>
                                    </div>
                                    <pre class="overflow-x-auto rounded-md bg-muted p-4 font-mono text-sm"><code>@item.CodeSnippet</code></pre>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read API docs</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Contact support
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer, string Language, string CodeSnippet);

    private string? _expanded = "auth";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static readonly FaqItem[] _faqItems =
    [
        new("auth",
            "How do I authenticate API requests?",
            "Pass your API key as a Bearer token in the Authorization header. Generate scoped keys in Settings → API Keys and rotate them anytime — never check keys into version control.",
            "typescript",
            "const response = await fetch(\"https://api.example.com/v1/data\", {\n  headers: {\n    Authorization: `Bearer ${process.env.API_KEY}`,\n    \"Content-Type\": \"application/json\",\n  },\n})\n\nconst data = await response.json()"),
        new("rate-limits",
            "How do I read rate limit headers?",
            "Every response ships with X-RateLimit headers showing your current usage and reset time. Pro accounts get 1,000 requests per hour and Enterprise accounts get 10,000 — log these headers to track usage live.",
            "typescript",
            "console.log(response.headers.get(\"X-RateLimit-Limit\"))\nconsole.log(response.headers.get(\"X-RateLimit-Remaining\"))\nconsole.log(response.headers.get(\"X-RateLimit-Reset\"))"),
        new("webhooks",
            "How do I verify webhook signatures?",
            "Compute an HMAC-SHA256 of the request body with your webhook secret and compare it against the X-Webhook-Signature header using a timing-safe equality check.",
            "typescript",
            "import crypto from \"node:crypto\"\n\nexport function verifyWebhook(payload: string, signature: string, secret: string) {\n  const hmac = crypto.createHmac(\"sha256\", secret)\n  const digest = hmac.update(payload).digest(\"hex\")\n  return crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(digest))\n}"),
        new("pagination",
            "How do I paginate large result sets?",
            "Use cursor-based pagination via the cursor query parameter. Each response includes a nextCursor field — pass it back to fetch the next page until nextCursor is null.",
            "typescript",
            "async function fetchAllItems() {\n  const items = []\n  let cursor: string | null = null\n\n  do {\n    const url = cursor ? `/api/items?cursor=${cursor}` : \"/api/items\"\n    const res = await fetch(url)\n    const page = await res.json()\n    items.push(...page.items)\n    cursor = page.nextCursor\n  } while (cursor)\n\n  return items\n}"),
        new("retry",
            "How do I implement retry with exponential backoff?",
            "Retry only on 429 and 5xx responses. Wait progressively longer between attempts and add jitter so concurrent clients don't synchronize their retries into a thundering herd.",
            "typescript",
            "async function fetchWithRetry(url: string, maxRetries = 3) {\n  for (let i = 0; i < maxRetries; i++) {\n    const res = await fetch(url)\n    if (res.ok) return res\n    if (![429, 500, 502, 503].includes(res.status)) throw new Error(res.statusText)\n    const delay = Math.min(1000 * 2 ** i, 10000) + Math.random() * 1000\n    await new Promise((resolve) => setTimeout(resolve, delay))\n  }\n  throw new Error(\"Max retries exceeded\")\n}"),
        new("batch",
            "How do I batch multiple operations in one request?",
            "POST a list of operations to /v1/batch. Each operation is processed independently and you receive an ordered array of responses — useful for cutting round-trip latency on bulk work.",
            "typescript",
            "const res = await fetch(\"https://api.example.com/v1/batch\", {\n  method: \"POST\",\n  headers: {\n    Authorization: `Bearer ${process.env.API_KEY}`,\n    \"Content-Type\": \"application/json\",\n  },\n  body: JSON.stringify({\n    operations: [\n      { method: \"GET\", path: \"/users/123\" },\n      { method: \"POST\", path: \"/items\", body: { name: \"Item\" } },\n      { method: \"DELETE\", path: \"/items/456\" },\n    ],\n  }),\n})\n\nconst results = await res.json()"),
    ];
}
