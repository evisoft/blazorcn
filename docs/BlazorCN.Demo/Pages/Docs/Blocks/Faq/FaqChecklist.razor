@* ============================================================
   Block: faq-checklist
   Title: FaqChecklist
   Description: A marketing-scale checklist FAQ block for React and Next.js with checkable steps, progress bar, localStorage persistence, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Getting started
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Your setup checklist.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Seven steps from sign-up to your first shipped workflow. Tick each one off as you go —
                we'll keep your progress saved on this device.
            </p>
        </div>

        @* Progress + checklist *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            <div class="border-b px-6 py-5 sm:px-8 sm:py-6">
                <div class="flex items-center justify-between text-sm">
                    <span class="font-medium text-muted-foreground">Progress</span>
                    <span class="font-semibold text-foreground">
                        @_checkedItems.Count of @_faqSteps.Length completed
                    </span>
                </div>
                <ProgressCn Value="@_completionPercentage" Class="mt-3 h-2" aria-label="Progress" />
            </div>

            <div class="divide-y">
                @foreach (var it in _faqSteps)
                {
                    var step = it;
                    var isChecked = _checkedItems.Contains(step.Id);
                    <div class="px-6 py-5 sm:px-8 sm:py-6">
                        <div class="flex items-start gap-4">
                            <CheckboxCn Id="@($"checklist-{step.Id}")" Checked="@isChecked" CheckedChanged="@((bool v) => HandleCheck(step.Id, v))" Class="mt-1" />
                            <label for="@($"checklist-{step.Id}")" class="flex-1 cursor-pointer space-y-2">
                                <span class="@Cn.Merge("block text-base font-semibold sm:text-lg", isChecked ? "text-muted-foreground line-through" : "text-foreground")">
                                    @step.Question
                                </span>
                                @if (!isChecked)
                                {
                                    <span class="block overflow-hidden text-base leading-relaxed text-muted-foreground">
                                        @step.Answer
                                    </span>
                                }
                            </label>
                            <div class="shrink-0">
                                @if (isChecked)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-500" aria-hidden="true" />
                                }
                                else
                                {
                                    <LucideIconCn Name="circle" Size="20" Class="size-5 text-muted-foreground/40" aria-hidden="true" />
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_completionPercentage >= 100)
            {
                <div class="overflow-hidden border-t bg-emerald-500/10">
                    <div class="flex items-center gap-3 px-6 py-5 sm:px-8">
                        <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-500" aria-hidden="true" />
                        <p class="text-sm font-semibold text-foreground">
                            Congratulations — you've completed every setup step.
                        </p>
                    </div>
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private readonly HashSet<string> _checkedItems = new();

    private double _completionPercentage => _faqSteps.Length == 0 ? 0 : (_checkedItems.Count / (double)_faqSteps.Length) * 100;

    private void HandleCheck(string id, bool isChecked)
    {
        if (isChecked)
            _checkedItems.Add(id);
        else
            _checkedItems.Remove(id);
    }

    private record FaqStep(string Id, string Question, string Answer);

    private static readonly FaqStep[] _faqSteps =
    [
        new("account-setup",
            "Set up your account profile",
            "Complete your profile with name, company, and avatar. This helps teammates recognize you and improves collaboration. You can update your profile anytime from Settings."),
        new("invite-team",
            "Invite your team members",
            "Add team members by email to collaborate on projects. They receive an invitation link with onboarding instructions. Assign roles and permissions during the invite, and members appear in your dashboard immediately."),
        new("create-project",
            "Create your first project",
            "Projects organize work into manageable containers. Click New Project, pick a template or start from scratch, and invite collaborators. Each project gets its own settings, permissions, and activity feed."),
        new("configure-api",
            "Configure API keys",
            "Generate API keys from Settings → Developer. Each key supports scoped permissions for security. Store keys securely and never commit them to version control. Rotate keys without downtime using staged rotation."),
        new("setup-webhooks",
            "Set up webhook endpoints",
            "Configure webhooks to receive real-time notifications for events. Specify your endpoint URL and select event types. We send a verification request to confirm your endpoint, and payloads include signatures for verification."),
        new("integrate-tools",
            "Integrate with your existing tools",
            "Connect through our integrations marketplace. We support Slack, GitHub, Jira, and 50+ other platforms. Most integrations use OAuth and take under two minutes. Custom integrations are available via our REST API."),
        new("test-workflow",
            "Test your first workflow",
            "Run a test workflow to verify your setup. Use sample data or your own. Monitor execution in real time with our debugging tools, check logs for errors, and adjust configuration as needed. Most workflows complete in under five seconds."),
    ];
}
