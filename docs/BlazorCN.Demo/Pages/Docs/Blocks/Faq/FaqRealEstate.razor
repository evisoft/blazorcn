@* ============================================================
   Block: faq-real-estate
   Title: FaqRealEstate
   Description: A marketing-scale FAQ accordion block for React and Next.js with inline highlight badges per question, single-item expand, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-real-estate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Home buyer guide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The numbers, before the paperwork.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Financing, inspections, closing costs, and timeline — the answers first-time buyers need
                before they tour a single house.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-realestate-panel-{item.Id}";
                var triggerId = $"faq-realestate-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            @if (item.Highlight != null)
                            {
                                <span class="mt-2 inline-flex items-center rounded-full border bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                                    @item.Highlight
                                </span>
                            }
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Get pre-approved</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Talk to an agent</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "financing";

    private record FaqItem(string Id, string Question, string Answer, string? Highlight = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("financing",
            "What financing options are available for home buyers?",
            "Most buyers use conventional mortgages (620+ credit, 3-20% down), FHA loans (580+ credit, 3.5% down — ideal for first-time buyers), VA loans (0% down for eligible veterans, no PMI), or USDA loans (0% down for rural properties). Pre-approval takes 1-3 days and tells sellers you're serious. Current rates run 6.5-7.5% depending on credit, loan type, and down payment.",
            "3-20% down typical"),
        new("inspections",
            "What happens during a home inspection?",
            "A licensed inspector spends 2-4 hours examining the foundation, roof, electrical, plumbing, HVAC, and appliances and delivers a detailed report within 48 hours. Cost runs $300-600 depending on size. Findings can drive repair requests, seller credits, price renegotiation, or — if your contract has an inspection contingency — a clean walk-away.",
            "$300-600 typical"),
        new("closing-costs",
            "What are closing costs and how much should I expect?",
            "Closing costs run 2-5% of the home price ($6,000-$15,000 on a $300,000 purchase). Buyer costs include loan origination, appraisal, title insurance, attorney fees, prorated taxes, first-year homeowners insurance, and recording fees. Sellers cover agent commissions. Your Loan Estimate within 3 days of applying spells out exact numbers, and many costs are negotiable in a buyer's market.",
            "2-5% of home price"),
        new("timeline",
            "How long does it take to buy a house?",
            "From accepted offer to closing typically takes 30-45 days for financed purchases and 7-14 days for cash deals. The breakdown: 7-10 days for inspection, 7-14 days for appraisal, 2-3 weeks for final mortgage approval, plus a 24-hour walkthrough before closing day. House hunting itself is 2-8 weeks depending on the market. Build a buffer if you have move-out deadlines.",
            "30-45 days typical"),
        new("commission",
            "How does agent commission work and who pays?",
            "Total commission is typically 5-6% of the sale price, split between listing and buyer agents. The seller pays it from sale proceeds, so buyers don't write a separate check. Commission is negotiable in competitive markets and lower at discount brokerages. For Sale By Owner saves the fee but typically sells for 6-10% less due to limited exposure and negotiating leverage.",
            "5-6% of sale price"),
        new("first-time",
            "Are there programs for first-time home buyers?",
            "Yes — FHA loans with 3.5% down, state and local down payment assistance ($5,000-$25,000 grants or forgivable loans), penalty-free IRA withdrawals up to $10,000, reduced lender fees, and required homebuyer education courses that build budgeting and credit skills. Eligibility usually means you haven't owned a home in three years. Check with your local housing authority for what's available where you live.",
            "Down to 3.5% down"),
    ];
}
