@* ============================================================
   Block: faq-with-stats
   Title: FaqWithStats
   Description: A marketing-scale FAQ block for React and Next.js with a top metric bar, semantic dl/dt/dd, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Backed by the numbers.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Real operational metrics from the support team that answers these questions every day.
                The proof is on the floor, not in the marketing.
            </p>
        </div>

        @* Metric bar *@
        <dl class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-3">
            @foreach (var metric in _metrics)
            {
                <div class="rounded-xl border bg-card px-5 py-5 text-center">
                    <dt class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        @metric.Label
                    </dt>
                    <dd class="mt-1 text-2xl font-bold tabular-nums tracking-tight text-foreground">
                        @metric.Value
                    </dd>
                    <dd class="mt-0.5 text-xs text-muted-foreground">@metric.Sub</dd>
                </div>
            }
        </dl>

        @* Accordion *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-stats-panel-{item.Id}";
                var triggerId = $"faq-stats-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "billing";

    private record Metric(string Id, string Label, string Value, string Sub);
    private record FaqItem(string Id, string Question, string Answer);

    private static readonly Metric[] _metrics =
    [
        new("answered", "Questions answered", "12K+", "Last 90 days"),
        new("resolution", "Resolution rate", "98%", "First reply"),
        new("response", "Response time", "< 1hr", "Median weekday"),
    ];

    private static readonly FaqItem[] _faqItems =
    [
        new("billing",
            "What payment methods do you accept?",
            "We accept every major credit card (Visa, Mastercard, Amex, Discover), PayPal, and bank transfer for annual plans. All payments run through Stripe with PCI DSS compliance. Enterprise customers can bill by invoice with NET 30 terms."),
        new("trial",
            "Do you offer a free trial?",
            "Yes — every plan includes a 14-day free trial with full feature access. No credit card required to start. You can upgrade at any time during or after the trial, and your sample data carries over the moment you switch."),
        new("cancel",
            "Can I cancel my subscription anytime?",
            "Cancel from your account dashboard in two clicks. There are no cancellation fees and you keep access until the end of your billing period. New subscriptions also include a 30-day money-back guarantee, no questions asked."),
        new("security",
            "How do you handle data security?",
            "All data is encrypted in transit with TLS 1.3 and at rest with AES-256. We maintain SOC 2 Type II compliance, run quarterly third-party penetration tests, and back up across three geographically redundant regions every six hours."),
        new("support",
            "What kind of support do you provide?",
            "Every plan includes email support with a sub-hour median first response. Pro and Enterprise add live chat, dedicated success managers, and a private Slack channel. Documentation, tutorials, and a community forum are open to everyone."),
        new("integrations",
            "Does it integrate with my existing tools?",
            "Native integrations ship for Slack, Microsoft Teams, Salesforce, HubSpot, Zapier, and over 100 other tools. A REST API and webhooks cover everything else, and Enterprise plans include dedicated integration support and raised rate limits."),
    ];
}
