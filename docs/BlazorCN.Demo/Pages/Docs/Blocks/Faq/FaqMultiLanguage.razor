@* ============================================================
   Block: faq-multi-language
   Title: FaqMultiLanguage
   Description: A multilingual FAQ accordion block for React and Next.js with language switcher chips, translated content, smooth transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-multi-language.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_content.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                @_content.Title
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                @_content.Subtitle
            </p>
        </div>

        @* Language switcher chips *@
        <div role="tablist" aria-label="Select language" class="mt-8 flex flex-wrap items-center justify-center gap-2">
            @foreach (var lang in _languages)
            {
                var isActive = lang.Code == _language;
                <button
                    type="button"
                    role="tab"
                    aria-selected="@isActive.ToString().ToLower()"
                    @onclick="@(() => SetLanguage(lang.Code))"
                    class="@Cn.Merge("inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-card text-foreground hover:bg-muted/60")">
                    <span
                        aria-hidden="true"
                        class="@Cn.Merge("font-mono text-[10px] tracking-wider", isActive ? "text-background/70" : "text-muted-foreground")">
                        @lang.Flag
                    </span>
                    @lang.Label
                </button>
            }
        </div>

        @* Accordion *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _content.Faqs)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-ml-panel-{_language}-{item.Id}";
                var triggerId = $"faq-ml-trigger-{_language}-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Request a language</ButtonCn>
        </div>
    </div>
</section>

