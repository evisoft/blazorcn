@* ============================================================
   Block: faq-newsletter
   Title: FaqNewsletter
   Description: A marketing FAQ accordion block for React and Next.js with an embedded newsletter subscribe input, success state, and validated email capture built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-newsletter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Get the answers in your inbox.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The short answers below — and the long-form tutorials in the weekly newsletter. Join
                12,000+ builders getting practical web tips every Friday.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-nl-panel-{item.Id}";
                var triggerId = $"faq-nl-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Newsletter CTA *@
        <div class="mt-10">
            @if (_isSubscribed)
            {
                <div aria-live="polite" class="mx-auto flex max-w-md flex-col items-center gap-3 rounded-2xl border bg-card px-6 py-8 text-center">
                    <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check-circle-2" Size="24" Class="size-6 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                    </div>
                    <h3 class="text-lg font-semibold text-foreground">You're subscribed.</h3>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        Check your inbox for a confirmation. Your first issue arrives this Friday.
                    </p>
                </div>
            }
            else
            {
                <div class="mx-auto flex max-w-md flex-col items-center gap-3 text-center">
                    <div class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                        <LucideIconCn Name="mail" Size="14" Class="size-3.5" aria-hidden="true" />
                        Weekly newsletter
                    </div>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        Join 12,000+ builders. One email a week, unsubscribe anytime.
                    </p>
                    <div class="flex w-full flex-col gap-3 sm:flex-row sm:justify-center">
                        <InputCn
                            type="email"
                            required="required"
                            Placeholder="@("you@company.com")"
                            Value="@_email"
                            ValueChanged="@((string v) => _email = v)"
                            Disabled="@_isSubmitting"
                            aria-label="Email address"
                            Class="h-11 w-full sm:w-[260px]" />
                        <ButtonCn
                            type="submit"
                            disabled="@_isSubmitting"
                            Class="w-full sm:w-[160px]"
                            OnClick="HandleSubscribe">
                            @(_isSubmitting ? "Subscribing…" : "Subscribe")
                        </ButtonCn>
                    </div>
                    <p class="text-xs text-muted-foreground">
                        We respect your inbox. No spam, ever.
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "frequency";
    private string _email = "";
    private bool _isSubmitting = false;
    private bool _isSubscribed = false;

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("frequency",
            "How often do you publish new content?",
            "We ship new tutorials and case studies every Tuesday and Thursday, and the newsletter sends a curated weekly digest every Friday morning. Premium members get every new piece 48 hours before it goes public."),
        new("topics",
            "What topics does the newsletter cover?",
            "React, Next.js, TypeScript, web performance, accessibility, and modern CSS. Every issue includes practical patterns with working code you can drop into production — no theoretical fluff and no rehashed framework news."),
        new("cost",
            "Is there a cost to subscribe?",
            "The newsletter is completely free, forever. Premium membership ($12/month) unlocks advanced tutorials, downloadable code templates, and the private Discord community. Free is more than enough to learn what you need."),
        new("suggest",
            "Can I suggest topics for future issues?",
            "Yes — reply to any newsletter with a topic and we read every one. Community-requested topics jump the queue, and Discord members can vote on what we cover next so the editorial calendar follows real demand."),
        new("support",
            "Do you offer technical support?",
            "Free subscribers can email questions and get a 48-hour response. Premium members get priority Discord support with sub-4-hour replies on weekdays, plus monthly live Q&A sessions where you can ask anything."),
        new("unsubscribe",
            "How do I unsubscribe?",
            "Every newsletter has a one-click unsubscribe link in the footer. You can also pause emails or change frequency from your account settings. We respect your inbox and never share your email with anyone else."),
    ];

    private async Task HandleSubscribe()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        await Task.Delay(1200);
        _isSubmitting = false;
        _isSubscribed = true;
    }
}
