@* ============================================================
   Block: faq-numbered
   Title: FaqNumbered
   Description: A marketing FAQ accordion block for React and Next.js with monospace numbered badges, single-item expand, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-numbered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Getting started
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Step by step, in order.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The questions every new team asks during their first week — answered in the order most
                people hit them.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var index = System.Array.IndexOf(_faqItems, item);
                var isOpen = _expanded == item.Id;
                var number = (index + 1).ToString().PadLeft(2, '0');
                var panelId = $"faq-num-panel-{item.Id}";
                var triggerId = $"faq-num-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:gap-5 sm:px-8 sm:py-6">
                        <span
                            aria-hidden="true"
                            class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full border font-mono text-xs font-semibold transition-colors", isOpen ? "border-foreground bg-foreground text-background" : "border-border bg-muted/40 text-muted-foreground")">
                            @number
                        </span>
                        <span class="flex-1 text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-[76px] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[88px]">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start the tutorial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "first-project";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("first-project",
            "How do I create my first project?",
            "Click 'New project' on your dashboard, choose a starter template or start blank, and give it a name. Your workspace is created instantly with sensible defaults — invite teammates and start collaborating within a couple of minutes."),
        new("import",
            "Can I import data from other tools?",
            "Yes. We support CSV, Excel, and Google Sheets imports plus direct integrations with 50+ platforms including Trello, Asana, Notion, and Monday. The import wizard maps fields automatically and preserves relationships between items."),
        new("permissions",
            "How do permissions work for team members?",
            "Assign roles at the workspace or project level: Owner, Admin, Editor, or Viewer. Create custom roles with granular permissions, and every change applies immediately with audit logs tracking exactly who modified access and when."),
        new("backups",
            "What backup options are available?",
            "Automated backups run every 6 hours with 30-day retention on every plan. Manual backups can be triggered any time from settings, and Enterprise plans include point-in-time recovery, custom retention windows, and scheduled exports to your own S3 bucket."),
        new("workflows",
            "How do I set up custom workflows?",
            "Open Settings → Workflows and click 'Create workflow'. Define triggers (new item, status change, due date), conditions, and actions like sending notifications or assigning users. Test in sandbox mode before activating in production."),
        new("notifications",
            "Can I customize notification preferences?",
            "Yes. Control notifications at the global, workspace, and project levels. Choose delivery channels (email, in-app, Slack), frequency (real-time, daily digest, weekly summary), and set quiet hours so you never get pinged at 3am."),
        new("analytics",
            "What analytics and reporting features are included?",
            "Built-in dashboards show activity trends, team performance, and project health. Build custom reports with filters, grouping, and export to PDF or Excel. Pro plans unlock advanced analytics with custom date ranges and comparative views."),
    ];
}
