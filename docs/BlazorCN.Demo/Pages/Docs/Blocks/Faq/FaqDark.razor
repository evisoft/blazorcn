@* ============================================================
   Block: faq-dark
   Title: FaqDark
   Description: A dark-inset FAQ accordion block for React and Next.js with an inverted panel, single-expand disclosure, smooth height transitions, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-dark.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything you need to know.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The short answers to the questions our customers ask most. Set against a darker panel so
                they're impossible to miss as you scroll the page.
            </p>
        </div>

        @* Dark inset panel *@
        <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/10 bg-foreground text-background">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-dark-panel-{item.Id}";
                var triggerId = $"faq-dark-trigger-{item.Id}";
                <div class="border-b border-background/10 last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-background/5 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-background sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-background/60 transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-background/70 sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "data-after-cancel";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("data-after-cancel",
            "What happens to my data if I cancel my subscription?",
            "Your data stays accessible for 30 days after cancellation so you can reactivate or export it. After 30 days, all data is permanently deleted from our servers in compliance with GDPR. We email a reminder before the deletion window closes."),
        new("annual-refunds",
            "Do you offer refunds for annual subscriptions?",
            "Yes. Annual plans include a 30-day money-back guarantee — no questions asked. After 30 days, annual plans receive a prorated refund if you cancel within the first 90 days. Refunds land in your account in 5 to 7 business days."),
        new("plan-changes",
            "Can I upgrade or downgrade my plan anytime?",
            "Yes. Change plans anytime from your account dashboard. Upgrades apply immediately with prorated billing for the current period. Downgrades take effect at the next billing cycle so you keep the value of your current plan."),
        new("payment-security",
            "Is my payment information secure?",
            "All payments run through Stripe with PCI DSS Level 1 certification. We never store your credit card details on our servers, and every transaction is encrypted in transit with TLS 1.3 and at rest with AES-256."),
        new("nonprofit-discount",
            "Do you offer discounts for nonprofits or schools?",
            "Yes. We offer a 40% discount for verified nonprofits and educational institutions on both monthly and annual plans. Email sales with your organization's documentation and we'll have the discount applied within one business day."),
        new("trial-included",
            "What's included in the free trial?",
            "The 14-day free trial unlocks every feature on the Pro plan with no credit card required. You'll get unlimited projects, advanced analytics, priority support, and full API access. Cancel anytime during the trial without charge."),
        new("support-channels",
            "How do I contact support?",
            "Pro plans get priority email support with a 4-hour response time during business hours. Enterprise customers receive a dedicated Slack channel and 24/7 phone support. Free plans have access to the community forum and full knowledge base."),
        new("client-projects",
            "Can I use this for client projects?",
            "Yes. Pro and Enterprise plans include commercial usage rights for client work. You can ship unlimited client projects and retain ownership of everything you build. Attribution is appreciated but never required."),
    ];
}
