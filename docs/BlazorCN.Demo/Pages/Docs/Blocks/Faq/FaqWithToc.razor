@* ============================================================
   Block: faq-with-toc
   Title: FaqWithToc
   Description: A marketing-scale FAQ block for React and Next.js with a sticky left-rail table of contents, scroll-spy active highlighting, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-toc.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Jump to any answer.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A sticky table of contents on the left tracks where you are on the page so you can
                navigate long answers without losing your place.
            </p>
        </div>

        @* TOC + Accordion *@
        <div class="mt-10 grid gap-8 lg:grid-cols-[240px_1fr] lg:gap-12">
            @* Sticky TOC *@
            <aside class="lg:sticky lg:top-24 lg:self-start">
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    On this page
                </p>
                <nav class="mt-4 space-y-5">
                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        <div>
                            <p class="text-xs font-semibold text-foreground">@category</p>
                            <ul class="mt-2 space-y-1">
                                @foreach (var it in _faqItems)
                                {
                                    var item = it;
                                    if (item.Category == category)
                                    {
                                        var isActive = _activeId == item.Id;
                                        <li>
                                            <button
                                                type="button"
                                                @onclick="@(() => ScrollToQuestion(item.Id))"
                                                aria-current="@(isActive ? "true" : null)"
                                                class="@Cn.Merge("block w-full border-l-2 py-1 pl-3 text-left text-xs leading-snug transition-colors", isActive ? "border-foreground text-foreground" : "border-transparent text-muted-foreground hover:text-foreground")">
                                                @item.Question
                                            </button>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                </nav>
            </aside>

            @* Accordion *@
            <div class="overflow-hidden rounded-2xl border bg-card">
                @foreach (var it in _faqItems)
                {
                    var item = it;
                    var isOpen = _expanded == item.Id;
                    var panelId = $"faq-toc-panel-{item.Id}";
                    var triggerId = $"faq-toc-trigger-{item.Id}";
                    <div id="@item.Id" class="border-b last:border-0">
                        <button
                            type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen"
                            aria-controls="@panelId"
                            @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                            <div class="min-w-0 flex-1">
                                <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                                    @item.Category
                                </p>
                                <span class="mt-1 block text-base font-semibold text-foreground sm:text-lg">
                                    @item.Question
                                </span>
                            </div>
                            <LucideIconCn Name="chevron-down" Size="20"
                                Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")"
                                aria-hidden="true" />
                        </button>

                        @if (isOpen)
                        {
                            <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                    @item.Answer
                                </p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Browse the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "account-setup";
    private string _activeId = "account-setup";

    private void ScrollToQuestion(string id)
    {
        _activeId = id;
        _expanded = id;
    }

    private record FaqItem(string Id, string Category, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("account-setup",
            "Getting started",
            "How do I create an account and set up my workspace?",
            "Click Sign Up in the top right and choose email, Google, or GitHub. After verifying, the onboarding wizard walks you through naming your workspace, inviting teammates, and downloading the CLI. Setup takes about five minutes from sign-up to first deploy."),
        new("component-installation",
            "Getting started",
            "What's the recommended way to install components?",
            "Use the CLI for the fastest path: run npx shadcn@latest add button to install with all dependencies. Or browse components in your dashboard and copy the source. The CLI updates tailwind.config and imports for you, while the manual route is fully controllable."),
        new("plan-comparison",
            "Billing & plans",
            "What are the differences between subscription tiers?",
            "Individual ($20/mo) includes one seat and every premium component. Team ($40/mo) adds five seats, priority support, and shared workspaces. Organization ($80/mo) is unlimited seats with SSO, dedicated support, and SLA guarantees. Annual plans save 20%."),
        new("payment-methods",
            "Billing & plans",
            "What payment methods do you accept?",
            "All major credit and debit cards through Stripe. ACH and wire transfers are available on Organization plans. PayPal works for monthly and annual subscriptions. For lifetime purchases over $1,000 we can issue invoices payable by check or PO with NET-30 terms."),
        new("upgrade-downgrade",
            "Billing & plans",
            "Can I upgrade or downgrade my plan at any time?",
            "Yes. Open Settings, Billing, then change plans. Upgrades are prorated immediately and your renewal date stays the same. Downgrades take effect at the next renewal so you keep current features until then. Cancel anytime with no penalties."),
        new("framework-compatibility",
            "Technical",
            "Which frameworks and versions are supported?",
            "Components target Next.js 16+ with the App Router and React 19+. TypeScript 5.0+ is recommended, JavaScript works fine. Tailwind CSS 4.0+ is required for styling. We test against Node.js 20+ and Bun 1.0+, and patch within 48 hours of new framework releases."),
        new("component-customization",
            "Technical",
            "How much can I customize the components?",
            "Components are fully customizable — you get unobfuscated source code. Modify Tailwind classes, change structure, add props, or rewrite internals entirely. Architectural docs explain the design patterns used so extending components feels obvious instead of risky."),
        new("typescript-support",
            "Technical",
            "Are the components fully typed with TypeScript?",
            "Yes, every component ships with complete TypeScript definitions. We export interfaces for data structures so extending them in your project is trivial. Components use strict mode and pass type checking with no errors. JavaScript users get the same components without types."),
        new("team-collaboration",
            "Team features",
            "How do team workspaces and collaboration work?",
            "Team workspaces let five developers share components, design tokens, and project configs. Invite via email from Settings, Team. Members get Admin, Developer, or Viewer roles. Shared design tokens keep theming consistent and activity logs track every download."),
        new("support-response-times",
            "Support",
            "What are the support response times for each plan?",
            "Individual gets email support with a 48-hour response. Team gets priority support at 12 hours. Organization includes 2-hour critical response, dedicated Slack channels, and scheduled debugging sessions. Docs, tutorials, and forums are open to every plan."),
    ];

    private static readonly string[] _categories =
    [
        "Getting started",
        "Billing & plans",
        "Technical",
        "Team features",
        "Support",
    ];
}
