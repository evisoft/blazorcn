@* ============================================================
   Block: faq-command-palette
   Title: FaqCommandPalette
   Description: A keyboard-first command palette FAQ block for React and Next.js with Cmd+K trigger, fuzzy search, instant filtering, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-command-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Search anything in milliseconds.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hit ⌘K to open the command palette and fuzzy-search every answer, or browse the list
                below. Built for teams who live on the keyboard.
            </p>
        </div>

        @* Command trigger *@
        <div class="mt-8">
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-12 w-full justify-between rounded-xl" @onclick="@(() => _open = true)">
                <span class="flex items-center gap-2 text-muted-foreground">
                    <LucideIconCn Name="search" Size="16" Class="size-4" aria-hidden="true" />
                    Search questions...
                </span>
                <kbd class="pointer-events-none inline-flex h-6 select-none items-center gap-1 rounded border bg-muted px-2 font-mono text-[11px] font-medium text-muted-foreground">
                    <LucideIconCn Name="command" Size="12" Class="size-3" aria-hidden="true" />K
                </kbd>
            </ButtonCn>
        </div>

        @* Inline FAQ list *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-cmdk-panel-{item.Id}";
                var triggerId = $"faq-cmdk-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="flex min-w-0 flex-col gap-2">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <span class="inline-flex w-fit items-center rounded-full border bg-muted px-2 py-0.5 font-mono text-[11px] font-medium text-muted-foreground">
                                @item.Category
                            </span>
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@* Command Dialog *@
<DialogCn Open="@_open" OpenChanged="@((v) => _open = v)">
    <DialogContentCn Class="overflow-hidden p-0" ShowCloseButton="false">
        @* Command palette shell *@
        <div data-slot="command" class="flex h-full w-full flex-col overflow-hidden rounded-md bg-popover text-popover-foreground">
            @* CommandInput *@
            <div class="flex items-center border-b px-3" cmdk-input-wrapper="">
                <LucideIconCn Name="search" Size="16" Class="mr-2 size-4 shrink-0 opacity-50" />
                <input
                    type="text"
                    placeholder="Search questions..."
                    @bind="_searchQuery"
                    @bind:event="oninput"
                    class="flex h-10 w-full rounded-md bg-transparent py-3 text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50" />
            </div>
            @* CommandList *@
            <div class="max-h-[300px] scroll-py-1 overflow-x-hidden overflow-y-auto" role="listbox">
                @{
                    var filtered = _faqItems.Where(f =>
                        string.IsNullOrWhiteSpace(_searchQuery) ||
                        f.Question.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        f.Answer.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        f.Category.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                    ).ToArray();
                }
                @if (filtered.Length == 0)
                {
                    <div class="py-6 text-center text-sm text-muted-foreground">No results found.</div>
                }
                else
                {
                    @* CommandGroup *@
                    <div class="overflow-hidden p-1 text-foreground">
                        <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">Questions</div>
                        @foreach (var faq in filtered)
                        {
                            var faqItem = faq;
                            <button
                                type="button"
                                role="option"
                                class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50"
                                @onclick="@(() => SelectFaq(faqItem.Id))">
                                <div class="flex flex-col gap-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@faqItem.Question</span>
                                        <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                                            @faqItem.Category
                                        </span>
                                    </div>
                                    <span class="line-clamp-1 text-xs text-muted-foreground">
                                        @faqItem.Answer
                                    </span>
                                </div>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open = false;
    private string? _expanded = null;
    private string _searchQuery = "";

    private void SelectFaq(string id)
    {
        _expanded = id;
        _open = false;
        _searchQuery = "";
    }

    private record FaqItem(string Id, string Question, string Answer, string Category);

    private static readonly FaqItem[] _faqItems =
    [
        new("api-rate-limits",
            "What are the API rate limits?",
            "Free tier: 1,000 requests per hour. Pro: 10,000 requests per hour. Enterprise: unlimited with custom throttling. Rate limits reset hourly and we return X-RateLimit headers with remaining quota. Contact support for temporary limit increases during launches.",
            "API"),
        new("webhook-retry",
            "How do webhook retries work?",
            "Failed webhooks retry with exponential backoff: immediately, then 5s, 25s, 2m, and 10m. After 5 failures we mark the endpoint disabled. View failed attempts in the dashboard and manually retry from there. We strongly recommend designing idempotent endpoints.",
            "Webhooks"),
        new("data-retention",
            "How long do you retain data?",
            "Active account data is retained indefinitely. Deleted account data has a 30-day recovery window before permanent deletion. Logs and analytics are kept for 90 days. Enterprise customers can negotiate custom retention, and GDPR right-to-erasure requests are processed within 48 hours.",
            "Data"),
        new("sso-setup",
            "How do I set up SSO?",
            "Enterprise plans support SAML 2.0 and OAuth 2.0 SSO. Open Settings → Security → SSO and upload your IdP metadata. We support Okta, Azure AD, Google Workspace, and OneLogin out of the box. Most teams finish setup in under 15 minutes with the guided wizard.",
            "Security"),
        new("export-data",
            "Can I export my data?",
            "Yes. Export everything in JSON, CSV, or XML from Settings → Data → Export. Exports include all records, metadata, and attachments. Large exports run asynchronously and arrive as a downloadable link in your inbox. An export endpoint is available on the API for automation.",
            "Data"),
        new("downgrade-plan",
            "What happens when I downgrade my plan?",
            "Downgrades take effect at the end of your current billing cycle. Features that exceed the new plan's limits become read-only — nothing is deleted. We email a 7-day warning with migration recommendations, and you can re-upgrade at any time without losing data.",
            "Billing"),
        new("api-versioning",
            "How does API versioning work?",
            "We use date-based versioning (YYYY-MM-DD) sent in the API-Version header. The latest version is 2026-03-01. Old versions are supported for 12 months after deprecation announcement, and breaking changes are never made to existing versions. Full changelog lives in the docs.",
            "API"),
        new("uptime-sla",
            "What is your uptime SLA?",
            "Pro plans include a 99.5% uptime SLA. Enterprise raises that to 99.9% with financial credits for breaches. Real-time metrics are published on our status page, scheduled maintenance is announced 7 days in advance, and historical uptime data is available for the past 24 months.",
            "Infrastructure"),
    ];
}
