@* ============================================================
   Block: faq-side-by-side
   Title: FaqSideBySide
   Description: A two-column side-by-side FAQ block for React and Next.js with paired questions and answers, hero-scale headline cluster, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-side-by-side.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Frequently asked questions
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Everything in one glance.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            Short, scannable answers to the questions we hear most. Need more detail? Our team
            replies in under an hour.
        </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 sm:gap-8">
        @foreach (var item in _faqItems)
        {
            <figure class="rounded-2xl border bg-card px-6 py-5 sm:px-8 sm:py-6">
                <h3 class="text-base font-semibold text-foreground sm:text-lg">
                    @item.Question
                </h3>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">@item.Answer</p>
            </figure>
        }
    </div>

    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("pro-plan",
            "What's included in the Pro plan?",
            "Every premium component, unlimited project downloads, priority support, lifetime updates, and early access to new releases before they ship to the public."),
        new("client-projects",
            "Can I use these in client projects?",
            "Yes — your Pro license covers unlimited use in client and commercial projects. The only restriction is that you can't resell or redistribute the components themselves."),
        new("refunds",
            "Do you offer refunds?",
            "We offer a 14-day money-back guarantee on every plan. Not satisfied? Email support within 14 days for a full refund — no questions asked."),
        new("release-cadence",
            "How often are new components added?",
            "We ship new blocks, patterns, and hooks every week. Pro subscribers get immediate access. Track the changelog or subscribe to release notifications to stay current."),
        new("team-plans",
            "Is there a team or organization plan?",
            "Yes — Team plans cover 5 seats and Organization plans are unlimited. Both include shared workspaces, centralized billing, and usage analytics. Contact sales for enterprise pricing."),
        new("tech-stack",
            "What tech stack are these built with?",
            "React 19, Next.js 16, TypeScript, Tailwind CSS 4, shadcn/ui, and motion/react. Full source ships with every component so you can customize anything."),
    ];
}
