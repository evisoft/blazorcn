@* ============================================================
   Block: faq-compact
   Title: FaqCompact
   Description: A space-efficient compact FAQ list block for React and Next.js with tight padding, single-expand disclosure, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-compact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Quick answers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Short answers, fast.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A compact list of the questions we hear most often. Tap any item for the full answer, or
                get in touch with our team if you need more.
            </p>
        </div>

        @* Compact list *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-compact-panel-{item.Id}";
                var triggerId = $"faq-compact-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-5 px-5 py-4 text-left transition-colors hover:bg-muted/40 sm:px-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-5 pb-5 text-base leading-relaxed text-muted-foreground sm:px-6">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "trial-length";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("trial-length",
            "How long is the free trial?",
            "14 days with full access to every feature on the Pro plan. No credit card required to start, and you can cancel anytime during the trial without being charged a single cent."),
        new("change-plan",
            "Can I change plans later?",
            "Yes. Upgrade or downgrade anytime from your account dashboard. Upgrades apply immediately with prorated billing for the current period, and downgrades take effect at the next billing cycle."),
        new("cancel-anytime",
            "Can I cancel my subscription?",
            "Cancel anytime from Settings → Billing in two clicks. Your access continues through the end of the current billing period, and your data is retained for 90 days after cancellation in case you change your mind."),
        new("team-seats",
            "How do team seats work?",
            "Every team member gets a seat with their own role (Admin, Editor, Viewer). Add or remove seats anytime with automatic prorated billing adjustments, and reassign inactive seats to a new teammate instantly."),
        new("data-export",
            "Can I export my data?",
            "Yes. Export everything in CSV or JSON from Settings → Export, including records, metadata, and attachments. Large exports run in the background and arrive as a downloadable link in your inbox."),
        new("security",
            "Is my data encrypted and secure?",
            "All data is encrypted in transit with TLS 1.3 and at rest with AES-256. We are SOC 2 Type II certified, run quarterly third-party penetration tests, and never sell or share customer data with anyone."),
        new("support-response",
            "How fast is your support team?",
            "Email support replies in under one hour during business hours and within 24 hours overnight. Pro plans add live chat, and Enterprise customers get a dedicated Slack channel with 24/7 phone backup."),
        new("integrations",
            "What integrations are available?",
            "Native integrations ship for Slack, GitHub, Linear, Jira, and over 50 other tools. Our REST API and webhooks cover everything else, and Zapier support is included on every paid plan."),
    ];
}
