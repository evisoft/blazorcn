@* ============================================================
   Block: faq-with-contact
   Title: FaqWithContact
   Description: A marketing-scale FAQ accordion block for React and Next.js with a contact panel beneath the accordion offering email and live chat options, single-item expand, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-contact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help and support
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Answers first, humans second.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Start with the questions other customers ask most. If yours isn't here, our support team
                is one click away and replies in under an hour during business hours.
            </p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Contact panel *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-muted/40 p-6 sm:p-8">
            <div class="text-center">
                <h3 class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
                    Still have questions?
                </h3>
                <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">
                    Pick the channel that works for you — we read every message and reply within an hour
                    during business hours.
                </p>
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-2">
                <div class="flex items-start gap-3 rounded-xl border bg-background p-4">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-muted">
                        <LucideIconCn Name="mail" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-foreground">Email support</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            support@@example.com · replies in under an hour
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3 rounded-xl border bg-background p-4">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-muted">
                        <LucideIconCn Name="message-square" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-foreground">Live chat</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Mon–Fri, 9am–6pm UTC · average wait 30 seconds
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
                <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Read the docs</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "free-plan";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("free-plan",
            "What's included in the free plan?",
            "Three projects, 5 GB storage, basic integrations, and community support. Perfect for solo developers and small teams getting started — upgrade anytime to unlock unlimited projects and premium features."),
        new("change-plans",
            "Can I change plans later?",
            "Yes. Upgrade or downgrade anytime from Settings → Billing. Upgrades apply immediately with prorated billing for the current period. Downgrades take effect at your next billing cycle so you keep the value of your current plan."),
        new("annual",
            "Do you offer annual billing discounts?",
            "Annual plans save 20% compared to monthly billing — pay upfront for 12 months and get 2 months free. Every annual subscription includes priority support and early access to new features as they ship."),
        new("retention",
            "What's your data retention policy?",
            "Active accounts retain data indefinitely with automated daily backups. Cancelled accounts preserve data for 60 days for easy reactivation, after which it's permanently deleted per our privacy policy. Export anytime before cancellation."),
        new("feature-request",
            "How do I request a new feature?",
            "Submit ideas on our public roadmap and upvote existing requests to signal community interest. Pro and Enterprise customers can request custom features with priority consideration and concrete development timelines."),
        new("support-hours",
            "When does the support team respond?",
            "Standard plans receive a reply within one business day. Priority support on Pro plans answers within four hours during business hours. Enterprise plans include a dedicated Slack channel with one-hour response time, including weekends."),
    ];
}
