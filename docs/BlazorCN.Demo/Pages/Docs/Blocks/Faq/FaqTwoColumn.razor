@* ============================================================
   Block: faq-two-column
   Title: FaqTwoColumn
   Description: A two-column FAQ card grid for React and Next.js with side-by-side question cards, responsive collapse, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-two-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Marketing headline cluster *@
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Frequently asked questions
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Everything in one glance.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            Short answers to the questions we hear most often. If you need more depth, our docs and
            support team are one click away.
        </p>
    </div>

    @* Two-column grid *@
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
        @foreach (var it in _faqItems)
        {
            var item = it;
            <figure role="region" aria-label="@item.Question" class="rounded-2xl border bg-card px-6 py-5 sm:px-8 sm:py-6">
                <h3 class="text-base font-semibold text-foreground sm:text-lg">
                    @item.Question
                </h3>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">@item.Answer</p>
            </figure>
        }
    </div>

    @* CTAs *@
    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("refunds",
            "What is your refund policy?",
            "30-day money-back guarantee on every plan. Cancel anytime in the first month for a full refund — no questions, no forms, no friction."),
        new("seats",
            "How many users can I add?",
            "Pro includes 10 seats, Team supports 50, and Enterprise is unlimited with volume pricing. Add or remove members at any time and we prorate."),
        new("support",
            "Do you offer enterprise support?",
            "Enterprise customers get a dedicated account manager, 1-hour priority response, custom SLAs, and a private Slack channel for real-time help."),
        new("integrations",
            "Can I integrate with my existing tools?",
            "Native integrations ship for Slack, Salesforce, HubSpot, Zapier, and 100+ other tools. Anything else is one webhook or REST call away."),
        new("gdpr",
            "Is my data GDPR compliant?",
            "Yes. EU data residency, signed DPAs, right-to-erasure, and full SOC 2 Type II compliance. We never sell or share customer data."),
        new("security",
            "What are your security measures?",
            "AES-256 encryption at rest, TLS 1.3 in transit, annual third-party penetration tests, and optional IP allowlisting on Enterprise plans."),
        new("whitelabel",
            "Can I white-label the platform?",
            "Enterprise plans support custom branding — your logo, colors, and domain. Remove every trace of platform branding for a seamless experience."),
        new("payment",
            "What payment methods do you accept?",
            "All major credit cards, PayPal, and wire transfer for annual Enterprise plans. Invoicing with NET 30 terms is available on request."),
    ];
}
