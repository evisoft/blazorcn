@* ============================================================
   Block: faq-dual-column-accordion
   Title: FaqDualColumnAccordion
   Description: A marketing-scale dual-column FAQ accordion block for React and Next.js with balanced two-column distribution, independent expand state, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-dual-column-accordion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Twice the answers, half the scroll.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Two columns of the questions teams ask most. Can't find what you're looking for? Our
                support team replies in under an hour.
            </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
            @* Left column *@
            <div class="overflow-hidden rounded-2xl border bg-card">
                @foreach (var it in _leftItems)
                {
                    var item = it;
                    var isOpen = _leftExpanded == item.Id;
                    var panelId = $"faq-dual-left-panel-{item.Id}";
                    var triggerId = $"faq-dual-left-trigger-{item.Id}";
                    <div class="border-b last:border-0">
                        <button
                            type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen.ToString().ToLower()"
                            aria-controls="@panelId"
                            @onclick="@(() => _leftExpanded = isOpen ? null : item.Id)"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                        </button>

                        @if (isOpen)
                        {
                            <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                    @item.Answer
                                </p>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Right column *@
            <div class="overflow-hidden rounded-2xl border bg-card">
                @foreach (var it in _rightItems)
                {
                    var item = it;
                    var isOpen = _rightExpanded == item.Id;
                    var panelId = $"faq-dual-right-panel-{item.Id}";
                    var triggerId = $"faq-dual-right-trigger-{item.Id}";
                    <div class="border-b last:border-0">
                        <button
                            type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen.ToString().ToLower()"
                            aria-controls="@panelId"
                            @onclick="@(() => _rightExpanded = isOpen ? null : item.Id)"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                        </button>

                        @if (isOpen)
                        {
                            <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                    @item.Answer
                                </p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _leftExpanded = "payment-methods";
    private string? _rightExpanded = null;

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _allFaqItems =
    [
        new("payment-methods",
            "What payment methods do you accept?",
            "We accept every major credit card (Visa, Mastercard, Amex, Discover), PayPal, Apple Pay, and bank transfer for annual plans. All payments run through Stripe with PCI DSS compliance and enterprise customers can bill by invoice with NET 30 terms."),
        new("free-trial",
            "Is there a free trial available?",
            "Yes. Every paid plan starts with a 14-day free trial of every Pro feature with no credit card required. If you upgrade before the trial ends, your data and settings carry over without interruption."),
        new("cancel-subscription",
            "Can I cancel my subscription anytime?",
            "Yes. Cancel anytime from account settings with no cancellation fees. You'll keep full access until the end of the current billing period, and we honor a 30-day money-back guarantee on every new subscription."),
        new("data-security",
            "How secure is my data?",
            "All data is encrypted in transit with TLS 1.3 and at rest with AES-256. We maintain SOC 2 Type II compliance, run quarterly third-party penetration tests, and never sell customer data to third parties."),
        new("team-collaboration",
            "How does team collaboration work?",
            "Invite unlimited teammates to shared workspaces with three permission levels (Admin, Editor, Viewer). Every change syncs in real time with live presence indicators, threaded comments, and a complete audit log."),
        new("mobile-apps",
            "Do you offer native mobile apps?",
            "Yes. We ship native iOS and Android apps with full feature parity to the web. Both apps support offline mode with automatic sync the moment you reconnect."),
        new("api-access",
            "Is there REST API access?",
            "Every paid plan includes the full REST and webhooks API with comprehensive documentation. Enterprise plans receive raised rate limits and SDKs ship for JavaScript, Python, and Ruby."),
        new("data-export",
            "Can I export my data at any time?",
            "Yes. Export your full workspace as JSON, CSV, or Excel from the data export page. Exports include attachments and history, and large exports are emailed as downloadable zip files within minutes."),
        new("support-response",
            "What are your support response times?",
            "Free plans use community support, Pro plans receive email replies within 24 hours, and Enterprise plans receive priority support with a 4-hour first response time plus a dedicated Slack Connect channel."),
        new("integrations",
            "What integrations do you support?",
            "Native integrations ship for Slack, Microsoft Teams, Google Workspace, Salesforce, HubSpot, Zapier, and over 100 other tools. Our REST API and webhooks cover everything else."),
    ];

    private static readonly int _midpoint = (int)Math.Ceiling(_allFaqItems.Length / 2.0);
    private static readonly FaqItem[] _leftItems = _allFaqItems[.._midpoint];
    private static readonly FaqItem[] _rightItems = _allFaqItems[_midpoint..];
}
