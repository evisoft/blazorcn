@* ============================================================
   Block: faq-json-ld
   Title: FaqJsonLd
   Description: An SEO-optimized FAQ accordion block for React and Next.js with FAQPage JSON-LD structured data, marketing-scale headline, single-item expand, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-json-ld.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built to rank, built to read.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer below is mirrored as FAQPage JSON-LD so Google can lift it into a rich
                snippet — no extra build step, no separate file.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "pricing-plans";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("pricing-plans",
            "What are your pricing plans?",
            "We offer three plans. Individual is $39 per month for solo creators. Team is $79 per month for up to five users with shared workspaces. Enterprise is custom-priced with SSO, audit logs, and a dedicated success manager. Annual billing saves 20 percent and a 14-day free trial is available on every plan with no credit card required."),
        new("free-trial",
            "Do you offer a free trial?",
            "Yes — every plan starts with a 14-day free trial that unlocks the full Pro feature set. No credit card is required to begin, your trial data is preserved when you upgrade, and you can cancel at any moment during the trial without charges or follow-up emails."),
        new("payment-methods",
            "What payment methods do you accept?",
            "We accept every major credit card (Visa, Mastercard, Amex, Discover), PayPal, Apple Pay, Google Pay, and bank transfer for annual enterprise contracts. All payments run through Stripe with PCI DSS compliance and 3D Secure verification. Invoices are available on annual plans."),
        new("refund-policy",
            "What is your refund policy?",
            "Every plan includes a 30-day money-back guarantee. If the product doesn't fit, contact support and we'll process a full refund within five business days back to your original payment method. Annual plans cancelled after 30 days receive a prorated refund for unused months."),
        new("data-security",
            "How secure is my data?",
            "All data is encrypted in transit with TLS 1.3 and at rest with AES-256. We are SOC 2 Type II certified, run third-party penetration tests every quarter, and maintain geographically redundant backups every six hours. We never sell customer data and we comply with GDPR and CCPA in full."),
        new("team-collaboration",
            "How does team collaboration work?",
            "Team plans support unlimited members with role-based access (Admin, Editor, Viewer), real-time editing, presence indicators, and threaded comments. Every change is captured in an audit log, and notifications can be routed to Slack, email, or Microsoft Teams without extra configuration."),
        new("cancel-subscription",
            "Can I cancel anytime?",
            "Yes. Cancel from your account settings in two clicks — no fees, no retention calls. You keep full access until the end of your current billing period, and your data remains downloadable for 30 days after cancellation in case you change your mind."),
    ];
}
