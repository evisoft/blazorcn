@* ============================================================
   Block: faq-legal
   Title: FaqLegal
   Description: A marketing-scale FAQ accordion block for React and Next.js with topic filter tabs, single-item expand within each tab, smooth transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-legal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Filter by what matters to you.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a topic and dig in. Every answer is written by the team who actually handles those
                cases — no marketing department in the middle.
            </p>
        </div>

        @* Topic tab row *@
        <div class="mt-8 flex flex-nowrap items-center justify-start gap-2 overflow-x-auto pb-2 sm:justify-center">
            @foreach (var tp in _topics)
            {
                var topic = tp;
                var isActive = topic == _activeTopic;
                <button
                    type="button"
                    aria-pressed="@isActive.ToString().ToLower()"
                    @onclick="@(() => { _activeTopic = topic; _expanded = null; })"
                    class="@Cn.Merge("shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-card text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                    @topic
                </button>
            }
        </div>

        @* FAQ accordion for active topic *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in GetActiveItems())
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"legal-faq-panel-{item.Id}";
                var triggerId = $"legal-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">Book a consultation</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Contact the team</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _activeTopic = "General";
    private string? _expanded = "general-consult";

    private static readonly string[] _topics = ["General", "Family Law", "Criminal Defense", "Business", "Estate Planning"];

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly Dictionary<string, FaqItem[]> _faqGroups = new()
    {
        ["General"] =
        [
            new("general-consult",
                "How much does an initial consultation cost?",
                "Initial consultations are $250 for 60 minutes and the fee is waived if you retain our services. Some practice areas offer a free 20-minute phone call. Bring all relevant documents to make the most of the meeting and we'll send a clear written fee structure within 24 hours."),
            new("general-rates",
                "What are your hourly rates?",
                "Attorney rates run $300 to $650 per hour depending on experience and practice area. Paralegals bill at $125 to $175 per hour. Many matters are handled on flat fee or contingency. Every engagement starts with a written letter that locks in the structure before any billable work begins."),
            new("general-payment-plans",
                "Do you accept payment plans?",
                "Yes. Most matters can be split into a one-third upfront retainer plus two to six monthly installments. We accept credit card, ACH, and check. Some cases qualify for contingency fee arrangements with no money out of pocket until a settlement or judgment is reached."),
        ],
        ["Family Law"] =
        [
            new("family-divorce-time",
                "How long does a divorce take?",
                "Uncontested divorces close in 6 to 9 months because California requires a 6-month minimum waiting period. Contested divorces with complex assets or custody disputes typically run 12 to 24 months. Mediation can compress contested timelines to 8 to 12 months when both parties stay engaged."),
            new("family-divorce-cost",
                "What does a divorce cost?",
                "Uncontested with no children is a $5,000 to $8,000 flat fee. Contested with custody or asset disputes runs $15,000 to $50,000+. Forensic accountants and custody evaluators add $3,000 to $10,000 each when needed. Payment plans are available on every matter."),
            new("family-custody",
                "How is child custody determined?",
                "California courts weigh the child's best interests: health, safety, parental ability to provide care, history of abuse or substance use, and the child's preference if they are old enough to express one. Joint legal custody is presumed unless evidence of harm exists."),
        ],
        ["Criminal Defense"] =
        [
            new("criminal-silence",
                "Should I talk to police without a lawyer?",
                "No. Politely invoke your right to remain silent and request an attorney immediately. Anything you say — even seemingly innocent statements — can be used against you. Do not consent to searches without a warrant. Call us 24/7 and we'll be on the phone with detectives within the hour."),
            new("criminal-outcomes",
                "What are realistic outcomes for my charges?",
                "Every case is unique. We analyze police reports, witness statements, and procedural compliance to identify defense strategies. Common outcomes include dismissal for insufficient evidence, reduction to lesser charges, acquittal at trial, or favorable plea agreements that keep your record clean."),
            new("criminal-cost",
                "How much does criminal defense cost?",
                "Misdemeanors run $5,000 to $15,000. Felonies run $15,000 to $100,000+ for serious charges that need expert witnesses and trial preparation. DUI defense is typically $7,500 to $15,000. Flat fees and payment plans are available on most matters with a retainer required upfront."),
        ],
        ["Business"] =
        [
            new("business-formation",
                "What entity formation services do you offer?",
                "LLC, C-Corp, S-Corp, and partnership formation including filing, operating agreements, bylaws, and first-year compliance. Costs run $2,500 to $5,000 depending on complexity, including EIN application and stock issuance. Annual compliance packages are available for $1,500 to $3,000 per year."),
            new("business-contracts",
                "Do you review and draft contracts?",
                "Yes — employment agreements, vendor contracts, partnership agreements, leases, NDAs, and terms of service. Flat fees range from $750 for simple contracts to $10,000+ for complex agreements. Every review includes redlining, negotiation strategy, and a written risk assessment."),
            new("business-ip",
                "Can you help with intellectual property?",
                "We handle trademark registration ($2,000 to $4,000 including filing fees), copyright registration ($750 to $1,500), licensing agreements, and cease-and-desist letters. For patents we refer to specialized patent attorneys we've worked with for years."),
        ],
        ["Estate Planning"] =
        [
            new("estate-will-trust",
                "Do I need a will or a trust?",
                "A basic will ($1,500 to $2,500) is sufficient for estates under $184,500 with simple beneficiary designations. A living trust ($3,500 to $6,000) is recommended for estates over that threshold, real estate ownership, minor children, or anyone who values privacy and wants to avoid probate."),
            new("estate-probate",
                "What is probate and how long does it take?",
                "Probate is court-supervised asset distribution when someone dies without a trust. In California it runs 9 to 18 months minimum and often 18 to 24 months for complex estates. Costs are 4 to 7 percent of estate value in statutory fees plus court costs. Trusts eliminate probate entirely."),
        ],
    };

    private FaqItem[] GetActiveItems()
        => _faqGroups.TryGetValue(_activeTopic, out var items) ? items : [];
}
