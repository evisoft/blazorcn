@* ============================================================
   Block: faq-multi-select
   Title: FaqMultiSelect
   Description: A multi-select FAQ accordion block for React and Next.js where multiple items expand simultaneously with category tabs, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-multi-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Open as many as you need.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Compare answers side by side. Expand multiple questions at once and read everything in
                context — no more clicking back and forth.
            </p>
        </div>

        @* Category tabs *@
        <div
            role="tablist"
            aria-label="Filter questions by category"
            class="mt-8 flex flex-wrap items-center justify-center gap-2">
            @foreach (var cat in _categories)
            {
                var catItem = cat;
                var isActive = catItem == _category;
                <button
                    type="button"
                    role="tab"
                    aria-selected="@isActive.ToString().ToLower()"
                    @onclick="@(() => _category = catItem)"
                    class="@Cn.Merge("inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-card text-foreground hover:bg-muted/60")">
                    @catItem
                </button>
            }
        </div>

        @* Accordion *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in FilteredItems)
            {
                var item = it;
                var isOpen = _openIds.Contains(item.Id);
                var panelId = $"faq-ms-panel-{item.Id}";
                var triggerId = $"faq-ms-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => ToggleItem(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private HashSet<string> _openIds = ["free-plan"];
    private string _category = "All";

    private static readonly string[] _categories = ["All", "Plans", "Security", "Team", "Developers"];

    private FaqItem[] FilteredItems =>
        _category == "All" ? _faqItems : Array.FindAll(_faqItems, i => i.Category == _category);

    private void ToggleItem(string id)
    {
        if (_openIds.Contains(id))
            _openIds.Remove(id);
        else
            _openIds.Add(id);
    }

    private record FaqItem(string Id, string Category, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("free-plan", "Plans",
            "What's included in the free plan?",
            "Up to 3 projects, 100 MB of storage, basic analytics, and community support. You can invite 2 teammates and use every core feature with usage limits — perfect for solo work and trying the platform before you commit."),
        new("change-plan", "Plans",
            "Can I change my plan at any time?",
            "Yes. Upgrades apply immediately with prorated billing for the current period, and downgrades take effect at the end of your billing cycle so you never lose value you already paid for."),
        new("refunds", "Plans",
            "Do you offer refunds?",
            "We offer a 30-day money-back guarantee on every new annual subscription — no questions asked. Monthly plans can be canceled anytime to stop future charges, and annual customers can request a prorated refund within 90 days."),
        new("team-roles", "Team",
            "How does team collaboration work?",
            "Invite teammates by email with role-based access (Admin, Editor, Viewer). Every change is captured in an audit log, mentions and threaded comments keep conversation in context, and real-time editing ships on Pro and Enterprise plans."),
        new("security", "Security",
            "What security measures are in place?",
            "AES-256 encryption at rest, TLS 1.3 in transit, bcrypt password hashing, SOC 2 Type II compliance, quarterly third-party penetration tests, and SSO/SAML for Enterprise customers. Backups run every 6 hours across three regions."),
        new("api", "Developers",
            "Is there an API and webhooks?",
            "Yes. Pro and Enterprise plans include the full REST API with comprehensive docs, plus webhooks for real-time event notifications. Rate limits are 1,000 requests/hour on Pro and 10,000 on Enterprise, with raised limits available on request."),
        new("support", "Plans",
            "What kind of support do you provide?",
            "Free users get the community forum and the knowledge base. Pro users have priority email support with a 4-hour business-hour response time. Enterprise customers receive a dedicated Slack channel, phone support, and a customer success manager."),
        new("export", "Developers",
            "Can I export all of my data?",
            "Yes — anytime, in JSON, CSV, or SQL formats from Settings → Data Export. Large exports run in the background and arrive in your inbox when ready. We believe in data portability and never lock you in."),
    ];
}
