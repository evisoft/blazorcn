        new("delete",
            "How do I delete my account?",
            "Open Settings → Account → Delete Account and confirm. All data is permanently removed within 30 days per GDPR. Active subscriptions are canceled immediately with prorated refunds where applicable. Export your data first if you need it.",
            "2.4k views"),
    ];
}
