@* ============================================================
   Block: faq-with-badge-count
   Title: FaqWithBadgeCount
   Description: A marketing-scale FAQ accordion block for React and Next.js with view-count popularity badges per question, single-item expand, chevron rotation, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-badge-count.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Most-asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The answers people read most.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Each question is tagged with how many visitors have read its answer this month, so you
                can jump straight to what the rest of the community is curious about.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-2">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <span class="inline-flex items-center gap-1 rounded-full border bg-muted/60 px-2 py-0.5 font-mono text-[11px] text-muted-foreground">
                                <LucideIconCn Name="eye" Size="12" Class="size-3" aria-hidden="true" />
                                @item.Views
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "free-plan";

    private record FaqItem(string Id, string Question, string Answer, string Views);

    private static readonly FaqItem[] _faqItems =
    [
        new("free-plan",
            "What's included in the free plan?",
            "The free plan includes 1,000 API calls per month, 5 team members, and community support. Upgrade anytime to unlock unlimited API calls, priority support, and advanced analytics — no credit card required to start.",
            "12.4k views"),
        new("upgrade",
            "How do I upgrade to a paid plan?",
            "Open Settings → Billing and pick a plan. Annual billing saves 20%. Upgrades apply immediately with prorated billing for the current period and your new limits take effect within minutes.",
            "8.1k views"),
        new("rate-limits",
            "What's your API rate limit?",
            "Free plans get 1,000 requests per month at 10 req/min. Pro gets 100,000 requests per month at 100 req/min. Enterprise plans include custom limits and dedicated infrastructure. Rate limit headers ship in every response.",
            "6.7k views"),
        new("auth",
            "How do I authenticate API requests?",
            "All requests require an API key passed as a Bearer token in the Authorization header. Generate scoped keys in Settings → API Keys and rotate them anytime without downtime. Keep keys in environment variables, never in version control.",
            "5.2k views"),
        new("sdk",
            "Do you provide SDKs for popular languages?",
            "Official SDKs ship for JavaScript/TypeScript, Python, Ruby, Go, and PHP — all open-source with retry logic baked in. Community SDKs cover Rust, Java, and C#. Find the latest releases on our GitHub organization.",
            "4.9k views"),
        new("refund",
            "Can I request a refund?",
            "Yes — every paid plan ships with a 30-day money-back guarantee. Contact support and the refund will be on its way to your original payment method within one business day. Annual plans receive a prorated refund based on unused months.",
            "3.6k views"),
        new("security",
            "How secure is my data?",
            "All data is encrypted in transit with TLS 1.3 and at rest with AES-256. We hold SOC 2 Type II and GDPR compliance, run quarterly third-party penetration tests, and never sell or share customer data with anyone.",
