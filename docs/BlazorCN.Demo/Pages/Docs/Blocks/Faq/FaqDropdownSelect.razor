@* ============================================================
   Block: faq-dropdown-select
   Title: FaqDropdownSelect
   Description: A category-filtered FAQ block for React and Next.js with a dropdown selector, animated filter transitions, single-expand disclosure, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-dropdown-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a category from the dropdown to filter the list, or scroll through every answer
                below. Updated whenever we ship a meaningful change.
            </p>
        </div>

        @* Category selector *@
        <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
            <span class="text-sm font-medium text-muted-foreground">
                @_filteredFaqs.Length question@(_filteredFaqs.Length != 1 ? "s" : "")
            </span>
            <SelectCn Value="@_selectedCategory" ValueChanged="@((string v) => OnCategoryChanged(v))">
                <SelectTriggerCn aria-label="Filter questions by category" Class="h-11 w-full rounded-xl sm:w-[260px]">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        <SelectItemCn Value="@category.Value">@category.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* FAQ list *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _filteredFaqs)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-dropdown-panel-{item.Id}";
                var triggerId = $"faq-dropdown-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _selectedCategory = "all";
    private string? _expanded = "plans";

    private record FaqItem(string Id, string Question, string Answer, string Category);

    private record CategoryOption(string Value, string Label);

    private static readonly CategoryOption[] _categories =
    [
        new("all", "All topics"),
        new("Pricing", "Pricing & billing"),
        new("Account", "Account management"),
    ];

    private static readonly FaqItem[] _faqItems =
    [
        new("plans",
            "What plans do you offer?",
            "Three plans: Starter ($29/month) for individuals, Pro ($79/month) for teams up to 10 members, and Enterprise (custom pricing) for organizations needing dedicated support and custom infrastructure. Every plan starts with a 14-day free trial and no credit card.",
            "Pricing"),
        new("switch-plans",
            "Can I switch plans anytime?",
            "Yes. Upgrade or downgrade between plans anytime from your dashboard. Upgrades apply immediately with prorated billing for the remainder of your cycle. Downgrades take effect at the end of your current billing period.",
            "Pricing"),
        new("annual-billing",
            "Do you offer annual billing?",
            "Yes. Annual billing comes with a 20% discount versus monthly pricing. You can still upgrade or downgrade mid-cycle with prorated adjustments. Annual subscribers also get priority support and early access to beta features.",
            "Pricing"),
        new("reset-password",
            "How do I reset my password?",
            "Click 'Forgot password' on the sign-in page and enter your email. You'll receive a password reset link valid for one hour. Follow the link to create a new password meeting our security requirements (12+ characters, mixed case, number, and symbol).",
            "Account"),
        new("change-email",
            "Can I change my email address?",
            "Yes. Go to Settings → Profile → Email and enter your new address. We'll send a verification link to the new email. Click the link to confirm the change. Your old email stays active until verification finishes to prevent account lockout.",
            "Account"),
        new("two-factor",
            "How do I enable two-factor authentication?",
            "Open Settings → Security → Two-Factor Authentication and click Enable. Scan the QR code with an authenticator app like 1Password, Google Authenticator, or Authy. Enter the 6-digit code from your app to complete setup, then save your recovery codes.",
            "Account"),
        new("refund-policy",
            "What's your refund policy?",
            "We offer a 30-day money-back guarantee on every purchase — no questions asked. Contact support within 30 days for a full refund to your original payment method. Refunds land within 5 to 7 business days and apply to both monthly and annual plans.",
            "Pricing"),
        new("invite-team",
            "How do I invite team members?",
            "Open Team → Invite Members from your dashboard. Enter email addresses (one per line for bulk invites) and assign each person a role: Admin, Member, or Viewer. Invited teammates receive a sign-up link valid for 7 days.",
            "Account"),
        new("enterprise-quote",
            "Can I get a custom Enterprise quote?",
            "Yes. Email our sales team or use the Request Demo button on the pricing page. We'll schedule a call to understand your requirements and put together a quote with volume discounts, dedicated infrastructure, and premium support.",
            "Pricing"),
        new("data-after-cancel",
            "What happens to my data if I cancel?",
            "You retain full read-only access for 30 days after cancellation. During that window you can export everything from Settings → Data Export. After 30 days all data is permanently deleted in compliance with GDPR.",
            "Account"),
    ];

    private FaqItem[] _filteredFaqs => _selectedCategory == "all"
        ? _faqItems
        : _faqItems.Where(f => f.Category == _selectedCategory).ToArray();

    private void OnCategoryChanged(string value)
    {
        _selectedCategory = value;
        _expanded = null;
    }
}
