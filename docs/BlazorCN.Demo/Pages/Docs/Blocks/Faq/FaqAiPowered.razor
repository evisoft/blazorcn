@* ============================================================
   Block: faq-ai-powered
   Title: FaqAiPowered
   Description: A marketing-scale FAQ block for React and Next.js with live search filtering, category badges, smooth expand/collapse, accessible disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-ai-powered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Search the answers you need.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Type a keyword or browse the full list. Results filter as you type, and our support team
                replies in under an hour for anything you can't find.
            </p>
        </div>

        @* Search *@
        <div class="mt-10">
            <div class="relative">
                <LucideIconCn Name="search" Size="20" Class="absolute left-4 top-1/2 size-5 -translate-y-1/2 text-muted-foreground" aria-hidden="true" />
                <InputCn type="search"
                         aria-label="Search frequently asked questions"
                         Placeholder="Search questions, answers, or topics..."
                         Value="@_searchQuery"
                         ValueChanged="@((string v) => { _searchQuery = v; })"
                         Class="h-14 rounded-2xl pl-12 pr-4 text-base" />
            </div>
            <div aria-live="polite" class="mt-3 flex items-center gap-3 px-1">
                <span class="text-xs text-muted-foreground">
                    @FilteredFaqs.Length result@(FilteredFaqs.Length != 1 ? "s" : "")@(_query.Length > 0 ? $" for \"{_searchQuery}\"" : "")
                </span>
                @if (_query.Length > 0)
                {
                    <button type="button" @onclick="@(() => _searchQuery = "")" class="text-xs font-medium text-foreground hover:underline">
                        Clear search
                    </button>
                }
            </div>
        </div>

        @* Accordion *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @if (FilteredFaqs.Length == 0)
            {
                <div class="px-6 py-16 text-center sm:px-8">
                    <p class="text-base font-semibold text-foreground">No matches yet.</p>
                    <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-muted-foreground">
                        Try a different keyword or rephrase your question. You can also message our
                        support team directly.
                    </p>
                </div>
            }
            else
            {
                @foreach (var faqItem in FilteredFaqs)
                {
                    var item = faqItem;
                    var isOpen = _expandedId == item.Id;
                    var panelId = $"faq-ai-panel-{item.Id}";
                    var triggerId = $"faq-ai-trigger-{item.Id}";
                    <div class="border-b last:border-0">
                        <button type="button"
                                id="@triggerId"
                                aria-expanded="@(isOpen ? "true" : "false")"
                                aria-controls="@panelId"
                                @onclick="@(() => _expandedId = (isOpen ? null : item.Id))"
                                class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-3">
                                    <span class="text-base font-semibold text-foreground sm:text-lg">
                                        @item.Question
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0">
                                        @item.Category
                                    </BadgeCn>
                                </div>
                            </div>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                        </button>

                        @if (isOpen)
                        {
                            <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                    @item.Answer
                                </p>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer, string Category);

    private static readonly FaqItem[] _faqItems =
    [
        new("search",
            "How does search across the FAQ work?",
            "Search filters questions, answers, and categories with a case-insensitive substring match. Results update as you type, and the count announces live to assistive tech. Swap the filter callback for fuzzy or semantic search if you need more recall.",
            "Features"),
        new("billing",
            "What payment methods do you accept?",
            "We accept every major credit card (Visa, Mastercard, Amex, Discover) plus PayPal and bank transfer for annual plans. Payments run through Stripe with PCI DSS compliance, and enterprise customers can bill by invoice with NET 30 terms.",
            "Billing"),
        new("integration",
            "Can I integrate this with my existing knowledge base?",
            "Yes. Our REST API and SDKs let you sync content from Zendesk, Intercom, Notion, or your own CMS in real time or on a schedule. JavaScript, Python, and Ruby SDKs ship with TypeScript types and full retry handling.",
            "Technical"),
        new("export",
            "How do I export my data?",
            "Open Settings, Data Export and choose CSV, JSON, or XML. Filter by date, category, or tag, and enterprise plans include automated daily backups to your preferred cloud storage. Exports are encrypted at rest and signed for tamper detection.",
            "General"),
        new("mobile",
            "Is there a native mobile app?",
            "Yes. Native iOS and Android apps ship with full feature parity, offline mode, push notifications, and biometric unlock. Sign in with your existing credentials from the App Store or Google Play.",
            "General"),
        new("uptime",
            "What is your uptime guarantee?",
            "We guarantee 99.9% uptime backed by multi-region redundancy and automatic failover. The public status page shows live metrics for every service, and SLA credits are issued automatically for any qualifying incident.",
            "Technical"),
        new("cancel",
            "How do I cancel my subscription?",
            "Cancel anytime from Billing, Subscription. There are no cancellation fees and you keep access until the end of your current billing period. Export your data first if you need it; accounts are deleted 30 days after closure.",
            "Billing"),
        new("support",
            "What support do you offer?",
            "Every plan includes email support with a 24-hour response. Pro and Enterprise add priority support with a 4-hour response and a dedicated Slack channel, and Enterprise customers get a named account manager with quarterly business reviews.",
            "General"),
    ];

    private string _searchQuery = "";
    private string? _expandedId = null;

    private string _query => _searchQuery.Trim().ToLowerInvariant();

    private FaqItem[] FilteredFaqs => _query.Length == 0
        ? _faqItems
        : _faqItems.Where(faq =>
            faq.Question.ToLowerInvariant().Contains(_query) ||
            faq.Answer.ToLowerInvariant().Contains(_query) ||
            faq.Category.ToLowerInvariant().Contains(_query)).ToArray();
}
