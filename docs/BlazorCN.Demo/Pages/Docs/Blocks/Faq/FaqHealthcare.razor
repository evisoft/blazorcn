@* ============================================================
   Block: faq-healthcare
   Title: FaqHealthcare
   Description: A marketing-scale icon-accented FAQ accordion block for React and Next.js with single-item expand, semantic icon highlights per question, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-healthcare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Patient questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything before your visit.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Insurance, appointments, telehealth, prescriptions, records, and billing — answered so
                you can spend less time on the phone and more time getting care.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"healthcare-faq-panel-{item.Id}";
                var triggerId = $"healthcare-faq-trigger-{item.Id}";
                var iconName = _iconMap[item.Icon];
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="flex items-start gap-4">
                            <LucideIconCn Name="@iconName" Size="20" Class="mt-1 size-5 shrink-0 text-muted-foreground" aria-hidden="true" />
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-[3.75rem] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[4.25rem]">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Book appointment</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Open patient portal</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "insurance";

    private record FaqItem(string Id, string Question, string Answer, string Icon);

    private static readonly Dictionary<string, string> _iconMap = new()
    {
        ["shield"]   = "shield",
        ["calendar"] = "calendar",
        ["video"]    = "video",
        ["pill"]     = "pill",
        ["file"]     = "file-text",
        ["card"]     = "credit-card",
        ["heart"]    = "heart",
    };

    private static readonly FaqItem[] _faqItems =
    [
        new("insurance",
            "What insurance plans do you accept?",
            "We're in-network with 95% of major insurers including Blue Cross Blue Shield, UnitedHealthcare, Aetna, Cigna, Medicare, and most state Medicaid plans. Primary care copays typically range $15–$50 and specialist visits $30–$75 depending on your plan. Self-pay patients receive a 20% discount when paid at time of service, and our financial counselors will verify your benefits before the visit.",
            "shield"),
        new("appointments",
            "How do I schedule an appointment?",
            "Book online through our patient portal 24/7, by phone Monday–Friday 8am–6pm, or via the mobile app. Same-day urgent appointments are available when you call before 10am. New patient visits run 45–60 minutes, follow-ups 15–30 minutes. We send reminders 48 hours and 2 hours before your visit, and cancellations require 24-hour notice to avoid the no-show fee.",
            "calendar"),
        new("telehealth",
            "Do you offer telehealth or virtual visits?",
            "Yes. Telehealth is available for follow-ups, medication management, cold and flu symptoms, allergies, mental health, and chronic disease management on a HIPAA-compliant video platform. Insurance copays apply just like in-office visits, and prescriptions are sent electronically to your pharmacy after the appointment. New patients require one in-person visit before becoming telehealth-eligible.",
            "video"),
        new("prescriptions",
            "How do I request prescription refills?",
            "Request refills through the patient portal for the fastest turnaround — most are processed within 24 hours. We require an office visit every 6–12 months to continue prescriptions, and controlled substances need an in-person appointment every 3 months per federal regulations. Prescriptions are sent electronically and ready for pickup 2–4 hours after approval.",
            "pill"),
        new("records",
            "How can I access my medical records?",
            "Visit summaries, lab results, imaging reports, immunization history, and your medication list are available 24/7 in the patient portal. Lab results are typically posted within 24–48 hours alongside your provider's interpretation. To send records to another provider, submit a release request through the portal and digital copies arrive within 24 hours.",
            "file"),
        new("billing",
            "How does billing and payment work?",
            "Copays are due at time of service, and we'll send a statement 7–14 days after insurance processes the claim. We accept cards, HSA/FSA, checks, and digital wallets. Payment plans are available for balances over $500 with no interest if paid within six months, and financial hardship assistance is available on a sliding scale for qualifying patients.",
            "card"),
        new("emergency",
            "What should I do in a medical emergency?",
            "For life-threatening emergencies — chest pain, difficulty breathing, severe bleeding, stroke symptoms — call 911 immediately. For urgent but non-emergency issues, call before 10am for a same-day appointment. Our 24/7 nurse triage line can help you decide whether to head to the ER, urgent care, or wait for a regular visit.",
            "heart"),
    ];
}
