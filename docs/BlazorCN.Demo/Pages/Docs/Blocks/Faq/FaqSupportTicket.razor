@* ============================================================
   Block: faq-support-ticket
   Title: FaqSupportTicket
   Description: A marketing FAQ block for React and Next.js with self-serve answers and a clear support escalation CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-support-ticket.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Stuck? Start here.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Most issues are answered below in under a minute. If you still need a human, our support
                team replies to every ticket within an hour during business hours.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"support-panel-{item.Id}";
                var triggerId = $"support-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Escalation callout *@
        <p class="mt-8 text-center text-sm text-muted-foreground">
            Didn't find what you needed? Open a ticket and a human will reply within the hour.
        </p>

        @* CTAs *@
        <div class="mt-5 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Create a ticket</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "reset-password";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("reset-password",
            "How do I reset my password?",
            "Click 'Forgot password' on the login screen and enter your account email. We send a reset link valid for one hour. Follow it to set a new password (12+ characters with one uppercase, one number, and one symbol). For security, every active session is signed out the moment your password changes."),
        new("payment-failing",
            "Why is my payment failing?",
            "Failed payments usually mean an expired card, insufficient funds, or a bank flagging the charge as suspicious. Check Settings → Billing for the exact decline code. If everything looks right on your side, contact your card issuer — most charges go through on the second attempt once the bank approves."),
        new("data-export",
            "How do I export my data?",
            "Settings → Data Export lets you choose CSV, JSON, or XML and a date range. Large exports run in the background and arrive as a secure download link in your email within 30 minutes. Links stay live for seven days before automatic deletion."),
        new("change-email",
            "Can I change the email on my account?",
            "Yes. Settings → Profile → Email. Enter the new address and we send a verification link. Your old email stays active until you click the link, so you can't accidentally lock yourself out. The change takes effect the moment you verify."),
        new("cancel-subscription",
            "How do I cancel my subscription?",
            "Settings → Billing → Cancel subscription. There are no cancellation fees and you keep full access until the end of the current billing period. Export your data first — content is permanently deleted 30 days after closure to comply with GDPR."),
        new("missing-features",
            "Why can't I access certain features?",
            "Feature availability depends on your plan. Settings → Plan shows exactly which features are unlocked at your tier. If you recently upgraded, sign out and back in to refresh permissions — feature flags are cached for one hour."),
    ];
}
