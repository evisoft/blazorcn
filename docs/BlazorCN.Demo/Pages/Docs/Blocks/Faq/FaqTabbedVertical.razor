@* ============================================================
   Block: faq-tabbed-vertical
   Title: FaqTabbedVertical
   Description: A two-panel FAQ block for React and Next.js with vertical category tabs, animated panel transitions, and per-question expand built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-tabbed-vertical.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Pick a topic, find your answer.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Questions are grouped by topic so you can ignore the ones that don't apply. Switch
                categories on the left and the answers update on the right.
            </p>
        </div>

        @* Two-panel grid *@
        <div class="mt-12 overflow-hidden rounded-2xl border bg-card">
            <div class="grid sm:grid-cols-[200px_1fr]">
                @* Vertical tabs *@
                <div role="tablist"
                     aria-orientation="vertical"
                     aria-label="FAQ categories"
                     class="flex flex-row gap-1 overflow-x-auto border-b p-3 sm:flex-col sm:border-b-0 sm:border-r">
                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var isActive = _activeCategory == category.Id;
                        <button type="button"
                                role="tab"
                                aria-selected="@isActive"
                                aria-controls="@($"tabpanel-{category.Id}")"
                                id="@($"tab-{category.Id}")"
                                @onclick="@(() => SelectCategory(category.Id))"
                                class="@Cn.Merge("flex shrink-0 items-center gap-2 rounded-lg px-3 py-2.5 text-left text-sm transition-colors", isActive ? "bg-muted font-semibold text-foreground" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                            <LucideIconCn Name="@category.Icon" Size="16" Class="size-4 shrink-0" aria-hidden="true" />
                            <span class="flex-1">@category.Label</span>
                            <span class="@Cn.Merge("rounded-full px-1.5 py-0.5 font-mono text-[10px]", isActive ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @category.Count
                            </span>
                        </button>
                    }
                </div>

                @* Tab panel *@
                <div id="@($"tabpanel-{_activeCategory}")"
                     role="tabpanel"
                     aria-labelledby="@($"tab-{_activeCategory}")">
                    @foreach (var faq in FilteredFaqs)
                    {
                        var item = faq;
                        var isOpen = _expandedId == item.Id;
                        var panelId = $"faq-panel-{item.Id}";
                        var triggerId = $"faq-trigger-{item.Id}";
                        <div class="border-b last:border-b-0">
                            <button type="button"
                                    id="@triggerId"
                                    aria-expanded="@isOpen"
                                    aria-controls="@panelId"
                                    @onclick="@(() => ToggleExpanded(item.Id))"
                                    class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                                <span class="text-base font-semibold text-foreground sm:text-lg">
                                    @item.Question
                                </span>
                                <LucideIconCn Name="chevron-down"
                                              Size="20"
                                              Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")"
                                              aria-hidden="true" />
                            </button>
                            @if (isOpen)
                            {
                                <div id="@panelId"
                                     role="region"
                                     aria-labelledby="@triggerId"
                                     class="overflow-hidden">
                                    <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                        @item.Answer
                                    </p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Read the docs
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqCategory(string Id, string Label, string Icon, int Count);
    private record FaqItem(string Id, string Category, string Question, string Answer);

    private string _activeCategory = "general";
    private string? _expandedId = null;

    private FaqItem[] FilteredFaqs => _faqs.Where(f => f.Category == _activeCategory).ToArray();

    private void SelectCategory(string categoryId)
    {
        _activeCategory = categoryId;
        _expandedId = null;
    }

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static readonly FaqCategory[] _categories =
    [
        new("general",   "General",   "life-buoy",    3),
        new("billing",   "Billing",   "credit-card",  3),
        new("security",  "Security",  "lock",         2),
        new("technical", "Technical", "settings",     2),
    ];

    private static readonly FaqItem[] _faqs =
    [
        new("g1", "general",
