@* ============================================================
   Block: faq-keyboard-nav
   Title: FaqKeyboardNav
   Description: A keyboard-first FAQ accordion block for React and Next.js with ArrowUp, ArrowDown, Home, and End navigation, visible focus rings, shortcut hints, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-keyboard-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Drive the docs from your keyboard.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Arrow keys, Home, and End move between questions. Enter or Space expands. Built for
                engineers who haven't touched a mouse since 2019.
            </p>
        </div>

        @* Shortcut hint row — desktop only *@
        <div class="mt-8 hidden flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-muted-foreground sm:flex">
            <span class="inline-flex items-center gap-1.5">
                <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px] font-semibold">
                    ↑
                </kbd>
                <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px] font-semibold">
                    ↓
                </kbd>
                Navigate
            </span>
            <span class="inline-flex items-center gap-1.5">
                <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px] font-semibold">
                    Home
                </kbd>
                <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px] font-semibold">
                    End
                </kbd>
                Jump
            </span>
            <span class="inline-flex items-center gap-1.5">
                <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px] font-semibold">
                    Enter
                </kbd>
                Expand
            </span>
        </div>

        @* Accordion *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 focus:outline-none focus-visible:bg-muted/60 focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-inset sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read API docs</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">View shortcuts</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "shortcuts";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("shortcuts",
            "What keyboard shortcuts are available on this FAQ?",
            "ArrowUp and ArrowDown move between question triggers. Home jumps to the first question and End jumps to the last. Enter or Space expands or collapses the focused question. Tab moves into and out of the accordion in document order. Every shortcut is also reflected in the visible hint row above the list."),
        new("api-key",
            "How do I generate an API key?",
            "Navigate to Settings → API Keys and click Generate New Key. Choose a descriptive name and set optional expiration and IP restrictions. Copy the key immediately because it will not be shown again. Store keys in environment variables, never commit them to source control, and rotate every 90 days."),
        new("rate-limits",
            "What are the API rate limits?",
            "Standard tier allows 1,000 requests per hour per key. Professional tier allows 10,000 per hour. Every response includes X-RateLimit-Limit, X-RateLimit-Remaining, and X-RateLimit-Reset headers. Implement exponential backoff on 429 responses and contact sales for custom limits over 100,000 per hour."),
        new("webhooks-setup",
            "How do I configure webhooks?",
            "Add your endpoint URL under Settings → Webhooks and select which events trigger delivery. Each request includes an HMAC signature in the X-Signature header for verification. Your endpoint must respond with 200 within five seconds, and failed deliveries retry up to three times with exponential backoff."),
        new("authentication",
            "What authentication methods are supported?",
            "API keys for programmatic access, OAuth 2.0 for third-party integrations, and SAML 2.0 SSO for enterprise customers. API keys use Bearer token authentication. OAuth follows the standard authorization code flow with refresh tokens. SAML setup is metadata exchange with your identity provider."),
        new("data-export",
            "How do I export large datasets?",
            "Use the /v1/exports endpoint to create asynchronous export jobs with filters, date ranges, and output format (JSON, CSV, Excel). Large exports run in the background and email you a download link when complete. Links expire after seven days and exports respect your normal API rate limits."),
        new("pagination",
            "What pagination method should I use?",
            "Cursor-based pagination. Each response returns a next_cursor field — pass it back as ?cursor=abc123 on the next request. Use ?limit=100 to control page size up to 100 items. Cursor pagination prevents duplicates when underlying data shifts between pages, unlike offset-based pagination."),
        new("error-handling",
            "How should I handle API errors?",
            "Every error response includes a JSON body with code, message, and details fields plus a standard HTTP status. Retry 5xx and 429 responses with exponential backoff and capped jitter. Fail fast on 4xx responses other than 429 and surface the message field directly to your operators for debugging."),
    ];
}
