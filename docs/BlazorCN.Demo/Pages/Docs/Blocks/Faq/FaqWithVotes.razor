@* ============================================================
   Block: faq-with-votes
   Title: FaqWithVotes
   Description: A marketing-scale FAQ block for React and Next.js with per-item upvote and downvote buttons, live count toggling, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-votes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help us help you
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Was this answer helpful?
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A single tap tells us which answers are working and which need a rewrite. We rewrite the
                bottom 10% every quarter.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-vote-panel-{item.Id}";
                var triggerId = $"faq-vote-trigger-{item.Id}";
                var vote = _votes.TryGetValue(item.Id, out var v) ? v : null;
                var upCount = item.Upvotes + (vote == "up" ? 1 : 0);
                var downCount = item.Downvotes + (vote == "down" ? 1 : 0);
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <div class="mt-5 flex flex-wrap items-center gap-3 border-t pt-4">
                                    <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                        Was this helpful?
                                    </span>
                                    <button
                                        type="button"
                                        @onclick="@(() => HandleVote(item.Id, "up"))"
                                        aria-pressed="@((vote == "up").ToString().ToLower())"
                                        aria-label="@($"Mark answer as helpful ({upCount} positive)")"
                                        class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors", vote == "up" ? "border-emerald-500/40 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-card text-muted-foreground hover:bg-muted/60")">
                                        <LucideIconCn Name="thumbs-up" Size="14" Class="size-3.5" aria-hidden="true" />
                                        <span class="tabular-nums">@upCount</span>
                                    </button>
                                    <button
                                        type="button"
                                        @onclick="@(() => HandleVote(item.Id, "down"))"
                                        aria-pressed="@((vote == "down").ToString().ToLower())"
                                        aria-label="@($"Mark answer as not helpful ({downCount} negative)")"
                                        class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors", vote == "down" ? "border-red-500/40 bg-red-500/10 text-red-600 dark:text-red-400" : "bg-card text-muted-foreground hover:bg-muted/60")">
                                        <LucideIconCn Name="thumbs-down" Size="14" Class="size-3.5" aria-hidden="true" />
                                        <span class="tabular-nums">@downCount</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Suggest an answer</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "reset-password";
    private readonly Dictionary<string, string> _votes = new();

    private void HandleVote(string id, string direction)
    {
        if (_votes.TryGetValue(id, out var current) && current == direction)
            _votes.Remove(id);
        else
            _votes[id] = direction;
    }

    private record FaqItem(string Id, string Question, string Answer, int Upvotes, int Downvotes);

    private static readonly FaqItem[] _faqItems =
    [
        new("reset-password",
            "How do I reset my password?",
            "Click 'Forgot password' on the sign-in screen, enter your email, and follow the link we send you. The link expires after 24 hours. If you don't see the email after a minute, check your spam folder or contact support and we'll resend it.",
            248, 6),
        new("offline",
            "Can I use the platform offline?",
            "Our mobile apps support full offline mode — changes you make queue locally and sync the moment you're back online. Web offline support is rolling out in Q2 as a progressive web app with the same conflict-resolution model.",
            132, 14),
        new("invite-team",
            "How do I invite team members?",
            "Open Settings → Team and click 'Invite member'. Paste a list of emails, assign roles (Admin, Editor, Viewer), and we'll send invitations that expire after 7 days. SSO-enabled teams can also let members self-join from your identity provider.",
            189, 4),
        new("plan-limits",
            "What happens if I exceed my plan limits?",
            "We'll email you at 80% and 100% of every metered limit. Soft overages are allowed for up to 7 days so a busy week never breaks production. After that we ask you to upgrade or trim usage. Downgrades take effect at the next billing cycle.",
            96, 21),
        new("notifications",
            "Can I customize email notifications?",
            "Yes. Open Settings → Notifications and pick a frequency (real-time, daily digest, or weekly) and types (mentions, updates, comments). Quiet hours mute everything overnight, and you can unsubscribe from any individual category without losing critical alerts.",
            154, 8),
        new("delete-account",
            "How do I delete my account?",
            "Go to Settings → Account → Delete account and confirm. We'll email a verification link valid for 24 hours. Your data is deactivated immediately and permanently erased after 30 days. Export anything you need first — deletion can't be undone.",
            71, 3),
    ];
}
