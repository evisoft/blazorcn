@* ============================================================
   Block: faq-masonry
   Title: FaqMasonry
   Description: A marketing-scale FAQ masonry grid block for React and Next.js with three-column CSS columns layout, expandable cards, varied stagger entrance, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-masonry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Answers, in any order you like.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A dozen of the questions we hear most often, laid out so you can scan and tap whichever
                one matches your situation.
            </p>
        </div>

        @* Masonry *@
        <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"masonry-faq-panel-{item.Id}";
                var triggerId = $"masonry-faq-trigger-{item.Id}";
                <div class="mb-4 break-inside-avoid">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="w-full overflow-hidden rounded-xl border bg-card p-5 text-left transition-colors hover:bg-muted/40">
                        <div class="flex items-start justify-between gap-4">
                            <h3 class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </h3>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                        </div>

                        @if (isOpen)
                        {
                            <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                <p class="pt-3 text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                            </div>
                        }
                    </button>
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

