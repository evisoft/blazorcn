@* ============================================================
   Block: faq-marketplace
   Title: FaqMarketplace
   Description: A marketing-scale FAQ accordion block for React and Next.js with a two-role audience toggle, single-item expand within each role, smooth transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Two sides, one FAQ.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick the side you're on and we'll show the answers that actually apply. Switch any time
                — your spot in the list won't move.
            </p>
        </div>

        @* Role toggle *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex rounded-full border bg-card p-1">
                @foreach (var r in _roles)
                {
                    var roleItem = r;
                    var isActive = roleItem.Key == _role;
                    <button
                        type="button"
                        aria-pressed="@isActive.ToString().ToLower()"
                        @onclick="@(() => { _role = roleItem.Key; _expanded = null; })"
                        class="@Cn.Merge("rounded-full px-5 py-2 text-sm font-semibold transition-colors", isActive ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @roleItem.Label
                    </button>
                }
            </div>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl border bg-card" aria-live="polite">
            @foreach (var it in CurrentFaqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"marketplace-faq-panel-{item.Id}";
                var triggerId = $"marketplace-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">@(_role == "buyer" ? "Start shopping" : "Open a shop")</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Contact support</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _role = "buyer";
    private string? _expanded = "buyer-purchase";

    private record RoleOption(string Key, string Label);
    private record FaqItem(string Id, string Question, string Answer);

    private static readonly RoleOption[] _roles =
    [
        new("buyer", "I'm buying"),
        new("seller", "I'm selling"),
    ];

    private static readonly FaqItem[] _buyerFaqs =
    [
        new("buyer-purchase",
            "How do I make a purchase safely?",
            "Browse listings, add to cart, and check out. We accept credit cards, PayPal, Apple Pay, and Google Pay. Payment is held in escrow until you confirm receipt or seven days pass. Buyer protection covers items not received or significantly different from description — open a case within 48 hours of delivery."),
        new("buyer-fees",
            "What fees do buyers pay?",
            "There are no buyer fees on most purchases. Payment processing (2.9 percent plus $0.30) is included in the listed price. International purchases may incur a 1.5 percent currency conversion fee. Expedited shipping and insurance are optional add-ons at checkout."),
        new("buyer-disputes",
            "What if my item doesn't arrive or is wrong?",
            "Open a case within 48 hours of delivery or seven days past expected delivery. Provide photos and any tracking. We mediate between buyer and seller and resolve within five business days. Funds stay in escrow until the dispute is closed and refunds are issued back to your original payment method."),
        new("buyer-returns",
            "Can I return items I bought?",
            "Return policies are set by individual sellers and shown on every listing. Most accept returns within 14 to 30 days. Return shipping is typically paid by the buyer unless the item is defective or misrepresented. Refunds process within two to five business days after the seller receives and inspects the return."),
        new("buyer-shipping",
            "How long does shipping take?",
            "Sellers must ship within two business days of order. Standard shipping runs 3 to 7 days domestic and 10 to 21 days international. Expedited (1 to 3 days) is available on eligible items. Tracking is provided on every order over $20 and delayed shipments qualify for partial refunds or cancellation."),
    ];

    private static readonly FaqItem[] _sellerFaqs =
    [
        new("seller-start",
            "How do I start selling?",
            "Create a free seller account, complete identity verification (government ID plus bank account), and list your first item. Basic sellers list up to 10 items per month free. The Pro plan ($19 per month) removes listing limits and reduces fees. New sellers have a $500 weekly limit for the first 90 days while you build a reputation."),
        new("seller-fees",
            "What fees do sellers pay?",
            "Standard sellers pay 12 percent commission plus $0.30 per transaction. Pro sellers pay 8 percent plus $0.30. Payment processing (2.9 percent) is included. Example: a $100 item nets $87.70 as a standard seller. No listing fees, no monthly minimums. Volume discounts kick in at $10,000 monthly sales."),
        new("seller-payouts",
            "When do I get paid?",
            "Funds release two days after buyer confirmation or seven days after delivery, whichever comes first. New sellers have a 14-day hold on the first five transactions. Payouts run Monday through Friday via free ACH (1 to 2 days) or instant transfer ($1.50 fee, 30 minutes). Minimum payout is $10."),
        new("seller-verification",
            "How does seller verification work?",
            "Level 1 verifies identity with a government ID and bank account. Level 2 verifies address with a utility bill. Level 3 verifies a registered business with EIN. Higher levels unlock larger selling limits, faster payouts, and a premium badge on your listings. Reverification happens annually."),
        new("seller-disputes",
            "What happens if a buyer opens a dispute?",
            "You have 48 hours to respond with evidence (photos, tracking, communications). We review both sides and decide within five business days. Outcomes range from full refund to dispute closed in your favor. Sellers above a 5 percent dispute rate get an account review and potential listing restrictions."),
    ];

    private FaqItem[] CurrentFaqItems => _role == "seller" ? _sellerFaqs : _buyerFaqs;
}
