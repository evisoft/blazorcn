@* ============================================================
   Block: faq-split-view
   Title: FaqSplitView
   Description: A master-detail FAQ block for React and Next.js with question list on the left and full answer panel on the right, hero-scale headline cluster, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-split-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Knowledge base
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Pick a question, read the answer.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Browse the question list and the full answer opens beside it. Long answers get the
                reading space they deserve.
            </p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-[280px_1fr]">
            @* Master list *@
            <div
                role="tablist"
                aria-label="FAQ questions"
                class="overflow-hidden rounded-2xl border bg-card">
                @foreach (var it in _faqItems)
                {
                    var item = it;
                    var isActive = _selectedId == item.Id;
                    var triggerId = $"faq-split-trigger-{item.Id}";
                    <button
                        type="button"
                        role="tab"
                        id="@triggerId"
                        aria-selected="@isActive.ToString().ToLowerInvariant()"
                        aria-controls="faq-split-panel"
                        @onclick="@(() => _selectedId = item.Id)"
                        class="@Cn.Merge("block w-full border-b px-5 py-4 text-left transition-colors last:border-0", isActive ? "bg-muted/60 text-foreground" : "text-muted-foreground hover:bg-muted/30 hover:text-foreground")">
                        <p class="@Cn.Merge("text-sm", isActive ? "font-semibold text-foreground" : "font-medium")">
                            @item.Question
                        </p>
                        <p class="mt-1 text-xs text-muted-foreground">@item.Category</p>
                    </button>
                }
            </div>

            @* Detail panel *@
            @{
                var selected = _faqItems.FirstOrDefault(x => x.Id == _selectedId) ?? _faqItems[0];
            }
            <div
                id="faq-split-panel"
                role="region"
                aria-labelledby="@($"faq-split-trigger-{selected.Id}")"
                class="rounded-2xl border bg-card px-6 py-6 sm:px-8 sm:py-8">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @selected.Category
                </p>
                <h3 class="mt-3 text-base font-semibold text-foreground sm:text-lg">
                    @selected.Question
                </h3>
                <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                    @selected.Answer
                </p>
            </div>
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Category, string Question, string Answer);

    private string _selectedId = "data-sync";

    private static readonly FaqItem[] _faqItems =
    [
        new("data-sync", "Technical",
            "How often does data sync?",
            "Data syncs in real-time over WebSocket connections — changes by one teammate appear immediately for everyone viewing the same resource. For offline edits, sync happens automatically when connectivity is restored using conflict resolution algorithms. A background sync runs every five minutes for non-critical updates like view counts and last-accessed timestamps. You can also trigger sync manually from Settings → Sync."),
        new("custom-fields", "Features",
            "Can I create custom fields?",
            "Yes — custom fields ship with Professional and Enterprise plans. Open Settings → Custom Fields to create text, number, date, dropdown, or multi-select fields, with up to 50 per workspace. Fields can be marked required and validated. Use the API to programmatically create or update field values, and they show up in exports, filters, and sorts."),
        new("backup-restore", "Technical",
            "How do backups work?",
            "Automated backups run daily at 02:00 UTC. Standard plans retain 30 days of history; Enterprise retains 90 days. Restore from any backup point via Settings → Backups, or contact support. Enterprise customers also get point-in-time recovery with 15-minute granularity. Every backup is encrypted and replicated across geographically distributed regions with triple redundancy."),
        new("team-permissions", "Security",
            "How do team permissions work?",
            "Role-based access with five default roles: Owner, Admin, Member, Guest, and Viewer. Owners manage billing and can delete the workspace. Admins handle members and settings but not billing. Members create and edit content. Guests have project-scoped access. Viewers are read-only. You can also customize permissions per workspace."),
        new("mobile-features", "Features",
            "What features are in the mobile apps?",
            "Native iOS and Android apps support offline access, push notifications, camera uploads, voice memos, and biometric authentication. View, create, edit, and comment on items anywhere. Bulk operations and integrations are still web-only. Background sync keeps everything fresh, and tablet apps use a split-view layout for productivity."),
        new("export-formats", "Technical",
            "What export formats are supported?",
            "Export to CSV, JSON, Excel (XLSX), and PDF. CSV includes every field with proper escaping. JSON preserves the full data structure with relationships. Excel uses multiple sheets for different data types. PDF is formatted for printing with charts when relevant. Large exports run asynchronously and arrive via email link."),
        new("compliance", "Security",
            "What compliance certifications do you have?",
            "SOC 2 Type II, ISO 27001, GDPR, CCPA, and HIPAA — audited annually by independent third parties. Reports are available to Enterprise customers under NDA. Our DPAs include standard contractual clauses for international transfers, and we comply with industry-specific rules like FINRA for financial services and FERPA for education."),
        new("automation", "Features",
            "Can I automate repetitive tasks?",
            "Yes — use Rules and Workflows. Rules trigger actions on events like status changes or due dates: send notifications, update fields, create tasks, or call webhooks. Workflows are multi-step automations with conditions, delays, and loops. Professional supports 100 automations; Enterprise is unlimited."),
    ];
}
