@* ============================================================
   Block: faq-with-schema
   Title: FaqWithSchema
   Description: A marketing-scale FAQ block for React and Next.js with embedded JSON-LD FAQPage schema, copy-to-clipboard, single-item expand, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-schema.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">

    @* Marketing headline cluster *@
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Frequently asked questions
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Built for FAQ rich results.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            Every question on this page ships with valid JSON-LD FAQPage schema. Crawlers see the
            structured data automatically - no extra setup required.
        </p>
    </div>

    @* Accordion *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
        @foreach (var it in _faqItems)
        {
            var item = it;
            var isOpen = _expanded == item.Id;
            var panelId = $"faq-schema-panel-{item.Id}";
            var triggerId = $"faq-schema-trigger-{item.Id}";
            <div class="border-b last:border-0">
                <button
                    type="button"
                    id="@triggerId"
                    aria-expanded="@isOpen.ToString().ToLowerInvariant()"
                    aria-controls="@panelId"
                    @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                    class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                    <span class="text-base font-semibold text-foreground sm:text-lg">
                        @item.Question
                    </span>
                    <LucideIconCn Name="chevron-down" Size="20"
                        Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")"
                        aria-hidden="true" />
                </button>

                @if (isOpen)
                {
                    <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                        <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                            @item.Answer
                        </p>
                    </div>
                }
            </div>
        }
    </div>

    @* Schema preview *@
    <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
        <div class="flex items-center justify-between gap-4 border-b px-6 py-4 sm:px-8">
            <div>
                <p class="text-sm font-semibold text-foreground">JSON-LD FAQPage schema</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Already embedded above. Copy it for your own page.
                </p>
            </div>
            <button
                type="button"
                @onclick="HandleCopy"
                aria-label="Copy JSON-LD schema to clipboard"
                class="inline-flex items-center gap-1.5 rounded-md border bg-background px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-muted/60">
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600" aria-hidden="true" />
                    @:Copied
                }
                else
                {
                    <LucideIconCn Name="copy" Size="14" Class="size-3.5" aria-hidden="true" />
                    @:Copy
                }
            </button>
        </div>
        <pre class="max-h-72 overflow-auto bg-muted/40 px-6 py-5 font-mono text-xs leading-relaxed text-foreground sm:px-8"><code>@_schemaString</code></pre>
    </div>

    @* CTAs *@
    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <ButtonCn Class="w-full sm:w-[220px]">Read SEO guide</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Test on Google</ButtonCn>
    </div>

</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("structured-data",
            "What is structured data and why does it matter?",
            "Structured data is code in a specific format like JSON-LD that helps search engines understand your content. It enables rich results - FAQ snippets, review stars, event cards - that stand out in search listings and lift click-through rates even when rankings stay the same."),
        new("implement-faq-schema",
            "How do I implement valid FAQ schema?",
            "Use JSON-LD inside a script tag with type application/ld+json. The schema needs @context, @type FAQPage, and a mainEntity array of Question objects. Each question needs a name and an acceptedAnswer with text. Place the script anywhere in the document - the head is conventional, but body works too."),
        new("ranking-impact",
            "Will FAQ schema improve my search rankings?",
            "Schema markup doesn't directly improve rankings, but it can lift click-through rates by surfacing FAQ snippets in search results. Higher CTR can indirectly boost rankings over time. The real benefit is enhanced visibility and a more informative listing that competes against pages without rich results."),
        new("other-schema-types",
            "What other schema types should I consider?",
            "Common types include Article, Product, Recipe, Event, LocalBusiness, and BreadcrumbList. Each has its own required and recommended properties. Schema.org documents them all. Multiple schema types can coexist on one page, so an Article can also expose FAQPage markup for the embedded FAQ section."),
        new("test-schema",
            "How do I test schema markup before shipping?",
            "Use Google's Rich Results Test at search.google.com/test/rich-results to validate the markup and preview how it appears in search. Google Search Console reports any errors discovered after launch. Fix every validation error to stay eligible for rich results across the indexable URLs of your site."),
    ];

    private static readonly string _schemaString = BuildSchemaString();

    private static string BuildSchemaString()
    {
        var lines = new System.Text.StringBuilder();
        lines.AppendLine("{");
        lines.AppendLine("  \"@context\": \"https://schema.org\",");
        lines.AppendLine("  \"@type\": \"FAQPage\",");
        lines.AppendLine("  \"mainEntity\": [");
        for (var i = 0; i < _faqItems.Length; i++)
        {
            var faq = _faqItems[i];
            var comma = i < _faqItems.Length - 1 ? "," : "";
            lines.AppendLine("    {");
            lines.AppendLine("      \"@type\": \"Question\",");
            lines.AppendLine($"      \"name\": \"{faq.Question}\",");
            lines.AppendLine("      \"acceptedAnswer\": {");
            lines.AppendLine("        \"@type\": \"Answer\",");
            lines.AppendLine($"        \"text\": \"{faq.Answer}\"");
            lines.AppendLine("      }");
            lines.AppendLine($"    }}{comma}");
        }
        lines.AppendLine("  ]");
        lines.Append("}");
        return lines.ToString();
    }

    private string? _expanded = "structured-data";
    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
