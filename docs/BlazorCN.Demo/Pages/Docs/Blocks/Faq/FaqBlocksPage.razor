    ];
}";

    private const string FaqWizardCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div>
        @* Marketing headline cluster *@
        <div class=""mx-auto max-w-2xl text-center"">
            <p class=""text-xs font-medium uppercase tracking-widest text-muted-foreground"">
                Get started in five steps
            </p>
            <h2 class=""mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"">
                One question at a time.
            </h2>
            <p class=""mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground"">
                A guided FAQ that walks you from a fresh signup to a published dashboard. Read each
                answer, then advance when you&#x27;re ready.
            </p>
        </div>

        @* Wizard panel *@
        <div class=""mt-10 overflow-hidden rounded-2xl border bg-card"">
            @* Progress indicator *@
            <div class=""flex items-center justify-between gap-4 border-b px-6 py-5 sm:px-8"">
                <p class=""text-xs font-medium uppercase tracking-widest text-muted-foreground"">
                    Step <span class=""tabular-nums text-foreground"">@(_step + 1)</span> of&#160;<span class=""tabular-nums"">@_total</span>
                </p>
                <ol class=""flex items-center gap-2"">
                    @foreach (var it in _faqSteps)
                    {
                        var faqStep = it;
                        var i = System.Array.IndexOf(_faqSteps, faqStep);
                        var isActive = i == _step;
                        var isComplete = i < _step;
                        <li key=""@faqStep.Id"">
                            <button
                                type=""button""
                                @onclick=""@(() => _step = i)""
                                aria-current=""@(isActive ? ""step"" : null)""
                                aria-label=""@($""Go to step {i + 1} of {_total}"")""
                                class=""@Cn.Merge(""h-1.5 rounded-full transition-all"", isActive ? ""w-8 bg-foreground"" : isComplete ? ""w-4 bg-foreground/60 hover:bg-foreground/80"" : ""w-4 bg-muted-foreground/30 hover:bg-muted-foreground/50"")"" />
                        </li>
                    }
                </ol>
            </div>

            @* Step content *@
            <div
                role=""region""
                aria-live=""polite""
                aria-labelledby=""faq-wizard-question""
                class=""relative min-h-[260px] px-6 py-8 sm:px-8 sm:py-10"">
                <div>
                    <h3
                        id=""faq-wizard-question""
                        class=""text-base font-semibold text-foreground sm:text-lg"">
                        @_current.Question
                    </h3>
                    <p class=""mt-4 text-base leading-relaxed text-muted-foreground"">
                        @_current.Answer
                    </p>
                </div>
            </div>
        </div>

        @* Prev/Next navigation *@
        <div class=""mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center"">
            <ButtonCn Variant=""ButtonVariant.Ghost"" Class=""w-full sm:w-[180px]"" @onclick=""GoPrev"" Disabled=""@_isFirst"" aria-label=""Go to previous step"">
                <LucideIconCn Name=""arrow-left"" Size=""16"" Class=""mr-1 size-4"" aria-hidden=""true"" />
                Previous
            </ButtonCn>
            <ButtonCn Class=""w-full sm:w-[200px]"" @onclick=""GoNext"" Disabled=""@_isLast"" aria-label=""@(_isLast ? ""Final step reached"" : ""Go to next step"")"">
                @(_isLast ? ""All done"" : ""Next step"")
                @if (!_isLast)
                {
                    <LucideIconCn Name=""arrow-right"" Size=""16"" Class=""ml-1 size-4"" aria-hidden=""true"" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _step = 0;

    private record FaqStep(string Id, string Question, string Answer);

    private static readonly FaqStep[] _faqSteps =
    [
        new(""create-account"",
            ""How do I create an account and verify my email?"",
            ""Sign up with a work email and we'll send a verification link valid for 24 hours. Click the link to land in your fresh workspace. Single sign-on with Google, GitHub, and Microsoft is available on the same screen if you'd rather skip the password.""),
        new(""connect-data"",
            ""How do I connect my first data source?"",
            ""From the welcome screen, pick a source (Postgres, Snowflake, BigQuery, or one of 40+ others) and paste read-only credentials. We test the connection live and confirm row counts so you know it worked before you move on.""),
        new(""invite-team"",
            ""How do I invite my team and assign roles?"",
            ""Open Settings → Team and paste a list of emails. Pick a role (Admin, Editor, Viewer) for each, and we send invitations that expire after 7 days. SSO-enabled teams can also let members self-join from your identity provider.""),
        new(""first-dashboard"",
            ""How do I build my first dashboard?"",
            ""Click 'New dashboard', drag in any of the prebuilt charts, and bind them to the source you connected. Filters cascade across the whole canvas, and changes are autosaved every keystroke so you'll never lose your place.""),
        new(""share-publish"",
            ""How do I share or publish what I built?"",
            ""Open the share menu in the top right. You can invite specific people, generate a public link with optional password, or embed the dashboard in any iframe-friendly tool. All access is logged in the audit trail.""),
    ];

    private int _total => _faqSteps.Length;
    private FaqStep _current => _faqSteps[_step];
    private bool _isFirst => _step == 0;
    private bool _isLast => _step == _total - 1;

    private void GoPrev() => _step = Math.Max(0, _step - 1);
    private void GoNext() => _step = Math.Min(_total - 1, _step + 1);
}";
}
