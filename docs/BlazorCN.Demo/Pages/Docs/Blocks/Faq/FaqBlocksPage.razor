            ""Yes — Team plans include 5 seats and Organization plans include unlimited seats with shared workspaces, centralized billing, and usage analytics. Volume pricing and priority support are included on both.""),
    ];

    private RenderFragment RenderHighlighted(string text) => builder =>
    {
        var parts = System.Text.RegularExpressions.Regex.Split(text, @""(\s+)"");
        int seq = 0;
        foreach (var part in parts)
        {
            var stripped = System.Text.RegularExpressions.Regex.Replace(part, @""[.,!?;:()]"", """");
            if (_highlightTerms.Contains(stripped))
            {
                builder.OpenElement(seq++, ""span"");
                builder.AddAttribute(seq++, ""class"", ""rounded bg-amber-500/10 px-1 text-foreground"");
                builder.AddContent(seq++, part);
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, ""span"");
                builder.AddContent(seq++, part);
                builder.CloseElement();
            }
        }
    };
}";

