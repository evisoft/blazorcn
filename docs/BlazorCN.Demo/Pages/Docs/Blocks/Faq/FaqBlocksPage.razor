    private record FaqItem(string Id, string Question, string Answer);

    private string? _expanded = ""install"";
    private string? _copiedId = null;

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private void HandleCopy(string id, string text)
    {
        _copiedId = id;
        _ = ResetCopiedAfterDelayAsync(id);
    }

    private async Task ResetCopiedAfterDelayAsync(string id)
