@* ============================================================
   Block: faq-sortable
   Title: FaqSortable
   Description: A category-filtered FAQ block for React and Next.js with subtle pill group filters, single-item expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-sortable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Filter by category to find the answer you need. Still stuck? Our support team replies in
                under an hour.
            </p>
        </div>

        <div role="tablist" aria-label="FAQ categories" class="mt-8 flex flex-wrap items-center justify-center gap-2">
            @foreach (var cat in _categories)
            {
                var category = cat;
                var isActive = _activeCategory == category;
                <button type="button"
                        role="tab"
                        aria-selected="@isActive"
                        @onclick="@(() => { _activeCategory = category; _expanded = null; })"
                        class="@Cn.Merge("h-9 rounded-full border px-4 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-card text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                    @category
                </button>
            }
        </div>

        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in FilteredItems)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-cat-panel-{item.Id}";
                var triggerId = $"faq-cat-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen"
                            aria-controls="@(isOpen ? panelId : null)"
                            @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down"
                                      Size="20"
                                      aria-hidden="true"
                                      Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>
                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Read the docs
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Category, string Question, string Answer);

    private string _activeCategory = "All";
    private string? _expanded = null;

    private static readonly string[] _categories = ["All", "Account", "Billing", "Platform", "Security"];

    private static readonly FaqItem[] _faqItems =
    [
        new("payments", "Billing",
            "What payment methods do you accept?",
            "We accept every major credit card, PayPal, Apple Pay, Google Pay, and bank transfers for Enterprise plans. Payments run securely through Stripe with PCI DSS Level 1 compliance."),
        new("password", "Account",
            "How do I reset my password?",
            "Click 'Forgot password' on the login screen, enter your email, and we'll send a reset link within five minutes. The link expires after 24 hours for security."),
        new("export", "Platform",
            "Can I export my data anytime?",
            "Yes — export everything from Settings → Data Export in JSON, CSV, or SQL. Large exports run in the background and arrive by email when ready."),
        new("api", "Platform",
            "Do you offer API access?",
            "API access ships with Pro and Enterprise. Pro gets 1,000 requests per hour and Enterprise gets 10,000. Generate keys from your dashboard and read full docs at docs.example.com/api."),
        new("uptime", "Platform",
            "What's your uptime guarantee?",
            "99.9% on every paid plan, monitored live at status.example.com. If we miss it, you get a 10% credit. Enterprise plans run on dedicated infrastructure with a 99.99% SLA."),
        new("team", "Account",
            "How do I add team members?",
            "Open Settings → Team and click 'Invite member'. Enter their email and assign Admin, Editor, or Viewer. They'll receive an invite with setup instructions immediately."),
        new("mobile", "Platform",
            "Is there a mobile app?",
            "Yes — native iOS and Android apps that sync in real time, work offline, and send push notifications for important activity."),
        new("security", "Security",
            "What security measures do you implement?",
            "AES-256 at rest, TLS 1.3 in transit, bcrypt-hashed passwords, quarterly security audits, SOC 2 Type II compliance, and SAML SSO for Enterprise customers."),
    ];

    private FaqItem[] FilteredItems =>
        _activeCategory == "All"
            ? _faqItems
            : Array.FindAll(_faqItems, x => x.Category == _activeCategory);
}
