@* ============================================================
   Block: faq-onboarding
   Title: FaqOnboarding
   Description: A numbered step-by-step FAQ accordion block for React and Next.js with hero-scale headline cluster, sequential step indicators, smooth disclosure transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-onboarding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Getting started
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Your first hour, step by step.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Everything new users ask in their first session — answered in the order you'll need
                them. Most teams ship their first project before lunch.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @{
                int index = 0;
            }
            @foreach (var it in _faqItems)
            {
                var item = it;
                var stepIndex = index;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-onboarding-panel-{item.Id}";
                var triggerId = $"faq-onboarding-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start gap-5 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-sm font-semibold text-muted-foreground">
                            @(stepIndex + 1)
                        </span>
                        <span class="flex-1 text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-[76px] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[84px]">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
                index++;
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Start the tutorial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Watch the demo</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "first-project";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("first-project",
            "How do I get started with my first project?",
            "After signing up, click 'Create Project' from your dashboard. Give your project a name and description, then choose a template or start from scratch. Follow the setup wizard to configure your project settings. Your first project is created in seconds, and you can invite team members immediately."),
        new("after-signup",
            "What should I do first after creating my account?",
            "Complete your profile in Account Settings, connect your preferred integrations, and watch the 5-minute quickstart video in the welcome modal. Create your first project to familiarize yourself with the interface, then explore our interactive tutorial available from the Help menu for hands-on guidance."),
        new("tutorials",
            "Where can I find tutorials and documentation?",
            "Access our complete documentation from the Help menu or at docs.example.com. Video tutorials live in the Learning Center with topics ranging from basics to advanced features. Join our community forum to ask questions and learn from other users' experiences."),
        new("invite-team",
            "How do I invite team members?",
            "Open your project settings and click the Team tab. Click 'Invite Member', enter their email, and assign a role (Admin, Editor, or Viewer). They'll receive an invitation email with setup instructions. Team size depends on your plan tier."),
        new("integrations",
            "What if I'm having trouble connecting integrations?",
            "Visit Settings > Integrations and click 'Connect' next to the service you want. Follow the OAuth flow to grant permissions. If you hit an error, check our integration troubleshooting guide or contact support with screenshots. Most connection issues resolve by revoking and reconnecting access."),
        new("stuck",
            "Where do I find help if I'm stuck?",
            "Use the in-app Help Center (question mark icon in the top-right) for contextual assistance. Search our knowledge base for common solutions. Pro users can email support@example.com for priority help, and our Slack community is great for peer support and quick answers."),
        new("productive",
            "How long does it take to become productive?",
            "Most users complete their first project within 30 minutes. The learning curve is gentle thanks to guided onboarding, and you'll be comfortable with core features within a few days. We recommend completing at least one full workflow to understand the platform's capabilities."),
    ];
}
