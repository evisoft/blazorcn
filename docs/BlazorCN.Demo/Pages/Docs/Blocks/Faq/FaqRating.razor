@* ============================================================
   Block: faq-rating
   Title: FaqRating
   Description: A marketing-scale FAQ accordion block for React and Next.js with a was-this-helpful thumb up and thumb down feedback affordance per item built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Did this answer help?
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Tap the thumb after each answer so we know which docs to rewrite first. Your feedback
                shapes next week's content updates.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-rating-panel-{item.Id}";
                var triggerId = $"faq-rating-trigger-{item.Id}";
                var userVote = _feedback.TryGetValue(item.Id, out var v) ? v : null;
                var helpfulPct = (int)Math.Round((double)item.Helpful / item.Total * 100);
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <span class="mt-1 block text-xs text-muted-foreground">
                                @helpfulPct% found this helpful · @item.Total responses
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <div class="mt-5 flex items-center gap-3 border-t pt-5">
                                    <span class="text-sm text-muted-foreground">Was this helpful?</span>
                                    <button
                                        type="button"
                                        @onclick="@(() => HandleFeedback(item.Id, "up"))"
                                        aria-pressed="@((userVote == "up").ToString().ToLower())"
                                        aria-label="Yes, this was helpful"
                                        class="@Cn.Merge("inline-flex size-9 items-center justify-center rounded-md border transition-colors", userVote == "up" ? "border-emerald-500/40 bg-emerald-500/10 text-emerald-600" : "hover:bg-muted/60")">
                                        <LucideIconCn Name="thumbs-up" Size="16" Class="size-4" aria-hidden="true" />
                                    </button>
                                    <button
                                        type="button"
                                        @onclick="@(() => HandleFeedback(item.Id, "down"))"
                                        aria-pressed="@((userVote == "down").ToString().ToLower())"
                                        aria-label="No, this was not helpful"
                                        class="@Cn.Merge("inline-flex size-9 items-center justify-center rounded-md border transition-colors", userVote == "down" ? "border-red-500/40 bg-red-500/10 text-red-600" : "hover:bg-muted/60")">
                                        <LucideIconCn Name="thumbs-down" Size="16" Class="size-4" aria-hidden="true" />
                                    </button>
                                    @if (userVote != null)
                                    {
                                        <span class="text-xs text-muted-foreground">
                                            Thanks — we'll use this to improve.
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Browse the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "getting-started";
    private Dictionary<string, string> _feedback = new();

    private void HandleFeedback(string id, string value)
    {
        _feedback[id] = value;
    }

    private record FaqItem(string Id, string Question, string Answer, int Helpful, int Total);

    private static readonly FaqItem[] _faqItems =
    [
        new("getting-started",
            "How do I get started with the platform?",
            "Sign up for a free account, browse the component library, and click Copy Code on any component. Paste it into your React or Next.js project, install the listed dependencies, and you're shipping. The Quick Start guide walks you through theme setup and the dark-mode toggle in under ten minutes.",
            232, 245),
        new("payments",
            "What payment methods are accepted?",
            "We accept every major credit card (Visa, Mastercard, American Express, Discover) and PayPal, all processed securely through Stripe with PCI DSS compliance. Enterprise customers can pay by wire or invoice with NET 30 terms.",
            174, 189),
        new("cancel",
            "Can I cancel my subscription anytime?",
            "Cancel anytime from Account Settings with one click. You'll keep Pro access through the end of your current billing period and won't be charged again. We also honor a 14-day money-back guarantee on new subscriptions, no questions asked.",
            301, 312),
        new("customize",
            "How do I customize component styles?",
            "Every component uses Tailwind CSS theme variables, so changing colors, spacing, and typography is a one-line edit in tailwind.config.js. You can also override classes inline or wrap blocks in a variant prop pattern for reusable custom styles across your app.",
            138, 156),
        new("typescript",
            "Is TypeScript required?",
            "TypeScript is not required but strongly recommended. Every component ships with full type definitions so you get autocomplete and inline documentation in your IDE. JavaScript projects work too — generated declaration files give you the same autocomplete experience.",
            192, 203),
        new("frameworks",
            "What frameworks are supported?",
            "Components work in React 18+, Next.js 16+, Remix, Vite, Astro, and any React-based framework. They're built with modern patterns including Server Components and React 19 hooks. Full compatibility details are listed in each block's documentation header.",
            268, 278),
    ];
}
