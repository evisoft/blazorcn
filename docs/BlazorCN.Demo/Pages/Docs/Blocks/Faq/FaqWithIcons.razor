@* ============================================================
   Block: faq-with-icons
   Title: FaqWithIcons
   Description: A marketing-scale FAQ accordion with category lucide icons prefixed to each question for React and Next.js, built with shadcn/ui, motion/react, and Tailwind CSS
   Source: original/blocks/faq/faq-with-icons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Browse by topic
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Find the answer at a glance.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every question is tagged with a category icon so you can spot the topic you need without
                reading every line.
            </p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="flex items-start gap-4">
                            <LucideIconCn Name="@item.Icon" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" aria-hidden="true" />
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-[3.75rem] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[4.25rem]">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "billing";

    private record FaqItem(string Id, string Icon, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("billing", "credit-card",
            "What payment methods do you accept?",
            "We accept every major credit card (Visa, Mastercard, Amex, Discover), PayPal, and bank transfer for annual plans. All payments run through Stripe with PCI DSS compliance. Enterprise customers can bill by invoice with NET 30 terms."),
        new("plan-changes", "refresh-ccw",
            "Can I upgrade or downgrade my plan at any time?",
            "Yes. Change plans anytime from your account dashboard. Upgrades apply immediately with prorated billing for the current period. Downgrades take effect at your next billing cycle so you keep the value of your current plan."),
        new("security", "shield",
            "Is my data encrypted and secure?",
            "All data is encrypted in transit with TLS 1.3 and at rest with AES-256. We maintain SOC 2 Type II compliance and run third-party penetration tests quarterly. Backups run every 6 hours across three geographically redundant regions."),
        new("integrations", "plug",
            "What integrations do you support?",
            "Native integrations ship for Slack, Microsoft Teams, Google Workspace, Salesforce, HubSpot, Zapier, and over 100 other tools. Our REST API and webhooks cover everything else, and enterprise plans include dedicated integration support."),
        new("collaboration", "users",
            "How does team collaboration work?",
            "Team plans support unlimited members with role-based access (Admin, Editor, Viewer), live presence indicators, and real-time editing. Every change is captured in an audit log, and mentions plus threaded comments keep conversation in context."),
        new("support", "help-circle",
            "How do I reach customer support?",
            "Standard support runs 24/5 with median first response under 2 hours. Business plans add 24/7 chat coverage with a 1-hour response SLA, and Enterprise plans include a dedicated success manager plus a private Slack channel with our on-call engineering team."),
    ];
}
