@* ============================================================
   Block: faq-with-last-updated
   Title: FaqWithLastUpdated
   Description: A marketing-scale FAQ accordion with a static last-updated timestamp on every answer for React and Next.js, built with shadcn/ui, motion/react, and Tailwind CSS
   Source: original/blocks/faq/faq-with-last-updated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Always current
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Fresh answers, dated.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer carries a last-updated stamp so you know exactly when the information you
                are reading was reviewed and revised.
            </p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"with-last-updated-faq-panel-{item.Id}";
                var triggerId = $"with-last-updated-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <p class="mt-5 inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                    <LucideIconCn Name="calendar-clock" Size="14" Class="size-3.5" aria-hidden="true" />
                                    @item.UpdatedLabel
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">View changelog</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Contact support</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "pricing-changes";

    private record FaqItem(string Id, string Question, string Answer, string UpdatedLabel);

    private static readonly FaqItem[] _faqItems =
    [
        new("pricing-changes",
            "Did pricing change recently?",
            "Yes — we lowered the Starter plan from $19 to $12 per month and added a new Team plan at $39 per seat. Existing customers keep their current rate for the next 12 months. New customers see the updated pricing on the pricing page.",
            "Updated 3 days ago"),
        new("new-integrations",
            "What new integrations were added this quarter?",
            "We shipped native integrations with Linear, Notion, Vercel, Cloudflare, and Datadog this quarter. Each integration includes OAuth setup, two-way sync, and real-time webhooks. Documentation is linked from Settings → Integrations.",
            "Updated 1 week ago"),
        new("data-policy",
            "Has your data retention policy changed?",
            "We extended free-tier data retention from 30 days to 90 days, and Pro/Business plans now retain data indefinitely while the subscription is active. Canceled accounts retain data for 90 days before permanent deletion.",
            "Updated 2 weeks ago"),
        new("ai-features",
            "What AI features are available?",
            "AI assist is available on Pro and above. Capabilities include answer drafting, summarization, semantic search across your workspace, and a chat interface that can read and edit documents with permission. All AI calls run on opted-in data only.",
            "Updated 3 weeks ago"),
        new("compliance",
            "Are you SOC 2 and GDPR compliant?",
            "Yes. We maintain SOC 2 Type II and ISO 27001 certifications, plus GDPR and CCPA compliance. Our Trust Center publishes the latest reports, sub-processor list, and DPA template available for download by any customer.",
            "Updated 1 month ago"),
        new("mobile-app",
            "When is the mobile app launching?",
            "The native iOS app shipped to the App Store last month with full editing, comments, notifications, and offline viewing. The Android app is in public beta with a general availability date in the next 6 weeks.",
            "Updated 2 months ago"),
    ];
}
