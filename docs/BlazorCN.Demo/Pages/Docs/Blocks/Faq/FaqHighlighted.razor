@* ============================================================
   Block: faq-highlighted
   Title: FaqHighlighted
   Description: A marketing-scale FAQ block for React and Next.js with one prominently highlighted featured question above a standard accordion, keyword highlighting in answers, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-highlighted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The big question, answered first.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                We led with the question we hear the most. Everything else lives in the accordion below
                — open whatever you need.
            </p>
        </div>

        @* Featured *@
        <div class="mt-10 overflow-hidden rounded-2xl border-2 border-primary/30 bg-primary/5">
            <button
                type="button"
                id="faq-trigger-featured"
                aria-expanded="@_featuredOpen.ToString().ToLower()"
                aria-controls="faq-panel-featured"
                @onclick="@(() => _featuredOpen = !_featuredOpen)"
                class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-primary/10 sm:px-8 sm:py-6">
                <span class="flex items-start gap-4">
                    <LucideIconCn Name="star" Size="20" Class="mt-1 size-5 shrink-0 fill-amber-500 text-amber-500" />
                    <span>
                        <span class="block text-base font-semibold text-foreground sm:text-lg">
                            @_featured.Question
                        </span>
                        <span class="mt-1 block text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            Most asked
                        </span>
                    </span>
                </span>
                <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", _featuredOpen ? "rotate-180" : "")" />
            </button>

            @if (_featuredOpen)
            {
                <div id="faq-panel-featured" role="region" aria-labelledby="faq-trigger-featured" class="overflow-hidden">
                    <p class="px-6 pb-6 pl-[3.75rem] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[4.25rem]">
                        @RenderHighlighted(_featured.Answer)
                    </p>
                </div>
            }
        </div>

        @* Standard accordion *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @RenderHighlighted(item.Answer)
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Talk to sales</ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _featuredOpen = true;
    private string? _expanded = null;

    private static readonly HashSet<string> _highlightTerms = new(StringComparer.Ordinal)
    {
        "premium", "lifetime", "commercial", "priority", "unlimited",
        "money-back", "TypeScript", "Server"
    };

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem _featured = new(
        "featured",
        "What's actually included in the Pro plan?",
        "Pro unlocks every premium block, advanced charts, shaders, and AI components, plus unlimited downloads, lifetime updates, and full source code with a commercial license for unlimited client work. Priority support replies in under one hour, and Pro subscribers get early access to new releases the day they ship."
    );

    private static readonly FaqItem[] _faqItems =
    [
        new("commercial",
            "Can I use components in commercial client projects?",
            "Yes — your Pro license grants unlimited use in commercial work with no cap on revenue or end products. The only restriction is that you cannot resell the components as a competing component library."),
        new("refunds",
            "Do you offer refunds?",
            "We offer a 14-day money-back guarantee on every plan with no questions asked. Refunds land back on your original payment method within 5–7 business days of approval."),
        new("install",
            "How do I install components into an existing project?",
            "Use the shadcn CLI with `npx shadcn@latest add [component]` or copy the source directly from any block page. Components drop into existing shadcn/ui projects without configuration changes and follow the same install patterns you already know."),
        new("plan-changes",
            "Can I upgrade or downgrade my plan?",
            "Yes, change your plan anytime from account settings. Upgrades apply immediately with prorated billing, and downgrades take effect at the end of your current billing period so you keep the value you've already paid for."),
        new("frameworks",
            "Which frameworks and React versions are supported?",
            "Every block works with React 19 and Next.js 16, plus modern React frameworks like Remix and Vite. Server Components are supported, and full TypeScript types ship with every component."),
        new("team",
            "Is there a team or organization plan?",
            "Yes — Team plans include 5 seats and Organization plans include unlimited seats with shared workspaces, centralized billing, and usage analytics. Volume pricing and priority support are included on both."),
    ];

    private RenderFragment RenderHighlighted(string text) => builder =>
    {
        var parts = System.Text.RegularExpressions.Regex.Split(text, @"(\s+)");
        int seq = 0;
        foreach (var part in parts)
        {
            var stripped = System.Text.RegularExpressions.Regex.Replace(part, @"[.,!?;:()]", "");
            if (_highlightTerms.Contains(stripped))
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "rounded bg-amber-500/10 px-1 text-foreground");
                builder.AddContent(seq++, part);
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, "span");
                builder.AddContent(seq++, part);
                builder.CloseElement();
            }
        }
    };
}
