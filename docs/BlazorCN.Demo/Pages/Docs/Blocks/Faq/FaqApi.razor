@* ============================================================
   Block: faq-api
   Title: FaqApi
   Description: A marketing-scale technical FAQ block for React and Next.js with inline code snippet panels, single-expand disclosure, smooth animations, accessible markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-api.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Developer FAQ
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for developers who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The questions our developer community asks before they integrate. Auth, rate limits,
                webhooks, and error handling in one place.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in _faqItems)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-api-panel-{item.Id}";
                var triggerId = $"faq-api-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        aria-controls="@panelId"
                        @onclick="@(() => Toggle(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="space-y-4 px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                @if (!string.IsNullOrEmpty(item.Code))
                                {
                                    <div class="overflow-hidden rounded-xl border bg-muted/60">
                                        <pre class="overflow-x-auto px-4 py-3 font-mono text-xs leading-relaxed text-foreground sm:text-sm">@item.Code</pre>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read the API docs</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Contact developer support
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer, string? Code = null);

    private string? _expanded = "rate-limits";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static readonly FaqItem[] _faqItems =
    [
        new("rate-limits",
            "What are the API rate limits?",
            "Rate limits are tiered by plan: Free 100 req/hr, Starter 1,000 req/hr, Pro 10,000 req/hr, Enterprise custom. Every response includes X-RateLimit headers, and exceeding the limit returns a 429 with a Retry-After header.",
            "X-RateLimit-Limit: 1000\nX-RateLimit-Remaining: 847\nX-RateLimit-Reset: 1679875200"),
        new("authentication",
            "How do I authenticate API requests?",
            "We support API keys for server-to-server, OAuth 2.0 for user-delegated access, and JWTs for mobile apps. Send your key in the Authorization header as a Bearer token. Rotate keys every 90 days and never commit them to version control.",
            "curl -H \"Authorization: Bearer sk_live_abc123xyz\" \\\n  https://api.example.com/v1/users"),
        new("sdks",
            "Which SDKs and languages are supported?",
            "Official SDKs ship for Node.js, Python, Ruby, PHP, Go, and Java with TypeScript types, retry logic, and full error handling. Community SDKs cover .NET, Rust, and Swift. All SDKs follow semver and update within 48 hours of API changes."),
        new("webhooks",
            "How do webhooks work?",
            "Webhooks deliver events to your endpoint via HTTP POST. Configure them in your dashboard, pick which events to receive, and verify the X-Webhook-Signature HMAC-SHA256 header. Failed deliveries retry up to 3 times with exponential backoff."),
        new("errors",
            "What error codes should I expect?",
            "All errors return standard HTTP status codes with a consistent JSON body containing code, message, and an optional details array. Use the code for programmatic handling and the message for user-facing display.",
            "{\n  \"error\": {\n    \"code\": \"AUTH_INVALID_TOKEN\",\n    \"message\": \"The API key provided is invalid or expired\",\n    \"details\": []\n  }\n}"),
        new("pagination",
            "How does pagination work?",
            "List endpoints use cursor-based pagination. Each response includes a next_cursor (null on the last page) you pass back as the cursor parameter. Default page size is 20 items, maximum 100. Cursor pagination stays consistent under concurrent modifications."),
        new("versioning",
            "How is API versioning handled?",
            "We use date-based versioning. Pin a version with the X-API-Version header or use the latest stable. Deprecated versions get 12 months of support before sunset, and migration guides ship 90 days before deprecation."),
        new("testing",
            "Is there a sandbox for testing?",
            "Yes. Use test mode keys (sk_test_) to interact with our sandbox without charging cards or affecting production data. Use magic values like card 4242424242424242 to simulate scenarios. Test data is purged every 90 days."),
    ];
}
