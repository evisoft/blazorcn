@* ============================================================
   Block: faq-enterprise
   Title: FaqEnterprise
   Description: A marketing-scale tagged accordion FAQ block for React and Next.js with per-item tag chips, single-item expand, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-enterprise.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Enterprise solutions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for the procurement review.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                SLAs, compliance certifications, custom contracts, and deployment options — the answers
                your security and legal teams ask first.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-ent-panel-{item.Id}";
                var triggerId = $"faq-ent-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            @if (item.Tags != null && item.Tags.Length > 0)
                            {
                                <div class="mt-3 flex flex-wrap gap-1.5">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <span class="inline-flex items-center rounded-full border bg-muted px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground">
                                            @tag
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Schedule a demo</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">Contact enterprise sales</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "sla";

    private record FaqItem(string Id, string Question, string Answer, string[]? Tags = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("sla",
            "What service level agreements do you offer?",
            "Enterprise plans include a 99.95% uptime SLA with financial credits for downtime, Priority 1 incident response within 1 hour, and Priority 2 within 4 hours. We provide 24/7/365 dedicated support via phone, email, and Slack Connect with monthly uptime reports and 14-day notice on maintenance windows.",
            ["99.95% uptime", "24/7 support", "Financial credits"]),
        new("contracts",
            "Do you offer custom contracts and pricing?",
            "Yes. We work with enterprise customers on multi-year agreements with volume discounts, custom payment terms, and flexible billing cycles. Our enterprise team handles BAAs, DPAs, custom MSAs, and vendor questionnaires alongside your legal and procurement departments."),
        new("support",
            "What does dedicated enterprise support include?",
            "A named Customer Success Manager as your single point of contact, quarterly business reviews, direct access to our Solutions Architecture team, white-glove onboarding with custom training sessions, and a private Slack Connect channel for direct engineering escalation."),
        new("compliance",
            "Which compliance certifications do you maintain?",
            "SOC 2 Type II, ISO 27001, GDPR, HIPAA with signed BAAs, CCPA, and PCI DSS Level 1. Our infrastructure is FedRAMP In Process for government customers. Annual third-party penetration testing and continuous monitoring keep us audit-ready year round.",
            ["SOC 2", "ISO 27001", "HIPAA", "GDPR"]),
        new("deployment",
            "What deployment options are available?",
            "Choose multi-tenant cloud (fastest setup), single-tenant cloud in our VPC, private cloud on dedicated hardware in any AWS, GCP, or Azure region, or fully on-premise for air-gapped environments. Every option receives the same feature updates and security patches."),
        new("security",
            "How do you handle enterprise security requirements?",
            "SSO via SAML 2.0 and OpenID Connect (Okta, Azure AD, Google Workspace), SCIM 2.0 user provisioning, role-based access control, tamper-proof audit logs, AES-256 encryption at rest, TLS 1.3 in transit, and optional customer-managed encryption keys."),
        new("data-residency",
            "Can you meet data residency and sovereignty requirements?",
            "Yes. We operate data centers in North America, the EU, the United Kingdom, and Asia-Pacific, and can provision infrastructure in specific countries for regulatory compliance. Data including backups never leaves your chosen region."),
        new("integration",
            "Do you support enterprise integrations and APIs?",
            "Comprehensive REST and GraphQL APIs with no rate limits for enterprise customers, plus pre-built integrations with Salesforce, Workday, SAP, Oracle, and ServiceNow. Our Professional Services team can build custom integrations for legacy or proprietary systems."),
    ];
}
