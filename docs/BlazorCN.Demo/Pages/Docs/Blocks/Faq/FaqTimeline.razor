@* ============================================================
   Block: faq-timeline
   Title: FaqTimeline
   Description: A vertical timeline FAQ block for React and Next.js with version-history rail, dot indicators, and per-version expandable answers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Release history
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every version, explained.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A chronological tour of the questions we hear most often after each release. Tap any
                version to read the full answer.
            </p>
        </div>

        @* Timeline *@
        <div class="relative mt-12 overflow-hidden rounded-2xl border bg-card px-6 py-8 sm:px-8 sm:py-10">
            @* Rail *@
            <div aria-hidden="true" class="absolute bottom-10 left-[34px] top-10 w-px bg-border sm:left-[42px]"></div>

            <ul class="space-y-8">
                @foreach (var it in _timelineItems)
                {
                    var item = it;
                    var isOpen = _expandedId == item.Id;
                    var panelId = $"timeline-panel-{item.Id}";
                    var triggerId = $"timeline-trigger-{item.Id}";
                    <li class="relative pl-10 sm:pl-14">
                        @* Dot *@
                        <div aria-hidden="true" class="@Cn.Merge("absolute left-0 top-1.5 flex size-[18px] items-center justify-center rounded-full border-2 transition-colors sm:left-2", isOpen ? "border-foreground bg-foreground" : "border-border bg-card")">
                            @if (isOpen)
                            {
                                <div class="size-1.5 rounded-full bg-background"></div>
                            }
                        </div>

                        <p class="mb-1 font-mono text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                            @item.Version
                        </p>
                        <button
                            type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen.ToString().ToLower()"
                            aria-controls="@panelId"
                            @onclick="@(() => _expandedId = isOpen ? null : item.Id)"
                            class="flex w-full items-start justify-between gap-4 text-left">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                        </button>

                        @if (isOpen)
                        {
                            <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Read changelog</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Migration guides</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expandedId = "v4";

    private record TimelineItem(string Id, string Version, string Question, string Answer);

    private static readonly TimelineItem[] _timelineItems =
    [
        new("v4",
            "v4.0 · Apr 2026",
            "What changed in the v4 React 19 rewrite?",
            "We rewrote the runtime on top of React 19 Server Components and dropped the legacy class-based context. Bundle size shrank by 38% and first paint is roughly twice as fast on cold loads. The migration codemod handles 95% of upgrades automatically."),
        new("v3",
            "v3.0 · Oct 2025",
            "How did the v3 plugin API replace the old hooks system?",
            "The v3 plugin API introduced a single registerPlugin() entry point that replaces the eight-hook lifecycle from v2. Existing plugins continue to work via a compat shim, but new plugins should target the new API for better tree-shaking and TypeScript inference."),
        new("v2",
            "v2.0 · Mar 2025",
            "Why did v2 drop CommonJS support?",
            "v2 went ESM-only because every supported runtime (Node 20+, Bun, Deno, modern bundlers) handles ESM natively, and dual-publishing was the source of 40% of our reported bugs. If you still need CJS, pin to v1.x — it remains in security-only maintenance."),
        new("v1",
            "v1.0 · Sep 2024",
            "What was shipped in the original v1 release?",
            "The first stable release shipped the core component library, the CLI, and the TypeScript types. It set the API contract we've maintained backwards compatibility against ever since, and laid the groundwork for the plugin system that arrived in v3."),
        new("v0",
            "v0.1 · May 2024",
            "How did the early beta shape the public API?",
            "The v0.1 beta ran for four months with around 800 design partners. Their feedback drove the decision to ship as a single package instead of a monorepo, to make 'use client' opt-in rather than required, and to default to Tailwind class names instead of CSS-in-JS."),
    ];
}
