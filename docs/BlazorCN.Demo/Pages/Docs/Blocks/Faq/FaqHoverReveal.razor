@* ============================================================
   Block: faq-hover-reveal
   Title: FaqHoverReveal
   Description: A marketing-scale hover-reveal FAQ block for React and Next.js with desktop hover-to-reveal answers, mobile tap-to-reveal fallback, keyboard focus support, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-hover-reveal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Hover to reveal. Tap on mobile.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Move your cursor over a question and the answer slides open. On touch devices, tap once
                to reveal and tap again to collapse.
            </p>
        </div>

        @* FAQ list *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isActive = _activeId == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0"
                     @onmouseenter="@(() => _activeId = item.Id)"
                     @onmouseleave="@(() => { if (_activeId == item.Id) _activeId = null; })">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isActive.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _activeId = isActive ? null : item.Id)"
                        @onfocus="@(() => _activeId = item.Id)"
                        class="flex w-full items-start gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <LucideIconCn Name="help-circle" Size="20" Class="mt-1 size-5 shrink-0 text-muted-foreground" aria-hidden="true" />
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                    </button>

                    @if (isActive)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-[3.75rem] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[4.25rem]">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _activeId = null;

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("tiers",
            "What's the difference between pricing tiers?",
            "Starter ships the core features for solo builders. Pro adds team collaboration, priority support, and advanced analytics. Enterprise includes everything plus SSO, custom contracts, and a dedicated success manager."),
        new("refund",
            "What is your refund policy?",
            "30-day money-back guarantee on every plan with no questions asked. Refunds land back on your original payment method within 5–7 business days of approval."),
        new("export",
            "Can I export my data anytime?",
            "Yes — export everything in JSON or CSV from account settings. Exports include records, attachments, and metadata, and large exports arrive as a downloadable email link within a few minutes."),
        new("team",
            "Are there limits on team size?",
            "Starter is single-user, Pro supports up to 5 seats, and Enterprise removes the cap entirely. Additional Pro seats cost $15 each per month, and Enterprise includes volume discounts."),
        new("maintenance",
            "How do you handle scheduled maintenance?",
            "Maintenance is announced seven days in advance and runs during low-traffic windows (Sunday 2–4am UTC). Most updates ship without downtime via blue-green deployments."),
        new("api",
            "How stable is your API?",
            "99.9% uptime with comprehensive versioning. We support old versions for 12 months after deprecation and breaking changes never affect existing versions. Real-time status lives at status.example.com."),
    ];
}
