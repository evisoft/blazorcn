@* ============================================================
   Block: faq-fitness
   Title: FaqFitness
   Description: A tagged accordion FAQ block for React and Next.js with inline category pills, single-expand disclosure, smooth height transitions, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-fitness.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything before you join.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Memberships, classes, training, and facilities — the answers that help you decide
                whether we're the right room for your routine.
            </p>
        </div>

        @* Tagged accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"fitness-faq-panel-{item.Id}";
                var triggerId = $"fitness-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="inline-flex items-center rounded-full border bg-muted px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @item.Category
                            </span>
                            <p class="mt-2 text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Book a tour</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "membership-options";

    private record FaqItem(string Id, string Category, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("membership-options",
            "Membership",
            "What membership options do you offer?",
            "We offer flexible plans: month-to-month at $79, six-month at $429 (save 10%), and annual at $799 (save 20%). Every plan includes unlimited gym access, group classes, locker rooms, and the mobile app. Personal training packages are available as add-ons."),
        new("cancellation",
            "Membership",
            "Is there a cancellation fee?",
            "Month-to-month memberships can be cancelled anytime with 30 days notice and no fee. Prepaid 6-month and annual plans are non-refundable but can be frozen for up to 3 months per year for documented medical or extended-travel reasons."),
        new("classes-included",
            "Classes",
            "What group fitness classes are included?",
            "Every membership includes unlimited access to 40+ weekly classes: HIIT, yoga, spinning, strength training, Pilates, Zumba, boxing, and meditation. Classes range from beginner to advanced. Reserve your spot up to seven days in advance through the app."),
        new("booking",
            "Classes",
            "Do I need to book classes in advance?",
            "Popular classes (morning HIIT, evening yoga) fill up quickly and require advance booking through our app or website. General gym access does not require booking. We recommend reserving 2-3 days ahead for peak times."),
        new("personal-training",
            "Training",
            "How much do personal trainers cost?",
            "Personal training is $75/hour for standard trainers and $95/hour for specialists in sports performance or rehabilitation backgrounds. Discounted packs: 10 sessions for $650 or 20 sessions for $1,200. The initial fitness assessment is included with any package."),
        new("guest-passes",
            "Access",
            "Can I bring a guest?",
            "Members get two complimentary guest passes per month. Additional passes are $15 each, available at the front desk or through the app. Guests must be 16+ and sign a waiver, and they must be accompanied by the member during their entire visit."),
        new("facilities",
            "Facilities",
            "What equipment and amenities are available?",
            "Our 15,000 sq ft facility includes a full range of cardio equipment, free weights to 150lbs, cable machines, squat racks, Olympic platforms, a functional training area, sauna, steam room, and locker rooms with showers. Towel service, WiFi, and filtered water included."),
    ];
}
