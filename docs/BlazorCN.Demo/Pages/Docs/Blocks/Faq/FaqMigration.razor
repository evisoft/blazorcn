@* ============================================================
   Block: faq-migration
   Title: FaqMigration
   Description: A marketing-scale FAQ migration guide block for React and Next.js with step-by-step expandable sections, semantic disclosure markup, varied stagger entrance, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-migration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Migration guide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Switch without the panic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Step-by-step answers to the questions every team asks before migrating. 99.97% success
                rate across 10,000+ migrations and counting.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @for (var i = 0; i < _faqItems.Length; i++)
            {
                var item = _faqItems[i];
                var index = i;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                var stepLabel = (index + 1).ToString().PadLeft(2, '0');
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex items-start gap-4">
                            <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-xs font-semibold text-muted-foreground">
                                @stepLabel
                            </span>
                            <div>
                                <span class="text-base font-semibold text-foreground sm:text-lg">
                                    @item.Question
                                </span>
                                @if (item.Timeline != null)
                                {
                                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                        @item.Timeline
                                    </p>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-[68px] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[76px]">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Start migration assessment</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Talk to a specialist</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "data-import";

    private record FaqItem(string Id, string Question, string Answer, string? Timeline = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("data-import",
            "How do I import my existing data?",
            "We provide multiple import methods: CSV/Excel upload for bulk data up to 500MB, direct API migration for automated transfers with progress tracking, and database connectors for MySQL, PostgreSQL, and MongoDB with schema mapping. Our migration wizard validates data before import, identifies potential issues, and provides detailed error reports. Most customers complete self-service migrations in 2 to 4 hours depending on data volume.",
            "2–4 hours"),
        new("switching",
            "What's involved in switching from competitors?",
            "We've built dedicated migration tools for switching from Salesforce, HubSpot, Intercom, Zendesk, and 20+ other platforms. Each tool includes field mapping to match your existing data structure, automatic conversion of custom fields and workflows, and preservation of historical data with timestamps. Most migrations maintain 100% data fidelity with zero manual cleanup."),
        new("downtime",
            "How much downtime should I expect during migration?",
            "Zero downtime for most migrations. We support parallel running where your old system stays operational while we import data to our platform. The actual cutover typically takes 5 to 15 minutes to update DNS, configure SSO, and activate accounts. We schedule cutovers during your low-traffic windows and provide rollback procedures if issues arise.",
            "~10 min cutover"),
        new("rollback",
            "Can I roll back if something goes wrong?",
            "Yes — we maintain rollback capabilities for 30 days post-migration. Your data remains in read-only mode in the old system during this period. If critical issues occur, we can revert DNS settings within minutes to restore access to your previous platform while we troubleshoot. Our migration team monitors the first 72 hours closely."),
        new("compatibility",
            "How do you handle compatibility with my existing integrations?",
            "Our compatibility checker scans your current integrations and identifies which are natively supported, require configuration, or need custom development. We support 200+ integrations out of the box including Slack, Microsoft Teams, Google Workspace, Zapier, webhooks, and REST APIs. Most customers migrate integrations in the same window as data migration."),
        new("data-loss",
            "What safeguards prevent data loss during migration?",
            "Multiple safeguards protect your data: pre-migration validation checks data integrity before import, atomic transactions ensure all-or-nothing imports, automated backups before every migration step, real-time error logging with immediate notifications, and post-migration validation comparing record counts and checksums. In 10,000+ migrations we've achieved a 99.97% success rate with zero permanent data loss."),
        new("training",
            "Do you provide training for my team during migration?",
            "Yes — migration includes live onboarding sessions for admins, recorded video tutorials for end users, an interactive sandbox for hands-on practice, and side-by-side documentation comparing your old platform's features to ours. Enterprise customers receive dedicated training sessions customized to their workflows."),
        new("timeline",
            "What's the typical migration timeline from start to finish?",
            "Standard migration timeline: Week 1 — discovery call, data export, compatibility assessment. Week 2 — test migration to staging, field mapping review. Week 3 — user acceptance testing, training, final data sync. Week 4 — production cutover, monitoring, optimization. Faster migrations are possible for simple use cases with under 10,000 records.",
            "2–4 weeks typical"),
    ];
}
