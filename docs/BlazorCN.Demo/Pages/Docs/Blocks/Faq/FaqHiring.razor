@* ============================================================
   Block: faq-hiring
   Title: FaqHiring
   Description: A marketing-scale tagged FAQ accordion block for React and Next.js with single-item expand, inline tag chips per question, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-hiring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Working here
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                What candidates ask before applying.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Process, benefits, remote work, visas, and culture — with the quick facts up front so
                you can scan before you read.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"hiring-faq-panel-{item.Id}";
                var triggerId = $"hiring-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="min-w-0">
                            <span class="block text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            @if (item.Tags != null && item.Tags.Length > 0)
                            {
                                <span class="mt-2 flex flex-wrap gap-1.5">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <span class="inline-flex items-center rounded-full border bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                                            @tag
                                        </span>
                                    }
                                </span>
                            }
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">View open positions</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Life at the company</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "application";

    private record FaqItem(string Id, string Question, string Answer, string[]? Tags = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("application",
            "What's the application and hiring process?",
            "Submit your application through our careers page and we review every one within five business days. From there: a 30-minute recruiter screen, a skills assessment relevant to the role, two or three team interviews with potential teammates and your hiring manager, and a final conversation with leadership before reference checks and an offer. You'll get feedback at every stage and can ask questions anytime.",
            ["2–3 weeks", "5 stages"]),
        new("remote",
            "Do you offer remote work or flexible schedules?",
            "We're a remote-first company with employees in 25 countries. Choose fully remote, hybrid near one of our hubs, or full-time from our offices. Core collaboration hours are 10am–3pm in your local time zone, and you can work the rest of your hours whenever you're most productive. We provide a $2,000 home office setup, $100/month remote stipend, and an annual company retreat.",
            ["Remote-first", "25 countries", "Flexible hours"]),
        new("benefits",
            "What benefits and perks do you offer?",
            "Health, dental, and vision premiums covered 100% for employees and 75% for dependents. Unlimited PTO with a 15-day minimum, plus company-wide shutdown weeks. 16 weeks paid parental leave for all parents, $1,500 annual professional development budget with no approval required, and equity compensation for every employee — not just executives.",
            ["Unlimited PTO", "100% health coverage", "Equity for all"]),
        new("interview",
            "How should I prepare for the interview stages?",
            "For the recruiter screen, research our product and prepare two or three questions about the role. For the skills assessment, expect a coding challenge for engineering, a portfolio walkthrough for design, or a product case for PM roles. For team interviews, prepare STAR-method examples for each required skill. We share an interview guide and study materials after the phone screen.",
            ["STAR method", "Take-home"]),
        new("visa",
            "Do you sponsor work visas?",
            "Yes — we sponsor H-1B in the US, Tier 2 in the UK, and equivalent permits in Canada, Germany, Singapore, and Australia. We cover all legal fees and processing costs, and you can transfer an existing H-1B when you join. The visa process typically takes two to four months and you can usually start remotely while paperwork processes.",
            ["US, UK, CA, DE, SG, AU", "100% fees covered"]),
        new("culture",
            "What's the company culture really like?",
            "Async-first communication with most work happening in writing rather than meetings. Full transparency: every employee has access to revenue, growth metrics, and strategic decisions. Bias toward shipping and iterating over chasing perfection, psychological safety as a non-negotiable, and a 120-person team across 25 countries that takes the work seriously without taking themselves too seriously.",
            ["Async-first", "Transparent"]),
        new("growth",
            "What career growth opportunities exist?",
            "Clear career frameworks from junior to staff across every function, quarterly check-ins with your manager, and a $1,500 annual education budget that requires no approval — just expense it. 70% of management positions are filled internally, and our mentorship program pairs junior employees directly with senior leaders.",
            ["1,500 USD/yr learning", "70% internal promotion"]),
    ];
}
