@* ============================================================
   Block: faq-pricing-plans
   Title: FaqPricingPlans
   Description: A pricing-focused FAQ accordion block for React and Next.js with hero-scale headline cluster, highlighted answer badges, smooth single-expand disclosure, semantic aria markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-pricing-plans.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Pricing questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The honest answers about price.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Plans, billing, discounts, trials, and refunds — all the things teams ask before they
                commit. No fine print, no surprises.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-pricing-panel-{item.Id}";
                var triggerId = $"faq-pricing-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="block text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            @if (item.Highlight != null)
                            {
                                <span class="mt-2 inline-flex items-center rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-0.5 text-xs font-medium text-emerald-700 dark:text-emerald-400">
                                    @item.Highlight
                                </span>
                            }
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Compare all plans</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "included";

    private record FaqItem(string Id, string Question, string Answer, string? Highlight = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("included",
            "What's included in each plan?",
            "Free covers 3 projects and 100 API requests/day with community support. Starter ($19/mo) unlocks 10 projects, 1,000 API requests/day, email support, and custom domains. Pro ($49/mo) gives unlimited projects, 10,000 API requests/day, priority support, and 5 team seats. Enterprise (custom) adds SLA, SSO, and on-prem deployment.",
            "14-day free trial"),
        new("free-vs-pro",
            "What's the difference between Free and Pro plans?",
            "Free is perfect for individual developers and side projects (3 projects, 100 API calls/day). Pro unlocks unlimited projects, 100x higher API limits, 5-seat team collaboration, 4-hour priority support, custom domains with SSL, advanced analytics, and premium integrations like Slack and Zapier. Most users upgrade when they hit project limits."),
        new("team-discounts",
            "Do you offer team or volume discounts?",
            "Pro includes 5 seats at no extra cost ($9.80/seat). Teams of 6–20 get 20% off additional seats, 21–50 get 30% off, and 51+ get 40% off. Enterprise plans for 100+ users have custom pricing with up to 50% volume discounts. Nonprofits and educational institutions get 50% off all plans with verification.",
            "Up to 50% team savings"),
        new("annual-savings",
            "How much do I save with annual billing?",
            "Annual billing saves 20% over monthly. Starter is $228/year ($60 saved). Pro is $470/year ($118 saved). Annual subscribers also get early access to new features, dedicated onboarding, and a priority support queue. Quarterly billing (10% discount) is available if a full year up front feels like too much.",
            "Save 20% annually"),
        new("trial",
            "Do you offer a free trial?",
            "Every paid plan includes a 14-day free trial with full Pro or Enterprise access — no credit card required. After the trial, your account automatically downgrades to Free unless you add payment, so there are no surprise charges. Annual commitments extend the trial to 30 days, and Enterprise pilots run 60 days with a dedicated success manager.",
            "No credit card needed"),
        new("switching-plans",
            "Can I upgrade, downgrade, or cancel anytime?",
            "Yes. Upgrades apply instantly with prorated billing. Downgrades take effect at the next billing cycle so you keep current value. Monthly cancellations stop billing immediately. Annual plans are eligible for prorated refunds within the first 90 days. Your data stays exportable for 90 days after cancellation."),
        new("refund-policy",
            "What's your refund policy?",
            "30-day money-back guarantee on all plans, no questions asked. Annual plans qualify for prorated refunds within the first 90 days. Service issues like extended downtime may qualify for prorated credits beyond the standard window. Refunds process within 5–7 business days through your original payment method."),
        new("student-pricing",
            "Do you offer student or nonprofit discounts?",
            "Yes — 50% off all paid plans for verified students, teachers, schools, and registered nonprofits. Students just need a .edu email. Nonprofits submit 501(c)(3) documentation. Open source maintainers with 1,000+ GitHub stars get a free Pro plan. Discounts stack with annual billing for the deepest savings.",
            "50% off students/nonprofits"),
    ];
}
