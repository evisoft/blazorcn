@* ============================================================
   Block: faq-expandable-sections
   Title: FaqExpandableSections
   Description: A nested expandable sections FAQ block for React and Next.js with two-level disclosure groups, category counts, smooth height transitions, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-expandable-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse questions by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Everything from getting started to billing, security, and integrations — grouped into
                sections you can scan in seconds.
            </p>
        </div>

        @* Sections *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var sec in _faqSections)
            {
                var isSectionOpen = _expandedSection == sec.Id;
                var sectionPanelId = $"expandable-sections-faq-section-panel-{sec.Id}";
                var sectionTriggerId = $"expandable-sections-faq-section-trigger-{sec.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@sectionTriggerId"
                        aria-expanded="@isSectionOpen.ToString().ToLower()"
                        aria-controls="@sectionPanelId"
                        @onclick="@(() => _expandedSection = isSectionOpen ? null : sec.Id)"
                        class="flex w-full items-center justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex items-center gap-3">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @sec.Title
                            </span>
                            <span class="rounded-full border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
                                @sec.Items.Length
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" aria-hidden="true"
                            Class="@Cn.Merge("size-5 shrink-0 text-muted-foreground transition-transform duration-300", isSectionOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isSectionOpen)
                    {
                        <div id="@sectionPanelId" role="region" aria-labelledby="@sectionTriggerId" class="overflow-hidden bg-muted/20">
                            <div class="border-t">
                                @foreach (var itm in sec.Items)
                                {
                                    var item = itm;
                                    var isItemOpen = _expandedItem == item.Id;
                                    var itemPanelId = $"expandable-sections-faq-item-panel-{item.Id}";
                                    var itemTriggerId = $"expandable-sections-faq-item-trigger-{item.Id}";
                                    <div class="border-b last:border-0">
                                        <button
                                            type="button"
                                            id="@itemTriggerId"
                                            aria-expanded="@isItemOpen.ToString().ToLower()"
                                            aria-controls="@itemPanelId"
                                            @onclick="@(() => _expandedItem = isItemOpen ? null : item.Id)"
                                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/50 sm:px-8 sm:py-6">
                                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                                @item.Question
                                            </span>
                                            <LucideIconCn Name="chevron-down" Size="20" aria-hidden="true"
                                                Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isItemOpen ? "rotate-180" : "")" />
                                        </button>

                                        @if (isItemOpen)
                                        {
                                            <div id="@itemPanelId" role="region" aria-labelledby="@itemTriggerId" class="overflow-hidden">
                                                <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                                    @item.Answer
                                                </p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expandedSection = "getting-started";
    private string? _expandedItem = "account-creation";

    private record FaqItem(string Id, string Question, string Answer);
    private record FaqSection(string Id, string Title, FaqItem[] Items);

    private static readonly FaqSection[] _faqSections =
    [
        new("getting-started", "Getting started",
        [
            new("account-creation",
                "How do I create an account?",
                "Click Sign up in the top right, enter your email, and choose a password. You'll receive a verification email within minutes — click the link to activate your account. Enterprise users with SSO can sign in with their workspace credentials instead."),
            new("first-project",
                "How do I set up my first project?",
                "After logging in, click New project from the dashboard. Pick a template or start from scratch, name your project, set the timezone, and invite teammates. The onboarding wizard walks through integrations and notification preferences in under five minutes."),
            new("import-data",
                "Can I import data from other tools?",
                "Yes. We support imports from CSV, Excel, Asana, Trello, Jira, and Monday. Open Settings, Import, pick a source, and follow the field-mapping wizard. Large imports run in the background and email you when complete — attachments and history are preserved."),
        ]),
        new("billing-payments", "Billing and payments",
        [
            new("payment-methods",
                "What payment methods do you accept?",
                "All major credit cards (Visa, Mastercard, Amex, Discover), debit cards, and ACH transfers for annual plans. Enterprise customers can pay by wire or invoice with NET 30 terms. Every payment runs through Stripe with PCI DSS compliance."),
            new("refund-policy",
                "What is your refund policy?",
                "We offer a 14-day money-back guarantee on new subscriptions — contact support and we have the refund on its way within one business day. Annual plans receive a prorated refund for unused months when cancelled within the first 90 days."),
            new("change-plan",
                "How do I upgrade or downgrade my plan?",
                "Open Settings, Billing, and pick Change plan. Upgrades apply immediately with prorated billing. Downgrades take effect at the end of your current period so you keep premium features until the cycle closes. We email reminders 7 days and 1 day before changes apply."),
            new("invoices",
                "Where can I find my invoices?",
                "Every invoice lives in Settings, Billing, Invoice history. Download PDFs, update billing details, and add purchase order numbers. Invoices are also emailed to your billing contact after each successful payment."),
        ]),
        new("security-privacy", "Security and privacy",
        [
            new("data-encryption",
                "How is my data encrypted?",
                "All data is encrypted at rest with AES-256 and in transit with TLS 1.3. Encryption keys are managed through AWS KMS with automatic 90-day rotation. Database backups are encrypted and stored across geographically distributed regions."),
            new("gdpr-compliance",
                "Are you GDPR compliant?",
                "Yes. You can access, export, or delete your data any time from Settings, Privacy. We have a Data Protection Officer on staff and maintain comprehensive data processing agreements. EU customer data stays in EU data centers by default."),
            new("data-retention",
                "How long do you retain my data?",
                "Active account data is retained while your subscription is active. Deleted items are soft-deleted and recoverable for 30 days before permanent deletion. After cancellation, data is retained for 90 days then permanently deleted on request."),
        ]),
        new("integrations", "Integrations",
        [
            new("slack-integration",
                "How does the Slack integration work?",
                "Connect Slack from Settings, Integrations. Pick which channels receive notifications for project updates, mentions, and due dates. You can also create and update items directly from Slack with slash commands. Two-way sync keeps conversations linked."),
            new("api-access",
                "Do you provide API access?",
                "Yes. Our REST API ships on Professional and Enterprise plans. Generate API keys in Settings, Developers. Complete OpenAPI specs and code examples live at docs.example.com/api. Rate limits are documented per plan tier."),
            new("zapier",
                "Can I use Zapier to connect other apps?",
                "Yes. Our Zapier integration supports 1,000+ apps including Gmail, Sheets, Salesforce, and HubSpot. Triggers cover new items, status changes, and due dates. Actions include creating, updating, and deleting items. Available on every paid plan."),
        ]),
    ];
}
