@* ============================================================
   Block: faq-with-progress
   Title: FaqWithProgress
   Description: A marketing-scale FAQ block for React and Next.js with a reading progress bar, completion badge, single-item expand, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Read at your own pace.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Track your way through the answers below. The progress bar fills as you open each
                question, and a badge confirms when you've read the whole section.
            </p>
        </div>

        @* Progress bar *@
        <div class="mt-8 flex items-center gap-4">
            <ProgressCn Value="@_progress" Class="h-2 flex-1" aria-label="Progress" />
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 tabular-nums">
                @if (_isComplete)
                {
                    <span class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600" aria-hidden="true" />
                        All read
                    </span>
                }
                else
                {
                    @($"Read {_readItems.Count} of {_faqItems.Length}")
                }
            </BadgeCn>
        </div>

        @* Accordion *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems.Select((item, idx) => (item, idx)))
            {
                var item = it.item;
                var index = it.idx;
                var isOpen = _expanded == item.Id;
                var isRead = _readItems.Contains(item.Id);
                var panelId = $"faq-progress-panel-{item.Id}";
                var triggerId = $"faq-progress-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => HandleExpand(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex min-w-0 items-start gap-4">
                            @if (isRead)
                            {
                                <LucideIconCn Name="check-circle-2" Size="20" Class="mt-1 size-5 shrink-0 text-emerald-600" aria-hidden="true" />
                            }
                            else
                            {
                                <span aria-hidden="true" class="mt-1 flex size-5 shrink-0 items-center justify-center rounded-full border text-[11px] font-medium tabular-nums text-muted-foreground">
                                    @(index + 1)
                                </span>
                            }
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 pl-[60px] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[68px]">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Talk to sales</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = null;
    private readonly HashSet<string> _readItems = [];

    private double _progress => _faqItems.Length == 0 ? 0 : (double)_readItems.Count / _faqItems.Length * 100;
    private bool _isComplete => _readItems.Count == _faqItems.Length;

    private void HandleExpand(string id)
    {
        var next = _expanded == id ? null : id;
        _expanded = next;
        if (next != null && !_readItems.Contains(id))
        {
            _readItems.Add(id);
        }
    }

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("getting-started",
            "How do I get started in under 15 minutes?",
            "Sign up at app.example.com/signup, connect your first data source from the Integrations page, and let the onboarding wizard build your first dashboard. Most teams are running in under 15 minutes with no engineer required."),
        new("integrations",
            "What integrations ship out of the box?",
            "We support 50+ integrations including Stripe, Salesforce, HubSpot, Google Analytics, Shopify, and every major CRM. Each one connects via OAuth in 2-5 minutes and syncs hourly or on-demand through webhooks."),
        new("team",
            "How do I invite my team and assign roles?",
            "From Settings > Team, paste a comma-separated list of emails and assign Admin, Member, or Viewer roles. Invitees get an email with onboarding instructions. Team size limits depend on your subscription tier."),
        new("pricing",
            "How much does a typical team plan cost?",
            "Pricing starts at $29/month for individuals, $79/month for teams of up to 10, and custom pricing for Enterprise. Annual billing saves 20% and every plan includes unlimited data sources, 24/7 support, and a 99.9% uptime SLA."),
        new("plan-changes",
            "Can I upgrade or downgrade my plan anytime?",
            "Yes. Change plans from your billing dashboard at any time. Upgrades apply immediately with prorated billing, and downgrades take effect at your next renewal so you don't lose value mid-cycle."),
        new("refunds",
            "Do you offer a money-back guarantee?",
            "Every new subscription includes a 30-day money-back guarantee with no questions asked. Contact support and we'll process the refund within 5-7 business days. Annual plans also receive prorated refunds within the first 90 days."),
        new("security",
            "Is my data encrypted and SOC 2 compliant?",
            "All data is encrypted in transit with TLS 1.3 and at rest with AES-256. We're SOC 2 Type II certified and run third-party penetration tests quarterly. Backups run every 4 hours across three geographically redundant regions."),
        new("api-limits",
            "What are the API rate limits per plan?",
            "Starter plans get 1,000 calls per hour, Pro plans 10,000, and Enterprise plans negotiate custom limits. Every response includes rate limit headers, and 429 responses include retry-after timing for graceful backoff."),
    ];
}
