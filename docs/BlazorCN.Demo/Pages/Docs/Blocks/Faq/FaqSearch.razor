@* ============================================================
   Block: faq-search
   Title: FaqSearch
   Description: A searchable FAQ block for React and Next.js with marketing-scale search input, real-time question and answer filtering, result count, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Search every answer.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Type a keyword to filter through the questions we hear most often. Can't find it? Our
                support team replies in under an hour.
            </p>
        </div>

        @* Marketing search input *@
        <div class="relative mt-10">
            <LucideIconCn Name="search" Size="20" Class="absolute left-4 top-1/2 size-5 -translate-y-1/2 text-muted-foreground" />
            <InputCn type="search"
                     aria-label="Search FAQ"
                     Placeholder="Search questions and answers..."
                     @bind-Value="_searchQuery"
                     @bind-Value:event="oninput"
                     Class="h-12 rounded-2xl border bg-card pl-12 text-base shadow-sm" />
        </div>

        <p aria-live="polite" class="mt-3 text-center text-xs text-muted-foreground">
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                @($"{_filteredItems.Length} {(_filteredItems.Length == 1 ? "result" : "results")}")
            }
            else
            {
                @($"{_faqItems.Length} questions")
            }
        </p>

        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @if (_filteredItems.Length > 0)
            {
                @foreach (var it in _filteredItems)
                {
                    var item = it;
                    var isOpen = _expanded == item.Id;
                    var panelId = $"faq-search-panel-{item.Id}";
                    var triggerId = $"faq-search-trigger-{item.Id}";
                    <div class="border-b last:border-0">
                        <button
                            type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen.ToString().ToLower()"
                            aria-controls="@panelId"
                            @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                            class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                        </button>

                        @if (isOpen)
                        {
                            <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                    @item.Answer
                                </p>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="px-6 py-12 text-center">
                    <p class="text-base text-muted-foreground">
                        No answers match "@_searchQuery". Try different keywords.
                    </p>
                </div>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _searchQuery = "";
    private string? _expanded = null;

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("password",
            "How do I reset my password?",
            "Click 'Forgot password' on the login page and enter your email. You'll get a reset link within five minutes — it expires after 24 hours for security. If it doesn't arrive, check your spam folder or contact support and we'll reset it manually."),
        new("rate-limits",
            "What are your API rate limits?",
            "Free accounts get 1,000 requests per hour. Pro accounts get 10,000 with burst capacity up to 15,000. Enterprise plans start at 100,000 requests per hour with custom limits. Rate-limit headers ship with every response so you can monitor in real time."),
        new("export",
            "Can I export my data?",
            "Yes. Export everything as JSON or CSV from account settings. Exports include full history, metadata, and attachments. Large exports run asynchronously and arrive by email within 24 hours. Enterprise plans can schedule automatic exports to S3 or SFTP."),
        new("sso",
            "Do you support single sign-on (SSO)?",
            "Enterprise plans include SAML 2.0 and OAuth 2.0 SSO with Okta, Azure AD, and Google Workspace. We also support SCIM for automated user provisioning. Setup takes one to two hours with our onboarding team."),
        new("uptime",
            "What is your uptime SLA?",
            "We guarantee 99.9% uptime on Pro and 99.99% on Enterprise, backed by financial credits if we miss it. Infrastructure runs across multiple availability zones with automatic failover and live status updates at status.example.com."),
        new("webhooks",
            "How do webhooks work?",
            "Configure webhook endpoints from your dashboard to receive real-time event notifications via HTTPS POST. Supported events include payment.succeeded, user.created, and subscription.cancelled. Every webhook is signed and retried with exponential backoff."),
        new("domains",
            "Can I use custom domains?",
            "Pro and Enterprise plans support custom domains with automatic Let's Encrypt SSL. Add your domain in settings, update DNS, and verification completes within an hour. Apex, subdomain, and wildcard certificates are all supported."),
        new("compliance",
            "What compliance certifications do you have?",
            "We maintain SOC 2 Type II, ISO 27001, GDPR, CCPA, and HIPAA compliance, audited annually by independent third parties. Compliance reports are available to Enterprise customers under NDA, and data residency is supported in US, EU, and UK regions."),
    ];

    private FaqItem[] _filteredItems => string.IsNullOrWhiteSpace(_searchQuery)
        ? _faqItems
        : _faqItems.Where(item =>
            item.Question.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ||
            item.Answer.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase))
          .ToArray();
}
