@* ============================================================
   Block: faq-with-images
   Title: FaqWithImages
   Description: A marketing-scale FAQ accordion with an illustration panel beside every answer for React and Next.js, built with shadcn/ui, motion/react, and Tailwind CSS
   Source: original/blocks/faq/faq-with-images.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                See how it works
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Answers, with a picture.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer pairs the explanation with a visual so you can see exactly what we mean
                without leaving the page.
            </p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"with-images-faq-panel-{item.Id}";
                var triggerId = $"with-images-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="grid gap-6 px-6 pb-6 sm:grid-cols-[1fr_1.1fr] sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <div aria-hidden="true" class="@($"relative aspect-video w-full overflow-hidden rounded-xl border bg-muted bg-gradient-to-br {item.ImageGradient}")">
                                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(255,255,255,0.25),transparent_55%)]"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Watch a demo</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Contact support</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "dashboard";

    private record FaqItem(string Id, string Question, string Answer, string ImageGradient);

    private static readonly FaqItem[] _faqItems =
    [
        new("dashboard",
            "How do I customize my dashboard layout?",
            "Drag any widget by its handle to rearrange. Right-click to resize, hide, or duplicate. Layouts auto-save per user, and admins can publish a default layout for new teammates from Settings → Workspace → Default layout.",
            "from-sky-500/30 via-indigo-500/20 to-violet-500/30"),
        new("import",
            "Can I import data from another tool?",
            "Yes. We support CSV, JSON, and direct imports from Notion, Airtable, Trello, and Linear. The import wizard maps your fields to ours, previews 25 rows, and lets you fix mapping mistakes before committing the full import.",
            "from-emerald-500/30 via-teal-500/20 to-cyan-500/30"),
        new("shortcuts",
            "Are there keyboard shortcuts I should know?",
            "Press Cmd+K (Ctrl+K on Windows) to open the command palette — every action in the app is reachable from there. Press ? at any time for the full shortcut overlay, including navigation, editing, and selection commands.",
            "from-amber-500/30 via-orange-500/20 to-rose-500/30"),
        new("permissions",
            "How do permissions and roles work?",
            "Three built-in roles ship by default: Admin, Editor, and Viewer. Custom roles let you create granular permissions for any combination of resources. Permissions inherit through workspace, project, and document scopes — overrides are explicit.",
            "from-fuchsia-500/30 via-pink-500/20 to-rose-500/30"),
        new("mobile",
            "Is there a mobile app?",
            "Yes. Native iOS and Android apps cover the core features — browsing, editing, comments, notifications, and offline mode for read-only viewing. Heavier admin workflows still live on the desktop web app for now.",
            "from-indigo-500/30 via-blue-500/20 to-sky-500/30"),
        new("backups",
            "How often is my data backed up?",
            "Backups run every 6 hours with 30-day retention across three geographically redundant regions. Enterprise plans include hourly snapshots and on-demand point-in-time restore for the last 7 days from your account dashboard.",
            "from-lime-500/30 via-emerald-500/20 to-teal-500/30"),
    ];
}
