@* ============================================================
   Block: faq-progressive
   Title: FaqProgressive
   Description: A progressive disclosure FAQ block for React and Next.js where each answer starts short and a Read more button reveals the long version with smooth height animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-progressive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Quick answers, deep when you need them.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Skim the one-line summary, then expand the answers you actually want to read in full.
                Nothing buried, nothing wasted.
            </p>
        </div>

        @* List *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-progressive-panel-{item.Id}";
                var triggerId = $"faq-progressive-trigger-{item.Id}";
                <div class="border-b px-6 py-5 last:border-0 sm:px-8 sm:py-6">
                    <h3 class="text-base font-semibold text-foreground sm:text-lg">
                        @item.Question
                    </h3>
                    <p class="mt-2 text-base leading-relaxed text-muted-foreground">@item.Short</p>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                                @item.Long
                            </p>
                        </div>
                    }

                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-foreground transition-colors hover:text-muted-foreground">
                        @(isOpen ? "Show less" : "Read more")
                        <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = null;

    private record FaqItem(string Id, string Question, string Short, string Long);

    private static readonly FaqItem[] _faqItems =
    [
        new("getting-started",
            "How do I get started?",
            "Sign up, copy any component, paste into your project — under five minutes.",
            "Sign up for a free account, browse the component library, and click Copy Code on any component. Paste it into your React or Next.js project, install the listed dependencies, and you're shipping. Our Quick Start guide walks through your first component end-to-end, including theme setup and the dark-mode toggle."),
        new("free-vs-pro",
            "What's the difference between Free and Pro?",
            "Free covers 1,100+ patterns; Pro unlocks 880+ premium blocks plus charts, AI, and shaders.",
            "Free includes 1,100+ open-source patterns, 285K+ icons, and 35+ utility hooks. Pro unlocks 880+ premium blocks, advanced data charts, animated shaders, AI components, priority support, unlimited downloads, and lifetime updates. Pro subscribers also get early access to new blocks weeks before they ship publicly."),
        new("cancel",
            "Can I cancel my subscription anytime?",
            "Yes, cancel from Account Settings — you keep Pro access until the period ends.",
            "Cancel anytime from Account Settings with one click. You'll keep full Pro access until the end of your current billing period and won't be charged again. We also honor a 14-day money-back guarantee on new subscriptions, no questions asked — just email support and the refund lands within one business day."),
        new("typescript",
            "Do you provide TypeScript support?",
            "Yes — every component is written in TypeScript with full type definitions.",
            "All components are written in TypeScript with strict typing and full prop interfaces. You get autocomplete, type checking, and inline JSDoc in every modern IDE. We follow strict mode and never ship any types, so refactors stay safe. Generated declaration files mean even JavaScript projects get autocomplete in editors."),
        new("frameworks",
            "What frameworks are compatible?",
            "Works with React 18+, Next.js 16+, Remix, Vite, and any React-based framework.",
            "Components are framework-agnostic React 18+ code and work in Next.js 16+, Remix, Vite, Astro, and any React-based framework. They're built with modern patterns including Server Components and React 19 features like the useFormStatus hook. Each block lists its specific requirements in the header so you can integrate with confidence."),
        new("updates",
            "How often are new components released?",
            "We ship new blocks every week and continuous bug fixes between releases.",
            "We release new blocks every week and push bug fixes and improvements continuously between weekly drops. Pro subscribers get immediate access on release day. Follow our changelog or enable email notifications to be alerted the moment a new block category lands so you can start using it the same day."),
    ];
}
