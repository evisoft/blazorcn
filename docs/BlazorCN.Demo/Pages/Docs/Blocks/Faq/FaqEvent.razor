@* ============================================================
   Block: faq-event
   Title: FaqEvent
   Description: A marketing-scale accordion FAQ block for React and Next.js with per-item lucide icons, optional highlight chips, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-event.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Event information
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Plan your three days at the conference.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Venue, schedule, tickets, accommodation, and live streaming — the answers attendees ask
                before they book travel.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-event-panel-{item.Id}";
                var triggerId = $"faq-event-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex min-w-0 items-start gap-4">
                            @if (item.Icon != null)
                            {
                                <div class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border bg-muted">
                                    <LucideIconCn Name="@GetIconName(item.Icon)" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
                                </div>
                            }
                            <div class="min-w-0">
                                <span class="text-base font-semibold text-foreground sm:text-lg">
                                    @item.Question
                                </span>
                                @if (item.Highlight != null)
                                {
                                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                        @item.Highlight
                                    </p>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[180px]">Get tickets</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">View full schedule</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "venue";

    private record FaqItem(string Id, string Question, string Answer, string? Icon = null, string? Highlight = null);

    private static readonly FaqItem[] _faqItems =
    [
        new("venue",
            "Where is the event located and how do I get there?",
            "The conference takes place at the Grand Convention Center, 123 Innovation Drive, San Francisco, CA. The venue is a 10-minute walk from Montgomery St. BART, served by Muni lines 12, 27, and 30, and offers 500 on-site parking spaces at $25 per day. The space is fully wheelchair accessible.",
            Icon: "map"),
        new("schedule",
            "What's the schedule and daily agenda?",
            "Day 1 opens with registration at 8 AM and a keynote at 9, followed by morning sessions, a networking lunch, afternoon workshops, and an evening reception. Day 2 mirrors the structure with a closing keynote at 5:30 PM. Day 3 hosts optional workshops with a separate ticket. All times are Pacific.",
            Icon: "calendar",
            Highlight: "June 15–17"),
        new("tickets",
            "What ticket types are available?",
            "General Admission ($599) includes every session, workshop, meal, and 6 months of recorded content. VIP ($999) adds reserved seating, lounge access, and speaker meet-and-greets. Student tickets ($199) and virtual passes ($199) are available, and groups of 5+ receive 10–20% off.",
            Icon: "ticket",
            Highlight: "Early bird until May 1"),
        new("refunds",
            "What's your refund and cancellation policy?",
            "Full refunds are available until May 1 (minus a $50 processing fee), 50% refunds run from May 2 to 31, and tickets are transferable any time up to 24 hours before the event. If the organizers cancel or postpone, you'll receive a full refund or transfer to the new date.",
            Icon: "shield"),
        new("accommodation",
            "Where should I stay and are there hotel discounts?",
            "Three partner hotels offer conference rates within walking distance: Hilton Union Square at $189/night, Marriott Marquis at $199/night, and Hotel Zephyr at $169/night. Use code CONF2026 at checkout. Rates apply 3 days before and after event dates and rooms hold until May 15.",
            Icon: "hotel",
            Highlight: "Code CONF2026"),
        new("streaming",
            "Is there a live stream or virtual option?",
            "Yes. Virtual tickets ($199) include live streaming of every mainstage session in 1080p with live Q&A chat, dedicated networking sessions, and 12 months of on-demand recordings. Live captions ship in English, Spanish, and French.",
            Icon: "tv"),
        new("code-of-conduct",
            "What's the code of conduct?",
            "We're committed to a harassment-free experience for every attendee regardless of background. Violations result in immediate removal without refund. Report concerns to any staff member wearing a red lanyard or text the on-site safety line.",
            Icon: "users"),
        new("what-to-bring",
            "What should I bring and what's provided?",
            "Bring a laptop for workshops, government-issued ID for check-in, business cards for networking, and comfortable shoes — the venue is large. We provide swag bags, name badges, the event app, free WiFi, charging stations, breakfast, lunch, and snack breaks throughout each day."),
    ];

    private static string GetIconName(string key) => key switch
    {
        "map"      => "map-pin",
        "calendar" => "calendar",
        "ticket"   => "ticket",
        "hotel"    => "hotel",
        "tv"       => "tv",
        "shield"   => "shield",
        "users"    => "users",
        _          => "circle",
    };
}
