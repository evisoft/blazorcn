@* ============================================================
   Block: faq-with-feedback
   Title: FaqWithFeedback
   Description: A marketing-scale FAQ accordion with thumbs up and down feedback voting per answer for React and Next.js, built with shadcn/ui, motion/react, and Tailwind CSS
   Source: original/blocks/faq/faq-with-feedback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help us improve
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Was this answer helpful?
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Browse the questions our team hears most often. Tap thumbs up or thumbs down on any
                answer — your feedback rewrites the docs.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"with-feedback-faq-panel-{item.Id}";
                var triggerId = $"with-feedback-faq-trigger-{item.Id}";
                var vote = _votes.TryGetValue(item.Id, out var v) ? v : null;
                var helpful = item.HelpfulCount + (vote == "up" ? 1 : 0);
                var notHelpful = item.NotHelpfulCount + (vote == "down" ? 1 : 0);
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <div class="mt-6 flex flex-wrap items-center gap-3 border-t pt-5">
                                    <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                        Was this helpful?
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <button
                                            type="button"
                                            aria-pressed="@((vote == "up").ToString().ToLower())"
                                            aria-label="Mark answer as helpful"
                                            @onclick="@(() => SetVote(item.Id, "up"))"
                                            class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors", vote == "up" ? "border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400" : "bg-card text-muted-foreground hover:bg-muted/60")">
                                            <LucideIconCn Name="thumbs-up" Size="14" Class="size-3.5" />
                                            <span class="tabular-nums">@helpful</span>
                                        </button>
                                        <button
                                            type="button"
                                            aria-pressed="@((vote == "down").ToString().ToLower())"
                                            aria-label="Mark answer as not helpful"
                                            @onclick="@(() => SetVote(item.Id, "down"))"
                                            class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors", vote == "down" ? "border-rose-500/40 bg-rose-500/10 text-rose-700 dark:text-rose-400" : "bg-card text-muted-foreground hover:bg-muted/60")">
                                            <LucideIconCn Name="thumbs-down" Size="14" Class="size-3.5" />
                                            <span class="tabular-nums">@notHelpful</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Suggest a question</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "trial";
    private readonly Dictionary<string, string> _votes = new();

    private void SetVote(string id, string vote)
    {
        if (_votes.TryGetValue(id, out var current) && current == vote)
            _votes.Remove(id);
        else
            _votes[id] = vote;
    }

    private record FaqItem(string Id, string Question, string Answer, int HelpfulCount, int NotHelpfulCount);

    private static readonly FaqItem[] _faqItems =
    [
        new("trial",
            "How does the 14-day free trial work?",
            "Sign up with email — no credit card required. You get full access to every feature on the Pro plan for 14 days. We send a reminder 3 days before the trial ends, and your account drops to the Free tier automatically if you don't upgrade. Nothing is ever auto-charged.",
            412, 18),
        new("data-export",
            "Can I export my data if I cancel?",
            "Always. Your data belongs to you. Export everything as JSON or CSV from Settings → Export at any time, even after cancellation. We retain canceled accounts for 90 days so you can re-export if you change your mind, then we permanently delete the data.",
            297, 7),
        new("team-billing",
            "How does team billing work for multiple seats?",
            "Team plans bill per seat with volume discounts kicking in at 10, 25, and 50 users. Add or remove seats anytime — added seats are prorated for the current period and removed seats credit your next invoice. One billing contact receives the consolidated monthly invoice.",
            184, 22),
        new("sso",
            "Do you support SSO and SAML for enterprise?",
            "Yes. SAML 2.0 and OIDC are included on the Business and Enterprise plans, with native integrations for Okta, Auth0, Google Workspace, Azure AD, and OneLogin. SCIM provisioning is available on Enterprise for automatic user lifecycle management.",
            156, 4),
        new("uptime",
            "What is your uptime SLA?",
            "We commit to 99.95% monthly uptime on Business plans and 99.99% on Enterprise, both backed by service credits. Our public status page shows real-time and historical uptime, and we publish post-mortems within 5 business days of any incident lasting longer than 10 minutes.",
            221, 11),
        new("support-hours",
            "What are your support hours and response times?",
            "Standard support runs 24/5 with median first response under 2 hours. Business plans add 24/7 chat coverage with a 1-hour response SLA, and Enterprise plans include a dedicated success manager plus a private Slack channel with our on-call engineering team.",
            143, 9),
    ];
}
