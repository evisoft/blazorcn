@* ============================================================
   Block: faq-animated-counter
   Title: FaqAnimatedCounter
   Description: A marketing-scale FAQ block for React and Next.js with an animated count-up question total, single-expand accordion, smooth disclosure animation, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-animated-counter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster with counter *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything you might ask.
            </h2>
            <div class="mt-8 flex items-baseline justify-center gap-3">
                <span class="text-6xl font-bold tracking-tight tabular-nums sm:text-7xl" aria-live="polite">
                    @_faqItems.Length
                </span>
                <span class="text-base font-medium text-muted-foreground sm:text-lg">
                    answered questions
                </span>
            </div>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Browse the full list below. Can't find what you're looking for? Our support team replies
                in under an hour.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-counter-panel-{item.Id}";
                var triggerId = $"faq-counter-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLowerInvariant()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private string? _expanded = "pricing";

    private static readonly FaqItem[] _faqItems =
    [
        new("pricing",
            "What pricing plans do you offer?",
            "Three tiers: Starter at $29/mo for individuals, Professional at $79/mo for small teams with priority support, and Enterprise with custom pricing for organizations needing dedicated SLAs and custom integrations. All plans include a 14-day free trial."),
        new("integration",
            "How do I integrate with my existing tools?",
            "Native integrations ship for Slack, Microsoft Teams, Jira, GitHub, and 50+ other tools via OAuth 2.0. The REST API and webhooks cover everything else, with SDKs for JavaScript, Python, and Go in our developer portal."),
        new("data-security",
            "How is my data secured?",
            "All data is encrypted at rest with AES-256 and in transit with TLS 1.3. We maintain SOC 2 Type II and ISO 27001 certifications, run quarterly penetration tests, and offer optional data residency in US, EU, or APAC regions."),
        new("migration",
            "Can you help us migrate from our current solution?",
            "Yes. Professional and Enterprise customers get free migration assistance. Our team analyzes your setup, drafts the migration plan, handles data transfer, and runs training sessions. Most migrations finish within 2-4 weeks."),
        new("uptime",
            "What is your uptime guarantee?",
            "99.9% SLA on Professional and 99.95% on Enterprise. Our infrastructure runs multi-region with automatic failover, real-time status updates, and incident reports within 24 hours of any service degradation."),
        new("support",
            "What support channels are available?",
            "Starter includes email support with a 24-hour response. Professional adds chat support and priority email. Enterprise gets 24/7 phone support, a dedicated account manager, quarterly business reviews, and a Slack channel with our engineers."),
        new("branding",
            "Can I customize the platform for my brand?",
            "Professional and Enterprise plans support custom branding including logo, color scheme, custom domain, and white-label options. Enterprise customers can request custom feature development on a quarterly roadmap call."),
        new("mobile",
            "Is there a native mobile app?",
            "Yes. Native iOS and Android apps ship with offline sync, biometric authentication, push notifications, and the core features from the web app. Releases ship bi-weekly in sync with web platform updates."),
    ];
}
