@* ============================================================
   Block: faq-with-difficulty
   Title: FaqWithDifficulty
   Description: A marketing-scale FAQ accordion block for React and Next.js with per-item difficulty badges (Beginner, Intermediate, Advanced), semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-difficulty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Developer FAQ
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Pick your level. Get your answer.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every question is tagged Beginner, Intermediate, or Advanced so you can jump straight to
                the depth that matches where you are today.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-difficulty-panel-{item.Id}";
                var triggerId = $"faq-difficulty-trigger-{item.Id}";
                var difficultyClass = _difficultyStyles.TryGetValue(item.Difficulty, out var dc) ? dc : "";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="flex min-w-0 flex-1 flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <span class="@Cn.Merge("inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold sm:ml-auto", difficultyClass)">
                                @item.Difficulty
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Open the SDK</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "install";

    private record FaqItem(string Id, string Question, string Answer, string Difficulty);

    private static readonly Dictionary<string, string> _difficultyStyles = new()
    {
        ["Beginner"] = "bg-emerald-500/10 text-emerald-700 ring-1 ring-inset ring-emerald-500/20 dark:text-emerald-400",
        ["Intermediate"] = "bg-amber-500/10 text-amber-700 ring-1 ring-inset ring-amber-500/20 dark:text-amber-400",
        ["Advanced"] = "bg-rose-500/10 text-rose-700 ring-1 ring-inset ring-rose-500/20 dark:text-rose-400",
    };

    private static readonly FaqItem[] _faqItems =
    [
        new("install",
            "How do I install the SDK in a fresh Next.js project?",
            "Run npm install @example/sdk inside your project, then import the Client from @example/sdk and initialize it with your API key. Types ship with the package, so editor autocomplete works the moment you import.",
            "Beginner"),
        new("auth",
            "How do I authenticate API requests?",
            "Send your secret as a bearer token in the Authorization header. Read the value from an environment variable, never hardcode it, and rotate it every quarter or after any suspected exposure.",
            "Beginner"),
        new("rate-limit",
            "How are rate limits enforced and surfaced?",
            "We use a sliding window per key. Every response includes X-RateLimit-Limit, X-RateLimit-Remaining, and X-RateLimit-Reset. When you cross the limit you receive a 429 with a Retry-After header — implement exponential backoff and respect it.",
            "Intermediate"),
        new("webhooks",
            "How do I verify webhook signatures end to end?",
            "Compute an HMAC SHA-256 of the raw request body with your webhook secret and constant-time compare it against the X-Signature header. Reject any request older than 5 minutes to defeat replay attacks.",
            "Intermediate"),
        new("pagination",
            "Which pagination strategy do you recommend for large lists?",
            "Cursor pagination. Pass the next_cursor value from each response back as ?cursor=... on the next request. Cursor pagination stays correct under concurrent writes, unlike offset pagination which silently duplicates rows.",
            "Intermediate"),
        new("batching",
            "Can I batch multiple operations into one request?",
            "Yes. POST up to 100 operations to /v1/batch. Each operation has its own method, path, and body, and the response array preserves order. Failed operations return per-item errors without aborting the batch.",
            "Advanced"),
        new("idempotency",
            "How do idempotency keys prevent duplicate writes?",
            "Send a unique UUID in the Idempotency-Key header on POST, PUT, and PATCH requests. We cache the response for 24 hours per key and replay it on retry, so a flaky network can never charge a customer twice.",
            "Advanced"),
        new("caching",
            "How should I cache GET responses for low-latency reads?",
            "We return Cache-Control and ETag headers on every GET. Issue conditional If-None-Match requests to receive a 304 when nothing changed, and front the API with Redis or a CDN for hot keys. Use webhooks instead of polling for real-time data.",
            "Advanced"),
    ];
}
