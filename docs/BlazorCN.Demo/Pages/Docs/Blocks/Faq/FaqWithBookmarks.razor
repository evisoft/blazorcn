@* ============================================================
   Block: faq-with-bookmarks
   Title: FaqWithBookmarks
   Description: A marketing-scale FAQ accordion block for React and Next.js with per-item bookmark star toggles, single-item expand, smooth height transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-bookmarks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Save what matters
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Bookmark the answers you'll come back to.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Tap the star on any question to keep it nearby. Bookmarks live in your browser session,
                so you can scan a long FAQ once and find your favourites instantly.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var isBookmarked = _bookmarked.Contains(item.Id);
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="@Cn.Merge("border-b last:border-0 transition-colors", isBookmarked ? "bg-amber-500/5" : "")">
                    <div class="flex items-start gap-2 px-6 py-5 sm:px-8 sm:py-6">
                        <button
                            type="button"
                            id="@triggerId"
                            aria-expanded="@isOpen.ToString().ToLower()"
                            aria-controls="@panelId"
                            @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                            class="flex min-w-0 flex-1 items-start justify-between gap-6 text-left">
                            <span class="text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                            <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                        </button>
                        <button
                            type="button"
                            @onclick="@(() => ToggleBookmark(item.Id))"
                            aria-pressed="@isBookmarked.ToString().ToLower()"
                            aria-label="@(isBookmarked ? "Remove bookmark" : "Bookmark this question")"
                            class="ml-1 inline-flex size-9 shrink-0 items-center justify-center rounded-full border bg-background transition-colors hover:bg-muted">
                            <LucideIconCn Name="star" Size="16" Class="@Cn.Merge("size-4 transition-colors", isBookmarked ? "fill-amber-500 text-amber-500" : "text-muted-foreground")" />
                        </button>
                    </div>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Browse all guides</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "pricing-tiers";
    private readonly HashSet<string> _bookmarked = [];

    private void ToggleBookmark(string id)
    {
        if (!_bookmarked.Add(id))
            _bookmarked.Remove(id);
    }

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("pricing-tiers",
            "What's the difference between the Individual, Team, and Organization plans?",
            "Individual is one seat with full access to every premium block. Team supports up to 5 developers with a shared workspace, priority support, and collaborative design tokens. Organization is unlimited seats with SSO, dedicated account management, custom training, and an SLA. All three include the complete component library, lifetime updates, and commercial usage rights."),
        new("refund-policy",
            "Do you offer refunds on subscription purchases?",
            "Every monthly and yearly subscription ships with a 30-day money-back guarantee — contact support within 30 days for a full refund, no questions asked. Lifetime purchases have a 14-day refund window. After the refund period, cancel anytime to stop future charges."),
        new("license-scope",
            "Can I use components in client projects?",
            "Yes. Your subscription includes commercial usage rights for unlimited client projects and SaaS apps. Modify components extensively, ship them in revenue-generating products, and bake them into client deliverables. The only restriction is reselling the source as a competing component library."),
        new("component-updates",
            "How often are new components and blocks added?",
            "We release 10–15 new blocks every month, with major feature drops quarterly. Every update is included in your subscription at no extra cost, and the changelog in your dashboard tracks every addition so you never miss a release."),
        new("framework-compat",
            "Do the components work with Next.js 16 and React 19?",
            "Yes. Every component is built against Next.js 16 and React 19 with App Router support. We mark client components with use client, follow Next.js best practices for Image and metadata, and ship updates within 48 hours of major framework releases."),
        new("enterprise-security",
            "What security do you provide for enterprise customers?",
            "Organization plans include SOC 2 Type II compliance, annual penetration testing, role-based access controls, and audit logging on every administrative action. Customers receive incident notifications within two hours and can request custom security reviews on specific components."),
    ];
}
