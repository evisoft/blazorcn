@* ============================================================
   Block: faq-toggle-all
   Title: FaqToggleAll
   Description: An accordion FAQ block for React and Next.js with expand-all and collapse-all controls, set-based state, and smooth height transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-toggle-all.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Open one. Or open them all.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Eight common questions about platform features and usage. Use the controls below to scan
                everything at once or expand answers individually.
            </p>
        </div>

        @* Bulk controls *@
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Variant="ButtonVariant.Ghost" @onclick="ExpandAll" Disabled="@_allExpanded" Class="w-full sm:w-[170px]">
                Expand all
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" @onclick="CollapseAll" Disabled="@(_expandedItems.Count == 0)" Class="w-full sm:w-[180px]">
                Collapse all
            </ButtonCn>
        </div>

        @* Accordion *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expandedItems.Contains(item.Id);
                var panelId = $"toggleall-panel-{item.Id}";
                var triggerId = $"toggleall-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => ToggleItem(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private HashSet<string> _expandedItems = [];

    private bool _allExpanded => _expandedItems.Count == _faqItems.Length;

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("slack",
            "How do I integrate with Slack?",
            "Settings → Integrations → Connect Slack. Authorize the app in your Slack workspace and pick which channels receive notifications. You can customize which event types fire, throttle frequency per channel, and disconnect anytime from the same screen."),
        new("rate-limits",
            "What is your API rate limit policy?",
            "Free accounts get 1,000 requests per hour. Pro gets 10,000 with a burst capacity of 15,000. Enterprise plans start at 100,000 per hour with custom limits negotiated with sales. Every response includes X-RateLimit headers so you can build adaptive client logic."),
        new("dashboard",
            "Can I customize the dashboard layout?",
            "Yes. Drag and drop widgets to rearrange, add or remove from the widget library, and save multiple layouts that sync across devices. Pro plans support custom widgets that pull from your own data sources or external APIs."),
        new("realtime",
            "How does real-time collaboration work?",
            "Multiple users editing the same document see live cursors and instant changes. Conflicts are resolved automatically via operational transformation. Inline comments and threaded chat keep conversation in context with the work, and every change lands in version history."),
        new("export",
            "What export formats do you support?",
            "JSON, CSV, Excel, PDF, and XML. Choose between full exports or filtered subsets by date range or criteria. Large exports run asynchronously and arrive via email. Enterprise plans include scheduled automated exports to S3, SFTP, or Google Drive."),
        new("reports",
            "Can I schedule automated reports?",
            "Pro and Enterprise plans support scheduled reports delivered via email or Slack. Pick daily, weekly, or monthly cadence and customize the metrics and filters. Reports honor your time zone and include interactive charts plus summary statistics."),
        new("domains",
            "How do I set up custom domains?",
            "Settings → Domains → Add domain, then update your DNS with the values we provide. SSL certificates are provisioned automatically via Let's Encrypt within an hour. We support apex domains, subdomains, and wildcard certificates with DNS or email verification."),
        new("mobile",
            "What mobile apps are available?",
            "Native iOS and Android apps with feature parity to the web client. Both include offline mode with automatic sync, push notifications for mentions and assignments, and biometric login. Sign in with your existing credentials and your workspace appears instantly."),
    ];

    private void ExpandAll()
    {
        _expandedItems = new HashSet<string>(_faqItems.Select(i => i.Id));
    }

    private void CollapseAll()
    {
        _expandedItems = [];
    }

    private void ToggleItem(string id)
    {
        if (_expandedItems.Contains(id))
            _expandedItems.Remove(id);
        else
            _expandedItems.Add(id);
    }
}
