@* ============================================================
   Block: faq-product
   Title: FaqProduct
   Description: A marketing-scale FAQ accordion block for React and Next.js with product-style icon header, single-item expand, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-product.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Shopping &amp; policies
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything before you check out.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Shipping, sizing, returns, and care — the answers we hear most from new shoppers. Still
                stuck? Our stylists reply in under an hour.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-product-panel-{item.Id}";
                var triggerId = $"faq-product-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">View size guide</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "shipping";

    private record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("shipping",
            "What are your shipping options and costs?",
            "Standard shipping takes 5-7 business days for $6.99 and express shipping arrives in 2-3 business days for $14.99. Orders over $75 qualify for free standard shipping. International shipping is available to 40+ countries with rates calculated at checkout based on destination and package weight."),
        new("sizing",
            "How do I find my correct size?",
            "Every product page links to a detailed size chart with chest, waist, and hip measurements in both inches and centimeters. If you're between sizes, we recommend sizing up for a relaxed fit or down for a fitted look. Email a photo of your fit question to support and our stylists reply within an hour during business days."),
        new("returns",
            "What is your return and exchange policy?",
            "Returns are accepted within 30 days of delivery on unworn, unwashed items with original tags attached. Exchanges are always free; refunds incur a $7.99 return shipping fee. Refunds process within 5-7 business days after we receive your package. Final-sale and custom items are not eligible for return."),
        new("materials",
            "What materials are your products made from?",
            "Every piece uses certified sustainable materials: GOTS organic cotton, GRS recycled polyester, and RWS responsibly-sourced merino wool. The product page lists exact fiber composition and certifications. We publish our material sourcing report annually so you can see exactly where each fabric comes from."),
        new("care",
            "How should I care for my items?",
            "Most items machine wash on a gentle cycle in cold water and air dry or tumble dry low. Avoid bleach, fabric softener, and high heat — they break down natural fibers fast. The care tag inside each garment has the exact instructions, and following them will easily double the life of the piece."),
        new("damaged",
            "What if an item arrives damaged or defective?",
            "Contact us within 7 days with a photo of the issue. We'll send a prepaid return label and ship a replacement immediately at no cost. Manufacturing defects are covered under our 90-day quality guarantee, and we'll always make it right — even if you're past the standard return window."),
    ];
}
