@* ============================================================
   Block: faq-gaming
   Title: FaqGaming
   Description: A tagged platform accordion FAQ block for React and Next.js with category and platform pills, single-expand disclosure, smooth height transitions, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-gaming.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything before you press start.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Specs, multiplayer, DLC, mods, and refunds — tagged by topic and the platforms each
                answer applies to.
            </p>
        </div>

        @* Tagged accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"gaming-faq-panel-{item.Id}";
                var triggerId = $"gaming-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="inline-flex items-center rounded-full border bg-muted px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                    @item.Category
                                </span>
                                @foreach (var platform in item.Platforms)
                                {
                                    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                                        @platform
                                    </span>
                                }
                            </div>
                            <p class="mt-2 text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Submit a ticket</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Join the Discord</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "system-requirements";

    private record FaqItem(string Id, string Category, string Question, string Answer, string[] Platforms);

    private static readonly FaqItem[] _faqItems =
    [
        new("system-requirements",
            "Technical",
            "What are the minimum system requirements?",
            "Minimum: Windows 10 64-bit, Intel Core i5-6600K or AMD Ryzen 5 1600, 8GB RAM, NVIDIA GTX 1050 Ti or AMD RX 560 (4GB VRAM), DirectX 12, 50GB storage. Recommended: Intel Core i7-8700K or AMD Ryzen 5 3600X, 16GB RAM, NVIDIA RTX 2060 or AMD RX 5700 (8GB VRAM), SSD required for optimal loading.",
            ["PC", "Steam"]),
        new("steam-deck",
            "Technical",
            "Does the game support Steam Deck?",
            "Yes — verified for Steam Deck. Runs at 40-60 FPS on medium settings at native resolution with a pre-configured controller layout. Cloud saves sync across PC and Steam Deck. Some text may be small on handheld; UI scaling options ship in settings.",
            ["Steam Deck"]),
        new("multiplayer",
            "Gameplay",
            "Is there multiplayer?",
            "Yes — supports 2-4 player co-op (local and online) and 8-player competitive matches. Cross-play is enabled between PC and consoles. Dedicated servers for ranked, peer-to-peer for casual. Voice chat is built in. Solo campaign is fully playable offline.",
            ["PC", "Console"]),
        new("offline",
            "Gameplay",
            "Can I play offline?",
            "The single-player campaign is fully playable offline after installation and activation. Multiplayer, leaderboards, and DLC validation require an online connection. Progress syncs to cloud when you reconnect, and offline mode preserves local saves indefinitely.",
            ["PC", "Console"]),
        new("dlc-list",
            "DLC",
            "What DLC is available?",
            "Season Pass ($39.99) includes 3 story expansions, 5 character skins, and an exclusive weapon pack. Individual expansions: Desert Ruins ($14.99, 8hrs), Frozen Wasteland ($14.99, 10hrs), and Neon City ($19.99, 12hrs). Cosmetic packs $4.99-$9.99. Free updates ship new modes and balance patches.",
            ["PC", "Console"]),
        new("dlc-friends",
            "DLC",
            "Do I need DLC to play with friends?",
            "No. The base game includes every multiplayer mode and map. DLC owners can play with non-DLC friends, and DLC maps rotate into public playlists. Story expansion co-op requires all players to own that specific expansion. No pay-to-win mechanics anywhere.",
            []),
        new("refund",
            "Support",
            "Can I get a refund?",
            "Steam and Epic: eligible within 14 days of purchase with under 2 hours playtime. Console: refund policies vary by platform — contact PlayStation or Xbox support directly. Physical copies are returnable to retailers within store policy, usually 7-30 days unopened.",
            ["PC", "Console"]),
        new("mods",
            "Support",
            "Are mods supported?",
            "PC fully supports Steam Workshop and manual mod installation, with 1,500+ community mods available. Modding tools and documentation are free on our website. Console versions do not support mods. Mods disable achievements unless you use approved achievement-safe mods.",
            ["PC", "Steam"]),
    ];
}
