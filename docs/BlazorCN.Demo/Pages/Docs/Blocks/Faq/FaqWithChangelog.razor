@* ============================================================
   Block: faq-with-changelog
   Title: FaqWithChangelog
   Description: A marketing-scale FAQ accordion block for React and Next.js with last-updated freshness badges, single-item expand, semantic time elements, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Always current
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Documentation that shows its age.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer carries the date it was last reviewed by our team, so you always know
                whether it reflects today's behaviour or last year's release notes.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"with-changelog-faq-panel-{item.Id}";
                var triggerId = $"with-changelog-faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                <span class="text-base font-semibold text-foreground sm:text-lg">
                                    @item.Question
                                </span>
                                <span class="inline-flex items-center gap-1 rounded-full border bg-emerald-500/10 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:text-emerald-400">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    <time datetime="@item.UpdatedIso">@item.Updated</time>
                                </span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">View changelog</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "api-version";

    private record FaqItem(string Id, string Question, string Answer, string Updated, string UpdatedIso);

    private static readonly FaqItem[] _faqItems =
    [
        new("api-version",
            "What's new in the latest API version?",
            "Version 3.0 introduces webhook delivery for real-time events, 10× higher rate limits, and GraphQL endpoints alongside REST. Several v2 endpoints are deprecated — the migration guide ships breaking-change notes and continues working until December 2026.",
            "Updated Oct 2025",
            "2025-10-14"),
        new("auth",
            "How do I authenticate API requests?",
            "Pass your API key as a Bearer token in the Authorization header. Generate scoped keys in Settings → API Keys (read-only, read-write, admin) and rotate them anytime without downtime. Keep keys in environment variables, never in client code.",
            "Updated Sep 2025",
            "2025-09-22"),
        new("rate-limits",
            "What are the current rate limits?",
            "Free: 1,000 requests per hour. Pro: 10,000 per hour. Enterprise: custom. Limits are per API key. Exceeding a limit returns 429 with a Retry-After header. Batch endpoints count as a single request regardless of payload size.",
            "Updated Oct 2025",
            "2025-10-02"),
        new("pagination",
            "How do I handle pagination in API responses?",
            "Cursor-based pagination via the cursor query parameter. Responses include next and previous cursors in metadata. Page size defaults to 100 (max 1,000). Cursors expire after 24 hours. Offset pagination remains supported but is deprecated.",
            "Updated Aug 2025",
            "2025-08-11"),
        new("errors",
            "What error codes should I handle?",
            "Common codes: 400 invalid request, 401 unauthorized, 403 forbidden, 404 not found, 429 rate limited, 500 server error. Every error returns JSON with code, message, and a docs link. Use exponential backoff for 429 and 5xx responses.",
            "Updated Jul 2025",
            "2025-07-19"),
        new("webhooks",
            "Do you support webhooks for real-time updates?",
            "Yes. Configure webhooks in Settings → Webhooks and subscribe to events like user.created, payment.succeeded, and subscription.cancelled. Delivery is at-most-once via HTTPS POST with HMAC signatures and exponential retries for 48 hours.",
            "Updated Oct 2025",
            "2025-10-05"),
        new("uptime",
            "What's your API uptime SLA?",
            "We guarantee 99.9% uptime on paid plans with service credits if we miss it. The status page shows real-time metrics and incident history. Maintenance windows run during low-traffic hours with 48-hour notice and automatic regional failover.",
            "Updated Jun 2025",
            "2025-06-30"),
    ];
}
