@* ============================================================
   Block: faq-with-preview
   Title: FaqWithPreview
   Description: A marketing-scale FAQ block for React and Next.js with hover-triggered popover answer previews, smooth motion enter/exit, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Peek before you read.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hover any question for a one-line summary, then click to read the full answer. Built for
                visitors who want to scan first and commit second.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var isHovered = _hovered == item.Id && !isOpen;
                var panelId = $"faq-preview-panel-{item.Id}";
                var triggerId = $"faq-preview-trigger-{item.Id}";
                <div class="relative border-b last:border-0"
                     @onmouseenter="@(() => _hovered = item.Id)"
                     @onmouseleave="@(() => _hovered = null)">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        @onfocus="@(() => _hovered = item.Id)"
                        @onblur="@(() => _hovered = null)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @* Hover preview popover *@
                    @if (isHovered)
                    {
                        <div aria-hidden="true" class="pointer-events-none absolute inset-x-6 -bottom-2 z-10 sm:inset-x-8">
                            <div class="rounded-lg border bg-popover px-4 py-3 text-sm leading-relaxed text-popover-foreground shadow-lg">
                                @item.Preview
                            </div>
                        </div>
                    }

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "enterprise-features";
    private string? _hovered = null;

    private record FaqItem(string Id, string Question, string Answer, string Preview);

    private static readonly FaqItem[] _faqItems =
    [
        new("enterprise-features",
            "What features are included in the Enterprise plan?",
            "Enterprise plans include unlimited seats, SSO/SAML authentication, a dedicated account manager, a 99.9% uptime SLA backed by financial credits, priority support with a 1-hour response window, custom contract terms, advanced security controls, audit logs, custom integrations, and on-premise deployment options. We also provide white-glove onboarding and quarterly business reviews.",
            "Unlimited seats, SSO/SAML, dedicated CSM, 99.9% uptime SLA, and on-prem options."),
        new("data-migration",
            "How does data migration from another tool work?",
            "Our migration team handles the entire process from assessment to validation. We support imports from CSV, Excel, JSON, SQL databases, and the major competitor platforms. The process includes data mapping, transformation, validation, and rollback. Most migrations complete within two weeks. We provide a dedicated engineer and keep your existing system running during the transition until you're satisfied.",
            "A migration engineer handles assessment, mapping, validation, and rollback in 2 weeks."),
        new("api-documentation",
