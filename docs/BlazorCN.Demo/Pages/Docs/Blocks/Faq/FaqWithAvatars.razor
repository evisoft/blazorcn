@* ============================================================
   Block: faq-with-avatars
   Title: FaqWithAvatars
   Description: An author-attributed FAQ block for React and Next.js with expert avatars beside each answer, single-expand accordion, font-mono initial fallbacks, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Answered by humans, not bots.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer below is signed by the teammate who owns it. If you need to dig deeper,
                you'll know exactly who to ask.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-avatar-{item.Id}-panel";
                var triggerId = $"faq-avatar-{item.Id}-trigger";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div aria-hidden="true" class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @item.AnsweredBy.Initials
                            </span>
                        </div>
                        <span class="flex-1 text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <figcaption class="mt-5 flex items-center gap-3 border-t pt-4">
                                    <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                        <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                            @item.AnsweredBy.Initials
                                        </span>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-foreground">
                                            @item.AnsweredBy.Name
                                        </p>
                                        <p class="text-xs text-muted-foreground">@item.AnsweredBy.Role</p>
                                    </div>
                                </figcaption>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Talk to our team</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "billing";

    private record TeamMember(string Name, string Initials, string Role);
    private record FaqItem(string Id, string Question, string Answer, TeamMember AnsweredBy);

    private static readonly FaqItem[] _faqItems =
    [
        new("billing",
            "How does billing work for team accounts?",
            "Team accounts are billed monthly per active seat. Add or remove members anytime and we prorate the current period. Annual plans get a 20% discount and lock in pricing for 12 months.",
            new TeamMember("Sarah Chen", "SC", "Head of Finance")),
        new("api-limits",
            "What are the API rate limits?",
            "Standard plans get 1,000 requests per hour with 100 burst per minute. Pro gets 10,000 per hour. Enterprise limits are negotiated during onboarding. Every response includes rate-limit headers.",
            new TeamMember("Marcus Okonkwo", "MO", "Principal Engineer")),
        new("data-export",
            "Can I export all my data?",
            "Yes. Export your full dataset anytime via the dashboard or API in JSON or CSV. Large exports run async and arrive by email within 24 hours. Scheduled exports are available via cron-style API calls.",
            new TeamMember("Emily Watson", "EW", "Product Manager")),
        new("sso",
            "How do I set up Single Sign-On?",
            "SSO is available on Enterprise via SAML 2.0 or OAuth 2.0. We support Okta, Azure AD, and Google Workspace, plus SCIM for automated provisioning. Setup typically completes in 2–3 business days.",
            new TeamMember("David Kim", "DK", "Security Engineer")),
        new("downgrade",
            "What happens if I downgrade my plan?",
            "You keep premium features through the end of the current period. After that, exclusive features become read-only — your data is never deleted. Upgrade again any time to restore full access.",
            new TeamMember("Sarah Chen", "SC", "Head of Finance")),
        new("webhooks",
            "Do you support webhooks for real-time updates?",
            "Yes, on Pro and Enterprise. Configure endpoints in settings to receive events for record creation, updates, and deletions. Every payload is signed with HMAC and we retry failed deliveries with exponential backoff.",
            new TeamMember("Marcus Okonkwo", "MO", "Principal Engineer")),
        new("training",
            "Is training included with Enterprise plans?",
            "Enterprise customers get live onboarding, custom documentation, video tutorials, and monthly office hours. We train your team on best practices, advanced features, and admin workflows at no extra cost.",
            new TeamMember("Jessica Taylor", "JT", "Customer Success")),
    ];
}
