@* ============================================================
   Block: faq-print-friendly
   Title: FaqPrintFriendly
   Description: A print-optimized FAQ accordion block for React and Next.js with hero-scale headline cluster, dedicated print ShadcnioButton, print media query that opens every answer on paper, semantic aria markup, and a CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-print-friendly.tsx
   ============================================================ *@

<style>
    @@media print {
        .faq-print-no-print { display: none !important; }
        .faq-print-answer {
            display: block !important;
            height: auto !important;
            opacity: 1 !important;
            overflow: visible !important;
        }
        .faq-print-card { border: none !important; box-shadow: none !important; }
    }
</style>

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Help center
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Take the answers with you.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every common question about accounts, billing, and integration — formatted to read
                cleanly on screen and on paper. Tap Print and every answer opens for the printer.
            </p>
        </div>

        @* Print affordance *@
        <div class="faq-print-no-print mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[210px]" @onclick="HandlePrint">
                <LucideIconCn Name="printer" Size="16" Class="mr-2 size-4" />
                Print this page
            </ButtonCn>
        </div>

        @* Accordion *@
        <div class="faq-print-card mt-8 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-print-panel-{item.Id}";
                var triggerId = $"faq-print-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <div class="min-w-0 flex-1">
                            <span class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                                @item.Category
                            </span>
                            <span class="mt-1.5 block text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("faq-print-no-print mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="faq-print-answer overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }

                    @if (!isOpen)
                    {
                        <div class="faq-print-answer hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="faq-print-no-print mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]" @onclick="HandlePrint">
                Print this page
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Download as PDF
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "account-security";

    private void HandlePrint()
    {
        // Print is a client-side browser action; in a real app wire up IJSRuntime.InvokeVoidAsync("window.print")
    }

    private record FaqItem(string Id, string Category, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("account-security", "Account",
            "How do I enable two-factor authentication on my account?",
            "Open Settings > Security and click 'Enable 2FA'. Scan the QR code with your authenticator app (Google Authenticator, Authy, or 1Password). Enter the 6-digit code to confirm and save your recovery codes somewhere safe. 2FA is required on Organization plans and strongly recommended for everyone handling sensitive data."),
        new("billing-cycle", "Billing",
            "When does my billing cycle start and how is it calculated?",
            "Your cycle begins on the day you first subscribe and repeats on the same day each month or each year. Upgrade mid-cycle and you're charged a prorated amount for the rest of the period — your renewal date doesn't move. Cancellations stop monthly billing immediately and apply at year-end for annual plans."),
        new("seat-management", "Team",
            "How do I add or remove team members from my workspace?",
            "Open workspace Settings > Members and click 'Invite Member'. Enter their email and pick a role (Admin, Developer, or Viewer). They get an invitation with setup instructions. Remove members from the three-dot menu — they lose access immediately, but their previous contributions stay in the workspace. Seat changes take effect on the next billing cycle."),
        new("component-integration", "Technical",
            "What's the recommended way to integrate components into an existing project?",
            "Make sure your project runs Next.js 16+, React 19+, and Tailwind CSS 4+. Install dependencies with bun install or npm install. Copy the component files into your components directory, keeping the folder structure. Update import paths to your alias (~/ or @/). Run your build to verify TypeScript types resolve cleanly."),
        new("license-compliance", "Licensing",
            "What are the licensing terms for components in open-source projects?",
            "You can use components in open-source projects under your active subscription. Include the source comment and keep copyright notices intact. You cannot extract components into a competing library. If your open-source project becomes commercial, your existing subscription covers that usage."),
        new("data-privacy", "Privacy",
            "What data do you collect and how is it used?",
            "We collect account info (name, email), billing details (processed by Stripe, not stored on our servers), usage analytics, and workspace data. We never access your component implementations, application code, or end-user data. Request export or deletion any time from Settings > Privacy. We're GDPR and CCPA compliant."),
        new("downgrade-process", "Subscription",
            "What happens to my data if I downgrade or cancel?",
            "Downgrading keeps every component you've already integrated working — the code doesn't expire. You lose access to download new premium components and updates. Cancel entirely and you have 30 days to export workspace data before it's archived. Archived data is retained for 90 days in case you reactivate."),
    ];
}
