@* ============================================================
   Block: faq-with-share
   Title: FaqWithShare
   Description: A marketing-scale FAQ block for React and Next.js with per-question share buttons for copy link, X, and LinkedIn, single-item expand, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-share.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Share any answer in one click.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer has a permalink and share buttons for X and LinkedIn. Drop the link in a
                ticket, a Slack thread, or a tweet - your teammates land directly on the answer.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in _faqItems)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var isCopied = _copiedId == item.Id;
                var panelId = $"faq-share-panel-{item.Id}";
                var triggerId = $"faq-share-trigger-{item.Id}";
                <div id="@($"with-share-{item.Id}")" class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        aria-controls="@panelId"
                        @onclick="@(() => Toggle(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <div class="mt-5 flex items-center gap-2 border-t pt-4">
                                    <span class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                                        Share
                                    </span>
                                    <div class="ml-2 flex items-center gap-1">
                                        <button
                                            type="button"
                                            @onclick="@(() => HandleCopy(item.Id))"
                                            aria-label="@($"Copy link to {item.Question}")"
                                            class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground">
                                            @if (isCopied)
                                            {
                                                <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600" aria-hidden="true" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="link" Size="16" Class="size-4" aria-hidden="true" />
                                            }
                                        </button>
                                        <button
                                            type="button"
                                            @onclick="@(() => HandleTwitter(item))"
                                            aria-label="@($"Share {item.Question} on X")"
                                            class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground">
                                            <LucideIconCn Name="twitter" Size="16" Class="size-4" aria-hidden="true" />
                                        </button>
                                        <button
                                            type="button"
                                            @onclick="@(() => HandleLinkedIn(item))"
                                            aria-label="@($"Share {item.Question} on LinkedIn")"
                                            class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground">
                                            <LucideIconCn Name="linkedin" Size="16" Class="size-4" aria-hidden="true" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Read the docs
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private string? _expanded = null;
    private string? _copiedId = null;

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private void HandleCopy(string id)
    {
        _copiedId = id;
        _ = ResetCopiedAfterDelayAsync(id);
    }

    private async Task ResetCopiedAfterDelayAsync(string id)
    {
        await Task.Delay(2000);
        if (_copiedId == id)
        {
            _copiedId = null;
            StateHasChanged();
        }
    }

    private void HandleTwitter(FaqItem item)
    {
        // Share on X — client-side navigation not available in SSR; link rendered as no-op in static context
    }

    private void HandleLinkedIn(FaqItem item)
    {
        // Share on LinkedIn — client-side navigation not available in SSR; link rendered as no-op in static context
    }

    private static readonly FaqItem[] _faqItems =
    [
        new("api-rate-limits",
            "What are the API rate limits per subscription tier?",
            "Individual plans get 1,000 requests per hour per API key. Team plans raise that to 5,000 per hour with a burst allowance of 10,000 requests in any 5-minute window. Organization plans include 20,000 requests per hour with custom burst limits negotiable through your account manager. Every response includes X-RateLimit-Limit and X-RateLimit-Remaining headers so you can back off gracefully."),
        new("webhook-retry",
            "How does webhook retry logic handle a downed endpoint?",
            "We attempt webhook delivery with exponential backoff: immediately, then 5 minutes, 30 minutes, 2 hours, 6 hours, and 24 hours later. After five failures across about 32 hours we mark the webhook as failed and email you. You can manually retry failed webhooks from the dashboard for up to 7 days, and we recommend using the X-Webhook-ID header for idempotent processing."),
        new("sso-providers",
            "Which SSO providers do you support for Organization accounts?",
            "We support SAML 2.0 with any compliant identity provider including Okta, Azure AD, Google Workspace, OneLogin, and Auth0. OIDC is available for Keycloak and custom providers. Setup needs your metadata URL or XML, and we provide ACS URL and Entity ID. SSO provisioning takes 2-3 business days. JIT and SCIM are available on Enterprise add-on packages."),
        new("data-export",
            "What format are data exports and how do I request one?",
            "Data exports are JSON files containing your workspace data, configurations, team lists, and usage analytics. From Settings > Data & Privacy click Request Export, and you'll receive a download link via email within 24 hours. Exports stay available for 7 days. Organization plans can request CSV or XML on demand."),
        new("versioning",
            "How does component versioning work and can I roll back?",
            "We follow semantic versioning - major.minor.patch - and maintain the last three major versions. Major versions indicate breaking changes, minor versions add features, and patches fix bugs. View version history in the docs and download any previous version from the changelog if you ever need to roll back."),
        new("custom-requests",
            "Do you accept custom component requests?",
            "Yes. Team plans include one custom component request per month and Organization plans include three. Submit requests through your dashboard with a description, mockups, and technical requirements. Our team reviews feasibility within three business days and provides a timeline. Custom components typically ship within 1-2 weeks."),
        new("performance",
            "What performance benchmarks should I expect?",
            "All components are optimized for Core Web Vitals. Average bundle size is 8-12KB gzipped per component. Lighthouse scores typically hit 95+ for performance and 100 for accessibility. We test on devices ranging from high-end desktops to mid-range phones, ensuring 60fps animations and sub-100ms interactions."),
        new("migration-timeline",
            "How long does a typical migration from another component library take?",
            "Small to medium projects with 10-50 components usually need 2-4 weeks. Large enterprise applications with 100+ components typically take 6-12 weeks. Timelines depend on your current library, design system complexity, and the level of customization. We recommend a phased approach - new features first, existing components during regular maintenance."),
    ];
}
