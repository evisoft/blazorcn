@* ============================================================
   Block: faq-with-tooltip
   Title: FaqWithTooltip
   Description: A marketing-scale FAQ block for React and Next.js with inline glossary terms, dotted underlines, hover tooltips, single-expand accordion, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-tooltip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Developer FAQ
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Hover the underlines for definitions.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The technical answers you need, with inline glossary tooltips for every term that
                would normally send you to a second tab.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in _faqItems)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-tooltip-panel-{item.Id}";
                var triggerId = $"faq-tooltip-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        aria-controls="@panelId"
                        @onclick="@(() => Toggle(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @foreach (var answerSeg in item.Answer)
                                {
                                    var seg = answerSeg;
                                    if (seg.IsText)
                                    {
                                        <span>@seg.Text</span>
                                    }
                                    else
                                    {
                                        <TooltipCn OpenDelay="150">
                                            <TooltipTriggerCn Class="cursor-help border-b border-dotted border-foreground/40 font-medium text-foreground transition-colors hover:border-foreground">@seg.Term</TooltipTriggerCn>
                                            <TooltipContentCn Class="max-w-xs">
                                                <p class="text-xs leading-relaxed">@seg.Definition</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    }
                                }
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Open the glossary</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "webhooks";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private record AnswerSegment(bool IsText, string Text = "", string Term = "", string Definition = "")
    {
        public static AnswerSegment FromText(string text) => new(true, Text: text);
        public static AnswerSegment FromTerm(string term, string definition) => new(false, Term: term, Definition: definition);
    }

    private record FaqItem(string Id, string Question, AnswerSegment[] Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("webhooks",
            "How do webhooks work?",
            [
                AnswerSegment.FromTerm("Webhooks", "Real-time HTTP callbacks sent to your server when events occur in our system."),
                AnswerSegment.FromText(" are triggered the moment specific events fire. We POST a "),
                AnswerSegment.FromTerm("JSON payload", "A structured key-value data format used for API communication."),
                AnswerSegment.FromText(" to your endpoint, signed with an "),
                AnswerSegment.FromTerm("HMAC signature", "A cryptographic signature that lets you verify the request actually came from us."),
                AnswerSegment.FromText(". Failed deliveries retry with "),
                AnswerSegment.FromTerm("exponential backoff", "A retry strategy where the wait between attempts doubles each time."),
                AnswerSegment.FromText(" for up to 24 hours."),
            ]),
        new("rate-limits",
            "What are the API rate limits?",
            [
                AnswerSegment.FromText("We enforce rate limits using a "),
                AnswerSegment.FromTerm("sliding window algorithm", "A counting strategy that measures requests over a rolling time window instead of fixed buckets."),
                AnswerSegment.FromText(". Free tier gets 1,000 requests per hour; Pro tier gets 10,000. Every response includes "),
                AnswerSegment.FromTerm("X-RateLimit headers", "HTTP headers that report your current usage, remaining quota, and reset timestamp."),
                AnswerSegment.FromText(", and exceeding the limit returns a "),
                AnswerSegment.FromTerm("429 status", "An HTTP status code that means Too Many Requests."),
                AnswerSegment.FromText(" with a Retry-After value."),
            ]),
        new("authentication",
            "How does authentication work?",
            [
                AnswerSegment.FromText("We use "),
                AnswerSegment.FromTerm("OAuth 2.0", "The industry-standard authorization framework for delegated API access."),
                AnswerSegment.FromText(" with "),
                AnswerSegment.FromTerm("PKCE", "Proof Key for Code Exchange, an extension that protects public clients from interception attacks."),
                AnswerSegment.FromText(". Access tokens are short-lived "),
                AnswerSegment.FromTerm("JWTs", "JSON Web Tokens — self-contained signed tokens that carry claims about the user."),
                AnswerSegment.FromText(" valid for one hour. Refresh tokens last 30 days with automatic rotation on each use."),
            ]),
        new("caching",
            "How does response caching work?",
            [
                AnswerSegment.FromText("Every cacheable response includes "),
                AnswerSegment.FromTerm("Cache-Control headers", "HTTP headers that tell browsers and CDNs how long to store a response."),
                AnswerSegment.FromText(" and an "),
                AnswerSegment.FromTerm("ETag", "A unique fingerprint for a resource version, used for conditional revalidation."),
                AnswerSegment.FromText(". Our edge "),
                AnswerSegment.FromTerm("CDN", "Content Delivery Network — a global mesh of servers that caches responses near your users."),
                AnswerSegment.FromText(" serves repeat reads in under 30ms with "),
                AnswerSegment.FromTerm("stale-while-revalidate", "A caching directive that serves the stale copy while a fresh one is fetched in the background."),
                AnswerSegment.FromText("."),
            ]),
        new("pagination",
            "How does pagination work?",
            [
                AnswerSegment.FromText("All list endpoints use "),
                AnswerSegment.FromTerm("cursor pagination", "A pagination model that returns an opaque pointer to your current position in the result set."),
                AnswerSegment.FromText(". Pass the cursor from the previous response into the next request. Default page size is 50 items, max 100, and cursors stay valid for 24 hours."),
            ]),
        new("idempotency",
            "What is idempotency and when should I use it?",
            [
                AnswerSegment.FromTerm("Idempotency", "A property where running the same operation multiple times has the same effect as running it once."),
                AnswerSegment.FromText(" prevents duplicate side-effects from network retries. Send an "),
                AnswerSegment.FromTerm("Idempotency-Key header", "A unique key that lets us recognize and replay a previous response instead of creating a duplicate."),
                AnswerSegment.FromText(" on every POST. We store keys for 24 hours."),
            ]),
    ];
}
