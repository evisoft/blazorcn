@* ============================================================
   Block: faq-categorized
   Title: FaqCategorized
   Description: A marketing-scale categorized FAQ block for React and Next.js with tab category switching, AnimatePresence transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-categorized.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse answers by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a category and skim the answers most teams want before they sign up. Can't find
                what you need? Our support team replies in under an hour.
            </p>
        </div>

        @* Tabs *@
        <TabsCn Value="@_active" ValueChanged="@((string? v) => { if (v is not null) _active = v; })" Class="mt-10 w-full">
            <TabsListCn Class="grid w-full grid-cols-2 sm:grid-cols-4">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <TabsTriggerCn Value="@category.Value" Class="gap-1.5">
                        <LucideIconCn Name="@category.Icon" Size="16" Class="size-4" aria-hidden="true" />
                        @category.Label
                    </TabsTriggerCn>
                }
            </TabsListCn>
        </TabsCn>

        @* Active panel *@
        <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
            @foreach (var item in ActiveItems)
            {
                <article class="border-b px-6 py-5 last:border-0 sm:px-8 sm:py-6">
                    <h3 class="text-base font-semibold text-foreground sm:text-lg">
                        @item.Question
                    </h3>
                    <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                        @item.Answer
                    </p>
                </article>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Read the docs
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);
    private record FaqCategory(string Value, string Label, string Icon);

    private string _active = "general";

    private FaqItem[] ActiveItems => _faqData.TryGetValue(_active, out var items) ? items : [];

    private static readonly FaqCategory[] _categories =
    [
        new("general", "General", "tag"),
        new("billing", "Billing", "credit-card"),
        new("technical", "Technical", "settings"),
        new("account", "Account", "circle-dollar-sign"),
    ];

    private static readonly Dictionary<string, FaqItem[]> _faqData = new()
    {
        ["general"] =
        [
            new("g1",
                "What makes your platform different from competitors?",
                "We combine enterprise-grade security with real-time collaboration and AI insights that learn from your workflow. Unlimited integrations ship on every plan, our 99.99% uptime SLA covers all customers, and 24/7 support is included from day one — not as a paid add-on."),
            new("g2",
                "How long does setup take for a new team?",
                "Most teams are fully operational within two hours. Our guided onboarding wizard handles workspace creation, user invitations, and integration setup automatically. Enterprise customers receive dedicated implementation support with custom training and migration assistance."),
            new("g3",
                "Do you offer a free trial?",
                "Yes — a 14-day free trial of every Pro feature, no credit card required. The trial includes unlimited users, all integrations, and priority support. At the end of the trial you can pick a plan or stay on the generous free tier indefinitely."),
        ],
        ["billing"] =
        [
            new("b1",
                "When am I charged for my subscription?",
                "Billing happens on the date you subscribe and renews on the same day each month or year. Annual plans pay upfront with a 20% discount. Receipts arrive immediately by email and full invoices live in your billing dashboard with complete transaction history."),
            new("b2",
                "Can I change my billing cycle?",
                "Yes. Switch between monthly and annual billing anytime from the dashboard. Switching to annual credits your remaining monthly subscription against the annual price. Switching back to monthly takes effect at the next renewal so you keep the value of your annual discount."),
            new("b3",
                "What happens if my payment fails?",
                "We retry the payment after three days, then again after seven, with email notifications before each attempt. If every retry fails, your account drops to the free tier and your data is preserved for 60 days so you have time to update your payment method without losing work."),
        ],
        ["technical"] =
        [
            new("t1",
                "What is your API response time?",
                "Our API maintains p95 response times under 200ms globally with edge caching across 50+ locations. Redis handles caching, PostgreSQL handles persistence, and a CDN serves static assets. Real-time latency metrics are public on our status page."),
            new("t2",
                "How do you handle data backups?",
                "Automated backups run every six hours with 30-day retention across geographically distributed regions. Point-in-time recovery is available on Enterprise plans with one-minute granularity. Backups are AES-256 encrypted and tested weekly via automated restore procedures."),
            new("t3",
                "Do you support self-hosting?",
                "Enterprise customers can deploy on their own infrastructure using Docker or Kubernetes. We provide deployment scripts, monitoring setup, and ongoing support. Self-hosted deployments receive the same feature updates as our cloud offering with a two-week delay for additional QA."),
        ],
        ["account"] =
        [
            new("a1",
                "How do I add team members?",
                "Open Settings → Team and click Invite Member. Add emails and assign Admin, Editor, or Viewer roles. Invitations expire after seven days and can be resent. Members receive onboarding emails with setup instructions and can sign in using SSO if configured."),
            new("a2",
                "Can I transfer ownership of my account?",
                "Yes. From Settings → Account → Transfer Ownership, select the new owner. They confirm via email. All billing, integrations, and data remain intact. Both parties must have 2FA enabled for the transfer to complete."),
            new("a3",
                "How do I delete my account?",
                "Go to Settings → Account → Delete Account and confirm via the email link, valid for 24 hours. Your data is deactivated immediately and permanently deleted after 30 days. Export your data before deletion as the action cannot be undone."),
        ],
    };
}
