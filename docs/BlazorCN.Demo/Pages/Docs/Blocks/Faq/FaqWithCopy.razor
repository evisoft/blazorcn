@* ============================================================
   Block: faq-with-copy
   Title: FaqWithCopy
   Description: A marketing-scale FAQ accordion block for React and Next.js with per-item copy-to-clipboard buttons, copied state feedback, semantic disclosure markup, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-with-copy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Developer answers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Copy the answer. Ship the change.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer is one click away from your terminal. Tap the copy button and paste it into
                your editor, your runbook, or your team's wiki.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var faqItem in _faqItems)
            {
                var item = faqItem;
                var isOpen = _expanded == item.Id;
                var isCopied = _copiedId == item.Id;
                var panelId = $"faq-copy-panel-{item.Id}";
                var triggerId = $"faq-copy-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        aria-controls="@panelId"
                        @onclick="@(() => Toggle(item.Id))"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" aria-hidden="true" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <button
                                    type="button"
                                    @onclick="@(() => HandleCopy(item.Id, item.Answer))"
                                    aria-label="@($"Copy answer for: {item.Question}")"
                                    class="mt-5 inline-flex items-center gap-2 rounded-lg border bg-background px-3 py-2 text-xs font-medium text-foreground transition-colors hover:bg-muted/60">
                                    @if (isCopied)
                                    {
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                                        @:Copied!
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="14" Class="size-3.5" aria-hidden="true" />
                                        @:Copy answer
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">
                Contact support
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Id, string Question, string Answer);

    private string? _expanded = "install";
    private string? _copiedId = null;

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private void HandleCopy(string id, string text)
    {
        _copiedId = id;
        _ = ResetCopiedAfterDelayAsync(id);
    }

    private async Task ResetCopiedAfterDelayAsync(string id)
    {
        await Task.Delay(2000);
        if (_copiedId == id)
        {
            _copiedId = null;
            StateHasChanged();
        }
    }

    private static readonly FaqItem[] _faqItems =
    [
        new("install",
            "How do I install the CLI on macOS, Linux, or Windows?",
            "Run npm install -g @company/cli, then verify with company --version. The CLI requires Node.js 18 or later and works identically across macOS, Linux, and Windows. On Windows you may need to relaunch your terminal after the global install so the new PATH entry is picked up."),
        new("auth",
            "How do I authenticate API requests?",
            "Send your secret key in the Authorization header as a bearer token: Authorization: Bearer sk_live_4eC39HqLyjWDarjtT1zdp7dc. Always read the key from an environment variable, never commit it to source control, and rotate it from the dashboard if you suspect exposure."),
        new("base-url",
            "What is the base URL for production API requests?",
            "Production traffic goes to https://api.example.com/v2 and the sandbox lives at https://sandbox.example.com/v2. Both endpoints share the same schema, so you can promote a working sandbox integration to production by swapping the host string and the API key."),
        new("webhook",
            "How do I set up a webhook endpoint?",
            "Point your handler at https://api.example.com/webhooks/events from the dashboard, then verify the X-Signature header on every payload using your webhook secret. Respond with a 200 status within 5 seconds — anything slower or non-2xx triggers retry with exponential backoff."),
        new("websocket",
            "How do I subscribe to real-time updates?",
            "Open a WebSocket to wss://ws.example.com/v2/stream and authenticate with your API key in the first frame. The server sends a ping every 30 seconds — reply with pong to keep the channel alive. Reconnect on close with jittered exponential backoff to avoid thundering-herd reconnects."),
        new("env",
            "Which environment variables should I set in production?",
            "Set API_KEY, API_URL, and WEBHOOK_SECRET in your hosting provider's secret manager. Never put real credentials in a .env file that ships with your build. Most platforms (Vercel, Fly, Render, Railway) expose a UI to inject secrets at deploy time without writing them to disk."),
    ];
}
