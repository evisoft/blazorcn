@* ============================================================
   Block: faq-collapsible-sidebar
   Title: FaqCollapsibleSidebar
   Description: A marketing-scale FAQ block for React and Next.js with a collapsible category sidebar, filtered question list, smooth disclosure transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-collapsible-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Filter answers by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a category in the sidebar to scope the questions, then expand any answer to read it
                in full. Collapse the sidebar anytime to focus on the content.
            </p>
        </div>

        @* Sidebar + content panel *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            <div class="flex">
                @* Sidebar *@
                @if (!_isCollapsed)
                {
                    <aside class="overflow-hidden border-r bg-muted/30" style="width:208px">
                        <div class="flex h-full flex-col">
                            <div class="flex items-center justify-between border-b px-4 py-3">
                                <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                    Categories
                                </span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick="@(() => _isCollapsed = true)" aria-label="Collapse sidebar">
                                    <LucideIconCn Name="panel-left-close" Size="16" Class="size-4" aria-hidden="true" />
                                </ButtonCn>
                            </div>
                            <div class="flex-1 overflow-y-auto p-2">
                                <button
                                    type="button"
                                    @onclick="@(() => _selectedCategory = null)"
                                    class="@Cn.Merge("mb-1 flex w-full items-center justify-between gap-2 rounded-md px-3 py-2 text-left text-sm transition-colors hover:bg-muted", _selectedCategory == null ? "bg-muted font-semibold" : "")">
                                    <span>All questions</span>
                                    <span class="text-xs text-muted-foreground">@_faqData.Length</span>
                                </button>
                                @foreach (var cat in _categories)
                                {
                                    var category = cat;
                                    var count = 0;
                                    foreach (var fi in _faqData) { if (fi.Category == category) count++; }
                                    <button
                                        type="button"
                                        @onclick="@(() => _selectedCategory = category)"
                                        class="@Cn.Merge("mb-1 flex w-full items-center justify-between gap-2 rounded-md px-3 py-2 text-left text-sm transition-colors hover:bg-muted", _selectedCategory == category ? "bg-muted font-semibold" : "")">
                                        <span>@category</span>
                                        <span class="text-xs text-muted-foreground">@count</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </aside>
                }

                @* Main content *@
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-3 border-b px-6 py-5 sm:px-8 sm:py-6">
                        @if (_isCollapsed)
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0" @onclick="@(() => _isCollapsed = false)" aria-label="Expand sidebar">
                                <LucideIconCn Name="panel-left-open" Size="16" Class="size-4" aria-hidden="true" />
                            </ButtonCn>
                        }
                        <div class="min-w-0 flex-1">
                            <p class="text-base font-semibold text-foreground sm:text-lg">
                                @(_selectedCategory != null ? $"{_selectedCategory} questions" : "All questions")
                            </p>
                            <p class="mt-1 text-xs text-muted-foreground">
                                @_filteredFaqs.Length @(_filteredFaqs.Length == 1 ? "question" : "questions")
                            </p>
                        </div>
                    </div>

                    <div>
                        @foreach (var it in _filteredFaqs)
                        {
                            var item = it;
                            var isExpanded = _expandedId == item.Id;
                            var triggerId = $"faq-sidebar-trigger-{item.Id}";
                            var panelId = $"faq-sidebar-panel-{item.Id}";
                            <div class="border-b last:border-0">
                                <button
                                    type="button"
                                    id="@triggerId"
                                    aria-expanded="@isExpanded.ToString().ToLower()"
                                    aria-controls="@panelId"
                                    @onclick="@(() => _expandedId = isExpanded ? null : item.Id)"
                                    class="flex w-full items-start gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                                    <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isExpanded ? "rotate-180" : "")" aria-hidden="true" />
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                            @item.Category
                                        </p>
                                        <p class="mt-1 text-base font-semibold text-foreground sm:text-lg">
                                            @item.Question
                                        </p>
                                    </div>
                                </button>

                                @if (isExpanded)
                                {
                                    <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                                        <p class="px-6 pb-6 pl-[60px] text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8 sm:pl-[68px]">
                                            @item.Answer
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _selectedCategory = null;
    private string? _expandedId = null;
    private bool _isCollapsed = false;

    private record FaqItem(string Id, string Category, string Question, string Answer);

    private static readonly FaqItem[] _faqData =
    [
        new("account-basics", "Account", "How do I reset my password?",
            "Click Forgot Password on the login page and enter your email. You'll receive a reset link valid for 24 hours. Click it and enter a new password twice to confirm. If the email doesn't arrive, check spam or contact support. For security, reset links can only be used once."),
        new("account-deletion", "Account", "How do I delete my account?",
            "Open Settings → Account → Delete Account and confirm by typing DELETE. Account deletion is permanent and erases your data within 30 days per GDPR. Active subscriptions cancel immediately with no refund for remaining time. Export your data first if you need to keep records."),
        new("account-security", "Account", "Does the platform support two-factor authentication?",
            "Yes — enable 2FA from Settings → Security. Scan the QR code with your authenticator app and save the recovery codes somewhere secure. Once enabled, you'll enter a six-digit code after your password. 2FA is mandatory for Organization plan accounts."),
        new("billing-cycle", "Billing", "When am I charged for my subscription?",
            "You're charged the day you subscribe and on the same day each cycle thereafter. Mid-cycle upgrades are prorated immediately and your renewal date stays the same. Annual plans pay upfront with a 20% discount versus monthly."),
        new("billing-invoice", "Billing", "How do I download invoices for my payments?",
            "Go to Settings → Billing → Invoice History. Open any invoice to view it or download a PDF. Invoices generate automatically after each successful payment with your billing details, itemized charges, and payment method."),
        new("billing-refund", "Billing", "What's your refund policy?",
            "30-day money-back guarantee on monthly and yearly subscriptions. Request a refund through Settings → Billing or by emailing support. Refunds process within 5–7 business days to your original payment method."),
        new("components-installation", "Components", "How do I install components in my project?",
            "Use the CLI: run npx shadcn@latest add button to install with dependencies. Or copy the source from your dashboard and paste into your components directory. Update import paths to match your alias and ensure Next.js 16+, React 19+, and Tailwind CSS 4+."),
        new("components-customization", "Components", "Can I modify the component source code?",
            "Yes — full unobfuscated source with no restrictions. Modify styling, logic, structure, or add features. Components are starting points for your unique needs. Updates won't overwrite changes since you control the code locally."),
        new("support-channels", "Support", "What support options are available?",
            "Individual plans get email support with 48-hour response. Team plans get priority email with 12-hour response. Organization plans add 2-hour responses for critical issues, dedicated Slack channels, and scheduled screen-share sessions."),
        new("support-response", "Support", "How quickly will I get a response?",
            "Response times depend on plan tier and ticket priority. Individual: 48 hours. Team: 12 hours. Organization: 2 hours. Targets apply during business hours Mon–Fri 9am–6pm PT. Organization plans can escalate via Slack outside hours."),
        new("integration-api", "Integration", "Do you provide an API?",
            "Yes — Team and Organization plans include REST API access. Download component code programmatically, query metadata, and integrate with your CI/CD pipeline. Generate API keys from Settings → Developers. Rate limits are 1,000/hour Team, 5,000/hour Organization."),
        new("integration-design-tools", "Integration", "Can I integrate with Figma?",
            "Yes — Figma component libraries match every UI component, available in your dashboard under Design Resources. Import the file to your workspace for design handoff. SVG exports and design tokens are also available for Sketch and Adobe XD."),
    ];

    private static readonly string[] _categories =
    [
        "Account", "Billing", "Components", "Support", "Integration"
    ];

    private FaqItem[] _filteredFaqs =>
        _selectedCategory != null
            ? _faqData.Where(f => f.Category == _selectedCategory).ToArray()
            : _faqData;
}
