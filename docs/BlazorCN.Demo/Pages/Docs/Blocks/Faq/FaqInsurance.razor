@* ============================================================
   Block: faq-insurance
   Title: FaqInsurance
   Description: A marketing-scale FAQ accordion block for React and Next.js with category tag chips, single-item expand, chevron rotation, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/faq/faq-insurance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Frequently asked questions
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Answers, sorted by topic.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Each answer is tagged with a category so you can scan straight to what you need. Still
                stuck? Our team replies within the hour.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="min-w-0 flex-1">
                            <span class="inline-block rounded-full bg-muted px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                @item.Category
                            </span>
                            <span class="mt-2 block text-base font-semibold text-foreground sm:text-lg">
                                @item.Question
                            </span>
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <p class="px-6 pb-6 text-base leading-relaxed text-muted-foreground sm:px-8 sm:pb-8">
                                @item.Answer
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Talk to an agent</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Browse policies</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "coverage-basics";

    private record FaqItem(string Id, string Category, string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("coverage-basics",
            "Coverage",
            "What does a standard policy actually cover?",
            "Coverage depends on policy type. Auto policies bundle liability (bodily injury and property damage), collision, comprehensive, and uninsured motorist protection. Home policies cover dwelling, personal property, liability, and additional living expenses. Health policies cover preventive care, hospitalization, prescription drugs, and specialist visits. Your declaration page lists exact limits, deductibles, and exclusions for your specific plan."),
        new("deductible-vs-premium",
            "Coverage",
            "What's the difference between a deductible and a premium?",
            "Your premium is what you pay every month or year to keep coverage active — typically $80 to $250 per month for most plans. Your deductible is what you pay out of pocket before insurance kicks in on a claim, usually $500 to $2,500 per incident. Higher deductibles lower your premium, and most deductibles reset annually or per claim depending on the policy."),
        new("file-claim",
            "Claims",
            "How do I file a claim and how long does it take?",
            "Report claims within 24 hours via the mobile app, online portal, or by calling our 24/7 claims line. Provide your policy number, date and time of incident, photos, and any police report. An adjuster is assigned within 48 hours. Standard claims close in 7 to 14 business days, total losses in 21 to 30 days, and complex catastrophic claims can take 30 to 90 days."),
        new("premium-increase",
            "Premiums",
            "Why did my premium increase at renewal?",
            "The most common drivers are a recent claim (even no-fault), a move to a higher-risk ZIP code, expired discounts (good student, claims-free), credit score changes, or state-wide rate adjustments approved by regulators. We send a detailed renewal notice 30 days before any change so you can review the breakdown line by line and shop alternatives if you need to."),
        new("discounts",
            "Discounts",
            "What discounts can I stack to lower my premium?",
            "Bundle home plus auto for 15 to 25 percent off. Add safe driver, good student, defensive driving, anti-theft, and low-mileage discounts on top. Most customers stack three to five discounts for a combined 20 to 40 percent reduction. Talk to your agent once a year — most missed discounts are because nobody asked, not because you don't qualify."),
        new("policy-changes",
            "Policy",
            "Can I change my policy mid-term without penalties?",
            "Yes. Add or remove coverage, change vehicles, update drivers, or adjust limits any time from your account dashboard. Most changes take effect immediately and are billed pro-rata, so increases are charged for the days remaining and decreases generate proportional refunds. Major changes like adding a teen driver may trigger a quick underwriting review but do not interrupt coverage."),
    ];
}
