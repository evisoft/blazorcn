@* ============================================================
   Block: faq-with-links
   Title: FaqWithLinks
   Description: A marketing-scale FAQ accordion with related documentation links beneath each answer for React and Next.js, built with shadcn/ui, motion/react, and Tailwind CSS
   Source: original/blocks/faq/faq-with-links.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Go deeper
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Answers, with the docs.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every answer is a starting point. Follow the related links to dive into the full
                documentation when the short version isn't enough.
            </p>
        </div>

        @* Accordion *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var it in _faqItems)
            {
                var item = it;
                var isOpen = _expanded == item.Id;
                var panelId = $"faq-panel-{item.Id}";
                var triggerId = $"faq-trigger-{item.Id}";
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        id="@triggerId"
                        aria-expanded="@isOpen.ToString().ToLower()"
                        aria-controls="@panelId"
                        @onclick="@(() => _expanded = isOpen ? null : item.Id)"
                        class="flex w-full items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-muted/40 sm:px-8 sm:py-6">
                        <span class="text-base font-semibold text-foreground sm:text-lg">
                            @item.Question
                        </span>
                        <LucideIconCn Name="chevron-down" Size="20" Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-300", isOpen ? "rotate-180" : "")" />
                    </button>

                    @if (isOpen)
                    {
                        <div id="@panelId" role="region" aria-labelledby="@triggerId" class="overflow-hidden">
                            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
                                <p class="text-base leading-relaxed text-muted-foreground">
                                    @item.Answer
                                </p>
                                <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
                                    @foreach (var lnk in item.Links)
                                    {
                                        var link = lnk;
                                        <li>
                                            <a href="@link.Href" class="inline-flex items-center gap-1 text-sm font-medium text-foreground underline underline-offset-4 transition-colors hover:text-foreground/70">
                                                @link.Label
                                                <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5" aria-hidden="true" />
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Read the docs</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Contact support</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "getting-started";

    private record FaqLink(string Label, string Href);
    private record FaqItem(string Id, string Question, string Answer, FaqLink[] Links);

    private static readonly FaqItem[] _faqItems =
    [
        new("getting-started",
            "How do I get started after signing up?",
            "Your account opens straight to the Getting Started checklist. Walk through the four steps — invite teammates, connect a data source, create your first project, and install the desktop app — and you'll be productive within 15 minutes.",
