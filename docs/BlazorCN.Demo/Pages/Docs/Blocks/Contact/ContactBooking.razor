@* ========================================
   Block: contact-booking
   Title: Contact Booking
   Description: Service booking form with provider selection, appointment type, and date preferences for service businesses
   Long Description: Service booking with provider selection and date preferences. Visual provider cards with ratings streamline appointment scheduling.
   Dependencies: AvatarCn, ButtonCn, InputCn, LabelCn, SelectCn
   Source: original/blocks/contact/contact-booking.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Book an Appointment</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Choose your provider and preferred time. We'll confirm within 2 hours.
            </p>
        </div>

        @* Provider selection cards with ratings *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Select Provider
            </LabelCn>
            <div class="grid gap-2 sm:grid-cols-2">
                @foreach (var p in _providers)
                {
                    <label class="flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors hover:border-foreground has-[:checked]:border-primary">
                        <input class="sr-only" name="provider" type="radio" value="@p.Initials" />
                        <AvatarCn Class="size-10">
                            <AvatarFallbackCn>@p.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@p.Name</span>
                                @if (p.Rating.HasValue)
                                {
                                    <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideStarCn Class="size-3 fill-current" Size="12" />
                                        @p.Rating
                                    </span>
                                }
                            </div>
                            <p class="text-xs text-muted-foreground">@p.Role</p>
                        </div>
                    </label>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="service">Service</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="service">
                        <SelectValueCn Placeholder="Select service" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="consultation">Initial Consultation (30 min) - Free</SelectItemCn>
                        <SelectItemCn Value="standard">Standard Session (60 min) - $85</SelectItemCn>
                        <SelectItemCn Value="premium">Premium Session (90 min) - $120</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="date">Preferred Date</LabelCn>
                    <InputCn id="date" Type="date" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="time">Time Preference</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="time">
                            <SelectValueCn Placeholder="Select time" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="morning">Morning (9am-12pm)</SelectItemCn>
                            <SelectItemCn Value="afternoon">Afternoon (12pm-5pm)</SelectItemCn>
                            <SelectItemCn Value="evening">Evening (5pm-8pm)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("john@example.com")" Type="email" />
            </div>

            <ButtonCn Class="w-full">Request Appointment</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                Confirmation sent within 2 hours. Free cancellation up to 24 hours before.
            </p>
        </form>
    </div>
</section>

@code {
    private record Provider(string Name, string Role, double? Rating, string Initials);

    private static readonly Provider[] _providers =
    [
        new("Sarah M.", "Senior Stylist", 4.9, "SM"),
        new("James K.", "Specialist", 4.8, "JK"),
        new("Emma L.", "Consultant", 4.7, "EL"),
        new("Any Available", "First available", null, "AA"),
    ];
}
