@* ========================================
   Block: contact-recruitment
   Title: Contact Recruitment
   Description: Recruitment agency inquiry form with hiring needs, position details, hire type selector, and budget range for staffing firms
   Long Description: Consultation booking with pricing
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-recruitment.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Staffing Inquiry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your hiring needs and we'll match you with qualified candidates.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Hire Type</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-3"
                              Value="@_hireType" ValueChanged="@((string? v) => _hireType = v ?? "full-time")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _hireType == "full-time" ? "border-primary" : "hover:border-foreground")"
                             For="hire-fulltime">
                        <RadioGroupItemCn Id="hire-fulltime" Value="full-time" />
                        <span class="text-sm font-medium">Full-Time</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _hireType == "part-time" ? "border-primary" : "hover:border-foreground")"
                             For="hire-parttime">
                        <RadioGroupItemCn Id="hire-parttime" Value="part-time" />
                        <span class="text-sm font-medium">Part-Time</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _hireType == "contract" ? "border-primary" : "hover:border-foreground")"
                             For="hire-contract">
                        <RadioGroupItemCn Id="hire-contract" Value="contract" />
                        <span class="text-sm font-medium">Contract</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _hireType == "temp-to-perm" ? "border-primary" : "hover:border-foreground")"
                             For="hire-temp">
                        <RadioGroupItemCn Id="hire-temp" Value="temp-to-perm" />
                        <span class="text-sm font-medium">Temp-to-Perm</span>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="company">Company Name</LabelCn>
                    <InputCn id="company" Placeholder="Acme Technologies" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="contact-name">Contact Name</LabelCn>
                    <InputCn id="contact-name" Placeholder="Rachel Torres" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="email">Work Email</LabelCn>
                    <InputCn id="email" Placeholder="@("rachel@acmetech.com")" Type="email" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="role-title">Role Title</LabelCn>
                    <InputCn id="role-title" Placeholder="Senior Frontend Engineer" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="department">Department</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="department">
                            <SelectValueCn Placeholder="Select department" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="engineering">Engineering</SelectItemCn>
                            <SelectItemCn Value="product">Product</SelectItemCn>
                            <SelectItemCn Value="design">Design</SelectItemCn>
                            <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                            <SelectItemCn Value="sales">Sales</SelectItemCn>
                            <SelectItemCn Value="operations">Operations</SelectItemCn>
                            <SelectItemCn Value="finance">Finance</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="headcount">Positions to Fill</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="headcount">
                            <SelectValueCn Placeholder="How many?" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1">1 position</SelectItemCn>
                            <SelectItemCn Value="2-3">2 - 3 positions</SelectItemCn>
                            <SelectItemCn Value="4-10">4 - 10 positions</SelectItemCn>
                            <SelectItemCn Value="10-plus">10+ positions</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="urgency">Hiring Timeline</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="urgency">
                            <SelectValueCn Placeholder="When do you need them?" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="asap">Immediately</SelectItemCn>
                            <SelectItemCn Value="2-weeks">Within 2 weeks</SelectItemCn>
                            <SelectItemCn Value="1-month">Within 1 month</SelectItemCn>
                            <SelectItemCn Value="flexible">Flexible</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="details">Role Details &amp; Requirements</LabelCn>
                <TextareaCn id="details"
                            Placeholder="Key skills, experience level, remote/hybrid/onsite, salary range..."
                            rows="3" />
            </div>

            <ButtonCn Class="w-full">Submit Hiring Request</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                A recruitment specialist will contact you within one business day.
            </p>
        </form>
    </div>
</section>

@code {
    private string _hireType = "full-time";
}
