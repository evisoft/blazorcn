@* ============================================================
   Block: contact-reservation
   Title: ContactReservation
   Description: Restaurant reservation form with party size, date selection, and special occasion options for hospitality
   Source: original/blocks/contact/contact-reservation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Make a Reservation</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Reserve your table and we'll have everything ready for you.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="date">Date</LabelCn>
                    <InputCn id="date" Type="date" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="party-size">Party Size</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="party-size">
                            <SelectValueCn Placeholder="Guests" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1">1 guest</SelectItemCn>
                            <SelectItemCn Value="2">2 guests</SelectItemCn>
                            <SelectItemCn Value="3">3 guests</SelectItemCn>
                            <SelectItemCn Value="4">4 guests</SelectItemCn>
                            <SelectItemCn Value="5">5 guests</SelectItemCn>
                            <SelectItemCn Value="6">6 guests</SelectItemCn>
                            <SelectItemCn Value="7+">7+ guests</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <LabelCn>Preferred Time</LabelCn>
                </div>
                <div class="grid grid-cols-3 gap-2">
                    <label class="relative flex cursor-pointer items-center justify-center rounded-md border p-2 text-sm transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                        <input class="sr-only" name="time" type="radio" value="18:00" />
                        6:00 PM
                    </label>
                    <label class="relative flex cursor-pointer items-center justify-center rounded-md border p-2 text-sm transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                        <input class="sr-only" name="time" type="radio" value="18:30" />
                        6:30 PM
                    </label>
                    <label class="relative flex cursor-pointer items-center justify-center rounded-md border p-2 text-sm transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                        <input class="sr-only" name="time" type="radio" value="19:00" />
                        7:00 PM
                        <span class="absolute -top-2 -right-2">
                            <BadgeCn Class="text-[10px] px-1" Variant="BadgeVariant.Secondary">Popular</BadgeCn>
                        </span>
                    </label>
                    <label class="relative flex cursor-pointer items-center justify-center rounded-md border p-2 text-sm transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                        <input class="sr-only" name="time" type="radio" value="19:30" />
                        7:30 PM
                    </label>
                    <label class="relative flex cursor-pointer items-center justify-center rounded-md border p-2 text-sm transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                        <input class="sr-only" name="time" type="radio" value="20:00" />
                        8:00 PM
                    </label>
                    <label class="relative flex cursor-pointer items-center justify-center rounded-md border p-2 text-sm transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                        <input class="sr-only" name="time" type="radio" value="20:30" />
                        8:30 PM
                    </label>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="Maria Garcia" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("maria@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="requests">Special Requests or Dietary Needs</LabelCn>
                <TextareaCn id="requests" Placeholder="Allergies, highchair, accessibility requirements..." Rows="2" />
            </div>

            <ButtonCn Class="w-full">Complete Reservation</ButtonCn>
        </form>
    </div>
</section>
