@* ========================================
   Block: contact-faq
   Title: Contact Faq
   Description: Contact form with integrated FAQ accordion helping users find answers before reaching out
   Long Description: FAQ with contact fallback. Unique: collapsible FAQ section above contact form.
   Dependencies: AccordionCn, ButtonCn, InputCn, LabelCn, TextareaCn
   Source: original/blocks/contact/contact-faq.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl space-y-6 p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Frequently Asked Questions</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Find answers to common questions below.
          </p>
        </div>

        <div class="p-6">
          <AccordionCn Class="w-full" collapsible type="single">
            <AccordionItemCn>
              <AccordionTriggerCn Class="text-left text-sm">
                How do I get started?
              </AccordionTriggerCn>
              <AccordionContentCn Class="text-xs text-muted-foreground">
                Sign up for an account, complete your profile, and you can begin using our services
                immediately. We also offer a guided onboarding tour.
              </AccordionContentCn>
            </AccordionItemCn>
            <AccordionItemCn>
              <AccordionTriggerCn Class="text-left text-sm">
                What payment methods do you accept?
              </AccordionTriggerCn>
              <AccordionContentCn Class="text-xs text-muted-foreground">
                We accept all major credit cards, PayPal, and bank transfers for enterprise
                accounts. All payments are processed securely.
              </AccordionContentCn>
            </AccordionItemCn>
            <AccordionItemCn>
              <AccordionTriggerCn Class="text-left text-sm">
                Can I cancel my subscription anytime?
              </AccordionTriggerCn>
              <AccordionContentCn Class="text-xs text-muted-foreground">
                Yes, you can cancel anytime from your account settings. You'll continue to have
                access until the end of your current billing period. No cancellation fees.
              </AccordionContentCn>
            </AccordionItemCn>
          </AccordionCn>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Still need help?</h2>
          <p class="mt-1 text-xs text-muted-foreground">Send us a message and we'll respond.</p>
        </div>

        <form class="space-y-4 p-6">
          <div class="space-y-2">
            <LabelCn for="faq-name">Name</LabelCn>
            <InputCn id="faq-name" Placeholder="John Doe" />
          </div>

          <div class="space-y-2">
            <LabelCn for="faq-email">Email</LabelCn>
            <InputCn id="faq-email" Placeholder="@("john@@example.com")" type="email" />
          </div>

          <div class="space-y-2">
            <LabelCn for="faq-message">Message</LabelCn>
            <TextareaCn id="faq-message" Placeholder="Describe your question or issue..." Rows="4" />
          </div>

          <ButtonCn Class="w-full gap-2">
            <LucideSendCn Size="16" Class="h-4 w-4" />
            Send Message
          </ButtonCn>
        </form>
      </div>
    </section>

