@* ========================================
   Block: contact-scholarship
   Title: Contact Scholarship
   Description: Scholarship application form with academic information, essay prompt, and eligibility criteria for educational institutions
   Long Description: Course enrollment with payments
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-scholarship.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Scholarship Application</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Apply for the 2026 Excellence in Leadership Scholarship. Deadline: May 15, 2026.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="rounded-lg border p-4">
            <div class="grid grid-cols-3 gap-4 text-center">
              <div>
                <p class="text-2xl font-semibold tabular-nums">12</p>
                <p class="text-xs text-muted-foreground">Awards</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">$5K</p>
                <p class="text-xs text-muted-foreground">Per Award</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">340+</p>
                <p class="text-xs text-muted-foreground">Past Recipients</p>
              </div>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="scholarship-first-name">First Name</LabelCn>
              <InputCn id="scholarship-first-name" Placeholder="Priya" />
            </div>
            <div class="space-y-2">
              <LabelCn for="scholarship-last-name">Last Name</LabelCn>
              <InputCn id="scholarship-last-name" Placeholder="Sharma" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="scholarship-email">Email</LabelCn>
            <InputCn id="scholarship-email" Placeholder="@("priya@@university.edu")" type="email" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="gpa">Current GPA</LabelCn>
              <InputCn id="gpa" Placeholder="3.85" />
            </div>
            <div class="space-y-2">
              <LabelCn for="scholarship-year">Academic Year</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="scholarship-year">
                  <SelectValueCn Placeholder="Select year" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="freshman">Freshman</SelectItemCn>
                  <SelectItemCn Value="sophomore">Sophomore</SelectItemCn>
                  <SelectItemCn Value="junior">Junior</SelectItemCn>
                  <SelectItemCn Value="senior">Senior</SelectItemCn>
                  <SelectItemCn Value="graduate">Graduate</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="scholarship-major">Field of Study</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="scholarship-major">
                <SelectValueCn Placeholder="Select your major" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="engineering">Engineering</SelectItemCn>
                <SelectItemCn Value="cs">Computer Science</SelectItemCn>
                <SelectItemCn Value="business">Business Administration</SelectItemCn>
                <SelectItemCn Value="sciences">Natural Sciences</SelectItemCn>
                <SelectItemCn Value="humanities">Humanities</SelectItemCn>
                <SelectItemCn Value="arts">Fine Arts</SelectItemCn>
                <SelectItemCn Value="other">Other</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="essay">Personal Statement</LabelCn>
            <p class="text-xs text-muted-foreground">
              Describe a leadership experience that shaped your academic journey (250-500 words).
            </p>
            <TextareaCn id="essay" Placeholder="Write your personal statement here..." Rows="5" />
          </div>

          <ButtonCn Class="w-full">Submit Application</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            Recipients will be notified by email within 6 weeks of the deadline.
          </p>
        </form>
      </div>
    </section>

@code {
}
