@* ========================================
   Block: contact-volunteer
   Title: Contact Volunteer
   Description: Volunteer application form with skills, availability, and interest areas for nonprofit organizations
   Long Description: Mobilize passionate volunteers for your cause. This React volunteer application component captures supporter information with availability scheduling and cause interest selection.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-volunteer.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Become a Volunteer</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Join our community of dedicated volunteers making a difference.
            </p>
        </div>

        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Areas of Interest
            </LabelCn>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var area in _interestAreas)
                {
                    <div class="flex items-center gap-2">
                        <CheckboxCn id="@area.Id" />
                        <LabelCn Class="text-sm font-normal" For="@area.Id">
                            @area.Label
                        </LabelCn>
                    </div>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="commitment">Commitment Level</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="commitment">
                        <SelectValueCn Placeholder="How often can you volunteer?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="weekly">Weekly (recurring)</SelectItemCn>
                        <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                        <SelectItemCn Value="events">Special Events Only</SelectItemCn>
                        <SelectItemCn Value="flexible">Flexible / On-Call</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="motivation">Why do you want to volunteer?</LabelCn>
                <TextareaCn id="motivation"
                            Placeholder="Tell us about your interest and what you hope to contribute..."
                            rows="2" />
            </div>

            <div class="border-b"></div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="Sarah Johnson" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("sarah@example.com")" Type="email" />
                </div>
            </div>

            <div class="flex items-center gap-3 rounded-lg border p-3">
                <LucideHeartCn Class="size-5 text-muted-foreground" Size="20" />
                <p class="text-sm text-muted-foreground">
                    Join 500+ volunteers who donated 10,000+ hours last year
                </p>
            </div>

            <ButtonCn Class="w-full">Submit Application</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll contact you within 3-5 days about next steps.
            </p>
        </form>
    </div>
</section>

@code {
    private record InterestArea(string Id, string Label);

    private static readonly InterestArea[] _interestAreas =
    [
        new("event-support", "Event Support"),
        new("administrative", "Administrative"),
        new("community-outreach", "Community Outreach"),
        new("mentoring", "Mentoring"),
        new("fundraising", "Fundraising"),
        new("marketing", "Marketing"),
    ];
}
