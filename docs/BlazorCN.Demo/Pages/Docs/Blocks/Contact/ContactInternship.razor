@* ========================================
   Block: contact-internship
   Title: Contact Internship
   Description: Internship application form with major, availability, duration selector, and skills for university programs and companies
   Long Description: Job application with resume upload
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-internship.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Internship Application</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Apply for our internship program and gain hands-on experience.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">Preferred Duration</LabelCn>
            <RadioGroupCn Class="grid grid-cols-2 gap-2 sm:grid-cols-4"
                          Value="@_duration" ValueChanged="@((string? v) => _duration = v ?? "summer")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _duration == "summer" ? "border-primary" : "hover:border-foreground")"
                         For="dur-summer">
                    <RadioGroupItemCn Class="sr-only" Id="dur-summer" Value="summer" />
                    <span class="text-xs font-medium">Summer</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">10-12 weeks</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _duration == "fall" ? "border-primary" : "hover:border-foreground")"
                         For="dur-fall">
                    <RadioGroupItemCn Class="sr-only" Id="dur-fall" Value="fall" />
                    <span class="text-xs font-medium">Fall</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">14-16 weeks</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _duration == "spring" ? "border-primary" : "hover:border-foreground")"
                         For="dur-spring">
                    <RadioGroupItemCn Class="sr-only" Id="dur-spring" Value="spring" />
                    <span class="text-xs font-medium">Spring</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">14-16 weeks</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _duration == "year-round" ? "border-primary" : "hover:border-foreground")"
                         For="dur-year">
                    <RadioGroupItemCn Class="sr-only" Id="dur-year" Value="year-round" />
                    <span class="text-xs font-medium">Year-Round</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">Ongoing</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="internship-name">Full Name</LabelCn>
                    <InputCn id="internship-name" Placeholder="Jordan Lee" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="internship-email">Email</LabelCn>
                    <InputCn id="internship-email" Placeholder="@("jordan@university.edu")" Type="email" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="university">University</LabelCn>
                    <InputCn id="university" Placeholder="Stanford University" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="internship-major">Major</LabelCn>
                    <InputCn id="internship-major" Placeholder="Computer Science" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="graduation">Expected Graduation</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="graduation">
                        <SelectValueCn Placeholder="Select year" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="2026">2026</SelectItemCn>
                        <SelectItemCn Value="2027">2027</SelectItemCn>
                        <SelectItemCn Value="2028">2028</SelectItemCn>
                        <SelectItemCn Value="2029">2029</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="skills">Relevant Skills</LabelCn>
                <TextareaCn id="skills"
                            Placeholder="React, TypeScript, Python, data analysis..."
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Submit Application</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Applications are reviewed on a rolling basis. We'll respond within 2 weeks.
            </p>
        </form>
    </div>
</section>

@code {
    private string _duration = "summer";
}
