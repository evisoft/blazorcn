@* ========================================
   Block: contact-pet
   Title: Contact Pet
   Description: Pet service booking form with pet details, service selection, and special care instructions for pet businesses
   Long Description: Pet service booking with pet type selector and health information. Perfect for groomers, boarding facilities, and veterinary clinics.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-pet.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Book Pet Care</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Tell us about your pet and we'll take great care of them.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="pet-name">Pet's Name</LabelCn>
              <InputCn id="pet-name" Placeholder="Buddy" />
            </div>
            <div class="space-y-2">
              <LabelCn for="pet-type">Pet Type</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="pet-type">
                  <SelectValueCn Placeholder="Select type" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="dog">Dog</SelectItemCn>
                  <SelectItemCn Value="cat">Cat</SelectItemCn>
                  <SelectItemCn Value="bird">Bird</SelectItemCn>
                  <SelectItemCn Value="rabbit">Rabbit</SelectItemCn>
                  <SelectItemCn Value="other">Other</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="breed">Breed</LabelCn>
              <InputCn id="breed" Placeholder="Golden Retriever" />
            </div>
            <div class="space-y-2">
              <LabelCn for="age">Age</LabelCn>
              <InputCn id="age" Placeholder="3 years" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="pet-service">Service Needed</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="pet-service">
                <SelectValueCn Placeholder="What do you need?" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="grooming">Grooming</SelectItemCn>
                <SelectItemCn Value="boarding">Boarding</SelectItemCn>
                <SelectItemCn Value="daycare">Daycare</SelectItemCn>
                <SelectItemCn Value="walking">Walking</SelectItemCn>
                <SelectItemCn Value="training">Training</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="pet-date">Preferred Date</LabelCn>
              <InputCn id="pet-date" type="date" />
            </div>
            <div class="space-y-2">
              <LabelCn for="pet-time">Preferred Time</LabelCn>
              <InputCn id="pet-time" type="time" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="health">Health Notes</LabelCn>
            <TextareaCn
              id="health"
              Placeholder="Allergies, medications, behavioral notes, or special care instructions..."
              Rows="2"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="owner-name">Your Name</LabelCn>
              <InputCn id="owner-name" Placeholder="Sarah Johnson" />
            </div>
            <div class="space-y-2">
              <LabelCn for="pet-phone">Phone</LabelCn>
              <InputCn id="pet-phone" Placeholder="+1 (555) 000-0000" type="tel" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="pet-email">Email</LabelCn>
            <InputCn id="pet-email" Placeholder="@("sarah@@example.com")" type="email" />
          </div>

          <ButtonCn Class="w-full">
            <LucidePawPrintCn Size="16" Class="mr-2 h-4 w-4" />
            Book Appointment
          </ButtonCn>

          <p class="text-center text-xs text-muted-foreground">We'll confirm within 2 hours.</p>
        </form>
      </div>
    </section>

@code {
}
