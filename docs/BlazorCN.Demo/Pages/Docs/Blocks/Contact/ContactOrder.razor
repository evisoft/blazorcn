@* ========================================
   Block: contact-order
   Title: Contact Order
   Description: Custom order request form with product specifications, quantity, and delivery preferences for e-commerce
   Long Description: Custom order form with order number lookup and issue type selector. Perfect for print shops, custom merchandise, and made-to-order businesses.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-order.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Order Inquiry</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Questions about your order? We're here to help.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="space-y-2">
            <LabelCn Class="flex items-center gap-2" for="order-number">
              <LucideSearchCn Size="16" Class="h-4 w-4 text-muted-foreground" />
              Order Number
            </LabelCn>
            <InputCn id="order-number" Placeholder="ORD-123456" />
            <p class="text-xs text-muted-foreground">
              Find this in your order confirmation email
            </p>
          </div>

          <div class="space-y-2">
            <LabelCn for="issue-type">What can we help with?</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="issue-type">
                <SelectValueCn Placeholder="Select issue type" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="status">Check Order Status</SelectItemCn>
                <SelectItemCn Value="change">Change or Cancel Order</SelectItemCn>
                <SelectItemCn Value="missing">Missing or Damaged Item</SelectItemCn>
                <SelectItemCn Value="return">Return or Exchange</SelectItemCn>
                <SelectItemCn Value="other">Other Question</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="details">Details</LabelCn>
            <TextareaCn
              id="details"
              Placeholder="Tell us more about your question or concern..."
              Rows="4"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="name">Your Name</LabelCn>
              <InputCn id="name" Placeholder="Alex Morgan" />
            </div>
            <div class="space-y-2">
              <LabelCn for="email">Email</LabelCn>
              <InputCn id="email" Placeholder="@("alex@@example.com")" type="email" />
            </div>
          </div>

          <ButtonCn Class="w-full">
            <LucidePackageCn Size="16" Class="mr-2 h-4 w-4" />
            Submit Inquiry
          </ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            We typically respond within 2 hours.
          </p>
        </form>
      </div>
    </section>

@code {
}
