@* ============================================================
   Block: contact-subscription
   Title: ContactSubscription
   Description: Subscription management form with current plan details, upgrade comparison, billing inquiries, and account changes for SaaS products
   Source: original/blocks/contact/contact-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Subscription Inquiry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Manage your plan, request changes, or ask about billing.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="rounded-lg border p-4">
                <div class="flex items-center gap-4">
                    <div class="flex-1 space-y-1">
                        <p class="text-xs text-muted-foreground">Current Plan</p>
                        <p class="text-sm font-medium">Starter</p>
                        <p class="text-xs text-muted-foreground">5 users &middot; 10 GB storage</p>
                    </div>
                    <LucideArrowRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="flex-1 space-y-1 rounded-md bg-muted/50 p-3">
                        <p class="text-xs text-muted-foreground">Recommended Upgrade</p>
                        <p class="text-sm font-medium">Pro — $49/mo</p>
                        <div class="mt-1 space-y-0.5">
                            <div class="flex items-center gap-1.5">
                                <LucideCheckCn Size="12" Class="size-3 text-emerald-500" />
                                <span class="text-xs text-muted-foreground">25 users</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <LucideCheckCn Size="12" Class="size-3 text-emerald-500" />
                                <span class="text-xs text-muted-foreground">100 GB storage</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <LucideCheckCn Size="12" Class="size-3 text-emerald-500" />
                                <span class="text-xs text-muted-foreground">Priority support</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Account Holder</LabelCn>
                    <InputCn id="name" Placeholder="Jordan Lee" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Account Email</LabelCn>
                    <InputCn id="email" Placeholder="@("jordan@company.com")" type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="inquiry-type">Inquiry Type</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="inquiry-type">
                        <SelectValueCn Placeholder="What do you need help with?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="upgrade">Upgrade my plan</SelectItemCn>
                        <SelectItemCn Value="downgrade">Downgrade my plan</SelectItemCn>
                        <SelectItemCn Value="billing">Billing question</SelectItemCn>
                        <SelectItemCn Value="invoice">Request an invoice</SelectItemCn>
                        <SelectItemCn Value="seats">Add or remove seats</SelectItemCn>
                        <SelectItemCn Value="enterprise">Enterprise pricing</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="account-id">Account ID</LabelCn>
                    <InputCn id="account-id" Placeholder="ACT-000000" Class="font-mono" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="billing-cycle">Preferred Billing</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="billing-cycle">
                            <SelectValueCn Placeholder="Select cycle" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                            <SelectItemCn Value="annual">Annual (save 20%)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="details">Additional Details</LabelCn>
                <TextareaCn id="details" Placeholder="Describe your request or question..." rows="2" />
            </div>

            <ButtonCn Class="w-full">Submit Inquiry</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Our billing team responds within 1 business day.
            </p>
        </form>
    </div>
</section>
