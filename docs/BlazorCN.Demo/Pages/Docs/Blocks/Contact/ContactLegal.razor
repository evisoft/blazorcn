@* ========================================
   Block: contact-legal
   Title: Contact Legal
   Description: Legal consultation request form with practice area selection, case urgency, and confidential intake for law firms and attorneys
   Long Description: Legal consultation form with practice area selection and urgency level indicator.
   Dependencies: AlertCn, ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-legal.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request Legal Consultation</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Free initial consultation. All information treated as confidential.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="mb-4">
                <LabelCn>Case Urgency</LabelCn>
            </div>
            <div class="space-y-2">
                @foreach (var level in _urgencyLevels)
                {
                    <label class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors", _urgency == level.Value ? "border-primary" : "hover:border-foreground")">
                        <div class="flex items-center gap-3">
                            <input checked="@(_urgency == level.Value)"
                                   class="h-4 w-4 accent-primary"
                                   name="urgency"
                                   @onchange="@(() => _urgency = level.Value)"
                                   type="radio"
                                   value="@level.Value" />
                            <div>
                                <span class="text-sm font-medium">@level.Label</span>
                                <p class="text-xs text-muted-foreground">@level.Desc</p>
                            </div>
                        </div>
                    </label>
                }
            </div>

            @if (_urgency == "emergency")
            {
                <AlertCn Class="mt-4" Variant="AlertVariant.Destructive">
                    <LucideTriangleAlertCn Class="h-4 w-4" Size="16" />
                    <AlertDescriptionCn>
                        For emergencies, call our 24/7 hotline:
                        <span class="font-medium">(555) 911-HELP</span>
                    </AlertDescriptionCn>
                </AlertCn>
            }
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="practice-area">Practice Area</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="practice-area">
                        <SelectValueCn Placeholder="Select legal matter type" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="family">Family Law</SelectItemCn>
                        <SelectItemCn Value="injury">Personal Injury</SelectItemCn>
                        <SelectItemCn Value="criminal">Criminal Defense</SelectItemCn>
                        <SelectItemCn Value="business">Business Law</SelectItemCn>
                        <SelectItemCn Value="estate">Estate Planning</SelectItemCn>
                        <SelectItemCn Value="immigration">Immigration</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="legal-description">Brief Description</LabelCn>
                <TextareaCn id="legal-description"
                            Placeholder="Describe your situation briefly. Include key dates and parties involved..."
                            rows="4" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="legal-name">Full Name</LabelCn>
                    <InputCn id="legal-name" Placeholder="Robert Johnson" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="legal-phone">Phone</LabelCn>
                    <InputCn id="legal-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="legal-email">Email</LabelCn>
                <InputCn id="legal-email" Placeholder="@("robert@example.com")" Type="email" />
            </div>

            <ButtonCn Class="w-full">
                <LucideScaleCn Class="mr-2 h-4 w-4" Size="16" />
                Request Free Consultation
            </ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Response within @ResponseTime
            </p>
        </form>
    </div>
</section>

@code {
    private record UrgencyLevel(string Value, string Label, string Desc);

    private string _urgency = "standard";

    private static readonly UrgencyLevel[] _urgencyLevels =
    [
        new("emergency", "Emergency", "Immediate threat, arrest, restraining order"),
        new("urgent", "Urgent", "Deadline within 1\u20132 weeks"),
        new("standard", "Standard", "No immediate deadline"),
    ];

    private string ResponseTime => _urgency switch
    {
        "emergency" => "1 hour",
        "urgent" => "24 hours",
        _ => "2 business days"
    };
}
