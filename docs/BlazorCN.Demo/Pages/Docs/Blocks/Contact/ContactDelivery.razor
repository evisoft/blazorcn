@* ========================================
   Block: contact-delivery
   Title: Contact Delivery
   Description: Delivery service booking form with package dimensions, weight, pickup and dropoff addresses, and package size radio card selector
   Long Description: Delivery booking form with visual package size selector using radio cards for Small, Medium, Large, and Freight. Ideal for courier services, logistics companies, and same-day delivery platforms.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-delivery.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Book a Delivery</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Enter your package details and we'll pick it up today.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="mb-3 flex items-center gap-2">
                <LucidePackageCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <span class="text-sm font-medium">Package Size</span>
            </div>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                @foreach (var s in _sizes)
                {
                    <button type="button"
                            @onclick="@(() => _size = s.Value)"
                            class="@Cn.Merge("rounded-md border px-3 py-3 text-left transition-colors", _size == s.Value ? "border-foreground bg-muted/50" : "hover:bg-muted/50")">
                        <span class="text-sm font-medium">@s.Label</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@s.Desc</p>
                    </button>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="pickup">Pickup Address</LabelCn>
                    <InputCn id="pickup" Placeholder="123 Main St, Suite 4" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="dropoff">Dropoff Address</LabelCn>
                    <InputCn id="dropoff" Placeholder="456 Oak Ave, Unit B" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="pickup-date">Pickup Date</LabelCn>
                    <InputCn id="pickup-date" Type="date" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="time-window">Time Window</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="time-window">
                            <SelectValueCn Placeholder="Select window" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="morning">Morning (8am–12pm)</SelectItemCn>
                            <SelectItemCn Value="afternoon">Afternoon (12pm–5pm)</SelectItemCn>
                            <SelectItemCn Value="evening">Evening (5pm–9pm)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="contents">Package Contents</LabelCn>
                <TextareaCn id="contents"
                            Placeholder="Briefly describe what's being shipped..."
                            rows="2" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Your Name</LabelCn>
                    <InputCn id="name" Placeholder="Sarah Kim" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <ButtonCn Class="w-full">Schedule Pickup</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Free pickup for packages over 30 lbs. Cancel anytime before dispatch.
            </p>
        </form>
    </div>
</section>

@code {
    private record SizeOption(string Value, string Label, string Desc);

    private string _size = "medium";

    private static readonly SizeOption[] _sizes =
    [
        new("small", "Small", "Up to 5 lbs"),
        new("medium", "Medium", "Up to 30 lbs"),
        new("large", "Large", "Up to 70 lbs"),
        new("freight", "Freight", "70+ lbs"),
    ];
}
