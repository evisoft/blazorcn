@* ========================================
   Block: contact-minimal
   Title: Contact Minimal
   Description: Minimal contact form with essential fields in a clean, centered layout with subtle styling and focused design
   Long Description: The cleanest contact form possible with just name, email, and message.
   Dependencies: ButtonCn, InputCn, LabelCn, TextareaCn
   Source: original/blocks/contact/contact-minimal.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Get in Touch</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Send us a message and we'll respond within 24 hours.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="space-y-2">
            <LabelCn for="name">Name</LabelCn>
            <InputCn id="name" Placeholder="Your name" />
          </div>

          <div class="space-y-2">
            <LabelCn for="email">Email</LabelCn>
            <InputCn id="email" Placeholder="@("your@@email.com")" type="email" />
          </div>

          <div class="space-y-2">
            <LabelCn for="message">Message</LabelCn>
            <TextareaCn id="message" Placeholder="How can we help?" Rows="4" />
          </div>

          <ButtonCn Class="w-full">Send Message</ButtonCn>
        </form>
      </div>
    </section>

@code {
}
