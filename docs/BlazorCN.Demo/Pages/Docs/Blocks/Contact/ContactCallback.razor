@* ========================================
   Block: contact-callback
   Title: Contact Callback
   Description: Contact form with callback request scheduler allowing users to select preferred date and time for phone consultation
   Long Description: Callback scheduling with visual time slot picker and timezone support. Grid layout makes selecting preferred call times quick and intuitive.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn
   Source: original/blocks/contact/contact-callback.tsx
   ======================================== *@

<section class="mx-auto max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request a Callback</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Schedule a time that works for you and we'll call you to discuss your needs.
            </p>
        </div>

        @* Time slot picker grid *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Preferred Time Slot
            </LabelCn>
            <div class="grid grid-cols-4 gap-2">
                @foreach (var slot in _timeSlots)
                {
                    <label class="cursor-pointer rounded-lg border px-3 py-2 text-center text-xs transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                        <input class="sr-only" name="time" type="radio" value="@slot" />
                        @slot
                    </label>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone Number</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("john@example.com")" Type="email" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="date">Preferred Date</LabelCn>
                    <InputCn id="date" Type="date" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="timezone">Timezone</LabelCn>
                    <SelectCn Value="est">
                        <SelectTriggerCn id="timezone">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="est">Eastern (EST)</SelectItemCn>
                            <SelectItemCn Value="cst">Central (CST)</SelectItemCn>
                            <SelectItemCn Value="mst">Mountain (MST)</SelectItemCn>
                            <SelectItemCn Value="pst">Pacific (PST)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="topic">Topic</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="topic">
                        <SelectValueCn Placeholder="What would you like to discuss?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="demo">Product Demo</SelectItemCn>
                        <SelectItemCn Value="sales">Sales Inquiry</SelectItemCn>
                        <SelectItemCn Value="support">Technical Support</SelectItemCn>
                        <SelectItemCn Value="partnership">Partnership</SelectItemCn>
                        <SelectItemCn Value="general">General Question</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <ButtonCn Class="w-full">Schedule Callback</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                We'll call you at the scheduled time. Confirmation sent via email.
            </p>
        </form>
    </div>
</section>

@code {
    private static readonly string[] _timeSlots =
    [
        "9:00 AM", "10:00 AM", "11:00 AM", "12:00 PM",
        "1:00 PM", "2:00 PM", "3:00 PM", "4:00 PM",
    ];
}
