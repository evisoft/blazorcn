@* ============================================================
   Block: contact-vendor
   Title: ContactVendor
   Description: Vendor application form with business credentials, certifications, and service capabilities for procurement
   Source: original/blocks/contact/contact-vendor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-6 py-5">
      <h2 class="text-sm font-medium">Become a Vendor</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        Join our network of qualified suppliers and service providers.
      </p>
    </div>

    <form class="space-y-4 p-6">
      <div class="space-y-2">
        <LabelCn for="business-name">Legal Business Name</LabelCn>
        <InputCn id="business-name" Placeholder="Acme Supplies LLC" />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="tax-id">Tax ID / EIN</LabelCn>
          <InputCn id="tax-id" Placeholder="XX-XXXXXXX" />
        </div>
        <div class="space-y-2">
          <LabelCn for="business-type">Business Type</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="business-type">
              <SelectValueCn Placeholder="Select type" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="corporation">Corporation</SelectItemCn>
              <SelectItemCn Value="llc">LLC</SelectItemCn>
              <SelectItemCn Value="partnership">Partnership</SelectItemCn>
              <SelectItemCn Value="sole-prop">Sole Proprietorship</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="category">Primary Service Category</LabelCn>
        <SelectCn>
          <SelectTriggerCn id="category">
            <SelectValueCn Placeholder="What do you provide?" />
          </SelectTriggerCn>
          <SelectContentCn>
            <SelectItemCn Value="supplies">Office Supplies</SelectItemCn>
            <SelectItemCn Value="technology">Technology &amp; IT</SelectItemCn>
            <SelectItemCn Value="professional">Professional Services</SelectItemCn>
            <SelectItemCn Value="facilities">Facilities &amp; Maintenance</SelectItemCn>
            <SelectItemCn Value="marketing">Marketing &amp; Creative</SelectItemCn>
            <SelectItemCn Value="logistics">Logistics &amp; Shipping</SelectItemCn>
          </SelectContentCn>
        </SelectCn>
      </div>

      <div class="space-y-3">
        <LabelCn>Diversity Certifications (Optional)</LabelCn>
        <div class="grid grid-cols-2 gap-2">
          <div class="flex items-center gap-2">
            <CheckboxCn id="mbe" />
            <LabelCn Class="text-sm font-normal" for="mbe">
              Minority-Owned (MBE)
            </LabelCn>
          </div>
          <div class="flex items-center gap-2">
            <CheckboxCn id="wbe" />
            <LabelCn Class="text-sm font-normal" for="wbe">
              Women-Owned (WBE)
            </LabelCn>
          </div>
          <div class="flex items-center gap-2">
            <CheckboxCn id="veteran" />
            <LabelCn Class="text-sm font-normal" for="veteran">
              Veteran-Owned
            </LabelCn>
          </div>
          <div class="flex items-center gap-2">
            <CheckboxCn id="small" />
            <LabelCn Class="text-sm font-normal" for="small">
              Small Business
            </LabelCn>
          </div>
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="capabilities">Describe Your Products/Services</LabelCn>
        <TextareaCn
          id="capabilities"
          Placeholder="Tell us about your capabilities, capacity, and what makes you a great partner..."
          Rows="3"
        />
      </div>

      <div class="border-b"></div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="contact-name">Contact Name</LabelCn>
          <InputCn id="contact-name" Placeholder="John Smith" />
        </div>
        <div class="space-y-2">
          <LabelCn for="contact-title">Title</LabelCn>
          <InputCn id="contact-title" Placeholder="Sales Manager" />
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="email">Business Email</LabelCn>
        <InputCn id="email" Placeholder="@("john@acmesupplies.com")" type="email" />
      </div>

      <div class="space-y-2">
        <LabelCn for="phone">Phone Number</LabelCn>
        <InputCn id="phone" Placeholder="+1 (555) 000-0000" type="tel" />
      </div>

      <div class="flex items-center gap-3 rounded-lg border p-3">
        <LucideIconCn Name="truck" Size="20" Class="size-5 text-muted-foreground" />
        <p class="text-sm text-muted-foreground">
          Approved vendors gain access to our procurement portal
        </p>
      </div>

      <ButtonCn Class="w-full">Submit Application</ButtonCn>

      <p class="text-center text-xs text-muted-foreground">
        Applications are reviewed within 5-7 business days.
      </p>
    </form>
  </div>
</section>

