@* ========================================
   Block: contact-travel
   Title: Contact Travel
   Description: Travel planning request form with destination selection, trip type radio cards, travel dates, and group size for tour operators
   Long Description: Restaurant reservation with time slots
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-travel.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Plan Your Trip</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Tell us about your ideal getaway and we'll craft a personalized itinerary.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="destination">Destination</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="destination">
                  <SelectValueCn Placeholder="Where to?" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="europe">Europe</SelectItemCn>
                  <SelectItemCn Value="asia">Asia & Pacific</SelectItemCn>
                  <SelectItemCn Value="americas">Americas</SelectItemCn>
                  <SelectItemCn Value="africa">Africa</SelectItemCn>
                  <SelectItemCn Value="middle-east">Middle East</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="travelers">Travelers</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="travelers">
                  <SelectValueCn Placeholder="Group size" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="1">1 traveler</SelectItemCn>
                  <SelectItemCn Value="2">2 travelers</SelectItemCn>
                  <SelectItemCn Value="3-4">3–4 travelers</SelectItemCn>
                  <SelectItemCn Value="5-8">5–8 travelers</SelectItemCn>
                  <SelectItemCn Value="9+">9+ travelers</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-3">
            <LabelCn>Trip Type</LabelCn>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              <label class="flex cursor-pointer flex-col items-center gap-1.5 rounded-md border p-3 text-center transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                <input class="sr-only" name="trip-type" type="radio" value="adventure" />
                <LucideMountainCn Size="16" Class="size-4" />
                <span class="text-xs font-medium">Adventure</span>
              </label>
              <label class="flex cursor-pointer flex-col items-center gap-1.5 rounded-md border p-3 text-center transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                <input class="sr-only" name="trip-type" type="radio" value="relaxation" />
                <LucidePalmtreeCn Size="16" Class="size-4" />
                <span class="text-xs font-medium">Relaxation</span>
              </label>
              <label class="flex cursor-pointer flex-col items-center gap-1.5 rounded-md border p-3 text-center transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                <input class="sr-only" name="trip-type" type="radio" value="cultural" />
                <LucideBuilding2Cn Size="16" Class="size-4" />
                <span class="text-xs font-medium">Cultural</span>
              </label>
              <label class="flex cursor-pointer flex-col items-center gap-1.5 rounded-md border p-3 text-center transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                <input class="sr-only" name="trip-type" type="radio" value="business" />
                <LucideBriefcaseCn Size="16" Class="size-4" />
                <span class="text-xs font-medium">Business</span>
              </label>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="depart-date">Departure</LabelCn>
              <InputCn id="depart-date" type="date" />
            </div>
            <div class="space-y-2">
              <LabelCn for="return-date">Return</LabelCn>
              <InputCn id="return-date" type="date" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="name">Full Name</LabelCn>
              <InputCn id="name" Placeholder="Alex Rivera" />
            </div>
            <div class="space-y-2">
              <LabelCn for="email">Email</LabelCn>
              <InputCn id="email" Placeholder="@("alex@@example.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="notes">Special Requests</LabelCn>
            <TextareaCn
              id="notes"
              Placeholder="Dietary needs, mobility requirements, must-see sights..."
              Rows="2"
            />
          </div>

          <div class="flex items-center gap-3 rounded-lg border p-3">
            <LucideCompassCn Size="20" Class="size-5 text-muted-foreground" />
            <div>
              <p class="text-sm font-medium">Free Itinerary Preview</p>
              <p class="text-xs text-muted-foreground">
                Receive a sample day-by-day plan within 48 hours
              </p>
            </div>
          </div>

          <ButtonCn Class="w-full">Request Travel Plan</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            No booking commitment required. Customize your trip before you pay.
          </p>
        </form>
      </div>
    </section>

@code {
}
