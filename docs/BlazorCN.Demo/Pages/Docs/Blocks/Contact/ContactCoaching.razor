@* ========================================
   Block: contact-coaching
   Title: Contact Coaching
   Description: Life and business coaching session booking form with goal selection, session format preferences, and availability for coaches and mentors
   Long Description: Coaching intake form with visual goal selector cards for career, health, business, and personal growth. Captures session preferences and availability to match clients with the right coach.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-coaching.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Book a Coaching Session</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Start with a free discovery call to find the right coach for you.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">
                What area do you want to focus on?
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-2 gap-2 sm:grid-cols-4"
                          Value="@_goal" ValueChanged="@((string? v) => _goal = v ?? "")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "career" ? "border-primary" : "hover:border-foreground")"
                         For="goal-career">
                    <RadioGroupItemCn Class="sr-only" Id="goal-career" Value="career" />
                    <LucideBriefcaseCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "career" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Career</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "health" ? "border-primary" : "hover:border-foreground")"
                         For="goal-health">
                    <RadioGroupItemCn Class="sr-only" Id="goal-health" Value="health" />
                    <LucideHeartCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "health" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Health</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "business" ? "border-primary" : "hover:border-foreground")"
                         For="goal-business">
                    <RadioGroupItemCn Class="sr-only" Id="goal-business" Value="business" />
                    <LucideTrendingUpCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "business" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Business</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "personal" ? "border-primary" : "hover:border-foreground")"
                         For="goal-personal">
                    <RadioGroupItemCn Class="sr-only" Id="goal-personal" Value="personal" />
                    <LucideLightbulbCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "personal" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Personal</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="Sam Chen" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("sam@example.com")" Type="email" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="format">Preferred Format</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="format">
                            <SelectValueCn Placeholder="Select format" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="video">Video Call</SelectItemCn>
                            <SelectItemCn Value="phone">Phone Call</SelectItemCn>
                            <SelectItemCn Value="in-person">In Person</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="frequency">Session Frequency</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="frequency">
                            <SelectValueCn Placeholder="Select frequency" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="weekly">Weekly</SelectItemCn>
                            <SelectItemCn Value="biweekly">Bi-weekly</SelectItemCn>
                            <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="challenge">What challenge are you facing?</LabelCn>
                <TextareaCn id="challenge"
                            Placeholder="Describe your current situation and what you'd like to achieve..."
                            rows="3" />
            </div>

            <ButtonCn Class="w-full">Schedule Discovery Call</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Free 20-minute call. No obligation to continue.
            </p>
        </form>
    </div>
</section>

@code {
    private string _goal = "";
}
