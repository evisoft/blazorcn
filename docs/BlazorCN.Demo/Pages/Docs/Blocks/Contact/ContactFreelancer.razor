@* ========================================
   Block: contact-freelancer
   Title: Contact Freelancer
   Description: Hire a freelancer form with project scope, timeline, budget range, and hourly rate display for freelance marketplaces
   Long Description: Freelancer hiring form with an hourly rate range display that updates based on selected skill category. Built for freelance platforms, agencies, and businesses looking to hire contract talent.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-freelancer.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Hire a Freelancer</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Describe your project and we'll match you with the right talent.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="space-y-2">
                <LabelCn For="freelancer-category">Skill Category</LabelCn>
                <SelectCn Value="@_category" ValueChanged="@((string v) => _category = v)">
                    <SelectTriggerCn id="freelancer-category">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="development">Development</SelectItemCn>
                        <SelectItemCn Value="design">Design</SelectItemCn>
                        <SelectItemCn Value="writing">Writing &amp; Content</SelectItemCn>
                        <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                        <SelectItemCn Value="data">Data &amp; Analytics</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="mt-4 rounded-md bg-muted/50 p-4">
                <div class="mb-1 flex items-center gap-2">
                    <LucideClockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm font-medium">Market Hourly Rate</span>
                </div>
                <p class="text-2xl font-semibold tabular-nums">
                    $@CurrentRange.Min – $@CurrentRange.Max
                </p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Based on experience level and project complexity
                </p>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="freelancer-title">Project Title</LabelCn>
                <InputCn id="freelancer-title" Placeholder="E-commerce redesign" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="freelancer-timeline">Timeline</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="freelancer-timeline">
                            <SelectValueCn Placeholder="Select duration" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1-2w">1–2 weeks</SelectItemCn>
                            <SelectItemCn Value="1m">1 month</SelectItemCn>
                            <SelectItemCn Value="1-3m">1–3 months</SelectItemCn>
                            <SelectItemCn Value="3-6m">3–6 months</SelectItemCn>
                            <SelectItemCn Value="ongoing">Ongoing</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="freelancer-budget">Budget Range</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="freelancer-budget">
                            <SelectValueCn Placeholder="Select budget" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1-5k">$1K – $5K</SelectItemCn>
                            <SelectItemCn Value="5-15k">$5K – $15K</SelectItemCn>
                            <SelectItemCn Value="15-50k">$15K – $50K</SelectItemCn>
                            <SelectItemCn Value="50k+">$50K+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="freelancer-description">Project Description</LabelCn>
                <TextareaCn id="freelancer-description"
                            Placeholder="Describe key deliverables, tools, and requirements..."
                            rows="3" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="freelancer-name">Your Name</LabelCn>
                    <InputCn id="freelancer-name" Placeholder="Alex Rivera" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="freelancer-email">Email</LabelCn>
                    <InputCn id="freelancer-email" Placeholder="@("alex@example.com")" Type="email" />
                </div>
            </div>

            <ButtonCn Class="w-full">Find Freelancers</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll send you 3–5 matched profiles within 24 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private record RateRange(int Min, int Max);

    private string _category = "development";

    private static readonly Dictionary<string, RateRange> _rateRanges = new()
    {
        ["development"] = new(75, 200),
        ["design"] = new(60, 175),
        ["writing"] = new(40, 120),
        ["marketing"] = new(50, 150),
        ["data"] = new(80, 220),
    };

    private RateRange CurrentRange => _rateRanges.GetValueOrDefault(_category, new(75, 200));
}
