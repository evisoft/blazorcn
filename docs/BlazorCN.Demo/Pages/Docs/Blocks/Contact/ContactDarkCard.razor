@* ========================================
   Block: contact-dark-card
   Title: Contact Dark Card
   Description: Contact form with dark gradient card displaying contact information, social media links, and iconized contact methods
   Long Description: Contact form with dark side panel. Unique: dark bg-primary panel showing contact details and social links.
   Dependencies: ButtonCn, InputCn, LabelCn, TextareaCn
   Source: original/blocks/contact/contact-dark-card.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Contact Us</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Any questions or remarks? Just write us a message.
          </p>
        </div>

        <div class="grid gap-0 lg:grid-cols-2">
          <div class="p-6 lg:p-8">
            <form class="space-y-4">
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                  <LabelCn for="dark-card-first-name">First Name</LabelCn>
                  <InputCn id="dark-card-first-name" Placeholder="John" />
                </div>
                <div class="space-y-2">
                  <LabelCn for="dark-card-last-name">Last Name</LabelCn>
                  <InputCn id="dark-card-last-name" Placeholder="Doe" />
                </div>
              </div>
              <div class="space-y-2">
                <LabelCn for="dark-card-email">Email</LabelCn>
                <InputCn id="dark-card-email" Placeholder="@("john@@example.com")" type="email" />
              </div>
              <div class="space-y-2">
                <LabelCn for="dark-card-message">Message</LabelCn>
                <TextareaCn id="dark-card-message" Placeholder="Tell us how we can help..." Rows="4" />
              </div>
              <ButtonCn Class="w-full">Send Message</ButtonCn>
            </form>
          </div>

          <div class="flex flex-col justify-between bg-primary p-6 text-primary-foreground lg:p-8">
            <div>
              <h3 class="mb-3 text-sm font-medium">Contact Information</h3>
              <p class="mb-8 text-xs text-primary-foreground/80">
                Fill up the form and our team will get back to you within 24 hours.
              </p>
              <div class="space-y-4">
                <div class="flex items-center gap-3">
                  <LucidePhoneCn Class="h-4 w-4 text-primary-foreground/70" />
                  <span class="text-sm">+1 (424) 535-3523</span>
                </div>
                <div class="flex items-center gap-3">
                  <LucideMailCn Class="h-4 w-4 text-primary-foreground/70" />
                  <span class="text-sm">hello@@company.com</span>
                </div>
              </div>
            </div>
            <div class="mt-8 flex items-center gap-4">
              <a
                class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-foreground/20 text-primary-foreground/70 transition-colors hover:border-primary-foreground/40 hover:text-primary-foreground"
                href="#"
                aria-label="Twitter"
              >
                <LucideTwitterCn Size="16" Class="h-4 w-4" />
              </a>
              <a
                class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-foreground/20 text-primary-foreground/70 transition-colors hover:border-primary-foreground/40 hover:text-primary-foreground"
                href="#"
                aria-label="LinkedIn"
              >
                <LucideLinkedinCn Size="16" Class="h-4 w-4" />
              </a>
              <a
                class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-foreground/20 text-primary-foreground/70 transition-colors hover:border-primary-foreground/40 hover:text-primary-foreground"
                href="#"
                aria-label="Dribbble"
              >
                <LucideDribbbleCn Size="16" Class="h-4 w-4" />
              </a>
              <a
                class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-foreground/20 text-primary-foreground/70 transition-colors hover:border-primary-foreground/40 hover:text-primary-foreground"
                href="#"
                aria-label="Facebook"
              >
                <LucideFacebookCn Size="16" Class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

@code {
}
