@* ========================================
   Block: contact-healthcare
   Title: Contact Healthcare
   Description: Healthcare appointment request form with symptoms, insurance details, and appointment type selection for medical practices
   Long Description: Healthcare appointment form with radio card selector for visit type. Patients choose between in-person, telehealth, or urgent care before providing symptoms and insurance details.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-healthcare.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request an Appointment</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Book a visit with our care team. We accept most major insurance plans.
            </p>
        </div>

        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Appointment Type
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-3 gap-3"
                          Value="@_visitType" ValueChanged="@((string? v) => _visitType = v ?? "in-person")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-2 rounded-lg border p-4 text-center transition-colors", _visitType == "in-person" ? "border-primary" : "hover:border-foreground")"
                         For="type-in-person">
                    <RadioGroupItemCn Class="sr-only" Id="type-in-person" Value="in-person" />
                    <LucideBuilding2Cn Class="size-5 text-muted-foreground" Size="20" />
                    <span class="text-sm font-medium">In-Person</span>
                    <span class="text-[10px] text-muted-foreground">Visit our office</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-2 rounded-lg border p-4 text-center transition-colors", _visitType == "telehealth" ? "border-primary" : "hover:border-foreground")"
                         For="type-telehealth">
                    <RadioGroupItemCn Class="sr-only" Id="type-telehealth" Value="telehealth" />
                    <LucideMonitorSmartphoneCn Class="size-5 text-muted-foreground" Size="20" />
                    <span class="text-sm font-medium">Telehealth</span>
                    <span class="text-[10px] text-muted-foreground">Video consultation</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-2 rounded-lg border p-4 text-center transition-colors", _visitType == "urgent" ? "border-primary" : "hover:border-foreground")"
                         For="type-urgent">
                    <RadioGroupItemCn Class="sr-only" Id="type-urgent" Value="urgent" />
                    <LucideStethoscopeCn Class="size-5 text-muted-foreground" Size="20" />
                    <span class="text-sm font-medium">Urgent Care</span>
                    <span class="text-[10px] text-muted-foreground">Same-day visit</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="first-name">First Name</LabelCn>
                    <InputCn id="first-name" Placeholder="Jordan" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="last-name">Last Name</LabelCn>
                    <InputCn id="last-name" Placeholder="Mitchell" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("jordan@example.com")" Type="email" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="insurance">Insurance Provider</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="insurance">
                            <SelectValueCn Placeholder="Select provider" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="aetna">Aetna</SelectItemCn>
                            <SelectItemCn Value="bcbs">Blue Cross Blue Shield</SelectItemCn>
                            <SelectItemCn Value="cigna">Cigna</SelectItemCn>
                            <SelectItemCn Value="united">UnitedHealthcare</SelectItemCn>
                            <SelectItemCn Value="kaiser">Kaiser Permanente</SelectItemCn>
                            <SelectItemCn Value="self">Self-Pay</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="member-id">Member ID</LabelCn>
                    <InputCn id="member-id" Placeholder="XYZ123456789" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="symptoms">Describe your symptoms or reason for visit</LabelCn>
                <TextareaCn id="symptoms"
                            Placeholder="When did your symptoms start? How severe are they?"
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Request Appointment</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Our scheduling team will confirm your appointment within one business day.
            </p>
        </form>
    </div>
</section>

@code {
    private string _visitType = "in-person";
}
