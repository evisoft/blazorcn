                @if (_step < _steps.Length - 1)
                {
                    <ButtonCn type=""button"" @onclick=""@(() => _step++)"">
                        Next
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn type=""submit"">Submit Request</ButtonCn>
                }
            </div>
        </form>
    </div>
</section>

