@* ========================================
   Block: contact-card
   Title: Contact Card
   Description: Contact form with card layout featuring contact information, phone, email, and support ticket options alongside form fields
   Long Description: Contact form with sidebar showing multiple contact methods. Clean two-column layout provides form and alternative contact options side-by-side.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, TextareaCn
   Source: original/blocks/contact/contact-card.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <div class="overflow-hidden rounded-lg border bg-card p-6 lg:p-8">
          <h3 class="mb-6 text-sm font-medium">Contact us</h3>
          <form class="space-y-6">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="space-y-2">
                <LabelCn for="card-first-name">First Name</LabelCn>
                <InputCn id="card-first-name" Placeholder="John" />
              </div>
              <div class="space-y-2">
                <LabelCn for="card-last-name">Last Name</LabelCn>
                <InputCn id="card-last-name" Placeholder="Doe" />
              </div>
            </div>
            <div class="space-y-2">
              <LabelCn for="card-email">Email Address</LabelCn>
              <InputCn id="card-email" Placeholder="@("john@@example.com")" type="email" />
            </div>
            <div class="space-y-2">
              <LabelCn for="card-message">Message</LabelCn>
              <TextareaCn id="card-message" Placeholder="Tell us how we can help..." Rows="4" />
            </div>
            <div class="flex items-center gap-2">
              <CheckboxCn id="privacy-policy" />
              <LabelCn Class="cursor-pointer text-xs font-normal" for="privacy-policy">
                I agree to the 
                <a class="text-primary hover:underline" href="#">
                  Privacy Policy
                </a>
              </LabelCn>
            </div>
            <ButtonCn Class="w-full">Send Message</ButtonCn>
          </form>
        </div>

        @* Unique UI element: contact methods sidebar *@
        <div class="lg:pt-8">
          <h2 class="mb-3 text-sm font-medium">Get in Touch</h2>
          <p class="text-xs text-muted-foreground">
            Have questions? We'd love to hear from you. Send us a message and we'll respond as soon
            as possible.
          </p>
          <div class="mt-10 space-y-4">
            <div class="flex items-center gap-4">
              <LucidePhoneCn Size="20" Class="size-5 text-muted-foreground" />
              <span>+1(424) 535 3523</span>
            </div>
            <div class="flex items-center gap-4">
              <LucideMailCn Size="20" Class="size-5 text-muted-foreground" />
              <span>hello@@mail.com</span>
            </div>
            <div class="flex items-center gap-4">
              <LucideTicketCn Size="20" Class="size-5 text-muted-foreground" />
              <span>Open Support Ticket</span>
            </div>
          </div>
        </div>
      </div>
    </section>

@code {
}
