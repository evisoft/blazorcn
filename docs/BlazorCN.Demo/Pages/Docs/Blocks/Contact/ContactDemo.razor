@* ========================================
   Block: contact-demo
   Title: Contact Demo
   Description: Product demo request form with use case selection and team size for SaaS lead qualification
   Long Description: Capture qualified leads with use case selection and team size picker. Unique: use case selector with icons and company size dropdown.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn
   Source: original/blocks/contact/contact-demo.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request a Demo</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                See how we can help your team work smarter.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">What interests you?</LabelCn>
            <RadioGroupCn Class="space-y-2" Value="@_useCase" ValueChanged="@((string? v) => _useCase = v ?? "")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _useCase == "automation" ? "border-primary" : "hover:border-foreground")"
                         For="demo-automation">
                    <RadioGroupItemCn Id="demo-automation" Value="automation" />
                    <LucideZapCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm font-medium">Workflow Automation</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _useCase == "analytics" ? "border-primary" : "hover:border-foreground")"
                         For="demo-analytics">
                    <RadioGroupItemCn Id="demo-analytics" Value="analytics" />
                    <LucideChartColumnCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm font-medium">Analytics &amp; Reporting</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _useCase == "collaboration" ? "border-primary" : "hover:border-foreground")"
                         For="demo-collaboration">
                    <RadioGroupItemCn Id="demo-collaboration" Value="collaboration" />
                    <LucideUsersCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm font-medium">Team Collaboration</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="demo-name">Name</LabelCn>
                    <InputCn id="demo-name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="demo-email">Work Email</LabelCn>
                    <InputCn id="demo-email" Placeholder="@("john@company.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="demo-company">Company</LabelCn>
                <InputCn id="demo-company" Placeholder="Acme Inc." />
            </div>

            <div class="space-y-2">
                <LabelCn For="demo-team-size">Team Size</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="demo-team-size">
                        <SelectValueCn Placeholder="Select team size" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="1-10">1-10 people</SelectItemCn>
                        <SelectItemCn Value="11-50">11-50 people</SelectItemCn>
                        <SelectItemCn Value="51-200">51-200 people</SelectItemCn>
                        <SelectItemCn Value="201-500">201-500 people</SelectItemCn>
                        <SelectItemCn Value="500+">500+ people</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <ButtonCn Class="w-full">Request Demo</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll reach out within 1 business day to schedule.
            </p>
        </form>
    </div>
</section>

@code {
    private string _useCase = "";
}
