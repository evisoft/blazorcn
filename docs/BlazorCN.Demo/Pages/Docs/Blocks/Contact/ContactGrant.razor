@* ========================================
   Block: contact-grant
   Title: Contact Grant
   Description: Grant application form with project scope, funding amount slider, and timeline for nonprofit and research organizations
   Long Description: Grant application with interactive funding range selector and project scope fields. The slider with live display helps applicants target realistic funding amounts within program limits.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, SliderCn, TextareaCn
   Source: original/blocks/contact/contact-grant.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Grant Application</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Apply for funding to support your project, research, or community initiative.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <LabelCn>Funding Amount Requested</LabelCn>
                    <span class="text-lg font-semibold tabular-nums">
                        $@_fundingAmount.ToString("N0")
                    </span>
                </div>
                <SliderCn Class="py-2" Max="100000" Min="5000" Value="@_fundingAmount"
                          ValueChanged="@((double v) => _fundingAmount = v)" Step="5000" />
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>$5,000</span>
                    <span>$100,000</span>
                </div>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="applicant-name">Applicant Name</LabelCn>
                    <InputCn id="applicant-name" Placeholder="Dr. Maya Patel" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("maya@nonprofit.org")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="organization">Organization</LabelCn>
                <InputCn id="organization" Placeholder="Community Impact Foundation" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="category">Grant Category</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="category">
                            <SelectValueCn Placeholder="Select category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="education">Education</SelectItemCn>
                            <SelectItemCn Value="health">Health &amp; Wellness</SelectItemCn>
                            <SelectItemCn Value="environment">Environment</SelectItemCn>
                            <SelectItemCn Value="arts">Arts &amp; Culture</SelectItemCn>
                            <SelectItemCn Value="research">Research</SelectItemCn>
                            <SelectItemCn Value="community">Community Development</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="duration">Project Duration</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="duration">
                            <SelectValueCn Placeholder="Select duration" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="6mo">6 months</SelectItemCn>
                            <SelectItemCn Value="1yr">1 year</SelectItemCn>
                            <SelectItemCn Value="2yr">2 years</SelectItemCn>
                            <SelectItemCn Value="3yr">3 years</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="project-title">Project Title</LabelCn>
                <InputCn id="project-title" Placeholder="Rural Literacy Initiative" />
            </div>

            <div class="space-y-2">
                <LabelCn For="summary">Project Summary</LabelCn>
                <TextareaCn id="summary"
                            Placeholder="Describe your project goals, target population, and expected outcomes..."
                            rows="3" />
            </div>

            <ButtonCn Class="w-full">Submit Application</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Applications are reviewed on a rolling basis. Expect a response within 4–6 weeks.
            </p>
        </form>
    </div>
</section>

@code {
    private double _fundingAmount = 25000;
}
