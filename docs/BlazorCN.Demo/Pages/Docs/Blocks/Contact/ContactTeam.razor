@* ============================================================
   Block: contact-team
   Title: ContactTeam
   Description: Contact section with team member cards showing staff photos, roles, and individual contact buttons
   Source: original/blocks/contact/contact-team.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Meet Our Team</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Get in touch with the right person for your needs.
            </p>
        </div>

        <div>
            @foreach (var member in _members)
            {
                var isLast = member == _members[_members.Length - 1];
                <div class="@Cn.Merge("flex items-center justify-between p-4", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="h-12 w-12">
                            <AvatarImageCn Src="@member.Avatar" Alt="@member.Name" />
                            <AvatarFallbackCn>@member.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="text-sm font-medium">@member.Name</p>
                            <p class="text-xs text-muted-foreground">@member.Role</p>
                        </div>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        <LucideIconCn Name="mail" Size="16" Class="mr-2 h-4 w-4" />
                        Email
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-t p-6">
            <h3 class="mb-4 text-sm font-medium">Not sure who to contact?</h3>
            <form class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="team-department">Department</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="team-department">
                            <SelectValueCn Placeholder="Select department" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="sales">Sales</SelectItemCn>
                            <SelectItemCn Value="support">Support</SelectItemCn>
                            <SelectItemCn Value="partnerships">Partnerships</SelectItemCn>
                            <SelectItemCn Value="general">General Inquiry</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <LabelCn For="team-name">Name</LabelCn>
                        <InputCn id="team-name" Placeholder="Your name" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="team-email">Email</LabelCn>
                        <InputCn id="team-email" Placeholder="@("you@example.com")" Type="email" />
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn For="team-message">Message</LabelCn>
                    <TextareaCn id="team-message" Placeholder="How can we help?" Rows="3" />
                </div>
                <ButtonCn Class="w-full">Send Message</ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Avatar, string Initials);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Johnson", "Head of Sales",
            "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&h=400&auto=format&fit=crop",
            "SJ"),
        new("Michael Chen", "Customer Success",
            "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&auto=format&fit=crop",
            "MC"),
        new("Emily Rodriguez", "Technical Support",
            "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&h=400&auto=format&fit=crop",
            "ER"),
    ];
}
