@* ========================================
   Block: contact-maintenance
   Title: Contact Maintenance
   Description: Maintenance request form with issue type, urgency level, and access instructions for property management
   Long Description: Maintenance request with issue category selector and photo upload area.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-maintenance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Maintenance Request</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Report an issue and we'll get it fixed as soon as possible.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="maintenance-category">Issue Category</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="maintenance-category">
                        <SelectValueCn Placeholder="What type of issue?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="plumbing">Plumbing</SelectItemCn>
                        <SelectItemCn Value="electrical">Electrical</SelectItemCn>
                        <SelectItemCn Value="hvac">HVAC</SelectItemCn>
                        <SelectItemCn Value="appliance">Appliances</SelectItemCn>
                        <SelectItemCn Value="structural">Structural</SelectItemCn>
                        <SelectItemCn Value="pest">Pest Control</SelectItemCn>
                        <SelectItemCn Value="other">Other</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="maintenance-description">Description</LabelCn>
                <TextareaCn id="maintenance-description"
                            Placeholder="Describe the problem. Include when it started and location in unit..."
                            rows="3" />
            </div>

            <div class="space-y-2">
                <LabelCn For="photos">Photos (Optional but helpful)</LabelCn>
                <label for="photos"
                       class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-dashed p-4 transition-colors hover:border-foreground">
                    <LucideUploadCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm text-muted-foreground">Upload photos</span>
                    <input id="photos" accept="image/*" class="hidden" multiple type="file" />
                </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="maintenance-unit">Unit Number</LabelCn>
                    <InputCn id="maintenance-unit" Placeholder="e.g., 4B" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="maintenance-urgency">Urgency</LabelCn>
                    <SelectCn Value="routine">
                        <SelectTriggerCn id="maintenance-urgency">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="emergency">Emergency</SelectItemCn>
                            <SelectItemCn Value="urgent">Urgent (24hrs)</SelectItemCn>
                            <SelectItemCn Value="routine">Routine (3-5 days)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="maintenance-name">Your Name</LabelCn>
                    <InputCn id="maintenance-name" Placeholder="Full name" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="maintenance-phone">Phone</LabelCn>
                    <InputCn id="maintenance-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-3">
                <LabelCn>Access Permission</LabelCn>
                <div class="space-y-2">
                    <div class="flex items-center gap-2">
                        <CheckboxCn id="enter" />
                        <LabelCn Class="text-sm font-normal" For="enter">
                            Permission to enter if I'm not home
                        </LabelCn>
                    </div>
                    <div class="flex items-center gap-2">
                        <CheckboxCn id="pet" />
                        <LabelCn Class="text-sm font-normal" For="pet">
                            I have pets in the unit
                        </LabelCn>
                    </div>
                </div>
            </div>

            <ButtonCn Class="w-full">Submit Request</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                You'll receive a work order confirmation within 1 hour.
            </p>
        </form>
    </div>
</section>

