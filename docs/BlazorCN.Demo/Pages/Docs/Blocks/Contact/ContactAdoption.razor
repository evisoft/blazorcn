@* ========================================
   Block: contact-adoption
   Title: Contact Adoption
   Description: Pet adoption application form with animal type preferences, living situation details, and experience level for shelters and rescues
   Long Description: Pet adoption application with visual pet type selector, living situation assessment, and experience level. Helps shelters qualify adopters and match them with the right companion.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-adoption.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Adopt a Pet</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Complete this application to begin the adoption process.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">
                What type of pet are you interested in?
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-2 gap-2 sm:grid-cols-4"
                          Value="@_petType" ValueChanged="@((string? v) => _petType = v ?? "")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _petType == "dog" ? "border-primary" : "hover:border-foreground")"
                         For="pet-dog">
                    <RadioGroupItemCn Class="sr-only" Id="pet-dog" Value="dog" />
                    <LucideDogCn Class="@Cn.Merge("mb-2 h-5 w-5", _petType == "dog" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Dog</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _petType == "cat" ? "border-primary" : "hover:border-foreground")"
                         For="pet-cat">
                    <RadioGroupItemCn Class="sr-only" Id="pet-cat" Value="cat" />
                    <LucideCatCn Class="@Cn.Merge("mb-2 h-5 w-5", _petType == "cat" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Cat</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _petType == "rabbit" ? "border-primary" : "hover:border-foreground")"
                         For="pet-rabbit">
                    <RadioGroupItemCn Class="sr-only" Id="pet-rabbit" Value="rabbit" />
                    <LucideRabbitCn Class="@Cn.Merge("mb-2 h-5 w-5", _petType == "rabbit" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Rabbit</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _petType == "bird" ? "border-primary" : "hover:border-foreground")"
                         For="pet-bird">
                    <RadioGroupItemCn Class="sr-only" Id="pet-bird" Value="bird" />
                    <LucideBirdCn Class="@Cn.Merge("mb-2 h-5 w-5", _petType == "bird" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Bird</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="adoption-name">Full Name</LabelCn>
                    <InputCn id="adoption-name" Placeholder="Jordan Lee" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="adoption-email">Email</LabelCn>
                    <InputCn id="adoption-email" Placeholder="@("jordan@example.com")" Type="email" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="living">Living Situation</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="living">
                            <SelectValueCn Placeholder="Select housing type" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="house-yard">House with yard</SelectItemCn>
                            <SelectItemCn Value="house-no-yard">House without yard</SelectItemCn>
                            <SelectItemCn Value="apartment">Apartment</SelectItemCn>
                            <SelectItemCn Value="condo">Condo / Townhouse</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="adoption-experience">Pet Experience</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="adoption-experience">
                            <SelectValueCn Placeholder="Select level" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="first-time">First-time owner</SelectItemCn>
                            <SelectItemCn Value="some">Some experience</SelectItemCn>
                            <SelectItemCn Value="experienced">Experienced owner</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="adoption-why">Why do you want to adopt?</LabelCn>
                <TextareaCn id="adoption-why" Placeholder="Tell us about your household and why you're ready for a pet..." />
            </div>

            <ButtonCn Class="w-full">Submit Application</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll review your application and contact you within 3-5 days.
            </p>
        </form>
    </div>
</section>

@code {
    private string _petType = "";
}
