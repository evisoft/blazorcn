@* ========================================
   Block: contact-patient
   Title: Contact Patient
   Description: Patient intake form with symptoms description, insurance details, medical history, and visit reason selector for healthcare providers
   Long Description: Consultation booking with pricing
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-patient.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Patient Intake Form</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Complete this form before your appointment to streamline your visit.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Visit Reason</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-3"
                              Value="@_visitReason" ValueChanged="@((string? v) => _visitReason = v ?? "new-patient")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _visitReason == "new-patient" ? "border-primary" : "hover:border-foreground")"
                             For="visit-new">
                        <RadioGroupItemCn Id="visit-new" Value="new-patient" />
                        <span class="text-sm font-medium">New Patient</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _visitReason == "follow-up" ? "border-primary" : "hover:border-foreground")"
                             For="visit-followup">
                        <RadioGroupItemCn Id="visit-followup" Value="follow-up" />
                        <span class="text-sm font-medium">Follow-Up</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _visitReason == "urgent" ? "border-primary" : "hover:border-foreground")"
                             For="visit-urgent">
                        <RadioGroupItemCn Id="visit-urgent" Value="urgent" />
                        <span class="text-sm font-medium">Urgent</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _visitReason == "specialist" ? "border-primary" : "hover:border-foreground")"
                             For="visit-specialist">
                        <RadioGroupItemCn Id="visit-specialist" Value="specialist" />
                        <span class="text-sm font-medium">Specialist Referral</span>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="first-name">First Name</LabelCn>
                    <InputCn id="first-name" Placeholder="Sarah" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="last-name">Last Name</LabelCn>
                    <InputCn id="last-name" Placeholder="Mitchell" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="dob">Date of Birth</LabelCn>
                    <InputCn id="dob" Type="date" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="insurance-provider">Insurance Provider</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="insurance-provider">
                        <SelectValueCn Placeholder="Select your provider" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="aetna">Aetna</SelectItemCn>
                        <SelectItemCn Value="bluecross">Blue Cross Blue Shield</SelectItemCn>
                        <SelectItemCn Value="cigna">Cigna</SelectItemCn>
                        <SelectItemCn Value="united">UnitedHealthcare</SelectItemCn>
                        <SelectItemCn Value="kaiser">Kaiser Permanente</SelectItemCn>
                        <SelectItemCn Value="self-pay">Self-Pay</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="member-id">Member ID</LabelCn>
                <InputCn id="member-id" Placeholder="ABC123456789" />
            </div>

            <div class="space-y-2">
                <LabelCn For="symptoms">Describe Your Symptoms</LabelCn>
                <TextareaCn id="symptoms"
                            Placeholder="When did symptoms start? How severe are they (1-10)? Any treatments tried?"
                            rows="3" />
            </div>

            <ButtonCn Class="w-full">Submit Intake Form</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Your information is protected under HIPAA privacy regulations.
            </p>
        </form>
    </div>
</section>

@code {
    private string _visitReason = "new-patient";
}
