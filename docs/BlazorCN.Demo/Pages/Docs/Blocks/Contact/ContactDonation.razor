@* ========================================
   Block: contact-donation
   Title: Contact Donation
   Description: Charitable donation form with preset amount buttons, custom input, donor information, and dedication option for nonprofits
   Long Description: Donation form with preset amount buttons for $25, $50, $100, and $250 plus a custom amount input. Built for nonprofits, charities, and fundraising campaigns that need a fast, trustworthy giving experience.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn
   Source: original/blocks/contact/contact-donation.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Make a Donation</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Your contribution directly supports our mission.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="mb-3 flex items-center gap-2">
                <LucideHeartCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <span class="text-sm font-medium">Select Amount</span>
            </div>
            <div class="grid grid-cols-4 gap-2">
                @foreach (var amt in _presets)
                {
                    <button type="button"
                            @onclick="@(() => { _selected = amt; _custom = ""; })"
                            class="@Cn.Merge("rounded-md border px-3 py-2.5 text-sm font-medium tabular-nums transition-colors", _selected == amt && string.IsNullOrEmpty(_custom) ? "border-foreground bg-muted/50" : "hover:bg-muted/50")">
                        $@amt
                    </button>
                }
            </div>
            <div class="relative mt-3">
                <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-muted-foreground">
                    $
                </span>
                <InputCn Class="pl-7" Placeholder="Custom amount" Type="number"
                         Value="@_custom" ValueChanged="@((string v) => _custom = v)" />
            </div>
            @if (ActiveAmount > 0)
            {
                <p class="mt-3 text-xs text-muted-foreground">
                    Your $@ActiveAmount gift can provide
                    @(ActiveAmount >= 100 ? "school supplies for 10 students" : $"{ActiveAmount * 2} meals to families in need").
                </p>
            }
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="first-name">First Name</LabelCn>
                    <InputCn id="first-name" Placeholder="Maria" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="last-name">Last Name</LabelCn>
                    <InputCn id="last-name" Placeholder="Santos" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("maria@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="frequency">Frequency</LabelCn>
                <SelectCn Value="one-time">
                    <SelectTriggerCn id="frequency">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="one-time">One-Time</SelectItemCn>
                        <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                        <SelectItemCn Value="annually">Annually</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="dedication">
                    Dedicate this gift <span class="text-muted-foreground">(optional)</span>
                </LabelCn>
                <InputCn id="dedication" Placeholder="In honor of Jane Doe" />
            </div>

            <ButtonCn Class="w-full">Donate $@(ActiveAmount > 0 ? ActiveAmount.ToString() : "...")</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Tax-deductible. You'll receive a receipt by email.
            </p>
        </form>
    </div>
</section>

@code {
    private static readonly int[] _presets = [25, 50, 100, 250];

    private int _selected = 50;
    private string _custom = "";

    private int ActiveAmount => !string.IsNullOrEmpty(_custom) && int.TryParse(_custom, out var c) ? c : _selected;
}
