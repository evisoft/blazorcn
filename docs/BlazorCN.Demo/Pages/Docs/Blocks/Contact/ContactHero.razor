@* ========================================
   Block: contact-hero
   Title: Contact Hero
   Description: Full-screen contact hero section with background image overlay displaying address, email, phone, and contact person information
   Long Description: Hero contact section with full-height muted background area displaying key contact information.
   Dependencies: ButtonCn, InputCn, LabelCn, TextareaCn
   Source: original/blocks/contact/contact-hero.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="bg-muted/50 px-6 py-16 text-center">
          <h2 class="mb-2 text-sm font-medium">Get in Touch</h2>
          <p class="mb-8 text-xs text-muted-foreground">
            We'd love to hear from you. Send us a message and we'll respond as soon as possible.
          </p>
          <div class="grid gap-6 sm:grid-cols-3">
            <div class="text-center">
              <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-background">
                <LucideMapPinCn Size="16" Class="h-4 w-4 text-muted-foreground" />
              </div>
              <p class="text-xs font-medium">123 Business St</p>
              <p class="text-xs text-muted-foreground">New York, NY</p>
            </div>
            <div class="text-center">
              <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-background">
                <LucideMailCn Size="16" Class="h-4 w-4 text-muted-foreground" />
              </div>
              <p class="text-xs font-medium">hello@@company.com</p>
            </div>
            <div class="text-center">
              <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-background">
                <LucidePhoneCn Size="16" Class="h-4 w-4 text-muted-foreground" />
              </div>
              <p class="text-xs font-medium">+1 (424) 535-3523</p>
            </div>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="hero-name">Name</LabelCn>
              <InputCn id="hero-name" Placeholder="John Doe" />
            </div>
            <div class="space-y-2">
              <LabelCn for="hero-email">Email</LabelCn>
              <InputCn id="hero-email" Placeholder="@("john@@example.com")" type="email" />
            </div>
          </div>
          <div class="space-y-2">
            <LabelCn for="hero-message">Message</LabelCn>
            <TextareaCn id="hero-message" Placeholder="Tell us how we can help..." Rows="4" />
          </div>
          <ButtonCn Class="w-full">Send Message</ButtonCn>
        </form>
      </div>
    </section>

