@* ============================================================
   Block: contact-speaker
   Title: ContactSpeaker
   Description: Speaker booking request form with event details, talk format selection, audience size, and budget range for conference organizers
   Source: original/blocks/contact/contact-speaker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Book a Speaker</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your event and we'll match you with the right speaker.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Talk Format</LabelCn>
                <RadioGroupCn class="grid grid-cols-2 gap-3" Value="@_format" ValueChanged="@((string? v) => _format = v ?? "keynote")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _format == "keynote" ? "border-primary" : "hover:border-foreground")"
                             For="fmt-keynote">
                        <RadioGroupItemCn Id="fmt-keynote" Value="keynote" />
                        <div>
                            <span class="text-sm font-medium">Keynote</span>
                            <p class="text-xs text-muted-foreground">30–60 min solo talk</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _format == "panel" ? "border-primary" : "hover:border-foreground")"
                             For="fmt-panel">
                        <RadioGroupItemCn Id="fmt-panel" Value="panel" />
                        <div>
                            <span class="text-sm font-medium">Panel</span>
                            <p class="text-xs text-muted-foreground">Moderated discussion</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _format == "workshop" ? "border-primary" : "hover:border-foreground")"
                             For="fmt-workshop">
                        <RadioGroupItemCn Id="fmt-workshop" Value="workshop" />
                        <div>
                            <span class="text-sm font-medium">Workshop</span>
                            <p class="text-xs text-muted-foreground">2–4 hr interactive</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _format == "fireside" ? "border-primary" : "hover:border-foreground")"
                             For="fmt-fireside">
                        <RadioGroupItemCn Id="fmt-fireside" Value="fireside" />
                        <div>
                            <span class="text-sm font-medium">Fireside Chat</span>
                            <p class="text-xs text-muted-foreground">Informal interview</p>
                        </div>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="organizer">Organizer Name</LabelCn>
                    <InputCn id="organizer" Placeholder="Rachel Kim" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Work Email</LabelCn>
                    <InputCn id="email" Placeholder="@("rachel@company.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="event-name">Event Name</LabelCn>
                <InputCn id="event-name" Placeholder="Design Systems Summit 2026" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="audience">Expected Audience</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="audience">
                            <SelectValueCn Placeholder="Select size" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="50">Under 50</SelectItemCn>
                            <SelectItemCn Value="200">50–200</SelectItemCn>
                            <SelectItemCn Value="500">200–500</SelectItemCn>
                            <SelectItemCn Value="1000">500–1,000</SelectItemCn>
                            <SelectItemCn Value="5000">1,000+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="budget">Speaker Budget</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="budget">
                            <SelectValueCn Placeholder="Select range" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="2500">Under $2,500</SelectItemCn>
                            <SelectItemCn Value="5000">$2,500–$5,000</SelectItemCn>
                            <SelectItemCn Value="10000">$5,000–$10,000</SelectItemCn>
                            <SelectItemCn Value="25000">$10,000–$25,000</SelectItemCn>
                            <SelectItemCn Value="25001">$25,000+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="topic">Preferred Topic or Theme</LabelCn>
                <TextareaCn
                    id="topic"
                    Placeholder="Describe the topic, audience profile, and any specific speakers you have in mind..."
                    Rows="2"
                />
            </div>

            <ButtonCn Class="w-full">Submit Speaker Request</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll respond with speaker recommendations within 48 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private string _format = "keynote";
}
