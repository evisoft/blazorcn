@* ============================================================
   Block: contact-relocation
   Title: ContactRelocation
   Description: Relocation services inquiry form with origin and destination countries, family size, timeline, and service needs for relocation agencies
   Source: original/blocks/contact/contact-relocation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Relocation Services Inquiry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Planning a move abroad? We handle visas, housing, and settling-in support.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="rounded-lg border p-4">
                <div class="grid grid-cols-3 gap-4 text-center">
                    <div>
                        <p class="text-2xl font-semibold tabular-nums">45+</p>
                        <p class="text-xs text-muted-foreground">Countries</p>
                    </div>
                    <div>
                        <p class="text-2xl font-semibold tabular-nums">3,200+</p>
                        <p class="text-xs text-muted-foreground">Relocations</p>
                    </div>
                    <div>
                        <p class="text-2xl font-semibold tabular-nums">98%</p>
                        <p class="text-xs text-muted-foreground">Satisfaction</p>
                    </div>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn for="relocation-origin">Relocating From</LabelCn>
                    <InputCn id="relocation-origin" Placeholder="City, Country" />
                </div>
                <div class="space-y-2">
                    <LabelCn for="relocation-destination">Relocating To</LabelCn>
                    <InputCn id="relocation-destination" Placeholder="City, Country" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn for="relocation-type">Relocation Type</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="relocation-type">
                            <SelectValueCn Placeholder="Select type" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="corporate">Corporate Transfer</SelectItemCn>
                            <SelectItemCn Value="individual">Individual Move</SelectItemCn>
                            <SelectItemCn Value="family">Family Relocation</SelectItemCn>
                            <SelectItemCn Value="retirement">Retirement Abroad</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn for="family-size">Family Size</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="family-size">
                            <SelectValueCn Placeholder="Who is relocating?" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="single">Just me</SelectItemCn>
                            <SelectItemCn Value="couple">Couple</SelectItemCn>
                            <SelectItemCn Value="family-small">Family (1-2 children)</SelectItemCn>
                            <SelectItemCn Value="family-large">Family (3+ children)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn for="relocation-timeline">Target Move Date</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="relocation-timeline">
                        <SelectValueCn Placeholder="When are you planning to move?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="1-month">Within 1 month</SelectItemCn>
                        <SelectItemCn Value="1-3">1 - 3 months</SelectItemCn>
                        <SelectItemCn Value="3-6">3 - 6 months</SelectItemCn>
                        <SelectItemCn Value="6-plus">6+ months</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn for="relocation-name">Full Name</LabelCn>
                    <InputCn id="relocation-name" Placeholder="Elena Vasquez" />
                </div>
                <div class="space-y-2">
                    <LabelCn for="relocation-email">Email</LabelCn>
                    <InputCn id="relocation-email" Placeholder="@("elena@@example.com")" type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn for="services">Services Needed</LabelCn>
                <TextareaCn
                    id="services"
                    Placeholder="Visa support, housing search, school search, language training, shipping..."
                    Rows="2"
                />
            </div>

            <ButtonCn Class="w-full">Request Free Consultation</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                A relocation specialist will schedule a discovery call within 48 hours.
            </p>
        </form>
    </div>
</section>

