@* ============================================================
   Block: contact-sales
   Title: ContactSales
   Description: Sales inquiry contact form with company details, budget selection, and timeline for B2B lead generation
   Source: original/blocks/contact/contact-sales.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Talk to Sales</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your needs and we'll help you find the right solution.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Work Email</LabelCn>
                    <InputCn id="email" Placeholder="@("john@company.com")" Type="email" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="company">Company</LabelCn>
                    <InputCn id="company" Placeholder="Acme Inc." />
                </div>
                <div class="space-y-2">
                    <LabelCn For="company-size">Company Size</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="company-size">
                            <SelectValueCn Placeholder="Select size" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1-10">1-10 employees</SelectItemCn>
                            <SelectItemCn Value="11-50">11-50 employees</SelectItemCn>
                            <SelectItemCn Value="51-200">51-200 employees</SelectItemCn>
                            <SelectItemCn Value="201-1000">201-1000 employees</SelectItemCn>
                            <SelectItemCn Value="1000+">1000+ employees</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="budget">Budget Range</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="budget">
                        <SelectValueCn Placeholder="Select budget" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="&lt;5k">Less than $5,000</SelectItemCn>
                        <SelectItemCn Value="5k-15k">$5,000 - $15,000</SelectItemCn>
                        <SelectItemCn Value="15k-50k">$15,000 - $50,000</SelectItemCn>
                        <SelectItemCn Value="50k+">$50,000+</SelectItemCn>
                        <SelectItemCn Value="unsure">Not sure yet</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="timeline">Timeline</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="timeline">
                        <SelectValueCn Placeholder="When do you need this?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="asap">ASAP</SelectItemCn>
                        <SelectItemCn Value="1-3m">1-3 months</SelectItemCn>
                        <SelectItemCn Value="3-6m">3-6 months</SelectItemCn>
                        <SelectItemCn Value="6m+">6+ months</SelectItemCn>
                        <SelectItemCn Value="exploring">Just exploring</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="message">How can we help?</LabelCn>
                <TextareaCn id="message" Placeholder="Tell us about your project or goals..." Rows="3" />
            </div>

            <ButtonCn Class="w-full">Contact Sales</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">We'll respond within 24 hours</p>
        </form>
    </div>
</section>
