@* ========================================
   Block: contact-mentorship
   Title: Contact Mentorship
   Description: Mentorship program application form with goals, experience level, and focus area selection for professional development platforms
   Long Description: Internship application with duration
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-mentorship.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Mentorship Application</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Get matched with an experienced mentor in your field.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <span class="mb-3 block text-xs text-muted-foreground">Select your focus areas</span>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var area in _focusAreas)
                {
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _selectedAreas.Contains(area.Id) ? "border-primary" : "hover:border-foreground")"
                             For="@($"focus-{area.Id}")">
                        <CheckboxCn id="@($"focus-{area.Id}")"
                                    Checked="@(_selectedAreas.Contains(area.Id))"
                                    CheckedChanged="@((bool v) => ToggleArea(area.Id, v))" />
                        <div>
                            <span class="text-xs font-medium">@area.Label</span>
                            <p class="text-[10px] text-muted-foreground">@area.Desc</p>
                        </div>
                    </LabelCn>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="mentorship-name">Full Name</LabelCn>
                    <InputCn id="mentorship-name" Placeholder="Priya Sharma" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="mentorship-email">Email</LabelCn>
                    <InputCn id="mentorship-email" Placeholder="@("priya@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="mentorship-role">Current Role</LabelCn>
                <InputCn id="mentorship-role" Placeholder="Senior Software Engineer" />
            </div>

            <div class="space-y-2">
                <LabelCn For="mentorship-experience">Years of Experience</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="mentorship-experience">
                        <SelectValueCn Placeholder="Select range" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="0-2">0-2 years</SelectItemCn>
                        <SelectItemCn Value="3-5">3-5 years</SelectItemCn>
                        <SelectItemCn Value="6-10">6-10 years</SelectItemCn>
                        <SelectItemCn Value="10+">10+ years</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="mentorship-goals">What do you hope to achieve?</LabelCn>
                <TextareaCn id="mentorship-goals" Placeholder="Describe your mentorship goals..." rows="2" />
            </div>

            <ButtonCn Class="w-full">Apply for Mentorship</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Mentor matching takes 5-7 business days. Program runs for 3 months.
            </p>
        </form>
    </div>
</section>

@code {
    private record FocusArea(string Id, string Label, string Desc);

    private static readonly FocusArea[] _focusAreas =
    [
        new("leadership", "Leadership", "Team & management"),
        new("technical", "Technical", "Skills & architecture"),
        new("career", "Career", "Path & transitions"),
        new("communication", "Communication", "Speaking & writing"),
    ];

    private List<string> _selectedAreas = new();

    private void ToggleArea(string area, bool isChecked)
    {
        if (isChecked && !_selectedAreas.Contains(area))
            _selectedAreas.Add(area);
        else if (!isChecked)
            _selectedAreas.Remove(area);
    }
}
