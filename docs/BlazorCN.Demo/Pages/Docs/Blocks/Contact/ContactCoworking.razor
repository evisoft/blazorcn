@* ========================================
   Block: contact-coworking
   Title: Contact Coworking
   Description: Coworking space tour and membership inquiry form with desk preferences, meeting room needs, and community details for shared workspaces
   Long Description: Coworking membership inquiry with stat bar showing desk capacity, meeting rooms, and active members. Captures workspace preferences and schedule for personalized tour booking.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-coworking.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Book a Tour</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Visit our space and find the perfect workspace for you or your team.
          </p>
        </div>

        @* Stat bar *@
        <div class="grid grid-cols-3 border-b divide-x text-center">
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">120+</p>
            <p class="text-xs text-muted-foreground">Desks</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">8</p>
            <p class="text-xs text-muted-foreground">Meeting Rooms</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">350+</p>
            <p class="text-xs text-muted-foreground">Members</p>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="name">Full Name</LabelCn>
              <InputCn id="name" Placeholder="Riley Brooks" />
            </div>
            <div class="space-y-2">
              <LabelCn for="email">Email</LabelCn>
              <InputCn id="email" Placeholder="@("riley@@example.com")" type="email" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="desk-type">Desk Preference</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="desk-type">
                  <SelectValueCn Placeholder="Select desk type" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="hot-desk">Hot Desk</SelectItemCn>
                  <SelectItemCn Value="dedicated">Dedicated Desk</SelectItemCn>
                  <SelectItemCn Value="private-office">Private Office</SelectItemCn>
                  <SelectItemCn Value="unsure">Not sure yet</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="team-size">Team Size</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="team-size">
                  <SelectValueCn Placeholder="Number of people" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="1">Just me</SelectItemCn>
                  <SelectItemCn Value="2-5">2–5 people</SelectItemCn>
                  <SelectItemCn Value="6-10">6–10 people</SelectItemCn>
                  <SelectItemCn Value="10+">10+ people</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="start-date">Preferred Start Date</LabelCn>
            <InputCn id="start-date" Placeholder="e.g. Next Monday" />
          </div>

          <div class="space-y-2">
            <LabelCn for="needs">Any specific needs?</LabelCn>
            <TextareaCn
              id="needs"
              Placeholder="Parking, 24/7 access, phone booth requirements..."
              Rows="3"
            />
          </div>

          <ButtonCn Class="w-full">Schedule Tour</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            Tours available Monday–Friday, 9 AM – 5 PM. Free day pass included.
          </p>
        </form>
      </div>
    </section>

@code {
}
