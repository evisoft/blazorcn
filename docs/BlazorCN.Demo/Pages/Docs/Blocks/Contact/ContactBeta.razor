@* ========================================
   Block: contact-beta
   Title: Contact Beta
   Description: Beta tester application form with device info, testing experience, and feedback commitment for product teams
   Long Description: Beta application that captures tester profiles with platform availability and commitment level. Shows available spots remaining to create urgency.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-beta.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Join Our Beta Program</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Help shape the future of our product with early access and direct influence.
          </p>
        </div>

        @* Unique UI element: available spots counter *@
        <div class="grid grid-cols-3 border-b divide-x text-center">
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">47</p>
            <p class="text-xs text-muted-foreground">Spots left</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">6 weeks</p>
            <p class="text-xs text-muted-foreground">Beta duration</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">1 year</p>
            <p class="text-xs text-muted-foreground">Free premium</p>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="beta-name">Full Name</LabelCn>
              <InputCn id="beta-name" Placeholder="Jordan Lee" />
            </div>
            <div class="space-y-2">
              <LabelCn for="beta-email">Email</LabelCn>
              <InputCn id="beta-email" Placeholder="@("jordan@@example.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="device">Primary Device & OS</LabelCn>
            <InputCn id="device" Placeholder="e.g., iPhone 15 Pro, iOS 17.2" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="beta-experience">Testing Experience</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="beta-experience">
                  <SelectValueCn Placeholder="Select level" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="none">First time</SelectItemCn>
                  <SelectItemCn Value="some">1-3 products</SelectItemCn>
                  <SelectItemCn Value="experienced">4-10 products</SelectItemCn>
                  <SelectItemCn Value="expert">10+ or professional QA</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="beta-availability">Availability</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="beta-availability">
                  <SelectValueCn Placeholder="How often?" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="daily">Daily (30+ min)</SelectItemCn>
                  <SelectItemCn Value="several">Several times/week</SelectItemCn>
                  <SelectItemCn Value="weekly">Once a week</SelectItemCn>
                  <SelectItemCn Value="occasional">Occasionally</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="beta-why">Why do you want to be a beta tester?</LabelCn>
            <TextareaCn
              id="beta-why"
              Placeholder="Tell us what excites you about the product..."
              Rows="3"
            />
          </div>

          <div class="flex items-start gap-2 pt-2">
            <CheckboxCn id="nda" />
            <LabelCn
              Class="text-xs font-normal leading-tight text-muted-foreground"
              for="nda"
            >
              I agree to keep beta features confidential and provide constructive feedback
            </LabelCn>
          </div>

          <ButtonCn Class="w-full">Apply for Beta Access</ButtonCn>
          <p class="text-center text-xs text-muted-foreground">
            Applications reviewed within 1 week.
          </p>
        </form>
      </div>
    </section>

@code {
}
