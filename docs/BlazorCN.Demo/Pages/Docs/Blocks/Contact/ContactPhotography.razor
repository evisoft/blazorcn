@* ========================================
   Block: contact-photography
   Title: Contact Photography
   Description: Photography session booking form with shoot type, location preference, package selection, and styling options for photographers
   Long Description: Photography booking with shoot type selector, date picker, and style preferences. Perfect for portrait photographers, wedding photographers, and product studios.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-photography.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Photography Booking</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Let's create stunning images together. Tell us about your vision.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="space-y-2">
            <LabelCn for="shoot-type">Type of Shoot</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="shoot-type">
                <SelectValueCn Placeholder="What are we capturing?" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="portrait">Portrait / Headshot</SelectItemCn>
                <SelectItemCn Value="family">Family Session</SelectItemCn>
                <SelectItemCn Value="couple">Couples / Engagement</SelectItemCn>
                <SelectItemCn Value="maternity">Maternity / Newborn</SelectItemCn>
                <SelectItemCn Value="event">Event Coverage</SelectItemCn>
                <SelectItemCn Value="product">Product / Commercial</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="date">Preferred Date</LabelCn>
              <InputCn id="date" type="date" />
            </div>
            <div class="space-y-2">
              <LabelCn for="time">Preferred Time</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="time">
                  <SelectValueCn Placeholder="Select time" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="morning">Morning (8-11am)</SelectItemCn>
                  <SelectItemCn Value="midday">Midday (11am-2pm)</SelectItemCn>
                  <SelectItemCn Value="afternoon">Afternoon (2-5pm)</SelectItemCn>
                  <SelectItemCn Value="golden">Golden Hour (5-7pm)</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="location">Location Preference</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="location">
                <SelectValueCn Placeholder="Where should we shoot?" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="studio">In-Studio</SelectItemCn>
                <SelectItemCn Value="outdoor">Outdoor Location</SelectItemCn>
                <SelectItemCn Value="client">Your Location</SelectItemCn>
                <SelectItemCn Value="destination">Destination</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="vision">Your Vision & Ideas</LabelCn>
            <TextareaCn
              id="vision"
              Placeholder="Describe the mood, style, or inspiration. Number of people, wardrobe ideas..."
              Rows="3"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="name">Your Name</LabelCn>
              <InputCn id="name" Placeholder="Sophia Martinez" />
            </div>
            <div class="space-y-2">
              <LabelCn for="phone">Phone</LabelCn>
              <InputCn id="phone" Placeholder="+1 (555) 000-0000" type="tel" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="email">Email</LabelCn>
            <InputCn id="email" Placeholder="@("sophia@@example.com")" type="email" />
          </div>

          <ButtonCn Class="w-full">
            <LucideCameraCn Size="16" Class="mr-2 h-4 w-4" />
            Request Session
          </ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            We'll confirm availability within 24 hours.
          </p>
        </form>
      </div>
    </section>

@code {
}
