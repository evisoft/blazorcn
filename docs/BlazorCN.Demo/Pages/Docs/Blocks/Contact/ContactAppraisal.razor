@* ========================================
   Block: contact-appraisal
   Title: Contact Appraisal
   Description: Property or item appraisal request form with asset type selection, value estimates, and service turnaround details for appraisers
   Long Description: Appraisal request form with stat bar showing turnaround, cost, and accuracy metrics. Captures asset details and purpose for fast, qualified intake.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-appraisal.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Request an Appraisal</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Get an accurate, certified valuation from our licensed appraisers.
          </p>
        </div>

        @* Stat bar *@
        <div class="grid grid-cols-3 border-b divide-x text-center">
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">3–5 days</p>
            <p class="text-xs text-muted-foreground">Turnaround</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">From $299</p>
            <p class="text-xs text-muted-foreground">Starting Cost</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">±3%</p>
            <p class="text-xs text-muted-foreground">Accuracy</p>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="appraisal-name">Full Name</LabelCn>
              <InputCn id="appraisal-name" Placeholder="Morgan Taylor" />
            </div>
            <div class="space-y-2">
              <LabelCn for="appraisal-email">Email</LabelCn>
              <InputCn id="appraisal-email" Placeholder="@("morgan@@example.com")" type="email" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="asset-type">Asset Type</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="asset-type">
                  <SelectValueCn Placeholder="Select type" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="residential">Residential Property</SelectItemCn>
                  <SelectItemCn Value="commercial">Commercial Property</SelectItemCn>
                  <SelectItemCn Value="jewelry">Jewelry / Watches</SelectItemCn>
                  <SelectItemCn Value="art">Art / Antiques</SelectItemCn>
                  <SelectItemCn Value="vehicle">Vehicle</SelectItemCn>
                  <SelectItemCn Value="other">Other</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="appraisal-purpose">Appraisal Purpose</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="appraisal-purpose">
                  <SelectValueCn Placeholder="Select purpose" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="sale">Buying / Selling</SelectItemCn>
                  <SelectItemCn Value="insurance">Insurance Coverage</SelectItemCn>
                  <SelectItemCn Value="estate">Estate Planning</SelectItemCn>
                  <SelectItemCn Value="legal">Legal / Divorce</SelectItemCn>
                  <SelectItemCn Value="tax">Tax / Donation</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="estimated-value">Estimated Value (if known)</LabelCn>
            <InputCn id="estimated-value" Placeholder="$50,000" />
          </div>

          <div class="space-y-2">
            <LabelCn for="appraisal-details">Item or Property Description</LabelCn>
            <TextareaCn
              id="appraisal-details"
              Placeholder="Provide location, condition, and any relevant details..."
              Rows="3"
            />
          </div>

          <ButtonCn Class="w-full">Request Appraisal</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            A certified appraiser will contact you within 1 business day.
          </p>
        </form>
      </div>
    </section>

@code {
}
