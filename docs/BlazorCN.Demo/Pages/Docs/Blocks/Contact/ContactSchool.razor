@* ========================================
   Block: contact-school
   Title: Contact School
   Description: School enrollment inquiry form with grade level selection, program preferences, and parent contact details for educational institutions
   Long Description: Course enrollment with payments
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-school.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Enrollment Inquiry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Interested in enrolling? Tell us about your student and we'll guide you through the process.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Grade Level</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-3"
                              Value="@_gradeLevel" ValueChanged="@((string? v) => _gradeLevel = v ?? "elementary")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _gradeLevel == "pre-k" ? "border-primary" : "hover:border-foreground")"
                             For="gl-pre-k">
                        <RadioGroupItemCn Id="gl-pre-k" Value="pre-k" />
                        <div>
                            <span class="text-sm font-medium">Pre-K</span>
                            <p class="text-xs text-muted-foreground">Ages 3-5</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _gradeLevel == "elementary" ? "border-primary" : "hover:border-foreground")"
                             For="gl-elementary">
                        <RadioGroupItemCn Id="gl-elementary" Value="elementary" />
                        <div>
                            <span class="text-sm font-medium">Elementary</span>
                            <p class="text-xs text-muted-foreground">Grades K-5</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _gradeLevel == "middle" ? "border-primary" : "hover:border-foreground")"
                             For="gl-middle">
                        <RadioGroupItemCn Id="gl-middle" Value="middle" />
                        <div>
                            <span class="text-sm font-medium">Middle School</span>
                            <p class="text-xs text-muted-foreground">Grades 6-8</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _gradeLevel == "high" ? "border-primary" : "hover:border-foreground")"
                             For="gl-high">
                        <RadioGroupItemCn Id="gl-high" Value="high" />
                        <div>
                            <span class="text-sm font-medium">High School</span>
                            <p class="text-xs text-muted-foreground">Grades 9-12</p>
                        </div>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="school-student-name">Student Name</LabelCn>
                    <InputCn id="school-student-name" Placeholder="Olivia Chen" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="current-grade">Current Grade</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="current-grade">
                            <SelectValueCn Placeholder="Select grade" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="pre-k">Pre-Kindergarten</SelectItemCn>
                            <SelectItemCn Value="k">Kindergarten</SelectItemCn>
                            <SelectItemCn Value="1">1st Grade</SelectItemCn>
                            <SelectItemCn Value="2">2nd Grade</SelectItemCn>
                            <SelectItemCn Value="3">3rd Grade</SelectItemCn>
                            <SelectItemCn Value="4">4th Grade</SelectItemCn>
                            <SelectItemCn Value="5">5th Grade</SelectItemCn>
                            <SelectItemCn Value="6">6th Grade</SelectItemCn>
                            <SelectItemCn Value="7">7th Grade</SelectItemCn>
                            <SelectItemCn Value="8">8th Grade</SelectItemCn>
                            <SelectItemCn Value="9">9th Grade</SelectItemCn>
                            <SelectItemCn Value="10">10th Grade</SelectItemCn>
                            <SelectItemCn Value="11">11th Grade</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="school-program">Program Interest</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="school-program">
                        <SelectValueCn Placeholder="Select a program" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="general">General Academics</SelectItemCn>
                        <SelectItemCn Value="stem">STEM Focus</SelectItemCn>
                        <SelectItemCn Value="arts">Arts &amp; Humanities</SelectItemCn>
                        <SelectItemCn Value="bilingual">Bilingual Immersion</SelectItemCn>
                        <SelectItemCn Value="montessori">Montessori</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="border-b"></div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="school-parent-name">Parent / Guardian Name</LabelCn>
                    <InputCn id="school-parent-name" Placeholder="David Chen" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="school-email">Email</LabelCn>
                    <InputCn id="school-email" Placeholder="@("david@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="school-phone">Phone</LabelCn>
                <InputCn id="school-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <div class="space-y-2">
                <LabelCn For="school-notes">Additional Information (Optional)</LabelCn>
                <TextareaCn id="school-notes"
                            Placeholder="Any special needs, sibling enrollment, or questions..."
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Request Enrollment Info</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Our admissions team will reach out within 2 business days to schedule a tour.
            </p>
        </form>
    </div>
</section>

@code {
    private string _gradeLevel = "elementary";
}
