@* ========================================
   Block: contact-influencer
   Title: Contact Influencer
   Description: Influencer collaboration request form with brand details, campaign scope, and content deliverables for marketing teams
   Long Description: Influencer collaboration form with at-a-glance campaign details. The stat bar sets expectations on budget, timeline, and deliverables before creators fill out their profile and content preferences.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-influencer.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Influencer Collaboration</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Partner with creators who connect authentically with your target audience.
          </p>
        </div>

        <div class="grid grid-cols-3 divide-x border-b text-center">
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">$2–10K</p>
            <p class="text-xs text-muted-foreground">Budget</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">4–8 wks</p>
            <p class="text-xs text-muted-foreground">Timeline</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">3–5</p>
            <p class="text-xs text-muted-foreground">Deliverables</p>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="name">Contact Name</LabelCn>
              <InputCn id="name" Placeholder="Jamie Torres" />
            </div>
            <div class="space-y-2">
              <LabelCn for="email">Work Email</LabelCn>
              <InputCn id="email" Placeholder="@("jamie@@brand.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="brand">Brand / Company</LabelCn>
            <InputCn id="brand" Placeholder="Glow Skincare Co." />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="platform">Primary Platform</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="platform">
                  <SelectValueCn Placeholder="Select platform" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="instagram">Instagram</SelectItemCn>
                  <SelectItemCn Value="tiktok">TikTok</SelectItemCn>
                  <SelectItemCn Value="youtube">YouTube</SelectItemCn>
                  <SelectItemCn Value="twitter">Twitter / X</SelectItemCn>
                  <SelectItemCn Value="multi">Multi-Platform</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="content-type">Content Type</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="content-type">
                  <SelectValueCn Placeholder="Select type" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="review">Product Review</SelectItemCn>
                  <SelectItemCn Value="unboxing">Unboxing</SelectItemCn>
                  <SelectItemCn Value="tutorial">Tutorial / How-To</SelectItemCn>
                  <SelectItemCn Value="lifestyle">Lifestyle Integration</SelectItemCn>
                  <SelectItemCn Value="giveaway">Giveaway Campaign</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="audience">Target Audience Size</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="audience">
                  <SelectValueCn Placeholder="Creator tier" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="nano">Nano (1K–10K)</SelectItemCn>
                  <SelectItemCn Value="micro">Micro (10K–50K)</SelectItemCn>
                  <SelectItemCn Value="mid">Mid-Tier (50K–500K)</SelectItemCn>
                  <SelectItemCn Value="macro">Macro (500K–1M)</SelectItemCn>
                  <SelectItemCn Value="mega">Mega (1M+)</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="budget">Campaign Budget</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="budget">
                  <SelectValueCn Placeholder="Select budget" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="500-2k">$500 – $2,000</SelectItemCn>
                  <SelectItemCn Value="2k-5k">$2,000 – $5,000</SelectItemCn>
                  <SelectItemCn Value="5k-10k">$5,000 – $10,000</SelectItemCn>
                  <SelectItemCn Value="10k+">$10,000+</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="brief">Campaign Brief</LabelCn>
            <TextareaCn
              id="brief"
              Placeholder="Describe your campaign goals, key messages, and any creative direction..."
              Rows="2"
            />
          </div>

          <ButtonCn Class="w-full">Submit Collaboration Request</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            Our partnerships team will match you with creators within 3 business days.
          </p>
        </form>
      </div>
    </section>

@code {
}
