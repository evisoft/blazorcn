@* ========================================
   Block: contact-newsletter
   Title: Contact Newsletter
   Description: Contact section with newsletter signup, social media links, and quick contact form in a multi-column layout
   Long Description: Newsletter signup with subscriber count. Super simple email capture—perfect for blogs and community sites.
   Dependencies: ButtonCn, InputCn, LabelCn
   Source: original/blocks/contact/contact-newsletter.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Stay Updated</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Join our newsletter for weekly updates and exclusive content.
          </p>
        </div>

        <div class="border-b px-6 py-4">
          <div class="flex items-center gap-3">
            <LucideUsersCn Size="16" Class="h-4 w-4 text-muted-foreground" />
            <div>
              <p class="text-lg font-semibold tabular-nums">12,847</p>
              <p class="text-xs text-muted-foreground">subscribers</p>
            </div>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="newsletter-name">Name (Optional)</LabelCn>
              <InputCn id="newsletter-name" Placeholder="Your name" />
            </div>
            <div class="space-y-2">
              <LabelCn for="newsletter-email">Email</LabelCn>
              <InputCn id="newsletter-email" Placeholder="@("you@@example.com")" type="email" />
            </div>
          </div>

          <ButtonCn Class="w-full">
            <LucideMailCn Size="16" Class="mr-2 h-4 w-4" />
            Subscribe
          </ButtonCn>

          <p class="text-center text-xs text-muted-foreground">No spam. Unsubscribe anytime.</p>
        </form>
      </div>
    </section>

@code {
}
