@* ============================================================
   Block: contact-report
   Title: ContactReport
   Description: Issue reporting form with category selection, severity levels, and file attachment for bug tracking
   Source: original/blocks/contact/contact-report.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Report an Issue</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Help us improve by reporting bugs or requesting features.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="report-category">Category</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="report-category">
                        <SelectValueCn Placeholder="What type of issue?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="bug">Bug / Something Broken</SelectItemCn>
                        <SelectItemCn Value="ui">UI / Visual Issue</SelectItemCn>
                        <SelectItemCn Value="crash">Crash / Error</SelectItemCn>
                        <SelectItemCn Value="feature">Feature Request</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="report-title">Issue Title</LabelCn>
                <InputCn id="report-title" Placeholder="Brief description of the problem" />
            </div>

            <div class="space-y-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="alert-triangle" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <LabelCn>Severity</LabelCn>
                </div>
                <RadioGroupCn Class="grid grid-cols-2 gap-2" @bind-Value="_severity">
                    @foreach (var sev in _severities)
                    {
                        var item = sev;
                        <LabelCn Class="flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors has-[[data-state=checked]]:border-primary hover:border-foreground"
                                 For="@($"severity-{item.Value}")">
                            <RadioGroupItemCn Id="@($"severity-{item.Value}")" Value="@item.Value" />
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@item.Label</span>
                                    @if (item.ShowBadge)
                                    {
                                        <BadgeCn Class="text-[10px]" Variant="BadgeVariant.Destructive">
                                            Urgent
                                        </BadgeCn>
                                    }
                                </div>
                                <p class="text-xs text-muted-foreground">@item.Desc</p>
                            </div>
                        </LabelCn>
                    }
                </RadioGroupCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="report-description">What happened?</LabelCn>
                <TextareaCn id="report-description" Placeholder="Describe the issue..." rows="3" />
            </div>

            <div class="space-y-2">
                <LabelCn>Attachments (Optional)</LabelCn>
                <label for="report-files"
                       class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-dashed p-4 transition-colors hover:border-foreground">
                    <LucideIconCn Name="upload" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <span class="text-sm text-muted-foreground">Upload screenshots or files</span>
                    <input id="report-files"
                           accept="image/*,.pdf,.txt,.log"
                           class="hidden"
                           multiple
                           type="file" />
                </label>
            </div>

            <div class="space-y-2">
                <LabelCn For="report-email">Your Email</LabelCn>
                <InputCn id="report-email" Placeholder="@("you@example.com")" Type="email" />
            </div>

            <ButtonCn Class="w-full">
                <LucideIconCn Name="bug" Size="16" Class="mr-2 h-4 w-4" />
                Submit Report
            </ButtonCn>
        </form>
    </div>
</section>

@code {
    private string _severity = "medium";

    private record SeverityLevel(string Value, string Label, string Desc, bool ShowBadge);

    private static readonly SeverityLevel[] _severities =
    [
        new("critical", "Critical", "System unusable", true),
        new("high", "High", "Feature broken", false),
        new("medium", "Medium", "Workaround exists", false),
        new("low", "Low", "Minor issue", false),
    ];
}
