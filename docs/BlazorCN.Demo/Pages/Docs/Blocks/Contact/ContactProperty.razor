@* ========================================
   Block: contact-property
   Title: Contact Property
   Description: Property listing inquiry form with budget range, property type radio cards, bedroom preferences, and move-in timeline for real estate agents
   Long Description: Consultation booking with pricing
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-property.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Property Inquiry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us what you're looking for and we'll match you with available listings.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Property Type</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-3 sm:grid-cols-4"
                              Value="@_propertyType" ValueChanged="@((string? v) => _propertyType = v ?? "house")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1.5 rounded-lg border p-3 text-center transition-colors", _propertyType == "house" ? "border-primary" : "hover:border-foreground")"
                             For="type-house">
                        <RadioGroupItemCn Class="sr-only" Id="type-house" Value="house" />
                        <span class="text-sm font-medium">House</span>
                        <span class="text-xs text-muted-foreground">Single-family</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1.5 rounded-lg border p-3 text-center transition-colors", _propertyType == "apartment" ? "border-primary" : "hover:border-foreground")"
                             For="type-apartment">
                        <RadioGroupItemCn Class="sr-only" Id="type-apartment" Value="apartment" />
                        <span class="text-sm font-medium">Apartment</span>
                        <span class="text-xs text-muted-foreground">Rental unit</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1.5 rounded-lg border p-3 text-center transition-colors", _propertyType == "condo" ? "border-primary" : "hover:border-foreground")"
                             For="type-condo">
                        <RadioGroupItemCn Class="sr-only" Id="type-condo" Value="condo" />
                        <span class="text-sm font-medium">Condo</span>
                        <span class="text-xs text-muted-foreground">Owned unit</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1.5 rounded-lg border p-3 text-center transition-colors", _propertyType == "land" ? "border-primary" : "hover:border-foreground")"
                             For="type-land">
                        <RadioGroupItemCn Class="sr-only" Id="type-land" Value="land" />
                        <span class="text-sm font-medium">Land</span>
                        <span class="text-xs text-muted-foreground">Vacant lot</span>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="property-budget">Budget Range</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="property-budget">
                            <SelectValueCn Placeholder="Select budget" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="under-250k">Under $250,000</SelectItemCn>
                            <SelectItemCn Value="250k-500k">$250,000 - $500,000</SelectItemCn>
                            <SelectItemCn Value="500k-750k">$500,000 - $750,000</SelectItemCn>
                            <SelectItemCn Value="750k-1m">$750,000 - $1,000,000</SelectItemCn>
                            <SelectItemCn Value="1m-plus">$1,000,000+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="property-bedrooms">Bedrooms</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="property-bedrooms">
                            <SelectValueCn Placeholder="Select bedrooms" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="studio">Studio</SelectItemCn>
                            <SelectItemCn Value="1">1 Bedroom</SelectItemCn>
                            <SelectItemCn Value="2">2 Bedrooms</SelectItemCn>
                            <SelectItemCn Value="3">3 Bedrooms</SelectItemCn>
                            <SelectItemCn Value="4-plus">4+ Bedrooms</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="property-location">Preferred Location</LabelCn>
                    <InputCn id="property-location" Placeholder="City, neighborhood, or ZIP" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="property-timeline">Move-In Timeline</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="property-timeline">
                            <SelectValueCn Placeholder="When do you need it?" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="asap">As soon as possible</SelectItemCn>
                            <SelectItemCn Value="1-3">1 - 3 months</SelectItemCn>
                            <SelectItemCn Value="3-6">3 - 6 months</SelectItemCn>
                            <SelectItemCn Value="6-plus">6+ months</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="property-name">Full Name</LabelCn>
                    <InputCn id="property-name" Placeholder="Jordan Park" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="property-email">Email</LabelCn>
                    <InputCn id="property-email" Placeholder="@("jordan@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="property-notes">Additional Preferences</LabelCn>
                <TextareaCn id="property-notes"
                            Placeholder="Garage, yard, pet-friendly, school district, accessibility needs..."
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Send Property Inquiry</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                A local agent will reach out with matching listings within 24 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private string _propertyType = "house";
}
