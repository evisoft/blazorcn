@* ========================================
   Block: contact-event
   Title: Contact Event
   Description: Event registration form with ticket selection, attendee details, and dietary preferences for conferences
   Long Description: Register attendees with ticket selection and dietary needs. Unique: event details summary with date, location, and capacity info.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn
   Source: original/blocks/contact/contact-event.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Event Registration</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Secure your spot at our upcoming conference.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <div class="rounded-lg border p-4">
                <div class="mb-3 flex items-start gap-3">
                    <LucideCalendarCn Class="mt-0.5 h-4 w-4 text-muted-foreground" Size="16" />
                    <div>
                        <p class="text-sm font-medium">Design Conference 2025</p>
                        <p class="text-xs text-muted-foreground">
                            March 15-16, 2025 &bull; 9:00 AM - 6:00 PM
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <LucideMapPinCn Class="mt-0.5 h-4 w-4 text-muted-foreground" Size="16" />
                    <p class="text-xs text-muted-foreground">Convention Center, San Francisco, CA</p>
                </div>
            </div>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">Select Ticket</LabelCn>
            <RadioGroupCn Class="space-y-2" Value="@_ticket" ValueChanged="@((string? v) => _ticket = v ?? "standard")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors", _ticket == "early" ? "border-primary" : "hover:border-foreground")"
                         For="early">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="early" Value="early" />
                        <span class="text-sm font-medium">Early Bird</span>
                    </div>
                    <div class="text-right">
                        <span class="text-sm font-medium">$99</span>
                        <span class="ml-2 text-xs text-muted-foreground line-through">$149</span>
                    </div>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors", _ticket == "standard" ? "border-primary" : "hover:border-foreground")"
                         For="standard">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="standard" Value="standard" />
                        <span class="text-sm font-medium">Standard</span>
                    </div>
                    <span class="text-sm font-medium">$149</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors", _ticket == "vip" ? "border-primary" : "hover:border-foreground")"
                         For="vip">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="vip" Value="vip" />
                        <div>
                            <span class="text-sm font-medium">VIP Access</span>
                            <p class="text-xs text-muted-foreground">Workshop + networking dinner</p>
                        </div>
                    </div>
                    <span class="text-sm font-medium">$299</span>
                </LabelCn>
            </RadioGroupCn>
            <p class="mt-3 text-xs text-muted-foreground">Only 23 early bird tickets remaining</p>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="event-first-name">First Name</LabelCn>
                    <InputCn id="event-first-name" Placeholder="John" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="event-last-name">Last Name</LabelCn>
                    <InputCn id="event-last-name" Placeholder="Doe" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="event-email">Email</LabelCn>
                <InputCn id="event-email" Placeholder="@("john@company.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="event-company">Company</LabelCn>
                <InputCn id="event-company" Placeholder="Acme Inc." />
            </div>

            <div class="space-y-2">
                <LabelCn For="event-dietary">Dietary Requirements</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="event-dietary">
                        <SelectValueCn Placeholder="Select dietary needs" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="none">No restrictions</SelectItemCn>
                        <SelectItemCn Value="vegetarian">Vegetarian</SelectItemCn>
                        <SelectItemCn Value="vegan">Vegan</SelectItemCn>
                        <SelectItemCn Value="gluten-free">Gluten-free</SelectItemCn>
                        <SelectItemCn Value="halal">Halal</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <ButtonCn Class="w-full">Complete Registration</ButtonCn>
        </form>
    </div>
</section>

@code {
    private string _ticket = "standard";
}
