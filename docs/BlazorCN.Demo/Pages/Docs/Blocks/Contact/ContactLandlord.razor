@* ========================================
   Block: contact-landlord
   Title: Contact Landlord
   Description: Tenant-to-landlord issue report form with unit selection, urgency radio cards, issue category, and photo upload option for property management
   Long Description: Maintenance request with scheduling
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-landlord.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Report an Issue</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Describe the problem and we'll get maintenance on it as soon as possible.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="unit">Unit Number</LabelCn>
              <InputCn id="unit" Placeholder="e.g. 4B" />
            </div>
            <div class="space-y-2">
              <LabelCn for="category">Issue Category</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="category">
                  <SelectValueCn Placeholder="Select category" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="plumbing">Plumbing</SelectItemCn>
                  <SelectItemCn Value="electrical">Electrical</SelectItemCn>
                  <SelectItemCn Value="hvac">Heating / Cooling</SelectItemCn>
                  <SelectItemCn Value="appliance">Appliance</SelectItemCn>
                  <SelectItemCn Value="structural">Doors / Windows</SelectItemCn>
                  <SelectItemCn Value="pest">Pest Control</SelectItemCn>
                  <SelectItemCn Value="other">Other</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-3">
            <LabelCn>Urgency Level</LabelCn>
            <div class="grid grid-cols-3 gap-2">
              <label class="flex cursor-pointer flex-col items-center gap-1.5 rounded-md border p-3 text-center transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                <input class="sr-only" name="urgency" type="radio" value="routine" />
                <LucideClockCn Size="16" Class="size-4" />
                <span class="text-xs font-medium">Routine</span>
              </label>
              <label class="flex cursor-pointer flex-col items-center gap-1.5 rounded-md border p-3 text-center transition-colors hover:border-foreground has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground">
                <input class="sr-only" name="urgency" type="radio" value="important" />
                <LucideWrenchCn Size="16" Class="size-4" />
                <span class="text-xs font-medium">Important</span>
              </label>
              <label class="flex cursor-pointer flex-col items-center gap-1.5 rounded-md border border-red-200 p-3 text-center transition-colors hover:border-red-400 has-[:checked]:border-red-500 has-[:checked]:bg-red-500 has-[:checked]:text-white dark:border-red-900 dark:hover:border-red-700 dark:has-[:checked]:border-red-600 dark:has-[:checked]:bg-red-600">
                <input class="sr-only" name="urgency" type="radio" value="emergency" />
                <LucideTriangleAlertCn Size="16" Class="size-4" />
                <span class="text-xs font-medium">Emergency</span>
              </label>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="description">Describe the Issue</LabelCn>
            <TextareaCn
              id="description"
              Placeholder="Where is the problem? When did it start? Is it getting worse?"
              Rows="3"
            />
          </div>

          <div class="space-y-2">
            <LabelCn for="availability">Preferred Access Time</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="availability">
                <SelectValueCn Placeholder="When can we enter?" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="anytime">Anytime (leave key)</SelectItemCn>
                <SelectItemCn Value="morning">Morning (8am–12pm)</SelectItemCn>
                <SelectItemCn Value="afternoon">Afternoon (12pm–5pm)</SelectItemCn>
                <SelectItemCn Value="evening">Evening (5pm–8pm)</SelectItemCn>
                <SelectItemCn Value="weekend">Weekend only</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="tenant-name">Your Name</LabelCn>
              <InputCn id="tenant-name" Placeholder="Jamie Park" />
            </div>
            <div class="space-y-2">
              <LabelCn for="phone">Phone</LabelCn>
              <InputCn id="phone" Placeholder="+1 (555) 000-0000" type="tel" />
            </div>
          </div>

          <ButtonCn Class="w-full">Submit Maintenance Request</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            You'll receive a confirmation email with your request tracking number.
          </p>
        </form>
      </div>
    </section>

@code {
}
