@* ========================================
   Block: contact-childcare
   Title: Contact Childcare
   Description: Childcare enrollment inquiry form with child age, program selection, schedule needs, and family information for daycare centers
   Long Description: Childcare enrollment with age group selection and schedule picker. Visual age group cards and weekday toggles simplify program matching.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, RadioGroupCn, SelectCn
   Source: original/blocks/contact/contact-childcare.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Enroll Your Child Today</h2>
            <p class="text-xs text-muted-foreground">
                A nurturing environment where little ones learn, play, and grow.
            </p>
        </div>

        @* Age group selection cards *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Child's Age Group
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-2 gap-3 sm:grid-cols-3"
                          Value="@_ageGroup" ValueChanged="@((string? v) => _ageGroup = v ?? "")">
                @foreach (var age in _ageGroups)
                {
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-4 text-center transition-colors", _ageGroup == age.Value ? "border-primary" : "hover:border-foreground")"
                             For="@($"age-{age.Value}")">
                        <RadioGroupItemCn Class="sr-only" Id="@($"age-{age.Value}")" Value="@age.Value" />
                        <span class="mb-1 text-2xl">@age.Emoji</span>
                        <span class="text-sm font-medium">@age.Label</span>
                        <span class="text-[10px] text-muted-foreground">@age.Ages</span>
                    </LabelCn>
                }
            </RadioGroupCn>
        </div>

        @* Weekday toggle buttons *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Days Needed
            </LabelCn>
            <div class="flex gap-2">
                @foreach (var day in _weekdays)
                {
                    <button type="button"
                            class="@Cn.Merge("flex-1 rounded-lg border py-3 text-sm font-medium transition-colors", _selectedDays.Contains(day.Id) ? "border-primary bg-primary text-primary-foreground" : "hover:border-foreground")"
                            @onclick="@(() => ToggleDay(day.Id))">
                        @day.Label
                    </button>
                }
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                @_selectedDays.Count day@(_selectedDays.Count != 1 ? "s" : "") per week selected
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="childcare-program">Program Type</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="childcare-program">
                        <SelectValueCn Placeholder="Select program" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="fulltime">Full-Time (5 days/week)</SelectItemCn>
                        <SelectItemCn Value="parttime">Part-Time (2-3 days/week)</SelectItemCn>
                        <SelectItemCn Value="beforeafter">Before/After School</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="child-name">Child's Name</LabelCn>
                    <InputCn id="child-name" Placeholder="Emma" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="child-dob">Date of Birth</LabelCn>
                    <InputCn id="child-dob" Type="date" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="childcare-parent-name">Parent/Guardian Name</LabelCn>
                    <InputCn id="childcare-parent-name" Placeholder="Sarah Johnson" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="childcare-phone">Phone</LabelCn>
                    <InputCn id="childcare-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="childcare-email">Email</LabelCn>
                <InputCn id="childcare-email" Placeholder="@("sarah@example.com")" Type="email" />
            </div>

            <div class="flex items-start gap-2 pt-2">
                <CheckboxCn id="tour" Checked="true" />
                <LabelCn Class="text-xs font-normal leading-tight text-muted-foreground"
                         For="tour">
                    I'd like to schedule a facility tour
                </LabelCn>
            </div>

            <ButtonCn Class="w-full">Start Enrollment Process</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                We'll contact you within 24 hours to schedule your tour.
            </p>
        </form>
    </div>
</section>

@code {
    private record AgeGroup(string Value, string Label, string Ages, string Emoji);
    private record Weekday(string Id, string Label);

    private string _ageGroup = "";
    private List<string> _selectedDays = ["mon", "tue", "wed", "thu", "fri"];

    private static readonly AgeGroup[] _ageGroups =
    [
        new("infant", "Infant", "6 wks-12 mo", "\ud83d\udc76"),
        new("toddler", "Toddler", "1-2 years", "\ud83e\uddd2"),
        new("preschool", "Preschool", "3-4 years", "\ud83c\udfa8"),
        new("prek", "Pre-K", "4-5 years", "\ud83d\udcda"),
        new("schoolage", "School Age", "5-12 years", "\ud83c\udf92"),
    ];

    private static readonly Weekday[] _weekdays =
    [
        new("mon", "Mon"), new("tue", "Tue"), new("wed", "Wed"),
        new("thu", "Thu"), new("fri", "Fri"),
    ];

    private void ToggleDay(string day)
    {
        if (_selectedDays.Contains(day))
            _selectedDays.Remove(day);
        else
            _selectedDays.Add(day);
    }
}
