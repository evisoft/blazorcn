@* ========================================
   Block: contact-audit
   Title: Contact Audit
   Description: Business and website audit request form with scope checkboxes, industry selection, and goal description for consulting agencies
   Long Description: Consultation booking with pricing
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-audit.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Request an Audit</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Get a detailed analysis of your website or business operations.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="space-y-2">
            <LabelCn for="audit-website">Website URL</LabelCn>
            <InputCn id="audit-website" Placeholder="https://example.com" type="url" />
          </div>

          <div class="space-y-3">
            <LabelCn>Audit Scope</LabelCn>
            <div class="grid grid-cols-2 gap-3">
              <div class="flex items-start gap-2 rounded-md border p-3">
                <CheckboxCn id="scope-seo" Class="mt-0.5" />
                <div>
                  <LabelCn Class="text-sm font-normal" for="scope-seo">
                    SEO
                  </LabelCn>
                  <p class="text-xs text-muted-foreground">Rankings, crawl, backlinks</p>
                </div>
              </div>
              <div class="flex items-start gap-2 rounded-md border p-3">
                <CheckboxCn id="scope-security" Class="mt-0.5" />
                <div>
                  <LabelCn Class="text-sm font-normal" for="scope-security">
                    Security
                  </LabelCn>
                  <p class="text-xs text-muted-foreground">Vulnerabilities, compliance</p>
                </div>
              </div>
              <div class="flex items-start gap-2 rounded-md border p-3">
                <CheckboxCn id="scope-performance" Class="mt-0.5" />
                <div>
                  <LabelCn Class="text-sm font-normal" for="scope-performance">
                    Performance
                  </LabelCn>
                  <p class="text-xs text-muted-foreground">Speed, Core Web Vitals</p>
                </div>
              </div>
              <div class="flex items-start gap-2 rounded-md border p-3">
                <CheckboxCn id="scope-a11y" Class="mt-0.5" />
                <div>
                  <LabelCn Class="text-sm font-normal" for="scope-a11y">
                    Accessibility
                  </LabelCn>
                  <p class="text-xs text-muted-foreground">WCAG, screen readers</p>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="audit-industry">Industry</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="audit-industry">
                <SelectValueCn Placeholder="Select your industry" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="saas">SaaS / Technology</SelectItemCn>
                <SelectItemCn Value="ecommerce">E-Commerce / Retail</SelectItemCn>
                <SelectItemCn Value="finance">Finance / Banking</SelectItemCn>
                <SelectItemCn Value="healthcare">Healthcare</SelectItemCn>
                <SelectItemCn Value="education">Education</SelectItemCn>
                <SelectItemCn Value="other">Other</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="audit-goals">Primary Goals</LabelCn>
            <TextareaCn
              id="audit-goals"
              Placeholder="What are you hoping to improve? Any known issues or concerns?"
              Rows="2"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="audit-name">Full Name</LabelCn>
              <InputCn id="audit-name" Placeholder="Jordan Lee" />
            </div>
            <div class="space-y-2">
              <LabelCn for="audit-email">Work Email</LabelCn>
              <InputCn id="audit-email" Placeholder="@("jordan@@company.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="audit-company">Company Name</LabelCn>
            <InputCn id="audit-company" Placeholder="Acme Inc." />
          </div>

          <div class="flex items-center gap-3 rounded-lg border p-3">
            <LucideShieldCheckCn Size="20" Class="size-5 text-muted-foreground" />
            <div>
              <p class="text-sm font-medium">Confidential Assessment</p>
              <p class="text-xs text-muted-foreground">
                All findings are shared under NDA upon request
              </p>
            </div>
          </div>

          <ButtonCn Class="w-full">Submit Audit Request</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            Preliminary findings delivered within 5 business days.
          </p>
        </form>
      </div>
    </section>

@code {
}
