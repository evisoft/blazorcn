@* ========================================
   Block: contact-nonprofit
   Title: Contact Nonprofit
   Description: Nonprofit inquiry form with mission area selection, support type, and organization details for charities and foundations
   Long Description: Volunteer signup with availability
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-nonprofit.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Support Our Mission</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Choose how you'd like to contribute and make an impact.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">
                How would you like to help?
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-2 gap-2 sm:grid-cols-4"
                          Value="@_supportType" ValueChanged="@((string? v) => _supportType = v ?? "donate")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _supportType == "donate" ? "border-primary" : "hover:border-foreground")"
                         For="type-donate">
                    <RadioGroupItemCn Class="sr-only" Id="type-donate" Value="donate" />
                    <span class="text-xs font-medium">Donate</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">Financial gift</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _supportType == "volunteer" ? "border-primary" : "hover:border-foreground")"
                         For="type-volunteer">
                    <RadioGroupItemCn Class="sr-only" Id="type-volunteer" Value="volunteer" />
                    <span class="text-xs font-medium">Volunteer</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">Give your time</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _supportType == "partner" ? "border-primary" : "hover:border-foreground")"
                         For="type-partner">
                    <RadioGroupItemCn Class="sr-only" Id="type-partner" Value="partner" />
                    <span class="text-xs font-medium">Partner</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">Collaborate</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _supportType == "sponsor" ? "border-primary" : "hover:border-foreground")"
                         For="type-sponsor">
                    <RadioGroupItemCn Class="sr-only" Id="type-sponsor" Value="sponsor" />
                    <span class="text-xs font-medium">Sponsor</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">Fund a program</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="Angela Torres" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("angela@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="organization">Organization (if applicable)</LabelCn>
                <InputCn id="organization" Placeholder="Company or group name" />
            </div>

            <div class="space-y-2">
                <LabelCn For="mission">Mission Area of Interest</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="mission">
                        <SelectValueCn Placeholder="Select a cause" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="education">Education &amp; Literacy</SelectItemCn>
                        <SelectItemCn Value="health">Health &amp; Wellness</SelectItemCn>
                        <SelectItemCn Value="environment">Environment &amp; Climate</SelectItemCn>
                        <SelectItemCn Value="housing">Housing &amp; Homelessness</SelectItemCn>
                        <SelectItemCn Value="youth">Youth Development</SelectItemCn>
                        <SelectItemCn Value="general">General Support</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="message">Tell us about your interest</LabelCn>
                <TextareaCn id="message" Placeholder="How you'd like to get involved..." rows="2" />
            </div>

            <ButtonCn Class="w-full">Get Involved</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We're a registered 501(c)(3). All donations are tax-deductible.
            </p>
        </form>
    </div>
</section>

@code {
    private string _supportType = "donate";
}
