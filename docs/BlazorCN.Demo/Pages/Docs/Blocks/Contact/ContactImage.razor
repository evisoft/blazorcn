@* ========================================
   Block: contact-image
   Title: Contact Image
   Description: Contact form with split-screen layout featuring form on left and full-height background image on right side
   Long Description: Split-screen contact form with form on left and image placeholder on right.
   Dependencies: ButtonCn, InputCn, LabelCn, TextareaCn
   Source: original/blocks/contact/contact-image.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="grid min-h-[500px] overflow-hidden rounded-lg border bg-card md:grid-cols-2">
        <div class="flex items-center p-6 sm:p-8">
          <div class="w-full">
            <h2 class="mb-2 text-sm font-medium">Contact Us</h2>
            <p class="mb-6 text-xs text-muted-foreground">
              Send us a message and we'll get back to you within 24 hours.
            </p>
            <form class="space-y-4">
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                  <LabelCn for="first-name">First Name</LabelCn>
                  <InputCn id="first-name" Placeholder="John" />
                </div>
                <div class="space-y-2">
                  <LabelCn for="last-name">Last Name</LabelCn>
                  <InputCn id="last-name" Placeholder="Doe" />
                </div>
              </div>
              <div class="space-y-2">
                <LabelCn for="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("john@@example.com")" type="email" />
              </div>
              <div class="space-y-2">
                <LabelCn for="message">Message</LabelCn>
                <TextareaCn id="message" Placeholder="How can we help?" Rows="4" />
              </div>
              <ButtonCn Class="w-full">Send Message</ButtonCn>
            </form>
          </div>
        </div>
        <div class="hidden bg-muted md:block"></div>
      </div>
    </section>

