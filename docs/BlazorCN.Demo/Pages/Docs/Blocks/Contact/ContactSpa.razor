@* ========================================
   Block: contact-spa
   Title: Contact Spa
   Description: Spa and wellness booking form with service type selection, therapist preferences, and scheduling options for wellness businesses
   Long Description: Meeting scheduler with time slots
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-spa.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Book a Spa Treatment</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Choose your treatment and let us create a personalized wellness experience.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Service Type</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-3"
                              Value="@_service" ValueChanged="@((string? v) => _service = v ?? "massage")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1 rounded-lg border p-4 text-center transition-colors", _service == "massage" ? "border-primary" : "hover:border-foreground")"
                             For="svc-massage">
                        <RadioGroupItemCn Class="sr-only" Id="svc-massage" Value="massage" />
                        <span class="text-sm font-medium">Massage</span>
                        <span class="text-xs text-muted-foreground">From 60 min</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1 rounded-lg border p-4 text-center transition-colors", _service == "facial" ? "border-primary" : "hover:border-foreground")"
                             For="svc-facial">
                        <RadioGroupItemCn Class="sr-only" Id="svc-facial" Value="facial" />
                        <span class="text-sm font-medium">Facial</span>
                        <span class="text-xs text-muted-foreground">From 45 min</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1 rounded-lg border p-4 text-center transition-colors", _service == "body" ? "border-primary" : "hover:border-foreground")"
                             For="svc-body">
                        <RadioGroupItemCn Class="sr-only" Id="svc-body" Value="body" />
                        <span class="text-sm font-medium">Body</span>
                        <span class="text-xs text-muted-foreground">From 50 min</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-1 rounded-lg border p-4 text-center transition-colors", _service == "nails" ? "border-primary" : "hover:border-foreground")"
                             For="svc-nails">
                        <RadioGroupItemCn Class="sr-only" Id="svc-nails" Value="nails" />
                        <span class="text-sm font-medium">Nails</span>
                        <span class="text-xs text-muted-foreground">From 30 min</span>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="treatment">Specific Treatment</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="treatment">
                        <SelectValueCn Placeholder="Select a treatment" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="swedish">Swedish Massage \u2014 $95</SelectItemCn>
                        <SelectItemCn Value="deep-tissue">Deep Tissue Massage \u2014 $115</SelectItemCn>
                        <SelectItemCn Value="hot-stone">Hot Stone Massage \u2014 $130</SelectItemCn>
                        <SelectItemCn Value="classic-facial">Classic Facial \u2014 $85</SelectItemCn>
                        <SelectItemCn Value="hydrating-facial">Hydrating Facial \u2014 $110</SelectItemCn>
                        <SelectItemCn Value="body-scrub">Body Scrub \u2014 $90</SelectItemCn>
                        <SelectItemCn Value="manicure">Manicure &amp; Pedicure \u2014 $65</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="spa-date">Preferred Date</LabelCn>
                    <InputCn id="spa-date" Type="date" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="spa-time">Preferred Time</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="spa-time">
                            <SelectValueCn Placeholder="Select time" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="9am">9:00 AM</SelectItemCn>
                            <SelectItemCn Value="10am">10:00 AM</SelectItemCn>
                            <SelectItemCn Value="11am">11:00 AM</SelectItemCn>
                            <SelectItemCn Value="1pm">1:00 PM</SelectItemCn>
                            <SelectItemCn Value="2pm">2:00 PM</SelectItemCn>
                            <SelectItemCn Value="3pm">3:00 PM</SelectItemCn>
                            <SelectItemCn Value="4pm">4:00 PM</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="spa-name">Full Name</LabelCn>
                    <InputCn id="spa-name" Placeholder="Sofia Martinez" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="spa-email">Email</LabelCn>
                    <InputCn id="spa-email" Placeholder="@("sofia@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="spa-phone">Phone</LabelCn>
                <InputCn id="spa-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <div class="space-y-2">
                <LabelCn For="preferences">Preferences or Allergies (Optional)</LabelCn>
                <TextareaCn id="preferences"
                            Placeholder="Pressure preference, allergies, areas of focus..."
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Book Appointment</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Arrive 15 minutes early. Free cancellation up to 24 hours before your appointment.
            </p>
        </form>
    </div>
</section>

@code {
    private string _service = "massage";
}
