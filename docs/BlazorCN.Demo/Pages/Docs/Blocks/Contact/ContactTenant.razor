@* ============================================================
   Block: contact-tenant
   Title: ContactTenant
   Description: Rental inquiry form with move-in date, lease terms, and household details for property managers
   Source: original/blocks/contact/contact-tenant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-6 py-5">
      <h2 class="text-sm font-medium">Rental Inquiry</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        Interested in this property? Tell us about yourself to schedule a viewing.
      </p>
    </div>

    <form class="space-y-4 p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="tenant-move-date">Desired Move-in Date</LabelCn>
          <InputCn id="tenant-move-date" type="date" />
        </div>
        <div class="space-y-2">
          <LabelCn for="lease-term">Preferred Lease Term</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="lease-term">
              <SelectValueCn Placeholder="Select lease length" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="6">6 months</SelectItemCn>
              <SelectItemCn Value="12">12 months</SelectItemCn>
              <SelectItemCn Value="18">18 months</SelectItemCn>
              <SelectItemCn Value="24">24 months</SelectItemCn>
              <SelectItemCn Value="flexible">Flexible</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="occupants">Number of Occupants</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="occupants">
              <SelectValueCn Placeholder="How many?" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="1">1 person</SelectItemCn>
              <SelectItemCn Value="2">2 people</SelectItemCn>
              <SelectItemCn Value="3">3 people</SelectItemCn>
              <SelectItemCn Value="4">4+ people</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
        <div class="space-y-2">
          <LabelCn for="tenant-income">Monthly Income</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="tenant-income">
              <SelectValueCn Placeholder="Select range" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="under-3x">Under 3x rent</SelectItemCn>
              <SelectItemCn Value="3x-4x">3x @("–") 4x rent</SelectItemCn>
              <SelectItemCn Value="4x-5x">4x @("–") 5x rent</SelectItemCn>
              <SelectItemCn Value="5x+">5x+ rent</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
      </div>

      <div class="border-b"></div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="tenant-first-name">First Name</LabelCn>
          <InputCn id="tenant-first-name" Placeholder="Michael" />
        </div>
        <div class="space-y-2">
          <LabelCn for="tenant-last-name">Last Name</LabelCn>
          <InputCn id="tenant-last-name" Placeholder="Chen" />
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="tenant-email">Email</LabelCn>
          <InputCn id="tenant-email" Placeholder="@("michael@example.com")" type="email" />
        </div>
        <div class="space-y-2">
          <LabelCn for="tenant-phone">Phone</LabelCn>
          <InputCn id="tenant-phone" Placeholder="+1 (555) 000-0000" type="tel" />
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="tenant-message">Additional Information (Optional)</LabelCn>
        <TextareaCn
          id="tenant-message"
          Placeholder="Pets, parking needs, rental history, or any questions..."
          Rows="2"
        />
      </div>

      <div class="flex items-start gap-2">
        <CheckboxCn id="tenant-consent" />
        <LabelCn Class="text-sm font-normal leading-tight" for="tenant-consent">
          I consent to a credit and background check as part of the application
        </LabelCn>
      </div>

      <div class="flex items-center gap-3 rounded-lg border p-3">
        <LucideIconCn Name="building" Size="20" Class="size-5 text-muted-foreground" />
        <p class="text-sm text-muted-foreground">
          Viewings available 7 days a week by appointment
        </p>
      </div>

      <ButtonCn Class="w-full">Submit Inquiry</ButtonCn>

      <p class="text-center text-xs text-muted-foreground">
        We'll contact you within 24 hours to schedule a viewing.
      </p>
    </form>
  </div>
</section>

