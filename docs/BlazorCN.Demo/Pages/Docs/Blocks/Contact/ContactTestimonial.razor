@* ============================================================
   Block: contact-testimonial
   Title: ContactTestimonial
   Description: Testimonial submission form with rating, photo upload option, and review details for social proof collection
   Source: original/blocks/contact/contact-testimonial.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Share Your Experience</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Your feedback helps others discover what we can do for them.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Overall Rating</LabelCn>
                <div class="flex gap-1">
                    @foreach (var s in _stars)
                    {
                        var star = s;
                        <button class="p-1 transition-transform hover:scale-110"
                                type="button"
                                @onclick="@(() => _rating = star)"
                                @onmouseenter="@(() => _hoveredRating = star)"
                                @onmouseleave="@(() => _hoveredRating = 0)">
                            <LucideIconCn Name="star" Size="32"
                                          Class="@Cn.Merge("h-8 w-8", (star <= (_hoveredRating != 0 ? _hoveredRating : _rating)) ? "fill-primary text-primary" : "text-muted-foreground")" />
                        </button>
                    }
                </div>
                <p class="text-sm text-muted-foreground">
                    @GetRatingLabel(_hoveredRating != 0 ? _hoveredRating : _rating)
                </p>
            </div>

            <div class="space-y-2">
                <LabelCn For="headline">Headline</LabelCn>
                <InputCn id="headline" Placeholder="Summarize your experience" />
            </div>

            <div class="space-y-2">
                <LabelCn For="review">Your Testimonial</LabelCn>
                <TextareaCn id="review"
                            Placeholder="What problem did we solve? What results have you seen?"
                            rows="4" />
            </div>

            <div class="border-b"></div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="Alex Thompson" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="title">Job Title</LabelCn>
                    <InputCn id="title" Placeholder="Marketing Director" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="company">Company</LabelCn>
                <InputCn id="company" Placeholder="Acme Inc." />
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("alex@acme.com")" Type="email" />
                <p class="text-xs text-muted-foreground">
                    For verification only—won't be displayed publicly
                </p>
            </div>

            <div class="border-b"></div>

            <div class="space-y-3">
                <LabelCn>Permissions</LabelCn>
                <div class="space-y-2">
                    <div class="flex items-start gap-2">
                        <CheckboxCn id="name-permission" Checked="true" />
                        <LabelCn For="name-permission" Class="text-sm font-normal leading-tight">
                            Display my name and job title
                        </LabelCn>
                    </div>
                    <div class="flex items-start gap-2">
                        <CheckboxCn id="company-permission" Checked="true" />
                        <LabelCn For="company-permission" Class="text-sm font-normal leading-tight">
                            Display my company name
                        </LabelCn>
                    </div>
                </div>
            </div>

            <ButtonCn Class="w-full">Submit Testimonial</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Thank you! We may reach out if we'd like to feature your story.
            </p>
        </form>
    </div>
</section>

@code {
    private static readonly int[] _stars = [1, 2, 3, 4, 5];

    private int _rating = 0;
    private int _hoveredRating = 0;

    private static string GetRatingLabel(int r)
    {
        if (r == 0) return "Click to rate";
        if (r == 1) return "Poor";
        if (r == 2) return "Fair";
        if (r == 3) return "Good";
        if (r == 4) return "Very Good";
        return "Excellent";
    }
}
