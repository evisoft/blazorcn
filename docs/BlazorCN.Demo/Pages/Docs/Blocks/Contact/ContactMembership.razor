@* ========================================
   Block: contact-membership
   Title: Contact Membership
   Description: Membership signup form with tier selection, billing cycle options, and member benefits for subscription businesses
   Long Description: Membership signup with plan tier selector and pricing display.
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn
   Source: original/blocks/contact/contact-membership.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Choose Your Plan</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                14-day free trial. No credit card required.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="space-y-3">
                @foreach (var plan in _plans)
                {
                    <label class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _selectedPlan == plan.Id ? "border-primary" : "hover:border-foreground")">
                        <div class="flex items-center gap-3">
                            <input checked="@(_selectedPlan == plan.Id)"
                                   class="h-4 w-4 accent-primary"
                                   name="plan"
                                   @onchange="@(() => _selectedPlan = plan.Id)"
                                   type="radio"
                                   value="@plan.Id" />
                            <div>
                                <div class="mb-1 flex items-center gap-2">
                                    <span class="text-sm font-medium">@plan.Name</span>
                                    @if (plan.Popular)
                                    {
                                        <BadgeCn Class="gap-1 text-[10px]">
                                            <LucideStarCn Class="h-3 w-3" Size="12" />
                                            Popular
                                        </BadgeCn>
                                    }
                                </div>
                                <div class="space-y-1">
                                    @foreach (var feature in plan.Features)
                                    {
                                        <div class="flex items-center gap-2">
                                            <LucideCheckCn Class="h-3 w-3 text-primary" Size="12" />
                                            <span class="text-xs text-muted-foreground">@feature</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-2xl font-semibold tabular-nums">$@plan.Price</p>
                            <p class="text-xs text-muted-foreground">/month</p>
                        </div>
                    </label>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="first-name">First Name</LabelCn>
                    <InputCn id="first-name" Placeholder="Jamie" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="last-name">Last Name</LabelCn>
                    <InputCn id="last-name" Placeholder="Wilson" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("jamie@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="password">Password</LabelCn>
                <InputCn id="password" Placeholder="Create a password" Type="password" />
            </div>

            <div class="rounded-lg border p-4">
                <div class="mb-2 flex items-center justify-between">
                    <span class="font-medium">@CurrentPlan?.Name Plan</span>
                    <span class="font-semibold">$@CurrentPlan?.Price/mo</span>
                </div>
                <p class="text-xs text-muted-foreground">14-day free trial, then billed monthly</p>
            </div>

            <ButtonCn Class="w-full">Start Free Trial</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">Cancel anytime during trial.</p>
        </form>
    </div>
</section>

@code {
    private record Plan(string Id, string Name, int Price, string[] Features, bool Popular = false);

    private string _selectedPlan = "pro";

    private static readonly Plan[] _plans =
    [
        new("starter", "Starter", 9, ["5 projects", "Basic analytics"]),
        new("pro", "Pro", 29, ["Unlimited projects", "Advanced analytics", "Priority support"], Popular: true),
        new("enterprise", "Enterprise", 99, ["Everything in Pro", "SSO", "Dedicated manager"]),
    ];

    private Plan? CurrentPlan => _plans.FirstOrDefault(p => p.Id == _selectedPlan);
}
