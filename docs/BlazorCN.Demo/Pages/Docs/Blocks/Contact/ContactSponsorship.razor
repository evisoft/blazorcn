@* ============================================================
   Block: contact-sponsorship
   Title: ContactSponsorship
   Description: Sponsorship request form with audience metrics, package selection, and partnership goals for creators
   Source: original/blocks/contact/contact-sponsorship.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Become a Sponsor</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Partner with us to reach an engaged audience of 50K+ subscribers.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="rounded-lg border p-4">
                <div class="grid grid-cols-3 gap-4 text-center">
                    <div>
                        <p class="text-2xl font-semibold tabular-nums">50K+</p>
                        <p class="text-xs text-muted-foreground">Subscribers</p>
                    </div>
                    <div>
                        <p class="text-2xl font-semibold tabular-nums">120K</p>
                        <p class="text-xs text-muted-foreground">Monthly Views</p>
                    </div>
                    <div>
                        <p class="text-2xl font-semibold tabular-nums">8.5%</p>
                        <p class="text-xs text-muted-foreground">Engagement</p>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <LabelCn>Sponsorship Package</LabelCn>
                <RadioGroupCn Class="space-y-3"
                              Value="@_selectedPackage" ValueChanged="@((string? v) => _selectedPackage = v ?? "growth")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _selectedPackage == "starter" ? "border-primary" : "hover:border-foreground")"
                             For="pkg-starter">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="pkg-starter" Value="starter" />
                            <div>
                                <span class="text-sm font-medium">Starter</span>
                                <p class="text-xs text-muted-foreground">Logo placement + mention</p>
                            </div>
                        </div>
                        <span class="text-sm font-medium">$500</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _selectedPackage == "growth" ? "border-primary" : "hover:border-foreground")"
                             For="pkg-growth">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="pkg-growth" Value="growth" />
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">Growth</span>
                                    <BadgeCn class="text-xs" Variant="BadgeVariant.Secondary">
                                        Popular
                                    </BadgeCn>
                                </div>
                                <p class="text-xs text-muted-foreground">Dedicated segment + social</p>
                            </div>
                        </div>
                        <span class="text-sm font-medium">$1,500</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _selectedPackage == "premium" ? "border-primary" : "hover:border-foreground")"
                             For="pkg-premium">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="pkg-premium" Value="premium" />
                            <div>
                                <span class="text-sm font-medium">Premium</span>
                                <p class="text-xs text-muted-foreground">Multi-episode + custom content</p>
                            </div>
                        </div>
                        <span class="text-sm font-medium">$3,500</span>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Contact Name</LabelCn>
                    <InputCn id="name" Placeholder="Sarah Johnson" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Work Email</LabelCn>
                    <InputCn id="email" Placeholder="@("sarah@company.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="company">Company Name</LabelCn>
                <InputCn id="company" Placeholder="Acme Inc." />
            </div>

            <div class="space-y-2">
                <LabelCn For="goal">Campaign Goal</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="goal">
                        <SelectValueCn Placeholder="What's your primary goal?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="awareness">Brand Awareness</SelectItemCn>
                        <SelectItemCn Value="leads">Lead Generation</SelectItemCn>
                        <SelectItemCn Value="sales">Direct Sales</SelectItemCn>
                        <SelectItemCn Value="launch">Product Launch</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="message">Tell us about your product/campaign</LabelCn>
                <TextareaCn id="message" Placeholder="What would you like to promote?" Rows="2" />
            </div>

            <ButtonCn Class="w-full">Request Sponsorship Info</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll send our full media kit within 24 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private string _selectedPackage = "growth";
}
