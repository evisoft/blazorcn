@* ========================================
   Block: contact-wedding
   Title: Contact Wedding
   Description: Wedding planning inquiry form with venue preferences, guest count, style selection, and vendor package options for wedding professionals
   Long Description: Plan your dream wedding with expert guidance. This React wedding inquiry component captures celebration details with date selection, guest count, and style choices.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn
   Source: original/blocks/contact/contact-wedding.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Begin Your Wedding Journey</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Let's bring your vision to life. Tell us about your celebration.
            </p>
        </div>

        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Wedding Style
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-4 gap-2"
                          Value="@_style" ValueChanged="@((string? v) => _style = v ?? "")">
                @foreach (var ws in _weddingStyles)
                {
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _style == ws.Value ? "border-primary" : "hover:border-foreground")"
                             For="@($"style-{ws.Value}")">
                        <RadioGroupItemCn Class="sr-only" Id="@($"style-{ws.Value}")" Value="@ws.Value" />
                        <span class="text-xs font-medium">@ws.Label</span>
                    </LabelCn>
                }
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="wedding-date">Wedding Date</LabelCn>
                    <InputCn id="wedding-date" Type="date" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="guests">Guest Count</LabelCn>
                    <InputCn id="guests" Placeholder="e.g., 120" Type="number" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="venue-type">Venue Preference</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="venue-type">
                        <SelectValueCn Placeholder="What type of venue?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="ballroom">Ballroom / Hotel</SelectItemCn>
                        <SelectItemCn Value="outdoor">Outdoor / Garden</SelectItemCn>
                        <SelectItemCn Value="barn">Barn / Rustic</SelectItemCn>
                        <SelectItemCn Value="beach">Beach / Waterfront</SelectItemCn>
                        <SelectItemCn Value="undecided">Still Exploring</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="partner1">Partner 1 Name</LabelCn>
                    <InputCn id="partner1" Placeholder="Jessica" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="partner2">Partner 2 Name</LabelCn>
                    <InputCn id="partner2" Placeholder="Michael" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("jessica.michael@example.com")" Type="email" />
            </div>

            <div class="flex items-center gap-3 rounded-lg border p-3">
                <LucideHeartCn Class="size-5 text-muted-foreground" Size="20" />
                <div>
                    <p class="text-sm font-medium">Free Consultation</p>
                    <p class="text-xs text-muted-foreground">
                        60-minute session to discuss your vision
                    </p>
                </div>
            </div>

            <ButtonCn Class="w-full">Start Planning Together</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll reach out within 24 hours to schedule your consultation.
            </p>
        </form>
    </div>
</section>

@code {
    private record WeddingStyle(string Value, string Label);

    private string _style = "";

    private static readonly WeddingStyle[] _weddingStyles =
    [
        new("classic", "Classic"),
        new("modern", "Modern"),
        new("rustic", "Rustic"),
        new("romantic", "Romantic"),
    ];
}
