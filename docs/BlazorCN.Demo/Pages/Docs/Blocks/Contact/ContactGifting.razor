@* ========================================
   Block: contact-gifting
   Title: Contact Gifting
   Description: Corporate gifting inquiry form with recipient count, budget range, and branding options for gift service providers
   Long Description: Corporate gifting form that captures order details, branding preferences, and delivery timelines. Stat bar highlights minimum order, delivery window, and branding availability upfront.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-gifting.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Corporate Gifting Inquiry</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Curated gifts that leave a lasting impression on clients and teams.
          </p>
        </div>

        <div class="grid grid-cols-3 divide-x border-b text-center">
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">10 units</p>
            <p class="text-xs text-muted-foreground">Min Order</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">2–3 wks</p>
            <p class="text-xs text-muted-foreground">Delivery</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">Custom</p>
            <p class="text-xs text-muted-foreground">Branding</p>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="name">Contact Name</LabelCn>
              <InputCn id="name" Placeholder="Rachel Kim" />
            </div>
            <div class="space-y-2">
              <LabelCn for="email">Work Email</LabelCn>
              <InputCn id="email" Placeholder="@("rachel@@company.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="company">Company Name</LabelCn>
            <InputCn id="company" Placeholder="Acme Corp" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="recipients">Number of Recipients</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="recipients">
                  <SelectValueCn Placeholder="Select range" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="10-25">10 – 25</SelectItemCn>
                  <SelectItemCn Value="25-50">25 – 50</SelectItemCn>
                  <SelectItemCn Value="50-100">50 – 100</SelectItemCn>
                  <SelectItemCn Value="100-250">100 – 250</SelectItemCn>
                  <SelectItemCn Value="250+">250+</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="budget">Budget Per Gift</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="budget">
                  <SelectValueCn Placeholder="Select budget" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="25-50">$25 – $50</SelectItemCn>
                  <SelectItemCn Value="50-100">$50 – $100</SelectItemCn>
                  <SelectItemCn Value="100-200">$100 – $200</SelectItemCn>
                  <SelectItemCn Value="200+">$200+</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="occasion">Occasion</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="occasion">
                <SelectValueCn Placeholder="Select occasion" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="holiday">Holiday Season</SelectItemCn>
                <SelectItemCn Value="appreciation">Client Appreciation</SelectItemCn>
                <SelectItemCn Value="onboarding">Employee Onboarding</SelectItemCn>
                <SelectItemCn Value="milestone">Company Milestone</SelectItemCn>
                <SelectItemCn Value="other">Other</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="details">Special requests or branding details</LabelCn>
            <TextareaCn
              id="details"
              Placeholder="Logo placement, custom packaging, dietary restrictions..."
              Rows="2"
            />
          </div>

          <ButtonCn Class="w-full">Request Gift Consultation</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            We'll send a curated proposal within 48 hours.
          </p>
        </form>
      </div>
    </section>

