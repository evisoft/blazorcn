@* ============================================================
   Block: contact-rental
   Title: ContactRental
   Description: Equipment rental inquiry form with date selection, delivery options, and tiered duration pricing for rental businesses
   Source: original/blocks/contact/contact-rental.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-6 py-5">
      <h2 class="text-sm font-medium">Equipment Rental Request</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        Browse our inventory and reserve the equipment you need for your project.
      </p>
    </div>

    <form class="space-y-4 p-6">
      <div class="rounded-lg border p-4">
        <div class="grid grid-cols-3 gap-4 text-center">
          <div>
            <p class="text-2xl font-semibold tabular-nums">$75</p>
            <p class="text-xs text-muted-foreground">Daily Rate</p>
          </div>
          <div>
            <p class="text-2xl font-semibold tabular-nums">$350</p>
            <p class="text-xs text-muted-foreground">Weekly Rate</p>
          </div>
          <div>
            <p class="text-2xl font-semibold tabular-nums">$1,100</p>
            <p class="text-xs text-muted-foreground">Monthly Rate</p>
          </div>
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="equipment">Equipment Type</LabelCn>
        <SelectCn>
          <SelectTriggerCn id="equipment">
            <SelectValueCn Placeholder="Select equipment" />
          </SelectTriggerCn>
          <SelectContentCn>
            <SelectItemCn Value="excavator">Mini Excavator</SelectItemCn>
            <SelectItemCn Value="skid-steer">Skid Steer Loader</SelectItemCn>
            <SelectItemCn Value="generator">Portable Generator</SelectItemCn>
            <SelectItemCn Value="scissor-lift">Scissor Lift</SelectItemCn>
            <SelectItemCn Value="pressure-washer">Pressure Washer</SelectItemCn>
            <SelectItemCn Value="concrete-mixer">Concrete Mixer</SelectItemCn>
          </SelectContentCn>
        </SelectCn>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="start-date">Start Date</LabelCn>
          <InputCn id="start-date" type="date" />
        </div>
        <div class="space-y-2">
          <LabelCn for="end-date">End Date</LabelCn>
          <InputCn id="end-date" type="date" />
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="name">Full Name</LabelCn>
          <InputCn id="name" Placeholder="James Carter" />
        </div>
        <div class="space-y-2">
          <LabelCn for="email">Email</LabelCn>
          <InputCn id="email" Placeholder="@("james@example.com")" type="email" />
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="phone">Phone</LabelCn>
        <InputCn id="phone" Placeholder="+1 (555) 000-0000" type="tel" />
      </div>

      <div class="space-y-2">
        <LabelCn for="notes">Project Details (Optional)</LabelCn>
        <TextareaCn
          id="notes"
          Placeholder="Describe your project or any special requirements..."
          Rows="2"
        />
      </div>

      <div class="flex items-center gap-3 rounded-lg border p-3">
        <LucideIconCn Name="truck" Size="20" Class="size-5 text-muted-foreground" />
        <div class="flex-1">
          <p class="text-sm font-medium">Delivery &amp; Pickup</p>
          <p class="text-xs text-muted-foreground">Free within 15 miles, $2/mile beyond</p>
        </div>
        <div class="flex items-center gap-2">
          <CheckboxCn id="delivery" />
          <LabelCn Class="text-sm font-normal" for="delivery">
            Add delivery
          </LabelCn>
        </div>
      </div>

      <ButtonCn Class="w-full">Request Rental Quote</ButtonCn>

      <p class="text-center text-xs text-muted-foreground">
        We'll confirm availability and send a detailed quote within 2 hours.
      </p>
    </form>
  </div>
</section>

@code {
}
