@* ========================================
   Block: contact-investment
   Title: Contact Investment
   Description: Investment inquiry form with portfolio size, risk tolerance, and financial goals for wealth management and advisory firms
   Long Description: Consultation booking with pricing
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-investment.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Investment Inquiry</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Schedule a consultation with our wealth management team.
          </p>
        </div>

        <div class="border-b px-6 py-4">
          <div class="rounded-lg border p-4">
            <div class="grid grid-cols-3 gap-4 text-center">
              <div>
                <p class="text-2xl font-semibold tabular-nums">$50K</p>
                <p class="text-xs text-muted-foreground">Min Investment</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">12.4%</p>
                <p class="text-xs text-muted-foreground">Avg Return</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">2,800+</p>
                <p class="text-xs text-muted-foreground">Clients</p>
              </div>
            </div>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="investment-name">Full Name</LabelCn>
              <InputCn id="investment-name" Placeholder="Michael Chen" />
            </div>
            <div class="space-y-2">
              <LabelCn for="investment-email">Email</LabelCn>
              <InputCn id="investment-email" Placeholder="@("michael@@example.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="investment-phone">Phone</LabelCn>
            <InputCn id="investment-phone" Placeholder="+1 (555) 000-0000" type="tel" />
          </div>

          <div class="space-y-2">
            <LabelCn for="portfolio">Portfolio Size</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="portfolio">
                <SelectValueCn Placeholder="Select range" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="50k-100k">$50K - $100K</SelectItemCn>
                <SelectItemCn Value="100k-250k">$100K - $250K</SelectItemCn>
                <SelectItemCn Value="250k-500k">$250K - $500K</SelectItemCn>
                <SelectItemCn Value="500k-1m">$500K - $1M</SelectItemCn>
                <SelectItemCn Value="1m+">$1M+</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="risk">Risk Tolerance</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="risk">
                <SelectValueCn Placeholder="Select your risk profile" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="conservative">Conservative — Preserve capital</SelectItemCn>
                <SelectItemCn Value="moderate">Moderate — Balanced growth</SelectItemCn>
                <SelectItemCn Value="aggressive">Aggressive — Maximize returns</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="investment-goal">Investment Goal</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="investment-goal">
                <SelectValueCn Placeholder="What are you investing for?" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="retirement">Retirement Planning</SelectItemCn>
                <SelectItemCn Value="growth">Wealth Growth</SelectItemCn>
                <SelectItemCn Value="income">Income Generation</SelectItemCn>
                <SelectItemCn Value="education">Education Funding</SelectItemCn>
                <SelectItemCn Value="estate">Estate Planning</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="investment-message">Additional Details</LabelCn>
            <TextareaCn id="investment-message" Placeholder="Tell us about your financial goals..." Rows="2" />
          </div>

          <ButtonCn Class="w-full">Request Consultation</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            A licensed advisor will contact you within one business day.
          </p>
        </form>
      </div>
    </section>

@code {
}
