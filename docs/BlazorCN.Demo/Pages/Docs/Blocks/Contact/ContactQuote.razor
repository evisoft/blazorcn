@* ============================================================
   Block: contact-quote
   Title: ContactQuote
   Description: Quote request form with project type selection and budget slider for service-based businesses
   Source: original/blocks/contact/contact-quote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request a Quote</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your project and we'll provide a custom estimate.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="quote-service">Service Needed</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="quote-service">
                        <SelectValueCn Placeholder="What do you need?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="website">Website</SelectItemCn>
                        <SelectItemCn Value="webapp">Web Application</SelectItemCn>
                        <SelectItemCn Value="mobile">Mobile App</SelectItemCn>
                        <SelectItemCn Value="branding">Branding</SelectItemCn>
                        <SelectItemCn Value="other">Other</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <LabelCn Class="flex items-center gap-2">
                        <LucideIconCn Name="dollar-sign" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        Budget Range
                    </LabelCn>
                    <span class="text-lg font-semibold tabular-nums">@FormatBudget(_budget)</span>
                </div>
                <SliderCn Class="py-2"
                          Max="50000"
                          Min="1000"
                          Step="1000"
                          aria-label="Budget range"
                          @bind-Value="_budget" />
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>$1,000</span>
                    <span>$50,000+</span>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="quote-timeline">Timeline</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="quote-timeline">
                        <SelectValueCn Placeholder="When do you need this?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="asap">ASAP</SelectItemCn>
                        <SelectItemCn Value="1-2months">1-2 months</SelectItemCn>
                        <SelectItemCn Value="3-6months">3-6 months</SelectItemCn>
                        <SelectItemCn Value="flexible">Flexible</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="quote-description">Project Description</LabelCn>
                <TextareaCn id="quote-description"
                            Placeholder="Describe your project, goals, and any specific requirements..."
                            rows="3" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="quote-name">Name</LabelCn>
                    <InputCn id="quote-name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="quote-company">Company (Optional)</LabelCn>
                    <InputCn id="quote-company" Placeholder="Acme Inc." />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="quote-email">Email</LabelCn>
                <InputCn id="quote-email" Placeholder="@("john@company.com")" Type="email" />
            </div>

            <ButtonCn Class="w-full">
                <LucideIconCn Name="send" Size="16" Class="mr-2 h-4 w-4" />
                Get Your Quote
            </ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We typically respond within 24 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private double _budget = 15000;

    private static string FormatBudget(double value)
    {
        if (value >= 50000)
        {
            return "$50,000+";
        }
        return $"${value:N0}";
    }
}
