@* ========================================
   Block: contact-survey
   Title: Contact Survey
   Description: Research survey participation form with demographic details, availability, study stats, and compensation info for research teams
   Long Description: Consultation booking with pricing
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-survey.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Participate in Research</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Join our user research study and help shape the future of the product.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="rounded-lg border p-4">
            <div class="grid grid-cols-3 gap-4 text-center">
              <div>
                <p class="text-2xl font-semibold tabular-nums">20 min</p>
                <p class="text-xs text-muted-foreground">Duration</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">$25</p>
                <p class="text-xs text-muted-foreground">Compensation</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">150</p>
                <p class="text-xs text-muted-foreground">Participants</p>
              </div>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="survey-name">Full Name</LabelCn>
              <InputCn id="survey-name" Placeholder="Priya Sharma" />
            </div>
            <div class="space-y-2">
              <LabelCn for="survey-email">Email</LabelCn>
              <InputCn id="survey-email" Placeholder="@("priya@@example.com")" type="email" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="age-range">Age Range</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="age-range">
                  <SelectValueCn Placeholder="Select range" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="18-24">18–24</SelectItemCn>
                  <SelectItemCn Value="25-34">25–34</SelectItemCn>
                  <SelectItemCn Value="35-44">35–44</SelectItemCn>
                  <SelectItemCn Value="45-54">45–54</SelectItemCn>
                  <SelectItemCn Value="55+">55+</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="occupation">Occupation</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="occupation">
                  <SelectValueCn Placeholder="Select field" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="engineering">Engineering / Tech</SelectItemCn>
                  <SelectItemCn Value="design">Design / Creative</SelectItemCn>
                  <SelectItemCn Value="marketing">Marketing / Sales</SelectItemCn>
                  <SelectItemCn Value="finance">Finance / Accounting</SelectItemCn>
                  <SelectItemCn Value="healthcare">Healthcare</SelectItemCn>
                  <SelectItemCn Value="education">Education</SelectItemCn>
                  <SelectItemCn Value="other">Other</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="survey-experience">Product Experience</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="survey-experience">
                <SelectValueCn Placeholder="How often do you use our product?" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="daily">Daily</SelectItemCn>
                <SelectItemCn Value="weekly">A few times a week</SelectItemCn>
                <SelectItemCn Value="monthly">A few times a month</SelectItemCn>
                <SelectItemCn Value="rarely">Rarely</SelectItemCn>
                <SelectItemCn Value="never">Never used it</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="survey-availability">Availability or Notes</LabelCn>
            <TextareaCn
              id="survey-availability"
              Placeholder="Best days/times for a session, or anything else we should know..."
              Rows="2"
            />
          </div>

          <div class="flex items-start gap-2">
            <CheckboxCn id="survey-consent" Class="mt-0.5" />
            <LabelCn for="survey-consent" Class="text-xs text-muted-foreground leading-relaxed">
              I agree to participate voluntarily and understand my responses may be used for product
              research. I can withdraw at any time.
            </LabelCn>
          </div>

          <ButtonCn Class="w-full">Sign Up for Study</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            Compensation sent via gift card within 48 hours of completion.
          </p>
        </form>
      </div>
    </section>

@code {
}
