@* ========================================
   Block: contact-repair
   Title: Contact Repair
   Description: Device repair request form with device type selection, issue description, and priority options for repair service providers
   Long Description: Equipment rental inquiry form with date selection, delivery options, and tiered duration pricing for rental businesses
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-repair.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Device Repair Request</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your device and the issue. We'll get it fixed.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="device-type">Device Type</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="device-type">
                            <SelectValueCn Placeholder="Select device" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="smartphone">Smartphone</SelectItemCn>
                            <SelectItemCn Value="tablet">Tablet</SelectItemCn>
                            <SelectItemCn Value="laptop">Laptop</SelectItemCn>
                            <SelectItemCn Value="desktop">Desktop Computer</SelectItemCn>
                            <SelectItemCn Value="game-console">Game Console</SelectItemCn>
                            <SelectItemCn Value="other">Other</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="repair-brand">Brand &amp; Model</LabelCn>
                    <InputCn id="repair-brand" Placeholder="e.g. iPhone 15 Pro" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="repair-issue">Issue Category</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="repair-issue">
                        <SelectValueCn Placeholder="What's wrong?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="screen">Cracked / Broken Screen</SelectItemCn>
                        <SelectItemCn Value="battery">Battery Not Charging</SelectItemCn>
                        <SelectItemCn Value="water">Water Damage</SelectItemCn>
                        <SelectItemCn Value="software">Software / OS Issue</SelectItemCn>
                        <SelectItemCn Value="port">Charging Port Damage</SelectItemCn>
                        <SelectItemCn Value="other">Other Issue</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="repair-description">Describe the Problem</LabelCn>
                <TextareaCn id="repair-description"
                            Placeholder="When did the issue start? Any error messages or symptoms..."
                            rows="2" />
            </div>

            <div class="space-y-3">
                <LabelCn>Repair Priority</LabelCn>
                <RadioGroupCn Class="space-y-3"
                              Value="@_priority" ValueChanged="@((string? v) => _priority = v ?? "standard")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _priority == "standard" ? "border-primary" : "hover:border-foreground")"
                             For="pri-standard">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="pri-standard" Value="standard" />
                            <div>
                                <span class="text-sm font-medium">Standard</span>
                                <p class="text-xs text-muted-foreground">3-5 business days</p>
                            </div>
                        </div>
                        <span class="text-sm font-medium">From $49</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _priority == "express" ? "border-primary" : "hover:border-foreground")"
                             For="pri-express">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="pri-express" Value="express" />
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">Express</span>
                                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                        Popular
                                    </BadgeCn>
                                </div>
                                <p class="text-xs text-muted-foreground">24-48 hours</p>
                            </div>
                        </div>
                        <span class="text-sm font-medium">From $89</span>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _priority == "same-day" ? "border-primary" : "hover:border-foreground")"
                             For="pri-same-day">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="pri-same-day" Value="same-day" />
                            <div>
                                <span class="text-sm font-medium">Same-Day</span>
                                <p class="text-xs text-muted-foreground">Ready by end of day</p>
                            </div>
                        </div>
                        <span class="text-sm font-medium">From $129</span>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="repair-name">Full Name</LabelCn>
                    <InputCn id="repair-name" Placeholder="Alex Rivera" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="repair-email">Email</LabelCn>
                    <InputCn id="repair-email" Placeholder="@("alex@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="repair-phone">Phone</LabelCn>
                <InputCn id="repair-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <ButtonCn Class="w-full">Submit Repair Request</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Free diagnostic included. 90-day warranty on all repairs.
            </p>
        </form>
    </div>
</section>

@code {
    private string _priority = "standard";
}
