@* ========================================
   Block: contact-fundraiser
   Title: Contact Fundraiser
   Description: Fundraising campaign inquiry form with goal display, timeline selection, campaign type, and donor outreach preferences for nonprofits
   Long Description: Event registration with tickets
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-fundraiser.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Start a Fundraising Campaign</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Tell us about your cause and we'll help you build a campaign that delivers.
          </p>
        </div>

        <div class="border-b px-6 py-5">
          <div class="rounded-lg bg-muted/50 p-4">
            <div class="flex items-center gap-2 mb-3">
              <LucideHeartCn Size="16" Class="size-4 text-muted-foreground" />
              <span class="text-xs font-medium text-muted-foreground">
                Campaign Goal Preview
              </span>
            </div>
            <div class="flex items-end justify-between">
              <div>
                <p class="text-2xl font-semibold tabular-nums">$50,000</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Target amount</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-medium tabular-nums">$0 raised</p>
                <p class="mt-0.5 text-xs text-muted-foreground">0% funded</p>
              </div>
            </div>
            <div class="mt-3 h-1.5 w-full rounded-full bg-muted">
              <div class="h-full w-0 rounded-full bg-emerald-500"></div>
            </div>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="campaign-type">Campaign Type</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="campaign-type">
                  <SelectValueCn Placeholder="Select type" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="annual">Annual Fund</SelectItemCn>
                  <SelectItemCn Value="capital">Capital Campaign</SelectItemCn>
                  <SelectItemCn Value="crowdfunding">Crowdfunding</SelectItemCn>
                  <SelectItemCn Value="peer">Peer-to-Peer</SelectItemCn>
                  <SelectItemCn Value="event">Event-Based</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="fundraiser-timeline">Timeline</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="fundraiser-timeline">
                  <SelectValueCn Placeholder="Duration" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="2-weeks">2 weeks</SelectItemCn>
                  <SelectItemCn Value="1-month">1 month</SelectItemCn>
                  <SelectItemCn Value="3-months">3 months</SelectItemCn>
                  <SelectItemCn Value="6-months">6 months</SelectItemCn>
                  <SelectItemCn Value="12-months">12 months</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="fundraiser-organization">Organization Name</LabelCn>
            <InputCn id="fundraiser-organization" Placeholder="Hope Foundation" />
          </div>

          <div class="space-y-2">
            <LabelCn for="cause">Describe Your Cause</LabelCn>
            <TextareaCn
              id="cause"
              Placeholder="What are you raising funds for? Who benefits and what impact will it have?"
              Rows="2"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="fundraiser-contact-name">Contact Name</LabelCn>
              <InputCn id="fundraiser-contact-name" Placeholder="Sarah Chen" />
            </div>
            <div class="space-y-2">
              <LabelCn for="fundraiser-email">Email</LabelCn>
              <InputCn id="fundraiser-email" Placeholder="@("sarah@@hopefoundation.org")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="fundraiser-phone">Phone</LabelCn>
            <InputCn id="fundraiser-phone" Placeholder="+1 (555) 000-0000" type="tel" />
          </div>

          <ButtonCn Class="w-full">Launch Campaign Consultation</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            Free consultation. No platform fees until your campaign is live.
          </p>
        </form>
      </div>
    </section>

@code {
}
