@* ========================================
   Block: contact-fitness
   Title: Contact Fitness
   Description: Fitness and personal training inquiry form with goal selection, experience level, availability, and training preferences for gyms and trainers
   Long Description: Capture fitness clients. Unique: goal selector with icons and experience level assessment.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn
   Source: original/blocks/contact/contact-fitness.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Start Your Fitness Journey</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Find the perfect training program for your goals.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">
                What's your primary goal?
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-2 gap-2 sm:grid-cols-4"
                          Value="@_goal" ValueChanged="@((string? v) => _goal = v ?? "")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "weight-loss" ? "border-primary" : "hover:border-foreground")"
                         For="weight-loss">
                    <RadioGroupItemCn Class="sr-only" Id="weight-loss" Value="weight-loss" />
                    <LucideFlameCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "weight-loss" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Lose Weight</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "muscle" ? "border-primary" : "hover:border-foreground")"
                         For="muscle">
                    <RadioGroupItemCn Class="sr-only" Id="muscle" Value="muscle" />
                    <LucideDumbbellCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "muscle" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Build Muscle</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "tone" ? "border-primary" : "hover:border-foreground")"
                         For="tone">
                    <RadioGroupItemCn Class="sr-only" Id="tone" Value="tone" />
                    <LucideTargetCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "tone" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Tone &amp; Define</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _goal == "wellness" ? "border-primary" : "hover:border-foreground")"
                         For="wellness">
                    <RadioGroupItemCn Class="sr-only" Id="wellness" Value="wellness" />
                    <LucideHeartCn Class="@Cn.Merge("mb-2 h-5 w-5", _goal == "wellness" ? "text-primary" : "text-muted-foreground")" Size="20" />
                    <span class="text-xs font-medium">Wellness</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="Alex Rivera" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("alex@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="experience">Fitness Level</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="experience">
                        <SelectValueCn Placeholder="Select your level" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="beginner">Beginner (New to exercise)</SelectItemCn>
                        <SelectItemCn Value="intermediate">Intermediate (Regular exercise)</SelectItemCn>
                        <SelectItemCn Value="advanced">Advanced (Consistent training)</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="frequency">Desired Training Frequency</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="frequency">
                        <SelectValueCn Placeholder="Sessions per week" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="2">2x per week</SelectItemCn>
                        <SelectItemCn Value="3">3x per week</SelectItemCn>
                        <SelectItemCn Value="4">4x per week</SelectItemCn>
                        <SelectItemCn Value="5">5+ per week</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="phone">Phone</LabelCn>
                <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <ButtonCn Class="w-full">
                <LucideFlameCn Class="mr-2 h-4 w-4" Size="16" />
                Get Your Free Assessment
            </ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                No commitment required. Let's see if we're the right fit.
            </p>
        </form>
    </div>
</section>

@code {
    private string _goal = "";
}
