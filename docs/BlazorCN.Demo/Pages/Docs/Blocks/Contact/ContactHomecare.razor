@* ========================================
   Block: contact-homecare
   Title: Contact Homecare
   Description: Home care services inquiry form with care level selection, schedule preferences, and patient details for home health agencies
   Long Description: Home care inquiry with visual care level selector for companion, personal, and skilled nursing. Families can specify schedule and care requirements before connecting with a care coordinator.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-homecare.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Home Care Services Inquiry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Compassionate care delivered in the comfort of home by trained professionals.
            </p>
        </div>

        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Care Level Needed
            </LabelCn>
            <RadioGroupCn Class="grid grid-cols-3 gap-3"
                          Value="@_careLevel" ValueChanged="@((string? v) => _careLevel = v ?? "personal")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-2 rounded-lg border p-4 text-center transition-colors", _careLevel == "companion" ? "border-primary" : "hover:border-foreground")"
                         For="care-companion">
                    <RadioGroupItemCn Class="sr-only" Id="care-companion" Value="companion" />
                    <LucideHeartCn Class="size-5 text-muted-foreground" Size="20" />
                    <span class="text-sm font-medium">Companion</span>
                    <span class="text-[10px] text-muted-foreground">Social &amp; errands</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-2 rounded-lg border p-4 text-center transition-colors", _careLevel == "personal" ? "border-primary" : "hover:border-foreground")"
                         For="care-personal">
                    <RadioGroupItemCn Class="sr-only" Id="care-personal" Value="personal" />
                    <LucideUserRoundCn Class="size-5 text-muted-foreground" Size="20" />
                    <span class="text-sm font-medium">Personal</span>
                    <span class="text-[10px] text-muted-foreground">Daily living help</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center gap-2 rounded-lg border p-4 text-center transition-colors", _careLevel == "skilled" ? "border-primary" : "hover:border-foreground")"
                         For="care-skilled">
                    <RadioGroupItemCn Class="sr-only" Id="care-skilled" Value="skilled" />
                    <LucideShieldCn Class="size-5 text-muted-foreground" Size="20" />
                    <span class="text-sm font-medium">Skilled Nursing</span>
                    <span class="text-[10px] text-muted-foreground">Medical care</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="homecare-contact-name">Your Name</LabelCn>
                    <InputCn id="homecare-contact-name" Placeholder="Lisa Chen" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="homecare-relationship">Relationship to Patient</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="homecare-relationship">
                            <SelectValueCn Placeholder="Select relationship" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="self">Self</SelectItemCn>
                            <SelectItemCn Value="spouse">Spouse/Partner</SelectItemCn>
                            <SelectItemCn Value="child">Adult Child</SelectItemCn>
                            <SelectItemCn Value="sibling">Sibling</SelectItemCn>
                            <SelectItemCn Value="other">Other Family</SelectItemCn>
                            <SelectItemCn Value="professional">Healthcare Professional</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="homecare-email">Email</LabelCn>
                    <InputCn id="homecare-email" Placeholder="@("lisa@example.com")" Type="email" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="homecare-phone">Phone</LabelCn>
                    <InputCn id="homecare-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="schedule">Schedule Preference</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="schedule">
                            <SelectValueCn Placeholder="Select schedule" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="hourly">Hourly Visits (2–8 hrs)</SelectItemCn>
                            <SelectItemCn Value="daily">Daily Visits</SelectItemCn>
                            <SelectItemCn Value="live-in">Live-In Care</SelectItemCn>
                            <SelectItemCn Value="overnight">Overnight Care</SelectItemCn>
                            <SelectItemCn Value="247">24/7 Around-the-Clock</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="homecare-start-date">Preferred Start Date</LabelCn>
                    <InputCn id="homecare-start-date" Type="date" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="homecare-needs">Care needs or special considerations</LabelCn>
                <TextareaCn id="homecare-needs"
                            Placeholder="Mobility limitations, medications, dietary needs, cognitive support..."
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Request Care Consultation</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                A care coordinator will call you within 24 hours for a free assessment.
            </p>
        </form>
    </div>
</section>

@code {
    private string _careLevel = "personal";
}
