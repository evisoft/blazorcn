@* ========================================
   Block: contact-loan
   Title: Contact Loan
   Description: Loan application form with amount selection, purpose, income details, and credit consent for financial services
   Long Description: Loan application with amount slider and monthly payment estimate display.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, SliderCn
   Source: original/blocks/contact/contact-loan.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Personal Loan Application</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Check your rate in minutes with no impact to your credit score.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <LabelCn>Loan Amount</LabelCn>
                    <span class="text-2xl font-semibold tabular-nums">
                        $@_loanAmount.ToString("N0")
                    </span>
                </div>
                <SliderCn Class="py-4" Max="50000" Min="1000" Value="@_loanAmount"
                          ValueChanged="@((double v) => _loanAmount = v)" Step="1000" />
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>$1,000</span>
                    <span>$50,000</span>
                </div>
            </div>

            <div class="mt-6 rounded-lg border bg-muted/50 p-4">
                <div class="mb-2 flex items-center gap-2">
                    <LucideDollarSignCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm font-medium">Estimated Monthly Payment</span>
                </div>
                <p class="text-2xl font-semibold tabular-nums">$@MonthlyPayment</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Based on 60-month term at 8.99% APR
                </p>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="purpose">Loan Purpose</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="purpose">
                        <SelectValueCn Placeholder="What's this loan for?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="debt">Debt Consolidation</SelectItemCn>
                        <SelectItemCn Value="home">Home Improvement</SelectItemCn>
                        <SelectItemCn Value="auto">Auto Purchase</SelectItemCn>
                        <SelectItemCn Value="medical">Medical Expenses</SelectItemCn>
                        <SelectItemCn Value="other">Other</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="first-name">First Name</LabelCn>
                    <InputCn id="first-name" Placeholder="James" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="last-name">Last Name</LabelCn>
                    <InputCn id="last-name" Placeholder="Wilson" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("james@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="income">Annual Income</LabelCn>
                <InputCn id="income" Placeholder="$75,000" />
            </div>

            <div class="space-y-2">
                <LabelCn For="credit">Estimated Credit Score</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="credit">
                        <SelectValueCn Placeholder="Select range" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="excellent">Excellent (750+)</SelectItemCn>
                        <SelectItemCn Value="good">Good (700-749)</SelectItemCn>
                        <SelectItemCn Value="fair">Fair (650-699)</SelectItemCn>
                        <SelectItemCn Value="poor">Below 650</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <ButtonCn Class="w-full">Check My Rate</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Checking your rate won't affect your credit score.
            </p>
        </form>
    </div>
</section>

@code {
    private double _loanAmount = 25000;

    private int MonthlyPayment => (int)Math.Round(_loanAmount * 0.02 + 150);
}
