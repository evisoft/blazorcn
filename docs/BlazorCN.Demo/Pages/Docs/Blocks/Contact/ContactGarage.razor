@* ========================================
   Block: contact-garage
   Title: Contact Garage
   Description: Auto repair service request form with vehicle details, service type, mileage, and urgency indicator for automotive shops
   Long Description: Auto repair booking form with a service urgency indicator offering Routine, Soon, and Urgent levels. Built for garages, auto shops, and mobile mechanic services that need to triage incoming requests.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-garage.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request Auto Service</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your vehicle and we'll get you booked in.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="mb-3 flex items-center gap-2">
                <LucideWrenchCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <span class="text-sm font-medium">Service Urgency</span>
            </div>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var level in _urgencyLevels)
                {
                    <button type="button"
                            @onclick="@(() => _urgency = level.Value)"
                            class="@Cn.Merge("rounded-md border px-3 py-3 text-left transition-colors", _urgency == level.Value ? "border-foreground bg-muted/50" : "hover:bg-muted/50")">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-2 rounded-full", level.Color)"></span>
                            <span class="text-sm font-medium">@level.Label</span>
                        </div>
                        <p class="mt-0.5 pl-4 text-xs text-muted-foreground">@level.Desc</p>
                    </button>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-3">
                <div class="space-y-2">
                    <LabelCn For="year">Year</LabelCn>
                    <InputCn id="year" Placeholder="2021" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="make">Make</LabelCn>
                    <InputCn id="make" Placeholder="Toyota" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="model">Model</LabelCn>
                    <InputCn id="model" Placeholder="Camry" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="mileage">Mileage</LabelCn>
                    <InputCn id="mileage" Placeholder="45,000" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="service-type">Service Type</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="service-type">
                            <SelectValueCn Placeholder="Select service" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="maintenance">Oil &amp; Maintenance</SelectItemCn>
                            <SelectItemCn Value="brakes">Brakes</SelectItemCn>
                            <SelectItemCn Value="engine">Engine &amp; Diagnostics</SelectItemCn>
                            <SelectItemCn Value="tires">Tires &amp; Alignment</SelectItemCn>
                            <SelectItemCn Value="electrical">Electrical</SelectItemCn>
                            <SelectItemCn Value="other">Other</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="issue">Describe the Issue</LabelCn>
                <TextareaCn id="issue"
                            Placeholder="Squealing noise when braking, check engine light on..."
                            rows="2" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Your Name</LabelCn>
                    <InputCn id="name" Placeholder="Kevin Park" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <ButtonCn Class="w-full">Book Service Appointment</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Free diagnostics with every repair. We'll confirm your slot by text.
            </p>
        </form>
    </div>
</section>

@code {
    private record UrgencyLevel(string Value, string Label, string Desc, string Color);

    private string _urgency = "routine";

    private static readonly UrgencyLevel[] _urgencyLevels =
    [
        new("routine", "Routine", "Within a week", "bg-emerald-500"),
        new("soon", "Soon", "2\u20133 days", "bg-amber-500"),
        new("urgent", "Urgent", "Same day", "bg-red-500"),
    ];
}
