@* ============================================================
   Block: contact-waitlist
   Title: ContactWaitlist
   Description: Waitlist signup form with position counter, referral program, and feature interest for product launches
   Source: original/blocks/contact/contact-waitlist.tsx
   ============================================================ *@

@if (_submitted)
{
    <section class="mx-auto w-full max-w-lg p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="space-y-4 p-6 text-center">
                <div class="mx-auto flex size-12 items-center justify-center rounded-full border">
                    <LucideIconCn Name="rocket" Size="24" Class="size-6" />
                </div>
                <h3 class="text-sm font-medium">You're on the list!</h3>
                <p class="text-xs text-muted-foreground">
                    You're #12,454 in line. Share to move up!
                </p>

                <div class="rounded-lg border p-4">
                    <p class="mb-2 text-sm text-muted-foreground">Your referral link</p>
                    <div class="flex gap-2">
                        <InputCn Class="text-sm" Value="https://app.co/ref/abc123" Readonly="true" />
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Copy</ButtonCn>
                    </div>
                </div>

                <p class="text-xs text-muted-foreground">
                    Refer friends to skip ahead. 3 referrals = priority access.
                </p>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-lg p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-6 py-5">
                <h2 class="text-sm font-medium">Join the Waitlist</h2>
                <p class="mt-1 text-xs text-muted-foreground">
                    Be the first to experience the future of productivity.
                </p>
            </div>

            <form class="space-y-4 p-6" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="users" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span class="text-sm">
                            <span class="font-semibold">12,453</span>
                            <span class="text-muted-foreground"> joined</span>
                        </span>
                    </div>
                    <span class="text-xs text-muted-foreground">847 beta spots left</span>
                </div>

                <div class="space-y-2">
                    <LabelCn for="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="Alex Johnson" />
                </div>

                <div class="space-y-2">
                    <LabelCn for="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("alex@@example.com")" type="email" />
                </div>

                <div class="space-y-3">
                    <LabelCn>Which features interest you most?</LabelCn>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="flex items-center gap-2">
                            <CheckboxCn id="analytics" />
                            <LabelCn Class="text-sm font-normal" for="analytics">Analytics</LabelCn>
                        </div>
                        <div class="flex items-center gap-2">
                            <CheckboxCn id="automation" />
                            <LabelCn Class="text-sm font-normal" for="automation">Automation</LabelCn>
                        </div>
                        <div class="flex items-center gap-2">
                            <CheckboxCn id="collaboration" />
                            <LabelCn Class="text-sm font-normal" for="collaboration">Collaboration</LabelCn>
                        </div>
                        <div class="flex items-center gap-2">
                            <CheckboxCn id="integrations" />
                            <LabelCn Class="text-sm font-normal" for="integrations">Integrations</LabelCn>
                        </div>
                    </div>
                </div>

                <ButtonCn Class="w-full" type="submit">
                    <LucideIconCn Name="rocket" Size="16" Class="mr-2 h-4 w-4" />
                    Join Waitlist
                </ButtonCn>

                <p class="text-center text-xs text-muted-foreground">
                    No spam, ever. We'll only email you about launch updates.
                </p>
            </form>
        </div>
    </section>
}

@code {
    private bool _submitted = false;

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
