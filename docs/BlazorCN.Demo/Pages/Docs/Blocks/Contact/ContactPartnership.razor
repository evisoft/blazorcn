@* ========================================
   Block: contact-partnership
   Title: Contact Partnership
   Description: Partnership inquiry form with collaboration type selection and company details for B2B opportunities
   Long Description: Partnership inquiry form with partner type selection and company details. Perfect for SaaS platforms, marketplaces, and agencies seeking strategic partnerships.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, TextareaCn
   Source: original/blocks/contact/contact-partnership.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Become a Partner</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Let's explore how we can grow together.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Partnership Type</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-2"
                              Value="@_partnerType" ValueChanged="@((string? v) => _partnerType = v ?? "")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-center rounded-lg border p-3 text-sm transition-colors", _partnerType == "integration" ? "border-primary bg-primary text-primary-foreground" : "hover:border-foreground")"
                             For="integration">
                        <RadioGroupItemCn Class="sr-only" Id="integration" Value="integration" />
                        Integration
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-center rounded-lg border p-3 text-sm transition-colors", _partnerType == "reseller" ? "border-primary bg-primary text-primary-foreground" : "hover:border-foreground")"
                             For="reseller">
                        <RadioGroupItemCn Class="sr-only" Id="reseller" Value="reseller" />
                        Reseller
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-center rounded-lg border p-3 text-sm transition-colors", _partnerType == "affiliate" ? "border-primary bg-primary text-primary-foreground" : "hover:border-foreground")"
                             For="affiliate">
                        <RadioGroupItemCn Class="sr-only" Id="affiliate" Value="affiliate" />
                        Affiliate
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-center rounded-lg border p-3 text-sm transition-colors", _partnerType == "other" ? "border-primary bg-primary text-primary-foreground" : "hover:border-foreground")"
                             For="other">
                        <RadioGroupItemCn Class="sr-only" Id="other" Value="other" />
                        Other
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="partnership-company">Company Name</LabelCn>
                <InputCn id="partnership-company" Placeholder="Acme Inc." />
            </div>

            <div class="space-y-2">
                <LabelCn For="partnership-website">Website</LabelCn>
                <InputCn id="partnership-website" Placeholder="https://example.com" Type="url" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="partnership-name">Your Name</LabelCn>
                    <InputCn id="partnership-name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="partnership-email">Work Email</LabelCn>
                    <InputCn id="partnership-email" Placeholder="@("john@company.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="proposal">Partnership Proposal</LabelCn>
                <TextareaCn id="proposal"
                            Placeholder="Tell us about your partnership idea and what you'd like to achieve together..."
                            rows="4" />
            </div>

            <ButtonCn Class="w-full">Submit Partnership Inquiry</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll respond within 48 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private string _partnerType = "";
}
