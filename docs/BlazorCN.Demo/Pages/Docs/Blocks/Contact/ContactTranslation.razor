@* ============================================================
   Block: contact-translation
   Title: ContactTranslation
   Description: Translation or localization request form with language pairs, document type, and turnaround options for language services
   Source: original/blocks/contact/contact-translation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-6 py-5">
      <h2 class="text-sm font-medium">Request a Translation</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        Professional human translation with native speakers. Get a quote in hours.
      </p>
    </div>

    <form class="space-y-4 p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="source">Source Language</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="source">
              <SelectValueCn Placeholder="From" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="en">English</SelectItemCn>
              <SelectItemCn Value="es">Spanish</SelectItemCn>
              <SelectItemCn Value="fr">French</SelectItemCn>
              <SelectItemCn Value="de">German</SelectItemCn>
              <SelectItemCn Value="zh">Chinese</SelectItemCn>
              <SelectItemCn Value="ja">Japanese</SelectItemCn>
              <SelectItemCn Value="other">Other</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
        <div class="space-y-2">
          <LabelCn for="target">Target Language</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="target">
              <SelectValueCn Placeholder="To" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="en">English</SelectItemCn>
              <SelectItemCn Value="es">Spanish</SelectItemCn>
              <SelectItemCn Value="fr">French</SelectItemCn>
              <SelectItemCn Value="de">German</SelectItemCn>
              <SelectItemCn Value="zh">Chinese</SelectItemCn>
              <SelectItemCn Value="ja">Japanese</SelectItemCn>
              <SelectItemCn Value="ko">Korean</SelectItemCn>
              <SelectItemCn Value="ar">Arabic</SelectItemCn>
              <SelectItemCn Value="multiple">Multiple Languages</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="doc-type">Document Type</LabelCn>
        <SelectCn>
          <SelectTriggerCn id="doc-type">
            <SelectValueCn Placeholder="Select content type" />
          </SelectTriggerCn>
          <SelectContentCn>
            <SelectItemCn Value="general">General / Business</SelectItemCn>
            <SelectItemCn Value="technical">Technical / IT (+20%)</SelectItemCn>
            <SelectItemCn Value="legal">Legal / Contracts (+30%)</SelectItemCn>
            <SelectItemCn Value="medical">Medical / Pharma (+40%)</SelectItemCn>
            <SelectItemCn Value="marketing">Marketing / Creative (+25%)</SelectItemCn>
          </SelectContentCn>
        </SelectCn>
      </div>

      <div class="space-y-2">
        <LabelCn for="wordcount">Estimated Word Count</LabelCn>
        <InputCn id="wordcount" Placeholder="e.g., 2500" type="number" />
        <p class="text-xs text-muted-foreground">
          Approximate is fine—we'll confirm after reviewing files
        </p>
      </div>

      <div class="space-y-2">
        <LabelCn for="context">Project Context (Optional)</LabelCn>
        <TextareaCn
          id="context"
          Placeholder="Target audience, tone preferences, terminology..."
          Rows="2"
        />
      </div>

      <div class="border-b"></div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="name">Your Name</LabelCn>
          <InputCn id="name" Placeholder="Emma Chen" />
        </div>
        <div class="space-y-2">
          <LabelCn for="company">Company (Optional)</LabelCn>
          <InputCn id="company" Placeholder="Global Corp" />
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="email">Email</LabelCn>
        <InputCn id="email" Placeholder="@("emma@@company.com")" type="email" />
      </div>

      <div class="flex items-center gap-3 rounded-lg border p-3">
        <LucideIconCn Name="globe" Size="20" Class="h-5 w-5 text-muted-foreground" />
        <p class="text-sm text-muted-foreground">
          Average rate: $0.12-0.20 per word depending on language pair
        </p>
      </div>

      <ButtonCn Class="w-full">Get Free Quote</ButtonCn>

      <p class="text-center text-xs text-muted-foreground">
        Detailed quote with exact pricing within 2-4 hours.
      </p>
    </form>
  </div>
</section>

@code {
}
