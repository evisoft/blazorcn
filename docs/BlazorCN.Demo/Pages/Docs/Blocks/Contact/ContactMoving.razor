@* ========================================
   Block: contact-moving
   Title: Contact Moving
   Description: Moving and relocation quote form with inventory assessment, service level selection, and scheduling for moving companies
   Long Description: Professional moving quote form with origin and destination address pair and move date. Perfect for moving companies and relocation services.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-moving.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Get Your Moving Quote</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Tell us where you're moving and we'll provide a free estimate.
          </p>
        </div>

        <div class="border-b p-6">
          <div class="flex items-center gap-2 mb-4">
            <LucideMapPinCn Size="16" Class="h-4 w-4 text-muted-foreground" />
            <h3 class="text-sm font-medium">Moving From & To</h3>
          </div>
          <div class="grid gap-4 md:grid-cols-[1fr,auto,1fr]">
            <div class="space-y-2">
              <LabelCn for="moving-origin">Origin Address</LabelCn>
              <InputCn id="moving-origin" Placeholder="123 Current St, City, State ZIP" />
            </div>

            <div class="flex items-center justify-center pt-7">
              <div class="rounded-full border p-1.5">
                <LucideArrowRightCn Size="16" Class="h-4 w-4 text-muted-foreground" />
              </div>
            </div>

            <div class="space-y-2">
              <LabelCn for="moving-destination">Destination Address</LabelCn>
              <InputCn id="moving-destination" Placeholder="456 New Ave, City, State ZIP" />
            </div>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="home-size">Home Size</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="home-size">
                  <SelectValueCn Placeholder="Select size" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="studio">Studio</SelectItemCn>
                  <SelectItemCn Value="1bed">1 Bedroom</SelectItemCn>
                  <SelectItemCn Value="2bed">2 Bedroom</SelectItemCn>
                  <SelectItemCn Value="3bed">3 Bedroom</SelectItemCn>
                  <SelectItemCn Value="4bed">4+ Bedroom</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="moving-move-date">Preferred Move Date</LabelCn>
              <InputCn id="moving-move-date" type="date" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="special">Special Items or Instructions</LabelCn>
            <TextareaCn
              id="special"
              Placeholder="Piano, fragile items, parking restrictions, stairs..."
              Rows="2"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="moving-name">Your Name</LabelCn>
              <InputCn id="moving-name" Placeholder="David Chen" />
            </div>
            <div class="space-y-2">
              <LabelCn for="moving-phone">Phone</LabelCn>
              <InputCn id="moving-phone" Placeholder="+1 (555) 000-0000" type="tel" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="moving-email">Email</LabelCn>
            <InputCn id="moving-email" Placeholder="@("david@@example.com")" type="email" />
          </div>

          <ButtonCn Class="w-full">
            <LucideTruckCn Size="16" Class="mr-2 h-4 w-4" />
            Get Free Quote
          </ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            We'll respond within 2 hours during business hours.
          </p>
        </form>
      </div>
    </section>

@code {
}
