@* ========================================
   Block: contact-affiliate
   Title: Contact Affiliate
   Description: Affiliate program application form with platform details, audience metrics, and promotion methods for partnership teams
   Long Description: Affiliate application form that qualifies partners with platform, audience size, and promotion approach. Commission details shown inline to set expectations upfront.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-affiliate.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Join Our Affiliate Program</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Earn up to 30% commission promoting products your audience loves.
          </p>
        </div>

        @* Commission summary *@
        <div class="grid grid-cols-3 border-b divide-x text-center">
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">20–30%</p>
            <p class="text-xs text-muted-foreground">Commission</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">60 days</p>
            <p class="text-xs text-muted-foreground">Cookie window</p>
          </div>
          <div class="px-4 py-3">
            <p class="text-lg font-semibold tabular-nums">Monthly</p>
            <p class="text-xs text-muted-foreground">Payouts</p>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="affiliate-name">Full Name</LabelCn>
              <InputCn id="affiliate-name" Placeholder="Alex Rivera" />
            </div>
            <div class="space-y-2">
              <LabelCn for="affiliate-email">Email</LabelCn>
              <InputCn id="affiliate-email" Placeholder="@("alex@@example.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="affiliate-website">Website or Channel URL</LabelCn>
            <InputCn id="affiliate-website" Placeholder="https://yoursite.com" type="url" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="affiliate-platform">Primary Platform</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="affiliate-platform">
                  <SelectValueCn Placeholder="Select platform" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="blog">Blog / Website</SelectItemCn>
                  <SelectItemCn Value="youtube">YouTube</SelectItemCn>
                  <SelectItemCn Value="instagram">Instagram</SelectItemCn>
                  <SelectItemCn Value="tiktok">TikTok</SelectItemCn>
                  <SelectItemCn Value="newsletter">Newsletter</SelectItemCn>
                  <SelectItemCn Value="podcast">Podcast</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="affiliate-audience">Audience Size</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="affiliate-audience">
                  <SelectValueCn Placeholder="Select range" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="1k-10k">1K – 10K</SelectItemCn>
                  <SelectItemCn Value="10k-50k">10K – 50K</SelectItemCn>
                  <SelectItemCn Value="50k-100k">50K – 100K</SelectItemCn>
                  <SelectItemCn Value="100k+">100K+</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="affiliate-why">Why do you want to promote us?</LabelCn>
            <TextareaCn
              id="affiliate-why"
              Placeholder="Tell us about your audience and why our product is a good fit..."
              Rows="3"
            />
          </div>

          <div class="flex items-start gap-2 pt-2">
            <CheckboxCn id="terms" />
            <LabelCn
              Class="text-xs font-normal leading-tight text-muted-foreground"
              for="terms"
            >
              I agree to the 
              <a class="text-primary hover:underline" href="#">
                affiliate terms
              </a> 
              and will disclose my affiliate relationship per FTC guidelines.
            </LabelCn>
          </div>

          <ButtonCn Class="w-full">Apply to Program</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            Applications reviewed within 2–3 business days.
          </p>
        </form>
      </div>
    </section>

