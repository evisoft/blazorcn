@* ========================================
   Block: contact-multistep
   Title: Contact Multistep
   Description: Multi-step wizard contact form breaking long forms into digestible steps with progress indicator and navigation controls
   Long Description: Multi-step contact form with progress tracking and step validation. Breaks complex forms into manageable sections—perfect for quote requests and detailed inquiries.
   Dependencies: ButtonCn, InputCn, LabelCn, ProgressCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-multistep.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request a Quote</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Fill out the form and we'll get back to you with a detailed quote.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-sm font-medium">@_steps[_step]</span>
                <span class="text-xs text-muted-foreground">
                    Step @(_step + 1) of @_steps.Length
                </span>
            </div>
            <ProgressCn Class="h-1" Value="@(((_step + 1.0) / _steps.Length) * 100)" aria-label="Progress" />
        </div>

        <form class="space-y-4 p-6">
            @if (_step == 0)
            {
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <LabelCn For="multistep-first-name">First Name</LabelCn>
                        <InputCn id="multistep-first-name" Placeholder="John" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="multistep-last-name">Last Name</LabelCn>
                        <InputCn id="multistep-last-name" Placeholder="Doe" />
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn For="multistep-email">Email</LabelCn>
                    <InputCn id="multistep-email" Placeholder="@("john@example.com")" Type="email" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="multistep-phone">Phone</LabelCn>
                    <InputCn id="multistep-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            }

            @if (_step == 1)
            {
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <LabelCn For="multistep-service">Service</LabelCn>
                        <SelectCn>
                            <SelectTriggerCn id="multistep-service">
                                <SelectValueCn Placeholder="Select a service" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="consulting">Consulting</SelectItemCn>
                                <SelectItemCn Value="development">Development</SelectItemCn>
                                <SelectItemCn Value="design">Design</SelectItemCn>
                                <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="multistep-budget">Budget Range</LabelCn>
                        <SelectCn>
                            <SelectTriggerCn id="multistep-budget">
                                <SelectValueCn Placeholder="Select budget" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="lt5k">Less than $5,000</SelectItemCn>
                                <SelectItemCn Value="5k-10k">$5,000 \u2013 $10,000</SelectItemCn>
                                <SelectItemCn Value="10k-25k">$10,000 \u2013 $25,000</SelectItemCn>
                                <SelectItemCn Value="25k+">$25,000+</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn For="multistep-details">Project Details</LabelCn>
                    <TextareaCn id="multistep-details" Placeholder="Tell us about your project..." rows="4" />
                </div>
            }

            @if (_step == 2)
            {
                <div class="space-y-3 rounded-lg border p-4">
                    <div>
                        <p class="text-xs text-muted-foreground">Contact</p>
                        <p class="text-sm font-medium">John Doe</p>
                        <p class="text-xs text-muted-foreground">@("john@example.com")</p>
                    </div>
                    <div class="border-t pt-3">
                        <p class="text-xs text-muted-foreground">Project</p>
                        <p class="text-sm font-medium">Consulting</p>
                        <p class="text-xs text-muted-foreground">Budget: $10,000 \u2013 $25,000</p>
                    </div>
                </div>
            }

            <div class="flex items-center justify-between pt-2">
                @if (_step > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Outline" type="button" @onclick="@(() => _step--)">
                        Previous
                    </ButtonCn>
                }
                else
                {
                    <div></div>
                }

                @if (_step < _steps.Length - 1)
                {
                    <ButtonCn type="button" @onclick="@(() => _step++)">
                        Next
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn type="submit">Submit Request</ButtonCn>
                }
            </div>
        </form>
    </div>
</section>

@code {
    private static readonly string[] _steps = ["Contact Info", "Project Details", "Review"];
    private int _step;
}
