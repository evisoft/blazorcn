@* ============================================================
   Block: contact-schedule
   Title: ContactSchedule
   Description: Meeting scheduler with visual day selection and time slots for booking consultations or demos
   Source: original/blocks/contact/contact-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-3">
                <AvatarCn Class="h-12 w-12">
                    <AvatarImageCn Src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&auto=format&fit=crop" Alt="" />
                    <AvatarFallbackCn>JD</AvatarFallbackCn>
                </AvatarCn>
                <div>
                    <h2 class="text-sm font-medium">Schedule with John Doe</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">30 min • Google Meet</p>
                </div>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">December 2024</p>
                <div class="grid grid-cols-5 gap-2">
                    @foreach (var d in _days)
                    {
                        var day = d;
                        <button
                            type="button"
                            class="@Cn.Merge("rounded-lg border py-3 text-center transition-colors", _selectedDay == day.Date ? "border-primary bg-primary text-primary-foreground" : day.Available ? "hover:border-foreground" : "cursor-not-allowed opacity-40")"
                            disabled="@(!day.Available)"
                            @onclick="@(() => SelectDay(day))">
                            <span class="block text-xs">@day.Day</span>
                            <span class="block text-lg font-semibold tabular-nums">@day.Date</span>
                        </button>
                    }
                </div>
            </div>

            <div class="space-y-3">
                <p class="text-sm font-medium">Available Times</p>
                <div class="grid grid-cols-3 gap-2">
                    @foreach (var t in _times)
                    {
                        var time = t;
                        <button
                            type="button"
                            class="@Cn.Merge("rounded-lg border py-2 text-sm transition-colors", _selectedTime == time ? "border-primary bg-primary text-primary-foreground" : "hover:border-foreground")"
                            @onclick="@(() => SelectTime(time))">
                            @time
                        </button>
                    }
                </div>
            </div>

            <div class="border-t pt-6 mt-6 grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="schedule-name">Name</LabelCn>
                    <InputCn id="schedule-name" Placeholder="Your name" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="schedule-email">Email</LabelCn>
                    <InputCn id="schedule-email" Placeholder="@("you@company.com")" Type="email" />
                </div>
            </div>

            <ButtonCn Class="w-full" Disabled="@(!(_selectedDay != null && _selectedTime != null))">
                Confirm Booking
            </ButtonCn>
        </form>
    </div>
</section>

@code {
    private record DaySlot(string Day, string Date, bool Available);

    private static readonly DaySlot[] _days =
    [
        new("Mon", "16", true),
        new("Tue", "17", true),
        new("Wed", "18", true),
        new("Thu", "19", false),
        new("Fri", "20", true),
    ];

    private static readonly string[] _times =
    [
        "9:00 AM", "10:00 AM", "10:30 AM", "2:00 PM", "3:00 PM", "4:00 PM"
    ];

    private string? _selectedDay = "16";
    private string? _selectedTime = null;

    private void SelectDay(DaySlot day)
    {
        if (day.Available)
            _selectedDay = day.Date;
    }

    private void SelectTime(string time)
    {
        _selectedTime = time;
    }
}
