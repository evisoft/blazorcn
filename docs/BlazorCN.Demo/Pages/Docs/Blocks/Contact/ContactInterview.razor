@* ========================================
   Block: contact-interview
   Title: Contact Interview
   Description: Interview scheduling form with role selection, availability windows, and interviewer preferences for HR teams
   Long Description: Interview scheduling component with role selection and available time slot display.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn
   Source: original/blocks/contact/contact-interview.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Schedule Your Interview</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Select your availability and we'll confirm your interview time.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="mb-4 flex items-center gap-2">
                <LucideClockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <span class="text-sm font-medium">Available Time Slots</span>
            </div>
            <div class="space-y-2">
                @foreach (var slot in _timeSlots)
                {
                    <label class="flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors hover:border-foreground has-[:checked]:border-primary">
                        <div class="flex items-center gap-3">
                            <input class="h-4 w-4 accent-primary" name="time-slot" type="radio" />
                            <div>
                                <span class="text-sm font-medium">@slot.Label</span>
                                <p class="text-xs text-muted-foreground">@slot.Time</p>
                            </div>
                        </div>
                    </label>
                }
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="role">Position</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="role">
                        <SelectValueCn Placeholder="Select position" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="frontend">Frontend Developer</SelectItemCn>
                        <SelectItemCn Value="backend">Backend Developer</SelectItemCn>
                        <SelectItemCn Value="designer">Product Designer</SelectItemCn>
                        <SelectItemCn Value="pm">Product Manager</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="Jordan Lee" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("jordan@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="phone">Phone Number</LabelCn>
                <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <div class="space-y-2">
                <LabelCn For="timezone">Your Timezone</LabelCn>
                <SelectCn Value="est">
                    <SelectTriggerCn id="timezone">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="pst">Pacific Time (PT)</SelectItemCn>
                        <SelectItemCn Value="mst">Mountain Time (MT)</SelectItemCn>
                        <SelectItemCn Value="cst">Central Time (CT)</SelectItemCn>
                        <SelectItemCn Value="est">Eastern Time (ET)</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="flex items-start gap-2">
                <CheckboxCn id="accommodations" />
                <LabelCn Class="text-sm font-normal leading-tight" For="accommodations">
                    I need accessibility accommodations (we'll follow up with details)
                </LabelCn>
            </div>

            <ButtonCn Class="w-full">Confirm Interview</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll send a calendar invite within 24 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private record TimeSlot(string Id, string Label, string Time);

    private static readonly TimeSlot[] _timeSlots =
    [
        new("morning", "Morning (9am - 12pm)", "Wednesday, Mar 20"),
        new("afternoon", "Afternoon (12pm - 5pm)", "Wednesday, Mar 20"),
        new("evening", "Evening (5pm - 7pm)", "Thursday, Mar 21"),
    ];
}
