@* ============================================================
   Block: contact-press
   Title: ContactPress
   Description: Press and media inquiry form with journalist verification and story type selection for PR teams
   Source: original/blocks/contact/contact-press.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-6 py-5">
      <h2 class="text-sm font-medium">Press Inquiries</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        For media and press requests, please fill out the form below.
      </p>
    </div>

    <form class="space-y-4 p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="name">Your Name</LabelCn>
          <InputCn id="name" Placeholder="Jane Smith" />
        </div>
        <div class="space-y-2">
          <LabelCn for="publication">Publication</LabelCn>
          <InputCn id="publication" Placeholder="TechCrunch" />
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="email">Email</LabelCn>
        <InputCn id="email" Placeholder="@("jane@@publication.com")" type="email" />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <LabelCn for="story-type">Inquiry Type</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="story-type">
              <SelectValueCn Placeholder="Select type" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="interview">Interview Request</SelectItemCn>
              <SelectItemCn Value="comment">Comment / Quote</SelectItemCn>
              <SelectItemCn Value="feature">Feature Story</SelectItemCn>
              <SelectItemCn Value="news">News Coverage</SelectItemCn>
              <SelectItemCn Value="other">Other</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
        <div class="space-y-2">
          <LabelCn for="deadline">Deadline</LabelCn>
          <SelectCn>
            <SelectTriggerCn id="deadline">
              <SelectValueCn Placeholder="When?" />
            </SelectTriggerCn>
            <SelectContentCn>
              <SelectItemCn Value="today">Today</SelectItemCn>
              <SelectItemCn Value="tomorrow">Tomorrow</SelectItemCn>
              <SelectItemCn Value="week">This Week</SelectItemCn>
              <SelectItemCn Value="flexible">Flexible</SelectItemCn>
            </SelectContentCn>
          </SelectCn>
        </div>
      </div>

      <div class="space-y-2">
        <LabelCn for="inquiry">Inquiry Details</LabelCn>
        <TextareaCn
          id="inquiry"
          Placeholder="Please describe your story angle, questions, and specific information you need..."
          Rows="4"
        />
      </div>

      <div class="border-t pt-4">
        <ButtonCn Class="w-full gap-2" Variant="ButtonVariant.Outline">
          <LucideIconCn Name="download" Size="16" Class="h-4 w-4" />
          Download Press Kit
        </ButtonCn>
      </div>

      <ButtonCn Class="w-full">
        <LucideIconCn Name="newspaper" Size="16" Class="mr-2 h-4 w-4" />
        Submit Press Request
      </ButtonCn>

      <p class="text-center text-xs text-muted-foreground">
        We aim to respond within 4 business hours.
      </p>
    </form>
  </div>
</section>

