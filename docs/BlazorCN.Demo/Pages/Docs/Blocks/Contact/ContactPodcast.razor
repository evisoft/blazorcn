@* ========================================
   Block: contact-podcast
   Title: Contact Podcast
   Description: Podcast guest application form with topic pitch, audience reach, speaking experience, and show metrics for podcast hosts
   Long Description: Sponsorship request with packages
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-podcast.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Apply to Be a Guest</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Share your expertise with our audience of developers and founders.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="rounded-lg border p-4">
            <div class="grid grid-cols-3 gap-4 text-center">
              <div>
                <p class="text-2xl font-semibold tabular-nums">320+</p>
                <p class="text-xs text-muted-foreground">Episodes</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">1.2M</p>
                <p class="text-xs text-muted-foreground">Downloads</p>
              </div>
              <div>
                <p class="text-2xl font-semibold tabular-nums">280+</p>
                <p class="text-xs text-muted-foreground">Guests</p>
              </div>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="podcast-name">Full Name</LabelCn>
              <InputCn id="podcast-name" Placeholder="Alex Rivera" />
            </div>
            <div class="space-y-2">
              <LabelCn for="podcast-email">Email</LabelCn>
              <InputCn id="podcast-email" Placeholder="@("alex@@example.com")" type="email" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="podcast-role">Current Role</LabelCn>
              <InputCn id="podcast-role" Placeholder="CTO at Acme Inc." />
            </div>
            <div class="space-y-2">
              <LabelCn for="audience-size">Your Audience Size</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="audience-size">
                  <SelectValueCn Placeholder="Select range" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="under-1k">Under 1,000</SelectItemCn>
                  <SelectItemCn Value="1k-10k">1,000 - 10,000</SelectItemCn>
                  <SelectItemCn Value="10k-50k">10,000 - 50,000</SelectItemCn>
                  <SelectItemCn Value="50k-100k">50,000 - 100,000</SelectItemCn>
                  <SelectItemCn Value="100k-plus">100,000+</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="podcast-topic">Proposed Topic</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="podcast-topic">
                <SelectValueCn Placeholder="Select a topic area" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="engineering">Engineering & Architecture</SelectItemCn>
                <SelectItemCn Value="product">Product & Design</SelectItemCn>
                <SelectItemCn Value="growth">Growth & Marketing</SelectItemCn>
                <SelectItemCn Value="leadership">Leadership & Culture</SelectItemCn>
                <SelectItemCn Value="ai">AI & Machine Learning</SelectItemCn>
                <SelectItemCn Value="startup">Startup & Fundraising</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="podcast-pitch">Topic Pitch</LabelCn>
            <TextareaCn
              id="podcast-pitch"
              Placeholder="What unique perspective would you bring? Include 3-5 key talking points..."
              Rows="3"
            />
          </div>

          <div class="space-y-2">
            <LabelCn for="links">Previous Appearances or Portfolio</LabelCn>
            <InputCn id="links" Placeholder="https://yourwebsite.com or podcast links" />
          </div>

          <ButtonCn Class="w-full">Submit Application</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            We review applications weekly and respond within 5 business days.
          </p>
        </form>
      </div>
    </section>

@code {
}
