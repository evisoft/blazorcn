@* ========================================
   Block: contact-careers
   Title: Contact Careers
   Description: Job application contact form with resume upload, position selection, and availability for recruiting teams
   Long Description: Job application with resume upload and position selection. File upload area provides clear feedback on accepted formats and size limits.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn
   Source: original/blocks/contact/contact-careers.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Join Our Team</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                We're always looking for talented people to join us.
            </p>
        </div>

        @* File upload area *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block">Resume / CV</LabelCn>
            @if (_resumeName is not null)
            {
                <div class="flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-3">
                        <LucideFileCn Class="size-5 text-muted-foreground" Size="20" />
                        <div>
                            <p class="text-sm font-medium">@_resumeName</p>
                            <p class="text-xs text-muted-foreground">@_resumeSize</p>
                        </div>
                    </div>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" OnClick="@(() => { _resumeName = null; _resumeSize = null; })" aria-label="Close">
                        <LucideXCn Class="size-4" Size="16" />
                    </ButtonCn>
                </div>
            }
            else
            {
                <label class="flex cursor-pointer flex-col items-center justify-center rounded-lg border border-dashed p-6 transition-colors hover:border-foreground"
                       for="resume-upload">
                    <LucideUploadCn Class="mb-2 size-6 text-muted-foreground" Size="24" />
                    <p class="text-sm">Upload your resume</p>
                    <p class="text-xs text-muted-foreground">PDF or DOCX up to 5MB</p>
                    <input accept=".pdf,.doc,.docx" class="hidden" id="resume-upload" type="file" />
                </label>
            }
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="position">Position</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="position">
                        <SelectValueCn Placeholder="Select position" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="frontend">Frontend Developer</SelectItemCn>
                        <SelectItemCn Value="backend">Backend Developer</SelectItemCn>
                        <SelectItemCn Value="fullstack">Full Stack Developer</SelectItemCn>
                        <SelectItemCn Value="designer">Product Designer</SelectItemCn>
                        <SelectItemCn Value="pm">Product Manager</SelectItemCn>
                        <SelectItemCn Value="other">Other</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="careers-first-name">First Name</LabelCn>
                    <InputCn id="careers-first-name" Placeholder="John" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="careers-last-name">Last Name</LabelCn>
                    <InputCn id="careers-last-name" Placeholder="Doe" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="careers-email">Email</LabelCn>
                <InputCn id="careers-email" Placeholder="@("john@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="careers-phone">Phone</LabelCn>
                <InputCn id="careers-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <div class="space-y-2">
                <LabelCn For="linkedin">LinkedIn Profile (Optional)</LabelCn>
                <InputCn id="linkedin" Placeholder="https://linkedin.com/in/yourprofile" Type="url" />
            </div>

            <ButtonCn Class="w-full">Submit Application</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                We'll review your application within 5 business days.
            </p>
        </form>
    </div>
</section>

@code {
    private string? _resumeName;
    private string? _resumeSize;
}
