@* ========================================
   Block: contact-locations
   Title: Contact Locations
   Description: Contact section displaying multiple office locations with address cards, maps, and local contact information
   Long Description: Multiple office locations with addresses in clean border-separated rows.
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, TextareaCn
   Source: original/blocks/contact/contact-locations.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Our Locations</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Visit us at one of our offices or send a message below.
            </p>
        </div>

        <div>
            @for (var i = 0; i < _locations.Length; i++)
            {
                var location = _locations[i];
                <div class="@(i < _locations.Length - 1 ? "border-b p-6" : "p-6")">
                    <div class="mb-3 flex items-center justify-between">
                        <h3 class="text-sm font-medium">@location.City</h3>
                        @if (location.IsHQ)
                        {
                            <BadgeCn>HQ</BadgeCn>
                        }
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-start gap-3">
                            <LucideMapPinCn Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                            <p class="text-sm">@location.Address</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <LucidePhoneCn Class="h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                            <a class="text-sm hover:underline" href="@($"tel:{location.Phone}")">
                                @location.Phone
                            </a>
                        </div>
                        <div class="flex items-center gap-3">
                            <LucideMailCn Class="h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                            <a class="text-sm hover:underline" href="@($"mailto:{location.Email}")">
                                @location.Email
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t p-6">
            <h3 class="mb-4 text-sm font-medium">Send Us a Message</h3>
            <form class="space-y-4">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <LabelCn For="locations-name">Name</LabelCn>
                        <InputCn id="locations-name" Placeholder="Your name" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="locations-email">Email</LabelCn>
                        <InputCn id="locations-email" Placeholder="@("your@email.com")" Type="email" />
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn For="locations-message">Message</LabelCn>
                    <TextareaCn id="locations-message" Placeholder="How can we help?" rows="3" />
                </div>
                <ButtonCn Class="w-full">Send Message</ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record OfficeLocation(string City, string Address, string Phone, string Email, bool IsHQ);

    private static readonly OfficeLocation[] _locations =
    [
        new("New York", "123 Broadway, Suite 100, New York, NY 10001", "+1 (212) 555-0100", "newyork@company.com", true),
        new("London", "45 King Street, London, WC2E 8JH", "+44 20 7123 4567", "london@company.com", false),
        new("Singapore", "1 Raffles Place, #20-01, Singapore 048616", "+65 6123 4567", "singapore@company.com", false),
    ];
}
