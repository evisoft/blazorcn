@* ============================================================
   Block: contact-tutoring
   Title: ContactTutoring
   Description: Tutoring session request form with subject selection, grade level, learning goals, and scheduling preferences for education services
   Source: original/blocks/contact/contact-tutoring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Find Your Perfect Tutor</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Personalized one-on-one learning tailored to your goals and schedule.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="subject">Subject</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="subject">
                        <SelectValueCn Placeholder="Select a subject" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="algebra">Math - Algebra</SelectItemCn>
                        <SelectItemCn Value="calculus">Math - Calculus</SelectItemCn>
                        <SelectItemCn Value="biology">Science - Biology</SelectItemCn>
                        <SelectItemCn Value="chemistry">Science - Chemistry</SelectItemCn>
                        <SelectItemCn Value="writing">English - Writing</SelectItemCn>
                        <SelectItemCn Value="sat">Test Prep - SAT</SelectItemCn>
                        <SelectItemCn Value="act">Test Prep - ACT</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="level">Grade Level</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="level">
                        <SelectValueCn Placeholder="Select grade level" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="elementary">Elementary (K-5)</SelectItemCn>
                        <SelectItemCn Value="middle">Middle School (6-8)</SelectItemCn>
                        <SelectItemCn Value="high">High School (9-12)</SelectItemCn>
                        <SelectItemCn Value="college">College / University</SelectItemCn>
                        <SelectItemCn Value="adult">Adult Learner</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-3">
                <LabelCn>Preferred Schedule</LabelCn>
                <div class="grid grid-cols-2 gap-2">
                    <div class="flex items-center gap-2">
                        <CheckboxCn id="weekday-afternoon" />
                        <LabelCn Class="text-sm font-normal" For="weekday-afternoon">
                            Weekday Afternoons
                        </LabelCn>
                    </div>
                    <div class="flex items-center gap-2">
                        <CheckboxCn id="weekday-evening" />
                        <LabelCn Class="text-sm font-normal" For="weekday-evening">
                            Weekday Evenings
                        </LabelCn>
                    </div>
                    <div class="flex items-center gap-2">
                        <CheckboxCn id="weekend" />
                        <LabelCn Class="text-sm font-normal" For="weekend">
                            Weekends
                        </LabelCn>
                    </div>
                    <div class="flex items-center gap-2">
                        <CheckboxCn id="flexible" />
                        <LabelCn Class="text-sm font-normal" For="flexible">
                            Flexible
                        </LabelCn>
                    </div>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="goals">Learning Goals (Optional)</LabelCn>
                <TextareaCn id="goals"
                            Placeholder="What are you hoping to achieve? Any specific topics or challenges?"
                            rows="2" />
            </div>

            <div class="border-b"></div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="student-name">Student Name</LabelCn>
                    <InputCn id="student-name" Placeholder="Emma Wilson" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="parent-name">Parent/Guardian (if applicable)</LabelCn>
                    <InputCn id="parent-name" Placeholder="Optional" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("emma@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="phone">Phone</LabelCn>
                <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <div class="flex items-center gap-3 rounded-lg border p-3">
                <LucideIconCn Name="graduation-cap" Size="20" Class="size-5 text-muted-foreground" />
                <div>
                    <p class="text-sm font-medium">Free Trial Session</p>
                    <p class="text-xs text-muted-foreground">
                        30-minute session to meet your tutor and assess fit
                    </p>
                </div>
            </div>

            <ButtonCn Class="w-full">Request Tutor Match</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                We'll match you with 2-3 qualified tutors within 24 hours.
            </p>
        </form>
    </div>
</section>
