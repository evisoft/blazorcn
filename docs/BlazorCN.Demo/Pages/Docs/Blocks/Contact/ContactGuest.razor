@* ========================================
   Block: contact-guest
   Title: Contact Guest
   Description: Guest registration form with visitor details, host selection, and check-in requirements for office buildings
   Long Description: Welcome visitors before they arrive. This React guest registration component captures visitor information with host notification, visit purpose, and security requirements.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn
   Source: original/blocks/contact/contact-guest.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Visitor Pre-Registration</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Register your visit in advance for a faster check-in experience.
          </p>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="first-name">First Name</LabelCn>
              <InputCn id="first-name" Placeholder="Jennifer" />
            </div>
            <div class="space-y-2">
              <LabelCn for="last-name">Last Name</LabelCn>
              <InputCn id="last-name" Placeholder="Martinez" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="company">Company</LabelCn>
              <InputCn id="company" Placeholder="Acme Partners" />
            </div>
            <div class="space-y-2">
              <LabelCn for="email">Email</LabelCn>
              <InputCn id="email" Placeholder="@("jennifer@@acme.com")" type="email" />
            </div>
          </div>

          <div class="border-b" ></div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="visit-date">Visit Date</LabelCn>
              <InputCn id="visit-date" type="date" />
            </div>
            <div class="space-y-2">
              <LabelCn for="arrival-time">Expected Arrival</LabelCn>
              <InputCn id="arrival-time" type="time" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="purpose">Purpose of Visit</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="purpose">
                  <SelectValueCn Placeholder="Why are you visiting?" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="meeting">Business Meeting</SelectItemCn>
                  <SelectItemCn Value="interview">Job Interview</SelectItemCn>
                  <SelectItemCn Value="delivery">Delivery / Pickup</SelectItemCn>
                  <SelectItemCn Value="contractor">Contractor Work</SelectItemCn>
                  <SelectItemCn Value="event">Event / Conference</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="host">Who are you visiting?</LabelCn>
              <InputCn id="host" Placeholder="Host name or department" />
            </div>
          </div>

          <div class="space-y-3">
            <div class="flex items-start gap-2">
              <CheckboxCn defaultChecked id="policies" />
              <LabelCn Class="text-sm font-normal leading-tight" for="policies">
                I agree to follow building security policies
              </LabelCn>
            </div>
          </div>

          <div class="flex items-center gap-3 rounded-lg border p-3">
            <LucideBuilding2Cn Size="20" Class="size-5 text-muted-foreground" />
            <p class="text-sm text-muted-foreground">
              Your host will be notified and a badge will be ready at reception
            </p>
          </div>

          <ButtonCn Class="w-full">Complete Registration</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            You'll receive a confirmation email with check-in instructions.
          </p>
        </form>
      </div>
    </section>

@code {
}
