@* ========================================
   Block: contact-course
   Title: Contact Course
   Description: Course enrollment form with program selection, payment plan options, and prerequisite verification for education
   Long Description: Enroll students with program selection and payment plans. Unique: course selector with pricing and schedule info.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn
   Source: original/blocks/contact/contact-course.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Course Enrollment</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Select your program and start learning with expert instructors.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">Select Program</LabelCn>
            <RadioGroupCn Class="space-y-2" Value="@_program" ValueChanged="@((string? v) => _program = v ?? "")">
                @foreach (var c in _courses)
                {
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors", _program == c.Value ? "border-primary" : "hover:border-foreground")"
                             For="@c.Value">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="@c.Value" Value="@c.Value" />
                            <div>
                                <span class="text-sm font-medium">@c.Label</span>
                                <p class="text-xs text-muted-foreground">@c.Schedule</p>
                            </div>
                        </div>
                        <span class="text-sm font-medium">@c.Price</span>
                    </LabelCn>
                }
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="first-name">First Name</LabelCn>
                    <InputCn id="first-name" Placeholder="Taylor" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="last-name">Last Name</LabelCn>
                    <InputCn id="last-name" Placeholder="Anderson" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("taylor@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="payment">Payment Plan</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="payment">
                        <SelectValueCn Placeholder="Select payment option" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="full">Pay in Full (Save $300)</SelectItemCn>
                        <SelectItemCn Value="monthly">Monthly (4 payments)</SelectItemCn>
                        <SelectItemCn Value="employer">Employer Sponsored</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <ButtonCn Class="w-full">
                <LucideGraduationCapCn Class="mr-2 h-4 w-4" Size="16" />
                Complete Enrollment
            </ButtonCn>
        </form>
    </div>
</section>

@code {
    private record CourseOption(string Value, string Label, string Schedule, string Price);

    private string _program = "";

    private static readonly CourseOption[] _courses =
    [
        new("web-dev", "Web Development", "12 weeks \u2022 Jan 15 start", "$4,500"),
        new("data-science", "Data Science", "16 weeks \u2022 Mar 10 start", "$5,500"),
        new("ux-design", "UX Design", "10 weeks \u2022 May 5 start", "$3,800"),
    ];
}
