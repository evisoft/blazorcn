@* ============================================================
   Block: contact-realestate
   Title: ContactRealestate
   Description: Real estate showing request form with property preferences, stat bar, budget range, and move-in timeline for realtors and brokerages
   Source: original/blocks/contact/contact-realestate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Schedule a Showing</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Share your preferences and we'll match you with the right properties.
            </p>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="px-4 py-4 text-center">
                <p class="text-2xl font-semibold tabular-nums">142</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Active Listings</p>
            </div>
            <div class="border-x px-4 py-4 text-center">
                <p class="text-2xl font-semibold tabular-nums">$485K</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Avg Price</p>
            </div>
            <div class="px-4 py-4 text-center">
                <p class="text-2xl font-semibold tabular-nums">38</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Sold This Month</p>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="property-type">Property Type</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="property-type">
                            <SelectValueCn Placeholder="Select type" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="single-family">Single Family</SelectItemCn>
                            <SelectItemCn Value="condo">Condo / Apartment</SelectItemCn>
                            <SelectItemCn Value="townhouse">Townhouse</SelectItemCn>
                            <SelectItemCn Value="multi-family">Multi-Family</SelectItemCn>
                            <SelectItemCn Value="land">Land / Lot</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="budget">Budget Range</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="budget">
                            <SelectValueCn Placeholder="Select range" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="under-300">Under $300K</SelectItemCn>
                            <SelectItemCn Value="300-500">$300K – $500K</SelectItemCn>
                            <SelectItemCn Value="500-750">$500K – $750K</SelectItemCn>
                            <SelectItemCn Value="750-1m">$750K – $1M</SelectItemCn>
                            <SelectItemCn Value="over-1m">$1M+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
                <div class="space-y-2">
                    <LabelCn For="bedrooms">Bedrooms</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="bedrooms">
                            <SelectValueCn Placeholder="Min" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1">1+</SelectItemCn>
                            <SelectItemCn Value="2">2+</SelectItemCn>
                            <SelectItemCn Value="3">3+</SelectItemCn>
                            <SelectItemCn Value="4">4+</SelectItemCn>
                            <SelectItemCn Value="5">5+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="bathrooms">Bathrooms</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="bathrooms">
                            <SelectValueCn Placeholder="Min" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1">1+</SelectItemCn>
                            <SelectItemCn Value="2">2+</SelectItemCn>
                            <SelectItemCn Value="3">3+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="timeline">Move-in</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="timeline">
                            <SelectValueCn Placeholder="When" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="asap">ASAP</SelectItemCn>
                            <SelectItemCn Value="1-3">1–3 months</SelectItemCn>
                            <SelectItemCn Value="3-6">3–6 months</SelectItemCn>
                            <SelectItemCn Value="6-12">6–12 months</SelectItemCn>
                            <SelectItemCn Value="browsing">Just browsing</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="neighborhood">Preferred Neighborhoods</LabelCn>
                <InputCn id="neighborhood" Placeholder="e.g. Downtown, Westside, Maple District" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="Taylor Morgan" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("taylor@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="notes">Additional Notes</LabelCn>
                <TextareaCn id="notes"
                            Placeholder="Must-haves, deal breakers, pet requirements..."
                            rows="2" />
            </div>

            <div class="flex items-center gap-3 rounded-lg border p-3">
                <LucideIconCn Name="home" Size="20" Class="size-5 text-muted-foreground" />
                <div>
                    <p class="text-sm font-medium">Pre-Approval Ready?</p>
                    <p class="text-xs text-muted-foreground">
                        Pre-approved buyers get priority access to new listings
                    </p>
                </div>
            </div>

            <ButtonCn Class="w-full">Request Property Showing</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                A local agent will reach out within 24 hours to schedule your tour.
            </p>
        </form>
    </div>
</section>
