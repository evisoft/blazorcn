@* ============================================================
   Block: contact-retreat
   Title: ContactRetreat
   Description: Retreat or workshop registration form with session selection, accommodation options, and dietary needs for event organizers
   Source: original/blocks/contact/contact-retreat.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Wellness Retreat Registration</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Join us for a transformative 5-day journey of renewal and self-discovery.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="mb-4">
                <h3 class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    Accommodation
                </h3>
            </div>

            <RadioGroupCn Class="space-y-3"
                          Value="@_accommodation" ValueChanged="@((string? v) => _accommodation = v ?? "private")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _accommodation == "shared-room" ? "border-primary" : "hover:border-foreground")"
                         For="acc-shared-room">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="acc-shared-room" Value="shared-room" />
                        <div>
                            <span class="font-medium">Shared Room</span>
                            <p class="text-xs text-muted-foreground">2 people, private bath</p>
                        </div>
                    </div>
                    <span class="font-semibold">$1,100</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _accommodation == "private" ? "border-primary" : "hover:border-foreground")"
                         For="acc-private">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="acc-private" Value="private" />
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-medium">Private Room</span>
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                    Popular
                                </BadgeCn>
                            </div>
                            <p class="text-xs text-muted-foreground">Queen bed, private bath</p>
                        </div>
                    </div>
                    <span class="font-semibold">$1,450</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors", _accommodation == "premium" ? "border-primary" : "hover:border-foreground")"
                         For="acc-premium">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="acc-premium" Value="premium" />
                        <div>
                            <span class="font-medium">Premium Suite</span>
                            <p class="text-xs text-muted-foreground">King bed, ocean view</p>
                        </div>
                    </div>
                    <span class="font-semibold">$1,950</span>
                </LabelCn>
            </RadioGroupCn>

            <div class="border-t pt-6 mt-6">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <LabelCn For="retreat-name">Full Name</LabelCn>
                        <InputCn id="retreat-name" Placeholder="Maya Patel" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="retreat-email">Email</LabelCn>
                        <InputCn id="retreat-email" Placeholder="@("maya@example.com")" Type="email" />
                    </div>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="retreat-phone">Phone</LabelCn>
                <InputCn id="retreat-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <div class="space-y-2">
                <LabelCn For="retreat-dietary">Dietary Requirements</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="retreat-dietary">
                        <SelectValueCn Placeholder="Select dietary preference" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="none">No restrictions</SelectItemCn>
                        <SelectItemCn Value="vegetarian">Vegetarian</SelectItemCn>
                        <SelectItemCn Value="vegan">Vegan</SelectItemCn>
                        <SelectItemCn Value="gluten-free">Gluten-free</SelectItemCn>
                        <SelectItemCn Value="other">Other (specify below)</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="retreat-notes">Allergies or Special Needs</LabelCn>
                <TextareaCn id="retreat-notes"
                            Placeholder="Any food allergies, mobility needs, or other requirements..."
                            rows="2" />
            </div>

            <div class="rounded-lg border p-4">
                <p class="text-sm">
                    <span class="font-medium">Early Bird Pricing:</span>
                    <span class="text-muted-foreground">
                        $500 deposit reserves your spot. Balance due 30 days before retreat.
                    </span>
                </p>
            </div>

            <ButtonCn Class="w-full">Reserve My Spot</ButtonCn>
        </form>
    </div>
</section>

@code {
    private string _accommodation = "private";
}
