@* ============================================================
   Block: contact-warranty
   Title: ContactWarranty
   Description: Warranty claim form with product registration, issue description, and proof of purchase for support teams
   Source: original/blocks/contact/contact-warranty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Warranty Claim</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Submit a warranty claim for your product. We'll process it within 48 hours.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="serial">Serial Number</LabelCn>
                <InputCn id="serial" Placeholder="SN-XXXX-XXXX-XXXX" />
                <p class="text-xs text-muted-foreground">Found on the product label or packaging</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="product">Product Name</LabelCn>
                    <InputCn id="product" Placeholder="Model XYZ-2000" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="purchase-date">Purchase Date</LabelCn>
                    <InputCn id="purchase-date" Type="date" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="issue-type">Issue Type</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="issue-type">
                        <SelectValueCn Placeholder="Select issue type" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="doa">Defective on Arrival</SelectItemCn>
                        <SelectItemCn Value="malfunction">Stopped Working</SelectItemCn>
                        <SelectItemCn Value="damage">Physical Damage</SelectItemCn>
                        <SelectItemCn Value="missing">Missing Parts</SelectItemCn>
                        <SelectItemCn Value="performance">Performance Issue</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="description">Describe the Issue</LabelCn>
                <TextareaCn id="description"
                            Placeholder="Please provide details about what happened and when the issue started..."
                            rows="3" />
            </div>

            <div class="space-y-2">
                <LabelCn For="resolution">Preferred Resolution</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="resolution">
                        <SelectValueCn Placeholder="How would you like this resolved?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="repair">Repair</SelectItemCn>
                        <SelectItemCn Value="replace">Replacement</SelectItemCn>
                        <SelectItemCn Value="refund">Refund</SelectItemCn>
                        <SelectItemCn Value="any">No Preference</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="border-b"></div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="order">Order Number (Optional)</LabelCn>
                    <InputCn id="order" Placeholder="ORD-123456" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("john@example.com")" Type="email" />
            </div>

            <div class="space-y-2">
                <LabelCn For="phone">Phone Number</LabelCn>
                <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
            </div>

            <div class="flex items-start gap-2">
                <CheckboxCn id="confirm" />
                <LabelCn Class="text-sm font-normal leading-tight" For="confirm">
                    I confirm this product is within the warranty period and has not been damaged through
                    misuse
                </LabelCn>
            </div>

            <div class="flex items-center gap-3 rounded-lg border p-3">
                <LucideIconCn Name="calendar" Size="20" Class="size-5 text-muted-foreground" />
                <p class="text-sm text-muted-foreground">
                    Claims are typically processed within 2-3 business days
                </p>
            </div>

            <ButtonCn Class="w-full">Submit Warranty Claim</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                You'll receive a claim number and next steps via email.
            </p>
        </form>
    </div>
</section>
