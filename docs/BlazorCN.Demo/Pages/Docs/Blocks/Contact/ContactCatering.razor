@* ========================================
   Block: contact-catering
   Title: Contact Catering
   Description: Catering inquiry form with event type, guest count, menu preferences, and service style for food service businesses
   Long Description: Catering inquiry with interactive guest count slider and menu preferences. Visual slider makes selecting party size intuitive and engaging.
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, SelectCn, SliderCn
   Source: original/blocks/contact/contact-catering.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Catering Inquiry</h2>
            <p class="text-xs text-muted-foreground">
                From intimate dinners to grand celebrations, we'll create the perfect menu.
            </p>
        </div>

        @* Guest count slider *@
        <div class="border-b p-6">
            <div class="mb-4 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideUsersCn Class="size-4 text-muted-foreground" Size="16" />
                    <LabelCn>Estimated Guests</LabelCn>
                </div>
                <span class="text-lg font-semibold tabular-nums">@_guests</span>
            </div>
            <SliderCn Class="py-2" Max="500" Min="10" Value="@_guests"
                      ValueChanged="@((double v) => _guests = v)" Step="5" />
            <div class="mt-2 flex justify-between text-xs text-muted-foreground">
                <span>10 guests</span>
                <span>500 guests</span>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="event-type">Event Type</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="event-type">
                            <SelectValueCn Placeholder="Select type" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="wedding">Wedding</SelectItemCn>
                            <SelectItemCn Value="corporate">Corporate Event</SelectItemCn>
                            <SelectItemCn Value="birthday">Birthday / Anniversary</SelectItemCn>
                            <SelectItemCn Value="holiday">Holiday Party</SelectItemCn>
                            <SelectItemCn Value="other">Other</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="event-date">Event Date</LabelCn>
                    <InputCn id="event-date" Type="date" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="service">Service Style</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="service">
                        <SelectValueCn Placeholder="Select style" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="buffet">Buffet - Self-serve stations</SelectItemCn>
                        <SelectItemCn Value="plated">Plated - Formal sit-down</SelectItemCn>
                        <SelectItemCn Value="family">Family Style - Shared platters</SelectItemCn>
                        <SelectItemCn Value="stations">Food Stations - Interactive</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-3">
                <LabelCn>Menu Preferences</LabelCn>
                <div class="grid grid-cols-2 gap-2">
                    @foreach (var cuisine in _cuisines)
                    {
                        <div class="flex items-center gap-2">
                            <CheckboxCn id="@cuisine" />
                            <LabelCn Class="text-sm font-normal" For="@cuisine">
                                @cuisine
                            </LabelCn>
                        </div>
                    }
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Your Name</LabelCn>
                    <InputCn id="name" Placeholder="Rachel Green" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="phone">Phone</LabelCn>
                    <InputCn id="phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="email">Email</LabelCn>
                <InputCn id="email" Placeholder="@("rachel@example.com")" Type="email" />
            </div>

            <ButtonCn Class="w-full">Request Proposal</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                We'll send a detailed proposal within 48 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private double _guests = 75;

    private static readonly string[] _cuisines =
    [
        "American", "Italian", "Asian Fusion", "Mexican", "Mediterranean", "BBQ",
    ];
}
