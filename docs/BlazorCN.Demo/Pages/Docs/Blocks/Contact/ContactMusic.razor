@* ========================================
   Block: contact-music
   Title: Contact Music
   Description: Music lesson booking and DJ inquiry form with instrument selection, skill level, and scheduling preferences for studios and instructors
   Long Description: Course enrollment with payments
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-music.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Book a Music Lesson</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Private and group lessons for all ages and skill levels.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">Your Skill Level</LabelCn>
            <RadioGroupCn Class="grid grid-cols-3 gap-2"
                          Value="@_level" ValueChanged="@((string? v) => _level = v ?? "beginner")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _level == "beginner" ? "border-primary" : "hover:border-foreground")"
                         For="lvl-beginner">
                    <RadioGroupItemCn Class="sr-only" Id="lvl-beginner" Value="beginner" />
                    <span class="text-xs font-medium">Beginner</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">Just starting out</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _level == "intermediate" ? "border-primary" : "hover:border-foreground")"
                         For="lvl-intermediate">
                    <RadioGroupItemCn Class="sr-only" Id="lvl-intermediate" Value="intermediate" />
                    <span class="text-xs font-medium">Intermediate</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">1-3 years playing</span>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center rounded-lg border p-3 text-center transition-colors", _level == "advanced" ? "border-primary" : "hover:border-foreground")"
                         For="lvl-advanced">
                    <RadioGroupItemCn Class="sr-only" Id="lvl-advanced" Value="advanced" />
                    <span class="text-xs font-medium">Advanced</span>
                    <span class="mt-0.5 text-[10px] text-muted-foreground">3+ years experience</span>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="music-name">Full Name</LabelCn>
                    <InputCn id="music-name" Placeholder="Sam Rodriguez" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="music-email">Email</LabelCn>
                    <InputCn id="music-email" Placeholder="@("sam@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="instrument">Instrument</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="instrument">
                        <SelectValueCn Placeholder="Select an instrument" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="piano">Piano / Keyboard</SelectItemCn>
                        <SelectItemCn Value="guitar">Guitar</SelectItemCn>
                        <SelectItemCn Value="drums">Drums</SelectItemCn>
                        <SelectItemCn Value="vocals">Vocals</SelectItemCn>
                        <SelectItemCn Value="bass">Bass</SelectItemCn>
                        <SelectItemCn Value="violin">Violin</SelectItemCn>
                        <SelectItemCn Value="dj">DJ / Production</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="music-format">Lesson Format</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="music-format">
                        <SelectValueCn Placeholder="How would you like to learn?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="private-30">Private (30 min)</SelectItemCn>
                        <SelectItemCn Value="private-60">Private (60 min)</SelectItemCn>
                        <SelectItemCn Value="group">Group Class</SelectItemCn>
                        <SelectItemCn Value="online">Online Lesson</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="music-goals">What would you like to learn?</LabelCn>
                <TextareaCn id="music-goals" Placeholder="Specific songs, techniques, or goals..." rows="2" />
            </div>

            <ButtonCn Class="w-full">Book a Trial Lesson</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                First lesson is 50% off. No long-term commitment required.
            </p>
        </form>
    </div>
</section>

@code {
    private string _level = "beginner";
}
