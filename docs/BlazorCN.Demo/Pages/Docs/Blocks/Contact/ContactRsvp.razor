@* ========================================
   Block: contact-rsvp
   Title: Contact Rsvp
   Description: Event RSVP form with attendance confirmation, guest count, meal selection, and dietary notes for event planning
   Long Description: Event registration with tickets
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-rsvp.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Sarah &amp; Michael's Wedding</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Saturday, June 21, 2025 \u2022 The Grand Estate
            </p>
        </div>

        <div class="p-6">
            <div class="mb-6 rounded-lg border p-4 text-center">
                <p class="text-sm font-medium">Please respond by May 15, 2025</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Ceremony at 4:00 PM \u2022 Reception to follow
                </p>
            </div>

            <form class="space-y-6">
                <div class="space-y-3">
                    <LabelCn Class="text-sm font-medium">Will you be attending?</LabelCn>
                    <RadioGroupCn Class="grid grid-cols-2 gap-3"
                                  Value="@_attending" ValueChanged="@((string? v) => _attending = v ?? "")">
                        <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center justify-center rounded-lg border p-4 transition-colors", _attending == "yes" ? "border-primary bg-primary/5" : "hover:border-foreground")"
                                 For="attending-yes">
                            <RadioGroupItemCn Class="sr-only" Id="attending-yes" Value="yes" />
                            <span class="mb-1 text-2xl">\ud83c\udf89</span>
                            <span class="font-medium">Joyfully Accept</span>
                        </LabelCn>
                        <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col items-center justify-center rounded-lg border p-4 transition-colors", _attending == "no" ? "border-primary bg-primary/5" : "hover:border-foreground")"
                                 For="attending-no">
                            <RadioGroupItemCn Class="sr-only" Id="attending-no" Value="no" />
                            <span class="mb-1 text-2xl">\ud83d\ude22</span>
                            <span class="font-medium">Regretfully Decline</span>
                        </LabelCn>
                    </RadioGroupCn>
                </div>

                @if (_attending == "yes")
                {
                    <div class="space-y-4 border-t pt-6">
                        <div class="space-y-2">
                            <LabelCn For="rsvp-name">Your Name</LabelCn>
                            <InputCn id="rsvp-name" Placeholder="As it appears on your invitation" />
                        </div>

                        <div class="space-y-2">
                            <LabelCn For="guests">Number of Guests</LabelCn>
                            <SelectCn Value="@_guestCount" ValueChanged="@((string v) => _guestCount = v)">
                                <SelectTriggerCn id="guests">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="1">Just me</SelectItemCn>
                                    <SelectItemCn Value="2">2 guests</SelectItemCn>
                                    <SelectItemCn Value="3">3 guests</SelectItemCn>
                                    <SelectItemCn Value="4">4 guests</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        @if (int.Parse(_guestCount) > 1)
                        {
                            <div class="space-y-2">
                                <LabelCn>Guest Names</LabelCn>
                                @for (var i = 0; i < int.Parse(_guestCount) - 1; i++)
                                {
                                    var guestNum = i + 2;
                                    <InputCn Placeholder="@($"Guest {guestNum} name")" aria-label="@($"Guest {guestNum} name")" />
                                }
                            </div>
                        }

                        <div class="space-y-2">
                            <LabelCn For="meal">Meal Selection</LabelCn>
                            <SelectCn>
                                <SelectTriggerCn id="meal">
                                    <SelectValueCn Placeholder="Select entr\u00e9e" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="beef">Filet Mignon</SelectItemCn>
                                    <SelectItemCn Value="chicken">Herb Roasted Chicken</SelectItemCn>
                                    <SelectItemCn Value="fish">Pan-Seared Salmon</SelectItemCn>
                                    <SelectItemCn Value="vegetarian">Vegetarian Risotto</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        <div class="space-y-2">
                            <LabelCn For="rsvp-dietary">Dietary Restrictions or Allergies</LabelCn>
                            <TextareaCn id="rsvp-dietary"
                                        Placeholder="Please let us know of any allergies..."
                                        rows="2" />
                        </div>
                    </div>
                }

                @if (_attending == "no")
                {
                    <div class="space-y-4 border-t pt-6">
                        <div class="space-y-2">
                            <LabelCn For="decline-name">Your Name</LabelCn>
                            <InputCn id="decline-name" Placeholder="So we know who responded" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn For="rsvp-message">Send a Message (Optional)</LabelCn>
                            <TextareaCn id="rsvp-message"
                                        Placeholder="Share your well wishes with the couple..."
                                        rows="3" />
                        </div>
                    </div>
                }

                <ButtonCn Class="w-full" disabled="@(string.IsNullOrEmpty(_attending))">
                    @(_attending == "yes" ? "Confirm Attendance" : _attending == "no" ? "Send Response" : "Submit RSVP")
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private string _attending = "";
    private string _guestCount = "1";
}
