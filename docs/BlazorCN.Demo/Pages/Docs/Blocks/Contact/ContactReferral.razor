@* ========================================
   Block: contact-referral
   Title: Contact Referral
   Description: Referral submission form with referee details and relationship context for customer referral programs
   Long Description: Turn happy customers into advocates. This React referral form component captures customer referrals with referee details, relationship context, and optional message.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-referral.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Refer a Friend</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Know someone who would benefit from our product? Share the love.
          </p>
        </div>

        @* Unique UI: reward callout *@
        <div class="flex items-center gap-3 border-b px-6 py-4">
          <LucideGiftCn Size="20" Class="size-5 text-muted-foreground" />
          <div>
            <p class="text-sm font-medium">Give $50, Get $50</p>
            <p class="text-xs text-muted-foreground">
              You both get $50 credit when they sign up
            </p>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="referee-name">Their Name</LabelCn>
              <InputCn id="referee-name" Placeholder="Jane Smith" />
            </div>
            <div class="space-y-2">
              <LabelCn for="referee-email">Their Email</LabelCn>
              <InputCn id="referee-email" Placeholder="@("jane@@company.com")" type="email" />
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="referral-relationship">Your Relationship</LabelCn>
            <SelectCn>
              <SelectTriggerCn id="referral-relationship">
                <SelectValueCn Placeholder="How do you know them?" />
              </SelectTriggerCn>
              <SelectContentCn>
                <SelectItemCn Value="colleague">Colleague</SelectItemCn>
                <SelectItemCn Value="friend">Friend</SelectItemCn>
                <SelectItemCn Value="industry-peer">Industry Peer</SelectItemCn>
                <SelectItemCn Value="client">Client</SelectItemCn>
                <SelectItemCn Value="other">Other</SelectItemCn>
              </SelectContentCn>
            </SelectCn>
          </div>

          <div class="space-y-2">
            <LabelCn for="referral-message">Personal Message (Optional)</LabelCn>
            <TextareaCn
              id="referral-message"
              Placeholder="Add a note we can include when reaching out..."
              Rows="2"
            />
          </div>

          <div class="border-b" ></div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="your-name">Your Name</LabelCn>
              <InputCn id="your-name" Placeholder="John Doe" />
            </div>
            <div class="space-y-2">
              <LabelCn for="your-email">Your Email</LabelCn>
              <InputCn id="your-email" Placeholder="@("john@@company.com")" type="email" />
            </div>
          </div>

          <ButtonCn Class="w-full">Submit Referral</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            We'll reach out to your referral within 24 hours.
          </p>
        </form>
      </div>
    </section>

