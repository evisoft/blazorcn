@* ========================================
   Block: contact-franchise
   Title: Contact Franchise
   Description: Franchise inquiry form with investment range selector, territory preference, stat bar overview, and business experience details
   Long Description: Franchise inquiry form featuring a three-column stat bar displaying total locations, minimum investment, and average ROI. Designed for franchise brands, restaurant chains, and business opportunity platforms.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-franchise.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
          <h2 class="text-sm font-medium">Franchise Inquiry</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Learn about ownership opportunities in your area.
          </p>
        </div>

        <div class="border-b p-6">
          <div class="grid grid-cols-3 divide-x text-center">
            <div class="px-3">
              <div class="flex items-center justify-center gap-1.5 text-muted-foreground">
                <LucideBuilding2Cn Size="12" Class="h-3.5 w-3.5" />
                <span class="text-xs">Locations</span>
              </div>
              <p class="mt-1 text-2xl font-semibold tabular-nums">840+</p>
            </div>
            <div class="px-3">
              <div class="flex items-center justify-center gap-1.5 text-muted-foreground">
                <LucideDollarSignCn Size="12" Class="h-3.5 w-3.5" />
                <span class="text-xs">Min. Investment</span>
              </div>
              <p class="mt-1 text-2xl font-semibold tabular-nums">$150K</p>
            </div>
            <div class="px-3">
              <div class="flex items-center justify-center gap-1.5 text-muted-foreground">
                <LucideTrendingUpCn Size="12" Class="h-3.5 w-3.5" />
                <span class="text-xs">Avg. ROI</span>
              </div>
              <p class="mt-1 text-2xl font-semibold tabular-nums">22%</p>
            </div>
          </div>
        </div>

        <form class="space-y-4 p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="franchise-first-name">First Name</LabelCn>
              <InputCn id="franchise-first-name" Placeholder="Robert" />
            </div>
            <div class="space-y-2">
              <LabelCn for="franchise-last-name">Last Name</LabelCn>
              <InputCn id="franchise-last-name" Placeholder="Chen" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="franchise-email">Email</LabelCn>
              <InputCn id="franchise-email" Placeholder="@("robert@@example.com")" type="email" />
            </div>
            <div class="space-y-2">
              <LabelCn for="franchise-phone">Phone</LabelCn>
              <InputCn id="franchise-phone" Placeholder="+1 (555) 000-0000" type="tel" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <LabelCn for="investment">Investment Range</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="investment">
                  <SelectValueCn Placeholder="Select range" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="150-250">$150K – $250K</SelectItemCn>
                  <SelectItemCn Value="250-500">$250K – $500K</SelectItemCn>
                  <SelectItemCn Value="500-750">$500K – $750K</SelectItemCn>
                  <SelectItemCn Value="750+">$750K+</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
            <div class="space-y-2">
              <LabelCn for="territory">Preferred Territory</LabelCn>
              <SelectCn>
                <SelectTriggerCn id="territory">
                  <SelectValueCn Placeholder="Select region" />
                </SelectTriggerCn>
                <SelectContentCn>
                  <SelectItemCn Value="northeast">Northeast</SelectItemCn>
                  <SelectItemCn Value="southeast">Southeast</SelectItemCn>
                  <SelectItemCn Value="midwest">Midwest</SelectItemCn>
                  <SelectItemCn Value="southwest">Southwest</SelectItemCn>
                  <SelectItemCn Value="west">West Coast</SelectItemCn>
                </SelectContentCn>
              </SelectCn>
            </div>
          </div>

          <div class="space-y-2">
            <LabelCn for="franchise-experience">Business Experience</LabelCn>
            <TextareaCn
              id="franchise-experience"
              Placeholder="Briefly describe your management or business ownership background..."
              Rows="2"
            />
          </div>

          <ButtonCn Class="w-full">Request Franchise Information</ButtonCn>

          <p class="text-center text-xs text-muted-foreground">
            No commitment. A franchise advisor will reach out within 48 hours.
          </p>
        </form>
      </div>
    </section>

