@* ========================================
   Block: contact-tax
   Title: Contact Tax
   Description: Tax service request form with filing type selection, financial situation details, and document checklist for accounting firms
   Long Description: Legal consultation request form
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-tax.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Request Tax Services</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us about your tax situation and we'll pair you with the right specialist.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Filing Type</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-3"
                              Value="@_filingType" ValueChanged="@((string? v) => _filingType = v ?? "individual")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _filingType == "individual" ? "border-primary" : "hover:border-foreground")"
                             For="ft-individual">
                        <RadioGroupItemCn Id="ft-individual" Value="individual" />
                        <div>
                            <span class="text-sm font-medium">Individual</span>
                            <p class="text-xs text-muted-foreground">Personal returns</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _filingType == "business" ? "border-primary" : "hover:border-foreground")"
                             For="ft-business">
                        <RadioGroupItemCn Id="ft-business" Value="business" />
                        <div>
                            <span class="text-sm font-medium">Business</span>
                            <p class="text-xs text-muted-foreground">LLC, S-Corp, C-Corp</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _filingType == "estate" ? "border-primary" : "hover:border-foreground")"
                             For="ft-estate">
                        <RadioGroupItemCn Id="ft-estate" Value="estate" />
                        <div>
                            <span class="text-sm font-medium">Estate</span>
                            <p class="text-xs text-muted-foreground">Trust &amp; estate tax</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors", _filingType == "nonprofit" ? "border-primary" : "hover:border-foreground")"
                             For="ft-nonprofit">
                        <RadioGroupItemCn Id="ft-nonprofit" Value="nonprofit" />
                        <div>
                            <span class="text-sm font-medium">Nonprofit</span>
                            <p class="text-xs text-muted-foreground">Form 990 filing</p>
                        </div>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="David Chen" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("david@example.com")" Type="email" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="tax-year">Tax Year</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="tax-year">
                            <SelectValueCn Placeholder="Select year" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="2025">2025</SelectItemCn>
                            <SelectItemCn Value="2024">2024</SelectItemCn>
                            <SelectItemCn Value="2023">2023</SelectItemCn>
                            <SelectItemCn Value="multiple">Multiple years</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="income-source">Primary Income</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="income-source">
                            <SelectValueCn Placeholder="Select source" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="w2">W-2 Employment</SelectItemCn>
                            <SelectItemCn Value="self-employed">Self-Employed / 1099</SelectItemCn>
                            <SelectItemCn Value="business-income">Business Income</SelectItemCn>
                            <SelectItemCn Value="investments">Investments / Capital Gains</SelectItemCn>
                            <SelectItemCn Value="rental">Rental Income</SelectItemCn>
                            <SelectItemCn Value="mixed">Multiple Sources</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="service">Service Needed</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="service">
                        <SelectValueCn Placeholder="What do you need?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="preparation">Tax Preparation</SelectItemCn>
                        <SelectItemCn Value="planning">Tax Planning</SelectItemCn>
                        <SelectItemCn Value="amendment">File an Amendment</SelectItemCn>
                        <SelectItemCn Value="audit">Audit Representation</SelectItemCn>
                        <SelectItemCn Value="consulting">General Tax Consulting</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="details">Describe Your Situation</LabelCn>
                <TextareaCn id="details"
                            Placeholder="Any special circumstances, recent life changes, or questions..."
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Request Consultation</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                A CPA will reach out within 1 business day to schedule your review.
            </p>
        </form>
    </div>
</section>

@code {
    private string _filingType = "individual";
}
