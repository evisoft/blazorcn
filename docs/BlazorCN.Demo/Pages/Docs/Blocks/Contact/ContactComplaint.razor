@* ========================================
   Block: contact-complaint
   Title: Contact Complaint
   Description: Customer complaint form with incident details, resolution expectations, and escalation options for service recovery
   Long Description: Complaint form with severity levels and resolution preferences. Impact selector helps prioritize urgent issues while collecting actionable feedback.
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-complaint.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">We Want to Make This Right</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                We're sorry you had a poor experience. Please share details so we can resolve this.
            </p>
        </div>

        @* Severity/impact selector *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                How Much Did This Impact You?
            </LabelCn>
            <RadioGroupCn Class="space-y-2">
                @foreach (var level in _impactLevels)
                {
                    <LabelCn Class="flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors hover:border-foreground has-[[data-state=checked]]:border-primary"
                             For="@($"impact-{level.Value}")">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="@($"impact-{level.Value}")" Value="@level.Value" />
                            <div>
                                <span class="text-sm font-medium">@level.Label</span>
                                <p class="text-xs text-muted-foreground">@level.Desc</p>
                            </div>
                        </div>
                        @if (level.ShowBadge)
                        {
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Destructive">
                                Priority
                            </BadgeCn>
                        }
                    </LabelCn>
                }
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="complaint-order">Order / Reference #</LabelCn>
                    <InputCn id="complaint-order" Placeholder="ORD-123456" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="complaint-category">Category</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="complaint-category">
                            <SelectValueCn Placeholder="What is this regarding?" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="product">Product Quality / Defect</SelectItemCn>
                            <SelectItemCn Value="service">Poor Service Experience</SelectItemCn>
                            <SelectItemCn Value="delivery">Delivery Issue</SelectItemCn>
                            <SelectItemCn Value="billing">Billing / Charges Error</SelectItemCn>
                            <SelectItemCn Value="other">Other</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="complaint-description">What happened?</LabelCn>
                <TextareaCn id="complaint-description"
                            Placeholder="Please describe the issue in detail..."
                            rows="4" />
            </div>

            <div class="space-y-2">
                <LabelCn For="complaint-resolution">Desired Resolution</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="complaint-resolution">
                        <SelectValueCn Placeholder="How can we make this right?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="refund">Full Refund</SelectItemCn>
                        <SelectItemCn Value="partial">Partial Refund</SelectItemCn>
                        <SelectItemCn Value="replacement">Replacement</SelectItemCn>
                        <SelectItemCn Value="credit">Store Credit</SelectItemCn>
                        <SelectItemCn Value="apology">Apology &amp; Explanation</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="complaint-name">Full Name</LabelCn>
                    <InputCn id="complaint-name" Placeholder="Robert Kim" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="complaint-email">Email</LabelCn>
                    <InputCn id="complaint-email" Placeholder="@("robert@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <CheckboxCn id="callback" />
                    <LabelCn Class="text-sm font-normal" For="callback">
                        I would like a phone call to discuss this
                    </LabelCn>
                </div>
            </div>

            <ButtonCn Class="w-full">Submit Complaint</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                We respond to all complaints within 24 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private record ImpactLevel(string Value, string Label, string Desc, bool ShowBadge);

    private static readonly ImpactLevel[] _impactLevels =
    [
        new("minor", "Minor Inconvenience", "Slight frustration", false),
        new("moderate", "Moderate Impact", "Disrupted my plans", false),
        new("significant", "Significant Problem", "Caused real harm", false),
        new("severe", "Severe / Urgent", "Immediate attention needed", true),
    ];
}
