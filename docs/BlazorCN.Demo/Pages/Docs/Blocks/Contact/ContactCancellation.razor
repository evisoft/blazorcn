@* ========================================
   Block: contact-cancellation
   Title: Contact Cancellation
   Description: Subscription cancellation form with reason selection, retention offers, and feedback collection for churn reduction
   Long Description: Cancellation form with reason selection and dynamic retention offers. Captures feedback while presenting alternatives to reduce churn.
   Dependencies: ButtonCn, CheckboxCn, LabelCn, RadioGroupCn, TextareaCn
   Source: original/blocks/contact/contact-cancellation.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">We're Sorry to See You Go</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Before you cancel, help us understand how we can improve.
            </p>
        </div>

        @* Retention offer *@
        <div class="border-b bg-muted/50 px-6 py-4">
            <div class="flex items-start gap-3">
                <LucideGiftCn Class="size-5 shrink-0 text-primary" Size="20" />
                <div>
                    <p class="text-sm font-medium">Stay for 50% off</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We'd hate to see you go. How about 50% off your next 3 months?
                    </p>
                    <ButtonCn Class="mt-3" Size="ButtonSize.Sm">
                        Claim Discount
                    </ButtonCn>
                </div>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn Class="text-sm font-medium">Why are you canceling?</LabelCn>
                <RadioGroupCn Class="space-y-2">
                    @foreach (var reason in _reasons)
                    {
                        <LabelCn Class="flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition-colors hover:border-foreground has-[[data-state=checked]]:border-primary"
                                 For="@($"reason-{reason}")">
                            <RadioGroupItemCn Id="@($"reason-{reason}")" Value="@reason" />
                            <span class="text-sm">@reason</span>
                        </LabelCn>
                    }
                </RadioGroupCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="cancellation-feedback">What could we have done better? (Optional)</LabelCn>
                <TextareaCn id="cancellation-feedback" Placeholder="Your feedback helps us improve..." rows="3" />
            </div>

            <div class="space-y-3 border-t pt-4">
                <div class="flex items-start gap-2">
                    <CheckboxCn id="cancellation-confirm" />
                    <LabelCn Class="text-xs font-normal leading-tight text-muted-foreground"
                             For="cancellation-confirm">
                        I understand my subscription will end on Jan 15, 2025 and I'll lose access to Pro
                        features
                    </LabelCn>
                </div>
            </div>

            <div class="rounded-lg border border-dashed p-4 text-center">
                <p class="mb-3 text-xs text-muted-foreground">
                    Not ready to cancel? Downgrade to our Free plan instead.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Switch to Free Plan
                </ButtonCn>
            </div>

            <div class="flex gap-3">
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                    Keep Subscription
                </ButtonCn>
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Destructive">
                    Cancel Subscription
                </ButtonCn>
            </div>

            <p class="text-center text-xs text-muted-foreground">
                You can reactivate anytime. We'll save your data for 30 days.
            </p>
        </form>
    </div>
</section>

@code {
    private static readonly string[] _reasons =
    [
        "Too expensive",
        "Not using it enough",
        "Missing features I need",
        "Switching to another product",
        "Technical issues or bugs",
        "Temporary\u2014I'll be back",
        "Other reason",
    ];
}
