@* ========================================
   Block: contact-consultation
   Title: Contact Consultation
   Description: Consultation booking form with service selection, duration picker, and brief intake for professional services
   Long Description: Consultation booking with service and duration selection. Transparent pricing display helps qualify leads upfront.
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, RadioGroupCn, TextareaCn
   Source: original/blocks/contact/contact-consultation.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Book a Consultation</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Get expert advice tailored to your specific needs.
            </p>
        </div>

        @* Consultation type with pricing *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Select Service
            </LabelCn>
            <RadioGroupCn Class="space-y-3" Value="strategy">
                @foreach (var service in _services)
                {
                    <LabelCn Class="flex cursor-pointer items-start gap-3 rounded-lg border p-4 transition-colors hover:border-foreground has-[[data-state=checked]]:border-primary"
                             For="@($"service-{service.Value}")">
                        <RadioGroupItemCn Class="mt-0.5" Id="@($"service-{service.Value}")" Value="@service.Value" />
                        <div>
                            <span class="font-medium">@service.Label</span>
                            <p class="text-sm text-muted-foreground">@service.Desc</p>
                        </div>
                    </LabelCn>
                }
            </RadioGroupCn>
        </div>

        @* Duration pricing cards *@
        <div class="border-b p-6">
            <LabelCn Class="mb-3 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                Duration
            </LabelCn>
            <RadioGroupCn Class="space-y-3" Value="60">
                @foreach (var d in _durations)
                {
                    <LabelCn Class="flex cursor-pointer items-center justify-between rounded-lg border p-4 transition-colors hover:border-foreground has-[[data-state=checked]]:border-primary"
                             For="@($"duration-{d.Value}")">
                        <div class="flex items-center gap-3">
                            <RadioGroupItemCn Id="@($"duration-{d.Value}")" Value="@d.Value" />
                            <span>@d.Label</span>
                            @if (d.Badge is not null)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                    @d.Badge
                                </BadgeCn>
                            }
                        </div>
                        <span class="font-medium">@d.Price</span>
                    </LabelCn>
                }
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="consultation-name">Name</LabelCn>
                    <InputCn id="consultation-name" Placeholder="John Doe" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="consultation-email">Email</LabelCn>
                    <InputCn id="consultation-email" Placeholder="@("john@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="consultation-challenge">What challenge are you facing?</LabelCn>
                <TextareaCn id="consultation-challenge"
                            Placeholder="Briefly describe your situation and what you hope to achieve..."
                            rows="3" />
            </div>

            <ButtonCn Class="w-full">Request Consultation</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                We'll confirm your booking within 2 hours.
            </p>
        </form>
    </div>
</section>

@code {
    private record ServiceOption(string Value, string Label, string Desc);
    private record DurationOption(string Value, string Label, string Price, string? Badge);

    private static readonly ServiceOption[] _services =
    [
        new("strategy", "Strategy Session", "High-level planning and direction"),
        new("review", "Portfolio Review", "In-depth analysis of current work"),
        new("coaching", "1-on-1 Coaching", "Personalized guidance and feedback"),
    ];

    private static readonly DurationOption[] _durations =
    [
        new("30", "30 minutes", "Free", "Intro Call"),
        new("60", "60 minutes", "$150", null),
        new("90", "90 minutes", "$200", "Most Popular"),
    ];
}
