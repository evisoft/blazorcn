@* ========================================
   Block: contact-insurance
   Title: Contact Insurance
   Description: Insurance quote request form with coverage type, policy details, risk assessment, and personalized rate factors for insurance providers
   Long Description: Insurance quote component captures policyholder information with coverage type selection, asset details, and discount eligibility.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, SliderCn
   Source: original/blocks/contact/contact-insurance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Get Your Insurance Quote</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Compare rates and find coverage that fits your budget.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <LabelCn>Coverage Amount</LabelCn>
                    <span class="text-lg font-semibold tabular-nums">
                        $@(((int)_coverageAmount / 1000))K
                    </span>
                </div>
                <SliderCn Class="py-2" Max="1000000" Min="50000" Value="@_coverageAmount"
                          ValueChanged="@((double v) => _coverageAmount = v)" Step="25000" aria-label="Coverage amount" />
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>$50K</span>
                    <span>$1M</span>
                </div>
            </div>

            <div class="mt-6 rounded-lg border bg-muted/50 p-4">
                <div class="mb-2 flex items-center gap-2">
                    <LucideCalculatorCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm font-medium">Estimated Monthly Premium</span>
                </div>
                <p class="text-2xl font-semibold tabular-nums">$@EstimatedPremium</p>
                <p class="mt-1 text-xs text-muted-foreground">Based on your coverage selection</p>
            </div>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="coverage-type">Coverage Type</LabelCn>
                <SelectCn Value="auto">
                    <SelectTriggerCn id="coverage-type">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="auto">Auto Insurance</SelectItemCn>
                        <SelectItemCn Value="home">Home Insurance</SelectItemCn>
                        <SelectItemCn Value="life">Life Insurance</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="insurance-first-name">First Name</LabelCn>
                    <InputCn id="insurance-first-name" Placeholder="Michael" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="insurance-last-name">Last Name</LabelCn>
                    <InputCn id="insurance-last-name" Placeholder="Thompson" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="insurance-email">Email</LabelCn>
                <InputCn id="insurance-email" Placeholder="@("michael@example.com")" Type="email" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="insurance-phone">Phone</LabelCn>
                    <InputCn id="insurance-phone" Placeholder="+1 (555) 000-0000" Type="tel" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="zip">ZIP Code</LabelCn>
                    <InputCn id="zip" Placeholder="90210" />
                </div>
            </div>

            <ButtonCn Class="w-full">Get My Free Quote</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                No obligation. Your information is secure.
            </p>
        </form>
    </div>
</section>

@code {
    private double _coverageAmount = 250000;

    private int EstimatedPremium => (int)Math.Round(_coverageAmount / 1000 * 0.8);
}
