@* ============================================================
   Block: contact-upload
   Title: ContactUpload
   Description: Contact form with file upload support for attachments, allowing users to send documents, images, or files with their inquiries
   Source: original/blocks/contact/contact-upload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Submit a Request</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Attach any relevant files to help us understand your inquiry.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn for="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="Your name" />
                </div>
                <div class="space-y-2">
                    <LabelCn for="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("your@email.com")" type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn for="message">Message</LabelCn>
                <TextareaCn id="message" Placeholder="Describe your issue or question..." Rows="4" />
            </div>

            <div class="space-y-2">
                <LabelCn>Attachment (Optional)</LabelCn>
                @if (_selectedFileName is not null)
                {
                    <div class="flex items-center justify-between rounded-lg border p-3">
                        <div class="flex items-center gap-3">
                            <LucideIconCn Name="file" Size="20" Class="h-5 w-5 text-muted-foreground" />
                            <div>
                                <p class="text-sm font-medium">@_selectedFileName</p>
                                <p class="text-xs text-muted-foreground">@FormatFileSize(_selectedFileSize)</p>
                            </div>
                        </div>
                        <ButtonCn @onclick="@(() => RemoveFile())" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" type="button">
                            <LucideIconCn Name="x" Size="16" Class="h-4 w-4" />
                        </ButtonCn>
                    </div>
                }
                else
                {
                    <label
                        class="flex cursor-pointer flex-col items-center justify-center rounded-lg border border-dashed p-6 transition-colors hover:bg-muted/50"
                        for="file-upload">
                        <LucideIconCn Name="upload" Size="24" Class="mb-2 h-6 w-6 text-muted-foreground" />
                        <p class="text-sm">Click to upload</p>
                        <p class="text-xs text-muted-foreground">PDF, DOC, PNG, JPG up to 10MB</p>
                        <input
                            accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"
                            class="hidden"
                            id="file-upload"
                            type="file"
                            @onchange="HandleFileChange" />
                    </label>
                }
            </div>

            <ButtonCn Class="w-full">Submit Request</ButtonCn>
        </form>
    </div>
</section>

@code {
    private string? _selectedFileName;
    private long _selectedFileSize;

    private async Task HandleFileChange(ChangeEventArgs e)
    {
        if (e.Value is not null)
        {
            // In Blazor, file input change events don't expose file metadata directly via ChangeEventArgs.
            // We set a placeholder name to indicate a file was selected.
            _selectedFileName = "attachment";
            _selectedFileSize = 0;
        }
        await Task.CompletedTask;
    }

    private void RemoveFile()
    {
        _selectedFileName = null;
        _selectedFileSize = 0;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 Bytes";
        var k = 1024L;
        var sizes = new[] { "Bytes", "KB", "MB" };
        var i = (int)(Math.Log(bytes) / Math.Log(k));
        if (i >= sizes.Length) i = sizes.Length - 1;
        var value = Math.Round((bytes / Math.Pow(k, i)) * 100.0) / 100.0;
        return $"{value} {sizes[i]}";
    }
}
