@* ============================================================
   Block: contact-support
   Title: ContactSupport
   Description: Contact support section with multiple contact methods including live chat, email, phone, and help center links
   Source: original/blocks/contact/contact-support.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">How can we help?</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Send us a message or use one of our support channels.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="subject">Subject</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="subject">
                        <SelectValueCn Placeholder="What do you need help with?" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="account">Account &amp; Billing</SelectItemCn>
                        <SelectItemCn Value="technical">Technical Issue</SelectItemCn>
                        <SelectItemCn Value="feature">Feature Request</SelectItemCn>
                        <SelectItemCn Value="other">Other</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="Your name" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("you@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="message">Message</LabelCn>
                <TextareaCn id="message" Placeholder="Describe your issue..." Rows="4" />
            </div>

            <ButtonCn Class="w-full">Send Message</ButtonCn>

            <div class="mt-6 border-t pt-6">
                <p class="mb-4 text-sm font-medium">Other ways to get help</p>
                <div class="space-y-3">
                    @foreach (var item in _supportChannels)
                    {
                        <button type="button"
                                class="flex w-full items-center gap-4 rounded-lg border p-3 text-left transition-colors hover:bg-muted/50">
                            @if (item.Icon == "message-circle")
                            {
                                <LucideMessageCircleCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                            }
                            else if (item.Icon == "phone")
                            {
                                <LucidePhoneCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                            }
                            else if (item.Icon == "book-open")
                            {
                                <LucideBookOpenCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                            }
                            <div class="flex-1">
                                <p class="text-sm font-medium">@item.Title</p>
                                <p class="text-xs text-muted-foreground">@item.Subtitle</p>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </form>
    </div>
</section>

@code {
    private record SupportChannel(string Icon, string Title, string Subtitle);

    private static readonly SupportChannel[] _supportChannels =
    [
        new("message-circle", "Live Chat", "Chat with our team in real-time"),
        new("phone", "Phone Support", "+1 (555) 123-4567"),
        new("book-open", "Help Center", "Browse articles and guides"),
    ];
}
