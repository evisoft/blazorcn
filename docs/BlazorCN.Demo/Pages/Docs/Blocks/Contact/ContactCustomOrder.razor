@* ========================================
   Block: contact-custom-order
   Title: Contact Custom Order
   Description: Custom product order form with material selection, quantity input, and timeline urgency indicator for manufacturers and artisans
   Long Description: Custom order form with quantity input and urgency timeline indicator. Captures product specifications, materials, and delivery expectations for bespoke manufacturing requests.
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-custom-order.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Place a Custom Order</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Tell us what you need and we'll provide a detailed quote.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <InputCn id="name" Placeholder="Taylor Kim" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("taylor@example.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="product">Product Type</LabelCn>
                <SelectCn>
                    <SelectTriggerCn id="product">
                        <SelectValueCn Placeholder="Select product type" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="furniture">Custom Furniture</SelectItemCn>
                        <SelectItemCn Value="signage">Signage / Displays</SelectItemCn>
                        <SelectItemCn Value="apparel">Custom Apparel</SelectItemCn>
                        <SelectItemCn Value="packaging">Custom Packaging</SelectItemCn>
                        <SelectItemCn Value="parts">Machined Parts</SelectItemCn>
                        <SelectItemCn Value="other">Other</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="material">Preferred Material</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="material">
                            <SelectValueCn Placeholder="Select material" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="wood">Wood</SelectItemCn>
                            <SelectItemCn Value="metal">Metal</SelectItemCn>
                            <SelectItemCn Value="acrylic">Acrylic / Plastic</SelectItemCn>
                            <SelectItemCn Value="fabric">Fabric / Textile</SelectItemCn>
                            <SelectItemCn Value="mixed">Mixed Materials</SelectItemCn>
                            <SelectItemCn Value="unsure">Not sure</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="quantity">Quantity</LabelCn>
                    <InputCn id="quantity" Placeholder="1" Type="number" />
                </div>
            </div>

            @* Urgency timeline indicator *@
            <div class="space-y-2">
                <LabelCn For="urgency">Timeline</LabelCn>
                <SelectCn Value="@_urgency" ValueChanged="@((string v) => _urgency = v)">
                    <SelectTriggerCn id="urgency">
                        <SelectValueCn Placeholder="Select timeline" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="standard">Standard (4–6 weeks)</SelectItemCn>
                        <SelectItemCn Value="rush">Rush (1–2 weeks)</SelectItemCn>
                        <SelectItemCn Value="express">Express (under 1 week)</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                @if (!string.IsNullOrEmpty(_urgency))
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _urgency == "express" ? "bg-red-500" : _urgency == "rush" ? "bg-amber-500" : "bg-emerald-500")"></span>
                        <span class="text-xs text-muted-foreground">
                            @(_urgency == "express" ? "Express orders incur a 100% rush fee"
                              : _urgency == "rush" ? "Rush orders incur a 50% rush fee"
                              : "Standard timeline — no additional fees")
                        </span>
                    </div>
                }
            </div>

            <div class="space-y-2">
                <LabelCn For="specs">Specifications</LabelCn>
                <TextareaCn id="specs"
                            Placeholder="Dimensions, colors, finish, branding requirements..."
                            rows="3" />
            </div>

            <ButtonCn Class="w-full">Request Quote</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Quotes provided within 1–2 business days. 50% deposit required to begin.
            </p>
        </form>
    </div>
</section>

@code {
    private string _urgency = "";
}
