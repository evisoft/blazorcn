@* ========================================
   Block: contact-emergency
   Title: Contact Emergency
   Description: Urgent contact form with priority levels and immediate response options for critical support requests
   Long Description: Handle urgent requests with priority selector. Unique: priority level indicator with colored dots and response times.
   Dependencies: ButtonCn, InputCn, LabelCn, RadioGroupCn, TextareaCn
   Source: original/blocks/contact/contact-emergency.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Urgent Support</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Need immediate help? Select your priority level below.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">Priority Level</LabelCn>
            <RadioGroupCn Class="space-y-2" Value="@_priority" ValueChanged="@((string? v) => _priority = v ?? "normal")">
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors", _priority == "critical" ? "border-primary" : "hover:border-foreground")"
                         For="critical">
                    <RadioGroupItemCn Class="mt-0.5" Id="critical" Value="critical" />
                    <div class="flex-1">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="size-2 rounded-full bg-red-500"></span>
                                <span class="text-sm font-medium">Critical</span>
                            </div>
                            <span class="text-xs text-muted-foreground">15 min response</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            System down, business stopped
                        </p>
                    </div>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors", _priority == "high" ? "border-primary" : "hover:border-foreground")"
                         For="high">
                    <RadioGroupItemCn Class="mt-0.5" Id="high" Value="high" />
                    <div class="flex-1">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="size-2 rounded-full bg-amber-500"></span>
                                <span class="text-sm font-medium">High</span>
                            </div>
                            <span class="text-xs text-muted-foreground">2 hour response</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Major impact, needs attention
                        </p>
                    </div>
                </LabelCn>
                <LabelCn Class="@Cn.Merge("flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors", _priority == "normal" ? "border-primary" : "hover:border-foreground")"
                         For="normal">
                    <RadioGroupItemCn Class="mt-0.5" Id="normal" Value="normal" />
                    <div class="flex-1">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="size-2 rounded-full bg-emerald-500"></span>
                                <span class="text-sm font-medium">Normal</span>
                            </div>
                            <span class="text-xs text-muted-foreground">24 hour response</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">Standard request</p>
                    </div>
                </LabelCn>
            </RadioGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="Your name" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("you@company.com")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="subject">Subject</LabelCn>
                <InputCn id="subject" Placeholder="Brief summary of the issue" />
            </div>

            <div class="space-y-2">
                <LabelCn For="description">Description</LabelCn>
                <TextareaCn id="description"
                            Placeholder="Describe the issue and what you've tried..."
                            rows="4" />
            </div>

            <div class="flex items-center justify-between rounded-lg border p-3">
                <span class="flex items-center gap-2">
                    <span class="@Cn.Merge("size-2 rounded-full", DotColor)"></span>
                    <span class="text-sm text-muted-foreground">Expected response:</span>
                </span>
                <span class="text-sm font-medium">@ResponseTime</span>
            </div>

            <ButtonCn Class="w-full">Submit Request</ButtonCn>

            <div class="flex items-center gap-2 rounded-lg border p-3 text-xs text-muted-foreground">
                <LucidePhoneCn Class="h-4 w-4 shrink-0" Size="16" />
                <span>
                    For critical issues, call <span class="font-medium">+1 (555) 911-0000</span>
                </span>
            </div>
        </form>
    </div>
</section>

@code {
    private string _priority = "normal";

    private string ResponseTime => _priority switch
    {
        "critical" => "15 min",
        "high" => "2 hours",
        _ => "24 hours",
    };

    private string DotColor => _priority switch
    {
        "critical" => "bg-red-500",
        "high" => "bg-amber-500",
        _ => "bg-emerald-500",
    };
}
