@* ========================================
   Block: contact-feedback
   Title: Contact Feedback
   Description: Feedback form with rating selection and category tags for collecting user opinions and product suggestions
   Long Description: Collect structured feedback. Unique: emoji rating selector with category tags.
   Dependencies: ButtonCn, InputCn, LabelCn, TextareaCn, ToggleGroupCn
   Source: original/blocks/contact/contact-feedback.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Share Your Feedback</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Help us improve by sharing your experience.
            </p>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">
                How would you rate your experience?
            </LabelCn>
            <ToggleGroupCn Class="justify-between" Type="ToggleGroupType.Single"
                           Value="@_rating" ValueChanged="@((string v) => _rating = v)">
                @foreach (var r in _ratings)
                {
                    <ToggleGroupItemCn Class="flex h-14 w-14 flex-col gap-0.5 data-[state=on]:border-primary"
                                       Value="@r.Value">
                        <span class="text-xl">@r.Emoji</span>
                        <span class="text-[10px] text-muted-foreground">@r.Label</span>
                    </ToggleGroupItemCn>
                }
            </ToggleGroupCn>
        </div>

        <div class="border-b px-6 py-4">
            <LabelCn Class="mb-3 block text-xs text-muted-foreground">
                What is your feedback about?
            </LabelCn>
            <ToggleGroupCn Class="flex-wrap justify-start gap-2" Type="ToggleGroupType.Multiple">
                @foreach (var cat in _categories)
                {
                    <ToggleGroupItemCn Class="rounded-full border px-4 py-1 text-xs data-[state=on]:border-primary data-[state=on]:bg-primary data-[state=on]:text-primary-foreground"
                                       Value="@cat.Value">
                        @cat.Label
                    </ToggleGroupItemCn>
                }
            </ToggleGroupCn>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-2">
                <LabelCn For="feedback-feedback">Tell us more</LabelCn>
                <TextareaCn id="feedback-feedback"
                            Placeholder="What did you like? What could be better?"
                            rows="4" />
            </div>

            <div class="space-y-2">
                <LabelCn For="feedback-email">
                    Email <span class="font-normal text-muted-foreground">(Optional)</span>
                </LabelCn>
                <InputCn id="feedback-email" Placeholder="@("you@example.com")" Type="email" />
            </div>

            <ButtonCn Class="w-full">
                <LucideMessageSquareCn Class="mr-2 h-4 w-4" Size="16" />
                Submit Feedback
            </ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Your feedback helps us build a better product.
            </p>
        </form>
    </div>
</section>

@code {
    private record RatingOption(string Value, string Emoji, string Label);
    private record CategoryOption(string Value, string Label);

    private string _rating = "";

    private static readonly RatingOption[] _ratings =
    [
        new("1", "\ud83d\ude20", "Bad"),
        new("2", "\ud83d\ude15", "Poor"),
        new("3", "\ud83d\ude10", "Okay"),
        new("4", "\ud83d\ude42", "Good"),
        new("5", "\ud83d\ude0d", "Great"),
    ];

    private static readonly CategoryOption[] _categories =
    [
        new("bug", "Bug Report"),
        new("feature", "Feature Request"),
        new("usability", "Usability"),
        new("design", "Design"),
    ];
}
