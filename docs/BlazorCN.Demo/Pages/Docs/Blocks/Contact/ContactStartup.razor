@* ========================================
   Block: contact-startup
   Title: Contact Startup
   Description: Startup pitch form with funding stage selection, traction metrics, team size, and investor outreach details for founders
   Long Description: Sales inquiry form with company details
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, RadioGroupCn, SelectCn, TextareaCn
   Source: original/blocks/contact/contact-startup.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-sm font-medium">Submit Your Pitch</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Share your startup details and we'll connect you with the right investors.
            </p>
        </div>

        <form class="space-y-4 p-6">
            <div class="space-y-3">
                <LabelCn>Funding Stage</LabelCn>
                <RadioGroupCn Class="grid grid-cols-2 gap-3"
                              Value="@_stage" ValueChanged="@((string? v) => _stage = v ?? "seed")">
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _stage == "pre-seed" ? "border-primary" : "hover:border-foreground")"
                             For="stage-pre-seed">
                        <RadioGroupItemCn Id="stage-pre-seed" Value="pre-seed" />
                        <div>
                            <span class="text-sm font-medium">Pre-Seed</span>
                            <p class="text-xs text-muted-foreground">Under $500K</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _stage == "seed" ? "border-primary" : "hover:border-foreground")"
                             For="stage-seed">
                        <RadioGroupItemCn Id="stage-seed" Value="seed" />
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">Seed</span>
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                    Common
                                </BadgeCn>
                            </div>
                            <p class="text-xs text-muted-foreground">$500K\u2013$3M</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _stage == "series-a" ? "border-primary" : "hover:border-foreground")"
                             For="stage-series-a">
                        <RadioGroupItemCn Id="stage-series-a" Value="series-a" />
                        <div>
                            <span class="text-sm font-medium">Series A</span>
                            <p class="text-xs text-muted-foreground">$5M\u2013$15M</p>
                        </div>
                    </LabelCn>
                    <LabelCn Class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-lg border p-4 transition-colors", _stage == "growth" ? "border-primary" : "hover:border-foreground")"
                             For="stage-growth">
                        <RadioGroupItemCn Id="stage-growth" Value="growth" />
                        <div>
                            <span class="text-sm font-medium">Growth</span>
                            <p class="text-xs text-muted-foreground">$15M+</p>
                        </div>
                    </LabelCn>
                </RadioGroupCn>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="founder">Founder Name</LabelCn>
                    <InputCn id="founder" Placeholder="Alex Rivera" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="email">Email</LabelCn>
                    <InputCn id="email" Placeholder="@("alex@startup.io")" Type="email" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="company">Company Name</LabelCn>
                <InputCn id="company" Placeholder="NovaTech Labs" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="industry">Industry</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="industry">
                            <SelectValueCn Placeholder="Select industry" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="saas">SaaS / B2B Software</SelectItemCn>
                            <SelectItemCn Value="fintech">Fintech</SelectItemCn>
                            <SelectItemCn Value="healthtech">Healthtech</SelectItemCn>
                            <SelectItemCn Value="ai">AI / Machine Learning</SelectItemCn>
                            <SelectItemCn Value="ecommerce">E-Commerce / DTC</SelectItemCn>
                            <SelectItemCn Value="other">Other</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-2">
                    <LabelCn For="team-size">Team Size</LabelCn>
                    <SelectCn>
                        <SelectTriggerCn id="team-size">
                            <SelectValueCn Placeholder="Select size" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="solo">Solo founder</SelectItemCn>
                            <SelectItemCn Value="2-5">2\u20135 people</SelectItemCn>
                            <SelectItemCn Value="6-15">6\u201315 people</SelectItemCn>
                            <SelectItemCn Value="16-50">16\u201350 people</SelectItemCn>
                            <SelectItemCn Value="50+">50+</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="pitch">One-Line Pitch</LabelCn>
                <TextareaCn id="pitch"
                            Placeholder="We help [target customer] do [outcome] by [unique approach]..."
                            rows="2" />
            </div>

            <ButtonCn Class="w-full">Submit Pitch</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Our team reviews every submission within 5 business days.
            </p>
        </form>
    </div>
</section>

@code {
    private string _stage = "seed";
}
