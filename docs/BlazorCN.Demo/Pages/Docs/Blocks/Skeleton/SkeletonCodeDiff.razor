@* ============================================================
   Block: skeleton-code-diff
   Title: SkeletonCodeDiff
   Description: A React and Next.js skeleton loading placeholder for unified code diff views, built with shadcn/ui Skeleton and Tailwind CSS with line numbers and change indicators.
   Source: original/blocks/skeleton/skeleton-code-diff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-2/3" />
                <SkeletonCn Class="h-3 w-16" />
            </div>
        </div>

        <div class="flex bg-muted/20">
            <div class="flex shrink-0 flex-col items-end border-r bg-muted/30 px-3 py-2">
                @foreach (var line in _diffLines)
                {
                    <div class="@($"h-5 w-6 py-0.5 {GetLineBg(line.Type)}")">
                        <SkeletonCn Class="h-3 w-full" />
                    </div>
                }
            </div>

            <div class="flex-1">
                @foreach (var line in _diffLines)
                {
                    var indicator = GetLineIndicator(line.Type);
                    <div class="@($"flex items-center gap-2 px-3 py-0.5 {GetLineBg(line.Type)}")">
                        <span class="@($"w-3 shrink-0 text-center text-xs {indicator.Color}")">@indicator.Symbol</span>
                        <SkeletonCn Class="@($"h-4 {line.Width}")" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record DiffLine(string Id, string Type, string Width);
    private record LineIndicator(string Symbol, string Color);

    private static readonly DiffLine[] _diffLines =
    [
        new("ctx1", "context", "w-1/2"),
        new("ctx2", "context", "w-2/3"),
        new("ctx3", "context", "w-3/5"),
        new("rem1", "removed", "w-1/2"),
        new("rem2", "removed", "w-2/5"),
        new("add1", "added",   "w-3/5"),
        new("add2", "added",   "w-1/2"),
        new("add3", "added",   "w-2/3"),
        new("ctx4", "context", "w-1/3"),
        new("ctx5", "context", "w-2/5"),
        new("rem3", "removed", "w-1/2"),
        new("add4", "added",   "w-3/5"),
        new("ctx6", "context", "w-2/3"),
        new("ctx7", "context", "w-1/2"),
        new("ctx8", "context", "w-3/5"),
    ];

    private static string GetLineBg(string type) => type switch
    {
        "removed" => "bg-red-500/5",
        "added"   => "bg-green-500/5",
        _         => "",
    };

    private static LineIndicator GetLineIndicator(string type) => type switch
    {
        "removed" => new("-", "text-red-600"),
        "added"   => new("+", "text-green-600"),
        _         => new("",  "text-muted-foreground"),
    };
}
