@* ============================================================
   Block: skeleton-pricing-card
   Title: SkeletonPricingCard
   Description: A React and Next.js pricing card skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for subscription plan displays
   Source: original/blocks/skeleton/skeleton-pricing-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Plan header *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-28" />
        </div>

        @* Price display *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline gap-2">
                <SkeletonCn Class="h-8 w-20" />
                <SkeletonCn Class="h-3 w-16" />
            </div>
            <SkeletonCn Class="mt-2 h-3 w-24" />
        </div>

        @* Features list *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                @foreach (var feat in _features)
                {
                    <div class="flex items-center gap-3">
                        <SkeletonCn Class="size-4 shrink-0 rounded-full" />
                        <SkeletonCn Class="@($"h-3 {feat}")" />
                    </div>
                }
            </div>
        </div>

        @* CTA button + disclaimer *@
        <div class="px-4 py-2.5">
            <SkeletonCn Class="h-9 w-full rounded-md" />
            <SkeletonCn Class="mx-auto mt-2.5 h-3 w-44" />
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features = ["w-4/5", "w-3/5", "w-2/3", "w-3/4", "w-1/2", "w-3/5"];
}
