@* ============================================================
   Block: skeleton-table-striped
   Title: SkeletonTableStriped
   Description: A React striped table skeleton with alternating row backgrounds built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-table-striped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <SkeletonCn Class="h-3 w-20" />
            <SkeletonCn Class="h-3 w-32" />
            <SkeletonCn Class="h-3 w-28" />
            <SkeletonCn Class="h-3 w-24" />
            <SkeletonCn Class="h-3 w-20" />
        </div>

        @* Data rows with striping *@
        @foreach (var row in _rows)
        {
            var rowIdx = Array.IndexOf(_rows, row);
            <div class="@Cn.Merge("px-4 py-3", rowIdx < _rows.Length - 1 ? "border-b" : "", rowIdx % 2 == 1 ? "bg-muted/30" : "")">
                <div class="flex items-center gap-4">
                    <SkeletonCn Class="@($"h-3 {row.Col1}")" />
                    <SkeletonCn Class="@($"h-3 {row.Col2}")" />
                    <SkeletonCn Class="@($"h-3 {row.Col3}")" />
                    <SkeletonCn Class="@($"h-3 {row.Col4}")" />
                    <SkeletonCn Class="@($"h-3 {row.Col5}")" />
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record RowData(string Col1, string Col2, string Col3, string Col4, string Col5);

    private static readonly RowData[] _rows =
    [
        new("w-16", "w-40", "w-24", "w-28", "w-18"),
        new("w-18", "w-36", "w-28", "w-24", "w-20"),
        new("w-20", "w-44", "w-20", "w-32", "w-16"),
        new("w-16", "w-38", "w-24", "w-28", "w-20"),
        new("w-18", "w-40", "w-28", "w-24", "w-18"),
        new("w-20", "w-36", "w-24", "w-32", "w-20"),
    ];
}
