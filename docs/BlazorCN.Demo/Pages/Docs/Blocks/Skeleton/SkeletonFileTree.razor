@* ============================================================
   Block: skeleton-file-tree
   Title: SkeletonFileTree
   Description: A React file tree skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for loading states in code editor sidebars.
   Source: original/blocks/skeleton/skeleton-file-tree.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-24" />
            <SkeletonCn Class="size-7 rounded-md" />
        </div>

        @* File tree *@
        <div>
            @* Root folder 1 - collapsed *@
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="size-3 shrink-0" />
                    <SkeletonCn Class="size-4 shrink-0" />
                    <SkeletonCn Class="h-4 w-20" />
                </div>
            </div>

            @* Root folder 2 - expanded with nested files *@
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="size-3 shrink-0" />
                    <SkeletonCn Class="size-4 shrink-0" />
                    <SkeletonCn Class="h-4 w-28" />
                </div>
                <div class="ml-5 mt-1 space-y-1 border-l pl-4">
                    @foreach (var file in _nestedFiles)
                    {
                        <div class="flex items-center gap-2 py-1">
                            <SkeletonCn Class="size-4 shrink-0" />
                            <SkeletonCn Class="@($"h-3 {file.Width}")" />
                        </div>
                    }
                </div>
            </div>

            @* Root folder 3 - collapsed *@
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="size-3 shrink-0" />
                    <SkeletonCn Class="size-4 shrink-0" />
                    <SkeletonCn Class="h-4 w-16" />
                </div>
            </div>

            @* Root files *@
            <div class="space-y-1 px-4 py-2.5">
                @foreach (var file in _rootFiles)
                {
                    <div class="flex items-center gap-2 py-1">
                        <div class="w-3"></div>
                        <SkeletonCn Class="size-4 shrink-0" />
                        <SkeletonCn Class="@($"h-3 {file.Width}")" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FileItem(string Width);

    private static readonly FileItem[] _nestedFiles =
    [
        new("w-28"),
        new("w-36"),
        new("w-24"),
    ];

    private static readonly FileItem[] _rootFiles =
    [
        new("w-36"),
        new("w-28"),
        new("w-20"),
    ];
}
