@* ============================================================
   Block: skeleton-profile-card
   Title: SkeletonProfileCard
   Description: A React and Next.js skeleton loader for horizontal profile cards built with shadcn/ui Skeleton and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-profile-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Avatar and Name *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <SkeletonCn Class="size-12 shrink-0 rounded-full" />
                <div class="min-w-0 flex-1 space-y-2">
                    <SkeletonCn Class="h-4 w-32" />
                    <SkeletonCn Class="h-3 w-44" />
                    <SkeletonCn Class="h-5 w-20 rounded-full" />
                </div>
            </div>
        </div>

        @* Contact Details *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2.5">
                @foreach (var row in _contactRows)
                {
                    <div class="flex items-center gap-3">
                        <SkeletonCn Class="@($"h-3 {row.LabelWidth}")" />
                        <SkeletonCn Class="@($"h-3 {row.ValueWidth}")" />
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-3">
                <SkeletonCn Class="h-7 flex-1 rounded-md" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record ContactRow(string LabelWidth, string ValueWidth);

    private static readonly ContactRow[] _contactRows =
    [
        new("w-12", "w-40"),
        new("w-10", "w-48"),
        new("w-14", "w-32"),
    ];
}
