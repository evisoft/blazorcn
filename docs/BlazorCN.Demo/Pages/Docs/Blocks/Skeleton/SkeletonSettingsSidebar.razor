@* ============================================================
   Block: skeleton-settings-sidebar
   Title: SkeletonSettingsSidebar
   Description: A React skeleton loader for settings pages with sidebar navigation built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-settings-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex">
            @* Sidebar Navigation *@
            <div class="w-56 shrink-0 border-r">
                <div class="space-y-1 px-3 py-3">
                    @foreach (var width in _sidebarWidths)
                    {
                        <SkeletonCn Class="@($"h-8 {width}")" />
                    }
                </div>
            </div>

            @* Content Area *@
            <div class="flex-1">
                <div class="border-b px-4 py-3">
                    <SkeletonCn Class="h-4 w-40" />
                </div>

                <div class="border-b px-4 py-3">
                    <div class="space-y-6">
                        @foreach (var width in _fieldLabelWidths)
                        {
                            <div class="space-y-2">
                                <SkeletonCn Class="@($"h-4 {width}")" />
                                <SkeletonCn Class="h-10 w-full" />
                            </div>
                        }
                    </div>
                </div>

                @* Save Button *@
                <div class="px-4 py-2.5">
                    <SkeletonCn Class="h-7 w-20 rounded-md" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _sidebarWidths = ["w-full", "w-4/5", "w-full", "w-3/4", "w-full", "w-5/6", "w-4/5", "w-3/4"];
    private static readonly string[] _fieldLabelWidths = ["w-28", "w-36", "w-24"];
}
