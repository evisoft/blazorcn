<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Thumbnail with Play Button *@
        <div class="relative border-b">
            <SkeletonCn Class="aspect-video w-full" />
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
                <SkeletonCn Class="size-12 rounded-full" />
            </div>
            @* Duration Badge *@
            <div class="absolute bottom-2 right-2">
                <SkeletonCn Class="h-5 w-10 rounded" />
            </div>
        </div>

        @* Video Info *@
        <div class="flex gap-3 px-4 py-3">
            <SkeletonCn Class="size-9 shrink-0 rounded-full" />
            <div class="min-w-0 flex-1 space-y-2">
                <SkeletonCn Class="h-4 w-full" />
                <SkeletonCn Class="h-4 w-4/5" />
                <SkeletonCn Class="h-3 w-28" />
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-3 w-16" />
                    <SkeletonCn Class="size-1 rounded-full" />
                    <SkeletonCn Class="h-3 w-20" />
                </div>
            </div>
        </div>
    </div>
</section>
