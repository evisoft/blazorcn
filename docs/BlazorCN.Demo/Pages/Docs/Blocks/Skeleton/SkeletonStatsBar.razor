@* ============================================================
   Block: skeleton-stats-bar
   Title: SkeletonStatsBar
   Description: A React horizontal metrics bar skeleton with inline statistics and dividers built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-stats-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex divide-x px-4 py-3">
            @foreach (var stat in _stats)
            {
                <div class="flex flex-1 flex-col gap-2 px-4">
                    <SkeletonCn Class="@($"h-3 {stat.LabelWidth}")" />
                    <SkeletonCn Class="@($"h-6 {stat.ValueWidth}")" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatItem(string LabelWidth, string ValueWidth);

    private static readonly StatItem[] _stats =
    [
        new("w-16", "w-12"),
        new("w-20", "w-10"),
        new("w-14", "w-14"),
        new("w-18", "w-12"),
    ];
}
