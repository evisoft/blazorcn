@* ============================================================
   Block: skeleton-navbar
   Title: SkeletonNavbar
   Description: A React navigation bar skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for website headers
   Source: original/blocks/skeleton/skeleton-navbar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between px-4 py-3">
            @* Logo *@
            <SkeletonCn Class="h-4 w-28" />

            @* Center Navigation Links *@
            <div class="flex items-center gap-6">
                @foreach (var link in _navLinks)
                {
                    <SkeletonCn Class="@($"h-3 {link.Width}")" />
                }
            </div>

            @* Action Buttons *@
            <div class="flex items-center gap-2">
                <SkeletonCn Class="h-7 w-16 rounded-md" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record NavLink(string Id, string Width);

    private static readonly NavLink[] _navLinks =
    [
        new("products", "w-16"),
        new("solutions", "w-14"),
        new("pricing", "w-12"),
        new("docs", "w-10"),
        new("blog", "w-9"),
    ];
}
