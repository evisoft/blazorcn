@* ============================================================
   Block: skeleton-product-list
   Title: SkeletonProductList
   Description: A React and Next.js skeleton loader for horizontal product lists built with shadcn/ui Skeleton and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-product-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-28" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>

        @* Product List Items *@
        @foreach (var item in _items)
        {
            <div class="@(item.IsLast ? "px-4 py-3" : "border-b px-4 py-3")">
                <div class="flex gap-4">
                    <SkeletonCn Class="size-20 shrink-0 rounded-md" />
                    <div class="flex min-w-0 flex-1 flex-col gap-2">
                        <SkeletonCn Class="@($"h-4 {item.TitleWidth}")" />
                        <SkeletonCn Class="@($"h-3 {item.DescWidth}")" />
                        <SkeletonCn Class="h-3 w-3/4" />
                        <div class="mt-auto flex items-center justify-between">
                            <SkeletonCn Class="h-4 w-16" />
                            <SkeletonCn Class="h-7 w-20 rounded-md" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-24" />
                <SkeletonCn Class="h-3 w-16" />
            </div>
        </div>
    </div>
</section>

@code {
    private record ProductRow(string TitleWidth, string DescWidth, bool IsLast);

    private static readonly ProductRow[] _items =
    [
        new("w-3/4", "w-full",  false),
        new("w-2/3", "w-5/6",  false),
        new("w-4/5", "w-full",  false),
        new("w-3/5", "w-4/5",  true),
    ];
}
