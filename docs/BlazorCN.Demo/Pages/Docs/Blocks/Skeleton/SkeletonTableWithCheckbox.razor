@* ============================================================
   Block: skeleton-table-with-checkbox
   Title: SkeletonTableWithCheckbox
   Description: A React table skeleton with checkbox placeholders built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for selectable data tables
   Source: original/blocks/skeleton/skeleton-table-with-checkbox.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-32" />
        </div>

        @* Table header *@
        <div class="flex items-center gap-4 border-b bg-muted/50 px-4 py-3">
            <SkeletonCn Class="size-4 shrink-0 rounded-sm" />
            <SkeletonCn Class="h-3 w-20" />
            <SkeletonCn Class="h-3 w-32 flex-1" />
            <SkeletonCn Class="h-3 w-24" />
            <SkeletonCn Class="size-4 shrink-0" />
        </div>

        @* Table rows *@
        @for (var i = 0; i < _dataRows.Length; i++)
        {
            var row = _dataRows[i];
            var isLast = i == _dataRows.Length - 1;
            <div class="@(isLast ? "flex items-center gap-4 px-4 py-3" : "flex items-center gap-4 border-b px-4 py-3")">
                <SkeletonCn Class="size-4 shrink-0 rounded-sm" />
                <SkeletonCn Class="@($"h-3 {row.Col1}")" />
                <SkeletonCn Class="h-3 flex-1" />
                <SkeletonCn Class="@($"h-3 {row.Col2}")" />
                <SkeletonCn Class="size-4 shrink-0 rounded-full" />
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-32" />
            <div class="flex items-center gap-2">
                <SkeletonCn Class="h-7 w-20 rounded-md" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record DataRow(string Col1, string Col2);

    private static readonly DataRow[] _dataRows =
    [
        new("w-20", "w-24"),
        new("w-24", "w-20"),
        new("w-16", "w-28"),
        new("w-20", "w-24"),
        new("w-24", "w-20"),
        new("w-18", "w-24"),
    ];
}
