@* ============================================================
   Block: skeleton-dashboard-chart
   Title: SkeletonDashboardChart
   Description: A React and Next.js dashboard chart skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring Y-axis labels, grid lines, chart area placeholder, and legend indicators.
   Source: original/blocks/skeleton/skeleton-dashboard-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="space-y-1">
                <SkeletonCn Class="h-4 w-32" />
                <SkeletonCn Class="h-3 w-48" />
            </div>
            <SkeletonCn Class="h-7 w-24 rounded-md" />
        </div>

        @* Chart area *@
        <div class="border-b px-4 py-3">
            <div class="relative h-64">
                @* Y-axis labels *@
                <div class="absolute top-0 left-0 flex h-full flex-col justify-between py-1">
                    @foreach (var w in _yAxisLabels)
                    {
                        <SkeletonCn Class="@($"h-3 {w}")" />
                    }
                </div>

                @* Chart grid area *@
                <div class="ml-12 h-full rounded-md border border-dashed border-border/40">
                    <div class="flex h-full flex-col justify-between px-4 py-3">
                        @foreach (var i in _gridLines)
                        {
                            <div class="h-px bg-border/30"></div>
                        }
                    </div>
                </div>

                @* X-axis labels *@
                <div class="mt-2 ml-12 flex justify-between">
                    @foreach (var w in _xAxisLabels)
                    {
                        <SkeletonCn Class="@($"h-3 {w}")" />
                    }
                </div>
            </div>
        </div>

        @* Legend *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-center gap-6">
                @foreach (var item in _legendItems)
                {
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="size-3 rounded-full" />
                        <SkeletonCn Class="@($"h-3 {item.TextWidth}")" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _yAxisLabels = ["w-8", "w-6", "w-8", "w-6", "w-8"];
    private static readonly string[] _xAxisLabels = ["w-10", "w-8", "w-10", "w-8", "w-10", "w-8"];
    private static readonly int[] _gridLines = [0, 1, 2, 3];

    private record LegendItem(string TextWidth);

    private static readonly LegendItem[] _legendItems =
    [
        new("w-16"),
        new("w-14"),
        new("w-18"),
    ];
}
