<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-32" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>
        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var item in _imageItems)
                {
                    <SkeletonCn Class="h-40 w-full rounded-md" />
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ImageItem(string Id);

    private static readonly ImageItem[] _imageItems =
    [
        new("img-1"),
        new("img-2"),
        new("img-3"),
        new("img-4"),
        new("img-5"),
        new("img-6"),
    ];
}
