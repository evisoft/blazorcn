@* ============================================================
   Block: skeleton-analytics-dashboard
   Title: SkeletonAnalyticsDashboard
   Description: A React and Next.js skeleton loader block for analytics dashboards with stat cards, chart placeholder, and data table built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/skeleton/skeleton-analytics-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with controls *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-32" />
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-7 w-36 rounded-md" />
                    <SkeletonCn Class="h-7 w-20 rounded-md" />
                </div>
            </div>
        </div>

        @* Metric cards grid *@
        <div class="border-b px-4 py-3">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var card in _metricCards)
                {
                    <div class="rounded-md border p-3">
                        <SkeletonCn Class="@($"mb-2 h-3 {card.LabelWidth}")" />
                        <SkeletonCn Class="@($"mb-1 h-6 {card.ValueWidth}")" />
                        <SkeletonCn Class="h-3 w-12" />
                    </div>
                }
            </div>
        </div>

        @* Chart area *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <SkeletonCn Class="h-4 w-28" />
                <SkeletonCn Class="h-7 w-24 rounded-md" />
            </div>
            <SkeletonCn Class="h-52 w-full rounded-md" />
        </div>

        @* Summary table *@
        <div class="px-4 py-3">
            <SkeletonCn Class="mb-3 h-4 w-32" />
            <div class="space-y-2">
                @* Table header *@
                <div class="grid grid-cols-4 gap-4 border-b pb-2">
                    <SkeletonCn Class="h-3 w-16" />
                    <SkeletonCn Class="h-3 w-14" />
                    <SkeletonCn Class="h-3 w-12" />
                    <SkeletonCn Class="h-3 w-10" />
                </div>
                @* Table rows *@
                @foreach (var row in _tableRows)
                {
                    <div class="grid grid-cols-4 gap-4 py-2">
                        @foreach (var w in row)
                        {
                            <SkeletonCn Class="@($"h-3 {w}")" />
                        }
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex justify-center border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private static readonly string[] _tableRowWidths = ["w-full", "w-3/4", "w-2/3", "w-1/2"];

    private static readonly string[] _metricLabelWidths = ["w-20", "w-24", "w-16", "w-20"];
    private static readonly string[] _metricValueWidths = ["w-16", "w-20", "w-14", "w-18"];

    private record MetricCard(string LabelWidth, string ValueWidth);

    private static readonly MetricCard[] _metricCards =
    [
        new("w-20", "w-16"),
        new("w-24", "w-20"),
        new("w-16", "w-14"),
        new("w-20", "w-18"),
    ];

    // 5 table rows, each row uses the same 4 column widths
    private static readonly string[][] _tableRows =
    [
        _tableRowWidths,
        _tableRowWidths,
        _tableRowWidths,
        _tableRowWidths,
        _tableRowWidths,
    ];
}
