@* ============================================================
   Block: skeleton-timeline
   Title: SkeletonTimeline
   Description: A React vertical timeline skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for event feeds
   Source: original/blocks/skeleton/skeleton-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-28" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative space-y-6">
                @* Vertical Line *@
                <div class="absolute top-2 bottom-2 left-[9px] w-px bg-border"></div>

                @* Timeline Entries *@
                @foreach (var item in _timelineEntries)
                {
                    <div class="relative flex gap-3 pl-7">
                        @* Timeline Dot *@
                        <div class="absolute left-0 top-0.5">
                            <SkeletonCn Class="size-5 rounded-full" />
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 space-y-2">
                            @* Timestamp *@
                            <SkeletonCn Class="@($"h-3 {item.TimeWidth}")" />

                            @* Title *@
                            <SkeletonCn Class="@($"h-4 {item.TitleWidth}")" />

                            @* Description *@
                            <div class="space-y-1.5">
                                <SkeletonCn Class="@($"h-3 {item.DescWidth}")" />
                                <SkeletonCn Class="h-3 w-2/3" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-32" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string TitleWidth, string DescWidth, string TimeWidth);

    private static readonly TimelineEntry[] _timelineEntries =
    [
        new("w-2/3", "w-full",  "w-20"),
        new("w-3/4", "w-5/6",  "w-24"),
        new("w-1/2", "w-4/5",  "w-16"),
        new("w-3/5", "w-full",  "w-20"),
        new("w-2/3", "w-3/4",  "w-24"),
    ];
}
