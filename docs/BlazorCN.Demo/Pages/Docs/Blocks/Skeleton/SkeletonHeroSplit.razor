@* ============================================================
   Block: skeleton-hero-split
   Title: SkeletonHeroSplit
   Description: A React split hero skeleton built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for two-column hero layouts
   Source: original/blocks/skeleton/skeleton-hero-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-6 px-4 py-3 md:grid-cols-2 md:items-center">
            <div class="space-y-4">
                <div class="space-y-2">
                    @foreach (var w in _headingWidths)
                    {
                        <SkeletonCn Class="@($"h-4 {w}")" />
                    }
                </div>
                <div class="space-y-2">
                    @foreach (var w in _descriptionWidths)
                    {
                        <SkeletonCn Class="@($"h-3 {w}")" />
                    }
                </div>
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="h-7 w-20 rounded-md" />
                    <SkeletonCn Class="h-7 w-20 rounded-md" />
                </div>
            </div>
            <div class="flex items-center justify-center">
                <SkeletonCn Class="h-64 w-full rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _headingWidths = ["w-full", "w-5/6", "w-3/4"];
    private static readonly string[] _descriptionWidths = ["w-full", "w-full", "w-4/5"];
}
