@* ============================================================
   Block: skeleton-invoice
   Title: SkeletonInvoice
   Description: A React and Next.js invoice skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, showing header, line items, and totals placeholders.
   Source: original/blocks/skeleton/skeleton-invoice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div class="space-y-2">
                    <SkeletonCn Class="h-7 w-28" />
                    <SkeletonCn Class="h-3 w-20" />
                </div>
                <div class="space-y-2 text-right">
                    <SkeletonCn Class="ml-auto h-4 w-32" />
                    <SkeletonCn Class="ml-auto h-3 w-24" />
                </div>
            </div>
        </div>

        @* Bill To / Ship To *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-3">
            <div class="space-y-1.5">
                <SkeletonCn Class="mb-2 h-3 w-14" />
                <SkeletonCn Class="h-4 w-36" />
                <SkeletonCn Class="h-3 w-44" />
                <SkeletonCn Class="h-3 w-32" />
            </div>
            <div class="space-y-1.5">
                <SkeletonCn Class="mb-2 h-3 w-16" />
                <SkeletonCn Class="h-4 w-28" />
                <SkeletonCn Class="h-3 w-40" />
                <SkeletonCn Class="h-3 w-36" />
            </div>
        </div>

        @* Items Table Header *@
        <div class="border-b px-4 py-2.5">
            <div class="grid grid-cols-12 gap-3">
                <SkeletonCn Class="col-span-6 h-3 w-20" />
                <SkeletonCn Class="col-span-2 h-3 w-8" />
                <SkeletonCn Class="col-span-2 h-3 w-10" />
                <SkeletonCn Class="col-span-2 h-3 w-12" />
            </div>
        </div>

        @* Table Rows *@
        @foreach (var item in _lineItems)
        {
            <div class="@Cn.Merge("grid grid-cols-12 gap-3 px-4 py-3", item.IsLast ? "" : "border-b")">
                <div class="col-span-6 space-y-1">
                    <SkeletonCn Class="@($"h-3 {item.TitleW}")" />
                    <SkeletonCn Class="@($"h-3 {item.DescW}")" />
                </div>
                <SkeletonCn Class="@($"col-span-2 h-3 {item.QtyW}")" />
                <SkeletonCn Class="@($"col-span-2 h-3 {item.PriceW}")" />
                <SkeletonCn Class="@($"col-span-2 h-3 {item.TotalW}")" />
            </div>
        }

        @* Totals *@
        <div class="border-t px-4 py-3">
            <div class="ml-auto max-w-xs space-y-2">
                <div class="flex justify-between">
                    <SkeletonCn Class="h-3 w-16" />
                    <SkeletonCn Class="h-3 w-20" />
                </div>
                <div class="flex justify-between">
                    <SkeletonCn Class="h-3 w-10" />
                    <SkeletonCn Class="h-3 w-14" />
                </div>
                <div class="flex justify-between">
                    <SkeletonCn Class="h-3 w-14" />
                    <SkeletonCn Class="h-3 w-16" />
                </div>
                <div class="flex justify-between border-t pt-2">
                    <SkeletonCn Class="h-4 w-20" />
                    <SkeletonCn Class="h-4 w-24" />
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-40" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record LineItem(string TitleW, string DescW, string QtyW, string PriceW, string TotalW, bool IsLast);

    private static readonly LineItem[] _lineItems =
    [
        new("w-full",  "w-3/4", "w-8", "w-14", "w-16", false),
        new("w-5/6",   "w-2/3", "w-6", "w-12", "w-14", false),
        new("w-full",  "w-4/5", "w-8", "w-10", "w-16", false),
        new("w-3/4",   "w-1/2", "w-6", "w-14", "w-12", true),
    ];
}
