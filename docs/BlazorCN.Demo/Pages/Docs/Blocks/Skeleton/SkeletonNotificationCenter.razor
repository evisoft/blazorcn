@* ============================================================
   Block: skeleton-notification-center
   Title: SkeletonNotificationCenter
   Description: A React notification center skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for grouped alerts
   Source: original/blocks/skeleton/skeleton-notification-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-32" />
            <SkeletonCn Class="h-7 w-24 rounded-md" />
        </div>

        @* Today group *@
        <div class="border-b">
            <div class="px-4 py-2.5">
                <SkeletonCn Class="h-3 w-12" />
            </div>
            @foreach (var item in _todayItems)
            {
                <div class="flex gap-3 border-t px-4 py-3">
                    <SkeletonCn Class="size-9 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-2">
                        <SkeletonCn Class="@($"h-4 {item.TitleWidth}")" />
                        <SkeletonCn Class="@($"h-3 {item.BodyWidth}")" />
                        <SkeletonCn Class="h-3 w-16" />
                    </div>
                </div>
            }
        </div>

        @* Yesterday group *@
        <div class="border-b">
            <div class="px-4 py-2.5">
                <SkeletonCn Class="h-3 w-20" />
            </div>
            @foreach (var item in _yesterdayItems)
            {
                <div class="flex gap-3 border-t px-4 py-3">
                    <SkeletonCn Class="size-9 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-2">
                        <SkeletonCn Class="@($"h-4 {item.TitleWidth}")" />
                        <SkeletonCn Class="@($"h-3 {item.BodyWidth}")" />
                        <SkeletonCn Class="h-3 w-14" />
                    </div>
                </div>
            }
        </div>

        @* Earlier group *@
        <div class="border-b">
            <div class="px-4 py-2.5">
                <SkeletonCn Class="h-3 w-14" />
            </div>
            @foreach (var item in _earlierItems)
            {
                <div class="flex gap-3 border-t px-4 py-3">
                    <SkeletonCn Class="size-9 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-2">
                        <SkeletonCn Class="@($"h-4 {item.TitleWidth}")" />
                        <SkeletonCn Class="@($"h-3 {item.BodyWidth}")" />
                        <SkeletonCn Class="h-3 w-12" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 text-center">
            <SkeletonCn Class="mx-auto h-3 w-28" />
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string TitleWidth, string BodyWidth);

    private static readonly NotificationItem[] _todayItems =
    [
        new("w-full", "w-4/5"),
        new("w-11/12", "w-3/4"),
        new("w-5/6", "w-4/5"),
    ];

    private static readonly NotificationItem[] _yesterdayItems =
    [
        new("w-full", "w-3/4"),
        new("w-5/6", "w-2/3"),
    ];

    private static readonly NotificationItem[] _earlierItems =
    [
        new("w-4/5", "w-3/5"),
        new("w-5/6", "w-2/3"),
    ];
}
