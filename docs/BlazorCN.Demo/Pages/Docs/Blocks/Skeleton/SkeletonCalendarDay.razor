@* ============================================================
   Block: skeleton-calendar-day
   Title: SkeletonCalendarDay
   Description: A React and Next.js daily calendar skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring hourly time slots, event placeholders, and navigation controls
   Source: original/blocks/skeleton/skeleton-calendar-day.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Date Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <SkeletonCn Class="size-8 rounded-md" />
                <div class="space-y-1">
                    <SkeletonCn Class="h-4 w-32" />
                    <SkeletonCn Class="h-3 w-20" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <SkeletonCn Class="h-7 w-20 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
            </div>
        </div>

        @* Time Slots *@
        <div class="divide-y">
            @foreach (var slot in _timeSlots)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    <SkeletonCn Class="mt-0.5 h-3 w-14 shrink-0" />
                    <div class="min-h-[40px] w-full">
                        @if (slot.HasEvent)
                        {
                            <SkeletonCn Class="h-14 w-full rounded-md" />
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex justify-center border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private record TimeSlot(bool HasEvent);

    private static readonly TimeSlot[] _timeSlots =
    [
        new(false),
        new(true),
        new(true),
        new(false),
        new(false),
        new(true),
        new(false),
        new(true),
        new(false),
        new(true),
        new(false),
    ];
}
