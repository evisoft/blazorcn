@* ============================================================
   Block: skeleton-kanban-board
   Title: SkeletonKanbanBoard
   Description: A React and Next.js kanban board skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, showing multi-column task cards.
   Source: original/blocks/skeleton/skeleton-kanban-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Board Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="h-4 w-32" />
                    <SkeletonCn Class="h-5 w-7 rounded-full" />
                </div>
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-7 w-20 rounded-md" />
                    <SkeletonCn Class="h-7 w-7 rounded-md" />
                </div>
            </div>
        </div>

        @* Kanban Columns *@
        <div class="grid gap-4 p-4 md:grid-cols-3">
            @foreach (var col in _columns)
            {
                <div class="space-y-3">
                    @* Column Header *@
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="@($"h-4 {col.LabelW}")" />
                        <SkeletonCn Class="h-5 w-6 rounded-full" />
                    </div>

                    @* Task Cards *@
                    <div class="space-y-2">
                        @foreach (var card in col.Cards)
                        {
                            <div class="space-y-2 rounded-md border p-3">
                                <SkeletonCn Class="@($"h-3 {card.TitleW}")" />
                                <SkeletonCn Class="@($"h-3 {card.SubW}")" />
                                <div class="flex items-center gap-2 pt-1">
                                    @foreach (var tw in card.Tags)
                                    {
                                        <SkeletonCn Class="@($"h-5 {tw} rounded-full")" />
                                    }
                                </div>
                                <div class="flex items-center justify-between border-t pt-2">
                                    <SkeletonCn Class="h-5 w-5 rounded-full" />
                                    <SkeletonCn Class="h-3 w-16" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record KanbanCard(string TitleW, string SubW, string[] Tags);
    private record KanbanColumn(string LabelW, KanbanCard[] Cards);

    private static readonly KanbanColumn[] _columns =
    [
        new("w-16", [
            new("w-full", "w-3/4", ["w-12", "w-16"]),
            new("w-5/6", "w-2/3", ["w-14", "w-10"]),
            new("w-full", "w-4/5", ["w-16"]),
            new("w-3/4", "w-1/2", ["w-12", "w-14"]),
        ]),
        new("w-24", [
            new("w-full", "w-2/3", ["w-14", "w-12"]),
            new("w-4/5", "w-3/4", ["w-10"]),
            new("w-full", "w-1/2", ["w-16", "w-12"]),
        ]),
        new("w-12", [
            new("w-full", "w-4/5", ["w-16"]),
            new("w-5/6", "w-2/3", ["w-12"]),
        ]),
    ];
}
