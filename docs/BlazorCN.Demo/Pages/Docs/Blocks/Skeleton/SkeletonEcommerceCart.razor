@* ============================================================
   Block: skeleton-ecommerce-cart
   Title: SkeletonEcommerceCart
   Description: A React shopping cart skeleton loader block built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for ecommerce cart loading states
   Source: original/blocks/skeleton/skeleton-ecommerce-cart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-28" />
                <SkeletonCn Class="h-3 w-16" />
            </div>
        </div>

        @* Cart Items *@
        @foreach (var item in _cartItems)
        {
            <div class="border-b px-4 py-3">
                <div class="flex gap-3">
                    <SkeletonCn Class="size-14 shrink-0 rounded-md" />
                    <div class="flex min-w-0 flex-1 flex-col gap-1.5">
                        <SkeletonCn Class="@($"h-4 {item.NameW}")" />
                        <SkeletonCn Class="@($"h-3 {item.DetailW}")" />
                        <div class="flex items-center justify-between">
                            <SkeletonCn Class="h-7 w-20 rounded-md" />
                            <SkeletonCn Class="@($"h-4 {item.PriceW}")" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Cart Summary *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <SkeletonCn Class="h-3 w-16" />
                    <SkeletonCn Class="h-3 w-14" />
                </div>
                <div class="flex items-center justify-between">
                    <SkeletonCn Class="h-3 w-20" />
                    <SkeletonCn Class="h-3 w-12" />
                </div>
                <div class="flex items-center justify-between border-t pt-2">
                    <SkeletonCn Class="h-4 w-14" />
                    <SkeletonCn Class="h-4 w-16" />
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center gap-2 px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
            <div class="flex-1"></div>
            <SkeletonCn Class="h-7 w-28 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record CartItem(string NameW, string DetailW, string PriceW);

    private static readonly CartItem[] _cartItems =
    [
        new("w-44", "w-28", "w-14"),
        new("w-36", "w-32", "w-16"),
        new("w-40", "w-24", "w-12"),
    ];
}
