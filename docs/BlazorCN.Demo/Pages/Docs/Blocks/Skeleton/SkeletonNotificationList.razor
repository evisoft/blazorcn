@* ============================================================
   Block: skeleton-notification-list
   Title: SkeletonNotificationList
   Description: A React notification list skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for alert feeds
   Source: original/blocks/skeleton/skeleton-notification-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-28" />
            <SkeletonCn Class="h-7 w-24 rounded-md" />
        </div>

        @* Notifications *@
        @foreach (var notif in _notifications)
        {
            var item = notif;
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", item.IsLast ? "" : "border-b")">
                <SkeletonCn Class="size-1.5 shrink-0 rounded-full" />
                <SkeletonCn Class="size-6 shrink-0 rounded-full" />
                <div class="min-w-0 flex-1 space-y-1.5">
                    <SkeletonCn Class="@($"h-3 {item.TextWidth}")" />
                    <SkeletonCn Class="@($"h-3 {item.TimeWidth}")" />
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-center">
            <SkeletonCn Class="mx-auto h-3 w-24" />
        </div>
    </div>
</section>

@code {
    private record NotifItem(string TextWidth, string TimeWidth, bool IsLast);

    private static readonly NotifItem[] _notifications =
    [
        new("w-full",    "w-12", false),
        new("w-11/12",   "w-14", false),
        new("w-full",    "w-10", false),
        new("w-10/12",   "w-16", false),
        new("w-full",    "w-14", true),
    ];
}
