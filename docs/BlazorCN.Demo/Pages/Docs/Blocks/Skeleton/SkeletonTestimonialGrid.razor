@* ============================================================
   Block: skeleton-testimonial-grid
   Title: SkeletonTestimonialGrid
   Description: A React testimonial grid skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for social proof sections
   Source: original/blocks/skeleton/skeleton-testimonial-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-28" />
                <SkeletonCn Class="h-3 w-20" />
            </div>
        </div>

        @* Testimonial Grid *@
        <div class="px-4 py-3">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                @foreach (var item in _testimonials)
                {
                    <div class="rounded-md border p-3">
                        @* Quote Icon *@
                        <SkeletonCn Class="mb-2.5 h-5 w-5 rounded" />

                        @* Quote Text *@
                        <div class="mb-3 space-y-1.5">
                            @foreach (var w in item.QuoteLines)
                            {
                                <SkeletonCn Class="@($"h-3 {w}")" />
                            }
                        </div>

                        @* Author *@
                        <div class="flex items-center gap-2.5">
                            <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                            <div class="space-y-1.5">
                                <SkeletonCn Class="@($"h-3 {item.NameWidth}")" />
                                <SkeletonCn Class="@($"h-3 {item.RoleWidth}")" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-24" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string[] QuoteLines, string NameWidth, string RoleWidth);

    private static readonly Testimonial[] _testimonials =
    [
        new(["w-full", "w-full", "w-4/5"], "w-20", "w-24"),
        new(["w-full", "w-5/6", "w-3/4"], "w-24", "w-20"),
        new(["w-full", "w-full", "w-2/3"], "w-16", "w-28"),
    ];
}
