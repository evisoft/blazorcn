@* ============================================================
   Block: skeleton-tabs-horizontal
   Title: SkeletonTabsHorizontal
   Description: A React horizontal tabs skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for tabbed navigation loading states
   Source: original/blocks/skeleton/skeleton-tabs-horizontal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Tab Bar *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-2">
                @foreach (var tab in _tabs)
                {
                    <SkeletonCn Class="@($"h-8 {tab}")" />
                }
            </div>
        </div>

        @* Tab Content *@
        <div class="space-y-4 px-4 py-3">
            <SkeletonCn Class="h-4 w-36" />
            <div class="space-y-2">
                @foreach (var line in _bodyLines)
                {
                    <SkeletonCn Class="@($"h-3 {line}")" />
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="border-t px-4 py-2.5">
            <div class="flex gap-2">
                <SkeletonCn Class="h-7 w-20 rounded-md" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _tabs = ["w-20", "w-24", "w-16", "w-20"];
    private static readonly string[] _bodyLines = ["w-full", "w-full", "w-3/4"];
}
