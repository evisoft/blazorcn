@* ============================================================
   Block: skeleton-product-review
   Title: SkeletonProductReview
   Description: A React and Next.js skeleton loader for product review sections built with shadcn/ui Skeleton and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-product-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-36" />
        </div>

        @* Rating Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-6">
                <div class="flex flex-col items-center gap-2">
                    <SkeletonCn Class="h-10 w-14" />
                    <div class="flex gap-1">
                        @for (var i = 0; i < 5; i++)
                        {
                            <SkeletonCn Class="size-3.5" />
                        }
                    </div>
                    <SkeletonCn Class="h-3 w-20" />
                </div>
                <div class="flex-1 space-y-2">
                    @foreach (var bar in _distributionBarWidths)
                    {
                        <div class="flex items-center gap-3">
                            <SkeletonCn Class="h-3 w-6" />
                            <SkeletonCn Class="@($"h-2 {bar}")" />
                            <SkeletonCn Class="h-3 w-8" />
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Review Items *@
        @for (var i = 0; i < _reviewWidths.Length; i++)
        {
            var review = _reviewWidths[i];
            var isLast = i == _reviewWidths.Length - 1;
            <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                <div class="flex gap-3">
                    <SkeletonCn Class="size-10 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-2">
                        <div class="flex items-center justify-between gap-3">
                            <SkeletonCn Class="@($"h-4 {review.Name}")" />
                            <SkeletonCn Class="h-3 w-20" />
                        </div>
                        <div class="flex gap-1">
                            @for (var j = 0; j < 5; j++)
                            {
                                <SkeletonCn Class="size-3" />
                            }
                        </div>
                        <div class="space-y-2">
                            <SkeletonCn Class="h-3 w-full" />
                            <SkeletonCn Class="h-3 w-full" />
                            <SkeletonCn Class="@($"h-3 {review.LastLine}")" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-center">
                <SkeletonCn Class="h-3 w-28" />
            </div>
        </div>
    </div>
</section>

@code {
    private record ReviewWidth(string Name, string LastLine);

    private static readonly ReviewWidth[] _reviewWidths =
    [
        new("w-28", "w-3/4"),
        new("w-36", "w-2/3"),
        new("w-24", "w-4/5"),
    ];

    private static readonly string[] _distributionBarWidths = ["w-1/5", "w-2/5", "w-full", "w-3/5", "w-1/4"];
}
