@* ============================================================
   Block: skeleton-kanban-column
   Title: SkeletonKanbanColumn
   Description: A React and Next.js single kanban column skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, showing stacked task cards.
   Source: original/blocks/skeleton/skeleton-kanban-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Column Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-4 w-24" />
                    <SkeletonCn Class="h-5 w-7 rounded-full" />
                </div>
                <SkeletonCn Class="h-7 w-7 rounded-md" />
            </div>
        </div>

        @* Task Cards *@
        @foreach (var card in _cards)
        {
            var isLast = card == _cards[_cards.Length - 1];
            <div class="@Cn.Merge("space-y-2.5 px-4 py-3", isLast ? "" : "border-b")">
                <div class="space-y-1.5">
                    <SkeletonCn Class="@($"h-4 {card.TitleW}")" />
                    <SkeletonCn Class="@($"h-3 {card.DescW}")" />
                </div>

                <div class="flex items-center gap-2">
                    @foreach (var tag in card.Tags)
                    {
                        <SkeletonCn Class="@($"h-5 {tag} rounded-full")" />
                    }
                </div>

                <div class="flex items-center justify-between pt-0.5">
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="h-5 w-5 rounded-full" />
                        <SkeletonCn Class="h-3 w-20" />
                    </div>
                    <SkeletonCn Class="@($"h-3 {card.DateW}")" />
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <SkeletonCn Class="h-7 w-full rounded-md" />
        </div>
    </div>
</section>

@code {
    private record KanbanCard(string TitleW, string DescW, string[] Tags, string DateW);

    private static readonly KanbanCard[] _cards =
    [
        new("w-full",  "w-3/4", ["w-16", "w-14"], "w-16"),
        new("w-5/6",   "w-2/3", ["w-12", "w-18"], "w-20"),
        new("w-full",  "w-4/5", ["w-14"],          "w-14"),
        new("w-4/5",   "w-1/2", ["w-16", "w-12"], "w-18"),
        new("w-full",  "w-3/5", ["w-10", "w-14"], "w-16"),
    ];
}
