@* ============================================================
   Block: skeleton-footer
   Title: SkeletonFooter
   Description: A React footer skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for multi-column footer layouts
   Source: original/blocks/skeleton/skeleton-footer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
                @foreach (var col in _columnLinks)
                {
                    <div class="space-y-3">
                        <SkeletonCn Class="@($"h-4 {col.HeaderWidth}")" />
                        <div class="space-y-2">
                            @foreach (var link in col.Links)
                            {
                                <SkeletonCn Class="@($"h-3 {link}")" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-24" />
                <SkeletonCn Class="h-3 w-40" />
            </div>
        </div>
    </div>
</section>

@code {
    private record FooterColumn(string HeaderWidth, string[] Links);

    private static readonly FooterColumn[] _columnLinks =
    [
        new("w-16", ["w-20", "w-28", "w-16", "w-24"]),
        new("w-20", ["w-24", "w-16", "w-28", "w-20"]),
        new("w-14", ["w-16", "w-24", "w-20", "w-28"]),
        new("w-18", ["w-28", "w-20", "w-24", "w-16"]),
    ];
}
