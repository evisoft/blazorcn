@* ============================================================
   Block: skeleton-testimonial-carousel
   Title: SkeletonTestimonialCarousel
   Description: A React testimonial carousel skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for rotating quote loading states
   Source: original/blocks/skeleton/skeleton-testimonial-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-36" />
                <SkeletonCn Class="h-3 w-20" />
            </div>
        </div>

        @* Carousel Content *@
        <div class="px-4 py-3">
            <div class="relative py-6">
                @* Left Arrow *@
                <div class="absolute left-0 top-1/2 -translate-y-1/2">
                    <SkeletonCn Class="size-8 rounded-full" />
                </div>

                @* Testimonial Content *@
                <div class="mx-auto max-w-md px-12 text-center">
                    @* Star Rating *@
                    <div class="mb-4 flex items-center justify-center gap-1">
                        @foreach (var i in _stars)
                        {
                            <SkeletonCn Class="size-4 rounded-sm" />
                        }
                    </div>

                    @* Quote Text *@
                    <div class="mb-4 space-y-2">
                        @foreach (var line in _quoteLines)
                        {
                            <SkeletonCn Class="@($"mx-auto h-3 {line.Width}")" />
                        }
                    </div>

                    @* Author *@
                    <div class="flex flex-col items-center gap-2">
                        <SkeletonCn Class="size-10 rounded-full" />
                        <div class="space-y-1">
                            <SkeletonCn Class="mx-auto h-4 w-28" />
                            <SkeletonCn Class="mx-auto h-3 w-36" />
                        </div>
                    </div>
                </div>

                @* Right Arrow *@
                <div class="absolute right-0 top-1/2 -translate-y-1/2">
                    <SkeletonCn Class="size-8 rounded-full" />
                </div>
            </div>
        </div>

        @* Pagination Dots Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-center gap-2">
                @foreach (var d in _dots)
                {
                    <SkeletonCn Class="size-2 rounded-full" />
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record QuoteLine(string Width);

    private static readonly QuoteLine[] _quoteLines =
    [
        new("w-full"),
        new("w-full"),
        new("w-5/6"),
        new("w-4/5"),
    ];

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
    private static readonly int[] _dots = [0, 1, 2, 3, 4];
}
