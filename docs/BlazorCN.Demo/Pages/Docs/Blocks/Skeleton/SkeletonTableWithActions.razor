@* ============================================================
   Block: skeleton-table-with-actions
   Title: SkeletonTableWithActions
   Description: A React table skeleton with action button placeholders built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-table-with-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-28" />
            <SkeletonCn Class="h-4 flex-1" />
            <SkeletonCn Class="h-4 w-24" />
            <SkeletonCn Class="h-4 w-20" />
        </div>

        @* Data rows with actions *@
        @foreach (var row in _rows)
        {
            var borderClass = row.IsLast ? "" : "border-b";
            <div class="@($"px-4 py-3 {borderClass}")">
                <div class="flex items-center gap-4">
                    <SkeletonCn Class="@($"h-3 {row.Col1}")" />
                    <SkeletonCn Class="h-3 flex-1" />
                    <SkeletonCn Class="@($"h-3 {row.Col2}")" />
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="size-7 rounded-md" />
                        <SkeletonCn Class="size-7 rounded-md" />
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record RowData(string Col1, string Col2, bool IsLast);

    private static readonly RowData[] _rows =
    [
        new("w-20", "w-28", false),
        new("w-24", "w-24", false),
        new("w-16", "w-32", false),
        new("w-20", "w-28", false),
        new("w-18", "w-24", true),
    ];
}
