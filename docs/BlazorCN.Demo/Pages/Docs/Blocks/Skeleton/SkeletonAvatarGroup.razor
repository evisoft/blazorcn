@* ============================================================
   Block: skeleton-avatar-group
   Title: SkeletonAvatarGroup
   Description: A React and Next.js overlapping avatar group skeleton loader with stacked circles and count badge built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/skeleton/skeleton-avatar-group.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <SkeletonCn Class="h-4 w-28" />
                    <SkeletonCn Class="mt-1.5 h-3 w-48" />
                </div>
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>

        @* Avatar group *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex -space-x-2">
                    @foreach (var i in Enumerable.Range(0, 6))
                    {
                        <SkeletonCn Class="size-8 rounded-full border-2 border-card" />
                    }
                </div>
                <SkeletonCn Class="h-6 w-12 rounded-full" />
            </div>
        </div>

        @* Member summary rows *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2.5">
                @foreach (var row in _memberRows)
                {
                    <div class="flex items-center gap-3">
                        <SkeletonCn Class="size-6 rounded-full" />
                        <SkeletonCn Class="@($"h-3 {row.NameWidth}")" />
                        <SkeletonCn Class="@($"h-3 {row.RoleWidth}")" />
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex justify-center px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private record MemberRow(string NameWidth, string RoleWidth);

    private static readonly MemberRow[] _memberRows =
    [
        new("w-28", "w-12"),
        new("w-24", "w-16"),
        new("w-32", "w-10"),
    ];
}
