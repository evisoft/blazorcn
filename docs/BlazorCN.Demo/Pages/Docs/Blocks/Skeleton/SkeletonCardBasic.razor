@* ============================================================
   Block: skeleton-card-basic
   Title: SkeletonCardBasic
   Description: A React skeleton loading placeholder for basic card layouts built with shadcn/ui Skeleton, Next.js, and Tailwind CSS. Features image, title, body text, and button placeholders with pulse animation.
   Source: original/blocks/skeleton/skeleton-card-basic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SkeletonCn Class="h-48 w-full rounded-none" />
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-3/4" />
        </div>
        <div class="space-y-2 border-b px-4 py-3">
            @foreach (var w in _bodyWidths)
            {
                <SkeletonCn Class="@($"h-3 {w}")" />
            }
        </div>
        <div class="px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>
    </div>
</section>

@code {
    private static readonly string[] _bodyWidths = ["w-full", "w-5/6", "w-2/3"];
}
