@* ============================================================
   Block: skeleton-blog-post
   Title: SkeletonBlogPost
   Description: A React and Next.js blog post skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring title, author metadata, hero image, and multi-paragraph content placeholders
   Source: original/blocks/skeleton/skeleton-blog-post.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-24" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>

        @* Title & Meta *@
        <div class="space-y-3 border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-3/4" />
            <SkeletonCn Class="h-4 w-1/2" />
            <div class="flex items-center gap-3 pt-1">
                <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                <SkeletonCn Class="h-3 w-28" />
                <SkeletonCn Class="size-1 rounded-full" />
                <SkeletonCn Class="h-3 w-24" />
                <SkeletonCn Class="size-1 rounded-full" />
                <SkeletonCn Class="h-3 w-16" />
            </div>
        </div>

        @* Hero Image *@
        <SkeletonCn Class="h-48 w-full rounded-none border-b" />

        @* Content Paragraphs *@
        <div class="space-y-5 px-4 py-3">
            @* Paragraph 1 *@
            <div class="space-y-2">
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-11/12" />
                <SkeletonCn Class="h-3 w-4/5" />
            </div>

            @* Paragraph 2 *@
            <div class="space-y-2">
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-3/4" />
            </div>

            @* Paragraph 3 *@
            <div class="space-y-2">
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-11/12" />
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-2/3" />
            </div>

            @* Paragraph 4 *@
            <div class="space-y-2">
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-5/6" />
            </div>
        </div>

        @* Footer *@
        <div class="flex justify-center border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>
