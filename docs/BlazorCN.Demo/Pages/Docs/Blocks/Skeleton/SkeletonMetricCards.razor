@* ============================================================
   Block: skeleton-metric-cards
   Title: SkeletonMetricCards
   Description: React dashboard metric card skeletons with icon, label, value, and sparkline areas built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-metric-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-32" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>

        @* Metric Cards *@
        <div class="divide-y">
            @foreach (var card in _cards)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between">
                        <div class="flex items-center gap-2">
                            <SkeletonCn Class="size-8 rounded" />
                            <div class="space-y-1">
                                <SkeletonCn Class="@($"h-3 {card.LabelWidth}")" />
                                <SkeletonCn Class="@($"h-6 {card.ValueWidth}")" />
                            </div>
                        </div>
                        <SkeletonCn Class="@($"h-5 {card.ChangeWidth} rounded")" />
                    </div>
                    <div class="mt-3">
                        <SkeletonCn Class="h-8 w-full rounded" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricCard(string LabelWidth, string ValueWidth, string ChangeWidth);

    private static readonly MetricCard[] _cards =
    [
        new("w-20", "w-24", "w-14"),
        new("w-24", "w-20", "w-16"),
        new("w-16", "w-28", "w-12"),
    ];
}
