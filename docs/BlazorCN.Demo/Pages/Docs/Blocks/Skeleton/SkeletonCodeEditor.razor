@* ============================================================
   Block: skeleton-code-editor
   Title: SkeletonCodeEditor
   Description: A React and Next.js code editor skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring tab bar, line numbers, and indented code line placeholders.
   Source: original/blocks/skeleton/skeleton-code-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Tab bar *@
        <div class="flex items-center gap-1 border-b bg-muted/30 px-4 py-2.5">
            @foreach (var tab in _tabs)
            {
                <SkeletonCn Class="@($"h-7 {tab} rounded-md")" />
            }
        </div>

        @* Editor content *@
        <div class="flex">
            @* Line number gutter *@
            <div class="flex shrink-0 flex-col items-end border-r bg-muted/30 px-3 py-3">
                @foreach (var w in _lineNumbers)
                {
                    <SkeletonCn Class="@($"mb-1.5 h-4 {w}")" />
                }
            </div>

            @* Code lines *@
            <div class="flex-1 space-y-1.5 px-4 py-3">
                @foreach (var line in _codeLines)
                {
                    if (line.Indent == "spacer")
                    {
                        <div class="h-4"></div>
                    }
                    else
                    {
                        <SkeletonCn Class="@($"h-3 {line.Width} {line.Indent}")" />
                    }
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _tabs = ["w-28", "w-24", "w-32"];

    private static readonly string[] _lineNumbers =
    [
        "w-4", "w-4", "w-4", "w-4", "w-4", "w-4", "w-4", "w-4", "w-4",
        "w-5", "w-5", "w-5", "w-5", "w-5", "w-5"
    ];

    private record CodeLine(string Width, string Indent);

    private static readonly CodeLine[] _codeLines =
    [
        new("w-1/2", ""),
        new("w-2/5", ""),
        new("", "spacer"),
        new("w-3/5", ""),
        new("w-1/2", "ml-4"),
        new("w-2/3", "ml-4"),
        new("w-1/3", "ml-8"),
        new("w-2/5", "ml-8"),
        new("w-1/4", "ml-4"),
        new("w-4", ""),
        new("", "spacer"),
        new("w-1/3", ""),
        new("w-3/5", "ml-4"),
        new("w-4", ""),
    ];
}
