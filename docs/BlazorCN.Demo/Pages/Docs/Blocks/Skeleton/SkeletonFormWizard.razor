@* ============================================================
   Block: skeleton-form-wizard
   Title: SkeletonFormWizard
   Description: A React multi-step form wizard skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for onboarding flows
   Source: original/blocks/skeleton/skeleton-form-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Step Indicator *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                @foreach (var step in _steps)
                {
                    var s = step;
                    <div class="flex flex-1 items-center">
                        <div class="flex flex-col items-center gap-1.5">
                            <SkeletonCn Class="size-8 rounded-full" />
                            <SkeletonCn Class="@($"h-3 {s.LabelWidth}")" />
                        </div>
                        @if (s.ShowConnector)
                        {
                            <SkeletonCn Class="mx-2 h-px flex-1" />
                        }
                    </div>
                }
            </div>
        </div>

        @* Form Content *@
        <div class="space-y-5 px-4 py-3">
            @foreach (var field in _fields)
            {
                var f = field;
                <div class="space-y-2">
                    <SkeletonCn Class="@($"h-4 {f.LabelWidth}")" />
                    <SkeletonCn Class="@($"{f.Height} w-full rounded-md")" />
                </div>
            }
        </div>

        @* Navigation *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-7 w-20 rounded-md" />
                <SkeletonCn Class="h-7 w-24 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record StepDef(string LabelWidth, bool ShowConnector);
    private record FieldDef(string LabelWidth, string Height);

    private static readonly StepDef[] _steps =
    [
        new("w-14", true),
        new("w-16", true),
        new("w-12", true),
        new("w-14", false),
    ];

    private static readonly FieldDef[] _fields =
    [
        new("w-24", "h-9"),
        new("w-32", "h-9"),
        new("w-28", "h-24"),
    ];
}
