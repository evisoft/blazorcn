@* ============================================================
   Block: skeleton-form-two-column
   Title: SkeletonFormTwoColumn
   Description: A React responsive two-column form skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for settings pages
   Source: original/blocks/skeleton/skeleton-form-two-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-32" />
                <SkeletonCn Class="h-3 w-20" />
            </div>
        </div>

        @* Two-column grid *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                @foreach (var field in _gridFields)
                {
                    <div class="space-y-2">
                        <SkeletonCn Class="@($"h-4 {field.LabelWidth}")" />
                        <SkeletonCn Class="h-9 w-full rounded-md" />
                    </div>
                }
            </div>
        </div>

        @* Full-width textarea *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <SkeletonCn Class="h-4 w-24" />
                <SkeletonCn Class="h-24 w-full rounded-md" />
                <SkeletonCn Class="h-3 w-44" />
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-end">
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record GridField(string LabelWidth);

    private static readonly GridField[] _gridFields =
    [
        new("w-20"),
        new("w-24"),
        new("w-16"),
        new("w-28"),
        new("w-20"),
        new("w-24"),
    ];
}
