@* ============================================================
   Block: skeleton-receipt
   Title: SkeletonReceipt
   Description: A React and Next.js receipt skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for e-commerce order views.
   Source: original/blocks/skeleton/skeleton-receipt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Store / Order Header *@
        <div class="border-b px-4 py-3 text-center">
            <SkeletonCn Class="mx-auto mb-2 h-6 w-32" />
            <SkeletonCn Class="mx-auto h-3 w-24" />
        </div>

        @* Order Info *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex justify-between">
                <SkeletonCn Class="h-3 w-16" />
                <SkeletonCn Class="h-3 w-32" />
            </div>
            <div class="flex justify-between">
                <SkeletonCn Class="h-3 w-20" />
                <SkeletonCn Class="h-3 w-24" />
            </div>
        </div>

        @* Line Items *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2.5">
                @foreach (var item in _lineItems)
                {
                    <div class="flex justify-between">
                        <SkeletonCn Class="@($"h-3 {item.NameWidth}")" />
                        <SkeletonCn Class="@($"h-3 {item.PriceWidth}")" />
                    </div>
                }
            </div>
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex justify-between">
                    <SkeletonCn Class="h-3 w-16" />
                    <SkeletonCn Class="h-3 w-16" />
                </div>
                <div class="flex justify-between">
                    <SkeletonCn Class="h-3 w-12" />
                    <SkeletonCn Class="h-3 w-14" />
                </div>
                <div class="flex justify-between border-t pt-2">
                    <SkeletonCn Class="h-4 w-20" />
                    <SkeletonCn Class="h-4 w-20" />
                </div>
            </div>
        </div>

        @* Payment Row *@
        <div class="border-b px-4 py-3">
            <div class="flex justify-between">
                <SkeletonCn Class="h-3 w-24" />
                <SkeletonCn Class="h-3 w-28" />
            </div>
        </div>

        @* Barcode / QR Placeholder *@
        <div class="px-4 py-2.5">
            <SkeletonCn Class="mx-auto h-12 w-full" />
        </div>

    </div>
</section>

@code {
    private record LineItem(string NameWidth, string PriceWidth);

    private static readonly LineItem[] _lineItems =
    [
        new("w-3/5", "w-14"),
        new("w-2/5", "w-16"),
        new("w-1/2", "w-12"),
        new("w-3/4", "w-14"),
        new("w-2/3", "w-16"),
    ];
}
