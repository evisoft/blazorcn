@* ============================================================
   Block: skeleton-playlist
   Title: SkeletonPlaylist
   Description: A React and Next.js playlist skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for music and media track listings
   Source: original/blocks/skeleton/skeleton-playlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Playlist header *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-4">
                <SkeletonCn Class="size-28 shrink-0 rounded-md" />
                <div class="flex min-w-0 flex-1 flex-col justify-center space-y-2">
                    <SkeletonCn Class="h-4 w-3/4" />
                    <SkeletonCn Class="h-3 w-1/2" />
                    <SkeletonCn Class="h-3 w-2/3" />
                </div>
            </div>
        </div>

        @* Track list *@
        <div>
            @foreach (var track in _tracks)
            {
                var borderClass = track.Index < _tracks.Length - 1 ? " border-b" : "";
                <div class="@($"flex items-center gap-4 px-4 py-3{borderClass}")">
                    <SkeletonCn Class="h-4 w-6 shrink-0" />
                    <div class="min-w-0 flex-1 space-y-1.5">
                        <SkeletonCn Class="@($"h-3 {track.TitleWidth}")" />
                        <SkeletonCn Class="@($"h-3 {track.ArtistWidth}")" />
                    </div>
                    <SkeletonCn Class="h-3 w-10 shrink-0" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TrackSkeleton(int Index, string TitleWidth, string ArtistWidth);

    private static readonly TrackSkeleton[] _tracks =
    [
        new(0, "w-3/4", "w-2/5"),
        new(1, "w-1/2", "w-1/3"),
        new(2, "w-2/3", "w-2/5"),
        new(3, "w-3/5", "w-1/4"),
        new(4, "w-4/5", "w-1/3"),
        new(5, "w-1/2", "w-2/5"),
        new(6, "w-2/3", "w-1/4"),
    ];
}
