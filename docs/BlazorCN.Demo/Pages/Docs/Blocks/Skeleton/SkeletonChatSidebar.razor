@* ============================================================
   Block: skeleton-chat-sidebar
   Title: SkeletonChatSidebar
   Description: A React and Next.js skeleton loading placeholder for two-panel chat layouts, built with shadcn/ui Skeleton and Tailwind CSS with conversation list and active chat view.
   Source: original/blocks/skeleton/skeleton-chat-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex overflow-hidden rounded-lg border bg-card">
        @* Sidebar panel *@
        <div class="w-72 shrink-0 border-r">
            <div class="border-b px-4 py-3">
                <SkeletonCn Class="h-9 w-full rounded-md" />
            </div>

            <div>
                @foreach (var conv in _conversations)
                {
                    <div class="@Cn.Merge("flex gap-3 border-b px-4 py-3", conv.Last ? "last:border-b-0" : "")">
                        <SkeletonCn Class="size-10 shrink-0 rounded-full" />
                        <div class="min-w-0 flex-1 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <SkeletonCn Class="@($"h-3.5 {conv.NameWidth}")" />
                                <SkeletonCn Class="h-3 w-10" />
                            </div>
                            <SkeletonCn Class="@($"h-3 {conv.PreviewWidth}")" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Main chat panel *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Chat header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="size-10 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-1.5">
                        <div class="flex items-center gap-2">
                            <SkeletonCn Class="h-4 w-32" />
                            <SkeletonCn Class="size-2 rounded-full" />
                        </div>
                        <SkeletonCn Class="h-3 w-24" />
                    </div>
                    <SkeletonCn Class="size-8 shrink-0 rounded-md" />
                </div>
            </div>

            @* Messages *@
            <div class="flex-1 border-b px-4 py-3">
                <div class="space-y-4">
                    <div class="flex gap-2">
                        <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                        <div class="space-y-2">
                            <SkeletonCn Class="h-10 w-64 rounded-2xl" />
                            <SkeletonCn Class="h-10 w-48 rounded-2xl" />
                        </div>
                    </div>

                    <div class="flex justify-end">
                        <SkeletonCn Class="h-10 w-56 rounded-2xl" />
                    </div>

                    <div class="flex gap-2">
                        <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                        <SkeletonCn Class="h-10 w-72 rounded-2xl" />
                    </div>

                    <div class="flex justify-end">
                        <div class="space-y-2">
                            <SkeletonCn Class="h-10 w-44 rounded-2xl" />
                            <SkeletonCn Class="h-10 w-60 rounded-2xl" />
                        </div>
                    </div>
                </div>
            </div>

            @* Input bar *@
            <div class="px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="size-9 shrink-0 rounded-md" />
                    <SkeletonCn Class="h-9 flex-1 rounded-full" />
                    <SkeletonCn Class="size-9 shrink-0 rounded-full" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Conversation(string Id, string NameWidth, string PreviewWidth, bool Last);

    private static readonly Conversation[] _conversations =
    [
        new("c1", "w-24", "w-full",  false),
        new("c2", "w-20", "w-4/5",   false),
        new("c3", "w-28", "w-full",  false),
        new("c4", "w-16", "w-3/4",   false),
        new("c5", "w-24", "w-full",  false),
        new("c6", "w-20", "w-4/5",   true),
    ];
}
