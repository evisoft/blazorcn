@* ============================================================
   Block: skeleton-email-compose
   Title: SkeletonEmailCompose
   Description: A React email compose form skeleton loader block built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for email editor loading states
   Source: original/blocks/skeleton/skeleton-email-compose.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Recipient Fields *@
        @foreach (var field in _recipientFields)
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <SkeletonCn Class="@($"h-3 {field.LabelW}")" />
                <SkeletonCn Class="h-9 flex-1 rounded-md" />
            </div>
        }

        @* Rich Text Toolbar *@
        <div class="flex items-center gap-1 border-b bg-muted/30 px-4 py-2">
            @foreach (var grp in _toolbarGroups)
            {
                var group = grp;
                var groupIndex = System.Array.IndexOf(_toolbarGroups, group);
                <div class="flex items-center gap-1">
                    @if (groupIndex > 0)
                    {
                        <div class="mx-1 h-4 w-px bg-border"></div>
                    }
                    @for (int i = 0; i < group.Count; i++)
                    {
                        <SkeletonCn Class="size-7 rounded" />
                    }
                </div>
            }
            <div class="flex-1"></div>
            <SkeletonCn Class="size-7 rounded" />
        </div>

        @* Email Body *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-5/6" />
                <SkeletonCn Class="h-3 w-3/4" />
                <SkeletonCn Class="mt-3 h-3 w-full" />
                <SkeletonCn Class="h-3 w-4/5" />
                <SkeletonCn Class="h-3 w-2/3" />
                <SkeletonCn Class="mt-3 h-3 w-3/4" />
                <SkeletonCn Class="h-3 w-1/2" />
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center gap-2 px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
            <SkeletonCn Class="h-7 w-24 rounded-md" />
            <div class="flex-1"></div>
            <SkeletonCn Class="size-7 rounded-md" />
            <SkeletonCn Class="size-7 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record RecipientField(string LabelW, string Id);
    private record ToolbarGroup(int Count, string Id);

    private static readonly RecipientField[] _recipientFields =
    [
        new("w-6", "to"),
        new("w-6", "cc"),
        new("w-14", "subject"),
    ];

    private static readonly ToolbarGroup[] _toolbarGroups =
    [
        new(3, "format"),
        new(3, "align"),
        new(2, "insert"),
    ];
}
