@* ============================================================
   Block: skeleton-pagination
   Title: SkeletonPagination
   Description: A React and Next.js pagination skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for table and list navigation
   Source: original/blocks/skeleton/skeleton-pagination.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Result count + page buttons + per-page selector *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                @* Result count *@
                <SkeletonCn Class="h-3 w-28" />

                @* Page navigation *@
                <div class="flex items-center gap-1">
                    <SkeletonCn Class="h-7 w-7 rounded-md" />
                    @foreach (var w in _pageButtons)
                    {
                        <SkeletonCn Class="@($"h-7 {w} rounded-md")" />
                    }
                    <SkeletonCn Class="h-7 w-7 rounded-md" />
                </div>

                @* Per-page selector *@
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-3 w-14" />
                    <SkeletonCn Class="h-7 w-16 rounded-md" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _pageButtons = ["w-8", "w-8", "w-8", "w-8", "w-8"];
}
