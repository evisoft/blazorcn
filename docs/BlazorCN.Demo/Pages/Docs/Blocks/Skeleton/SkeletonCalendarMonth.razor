@* ============================================================
   Block: skeleton-calendar-month
   Title: SkeletonCalendarMonth
   Description: A React and Next.js monthly calendar skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring a 7-column day grid, navigation controls, and event dot indicators
   Source: original/blocks/skeleton/skeleton-calendar-month.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Calendar Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-32" />
            <div class="flex items-center gap-2">
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
            </div>
        </div>

        @* Day of Week Headers *@
        <div class="grid grid-cols-7 border-b px-4 py-3">
            @foreach (var day in _dayLabels)
            {
                <div class="text-center">
                    <SkeletonCn Class="mx-auto h-3 w-8" />
                </div>
            }
        </div>

        @* Date Grid - 5 weeks *@
        <div class="grid grid-cols-7 gap-px border-b bg-muted/30">
            @foreach (var index in Enumerable.Range(0, 35))
            {
                var hasEvent = _eventDays.Contains(index);
                var isCurrentMonth = index >= 3 && index < 28;
                <div class="@($"aspect-square bg-card p-2 {(isCurrentMonth ? "" : "opacity-40")}")">
                    <div class="flex h-full flex-col">
                        <SkeletonCn Class="h-3 w-5" />
                        @if (hasEvent && isCurrentMonth)
                        {
                            <div class="mt-auto flex gap-1">
                                <SkeletonCn Class="size-1.5 rounded-full" />
                                <SkeletonCn Class="size-1.5 rounded-full" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex justify-center px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private static readonly string[] _dayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    private static readonly int[] _eventDays = [4, 7, 14, 19, 27];
}
