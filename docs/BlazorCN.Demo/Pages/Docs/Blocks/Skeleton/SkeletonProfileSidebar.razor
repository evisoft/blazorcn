@* ============================================================
   Block: skeleton-profile-sidebar
   Title: SkeletonProfileSidebar
   Description: A React and Next.js profile sidebar skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for dashboard layouts.
   Source: original/blocks/skeleton/skeleton-profile-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SkeletonCn Class="h-24 w-full rounded-none" />
        <div class="px-4">
            <SkeletonCn Class="-mt-8 size-16 rounded-full border-4 border-card" />
        </div>
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-40" />
            <SkeletonCn Class="mt-1.5 h-3 w-28" />
        </div>
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                @foreach (var row in _infoRows)
                {
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="@($"{row.IconSize} shrink-0")" />
                        <SkeletonCn Class="@($"h-3 {row.TextWidth}")" />
                    </div>
                }
            </div>
        </div>
        <div class="px-4 py-3">
            <div class="space-y-2">
                <SkeletonCn Class="h-7 w-full rounded-md" />
                <SkeletonCn Class="h-7 w-full rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record InfoRow(string IconSize, string TextWidth);

    private static readonly InfoRow[] _infoRows =
    [
        new("size-4", "w-44"),
        new("size-4", "w-36"),
        new("size-4", "w-52"),
        new("size-4", "w-28"),
    ];
}
