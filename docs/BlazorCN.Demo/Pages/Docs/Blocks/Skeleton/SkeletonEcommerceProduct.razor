@* ============================================================
   Block: skeleton-ecommerce-product
   Title: SkeletonEcommerceProduct
   Description: A React product detail skeleton loader block built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for ecommerce product page loading states
   Source: original/blocks/skeleton/skeleton-ecommerce-product.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Product Image *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-72 w-full rounded-md" />
            @* Thumbnail strip *@
            <div class="mt-2 flex gap-2">
                <SkeletonCn Class="size-12 rounded-md" />
                <SkeletonCn Class="size-12 rounded-md" />
                <SkeletonCn Class="size-12 rounded-md" />
                <SkeletonCn Class="size-12 rounded-md" />
            </div>
        </div>

        @* Product Info *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="mb-2 h-4 w-48" />
            <SkeletonCn Class="mb-3 h-4 w-20" />

            @* Rating Stars *@
            <div class="mb-3 flex items-center gap-1">
                <SkeletonCn Class="size-3.5 rounded-sm" />
                <SkeletonCn Class="size-3.5 rounded-sm" />
                <SkeletonCn Class="size-3.5 rounded-sm" />
                <SkeletonCn Class="size-3.5 rounded-sm" />
                <SkeletonCn Class="size-3.5 rounded-sm" />
                <SkeletonCn Class="ml-1.5 h-3 w-16" />
            </div>

            @* Description *@
            <div class="space-y-1.5">
                @foreach (var w in _descriptionLines)
                {
                    <SkeletonCn Class="@($"h-3 {w}")" />
                }
            </div>
        </div>

        @* Size Selector *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="mb-2 h-3 w-16" />
            <div class="flex gap-2">
                @foreach (var size in _sizeOptions)
                {
                    <SkeletonCn Class="@($"h-7 {size.W} rounded-md")" />
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center gap-2 px-4 py-2.5">
            <SkeletonCn Class="h-7 flex-1 rounded-md" />
            <SkeletonCn Class="h-7 w-7 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record SizeOption(string W, string Id);

    private static readonly SizeOption[] _sizeOptions =
    [
        new("w-12", "xs"),
        new("w-10", "s"),
        new("w-12", "m"),
        new("w-14", "l"),
        new("w-10", "xl"),
    ];

    private static readonly string[] _descriptionLines = ["w-full", "w-full", "w-4/5"];
}
