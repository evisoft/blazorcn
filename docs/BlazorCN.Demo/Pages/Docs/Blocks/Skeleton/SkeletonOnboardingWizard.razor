@* ============================================================
   Block: skeleton-onboarding-wizard
   Title: SkeletonOnboardingWizard
   Description: A React and Next.js onboarding wizard skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for multi-step setup flows
   Source: original/blocks/skeleton/skeleton-onboarding-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Progress steps *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                @for (var i = 0; i < _stepWidths.Length; i++)
                {
                    var idx = i;
                    var w = _stepWidths[idx];
                    <div class="flex items-center">
                        <div class="flex flex-col items-center gap-1.5">
                            <SkeletonCn Class="size-7 rounded-full" />
                            <SkeletonCn Class="@($"h-3 {w}")" />
                        </div>
                        @if (idx < _stepWidths.Length - 1)
                        {
                            <SkeletonCn Class="mx-3 h-0.5 w-12 sm:w-20" />
                        }
                    </div>
                }
            </div>
        </div>

        @* Content area *@
        <div class="border-b px-4 py-3">
            <div class="space-y-4">
                <div class="space-y-2 text-center">
                    <SkeletonCn Class="mx-auto h-4 w-48" />
                    @foreach (var lw in _contentLines)
                    {
                        var lineWidth = lw;
                        <SkeletonCn Class="@($"mx-auto h-3 {lineWidth}")" />
                    }
                </div>

                @* Illustration placeholder *@
                <SkeletonCn Class="mx-auto h-40 w-full rounded-md" />

                @* Form fields placeholder *@
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <SkeletonCn Class="h-3 w-20" />
                        <SkeletonCn Class="h-8 w-full rounded-md" />
                    </div>
                    <div class="space-y-1.5">
                        <SkeletonCn Class="h-3 w-24" />
                        <SkeletonCn Class="h-8 w-full rounded-md" />
                    </div>
                </div>
            </div>
        </div>

        @* Action buttons *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-7 w-16 rounded-md" />
                <SkeletonCn Class="h-7 w-24 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _stepWidths = ["w-14", "w-16", "w-12", "w-14"];
    private static readonly string[] _contentLines = ["w-full", "w-5/6"];
}
