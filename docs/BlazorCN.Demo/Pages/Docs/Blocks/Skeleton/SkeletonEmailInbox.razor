@* ============================================================
   Block: skeleton-email-inbox
   Title: SkeletonEmailInbox
   Description: A React email inbox skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for loading states in webmail list views.
   Source: original/blocks/skeleton/skeleton-email-inbox.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Toolbar *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <SkeletonCn Class="size-4 rounded" />
            <div class="h-4 w-px bg-border"></div>
            <SkeletonCn Class="size-7 rounded-md" />
            <SkeletonCn Class="size-7 rounded-md" />
            <SkeletonCn Class="size-7 rounded-md" />
            <div class="flex-1"></div>
            <SkeletonCn Class="h-7 w-24 rounded-md" />
        </div>

        @* Email List *@
        <div>
            @foreach (var row in _emailRows)
            {
                var idx = System.Array.IndexOf(_emailRows, row);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", idx < _emailRows.Length - 1 ? "border-b" : "")">
                    <SkeletonCn Class="size-4 rounded" />
                    <SkeletonCn Class="size-9 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-1.5">
                        <div class="flex items-center gap-2">
                            <SkeletonCn Class="@($"h-4 {row.Sender}")" />
                            <SkeletonCn Class="@($"h-3 {row.Subject}")" />
                        </div>
                        <SkeletonCn Class="@($"h-3 {row.Preview}")" />
                        <SkeletonCn Class="@($"h-3 {row.PreviewTail}")" />
                    </div>
                    <SkeletonCn Class="@($"h-3 shrink-0 {row.Time}")" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EmailRow(string Sender, string Subject, string Preview, string PreviewTail, string Time);

    private static readonly EmailRow[] _emailRows =
    [
        new("w-32", "w-24", "w-full", "w-4/5", "w-12"),
        new("w-40", "w-20", "w-5/6", "w-3/4", "w-16"),
        new("w-28", "w-20", "w-full", "w-2/3", "w-12"),
        new("w-36", "w-16", "w-4/5", "w-3/5", "w-14"),
        new("w-32", "w-24", "w-full", "w-1/2", "w-16"),
        new("w-40", "w-20", "w-5/6", "w-2/3", "w-12"),
    ];
}
