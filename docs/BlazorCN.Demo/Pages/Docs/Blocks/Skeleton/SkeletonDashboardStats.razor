@* ============================================================
   Block: skeleton-dashboard-stats
   Title: SkeletonDashboardStats
   Description: A React grid of stat card skeletons showing key metrics in a dashboard layout built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-dashboard-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-24" />
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-2 divide-x divide-y md:grid-cols-4">
            @foreach (var card in _statCards)
            {
                <div class="flex flex-col gap-3 px-4 py-4">
                    <SkeletonCn Class="@($"h-3 {card.LabelWidth}")" />
                    <SkeletonCn Class="@($"h-8 {card.ValueWidth}")" />
                    <div class="flex items-center gap-1.5">
                        <SkeletonCn Class="size-3 rounded-full" />
                        <SkeletonCn Class="@($"h-3 {card.TrendWidth}")" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-32" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record StatCard(string LabelWidth, string ValueWidth, string TrendWidth);

    private static readonly StatCard[] _statCards =
    [
        new("w-16", "w-20", "w-14"),
        new("w-20", "w-24", "w-16"),
        new("w-14", "w-18", "w-12"),
        new("w-18", "w-22", "w-16"),
    ];
}
