@* ============================================================
   Block: skeleton-map-sidebar
   Title: SkeletonMapSidebar
   Description: A React and Next.js map sidebar skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, showing search, location list, and map area.
   Source: original/blocks/skeleton/skeleton-map-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-28" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>

        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="w-72 border-r">
                @* Search Input *@
                <div class="border-b px-4 py-3">
                    <SkeletonCn Class="h-8 w-full rounded-md" />
                </div>

                @* Filter Chips *@
                <div class="flex items-center gap-2 border-b px-4 py-2.5">
                    <SkeletonCn Class="h-6 w-14 rounded-full" />
                    <SkeletonCn Class="h-6 w-18 rounded-full" />
                    <SkeletonCn Class="h-6 w-12 rounded-full" />
                </div>

                @* Location List *@
                <div class="overflow-auto">
                    @foreach (var loc in _locations)
                    {
                        var item = loc;
                        <div class="@Cn.Merge("px-4 py-3", item.BorderBottom ? "border-b" : "")">
                            <div class="mb-1.5 flex items-center justify-between">
                                <SkeletonCn Class="@($"h-4 {item.NameW}")" />
                                <SkeletonCn Class="h-3 w-10" />
                            </div>
                            <div class="space-y-1">
                                <SkeletonCn Class="@($"h-3 {item.AddrW}")" />
                                <SkeletonCn Class="@($"h-3 {item.Addr2W}")" />
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <SkeletonCn Class="h-3 w-3 rounded-full" />
                                <SkeletonCn Class="@($"h-3 {item.DistW}")" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Map Area *@
            <div class="flex-1 bg-muted/30 p-4">
                <SkeletonCn Class="h-full w-full rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record Location(string NameW, string AddrW, string Addr2W, string DistW, bool BorderBottom);

    private static readonly Location[] _locations =
    [
        new("w-3/4", "w-full", "w-5/6", "w-16", true),
        new("w-2/3", "w-5/6", "w-3/4", "w-20", true),
        new("w-4/5", "w-full", "w-2/3", "w-14", true),
        new("w-1/2", "w-4/5", "w-3/4", "w-18", true),
        new("w-3/5", "w-full", "w-5/6", "w-16", false),
    ];
}
