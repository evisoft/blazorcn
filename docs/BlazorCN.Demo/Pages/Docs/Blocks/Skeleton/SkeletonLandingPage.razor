@* ============================================================
   Block: skeleton-landing-page
   Title: SkeletonLandingPage
   Description: A React and Next.js landing page skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, showing navbar, hero, features, and footer.
   Source: original/blocks/skeleton/skeleton-landing-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Navbar *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-6 w-28" />
            <div class="flex items-center gap-4">
                @foreach (var w in _navLinks)
                {
                    <SkeletonCn Class="@($"h-3 {w}")" />
                }
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>

        @* Hero Section *@
        <div class="border-b px-4 py-10 text-center">
            <div class="mx-auto mb-4 flex flex-col items-center gap-2">
                <SkeletonCn Class="h-8 w-3/4" />
                <SkeletonCn Class="h-8 w-1/2" />
            </div>
            <div class="mx-auto mb-6 flex flex-col items-center gap-1.5">
                <SkeletonCn Class="h-3 w-2/3" />
                <SkeletonCn Class="h-3 w-1/2" />
            </div>
            <div class="mb-8 flex justify-center gap-3">
                <SkeletonCn Class="h-7 w-28 rounded-md" />
                <SkeletonCn Class="h-7 w-28 rounded-md" />
            </div>
            <SkeletonCn Class="mx-auto h-40 w-full rounded-md" />
        </div>

        @* Features Section *@
        <div class="border-b px-4 py-8">
            <div class="mb-6 flex flex-col items-center gap-2">
                <SkeletonCn Class="h-4 w-40" />
                <SkeletonCn Class="h-3 w-56" />
            </div>
            <div class="grid gap-6 md:grid-cols-3">
                @foreach (var feat in _features)
                {
                    <div class="space-y-2.5">
                        <SkeletonCn Class="h-10 w-10 rounded-md" />
                        <SkeletonCn Class="@($"h-4 {feat.TitleW}")" />
                        <div class="space-y-1.5">
                            <SkeletonCn Class="@($"h-3 {feat.DescW}")" />
                            <SkeletonCn Class="@($"h-3 {feat.Desc2W}")" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Testimonial Section *@
        <div class="border-b px-4 py-8">
            <div class="mb-6 flex justify-center">
                <SkeletonCn Class="h-4 w-48" />
            </div>
            <div class="rounded-md border p-4">
                <div class="space-y-1.5">
                    <SkeletonCn Class="h-3 w-full" />
                    <SkeletonCn Class="h-3 w-5/6" />
                    <SkeletonCn Class="h-3 w-3/4" />
                </div>
                <div class="mt-4 flex items-center gap-3">
                    <SkeletonCn Class="size-8 rounded-full" />
                    <div class="space-y-1.5">
                        <SkeletonCn Class="h-4 w-28" />
                        <SkeletonCn Class="h-3 w-20" />
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-44" />
                <div class="flex gap-3">
                    <SkeletonCn Class="size-4 rounded" />
                    <SkeletonCn Class="size-4 rounded" />
                    <SkeletonCn Class="size-4 rounded" />
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _navLinks = ["w-14", "w-16", "w-12"];

    private record Feature(string TitleW, string DescW, string Desc2W);

    private static readonly Feature[] _features =
    [
        new("w-3/4", "w-full", "w-5/6"),
        new("w-2/3", "w-full", "w-4/5"),
        new("w-4/5", "w-5/6", "w-full"),
    ];
}
