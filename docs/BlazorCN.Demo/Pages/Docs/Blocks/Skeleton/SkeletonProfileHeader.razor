@* ============================================================
   Block: skeleton-profile-header
   Title: SkeletonProfileHeader
   Description: A React and Next.js skeleton loader for centered profile headers built with shadcn/ui Skeleton and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-profile-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile Content *@
        <div class="flex flex-col items-center border-b px-4 py-6">
            <SkeletonCn Class="size-20 rounded-full" />
            <SkeletonCn Class="mt-4 h-4 w-40" />
            <SkeletonCn Class="mt-2 h-3 w-56" />

            @* Stats *@
            <div class="mt-6 flex items-center gap-8">
                @foreach (var stat in _stats)
                {
                    <div class="flex flex-col items-center gap-1">
                        <SkeletonCn Class="@($"h-4 {stat.NumberWidth}")" />
                        <SkeletonCn Class="@($"h-3 {stat.LabelWidth}")" />
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-3">
                <SkeletonCn Class="h-7 flex-1 rounded-md" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string NumberWidth, string LabelWidth);

    private static readonly StatItem[] _stats =
    [
        new("w-10", "w-14"),
        new("w-12", "w-16"),
        new("w-10", "w-16"),
    ];
}
