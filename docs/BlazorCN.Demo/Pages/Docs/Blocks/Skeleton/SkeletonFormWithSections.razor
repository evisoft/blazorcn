@* ============================================================
   Block: skeleton-form-with-sections
   Title: SkeletonFormWithSections
   Description: A React multi-section form skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for grouped field layouts
   Source: original/blocks/skeleton/skeleton-form-with-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @foreach (var sec in _sections)
        {
            <div class="space-y-4 border-b px-4 py-3">
                <div class="space-y-1.5">
                    <SkeletonCn Class="@($"h-4 {sec.TitleWidth}")" />
                    <SkeletonCn Class="@($"h-3 {sec.DescWidth}")" />
                </div>
                <div class="space-y-4">
                    @foreach (var field in sec.Fields)
                    {
                        <div class="space-y-2">
                            <SkeletonCn Class="@($"h-3 {field.LabelWidth}")" />
                            <SkeletonCn Class="@($"{field.InputHeight} w-full rounded-md")" />
                        </div>
                    }
                </div>
            </div>
        }
        <div class="flex justify-end gap-2 px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
            <SkeletonCn Class="h-7 w-28 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record FieldDef(string LabelWidth, string InputHeight);
    private record SectionDef(string TitleWidth, string DescWidth, FieldDef[] Fields);

    private static readonly SectionDef[] _sections =
    [
        new("w-32", "w-64", [
            new("w-20", "h-9"),
            new("w-28", "h-9"),
            new("w-16", "h-9"),
        ]),
        new("w-24", "w-56", [
            new("w-24", "h-9"),
            new("w-32", "h-9"),
        ]),
        new("w-28", "w-48", [
            new("w-20", "h-20"),
            new("w-24", "h-9"),
        ]),
    ];
}
