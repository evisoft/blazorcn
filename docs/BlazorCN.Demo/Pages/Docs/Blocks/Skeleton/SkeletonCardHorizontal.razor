@* ============================================================
   Block: skeleton-card-horizontal
   Title: SkeletonCardHorizontal
   Description: A React horizontal card skeleton placeholder built with shadcn/ui Skeleton, Next.js, and Tailwind CSS. Features side-by-side image and content areas with title, body text, and badge placeholders.
   Source: original/blocks/skeleton/skeleton-card-horizontal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col sm:flex-row">
            <SkeletonCn Class="h-36 w-full shrink-0 rounded-none sm:h-auto sm:w-36" />
            <div class="flex min-w-0 flex-1 flex-col px-4 py-3">
                <SkeletonCn Class="h-4 w-3/4" />
                <div class="mt-2 space-y-2">
                    @foreach (var w in _bodyWidths)
                    {
                        <SkeletonCn Class="@($"h-3 {w}")" />
                    }
                </div>
                <div class="mt-3">
                    <SkeletonCn Class="h-5 w-16 rounded-full" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _bodyWidths = ["w-full", "w-5/6", "w-2/3"];
}
