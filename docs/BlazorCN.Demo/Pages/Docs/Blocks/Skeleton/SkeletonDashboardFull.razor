@* ============================================================
   Block: skeleton-dashboard-full
   Title: SkeletonDashboardFull
   Description: A React full dashboard skeleton with header, stats, chart, and table sections built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-dashboard-full.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-6">
                    <SkeletonCn Class="h-6 w-20" />
                    <div class="flex gap-4">
                        @foreach (var w in _navWidths)
                        {
                            <SkeletonCn Class="@($"h-3 {w}")" />
                        }
                    </div>
                </div>
                <SkeletonCn Class="size-8 rounded-full" />
            </div>
        </div>

        @* Stats Cards *@
        <div class="grid grid-cols-3 divide-x border-b">
            @foreach (var labelW in _statLabelWidths)
            {
                <div class="flex flex-col gap-2 px-4 py-4">
                    <SkeletonCn Class="@($"h-3 {labelW}")" />
                    <SkeletonCn Class="h-7 w-24" />
                    <div class="flex items-center gap-1.5">
                        <SkeletonCn Class="size-3 rounded-full" />
                        <SkeletonCn Class="h-3 w-16" />
                    </div>
                </div>
            }
        </div>

        @* Chart Area *@
        <div class="border-b px-4 py-3">
            <div class="mb-4 flex items-center justify-between">
                <SkeletonCn Class="h-4 w-32" />
                <SkeletonCn Class="h-7 w-24 rounded-md" />
            </div>
            <SkeletonCn Class="h-48 w-full rounded-md" />
            <div class="mt-3 flex items-center justify-center gap-6">
                @foreach (var w in _legendWidths)
                {
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="size-3 rounded-full" />
                        <SkeletonCn Class="@($"h-3 {w}")" />
                    </div>
                }
            </div>
        </div>

        @* Table *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <SkeletonCn Class="h-4 w-28" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
            <div class="space-y-3">
                @for (var i = 0; i < _rowTitleWidths.Length; i++)
                {
                    var titleW = _rowTitleWidths[i];
                    var subW = _rowSubWidths[i];
                    <div class="flex items-center gap-3">
                        <SkeletonCn Class="size-10 shrink-0 rounded-md" />
                        <div class="flex-1 space-y-2">
                            <SkeletonCn Class="@($"h-4 {titleW}")" />
                            <SkeletonCn Class="@($"h-3 {subW}")" />
                        </div>
                        <SkeletonCn Class="h-7 w-16 rounded-md" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _navWidths = ["w-16", "w-20", "w-14"];
    private static readonly string[] _legendWidths = ["w-14", "w-18", "w-12"];
    private static readonly string[] _rowTitleWidths = ["w-full", "w-11/12", "w-full", "w-10/12", "w-full"];
    private static readonly string[] _rowSubWidths = ["w-2/3", "w-3/4", "w-1/2", "w-2/3", "w-3/5"];
    private static readonly string[] _statLabelWidths = ["w-20", "w-16", "w-24"];
}
