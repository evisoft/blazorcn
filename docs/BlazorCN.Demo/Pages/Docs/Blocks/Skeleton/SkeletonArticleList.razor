@* ============================================================
   Block: skeleton-article-list
   Title: SkeletonArticleList
   Description: A React and Next.js article list skeleton loader with title, description, and author metadata rows built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/skeleton/skeleton-article-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-24" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>

        @* Article rows *@
        @foreach (var row in _rows)
        {
            <div class="border-b px-4 py-3">
                <div class="space-y-2.5">
                    @* Title *@
                    <SkeletonCn Class="@($"h-4 {row.TitleWidth}")" />

                    @* Description *@
                    <div class="space-y-1.5">
                        <SkeletonCn Class="@($"h-3 {row.DescWidth}")" />
                        <SkeletonCn Class="@($"h-3 {row.DescSecondWidth}")" />
                    </div>

                    @* Author + meta *@
                    <div class="flex items-center gap-2 pt-0.5">
                        <SkeletonCn Class="size-6 rounded-full" />
                        <SkeletonCn Class="@($"h-3 {row.NameWidth}")" />
                        <SkeletonCn Class="size-1 rounded-full" />
                        <SkeletonCn Class="@($"h-3 {row.MetaWidth}")" />
                        <SkeletonCn Class="size-1 rounded-full" />
                        <SkeletonCn Class="h-3 w-10" />
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex justify-center px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private record ArticleRow(string TitleWidth, string DescWidth, string DescSecondWidth, string NameWidth, string MetaWidth);

    private static readonly ArticleRow[] _rows =
    [
        new("w-3/4", "w-full",  "w-5/6", "w-20", "w-14"),
        new("w-2/3", "w-5/6",  "w-3/4", "w-16", "w-16"),
        new("w-4/5", "w-full",  "w-2/3", "w-24", "w-12"),
        new("w-1/2", "w-4/5",  "w-5/6", "w-18", "w-14"),
        new("w-3/5", "w-full",  "w-4/5", "w-20", "w-10"),
    ];
}
