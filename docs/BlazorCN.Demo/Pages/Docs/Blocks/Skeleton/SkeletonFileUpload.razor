@* ============================================================
   Block: skeleton-file-upload
   Title: SkeletonFileUpload
   Description: A React file upload skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for loading states in file upload interfaces.
   Source: original/blocks/skeleton/skeleton-file-upload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-32" />
            <SkeletonCn Class="mt-1.5 h-3 w-64" />
        </div>

        @* Drop zone *@
        <div class="border-b px-4 py-3">
            <div class="flex h-40 flex-col items-center justify-center gap-3 rounded-lg border-2 border-dashed">
                <SkeletonCn Class="size-10 rounded-full" />
                <div class="flex flex-col items-center gap-1">
                    <SkeletonCn Class="h-4 w-48" />
                    <SkeletonCn Class="h-3 w-32" />
                </div>
                <SkeletonCn Class="h-7 w-28 rounded-md" />
            </div>
        </div>

        @* Uploaded files section *@
        <div class="px-4 py-3">
            <SkeletonCn Class="mb-3 h-4 w-24" />
            <div class="space-y-3">
                @foreach (var file in _uploadedFiles)
                {
                    <div class="flex items-start gap-3 rounded-lg border p-3">
                        <SkeletonCn Class="size-10 shrink-0 rounded" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <SkeletonCn Class="@($"h-4 {file.Name}")" />
                                    <SkeletonCn Class="@($"mt-1 h-3 {file.Size}")" />
                                </div>
                                <SkeletonCn Class="size-6 shrink-0 rounded-md" />
                            </div>
                            <div class="mt-2">
                                <SkeletonCn Class="@($"h-1.5 rounded-full {file.Progress}")" />
                                <SkeletonCn Class="@($"mt-1 h-3 {file.Percent}")" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record UploadedFile(string Name, string Size, string Progress, string Percent);

    private static readonly UploadedFile[] _uploadedFiles =
    [
        new("w-44", "w-16", "w-full", "w-10"),
        new("w-56", "w-20", "w-2/3", "w-12"),
    ];
}
