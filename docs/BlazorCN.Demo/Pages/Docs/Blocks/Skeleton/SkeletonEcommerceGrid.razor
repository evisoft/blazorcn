@* ============================================================
   Block: skeleton-ecommerce-grid
   Title: SkeletonEcommerceGrid
   Description: A React product grid skeleton loader block built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for ecommerce catalog loading states
   Source: original/blocks/skeleton/skeleton-ecommerce-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with Category and Sort *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-28" />
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-7 w-20 rounded-md" />
                    <SkeletonCn Class="h-7 w-16 rounded-md" />
                </div>
            </div>
        </div>

        @* Product Grid *@
        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-3">
                @foreach (var product in _products)
                {
                    <div class="space-y-2">
                        <SkeletonCn Class="h-36 w-full rounded-md" />
                        <SkeletonCn Class="@($"h-4 {product.TitleW}")" />
                        <SkeletonCn Class="@($"h-3 {product.SubtitleW}")" />
                        <div class="flex items-center justify-between">
                            <SkeletonCn Class="@($"h-4 {product.PriceW}")" />
                            <div class="flex items-center gap-0.5">
                                <SkeletonCn Class="size-2.5 rounded-full" />
                                <SkeletonCn Class="size-2.5 rounded-full" />
                                <SkeletonCn Class="size-2.5 rounded-full" />
                                <SkeletonCn Class="size-2.5 rounded-full" />
                                <SkeletonCn Class="size-2.5 rounded-full" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer Pagination *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-24" />
                <div class="flex items-center gap-1">
                    <SkeletonCn Class="h-7 w-7 rounded-md" />
                    <SkeletonCn Class="h-7 w-7 rounded-md" />
                    <SkeletonCn Class="h-7 w-7 rounded-md" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Product(string TitleW, string SubtitleW, string PriceW);

    private static readonly Product[] _products =
    [
        new("w-full", "w-2/3", "w-14"),
        new("w-3/4", "w-1/2", "w-16"),
        new("w-5/6", "w-3/5", "w-12"),
        new("w-2/3", "w-1/2", "w-14"),
    ];
}
