@* ============================================================
   Block: skeleton-news-feed
   Title: SkeletonNewsFeed
   Description: A React news feed skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for content stream interfaces
   Source: original/blocks/skeleton/skeleton-news-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-24" />
            <SkeletonCn Class="h-3 w-16" />
        </div>

        @* Feed Items *@
        @foreach (var item in _feedItems)
        {
            var feedItem = item;
            <div class="@Cn.Merge("flex gap-3 px-4 py-3", feedItem.HasBorder ? "border-b" : "")">
                <SkeletonCn Class="size-16 shrink-0 rounded" />
                <div class="min-w-0 flex-1 space-y-2">
                    <SkeletonCn Class="@($"h-4 {feedItem.TitleWidth}")" />
                    <SkeletonCn Class="h-3 w-4/5" />
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="@($"h-3 {feedItem.MetaWidth}")" />
                        <SkeletonCn Class="size-1 rounded-full" />
                        <SkeletonCn Class="h-3 w-14" />
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-center">
            <SkeletonCn Class="mx-auto h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private record FeedItem(string TitleWidth, string MetaWidth, bool HasBorder);

    private static readonly FeedItem[] _feedItems =
    [
        new("w-full", "w-24", true),
        new("w-11/12", "w-20", true),
        new("w-full", "w-28", true),
        new("w-10/12", "w-22", true),
        new("w-full", "w-16", false),
    ];
}
