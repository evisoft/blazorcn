@* ============================================================
   Block: skeleton-tabs-vertical
   Title: SkeletonTabsVertical
   Description: A React vertical tabs skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for side-by-side tab navigation states
   Source: original/blocks/skeleton/skeleton-tabs-vertical.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex">
            @* Tab List *@
            <div class="w-48 border-r">
                <div class="space-y-1 p-2">
                    @foreach (var tab in _tabItems)
                    {
                        <SkeletonCn Class="@($"h-8 {tab.Width}")" />
                    }
                </div>
            </div>

            @* Content Panel *@
            <div class="flex-1">
                <div class="space-y-4 px-4 py-3">
                    <SkeletonCn Class="h-4 w-40" />
                    <div class="space-y-2">
                        @foreach (var line in _contentLines)
                        {
                            <SkeletonCn Class="@($"h-3 {line.Width}")" />
                        }
                    </div>
                </div>

                @* Footer Actions *@
                <div class="border-t px-4 py-2.5">
                    <div class="flex gap-2">
                        <SkeletonCn Class="h-7 w-20 rounded-md" />
                        <SkeletonCn Class="h-7 w-20 rounded-md" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TabItem(string Width);

    private static readonly TabItem[] _tabItems =
    [
        new("w-full"),
        new("w-5/6"),
        new("w-full"),
        new("w-4/5"),
        new("w-full"),
    ];

    private static readonly TabItem[] _contentLines =
    [
        new("w-full"),
        new("w-full"),
        new("w-full"),
        new("w-2/3"),
    ];
}
