@* ============================================================
   Block: skeleton-dashboard-header
   Title: SkeletonDashboardHeader
   Description: A React dashboard header skeleton with logo, navigation links, and user controls built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-dashboard-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between px-4 py-3">
            @* Logo *@
            <SkeletonCn Class="h-6 w-24" />

            @* Center Navigation *@
            <div class="flex items-center gap-6">
                @foreach (var item in _navItems)
                {
                    <SkeletonCn Class="@($"h-3 {item.Width}")" />
                }
            </div>

            @* Right Side Controls *@
            <div class="flex items-center gap-3">
                <SkeletonCn Class="size-4" />
                <SkeletonCn Class="size-8 rounded-full" />
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Width);

    private static readonly NavItem[] _navItems =
    [
        new("w-16"),
        new("w-20"),
        new("w-14"),
        new("w-18"),
    ];
}
