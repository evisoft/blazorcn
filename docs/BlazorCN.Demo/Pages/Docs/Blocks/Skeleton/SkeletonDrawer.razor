@* ============================================================
   Block: skeleton-drawer
   Title: SkeletonDrawer
   Description: A React side drawer skeleton with header, content rows, and action buttons built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-drawer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex">
            @* Main content (dimmed) *@
            <div class="flex-1 p-6 opacity-40">
                <div class="space-y-4">
                    <SkeletonCn Class="h-6 w-64" />
                    <SkeletonCn Class="h-3 w-full" />
                    <SkeletonCn Class="h-3 w-full" />
                    <SkeletonCn Class="h-3 w-3/4" />
                    <div class="pt-4">
                        <SkeletonCn Class="h-48 w-full rounded-md" />
                    </div>
                </div>
            </div>

            @* Drawer panel *@
            <div class="w-80 border-l">
                @* Header *@
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <SkeletonCn Class="h-4 w-32" />
                    <SkeletonCn Class="size-5 rounded" />
                </div>

                @* Content rows *@
                <div class="border-b px-4 py-3">
                    <div class="space-y-4">
                        @foreach (var row in _infoRows)
                        {
                            <div class="space-y-1.5">
                                <SkeletonCn Class="@($"h-3 {row.LabelWidth}")" />
                                <SkeletonCn Class="@($"h-4 {row.ValueWidth}")" />
                            </div>
                        }
                    </div>
                </div>

                @* Description section *@
                <div class="border-b px-4 py-3">
                    <div class="space-y-2">
                        @foreach (var w in _descriptionWidths)
                        {
                            <SkeletonCn Class="@($"h-3 {w}")" />
                        }
                    </div>
                </div>

                @* Footer actions *@
                <div class="px-4 py-2.5">
                    <div class="flex gap-2">
                        <SkeletonCn Class="h-7 flex-1 rounded-md" />
                        <SkeletonCn Class="h-7 w-20 rounded-md" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record InfoRow(string LabelWidth, string ValueWidth);

    private static readonly InfoRow[] _infoRows =
    [
        new("w-16", "w-full"),
        new("w-20", "w-full"),
        new("w-24", "w-3/4"),
        new("w-20", "w-2/3"),
    ];

    private static readonly string[] _descriptionWidths = ["w-full", "w-full", "w-4/5"];
}
