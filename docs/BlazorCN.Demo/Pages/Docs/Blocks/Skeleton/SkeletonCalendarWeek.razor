@* ============================================================
   Block: skeleton-calendar-week
   Title: SkeletonCalendarWeek
   Description: A React and Next.js weekly calendar skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring 7 day columns with time-slot event placeholders and navigation controls
   Source: original/blocks/skeleton/skeleton-calendar-week.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with week range and navigation *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="h-4 w-40" />
            </div>
            <div class="flex items-center gap-2">
                <SkeletonCn Class="h-7 w-20 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
            </div>
        </div>

        @* Day headers *@
        <div class="grid grid-cols-7 border-b">
            @foreach (var i in Enumerable.Range(0, 7))
            {
                <div class="flex flex-col items-center gap-1 border-r px-2 py-3 last:border-r-0">
                    <SkeletonCn Class="h-3 w-8" />
                    <SkeletonCn Class="size-6 rounded-full" />
                </div>
            }
        </div>

        @* Calendar grid with events *@
        <div class="grid grid-cols-7 border-b">
            @foreach (var day in _dayEvents)
            {
                <div class="min-h-[400px] border-r p-2 last:border-r-0">
                    <div class="space-y-1.5">
                        @foreach (var height in day)
                        {
                            var px = height * 4;
                            <SkeletonCn Class="w-full rounded-md" Style="@($"height:{px}px")" />
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex justify-center px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private static readonly int[][] _dayEvents =
    [
        [16, 20],
        [12, 24, 16],
        [20],
        [16, 12],
        [24, 16],
        [12],
        [20],
    ];
}
