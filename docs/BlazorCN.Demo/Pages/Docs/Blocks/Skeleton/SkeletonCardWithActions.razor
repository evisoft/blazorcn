@* ============================================================
   Block: skeleton-card-with-actions
   Title: SkeletonCardWithActions
   Description: A React skeleton card with header, body, and action button placeholders built with shadcn/ui Skeleton, Next.js, and Tailwind CSS. Features title, badge, body text, and three footer action buttons.
   Source: original/blocks/skeleton/skeleton-card-with-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-36" />
            <SkeletonCn Class="h-5 w-14 rounded-full" />
        </div>
        <div class="space-y-2 border-b px-4 py-3">
            @foreach (var w in _bodyWidths)
            {
                <SkeletonCn Class="@($"h-3 {w}")" />
            }
        </div>
        <div class="flex items-center gap-2 px-4 py-2.5">
            @foreach (var w in _buttonWidths)
            {
                <SkeletonCn Class="@($"h-7 {w} rounded-md")" />
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] _bodyWidths = ["w-full", "w-full", "w-3/4"];
    private static readonly string[] _buttonWidths = ["w-20", "w-16", "w-20"];
}
