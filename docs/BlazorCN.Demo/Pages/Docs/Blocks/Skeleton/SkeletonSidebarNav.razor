@* ============================================================
   Block: skeleton-sidebar-nav
   Title: SkeletonSidebarNav
   Description: A React vertical sidebar menu skeleton with logo, nav items, and bottom actions built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-sidebar-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Logo *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-28" />
        </div>

        @* Main Navigation Items *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2">
                @foreach (var width in _navWidths)
                {
                    <div class="flex items-center gap-3">
                        <SkeletonCn Class="size-4 shrink-0 rounded" />
                        <SkeletonCn Class="@($"h-3 {width}")" />
                    </div>
                }
            </div>
        </div>

        @* Bottom Items *@
        <div class="px-4 py-2.5">
            <div class="flex flex-col gap-2">
                @foreach (var width in _bottomWidths)
                {
                    <div class="flex items-center gap-3">
                        <SkeletonCn Class="size-4 shrink-0 rounded" />
                        <SkeletonCn Class="@($"h-3 {width}")" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _navWidths = ["w-24", "w-20", "w-28", "w-22", "w-24", "w-16", "w-20", "w-26"];
    private static readonly string[] _bottomWidths = ["w-20", "w-24", "w-16"];
}
