@* ============================================================
   Block: skeleton-form-horizontal
   Title: SkeletonFormHorizontal
   Description: A React horizontal form skeleton with side-by-side labels and inputs built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-form-horizontal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @foreach (var field in _fields)
        {
            <div class="flex items-center gap-4 border-b px-4 py-3">
                <SkeletonCn Class="@($"h-3 shrink-0 {field.LabelWidth}")" />
                <SkeletonCn Class="h-9 w-full rounded-md" />
            </div>
        }
        <div class="flex justify-end gap-2 px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
            <SkeletonCn Class="h-7 w-24 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record FieldItem(string LabelWidth);

    private static readonly FieldItem[] _fields =
    [
        new("w-20"),
        new("w-28"),
        new("w-16"),
        new("w-24"),
        new("w-20"),
    ];
}
