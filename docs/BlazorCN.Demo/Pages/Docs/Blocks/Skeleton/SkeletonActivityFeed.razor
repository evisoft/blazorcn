@* ============================================================
   Block: skeleton-activity-feed
   Title: SkeletonActivityFeed
   Description: A React and Next.js skeleton loader block for vertical timeline activity feeds with avatars, date grouping, status dots, and timestamps built with shadcn/ui Skeleton and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-activity-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <SkeletonCn Class="size-4 rounded" />
                <SkeletonCn Class="h-4 w-24" />
            </div>
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>

        @* Date group: Today *@
        <div class="border-b px-4 py-2">
            <SkeletonCn Class="h-3 w-10" />
        </div>

        @* Today items *@
        <div class="relative">
            <div class="absolute bottom-0 left-[23px] top-0 w-px bg-border"></div>
            @foreach (var item in _group1)
            {
                <div class="@Cn.Merge("relative flex items-start gap-3 px-4 py-3", item.BorderBottom ? "border-b" : "")">
                    <SkeletonCn Class="relative z-10 mt-0.5 size-6 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-1.5">
                        <SkeletonCn Class="@($"h-3 {item.Width}")" />
                        <SkeletonCn Class="@($"h-3 {item.TimestampWidth}")" />
                    </div>
                </div>
            }
        </div>

        @* Date group: Yesterday *@
        <div class="border-b border-t px-4 py-2">
            <SkeletonCn Class="h-3 w-16" />
        </div>

        @* Yesterday items *@
        <div class="relative">
            <div class="absolute bottom-0 left-[23px] top-0 w-px bg-border"></div>
            @foreach (var item in _group2)
            {
                <div class="@Cn.Merge("relative flex items-start gap-3 px-4 py-3", item.BorderBottom ? "border-b" : "")">
                    <SkeletonCn Class="relative z-10 mt-0.5 size-6 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-1.5">
                        <SkeletonCn Class="@($"h-3 {item.Width}")" />
                        <SkeletonCn Class="@($"h-3 {item.TimestampWidth}")" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex justify-center border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private record FeedItem(string Width, string TimestampWidth, bool BorderBottom);

    private static readonly FeedItem[] _group1 =
    [
        new("w-4/5", "w-12", true),
        new("w-3/5", "w-14", true),
        new("w-full", "w-10", false),
    ];

    private static readonly FeedItem[] _group2 =
    [
        new("w-2/3", "w-16", true),
        new("w-4/5", "w-12", false),
    ];
}
