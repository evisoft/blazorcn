@* ============================================================
   Block: skeleton-user-list
   Title: SkeletonUserList
   Description: A React user list skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for member directories
   Source: original/blocks/skeleton/skeleton-user-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-24" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>

        @* User Rows *@
        @foreach (var item in _users)
        {
            var user = item;
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", user.IsLast ? "" : "border-b")">
                <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                <div class="min-w-0 flex-1 space-y-1.5">
                    <SkeletonCn Class="@($"h-4 {user.NameWidth}")" />
                    <SkeletonCn Class="@($"h-3 {user.EmailWidth}")" />
                </div>
                <SkeletonCn Class="@($"h-5 {user.BadgeWidth} rounded-full")" />
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-28" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record UserRow(string NameWidth, string EmailWidth, string BadgeWidth, bool IsLast);

    private static readonly UserRow[] _users =
    [
        new("w-28", "w-40", "w-14", false),
        new("w-24", "w-44", "w-16", false),
        new("w-32", "w-36", "w-12", false),
        new("w-20", "w-48", "w-16", false),
        new("w-28", "w-40", "w-14", true),
    ];
}
