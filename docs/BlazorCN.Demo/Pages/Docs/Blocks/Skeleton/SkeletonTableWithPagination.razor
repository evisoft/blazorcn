@* ============================================================
   Block: skeleton-table-with-pagination
   Title: SkeletonTableWithPagination
   Description: A React table skeleton with pagination footer built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for paginated data tables
   Source: original/blocks/skeleton/skeleton-table-with-pagination.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-32" />
            <SkeletonCn Class="h-4 flex-1" />
            <SkeletonCn Class="h-4 w-28" />
        </div>

        @* Data rows *@
        @foreach (var row in _rows)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-4">
                    <SkeletonCn Class="@($"h-3 {row.Col1}")" />
                    <SkeletonCn Class="h-3 flex-1" />
                    <SkeletonCn Class="@($"h-3 {row.Col2}")" />
                </div>
            </div>
        }

        @* Pagination footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <SkeletonCn Class="h-3 w-32" />
            <div class="flex items-center gap-2">
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record RowData(string Col1, string Col2);

    private static readonly RowData[] _rows =
    [
        new("w-24", "w-24"),
        new("w-28", "w-20"),
        new("w-20", "w-28"),
        new("w-24", "w-24"),
        new("w-28", "w-20"),
    ];
}
