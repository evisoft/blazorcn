@* ============================================================
   Block: skeleton-music-player
   Title: SkeletonMusicPlayer
   Description: A React music player skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for audio streaming interfaces
   Source: original/blocks/skeleton/skeleton-music-player.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Album Art *@
        <div class="flex justify-center border-b px-4 py-3">
            <SkeletonCn Class="size-48 rounded-md" />
        </div>

        @* Track Info *@
        <div class="space-y-2 border-b px-4 py-3 text-center">
            <SkeletonCn Class="mx-auto h-4 w-48" />
            <SkeletonCn Class="mx-auto h-3 w-32" />
        </div>

        @* Progress Bar *@
        <div class="space-y-2 border-b px-4 py-3">
            <SkeletonCn Class="h-1.5 w-full rounded-full" />
            <div class="flex justify-between">
                <SkeletonCn Class="h-3 w-10" />
                <SkeletonCn Class="h-3 w-10" />
            </div>
        </div>

        @* Transport Controls *@
        <div class="flex items-center justify-center gap-4 border-b px-4 py-3">
            <SkeletonCn Class="size-8 rounded-full" />
            <SkeletonCn Class="size-12 rounded-full" />
            <SkeletonCn Class="size-8 rounded-full" />
        </div>

        @* Additional Controls *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <div class="flex gap-2">
                @foreach (var ctrl in _additionalControls)
                {
                    <SkeletonCn Class="@($"size-6 rounded {ctrl.Width}")" />
                }
            </div>
            <div class="flex items-center gap-2">
                @foreach (var ctrl in _volumeControls)
                {
                    <SkeletonCn Class="@(ctrl.Id == "volume-bar" ? $"h-1.5 {ctrl.Width} rounded-full" : "size-6 rounded")" />
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Control(string Id, string Width);

    private static readonly Control[] _additionalControls =
    [
        new("shuffle", "w-6"),
        new("heart", "w-6"),
    ];

    private static readonly Control[] _volumeControls =
    [
        new("volume-icon", "w-6"),
        new("volume-bar", "w-20"),
    ];
}
