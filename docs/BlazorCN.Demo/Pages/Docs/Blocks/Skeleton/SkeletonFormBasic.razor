@* ============================================================
   Block: skeleton-form-basic
   Title: SkeletonFormBasic
   Description: A React stacked form skeleton loader with labels, inputs, and submit button built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-form-basic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @foreach (var field in _fields)
        {
            <div class="space-y-2 border-b px-4 py-3">
                <SkeletonCn Class="@($"h-3 {field.LabelWidth}")" />
                <SkeletonCn Class="@($"{field.InputHeight} w-full rounded-md")" />
                <SkeletonCn Class="@($"h-2.5 {field.DescWidth}")" />
            </div>
        }
        <div class="flex justify-end px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record FieldDef(string LabelWidth, string InputHeight, string DescWidth);

    private static readonly FieldDef[] _fields =
    [
        new("w-20", "h-9", "w-40"),
        new("w-28", "h-9", "w-36"),
        new("w-16", "h-9", "w-44"),
        new("w-24", "h-24", "w-52"),
    ];
}
