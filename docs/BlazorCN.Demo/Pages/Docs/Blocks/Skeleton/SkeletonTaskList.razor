@* ============================================================
   Block: skeleton-task-list
   Title: SkeletonTaskList
   Description: A React task list skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for to-do and checklist loading states
   Source: original/blocks/skeleton/skeleton-task-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-24" />
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-7 w-20 rounded-md" />
                    <SkeletonCn Class="h-7 w-7 rounded-md" />
                </div>
            </div>
        </div>

        @* Task Rows *@
        @foreach (var item in _tasks)
        {
            <div class="@Cn.Merge("px-4 py-3", item.BorderBottom ? "border-b" : "")">
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="size-4 shrink-0 rounded-sm" />
                    <div class="flex min-w-0 flex-1 items-center gap-3">
                        <SkeletonCn Class="@($"h-3 {item.TitleWidth}")" />
                    </div>
                    <SkeletonCn Class="@($"h-5 {item.TagWidth} shrink-0 rounded-full")" />
                    <SkeletonCn Class="size-6 shrink-0 rounded-full" />
                    <SkeletonCn Class="@($"h-3 {item.DateWidth} shrink-0")" />
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-28" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string TitleWidth, string TagWidth, string DateWidth, bool BorderBottom);

    private static readonly TaskItem[] _tasks =
    [
        new("w-2/3", "w-16", "w-20", true),
        new("w-3/4", "w-14", "w-16", true),
        new("w-1/2", "w-12", "w-20", true),
        new("w-full", "w-16", "w-14", true),
        new("w-5/6", "w-14", "w-18", true),
        new("w-3/5", "w-12", "w-16", false),
    ];
}
