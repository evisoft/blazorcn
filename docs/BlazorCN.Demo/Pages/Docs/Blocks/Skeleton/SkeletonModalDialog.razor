@* ============================================================
   Block: skeleton-modal-dialog
   Title: SkeletonModalDialog
   Description: A React modal dialog skeleton with header, form fields, and action buttons built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-modal-dialog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Backdrop Hint *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-center">
                <SkeletonCn Class="h-3 w-48" />
            </div>
        </div>

        @* Dialog Header *@
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div class="flex-1 space-y-2">
                <SkeletonCn Class="h-4 w-44" />
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-3/4" />
            </div>
            <SkeletonCn Class="ml-4 size-5 rounded" />
        </div>

        @* Form Fields *@
        <div class="space-y-4 px-4 py-3">
            @foreach (var field in _fields)
            {
                <div class="space-y-2">
                    <SkeletonCn Class="@($"h-3 {field.LabelWidth}")" />
                    <SkeletonCn Class="@($"{field.Height} w-full rounded-md")" />
                </div>
            }
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-end gap-3 border-t px-4 py-2.5">
            <SkeletonCn Class="h-7 w-16 rounded-md" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record FieldDef(string LabelWidth, string Height);

    private static readonly FieldDef[] _fields =
    [
        new("w-16", "h-9"),
        new("w-20", "h-9"),
        new("w-24", "h-24"),
    ];
}
