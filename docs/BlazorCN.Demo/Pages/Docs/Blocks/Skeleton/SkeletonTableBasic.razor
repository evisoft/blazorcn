@* ============================================================
   Block: skeleton-table-basic
   Title: SkeletonTableBasic
   Description: A React data table skeleton loader with header and rows built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-table-basic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header row *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                @foreach (var width in _headerWidths)
                {
                    <SkeletonCn Class="@($"h-4 {width}")" />
                }
            </div>
        </div>

        @* Data rows *@
        @for (var rowIndex = 0; rowIndex < _rows.Length; rowIndex++)
        {
            var cols = _rows[rowIndex];
            var isLast = rowIndex == _rows.Length - 1;
            <div class="@(isLast ? "px-4 py-3" : "border-b px-4 py-3")">
                <div class="flex items-center gap-4">
                    @foreach (var width in cols)
                    {
                        <SkeletonCn Class="@($"h-3 {width}")" />
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private static readonly string[] _headerWidths = ["w-24", "w-32", "w-28", "w-20"];

    private static readonly string[][] _rows =
    [
        ["w-16", "w-40", "w-24", "w-20"],
        ["w-20", "w-36", "w-28", "w-16"],
        ["w-14", "w-44", "w-20", "w-24"],
        ["w-16", "w-32", "w-32", "w-20"],
        ["w-24", "w-36", "w-24", "w-16"],
    ];
}
