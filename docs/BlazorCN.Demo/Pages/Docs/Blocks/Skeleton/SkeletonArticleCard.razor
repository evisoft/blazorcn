@* ============================================================
   Block: skeleton-article-card
   Title: SkeletonArticleCard
   Description: A React and Next.js article card skeleton loader with hero image, title, author info, body preview, and tags built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/skeleton/skeleton-article-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Hero image *@
        <SkeletonCn Class="h-48 w-full rounded-none" />

        @* Header with title *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-3/4" />
        </div>

        @* Author row *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <SkeletonCn Class="size-8 rounded-full" />
                <div class="flex flex-1 items-center gap-2">
                    <SkeletonCn Class="h-3 w-24" />
                    <SkeletonCn Class="size-1 rounded-full" />
                    <SkeletonCn Class="h-3 w-16" />
                </div>
            </div>
        </div>

        @* Body preview *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-5/6" />
                <SkeletonCn Class="h-3 w-4/5" />
            </div>
        </div>

        @* Tags *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-2">
                @foreach (var w in _tagWidths)
                {
                    <SkeletonCn Class="@($"h-5 {w} rounded-full")" />
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex justify-center px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private static readonly string[] _tagWidths = ["w-16", "w-20", "w-14"];
}
