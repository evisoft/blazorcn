@* ============================================================
   Block: skeleton-command-palette
   Title: SkeletonCommandPalette
   Description: A React and Next.js command palette skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring search input, grouped commands, and keyboard shortcut placeholders.
   Source: original/blocks/skeleton/skeleton-command-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search input *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-9 w-full rounded-md" />
        </div>

        @* Command groups *@
        <div class="px-2 py-2">
            @foreach (var grp in _groups)
            {
                var gi = Array.IndexOf(_groups, grp);
                <div class="@Cn.Merge("", gi < _groups.Length - 1 ? "mb-4" : "")">
                    <div class="mb-2 px-2">
                        <SkeletonCn Class="@($"h-3 {grp.LabelWidth}")" />
                    </div>
                    <div class="space-y-0.5">
                        @foreach (var item in grp.Items)
                        {
                            <div class="flex items-center gap-3 rounded-md px-2 py-2">
                                <SkeletonCn Class="size-4 shrink-0 rounded" />
                                <SkeletonCn Class="@($"h-4 flex-1 {item.TextWidth} max-w-full")" />
                                <SkeletonCn Class="@($"h-5 shrink-0 {item.ShortcutWidth} rounded")" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-3 w-24" />
                <div class="flex items-center gap-2">
                    <SkeletonCn Class="h-5 w-6 rounded" />
                    <SkeletonCn Class="h-3 w-14" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record CommandItem(string TextWidth, string ShortcutWidth);
    private record CommandGroup(string LabelWidth, CommandItem[] Items);

    private static readonly CommandGroup[] _groups =
    [
        new("w-16",
        [
            new("w-40", "w-10"),
            new("w-32", "w-8"),
            new("w-36", "w-12"),
        ]),
        new("w-20",
        [
            new("w-44", "w-10"),
            new("w-28", "w-8"),
            new("w-36", "w-10"),
        ]),
    ];
}
