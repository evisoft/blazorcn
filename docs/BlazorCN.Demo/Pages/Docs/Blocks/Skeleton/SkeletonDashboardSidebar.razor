@* ============================================================
   Block: skeleton-dashboard-sidebar
   Title: SkeletonDashboardSidebar
   Description: A React two-panel dashboard skeleton with sidebar navigation and main content area built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-dashboard-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex">
            @* Sidebar *@
            <div class="w-48 shrink-0 border-r">
                @* Logo *@
                <div class="border-b px-4 py-3">
                    <SkeletonCn Class="h-6 w-24" />
                </div>

                @* Nav Items *@
                <div class="divide-y">
                    @foreach (var w in _sidebarNavWidths)
                    {
                        <div class="flex items-center gap-3 px-4 py-3">
                            <SkeletonCn Class="size-5 shrink-0 rounded-md" />
                            <SkeletonCn Class="@($"h-3 {w}")" />
                        </div>
                    }
                </div>

                @* Bottom Item *@
                <div class="border-t px-4 py-3">
                    <div class="flex items-center gap-3">
                        <SkeletonCn Class="size-5 shrink-0 rounded-md" />
                        <SkeletonCn Class="h-3 w-20" />
                    </div>
                </div>
            </div>

            @* Main Content *@
            <div class="flex-1">
                @* Header *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-center justify-between">
                        <SkeletonCn Class="h-4 w-40" />
                        <div class="flex items-center gap-2">
                            <SkeletonCn Class="h-7 w-20 rounded-md" />
                            <SkeletonCn Class="size-8 rounded-full" />
                        </div>
                    </div>
                </div>

                @* Stats Row *@
                <div class="grid grid-cols-3 divide-x border-b">
                    @for (var i = 0; i < _statLabelWidths.Length; i++)
                    {
                        var labelW = _statLabelWidths[i];
                        var valueW = _statValueWidths[i];
                        <div class="flex flex-col gap-2 px-4 py-4">
                            <SkeletonCn Class="@($"h-3 {labelW}")" />
                            <SkeletonCn Class="@($"h-7 {valueW}")" />
                            <SkeletonCn Class="h-3 w-12" />
                        </div>
                    }
                </div>

                @* Content Area *@
                <div class="space-y-4 p-4">
                    <SkeletonCn Class="h-4 w-32" />
                    <div class="space-y-3">
                        @for (var i = 0; i < _rowTitleWidths.Length; i++)
                        {
                            var titleW = _rowTitleWidths[i];
                            var subW = _rowSubWidths[i];
                            <div class="flex items-center gap-3">
                                <SkeletonCn Class="size-10 shrink-0 rounded-md" />
                                <div class="flex-1 space-y-2">
                                    <SkeletonCn Class="@($"h-4 {titleW}")" />
                                    <SkeletonCn Class="@($"h-3 {subW}")" />
                                </div>
                                <SkeletonCn Class="h-7 w-16 rounded-md" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _sidebarNavWidths = ["w-24", "w-20", "w-28", "w-16", "w-22", "w-20", "w-24"];
    private static readonly string[] _statLabelWidths = ["w-16", "w-20", "w-14"];
    private static readonly string[] _statValueWidths = ["w-20", "w-24", "w-18"];
    private static readonly string[] _rowTitleWidths = ["w-full", "w-11/12", "w-full", "w-10/12"];
    private static readonly string[] _rowSubWidths = ["w-3/4", "w-2/3", "w-4/5", "w-1/2"];
}
