@* ============================================================
   Block: skeleton-chat-conversation
   Title: SkeletonChatConversation
   Description: A React and Next.js skeleton loading placeholder for full chat interfaces, built with shadcn/ui Skeleton and Tailwind CSS with header, messages, and input bar.
   Source: original/blocks/skeleton/skeleton-chat-conversation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Chat header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <SkeletonCn Class="size-10 shrink-0 rounded-full" />
                <div class="min-w-0 flex-1 space-y-1.5">
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="h-4 w-32" />
                        <SkeletonCn Class="size-2 rounded-full" />
                    </div>
                    <SkeletonCn Class="h-3 w-24" />
                </div>
                <SkeletonCn Class="size-8 shrink-0 rounded-md" />
            </div>
        </div>

        @* Message list *@
        <div class="border-b px-4 py-3">
            <div class="space-y-4">

                @* Received: two bubbles *@
                <div class="flex gap-2">
                    <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                    <div class="space-y-2">
                        <SkeletonCn Class="h-10 w-64 rounded-2xl" />
                        <SkeletonCn Class="h-10 w-56 rounded-2xl" />
                    </div>
                </div>

                @* Sent: one bubble *@
                <div class="flex justify-end">
                    <SkeletonCn Class="h-10 w-48 rounded-2xl" />
                </div>

                @* Received: image + short reaction *@
                <div class="flex gap-2">
                    <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                    <div class="space-y-2">
                        <SkeletonCn Class="h-40 w-64 rounded-xl" />
                        <SkeletonCn Class="h-8 w-48 rounded-2xl" />
                    </div>
                </div>

                @* Sent: two bubbles *@
                <div class="flex justify-end">
                    <div class="space-y-2">
                        <SkeletonCn Class="h-10 w-52 rounded-2xl" />
                        <SkeletonCn Class="h-10 w-60 rounded-2xl" />
                    </div>
                </div>

                @* Received: single bubble *@
                <div class="flex gap-2">
                    <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                    <SkeletonCn Class="h-10 w-72 rounded-2xl" />
                </div>

                @* Sent: single bubble *@
                <div class="flex justify-end">
                    <SkeletonCn Class="h-10 w-60 rounded-2xl" />
                </div>

            </div>
        </div>

        @* Input bar *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-2">
                <SkeletonCn Class="size-9 shrink-0 rounded-md" />
                <SkeletonCn Class="h-9 flex-1 rounded-full" />
                <SkeletonCn Class="size-9 shrink-0 rounded-full" />
            </div>
        </div>

    </div>
</section>
