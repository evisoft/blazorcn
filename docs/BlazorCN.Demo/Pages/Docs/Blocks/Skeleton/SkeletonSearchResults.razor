@* ============================================================
   Block: skeleton-search-results
   Title: SkeletonSearchResults
   Description: A React and Next.js search results skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for content discovery pages.
   Source: original/blocks/skeleton/skeleton-search-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-10 w-full rounded-md" />
        </div>

        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-3 w-36" />
        </div>

        <div class="divide-y">
            @foreach (var result in _results)
            {
                <div class="space-y-2 px-4 py-3">
                    <SkeletonCn Class="@($"h-4 {result.TitleWidth}")" />
                    <SkeletonCn Class="@($"h-3 {result.UrlWidth}")" />
                    <div class="space-y-1.5">
                        <SkeletonCn Class="h-3 w-full" />
                        <SkeletonCn Class="@($"h-3 {result.DescWidth}")" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SearchResult(string TitleWidth, string UrlWidth, string DescWidth);

    private static readonly SearchResult[] _results =
    [
        new("w-2/3", "w-1/3", "w-5/6"),
        new("w-3/5", "w-2/5", "w-4/5"),
        new("w-1/2", "w-1/4", "w-11/12"),
        new("w-3/4", "w-1/3", "w-3/4"),
        new("w-7/12", "w-1/4", "w-5/6"),
    ];
}
