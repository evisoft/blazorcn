@* ============================================================
   Block: skeleton-app-shell
   Title: SkeletonAppShell
   Description: A React and Next.js app shell skeleton loader with navbar, sidebar navigation, breadcrumbs, and two-column content layout built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/skeleton/skeleton-app-shell.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Top navbar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="size-8 rounded-md" />
                    <SkeletonCn Class="h-4 w-28" />
                </div>
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="h-7 w-48 rounded-md" />
                    <SkeletonCn Class="size-8 rounded-full" />
                </div>
            </div>
        </div>

        <div class="flex">
            @* Left sidebar *@
            <div class="w-14 border-r bg-muted/50 py-3">
                <div class="space-y-3">
                    @foreach (var i in Enumerable.Range(0, 6))
                    {
                        <div class="flex justify-center">
                            <SkeletonCn Class="size-8 rounded-md" />
                        </div>
                    }
                </div>
            </div>

            @* Main content area *@
            <div class="min-w-0 flex-1">
                @* Breadcrumbs + page title *@
                <div class="border-b px-4 py-3">
                    <div class="mb-2 flex items-center gap-2">
                        @foreach (var item in _breadcrumbItems)
                        {
                            <div class="flex items-center gap-2">
                                @if (item.ShowSeparator)
                                {
                                    <SkeletonCn Class="h-3 w-2" />
                                }
                                <SkeletonCn Class="@($"h-3 {item.Width}")" />
                            </div>
                        }
                    </div>
                    <SkeletonCn Class="h-5 w-40" />
                </div>

                @* Two-column layout *@
                <div class="flex">
                    @* Main content column *@
                    <div class="min-w-0 flex-1 border-r">
                        @* Content section 1 *@
                        <div class="border-b px-4 py-3">
                            <div class="mb-3 flex items-center justify-between">
                                <SkeletonCn Class="h-4 w-28" />
                                <SkeletonCn Class="h-7 w-20 rounded-md" />
                            </div>
                            <div class="space-y-3">
                                @foreach (var w in _contentLineWidths)
                                {
                                    <div class="space-y-2">
                                        <SkeletonCn Class="@($"h-3 {w}")" />
                                        <SkeletonCn Class="h-3 w-2/3" />
                                    </div>
                                }
                            </div>
                        </div>

                        @* Content section 2 - item list *@
                        <div class="px-4 py-3">
                            <SkeletonCn Class="mb-3 h-4 w-32" />
                            <div class="space-y-2">
                                @foreach (var i in Enumerable.Range(0, 4))
                                {
                                    <div class="flex items-center gap-3 rounded-md border p-3">
                                        <SkeletonCn Class="size-8 rounded-md" />
                                        <div class="min-w-0 flex-1 space-y-1.5">
                                            <SkeletonCn Class="h-3 w-3/4" />
                                            <SkeletonCn Class="h-3 w-1/2" />
                                        </div>
                                        <SkeletonCn Class="size-7 rounded-md" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Aside panel *@
                    <div class="hidden w-64 shrink-0 lg:block">
                        @* Info card *@
                        <div class="border-b px-4 py-3">
                            <SkeletonCn Class="mb-3 h-4 w-20" />
                            <div class="space-y-2.5">
                                @foreach (var entry in _asideEntries)
                                {
                                    <div class="flex items-center justify-between">
                                        <SkeletonCn Class="@($"h-3 {entry.LabelWidth}")" />
                                        <SkeletonCn Class="@($"h-3 {entry.ValueWidth}")" />
                                    </div>
                                }
                            </div>
                        </div>

                        @* Activity feed *@
                        <div class="px-4 py-3">
                            <SkeletonCn Class="mb-3 h-4 w-24" />
                            <div class="space-y-3">
                                @foreach (var i in Enumerable.Range(0, 3))
                                {
                                    <div class="flex gap-2">
                                        <SkeletonCn Class="size-6 shrink-0 rounded-full" />
                                        <div class="min-w-0 flex-1 space-y-1.5">
                                            <SkeletonCn Class="h-3 w-full" />
                                            <SkeletonCn Class="h-3 w-2/3" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex justify-center border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private record BreadcrumbItem(string Width, bool ShowSeparator);
    private record AsideEntry(string LabelWidth, string ValueWidth);

    private static readonly BreadcrumbItem[] _breadcrumbItems =
    [
        new("w-16", false),
        new("w-20", true),
        new("w-24", true),
    ];

    private static readonly string[] _contentLineWidths = ["w-full", "w-5/6", "w-4/5"];

    private static readonly AsideEntry[] _asideEntries =
    [
        new("w-20", "w-14"),
        new("w-16", "w-12"),
        new("w-24", "w-16"),
        new("w-18", "w-10"),
    ];
}
