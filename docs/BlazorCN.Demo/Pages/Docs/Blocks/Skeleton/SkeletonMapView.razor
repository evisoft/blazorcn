@* ============================================================
   Block: skeleton-map-view
   Title: SkeletonMapView
   Description: A React map view skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for map-based interfaces
   Source: original/blocks/skeleton/skeleton-map-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Map Area with Search Overlay *@
        <div class="relative border-b">
            <div class="h-72 bg-muted/30">
                <div class="grid h-full grid-cols-4 grid-rows-4">
                    @foreach (var i in _tiles)
                    {
                        <div class="border border-border/30"></div>
                    }
                </div>
            </div>
            <div class="absolute left-4 right-4 top-4">
                <div class="rounded-lg border bg-card p-2 shadow-lg">
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="size-5 shrink-0" />
                        <SkeletonCn Class="h-4 flex-1" />
                        <SkeletonCn Class="size-8 rounded" />
                    </div>
                </div>
            </div>
        </div>

        @* Location Cards *@
        <div class="divide-y">
            @foreach (var loc in _locations)
            {
                <div class="flex gap-3 px-4 py-3">
                    <SkeletonCn Class="size-20 shrink-0 rounded" />
                    <div class="min-w-0 flex-1 space-y-2">
                        <SkeletonCn Class="@($"h-4 {loc.TitleWidth}")" />
                        <SkeletonCn Class="@($"h-3 {loc.AddressWidth}")" />
                        <SkeletonCn Class="@($"h-3 {loc.DetailWidth}")" />
                        <div class="flex items-center gap-1">
                            <SkeletonCn Class="h-3 w-12" />
                            <SkeletonCn Class="@($"h-3 {loc.RatingWidth}")" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Location(string TitleWidth, string AddressWidth, string DetailWidth, string RatingWidth);

    private static readonly Location[] _locations =
    [
        new("w-2/3", "w-full", "w-4/5", "w-16"),
        new("w-3/4", "w-full", "w-3/4", "w-20"),
        new("w-1/2", "w-full", "w-5/6", "w-24"),
    ];

    private static readonly int[] _tiles = new int[16];
}
