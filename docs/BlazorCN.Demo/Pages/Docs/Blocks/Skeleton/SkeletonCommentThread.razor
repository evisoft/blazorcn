@* ============================================================
   Block: skeleton-comment-thread
   Title: SkeletonCommentThread
   Description: A React and Next.js comment thread skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring avatars, author names, timestamps, and nested reply indentation.
   Source: original/blocks/skeleton/skeleton-comment-thread.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-28" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>

        @* Comments *@
        @foreach (var comment in _comments)
        {
            var isLast = comment == _comments[_comments.Length - 1];
            <div class="@(isLast ? "px-4 py-3" : "border-b px-4 py-3")">
                <div class="@($"flex gap-3{(comment.Indent ? " ml-8" : "")}")">
                    <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                    <div class="min-w-0 flex-1 space-y-2">
                        <div class="flex items-center gap-2">
                            <SkeletonCn Class="@($"h-3 {comment.NameWidth}")" />
                            <SkeletonCn Class="@($"h-3 {comment.TimeWidth}")" />
                        </div>
                        @foreach (var w in comment.BodyWidths)
                        {
                            <SkeletonCn Class="@($"h-3 {w}")" />
                        }
                        <div class="flex items-center gap-2 pt-1">
                            @foreach (var aw in comment.Actions)
                            {
                                <SkeletonCn Class="@($"h-6 {aw} rounded-md")" />
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record CommentSkeleton(bool Indent, string NameWidth, string TimeWidth, string[] BodyWidths, string[] Actions);

    private static readonly CommentSkeleton[] _comments =
    [
        new(false, "w-24", "w-16", ["w-full", "w-5/6"],           ["w-12", "w-10", "w-14"]),
        new(true,  "w-20", "w-14", ["w-full", "w-3/4"],           ["w-12", "w-10"]),
        new(true,  "w-22", "w-12", ["w-full", "w-4/5"],           ["w-12", "w-10"]),
        new(false, "w-28", "w-12", ["w-full", "w-11/12", "w-2/3"],["w-12", "w-10", "w-14"]),
    ];
}
