@* ============================================================
   Block: skeleton-card-grid
   Title: SkeletonCardGrid
   Description: A React responsive card grid skeleton built with shadcn/ui Skeleton, Next.js, and Tailwind CSS. Features six card placeholders in a responsive two-column grid with image, title, and text areas.
   Source: original/blocks/skeleton/skeleton-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2">
            @foreach (var item in _items)
            {
                <div class="space-y-3 bg-card p-4">
                    <SkeletonCn Class="h-24 w-full rounded-md" />
                    <div class="space-y-2">
                        <SkeletonCn Class="@($"h-4 {item.TitleW}")" />
                        <SkeletonCn Class="@($"h-3 {item.BodyW}")" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CardItem(int Id, string TitleW, string BodyW);

    private static readonly string[] _titleWidths = ["w-3/4", "w-2/3", "w-4/5", "w-1/2", "w-3/5", "w-2/3"];
    private static readonly string[] _bodyWidths  = ["w-full", "w-5/6", "w-full", "w-4/5", "w-full", "w-5/6"];

    private static readonly CardItem[] _items =
    [
        new(0, _titleWidths[0], _bodyWidths[0]),
        new(1, _titleWidths[1], _bodyWidths[1]),
        new(2, _titleWidths[2], _bodyWidths[2]),
        new(3, _titleWidths[3], _bodyWidths[3]),
        new(4, _titleWidths[4], _bodyWidths[4]),
        new(5, _titleWidths[5], _bodyWidths[5]),
    ];
}
