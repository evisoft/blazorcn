@* ============================================================
   Block: skeleton-breadcrumb
   Title: SkeletonBreadcrumb
   Description: A React and Next.js breadcrumb navigation skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring linked items, separators, and a header with action button
   Source: original/blocks/skeleton/skeleton-breadcrumb.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-28" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>

        @* Breadcrumb Trail *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                @for (var i = 0; i < _crumbs.Length; i++)
                {
                    var crumb = _crumbs[i];
                    <div class="flex items-center gap-2">
                        @if (i > 0)
                        {
                            <SkeletonCn Class="size-3 rounded-full" />
                        }
                        <SkeletonCn Class="@($"h-3 {crumb.Width}")" />
                    </div>
                }
            </div>
        </div>

        @* Page Title Placeholder *@
        <div class="space-y-2 border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-2/3" />
            <SkeletonCn Class="h-3 w-1/2" />
        </div>

        @* Content Lines *@
        <div class="space-y-2 border-b px-4 py-3">
            <SkeletonCn Class="h-3 w-full" />
            <SkeletonCn Class="h-3 w-4/5" />
            <SkeletonCn Class="h-3 w-3/4" />
        </div>

        @* Footer *@
        <div class="flex justify-center border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-20" />
        </div>
    </div>
</section>

@code {
    private record Crumb(string Width);

    private static readonly Crumb[] _crumbs =
    [
        new("w-12"),
        new("w-20"),
        new("w-16"),
        new("w-24"),
    ];
}
