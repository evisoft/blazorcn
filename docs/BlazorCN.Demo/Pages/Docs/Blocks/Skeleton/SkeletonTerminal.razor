@* ============================================================
   Block: skeleton-terminal
   Title: SkeletonTerminal
   Description: A React terminal CLI skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for command-line interface loading states
   Source: original/blocks/skeleton/skeleton-terminal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Title Bar *@
        <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-3">
            <div class="flex gap-1.5">
                <span class="size-3 rounded-full bg-red-500/20"></span>
                <span class="size-3 rounded-full bg-amber-500/20"></span>
                <span class="size-3 rounded-full bg-emerald-500/20"></span>
            </div>
            <SkeletonCn Class="h-3 w-32" />
        </div>

        @* Terminal Output Area *@
        <div class="bg-zinc-950 p-4">
            <div class="space-y-2">
                @foreach (var line in _outputLines)
                {
                    var showGap = line.ShowGap;
                    <div class="@(showGap ? "pt-2" : "")">
                        <SkeletonCn Class="@($"h-3 {line.Width} bg-zinc-800")" />
                    </div>
                }
            </div>

            @* Cursor Line *@
            <div class="mt-4 flex items-center gap-2">
                <SkeletonCn Class="h-3 w-16 bg-zinc-800" />
                <SkeletonCn Class="h-4 w-2 bg-zinc-600" />
            </div>
        </div>
    </div>
</section>

@code {
    private record OutputLine(string Width, bool ShowGap);

    private static readonly OutputLine[] _outputLines =
    [
        new("w-48",   false),
        new("w-full", false),
        new("w-2/3",  false),
        new("w-56",   true),
        new("w-full", false),
        new("w-4/5",  false),
        new("w-3/5",  false),
        new("w-40",   true),
    ];
}
