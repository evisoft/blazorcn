@* ============================================================
   Block: skeleton-gallery-masonry
   Title: SkeletonGalleryMasonry
   Description: A React masonry gallery skeleton built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for Pinterest-style layouts
   Source: original/blocks/skeleton/skeleton-gallery-masonry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-40" />
            <div class="flex gap-2">
                <SkeletonCn Class="h-7 w-16 rounded-md" />
                <SkeletonCn Class="h-7 w-16 rounded-md" />
            </div>
        </div>
        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-3">
                    @foreach (var item in _leftColumn)
                    {
                        <SkeletonCn Class="@($"{item.Height} w-full rounded-md")" />
                    }
                </div>
                <div class="space-y-3">
                    @foreach (var item in _rightColumn)
                    {
                        <SkeletonCn Class="@($"{item.Height} w-full rounded-md")" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Height);

    private static readonly GalleryItem[] _leftColumn =
    [
        new("left-1", "h-32"),
        new("left-2", "h-48"),
        new("left-3", "h-40"),
    ];

    private static readonly GalleryItem[] _rightColumn =
    [
        new("right-1", "h-56"),
        new("right-2", "h-36"),
        new("right-3", "h-44"),
    ];
}
