@* ============================================================
   Block: skeleton-social-post
   Title: SkeletonSocialPost
   Description: A React skeleton loader for social media posts with avatar, content, image, and actions built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-social-post.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <SkeletonCn Class="size-10 shrink-0 rounded-full" />
                <div class="min-w-0 flex-1 space-y-1.5">
                    <SkeletonCn Class="h-4 w-32" />
                    <SkeletonCn Class="h-3 w-20" />
                </div>
                <SkeletonCn Class="h-7 w-7 shrink-0 rounded-md" />
            </div>
        </div>

        @* Content *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <SkeletonCn Class="h-3 w-full" />
                <SkeletonCn Class="h-3 w-5/6" />
                <SkeletonCn Class="h-3 w-3/4" />
            </div>
        </div>

        @* Image *@
        <div class="border-b">
            <SkeletonCn Class="h-56 w-full rounded-none" />
        </div>

        @* Footer Actions *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-2">
                @foreach (var width in _actionWidths)
                {
                    <SkeletonCn Class="@($"h-7 {width} rounded-md")" />
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _actionWidths = ["w-16", "w-18", "w-14"];
}
