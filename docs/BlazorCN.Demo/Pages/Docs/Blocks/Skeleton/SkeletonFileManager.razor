@* ============================================================
   Block: skeleton-file-manager
   Title: SkeletonFileManager
   Description: A React file manager skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for loading states in file browser interfaces.
   Source: original/blocks/skeleton/skeleton-file-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Toolbar with breadcrumb and actions *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <SkeletonCn Class="h-4 w-12" />
                <SkeletonCn Class="h-3 w-1.5" />
                <SkeletonCn Class="h-4 w-20" />
                <SkeletonCn Class="h-3 w-1.5" />
                <SkeletonCn Class="h-4 w-24" />
            </div>
            <div class="flex items-center gap-2">
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="size-7 rounded-md" />
                <SkeletonCn Class="h-7 w-20 rounded-md" />
            </div>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-4 border-b bg-muted/50 px-4 py-2.5">
            <div class="flex min-w-0 flex-1 items-center gap-3">
                <SkeletonCn Class="size-4 shrink-0" />
                <SkeletonCn Class="h-3 w-10" />
            </div>
            <SkeletonCn Class="h-3 w-8 shrink-0" />
            <SkeletonCn Class="h-3 w-16 shrink-0" />
            <div class="w-7 shrink-0"></div>
        </div>

        @* File list *@
        <div>
            @foreach (var (row, i) in _fileRows.Select((r, idx) => (r, idx)))
            {
                <div class="@Cn.Merge("flex items-center gap-4 px-4 py-3", i < _fileRows.Length - 1 ? "border-b" : "")">
                    <div class="flex min-w-0 flex-1 items-center gap-3">
                        <SkeletonCn Class="size-4 shrink-0" />
                        <SkeletonCn Class="@($"h-4 {row.Name}")" />
                    </div>
                    <SkeletonCn Class="@($"h-3 shrink-0 {row.Size}")" />
                    <SkeletonCn Class="@($"h-3 shrink-0 {row.Date}")" />
                    <SkeletonCn Class="size-7 shrink-0 rounded-md" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FileRow(string Name, string Size, string Date);

    private static readonly FileRow[] _fileRows =
    [
        new("w-44", "w-14", "w-24"),
        new("w-56", "w-10", "w-20"),
        new("w-36", "w-12", "w-24"),
        new("w-48", "w-16", "w-20"),
        new("w-40", "w-10", "w-24"),
        new("w-52", "w-14", "w-20"),
    ];
}
