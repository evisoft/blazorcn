@* ============================================================
   Block: skeleton-chat-message
   Title: SkeletonChatMessage
   Description: A React and Next.js skeleton loading placeholder for chat message bubbles, built with shadcn/ui Skeleton and Tailwind CSS with alternating sent and received messages.
   Source: original/blocks/skeleton/skeleton-chat-message.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="space-y-4">
                @* Received message 1 — two bubbles *@
                <div class="flex gap-2">
                    <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                    <div class="space-y-2">
                        @foreach (var w in _received0)
                        {
                            <SkeletonCn Class="@($"h-10 {w} rounded-2xl")" />
                        }
                    </div>
                </div>

                @* Sent message 1 *@
                <div class="flex justify-end">
                    @foreach (var w in _sent0)
                    {
                        <SkeletonCn Class="@($"h-10 {w} rounded-2xl")" />
                    }
                </div>

                @* Received message 2 *@
                <div class="flex gap-2">
                    <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                    @foreach (var w in _received1)
                    {
                        <SkeletonCn Class="@($"h-10 {w} rounded-2xl")" />
                    }
                </div>

                @* Sent message 2 — two bubbles *@
                <div class="flex justify-end">
                    <div class="space-y-2">
                        @foreach (var w in _sent1)
                        {
                            <SkeletonCn Class="@($"h-10 {w} rounded-2xl")" />
                        }
                    </div>
                </div>

                @* Received message 3 *@
                <div class="flex gap-2">
                    <SkeletonCn Class="size-8 shrink-0 rounded-full" />
                    @foreach (var w in _received2)
                    {
                        <SkeletonCn Class="@($"h-10 {w} rounded-2xl")" />
                    }
                </div>
            </div>
        </div>

        <div class="px-4 py-2.5">
            <div class="flex items-center gap-2">
                <SkeletonCn Class="h-9 flex-1 rounded-full" />
                <SkeletonCn Class="size-9 rounded-full" />
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _received0 = ["w-64", "w-48"];
    private static readonly string[] _received1 = ["w-72"];
    private static readonly string[] _received2 = ["w-52"];

    private static readonly string[] _sent0 = ["w-56"];
    private static readonly string[] _sent1 = ["w-44", "w-60"];
}
