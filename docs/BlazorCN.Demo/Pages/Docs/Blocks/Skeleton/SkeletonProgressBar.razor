@* ============================================================
   Block: skeleton-progress-bar
   Title: SkeletonProgressBar
   Description: A React and Next.js progress bar skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for tracking dashboards.
   Source: original/blocks/skeleton/skeleton-progress-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-40" />
                <SkeletonCn Class="h-4 w-12" />
            </div>
        </div>

        <div class="space-y-5 border-b px-4 py-3">
            @foreach (var bar in _progressBars)
            {
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <SkeletonCn Class="@($"h-3 {bar.LabelWidth}")" />
                        <SkeletonCn Class="h-3 w-10" />
                    </div>
                    <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
                        <SkeletonCn Class="@($"h-full {bar.BarWidth}")" />
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <SkeletonCn Class="mb-3 h-3 w-20" />
            <div class="relative">
                <div class="absolute left-0 top-2 h-0.5 w-full bg-muted"></div>
                <div class="relative flex justify-between">
                    @foreach (var ms in _milestones)
                    {
                        var milestone = ms;
                        <div class="flex flex-col items-center gap-2">
                            <SkeletonCn Class="size-4 rounded-full" />
                            <SkeletonCn Class="@($"h-3 {milestone}")" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ProgressBar(string LabelWidth, string BarWidth);

    private static readonly ProgressBar[] _progressBars =
    [
        new("w-32", "w-3/4"),
        new("w-24", "w-[45%]"),
        new("w-36", "w-[90%]"),
    ];

    private static readonly string[] _milestones = ["w-14", "w-16", "w-12", "w-18", "w-14"];
}
