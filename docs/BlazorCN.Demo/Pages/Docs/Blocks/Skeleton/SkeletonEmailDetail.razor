@* ============================================================
   Block: skeleton-email-detail
   Title: SkeletonEmailDetail
   Description: A React email detail skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for loading states in webmail reading panes.
   Source: original/blocks/skeleton/skeleton-email-detail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Sender Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <SkeletonCn Class="size-10 shrink-0 rounded-full" />
                <div class="min-w-0 flex-1 space-y-1.5">
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="h-4 w-32" />
                        <SkeletonCn Class="h-3 w-44" />
                    </div>
                    <div class="flex items-center gap-2">
                        <SkeletonCn Class="h-3 w-6" />
                        <SkeletonCn Class="h-3 w-40" />
                    </div>
                </div>
                <SkeletonCn Class="h-3 w-20 shrink-0" />
            </div>
        </div>

        @* Subject Line *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-3/4" />
        </div>

        @* Email Body *@
        <div class="space-y-4 border-b px-4 py-3">
            @foreach (var para in _bodyParagraphs)
            {
                <div class="space-y-2">
                    @foreach (var width in para.Lines)
                    {
                        <SkeletonCn Class="@($"h-3 {width}")" />
                    }
                </div>
            }
        </div>

        @* Action Bar *@
        <div class="flex items-center gap-2 px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
            <SkeletonCn Class="h-7 w-24 rounded-md" />
            <SkeletonCn Class="h-7 w-20 rounded-md" />
            <div class="flex-1"></div>
            <SkeletonCn Class="size-7 rounded-md" />
            <SkeletonCn Class="size-7 rounded-md" />
            <SkeletonCn Class="size-7 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record BodyParagraph(string[] Lines);

    private static readonly BodyParagraph[] _bodyParagraphs =
    [
        new(["w-full", "w-full", "w-4/5"]),
        new(["w-full", "w-full", "w-full", "w-3/4"]),
        new(["w-full", "w-5/6"]),
        new(["w-2/3", "w-1/2"]),
    ];
}
