@* ============================================================
   Block: skeleton-table-compact
   Title: SkeletonTableCompact
   Description: A React compact table skeleton loader built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for dense data-heavy loading states
   Source: original/blocks/skeleton/skeleton-table-compact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header row *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <SkeletonCn Class="h-2.5 w-12" />
            <SkeletonCn Class="h-2.5 w-32" />
            <SkeletonCn Class="h-2.5 w-24" />
            <SkeletonCn Class="h-2.5 w-20" />
            <SkeletonCn Class="h-2.5 w-16" />
        </div>

        @* Compact data rows *@
        @foreach (var row in _rows)
        {
            var idx = Array.IndexOf(_rows, row);
            <div class="@Cn.Merge("px-4 py-2", idx < _rows.Length - 1 ? "border-b" : "")">
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="@($"h-2.5 {row.Id}")" />
                    <SkeletonCn Class="@($"h-2.5 {row.Name}")" />
                    <SkeletonCn Class="@($"h-2.5 {row.Col3}")" />
                    <SkeletonCn Class="@($"h-2.5 {row.Col4}")" />
                    <SkeletonCn Class="@($"h-2.5 {row.Col5}")" />
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record RowData(string Id, string Name, string Col3, string Col4, string Col5);

    private static readonly RowData[] _rows =
    [
        new("w-10", "w-36", "w-20", "w-24", "w-14"),
        new("w-12", "w-32", "w-24", "w-20", "w-16"),
        new("w-10", "w-40", "w-20", "w-24", "w-14"),
        new("w-12", "w-28", "w-24", "w-20", "w-16"),
        new("w-10", "w-36", "w-20", "w-24", "w-14"),
        new("w-12", "w-32", "w-24", "w-20", "w-16"),
        new("w-10", "w-38", "w-20", "w-24", "w-14"),
        new("w-12", "w-34", "w-24", "w-20", "w-16"),
    ];
}
