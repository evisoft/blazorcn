@* ============================================================
   Block: skeleton-comparison-table
   Title: SkeletonComparisonTable
   Description: A React and Next.js comparison table skeleton loader built with shadcn/ui Skeleton and Tailwind CSS, featuring plan columns, pricing rows, feature checkmarks, and CTA buttons.
   Source: original/blocks/skeleton/skeleton-comparison-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with plan names *@
        <div class="grid grid-cols-4 gap-4 border-b bg-muted/50 px-4 py-3">
            <div>
                <SkeletonCn Class="h-4 w-20" />
            </div>
            @foreach (var plan in _planCols)
            {
                <div class="space-y-2 text-center">
                    <SkeletonCn Class="@($"mx-auto h-4 {plan.PlanWidth}")" />
                    <SkeletonCn Class="@($"mx-auto h-6 {plan.PriceWidth}")" />
                    <SkeletonCn Class="@($"mx-auto h-3 {plan.BillingWidth}")" />
                </div>
            }
        </div>

        @* Feature rows *@
        <div>
            @foreach (var row in _featureRows)
            {
                var rowIdx = Array.IndexOf(_featureRows, row);
                <div class="@Cn.Merge("grid grid-cols-4 gap-4 border-b px-4 py-3", rowIdx % 2 == 0 ? "bg-muted/20" : "")">
                    <div class="flex items-center">
                        <SkeletonCn Class="@($"h-3 {row.LabelWidth}")" />
                    </div>
                    @foreach (var j in _colIndices)
                    {
                        <div class="flex items-center justify-center">
                            @if (row.Type == "check")
                            {
                                <SkeletonCn Class="size-4 rounded-full" />
                            }
                            else
                            {
                                <SkeletonCn Class="h-3 w-16" />
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* CTA buttons footer *@
        <div class="grid grid-cols-4 gap-4 px-4 py-2.5">
            <div></div>
            @foreach (var j in _colIndices)
            {
                <div class="flex justify-center">
                    <SkeletonCn Class="h-7 w-full max-w-28 rounded-md" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PlanCol(string PlanWidth, string PriceWidth, string BillingWidth);
    private record FeatureRow(string LabelWidth, string Type);

    private static readonly PlanCol[] _planCols =
    [
        new("w-20", "w-14", "w-18"),
        new("w-24", "w-16", "w-20"),
        new("w-28", "w-14", "w-18"),
    ];

    private static readonly FeatureRow[] _featureRows =
    [
        new("w-32", "check"),
        new("w-28", "text"),
        new("w-36", "check"),
        new("w-24", "text"),
        new("w-32", "check"),
        new("w-30", "text"),
        new("w-28", "check"),
        new("w-36", "text"),
    ];

    private static readonly int[] _colIndices = [0, 1, 2];
}
