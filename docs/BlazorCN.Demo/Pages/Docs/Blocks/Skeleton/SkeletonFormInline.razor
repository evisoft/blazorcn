@* ============================================================
   Block: skeleton-form-inline
   Title: SkeletonFormInline
   Description: A React compact single-row inline form skeleton built with Next.js, shadcn/ui Skeleton, and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-form-inline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                @foreach (var width in _inputWidths)
                {
                    <SkeletonCn Class="@($"h-9 w-full rounded-md {width}")" />
                }
                <SkeletonCn Class="h-7 w-full rounded-md sm:w-24" />
            </div>
        </div>
        <div class="space-y-3 px-4 py-3">
            @foreach (var width in _resultWidths)
            {
                <SkeletonCn Class="@($"h-3 {width}")" />
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] _inputWidths = ["sm:w-48", "sm:w-40", "sm:w-36"];
    private static readonly string[] _resultWidths = ["w-full", "w-full", "w-3/4"];
}
