@* ============================================================
   Block: skeleton-podcast-player
   Title: SkeletonPodcastPlayer
   Description: A React and Next.js podcast player skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for audio episode interfaces
   Source: original/blocks/skeleton/skeleton-podcast-player.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Episode info *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-4">
                <SkeletonCn Class="size-20 shrink-0 rounded-md" />
                <div class="min-w-0 flex-1 space-y-2">
                    <SkeletonCn Class="h-4 w-3/4" />
                    <SkeletonCn Class="h-3 w-1/2" />
                    <SkeletonCn Class="h-3 w-full" />
                    <SkeletonCn Class="h-3 w-4/5" />
                </div>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-1.5 w-full rounded-full" />
            <div class="mt-1.5 flex items-center justify-between">
                <SkeletonCn Class="h-3 w-10" />
                <SkeletonCn Class="h-3 w-10" />
            </div>
        </div>

        @* Playback controls *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-7 w-14 rounded-md" />
                <div class="flex items-center gap-3">
                    <SkeletonCn Class="size-7 rounded-full" />
                    <SkeletonCn Class="size-9 rounded-full" />
                    <SkeletonCn Class="size-7 rounded-full" />
                </div>
                <SkeletonCn Class="h-7 w-12 rounded-md" />
            </div>
        </div>
    </div>
</section>
