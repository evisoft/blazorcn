@* ============================================================
   Block: skeleton-settings-page
   Title: SkeletonSettingsPage
   Description: A React and Next.js settings page skeleton loader built with shadcn/ui Skeleton and Tailwind CSS for preferences interfaces.
   Source: original/blocks/skeleton/skeleton-settings-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex gap-6">
                @foreach (var width in _tabs)
                {
                    <SkeletonCn Class="@($"h-4 {width}")" />
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="space-y-6">
                @foreach (var grp in _settingGroups)
                {
                    <div class="space-y-2">
                        <div class="space-y-1.5">
                            <SkeletonCn Class="@($"h-4 {grp.LabelWidth}")" />
                            <SkeletonCn Class="@($"h-3 {grp.DescWidth}")" />
                        </div>
                        <SkeletonCn Class="h-10 w-full rounded-md" />
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-2.5">
            <SkeletonCn Class="h-7 w-20 rounded-md" />
        </div>
    </div>
</section>

@code {
    private record SettingGroup(string LabelWidth, string DescWidth);

    private static readonly string[] _tabs = ["w-16", "w-20", "w-14", "w-24", "w-18"];

    private static readonly SettingGroup[] _settingGroups =
    [
        new("w-28", "w-full"),
        new("w-36", "w-4/5"),
        new("w-24", "w-full"),
        new("w-32", "w-3/4"),
    ];
}
