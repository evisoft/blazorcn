@* ============================================================
   Block: skeleton-ecommerce-checkout
   Title: SkeletonEcommerceCheckout
   Description: A React checkout form skeleton loader block built with Next.js, shadcn/ui Skeleton, and Tailwind CSS for two-panel checkout loading states
   Source: original/blocks/skeleton/skeleton-ecommerce-checkout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <SkeletonCn Class="h-4 w-24" />
        </div>

        @* Two Column Layout *@
        <div class="grid grid-cols-1 md:grid-cols-2">
            @* Left: Shipping Form *@
            <div class="border-b px-4 py-3 md:border-b-0 md:border-r">
                <SkeletonCn Class="mb-3 h-4 w-28" />

                <div class="space-y-3">
                    @foreach (var field in _formFields)
                    {
                        <div class="space-y-1.5">
                            <SkeletonCn Class="@($"h-3 {field.LabelW}")" />
                            <SkeletonCn Class="h-9 w-full rounded-md" />
                        </div>
                    }

                    @* City, State, Zip *@
                    <div class="grid grid-cols-3 gap-2">
                        @foreach (var field in _compactFields)
                        {
                            <div class="space-y-1.5">
                                <SkeletonCn Class="@($"h-3 {field.LabelW}")" />
                                <SkeletonCn Class="h-9 w-full rounded-md" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Right: Order Summary *@
            <div class="px-4 py-3">
                <SkeletonCn Class="mb-3 h-4 w-28" />

                @* Order Items *@
                <div class="space-y-2.5">
                    @foreach (var item in _orderItems)
                    {
                        <div class="flex gap-2.5">
                            <SkeletonCn Class="size-10 shrink-0 rounded-md" />
                            <div class="flex min-w-0 flex-1 flex-col gap-1">
                                <SkeletonCn Class="@($"h-3 {item.NameW}")" />
                                <SkeletonCn Class="@($"h-3 {item.DetailW}")" />
                            </div>
                            <SkeletonCn Class="h-3 w-12 shrink-0" />
                        </div>
                    }
                </div>

                @* Pricing *@
                <div class="mt-3 space-y-1.5 border-t pt-2.5">
                    <div class="flex items-center justify-between">
                        <SkeletonCn Class="h-3 w-16" />
                        <SkeletonCn Class="h-3 w-14" />
                    </div>
                    <div class="flex items-center justify-between">
                        <SkeletonCn Class="h-3 w-20" />
                        <SkeletonCn Class="h-3 w-12" />
                    </div>
                    <div class="flex items-center justify-between">
                        <SkeletonCn Class="h-3 w-10" />
                        <SkeletonCn Class="h-3 w-14" />
                    </div>
                    <div class="flex items-center justify-between border-t pt-2">
                        <SkeletonCn Class="h-4 w-14" />
                        <SkeletonCn Class="h-4 w-16" />
                    </div>
                </div>

                @* Place Order Button *@
                <div class="mt-3">
                    <SkeletonCn Class="h-7 w-full rounded-md" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record FormField(string LabelW, string Id);
    private record OrderItem(string NameW, string DetailW);

    private static readonly FormField[] _formFields =
    [
        new("w-20", "name"),
        new("w-14", "email"),
        new("w-24", "address"),
        new("w-20", "phone"),
    ];

    private static readonly FormField[] _compactFields =
    [
        new("w-10", "city"),
        new("w-12", "state"),
        new("w-16", "zip"),
    ];

    private static readonly OrderItem[] _orderItems =
    [
        new("w-3/4", "w-1/2"),
        new("w-full", "w-2/3"),
        new("w-2/3", "w-1/3"),
    ];
}
