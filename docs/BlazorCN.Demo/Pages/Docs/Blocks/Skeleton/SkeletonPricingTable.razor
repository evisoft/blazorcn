@* ============================================================
   Block: skeleton-pricing-table
   Title: SkeletonPricingTable
   Description: A React and Next.js skeleton loader for pricing comparison tables built with shadcn/ui Skeleton and Tailwind CSS
   Source: original/blocks/skeleton/skeleton-pricing-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <SkeletonCn Class="h-4 w-32" />
                <SkeletonCn Class="h-3 w-48" />
            </div>
        </div>

        @* Pricing Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var plan in _planNameWidths)
            {
                <div class="px-4 py-3">
                    <div class="space-y-4">
                        @* Plan Name *@
                        <SkeletonCn Class="@($"h-4 {plan}")" />

                        @* Price *@
                        <SkeletonCn Class="h-8 w-16" />

                        @* Description *@
                        <SkeletonCn Class="h-3 w-full" />

                        @* Features *@
                        <div class="space-y-3 pt-2">
                            @foreach (var width in _featureWidths)
                            {
                                <div class="flex items-center gap-2">
                                    <SkeletonCn Class="size-3.5 shrink-0 rounded-sm" />
                                    <SkeletonCn Class="@($"h-3 {width}")" />
                                </div>
                            }
                        </div>

                        @* CTA Button *@
                        <SkeletonCn Class="h-7 w-full rounded-md" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <SkeletonCn Class="h-3 w-56" />
        </div>
    </div>
</section>

@code {
    private static readonly string[] _featureWidths = ["w-full", "w-5/6", "w-4/5", "w-full", "w-3/4"];
    private static readonly string[] _planNameWidths = ["w-20", "w-24", "w-16"];
}
