@* ===========================================================
   Block: settings-time-tracking
   Title: Settings Time Tracking
   Description: Animated React time tracking settings block for Next.js with rounding rules, billable hour defaults, overtime configuration, and approval workflows built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-time-tracking.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Time tracking</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Rounding rules, billing defaults, and overtime configuration
            </p>
        </div>

        @* Rounding section *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-muted-foreground text-xs uppercase tracking-wide">
                Rounding
            </p>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1.5 block text-muted-foreground text-xs">Interval</span>
                    <SelectCn @bind-Value="_roundingInterval">
                        <SelectTriggerCn aria-label="Rounding interval" Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var r in _roundingIntervals)
                            {
                                <SelectItemCn Value="@r.Value">@r.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div>
                    <span class="mb-1.5 block text-muted-foreground text-xs">Direction</span>
                    <SelectCn @bind-Value="_roundingDirection">
                        <SelectTriggerCn aria-label="Rounding direction" Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var d in _roundingDirections)
                            {
                                <SelectItemCn Value="@d.Value">@d.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Billing defaults *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Default to billable</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    New time entries are marked billable by default
                </p>
            </div>
            <SwitchCn aria-label="Default to billable" @bind-Checked="_defaultBillable" />
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Default hourly rate
                    </span>
                    <InputCn aria-label="Default hourly rate" Type="number" @bind-Value="_defaultRate" Class="h-8 font-mono text-sm" />
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Currency
                    </span>
                    <SelectCn @bind-Value="_currency">
                        <SelectTriggerCn aria-label="Currency" Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var c in _currencies)
                            {
                                <SelectItemCn Value="@c.Value">@c.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Overtime *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Overtime tracking</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Track and calculate overtime based on weekly threshold
                </p>
            </div>
            <SwitchCn aria-label="Overtime tracking" @bind-Checked="_overtimeEnabled" />
        </div>

        @if (_overtimeEnabled)
        {
            <div class="border-b px-4 py-3">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <span class="mb-1.5 block text-muted-foreground text-xs">
                            Weekly threshold (hours)
                        </span>
                        <InputCn aria-label="Weekly threshold (hours)" Type="number" @bind-Value="_weeklyThreshold" Class="h-8 font-mono text-sm" />
                    </div>
                    <div>
                        <span class="mb-1.5 block text-muted-foreground text-xs">
                            Overtime multiplier
                        </span>
                        <InputCn aria-label="Overtime multiplier" @bind-Value="_overtimeMultiplier" Class="h-8 font-mono text-sm" Placeholder="1.5" />
                    </div>
                </div>
                <div class="mt-3 flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Double time</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Apply 2x rate after a second threshold
                        </p>
                    </div>
                    <SwitchCn aria-label="Double time" @bind-Checked="_doubleTimeEnabled" />
                </div>
            </div>
        }

        @* Approval workflow *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Require manager approval</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Time entries need manager sign-off before billing
                </p>
            </div>
            <SwitchCn aria-label="Require manager approval" @bind-Checked="_approvalRequired" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Lock after approval</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Prevent edits to approved time entries
                </p>
            </div>
            <SwitchCn aria-label="Lock after approval" @bind-Checked="_lockAfterApproval" />
        </div>

        @* Daily reminder *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Daily time reminder</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Remind team members to log their hours
                </p>
            </div>
            <div class="flex items-center gap-3">
                @if (_reminderEnabled)
                {
                    <SelectCn @bind-Value="_reminderTime">
                        <SelectTriggerCn aria-label="Reminder time" Class="h-8 w-28 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var t in _reminderTimes)
                            {
                                <SelectItemCn Value="@t.Value">@t.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                }
                <SwitchCn aria-label="Daily time reminder" @bind-Checked="_reminderEnabled" />
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _roundingInterval = "15";
    private string _roundingDirection = "nearest";
    private bool _defaultBillable = true;
    private string _defaultRate = "150";
    private string _currency = "USD";
    private string _weeklyThreshold = "40";
    private bool _overtimeEnabled = true;
    private string _overtimeMultiplier = "1.5";
    private bool _doubleTimeEnabled;
    private bool _approvalRequired = true;
    private bool _lockAfterApproval = true;
    private bool _reminderEnabled = true;
    private string _reminderTime = "17:00";
    private bool _saved;

    private record SelectOption(string Value, string Label);

    private static readonly List<SelectOption> _roundingIntervals = new()
    {
        new("1", "1 minute"), new("5", "5 minutes"), new("6", "6 minutes (1/10 hr)"),
        new("15", "15 minutes"), new("30", "30 minutes"), new("60", "1 hour"),
    };

    private static readonly List<SelectOption> _roundingDirections = new()
    {
        new("nearest", "Nearest"), new("up", "Round up"), new("down", "Round down"),
    };

    private static readonly List<SelectOption> _currencies = new()
    {
        new("USD", "USD ($)"), new("EUR", "EUR"), new("GBP", "GBP"),
        new("CAD", "CAD"), new("AUD", "AUD"),
    };

    private static readonly List<SelectOption> _reminderTimes = new()
    {
        new("17:00", "5:00 PM"), new("18:00", "6:00 PM"),
        new("19:00", "7:00 PM"), new("20:00", "8:00 PM"),
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
