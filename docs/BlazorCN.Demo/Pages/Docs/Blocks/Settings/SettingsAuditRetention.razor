@* ===========================================================
   Block: settings-audit-retention
   Title: Settings Audit Retention
   Description: Retention period, archival, export policy settings
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-audit-retention.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Audit Log Retention</p>
            <p class="mt-0.5 text-muted-foreground text-xs">Retention period, archival, and export policies</p>
        </div>

        @* Storage usage *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideHardDriveCn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Storage usage</span>
                </div>
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium tabular-nums text-foreground">@_storageUsed GB</span> / @_storageTotal GB
                </span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground/70 transition-all" style="@($"width: {(_storageUsed * 100 / _storageTotal)}%")"></div>
            </div>
            <div class="mt-2 flex items-center gap-4">
                @foreach (var evtType in _eventTypes)
                {
                    <span class="text-muted-foreground text-xs">
                        @evtType.Name: <span class="font-medium tabular-nums text-foreground">@evtType.Count</span>
                    </span>
                }
            </div>
        </div>

        @* Retention period *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Retention period</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">How long logs remain in active storage</p>
                        </div>
                    </div>
                    <SelectCn @bind-Value="_retentionPeriod">
                        <SelectTriggerCn aria-label="Retention period" Class="h-8 w-32 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="30d">30 days</SelectItemCn>
                            <SelectItemCn Value="90d">90 days</SelectItemCn>
                            <SelectItemCn Value="6m">6 months</SelectItemCn>
                            <SelectItemCn Value="1y">1 year</SelectItemCn>
                            <SelectItemCn Value="2y">2 years</SelectItemCn>
                            <SelectItemCn Value="5y">5 years</SelectItemCn>
                            <SelectItemCn Value="indefinite">Indefinite</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Immutable logs</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Prevent modification or deletion of audit entries</p>
                    </div>
                    <SwitchCn aria-label="Immutable logs" @bind-Checked="_immutableLogs" />
                </div>
            </div>
        </div>

        @* Archival *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideArchiveCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Archival</span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Archive expired logs</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Move logs to cold storage after retention period</p>
                    </div>
                    <SwitchCn aria-label="Archive expired logs" @bind-Checked="_archiveEnabled" />
                </div>

                @if (_archiveEnabled)
                {
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-sm">Archive destination</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">Cold storage provider for archived logs</p>
                        </div>
                        <SelectCn @bind-Value="_archiveDestination">
                            <SelectTriggerCn aria-label="Archive destination" Class="h-8 w-36 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="s3">Amazon S3 Glacier</SelectItemCn>
                                <SelectItemCn Value="gcs">GCS Coldline</SelectItemCn>
                                <SelectItemCn Value="azure">Azure Cool Blob</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-sm">Archive retention</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">How long archived logs are kept before deletion</p>
                        </div>
                        <SelectCn @bind-Value="_archiveRetention">
                            <SelectTriggerCn aria-label="Archive retention" Class="h-8 w-28 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="1y">1 year</SelectItemCn>
                                <SelectItemCn Value="3y">3 years</SelectItemCn>
                                <SelectItemCn Value="5y">5 years</SelectItemCn>
                                <SelectItemCn Value="7y">7 years</SelectItemCn>
                                <SelectItemCn Value="10y">10 years</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                }
            </div>
        </div>

        @* Export policy *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideDownloadCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Automated export</span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Scheduled export</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Automatically export audit logs on a schedule</p>
                    </div>
                    <SwitchCn aria-label="Scheduled export" @bind-Checked="_autoExport" />
                </div>

                @if (_autoExport)
                {
                    <div class="flex items-center justify-between">
                        <p class="font-medium text-sm">Export format</p>
                        <SelectCn @bind-Value="_exportFormat">
                            <SelectTriggerCn aria-label="Export format" Class="h-8 w-28 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="json">JSON</SelectItemCn>
                                <SelectItemCn Value="csv">CSV</SelectItemCn>
                                <SelectItemCn Value="parquet">Parquet</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="flex items-center justify-between">
                        <p class="font-medium text-sm">Export frequency</p>
                        <SelectCn @bind-Value="_exportFrequency">
                            <SelectTriggerCn aria-label="Export frequency" Class="h-8 w-28 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="daily">Daily</SelectItemCn>
                                <SelectItemCn Value="weekly">Weekly</SelectItemCn>
                                <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-sm">Notify on export</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">Send an email when export completes</p>
                        </div>
                        <SwitchCn aria-label="Notify on export" @bind-Checked="_notifyOnExport" />
                    </div>

                    @if (_notifyOnExport)
                    {
                        <div class="flex items-center justify-between">
                            <p class="text-muted-foreground text-xs">Notification email</p>
                            <InputCn aria-label="Notification email" @bind-Value="_notifyEmail" Class="h-7 w-52 text-xs" />
                        </div>
                    }
                }
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-red-600 text-xs hover:text-red-700">
                <LucideTrashCn Size="12" Class="size-3" />
                Purge expired logs
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_saved)
                {
                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideCheckCn Size="12" Class="size-3" />
                        Saved
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record EventTypeInfo(string Name, int Count);

    private static readonly List<EventTypeInfo> _eventTypes =
    [
        new("Auth", 12480),
        new("Data", 3200),
        new("Settings", 890),
    ];

    private int _storageUsed = 14;
    private int _storageTotal = 50;
    private string _retentionPeriod = "1y";
    private bool _immutableLogs = true;
    private bool _archiveEnabled = true;
    private string _archiveDestination = "s3";
    private string _archiveRetention = "7y";
    private bool _autoExport = true;
    private string _exportFormat = "json";
    private string _exportFrequency = "weekly";
    private bool _notifyOnExport = true;
    private string _notifyEmail = "compliance@acme.com";
    private bool _saved = false;
}
