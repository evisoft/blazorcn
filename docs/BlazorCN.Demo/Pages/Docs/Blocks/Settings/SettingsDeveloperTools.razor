@* ===========================================================
   Block: settings-developer-tools
   Title: Settings Developer Tools
   Description: Developer tools settings with debug mode toggle, API sandbox environment, request logging, and performance profiling
   Dependencies: BadgeCn, ButtonCn, LucideBugCn, LucideCodeCn, LucideGaugeCn, LucideNetworkCn, LucideServerCn, LucideTerminalCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-developer-tools.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTerminalCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Developer Tools</h2>
                    <p class="text-xs text-muted-foreground">
                        Debug, profile, and inspect API behavior
                    </p>
                </div>
            </div>
        </div>

        @* Environment *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">ENVIRONMENT</p>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideServerCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">API environment</p>
                        <p class="text-xs text-muted-foreground">
                            Switch between sandbox and production
                        </p>
                    </div>
                </div>
                <SelectCn Value="@_apiEnvironment" ValueChanged="v => _apiEnvironment = v">
                    <SelectTriggerCn aria-label="API environment" Class="h-7 w-32 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="sandbox">Sandbox</SelectItemCn>
                        <SelectItemCn Value="production">Production</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            @if (_apiEnvironment == "sandbox")
            {
                <div class="mt-2 rounded-md bg-amber-500/5 p-2.5">
                    <p class="text-xs text-amber-700 dark:text-amber-300">
                        Sandbox mode: requests use test data and relaxed rate limits. No real data is affected.
                    </p>
                </div>
            }
        </div>

        @* Debug toggles *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">DEBUG OPTIONS</p>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideBugCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="text-sm font-medium">Debug mode</p>
                            <p class="text-xs text-muted-foreground">
                                Verbose console output and render boundaries
                            </p>
                        </div>
                    </div>
                    <SwitchCn aria-label="Debug mode" @bind-Checked="_debugMode" />
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideCodeCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="text-sm font-medium">Verbose error messages</p>
                            <p class="text-xs text-muted-foreground">
                                Show stack traces and internal error details
                            </p>
                        </div>
                    </div>
                    <SwitchCn aria-label="Verbose error messages" @bind-Checked="_verboseErrors" />
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideGaugeCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="text-sm font-medium">Performance profiling</p>
                            <p class="text-xs text-muted-foreground">
                                Track render times and network latency
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (_profiling)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] text-amber-600 dark:text-amber-400">
                                ~5% overhead
                            </BadgeCn>
                        }
                        <SwitchCn aria-label="Performance profiling" @bind-Checked="_profiling" />
                    </div>
                </div>
            </div>
        </div>

        @* Request logging *@
        <div>
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideNetworkCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="text-sm font-medium">Request logging</p>
                            <p class="text-xs text-muted-foreground">
                                Capture API requests and responses in-browser
                            </p>
                        </div>
                    </div>
                    <SwitchCn aria-label="Request logging" @bind-Checked="_requestLogging" />
                </div>
            </div>

            @if (_requestLogging)
            {
                <div class="border-b px-4 py-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-muted-foreground">
                            RECENT REQUESTS (@_recentLogs.Length)
                        </span>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                  Class="h-6 px-2 text-xs"
                                  @onclick="@(() => _showLogs = !_showLogs)">
                            @(_showLogs ? "Collapse" : "Expand")
                        </ButtonCn>
                    </div>
                </div>

                @if (_showLogs)
                {
                    <div class="bg-zinc-950 px-3 py-2">
                        @foreach (var log in _recentLogs)
                        {
                            <div class="flex items-center gap-2 py-1 font-mono text-xs">
                                <span class="tabular-nums text-zinc-500">@log.Timestamp</span>
                                <span class="@($"w-12 font-semibold {GetMethodColor(log.Method)}")">
                                    @log.Method
                                </span>
                                <span class="flex-1 truncate text-zinc-300">@log.Path</span>
                                <span class="@($"tabular-nums {(log.Status >= 400 ? "text-red-400" : "text-emerald-400")}")">
                                    @log.Status
                                </span>
                                <span class="w-12 text-right tabular-nums text-zinc-500">
                                    @log.Latency
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record LogEntry(string Method, string Path, int Status, string Latency, string Timestamp);

    private bool _debugMode;
    private string _apiEnvironment = "sandbox";
    private bool _requestLogging = true;
    private bool _profiling;
    private bool _verboseErrors = true;
    private bool _showLogs;

    private static readonly LogEntry[] _recentLogs =
    [
        new("GET", "/api/v1/users/me", 200, "42ms", "12:34:02"),
        new("POST", "/api/v1/workspaces", 201, "187ms", "12:33:58"),
        new("GET", "/api/v1/billing/invoices", 200, "95ms", "12:33:41"),
        new("PATCH", "/api/v1/settings", 200, "63ms", "12:33:29"),
        new("DELETE", "/api/v1/tokens/tk_old", 204, "31ms", "12:33:15"),
        new("GET", "/api/v1/audit-log", 403, "12ms", "12:32:58"),
    ];

    private static string GetMethodColor(string method) => method switch
    {
        "GET" => "text-blue-600 dark:text-blue-400",
        "POST" => "text-emerald-600 dark:text-emerald-400",
        "PATCH" or "PUT" => "text-amber-600 dark:text-amber-400",
        "DELETE" => "text-red-600 dark:text-red-400",
        _ => "text-zinc-400",
    };
}
