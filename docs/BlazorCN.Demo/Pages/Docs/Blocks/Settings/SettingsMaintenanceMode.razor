@* ===========================================================
   Block: settings-maintenance-mode
   Title: Settings Maintenance Mode
   Description: Enable toggle, scheduled window, status page message, bypass IPs, notifications
   Dependencies: BadgeCn, ButtonCn, InputCn, SwitchCn, TextareaCn
   Source: original/blocks/settings/settings-maintenance-mode.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideWrenchCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">Maintenance Mode</p>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Control application availability and scheduled downtime
            </p>
        </div>

        @* Main toggle *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                @if (_enabled)
                {
                    <LucideTriangleAlertCn Size="16" Class="size-4 text-amber-500" />
                }
                <div>
                    <p class="font-medium text-sm">Enable maintenance mode</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Show maintenance page to all users immediately
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                @if (_enabled)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-amber-600 text-xs dark:text-amber-400">
                        Active
                    </BadgeCn>
                }
                <SwitchCn @bind-Checked="_enabled" />
            </div>
        </div>

        @* Scheduled window section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideClockCn Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="font-medium text-muted-foreground text-xs">Scheduled window</p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 border-b px-4 py-4">
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Start time</span>
                <InputCn type="datetime-local" @bind-Value="_scheduledStart" Class="h-8 text-sm" />
            </div>
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">End time</span>
                <InputCn type="datetime-local" @bind-Value="_scheduledEnd" Class="h-8 text-sm" />
            </div>
        </div>

        @* Show countdown *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Show countdown timer on status page</span>
            <SwitchCn @bind-Checked="_showCountdown" />
        </div>

        @* Status page message *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Status page message
            </span>
            <TextareaCn @bind-Value="_message" Class="min-h-20 text-sm" rows="3" />
            <p class="mt-1.5 text-muted-foreground text-xs">
                Displayed to visitors during maintenance. Plain text or markdown.
            </p>
        </div>

        @* Admin access *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Allow admin access</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Admins can access the app during maintenance
                </p>
            </div>
            <SwitchCn @bind-Checked="_allowAdminAccess" />
        </div>

        @* Bypass IPs *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-muted-foreground text-xs">Bypass IP addresses</p>
        </div>

        @foreach (var ip in _bypassIps)
        {
            <div class="flex items-center gap-3 border-b px-4 py-2.5">
                <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                <span class="font-mono text-sm">@ip.Ip</span>
                <span class="text-muted-foreground text-xs">@ip.Label</span>
                <div class="flex-1"></div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-muted-foreground text-xs hover:text-red-600 dark:hover:text-red-400">
                    Remove
                </ButtonCn>
            </div>
        }

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn @bind-Value="_newBypassIp" Placeholder="IP or CIDR range" Class="h-8 font-mono text-sm" />
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">
                Add IP
            </ButtonCn>
        </div>

        @* Notifications section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMailCn Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="font-medium text-muted-foreground text-xs">Notifications</p>
            </div>
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Email all users before maintenance</span>
            <SwitchCn @bind-Checked="_emailUsers" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Show in-app banner</span>
            <SwitchCn @bind-Checked="_inAppBanner" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Update public status page</span>
            <SwitchCn @bind-Checked="_statusPage" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Send Slack notification</span>
            <SwitchCn @bind-Checked="_slackWebhook" />
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BypassIpItem(string Id, string Ip, string Label);

    private static readonly List<BypassIpItem> _bypassIps =
    [
        new("1", "203.0.113.50", "Developer workstation"),
        new("2", "198.51.100.0/24", "Office network"),
        new("3", "10.0.0.5", "QA environment"),
    ];

    private bool _enabled = false;
    private string _scheduledStart = "2026-03-20T02:00";
    private string _scheduledEnd = "2026-03-20T04:00";
    private string _message = "We are performing scheduled maintenance to improve performance and reliability. We expect to be back online shortly. Thank you for your patience.";
    private bool _showCountdown = true;
    private bool _allowAdminAccess = true;
    private string _newBypassIp = "";
    private bool _emailUsers = true;
    private bool _inAppBanner = true;
    private bool _statusPage = true;
    private bool _slackWebhook = false;
    private bool _saved = false;
}
