@* ===========================================================
   Block: settings-password-policy
   Title: Settings Password Policy
   Description: Animated React password policy settings page for Next.js with minimum length, complexity rules, expiry period, history tracking, and lockout configuration built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: TOTP, SMS, and backup codes setup
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-password-policy.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Password Policy</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Set password requirements for all organization members
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="@StrengthColor">@StrengthLabel</span>
                </BadgeCn>
            </div>
        </div>

        @* Length requirements *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideKeyCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Length requirements</span>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1 block text-muted-foreground text-xs">Minimum length</span>
                    <InputCn Type="number" @bind-Value="_minLength" Class="h-8 text-sm" />
                </div>
                <div>
                    <span class="mb-1 block text-muted-foreground text-xs">Maximum length</span>
                    <InputCn Type="number" @bind-Value="_maxLength" Class="h-8 text-sm" />
                </div>
            </div>
        </div>

        @* Complexity rules *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideShieldAlertCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Complexity rules</span>
                </div>
                <span class="text-muted-foreground text-xs">
                    @ActiveRules of @_rules.Count enabled
                </span>
            </div>
            <div class="space-y-1">
                @foreach (var rule in _rules)
                {
                    <div class="flex items-center justify-between rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50">
                        <div>
                            <p class="font-medium text-sm">@rule.Label</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">@rule.Description</p>
                        </div>
                        <SwitchCn @bind-Checked="rule.Enabled" />
                    </div>
                }
            </div>
        </div>

        @* Password expiry *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <p class="font-medium text-sm">Password expiry</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Force password change after a set period
                        </p>
                    </div>
                </div>
                <SwitchCn @bind-Checked="_expiryEnabled" />
            </div>
            @if (_expiryEnabled)
            {
                <div class="mt-3 ml-7">
                    <SelectCn @bind-Value="_expiryDays">
                        <SelectTriggerCn Class="h-8 w-40 text-xs">
                            <SelectValueCn Placeholder="Select" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="@("30")">Every 30 days</SelectItemCn>
                            <SelectItemCn Value="@("60")">Every 60 days</SelectItemCn>
                            <SelectItemCn Value="@("90")">Every 90 days</SelectItemCn>
                            <SelectItemCn Value="@("180")">Every 180 days</SelectItemCn>
                            <SelectItemCn Value="@("365")">Every 365 days</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            }
        </div>

        @* Password history *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <LucideHistoryCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Password history</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Prevent reuse of recent passwords
                    </p>
                </div>
            </div>
            <SelectCn @bind-Value="_historyCount">
                <SelectTriggerCn Class="h-8 w-32 text-xs">
                    <SelectValueCn Placeholder="Select" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("0")">Disabled</SelectItemCn>
                    <SelectItemCn Value="@("3")">Last 3</SelectItemCn>
                    <SelectItemCn Value="@("5")">Last 5</SelectItemCn>
                    <SelectItemCn Value="@("10")">Last 10</SelectItemCn>
                    <SelectItemCn Value="@("24")">Last 24</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Account lockout *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideLockCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <p class="font-medium text-sm">Account lockout</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Lock account after failed login attempts
                        </p>
                    </div>
                </div>
                <SwitchCn @bind-Checked="_lockoutEnabled" />
            </div>
            @if (_lockoutEnabled)
            {
                <div class="mt-3 ml-7 grid grid-cols-2 gap-3">
                    <div>
                        <span class="mb-1 block text-muted-foreground text-xs">
                            Failed attempts
                        </span>
                        <InputCn Type="number" @bind-Value="_lockoutAttempts" Class="h-8 text-sm" />
                    </div>
                    <div>
                        <span class="mb-1 block text-muted-foreground text-xs">
                            Lockout duration (min)
                        </span>
                        <InputCn Type="number" @bind-Value="_lockoutDuration" Class="h-8 text-sm" />
                    </div>
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _minLength = "12";
    private string _maxLength = "128";
    private string _expiryDays = "0";
    private string _historyCount = "5";
    private string _lockoutAttempts = "5";
    private string _lockoutDuration = "15";
    private bool _expiryEnabled;
    private bool _lockoutEnabled = true;
    private bool _saved;

    private class ComplexityRule
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private readonly List<ComplexityRule> _rules = new()
    {
        new() { Id = "uppercase", Label = "Uppercase letter", Description = "Require at least one uppercase character (A-Z)", Enabled = true },
        new() { Id = "lowercase", Label = "Lowercase letter", Description = "Require at least one lowercase character (a-z)", Enabled = true },
        new() { Id = "number", Label = "Number", Description = "Require at least one numeric digit (0-9)", Enabled = true },
        new() { Id = "special", Label = "Special character", Description = "Require at least one special character (!@@#$%)", Enabled = true },
        new() { Id = "nocommon", Label = "Block common passwords", Description = "Reject passwords found in breach databases", Enabled = true },
        new() { Id = "nousername", Label = "No username in password", Description = "Prevent passwords containing the username or email", Enabled = false },
    };

    private int ActiveRules => _rules.Count(r => r.Enabled);

    private string StrengthLabel => ActiveRules >= 5 ? "Strong" : ActiveRules >= 3 ? "Moderate" : "Weak";

    private string StrengthColor => ActiveRules >= 5
        ? "text-emerald-600 dark:text-emerald-400"
        : ActiveRules >= 3
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
