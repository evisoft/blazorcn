@* ===========================================================
   Block: settings-referral-program
   Title: Settings Referral Program
   Description: Animated React referral program settings page for Next.js with reward tiers, referral link sharing, invite tracking, and commission configuration built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Plan, payment method, and invoices
   Dependencies: BadgeCn, ButtonCn, InputCn, SwitchCn
   Source: original/blocks/settings/settings-referral-program.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Referral Program</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Share your link, earn rewards for every converted referral
            </p>
        </div>

        @* Stats *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-semibold text-sm tabular-nums">@_referrals.Count</span>
                <span class="text-muted-foreground text-xs">invited</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-semibold text-sm tabular-nums">@_referrals.Count(r => r.Status == "converted")</span>
                <span class="text-muted-foreground text-xs">converted</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-2">
                <LucideGiftCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-semibold text-sm tabular-nums">$65</span>
                <span class="text-muted-foreground text-xs">earned</span>
            </div>
        </div>

        @* Referral link *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Your referral link
            </span>
            <div class="flex items-center gap-2">
                <div class="flex flex-1 items-center gap-2 rounded-md border bg-muted/30 px-3 py-1.5">
                    <LucideLinkCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                    <span class="truncate font-mono text-xs">@_referralUrl</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Reward tiers *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Reward tiers</span>
            <div class="space-y-2">
                @foreach (var tier in _rewardTiers)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2">
                        <div class="flex items-center gap-3">
                            <span class="@Cn.Merge("size-1.5 rounded-full", tier.Reached ? "bg-emerald-500" : "bg-zinc-300 dark:bg-zinc-600")"></span>
                            <div>
                                <span class="font-medium text-sm">@tier.Name</span>
                                <span class="ml-2 text-muted-foreground text-xs">
                                    @tier.Referrals referrals
                                </span>
                            </div>
                        </div>
                        <span class="@Cn.Merge("text-xs", tier.Reached ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                            @tier.Reward
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Recent referrals *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Recent referrals</span>
            </div>
            @for (var i = 0; i < _referrals.Count; i++)
            {
                var referral = _referrals[i];
                var index = i;

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", index < _referrals.Count - 1 ? "border-b" : "")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusConfig[referral.Status].Dot)"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@referral.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@referral.Email</span>
                    </div>
                    <span class="text-muted-foreground text-xs">@referral.Date</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_statusConfig[referral.Status].Label
                    </BadgeCn>
                </div>
            }
        </div>

        @* Settings toggles *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Automatic payouts</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Automatically credit rewards when referrals convert
                    </p>
                </div>
                <SwitchCn @bind-Checked="_autoPayout" />
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Email notifications</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Get notified when someone signs up through your link
                    </p>
                </div>
                <SwitchCn @bind-Checked="_emailNotify" />
            </div>
        </div>

        @* Custom code *@
        <div class="px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Custom referral code
            </span>
            <div class="flex items-center gap-2">
                <InputCn Value="@_referralCode" Class="h-8 font-mono text-sm" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Update
                </ButtonCn>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                Letters, numbers, and hyphens only. Max 12 characters.
            </p>
        </div>
    </div>
</section>

@code {
    private bool _copied;
    private bool _autoPayout = true;
    private bool _emailNotify = true;
    private string _referralCode = "ACME-AX7K2M";
    private string _referralUrl => $"https://acme.com/ref/{_referralCode}";

    private record RewardTier(string Id, string Name, int Referrals, string Reward, bool Reached);

    private record ReferralEntry(string Id, string Name, string Email, string Status, string Date);

    private record StatusInfo(string Dot, string Label);

    private static readonly List<RewardTier> _rewardTiers = new()
    {
        new("t1", "Starter", 3, "$15 credit", true),
        new("t2", "Advocate", 10, "$50 credit", true),
        new("t3", "Champion", 25, "1 month free", false),
        new("t4", "Ambassador", 50, "Lifetime 20% off", false),
    };

    private static readonly List<ReferralEntry> _referrals = new()
    {
        new("r1", "Jordan Rivera", "jordan@startup.io", "converted", "Mar 2"),
        new("r2", "Taylor Kim", "taylor.k@design.co", "trial", "Mar 8"),
        new("r3", "Sam Patel", "sam.p@agency.dev", "signed_up", "Mar 12"),
        new("r4", "Casey Nguyen", "casey@freelance.com", "expired", "Feb 14"),
    };

    private static readonly Dictionary<string, StatusInfo> _statusConfig = new()
    {
        ["converted"] = new("bg-emerald-500", "Converted"),
        ["trial"] = new("bg-blue-500", "Trial"),
        ["signed_up"] = new("bg-amber-500", "Signed up"),
        ["expired"] = new("bg-zinc-400", "Expired"),
    };

    private void HandleCopy()
    {
        _copied = true;
        _ = ResetCopied();
    }

    private async Task ResetCopied()
    {
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }
}
