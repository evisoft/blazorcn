@* ===========================================================
   Block: settings-localization
   Title: Settings Localization
   Description: Language management, translation progress, fallback locale, date/number format
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-localization.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">Localization</p>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage languages, translations, and regional formatting
            </p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">@_languages.Count(l => l.Enabled) languages enabled</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">
                @_languages.Count(l => l.Progress == 100) fully translated
            </span>
        </div>

        @* Auto-detect locale *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Auto-detect locale</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Detect user language from browser settings
                </p>
            </div>
            <SwitchCn @bind-Checked="_autoDetect" />
        </div>

        @* Fallback locale *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Fallback locale</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Used when a translation is missing
                </p>
            </div>
            <SelectCn @bind-Value="_fallbackLocale">
                <SelectTriggerCn Class="h-8 w-36 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var lang in _languages.Where(l => l.Enabled))
                    {
                        <SelectItemCn Value="@lang.Code">@lang.Name</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Date format *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Date format</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Default date display format</p>
            </div>
            <SelectCn @bind-Value="_dateFormat">
                <SelectTriggerCn Class="h-8 w-44 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="iso">ISO 8601 (2026-03-17)</SelectItemCn>
                    <SelectItemCn Value="us">US (03/17/2026)</SelectItemCn>
                    <SelectItemCn Value="eu">EU (17/03/2026)</SelectItemCn>
                    <SelectItemCn Value="relative">Relative (3 days ago)</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Number format *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Number format</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Thousand and decimal separator style
                </p>
            </div>
            <SelectCn @bind-Value="_numberFormat">
                <SelectTriggerCn Class="h-8 w-44 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="international">International (1,234.56)</SelectItemCn>
                    <SelectItemCn Value="european">European (1.234,56)</SelectItemCn>
                    <SelectItemCn Value="swiss">Swiss (1'234.56)</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Languages section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="font-medium text-muted-foreground text-xs">Languages</p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add language
                </ButtonCn>
            </div>
        </div>

        @* Language list *@
        @foreach (var language in _languages)
        {
            var progressColor = language.Progress == 100
                ? "bg-emerald-500"
                : language.Progress >= 75
                    ? "bg-foreground"
                    : "bg-amber-500";
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideGripVerticalCn Class="size-3.5 shrink-0 cursor-grab text-muted-foreground/40" />
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@language.Name</span>
                        <span class="text-muted-foreground text-xs">@language.NativeName</span>
                        @if (language.Rtl)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                RTL
                            </BadgeCn>
                        }
                        @if (language.Code == _fallbackLocale)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                Fallback
                            </BadgeCn>
                        }
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <div class="h-1 w-24 overflow-hidden rounded-full bg-muted/50">
                            <div class="@Cn.Merge("h-full rounded-full", progressColor)" style="width: @(language.Progress)%"></div>
                        </div>
                        <span class="font-mono text-muted-foreground text-xs">
                            @(language.Progress)%
                        </span>
                    </div>
                </div>
                <SwitchCn Checked="@language.Enabled" />
            </div>
        }

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record LanguageItem(string Id, string Code, string Name, string NativeName, int Progress, bool Rtl, bool Enabled);

    private static readonly List<LanguageItem> _languages =
    [
        new("1", "en", "English", "English", 100, false, true),
        new("2", "es", "Spanish", "Espanol", 94, false, true),
        new("3", "fr", "French", "Francais", 87, false, true),
        new("4", "de", "German", "Deutsch", 82, false, true),
        new("5", "ja", "Japanese", "\u65E5\u672C\u8A9E", 71, false, true),
        new("6", "ar", "Arabic", "\u0627\u0644\u0639\u0631\u0628\u064A\u0629", 58, true, false),
    ];

    private string _fallbackLocale = "en";
    private string _dateFormat = "iso";
    private string _numberFormat = "international";
    private bool _autoDetect = true;
    private bool _saved = false;
}
