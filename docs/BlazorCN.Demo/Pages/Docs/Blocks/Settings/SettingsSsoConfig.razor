@* ===========================================================
   Block: settings-sso-config
   Title: Settings Sso Config
   Description: SAML SSO with IdP setup, metadata URL, certificate, connection test, enforcement
   Dependencies: ButtonCn, InputCn, SwitchCn, TextareaCn
   Source: original/blocks/settings/settings-sso-config.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideLockCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                    <div>
                        <h2 class="font-medium text-sm">SSO Configuration</h2>
                        <p class="text-muted-foreground text-xs">Set up SAML single sign-on for your organization</p>
                    </div>
                </div>
                @if (_selectedProvider == "okta")
                {
                    <div class="flex items-center gap-1.5">
                        <span class="size-2 rounded-full bg-emerald-500"></span>
                        <span class="text-muted-foreground text-xs">Connected</span>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-1.5">
                        <span class="size-2 rounded-full bg-muted-foreground/40"></span>
                        <span class="text-muted-foreground text-xs">Not connected</span>
                    </div>
                }
            </div>
        </div>

        @* Provider selection *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Identity Provider</span>
            <div class="flex gap-2">
                @foreach (var provider in _providers)
                {
                    <button type="button"
                        @onclick="@(() => _selectedProvider = provider.Id)"
                        class="@Cn.Merge("flex items-center gap-2 rounded-md border px-3 py-2 text-left transition-colors", _selectedProvider == provider.Id ? "border-foreground/20 bg-muted/50" : "hover:bg-muted/30")">
                        <div>
                            <p class="font-medium text-sm">@provider.Name</p>
                            <p class="text-muted-foreground text-xs">@provider.Protocol</p>
                        </div>
                        @if (provider.Status == "connected")
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                    </button>
                }
            </div>
        </div>

        @* Connected provider info *@
        @if (_selectedProvider == "okta")
        {
            <div class="overflow-hidden border-b">
                <div class="px-4 py-3">
                    <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                        <LucideShieldCheckCn Size="16" Class="h-4 w-4 text-emerald-600" />
                        <div>
                            <p class="font-medium text-sm">Okta</p>
                            <p class="text-muted-foreground text-xs">Connected Mar 1, 2026</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* SAML Configuration - Expandable *@
        <div class="border-b">
            <button type="button"
                @onclick="@(() => _expandedSection = _expandedSection == "saml" ? null : "saml")"
                class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="font-medium text-sm">SAML Configuration</span>
                <LucideChevronRightCn Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expandedSection == "saml" ? "rotate-90" : "")" />
            </button>

            @if (_expandedSection == "saml")
            {
                <div class="overflow-hidden">
                    <div class="space-y-4 px-4 pb-4">
                        <div>
                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Metadata URL</span>
                            <InputCn aria-label="Metadata URL" @bind-Value="_metadataUrl" Class="h-8 font-mono text-xs" Placeholder="https://your-idp.com/metadata.xml" />
                            <p class="mt-1 text-muted-foreground text-xs">Paste your IdP metadata URL to auto-configure fields below</p>
                        </div>
                        <div>
                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">SSO URL</span>
                            <InputCn aria-label="SSO URL" @bind-Value="_ssoUrl" Class="h-8 font-mono text-xs" Placeholder="https://your-idp.com/sso/saml" />
                        </div>
                        <div>
                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Entity ID</span>
                            <InputCn aria-label="Entity ID" @bind-Value="_entityId" Class="h-8 font-mono text-xs" Placeholder="https://your-idp.com/entity-id" />
                        </div>
                        <div>
                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">X.509 Certificate</span>
                            <TextareaCn aria-label="X.509 Certificate" @bind-Value="_certificate" Class="min-h-[80px] resize-none font-mono text-xs" Placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----" />
                            <div class="mt-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                    <LucideUploadCn Size="14" Class="h-3.5 w-3.5" />
                                    Upload Certificate
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Enforcement settings *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Enforce SSO</p>
                        <p class="text-muted-foreground text-xs">Require all team members to authenticate via SSO</p>
                    </div>
                    <SwitchCn aria-label="Enforce SSO" @bind-Checked="_enforceSSO" />
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Allow IdP-initiated SSO</p>
                        <p class="text-muted-foreground text-xs">Users can sign in directly from the identity provider portal</p>
                    </div>
                    <SwitchCn aria-label="Allow IdP-initiated SSO" @bind-Checked="_allowIdpInitiated" />
                </div>
            </div>
        </div>

        @* Test result *@
        @if (_testResult == "success")
        {
            <div class="overflow-hidden border-b">
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2 rounded-md bg-emerald-500/10 p-3">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-emerald-600" />
                        <span class="font-medium text-emerald-700 text-xs dark:text-emerald-400">
                            Connection successful — SAML handshake verified
                        </span>
                    </div>
                </div>
            </div>
        }

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5 text-xs" Disabled="@_isTesting">
                    @if (_isTesting)
                    {
                        <LucideLoaderCircleCn Size="14" Class="h-3.5 w-3.5 animate-spin" />
                        <span>Testing...</span>
                    }
                    else
                    {
                        <LucideFlaskConicalCn Size="14" Class="h-3.5 w-3.5" />
                        <span>Test Connection</span>
                    }
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5 text-xs" Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <LucideLoaderCircleCn Size="14" Class="h-3.5 w-3.5 animate-spin" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <LucideSaveCn Size="14" Class="h-3.5 w-3.5" />
                        <span>Save Configuration</span>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SsoProvider(string Id, string Name, string Protocol, string Status);

    private static readonly List<SsoProvider> _providers =
    [
        new("okta", "Okta", "SAML 2.0", "connected"),
        new("azure", "Azure AD", "SAML 2.0", "disconnected"),
        new("google", "Google Workspace", "OIDC", "disconnected"),
    ];

    private string _selectedProvider = "okta";
    private string? _expandedSection = "saml";
    private string _metadataUrl = "https://acme.okta.com/app/abc123/sso/saml/metadata";
    private string _ssoUrl = "https://acme.okta.com/app/abc123/sso/saml";
    private string _entityId = "https://acme.okta.com/abc123";
    private string _certificate = "-----BEGIN CERTIFICATE-----\nMIIDpDCCAoygAwIBAgIGAX...\n-----END CERTIFICATE-----";
    private bool _enforceSSO = false;
    private bool _allowIdpInitiated = true;
    private bool _isTesting = false;
    private string? _testResult = null;
    private bool _isSaving = false;
}
