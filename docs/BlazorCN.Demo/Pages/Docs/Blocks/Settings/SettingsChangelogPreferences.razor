@* ===========================================================
   Block: settings-changelog-preferences
   Title: Settings Changelog Preferences
   Description: React animated changelog notification preferences settings block for Next.js with product area subscriptions, delivery frequency selector, release channel toggles, and digest preview using shadcn/ui, framer-motion, and Tailwind CSS
   Long Description: Alert conditions and notification channels
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-changelog-preferences.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideBookOpenCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                <div>
                    <h2 class="font-medium text-sm">Changelog Preferences</h2>
                    <p class="text-muted-foreground text-xs">Choose which product updates you want to hear about</p>
                </div>
            </div>
        </div>

        @* Frequency *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Delivery Frequency</span>
            <div class="flex gap-2">
                @foreach (var option in _frequencyOptions)
                {
                    <button type="button" @onclick="() => _frequency = option.Id"
                            class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-left transition-colors", _frequency == option.Id ? "border-foreground/20 bg-muted/50" : "hover:bg-muted/30")">
                        <p class="font-medium text-sm">@option.Label</p>
                        <p class="text-muted-foreground text-xs">@option.Desc</p>
                    </button>
                }
            </div>
        </div>

        @* Release channels *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Release Channels</span>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideRocketCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Stable</p>
                            <p class="text-muted-foreground text-xs">Production-ready releases</p>
                        </div>
                    </div>
                    <SwitchCn aria-label="Stable" @bind-Checked="_channelStable" />
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideSparklesCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Beta</p>
                            <p class="text-muted-foreground text-xs">Pre-release features for early adopters</p>
                        </div>
                    </div>
                    <SwitchCn aria-label="Beta" @bind-Checked="_channelBeta" />
                </div>
            </div>
        </div>

        @* Product areas *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Product Areas</span>
            <div class="space-y-1">
                @foreach (var area in _productAreas)
                {
                    <div class="flex items-center justify-between rounded-md px-2 py-2 transition-colors hover:bg-muted/30">
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@area.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-xs">@area.ChangeCount</BadgeCn>
                            </div>
                            <p class="text-muted-foreground text-xs">@area.Description</p>
                        </div>
                        <SwitchCn aria-label="@area.Name" Checked="area.Subscribed" CheckedChanged="() => area.Subscribed = !area.Subscribed" />
                    </div>
                }
            </div>
        </div>

        @* Breaking changes filter *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Breaking Changes Only</p>
                    <p class="text-muted-foreground text-xs">Only notify for breaking changes and deprecations</p>
                </div>
                <SwitchCn aria-label="Breaking Changes Only" @bind-Checked="_breakingOnly" />
            </div>
        </div>

        @* Recent changes preview *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Recent Changes</span>
            <div class="space-y-1">
                @foreach (var change in _recentChanges)
                {
                    <div class="flex items-center gap-3 rounded-md px-2 py-2 transition-colors hover:bg-muted/30">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", ChangeTypeDot(change.Type))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@change.Title</span>
                            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@change.Area</span>
                                <span>&middot;</span>
                                <span>@change.Date</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs", ChangeTypeColor(change.Type))">
                            @change.Type
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        @* Save *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5 text-xs" Disabled="_isSaving" OnClick="() => _isSaving = true">
                    @if (_isSaving)
                    {
                        <LucideLoaderCircleCn Size="14" Class="h-3.5 w-3.5 animate-spin" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <LucideSaveCn Size="14" Class="h-3.5 w-3.5" />
                        <span>Save Preferences</span>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _frequency = "daily";
    private bool _channelStable = true;
    private bool _channelBeta;
    private bool _breakingOnly;
    private bool _isSaving;

    private record FrequencyOption(string Id, string Label, string Desc);
    private record RecentChange(string Title, string Area, string Type, string Date);

    private class ProductArea
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public int ChangeCount { get; set; }
        public bool Subscribed { get; set; }
    }

    private static readonly FrequencyOption[] _frequencyOptions =
    [
        new("realtime", "Real-time", "Instant notifications"),
        new("daily", "Daily Digest", "Once per day"),
        new("weekly", "Weekly Digest", "Every Monday"),
    ];

    private readonly List<ProductArea> _productAreas =
    [
        new() { Name = "API", Description = "REST and GraphQL API changes", ChangeCount = 12, Subscribed = true },
        new() { Name = "Dashboard", Description = "Web dashboard features and UI updates", ChangeCount = 8, Subscribed = true },
        new() { Name = "CLI", Description = "Command-line tool updates", ChangeCount = 5, Subscribed = false },
        new() { Name = "Mobile", Description = "iOS and Android app changes", ChangeCount = 3, Subscribed = true },
        new() { Name = "Integrations", Description = "Third-party integration updates", ChangeCount = 6, Subscribed = false },
        new() { Name = "Security", Description = "Security patches and advisories", ChangeCount = 2, Subscribed = true },
    ];

    private static readonly RecentChange[] _recentChanges =
    [
        new("New batch endpoint for bulk operations", "API", "feature", "2 days ago"),
        new("Improved table sorting performance", "Dashboard", "improvement", "3 days ago"),
        new("Deprecated v1 authentication tokens", "API", "breaking", "5 days ago"),
        new("Fixed push notification delivery on iOS 18", "Mobile", "fix", "1 week ago"),
    ];

    private static string ChangeTypeColor(string type) => type switch
    {
        "feature" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "improvement" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "fix" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "breaking" => "bg-red-500/10 text-red-700 dark:text-red-400",
        _ => "",
    };

    private static string ChangeTypeDot(string type) => type switch
    {
        "feature" => "bg-blue-500",
        "improvement" => "bg-emerald-500",
        "fix" => "bg-amber-500",
        "breaking" => "bg-red-500",
        _ => "bg-muted-foreground",
    };
}
