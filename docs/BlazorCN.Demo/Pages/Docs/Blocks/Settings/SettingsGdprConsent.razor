@* ===========================================================
   Block: settings-gdpr-consent
   Title: Settings Gdpr Consent
   Description: GDPR consent management with purpose-based consent toggles, data retention policies, data subject rights actions, and legal basis display
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideDownloadCn, LucideFileTextCn, LucideShieldCn, LucideTrash2Cn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-gdpr-consent.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">GDPR &amp; Consent</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Manage data processing consent and exercise your data subject rights
            </p>
        </div>

        @* Consent purposes *@
        @foreach (var consent in _consents)
        {
            var consentId = consent.Id;
            <div class="flex items-start justify-between border-b px-4 py-4">
                <div class="min-w-0 flex-1 pr-4">
                    <div class="flex items-center gap-2">
                        <p class="text-sm font-medium">@consent.Title</p>
                        @if (consent.Required)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                Required
                            </BadgeCn>
                        }
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@consent.Description</p>
                    <p class="mt-1 font-mono text-xs text-muted-foreground">
                        Legal basis: @consent.LegalBasis
                    </p>
                </div>
                <SwitchCn Checked="@consent.Enabled"
                          Disabled="@consent.Required"
                          CheckedChanged="@(_ => ToggleConsent(consentId))" />
            </div>
        }

        @* Data retention *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Data retention period</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    How long personal data is stored after account closure
                </p>
            </div>
            <SelectCn TValue="string" Value="@_retention" ValueChanged="v => _retention = v">
                <SelectTriggerCn Class="h-8 w-40 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="6">6 months</SelectItemCn>
                    <SelectItemCn Value="12">12 months</SelectItemCn>
                    <SelectItemCn Value="24">24 months</SelectItemCn>
                    <SelectItemCn Value="36">36 months</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Data subject rights header *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Data subject rights</p>
        </div>

        @* Data subject rights *@
        @foreach (var right in _dataRights)
        {
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    @if (right.Icon == "download")
                    {
                        <LucideDownloadCn Size="16" Class="size-4 text-muted-foreground" />
                    }
                    else if (right.Icon == "file")
                    {
                        <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                    }
                    else if (right.Icon == "trash")
                    {
                        <LucideTrash2Cn Size="16" Class="size-4 text-muted-foreground" />
                    }
                    <div>
                        <p class="text-sm font-medium">@right.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@right.Description</p>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="@($"h-7 text-xs {(right.Destructive ? "text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300" : "")}")">
                    Request
                </ButtonCn>
            </div>
        }

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                    <LucideCheckCn Size="16" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                      @onclick="HandleSave">
                Save preferences
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class ConsentPurpose
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string LegalBasis { get; set; } = "";
        public bool Required { get; set; }
        public bool Enabled { get; set; }
    }

    private record DataRight(string Id, string Title, string Description, string Article, string Icon, bool Destructive = false);

    private string _retention = "24";
    private bool _saved;

    private List<ConsentPurpose> _consents = new()
    {
        new() { Id = "essential", Title = "Essential services", Description = "Required for core functionality, authentication, and security", LegalBasis = "Legitimate interest", Required = true, Enabled = true },
        new() { Id = "analytics", Title = "Analytics & performance", Description = "Anonymized usage data to improve product experience", LegalBasis = "Consent", Required = false, Enabled = true },
        new() { Id = "marketing", Title = "Marketing communications", Description = "Product updates, newsletters, and promotional content", LegalBasis = "Consent", Required = false, Enabled = false },
        new() { Id = "personalization", Title = "Personalization", Description = "Tailored recommendations and content based on usage patterns", LegalBasis = "Consent", Required = false, Enabled = true },
        new() { Id = "third-party", Title = "Third-party sharing", Description = "Share data with trusted partners for integrated services", LegalBasis = "Consent", Required = false, Enabled = false },
    };

    private static readonly DataRight[] _dataRights =
    [
        new("access", "Download my data", "Export a copy of all your personal data (Article 15)", "Art. 15", "download"),
        new("portability", "Data portability", "Receive your data in a machine-readable format (Article 20)", "Art. 20", "file"),
        new("erasure", "Delete my data", "Request permanent deletion of all personal data (Article 17)", "Art. 17", "trash", true),
    ];

    private void ToggleConsent(string id)
    {
        var consent = _consents.FirstOrDefault(c => c.Id == id);
        if (consent != null && !consent.Required)
            consent.Enabled = !consent.Enabled;
    }

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
