@* ===========================================================
   Block: settings-custom-domain
   Title: Settings Custom Domain
   Description: Custom domains with DNS records, SSL status, verification
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-custom-domain.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h2 class="font-medium text-sm">Custom Domains</h2>
                    <p class="text-muted-foreground text-xs">Connect your own domain to this workspace</p>
                </div>
            </div>
        </div>

        @* Add domain *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn aria-label="Enter domain" @bind-Value="_newDomain" Placeholder="Enter domain, e.g. app.example.com" Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0 text-sm" />
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 gap-1 text-xs" Disabled="@(string.IsNullOrWhiteSpace(_newDomain))">
                <LucidePlusCn Size="12" Class="size-3" />
                Add
            </ButtonCn>
        </div>

        @* Domains list *@
        <div>
            @for (var i = 0; i < _domains.Count; i++)
            {
                var domain = _domains[i];
                var isLast = i == _domains.Count - 1;
                var isExpanded = _expanded == domain.Id;
                var dotClass = domain.Status == "verified" ? "bg-emerald-500" : domain.Status == "failed" ? "bg-red-500" : "bg-amber-500";
                var statusLabel = domain.Status == "verified" ? "Verified" : domain.Status == "failed" ? "Failed" : "Pending verification";
                var sslLabel = domain.Ssl == "active" ? "SSL Active" : domain.Ssl == "provisioning" ? "Provisioning..." : "Pending";
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : domain.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dotClass)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-mono font-medium text-sm">@domain.Name</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@statusLabel</span>
                                <span>·</span>
                                <span>@sslLabel</span>
                            </div>
                        </div>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-9">
                                <p class="mb-2 font-medium text-muted-foreground text-xs">DNS RECORDS</p>
                                <div class="space-y-2">
                                    @foreach (var record in domain.Records)
                                    {
                                        <div class="rounded-md bg-muted/50 p-2.5">
                                            <div class="flex items-center justify-between">
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">@record.Type</BadgeCn>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1.5 text-[10px]">
                                                    <LucideCopyCn Size="10" Class="size-2.5" />
                                                    Copy
                                                </ButtonCn>
                                            </div>
                                            <div class="mt-1.5 grid grid-cols-2 gap-x-3 text-xs">
                                                <div>
                                                    <span class="text-muted-foreground">Name</span>
                                                    <p class="font-mono text-foreground">@record.Name</p>
                                                </div>
                                                <div>
                                                    <span class="text-muted-foreground">Value</span>
                                                    <p class="truncate font-mono text-foreground">@record.Value</p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="mt-3 flex items-center gap-2">
                                    @if (domain.Status == "pending")
                                    {
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-6 gap-1 px-2 text-xs" Disabled="@(_verifying == domain.Id)">
                                            @if (_verifying == domain.Id)
                                            {
                                                <LucideLoaderCircleCn Size="12" Class="size-3 animate-spin" />
                                                <span>Verifying...</span>
                                            }
                                            else
                                            {
                                                <LucideRefreshCwCn Size="12" Class="size-3" />
                                                <span>Verify DNS</span>
                                            }
                                        </ButtonCn>
                                    }
                                    @if (domain.Status == "verified")
                                    {
                                        <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                                            <LucideCircleCheckBigCn Size="12" Class="size-3" />
                                            DNS verified
                                        </span>
                                    }
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-red-600 text-xs hover:text-red-600">
                                        <LucideTrash2Cn Size="12" Class="size-3" />
                                        Remove
                                    </ButtonCn>
                                    <span class="ml-auto text-muted-foreground text-xs">Added @domain.AddedAt</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_domains.Count == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                    No custom domains configured. Add one above.
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DnsRecord(string Type, string Name, string Value);
    private record DomainItem(string Id, string Name, string Status, string Ssl, string AddedAt, List<DnsRecord> Records);

    private static readonly List<DomainItem> _domains =
    [
        new("d-1", "app.acme.com", "verified", "active", "Mar 1, 2026",
        [
            new("CNAME", "app", "cname.acme-hosting.com"),
        ]),
        new("d-2", "docs.acme.com", "pending", "provisioning", "Mar 15, 2026",
        [
            new("CNAME", "docs", "cname.acme-hosting.com"),
            new("TXT", "_acme-challenge.docs", "verify_abc123xyz"),
        ]),
    ];

    private string _newDomain = "";
    private string? _expanded = "d-2";
    private string? _verifying = null;
}
