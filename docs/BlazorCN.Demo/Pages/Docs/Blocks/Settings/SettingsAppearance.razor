@* ===========================================================
   Block: settings-appearance
   Title: Settings Appearance
   Description: Animated React appearance settings page for Next.js with theme toggle for light dark and system modes, font size slider, UI density selector, and accent color picker built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-appearance.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Appearance</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Customize the look, feel, and accessibility of your interface
            </p>
        </div>

        @* Theme *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 font-medium text-sm">Theme</p>
            <div class="flex gap-2">
                @foreach (var option in _themeOptions)
                {
                    var isActive = _theme == option.Value;
                    <button type="button" @onclick="() => _theme = option.Value"
                            class="@Cn.Merge("flex flex-1 items-center justify-center gap-2 rounded-md border px-3 py-2 transition-colors", isActive ? "border-foreground/20 bg-muted/50" : "border-transparent hover:bg-muted/30")">
                        @if (option.Value == "light")
                        {
                            <LucideSunCn Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        else if (option.Value == "dark")
                        {
                            <LucideMoonCn Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideMonitorCn Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        <span class="text-sm">@option.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Accent color *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 font-medium text-sm">Accent color</p>
            <div class="flex gap-3">
                @foreach (var color in _accentColors)
                {
                    <button type="button" @onclick="() => _accent = color.Value"
                            class="group flex flex-col items-center gap-1.5">
                        <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-full transition-transform group-hover:scale-110", color.ClassName)">
                            @if (_accent == color.Value)
                            {
                                <LucideCheckCn Size="14" Class="size-3.5 text-white" />
                            }
                        </div>
                        <span class="text-muted-foreground text-xs">@color.Name</span>
                    </button>
                }
            </div>
        </div>

        @* Font size *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 font-medium text-sm">Font size</p>
            <div class="flex gap-2">
                @foreach (var option in _fontSizeOptions)
                {
                    var isActive = _fontSize == option.Value;
                    <button type="button" @onclick="() => _fontSize = option.Value"
                            class="@Cn.Merge("flex flex-1 flex-col items-center gap-1 rounded-md border px-3 py-2.5 transition-colors", isActive ? "border-foreground/20 bg-muted/50" : "border-transparent hover:bg-muted/30")">
                        <span class="@Cn.Merge("font-medium", FontSizeClass(option.Value))">Aa</span>
                        <span class="text-muted-foreground text-xs">@option.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Density *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 font-medium text-sm">Density</p>
            <div class="space-y-1">
                @foreach (var option in _densityOptions)
                {
                    var isActive = _density == option.Value;
                    <button type="button" @onclick="() => _density = option.Value"
                            class="@Cn.Merge("flex w-full items-center justify-between rounded-md px-3 py-2 text-left transition-colors", isActive ? "bg-muted/50" : "hover:bg-muted/30")">
                        <div>
                            <span class="font-medium text-sm">@option.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@option.Description</p>
                        </div>
                        @if (isActive)
                        {
                            <LucideCheckCn Size="16" Class="size-4 shrink-0 text-foreground" />
                        }
                    </button>
                }
            </div>
        </div>

        @* Reduce motion *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Reduce motion</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Minimize animations throughout the interface
                </p>
            </div>
            <SwitchCn @bind-Checked="_reduceMotion" />
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _saved = true">
                Save preferences
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _theme = "system";
    private string _density = "comfortable";
    private string _fontSize = "default";
    private string _accent = "zinc";
    private bool _reduceMotion;
    private bool _saved;

    private record ThemeOption(string Value, string Label);
    private record AccentColor(string Name, string Value, string ClassName);
    private record FontSizeOption(string Value, string Label);
    private record DensityOption(string Value, string Label, string Description);

    private static readonly ThemeOption[] _themeOptions =
    [
        new("light", "Light"),
        new("dark", "Dark"),
        new("system", "System"),
    ];

    private static readonly AccentColor[] _accentColors =
    [
        new("Zinc", "zinc", "bg-zinc-900 dark:bg-zinc-100"),
        new("Blue", "blue", "bg-blue-600"),
        new("Green", "green", "bg-emerald-600"),
        new("Orange", "orange", "bg-orange-600"),
        new("Rose", "rose", "bg-rose-600"),
        new("Violet", "violet", "bg-violet-600"),
    ];

    private static readonly FontSizeOption[] _fontSizeOptions =
    [
        new("small", "Small"),
        new("default", "Default"),
        new("large", "Large"),
    ];

    private static readonly DensityOption[] _densityOptions =
    [
        new("compact", "Compact", "Reduced spacing for information density"),
        new("comfortable", "Comfortable", "Default balanced spacing"),
        new("spacious", "Spacious", "Increased spacing for readability"),
    ];

    private static string FontSizeClass(string value) => value switch
    {
        "small" => "text-xs",
        "large" => "text-base",
        _ => "text-sm",
    };
}
