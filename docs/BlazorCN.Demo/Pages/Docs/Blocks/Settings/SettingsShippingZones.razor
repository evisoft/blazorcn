@* ===========================================================
   Block: settings-shipping-zones
   Title: Settings Shipping Zones
   Description: Animated React shipping zone configuration page for Next.js with region management, rate tables, carrier selection, and free shipping thresholds built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Plan, payment method, and invoices
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-shipping-zones.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Shipping Zones</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Configure regions, carriers, and shipping rates
                    </p>
                </div>
            </div>
            <span class="text-muted-foreground text-xs">
                @_zones.Count(z => z.Enabled) active zone@(_zones.Count(z => z.Enabled) != 1 ? "s" : "")
            </span>
        </div>

        @* Zones list *@
        <div>
            @for (var i = 0; i < _zones.Count; i++)
            {
                var zone = _zones[i];
                var index = i;
                var isExpanded = _expanded == zone.Id;
                var isLast = index == _zones.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <button type="button" @onclick="() => _expanded = isExpanded ? null : zone.Id"
                                class="flex min-w-0 flex-1 items-center gap-3 text-left">
                            <LucideTruckCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("font-medium text-sm", !zone.Enabled ? "text-muted-foreground" : "")">
                                    @zone.Name
                                </span>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@zone.Regions.Count region@(zone.Regions.Count != 1 ? "s" : "")</span>
                                    <span>&middot;</span>
                                    <span>@(_carriers.FirstOrDefault(c => c.Value == zone.Carrier)?.Label)</span>
                                    <span>&middot;</span>
                                    <span>@zone.Rates.Count rate@(zone.Rates.Count != 1 ? "s" : "")</span>
                                </div>
                            </div>
                            <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                        <SwitchCn aria-label="@zone.Name" @bind-Checked="zone.Enabled" />
                    </div>

                    @if (isExpanded)
                    {
                        <div class="space-y-4 px-4 pb-4 pl-11">
                            @* Regions *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Regions
                                </span>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var region in zone.Regions)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            @region
                                        </BadgeCn>
                                    }
                                </div>
                            </div>

                            @* Carrier *@
                            <div>
                                <span class="mb-1 block font-medium text-muted-foreground text-xs">
                                    Carrier
                                </span>
                                <SelectCn @bind-Value="zone.Carrier">
                                    <SelectTriggerCn aria-label="@($"{zone.Name} carrier")" Class="h-8 text-xs">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        @foreach (var c in _carriers)
                                        {
                                            <SelectItemCn Value="@c.Value">@c.Label</SelectItemCn>
                                        }
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            @* Rates *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Shipping rates
                                </span>
                                <div class="space-y-2">
                                    @foreach (var rate in zone.Rates)
                                    {
                                        <div class="flex items-center gap-3 rounded-md bg-muted/30 px-3 py-2">
                                            <div class="min-w-0 flex-1">
                                                <span class="font-medium text-sm">@rate.Name</span>
                                                <span class="ml-2 text-muted-foreground text-xs">
                                                    @rate.EstimatedDays days
                                                </span>
                                            </div>
                                            <div class="flex items-center gap-1">
                                                <span class="text-muted-foreground text-xs">$</span>
                                                <InputCn aria-label="@($"{rate.Name} price")" @bind-Value="rate.Price"
                                                         Class="h-7 w-20 text-right font-mono text-xs" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Free shipping *@
                            <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                                <div class="flex items-center gap-2">
                                    <SwitchCn aria-label="Free shipping" @bind-Checked="zone.FreeShippingEnabled" />
                                    <span class="text-sm">Free shipping over</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="text-muted-foreground text-xs">$</span>
                                    <InputCn aria-label="Free shipping over" @bind-Value="zone.FreeShippingThreshold"
                                             Class="h-7 w-20 text-right font-mono text-xs"
                                             Disabled="@(!zone.FreeShippingEnabled)" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add zone
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_saved)
                {
                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideCheckCn Size="12" Class="size-3" />
                        Saved
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private bool _saved;

    private record CarrierOption(string Value, string Label);

    private static readonly List<CarrierOption> _carriers = new()
    {
        new("usps", "USPS"), new("ups", "UPS"), new("fedex", "FedEx"),
        new("dhl", "DHL"), new("custom", "Custom rates"),
    };

    private class ShippingRate
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Price { get; set; } = "";
        public string EstimatedDays { get; set; } = "";
    }

    private class ShippingZone
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public List<string> Regions { get; set; } = new();
        public string Carrier { get; set; } = "";
        public bool Enabled { get; set; }
        public string FreeShippingThreshold { get; set; } = "";
        public bool FreeShippingEnabled { get; set; }
        public List<ShippingRate> Rates { get; set; } = new();
    }

    private readonly List<ShippingZone> _zones = new()
    {
        new() { Id = "z1", Name = "Domestic", Regions = new() { "United States", "Puerto Rico", "US Virgin Islands" }, Carrier = "usps", Enabled = true, FreeShippingThreshold = "75", FreeShippingEnabled = true, Rates = new() { new() { Id = "r1", Name = "Standard", Price = "5.99", EstimatedDays = "5-7" }, new() { Id = "r2", Name = "Express", Price = "12.99", EstimatedDays = "2-3" }, new() { Id = "r3", Name = "Overnight", Price = "24.99", EstimatedDays = "1" } } },
        new() { Id = "z2", Name = "Canada", Regions = new() { "Canada" }, Carrier = "ups", Enabled = true, FreeShippingThreshold = "150", FreeShippingEnabled = false, Rates = new() { new() { Id = "r4", Name = "Standard", Price = "14.99", EstimatedDays = "7-12" }, new() { Id = "r5", Name = "Express", Price = "29.99", EstimatedDays = "3-5" } } },
        new() { Id = "z3", Name = "Europe", Regions = new() { "United Kingdom", "Germany", "France", "Netherlands", "Spain" }, Carrier = "dhl", Enabled = true, FreeShippingThreshold = "200", FreeShippingEnabled = false, Rates = new() { new() { Id = "r6", Name = "Standard", Price = "19.99", EstimatedDays = "10-15" }, new() { Id = "r7", Name = "Express", Price = "39.99", EstimatedDays = "5-7" } } },
        new() { Id = "z4", Name = "Asia-Pacific", Regions = new() { "Japan", "Australia", "South Korea", "Singapore" }, Carrier = "fedex", Enabled = false, FreeShippingThreshold = "250", FreeShippingEnabled = false, Rates = new() { new() { Id = "r8", Name = "Standard", Price = "24.99", EstimatedDays = "12-20" }, new() { Id = "r9", Name = "Express", Price = "49.99", EstimatedDays = "5-8" } } },
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
