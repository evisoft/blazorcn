@* ===========================================================
   Block: settings-waitlist-config
   Title: Settings Waitlist Config
   Description: Animated React waitlist configuration settings page for Next.js with capacity limits, invite batch size, priority rules, and signup status using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Invite links and domain restrictions
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-waitlist-config.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Waitlist</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Capacity, invite batching, and priority rules
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_enabled)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <span class="mr-1.5 size-1.5 rounded-full bg-emerald-500"></span>
                        Active
                    </BadgeCn>
                }
                else
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Paused
                    </BadgeCn>
                }
                <SwitchCn @bind-Checked="_enabled" />
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">4,328 total</span>
            </div>
            <span class="text-muted-foreground text-xs">
                <span class="font-medium tabular-nums text-foreground">3,078</span>
                waiting
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="font-medium tabular-nums text-foreground">1,250</span>
                invited
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="font-medium tabular-nums text-foreground">980</span>
                accepted
            </span>
        </div>

        @* Capacity and batching *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Total capacity</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Maximum number of active users allowed
                        </p>
                    </div>
                    <InputCn @bind-Value="_capacity" Class="h-8 w-24 text-center text-xs" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Invite batch size</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Number of invites sent per batch
                        </p>
                    </div>
                    <InputCn @bind-Value="_batchSize" Class="h-8 w-20 text-center text-xs" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Auto-invite</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Automatically send invites on a schedule
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_autoInvite" />
                </div>

                @if (_autoInvite)
                {
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-sm">Invite frequency</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                How often to send invite batches
                            </p>
                        </div>
                        <SelectCn @bind-Value="_inviteFrequency">
                            <SelectTriggerCn Class="h-8 w-28 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="@("hourly")">Hourly</SelectItemCn>
                                <SelectItemCn Value="@("daily")">Daily</SelectItemCn>
                                <SelectItemCn Value="@("weekly")">Weekly</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                }
            </div>
        </div>

        @* Priority rules *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-3">
                <span class="font-medium text-sm">Priority rules</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add rule
                </ButtonCn>
            </div>

            @foreach (var rule in _rules)
            {
                var ruleId = rule.Id;
                var isExpanded = _expandedRule == rule.Id;

                <div>
                    <button type="button" @onclick="() => _expandedRule = isExpanded ? null : ruleId"
                            class="flex w-full items-center gap-3 border-t px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", rule.Enabled ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@rule.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                +@rule.Bonus priority points
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@rule.Condition</p>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-muted-foreground text-xs">Enabled</span>
                                <SwitchCn @bind-Checked="rule.Enabled" />
                            </div>
                            <div class="flex justify-end">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                          Class="h-7 gap-1 text-red-600 text-xs hover:text-red-700"
                                          OnClick="() => RemoveRule(ruleId)">
                                    <LucideTrashCn Size="12" Class="size-3" />
                                    Remove
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _enabled = true;
    private string _capacity = "10000";
    private string _batchSize = "50";
    private bool _autoInvite = true;
    private string _inviteFrequency = "daily";
    private string? _expandedRule;
    private bool _saved;

    private class PriorityRule
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Condition { get; set; } = "";
        public int Bonus { get; set; }
        public bool Enabled { get; set; }
    }

    private readonly List<PriorityRule> _rules = new()
    {
        new() { Id = "1", Name = "Referral bonus", Condition = "User was referred by an existing member", Bonus = 50, Enabled = true },
        new() { Id = "2", Name = "Enterprise domain", Condition = "Email domain matches Fortune 500 list", Bonus = 100, Enabled = true },
        new() { Id = "3", Name = "Newsletter subscriber", Condition = "User is subscribed to the product newsletter", Bonus = 20, Enabled = false },
        new() { Id = "4", Name = "Beta tester", Condition = "User participated in a previous beta program", Bonus = 75, Enabled = true },
    };

    private void RemoveRule(string id)
    {
        _rules.RemoveAll(r => r.Id == id);
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
