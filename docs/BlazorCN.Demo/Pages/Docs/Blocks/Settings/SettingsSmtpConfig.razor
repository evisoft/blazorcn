@* ===========================================================
   Block: settings-smtp-config
   Title: Settings Smtp Config
   Description: SMTP host/port, auth credentials, TLS, sender identity, send test email
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-smtp-config.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">SMTP Configuration</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Configure outbound email delivery settings</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideShieldCheckCn Size="12" Class="size-3" />
                TLS
            </BadgeCn>
        </div>

        @* Server settings *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Server settings</span>
            <div class="space-y-3">
                <div>
                    <span class="mb-1 block font-medium text-muted-foreground text-xs">SMTP host</span>
                    <InputCn @bind-Value="_host" Class="h-8 font-mono text-sm" Placeholder="smtp.example.com" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">Port</span>
                        <InputCn @bind-Value="_port" Class="h-8 font-mono text-sm" Placeholder="465" />
                    </div>
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">Encryption</span>
                        <SelectCn @bind-Value="_encryption">
                            <SelectTriggerCn Class="h-8 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="tls">TLS (recommended)</SelectItemCn>
                                <SelectItemCn Value="starttls">STARTTLS</SelectItemCn>
                                <SelectItemCn Value="none">None</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
            </div>
        </div>

        @* Authentication *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Authentication</span>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">@(_authEnabled ? "Enabled" : "Disabled")</span>
                    <SwitchCn @bind-Checked="_authEnabled" />
                </div>
            </div>
            @if (_authEnabled)
            {
                <div class="space-y-3">
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">Username</span>
                        <InputCn @bind-Value="_username" Class="h-8 font-mono text-sm" Placeholder="your-username" />
                    </div>
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">Password</span>
                        <div class="relative">
                            <InputCn type="@(_showPassword ? "text" : "password")" @bind-Value="_password" Class="h-8 pr-8 font-mono text-sm" />
                            <button type="button"
                                @onclick="@(() => _showPassword = !_showPassword)"
                                class="absolute right-2 top-1/2 -translate-y-1/2 text-muted-foreground transition-colors hover:text-foreground">
                                @if (_showPassword)
                                {
                                    <LucideEyeOffCn Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideEyeCn Size="14" Class="size-3.5" />
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Sender identity *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Sender identity</span>
            <div class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">From name</span>
                        <InputCn @bind-Value="_fromName" Class="h-8 text-sm" Placeholder="Your App" />
                    </div>
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">From email</span>
                        <InputCn @bind-Value="_fromEmail" Class="h-8 font-mono text-sm" Placeholder=@("noreply@example.com") />
                    </div>
                </div>
                <div>
                    <span class="mb-1 block font-medium text-muted-foreground text-xs">Reply-to address</span>
                    <InputCn @bind-Value="_replyTo" Class="h-8 font-mono text-sm" Placeholder=@("support@example.com") />
                </div>
            </div>
        </div>

        @* Test email *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Send test email</span>
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_testEmail" Class="h-8 font-mono text-sm" Placeholder=@("test@example.com") />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 text-xs" Disabled="@(_testStatus == "sending")">
                    @if (_testStatus == "sending")
                    {
                        <span>Sending...</span>
                    }
                    else if (_testStatus == "success")
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <span>Sent</span>
                    }
                    else
                    {
                        <LucideSendCn Size="12" Class="size-3" />
                        <span>Send test</span>
                    }
                </ButtonCn>
            </div>
            @if (_testStatus == "success")
            {
                <p class="mt-2 text-emerald-600 text-xs dark:text-emerald-400">
                    Test email delivered successfully to @_testEmail
                </p>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _host = "smtp.sendgrid.net";
    private string _port = "465";
    private string _encryption = "tls";
    private string _username = "apikey";
    private string _password = "SG.xxxxxxxxxxxxxxxxxxxxx";
    private string _fromName = "Acme";
    private string _fromEmail = "noreply@acme.com";
    private string _replyTo = "support@acme.com";
    private bool _showPassword = false;
    private bool _authEnabled = true;
    private string _testEmail = "admin@acme.com";
    private string _testStatus = "idle";
    private bool _saved = false;
}
