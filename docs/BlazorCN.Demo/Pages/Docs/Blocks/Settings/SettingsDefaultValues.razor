@* ===========================================================
   Block: settings-default-values
   Title: Settings Default Values
   Description: Animated React default values configuration page for Next.js with type-specific inputs for text, number, select, boolean, and date fields built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Custom field builder with drag ordering
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-default-values.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Default Values</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Set default values for forms, invoices, and documents</p>
            </div>
            @{ var modifiedCount = _fields.Count(f => f.Value != f.OriginalValue); }
            @if (modifiedCount > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@modifiedCount modified</BadgeCn>
            }
        </div>

        @* Fields *@
        @for (var i = 0; i < _fields.Count; i++)
        {
            var field = _fields[i];
            var isModified = field.Value != field.OriginalValue;
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between gap-4">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            @if (isModified)
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                            }
                            <span class="font-medium text-sm">@field.Label</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@field.Description</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        @if (field.Type == "text")
                        {
                            <InputCn Value="@field.Value" ValueChanged="@((string v) => { field.Value = v; })" Class="h-8 w-48 text-xs" />
                        }
                        else if (field.Type == "number")
                        {
                            <InputCn type="number" Value="@field.Value" ValueChanged="@((string v) => { field.Value = v; })" Class="h-8 w-24 text-xs tabular-nums" />
                        }
                        else if (field.Type == "date")
                        {
                            <InputCn type="date" Value="@field.Value" ValueChanged="@((string v) => { field.Value = v; })" Class="h-8 w-40 text-xs" />
                        }
                        else if (field.Type == "boolean")
                        {
                            <SwitchCn Checked="@(field.Value == "true")" CheckedChanged="@((bool v) => { field.Value = v.ToString().ToLowerInvariant(); })" />
                        }
                        else if (field.Type == "select" && field.Options != null)
                        {
                            <SelectCn Value="@field.Value" ValueChanged="@((string v) => { field.Value = v; })">
                                <SelectTriggerCn Class="h-8 w-32 text-xs">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var opt in field.Options)
                                    {
                                        <SelectItemCn Value="@opt">@(LanguageLabel(opt))</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                        }
                        @if (isModified)
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2" OnClick="() => field.Value = field.OriginalValue">
                                <LucideRotateCcwCn Size="12" Class="size-3" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>
        }

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _saved = true">
                Save defaults
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _saved;

    private class DefaultField
    {
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public string Type { get; set; } = "";
        public string Value { get; set; } = "";
        public string OriginalValue { get; set; } = "";
        public string[]? Options { get; set; }
    }

    private readonly List<DefaultField> _fields =
    [
        new() { Label = "Default Currency", Description = "Currency used for new invoices and pricing", Type = "select", Value = "USD", OriginalValue = "USD", Options = ["USD", "EUR", "GBP", "JPY", "CAD", "AUD"] },
        new() { Label = "Tax Rate", Description = "Default tax percentage applied to line items", Type = "number", Value = "8.5", OriginalValue = "8.5" },
        new() { Label = "Invoice Prefix", Description = "Prefix prepended to all invoice numbers", Type = "text", Value = "INV-", OriginalValue = "INV-" },
        new() { Label = "Auto-send Receipts", Description = "Automatically email receipts after payment", Type = "boolean", Value = "true", OriginalValue = "true" },
        new() { Label = "Due Date Offset", Description = "Days from invoice creation until payment is due", Type = "number", Value = "30", OriginalValue = "30" },
        new() { Label = "Default Language", Description = "Language for auto-generated documents and emails", Type = "select", Value = "en", OriginalValue = "en", Options = ["en", "es", "fr", "de", "ja", "pt"] },
        new() { Label = "Payment Terms", Description = "Default payment terms text shown on invoices", Type = "text", Value = "Net 30. Late payments subject to 1.5% monthly interest.", OriginalValue = "Net 30. Late payments subject to 1.5% monthly interest." },
        new() { Label = "Fiscal Year Start", Description = "Start date for the fiscal year in reports", Type = "date", Value = "2026-01-01", OriginalValue = "2026-01-01" },
    ];

    private static readonly Dictionary<string, string> _languageLabels = new()
    {
        ["en"] = "English",
        ["es"] = "Spanish",
        ["fr"] = "French",
        ["de"] = "German",
        ["ja"] = "Japanese",
        ["pt"] = "Portuguese",
    };

    private static string LanguageLabel(string code) => _languageLabels.GetValueOrDefault(code, code);
}
