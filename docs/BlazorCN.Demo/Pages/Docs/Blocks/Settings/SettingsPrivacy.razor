@* ===========================================================
   Block: settings-privacy
   Title: Settings Privacy
   Description: Animated React privacy settings page for Next.js with data sharing toggles, cookie preferences by category, data export request, and account data deletion built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Password, 2FA, and session management
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-privacy.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">Privacy</p>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Control how your data is collected, used, and shared
            </p>
        </div>

        @* Data sharing section *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Data sharing</p>
        </div>
        @foreach (var option in _dataSharing)
        {
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="min-w-0 flex-1 pr-4">
                    <p class="font-medium text-sm">@option.Label</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">@option.Description</p>
                </div>
                <SwitchCn @bind-Checked="option.Enabled" />
            </div>
        }

        @* Cookie preferences section *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Cookie preferences</p>
        </div>
        @foreach (var category in _cookies)
        {
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="min-w-0 flex-1 pr-4">
                    <div class="flex items-center gap-2">
                        <p class="font-medium text-sm">@category.Label</p>
                        @if (category.Required)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                Required
                            </BadgeCn>
                        }
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @category.CookieCount @(category.CookieCount == 1 ? "cookie" : "cookies")
                        </span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@category.Description</p>
                </div>
                <SwitchCn @bind-Checked="category.Enabled" Disabled="category.Required" />
            </div>
        }

        @* Data export *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Export your data</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Download a copy of all your personal data as JSON
                </p>
            </div>
            @if (_exportRequested)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Request sent
                </span>
            }
            else
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="() => _exportRequested = true">
                    <LucideDownloadCn Size="12" Class="size-3" />
                    Request export
                </ButtonCn>
            }
        </div>

        @* Delete data *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <div class="flex items-center gap-2">
                    <p class="font-medium text-sm">Delete all data</p>
                    <LucideTriangleAlertCn Size="12" Class="size-3 text-red-500" />
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Permanently remove all personal data. This cannot be undone.
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-red-600 text-xs dark:text-red-400">
                <LucideTrashCn Size="12" Class="size-3" />
                Delete data
            </ButtonCn>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save preferences
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _saved;
    private bool _exportRequested;

    private class DataSharingOption
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class CookieCategory
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
        public bool Required { get; set; }
        public int CookieCount { get; set; }
    }

    private readonly List<DataSharingOption> _dataSharing = new()
    {
        new() { Id = "usage-analytics", Label = "Usage analytics", Description = "Help us improve by sharing anonymized usage patterns", Enabled = true },
        new() { Id = "crash-reports", Label = "Crash reports", Description = "Automatically send error reports to help fix issues faster", Enabled = true },
        new() { Id = "personalization", Label = "Personalization", Description = "Use your activity to personalize recommendations and content", Enabled = false },
        new() { Id = "third-party", Label = "Third-party sharing", Description = "Allow sharing anonymized data with trusted analytics partners", Enabled = false },
    };

    private readonly List<CookieCategory> _cookies = new()
    {
        new() { Id = "essential", Label = "Essential", Description = "Required for authentication, security, and core features", Enabled = true, Required = true, CookieCount = 4 },
        new() { Id = "analytics", Label = "Analytics", Description = "Track page views, clicks, and feature usage for improvements", Enabled = true, CookieCount = 3 },
        new() { Id = "marketing", Label = "Marketing", Description = "Used for targeted advertising and campaign measurement", Enabled = false, CookieCount = 6 },
        new() { Id = "preferences", Label = "Preferences", Description = "Remember your settings, language, and display preferences", Enabled = true, CookieCount = 2 },
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
