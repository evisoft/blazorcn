@* ===========================================================
   Block: settings-timezone-calendar
   Title: Settings Timezone Calendar
   Description: Animated React timezone and calendar settings block for Next.js with working hours grid, week start day, holiday management, and date format preferences built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-timezone-calendar.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Timezone &amp; calendar</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Set your timezone, working hours, and calendar preferences
            </p>
        </div>

        @* Timezone *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Timezone</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Your local timezone for scheduling</p>
            </div>
            <SelectCn @bind-Value="_timezone">
                <SelectTriggerCn aria-label="Timezone" Class="h-8 w-48 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var tz in _timezones)
                    {
                        <SelectItemCn Value="@tz.Value">@tz.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Date & time format *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Date format</span>
                    <SelectCn @bind-Value="_dateFormat">
                        <SelectTriggerCn aria-label="Date format" Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var f in _dateFormats)
                            {
                                <SelectItemCn Value="@f.Value">@f.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Time format</span>
                    <SelectCn @bind-Value="_timeFormat">
                        <SelectTriggerCn aria-label="Time format" Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var f in _timeFormats)
                            {
                                <SelectItemCn Value="@f.Value">@f.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Week start *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Week starts on</p>
                <p class="mt-0.5 text-muted-foreground text-xs">First day of the week in calendars</p>
            </div>
            <SelectCn @bind-Value="_weekStart">
                <SelectTriggerCn aria-label="Week starts on" Class="h-8 w-32 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var w in _weekStarts)
                    {
                        <SelectItemCn Value="@w.Value">@w.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Working hours *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-muted-foreground text-xs uppercase tracking-wide">
                Working hours
            </p>
            <div class="space-y-2">
                @for (var i = 0; i < _days.Count; i++)
                {
                    var day = _days[i];
                    <div class="flex items-center gap-3">
                        <SwitchCn aria-label="@day.Short" @bind-Checked="day.Enabled" />
                        <span class="@Cn.Merge("w-10 text-xs", day.Enabled ? "font-medium" : "text-muted-foreground")">
                            @day.Short
                        </span>
                        @if (day.Enabled)
                        {
                            <div class="flex items-center gap-2">
                                <InputCn aria-label="@($"{day.Short} start time")" @bind-Value="day.Start" Class="h-7 w-20 font-mono text-xs" />
                                <span class="text-muted-foreground text-xs">to</span>
                                <InputCn aria-label="@($"{day.Short} end time")" @bind-Value="day.End" Class="h-7 w-20 font-mono text-xs" />
                            </div>
                        }
                        else
                        {
                            <span class="text-muted-foreground text-xs">Not working</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Holidays *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Holidays
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add holiday
                </ButtonCn>
            </div>
            <div class="space-y-1">
                @foreach (var holiday in _holidays)
                {
                    var holidayId = holiday.Id;
                    <div class="flex items-center justify-between rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-2">
                            <span class="size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                            <span class="text-sm">@holiday.Name</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-muted-foreground text-xs">@holiday.Date</span>
                            <ButtonCn aria-label="@($"Remove {holiday.Name}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="h-6 w-6 p-0 text-muted-foreground hover:text-red-600"
                                      OnClick="() => RemoveHoliday(holidayId)">
                                <LucideTrashCn Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _timezone = "America/New_York";
    private string _dateFormat = "MM/DD/YYYY";
    private string _timeFormat = "12h";
    private string _weekStart = "monday";
    private bool _saved;

    private record SelectOption(string Value, string Label);

    private static readonly List<SelectOption> _timezones = new()
    {
        new("America/New_York", "Eastern (UTC-5)"), new("America/Chicago", "Central (UTC-6)"),
        new("America/Denver", "Mountain (UTC-7)"), new("America/Los_Angeles", "Pacific (UTC-8)"),
        new("Europe/London", "London (UTC+0)"), new("Europe/Berlin", "Berlin (UTC+1)"),
        new("Europe/Paris", "Paris (UTC+1)"), new("Asia/Tokyo", "Tokyo (UTC+9)"),
        new("Australia/Sydney", "Sydney (UTC+11)"),
    };

    private static readonly List<SelectOption> _dateFormats = new()
    {
        new("MM/DD/YYYY", "MM/DD/YYYY"), new("DD/MM/YYYY", "DD/MM/YYYY"),
        new("YYYY-MM-DD", "YYYY-MM-DD (ISO)"), new("DD.MM.YYYY", "DD.MM.YYYY"),
    };

    private static readonly List<SelectOption> _timeFormats = new()
    {
        new("12h", "12-hour (3:00 PM)"), new("24h", "24-hour (15:00)"),
    };

    private static readonly List<SelectOption> _weekStarts = new()
    {
        new("sunday", "Sunday"), new("monday", "Monday"), new("saturday", "Saturday"),
    };

    private class WorkingDay
    {
        public string Day { get; set; } = "";
        public string Short { get; set; } = "";
        public bool Enabled { get; set; }
        public string Start { get; set; } = "";
        public string End { get; set; } = "";
    }

    private record HolidayEntry(string Id, string Name, string Date);

    private readonly List<WorkingDay> _days = new()
    {
        new() { Day = "Monday", Short = "Mon", Enabled = true, Start = "09:00", End = "17:00" },
        new() { Day = "Tuesday", Short = "Tue", Enabled = true, Start = "09:00", End = "17:00" },
        new() { Day = "Wednesday", Short = "Wed", Enabled = true, Start = "09:00", End = "17:00" },
        new() { Day = "Thursday", Short = "Thu", Enabled = true, Start = "09:00", End = "17:00" },
        new() { Day = "Friday", Short = "Fri", Enabled = true, Start = "09:00", End = "17:00" },
        new() { Day = "Saturday", Short = "Sat", Enabled = false, Start = "10:00", End = "14:00" },
        new() { Day = "Sunday", Short = "Sun", Enabled = false, Start = "10:00", End = "14:00" },
    };

    private readonly List<HolidayEntry> _holidays = new()
    {
        new("1", "New Year's Day", "2026-01-01"),
        new("2", "Independence Day", "2026-07-04"),
        new("3", "Thanksgiving", "2026-11-26"),
        new("4", "Christmas Day", "2026-12-25"),
    };

    private void RemoveHoliday(string id)
    {
        _holidays.RemoveAll(h => h.Id == id);
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
