@* ===========================================================
   Block: settings-content-moderation
   Title: Settings Content Moderation
   Description: Auto-mod rules, banned words, escalation levels, appeals
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-content-moderation.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Content Moderation</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Auto-mod rules, banned words, and escalation workflows</p>
            </div>
            <div class="flex items-center gap-2">
                @if (_globalEnabled)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <span class="mr-1.5 size-1.5 rounded-full bg-emerald-500"></span>
                        Active
                    </BadgeCn>
                }
                else
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Disabled</BadgeCn>
                }
                <SwitchCn aria-label="Content Moderation" @bind-Checked="_globalEnabled" />
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideShieldAlertCn Size="12" Class="size-3" />
                @_rules.Count(r => r.Enabled) active rules
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="font-medium tabular-nums text-foreground">@_totalFlagged.ToString("N0")</span> items flagged
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="font-medium tabular-nums text-foreground">@_bannedWords.Count</span> banned terms
            </span>
        </div>

        @* Scan targets *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Scan comments</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Apply moderation rules to user comments</p>
                    </div>
                    <SwitchCn aria-label="Scan comments" @bind-Checked="_scanComments" />
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Scan direct messages</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Apply moderation rules to private messages</p>
                    </div>
                    <SwitchCn aria-label="Scan direct messages" @bind-Checked="_scanMessages" />
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Scan user profiles</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Check bios and display names for violations</p>
                    </div>
                    <SwitchCn aria-label="Scan user profiles" @bind-Checked="_scanProfiles" />
                </div>
            </div>
        </div>

        @* Auto-mod rules *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-sm">Auto-moderation rules</span>
            </div>
            @for (var i = 0; i < _rules.Count; i++)
            {
                var rule = _rules[i];
                var isExpanded = _expandedRule == rule.Id;
                <div class="border-t">
                    <button type="button"
                        @onclick="@(() => _expandedRule = isExpanded ? null : rule.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", rule.Enabled ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@rule.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @rule.FlaggedCount.ToString("N0") flagged · Action: @rule.Action · Sensitivity: @rule.Sensitivity
                            </p>
                        </div>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-9">
                                <p class="text-muted-foreground text-sm leading-relaxed">@rule.Description</p>
                                <div class="flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Action when triggered</span>
                                    <SelectCn Value="@rule.Action">
                                        <SelectTriggerCn aria-label="@($"{rule.Name} action")" Class="h-7 w-28 text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="flag">Flag for review</SelectItemCn>
                                            <SelectItemCn Value="hide">Hide content</SelectItemCn>
                                            <SelectItemCn Value="block">Block user</SelectItemCn>
                                            <SelectItemCn Value="redact">Redact content</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Sensitivity</span>
                                    <SelectCn Value="@rule.Sensitivity">
                                        <SelectTriggerCn aria-label="@($"{rule.Name} sensitivity")" Class="h-7 w-24 text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="low">Low</SelectItemCn>
                                            <SelectItemCn Value="medium">Medium</SelectItemCn>
                                            <SelectItemCn Value="high">High</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Enabled</span>
                                    <SwitchCn aria-label="Enabled" Checked="@rule.Enabled" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Banned words *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Banned words</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_bannedWords.Count</BadgeCn>
                </div>
            </div>
            <p class="mb-3 text-muted-foreground text-xs">Content containing these terms is automatically hidden</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var word in _bannedWords)
                {
                    <span class="flex items-center gap-1 rounded-md bg-muted/50 px-2 py-1 font-mono text-xs">
                        @word
                        <button aria-label="Remove @word" type="button" class="rounded p-0.5 text-muted-foreground transition-colors hover:text-red-600">
                            <LucideXCn Size="10" Class="size-2.5" />
                        </button>
                    </span>
                }
            </div>
            <div class="mt-2 flex items-center gap-2">
                <InputCn aria-label="Add banned word or phrase..." @bind-Value="_newWord" Placeholder="Add banned word or phrase..." Class="h-7 flex-1 text-xs" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
        </div>

        @* Escalation *@
        <div class="border-b">
            <div class="px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideTriangleAlertCn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Escalation levels</span>
                </div>
            </div>
            @for (var i = 0; i < _escalationLevels.Count; i++)
            {
                var level = _escalationLevels[i];
                var isExpanded = _expandedEscalation == level.Id;
                var dotColor = level.Id == "high" ? "bg-red-500" : level.Id == "medium" ? "bg-amber-500" : "bg-blue-500";
                <div>
                    <button type="button"
                        @onclick="@(() => _expandedEscalation = isExpanded ? null : level.Id)"
                        class="flex w-full items-center gap-3 border-t px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@level.Name priority</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@level.Description</p>
                        </div>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-2 px-4 pb-4 pl-9">
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Notify role</span>
                                    <span class="font-mono text-xs">@level.NotifyRole</span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Response time SLA</span>
                                    <span class="text-xs">@level.ResponseTime</span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Auto-restrict user</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @(level.AutoRestrict ? "Yes" : "No")
                                    </BadgeCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Appeals *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Allow appeals</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Let users appeal moderation decisions</p>
                    </div>
                    <SwitchCn aria-label="Allow appeals" @bind-Checked="_allowAppeals" />
                </div>

                @if (_allowAppeals)
                {
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-sm">Appeal window</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">Time allowed to submit an appeal</p>
                        </div>
                        <SelectCn @bind-Value="_appealWindow">
                            <SelectTriggerCn aria-label="Appeal window" Class="h-8 w-24 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="24h">24 hours</SelectItemCn>
                                <SelectItemCn Value="3d">3 days</SelectItemCn>
                                <SelectItemCn Value="7d">7 days</SelectItemCn>
                                <SelectItemCn Value="30d">30 days</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                }
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ModRule(string Id, string Name, string Description, string Action, string Sensitivity, int FlaggedCount, bool Enabled);
    private record EscalationLevel(string Id, string Name, string Description, string NotifyRole, string ResponseTime, bool AutoRestrict);

    private static readonly List<ModRule> _rules =
    [
        new("profanity", "Profanity filter", "Detects and filters profane language", "flag", "medium", 1247, true),
        new("spam", "Spam detection", "Identifies repetitive or promotional content", "hide", "high", 892, true),
        new("harassment", "Harassment detection", "Flags targeted harassment and bullying", "block", "high", 156, true),
        new("pii", "PII detection", "Detects personal information like SSNs and credit cards", "redact", "high", 43, false),
    ];

    private static readonly List<EscalationLevel> _escalationLevels =
    [
        new("high", "High", "Immediate threats, illegal content, or severe harassment", "@admins", "15 minutes", true),
        new("medium", "Medium", "Repeated violations or concerning patterns", "@moderators", "1 hour", false),
        new("low", "Low", "Minor infractions or borderline content", "@reviewers", "24 hours", false),
    ];

    private static readonly List<string> _bannedWords = ["spam", "scam", "phishing", "malware", "hack"];

    private int _totalFlagged = 2338;
    private bool _globalEnabled = true;
    private bool _scanComments = true;
    private bool _scanMessages = true;
    private bool _scanProfiles = false;
    private bool _allowAppeals = true;
    private string _appealWindow = "7d";
    private string _newWord = "";
    private string? _expandedRule = "profanity";
    private string? _expandedEscalation = null;
    private bool _saved = false;
}
