@* ===========================================================
   Block: settings-theme-editor
   Title: Settings Theme Editor
   Description: Animated React theme editor settings block for Next.js with color token text inputs, border radius slider, font selector, live preview swatch, and dark mode toggle built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-theme-editor.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Theme editor</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Customize colors, typography, and border radius for your application
            </p>
        </div>

        @* Preview swatch *@
        <div class="border-b px-4 py-4">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Preview</span>
            <div class="flex items-center gap-3 border p-3"
                 style="@($"background-color: {_colors["background"]}; border-color: {_colors["border"]}; border-radius: {RadiusPx}")">
                <div class="flex h-8 items-center justify-center px-3 text-white text-xs font-medium"
                     style="@($"background-color: {_colors["primary"]}; border-radius: {RadiusPx}")">
                    Primary
                </div>
                <div class="flex h-8 items-center justify-center px-3 text-white text-xs font-medium"
                     style="@($"background-color: {_colors["secondary"]}; border-radius: {RadiusPx}")">
                    Secondary
                </div>
                <div class="flex h-8 items-center justify-center px-3 text-white text-xs font-medium"
                     style="@($"background-color: {_colors["accent"]}; border-radius: {RadiusPx}")">
                    Accent
                </div>
                <div class="ml-auto flex h-8 items-center justify-center border px-3 text-xs font-medium"
                     style="@($"color: {_colors["foreground"]}; background-color: {_colors["muted"]}; border-color: {_colors["border"]}; border-radius: {RadiusPx}")">
                    Muted
                </div>
            </div>
        </div>

        @* Color tokens *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Color tokens
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                          OnClick="ResetColors">
                    <LucideRotateCcwCn Size="12" Class="size-3" />
                    Reset
                </ButtonCn>
            </div>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var token in _colorLabels)
                {
                    var key = token.Key;
                    <div class="flex items-center gap-2">
                        <span class="size-6 shrink-0 rounded border"
                              style="@($"background-color: {_colors[key]}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="block text-muted-foreground text-xs">@token.Value</span>
                            <InputCn Value="@_colors[key]"
                                     ValueChanged="@((string v) => _colors[key] = v)"
                                     Class="mt-0.5 h-7 font-mono text-xs" Placeholder="#000000" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Border radius *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Border radius</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Corner rounding for buttons, cards, and inputs
                </p>
            </div>
            <SelectCn @bind-Value="_borderRadius">
                <SelectTriggerCn Class="h-8 w-40 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var r in _radii)
                    {
                        <SelectItemCn Value="@r.Value">@r.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Font *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Font family</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Primary typeface for your application
                </p>
            </div>
            <SelectCn @bind-Value="_font">
                <SelectTriggerCn Class="h-8 w-40 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var f in _fonts)
                    {
                        <SelectItemCn Value="@f.Value">@f.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Dark mode *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Dark mode</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Generate dark mode variants for all color tokens
                </p>
            </div>
            <SwitchCn @bind-Checked="_darkMode" />
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save theme
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _borderRadius = "0.5";
    private string _font = "inter";
    private bool _darkMode;
    private bool _saved;

    private string RadiusPx => $"{double.Parse(_borderRadius) * 16}px";

    private static readonly Dictionary<string, string> _defaultColors = new()
    {
        ["primary"] = "#2563eb", ["secondary"] = "#64748b", ["accent"] = "#8b5cf6",
        ["background"] = "#ffffff", ["foreground"] = "#0f172a", ["muted"] = "#f1f5f9",
        ["border"] = "#e2e8f0", ["destructive"] = "#ef4444",
    };

    private static readonly Dictionary<string, string> _colorLabels = new()
    {
        ["primary"] = "Primary", ["secondary"] = "Secondary", ["accent"] = "Accent",
        ["background"] = "Background", ["foreground"] = "Foreground", ["muted"] = "Muted",
        ["border"] = "Border", ["destructive"] = "Destructive",
    };

    private readonly Dictionary<string, string> _colors = new(_defaultColors);

    private record SelectOption(string Value, string Label);

    private static readonly List<SelectOption> _radii = new()
    {
        new("0", "None (0px)"), new("0.25", "Small (4px)"), new("0.375", "Medium (6px)"),
        new("0.5", "Default (8px)"), new("0.75", "Large (12px)"), new("1", "XL (16px)"),
    };

    private static readonly List<SelectOption> _fonts = new()
    {
        new("inter", "Inter"), new("geist", "Geist"), new("system", "System UI"),
        new("mono", "JetBrains Mono"), new("serif", "Georgia"),
    };

    private void ResetColors()
    {
        foreach (var kv in _defaultColors)
            _colors[kv.Key] = kv.Value;
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
