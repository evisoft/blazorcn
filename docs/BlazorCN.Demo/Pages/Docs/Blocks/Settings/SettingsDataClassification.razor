@* ===========================================================
   Block: settings-data-classification
   Title: Settings Data Classification
   Description: Animated React data classification settings page for Next.js with sensitivity levels, handling rules, retention policies, and label management using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Password, 2FA, and session management
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-data-classification.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Data classification</p>
            <p class="mt-0.5 text-muted-foreground text-xs">Define sensitivity levels, handling rules, and retention policies</p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">@_levels.Sum(l => l.ResourceCount).ToString("N0") resources classified</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-3">
                @foreach (var level in _levels)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", level.DotColor)"></span>
                        @level.ResourceCount
                    </span>
                }
            </div>
        </div>

        @* Global settings *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideShieldAlertCn Size="14" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Mandatory labeling</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">Require a classification label on all resources</p>
                        </div>
                    </div>
                    <SwitchCn @bind-Checked="_mandatoryLabeling" />
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideLockCn Size="14" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Auto-classification</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">Automatically label resources based on content analysis</p>
                        </div>
                    </div>
                    <SwitchCn @bind-Checked="_autoClassify" />
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Default classification</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Applied to new resources without a label</p>
                    </div>
                    <SelectCn @bind-Value="_defaultLevel">
                        <SelectTriggerCn Class="h-8 w-32 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var l in _levels)
                            {
                                <SelectItemCn Value="@l.Id">@l.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Classification levels *@
        <div>
            <div class="px-4 py-3">
                <p class="font-medium text-sm">Classification levels</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Configure handling rules and retention per sensitivity level</p>
            </div>
            @for (var i = 0; i < _levels.Count; i++)
            {
                var level = _levels[i];
                var isExpanded = _expanded == level.Id;
                var isLast = i == _levels.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : level.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", level.DotColor)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@level.Label</span>
                                <span class="text-muted-foreground text-xs">@level.ResourceCount resources</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@level.Description</p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-9">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium text-xs">Encryption at rest</p>
                                        <p class="mt-0.5 text-muted-foreground text-xs">Encrypt stored data with AES-256</p>
                                    </div>
                                    <SwitchCn Checked="level.Encryption" CheckedChanged="() => level.Encryption = !level.Encryption" />
                                </div>
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium text-xs">Audit access logs</p>
                                        <p class="mt-0.5 text-muted-foreground text-xs">Log every read and write operation</p>
                                    </div>
                                    <SwitchCn Checked="level.AuditAccess" CheckedChanged="() => level.AuditAccess = !level.AuditAccess" />
                                </div>
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium text-xs">Sharing</p>
                                        <p class="mt-0.5 text-muted-foreground text-xs">Who can access resources at this level</p>
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@SharingLabel(level.Sharing)</BadgeCn>
                                </div>
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium text-xs">Retention</p>
                                        <p class="mt-0.5 text-muted-foreground text-xs">How long data is retained before review</p>
                                    </div>
                                    <SelectCn Value="@level.Retention" ValueChanged="@((string v) => { level.Retention = v; })">
                                        <SelectTriggerCn Class="h-7 w-28 text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="1-year">1 year</SelectItemCn>
                                            <SelectItemCn Value="3-years">3 years</SelectItemCn>
                                            <SelectItemCn Value="5-years">5 years</SelectItemCn>
                                            <SelectItemCn Value="7-years">7 years</SelectItemCn>
                                            <SelectItemCn Value="10-years">10 years</SelectItemCn>
                                            <SelectItemCn Value="indefinite">Indefinite</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            @if (_saved)
            {
                <span class="mr-2 flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _saved = true">
                Save classification
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _mandatoryLabeling = true;
    private string _defaultLevel = "internal";
    private bool _autoClassify;
    private string? _expanded;
    private bool _saved;

    private class ClassificationLevel
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public string DotColor { get; set; } = "";
        public bool Encryption { get; set; }
        public bool AuditAccess { get; set; }
        public string Sharing { get; set; } = "";
        public string Retention { get; set; } = "";
        public int ResourceCount { get; set; }
    }

    private readonly List<ClassificationLevel> _levels =
    [
        new() { Id = "public", Label = "Public", Description = "Information intended for public access with no restrictions", DotColor = "bg-emerald-500", Encryption = false, AuditAccess = false, Sharing = "anyone", Retention = "indefinite", ResourceCount = 342 },
        new() { Id = "internal", Label = "Internal", Description = "General business information for internal use only", DotColor = "bg-blue-500", Encryption = false, AuditAccess = false, Sharing = "members", Retention = "3-years", ResourceCount = 1284 },
        new() { Id = "confidential", Label = "Confidential", Description = "Sensitive business data requiring explicit access grants", DotColor = "bg-amber-500", Encryption = true, AuditAccess = true, Sharing = "explicit", Retention = "7-years", ResourceCount = 567 },
        new() { Id = "restricted", Label = "Restricted", Description = "Highly sensitive data with strict access controls and audit requirements", DotColor = "bg-red-500", Encryption = true, AuditAccess = true, Sharing = "none", Retention = "10-years", ResourceCount = 89 },
    ];

    private static string SharingLabel(string sharing) => sharing switch
    {
        "anyone" => "Anyone",
        "members" => "Members",
        "explicit" => "Explicit",
        "none" => "No sharing",
        _ => sharing,
    };
}
