@* ===========================================================
   Block: settings-notification-channels
   Title: Settings Notification Channels
   Description: Animated React notification channel routing settings page for Next.js with Slack, email, PagerDuty, and webhook configuration plus event-to-channel mapping built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Device and push notification management
   Dependencies: ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-notification-channels.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Notification Channels</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure delivery channels and event routing rules
            </p>
        </div>

        @* Channels *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Channels</span>
            <div class="space-y-1">
                @foreach (var channel in _channels)
                {
                    <div class="flex items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", channel.Enabled ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground")">
                            @if (channel.Type == "slack")
                            {
                                <LucideHashCn Size="16" Class="size-4" />
                            }
                            else if (channel.Type == "email")
                            {
                                <LucideMailCn Size="16" Class="size-4" />
                            }
                            else if (channel.Type == "pagerduty")
                            {
                                <LucideSirenCn Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucideWebhookCn Size="16" Class="size-4" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@channel.Name</span>
                                <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[channel.Status])"></span>
                            </div>
                            <p class="mt-0.5 truncate font-mono text-muted-foreground text-xs">
                                @channel.Detail
                            </p>
                        </div>
                        <SwitchCn aria-label="@channel.Name" @bind-Checked="channel.Enabled" />
                    </div>
                }
            </div>
        </div>

        @* Event routing *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Event routing</span>
            </div>
            @for (var i = 0; i < _eventRoutes.Count; i++)
            {
                var route = _eventRoutes[i];
                var isExpanded = _expanded == route.Id;
                var isLast = i == _eventRoutes.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="() => _expanded = isExpanded ? null : route.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideBellCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@route.Event</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@route.Description</p>
                        </div>
                        <div class="flex items-center gap-1.5">
                            @foreach (var chId in route.Channels)
                            {
                                var ch = _channels.FirstOrDefault(c => c.Id == chId);
                                if (ch != null)
                                {
                                    <span class="flex size-5 items-center justify-center rounded bg-muted/50">
                                        @if (ch.Type == "slack")
                                        {
                                            <LucideHashCn Size="12" Class="size-3 text-muted-foreground" />
                                        }
                                        else if (ch.Type == "email")
                                        {
                                            <LucideMailCn Size="12" Class="size-3 text-muted-foreground" />
                                        }
                                        else if (ch.Type == "pagerduty")
                                        {
                                            <LucideSirenCn Size="12" Class="size-3 text-muted-foreground" />
                                        }
                                        else
                                        {
                                            <LucideWebhookCn Size="12" Class="size-3 text-muted-foreground" />
                                        }
                                    </span>
                                }
                            }
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-11">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                    Deliver to
                                </span>
                                <div class="space-y-2">
                                    @foreach (var ch in _channels)
                                    {
                                        var isRouted = route.Channels.Contains(ch.Id);
                                        <span class="flex cursor-pointer items-center gap-2">
                                            <span class="@Cn.Merge("flex size-4 items-center justify-center rounded border text-xs", isRouted ? "border-foreground bg-foreground text-background" : "border-muted-foreground/30")">
                                                @if (isRouted)
                                                {
                                                    <LucideCheckCn Size="12" Class="size-3" />
                                                }
                                            </span>
                                            @if (ch.Type == "slack")
                                            {
                                                <LucideHashCn Size="14" Class="size-3.5 text-muted-foreground" />
                                            }
                                            else if (ch.Type == "email")
                                            {
                                                <LucideMailCn Size="14" Class="size-3.5 text-muted-foreground" />
                                            }
                                            else if (ch.Type == "pagerduty")
                                            {
                                                <LucideSirenCn Size="14" Class="size-3.5 text-muted-foreground" />
                                            }
                                            else
                                            {
                                                <LucideWebhookCn Size="14" Class="size-3.5 text-muted-foreground" />
                                            }
                                            <span class="text-sm">@ch.Name</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                @(_channels.Count(c => c.Enabled)) channels active &middot; @_eventRoutes.Count event rules configured
            </span>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private bool _saved;

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["connected"] = "bg-emerald-500",
        ["pending"] = "bg-amber-500",
        ["error"] = "bg-red-500",
    };

    private class ChannelInfo
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "";
        public string Name { get; set; } = "";
        public string Detail { get; set; } = "";
        public bool Enabled { get; set; }
        public string Status { get; set; } = "";
    }

    private record EventRoute(string Id, string Event, string Description, List<string> Channels);

    private readonly List<ChannelInfo> _channels = new()
    {
        new() { Id = "slack", Type = "slack", Name = "Slack", Detail = "#eng-alerts \u00b7 acme.slack.com", Enabled = true, Status = "connected" },
        new() { Id = "email", Type = "email", Name = "Email", Detail = "team@@acme.com, ops@@acme.com", Enabled = true, Status = "connected" },
        new() { Id = "pagerduty", Type = "pagerduty", Name = "PagerDuty", Detail = "Engineering On-Call", Enabled = true, Status = "connected" },
        new() { Id = "webhook", Type = "webhook", Name = "Webhook", Detail = "https://hooks.acme.com/notify", Enabled = false, Status = "pending" },
    };

    private readonly List<EventRoute> _eventRoutes = new()
    {
        new("deploy", "Deployment completed", "Production and staging deployments", new() { "slack", "email" }),
        new("error", "Error threshold exceeded", "Error rate above 5% for 5 minutes", new() { "slack", "pagerduty" }),
        new("user", "New user signup", "User registration events", new() { "slack" }),
        new("billing", "Payment failed", "Subscription charge failures", new() { "email", "pagerduty" }),
        new("security", "Security alert", "Suspicious login or permission changes", new() { "slack", "email", "pagerduty" }),
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
