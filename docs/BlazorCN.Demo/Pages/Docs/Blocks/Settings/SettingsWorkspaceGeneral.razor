@* ===========================================================
   Block: settings-workspace-general
   Title: Settings Workspace General
   Description: Name, URL slug, logo upload, description, timezone, danger zone
   Dependencies: ButtonCn, InputCn, TextareaCn
   Source: original/blocks/settings/settings-workspace-general.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideBuildingCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                <div>
                    <h2 class="font-medium text-sm">Workspace Settings</h2>
                    <p class="text-muted-foreground text-xs">Manage your workspace name, URL, and branding</p>
                </div>
            </div>
        </div>

        <div>
            @* Logo upload *@
            <div class="border-b px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Workspace Logo</span>
                <div class="flex items-center gap-4">
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg border-2 border-dashed bg-muted/30">
                        <LucideImageCn Class="h-6 w-6 text-muted-foreground/50" />
                    </div>
                    <div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                            <LucideImageCn Size="14" Class="h-3.5 w-3.5" />
                            Upload Logo
                        </ButtonCn>
                        <p class="mt-1 text-muted-foreground text-xs">PNG, JPG, SVG, or WebP. Recommended 256x256px.</p>
                    </div>
                </div>
            </div>

            @* Workspace name *@
            <div class="border-b px-4 py-3">
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Workspace Name</span>
                <InputCn aria-label="Workspace Name" Class="h-8 text-sm" @bind-Value="_name" Placeholder="My Workspace" />
            </div>

            @* URL slug *@
            <div class="border-b px-4 py-3">
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Workspace URL</span>
                <div class="flex items-center gap-0">
                    <span class="flex h-8 items-center rounded-l-md border border-r-0 bg-muted/50 px-3 font-mono text-muted-foreground text-xs">app.acme.com/</span>
                    <InputCn aria-label="Workspace URL" Class="h-8 rounded-l-none font-mono text-xs" @bind-Value="_slug" Placeholder="my-workspace" />
                </div>
                <p class="mt-1 text-muted-foreground text-xs">Lowercase letters, numbers, and hyphens only. 3-48 characters.</p>
            </div>

            @* Description *@
            <div class="border-b px-4 py-3">
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Description</span>
                <TextareaCn aria-label="Description" Class="min-h-[72px] resize-none text-sm" @bind-Value="_description" Placeholder="A brief description of your workspace" />
                <p class="mt-1 text-muted-foreground text-xs">@(_description.Length)/280 characters</p>
            </div>

            @* Timezone *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Timezone</p>
                        <p class="text-muted-foreground text-xs">Used for scheduled reports and activity logs</p>
                    </div>
                    <span class="font-mono text-muted-foreground text-xs">@_timezone</span>
                </div>
            </div>

            @* Save button *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-end">
                    <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5 text-xs" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <LucideLoaderCircleCn Size="14" Class="h-3.5 w-3.5 animate-spin" />
                            <span>Saving...</span>
                        }
                        else
                        {
                            <LucideSaveCn Size="14" Class="h-3.5 w-3.5" />
                            <span>Save Changes</span>
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Danger zone *@
            <div class="px-4 py-3">
                <span class="mb-3 block font-medium text-red-600 text-xs dark:text-red-400">Danger Zone</span>
                <div class="space-y-3 rounded-md border border-red-200 p-3 dark:border-red-900/50">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-sm">Transfer Ownership</p>
                            <p class="text-muted-foreground text-xs">Transfer this workspace to another admin member</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Transfer</ButtonCn>
                    </div>
                    <div class="border-t pt-3">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="font-medium text-sm">Delete Workspace</p>
                                <p class="text-muted-foreground text-xs">Permanently delete this workspace and all its data</p>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-red-600 text-xs hover:text-red-700">
                                <LucideTrash2Cn Size="12" Class="mr-1 h-3 w-3" />
                                Delete
                            </ButtonCn>
                        </div>
                        <div class="mt-3">
                            <InputCn aria-label="Type workspace name to confirm" Class="h-8 text-xs" Placeholder="@($"Type \"{_name}\" to confirm")" @bind-Value="_deleteConfirm" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _name = "Acme Corporation";
    private string _slug = "acme-corp";
    private string _description = "Enterprise SaaS platform for project management and team collaboration across distributed teams.";
    private string _timezone = "America/New_York";
    private bool _isSaving = false;
    private string _deleteConfirm = "";
}
