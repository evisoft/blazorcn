@* ===========================================================
   Block: settings-slack-integration
   Title: Settings Slack Integration
   Description: Channel mapping, bot config, event subscriptions, webhook URL management
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-slack-integration.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMessageSquareCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Slack Integration</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Connect events and notifications to Slack channels
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="@Cn.Merge("size-1.5 rounded-full", _connected ? "bg-emerald-500" : "bg-red-500")"></span>
                <span class="text-muted-foreground text-xs">@(_connected ? "Connected" : "Disconnected")</span>
            </div>
        </div>

        @* Bot config *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-4">
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Bot display name</span>
                <InputCn aria-label="Bot display name" @bind-Value="_botName" Class="h-8 text-sm" />
            </div>
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Bot emoji</span>
                <InputCn aria-label="Bot emoji" @bind-Value="_botEmoji" Class="h-8 font-mono text-sm" />
            </div>
        </div>

        @* Webhook URL *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Webhook URL</span>
            <div class="flex items-center gap-2">
                <div class="flex flex-1 items-center gap-2 rounded-md border bg-muted/30 px-3 py-1.5">
                    <LucideLinkCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                    <span class="truncate font-mono text-xs">https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Channel mappings *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Channel mappings</span>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">@_mappings.Count(m => m.Enabled) active</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                        <LucidePlusCn Size="12" Class="size-3" />
                        Add
                    </ButtonCn>
                </div>
            </div>
            @for (var i = 0; i < _mappings.Count; i++)
            {
                var mapping = _mappings[i];
                var isLast = i == _mappings.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", mapping.Enabled ? "bg-emerald-500" : "bg-zinc-300 dark:bg-zinc-600")"></span>
                    <span class="@Cn.Merge("min-w-0 flex-1 text-sm", !mapping.Enabled ? "text-muted-foreground" : "")">
                        @mapping.Event
                    </span>
                    <SelectCn Value="@mapping.Channel">
                        <SelectTriggerCn aria-label="@($"{mapping.Event} channel")" Class="h-7 w-32 text-xs">
                            <div class="flex items-center gap-1">
                                <LucideHashCn Size="12" Class="size-3 text-muted-foreground" />
                                <SelectValueCn />
                            </div>
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="general">general</SelectItemCn>
                            <SelectItemCn Value="engineering">engineering</SelectItemCn>
                            <SelectItemCn Value="alerts">alerts</SelectItemCn>
                            <SelectItemCn Value="deploys">deploys</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <SwitchCn aria-label="@mapping.Event" Checked="@mapping.Enabled" />
                    <ButtonCn aria-label="@($"Remove {mapping.Event}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0 text-muted-foreground hover:text-red-600">
                        <LucideTrashCn Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            }
        </div>

        @* Event subscriptions *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Event subscriptions</span>
            </div>
            @for (var i = 0; i < _events.Count; i++)
            {
                var evt = _events[i];
                var isLast = i == _events.Count - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <div>
                        <p class="font-medium text-sm">@evt.Name</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">@evt.Description</p>
                    </div>
                    <SwitchCn aria-label="@evt.Name" Checked="@evt.Enabled" />
                </div>
            }
        </div>

        @* Connection toggle + Save *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <SwitchCn aria-label="Slack integration" @bind-Checked="_connected" />
                <span class="text-muted-foreground text-xs">
                    Integration @(_connected ? "enabled" : "disabled")
                </span>
            </div>
            <div class="flex items-center gap-2">
                @if (_saved)
                {
                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideCheckCn Size="12" Class="size-3" />
                        Saved
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChannelMapping(string Event, string Channel, bool Enabled);
    private record EventSubscription(string Name, string Description, bool Enabled);

    private static readonly List<ChannelMapping> _mappings =
    [
        new("Deployment started", "deploys", true),
        new("Deployment completed", "deploys", true),
        new("Error threshold exceeded", "alerts", true),
        new("New team member joined", "general", true),
        new("Invoice generated", "general", false),
    ];

    private static readonly List<EventSubscription> _events =
    [
        new("Push events", "Notify on code pushes to watched branches", true),
        new("Pull request reviews", "Notify when reviews are requested or submitted", true),
        new("CI/CD pipeline status", "Build success and failure notifications", true),
        new("Security alerts", "Critical vulnerability and access warnings", false),
    ];

    private string _botName = "AcmeBot";
    private string _botEmoji = ":robot_face:";
    private bool _connected = true;
    private bool _copied = false;
    private bool _saved = false;
}
