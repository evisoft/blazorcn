@* ===========================================================
   Block: settings-notifications
   Title: Settings Notifications
   Description: Animated React notification preferences settings page for Next.js with per-category email, push, and SMS toggles using shadcn/ui Switch, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-notifications.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Notifications</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose how you want to be notified for each category
            </p>
        </div>

        @* Channel legend *@
        <div class="flex items-center justify-end gap-6 border-b px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideMailCn Size="12" Class="size-3" />
                Email
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideBellCn Size="12" Class="size-3" />
                Push
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideSmartphoneCn Size="12" Class="size-3" />
                SMS
            </span>
        </div>

        @* Categories *@
        <div>
            @for (var i = 0; i < _categories.Count; i++)
            {
                var cat = _categories[i];
                var isLast = i == _categories.Count - 1;

                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1 pr-4">
                        <p class="font-medium text-sm">@cat.Label</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">@cat.Description</p>
                    </div>
                    <div class="flex items-center gap-6">
                        <div class="flex w-10 justify-center">
                            <SwitchCn @bind-Checked="cat.Email" />
                        </div>
                        <div class="flex w-10 justify-center">
                            <SwitchCn @bind-Checked="cat.Push" />
                        </div>
                        <div class="flex w-10 justify-center">
                            <SwitchCn @bind-Checked="cat.Sms" />
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideMessageSquareCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">
                    Push notifications paused 10 PM - 8 AM
                </span>
            </div>
            <div class="flex items-center gap-2">
                @if (_saved)
                {
                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideCheckCn Size="12" Class="size-3" />
                        Saved
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                    Save preferences
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _saved;

    private class NotificationCategory
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Email { get; set; }
        public bool Push { get; set; }
        public bool Sms { get; set; }
    }

    private readonly List<NotificationCategory> _categories = new()
    {
        new() { Id = "security", Label = "Security alerts", Description = "Login attempts, password changes, and suspicious activity", Email = true, Push = true, Sms = true },
        new() { Id = "product", Label = "Product updates", Description = "New features, changelog entries, and platform improvements", Email = true, Push = false, Sms = false },
        new() { Id = "billing", Label = "Billing & invoices", Description = "Payment confirmations, upcoming renewals, and failed charges", Email = true, Push = true, Sms = false },
        new() { Id = "team", Label = "Team activity", Description = "Member invitations, role changes, and workspace updates", Email = true, Push = true, Sms = false },
        new() { Id = "marketing", Label = "Tips & tutorials", Description = "Best practices, use cases, and community highlights", Email = false, Push = false, Sms = false },
        new() { Id = "comments", Label = "Comments & mentions", Description = "When someone mentions you or replies to your thread", Email = true, Push = true, Sms = false },
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
