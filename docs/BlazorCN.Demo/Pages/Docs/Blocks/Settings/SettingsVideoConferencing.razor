@* ===========================================================
   Block: settings-video-conferencing
   Title: Settings Video Conferencing
   Description: Animated React video conferencing settings page for Next.js with default provider selection, recording toggle, transcription preferences, and meeting defaults using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Email, push, and SMS notification preferences
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-video-conferencing.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Video Conferencing</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Default provider, recording, and meeting preferences
            </p>
        </div>

        @* Provider selection *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Default provider</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Used when scheduling meetings from the platform
                </p>
            </div>
            <div class="flex items-center gap-2">
                @{
                    var activeProvider = _providers.FirstOrDefault(p => p.Id == _defaultProvider);
                }
                @if (activeProvider?.Status == "connected")
                {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-muted-foreground text-xs">Connected</span>
                    </span>
                }
                <SelectCn @bind-Value="_defaultProvider">
                    <SelectTriggerCn Class="h-8 w-40 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var provider in _providers)
                        {
                            <SelectItemCn Value="@provider.Id">
                                <span class="flex items-center gap-2">
                                    @provider.Name
                                    @if (provider.Status == "disconnected")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                                            Not linked
                                        </BadgeCn>
                                    }
                                </span>
                            </SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Recording *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideVideoCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Recording</span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Auto-record meetings</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Start recording when the meeting begins
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_autoRecord" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Recording storage</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Where meeting recordings are saved
                        </p>
                    </div>
                    <SelectCn @bind-Value="_recordingStorage">
                        <SelectTriggerCn Class="h-8 w-32 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="@("cloud")">Cloud</SelectItemCn>
                            <SelectItemCn Value="@("local")">Local</SelectItemCn>
                            <SelectItemCn Value="@("both")">Both</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Transcription *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideMicCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Transcription</span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">AI transcription</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Automatically transcribe meeting recordings
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_transcription" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Transcription language</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Primary language for speech recognition
                        </p>
                    </div>
                    <SelectCn @bind-Value="_transcriptionLanguage">
                        <SelectTriggerCn Class="h-8 w-36 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var lang in _languages)
                            {
                                <SelectItemCn Value="@lang.Value">@lang.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Meeting defaults *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideMonitorCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Meeting defaults</span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Waiting room</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Participants wait until admitted by the host
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_waitingRoom" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Mute on join</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Mute participant microphones when they join
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_muteOnJoin" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Camera off on join</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Disable participant cameras by default
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_cameraOffOnJoin" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Max participants</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Maximum number of attendees per meeting
                        </p>
                    </div>
                    <InputCn @bind-Value="_maxParticipants" Class="h-8 w-20 text-center text-xs" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Default duration</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Default meeting length in minutes
                        </p>
                    </div>
                    <SelectCn @bind-Value="_meetingDuration">
                        <SelectTriggerCn Class="h-8 w-28 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="@("15")">15 min</SelectItemCn>
                            <SelectItemCn Value="@("30")">30 min</SelectItemCn>
                            <SelectItemCn Value="@("45")">45 min</SelectItemCn>
                            <SelectItemCn Value="@("60")">60 min</SelectItemCn>
                            <SelectItemCn Value="@("90")">90 min</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _defaultProvider = "zoom";
    private bool _autoRecord = true;
    private string _recordingStorage = "cloud";
    private bool _transcription = true;
    private string _transcriptionLanguage = "en";
    private bool _waitingRoom;
    private bool _muteOnJoin = true;
    private bool _cameraOffOnJoin;
    private string _maxParticipants = "100";
    private string _meetingDuration = "60";
    private bool _saved;

    private record SelectOption(string Value, string Label);

    private record Provider(string Id, string Name, string Status);

    private static readonly List<Provider> _providers = new()
    {
        new("zoom", "Zoom", "connected"),
        new("google-meet", "Google Meet", "connected"),
        new("teams", "Microsoft Teams", "disconnected"),
        new("webex", "Cisco Webex", "disconnected"),
    };

    private static readonly List<SelectOption> _languages = new()
    {
        new("en", "English"), new("es", "Spanish"), new("fr", "French"),
        new("de", "German"), new("ja", "Japanese"), new("zh", "Chinese (Mandarin)"),
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
