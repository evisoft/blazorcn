@* ===========================================================
   Block: settings-subscription-cancel
   Title: Settings Subscription Cancel
   Description: Reason survey, retention offers, pause option, multi-step confirmation
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/settings/settings-subscription-cancel.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Cancel subscription</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">We are sorry to see you go</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Pro plan</BadgeCn>
            </div>
        </div>

        @* Current plan summary *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-sm">Active until Apr 17, 2026</span>
            </div>
            <span class="font-mono text-muted-foreground text-xs">$39/mo</span>
        </div>

        @if (_isCancelled)
        {
            <div class="px-4 py-6">
                <div class="rounded-md bg-muted/50 p-4 text-center">
                    <span class="mx-auto mb-3 flex size-8 items-center justify-center rounded-full bg-amber-500/10">
                        <LucideTriangleAlertCn Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                    </span>
                    <p class="font-medium text-sm">Subscription cancelled</p>
                    <p class="mt-1 text-muted-foreground text-xs">
                        You will retain access until Apr 17, 2026. You can resubscribe at any time from your billing settings.
                    </p>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs">
                        Resubscribe
                    </ButtonCn>
                </div>
            </div>
        }
        else if (_step == 0)
        {
            @* Reason selection *@
            <div class="px-4 pt-3 pb-1">
                <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Why are you cancelling?
                </p>
            </div>
            <div>
                @for (var i = 0; i < _reasons.Count; i++)
                {
                    var reason = _reasons[i];
                    var isLast = i == _reasons.Count - 1;
                    <div class="@(isLast ? "" : "border-b")">
                        <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", _selectedReason == reason.Id ? "bg-muted/50" : "")"
                            @onclick="@(() => _selectedReason = reason.Id)">
                            <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", _selectedReason == reason.Id ? "border-primary bg-primary" : "border-muted-foreground/30")">
                                @if (_selectedReason == reason.Id)
                                {
                                    <span class="size-1.5 rounded-full bg-background"></span>
                                }
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@reason.Label</span>
                                <p class="text-muted-foreground text-xs">@reason.Description</p>
                            </div>
                        </label>
                    </div>
                }
            </div>
            <div class="flex justify-end border-t px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" Disabled="@(string.IsNullOrEmpty(_selectedReason))" @onclick="@(() => _step = 1)">
                    Continue
                    <LucideChevronRightCn Size="12" Class="ml-1 size-3" />
                </ButtonCn>
            </div>
        }
        else if (_step == 1)
        {
            @* Retention offer *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wide">Before you go</p>
                @{ var selectedReasonData = _reasons.FirstOrDefault(r => r.Id == _selectedReason); }
                <div class="rounded-md border border-emerald-500/20 bg-emerald-500/5 p-3">
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideGiftCn Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </span>
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <p class="font-medium text-sm">@(selectedReasonData?.Offer ?? "")</p>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @(selectedReasonData?.Discount ?? "")
                                </BadgeCn>
                            </div>
                            <p class="mt-1 text-muted-foreground text-xs">
                                We would love to keep you as a customer. This offer is available for the next 24 hours.
                            </p>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="mt-2 h-7 text-xs">
                                <LucideCheckCn Size="12" Class="mr-1 size-3" />
                                Accept offer
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            </div>

            @* Pause option *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <LucidePauseCn Size="16" Class="size-4 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Pause instead of cancelling</p>
                            <p class="text-muted-foreground text-xs">Freeze your subscription for 1-3 months</p>
                        </div>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">Pause</ButtonCn>
                </div>
            </div>

            @* Continue to cancel *@
            <div class="flex items-center justify-between px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs" @onclick="@(() => _step = 0)">Back</ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs text-red-600 hover:text-red-600" @onclick="@(() => _step = 2)">
                    Continue cancellation
                    <LucideChevronRightCn Size="12" Class="ml-1 size-3" />
                </ButtonCn>
            </div>
        }
        else
        {
            @* Final confirmation *@
            <div class="px-4 py-3">
                <div class="rounded-md bg-red-500/5 p-3">
                    <div class="flex items-start gap-2">
                        <LucideTriangleAlertCn Size="16" Class="mt-0.5 size-4 shrink-0 text-red-600 dark:text-red-400" />
                        <div class="flex-1">
                            <p class="font-medium text-red-600 text-sm dark:text-red-400">Confirm cancellation</p>
                            <p class="mt-1 text-muted-foreground text-xs">
                                Your Pro plan will remain active until Apr 17, 2026. After that, you will lose access to premium features including advanced blocks, priority support, and team collaboration tools.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-3 rounded-md bg-muted/50 p-3">
                    <p class="mb-1 font-medium text-muted-foreground text-xs">You will lose access to</p>
                    <ul class="space-y-1">
                        @foreach (var feature in new[] { "880+ premium blocks", "Priority support", "Team collaboration (5 seats)", "Advanced analytics" })
                        {
                            <li class="flex items-center gap-2 text-sm">
                                <LucideXCn Size="12" Class="size-3 shrink-0 text-red-500" />
                                @feature
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="flex items-center justify-between border-t px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs" @onclick="@(() => _step = 1)">Back</ButtonCn>
                <div class="flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" @onclick="@(() => _step = 0)">Keep subscription</ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs text-red-600 hover:text-red-600" @onclick="@(() => _isCancelled = true)">
                        Cancel subscription
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record CancelReason(string Id, string Label, string Description, string Offer, string Discount);

    private static readonly List<CancelReason> _reasons =
    [
        new("price", "Too expensive", "The pricing doesn't fit our budget", "Get 50% off for 3 months", "50% off"),
        new("features", "Missing features", "The product lacks features we need", "Early access to upcoming features", "Beta access"),
        new("competitor", "Switching to competitor", "Found a better alternative", "Free migration assistance + 30% off", "30% off"),
        new("unused", "Not using it enough", "We don't use the product frequently", "Downgrade to free tier with core features", "Free tier"),
        new("other", "Other reason", "Something else entirely", "Let us know how we can help", "Custom offer"),
    ];

    private int _step = 0;
    private string? _selectedReason = null;
    private bool _isCancelled = false;
}
