@* ===========================================================
   Block: settings-transfer-ownership
   Title: Settings Transfer Ownership
   Description: New owner search, role comparison, confirmation steps, transfer countdown
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-transfer-ownership.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Transfer ownership</p>
                    <p class="text-muted-foreground text-xs">
                        Transfer this workspace to another team member
                    </p>
                </div>
            </div>
        </div>

        @* Current owner *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted/50 font-medium text-xs">
                AC
            </div>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Alex Chen</p>
                <p class="text-muted-foreground text-xs">alex.chen@@acme.com</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Owner
            </BadgeCn>
        </div>

        @if (_isTransferred)
        {
            @* Transfer pending *@
            <div class="px-4 py-6">
                <div class="rounded-md bg-muted/50 p-4 text-center">
                    <span class="mx-auto mb-3 flex size-8 items-center justify-center rounded-full bg-blue-500/10">
                        <LucideArrowRightCn Size="16" Class="size-4 text-blue-600 dark:text-blue-400" />
                    </span>
                    <p class="font-medium text-sm">Transfer pending</p>
                    <p class="mt-1 text-muted-foreground text-xs">
                        @(_selectedMember?.Name) has been sent an invitation to accept ownership. The
                        transfer expires in 7 days.
                    </p>
                    <div class="mt-3 flex items-center justify-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">
                            7 days remaining
                        </BadgeCn>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="mt-4 h-7 text-xs text-red-600 hover:text-red-600"
                              OnClick="HandleCancel">
                        Cancel transfer
                    </ButtonCn>
                </div>
            </div>
        }
        else if (_step == 0)
        {
            @* Step 0: Search *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideSearchCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <InputCn @bind-Value="_search" Placeholder="Search team members..."
                             Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
            </div>

            <div>
                @{ var filtered = _members.Where(m => m.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || m.Email.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList(); }
                @for (var i = 0; i < filtered.Count; i++)
                {
                    var member = filtered[i];
                    var isLast = i == filtered.Count - 1;
                    var isSelected = _selectedMember?.Id == member.Id;

                    <div class="@(isLast ? "" : "border-b")">
                        <button type="button" @onclick="() => _selectedMember = member"
                                class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50" : "")">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50 font-medium text-xs">
                                @member.Avatar
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@member.Name</span>
                                <p class="text-muted-foreground text-xs">@member.Email</p>
                            </div>
                            <span class="text-muted-foreground text-xs">@member.Role</span>
                            @if (isSelected)
                            {
                                <LucideCheckCn Size="16" Class="size-4 text-primary" />
                            }
                        </button>
                    </div>
                }
                @if (filtered.Count == 0)
                {
                    <div class="px-4 py-6 text-center text-muted-foreground text-sm">
                        No members found
                    </div>
                }
            </div>

            <div class="flex justify-end border-t px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                          Disabled="@(_selectedMember == null)" OnClick="() => _step = 1">
                    Continue
                    <LucideChevronRightCn Size="12" Class="ml-1 size-3" />
                </ButtonCn>
            </div>
        }
        else if (_step == 1)
        {
            @* Step 1: Permission review *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="flex size-7 items-center justify-center rounded-full bg-muted/50 text-xs font-medium">
                            AC
                        </div>
                        <span class="text-sm">Alex Chen</span>
                    </div>
                    <LucideArrowRightCn Size="16" Class="size-4 text-muted-foreground" />
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@_selectedMember?.Name</span>
                        <div class="flex size-7 items-center justify-center rounded-full bg-muted/50 text-xs font-medium">
                            @_selectedMember?.Avatar
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-b px-4 py-3">
                <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Your permissions after transfer
                </p>
                <div class="space-y-1.5">
                    @foreach (var perm in _permissionChanges)
                    {
                        <div class="flex items-center justify-between py-0.5">
                            <span class="text-sm">@perm.Label</span>
                            @if (perm.After)
                            {
                                <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideXCn Size="16" Class="size-4 text-red-500" />
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center justify-between px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs"
                          OnClick="() => _step = 0">
                    Back
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                          OnClick="() => _step = 2">
                    Continue
                    <LucideChevronRightCn Size="12" Class="ml-1 size-3" />
                </ButtonCn>
            </div>
        }
        else
        {
            @* Step 2: Final confirmation *@
            <div class="px-4 py-3">
                <div class="rounded-md bg-amber-500/5 p-3">
                    <div class="flex items-start gap-2">
                        <LucideAlertTriangleCn Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400" />
                        <div class="flex-1">
                            <p class="font-medium text-amber-600 text-sm dark:text-amber-400">
                                Confirm ownership transfer
                            </p>
                            <p class="mt-1 text-muted-foreground text-xs">
                                You are about to transfer ownership of this workspace to
                                <span class="font-medium text-foreground">@_selectedMember?.Name</span>.
                                You will be downgraded to Admin and lose billing and deletion permissions.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <p class="mb-2 text-muted-foreground text-xs">
                        Type <span class="font-medium font-mono text-foreground">TRANSFER</span> to confirm
                    </p>
                    <InputCn @bind-Value="_confirmText" Placeholder="Type TRANSFER to confirm"
                             Class="h-8 font-mono text-sm" />
                </div>
            </div>

            <div class="flex items-center justify-between border-t px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs"
                          OnClick="() => _step = 1">
                    Back
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                          Class="h-7 text-xs text-red-600 hover:text-red-600"
                          Disabled="@(_confirmText != "TRANSFER")" OnClick="HandleConfirm">
                    <LucideUserCn Size="12" Class="mr-1 size-3" />
                    Transfer ownership
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private int _step;
    private string _search = "";
    private TeamMember? _selectedMember;
    private string _confirmText = "";
    private bool _isTransferred;

    private record TeamMember(string Id, string Name, string Email, string Role, string Avatar);
    private record PermissionChange(string Label, bool After);

    private static readonly List<TeamMember> _members = new()
    {
        new("1", "Sarah Kim", "sarah.kim@acme.com", "Admin", "SK"),
        new("2", "Marcus Johnson", "marcus.j@acme.com", "Admin", "MJ"),
        new("3", "Elena Vasquez", "elena.v@acme.com", "Member", "EV"),
        new("4", "David Park", "david.park@acme.com", "Member", "DP"),
    };

    private static readonly List<PermissionChange> _permissionChanges = new()
    {
        new("Billing management", false),
        new("Delete workspace", false),
        new("Transfer ownership", false),
        new("Manage members", true),
        new("Workspace settings", true),
        new("All content access", true),
    };

    private void HandleConfirm()
    {
        if (_confirmText == "TRANSFER")
        {
            _isTransferred = true;
        }
    }

    private void HandleCancel()
    {
        _step = 0;
        _selectedMember = null;
        _confirmText = "";
        _isTransferred = false;
        _search = "";
    }
}
