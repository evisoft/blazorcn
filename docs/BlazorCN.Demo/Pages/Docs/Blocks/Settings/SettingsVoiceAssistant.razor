@* ===========================================================
   Block: settings-voice-assistant
   Title: Settings Voice Assistant
   Description: Wake word config, language selection, voice type, speed, privacy controls
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-voice-assistant.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Voice Assistant</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Wake word, voice type, speed, and privacy settings
            </p>
        </div>

        @* Wake word *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideMicCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Activation</span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Wake word detection</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Activate the assistant hands-free with a voice trigger</p>
                    </div>
                    <SwitchCn @bind-Checked="_wakeWordEnabled" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Wake phrase</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">The phrase that triggers the assistant</p>
                    </div>
                    <InputCn @bind-Value="_wakeWord" Class="h-8 w-40 text-xs" Disabled="@(!_wakeWordEnabled)" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Continuous listening</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Keep listening after responding for follow-up queries</p>
                    </div>
                    <SwitchCn @bind-Checked="_continuousListening" />
                </div>
            </div>
        </div>

        @* Language *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideLanguagesCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Language</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Language for speech recognition and responses</p>
                </div>
            </div>
            <SelectCn @bind-Value="_language">
                <SelectTriggerCn Class="h-8 w-44 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="en-US">English (US)</SelectItemCn>
                    <SelectItemCn Value="en-GB">English (UK)</SelectItemCn>
                    <SelectItemCn Value="es-ES">Spanish</SelectItemCn>
                    <SelectItemCn Value="fr-FR">French</SelectItemCn>
                    <SelectItemCn Value="de-DE">German</SelectItemCn>
                    <SelectItemCn Value="ja-JP">Japanese</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Voice *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideVolume2Cn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Voice output</span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Voice type</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Select a voice for responses</p>
                    </div>
                    <SelectCn @bind-Value="_voiceType">
                        <SelectTriggerCn Class="h-8 w-32 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="nova">Nova</SelectItemCn>
                            <SelectItemCn Value="alloy">Alloy</SelectItemCn>
                            <SelectItemCn Value="echo">Echo</SelectItemCn>
                            <SelectItemCn Value="fable">Fable</SelectItemCn>
                            <SelectItemCn Value="onyx">Onyx</SelectItemCn>
                            <SelectItemCn Value="shimmer">Shimmer</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Speech speed</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Playback rate for voice responses</p>
                    </div>
                    <SelectCn @bind-Value="_speed">
                        <SelectTriggerCn Class="h-8 w-24 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="0.75">0.75x</SelectItemCn>
                            <SelectItemCn Value="1.0">1.0x</SelectItemCn>
                            <SelectItemCn Value="1.25">1.25x</SelectItemCn>
                            <SelectItemCn Value="1.5">1.5x</SelectItemCn>
                            <SelectItemCn Value="2.0">2.0x</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Sound effects</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Play audio cues on activation and completion</p>
                    </div>
                    <SwitchCn @bind-Checked="_soundEffects" />
                </div>
            </div>
        </div>

        @* Privacy *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Save conversation history</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Store transcripts for context in future conversations</p>
                    </div>
                    <SwitchCn @bind-Checked="_saveHistory" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Offline mode</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Use on-device models when network is unavailable</p>
                    </div>
                    <SwitchCn @bind-Checked="_offlineMode" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Delete history</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Permanently remove all stored voice interactions</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-red-600 text-xs hover:text-red-700">
                        <LucideTrashCn Size="12" Class="size-3" />
                        Delete all
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _wakeWord = "Hey Assistant";
    private bool _wakeWordEnabled = true;
    private string _language = "en-US";
    private string _voiceType = "nova";
    private string _speed = "1.0";
    private bool _continuousListening = false;
    private bool _soundEffects = true;
    private bool _saveHistory = true;
    private bool _offlineMode = false;
    private bool _saved = false;
}
