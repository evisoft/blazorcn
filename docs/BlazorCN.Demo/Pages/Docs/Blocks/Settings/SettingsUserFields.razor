@* ===========================================================
   Block: settings-user-fields
   Title: Settings User Fields
   Description: Animated React custom user profile field management settings block for Next.js with drag-reorderable field list, field type selector, validation rules, required toggle, and expandable configuration rows built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-user-fields.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Custom user fields</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Define custom profile fields, types, and validation rules
            </p>
        </div>

        @* Stats bar *@
        <div class="flex items-center justify-between border-b px-4 py-2">
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">@_fields.Count fields</span>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">@_fields.Count(f => f.Visible) visible</span>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">@_fields.Count(f => f.Required) required</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add field
            </ButtonCn>
        </div>

        @* Field list *@
        <div>
            @for (var i = 0; i < _fields.Count; i++)
            {
                var field = _fields[i];
                var isExpanded = _expanded == field.Id;
                var isLast = i == _fields.Count - 1;
                var fieldId = field.Id;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : fieldId"
                            class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideGripVerticalCn Size="16" Class="size-4 shrink-0 cursor-grab text-muted-foreground/40" />
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", field.Visible ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@field.Label</span>
                                @if (field.Required)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px] px-1 py-0">
                                        Required
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                @field.Slug &middot; @field.Type
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-12">
                            @* Label and slug *@
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Label</span>
                                    <InputCn @bind-Value="field.Label" Class="h-7 text-xs" />
                                </div>
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Slug</span>
                                    <InputCn @bind-Value="field.Slug" Class="h-7 font-mono text-xs" />
                                </div>
                            </div>

                            @* Type and placeholder *@
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Type</span>
                                    <SelectCn @bind-Value="field.Type">
                                        <SelectTriggerCn Class="h-7 text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var t in _fieldTypes)
                                            {
                                                <SelectItemCn Value="@t.Value">@t.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Placeholder</span>
                                    <InputCn @bind-Value="field.Placeholder" Class="h-7 text-xs" />
                                </div>
                            </div>

                            @* Description *@
                            <div>
                                <span class="mb-1 block text-muted-foreground text-xs">Help text</span>
                                <InputCn @bind-Value="field.Description" Class="h-7 text-xs" />
                            </div>

                            @* Validation *@
                            @if (field.Type == "text" || field.Type == "textarea")
                            {
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <span class="mb-1 block text-muted-foreground text-xs">Min length</span>
                                        <InputCn Type="number" @bind-Value="field.MinLength" Class="h-7 font-mono text-xs" Placeholder="0" />
                                    </div>
                                    <div>
                                        <span class="mb-1 block text-muted-foreground text-xs">Max length</span>
                                        <InputCn Type="number" @bind-Value="field.MaxLength" Class="h-7 font-mono text-xs" Placeholder="No limit" />
                                    </div>
                                </div>
                            }

                            @* Select options preview *@
                            @if (field.Type == "select" && field.Options.Count > 0)
                            {
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Options</span>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var opt in field.Options)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                                @opt
                                            </BadgeCn>
                                        }
                                    </div>
                                </div>
                            }

                            @* Toggles and delete *@
                            <div class="flex items-center justify-between pt-1">
                                <div class="flex items-center gap-4">
                                    <div class="flex items-center gap-2">
                                        <SwitchCn @bind-Checked="field.Required" />
                                        <span class="text-muted-foreground text-xs">Required</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <SwitchCn @bind-Checked="field.Visible" />
                                        <span class="text-muted-foreground text-xs">Visible</span>
                                    </div>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="h-7 px-2 text-xs text-red-600 hover:text-red-600"
                                          OnClick="() => RemoveField(fieldId)">
                                    <LucideTrashCn Size="12" Class="mr-1 size-3" />
                                    Remove
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private bool _saved;

    private record SelectOption(string Value, string Label);

    private static readonly List<SelectOption> _fieldTypes = new()
    {
        new("text", "Text"), new("email", "Email"), new("url", "URL"),
        new("number", "Number"), new("date", "Date"), new("textarea", "Textarea"), new("select", "Select"),
    };

    private class CustomField
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Type { get; set; } = "";
        public bool Required { get; set; }
        public bool Visible { get; set; }
        public string Placeholder { get; set; } = "";
        public string Description { get; set; } = "";
        public string MinLength { get; set; } = "";
        public string MaxLength { get; set; } = "";
        public List<string> Options { get; set; } = new();
    }

    private readonly List<CustomField> _fields = new()
    {
        new() { Id = "1", Label = "Job title", Slug = "job-title", Type = "text", Required = false, Visible = true, Placeholder = "e.g. Senior Engineer", Description = "Your current role or position", MaxLength = "100" },
        new() { Id = "2", Label = "Company", Slug = "company", Type = "text", Required = false, Visible = true, Placeholder = "e.g. Acme Inc.", Description = "Your company or organization name", MaxLength = "100" },
        new() { Id = "3", Label = "Department", Slug = "department", Type = "select", Required = false, Visible = true, Placeholder = "Select department", Description = "Your team or department", Options = new() { "Engineering", "Design", "Product", "Marketing", "Sales", "Support", "Operations" } },
        new() { Id = "4", Label = "Phone number", Slug = "phone-number", Type = "text", Required = false, Visible = false, Placeholder = "+1 (555) 000-0000", Description = "Contact phone number" },
        new() { Id = "5", Label = "LinkedIn URL", Slug = "linkedin-url", Type = "url", Required = false, Visible = true, Placeholder = "https://linkedin.com/in/username", Description = "Your LinkedIn profile link" },
        new() { Id = "6", Label = "Start date", Slug = "start-date", Type = "date", Required = true, Visible = true, Placeholder = "YYYY-MM-DD", Description = "When you joined the organization" },
    };

    private void RemoveField(string id)
    {
        _fields.RemoveAll(f => f.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
