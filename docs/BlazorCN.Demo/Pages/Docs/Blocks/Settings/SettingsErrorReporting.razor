@* ===========================================================
   Block: settings-error-reporting
   Title: Settings Error Reporting
   Description: Error reporting configuration with source map uploads, grouping rules, ignore patterns, and environment filtering
   Dependencies: ButtonCn, LucideCheckCn, LucideChevronRightCn, LucideCodeCn, LucideFunnelCn, LucideLayersCn, LucidePlusCn, LucideTrashCn, SwitchCn
   Source: original/blocks/settings/settings-error-reporting.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Error reporting</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Source maps, grouping rules, and ignore patterns
            </p>
        </div>

        @* Source maps & stack traces *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideCodeCn Size="16" Class="size-3.5 text-muted-foreground" />
                <p class="text-sm font-medium">Source maps</p>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium">Upload source maps</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Automatically upload source maps during build
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        @if (_sourceMaps)
                        {
                            <span class="flex items-center gap-1.5 text-xs text-emerald-600 dark:text-emerald-400">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                Active
                            </span>
                        }
                        <SwitchCn @bind-Checked="_sourceMaps" />
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium">Source links in traces</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Link stack frames to your repository source code
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_stackTraceLinks" />
                </div>
            </div>
        </div>

        @* Environments *@
        <div class="border-b">
            <div class="px-4 py-3">
                <p class="text-sm font-medium">Environments</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Toggle error collection per environment
                </p>
            </div>
            @for (var i = 0; i < _environments.Count; i++)
            {
                var env = _environments[i];
                var isLast = i == _environments.Count - 1;
                var envId = env.Id;
                <div class="@($"flex items-center justify-between px-4 py-3 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-center gap-3">
                        <span class="@($"size-1.5 rounded-full {(env.Enabled ? "bg-emerald-500" : "bg-muted-foreground/40")}")"></span>
                        <div>
                            <p class="text-sm font-medium">@env.Name</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @env.ErrorCount errors &middot; @env.SampleRate% sample rate
                            </p>
                        </div>
                    </div>
                    <SwitchCn Checked="@env.Enabled"
                              CheckedChanged="@(_ => ToggleEnv(envId))" />
                </div>
            }
        </div>

        @* Grouping rules *@
        <div class="border-b">
            <button type="button"
                    class="flex w-full cursor-pointer items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expandedSection = _expandedSection == "grouping" ? null : "grouping")">
                <div class="flex items-center gap-2">
                    <LucideLayersCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">Grouping rules</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_groupingRules.Count(r => r.Enabled) active rules
                        </p>
                    </div>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expandedSection == "grouping" ? "rotate-90" : "")" />
            </button>
            @if (_expandedSection == "grouping")
            {
                @foreach (var rule in _groupingRules)
                {
                    var ruleId = rule.Id;
                    <div class="flex items-center gap-3 border-t px-4 py-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@rule.Name</p>
                                <span class="text-xs text-muted-foreground">
                                    @rule.MatchCount matches
                                </span>
                            </div>
                            <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">
                                @rule.Pattern
                            </p>
                        </div>
                        <SwitchCn Checked="@rule.Enabled"
                                  CheckedChanged="@(_ => ToggleGroupingRule(ruleId))" />
                    </div>
                }
                <div class="border-t px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucidePlusCn Size="16" Class="size-3" />
                        Add rule
                    </ButtonCn>
                </div>
            }
        </div>

        @* Ignore patterns *@
        <div>
            <button type="button"
                    class="flex w-full cursor-pointer items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expandedSection = _expandedSection == "ignore" ? null : "ignore")">
                <div class="flex items-center gap-2">
                    <LucideFunnelCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">Ignore patterns</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_ignorePatterns.Count patterns filtering errors
                        </p>
                    </div>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expandedSection == "ignore" ? "rotate-90" : "")" />
            </button>
            @if (_expandedSection == "ignore")
            {
                @foreach (var pattern in _ignorePatterns)
                {
                    var patternId = pattern.Id;
                    <div class="flex items-center gap-3 border-t px-4 py-3">
                        <div class="min-w-0 flex-1">
                            <p class="truncate font-mono text-sm">@pattern.Pattern</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @pattern.Reason &middot; @pattern.MatchCount filtered
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-6 shrink-0 px-1.5 text-red-600 dark:text-red-400"
                                  @onclick="@(() => RemoveIgnorePattern(patternId))">
                            <LucideTrashCn Size="16" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
                <div class="border-t px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucidePlusCn Size="16" Class="size-3" />
                        Add pattern
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            @if (_saved)
            {
                <span class="mr-2 flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                    <LucideCheckCn Size="16" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                      @onclick="HandleSave">
                Save settings
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class Environment
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public bool Enabled { get; set; }
        public int SampleRate { get; set; }
        public string ErrorCount { get; set; } = "";
    }

    private class GroupingRule
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Pattern { get; set; } = "";
        public string MatchCount { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private record IgnorePattern(string Id, string Pattern, string Reason, string MatchCount);

    private bool _sourceMaps = true;
    private bool _stackTraceLinks = true;
    private string? _expandedSection;
    private bool _saved;

    private List<Environment> _environments = new()
    {
        new() { Id = "prod", Name = "Production", Enabled = true, SampleRate = 100, ErrorCount = "2,847" },
        new() { Id = "staging", Name = "Staging", Enabled = true, SampleRate = 50, ErrorCount = "423" },
        new() { Id = "dev", Name = "Development", Enabled = false, SampleRate = 10, ErrorCount = "12,091" },
    };

    private List<GroupingRule> _groupingRules = new()
    {
        new() { Id = "gr1", Name = "Network timeouts", Pattern = "TimeoutError|ETIMEDOUT|ECONNRESET", MatchCount = "1,204", Enabled = true },
        new() { Id = "gr2", Name = "Auth failures", Pattern = "401|403|UnauthorizedError", MatchCount = "389", Enabled = true },
        new() { Id = "gr3", Name = "Validation errors", Pattern = "ValidationError|ZodError", MatchCount = "672", Enabled = true },
    };

    private List<IgnorePattern> _ignorePatterns = new()
    {
        new("ip1", "ResizeObserver loop limit exceeded", "Browser-internal, non-actionable", "8,412"),
        new("ip2", "Loading chunk \\d+ failed", "Stale cache after deployment", "1,893"),
        new("ip3", "AbortError: The operation was aborted", "User-initiated navigation cancellation", "3,204"),
    };

    private void ToggleEnv(string id)
    {
        var env = _environments.FirstOrDefault(e => e.Id == id);
        if (env != null) env.Enabled = !env.Enabled;
    }

    private void ToggleGroupingRule(string id)
    {
        var rule = _groupingRules.FirstOrDefault(r => r.Id == id);
        if (rule != null) rule.Enabled = !rule.Enabled;
    }

    private void RemoveIgnorePattern(string id) =>
        _ignorePatterns.RemoveAll(p => p.Id == id);

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
