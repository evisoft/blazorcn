@* ===========================================================
   Block: settings-backup-restore
   Title: Settings Backup Restore
   Description: Backup/restore with schedule, retention, backup history list
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-backup-restore.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Backup &amp; Restore</h2>
                        <p class="text-xs text-muted-foreground">Schedule backups and restore from snapshots</p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs" Disabled="_isBackingUp" OnClick="HandleManualBackup">
                    @if (_isBackingUp)
                    {
                        <span class="flex items-center gap-1.5">
                            <LucideLoaderCircleCn Size="12" Class="size-3 animate-spin" />
                            Backing up...
                        </span>
                    }
                    else if (_backupComplete)
                    {
                        <span class="flex items-center gap-1.5">
                            <LucideCheckCn Size="12" Class="size-3" />
                            Done
                        </span>
                    }
                    else
                    {
                        <span class="flex items-center gap-1.5">
                            <LucideCloudUploadCn Size="12" Class="size-3" />
                            Back up now
                        </span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Status *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">Last backup:</span>
                <span class="text-xs font-medium">Mar 17, 2026 at 3:00 AM</span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="font-mono text-xs text-muted-foreground">1.8 GB</span>
            </div>
        </div>

        @* Schedule settings *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">SCHEDULE</p>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium">Automatic backups</p>
                        <p class="text-xs text-muted-foreground">Run backups on a recurring schedule</p>
                    </div>
                    <SwitchCn aria-label="Automatic backups" @bind-Checked="_autoBackup" />
                </div>

                @if (_autoBackup)
                {
                    <div class="space-y-3 pt-1">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium">Frequency</p>
                                <p class="text-xs text-muted-foreground">How often to create backups</p>
                            </div>
                            <SelectCn @bind-Value="_frequency">
                                <SelectTriggerCn aria-label="Backup frequency" Class="h-7 w-28 text-xs">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="daily">Daily</SelectItemCn>
                                    <SelectItemCn Value="weekly">Weekly</SelectItemCn>
                                    <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium">Retention</p>
                                <p class="text-xs text-muted-foreground">How long to keep backups</p>
                            </div>
                            <SelectCn @bind-Value="_retention">
                                <SelectTriggerCn aria-label="Backup retention" Class="h-7 w-28 text-xs">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="7">7 days</SelectItemCn>
                                    <SelectItemCn Value="30">30 days</SelectItemCn>
                                    <SelectItemCn Value="90">90 days</SelectItemCn>
                                    <SelectItemCn Value="365">1 year</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium">Storage</p>
                                <p class="text-xs text-muted-foreground">Where backups are stored</p>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <LucideCloudCn Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">Cloud (encrypted)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Backup history *@
        <div>
            <div class="border-b px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">BACKUP HISTORY</p>
            </div>
            @for (var i = 0; i < _backups.Count; i++)
            {
                var backup = _backups[i];
                var isRestoring = _restoringId == backup.Id;
                var isLast = i == _backups.Count - 1;

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <LucideHardDriveCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium">@backup.Timestamp</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                @backup.Type
                            </BadgeCn>
                        </div>
                        <span class="font-mono text-xs text-muted-foreground">@backup.Size</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-xs" Disabled="isRestoring">
                            <LucideCloudDownloadCn Size="12" Class="size-3" />
                            Download
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-xs" Disabled="@(_restoringId != null)" OnClick="() => HandleRestore(backup.Id)">
                            @if (isRestoring)
                            {
                                <LucideLoaderCircleCn Size="12" Class="size-3 animate-spin" />
                                <span>Restoring...</span>
                            }
                            else
                            {
                                <LucideRotateCcwCn Size="12" Class="size-3" />
                                <span>Restore</span>
                            }
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BackupItem(string Id, string Timestamp, string Size, string Type);

    private static readonly List<BackupItem> _backups =
    [
        new("bk-1", "Mar 17, 2026 at 3:00 AM", "1.8 GB", "scheduled"),
        new("bk-2", "Mar 16, 2026 at 3:00 AM", "1.8 GB", "scheduled"),
        new("bk-3", "Mar 15, 2026 at 11:42 AM", "1.7 GB", "manual"),
        new("bk-4", "Mar 15, 2026 at 3:00 AM", "1.7 GB", "scheduled"),
        new("bk-5", "Mar 14, 2026 at 3:00 AM", "1.7 GB", "scheduled"),
    ];

    private bool _autoBackup = true;
    private string _frequency = "daily";
    private string _retention = "30";
    private bool _isBackingUp;
    private bool _backupComplete;
    private string? _restoringId;

    private void HandleManualBackup()
    {
        _isBackingUp = true;
        _backupComplete = false;
    }

    private void HandleRestore(string id) => _restoringId = id;
}
