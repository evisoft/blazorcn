@* ===========================================================
   Block: settings-multi-factor
   Title: Settings Multi Factor
   Description: TOTP setup, SMS verification, backup codes management, recovery options
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-multi-factor.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Multi-Factor Authentication</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Add extra security to your account
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <LucideShieldCheckCn Size="16" Class="@Cn.Merge("size-4", _methods.Count(m => m.Enabled) > 0 ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")" />
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @(_methods.Count(m => m.Enabled)) active
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* MFA methods *@
        <div class="border-b">
            @for (var i = 0; i < _methods.Count; i++)
            {
                var method = _methods[i];
                var isLast = i == _methods.Count - 1;

                <div class="@Cn.Merge("px-4 py-4", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", method.Enabled ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground")">
                            @if (method.Type == "totp")
                            {
                                <LucideSmartphoneCn Size="16" Class="size-4" />
                            }
                            else if (method.Type == "sms")
                            {
                                <LucideMessageSquareCn Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucideKeyCn Size="16" Class="size-4" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@method.Label</span>
                                @if (method.Enabled)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@method.Description</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="() => method.Enabled = !method.Enabled">
                            @(method.Enabled ? "Disable" : "Enable")
                        </ButtonCn>
                    </div>
                    <p class="mt-2 ml-11 text-muted-foreground text-xs">@method.Detail</p>
                </div>
            }
        </div>

        @* Backup codes *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Backup codes</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Use these if you lose access to your authenticator
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="() => _showCodes = !_showCodes">
                        @(_showCodes ? "Hide" : "Show") codes
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                        <LucideRefreshCwCn Size="12" Class="size-3" />
                        Regenerate
                    </ButtonCn>
                </div>
            </div>
            @if (_showCodes)
            {
                <div class="mt-3 rounded-md bg-muted/50 p-3">
                    <div class="mb-2 flex items-center justify-between">
                        <span class="font-medium text-muted-foreground text-xs">
                            Recovery codes
                        </span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="CopyAllCodes">
                            @if (_copied)
                            {
                                <LucideCheckCn Size="12" Class="size-3" />
                                <text>Copied</text>
                            }
                            else
                            {
                                <LucideCopyCn Size="12" Class="size-3" />
                                <text>Copy all</text>
                            }
                        </ButtonCn>
                    </div>
                    <div class="grid grid-cols-2 gap-1.5">
                        @for (var i = 0; i < _backupCodes.Length; i++)
                        {
                            <span class="font-mono text-sm">@(i + 1). @_backupCodes[i]</span>
                        }
                    </div>
                    <p class="mt-3 text-muted-foreground text-xs">
                        Each code can only be used once. Store these in a secure location.
                    </p>
                </div>
            }
        </div>

        @* Recovery email *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="font-medium text-sm">Recovery email</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Fallback email for account recovery
                    </p>
                </div>
            </div>
            <div class="mt-3 ml-7">
                <InputCn Type="email" @bind-Value="_recoveryEmail" Class="h-8 text-sm" Placeholder="backup@example.com" />
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _showCodes;
    private bool _copied;
    private string _recoveryEmail = "alex.backup@@gmail.com";
    private bool _saved;

    private class MfaMethod
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
        public string Detail { get; set; } = "";
    }

    private readonly List<MfaMethod> _methods = new()
    {
        new() { Id = "totp", Type = "totp", Label = "Authenticator app", Description = "Use Google Authenticator, Authy, or 1Password", Enabled = true, Detail = "Added on Jan 15, 2026" },
        new() { Id = "sms", Type = "sms", Label = "SMS verification", Description = "Receive codes via text message", Enabled = false, Detail = "Not configured" },
        new() { Id = "backup", Type = "backup", Label = "Backup codes", Description = "One-time use recovery codes", Enabled = true, Detail = "7 of 10 codes remaining" },
    };

    private static readonly string[] _backupCodes =
    {
        "AXKF-9R2M", "BN3T-7WPL", "CM8J-4YDX", "DQ5V-2HNS",
        "ER6K-8TGB", "FP4W-1ZCJ", "GH2M-5XRQ",
    };

    private void CopyAllCodes()
    {
        _copied = true;
        _ = ResetCopied();
    }

    private async Task ResetCopied()
    {
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
