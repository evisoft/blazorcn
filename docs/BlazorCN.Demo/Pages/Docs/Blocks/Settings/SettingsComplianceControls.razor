@* ===========================================================
   Block: settings-compliance-controls
   Title: Settings Compliance Controls
   Description: SOC2/GDPR/HIPAA frameworks with controls, evidence, readiness %
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-compliance-controls.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideShieldCheckCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                    <div>
                        <h2 class="font-medium text-sm">Compliance Controls</h2>
                        <p class="text-muted-foreground text-xs">Manage compliance frameworks, controls, and evidence</p>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideDownloadCn Size="14" Class="h-3.5 w-3.5" />
                    Export Report
                </ButtonCn>
            </div>
        </div>

        @* Frameworks *@
        <div>
            @for (var i = 0; i < _frameworks.Count; i++)
            {
                var framework = _frameworks[i];
                var isExpanded = _expanded == framework.Id;
                var isEnabled = _frameworkStates.GetValueOrDefault(framework.Id);
                var isLast = i == _frameworks.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : framework.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", isEnabled ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@framework.Name</span>
                                @if (!isEnabled)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-xs">Disabled</BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@framework.Description</p>
                        </div>
                        @if (isEnabled && framework.Readiness > 0)
                        {
                            <span class="@Cn.Merge("font-semibold text-sm tabular-nums", ReadinessColor(framework.Readiness))">@framework.Readiness%</span>
                        }
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-4 px-4 pb-4 pl-9">
                                @* Enable toggle *@
                                <div class="flex items-center justify-between">
                                    <div>
                                        <span class="font-medium text-sm">Framework Status</span>
                                        <p class="text-muted-foreground text-xs">
                                            @(isEnabled ? "Controls are being monitored" : "Enable to start tracking")
                                        </p>
                                    </div>
                                    <SwitchCn aria-label="Framework Status" Checked="isEnabled" CheckedChanged="() => ToggleFramework(framework.Id)" />
                                </div>

                                @if (isEnabled && framework.Controls.Count > 0)
                                {
                                    @* Audit dates *@
                                    <div class="flex items-center gap-4 text-muted-foreground text-xs">
                                        <span>Last audit: @framework.LastAudit</span>
                                        <span>&middot;</span>
                                        <span>Next audit: @framework.NextAudit</span>
                                    </div>

                                    @* Controls *@
                                    <div>
                                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Controls</span>
                                        <div class="rounded-md border">
                                            @for (var ci = 0; ci < framework.Controls.Count; ci++)
                                            {
                                                var control = framework.Controls[ci];
                                                <div class="@(ci < framework.Controls.Count - 1 ? "border-b px-3 py-2.5" : "px-3 py-2.5")">
                                                    <div class="flex items-center gap-2">
                                                        @if (control.Status == "passing")
                                                        {
                                                            <LucideCircleCheckCn Size="16" Class="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                                                        }
                                                        else if (control.Status == "failing")
                                                        {
                                                            <LucideCircleXCn Size="16" Class="h-4 w-4 shrink-0 text-red-600 dark:text-red-400" />
                                                        }
                                                        else
                                                        {
                                                            <LucideClockCn Size="16" Class="h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" />
                                                        }
                                                        <span class="font-medium text-sm">@control.Name</span>
                                                        <span class="ml-auto text-muted-foreground text-xs">@control.Evidence</span>
                                                    </div>
                                                    <p class="ml-6 mt-0.5 text-muted-foreground text-xs">@control.Description</p>
                                                    <div class="ml-6 mt-1 flex items-center gap-2">
                                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                            <LucideFileTextCn Size="12" Class="h-3 w-3" />
                                                            Reviewed @control.LastReviewed
                                                        </span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @* Actions *@
                                    <div class="flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Upload Evidence</ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View All Controls</ButtonCn>
                                    </div>
                                }

                                @if (!isEnabled)
                                {
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <p class="text-muted-foreground text-sm">
                                            Enable this framework to start tracking controls and collecting evidence.
                                            Your compliance team will be notified and assigned controls for review.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "soc2";

    private record ControlItem(string Name, string Description, string Evidence, string Status, string LastReviewed);
    private record FrameworkItem(string Id, string Name, string Description, bool Enabled, int Readiness, string LastAudit, string NextAudit, List<ControlItem> Controls);

    private static readonly List<FrameworkItem> _frameworks =
    [
        new("soc2", "SOC 2 Type II", "Service Organization Control for security, availability, and confidentiality", true, 92, "Jan 15, 2026", "Jul 15, 2026",
        [
            new("Access Control Policy", "Role-based access control with least privilege enforcement", "3 documents", "passing", "2 weeks ago"),
            new("Encryption at Rest", "AES-256 encryption for all stored data", "2 documents", "passing", "1 month ago"),
            new("Incident Response Plan", "Documented procedures for security incidents", "1 document", "pending", "3 months ago"),
            new("Vendor Risk Assessment", "Third-party vendor security evaluation process", "5 documents", "passing", "1 week ago"),
        ]),
        new("gdpr", "GDPR", "General Data Protection Regulation for EU data subjects", true, 88, "Nov 1, 2025", "May 1, 2026",
        [
            new("Data Processing Agreement", "DPA executed with all data processors", "8 documents", "passing", "1 week ago"),
            new("Right to Erasure", "Automated data deletion upon user request", "2 documents", "passing", "2 weeks ago"),
            new("Cookie Consent", "Granular cookie consent with preference center", "0 documents", "failing", "6 months ago"),
        ]),
        new("hipaa", "HIPAA", "Health Insurance Portability and Accountability Act", false, 0, "Not audited", "Not scheduled", []),
    ];

    private readonly Dictionary<string, bool> _frameworkStates = new()
    {
        ["soc2"] = true,
        ["gdpr"] = true,
        ["hipaa"] = false,
    };

    private void ToggleFramework(string id)
    {
        if (_frameworkStates.ContainsKey(id))
            _frameworkStates[id] = !_frameworkStates[id];
    }

    private static string ReadinessColor(int score) => score >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : score >= 70 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400";
}
