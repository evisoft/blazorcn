@* ===========================================================
   Block: settings-api-keys
   Title: Settings Api Keys
   Description: API key management with create/revoke, scopes, masked keys
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-api-keys.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">API Keys</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Create and manage keys for API access
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="@(() => _showCreate = !_showCreate)">
                <LucidePlusCn Size="12" Class="size-3" />
                Create key
            </ButtonCn>
        </div>

        @* Create form *@
        @if (_showCreate)
        {
            <div class="overflow-hidden border-b">
                <div class="flex items-center gap-2 px-4 py-3">
                    <InputCn @bind-Value="_newKeyName" Placeholder="Key name (e.g. Production API)" Class="h-8 flex-1 text-sm" />
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                        Generate
                    </ButtonCn>
                </div>
            </div>
        }

        @* Key count *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideKeyCn Size="12" Class="size-3 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                <span class="tabular-nums">@_keys.Count</span> @(_keys.Count == 1 ? "key" : "keys") active
            </span>
        </div>

        @* Keys list *@
        <div>
            @for (var i = 0; i < _keys.Count; i++)
            {
                var key = _keys[i];
                var isLast = i == _keys.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@key.Name</span>
                                <div class="flex gap-1">
                                    @foreach (var scope in key.Scopes)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                                            @scope
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-red-600 text-xs dark:text-red-400">
                                <LucideTrashCn Size="12" Class="size-3" />
                                Revoke
                            </ButtonCn>
                        </div>
                        <div class="mt-2 flex items-center gap-3">
                            <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1">
                                <span class="font-mono text-muted-foreground text-xs">@key.MaskedKey</span>
                                <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @onclick="@(() => _copied = key.Id)">
                                    @if (_copied == key.Id)
                                    {
                                        <LucideCheckCn Size="12" Class="size-3" />
                                    }
                                    else
                                    {
                                        <LucideCopyCn Size="12" Class="size-3" />
                                    }
                                </ButtonCn>
                            </div>
                            <span class="text-muted-foreground text-xs">Last used @key.LastUsed</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="text-muted-foreground text-xs">Created @key.CreatedAt</span>
                            @if (!string.IsNullOrEmpty(key.ExpiresAt))
                            {
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">Expires @key.ExpiresAt</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                API keys grant full access to your account via the API. Keep them secret and rotate regularly.
            </p>
        </div>
    </div>
</section>

@code {
    private record ApiKeyModel(string Id, string Name, string MaskedKey, string[] Scopes, string LastUsed, string CreatedAt, string? ExpiresAt);

    private static readonly List<ApiKeyModel> _keys =
    [
        new("1", "Production API", "sk_live····3f8k", ["read", "write"], "2 hours ago", "Mar 1, 2026", null),
        new("2", "CI/CD Pipeline", "sk_live····9m2p", ["deploy"], "Yesterday", "Feb 15, 2026", "Jun 15, 2026"),
        new("3", "Analytics", "sk_live····7n4x", ["read"], "3 days ago", "Jan 20, 2026", null),
    ];

    private bool _showCreate = false;
    private string _newKeyName = "";
    private string? _copied = null;
}
