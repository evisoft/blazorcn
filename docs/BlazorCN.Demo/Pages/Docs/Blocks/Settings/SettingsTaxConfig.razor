@* ===========================================================
   Block: settings-tax-config
   Title: Settings Tax Config
   Description: Per-region tax rates, tax ID management, auto calculation, expandable region rows
   Dependencies: ButtonCn, InputCn, SwitchCn
   Source: original/blocks/settings/settings-tax-config.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Tax configuration</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage tax rates, tax IDs, and calculation settings
            </p>
        </div>

        @* Auto calculation toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Automatic tax calculation</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Calculate tax based on customer billing address</p>
            </div>
            <SwitchCn aria-label="Automatic tax calculation" @bind-Checked="_autoCalculate" />
        </div>

        @* Tax inclusive toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Tax-inclusive pricing</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Display prices with tax included</p>
            </div>
            <SwitchCn aria-label="Tax-inclusive pricing" @bind-Checked="_taxInclusive" />
        </div>

        @* Tax ID *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Tax ID type</span>
                    <InputCn aria-label="Tax ID type" @bind-Value="_taxIdType" Class="h-8 text-sm" Placeholder="EU VAT" />
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Tax ID number</span>
                    <InputCn aria-label="Tax ID number" @bind-Value="_taxId" Class="h-8 font-mono text-sm" Placeholder="DE123456789" />
                </div>
            </div>
        </div>

        @* Region header *@
        <div class="flex items-center justify-between border-b px-4 py-2">
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">Tax regions</span>
                <span class="text-muted-foreground text-xs">@_regions.Count(r => r.Enabled) active</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add region
            </ButtonCn>
        </div>

        @* Region list *@
        <div>
            @for (var i = 0; i < _regions.Count; i++)
            {
                var region = _regions[i];
                var isLast = i == _regions.Count - 1;
                var isExpanded = _expanded == region.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : region.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", region.Enabled ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@region.Name</span>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">@region.Code · @region.Type</p>
                        </div>
                        <span class="shrink-0 font-mono text-sm tabular-nums">@(region.Rate)%</span>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-9">
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <span class="mb-1 block text-muted-foreground text-xs">Tax rate (%)</span>
                                        <InputCn aria-label="Tax rate (%)" type="number" Value="@region.Rate.ToString()" Class="h-8 font-mono text-sm" />
                                    </div>
                                    <div class="flex items-end gap-2">
                                        <div class="flex items-center gap-2">
                                            <SwitchCn aria-label="@region.Name" Checked="@region.Enabled" />
                                            <span class="text-muted-foreground text-xs">@(region.Enabled ? "Active" : "Disabled")</span>
                                        </div>
                                        <ButtonCn aria-label="@($"Remove {region.Name}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 px-2 text-xs text-red-600 hover:text-red-600">
                                            <LucideTrashCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TaxRegion(string Id, string Name, string Code, string Type, decimal Rate, bool Enabled);

    private static readonly List<TaxRegion> _regions =
    [
        new("us", "United States", "US", "Sales Tax", 0m, false),
        new("eu", "European Union", "EU", "VAT", 20m, true),
        new("uk", "United Kingdom", "GB", "VAT", 20m, true),
        new("ca", "Canada", "CA", "GST/HST", 13m, true),
        new("au", "Australia", "AU", "GST", 10m, false),
    ];

    private bool _autoCalculate = true;
    private bool _taxInclusive = false;
    private string _taxIdType = "EU VAT";
    private string _taxId = "DE123456789";
    private string? _expanded = null;
    private bool _saved = false;
}
