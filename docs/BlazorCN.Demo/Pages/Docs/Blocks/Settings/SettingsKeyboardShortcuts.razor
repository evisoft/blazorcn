@* ===========================================================
   Block: settings-keyboard-shortcuts
   Title: Settings Keyboard Shortcuts
   Description: Key binding editor with categories, search, record mode
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-keyboard-shortcuts.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideKeyboardCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">Keyboard Shortcuts</p>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Customize key bindings for actions across the application</p>
        </div>

        @* Search + stats *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideSearchCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <InputCn aria-label="Search shortcuts" @bind-Value="_search" Placeholder="Search shortcuts..." Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            @{ var customizedCount = _shortcuts.Count(s => s.Customized); }
            @if (customizedCount > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@customizedCount customized</BadgeCn>
            }
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 gap-1 px-2 text-muted-foreground text-xs">
                <LucideRotateCcwCn Size="12" Class="size-3" />
                Reset all
            </ButtonCn>
        </div>

        @* Categories and shortcuts *@
        @foreach (var category in _categories)
        {
            var categoryShortcuts = GetCategoryShortcuts(category);
            if (categoryShortcuts.Count == 0) continue;
            var isExpanded = _expandedCategory == category;
            <div>
                <button type="button"
                    @onclick="@(() => _expandedCategory = isExpanded ? null : category)"
                    class="flex w-full items-center gap-2 border-b px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <LucideChevronRightCn Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    <span class="font-medium text-muted-foreground text-xs">@category</span>
                    <span class="text-muted-foreground/60 text-xs">@categoryShortcuts.Count</span>
                </button>

                @if (isExpanded)
                {
                    <div>
                        @foreach (var shortcut in categoryShortcuts)
                        {
                            <div class="flex items-center justify-between border-b px-4 py-2.5 pl-10">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm">@shortcut.Action</span>
                                    @if (shortcut.Customized)
                                    {
                                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                                    }
                                </div>
                                <div class="flex items-center gap-2">
                                    @if (_recording == shortcut.Id)
                                    {
                                        <span class="rounded-md border border-dashed border-foreground/30 px-3 py-1 text-muted-foreground text-xs">Press keys...</span>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1">
                                            @foreach (var key in shortcut.Keys)
                                            {
                                                <kbd class="inline-flex h-5 min-w-[20px] items-center justify-center rounded border bg-muted/50 px-1.5 font-mono text-muted-foreground text-xs">@key</kbd>
                                            }
                                        </div>
                                    }
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => _recording = _recording == shortcut.Id ? null : shortcut.Id)">
                                        @(_recording == shortcut.Id ? "Cancel" : "Edit")
                                    </ButtonCn>
                                    @if (shortcut.Customized)
                                    {
                                        <ButtonCn aria-label="Reset shortcut" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-1.5 text-muted-foreground">
                                            <LucideRotateCcwCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">Save changes</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ShortcutItem(string Id, string Action, string Category, string[] Keys, bool Customized);

    private static readonly string[] _categories = ["General", "Navigation", "Editor"];

    private static readonly List<ShortcutItem> _shortcuts =
    [
        new("save", "Save", "General", ["Ctrl", "S"], false),
        new("undo", "Undo", "General", ["Ctrl", "Z"], false),
        new("redo", "Redo", "General", ["Ctrl", "Shift", "Z"], false),
        new("search", "Search", "General", ["Ctrl", "K"], true),
        new("nav-home", "Go to home", "Navigation", ["G", "H"], false),
        new("nav-settings", "Go to settings", "Navigation", ["G", "S"], false),
        new("bold", "Bold", "Editor", ["Ctrl", "B"], false),
        new("italic", "Italic", "Editor", ["Ctrl", "I"], false),
        new("code", "Code block", "Editor", ["Ctrl", "`"], true),
    ];

    private string _search = "";
    private string? _recording = null;
    private string? _expandedCategory = "General";
    private bool _saved = false;

    private List<ShortcutItem> GetCategoryShortcuts(string category)
    {
        return _shortcuts
            .Where(s => s.Category == category)
            .Where(s => string.IsNullOrEmpty(_search) || s.Action.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
