@* ===========================================================
   Block: settings-trial-settings
   Title: Settings Trial Settings
   Description: Animated React trial period settings block for Next.js with trial duration, feature gate toggles, conversion trigger rules, and usage limit overrides built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-trial-settings.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Trial configuration</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Set trial duration, feature access, and conversion triggers
            </p>
        </div>

        @* Duration *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Trial duration</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Length of the free trial period</p>
            </div>
            <SelectCn @bind-Value="_duration">
                <SelectTriggerCn Class="h-8 w-32 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var d in _durations)
                    {
                        <SelectItemCn Value="@d.Value">@d.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Require credit card *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Require credit card</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Require payment method to start trial</p>
            </div>
            <SwitchCn @bind-Checked="_requireCard" />
        </div>

        @* Expiration behavior *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">After trial expires</p>
                <p class="mt-0.5 text-muted-foreground text-xs">What happens when the trial period ends</p>
            </div>
            <SelectCn @bind-Value="_expirationBehavior">
                <SelectTriggerCn Class="h-8 w-48 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var b in _expirationBehaviors)
                    {
                        <SelectItemCn Value="@b.Value">@b.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Feature gates *@
        <div class="border-b px-4 py-2">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                    Feature access during trial
                </span>
                <span class="text-muted-foreground text-xs">
                    @_features.Count(f => f.Enabled)/@_features.Count enabled
                </span>
            </div>
        </div>

        <div>
            @foreach (var feature in _features)
            {
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <div class="min-w-0 flex-1 pr-4">
                        <p class="font-medium text-sm">@feature.Label</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">@feature.Description</p>
                    </div>
                    <SwitchCn @bind-Checked="feature.Enabled" />
                </div>
            }
        </div>

        @* Conversion triggers *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                Conversion triggers
            </span>
        </div>

        <div>
            @for (var i = 0; i < _triggers.Count; i++)
            {
                var trigger = _triggers[i];
                var isExpanded = _expandedTrigger == trigger.Id;
                var isLast = i == _triggers.Count - 1;
                var triggerId = trigger.Id;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expandedTrigger = isExpanded ? null : triggerId"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", trigger.Enabled ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@trigger.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@trigger.Description</p>
                        </div>
                        @if (!string.IsNullOrEmpty(trigger.Threshold))
                        {
                            var unit = trigger.Id == "expiration-warning" ? " days" : "%";
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">
                                @trigger.Threshold@unit
                            </BadgeCn>
                        }
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="flex items-center gap-4 px-4 pb-3 pl-9">
                            <div class="flex items-center gap-2">
                                <SwitchCn @bind-Checked="trigger.Enabled" />
                                <span class="text-muted-foreground text-xs">
                                    @(trigger.Enabled ? "Active" : "Disabled")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(trigger.Threshold))
                            {
                                <div class="flex items-center gap-2">
                                    <span class="text-muted-foreground text-xs">Threshold</span>
                                    <InputCn @bind-Value="trigger.Threshold" Class="h-7 w-20 font-mono text-xs" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _duration = "14";
    private string _expirationBehavior = "downgrade";
    private bool _requireCard;
    private string? _expandedTrigger;
    private bool _saved;

    private record SelectOption(string Value, string Label);

    private static readonly List<SelectOption> _durations = new()
    {
        new("7", "7 days"), new("14", "14 days"), new("21", "21 days"), new("30", "30 days"),
    };

    private static readonly List<SelectOption> _expirationBehaviors = new()
    {
        new("downgrade", "Downgrade to free plan"), new("lock", "Lock account until upgrade"),
        new("grace", "3-day grace period"), new("readonly", "Read-only access"),
    };

    private class FeatureGate
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class ConversionTrigger
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
        public string Threshold { get; set; } = "";
    }

    private readonly List<FeatureGate> _features = new()
    {
        new() { Id = "api", Label = "API access", Description = "REST and GraphQL API endpoints", Enabled = true },
        new() { Id = "team", Label = "Team collaboration", Description = "Invite up to 3 members during trial", Enabled = true },
        new() { Id = "export", Label = "Data export", Description = "Export data in CSV and JSON formats", Enabled = false },
        new() { Id = "analytics", Label = "Advanced analytics", Description = "Custom dashboards and detailed reports", Enabled = true },
        new() { Id = "integrations", Label = "Third-party integrations", Description = "Connect to Slack, GitHub, Jira, and more", Enabled = false },
        new() { Id = "priority-support", Label = "Priority support", Description = "Live chat and priority ticket queue", Enabled = false },
    };

    private readonly List<ConversionTrigger> _triggers = new()
    {
        new() { Id = "usage-limit", Label = "Usage limit reached", Description = "Show upgrade modal when trial limits are hit", Enabled = true, Threshold = "80" },
        new() { Id = "feature-gate", Label = "Gated feature access", Description = "Prompt upgrade when locked features are clicked", Enabled = true, Threshold = "" },
        new() { Id = "expiration-warning", Label = "Trial expiration warning", Description = "Show banner when trial is about to expire", Enabled = true, Threshold = "3" },
        new() { Id = "team-invite", Label = "Team seat limit", Description = "Prompt upgrade when team seat limit is reached", Enabled = false, Threshold = "3" },
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
