@* ===========================================================
   Block: settings-language-region
   Title: Settings Language Region
   Description: Language and region settings with locale picker, timezone selection, date and number format previews, and currency display
   Dependencies: ButtonCn, LucideCalendarCn, LucideCheckCn, LucideClockCn, LucideDollarSignCn, LucideGlobeCn, LucideHashCn, LucideLanguagesCn, SelectCn
   Source: original/blocks/settings/settings-language-region.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideLanguagesCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Language &amp; Region</h2>
                        <p class="text-xs text-muted-foreground">
                            Locale, timezone, and display format preferences
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                          Class="h-7 gap-1.5 text-xs" @onclick="HandleSave">
                    @if (_saved)
                    {
                        <LucideCheckCn Size="16" Class="size-3" />
                        <text>Saved</text>
                    }
                    else
                    {
                        <text>Save changes</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Language *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideGlobeCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">Display language</p>
                        <p class="text-xs text-muted-foreground">@SelectedNativeName</p>
                    </div>
                </div>
                <SelectCn TValue="string" Value="@_locale" ValueChanged="v => _locale = v">
                    <SelectTriggerCn Class="h-7 w-44 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var l in _locales)
                        {
                            <SelectItemCn Value="@l.Code">@l.Name</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Timezone *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideClockCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">Timezone</p>
                        <p class="text-xs text-muted-foreground">
                            All dates and times displayed in this zone
                        </p>
                    </div>
                </div>
                <SelectCn TValue="string" Value="@_timezone" ValueChanged="v => _timezone = v">
                    <SelectTriggerCn Class="h-7 w-44 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var tz in _timezones)
                        {
                            <SelectItemCn Value="@tz.Id">@tz.Label (@tz.Offset)</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Date format *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideCalendarCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">Date format</p>
                        <p class="text-xs text-muted-foreground">How dates appear throughout the app</p>
                    </div>
                </div>
                <SelectCn TValue="string" Value="@_dateFormat" ValueChanged="v => _dateFormat = v">
                    <SelectTriggerCn Class="h-7 w-44 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="short">Short (@GetDateFormat("short"))</SelectItemCn>
                        <SelectItemCn Value="medium">Medium (@GetDateFormat("medium"))</SelectItemCn>
                        <SelectItemCn Value="long">Long (@GetDateFormat("long"))</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Format preview *@
        <div class="px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">FORMAT PREVIEW</p>
            <div class="space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideCalendarCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Date</span>
                    </div>
                    <span class="font-mono text-xs font-medium">@GetFormatPreview("date")</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideHashCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Number</span>
                    </div>
                    <span class="font-mono text-xs font-medium">@GetFormatPreview("number")</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideDollarSignCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Currency</span>
                    </div>
                    <span class="font-mono text-xs font-medium">@GetFormatPreview("currency")</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record LocaleOption(string Code, string Name, string NativeName, string Flag);
    private record TimezoneOption(string Id, string Label, string Offset);

    private string _locale = "en-US";
    private string _timezone = "est";
    private string _dateFormat = "medium";
    private bool _saved;

    private static readonly LocaleOption[] _locales =
    [
        new("en-US", "English (US)", "English", "US"),
        new("en-GB", "English (UK)", "English", "GB"),
        new("es-ES", "Spanish", "Espanol", "ES"),
        new("fr-FR", "French", "Francais", "FR"),
        new("de-DE", "German", "Deutsch", "DE"),
        new("ja-JP", "Japanese", "Nihongo", "JP"),
        new("pt-BR", "Portuguese (BR)", "Portugues", "BR"),
    ];

    private static readonly TimezoneOption[] _timezones =
    [
        new("utc", "UTC", "+00:00"),
        new("est", "Eastern Time", "-05:00"),
        new("cst", "Central Time", "-06:00"),
        new("pst", "Pacific Time", "-08:00"),
        new("gmt", "London (GMT)", "+00:00"),
        new("cet", "Central European", "+01:00"),
        new("jst", "Japan Standard", "+09:00"),
    ];

    private static readonly Dictionary<string, Dictionary<string, string>> _dateFormats = new()
    {
        ["en-US"] = new() { ["short"] = "03/17/2026", ["medium"] = "Mar 17, 2026", ["long"] = "March 17, 2026" },
        ["en-GB"] = new() { ["short"] = "17/03/2026", ["medium"] = "17 Mar 2026", ["long"] = "17 March 2026" },
        ["es-ES"] = new() { ["short"] = "17/03/2026", ["medium"] = "17 mar 2026", ["long"] = "17 de marzo de 2026" },
        ["fr-FR"] = new() { ["short"] = "17/03/2026", ["medium"] = "17 mars 2026", ["long"] = "17 mars 2026" },
        ["de-DE"] = new() { ["short"] = "17.03.2026", ["medium"] = "17. Marz 2026", ["long"] = "17. Marz 2026" },
        ["ja-JP"] = new() { ["short"] = "2026/03/17", ["medium"] = "2026/03/17", ["long"] = "2026/03/17" },
        ["pt-BR"] = new() { ["short"] = "17/03/2026", ["medium"] = "17 de mar de 2026", ["long"] = "17 de marco de 2026" },
    };

    private static readonly Dictionary<string, Dictionary<string, string>> _formatPreviews = new()
    {
        ["date"] = new() { ["en-US"] = "March 17, 2026", ["en-GB"] = "17 March 2026", ["es-ES"] = "17 de marzo de 2026", ["fr-FR"] = "17 mars 2026", ["de-DE"] = "17. Marz 2026", ["ja-JP"] = "2026/03/17", ["pt-BR"] = "17 de marco de 2026" },
        ["number"] = new() { ["en-US"] = "1,234,567.89", ["en-GB"] = "1,234,567.89", ["es-ES"] = "1.234.567,89", ["fr-FR"] = "1 234 567,89", ["de-DE"] = "1.234.567,89", ["ja-JP"] = "1,234,567.89", ["pt-BR"] = "1.234.567,89" },
        ["currency"] = new() { ["en-US"] = "$1,234.56", ["en-GB"] = "GBP1,234.56", ["es-ES"] = "1.234,56 EUR", ["fr-FR"] = "1 234,56 EUR", ["de-DE"] = "1.234,56 EUR", ["ja-JP"] = "JPY1,234", ["pt-BR"] = "R$ 1.234,56" },
    };

    private string SelectedNativeName => _locales.FirstOrDefault(l => l.Code == _locale)?.NativeName ?? "";

    private string GetDateFormat(string format) =>
        _dateFormats.TryGetValue(_locale, out var formats) && formats.TryGetValue(format, out var value)
            ? value
            : "03/17/2026";

    private string GetFormatPreview(string type) =>
        _formatPreviews.TryGetValue(type, out var values) && values.TryGetValue(_locale, out var value)
            ? value
            : "";

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
