@* ===========================================================
   Block: settings-brand-assets
   Title: Settings Brand Assets
   Description: React animated brand asset management settings block for Next.js with logo variant uploads, brand color palette, typography settings, and usage guidelines using shadcn/ui, framer-motion, and Tailwind CSS
   Long Description: Notification frequency and product areas
   Dependencies: ButtonCn
   Source: original/blocks/settings/settings-brand-assets.tsx
   =========================================================== *@

    <section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <LucidePaletteCn Class="h-5 w-5 text-muted-foreground" />
              <div>
                <h2 class="font-medium text-sm">Brand Assets</h2>
                <p class="text-muted-foreground text-xs">
                  Manage logos, colors, fonts, and brand guidelines
                </p>
              </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
              <LucideDownloadCn Class="h-3.5 w-3.5" />
              Export Kit
            </ButtonCn>
          </div>
        </div>

        <motion.div variants={stagger} initial="hidden" animate="visible">
          @* Logo variants *@
          <motion.div variants={item} class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
              <span class="font-medium text-muted-foreground text-xs">Logo Variants</span>
              <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                <LucidePlusCn Class="h-3 w-3" />
                Add Variant
              </ButtonCn>
            </div>
            <div class="grid grid-cols-2 gap-2">
</div>
</motion.div>
</motion.div>
</div>
</section>

@code {
    private string? _copiedColor = null;
