@* ===========================================================
   Block: settings-audit-log
   Title: Settings Audit Log
   Description: Filterable audit log with severity, event types, expandable details
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn
   Source: original/blocks/settings/settings-audit-log.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Audit Log</h2>
                    <p class="text-muted-foreground text-xs">@_events.Count events in the last 90 days</p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs">
                    <LucideDownloadCn Size="12" Class="size-3" />
                    Export
                </ButtonCn>
            </div>
        </div>

        @* Search and filter *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideSearchCn Class="absolute left-0 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn @bind-Value="_search" Placeholder="Search events..." Class="h-7 border-0 bg-transparent pl-5 shadow-none focus-visible:ring-0 text-xs" />
            </div>
            <div class="flex items-center gap-1.5">
                <LucideFunnelCn Size="12" Class="size-3 text-muted-foreground" />
                <SelectCn @bind-Value="_filterType">
                    <SelectTriggerCn Class="h-7 w-32 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="all">All Events</SelectItemCn>
                        <SelectItemCn Value="auth">Authentication</SelectItemCn>
                        <SelectItemCn Value="permissions">Permissions</SelectItemCn>
                        <SelectItemCn Value="data">Data</SelectItemCn>
                        <SelectItemCn Value="billing">Billing</SelectItemCn>
                        <SelectItemCn Value="settings">Settings</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Event list *@
        <div>
            @{ var filtered = GetFilteredEvents(); }
            @for (var i = 0; i < filtered.Count; i++)
            {
                var evt = filtered[i];
                var isLast = i == filtered.Count - 1;
                var isExpanded = _expanded == evt.Id;
                var dotClass = evt.Severity == "high" ? "bg-red-500" : evt.Severity == "medium" ? "bg-amber-500" : "bg-blue-500";
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : evt.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dotClass)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@evt.Action</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                    @evt.EventType
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@evt.Actor · @evt.Timestamp</p>
                        </div>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="mb-2 text-sm leading-relaxed">@evt.Details</p>
                                    <div class="flex flex-wrap items-center gap-3 text-muted-foreground text-xs">
                                        <span>Resource: <span class="font-mono text-foreground">@evt.Resource</span></span>
                                        <span class="text-muted-foreground/40">·</span>
                                        <span class="flex items-center gap-1">
                                            <LucideGlobeCn Size="12" Class="size-3" />
                                            <span class="font-mono">@evt.Ip</span>
                                        </span>
                                        <span class="text-muted-foreground/40">·</span>
                                        <span class="font-mono">@evt.ActorEmail</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (filtered.Count == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                    No events match your filters
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AuditEvent(string Id, string Action, string EventType, string Actor, string ActorEmail, string Timestamp, string Severity, string Details, string Resource, string Ip);

    private static readonly List<AuditEvent> _events =
    [
        new("1", "User login", "auth", "Alex Chen", "alex@acme.com", "2 min ago", "low", "Successful login from Chrome on macOS", "auth/session", "192.168.1.42"),
        new("2", "Role changed", "permissions", "Sarah Kim", "sarah@acme.com", "1 hour ago", "medium", "Changed role from Viewer to Editor for user david.park", "team/members", "10.0.0.15"),
        new("3", "API key created", "settings", "Alex Chen", "alex@acme.com", "3 hours ago", "medium", "New API key 'CI Pipeline' created with deploy scope", "settings/api-keys", "192.168.1.42"),
        new("4", "Data exported", "data", "Marcus Johnson", "marcus@acme.com", "Yesterday", "high", "Exported 12,847 customer records in CSV format", "data/export", "172.16.0.8"),
        new("5", "Billing updated", "billing", "Alex Chen", "alex@acme.com", "2 days ago", "medium", "Payment method updated to Visa ending in 4242", "billing/payment", "192.168.1.42"),
    ];

    private string _filterType = "all";
    private string _search = "";
    private string? _expanded = null;

    private List<AuditEvent> GetFilteredEvents()
    {
        return _events
            .Where(e => _filterType == "all" || e.EventType == _filterType)
            .Where(e => string.IsNullOrEmpty(_search) || e.Action.Contains(_search, StringComparison.OrdinalIgnoreCase) || e.Actor.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
