@* ===========================================================
   Block: settings-profile
   Title: Settings Profile
   Description: Avatar upload, name, email, bio fields, timezone selector
   Dependencies: ButtonCn, InputCn, SelectCn, TextareaCn
   Source: original/blocks/settings/settings-profile.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Profile</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage your personal information and public profile
            </p>
        </div>

        @* Avatar section *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <div class="flex size-16 shrink-0 items-center justify-center rounded-full bg-muted/50">
                <LucideUserCn Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Profile photo</p>
                <p class="mt-0.5 text-muted-foreground text-xs">JPG, PNG or WebP. 1MB max.</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideCameraCn Size="12" Class="size-3" />
                Upload
            </ButtonCn>
        </div>

        @* Name fields *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-4">
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">First name</span>
                <InputCn @bind-Value="_firstName" Class="h-8 text-sm" />
            </div>
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Last name</span>
                <InputCn @bind-Value="_lastName" Class="h-8 text-sm" />
            </div>
        </div>

        @* Email *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Email address</span>
            <InputCn type="email" @bind-Value="_email" Class="h-8 text-sm" />
        </div>

        @* Bio *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Bio</span>
            <TextareaCn @bind-Value="_bio" Class="min-h-20 text-sm" rows="3" />
            <p class="mt-1.5 text-muted-foreground text-xs">
                Brief description for your profile. Max 160 characters.
            </p>
        </div>

        @* Timezone *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Timezone</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Used for scheduling and activity timestamps
                </p>
            </div>
            <SelectCn @bind-Value="_timezone">
                <SelectTriggerCn Class="h-8 w-48 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="America/New_York">Eastern (UTC-5)</SelectItemCn>
                    <SelectItemCn Value="America/Chicago">Central (UTC-6)</SelectItemCn>
                    <SelectItemCn Value="America/Denver">Mountain (UTC-7)</SelectItemCn>
                    <SelectItemCn Value="America/Los_Angeles">Pacific (UTC-8)</SelectItemCn>
                    <SelectItemCn Value="Europe/London">London (UTC+0)</SelectItemCn>
                    <SelectItemCn Value="Europe/Berlin">Berlin (UTC+1)</SelectItemCn>
                    <SelectItemCn Value="Asia/Tokyo">Tokyo (UTC+9)</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _firstName = "Alex";
    private string _lastName = "Chen";
    private string _email = "alex.chen@acme.com";
    private string _bio = "Product engineer building developer tools. Passionate about design systems and component-driven architecture.";
    private string _timezone = "America/New_York";
    private bool _saved = false;
}
