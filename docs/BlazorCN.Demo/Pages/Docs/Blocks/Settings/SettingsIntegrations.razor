@* ===========================================================
   Block: settings-integrations
   Title: Settings Integrations
   Description: Third-party service connections with status indicators
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/settings/settings-integrations.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Integrations</p>
            <p class="mt-0.5 text-muted-foreground text-xs">Connect third-party services to extend your workflow</p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideLinkCn Size="12" Class="size-3 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                <span class="tabular-nums">@_integrations.Count(i => i.Status == "connected")</span> of
                <span class="tabular-nums">@_integrations.Count</span> integrations connected
            </span>
        </div>

        @* Integrations list *@
        <div>
            @for (var i = 0; i < _integrations.Count; i++)
            {
                var integration = _integrations[i];
                var isLast = i == _integrations.Count - 1;
                var isExpanded = _expanded == integration.Id;
                var dotClass = integration.Status == "connected" ? "bg-emerald-500" : integration.Status == "error" ? "bg-red-500" : "bg-muted-foreground/30";
                var statusLabel = integration.Status == "connected" ? "Connected" : integration.Status == "error" ? "Error" : "Not connected";
                var statusTextClass = integration.Status == "connected" ? "text-emerald-600 dark:text-emerald-400" : integration.Status == "error" ? "text-red-600 dark:text-red-400" : "text-muted-foreground";
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : integration.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dotClass)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@integration.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@integration.Category</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@integration.Description</p>
                        </div>
                        <span class="@Cn.Merge("shrink-0 text-xs", statusTextClass)">@statusLabel</span>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-9">
                                @if (!string.IsNullOrEmpty(integration.ConnectedAs))
                                {
                                    <div class="mb-3 rounded-md bg-muted/50 p-3">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <span class="font-medium text-muted-foreground text-xs">Connected as</span>
                                                <p class="mt-0.5 font-mono text-sm">@integration.ConnectedAs</p>
                                            </div>
                                            @if (!string.IsNullOrEmpty(integration.LastSynced))
                                            {
                                                <span class="text-muted-foreground text-xs">Synced @integration.LastSynced</span>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="flex items-center gap-2">
                                    @if (integration.Status == "connected" || integration.Status == "error")
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-red-600 text-xs dark:text-red-400">
                                            <LucideUnlinkCn Size="12" Class="size-3" />
                                            Disconnect
                                        </ButtonCn>
                                    }
                                    else
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                            <LucideLinkCn Size="12" Class="size-3" />
                                            Connect
                                        </ButtonCn>
                                    }
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                        <LucideExternalLinkCn Size="12" Class="size-3" />
                                        Docs
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record IntegrationItem(string Id, string Name, string Category, string Description, string Status, string? ConnectedAs, string? LastSynced);

    private static readonly List<IntegrationItem> _integrations =
    [
        new("github", "GitHub", "Source Control", "Sync repositories and automate deployments", "connected", "acme-org", "5 min ago"),
        new("slack", "Slack", "Communication", "Send notifications to Slack channels", "connected", "#engineering", "1 hour ago"),
        new("stripe", "Stripe", "Payments", "Process payments and manage subscriptions", "connected", "acct_1234", "2 hours ago"),
        new("linear", "Linear", "Project Management", "Sync issues and track progress", "disconnected", null, null),
        new("sentry", "Sentry", "Monitoring", "Track errors and performance issues", "error", "acme-prod", "3 days ago"),
    ];

    private string? _expanded = null;
}
