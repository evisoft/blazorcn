@* ===========================================================
   Block: settings-connected-accounts
   Title: Settings Connected Accounts
   Description: React animated connected accounts settings block for Next.js with social and service account linking, OAuth status indicators, sync timestamps, and unlink confirmation using shadcn/ui, framer-motion, and Tailwind CSS
   Long Description: Personal access token management
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-connected-accounts.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideLinkCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                <div>
                    <h2 class="font-medium text-sm">Connected Accounts</h2>
                    <p class="text-muted-foreground text-xs">Link external services and manage sync settings</p>
                </div>
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-2">
            <span class="text-muted-foreground text-xs">
                @_accounts.Count(a => a.Connected) of @_accounts.Count connected
            </span>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">
                    @_accounts.Count(a => a.Connected && a.AutoSync) auto-syncing
                </span>
            </div>
        </div>

        @* Categories *@
        @foreach (var category in _categories)
        {
            var categoryAccounts = _accounts.Where(a => a.Category == category.Id).ToList();
            <div class="border-b last:border-b-0">
                <div class="px-4 pt-3 pb-1">
                    <span class="font-medium text-muted-foreground text-xs uppercase">@category.Label</span>
                </div>
                @foreach (var account in categoryAccounts)
                {
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", account.Connected ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@account.Provider</span>
                                    @if (account.Connected && !string.IsNullOrEmpty(account.Username))
                                    {
                                        <span class="text-muted-foreground text-xs">@account.Username</span>
                                    }
                                </div>
                                @if (account.Connected)
                                {
                                    <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                        @if (!string.IsNullOrEmpty(account.ProfileUrl))
                                        {
                                            <span class="flex items-center gap-1">
                                                <LucideExternalLinkCn Size="10" Class="h-2.5 w-2.5" />
                                                @account.ProfileUrl
                                            </span>
                                            <span>&middot;</span>
                                        }
                                        <span>Synced @account.LastSync</span>
                                    </div>
                                }
                            </div>
                            @if (account.Connected)
                            {
                                <div class="flex items-center gap-2">
                                    <ButtonCn aria-label="Sync now" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 shrink-0 p-0" Disabled="@(_syncing == account.Id)" OnClick="() => _syncing = account.Id">
                                        @if (_syncing == account.Id)
                                        {
                                            <LucideLoaderCircleCn Size="14" Class="h-3.5 w-3.5 animate-spin text-muted-foreground" />
                                        }
                                        else
                                        {
                                            <LucideRefreshCwCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                        }
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-red-600 text-xs hover:text-red-700">
                                        <LucideUnlinkCn Size="12" Class="h-3 w-3" />
                                        Unlink
                                    </ButtonCn>
                                </div>
                            }
                            else
                            {
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                    <LucideLinkCn Size="12" Class="h-3 w-3" />
                                    Connect
                                </ButtonCn>
                            }
                        </div>

                        @if (account.Connected)
                        {
                            <div class="ml-5 mt-2 space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Auto-sync</span>
                                    <SwitchCn aria-label="Auto-sync" Checked="account.AutoSync" CheckedChanged="() => account.AutoSync = !account.AutoSync" />
                                </div>
                                @if (account.Scopes.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var scope in account.Scopes)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">@scope</BadgeCn>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _syncing;

    private record CategoryInfo(string Id, string Label);

    private class AccountInfo
    {
        public string Id { get; set; } = "";
        public string Provider { get; set; } = "";
        public string Username { get; set; } = "";
        public string ProfileUrl { get; set; } = "";
        public bool Connected { get; set; }
        public bool AutoSync { get; set; }
        public string LastSync { get; set; } = "";
        public List<string> Scopes { get; set; } = [];
        public string Category { get; set; } = "";
    }

    private static readonly CategoryInfo[] _categories =
    [
        new("developer", "Developer Platforms"),
        new("productivity", "Productivity"),
        new("social", "Social"),
    ];

    private readonly List<AccountInfo> _accounts =
    [
        new() { Id = "github", Provider = "GitHub", Username = "acme-corp", ProfileUrl = "github.com/acme-corp", Connected = true, AutoSync = true, LastSync = "5 min ago", Scopes = ["repo", "read:org", "read:user"], Category = "developer" },
        new() { Id = "gitlab", Provider = "GitLab", Username = "acme-corp", ProfileUrl = "gitlab.com/acme-corp", Connected = true, AutoSync = false, LastSync = "2 days ago", Scopes = ["read_api", "read_repository"], Category = "developer" },
        new() { Id = "slack", Provider = "Slack", Username = "Acme Workspace", ProfileUrl = "acme-corp.slack.com", Connected = true, AutoSync = true, LastSync = "Just now", Scopes = ["channels:read", "chat:write", "users:read"], Category = "productivity" },
        new() { Id = "notion", Provider = "Notion", Username = "", ProfileUrl = "", Connected = false, AutoSync = false, LastSync = "", Scopes = [], Category = "productivity" },
        new() { Id = "figma", Provider = "Figma", Username = "", ProfileUrl = "", Connected = false, AutoSync = false, LastSync = "", Scopes = [], Category = "productivity" },
        new() { Id = "twitter", Provider = "X (Twitter)", Username = "@@acme_corp", ProfileUrl = "x.com/acme_corp", Connected = true, AutoSync = false, LastSync = "1 week ago", Scopes = ["tweet.read", "users.read"], Category = "social" },
        new() { Id = "linkedin", Provider = "LinkedIn", Username = "", ProfileUrl = "", Connected = false, AutoSync = false, LastSync = "", Scopes = [], Category = "social" },
    ];
}
