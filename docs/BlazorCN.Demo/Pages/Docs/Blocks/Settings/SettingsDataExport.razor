@* ===========================================================
   Block: settings-data-export
   Title: Settings Data Export
   Description: React animated data export settings block for Next.js with format selection, scheduled exports, download history, and progress tracking using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Backup scheduling and restore options
   Dependencies: BadgeCn, ButtonCn, ProgressCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-data-export.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Data Export</h2>
            <p class="text-xs text-muted-foreground">Export your data in multiple formats with scheduling</p>
        </div>

        @* Data categories *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">
                SELECT DATA (@_categories.Count(c => c.Selected) of @_categories.Count)
            </p>
            <div class="space-y-1">
                @foreach (var cat in _categories)
                {
                    <span class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50">
                        <SwitchCn aria-label="@cat.Label" Checked="cat.Selected" CheckedChanged="() => cat.Selected = !cat.Selected" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@cat.Label</span>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@cat.Count</span>
                                <span>&middot;</span>
                                <span class="font-mono">@cat.Size</span>
                            </div>
                        </div>
                    </span>
                }
            </div>
        </div>

        @* Format and export *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">FORMAT &amp; EXPORT</p>
            @if (_isExporting)
            {
                <div class="rounded-md border p-3">
                    <div class="flex items-center gap-3">
                        <LucideLoaderCircleCn Size="16" Class="size-4 shrink-0 animate-spin text-muted-foreground" />
                        <div class="flex-1">
                            <p class="text-xs font-medium">Preparing export...</p>
                            <p class="text-xs text-muted-foreground">
                                Packaging @_categories.Count(c => c.Selected) data categories as @_format.ToUpper()
                            </p>
                        </div>
                        <span class="font-mono text-xs font-semibold tabular-nums">@_exportProgress%</span>
                    </div>
                    <ProgressCn Value="_exportProgress" Class="mt-2" aria-label="Progress" />
                </div>
            }
            else
            {
                <div class="flex items-end gap-3">
                    <div class="flex-1">
                        <SelectCn @bind-Value="_format">
                            <SelectTriggerCn aria-label="Export format" Class="h-8 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="json">JSON</SelectItemCn>
                                <SelectItemCn Value="csv">CSV</SelectItemCn>
                                <SelectItemCn Value="xml">XML</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-1.5 text-xs" Disabled="@(!_categories.Any(c => c.Selected))" OnClick="HandleExport">
                        <LucideDownloadCn Size="12" Class="size-3" />
                        Export now
                    </ButtonCn>
                </div>
            }
        </div>

        @* Scheduled exports *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Scheduled exports</p>
                    <p class="text-xs text-muted-foreground">Automatically export data on a recurring basis</p>
                </div>
                <SwitchCn aria-label="Scheduled exports" @bind-Checked="_scheduledExports" />
            </div>
            @if (_scheduledExports)
            {
                <div class="mt-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideCalendarCn Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Frequency</span>
                    </div>
                    <SelectCn @bind-Value="_scheduleFrequency">
                        <SelectTriggerCn aria-label="Export frequency" Class="h-7 w-28 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="weekly">Weekly</SelectItemCn>
                            <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="mt-2 rounded-md bg-muted/50 p-2">
                    <p class="text-xs text-muted-foreground">
                        Next export: <span class="font-medium text-foreground">Mar 24, 2026</span>
                        &middot; @_format.ToUpper() format
                    </p>
                </div>
            }
        </div>

        @* Download history *@
        <div>
            <div class="border-b px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">DOWNLOAD HISTORY</p>
            </div>
            @for (var i = 0; i < _exportHistory.Count; i++)
            {
                var record = _exportHistory[i];
                var isLast = i == _exportHistory.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <LucideFileTextCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium">@record.Format.ToUpper() export</span>
                            <span class="@Cn.Merge("size-1.5 rounded-full", record.Status == "completed" ? "bg-emerald-500" : "bg-muted-foreground")"></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@record.Date</span>
                            <span>&middot;</span>
                            <span class="font-mono">@record.Size</span>
                            <span>&middot;</span>
                            <span>@string.Join(", ", record.Categories)</span>
                        </div>
                    </div>
                    @if (record.Status == "completed")
                    {
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-xs">
                            <LucideDownloadCn Size="12" Class="size-3" />
                            Download
                        </ButtonCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 text-[10px]">Expired</BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _format = "json";
    private bool _scheduledExports;
    private string _scheduleFrequency = "weekly";
    private bool _isExporting;
    private int _exportProgress;

    private class DataCategory
    {
        public string Label { get; set; } = "";
        public string Count { get; set; } = "";
        public string Size { get; set; } = "";
        public bool Selected { get; set; }
    }

    private record ExportRecord(string Format, string Date, string Size, string Status, string[] Categories);

    private readonly List<DataCategory> _categories =
    [
        new() { Label = "Profile & account", Count = "24 fields", Size = "12 KB", Selected = true },
        new() { Label = "Content & uploads", Count = "1,247 items", Size = "842 MB", Selected = true },
        new() { Label = "Activity & logs", Count = "32,891 events", Size = "18 MB", Selected = true },
        new() { Label = "Billing & invoices", Count = "36 records", Size = "240 KB", Selected = false },
        new() { Label = "Integrations & tokens", Count = "8 connections", Size = "4 KB", Selected = false },
    ];

    private static readonly List<ExportRecord> _exportHistory =
    [
        new("json", "Mar 15, 2026", "856 MB", "completed", ["Profile", "Content", "Activity"]),
        new("csv", "Mar 8, 2026", "412 MB", "completed", ["Activity", "Billing"]),
        new("json", "Feb 22, 2026", "830 MB", "expired", ["Profile", "Content", "Activity"]),
        new("xml", "Feb 1, 2026", "1.1 GB", "expired", ["All data"]),
    ];

    private void HandleExport()
    {
        _isExporting = true;
        _exportProgress = 0;
    }
}
