@* ===========================================================
   Block: settings-file-storage
   Title: Settings File Storage
   Description: File storage settings with cloud provider selection, bucket configuration, upload size limits, and storage usage display
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideCloudCn, LucideHardDriveCn, LucideServerCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-file-storage.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">File Storage</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Configure your storage provider, bucket, and upload limits
            </p>
        </div>

        @* Storage usage *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideHardDriveCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">Storage usage</span>
                </div>
                <span class="text-xs text-muted-foreground">
                    @UsedGB GB of @TotalGB GB used
                </span>
            </div>
            <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-foreground" style="@($"width: {UsagePercent:F1}%")"></div>
            </div>
            <div class="mt-2 flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-foreground"></span>
                    Used
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-muted"></span>
                    Available
                </span>
            </div>
        </div>

        @* Provider *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Storage provider</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Cloud provider for file uploads</p>
            </div>
            <SelectCn TValue="string" Value="@_provider" ValueChanged="v => _provider = v">
                <SelectTriggerCn Class="h-8 w-52 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var p in _providers)
                    {
                        <SelectItemCn Value="@p.Id">@p.Name</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Bucket name *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                Bucket name
            </span>
            <InputCn @bind-Value="_bucket" Placeholder="my-app-uploads" Class="h-8 font-mono text-sm" />
            <p class="mt-1.5 text-xs text-muted-foreground">
                Must be globally unique. Lowercase letters, numbers, and hyphens only.
            </p>
        </div>

        @* Region *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Region</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Data center location for your bucket
                </p>
            </div>
            <SelectCn TValue="string" Value="@_region" ValueChanged="v => _region = v">
                <SelectTriggerCn Class="h-8 w-52 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var r in _regions)
                    {
                        <SelectItemCn Value="@r.Value">@r.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Max file size *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Max file size</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Maximum upload size per file in megabytes
                </p>
            </div>
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_maxFileSize" Type="number" Class="h-8 w-20 text-right text-sm" />
                <span class="text-xs text-muted-foreground">MB</span>
            </div>
        </div>

        @* Versioning *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">File versioning</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Keep previous versions of overwritten files
                </p>
            </div>
            <SwitchCn @bind-Checked="_versioning" />
        </div>

        @* CDN *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">CDN delivery</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Serve files through a global CDN for faster downloads
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_cdnEnabled)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                        Active
                    </BadgeCn>
                }
                <SwitchCn @bind-Checked="_cdnEnabled" />
            </div>
        </div>

        @* Public access *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Public access</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Allow unauthenticated access to files via public URLs
                </p>
            </div>
            <SwitchCn @bind-Checked="_publicAccess" />
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                    <LucideCheckCn Size="16" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                      @onclick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StorageProvider(string Id, string Name, string Description);
    private record RegionOption(string Value, string Label);

    private const double UsedGB = 42.7;
    private const double TotalGB = 100;
    private const double UsagePercent = (UsedGB / TotalGB) * 100;

    private string _provider = "aws-s3";
    private string _bucket = "acme-uploads-prod";
    private string _region = "us-east-1";
    private string _maxFileSize = "25";
    private bool _publicAccess;
    private bool _versioning = true;
    private bool _cdnEnabled = true;
    private bool _saved;

    private static readonly StorageProvider[] _providers =
    [
        new("aws-s3", "Amazon S3", "AWS object storage"),
        new("gcs", "Google Cloud Storage", "GCP blob storage"),
        new("azure-blob", "Azure Blob", "Azure object storage"),
        new("r2", "Cloudflare R2", "Zero egress storage"),
        new("minio", "MinIO", "Self-hosted S3 compatible"),
    ];

    private static readonly RegionOption[] _regions =
    [
        new("us-east-1", "US East (Virginia)"),
        new("us-west-2", "US West (Oregon)"),
        new("eu-west-1", "EU (Ireland)"),
        new("eu-central-1", "EU (Frankfurt)"),
        new("ap-northeast-1", "Asia Pacific (Tokyo)"),
        new("ap-southeast-1", "Asia Pacific (Singapore)"),
    ];

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
