@* ===========================================================
   Block: settings-mobile-push
   Title: Settings Mobile Push
   Description: Animated React mobile push notification settings page for Next.js with device management, sound preferences, badge toggles, and quiet hours configuration built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Multi-channel notification routing
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-mobile-push.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Push Notifications</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage devices, sounds, and notification delivery
            </p>
        </div>

        @* Global toggle *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <LucideBellCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Enable push notifications</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Send notifications to all registered devices
                    </p>
                </div>
            </div>
            <SwitchCn @bind-Checked="_globalPush" />
        </div>

        @* Devices *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Registered devices
            </span>
            <div class="space-y-1">
                @foreach (var device in _devices)
                {
                    <div class="rounded-md px-3 py-3 transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-3">
                            @if (device.Type == "tablet")
                            {
                                <LucideTabletCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            else if (device.Type == "desktop")
                            {
                                <LucideMonitorSmartphoneCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideSmartphoneCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@device.Name</span>
                                    @if (device.PushEnabled)
                                    {
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    }
                                </div>
                                <p class="text-muted-foreground text-xs">
                                    @device.Os &middot; @device.LastActive
                                </p>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0 text-muted-foreground hover:text-red-600" OnClick="() => RemoveDevice(device.Id)">
                                <LucideTrashCn Size="14" Class="size-3.5" />
                            </ButtonCn>
                        </div>
                        <div class="mt-3 ml-7 flex items-center gap-6">
                            <span class="flex items-center gap-2">
                                <SwitchCn @bind-Checked="device.PushEnabled" />
                                <span class="text-muted-foreground text-xs">Push</span>
                            </span>
                            <span class="flex items-center gap-2">
                                <SwitchCn @bind-Checked="device.SoundEnabled" />
                                <span class="text-muted-foreground text-xs">Sound</span>
                            </span>
                            <span class="flex items-center gap-2">
                                <SwitchCn @bind-Checked="device.BadgeEnabled" />
                                <span class="text-muted-foreground text-xs">Badge</span>
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Priority *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <LucideVolume2Cn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Default priority</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Controls how notifications are delivered
                    </p>
                </div>
            </div>
            <SelectCn @bind-Value="_priority">
                <SelectTriggerCn Class="h-8 w-28 text-xs">
                    <SelectValueCn Placeholder="Select" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("high")">High</SelectItemCn>
                    <SelectItemCn Value="@("normal")">Normal</SelectItemCn>
                    <SelectItemCn Value="@("low")">Low</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Quiet hours *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Quiet hours</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Silence notifications during specific hours
                    </p>
                </div>
                <SwitchCn @bind-Checked="_quietHoursEnabled" />
            </div>
            @if (_quietHoursEnabled)
            {
                <div class="mt-3 flex items-center gap-3">
                    <div>
                        <span class="mb-1 block text-muted-foreground text-xs">From</span>
                        <SelectCn @bind-Value="_quietStart">
                            <SelectTriggerCn Class="h-8 w-24 text-xs">
                                <SelectValueCn Placeholder="Select" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="@("20:00")">8:00 PM</SelectItemCn>
                                <SelectItemCn Value="@("21:00")">9:00 PM</SelectItemCn>
                                <SelectItemCn Value="@("22:00")">10:00 PM</SelectItemCn>
                                <SelectItemCn Value="@("23:00")">11:00 PM</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div>
                        <span class="mb-1 block text-muted-foreground text-xs">To</span>
                        <SelectCn @bind-Value="_quietEnd">
                            <SelectTriggerCn Class="h-8 w-24 text-xs">
                                <SelectValueCn Placeholder="Select" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="@("06:00")">6:00 AM</SelectItemCn>
                                <SelectItemCn Value="@("07:00")">7:00 AM</SelectItemCn>
                                <SelectItemCn Value="@("08:00")">8:00 AM</SelectItemCn>
                                <SelectItemCn Value="@("09:00")">9:00 AM</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-4 font-normal text-xs">
                        9 hours
                    </BadgeCn>
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _globalPush = true;
    private string _priority = "normal";
    private bool _quietHoursEnabled = true;
    private string _quietStart = "22:00";
    private string _quietEnd = "07:00";
    private bool _saved;

    private class DeviceInfo
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
        public string Os { get; set; } = "";
        public string LastActive { get; set; } = "";
        public bool PushEnabled { get; set; }
        public bool SoundEnabled { get; set; }
        public bool BadgeEnabled { get; set; }
    }

    private readonly List<DeviceInfo> _devices = new()
    {
        new() { Id = "d1", Name = "iPhone 16 Pro", Type = "phone", Os = "iOS 19.2", LastActive = "Just now", PushEnabled = true, SoundEnabled = true, BadgeEnabled = true },
        new() { Id = "d2", Name = "iPad Air", Type = "tablet", Os = "iPadOS 19.2", LastActive = "3 hours ago", PushEnabled = true, SoundEnabled = false, BadgeEnabled = true },
        new() { Id = "d3", Name = "Pixel 9", Type = "phone", Os = "Android 16", LastActive = "2 days ago", PushEnabled = false, SoundEnabled = false, BadgeEnabled = false },
    };

    private void RemoveDevice(string id) => _devices.RemoveAll(d => d.Id == id);

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
