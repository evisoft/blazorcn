@* ===========================================================
   Block: settings-pipeline-config
   Title: Settings Pipeline Config
   Description: Animated React CI/CD pipeline configuration settings page for Next.js with stage management, trigger rules, environment matrix, and build history built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Multi-channel notification routing
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-pipeline-config.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Pipeline Configuration</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage build stages, triggers, and deployment settings
            </p>
        </div>

        @* Pipeline summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">@PassingCount passing</span>
            </div>
            @if (FailingCount > 0)
            {
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-muted-foreground text-xs">@FailingCount failing</span>
                </div>
            }
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">
                @(_stages.Count(s => s.Enabled)) stages active
            </span>
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucidePlayCn Size="12" Class="size-3" />
                    Run pipeline
                </ButtonCn>
            </div>
        </div>

        @* Stages *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Stages</span>
            </div>
            @for (var i = 0; i < _stages.Count; i++)
            {
                var stage = _stages[i];
                var isExpanded = _expanded == stage.Id;
                var isLast = i == _stages.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="() => _expanded = isExpanded ? null : stage.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", stage.Enabled ? _statusDot[stage.Status] : "bg-muted-foreground/20")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", !stage.Enabled ? "text-muted-foreground" : "")">
                                    @stage.Name
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @_triggerLabels[stage.Trigger]
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@stage.Description</p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <LucideSettingsCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-sm">Enabled</span>
                                </div>
                                <SwitchCn @bind-Checked="stage.Enabled" />
                            </div>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <LucideGitBranchCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-sm">Trigger</span>
                                </div>
                                <SelectCn @bind-Value="stage.Trigger">
                                    <SelectTriggerCn Class="h-7 w-28 text-xs">
                                        <SelectValueCn Placeholder="Select" />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="@("push")">On push</SelectItemCn>
                                        <SelectItemCn Value="@("pull_request")">On PR</SelectItemCn>
                                        <SelectItemCn Value="@("tag")">On tag</SelectItemCn>
                                        <SelectItemCn Value="@("manual")">Manual</SelectItemCn>
                                        <SelectItemCn Value="@("schedule")">Scheduled</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <LucideTimerCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-sm">Timeout</span>
                                </div>
                                <SelectCn @bind-Value="stage.Timeout">
                                    <SelectTriggerCn Class="h-7 w-28 text-xs">
                                        <SelectValueCn Placeholder="Select" />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="@("5")">5 min</SelectItemCn>
                                        <SelectItemCn Value="@("10")">10 min</SelectItemCn>
                                        <SelectItemCn Value="@("15")">15 min</SelectItemCn>
                                        <SelectItemCn Value="@("30")">30 min</SelectItemCn>
                                        <SelectItemCn Value="@("60")">60 min</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Environment matrix *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideLayersCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Environment matrix</span>
            </div>
            <div class="space-y-3">
                @foreach (var env in _envConfig)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-sm">@env.Label</span>
                        <SelectCn @bind-Value="env.Selected">
                            <SelectTriggerCn Class="h-8 w-40 font-mono text-xs">
                                <SelectValueCn Placeholder="Select" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var val in env.Values)
                                {
                                    <SelectItemCn Value="@val">@val</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                }
            </div>
        </div>

        @* Auto deploy *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Auto-deploy on success</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Automatically deploy when all stages pass
                </p>
            </div>
            <SwitchCn @bind-Checked="_autoDeploy" />
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "e2e";
    private bool _autoDeploy = true;
    private bool _saved;

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["passing"] = "bg-emerald-500",
        ["failing"] = "bg-red-500",
        ["skipped"] = "bg-muted-foreground/40",
    };

    private static readonly Dictionary<string, string> _triggerLabels = new()
    {
        ["push"] = "On push",
        ["pull_request"] = "On PR",
        ["tag"] = "On tag",
        ["manual"] = "Manual",
        ["schedule"] = "Scheduled",
    };

    private class PipelineStage
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
        public string Trigger { get; set; } = "";
        public string Timeout { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private class EnvOption
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public List<string> Values { get; set; } = new();
        public string Selected { get; set; } = "";
    }

    private readonly List<PipelineStage> _stages = new()
    {
        new() { Id = "lint", Name = "Lint & Format", Description = "ESLint, Prettier, type checking", Enabled = true, Trigger = "push", Timeout = "5", Status = "passing" },
        new() { Id = "test", Name = "Unit Tests", Description = "Vitest with coverage threshold 80%", Enabled = true, Trigger = "push", Timeout = "10", Status = "passing" },
        new() { Id = "e2e", Name = "E2E Tests", Description = "Playwright across Chromium, Firefox, WebKit", Enabled = true, Trigger = "pull_request", Timeout = "15", Status = "failing" },
        new() { Id = "build", Name = "Build", Description = "Next.js production build and bundle analysis", Enabled = true, Trigger = "push", Timeout = "10", Status = "passing" },
        new() { Id = "deploy-staging", Name = "Deploy Staging", Description = "Deploy to staging environment via Vercel", Enabled = true, Trigger = "push", Timeout = "5", Status = "passing" },
        new() { Id = "deploy-prod", Name = "Deploy Production", Description = "Deploy to production with approval gate", Enabled = true, Trigger = "tag", Timeout = "5", Status = "skipped" },
    };

    private readonly List<EnvOption> _envConfig = new()
    {
        new() { Id = "node", Label = "Node.js", Values = new() { "18.x", "20.x", "22.x" }, Selected = "20.x" },
        new() { Id = "os", Label = "OS", Values = new() { "ubuntu-latest", "macos-latest", "windows-latest" }, Selected = "ubuntu-latest" },
    };

    private int PassingCount => _stages.Count(s => s.Enabled && s.Status == "passing");
    private int FailingCount => _stages.Count(s => s.Enabled && s.Status == "failing");

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
