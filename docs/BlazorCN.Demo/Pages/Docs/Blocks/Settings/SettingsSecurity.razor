@* ===========================================================
   Block: settings-security
   Title: Settings Security
   Description: Animated React security settings page for Next.js with password change form, two-factor authentication toggle, active sessions list, and login history built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: BadgeCn, ButtonCn, InputCn, SwitchCn
   Source: original/blocks/settings/settings-security.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Security</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage your password, two-factor authentication, and active sessions
            </p>
        </div>

        @* Password section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Password</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Last changed 47 days ago</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="() => _showPassword = !_showPassword">
                    @(_showPassword ? "Cancel" : "Change password")
                </ButtonCn>
            </div>
            @if (_showPassword)
            {
                <div class="mt-4 space-y-3">
                    <div>
                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                            Current password
                        </span>
                        <InputCn aria-label="Current password" Type="password" Class="h-8 text-sm" />
                    </div>
                    <div>
                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                            New password
                        </span>
                        <InputCn aria-label="New password" Type="password" Class="h-8 text-sm" />
                    </div>
                    <div>
                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                            Confirm new password
                        </span>
                        <InputCn aria-label="Confirm new password" Type="password" Class="h-8 text-sm" />
                    </div>
                    <div class="flex justify-end">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                            Update password
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Two-factor auth *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div>
                    <p class="font-medium text-sm">Two-factor authentication</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Add an extra layer of security with TOTP authenticator
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="@Cn.Merge("flex items-center gap-1.5 text-xs", _twoFactor ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _twoFactor ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                    @(_twoFactor ? "Enabled" : "Disabled")
                </span>
                <SwitchCn aria-label="Two-factor authentication" @bind-Checked="_twoFactor" />
            </div>
        </div>

        @* Active sessions *@
        <div class="border-b">
            <div class="px-4 py-3">
                <p class="font-medium text-sm">Active sessions</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Devices currently signed in to your account
                </p>
            </div>
            @for (var i = 0; i < _sessions.Count; i++)
            {
                var session = _sessions[i];
                var isLast = i == _sessions.Count - 1;

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    @if (session.Icon == "mobile")
                    {
                        <LucideSmartphoneCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (session.Icon == "laptop")
                    {
                        <LucideLaptopCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideMonitorCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@session.Device</span>
                            @if (session.Current)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    This device
                                </BadgeCn>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @session.Browser &middot; @session.Location &middot; @session.LastActive
                        </p>
                    </div>
                    @if (!session.Current)
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-red-600 text-xs dark:text-red-400">
                            Revoke
                        </ButtonCn>
                    }
                </div>
            }
        </div>

        @* Login history toggle *@
        <div>
            <button type="button"
                    @onclick="() => _showHistory = !_showHistory"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <div>
                    <p class="font-medium text-sm">Login history</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Recent sign-in attempts on your account
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showHistory ? "rotate-90" : "")" />
            </button>
            @if (_showHistory)
            {
                @foreach (var entry in _loginHistory)
                {
                    <div class="flex items-center gap-3 border-t px-4 py-3">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", entry.Status == "success" ? "bg-emerald-500" : "bg-red-500")"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm">@entry.Device</p>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                @entry.Ip &middot; @entry.Location
                            </p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@entry.Time</span>
                    </div>
                }
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            @if (_saved)
            {
                <span class="mr-2 flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _twoFactor;
    private bool _showPassword;
    private bool _showHistory;
    private bool _saved;

    private record SessionInfo(string Id, string Device, string Icon, string Browser, string Location, string LastActive, bool Current);
    private record LoginEntry(string Id, string Ip, string Location, string Device, string Time, string Status);

    private static readonly List<SessionInfo> _sessions = new()
    {
        new("s1", "MacBook Pro", "laptop", "Chrome 122", "New York, US", "Now", true),
        new("s2", "iPhone 15 Pro", "mobile", "Safari 17", "New York, US", "2 hours ago", false),
        new("s3", "Windows Desktop", "desktop", "Firefox 123", "London, UK", "3 days ago", false),
    };

    private static readonly List<LoginEntry> _loginHistory = new()
    {
        new("l1", "192.168.1.42", "New York, US", "Chrome on macOS", "Today, 9:14 AM", "success"),
        new("l2", "10.0.0.88", "New York, US", "Safari on iOS", "Yesterday, 6:30 PM", "success"),
        new("l3", "203.0.113.55", "Unknown", "Chrome on Linux", "Mar 14, 11:02 PM", "failed"),
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
