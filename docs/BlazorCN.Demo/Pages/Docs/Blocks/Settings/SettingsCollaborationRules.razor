@* ===========================================================
   Block: settings-collaboration-rules
   Title: Settings Collaboration Rules
   Description: Animated React collaboration rules settings page for Next.js with commenting permissions, mention controls, guest access management, and sharing policies using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Email, push, and SMS notification preferences
   Dependencies: ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-collaboration-rules.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Collaboration rules</p>
            <p class="mt-0.5 text-muted-foreground text-xs">Control commenting, mentions, and guest access across your workspace</p>
        </div>

        @* Commenting *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideMessageSquareCn Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="font-medium text-sm">Commenting</p>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Who can comment</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Set the minimum role required to create comments</p>
                    </div>
                    <SelectCn @bind-Value="_commentPermission">
                        <SelectTriggerCn Class="h-8 w-36 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="all-members">All members</SelectItemCn>
                            <SelectItemCn Value="editors">Editors only</SelectItemCn>
                            <SelectItemCn Value="admins">Admins only</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Threaded replies</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Allow nested replies on comment threads</p>
                    </div>
                    <SwitchCn @bind-Checked="_threadedReplies" />
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Resolve comments</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Allow editors to mark comment threads as resolved</p>
                    </div>
                    <SwitchCn @bind-Checked="_resolveComments" />
                </div>
            </div>
        </div>

        @* Mentions *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideAtSignCn Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="font-medium text-sm">Mentions</p>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Cross-team mentions</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Allow mentioning members from other teams in comments</p>
                    </div>
                    <SwitchCn @bind-Checked="_mentionsCrossTeam" />
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Guest mentions</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Allow mentioning external guests in comment threads</p>
                    </div>
                    <SwitchCn @bind-Checked="_mentionsGuests" />
                </div>
            </div>
        </div>

        @* Guest access *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="font-medium text-sm">Guest access</p>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Allow external guests</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Invite people outside your organization</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="@Cn.Merge("flex items-center gap-1.5 text-xs", _guestAccess ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                            <span class="@Cn.Merge("size-1.5 rounded-full", _guestAccess ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                            @(_guestAccess ? "Enabled" : "Disabled")
                        </span>
                        <SwitchCn @bind-Checked="_guestAccess" />
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Guest link expiration</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Auto-expire guest access after this period</p>
                    </div>
                    <SelectCn @bind-Value="_guestExpiry">
                        <SelectTriggerCn Class="h-8 w-32 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="7-days">7 days</SelectItemCn>
                            <SelectItemCn Value="30-days">30 days</SelectItemCn>
                            <SelectItemCn Value="90-days">90 days</SelectItemCn>
                            <SelectItemCn Value="never">Never</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Current guests *@
        <div class="border-b">
            <button type="button" @onclick="() => _showGuests = !_showGuests"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <div>
                    <p class="font-medium text-sm">Current guests</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_guests.Count external users with access</p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showGuests ? "rotate-90" : "")" />
            </button>
            @if (_showGuests)
            {
                @foreach (var guest in _guests)
                {
                    <div class="flex items-center gap-3 border-t px-4 py-3">
                        <div class="min-w-0 flex-1">
                            <p class="font-medium text-sm">@guest.Name</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">@guest.Email &middot; Added @guest.AddedAt</p>
                        </div>
                        <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", AccessColor(guest.Access))">@guest.Access</span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-red-600 text-xs dark:text-red-400">
                            Remove
                        </ButtonCn>
                    </div>
                }
            }
        </div>

        @* Link sharing *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCn Size="14" Class="size-3.5 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Default sharing</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Who can access shared links by default</p>
                </div>
            </div>
            <SelectCn @bind-Value="_linkSharing">
                <SelectTriggerCn Class="h-8 w-40 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="anyone">Anyone with link</SelectItemCn>
                    <SelectItemCn Value="members-only">Members only</SelectItemCn>
                    <SelectItemCn Value="invited-only">Invited only</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            @if (_saved)
            {
                <span class="mr-2 flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _saved = true">
                Save rules
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _commentPermission = "all-members";
    private bool _threadedReplies = true;
    private bool _resolveComments = true;
    private bool _mentionsCrossTeam;
    private bool _mentionsGuests = true;
    private bool _guestAccess = true;
    private string _guestExpiry = "30-days";
    private string _linkSharing = "members-only";
    private bool _showGuests;
    private bool _saved;

    private record GuestUser(string Name, string Email, string Access, string AddedAt);

    private static readonly List<GuestUser> _guests =
    [
        new("Alex Thompson", "alex@@partner.co", "comment", "5 days ago"),
        new("Priya Sharma", "priya@@agency.io", "view", "2 weeks ago"),
        new("Marcus Lee", "marcus@@vendor.com", "edit", "1 month ago"),
    ];

    private static string AccessColor(string access) => access switch
    {
        "view" => "bg-muted text-muted-foreground",
        "comment" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "edit" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _ => "",
    };
}
