@* ===========================================================
   Block: settings-support-widget
   Title: Settings Support Widget
   Description: Widget position, brand color, greeting message, availability hours, toggle settings
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn, TextareaCn
   Source: original/blocks/settings/settings-support-widget.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Support widget</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Configure the embedded chat widget for your website
                </p>
            </div>
            <SwitchCn @bind-Checked="_enabled" />
        </div>

        @* Widget preview *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-full shadow-sm" style="background-color: @_brandColor">
                <LucideMessageCircleCn Size="20" Class="size-5 text-white" />
            </div>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Widget preview</p>
                <p class="mt-0.5 truncate text-muted-foreground text-xs">@_greeting</p>
            </div>
            <span class="shrink-0 rounded bg-muted/50 px-2 py-0.5 font-mono text-muted-foreground text-xs">@_position</span>
        </div>

        @* Brand color *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Brand color</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Hex color for the widget button and header</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="size-6 shrink-0 rounded border" style="background-color: @_brandColor"></span>
                <InputCn @bind-Value="_brandColor" Class="h-8 w-28 font-mono text-xs" Placeholder="#000000" />
            </div>
        </div>

        @* Position *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Position</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Where the widget appears on your site</p>
            </div>
            <SelectCn @bind-Value="_position">
                <SelectTriggerCn Class="h-8 w-40 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="bottom-right">Bottom Right</SelectItemCn>
                    <SelectItemCn Value="bottom-left">Bottom Left</SelectItemCn>
                    <SelectItemCn Value="top-right">Top Right</SelectItemCn>
                    <SelectItemCn Value="top-left">Top Left</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Greeting message *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Greeting message</span>
            <TextareaCn @bind-Value="_greeting" Class="min-h-16 text-sm" rows="2" />
        </div>

        @* Offline message *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Offline message</span>
            <TextareaCn @bind-Value="_offlineMessage" Class="min-h-16 text-sm" rows="2" />
        </div>

        @* Availability hours *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-muted-foreground text-xs uppercase tracking-wide">Availability hours</p>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1.5 block text-muted-foreground text-xs">Start</span>
                    <SelectCn @bind-Value="_availabilityStart">
                        <SelectTriggerCn Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="08:00">8:00 AM</SelectItemCn>
                            <SelectItemCn Value="09:00">9:00 AM</SelectItemCn>
                            <SelectItemCn Value="10:00">10:00 AM</SelectItemCn>
                            <SelectItemCn Value="11:00">11:00 AM</SelectItemCn>
                            <SelectItemCn Value="12:00">12:00 PM</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div>
                    <span class="mb-1.5 block text-muted-foreground text-xs">End</span>
                    <SelectCn @bind-Value="_availabilityEnd">
                        <SelectTriggerCn Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="17:00">5:00 PM</SelectItemCn>
                            <SelectItemCn Value="18:00">6:00 PM</SelectItemCn>
                            <SelectItemCn Value="19:00">7:00 PM</SelectItemCn>
                            <SelectItemCn Value="20:00">8:00 PM</SelectItemCn>
                            <SelectItemCn Value="21:00">9:00 PM</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Toggle settings *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Sound notifications</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Play a sound when a new message arrives</p>
            </div>
            <SwitchCn @bind-Checked="_soundEnabled" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Show agent photo</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Display agent avatar in the chat conversation</p>
            </div>
            <SwitchCn @bind-Checked="_showAgentPhoto" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Collect email before chat</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Require visitors to enter their email to start a conversation</p>
            </div>
            <SwitchCn @bind-Checked="_collectEmail" />
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _position = "bottom-right";
    private string _brandColor = "#2563eb";
    private string _greeting = "Hi there! How can we help you today?";
    private string _offlineMessage = "We are currently offline. Leave a message and we will get back to you.";
    private bool _enabled = true;
    private bool _soundEnabled = true;
    private bool _showAgentPhoto = true;
    private string _availabilityStart = "09:00";
    private string _availabilityEnd = "18:00";
    private bool _collectEmail = true;
    private bool _saved = false;
}
