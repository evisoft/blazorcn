@* ===========================================================
   Block: settings-changelog-widget
   Title: Settings Changelog Widget
   Description: In-app changelog with position, badge, auto-show, entry list
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-changelog-widget.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Changelog widget</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Configure how the in-app changelog appears to users</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="@Cn.Merge("flex items-center gap-1.5 text-xs", _widgetEnabled ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _widgetEnabled ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                    @(_widgetEnabled ? "Visible" : "Hidden")
                </span>
                <SwitchCn aria-label="Changelog widget" @bind-Checked="_widgetEnabled" />
            </div>
        </div>

        @* Widget position *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Position</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Where the widget appears on screen</p>
                </div>
                <SelectCn @bind-Value="_position">
                    <SelectTriggerCn aria-label="Widget position" Class="h-8 w-40 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="bottom-right">Bottom right</SelectItemCn>
                        <SelectItemCn Value="bottom-left">Bottom left</SelectItemCn>
                        <SelectItemCn Value="top-right">Top right</SelectItemCn>
                        <SelectItemCn Value="top-left">Top left</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Badge and auto-show *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideBellDotCn Size="14" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Unread badge</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">Show count badge for unseen entries</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        @if (_showBadge && _unseenCount > 0)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @_unseenCount new
                            </BadgeCn>
                        }
                        <SwitchCn aria-label="Unread badge" @bind-Checked="_showBadge" />
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideSparklesCn Size="14" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="font-medium text-sm">Auto-show for new items</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">Automatically open widget when new entries are published</p>
                        </div>
                    </div>
                    <SwitchCn aria-label="Auto-show for new items" @bind-Checked="_autoShow" />
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="pl-5.5 font-medium text-sm">Show only unseen entries</p>
                        <p class="mt-0.5 pl-5.5 text-muted-foreground text-xs">Hide entries the user has already dismissed</p>
                    </div>
                    <SwitchCn aria-label="Show only unseen entries" @bind-Checked="_showOnlyNew" />
                </div>
            </div>
        </div>

        @* Recent entries *@
        <div>
            <div class="px-4 py-3">
                <p class="font-medium text-sm">Recent entries</p>
                <p class="mt-0.5 text-muted-foreground text-xs">@_entries.Count entries · @_unseenCount unseen</p>
            </div>
            @for (var i = 0; i < _entries.Count; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Count - 1;
                var isExpanded = _expanded == entry.Id;
                var catColor = entry.Category == "feature" ? "bg-blue-500/10 text-blue-600" : entry.Category == "fix" ? "bg-emerald-500/10 text-emerald-600" : "bg-amber-500/10 text-amber-600";
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : entry.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (!entry.Seen)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                        }
                        else
                        {
                            <span class="size-1.5 shrink-0"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Title</span>
                                <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", catColor)">@entry.Category</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@entry.Date</p>
                        </div>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                <p class="text-muted-foreground text-sm leading-relaxed">@entry.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            @if (_saved)
            {
                <span class="mr-2 flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save settings
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record EntryItem(string Id, string Title, string Category, string Date, string Description, bool Seen);

    private static readonly List<EntryItem> _entries =
    [
        new("1", "Dark mode support", "feature", "Mar 18, 2026", "Full dark mode support with system preference detection and manual toggle.", false),
        new("2", "Fixed export bug", "fix", "Mar 15, 2026", "Resolved an issue where CSV exports would fail for datasets larger than 10MB.", false),
        new("3", "New keyboard shortcuts", "feature", "Mar 12, 2026", "Added keyboard shortcuts for common actions throughout the application.", true),
        new("4", "Performance improvements", "improvement", "Mar 10, 2026", "Improved page load times by 40% through optimized data fetching.", true),
    ];

    private int _unseenCount = 2;
    private bool _widgetEnabled = true;
    private string _position = "bottom-right";
    private bool _showBadge = true;
    private bool _autoShow = true;
    private bool _showOnlyNew = false;
    private string? _expanded = null;
    private bool _saved = false;
}
