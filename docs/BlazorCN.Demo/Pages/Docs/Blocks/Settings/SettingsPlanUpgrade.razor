@* ===========================================================
   Block: settings-plan-upgrade
   Title: Settings Plan Upgrade
   Description: React animated plan upgrade settings block for Next.js with current plan summary, side-by-side feature comparison, billing toggle, and upgrade CTA using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Multi-step account deletion flow
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-plan-upgrade.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideSparklesCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Plans & Billing</h2>
                        <p class="text-xs text-muted-foreground">
                            Compare plans and upgrade your workspace
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="@Cn.Merge("text-xs", !_yearly ? "font-medium" : "text-muted-foreground")">Monthly</span>
                    <SwitchCn aria-label="Billing period" @bind-Checked="_yearly" />
                    <span class="@Cn.Merge("text-xs", _yearly ? "font-medium" : "text-muted-foreground")">Yearly</span>
                    @if (_yearly)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] text-emerald-600 dark:text-emerald-400">
                            Save 50%
                        </BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Current plan *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                <div class="flex-1">
                    <p class="text-xs text-muted-foreground">Current plan</p>
                    <p class="text-sm font-medium">Free</p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Usage</p>
                    <p class="text-xs font-medium">2 of 3 projects &middot; 312 MB storage</p>
                </div>
            </div>
        </div>

        @* Plan cards *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-2">
                @foreach (var plan in _plans)
                {
                    var isCurrent = plan.Id == "free";
                    var price = _yearly ? plan.YearlyPrice : plan.MonthlyPrice;

                    <div class="@Cn.Merge("rounded-md border p-3", plan.Highlighted ? "border-primary bg-primary/5" : "", isCurrent ? "ring-1 ring-blue-500/30" : "")">
                        <div class="flex items-center gap-1.5">
                            @if (plan.Highlighted)
                            {
                                <LucideCrownCn Size="12" Class="size-3 text-primary" />
                            }
                            <span class="text-xs font-medium">@plan.Name</span>
                            @if (isCurrent)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1 text-[9px]">
                                    Current
                                </BadgeCn>
                            }
                        </div>
                        <div class="mt-1">
                            <span class="text-lg font-semibold tabular-nums">$@price</span>
                            <span class="text-xs text-muted-foreground">/mo</span>
                        </div>
                        <p class="mt-0.5 text-[10px] text-muted-foreground">@plan.Description</p>
                        @if (!isCurrent && price > 0)
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="@(plan.Highlighted ? ButtonVariant.Default : ButtonVariant.Outline)" Class="mt-2 h-6 w-full text-[10px]">
                                <LucideZapCn Size="10" Class="mr-1 size-2.5" />
                                Upgrade
                            </ButtonCn>
                        }
                        @if (isCurrent)
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="mt-2 h-6 w-full text-[10px]" Disabled="true">
                                Current plan
                            </ButtonCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Feature comparison *@
        <div class="px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">FEATURE COMPARISON</p>
            <div class="overflow-hidden rounded-md border">
                @* Table header *@
                <div class="grid grid-cols-5 border-b bg-muted/30 px-3 py-2">
                    <span class="text-xs font-medium text-muted-foreground">Feature</span>
                    @foreach (var plan in _plans)
                    {
                        <span class="text-center text-xs font-medium text-muted-foreground">@plan.Name</span>
                    }
                </div>

                @* Table rows *@
                @for (var i = 0; i < _features.Count; i++)
                {
                    var feature = _features[i];
                    var isLast = i == _features.Count - 1;

                    <div class="@Cn.Merge("grid grid-cols-5 items-center px-3 py-2 transition-colors hover:bg-muted/30", isLast ? "" : "border-b")">
                        <span class="text-xs">@feature.Name</span>
                        <span class="flex justify-center">@RenderValue(feature.Free)</span>
                        <span class="flex justify-center">@RenderValue(feature.Pro)</span>
                        <span class="flex justify-center">@RenderValue(feature.Team)</span>
                        <span class="flex justify-center">@RenderValue(feature.Enterprise)</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private bool _yearly;

    private record PlanTier(string Id, string Name, int MonthlyPrice, int YearlyPrice, string Description, bool Highlighted);

    private record FeatureRow(string Id, string Name, string Free, string Pro, string Team, string Enterprise);

    private static readonly List<PlanTier> _plans = new()
    {
        new("free", "Free", 0, 0, "For personal projects", false),
        new("pro", "Pro", 39, 19, "For professionals", true),
        new("team", "Team", 79, 39, "For growing teams", false),
        new("enterprise", "Enterprise", 159, 79, "For organizations", false),
    };

    private static readonly List<FeatureRow> _features = new()
    {
        new("f-1", "Projects", "3", "Unlimited", "Unlimited", "Unlimited"),
        new("f-2", "Team members", "1", "1", "5", "Unlimited"),
        new("f-3", "Storage", "500 MB", "10 GB", "50 GB", "500 GB"),
        new("f-4", "API requests / month", "1,000", "50,000", "200,000", "Unlimited"),
        new("f-5", "Custom domains", "false", "true", "true", "true"),
        new("f-6", "Analytics", "false", "true", "true", "true"),
        new("f-7", "Priority support", "false", "false", "true", "true"),
        new("f-8", "SSO / SAML", "false", "false", "false", "true"),
        new("f-9", "Audit trail", "false", "false", "true", "true"),
        new("f-10", "SLA guarantee", "false", "false", "false", "true"),
    };

    private RenderFragment RenderValue(string value) => value switch
    {
        "true" => @<LucideCheckCn Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />,
        "false" => @<LucideMinusCn Size="14" Class="size-3.5 text-muted-foreground/40" />,
        _ => @<span class="font-mono text-xs">@value</span>,
    };
}
