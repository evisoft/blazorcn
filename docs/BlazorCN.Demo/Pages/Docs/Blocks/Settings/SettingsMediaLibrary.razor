@* ===========================================================
   Block: settings-media-library
   Title: Settings Media Library
   Description: Storage provider selection, upload limits, image processing, CDN config
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-media-library.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Media Library</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure storage, upload limits, and image processing
            </p>
        </div>

        @* Storage provider *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Storage provider
            </span>
            <div class="space-y-2">
                @foreach (var provider in _providers)
                {
                    <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md p-3 transition-colors hover:bg-muted/50", _activeProvider == provider.Id ? "bg-muted/50" : "")">
                        <input type="radio"
                               name="provider"
                               value="@provider.Id"
                               checked="@(_activeProvider == provider.Id)"
                               @onchange="() => _activeProvider = provider.Id"
                               class="sr-only" />
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", _activeProvider == provider.Id ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground")">
                            @if (provider.Id == "r2")
                            {
                                <LucideHardDriveCn Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucideCloudCn Size="16" Class="size-4" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@provider.Name</span>
                            <p class="text-muted-foreground text-xs">
                                @provider.Region &middot; @provider.Usage used
                            </p>
                        </div>
                        @if (_activeProvider == provider.Id)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                Active
                            </BadgeCn>
                        }
                    </label>
                }
            </div>
        </div>

        @* Upload limits *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Upload limits
            </span>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Max file size</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Maximum size per uploaded file
                        </p>
                    </div>
                    <SelectCn @bind-Value="_maxFileSize">
                        <SelectTriggerCn Class="h-8 w-28 text-xs">
                            <SelectValueCn Placeholder="Select" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="@("5")">5 MB</SelectItemCn>
                            <SelectItemCn Value="@("10")">10 MB</SelectItemCn>
                            <SelectItemCn Value="@("25")">25 MB</SelectItemCn>
                            <SelectItemCn Value="@("50")">50 MB</SelectItemCn>
                            <SelectItemCn Value="@("100")">100 MB</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Allowed file types</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Accepted formats for uploads</p>
                    </div>
                    <div class="flex items-center gap-1">
                        @foreach (var type in new[] { "JPEG", "PNG", "WebP", "SVG", "GIF" })
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs font-normal">
                                @type
                            </BadgeCn>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Image processing *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Image processing
            </span>
            <div class="space-y-1">
                @foreach (var opt in _processingOptions)
                {
                    <div class="flex items-center justify-between rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50">
                        <div>
                            <p class="font-medium text-sm">@opt.Label</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">@opt.Description</p>
                        </div>
                        <SwitchCn Checked="_processingState[opt.Key]" CheckedChanged="v => { _processingState[opt.Key] = v; }" />
                    </div>
                }
            </div>
        </div>

        @* CDN *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">CDN domain</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Custom domain for serving media assets
                    </p>
                </div>
            </div>
            <div class="mt-3 flex items-center gap-2">
                <span class="text-muted-foreground text-xs">https://</span>
                <InputCn @bind-Value="_cdnDomain" Class="h-8 flex-1 text-sm" Placeholder="cdn.example.com" />
            </div>
        </div>

        @* Storage usage *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideImageCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <p class="font-medium text-sm">Storage usage</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            12.4 GB of 50 GB used &middot; 2,847 files
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-1.5">
                    <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground" style="width: 24.8%"></div>
                    </div>
                    <span class="text-muted-foreground text-xs">25%</span>
                </div>
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StorageProvider(string Id, string Name, string Region, string Usage);
    private record ProcessingOption(string Key, string Label, string Description);

    private static readonly List<StorageProvider> _providers = new()
    {
        new("s3", "Amazon S3", "us-east-1", "12.4 GB"),
        new("r2", "Cloudflare R2", "auto", "0 GB"),
        new("gcs", "Google Cloud Storage", "us-central1", "0 GB"),
    };

    private static readonly List<ProcessingOption> _processingOptions = new()
    {
        new("autoResize", "Auto-resize uploads", "Resize images exceeding 4096px to max dimensions"),
        new("generateThumbnails", "Generate thumbnails", "Create 150px, 300px, and 600px thumbnail variants"),
        new("stripMetadata", "Strip EXIF metadata", "Remove camera and location data from uploads"),
        new("convertToWebp", "Convert to WebP", "Auto-convert JPEG and PNG uploads to WebP format"),
        new("lazyLoading", "Lazy loading placeholders", "Generate blurred placeholder images for lazy loading"),
    };

    private string _activeProvider = "s3";
    private string _maxFileSize = "10";
    private string _cdnDomain = "cdn.acme.com";
    private readonly Dictionary<string, bool> _processingState = new()
    {
        ["autoResize"] = true,
        ["generateThumbnails"] = true,
        ["stripMetadata"] = false,
        ["convertToWebp"] = true,
        ["lazyLoading"] = true,
    };
    private bool _saved;

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
