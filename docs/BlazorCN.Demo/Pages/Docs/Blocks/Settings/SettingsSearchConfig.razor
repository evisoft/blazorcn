@* ===========================================================
   Block: settings-search-config
   Title: Settings Search Config
   Description: Animated React search configuration page for Next.js with indexing rules, synonym management, boosting weights, and result tuning built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, avatar, and timezone
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-search-config.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideSearchCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">Search Configuration</p>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure indexing, synonyms, and relevance tuning
            </p>
        </div>

        @* Indexing rules *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Indexing rules</span>
            </div>
            @for (var i = 0; i < _indexingRules.Count; i++)
            {
                var rule = _indexingRules[i];
                var isLast = i == _indexingRules.Count - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", !isLast ? "border-b" : "")">
                    <div>
                        <p class="font-medium text-sm">@rule.Label</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">@rule.Description</p>
                    </div>
                    <SwitchCn @bind-Checked="rule.Enabled" />
                </div>
            }
        </div>

        @* Synonyms *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Synonyms</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
            <div class="space-y-2.5">
                @foreach (var pair in _synonyms)
                {
                    var pairId = pair.Id;
                    <div class="flex items-start gap-3 rounded-md bg-muted/30 px-3 py-2.5">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@pair.Term</span>
                            <div class="mt-1.5 flex flex-wrap gap-1.5">
                                @foreach (var syn in pair.Synonyms.ToList())
                                {
                                    var synCopy = syn;
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                                        @synCopy
                                        <button type="button" @onclick="() => RemoveSynonym(pairId, synCopy)"
                                                class="opacity-60 transition-opacity hover:opacity-100">
                                            <LucideXCn Size="10" Class="size-2.5" />
                                            <span class="sr-only">Remove</span>
                                        </button>
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-6 w-6 shrink-0 p-0 text-muted-foreground hover:text-red-600"
                                  OnClick="() => RemoveSynonymPair(pairId)">
                            <LucideTrashCn Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Boosting weights *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Field boosting weights
            </span>
            <div class="space-y-3">
                @foreach (var field in _boostFields)
                {
                    var fieldId = field.Id;
                    <div class="flex items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium font-mono text-sm">@field.Field</span>
                                <span class="text-muted-foreground text-xs">@field.Description</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="range" min="1" max="10" value="@field.Weight"
                                   @onchange="e => UpdateWeight(fieldId, int.TryParse(e.Value?.ToString(), out var w) ? w : 1)"
                                   class="h-1 w-20 cursor-pointer accent-foreground" />
                            <span class="w-5 text-right font-mono text-muted-foreground text-xs tabular-nums">
                                @field.Weight
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Result settings *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-3">
                <div>
                    <p class="font-medium text-sm">Results per page</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Number of results shown per query
                    </p>
                </div>
                <SelectCn @bind-Value="_resultsPerPage">
                    <SelectTriggerCn Class="h-8 w-20 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="@("10")">10</SelectItemCn>
                        <SelectItemCn Value="@("20")">20</SelectItemCn>
                        <SelectItemCn Value="@("50")">50</SelectItemCn>
                        <SelectItemCn Value="@("100")">100</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div class="flex items-center justify-between border-t px-4 py-3">
                <div>
                    <p class="font-medium text-sm">Typo tolerance</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Match results with minor spelling mistakes
                    </p>
                </div>
                <SwitchCn @bind-Checked="_typoTolerance" />
            </div>
            <div class="flex items-center justify-between border-t px-4 py-3">
                <div>
                    <p class="font-medium text-sm">Highlight matches</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Bold matching terms in search results
                    </p>
                </div>
                <SwitchCn @bind-Checked="_highlightMatches" />
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _resultsPerPage = "20";
    private bool _typoTolerance = true;
    private bool _highlightMatches = true;
    private bool _saved;

    private class IndexingRule
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class SynonymPair
    {
        public string Id { get; set; } = "";
        public string Term { get; set; } = "";
        public List<string> Synonyms { get; set; } = new();
    }

    private class BoostField
    {
        public string Id { get; set; } = "";
        public string Field { get; set; } = "";
        public int Weight { get; set; }
        public string Description { get; set; } = "";
    }

    private readonly List<IndexingRule> _indexingRules = new()
    {
        new() { Id = "ir1", Label = "Index published content", Description = "Include only published pages and posts", Enabled = true },
        new() { Id = "ir2", Label = "Index product descriptions", Description = "Include product catalog in search results", Enabled = true },
        new() { Id = "ir3", Label = "Index help articles", Description = "Include knowledge base and documentation", Enabled = true },
        new() { Id = "ir4", Label = "Index user profiles", Description = "Allow searching for team members by name", Enabled = false },
        new() { Id = "ir5", Label = "Index archived content", Description = "Include archived pages in search results", Enabled = false },
    };

    private readonly List<SynonymPair> _synonyms = new()
    {
        new() { Id = "s1", Term = "laptop", Synonyms = new() { "notebook", "computer", "macbook" } },
        new() { Id = "s2", Term = "price", Synonyms = new() { "cost", "pricing", "rate" } },
        new() { Id = "s3", Term = "dashboard", Synonyms = new() { "overview", "home", "summary" } },
        new() { Id = "s4", Term = "settings", Synonyms = new() { "preferences", "config", "options" } },
    };

    private readonly List<BoostField> _boostFields = new()
    {
        new() { Id = "b1", Field = "title", Weight = 10, Description = "Page and product titles" },
        new() { Id = "b2", Field = "heading", Weight = 7, Description = "H2 and H3 headings" },
        new() { Id = "b3", Field = "description", Weight = 5, Description = "Meta descriptions and summaries" },
        new() { Id = "b4", Field = "body", Weight = 3, Description = "Main content body text" },
        new() { Id = "b5", Field = "tags", Weight = 4, Description = "Categories and tags" },
    };

    private void RemoveSynonym(string pairId, string synonym)
    {
        var pair = _synonyms.FirstOrDefault(s => s.Id == pairId);
        pair?.Synonyms.Remove(synonym);
    }

    private void RemoveSynonymPair(string id)
    {
        _synonyms.RemoveAll(s => s.Id == id);
    }

    private void UpdateWeight(string id, int weight)
    {
        var field = _boostFields.FirstOrDefault(f => f.Id == id);
        if (field != null) field.Weight = weight;
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
