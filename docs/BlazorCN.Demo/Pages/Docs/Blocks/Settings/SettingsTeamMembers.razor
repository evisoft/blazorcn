@* ===========================================================
   Block: settings-team-members
   Title: Settings Team Members
   Description: Team member management settings page with invite form, role selector, member status indicators, and remove actions
   Dependencies: AvatarCn, BadgeCn, ButtonCn, InputCn, SelectCn
   Source: original/blocks/settings/settings-team-members.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Team members</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Invite colleagues and manage roles for your workspace
            </p>
        </div>

        @* Invite form *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideMailCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn @bind-Value="_inviteEmail" Placeholder="colleague@company.com" Type="email"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <SelectCn @bind-Value="_inviteRole">
                <SelectTriggerCn Class="h-7 w-24 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("admin")">Admin</SelectItemCn>
                    <SelectItemCn Value="@("editor")">Editor</SelectItemCn>
                    <SelectItemCn Value="@("viewer")">Viewer</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 shrink-0 text-xs"
                      OnClick="SendInvite">
                <LucideSendCn Size="12" Class="size-3" />
                Invite
            </ButtonCn>
        </div>

        @* Member count *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <LucideUsersCn Size="12" Class="size-3 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                <span class="tabular-nums">@_members.Count(m => m.Status == "active")</span> active
            </span>
            @{ var pendingCount = _members.Count(m => m.Status == "pending"); }
            @if (pendingCount > 0)
            {
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">
                    <span class="tabular-nums">@pendingCount</span> pending
                </span>
            }
        </div>

        @* Members list *@
        <div>
            @for (var i = 0; i < _members.Count; i++)
            {
                var member = _members[i];
                var isLast = i == _members.Count - 1;
                var isOwner = member.Id == "m1";

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="relative">
                        <AvatarCn Class="size-8">
                            <AvatarFallbackCn Class="text-xs">@member.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        @if (member.Status == "active" && member.LastActive == "Now")
                        {
                            <span class="-right-0.5 -bottom-0.5 absolute size-2 rounded-full border border-card bg-emerald-500"></span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@member.Name</span>
                            @if (member.Status == "pending")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    Pending
                                </BadgeCn>
                            }
                            @if (isOwner)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    You
                                </BadgeCn>
                            }
                        </div>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">
                            @member.Email &middot; @member.LastActive
                        </p>
                    </div>
                    <SelectCn @bind-Value="member.Role" Disabled="@isOwner">
                        <SelectTriggerCn Class="h-7 w-24 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="@("admin")">Admin</SelectItemCn>
                            <SelectItemCn Value="@("editor")">Editor</SelectItemCn>
                            <SelectItemCn Value="@("viewer")">Viewer</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    @if (!isOwner)
                    {
                        var memberId = member.Id;
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-6 px-2 text-muted-foreground hover:text-red-600 dark:hover:text-red-400"
                                  OnClick="() => RemoveMember(memberId)">
                            <LucideUserMinusCn Size="12" Class="size-3" />
                        </ButtonCn>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                <span class="tabular-nums">@_members.Count</span> of 5 seats used on your plan
            </span>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideMoreHorizontalCn Size="12" Class="size-3" />
                Manage plan
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _inviteEmail = "";
    private string _inviteRole = "viewer";

    private class TeamMember
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Initials { get; set; } = "";
        public string Role { get; set; } = "";
        public string Status { get; set; } = "";
        public string LastActive { get; set; } = "";
    }

    private readonly List<TeamMember> _members = new()
    {
        new() { Id = "m1", Name = "Alex Chen", Email = "alex.chen@acme.com", Initials = "AC", Role = "admin", Status = "active", LastActive = "Now" },
        new() { Id = "m2", Name = "Sarah Kim", Email = "sarah.kim@acme.com", Initials = "SK", Role = "editor", Status = "active", LastActive = "5 min ago" },
        new() { Id = "m3", Name = "James Rivera", Email = "james.r@acme.com", Initials = "JR", Role = "editor", Status = "active", LastActive = "2 hours ago" },
        new() { Id = "m4", Name = "Priya Patel", Email = "priya.patel@acme.com", Initials = "PP", Role = "viewer", Status = "pending", LastActive = "Invited Mar 12" },
        new() { Id = "m5", Name = "Marcus Johnson", Email = "marcus.j@acme.com", Initials = "MJ", Role = "viewer", Status = "pending", LastActive = "Invited Mar 15" },
    };

    private void SendInvite()
    {
        if (string.IsNullOrWhiteSpace(_inviteEmail)) return;
        var parts = _inviteEmail.Split("@");
        var initials = parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        _members.Add(new TeamMember
        {
            Id = $"m{_members.Count + 1}",
            Name = parts[0],
            Email = _inviteEmail,
            Initials = initials,
            Role = _inviteRole,
            Status = "pending",
            LastActive = "Just invited",
        });
        _inviteEmail = "";
    }

    private void RemoveMember(string id)
    {
        _members.RemoveAll(m => m.Id == id);
    }
}
