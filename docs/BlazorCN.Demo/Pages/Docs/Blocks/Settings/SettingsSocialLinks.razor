@* ===========================================================
   Block: settings-social-links
   Title: Settings Social Links
   Description: Animated React social media links management page for Next.js with platform URL fields, display order controls, visibility toggles, and preview rendering built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, avatar, and timezone
   Dependencies: ButtonCn, InputCn, SwitchCn
   Source: original/blocks/settings/settings-social-links.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Social Links</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Manage your social media profiles and display order
                </p>
            </div>
            <span class="text-muted-foreground text-xs">@_platforms.Count(p => !string.IsNullOrEmpty(p.Url)) configured</span>
        </div>

        @* Platform list *@
        <div>
            @for (var i = 0; i < _platforms.Count; i++)
            {
                var platform = _platforms[i];
                var index = i;
                var isLast = index == _platforms.Count - 1;

                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    <div class="flex items-center gap-2">
                        <LucideGripVerticalCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", platform.Color)"></span>
                        <span class="@Cn.Merge("min-w-0 flex-1 font-medium text-sm", !platform.Visible ? "text-muted-foreground" : "")">
                            @platform.Name
                        </span>
                        <div class="flex items-center gap-1">
                            <ButtonCn aria-label="@($"Move {platform.Name} up")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0"
                                      OnClick="() => MoveItem(platform.Id, -1)" Disabled="@(index == 0)">
                                <LucideArrowUpCn Size="12" Class="size-3" />
                            </ButtonCn>
                            <ButtonCn aria-label="@($"Move {platform.Name} down")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0"
                                      OnClick="() => MoveItem(platform.Id, 1)" Disabled="@(index == _platforms.Count - 1)">
                                <LucideArrowDownCn Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                        <SwitchCn aria-label="@platform.Name" @bind-Checked="platform.Visible" />
                    </div>
                    <div class="mt-2 pl-7">
                        <InputCn aria-label="@($"{platform.Name} URL")" @bind-Value="platform.Url" Class="h-8 font-mono text-xs"
                                 Placeholder="@platform.PlaceholderText" />
                    </div>
                </div>
            }
        </div>

        @* Preview *@
        <div class="border-t px-4 py-4">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Preview</span>
            @{ var visiblePlatforms = _platforms.Where(p => p.Visible && !string.IsNullOrEmpty(p.Url)).ToList(); }
            @if (visiblePlatforms.Count > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var platform in visiblePlatforms)
                    {
                        <div class="flex items-center gap-2 rounded-md border bg-muted/30 px-3 py-1.5 transition-colors hover:bg-muted/50">
                            <span class="@Cn.Merge("size-1.5 rounded-full", platform.Color)"></span>
                            <span class="text-xs">@platform.Name</span>
                            <LucideExternalLinkCn Size="12" Class="size-3 text-muted-foreground" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex items-center justify-center rounded-md bg-muted/30 py-6">
                    <div class="text-center">
                        <LucideGlobeCn Size="16" Class="mx-auto mb-1.5 size-4 text-muted-foreground" />
                        <p class="text-muted-foreground text-xs">No visible links configured</p>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add platform
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_saved)
                {
                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideCheckCn Size="12" Class="size-3" />
                        Saved
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _saved;

    private class SocialPlatform
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Url { get; set; } = "";
        public string PlaceholderText { get; set; } = "";
        public bool Visible { get; set; }
        public string Color { get; set; } = "";
    }

    private readonly List<SocialPlatform> _platforms = new()
    {
        new() { Id = "twitter", Name = "X (Twitter)", Url = "https://x.com/acmeinc", PlaceholderText = "https://x.com/username", Visible = true, Color = "bg-zinc-900 dark:bg-zinc-100" },
        new() { Id = "github", Name = "GitHub", Url = "https://github.com/acme", PlaceholderText = "https://github.com/username", Visible = true, Color = "bg-zinc-800 dark:bg-zinc-200" },
        new() { Id = "linkedin", Name = "LinkedIn", Url = "https://linkedin.com/company/acme", PlaceholderText = "https://linkedin.com/in/username", Visible = true, Color = "bg-blue-600" },
        new() { Id = "youtube", Name = "YouTube", Url = "https://youtube.com/@acme", PlaceholderText = "https://youtube.com/@channel", Visible = true, Color = "bg-red-600" },
        new() { Id = "instagram", Name = "Instagram", Url = "", PlaceholderText = "https://instagram.com/username", Visible = false, Color = "bg-pink-600" },
        new() { Id = "discord", Name = "Discord", Url = "https://discord.gg/acme", PlaceholderText = "https://discord.gg/invite-code", Visible = true, Color = "bg-indigo-600" },
        new() { Id = "website", Name = "Website", Url = "https://acme.com", PlaceholderText = "https://your-website.com", Visible = true, Color = "bg-emerald-600" },
    };

    private void MoveItem(string id, int direction)
    {
        var idx = _platforms.FindIndex(p => p.Id == id);
        var swapIdx = idx + direction;
        if (swapIdx < 0 || swapIdx >= _platforms.Count) return;
        (_platforms[idx], _platforms[swapIdx]) = (_platforms[swapIdx], _platforms[idx]);
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
