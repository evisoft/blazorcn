@* ===========================================================
   Block: settings-cookie-consent
   Title: Settings Cookie Consent
   Description: Animated React cookie consent banner configuration page for Next.js with category toggles, consent log history, and compliance status built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: User profile and personal information management
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-cookie-consent.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Cookie Consent</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Configure cookie categories and consent banner behavior</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideShieldCheckCn Size="12" Class="size-3" />
                GDPR Compliant
            </BadgeCn>
        </div>

        @* Status *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideCookieCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                @_categories.Count(c => c.Enabled) of @_categories.Count categories enabled
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">Last updated 2 hours ago</span>
        </div>

        @* Categories *@
        @foreach (var category in _categories)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="min-w-0 flex-1 pr-4">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@category.Name</span>
                            @if (category.Required)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Required</BadgeCn>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@category.Description</p>
                    </div>
                    <SwitchCn Checked="category.Enabled" CheckedChanged="() => ToggleCategory(category.Id)" Disabled="category.Required" />
                </div>
            </div>
        }

        @* Consent Log *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 font-medium text-muted-foreground text-xs">Consent log</p>
            <div class="space-y-2">
                @foreach (var entry in _consentLog)
                {
                    <div class="flex items-start justify-between rounded-md bg-muted/50 px-3 py-2">
                        <div>
                            <p class="font-medium text-xs">@entry.Action</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">@string.Join(", ", entry.Categories)</p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@entry.Timestamp</span>
                    </div>
                }
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _saved = true">
                Save preferences
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _saved;

    private class CookieCategory
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Required { get; set; }
        public bool Enabled { get; set; }
    }

    private record ConsentLogEntry(string Action, string Timestamp, string[] Categories);

    private readonly List<CookieCategory> _categories =
    [
        new() { Id = "necessary", Name = "Strictly Necessary", Description = "Essential cookies for site functionality. Cannot be disabled.", Required = true, Enabled = true },
        new() { Id = "analytics", Name = "Analytics", Description = "Help us understand how visitors interact with the site by collecting anonymous usage data.", Required = false, Enabled = true },
        new() { Id = "marketing", Name = "Marketing", Description = "Used to deliver personalized advertisements and measure campaign effectiveness.", Required = false, Enabled = false },
        new() { Id = "preferences", Name = "Preferences", Description = "Remember your settings like language, region, and display preferences across sessions.", Required = false, Enabled = true },
        new() { Id = "social", Name = "Social Media", Description = "Enable sharing features and embedded social content from third-party platforms.", Required = false, Enabled = false },
    ];

    private static readonly ConsentLogEntry[] _consentLog =
    [
        new("Consent updated", "2 hours ago", ["Analytics", "Preferences"]),
        new("Consent granted", "3 days ago", ["Analytics", "Preferences", "Marketing"]),
        new("Consent revoked", "1 week ago", ["Marketing"]),
        new("Initial consent", "2 weeks ago", ["Strictly Necessary"]),
    ];

    private void ToggleCategory(string id)
    {
        var cat = _categories.Find(c => c.Id == id);
        if (cat is { Required: false })
            cat.Enabled = !cat.Enabled;
    }
}
