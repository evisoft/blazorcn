@* ===========================================================
   Block: settings-sidebar-layout
   Title: Settings Sidebar Layout
   Description: Animated React sidebar layout customization page for Next.js with menu item reordering, icon selection, collapse state toggle, and visibility controls built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Theme, font size, and density controls
   Dependencies: ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-sidebar-layout.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Sidebar Layout</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Customize navigation menu items and sidebar behavior
                </p>
            </div>
            <span class="text-muted-foreground text-xs">
                @(_menuItems.Count(m => m.Visible)) of @_menuItems.Count visible
            </span>
        </div>

        @* Collapse behavior *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Collapse mode</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    How the sidebar behaves when collapsed
                </p>
            </div>
            <SelectCn @bind-Value="_collapseMode">
                <SelectTriggerCn Class="h-8 w-36 text-xs">
                    <SelectValueCn Placeholder="Select" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("icons")">Icons only</SelectItemCn>
                    <SelectItemCn Value="@("hidden")">Fully hidden</SelectItemCn>
                    <SelectItemCn Value="@("overlay")">Overlay</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Toggle settings *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Start collapsed</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Sidebar is collapsed by default on page load
                </p>
            </div>
            <SwitchCn @bind-Checked="_defaultCollapsed" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Show item labels</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Display text labels alongside navigation icons
                </p>
            </div>
            <SwitchCn @bind-Checked="_showLabels" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Sticky header</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Keep sidebar header fixed while scrolling
                </p>
            </div>
            <SwitchCn @bind-Checked="_stickyHeader" />
        </div>

        @* Menu items *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Menu items</span>
            </div>
            @for (var i = 0; i < _menuItems.Count; i++)
            {
                var menuItem = _menuItems[i];
                var index = i;

                <div class="@Cn.Merge("flex items-center gap-2 px-4 py-2.5 transition-colors hover:bg-muted/50", index < _menuItems.Count - 1 ? "border-b" : "")">
                    <LucideGripVerticalCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                    @if (menuItem.Icon == "home")
                    {
                        <LucideHomeCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (menuItem.Icon == "dashboard")
                    {
                        <LucideLayoutDashboardCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (menuItem.Icon == "inbox")
                    {
                        <LucideInboxCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (menuItem.Icon == "users")
                    {
                        <LucideUsersCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (menuItem.Icon == "analytics")
                    {
                        <LucideBarChart3Cn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (menuItem.Icon == "documents")
                    {
                        <LucideFileTextCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideSettingsCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("font-medium text-sm", !menuItem.Visible ? "text-muted-foreground" : "")">
                            @menuItem.Label
                        </span>
                        @if (!string.IsNullOrEmpty(menuItem.Badge))
                        {
                            <span class="ml-2 rounded-full bg-muted px-1.5 py-0.5 font-mono text-muted-foreground text-xs tabular-nums">
                                @menuItem.Badge
                            </span>
                        }
                    </div>
                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="() => MoveItem(menuItem.Id, -1)" Disabled="@(index == 0)">
                            <LucideArrowUpCn Size="12" Class="size-3" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="() => MoveItem(menuItem.Id, 1)" Disabled="@(index == _menuItems.Count - 1)">
                            <LucideArrowDownCn Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                    <SwitchCn @bind-Checked="menuItem.Visible" />
                </div>
            }
        </div>

        @* Preview *@
        <div class="border-b px-4 py-4">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Preview</span>
            <div class="rounded-md border bg-muted/20 p-3">
                <div class="flex flex-col gap-1">
                    @{ var isFirst = true; }
                    @foreach (var menuItem in _menuItems.Where(m => m.Visible))
                    {
                        <div class="@Cn.Merge("flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-muted-foreground transition-colors", isFirst ? "bg-muted/50 text-foreground" : "")">
                            @if (menuItem.Icon == "home")
                            {
                                <LucideHomeCn Size="14" Class="size-3.5 shrink-0" />
                            }
                            else if (menuItem.Icon == "dashboard")
                            {
                                <LucideLayoutDashboardCn Size="14" Class="size-3.5 shrink-0" />
                            }
                            else if (menuItem.Icon == "inbox")
                            {
                                <LucideInboxCn Size="14" Class="size-3.5 shrink-0" />
                            }
                            else if (menuItem.Icon == "users")
                            {
                                <LucideUsersCn Size="14" Class="size-3.5 shrink-0" />
                            }
                            else if (menuItem.Icon == "analytics")
                            {
                                <LucideBarChart3Cn Size="14" Class="size-3.5 shrink-0" />
                            }
                            else if (menuItem.Icon == "documents")
                            {
                                <LucideFileTextCn Size="14" Class="size-3.5 shrink-0" />
                            }
                            else
                            {
                                <LucideSettingsCn Size="14" Class="size-3.5 shrink-0" />
                            }
                            @if (_showLabels)
                            {
                                <span class="text-xs">@menuItem.Label</span>
                            }
                            @if (!string.IsNullOrEmpty(menuItem.Badge) && _showLabels)
                            {
                                <span class="ml-auto font-mono text-muted-foreground text-xs tabular-nums">
                                    @menuItem.Badge
                                </span>
                            }
                        </div>
                        isFirst = false;
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _collapseMode = "icons";
    private bool _defaultCollapsed;
    private bool _showLabels = true;
    private bool _stickyHeader = true;
    private bool _saved;

    private class MenuItem
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool Visible { get; set; }
        public string Badge { get; set; } = "";
    }

    private readonly List<MenuItem> _menuItems = new()
    {
        new() { Id = "m1", Label = "Home", Icon = "home", Visible = true },
        new() { Id = "m2", Label = "Dashboard", Icon = "dashboard", Visible = true },
        new() { Id = "m3", Label = "Inbox", Icon = "inbox", Visible = true, Badge = "12" },
        new() { Id = "m4", Label = "Team", Icon = "users", Visible = true },
        new() { Id = "m5", Label = "Analytics", Icon = "analytics", Visible = true },
        new() { Id = "m6", Label = "Documents", Icon = "documents", Visible = false },
        new() { Id = "m7", Label = "Settings", Icon = "settings", Visible = true },
    };

    private void MoveItem(string id, int direction)
    {
        var idx = _menuItems.FindIndex(m => m.Id == id);
        var swapIdx = idx + direction;
        if (swapIdx < 0 || swapIdx >= _menuItems.Count) return;
        (_menuItems[idx], _menuItems[swapIdx]) = (_menuItems[swapIdx], _menuItems[idx]);
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
