@* ===========================================================
   Block: settings-deployment-config
   Title: Settings Deployment Config
   Description: Build command, env, region, node version, auto-deploy
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-deployment-config.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Deployment Configuration</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Build settings, environment, and deployment region</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideRocketCn Size="12" Class="size-3" />
                @_environment
            </BadgeCn>
        </div>

        @* Branch *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGitBranchCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Production branch</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Branch deployed to production</p>
                </div>
            </div>
            <InputCn @bind-Value="_branch" Class="h-8 w-32 font-mono text-xs" />
        </div>

        @* Build command *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Build command</span>
            <InputCn @bind-Value="_buildCommand" Class="h-8 font-mono text-sm" />
        </div>

        @* Install command *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Install command</span>
            <InputCn @bind-Value="_installCommand" Class="h-8 font-mono text-sm" />
        </div>

        @* Output + root directories *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-3">
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Output directory</span>
                <InputCn @bind-Value="_outputDirectory" Class="h-8 font-mono text-sm" />
            </div>
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Root directory</span>
                <InputCn @bind-Value="_rootDirectory" Class="h-8 font-mono text-sm" />
            </div>
        </div>

        @* Node version + Region *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-3">
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Node.js version</span>
                <SelectCn @bind-Value="_nodeVersion">
                    <SelectTriggerCn Class="h-8 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="18.x">18.x LTS</SelectItemCn>
                        <SelectItemCn Value="20.x">20.x LTS</SelectItemCn>
                        <SelectItemCn Value="22.x">22.x</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Deployment region</span>
                <SelectCn @bind-Value="_region">
                    <SelectTriggerCn Class="h-8 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="iad1">US East (Virginia)</SelectItemCn>
                        <SelectItemCn Value="sfo1">US West (San Francisco)</SelectItemCn>
                        <SelectItemCn Value="cdg1">Europe (Paris)</SelectItemCn>
                        <SelectItemCn Value="hnd1">Asia Pacific (Tokyo)</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Auto-deploy toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Auto-deploy on push</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Automatically deploy when commits are pushed to the production branch</p>
            </div>
            <SwitchCn @bind-Checked="_autoDeploy" />
        </div>

        @* Build notifications toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Build notifications</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Receive email notifications on build success or failure</p>
            </div>
            <SwitchCn @bind-Checked="_buildNotifications" />
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save configuration
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _buildCommand = "next build";
    private string _installCommand = "bun install";
    private string _outputDirectory = ".next";
    private string _rootDirectory = "./";
    private string _nodeVersion = "20.x";
    private string _environment = "production";
    private string _region = "iad1";
    private string _branch = "main";
    private bool _autoDeploy = true;
    private bool _buildNotifications = true;
    private bool _saved = false;
}
