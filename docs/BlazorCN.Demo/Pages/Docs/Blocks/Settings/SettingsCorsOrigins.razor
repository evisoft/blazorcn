@* ===========================================================
   Block: settings-cors-origins
   Title: Settings Cors Origins
   Description: CORS origin management with add/remove, wildcard, test/verify
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-cors-origins.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">CORS Allowed Origins</p>
            <p class="mt-0.5 text-muted-foreground text-xs">Manage which domains can make cross-origin requests to your API</p>
        </div>

        @* Status *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">@_origins.Count origins configured</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_origins.Count(o => o.Verified) verified
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                @_origins.Count(o => !o.Verified) unverified
            </span>
        </div>

        @* Add origin *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn aria-label="https://example.com or https://*.example.com" @bind-Value="_newOrigin" Placeholder="https://example.com or https://*.example.com" Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 gap-1 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add
            </ButtonCn>
        </div>

        @* Origins list *@
        <div>
            @for (var i = 0; i < _origins.Count; i++)
            {
                var origin = _origins[i];
                var isLast = i == _origins.Count - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", origin.Verified ? "bg-emerald-500" : "bg-amber-500")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-mono text-sm">@origin.Url</span>
                                @if (origin.Wildcard)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Wildcard</BadgeCn>
                                }
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" Disabled="@(_testing == origin.Id)">
                                @if (_testing == origin.Id)
                                {
                                    <span>Testing...</span>
                                }
                                else if (origin.Verified)
                                {
                                    <LucideCheckCn Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                    <span>Verified</span>
                                }
                                else
                                {
                                    <LucideZapCn Size="12" Class="size-3" />
                                    <span>Test</span>
                                }
                            </ButtonCn>
                            <ButtonCn aria-label="Delete origin" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-red-600 dark:text-red-400">
                                <LucideTrashCn Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Info *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="font-medium text-muted-foreground text-xs">Wildcard patterns</p>
                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                    Use <code class="font-mono">https://*.example.com</code> to allow all subdomains.
                    Wildcards only match one level of subdomain.
                </p>
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OriginItem(string Id, string Url, bool Verified, bool Wildcard);

    private static readonly List<OriginItem> _origins =
    [
        new("1", "https://app.acme.com", true, false),
        new("2", "https://*.acme.com", true, true),
        new("3", "https://staging.acme.com", true, false),
        new("4", "http://localhost:3000", false, false),
        new("5", "https://partner-site.com", false, false),
    ];

    private string _newOrigin = "";
    private string? _testing = null;
    private bool _saved = false;
}
