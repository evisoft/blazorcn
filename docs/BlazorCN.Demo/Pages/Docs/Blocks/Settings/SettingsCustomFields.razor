@* ===========================================================
   Block: settings-custom-fields
   Title: Settings Custom Fields
   Description: Animated React custom field builder settings page for Next.js with field types, drag reordering, required toggles, and live preview built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Default value configuration for forms and fields
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-custom-fields.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Custom Fields</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Define custom fields for your forms and data models</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs" OnClick="AddField">
                <LucidePlusCn Size="12" Class="size-3" />
                Add field
            </ButtonCn>
        </div>

        @* Fields list *@
        <div>
            @for (var i = 0; i < _fields.Count; i++)
            {
                var field = _fields[i];
                var idx = i;
                var isExpanded = _expanded == field.Id;
                <div class="border-b">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : field.Id"
                            class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideGripVerticalCn Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@field.Label</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@FieldTypeLabel(field.Type)</BadgeCn>
                                @if (field.Required)
                                {
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                }
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-11">
                                <div>
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Label</span>
                                    <InputCn Value="@field.Label" ValueChanged="@((string v) => { field.Label = v; })" Class="h-8 text-sm" />
                                </div>

                                <div>
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Type</span>
                                    <SelectCn Value="@field.Type" ValueChanged="@((string v) => { field.Type = v; })">
                                        <SelectTriggerCn Class="h-8 w-full text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="text">Text</SelectItemCn>
                                            <SelectItemCn Value="number">Number</SelectItemCn>
                                            <SelectItemCn Value="select">Select</SelectItemCn>
                                            <SelectItemCn Value="date">Date</SelectItemCn>
                                            <SelectItemCn Value="checkbox">Checkbox</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>

                                @if (field.Type != "checkbox")
                                {
                                    <div>
                                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Placeholder</span>
                                        <InputCn Value="@field.Placeholder" ValueChanged="@((string v) => { field.Placeholder = v; })" Class="h-8 text-sm" />
                                    </div>
                                }

                                @if (field.Type == "select")
                                {
                                    <div>
                                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Options (comma-separated)</span>
                                        <InputCn Value="@field.Options" ValueChanged="@((string v) => { field.Options = v; })" placeholder="Option 1, Option 2, Option 3" Class="h-8 text-sm" />
                                    </div>
                                }

                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <SwitchCn Checked="field.Required" CheckedChanged="() => field.Required = !field.Required" />
                                        <span class="text-muted-foreground text-xs">Required</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2" Disabled="@(idx == 0)" OnClick="() => MoveField(field.Id, true)">
                                            <LucideChevronUpCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2" Disabled="@(idx == _fields.Count - 1)" OnClick="() => MoveField(field.Id, false)">
                                            <LucideChevronDownCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-red-600 dark:text-red-400" OnClick="() => RemoveField(field.Id)">
                                            <LucideTrashCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _saved = true">
                Save fields
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "2";
    private bool _saved;

    private class CustomField
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "text";
        public bool Required { get; set; }
        public string Placeholder { get; set; } = "";
        public string Options { get; set; } = "";
    }

    private readonly List<CustomField> _fields =
    [
        new() { Id = "1", Label = "Company Name", Type = "text", Required = true, Placeholder = "Enter company name" },
        new() { Id = "2", Label = "Department", Type = "select", Required = true, Placeholder = "Select department", Options = "Engineering, Design, Marketing, Sales, Support" },
        new() { Id = "3", Label = "Start Date", Type = "date", Required = false, Placeholder = "YYYY-MM-DD" },
        new() { Id = "4", Label = "Team Size", Type = "number", Required = false, Placeholder = "Number of team members" },
        new() { Id = "5", Label = "Accepts Terms", Type = "checkbox", Required = true },
    ];

    private static string FieldTypeLabel(string type) => type switch
    {
        "text" => "Text",
        "number" => "Number",
        "select" => "Select",
        "date" => "Date",
        "checkbox" => "Checkbox",
        _ => type,
    };

    private void AddField()
    {
        var newField = new CustomField { Id = (_fields.Count + 1).ToString(), Label = "New Field", Type = "text" };
        _fields.Add(newField);
        _expanded = newField.Id;
    }

    private void RemoveField(string id)
    {
        _fields.RemoveAll(f => f.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private void MoveField(string id, bool up)
    {
        var index = _fields.FindIndex(f => f.Id == id);
        if (index < 0) return;
        var swap = up ? index - 1 : index + 1;
        if (swap < 0 || swap >= _fields.Count) return;
        (_fields[index], _fields[swap]) = (_fields[swap], _fields[index]);
    }
}
