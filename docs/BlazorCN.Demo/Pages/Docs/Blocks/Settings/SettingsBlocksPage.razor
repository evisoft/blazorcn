@code {
    private const string SettingsAccessTokensCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center justify-between"">
                <div class=""flex items-center gap-3"">
                    <LucideKeyCn Size=""20"" Class=""h-5 w-5 text-muted-foreground"" />
                    <div>
                        <h2 class=""font-medium text-sm"">Personal Access Tokens</h2>
                        <p class=""text-muted-foreground text-xs"">
                            Create and manage tokens for API authentication
                        </p>
                    </div>
                </div>
                <ButtonCn Size=""ButtonSize.Sm"" Class=""h-7 gap-1.5 text-xs"" OnClick=""() => _showCreate = !_showCreate"">
                    <LucidePlusCn Size=""14"" Class=""h-3.5 w-3.5"" />
                    New Token
                </ButtonCn>
            </div>
        </div>

        @* Create token form *@
        @if (_showCreate)
        {
            <div class=""overflow-hidden border-b"">
                <div class=""space-y-3 px-4 py-3"">
                    <span class=""font-medium text-muted-foreground text-xs"">Create New Token</span>
                    <div class=""flex gap-2"">
                        <input
                            type=""text""
                            placeholder=""Token name (e.g. CI/CD Pipeline)""
                            class=""h-8 flex-1 rounded-md border bg-transparent px-3 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"" />
                        <select class=""h-8 rounded-md border bg-transparent px-3 text-xs text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"">
                            <option>30 days</option>
                            <option>60 days</option>
                            <option>90 days</option>
                            <option>180 days</option>
                            <option>1 year</option>
                            <option>No expiration</option>
                        </select>
                    </div>
                    <div>
                        <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">
                            Scopes
                        </span>
                        <div class=""flex flex-wrap gap-1.5"">
                            @foreach (var scope in _availableScopes)
                            {
                                <button
                                    type=""button""
                                    @onclick=""() => ToggleScope(scope.Id)""
                                    class=""@Cn.Merge(""rounded-md border px-2.5 py-1 font-mono text-xs transition-colors"", _selectedScopes.Contains(scope.Id) ? ""border-foreground/20 bg-foreground/5 text-foreground"" : ""text-muted-foreground hover:bg-muted/50"")"">
                                    @scope.Label
                                </button>
                            }
                        </div>
                    </div>
                    <div class=""flex justify-end gap-2"">
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 text-xs"" OnClick=""() => _showCreate = false"">
                            Cancel
                        </ButtonCn>
                        <ButtonCn Size=""ButtonSize.Sm"" Class=""h-7 text-xs"">
                            Generate Token
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Token list *@
        <div>
            @for (var i = 0; i < _tokens.Count; i++)
            {
                var token = _tokens[i];
                var isExpanded = _expanded == token.Id;
                var isLast = i == _tokens.Count - 1;
                var isExpired = token.Status == ""expired"";

                <div class=""@(isLast ? """" : ""border-b"")"">
                    <button
                        type=""button""
                        @onclick=""() => _expanded = isExpanded ? null : token.Id""
                        class=""flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"">
