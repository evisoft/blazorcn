            <div class=""rounded-md border bg-muted/20 p-3"">
                <div class=""flex flex-col gap-1"">
                    @{ var isFirst = true; }
                    @foreach (var menuItem in _menuItems.Where(m => m.Visible))
                    {
                        <div class=""@Cn.Merge(""flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-muted-foreground transition-colors"", isFirst ? ""bg-muted/50 text-foreground"" : """")"">
                            @if (menuItem.Icon == ""home"")
                            {
                                <LucideHomeCn Size=""14"" Class=""size-3.5 shrink-0"" />
                            }
                            else if (menuItem.Icon == ""dashboard"")
                            {
                                <LucideLayoutDashboardCn Size=""14"" Class=""size-3.5 shrink-0"" />
                            }
                            else if (menuItem.Icon == ""inbox"")
                            {
                                <LucideInboxCn Size=""14"" Class=""size-3.5 shrink-0"" />
                            }
                            else if (menuItem.Icon == ""users"")
                            {
                                <LucideUsersCn Size=""14"" Class=""size-3.5 shrink-0"" />
                            }
                            else if (menuItem.Icon == ""analytics"")
                            {
                                <LucideBarChart3Cn Size=""14"" Class=""size-3.5 shrink-0"" />
                            }
                            else if (menuItem.Icon == ""documents"")
                            {
                                <LucideFileTextCn Size=""14"" Class=""size-3.5 shrink-0"" />
                            }
                            else
                            {
                                <LucideSettingsCn Size=""14"" Class=""size-3.5 shrink-0"" />
                            }
                            @if (_showLabels)
                            {
                                <span class=""text-xs"">@menuItem.Label</span>
                            }
                            @if (!string.IsNullOrEmpty(menuItem.Badge) && _showLabels)
                            {
                                <span class=""ml-auto font-mono text-muted-foreground text-xs tabular-nums"">
                                    @menuItem.Badge
                                </span>
                            }
                        </div>
                        isFirst = false;
                    }
