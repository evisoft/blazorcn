                                            <SelectItemCn Value=""@t.Value"">@t.Label</SelectItemCn>
                                        }
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            @* Conditions *@
                            <div>
                                <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">
                                    Conditions
                                </span>
                                <div class=""space-y-1.5"">
                                    @foreach (var condition in rule.Conditions)
                                    {
                                        <div class=""flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2"">
                                            <span class=""text-xs"">@condition</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Actions *@
                            <div>
                                <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">
                                    Actions
                                </span>
                                <div class=""space-y-1.5"">
