                                        <InputCn Value=""@field.Options"" ValueChanged=""@((string v) => { field.Options = v; })"" placeholder=""Option 1, Option 2, Option 3"" Class=""h-8 text-sm"" />
                                    </div>
                                }

                                <div class=""flex items-center justify-between"">
                                    <div class=""flex items-center gap-2"">
                                        <SwitchCn Checked=""field.Required"" CheckedChanged=""() => field.Required = !field.Required"" />
