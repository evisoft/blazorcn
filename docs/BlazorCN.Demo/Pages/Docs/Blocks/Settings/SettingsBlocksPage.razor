                            </div>
                            <p class=""mt-0.5 font-mono text-muted-foreground text-xs"">
                                @field.Slug &middot; @field.Type
                            </p>
                        </div>
                        <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class=""space-y-3 px-4 pb-4 pl-12"">
                            @* Label and slug *@
                            <div class=""grid grid-cols-2 gap-3"">
                                <div>
                                    <span class=""mb-1 block text-muted-foreground text-xs"">Label</span>
                                    <InputCn @bind-Value=""field.Label"" Class=""h-7 text-xs"" />
                                </div>
                                <div>
                                    <span class=""mb-1 block text-muted-foreground text-xs"">Slug</span>
                                    <InputCn @bind-Value=""field.Slug"" Class=""h-7 font-mono text-xs"" />
                                </div>
                            </div>

                            @* Type and placeholder *@
                            <div class=""grid grid-cols-2 gap-3"">
                                <div>
                                    <span class=""mb-1 block text-muted-foreground text-xs"">Type</span>
                                    <SelectCn @bind-Value=""field.Type"">
                                        <SelectTriggerCn Class=""h-7 text-xs"">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var t in _fieldTypes)
                                            {
                                                <SelectItemCn Value=""@t.Value"">@t.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                                <div>
                                    <span class=""mb-1 block text-muted-foreground text-xs"">Placeholder</span>
                                    <InputCn @bind-Value=""field.Placeholder"" Class=""h-7 text-xs"" />
                                </div>
                            </div>

                            @* Description *@
                            <div>
                                <span class=""mb-1 block text-muted-foreground text-xs"">Help text</span>
                                <InputCn @bind-Value=""field.Description"" Class=""h-7 text-xs"" />
                            </div>

                            @* Validation *@
                            @if (field.Type == ""text"" || field.Type == ""textarea"")
                            {
                                <div class=""grid grid-cols-2 gap-3"">
                                    <div>
                                        <span class=""mb-1 block text-muted-foreground text-xs"">Min length</span>
                                        <InputCn Type=""number"" @bind-Value=""field.MinLength"" Class=""h-7 font-mono text-xs"" Placeholder=""0"" />
                                    </div>
                                    <div>
                                        <span class=""mb-1 block text-muted-foreground text-xs"">Max length</span>
                                        <InputCn Type=""number"" @bind-Value=""field.MaxLength"" Class=""h-7 font-mono text-xs"" Placeholder=""No limit"" />
                                    </div>
                                </div>
                            }

                            @* Select options preview *@
                            @if (field.Type == ""select"" && field.Options.Count > 0)
                            {
                                <div>
                                    <span class=""mb-1 block text-muted-foreground text-xs"">Options</span>
                                    <div class=""flex flex-wrap gap-1"">
                                        @foreach (var opt in field.Options)
                                        {
                                            <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                                                @opt
                                            </BadgeCn>
                                        }
                                    </div>
                                </div>
                            }

                            @* Toggles and delete *@
                            <div class=""flex items-center justify-between pt-1"">
                                <div class=""flex items-center gap-4"">
                                    <div class=""flex items-center gap-2"">
                                        <SwitchCn @bind-Checked=""field.Required"" />
                                        <span class=""text-muted-foreground text-xs"">Required</span>
                                    </div>
                                    <div class=""flex items-center gap-2"">
                                        <SwitchCn @bind-Checked=""field.Visible"" />
                                        <span class=""text-muted-foreground text-xs"">Visible</span>
                                    </div>
                                </div>
                                <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm""
                                          Class=""h-7 px-2 text-xs text-red-600 hover:text-red-600""
                                          OnClick=""() => RemoveField(fieldId)"">
                                    <LucideTrashCn Size=""12"" Class=""mr-1 size-3"" />
                                    Remove
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class=""flex items-center justify-end gap-2 border-t px-4 py-3"">
            @if (_saved)
            {
                <span class=""flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400"">
                    <LucideCheckCn Size=""12"" Class=""size-3"" />
                    Saved
                </span>
            }
            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 text-xs"" OnClick=""HandleSave"">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private bool _saved;

    private record SelectOption(string Value, string Label);

    private static readonly List<SelectOption> _fieldTypes = new()
    {
        new(""text"", ""Text""), new(""email"", ""Email""), new(""url"", ""URL""),
        new(""number"", ""Number""), new(""date"", ""Date""), new(""textarea"", ""Textarea""), new(""select"", ""Select""),
    };

    private class CustomField
    {
        public string Id { get; set; } = """";
        public string Label { get; set; } = """";
        public string Slug { get; set; } = """";
        public string Type { get; set; } = """";
        public bool Required { get; set; }
        public bool Visible { get; set; }
        public string Placeholder { get; set; } = """";
        public string Description { get; set; } = """";
        public string MinLength { get; set; } = """";
        public string MaxLength { get; set; } = """";
        public List<string> Options { get; set; } = new();
    }

    private readonly List<CustomField> _fields = new()
    {
        new() { Id = ""1"", Label = ""Job title"", Slug = ""job-title"", Type = ""text"", Required = false, Visible = true, Placeholder = ""e.g. Senior Engineer"", Description = ""Your current role or position"", MaxLength = ""100"" },
        new() { Id = ""2"", Label = ""Company"", Slug = ""company"", Type = ""text"", Required = false, Visible = true, Placeholder = ""e.g. Acme Inc."", Description = ""Your company or organization name"", MaxLength = ""100"" },
        new() { Id = ""3"", Label = ""Department"", Slug = ""department"", Type = ""select"", Required = false, Visible = true, Placeholder = ""Select department"", Description = ""Your team or department"", Options = new() { ""Engineering"", ""Design"", ""Product"", ""Marketing"", ""Sales"", ""Support"", ""Operations"" } },
        new() { Id = ""4"", Label = ""Phone number"", Slug = ""phone-number"", Type = ""text"", Required = false, Visible = false, Placeholder = ""+1 (555) 000-0000"", Description = ""Contact phone number"" },
        new() { Id = ""5"", Label = ""LinkedIn URL"", Slug = ""linkedin-url"", Type = ""url"", Required = false, Visible = true, Placeholder = ""https://linkedin.com/in/username"", Description = ""Your LinkedIn profile link"" },
        new() { Id = ""6"", Label = ""Start date"", Slug = ""start-date"", Type = ""date"", Required = true, Visible = true, Placeholder = ""YYYY-MM-DD"", Description = ""When you joined the organization"" },
    };

    private void RemoveField(string id)
    {
        _fields.RemoveAll(f => f.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}";
    private const string SettingsVersionControlCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
            <p class=""font-medium text-sm"">Version Control</p>
            <p class=""mt-0.5 text-muted-foreground text-xs"">
                Branch protection, merge policies, and commit rules
            </p>
        </div>

        @* Protected branches *@
        <div class=""border-b"">
            <div class=""flex items-center justify-between px-4 py-3"">
                <div class=""flex items-center gap-2"">
                    <LucideShieldCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                    <span class=""font-medium text-sm"">Protected branches</span>
                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                        @_branches.Count
                    </BadgeCn>
                </div>
                <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm""
                          Class=""h-7 gap-1 text-xs"" OnClick=""() => _showAddBranch = !_showAddBranch"">
                    <LucidePlusCn Size=""12"" Class=""size-3"" />
                    Add
                </ButtonCn>
            </div>

            @if (_showAddBranch)
            {
                <div class=""flex items-center gap-2 border-t px-4 py-3"">
                    <LucideGitBranchCn Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                    <InputCn @bind-Value=""_newBranch"" Placeholder=""Branch name...""
                             Class=""h-7 flex-1 text-xs"" />
                    <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm""
                              Class=""h-7 text-xs"" OnClick=""AddBranch"">
                        Add
                    </ButtonCn>
                </div>
            }

            @foreach (var branch in _branches)
            {
                var branchId = branch.Id;
                var isExpanded = _expandedBranch == branch.Id;
                var reviewText = branch.RequiredReviews != 1
                    ? $""{branch.RequiredReviews} reviews required""
                    : ""1 review required"";
                var statusText = branch.RequireStatusChecks ? "" · Status checks"" : """";

                <div>
                    <button type=""button"" @onclick=""() => _expandedBranch = isExpanded ? null : branchId""
                            class=""flex w-full items-center gap-3 border-t px-4 py-3 text-left transition-colors hover:bg-muted/50"">
                        <LucideGitBranchCn Size=""14"" Class=""size-3.5 shrink-0 text-muted-foreground"" />
                        <div class=""min-w-0 flex-1"">
                            <span class=""font-medium font-mono text-sm"">@branch.Name</span>
                            <p class=""mt-0.5 text-muted-foreground text-xs"">
                                @reviewText@statusText
                            </p>
                        </div>
                        <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class=""space-y-3 px-4 pb-4 pl-11"">
                            <div class=""flex items-center justify-between"">
                                <div>
                                    <p class=""font-medium text-xs text-muted-foreground"">
                                        Required reviews
                                    </p>
                                </div>
                                <SelectCn @bind-Value=""branch.RequiredReviewsStr"">
                                    <SelectTriggerCn Class=""h-7 w-20 text-xs"">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        @for (var n = 1; n <= 5; n++)
                                        {
                                            var val = n.ToString();
                                            <SelectItemCn Value=""@val"">@val</SelectItemCn>
                                        }
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            <div class=""flex items-center justify-between"">
                                <p class=""font-medium text-xs text-muted-foreground"">
                                    Require status checks
                                </p>
                                <SwitchCn @bind-Checked=""branch.RequireStatusChecks"" />
                            </div>

                            <div class=""flex justify-end"">
                                <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm""
                                          Class=""h-7 gap-1 text-red-600 text-xs hover:text-red-700""
                                          OnClick=""() => RemoveBranch(branchId)"">
                                    <LucideTrashCn Size=""12"" Class=""size-3"" />
                                    Remove
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Merge strategy *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div>
                <p class=""font-medium text-sm"">Default merge strategy</p>
                <p class=""mt-0.5 text-muted-foreground text-xs"">
                    How pull requests are merged into the base branch
                </p>
            </div>
            <SelectCn @bind-Value=""_mergeStrategy"">
                <SelectTriggerCn Class=""h-8 w-44 text-xs"">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value=""@(""merge"")"">Merge commit</SelectItemCn>
                    <SelectItemCn Value=""@(""squash"")"">Squash and merge</SelectItemCn>
                    <SelectItemCn Value=""@(""rebase"")"">Rebase and merge</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Toggles *@
        <div class=""border-b px-4 py-3"">
            <div class=""space-y-3"">
                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Auto-merge</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Merge PRs automatically when all checks pass
                        </p>
                    </div>
                    <SwitchCn @bind-Checked=""_autoMerge"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Auto-merge dependency updates</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Automatically merge Dependabot and Renovate PRs
                        </p>
                    </div>
                    <SwitchCn @bind-Checked=""_autoMergeDependabot"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Require signed commits</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Enforce GPG or SSH commit signature verification
                        </p>
                    </div>
                    <SwitchCn @bind-Checked=""_requireSignedCommits"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Delete head branch on merge</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Automatically delete the source branch after merging
                        </p>
                    </div>
                    <SwitchCn @bind-Checked=""_deleteHeadBranch"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Enforce linear history</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Prevent merge commits to keep a clean, linear commit log
                        </p>
                    </div>
                    <SwitchCn @bind-Checked=""_linearHistory"" />
                </div>
            </div>
        </div>

        @* Save *@
        <div class=""flex items-center justify-end gap-2 px-4 py-3"">
            @if (_saved)
            {
                <span class=""flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400"">
                    <LucideCheckCn Size=""12"" Class=""size-3"" />
                    Saved
                </span>
            }
            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 text-xs"" OnClick=""HandleSave"">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _mergeStrategy = ""squash"";
    private bool _autoMerge = true;
    private bool _autoMergeDependabot = true;
    private bool _requireSignedCommits;
    private bool _deleteHeadBranch = true;
    private bool _linearHistory;
    private string? _expandedBranch = ""1"";
    private string _newBranch = """";
    private bool _showAddBranch;
    private bool _saved;

    private class ProtectedBranch
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public int RequiredReviews { get; set; }
        public bool RequireStatusChecks { get; set; }

        public string RequiredReviewsStr
        {
            get => RequiredReviews.ToString();
            set { if (int.TryParse(value, out var v)) RequiredReviews = v; }
        }
    }

    private readonly List<ProtectedBranch> _branches = new()
    {
        new() { Id = ""1"", Name = ""main"", RequiredReviews = 2, RequireStatusChecks = true },
        new() { Id = ""2"", Name = ""production"", RequiredReviews = 3, RequireStatusChecks = true },
    };

    private void AddBranch()
    {
        if (string.IsNullOrWhiteSpace(_newBranch)) return;
        _branches.Add(new()
        {
            Id = (_branches.Count + 1).ToString(),
            Name = _newBranch.Trim(),
            RequiredReviews = 1,
            RequireStatusChecks = true,
        });
        _newBranch = """";
        _showAddBranch = false;
    }

    private void RemoveBranch(string id)
    {
        _branches.RemoveAll(b => b.Id == id);
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}";
