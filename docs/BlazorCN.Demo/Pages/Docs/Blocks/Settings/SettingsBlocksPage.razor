@code {
    private string? _expanded = ""admin"";

    private static readonly string[] _crudOps = { ""create"", ""read"", ""update"", ""delete"" };

    private record ResourceDef(string Id, string Name, string Description);

    private static readonly List<ResourceDef> _resources = new()
    {
        new(""projects"", ""Projects"", ""Workspaces and project resources""),
        new(""users"", ""Users"", ""Team member accounts""),
        new(""billing"", ""Billing"", ""Invoices, plans, and payment methods""),
        new(""settings"", ""Settings"", ""Workspace configuration""),
        new(""api-keys"", ""API Keys"", ""Authentication tokens and keys""),
        new(""integrations"", ""Integrations"", ""Third-party app connections""),
    };

    private class RoleDef
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Description { get; set; } = """";
        public int MemberCount { get; set; }
        public bool IsSystem { get; set; }
        public Dictionary<string, Dictionary<string, bool>> Permissions { get; set; } = new();
    }

    private int TotalPossible => _resources.Count * _crudOps.Length;

    private int TotalPermissions(RoleDef role)
    {
        var count = 0;
        foreach (var perms in role.Permissions.Values)
            foreach (var val in perms.Values)
                if (val) count++;
        return count;
    }

    private bool GetPermission(RoleDef role, string resourceId, string op)
        => role.Permissions.TryGetValue(resourceId, out var perms) && perms.TryGetValue(op, out var val) && val;

    private void SetPermission(RoleDef role, string resourceId, string op, bool value)
    {
        if (!role.Permissions.ContainsKey(resourceId))
            role.Permissions[resourceId] = new();
        role.Permissions[resourceId][op] = value;
    }

    private void RemoveRole(string id)
    {
        _roles.RemoveAll(r => r.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private static Dictionary<string, bool> AllTrue() => new() { [""create""] = true, [""read""] = true, [""update""] = true, [""delete""] = true };
    private static Dictionary<string, bool> P(bool c, bool r, bool u, bool d) => new() { [""create""] = c, [""read""] = r, [""update""] = u, [""delete""] = d };

    private readonly List<RoleDef> _roles = new()
    {
