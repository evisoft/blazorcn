            </div>
        </div>

        @* Footer *@
        <div class=""flex items-center justify-end gap-2 px-4 py-3"">
            @if (_saved)
            {
                <span class=""flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400"">
                    <LucideCheckCn Size=""12"" Class=""size-3"" />
                    Saved
                </span>
            }
            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 text-xs"" OnClick=""HandleSave"">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _collapseMode = ""icons"";
    private bool _defaultCollapsed;
    private bool _showLabels = true;
    private bool _stickyHeader = true;
    private bool _saved;

    private class MenuItem
    {
        public string Id { get; set; } = """";
        public string Label { get; set; } = """";
        public string Icon { get; set; } = """";
        public bool Visible { get; set; }
        public string Badge { get; set; } = """";
    }

    private readonly List<MenuItem> _menuItems = new()
    {
        new() { Id = ""m1"", Label = ""Home"", Icon = ""home"", Visible = true },
        new() { Id = ""m2"", Label = ""Dashboard"", Icon = ""dashboard"", Visible = true },
        new() { Id = ""m3"", Label = ""Inbox"", Icon = ""inbox"", Visible = true, Badge = ""12"" },
        new() { Id = ""m4"", Label = ""Team"", Icon = ""users"", Visible = true },
        new() { Id = ""m5"", Label = ""Analytics"", Icon = ""analytics"", Visible = true },
        new() { Id = ""m6"", Label = ""Documents"", Icon = ""documents"", Visible = false },
        new() { Id = ""m7"", Label = ""Settings"", Icon = ""settings"", Visible = true },
    };

    private void MoveItem(string id, int direction)
    {
        var idx = _menuItems.FindIndex(m => m.Id == id);
        var swapIdx = idx + direction;
        if (swapIdx < 0 || swapIdx >= _menuItems.Count) return;
        (_menuItems[idx], _menuItems[swapIdx]) = (_menuItems[swapIdx], _menuItems[idx]);
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}";
