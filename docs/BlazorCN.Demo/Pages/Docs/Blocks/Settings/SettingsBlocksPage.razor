                                        @if (isEditing)
                                        {
                                            <LucideEyeCn Size=""16"" Class=""size-3"" />
                                            <text>Preview</text>
                                        }
                                        else
                                        {
                                            <LucidePencilCn Size=""16"" Class=""size-3"" />
                                            <text>Edit</text>
                                        }
                                    </ButtonCn>
                                    <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm""
                                              Class=""h-6 px-2 text-xs""
                                              @onclick=""@(() => template.Enabled = !template.Enabled)"">
                                        @(template.Enabled ? ""Disable"" : ""Enable"")
                                    </ButtonCn>
                                </div>
                                <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm""
                                          Class=""h-7 gap-1 text-xs""
                                          @onclick=""@(() => HandleSendTest(templateId))"">
                                    @if (_testSent == templateId)
                                    {
                                        <LucideCheckCn Size=""16"" Class=""size-3 text-emerald-600 dark:text-emerald-400"" />
                                        <text>Sent</text>
                                    }
                                    else
                                    {
                                        <LucideSendCn Size=""16"" Class=""size-3"" />
                                        <text>Send test</text>
                                    }
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

