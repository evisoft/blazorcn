                        </ButtonCn>
                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-6 w-6 p-0"" OnClick=""() => MoveItem(menuItem.Id, 1)"" Disabled=""@(index == _menuItems.Count - 1)"">
