            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 text-xs"" OnClick=""() => _saved = true"">
                Save fields
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = ""2"";
    private bool _saved;

    private class CustomField
    {
        public string Id { get; set; } = """";
        public string Label { get; set; } = """";
        public string Type { get; set; } = ""text"";
        public bool Required { get; set; }
        public string Placeholder { get; set; } = """";
        public string Options { get; set; } = """";
    }

    private readonly List<CustomField> _fields =
    [
        new() { Id = ""1"", Label = ""Company Name"", Type = ""text"", Required = true, Placeholder = ""Enter company name"" },
        new() { Id = ""2"", Label = ""Department"", Type = ""select"", Required = true, Placeholder = ""Select department"", Options = ""Engineering, Design, Marketing, Sales, Support"" },
        new() { Id = ""3"", Label = ""Start Date"", Type = ""date"", Required = false, Placeholder = ""YYYY-MM-DD"" },
        new() { Id = ""4"", Label = ""Team Size"", Type = ""number"", Required = false, Placeholder = ""Number of team members"" },
        new() { Id = ""5"", Label = ""Accepts Terms"", Type = ""checkbox"", Required = true },
    ];

    private static string FieldTypeLabel(string type) => type switch
    {
        ""text"" => ""Text"",
        ""number"" => ""Number"",
        ""select"" => ""Select"",
        ""date"" => ""Date"",
        ""checkbox"" => ""Checkbox"",
        _ => type,
    };

    private void AddField()
    {
        var newField = new CustomField { Id = (_fields.Count + 1).ToString(), Label = ""New Field"", Type = ""text"" };
        _fields.Add(newField);
        _expanded = newField.Id;
    }

    private void RemoveField(string id)
    {
        _fields.RemoveAll(f => f.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private void MoveField(string id, bool up)
    {
        var index = _fields.FindIndex(f => f.Id == id);
        if (index < 0) return;
        var swap = up ? index - 1 : index + 1;
        if (swap < 0 || swap >= _fields.Count) return;
        (_fields[index], _fields[swap]) = (_fields[swap], _fields[index]);
    }
}";
    private const string SettingsDangerZoneCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
