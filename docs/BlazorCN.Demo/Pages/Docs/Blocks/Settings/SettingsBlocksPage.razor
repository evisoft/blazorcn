                                    </div>
                                    <div class=""flex items-center gap-1"">
                                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-6 px-2"" Disabled=""@(idx == 0)"" OnClick=""() => MoveField(field.Id, true)"">
