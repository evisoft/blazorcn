@code {
    private record ShortcutItem(string Id, string Action, string Category, string[] Keys, bool Customized);

    private static readonly string[] _categories = [""General"", ""Navigation"", ""Editor""];

    private static readonly List<ShortcutItem> _shortcuts =
    [
        new(""save"", ""Save"", ""General"", [""Ctrl"", ""S""], false),
        new(""undo"", ""Undo"", ""General"", [""Ctrl"", ""Z""], false),
        new(""redo"", ""Redo"", ""General"", [""Ctrl"", ""Shift"", ""Z""], false),
        new(""search"", ""Search"", ""General"", [""Ctrl"", ""K""], true),
