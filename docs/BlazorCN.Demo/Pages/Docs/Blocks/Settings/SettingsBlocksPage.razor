            </div>

            @* Workspace name *@
            <div class=""border-b px-4 py-3"">
                <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">Workspace Name</span>
                <InputCn Class=""h-8 text-sm"" @bind-Value=""_name"" Placeholder=""My Workspace"" />
            </div>

            @* URL slug *@
            <div class=""border-b px-4 py-3"">
                <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">Workspace URL</span>
                <div class=""flex items-center gap-0"">
                    <span class=""flex h-8 items-center rounded-l-md border border-r-0 bg-muted/50 px-3 font-mono text-muted-foreground text-xs"">app.acme.com/</span>
                    <InputCn Class=""h-8 rounded-l-none font-mono text-xs"" @bind-Value=""_slug"" Placeholder=""my-workspace"" />
                </div>
                <p class=""mt-1 text-muted-foreground text-xs"">Lowercase letters, numbers, and hyphens only. 3-48 characters.</p>
            </div>

            @* Description *@
            <div class=""border-b px-4 py-3"">
                <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">Description</span>
                <TextareaCn Class=""min-h-[72px] resize-none text-sm"" @bind-Value=""_description"" Placeholder=""A brief description of your workspace"" />
                <p class=""mt-1 text-muted-foreground text-xs"">@(_description.Length)/280 characters</p>
            </div>

            @* Timezone *@
            <div class=""border-b px-4 py-3"">
                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Timezone</p>
                        <p class=""text-muted-foreground text-xs"">Used for scheduled reports and activity logs</p>
                    </div>
                    <span class=""font-mono text-muted-foreground text-xs"">@_timezone</span>
                </div>
            </div>

            @* Save button *@
            <div class=""border-b px-4 py-3"">
                <div class=""flex items-center justify-end"">
                    <ButtonCn Size=""ButtonSize.Sm"" Class=""gap-1.5 text-xs"" Disabled=""@_isSaving"">
                        @if (_isSaving)
                        {
                            <LucideLoaderCircleCn Size=""14"" Class=""h-3.5 w-3.5 animate-spin"" />
                            <span>Saving...</span>
                        }
                        else
                        {
                            <LucideSaveCn Size=""14"" Class=""h-3.5 w-3.5"" />
                            <span>Save Changes</span>
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Danger zone *@
            <div class=""px-4 py-3"">
                <span class=""mb-3 block font-medium text-red-600 text-xs dark:text-red-400"">Danger Zone</span>
                <div class=""space-y-3 rounded-md border border-red-200 p-3 dark:border-red-900/50"">
                    <div class=""flex items-center justify-between"">
                        <div>
                            <p class=""font-medium text-sm"">Transfer Ownership</p>
                            <p class=""text-muted-foreground text-xs"">Transfer this workspace to another admin member</p>
                        </div>
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 text-xs"">Transfer</ButtonCn>
                    </div>
                    <div class=""border-t pt-3"">
                        <div class=""flex items-center justify-between"">
                            <div>
                                <p class=""font-medium text-sm"">Delete Workspace</p>
                                <p class=""text-muted-foreground text-xs"">Permanently delete this workspace and all its data</p>
                            </div>
                            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 text-red-600 text-xs hover:text-red-700"">
                                <LucideTrash2Cn Size=""12"" Class=""mr-1 h-3 w-3"" />
                                Delete
                            </ButtonCn>
                        </div>
                        <div class=""mt-3"">
                            <InputCn Class=""h-8 text-xs"" Placeholder=""@($""Type \""{_name}\"" to confirm"")"" @bind-Value=""_deleteConfirm"" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _name = ""Acme Corporation"";
    private string _slug = ""acme-corp"";
    private string _description = ""Enterprise SaaS platform for project management and team collaboration across distributed teams."";
    private string _timezone = ""America/New_York"";
    private bool _isSaving = false;
    private string _deleteConfirm = """";
}";
    private const string SettingsWorkspaceInvitesCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
            <p class=""font-medium text-sm"">Workspace Invites</p>
            <p class=""mt-0.5 text-muted-foreground text-xs"">
                Invite link, domain restrictions, and pending invitations
            </p>
        </div>

        @* Invite link *@
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center justify-between"">
                <div class=""flex items-center gap-2"">
                    <LucideLinkCn Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                    <span class=""font-medium text-sm"">Invite link</span>
                </div>
                <SwitchCn @bind-Checked=""_linkEnabled"" />
            </div>
            @if (_linkEnabled)
            {
                <div class=""mt-3 space-y-3"">
                    <div class=""flex items-center gap-2"">
                        <InputCn Value=""https://app.acme.com/invite/abc123def456"" Class=""h-8 flex-1 font-mono text-xs"" />
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-8 gap-1 text-xs"">
                            @if (_copied)
                            {
                                <LucideCheckCn Size=""12"" Class=""size-3"" />
                                <span>Copied</span>
                            }
                            else
                            {
                                <LucideCopyCn Size=""12"" Class=""size-3"" />
                                <span>Copy</span>
                            }
                        </ButtonCn>
                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-8 px-2"" title=""Regenerate link"">
                            <LucideRefreshCwCn Size=""14"" Class=""size-3.5"" />
                        </ButtonCn>
                    </div>

                    <div class=""flex items-center justify-between"">
                        <p class=""text-muted-foreground text-xs"">Link expiration</p>
                        <SelectCn @bind-Value=""_linkExpiry"">
                            <SelectTriggerCn Class=""h-7 w-28 text-xs"">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value=""1d"">1 day</SelectItemCn>
                                <SelectItemCn Value=""7d"">7 days</SelectItemCn>
                                <SelectItemCn Value=""30d"">30 days</SelectItemCn>
                                <SelectItemCn Value=""never"">Never</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
            }
        </div>

        @* Domain restrictions *@
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center justify-between"">
                <div>
                    <p class=""font-medium text-sm"">Domain restriction</p>
                    <p class=""mt-0.5 text-muted-foreground text-xs"">Only allow signups from approved email domains</p>
                </div>
                <SwitchCn @bind-Checked=""_domainRestriction"" />
            </div>

            @if (_domainRestriction)
            {
                <div class=""mt-3"">
                    <div class=""space-y-1.5"">
                        @foreach (var domain in _domains)
                        {
                            <div class=""flex items-center justify-between rounded-md bg-muted/50 px-3 py-1.5"">
                                <span class=""font-mono text-xs"">@@@domain</span>
                                <button type=""button"" class=""rounded p-0.5 text-muted-foreground transition-colors hover:text-red-600"">
                                    <LucideXCn Size=""12"" Class=""size-3"" />
                                </button>
                            </div>
                        }
                    </div>

                    <div class=""mt-2 flex items-center gap-2"">
                        <InputCn @bind-Value=""_newDomain"" Placeholder=""company.com"" Class=""h-7 flex-1 text-xs"" />
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 gap-1 text-xs"">
                            <LucidePlusCn Size=""12"" Class=""size-3"" />
                            Add
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Auto-join and defaults *@
        <div class=""border-b px-4 py-3"">
            <div class=""space-y-3"">
                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Auto-join</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Users with matching domains join automatically</p>
                    </div>
                    <SwitchCn @bind-Checked=""_autoJoin"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Default role</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Role assigned to new members</p>
                    </div>
                    <SelectCn @bind-Value=""_defaultRole"">
                        <SelectTriggerCn Class=""h-8 w-28 text-xs"">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value=""viewer"">Viewer</SelectItemCn>
                            <SelectItemCn Value=""editor"">Editor</SelectItemCn>
                            <SelectItemCn Value=""admin"">Admin</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Max members</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Maximum workspace members allowed</p>
                    </div>
                    <InputCn @bind-Value=""_maxMembers"" Class=""h-8 w-20 text-center text-xs"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Require admin approval</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">New members need approval before joining</p>
                    </div>
                    <SwitchCn @bind-Checked=""_requireApproval"" />
                </div>
            </div>
        </div>

        @* Pending invitations *@
        <div class=""border-b"">
            <div class=""flex items-center justify-between px-4 py-3"">
                <div class=""flex items-center gap-2"">
                    <LucideMailCn Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                    <span class=""font-medium text-sm"">Pending invitations</span>
                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                        @_invites.Count(i => i.Status == ""pending"")
                    </BadgeCn>
                </div>
            </div>

            @for (var i = 0; i < _invites.Count; i++)
            {
                var invite = _invites[i];
                var isLast = i == _invites.Count - 1;
                <div class=""@Cn.Merge(""flex items-center justify-between px-4 py-2.5"", isLast ? """" : ""border-t"")"">
                    <div class=""min-w-0 flex-1"">
                        <p class=""truncate font-mono text-xs"">@invite.Email</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            @invite.Role · Sent @invite.SentAt
                            @if (invite.Status == ""expired"")
                            {
                                <span class=""ml-1 text-amber-600 dark:text-amber-400"">· Expired</span>
                            }
                        </p>
                    </div>
                    <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-6 px-2 text-red-600 text-xs hover:text-red-700"">
                        Revoke
                    </ButtonCn>
                </div>
            }
        </div>

        @* Save *@
        <div class=""flex items-center justify-end gap-2 px-4 py-3"">
            @if (_saved)
            {
                <span class=""flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400"">
                    <LucideCheckCn Size=""12"" Class=""size-3"" />
                    Saved
                </span>
            }
            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 text-xs"">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record InviteItem(string Email, string Role, string SentAt, string Status);

    private static readonly List<string> _domains = [""acme.com"", ""acme.io""];

    private static readonly List<InviteItem> _invites =
    [
        new(""jordan@acme.com"", ""Editor"", ""2 days ago"", ""pending""),
        new(""casey@acme.com"", ""Viewer"", ""5 days ago"", ""pending""),
        new(""morgan@acme.com"", ""Admin"", ""2 weeks ago"", ""expired""),
    ];

    private bool _linkEnabled = true;
    private string _linkExpiry = ""7d"";
    private bool _domainRestriction = true;
    private bool _autoJoin = false;
    private string _defaultRole = ""viewer"";
    private string _maxMembers = ""50"";
    private bool _requireApproval = false;
    private string _newDomain = """";
    private bool _copied = false;
    private bool _saved = false;
}";
}
