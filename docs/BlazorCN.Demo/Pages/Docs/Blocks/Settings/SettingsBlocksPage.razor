                    {
                        <div class=""space-y-3 px-4 pb-4 pl-8"">
                            @* Subject *@
                            <div>
                                <span class=""mb-1.5 block text-xs font-medium text-muted-foreground"">Subject</span>
                                @if (isEditing)
                                {
                                    <InputCn Value=""@template.Subject"" ValueChanged=""@(v => template.Subject = v)"" Class=""h-8 text-sm"" />
