                            <LucideTrashCn Size=""12"" Class=""size-3"" />
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Boosting weights *@
        <div class=""border-b px-4 py-4"">
            <span class=""mb-3 block font-medium text-muted-foreground text-xs"">
