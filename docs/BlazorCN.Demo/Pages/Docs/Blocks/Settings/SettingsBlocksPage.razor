    private bool _saved;

    private class IndexingRule
    {
        public string Id { get; set; } = """";
        public string Label { get; set; } = """";
        public string Description { get; set; } = """";
        public bool Enabled { get; set; }
    }

    private class SynonymPair
    {
        public string Id { get; set; } = """";
        public string Term { get; set; } = """";
        public List<string> Synonyms { get; set; } = new();
    }

    private class BoostField
    {
        public string Id { get; set; } = """";
        public string Field { get; set; } = """";
        public int Weight { get; set; }
        public string Description { get; set; } = """";
    }

    private readonly List<IndexingRule> _indexingRules = new()
    {
        new() { Id = ""ir1"", Label = ""Index published content"", Description = ""Include only published pages and posts"", Enabled = true },
        new() { Id = ""ir2"", Label = ""Index product descriptions"", Description = ""Include product catalog in search results"", Enabled = true },
        new() { Id = ""ir3"", Label = ""Index help articles"", Description = ""Include knowledge base and documentation"", Enabled = true },
        new() { Id = ""ir4"", Label = ""Index user profiles"", Description = ""Allow searching for team members by name"", Enabled = false },
        new() { Id = ""ir5"", Label = ""Index archived content"", Description = ""Include archived pages in search results"", Enabled = false },
    };

    private readonly List<SynonymPair> _synonyms = new()
    {
        new() { Id = ""s1"", Term = ""laptop"", Synonyms = new() { ""notebook"", ""computer"", ""macbook"" } },
        new() { Id = ""s2"", Term = ""price"", Synonyms = new() { ""cost"", ""pricing"", ""rate"" } },
        new() { Id = ""s3"", Term = ""dashboard"", Synonyms = new() { ""overview"", ""home"", ""summary"" } },
        new() { Id = ""s4"", Term = ""settings"", Synonyms = new() { ""preferences"", ""config"", ""options"" } },
    };

    private readonly List<BoostField> _boostFields = new()
    {
        new() { Id = ""b1"", Field = ""title"", Weight = 10, Description = ""Page and product titles"" },
        new() { Id = ""b2"", Field = ""heading"", Weight = 7, Description = ""H2 and H3 headings"" },
        new() { Id = ""b3"", Field = ""description"", Weight = 5, Description = ""Meta descriptions and summaries"" },
        new() { Id = ""b4"", Field = ""body"", Weight = 3, Description = ""Main content body text"" },
        new() { Id = ""b5"", Field = ""tags"", Weight = 4, Description = ""Categories and tags"" },
    };

    private void RemoveSynonym(string pairId, string synonym)
    {
        var pair = _synonyms.FirstOrDefault(s => s.Id == pairId);
        pair?.Synonyms.Remove(synonym);
    }

    private void RemoveSynonymPair(string id)
    {
        _synonyms.RemoveAll(s => s.Id == id);
    }

    private void UpdateWeight(string id, int weight)
    {
        var field = _boostFields.FirstOrDefault(f => f.Id == id);
        if (field != null) field.Weight = weight;
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}";
    private const string SettingsSecurityCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
