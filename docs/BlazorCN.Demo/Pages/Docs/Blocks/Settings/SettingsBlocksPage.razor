                </p>
            </div>
            <div class=""flex items-center gap-2 text-muted-foreground text-xs"">
                <LucideCalendarCn Size=""12"" Class=""size-3"" />
                <span>@_reports.Count(r => r.Enabled) active</span>
            </div>
        </div>

        @* Reports list *@
        <div>
            @for (var i = 0; i < _reports.Count; i++)
            {
                var report = _reports[i];
                var index = i;
                var isExpanded = _expanded == report.Id;
                var isLast = index == _reports.Count - 1;

                <div class=""@(isLast ? """" : ""border-b"")"">
                    <div class=""flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50"">
                        <button type=""button"" @onclick=""() => _expanded = isExpanded ? null : report.Id""
                                class=""flex min-w-0 flex-1 items-center gap-3 text-left"">
                            <LucideFileTextCn Size=""16"" Class=""size-4 shrink-0 text-muted-foreground"" />
                            <div class=""min-w-0 flex-1"">
                                <span class=""@Cn.Merge(""font-medium text-sm"", !report.Enabled ? ""text-muted-foreground"" : """")"">
                                    @report.Name
                                </span>
                                <div class=""mt-0.5 flex items-center gap-2"">
                                    <span class=""text-muted-foreground text-xs"">
                                        @(_frequencies.FirstOrDefault(f => f.Value == report.Frequency)?.Label)
                                    </span>
                                    <span class=""text-muted-foreground text-xs"">&middot;</span>
                                    <span class=""font-mono text-muted-foreground text-xs uppercase"">
                                        @report.Format
                                    </span>
                                    <span class=""text-muted-foreground text-xs"">&middot;</span>
                                    <span class=""text-muted-foreground text-xs"">
                                        @report.Recipients.Count recipient@(report.Recipients.Count != 1 ? ""s"" : """")
                                    </span>
                                </div>
                            </div>
                            <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                        </button>
                        <SwitchCn @bind-Checked=""report.Enabled"" />
                    </div>

                    @if (isExpanded)
                    {
                        <div class=""space-y-3 px-4 pb-4 pl-11"">
                            @* Report name *@
                            <div>
                                <span class=""mb-1 block font-medium text-muted-foreground text-xs"">
                                    Report name
                                </span>
                                <InputCn @bind-Value=""report.Name"" Class=""h-8 text-sm"" />
                            </div>

                            @* Frequency + Format *@
                            <div class=""grid grid-cols-2 gap-3"">
                                <div>
                                    <span class=""mb-1 block font-medium text-muted-foreground text-xs"">
                                        Frequency
                                    </span>
                                    <SelectCn @bind-Value=""report.Frequency"">
                                        <SelectTriggerCn Class=""h-8 text-xs"">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var f in _frequencies)
                                            {
                                                <SelectItemCn Value=""@f.Value"">@f.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                                <div>
                                    <span class=""mb-1 block font-medium text-muted-foreground text-xs"">
                                        Format
                                    </span>
                                    <SelectCn @bind-Value=""report.Format"">
                                        <SelectTriggerCn Class=""h-8 text-xs"">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var f in _formats)
                                            {
                                                <SelectItemCn Value=""@f.Value"">@f.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                            </div>

                            @* Next run info *@
                            <div class=""rounded-md bg-muted/50 p-3"">
                                <div class=""flex items-center justify-between"">
                                    <span class=""text-muted-foreground text-xs"">
                                        Next run: @report.NextRun
                                    </span>
                                    <span class=""text-muted-foreground text-xs"">
                                        Last run: @report.LastRun
                                    </span>
                                </div>
                            </div>

                            @* Recipients *@
                            <div>
                                <span class=""mb-1.5 block font-medium text-muted-foreground text-xs"">
                                    Recipients
                                </span>
                                <div class=""flex flex-wrap gap-1.5"">
                                    @foreach (var email in report.Recipients.ToList())
                                    {
                                        var emailCopy = email;
                                        var reportId = report.Id;
                                        <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""gap-1 font-mono font-normal text-xs"">
                                            @emailCopy
                                            <button type=""button"" @onclick=""() => RemoveRecipient(reportId, emailCopy)""
                                                    class=""ml-0.5 opacity-60 transition-opacity hover:opacity-100"">
                                                <span class=""sr-only"">Remove</span>&times;
                                            </button>
                                        </BadgeCn>
                                    }
                                </div>
                            </div>

                            @* Actions *@
                            <div class=""flex items-center justify-end gap-2"">
                                <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm""
                                          Class=""h-6 gap-1 px-2 text-red-600 text-xs hover:text-red-700""
                                          OnClick=""() => DeleteReport(report.Id)"">
                                    <LucideTrashCn Size=""12"" Class=""size-3"" />
                                    Delete
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class=""flex items-center justify-between border-t px-4 py-3"">
            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 gap-1 text-xs"">
                <LucidePlusCn Size=""12"" Class=""size-3"" />
                Add report
            </ButtonCn>
            <div class=""flex items-center gap-2"">
                @if (_saved)
                {
                    <span class=""flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400"">
                        <LucideCheckCn Size=""12"" Class=""size-3"" />
                        Saved
                    </span>
                }
                <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 text-xs"" OnClick=""HandleSave"">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private bool _saved;

    private record FrequencyOption(string Value, string Label);
    private record FormatOption(string Value, string Label);

    private static readonly List<FrequencyOption> _frequencies = new()
    {
        new(""daily"", ""Daily""), new(""weekly"", ""Weekly""), new(""biweekly"", ""Bi-weekly""),
        new(""monthly"", ""Monthly""), new(""quarterly"", ""Quarterly""),
    };

    private static readonly List<FormatOption> _formats = new()
    {
        new(""csv"", ""CSV""), new(""pdf"", ""PDF""), new(""xlsx"", ""XLSX""),
    };

    private class ScheduledReport
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Frequency { get; set; } = """";
        public string Format { get; set; } = """";
        public List<string> Recipients { get; set; } = new();
        public bool Enabled { get; set; }
        public string NextRun { get; set; } = """";
        public string LastRun { get; set; } = """";
    }

    private readonly List<ScheduledReport> _reports = new()
    {
        new() { Id = ""r1"", Name = ""Weekly Revenue Summary"", Frequency = ""weekly"", Format = ""pdf"", Recipients = new() { ""cfo@acme.com"", ""finance-team@acme.com"" }, Enabled = true, NextRun = ""Mon, Mar 24"", LastRun = ""Mon, Mar 17"" },
        new() { Id = ""r2"", Name = ""Daily Active Users"", Frequency = ""daily"", Format = ""csv"", Recipients = new() { ""product@acme.com"" }, Enabled = true, NextRun = ""Tomorrow, 8:00 AM"", LastRun = ""Today, 8:00 AM"" },
        new() { Id = ""r3"", Name = ""Monthly Churn Analysis"", Frequency = ""monthly"", Format = ""xlsx"", Recipients = new() { ""success@acme.com"", ""ceo@acme.com"", ""product@acme.com"" }, Enabled = true, NextRun = ""Apr 1"", LastRun = ""Mar 1"" },
        new() { Id = ""r4"", Name = ""Quarterly Board Deck"", Frequency = ""quarterly"", Format = ""pdf"", Recipients = new() { ""board@acme.com"" }, Enabled = false, NextRun = ""Jul 1"", LastRun = ""Jan 1"" },
    };

    private void RemoveRecipient(string reportId, string email)
    {
        var report = _reports.FirstOrDefault(r => r.Id == reportId);
        report?.Recipients.Remove(email);
    }

    private void DeleteReport(string id)
    {
        _reports.RemoveAll(r => r.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}";
    private const string SettingsSearchConfigCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
