                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                        Disabled
                    </BadgeCn>
                }
                <SwitchCn @bind-Checked=""_rateLimitEnabled"" />
            </div>
        </div>

        @* Global settings *@
        <div class=""border-b px-4 py-3"">
            <div class=""mb-3 flex items-center gap-2"">
                <LucideGaugeCn Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                <span class=""font-medium text-muted-foreground text-xs"">Global policy</span>
            </div>
            <div class=""space-y-3"">
                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Algorithm</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Rate limiting strategy for counting requests</p>
                    </div>
                    <SelectCn @bind-Value=""_algorithm"">
                        <SelectTriggerCn Class=""h-8 w-40 text-xs"">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value=""sliding-window"">Sliding window</SelectItemCn>
                            <SelectItemCn Value=""fixed-window"">Fixed window</SelectItemCn>
                            <SelectItemCn Value=""token-bucket"">Token bucket</SelectItemCn>
                            <SelectItemCn Value=""leaky-bucket"">Leaky bucket</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Include Retry-After headers</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Add Retry-After and X-RateLimit headers to responses</p>
                    </div>
                    <SwitchCn @bind-Checked=""_includeRetryHeaders"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Log exceeded requests</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Record rate-limited requests in the audit log</p>
                    </div>
                    <SwitchCn @bind-Checked=""_logExceeded"" />
                </div>

                <div class=""flex items-center justify-between"">
                    <div>
                        <p class=""font-medium text-sm"">Threshold alert</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Notify when usage exceeds a percentage of the limit</p>
                    </div>
                    <div class=""flex items-center gap-2"">
                        <InputCn @bind-Value=""_thresholdPercent"" Class=""h-7 w-14 text-center text-xs"" />
                        <span class=""text-muted-foreground text-xs"">%</span>
                    </div>
                </div>
            </div>
        </div>

        @* Tier list *@
        <div>
            @for (var i = 0; i < _tiers.Count; i++)
            {
                var tier = _tiers[i];
                var isExpanded = _expandedTier == tier.Id;
                var isLast = i == _tiers.Count - 1;

                <div class=""@(isLast ? """" : ""border-b"")"">
                    <button type=""button"" @onclick=""() => _expandedTier = isExpanded ? null : tier.Id""
                            class=""flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"">
                        <span class=""@Cn.Merge(""size-1.5 shrink-0 rounded-full"", UsageDot(tier.CurrentUsagePercent))""></span>
                        <div class=""min-w-0 flex-1"">
                            <div class=""flex items-center gap-2"">
                                <span class=""font-medium text-sm"">@tier.Name</span>
                                <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                                    @tier.ActiveKeys keys
                                </BadgeCn>
                            </div>
                            <p class=""mt-0.5 text-muted-foreground text-xs"">
                                @tier.RequestsPerMinute req/min &middot; @tier.RequestsPerDay req/day &middot;
                                <span class=""@UsageColor(tier.CurrentUsagePercent)"">@tier.CurrentUsagePercent% usage</span>
                            </p>
                        </div>
                        <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class=""overflow-hidden"">
                            <div class=""grid grid-cols-2 gap-3 px-4 pb-4 pl-8"">
                                <div>
                                    <span class=""mb-1 block font-medium text-muted-foreground text-xs"">Requests / minute</span>
                                    <InputCn Value=""@tier.RequestsPerMinute"" ValueChanged=""@((string v) => { tier.RequestsPerMinute = v; })"" Class=""h-7 text-xs"" />
                                </div>
                                <div>
                                    <span class=""mb-1 block font-medium text-muted-foreground text-xs"">Requests / day</span>
                                    <InputCn Value=""@tier.RequestsPerDay"" ValueChanged=""@((string v) => { tier.RequestsPerDay = v; })"" Class=""h-7 text-xs"" />
                                </div>
                                <div>
                                    <span class=""mb-1 block font-medium text-muted-foreground text-xs"">Burst allowance</span>
                                    <InputCn Value=""@tier.BurstAllowance"" ValueChanged=""@((string v) => { tier.BurstAllowance = v; })"" Class=""h-7 text-xs"" />
                                </div>
                                <div>
                                    <span class=""mb-1 block font-medium text-muted-foreground text-xs"">Cooldown (seconds)</span>
                                    <InputCn Value=""@tier.CooldownSeconds"" ValueChanged=""@((string v) => { tier.CooldownSeconds = v; })"" Class=""h-7 text-xs"" />
                                </div>
                                <div>
                                    <span class=""mb-1 block font-medium text-muted-foreground text-xs"">Concurrent connections</span>
                                    <InputCn Value=""@tier.ConcurrentConnections"" ValueChanged=""@((string v) => { tier.ConcurrentConnections = v; })"" Class=""h-7 text-xs"" />
                                </div>
                                <div class=""flex items-end"">
                                    <div class=""flex items-center gap-2"">
                                        <LucideActivityCn Size=""12"" Class=""size-3 text-muted-foreground"" />
                                        <span class=""text-muted-foreground text-xs"">
                                            <span class=""@Cn.Merge(""font-medium tabular-nums"", UsageColor(tier.CurrentUsagePercent))"">@tier.CurrentUsagePercent%</span>
                                            avg utilization
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class=""flex items-center justify-end gap-2 border-t px-4 py-3"">
            @if (_saved)
            {
                <span class=""flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400"">
                    <LucideCheckCn Size=""12"" Class=""size-3"" />
                    Saved
                </span>
            }
            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 text-xs"" OnClick=""() => _saved = true"">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

