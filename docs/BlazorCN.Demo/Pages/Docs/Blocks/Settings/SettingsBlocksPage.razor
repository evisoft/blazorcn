    private List<DnsRecord> _records = new()
    {
        new() { Id = ""1"", Type = ""A"", Name = ""acme.com"", Value = ""76.76.21.21"", Ttl = 300, Verified = true },
        new() { Id = ""2"", Type = ""CNAME"", Name = ""www"", Value = ""cname.vercel-dns.com"", Ttl = 3600, Verified = true },
        new() { Id = ""3"", Type = ""MX"", Name = ""acme.com"", Value = ""mx1.mailprovider.com"", Ttl = 3600, Verified = true, Priority = 10 },
        new() { Id = ""4"", Type = ""MX"", Name = ""acme.com"", Value = ""mx2.mailprovider.com"", Ttl = 3600, Verified = false, Priority = 20 },
        new() { Id = ""5"", Type = ""TXT"", Name = ""acme.com"", Value = ""v=spf1 include:_spf.mailprovider.com ~all"", Ttl = 3600, Verified = true },
        new() { Id = ""6"", Type = ""TXT"", Name = ""_dmarc"", Value = ""v=DMARC1; p=quarantine; rua=mailto:dmarc@@acme.com"", Ttl = 3600, Verified = false },
    };

    private int VerifiedCount => _records.Count(r => r.Verified);

    private static string GetTypeColor(string type) => type switch
    {
        ""A"" => ""bg-blue-500/10 text-blue-700 dark:text-blue-400"",
        ""CNAME"" => ""bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"",
        ""MX"" => ""bg-amber-500/10 text-amber-700 dark:text-amber-400"",
        ""TXT"" => ""bg-purple-500/10 text-purple-700 dark:text-purple-400"",
        _ => """",
    };

    private void AddRecord()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newValue)) return;
        _records.Add(new DnsRecord
        {
            Id = (_records.Count + 1).ToString(),
            Type = _newType,
            Name = _newName,
            Value = _newValue,
            Ttl = 3600,
            Verified = false,
        });
        _newType = ""A"";
        _newName = """";
        _newValue = """";
        _showAdd = false;
    }

    private void RemoveRecord(string id)
    {
        _records.RemoveAll(r => r.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private async Task HandleCopy(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}";
