        new() { Id = ""viewer"", Name = ""Viewer"", Description = ""Read-only access"", MemberCount = 12, IsSystem = true,
            Permissions = new() { [""projects""] = P(false,true,false,false), [""users""] = P(false,true,false,false), [""billing""] = P(false,false,false,false), [""settings""] = P(false,true,false,false), [""api-keys""] = P(false,false,false,false), [""integrations""] = P(false,true,false,false) } },
    };
}";
