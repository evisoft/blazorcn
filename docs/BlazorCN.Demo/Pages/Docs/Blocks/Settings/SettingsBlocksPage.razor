        new(""bold"", ""Bold"", ""Editor"", [""Ctrl"", ""B""], false),
        new(""italic"", ""Italic"", ""Editor"", [""Ctrl"", ""I""], false),
        new(""code"", ""Code block"", ""Editor"", [""Ctrl"", ""`""], true),
    ];

    private string _search = """";
    private string? _recording = null;
    private string? _expandedCategory = ""General"";
    private bool _saved = false;

    private List<ShortcutItem> GetCategoryShortcuts(string category)
    {
        return _shortcuts
