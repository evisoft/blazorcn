                        </ButtonCn>
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 text-xs""
                                  @onclick=""AddRecord"">
                            Add record
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Records list *@
        <div>
            @for (var i = 0; i < _records.Count; i++)
            {
                var record = _records[i];
