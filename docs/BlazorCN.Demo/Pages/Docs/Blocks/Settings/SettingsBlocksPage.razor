                                </div>
                            </div>
                            <div class=""mt-2 flex justify-end"">
                                <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm""
                                          Class=""h-6 px-2 text-xs text-red-600 dark:text-red-400""
                                          @onclick=""@(() => RemoveRecord(recordId))"">
                                    <LucideTrashCn Size=""16"" Class=""mr-1 size-3"" />
                                    Remove
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

