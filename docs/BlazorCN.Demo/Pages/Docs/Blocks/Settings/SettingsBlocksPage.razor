                            @(tierIndex + 1)
                        </span>
                        <div class=""min-w-0 flex-1"">
                            <span class=""text-sm font-medium"">@tier.Label</span>
                            <p class=""mt-0.5 text-xs text-muted-foreground"">@tier.Description</p>
