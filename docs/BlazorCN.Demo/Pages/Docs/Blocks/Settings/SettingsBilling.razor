@* ===========================================================
   Block: settings-billing
   Title: Settings Billing
   Description: Animated React billing settings page for Next.js with current plan display, payment method management, invoice history, and usage meter built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, bio, and avatar management
   Dependencies: BadgeCn, ButtonCn, ProgressCn
   Source: original/blocks/settings/settings-billing.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Billing</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage your subscription, payment methods, and view invoices
            </p>
        </div>

        @* Current plan *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted/50">
                    <LucideSparklesCn Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <p class="font-medium text-sm">Pro Individual</p>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Monthly</BadgeCn>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        <span class="font-semibold tabular-nums">$39</span>/month &middot; Renews Apr 1, 2026
                    </p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideZapCn Size="12" Class="size-3" />
                Upgrade
            </ButtonCn>
        </div>

        @* Payment method *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted/50">
                    <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div>
                    <p class="font-medium text-sm">Visa ending in 4242</p>
                    <p class="mt-0.5 font-mono text-muted-foreground text-xs">Expires 08/2028</p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Update
            </ButtonCn>
        </div>

        @* Usage *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 font-medium text-sm">Usage this period</p>
            <div class="space-y-4">
                @foreach (var u in _usage)
                {
                    var percentage = (int)Math.Round(u.Used / u.Limit * 100);
                    var isHigh = percentage >= 80;
                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">@u.Label</span>
                            <span class="@Cn.Merge("font-mono text-xs tabular-nums", isHigh ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground")">
                                @u.Used.ToString("N0") / @u.Limit.ToString("N0") @u.Unit
                            </span>
                        </div>
                        <ProgressCn Value="percentage" aria-label="Progress" />
                    </div>
                }
            </div>
        </div>

        @* Invoice history *@
        <div>
            <div class="px-4 py-3">
                <p class="font-medium text-sm">Invoice history</p>
            </div>
            @for (var i = 0; i < _invoices.Count; i++)
            {
                var invoice = _invoices[i];
                var isLast = i == _invoices.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", StatusDot(invoice.Status))"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm tabular-nums">@invoice.Id</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @invoice.Description &middot; @invoice.Date
                        </p>
                    </div>
                    <span class="font-medium text-sm tabular-nums">@invoice.Amount</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                        <LucideDownloadCn Size="12" Class="size-3" />
                        PDF
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Invoice(string Id, string Date, string Amount, string Status, string Description);
    private record UsageItem(string Label, double Used, double Limit, string Unit);

    private static readonly List<Invoice> _invoices =
    [
        new("INV-2026-003", "Mar 1, 2026", "$39.00", "paid", "Pro Individual - Monthly"),
        new("INV-2026-002", "Feb 1, 2026", "$39.00", "paid", "Pro Individual - Monthly"),
        new("INV-2026-001", "Jan 1, 2026", "$39.00", "paid", "Pro Individual - Monthly"),
        new("INV-2025-012", "Dec 1, 2025", "$29.00", "paid", "Starter - Monthly"),
    ];

    private static readonly UsageItem[] _usage =
    [
        new("API calls", 8420, 10000, "calls"),
        new("Storage", 3.2, 5, "GB"),
        new("Team members", 1, 1, "seats"),
    ];

    private static string StatusDot(string status) => status switch
    {
        "paid" => "bg-emerald-500",
        "pending" => "bg-amber-500",
        "failed" => "bg-red-500",
        _ => "bg-muted-foreground",
    };
}
