@* ===========================================================
   Block: settings-widget-embed
   Title: Settings Widget Embed
   Description: Animated React widget embed settings page for Next.js with script snippet preview, color customization, position selection, and allowed domains management using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Invite links and domain restrictions
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-widget-embed.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Widget Embed</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Embed script, customization, and allowed domains
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_enabled)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <span class="mr-1.5 size-1.5 rounded-full bg-emerald-500"></span>
                        Live
                    </BadgeCn>
                }
                else
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Disabled
                    </BadgeCn>
                }
                <SwitchCn @bind-Checked="_enabled" />
            </div>
        </div>

        @* Embed code *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideCodeCn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Embed code</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-xs" OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
            <div class="rounded-md bg-zinc-950 p-3">
                <pre class="overflow-x-auto font-mono text-sm text-zinc-100"><code>@_embedSnippet</code></pre>
            </div>
            <p class="mt-2 text-muted-foreground text-xs">
                Paste before the closing &lt;/body&gt; tag on your site
            </p>
        </div>

        @* Customization *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Position</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Widget placement on the page</p>
                    </div>
                    <SelectCn @bind-Value="_position">
                        <SelectTriggerCn Class="h-8 w-36 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="@("bottom-right")">Bottom right</SelectItemCn>
                            <SelectItemCn Value="@("bottom-left")">Bottom left</SelectItemCn>
                            <SelectItemCn Value="@("top-right")">Top right</SelectItemCn>
                            <SelectItemCn Value="@("top-left")">Top left</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Accent color</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Primary color for buttons and highlights
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="size-6 rounded-md border" style="@($"background-color: {_accentColor}")"></span>
                        <InputCn @bind-Value="_accentColor" Class="h-8 w-24 font-mono text-xs" />
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Border radius</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Corner rounding in pixels</p>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <InputCn @bind-Value="_borderRadius" Class="h-8 w-16 text-center text-xs" />
                        <span class="text-muted-foreground text-xs">px</span>
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Show branding</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Display "Powered by" badge in the widget footer
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_showBranding" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Mobile support</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Show widget on mobile devices
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_mobileEnabled" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Auto-open</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Automatically open the widget after a delay
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <SwitchCn @bind-Checked="_autoOpen" />
                    </div>
                </div>

                @if (_autoOpen)
                {
                    <div class="flex items-center justify-between pl-4">
                        <p class="text-muted-foreground text-xs">Delay before opening</p>
                        <div class="flex items-center gap-1.5">
                            <InputCn @bind-Value="_autoOpenDelay" Class="h-7 w-14 text-center text-xs" />
                            <span class="text-muted-foreground text-xs">sec</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Allowed domains *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideGlobeCn Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Allowed domains</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_domains.Count
                    </BadgeCn>
                </div>
            </div>
            <p class="mb-3 text-muted-foreground text-xs">
                The widget will only load on these domains
            </p>

            <div class="space-y-1.5">
                @foreach (var domain in _domains.ToList())
                {
                    var d = domain;
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-1.5">
                        <span class="font-mono text-xs">@d</span>
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm"
                                  Class="hover:text-red-600" OnClick="() => RemoveDomain(d)">
                            <LucideXCn Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
            </div>

            <div class="mt-2 flex items-center gap-2">
                <InputCn @bind-Value="_newDomain" Placeholder="example.com"
                         Class="h-7 flex-1 text-xs" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs" OnClick="AddDomain">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _enabled = true;
    private string _position = "bottom-right";
    private string _accentColor = "#18181B";
    private string _borderRadius = "12";
    private bool _showBranding = true;
    private bool _autoOpen;
    private string _autoOpenDelay = "5";
    private bool _mobileEnabled = true;
    private string _newDomain = "";
    private bool _copied;
    private bool _saved;

    private static readonly string _embedSnippet = @"<script
  src=""https://cdn.acme.com/widget/v2.js""
  data-widget-id=""wgt_8f3k2n4p""
  data-position=""bottom-right""
  async
></script>";

    private readonly List<string> _domains = new()
    {
        "acme.com", "app.acme.com", "docs.acme.com", "localhost:3000",
    };

    private void AddDomain()
    {
        if (string.IsNullOrWhiteSpace(_newDomain) || _domains.Contains(_newDomain.Trim())) return;
        _domains.Add(_newDomain.Trim());
        _newDomain = "";
    }

    private void RemoveDomain(string domain)
    {
        _domains.Remove(domain);
    }

    private void HandleCopy()
    {
        _copied = true;
        _ = ResetCopied();
    }

    private async Task ResetCopied()
    {
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
