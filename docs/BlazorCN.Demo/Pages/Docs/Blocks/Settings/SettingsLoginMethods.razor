@* ===========================================================
   Block: settings-login-methods
   Title: Settings Login Methods
   Description: Animated React login method settings page for Next.js with email/password, OAuth providers, magic link, passkey toggles, session duration, and brute-force protection built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: OIDC and SAML SSO configuration
   Dependencies: BadgeCn, ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-login-methods.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideKeyCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">Login Methods</p>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure how users authenticate with your application
            </p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @(_methods.Count(m => m.Enabled)) methods active
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">
                @(_methods.Count(m => !m.Enabled)) disabled
            </span>
        </div>

        @* Auth methods section *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-muted-foreground text-xs">Authentication methods</p>
        </div>

        @foreach (var method in _methods)
        {
            <div class="flex items-center justify-between border-b px-4 py-4">
                <div class="flex items-center gap-3">
                    @if (method.Icon == "mail")
                    {
                        <LucideMailCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (method.Icon == "fingerprint")
                    {
                        <LucideFingerprintPatternCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (method.Icon == "smartphone")
                    {
                        <LucideSmartphoneCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideShieldCheckCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    <div>
                        <div class="flex items-center gap-2">
                            <p class="font-medium text-sm">@method.Name</p>
                            @if (method.Enabled)
                            {
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@method.Description</p>
                    </div>
                </div>
                <SwitchCn aria-label="@method.Name" @bind-Checked="method.Enabled" />
            </div>
        }

        @* Password policy section *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-muted-foreground text-xs">Password policy</p>
        </div>

        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Minimum length</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Minimum characters required for passwords
                </p>
            </div>
            <SelectCn @bind-Value="_minLength">
                <SelectTriggerCn aria-label="Minimum password length" Class="h-8 w-28 text-xs">
                    <SelectValueCn Placeholder="Select" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("6")">6 chars</SelectItemCn>
                    <SelectItemCn Value="@("8")">8 chars</SelectItemCn>
                    <SelectItemCn Value="@("10")">10 chars</SelectItemCn>
                    <SelectItemCn Value="@("12")">12 chars</SelectItemCn>
                    <SelectItemCn Value="@("16")">16 chars</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Require uppercase letter</span>
            <SwitchCn aria-label="Require uppercase letter" @bind-Checked="_requireUppercase" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Require number</span>
            <SwitchCn aria-label="Require number" @bind-Checked="_requireNumbers" />
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm">Require special character</span>
            <SwitchCn aria-label="Require special character" @bind-Checked="_requireSymbols" />
        </div>

        @* Session & security section *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-muted-foreground text-xs">Session & security</p>
        </div>

        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Session duration</p>
                <p class="mt-0.5 text-muted-foreground text-xs">How long sessions remain active</p>
            </div>
            <SelectCn @bind-Value="_sessionDuration">
                <SelectTriggerCn aria-label="Session duration" Class="h-8 w-32 text-xs">
                    <SelectValueCn Placeholder="Select" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("1h")">1 hour</SelectItemCn>
                    <SelectItemCn Value="@("24h")">24 hours</SelectItemCn>
                    <SelectItemCn Value="@("7d")">7 days</SelectItemCn>
                    <SelectItemCn Value="@("30d")">30 days</SelectItemCn>
                    <SelectItemCn Value="@("90d")">90 days</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="font-medium text-sm">Brute-force protection</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Lock accounts after failed login attempts
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_bruteForce)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Active
                    </BadgeCn>
                }
                <SwitchCn aria-label="Brute-force protection" @bind-Checked="_bruteForce" />
            </div>
        </div>

        @if (_bruteForce)
        {
            <div class="flex items-center justify-between border-b px-4 py-4">
                <div>
                    <p class="font-medium text-sm">Lockout threshold</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Failed attempts before lockout</p>
                </div>
                <SelectCn @bind-Value="_lockoutThreshold">
                    <SelectTriggerCn aria-label="Lockout threshold" Class="h-8 w-32 text-xs">
                        <SelectValueCn Placeholder="Select" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="@("3")">3 attempts</SelectItemCn>
                        <SelectItemCn Value="@("5")">5 attempts</SelectItemCn>
                        <SelectItemCn Value="@("10")">10 attempts</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        }

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _sessionDuration = "7d";
    private bool _bruteForce = true;
    private string _lockoutThreshold = "5";
    private string _minLength = "8";
    private bool _requireUppercase = true;
    private bool _requireNumbers = true;
    private bool _requireSymbols;
    private bool _saved;

    private class AuthMethod
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private readonly List<AuthMethod> _methods = new()
    {
        new() { Id = "email-password", Name = "Email & password", Description = "Traditional email and password authentication", Icon = "mail", Enabled = true },
        new() { Id = "google", Name = "Google OAuth", Description = "Sign in with Google account", Icon = "shield", Enabled = true },
        new() { Id = "github", Name = "GitHub OAuth", Description = "Sign in with GitHub account", Icon = "shield", Enabled = true },
        new() { Id = "magic-link", Name = "Magic link", Description = "Passwordless email sign-in with one-time links", Icon = "mail", Enabled = false },
        new() { Id = "passkey", Name = "Passkey", Description = "WebAuthn biometric and hardware key authentication", Icon = "fingerprint", Enabled = false },
        new() { Id = "sms", Name = "SMS OTP", Description = "One-time password sent via text message", Icon = "smartphone", Enabled = false },
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
