@* ===========================================================
   Block: settings-rate-limiting
   Title: Settings Rate Limiting
   Description: Animated React rate limit configuration settings page for Next.js with tier-based limits, burst allowance, custom rules, and usage monitoring built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Multi-channel notification routing
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-rate-limiting.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Rate Limiting</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure API rate limits and burst allowances
            </p>
        </div>

        @* Global toggle *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Enable rate limiting</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Enforce request limits across all API endpoints
                    </p>
                </div>
            </div>
            <SwitchCn @bind-Checked="_globalEnabled" />
        </div>

        @* Current usage *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideGaugeCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">
                    Current usage (this hour)
                </span>
            </div>
            <div class="space-y-3">
                @foreach (var metric in _usageMetrics)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="text-sm">@metric.Tier</span>
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                @metric.Current.ToString("N0") / @metric.Limit.ToString("N0")
                            </span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="@Cn.Merge("h-full rounded-full", metric.Percentage >= 80 ? "bg-red-500" : metric.Percentage >= 50 ? "bg-amber-500" : "bg-foreground")"
                                 style="@($"width: {metric.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tier-based limits *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Tier limits</span>
            <div class="space-y-3">
                @foreach (var tier in _tiers)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@tier.Name</span>
                                @if (tier.Enabled)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                            </div>
                            <SwitchCn @bind-Checked="tier.Enabled" />
                        </div>
                        @if (tier.Enabled)
                        {
                            <div class="mt-3 grid grid-cols-3 gap-3">
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Requests</span>
                                    <InputCn Type="number" @bind-Value="tier.Requests" Class="h-7 text-xs" />
                                </div>
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Window</span>
                                    <SelectCn @bind-Value="tier.Window">
                                        <SelectTriggerCn Class="h-7 text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="@("minute")">Minute</SelectItemCn>
                                            <SelectItemCn Value="@("hour")">Hour</SelectItemCn>
                                            <SelectItemCn Value="@("day")">Day</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Burst</span>
                                    <InputCn Type="number" @bind-Value="tier.Burst" Class="h-7 text-xs" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Custom rules *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Custom endpoint rules</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    Add rule
                </ButtonCn>
            </div>
            @for (var i = 0; i < _rules.Count; i++)
            {
                var rule = _rules[i];
                var index = i;
                var isExpanded = _expanded == rule.Id;
                var isLast = index == _rules.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : rule.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideZapCn Size="16" Class="@Cn.Merge("size-4 shrink-0", rule.Enabled ? "text-foreground" : "text-muted-foreground/40")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm">@rule.Endpoint</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs font-normal">
                                    @rule.Method
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @rule.Limit requests / @rule.Window
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-11">
                            <div class="flex items-center justify-between">
                                <span class="text-sm">Enabled</span>
                                <SwitchCn @bind-Checked="rule.Enabled" />
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Limit</span>
                                    <InputCn Type="number" @bind-Value="rule.Limit" Class="h-7 text-xs" />
                                </div>
                                <div>
                                    <span class="mb-1 block text-muted-foreground text-xs">Window</span>
                                    <SelectCn @bind-Value="rule.Window">
                                        <SelectTriggerCn Class="h-7 text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            <SelectItemCn Value="@("second")">Second</SelectItemCn>
                                            <SelectItemCn Value="@("minute")">Minute</SelectItemCn>
                                            <SelectItemCn Value="@("hour")">Hour</SelectItemCn>
                                            <SelectItemCn Value="@("day")">Day</SelectItemCn>
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _globalEnabled = true;
    private string? _expanded = "auth";
    private bool _saved;

    private class RateTier
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Requests { get; set; } = "";
        public string Window { get; set; } = "";
        public string Burst { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class CustomRule
    {
        public string Id { get; set; } = "";
        public string Endpoint { get; set; } = "";
        public string Method { get; set; } = "";
        public string Limit { get; set; } = "";
        public string Window { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private record UsageMetric(string Tier, int Current, int Limit, double Percentage);

    private readonly List<RateTier> _tiers = new()
    {
        new() { Id = "free", Name = "Free", Requests = "100", Window = "hour", Burst = "20", Enabled = true },
        new() { Id = "pro", Name = "Pro", Requests = "5000", Window = "hour", Burst = "500", Enabled = true },
        new() { Id = "enterprise", Name = "Enterprise", Requests = "50000", Window = "hour", Burst = "5000", Enabled = true },
    };

    private readonly List<CustomRule> _rules = new()
    {
        new() { Id = "auth", Endpoint = "/api/auth/*", Method = "POST", Limit = "10", Window = "minute", Enabled = true },
        new() { Id = "upload", Endpoint = "/api/upload", Method = "POST", Limit = "50", Window = "hour", Enabled = true },
        new() { Id = "search", Endpoint = "/api/search", Method = "GET", Limit = "200", Window = "minute", Enabled = true },
        new() { Id = "webhook", Endpoint = "/api/webhooks/*", Method = "POST", Limit = "1000", Window = "hour", Enabled = false },
    };

    private static readonly List<UsageMetric> _usageMetrics = new()
    {
        new("Free", 67, 100, 67),
        new("Pro", 2340, 5000, 46.8),
        new("Enterprise", 12800, 50000, 25.6),
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
