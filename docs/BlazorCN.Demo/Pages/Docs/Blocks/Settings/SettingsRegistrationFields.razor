@* ===========================================================
   Block: settings-registration-fields
   Title: Settings Registration Fields
   Description: Animated React registration form field configuration page for Next.js with drag-to-reorder fields, required and optional toggles, field type selection, and validation rules built with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Name, email, avatar, and timezone
   Dependencies: ButtonCn, InputCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-registration-fields.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Registration Fields</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Configure which fields appear on your signup form
                </p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_fields.Count(f => f.Enabled) active</span>
                <span>&middot;</span>
                <span>@_fields.Count(f => f.Required && f.Enabled) required</span>
            </div>
        </div>

        @* Fields list *@
        <div>
            @for (var i = 0; i < _fields.Count; i++)
            {
                var field = _fields[i];
                var index = i;
                var isExpanded = _expanded == field.Id;
                var isLast = index == _fields.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-2 px-4 py-3 transition-colors hover:bg-muted/50">
                        <LucideGripVerticalCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                        <button type="button" @onclick="() => _expanded = isExpanded ? null : field.Id"
                                class="flex min-w-0 flex-1 items-center gap-3 text-left">
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("font-medium text-sm", !field.Enabled ? "text-muted-foreground" : "")">
                                    @field.Label
                                </span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <span class="text-muted-foreground text-xs">
                                        @(_fieldTypes.FirstOrDefault(t => t.Value == field.Type)?.Label)
                                    </span>
                                    @if (field.Required && field.Enabled)
                                    {
                                        <span class="text-muted-foreground text-xs">&middot;</span>
                                        <span class="text-muted-foreground text-xs">Required</span>
                                    }
                                </div>
                            </div>
                            <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                        <SwitchCn @bind-Checked="field.Enabled" />
                    </div>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <span class="mb-1 block font-medium text-muted-foreground text-xs">Label</span>
                                    <InputCn @bind-Value="field.Label" Class="h-8 text-sm" />
                                </div>
                                <div>
                                    <span class="mb-1 block font-medium text-muted-foreground text-xs">Type</span>
                                    <SelectCn @bind-Value="field.Type">
                                        <SelectTriggerCn Class="h-8 text-xs">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var ft in _fieldTypes)
                                            {
                                                <SelectItemCn Value="@ft.Value">@ft.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                            </div>

                            <div>
                                <span class="mb-1 block font-medium text-muted-foreground text-xs">Placeholder</span>
                                <InputCn @bind-Value="field.Placeholder" Class="h-8 text-sm" />
                            </div>

                            <div>
                                <span class="mb-1 block font-medium text-muted-foreground text-xs">Validation rules</span>
                                <InputCn @bind-Value="field.Validation" Class="h-8 font-mono text-xs" Placeholder="e.g. min:2, max:80, email" />
                            </div>

                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <SwitchCn @bind-Checked="field.Required" />
                                    <span class="text-muted-foreground text-xs">Required field</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="() => MoveField(field.Id, -1)" Disabled="@(index == 0)">
                                        <LucideArrowUpCn Size="12" Class="size-3" />
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="() => MoveField(field.Id, 1)" Disabled="@(index == _fields.Count - 1)">
                                        <LucideArrowDownCn Size="12" Class="size-3" />
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0 text-red-600 hover:text-red-700" OnClick="() => RemoveField(field.Id)">
                                        <LucideTrashCn Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add field
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_saved)
                {
                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideCheckCn Size="12" Class="size-3" />
                        Saved
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                    Save changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private bool _saved;

    private record FieldTypeOption(string Value, string Label);

    private static readonly List<FieldTypeOption> _fieldTypes = new()
    {
        new("text", "Text"), new("email", "Email"), new("password", "Password"),
        new("select", "Dropdown"), new("textarea", "Text area"), new("checkbox", "Checkbox"), new("phone", "Phone"),
    };

    private class RegistrationField
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "";
        public bool Required { get; set; }
        public bool Enabled { get; set; }
        public string Placeholder { get; set; } = "";
        public string Validation { get; set; } = "";
    }

    private readonly List<RegistrationField> _fields = new()
    {
        new() { Id = "f1", Label = "Full name", Type = "text", Required = true, Enabled = true, Placeholder = "Jane Smith", Validation = "min:2, max:80" },
        new() { Id = "f2", Label = "Email address", Type = "email", Required = true, Enabled = true, Placeholder = "jane@company.com", Validation = "email" },
        new() { Id = "f3", Label = "Password", Type = "password", Required = true, Enabled = true, Placeholder = "", Validation = "min:8, uppercase, number" },
        new() { Id = "f4", Label = "Company name", Type = "text", Required = false, Enabled = true, Placeholder = "Acme Inc.", Validation = "max:120" },
        new() { Id = "f5", Label = "Role", Type = "select", Required = false, Enabled = true, Placeholder = "Select your role", Validation = "" },
        new() { Id = "f6", Label = "Phone number", Type = "phone", Required = false, Enabled = false, Placeholder = "+1 (555) 000-0000", Validation = "phone" },
        new() { Id = "f7", Label = "How did you hear about us?", Type = "select", Required = false, Enabled = false, Placeholder = "Select source", Validation = "" },
    };

    private void MoveField(string id, int direction)
    {
        var idx = _fields.FindIndex(f => f.Id == id);
        var swapIdx = idx + direction;
        if (swapIdx < 0 || swapIdx >= _fields.Count) return;
        (_fields[idx], _fields[swapIdx]) = (_fields[swapIdx], _fields[idx]);
    }

    private void RemoveField(string id)
    {
        _fields.RemoveAll(f => f.Id == id);
        if (_expanded == id) _expanded = null;
    }

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
