@* ===========================================================
   Block: settings-email-domain
   Title: Settings Email Domain
   Description: SPF/DKIM/DMARC DNS record verification
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-email-domain.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Email domain</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Verify DNS records for authenticated email delivery</p>
            </div>
            <div class="flex items-center gap-1.5">
                @{ var allVerified = _records.All(r => r.Status == "verified"); }
                <span class="@Cn.Merge("size-1.5 rounded-full", allVerified ? "bg-emerald-500" : "bg-amber-500")"></span>
                <span class="text-muted-foreground text-xs">@_records.Count(r => r.Status == "verified")/@_records.Count verified</span>
            </div>
        </div>

        @* Domain input *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Sending domain</span>
            <div class="flex items-center gap-2">
                <InputCn aria-label="Sending domain" Class="h-8 font-mono text-sm" @bind-Value="_domain" Placeholder="example.com" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs" Disabled="@(_verifying == "all")">
                    @if (_verifying == "all")
                    {
                        <LucideLoaderCircleCn Size="12" Class="mr-1 size-3 animate-spin" />
                        <span>Verifying</span>
                    }
                    else
                    {
                        <span>Verify all</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* DNS Records *@
        <div>
            <div class="px-4 py-3">
                <p class="font-medium text-sm">DNS records</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Add these records to your domain DNS zone</p>
            </div>
            @for (var i = 0; i < _records.Count; i++)
            {
                var record = _records[i];
                var isLast = i == _records.Count - 1;
                var isExpanded = _expanded == record.Id;
                var dotClass = record.Status == "verified" ? "bg-emerald-500" : record.Status == "failed" ? "bg-red-500" : "bg-amber-500";
                var statusLabel = record.Status == "verified" ? "Verified" : record.Status == "failed" ? "Failed" : "Pending";
                var statusTextClass = record.Status == "verified" ? "text-emerald-600 dark:text-emerald-400" : record.Status == "failed" ? "text-red-600 dark:text-red-400" : "text-amber-600 dark:text-amber-400";
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : record.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dotClass)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@record.Type</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@record.RecordType</BadgeCn>
                            </div>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">@record.Name</p>
                        </div>
                        <span class="@Cn.Merge("text-xs", statusTextClass)">@statusLabel</span>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-9">
                                <div>
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Host / Name</span>
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <div class="flex items-center justify-between">
                                            <code class="break-all font-mono text-xs">@record.Name</code>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 gap-1 px-2 text-xs">
                                                <LucideCopyCn Size="12" Class="size-3" />
                                                Copy
                                            </ButtonCn>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Value</span>
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <div class="flex items-center justify-between gap-2">
                                            <code class="break-all font-mono text-xs">@record.Value</code>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 gap-1 px-2 text-xs">
                                                <LucideCopyCn Size="12" Class="size-3" />
                                                Copy
                                            </ButtonCn>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Last checked: @record.LastChecked</span>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_verifying == record.Id)">
                                        @if (_verifying == record.Id)
                                        {
                                            <LucideLoaderCircleCn Size="12" Class="mr-1 size-3 animate-spin" />
                                            <span>Checking</span>
                                        }
                                        else
                                        {
                                            <span>Verify</span>
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            @if (_saved)
            {
                <span class="mr-2 flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save domain
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DnsRecord(string Id, string Type, string RecordType, string Name, string Value, string Status, string LastChecked);

    private static readonly List<DnsRecord> _records =
    [
        new("spf", "SPF", "TXT", "acme.com", "v=spf1 include:_spf.acme-mail.com ~all", "verified", "2 hours ago"),
        new("dkim", "DKIM", "CNAME", "mail._domainkey.acme.com", "dkim.acme-mail.com", "verified", "2 hours ago"),
        new("dmarc", "DMARC", "TXT", "_dmarc.acme.com", "v=DMARC1; p=quarantine; rua=mailto:dmarc@acme.com", "pending", "3 days ago"),
    ];

    private string _domain = "acme.com";
    private string? _expanded = "dmarc";
    private string? _verifying = null;
    private bool _saved = false;
}
