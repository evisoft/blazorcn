@* ===========================================================
   Block: settings-feature-toggles
   Title: Settings Feature Toggles
   Description: Feature flag management with environment toggles, rollout percentages, user targeting, and kill switch
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideChevronRightCn, LucideFlagCn, LucideZapCn, SliderCn, SwitchCn
   Source: original/blocks/settings/settings-feature-toggles.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Feature Toggles</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Control feature rollout across environments
                </p>
            </div>
            <div class="flex items-center gap-2">
                <LucideFlagCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">
                    @ActiveInProd of @_flags.Count in production
                </span>
            </div>
        </div>

        @* Flags list *@
        <div>
            @for (var i = 0; i < _flags.Count; i++)
            {
                var flag = _flags[i];
                var isExpanded = _expanded == flag.Id;
                var isLast = i == _flags.Count - 1;
                var flagId = flag.Id;
                var isActive = flag.Production || flag.Staging || flag.Development;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : flagId)">
                        <span class="@($"size-1.5 shrink-0 rounded-full {(isActive ? "bg-emerald-500" : "bg-muted-foreground/30")}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@flag.Name</span>
                                @if (flag.Production)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                        @(flag.Rollout)%
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 font-mono text-xs text-muted-foreground">@flag.Key</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">
                            @flag.LastModified
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-4 px-4 pb-4 pl-8">
                            @* Description *@
                            <p class="text-sm leading-relaxed text-muted-foreground">
                                @flag.Description
                            </p>

                            @* Environment toggles *@
                            <div>
                                <span class="mb-2 block text-xs font-medium text-muted-foreground">
                                    Environments
                                </span>
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                        <span class="text-sm capitalize">production</span>
                                        <SwitchCn Checked="@flag.Production"
                                                  CheckedChanged="@(_ => ToggleEnvironment(flagId, "production"))" />
                                    </div>
                                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                        <span class="text-sm capitalize">staging</span>
                                        <SwitchCn Checked="@flag.Staging"
                                                  CheckedChanged="@(_ => ToggleEnvironment(flagId, "staging"))" />
                                    </div>
                                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                        <span class="text-sm capitalize">development</span>
                                        <SwitchCn Checked="@flag.Development"
                                                  CheckedChanged="@(_ => ToggleEnvironment(flagId, "development"))" />
                                    </div>
                                </div>
                            </div>

                            @* Rollout percentage *@
                            <div>
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Rollout percentage
                                    </span>
                                    <span class="text-sm font-semibold tabular-nums">
                                        @(flag.Rollout)%
                                    </span>
                                </div>
                                <SliderCn Value="@flag.Rollout" ValueChanged="@(v => UpdateRollout(flagId, (int)v))"
                                          Max="100" Step="5" />
                            </div>

                            @* Targeting *@
                            <div class="flex items-center justify-between">
                                <div>
                                    <span class="block text-xs font-medium text-muted-foreground">
                                        Targeting
                                    </span>
                                    <span class="text-sm">@flag.Targeting</span>
                                </div>
                            </div>

                            @* Kill switch *@
                            <div class="flex items-center justify-between pt-1">
                                <span class="text-xs text-muted-foreground">
                                    Instantly disable across all environments
                                </span>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                          Class="h-7 gap-1 border-red-200 text-xs text-red-600 hover:bg-red-50 dark:border-red-900/50 dark:text-red-400 dark:hover:bg-red-950/30"
                                          @onclick="@(() => KillSwitch(flagId))">
                                    <LucideZapCn Size="16" Class="size-3" />
                                    Kill switch
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                    <LucideCheckCn Size="16" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                      @onclick="HandleSave">
                Save flags
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class FeatureFlag
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Key { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Production { get; set; }
        public bool Staging { get; set; }
        public bool Development { get; set; }
        public int Rollout { get; set; }
        public string Targeting { get; set; } = "";
        public string LastModified { get; set; } = "";
    }

    private string? _expanded = "1";
    private bool _saved;

    private List<FeatureFlag> _flags = new()
    {
        new() { Id = "1", Name = "New Onboarding Flow", Key = "new_onboarding_v2", Description = "Redesigned onboarding with interactive walkthrough and progress tracking", Production = false, Staging = true, Development = true, Rollout = 25, Targeting = "Pro plan users", LastModified = "3 hours ago" },
        new() { Id = "2", Name = "AI Code Review", Key = "ai_code_review", Description = "AI-powered code review suggestions in pull request comments", Production = true, Staging = true, Development = true, Rollout = 100, Targeting = "All users", LastModified = "2 days ago" },
        new() { Id = "3", Name = "Real-time Collaboration", Key = "realtime_collab", Description = "Live cursors, presence indicators, and simultaneous editing support", Production = false, Staging = true, Development = true, Rollout = 10, Targeting = "Team plan users", LastModified = "1 week ago" },
        new() { Id = "4", Name = "Dark Mode V2", Key = "dark_mode_v2", Description = "Updated dark mode palette with improved contrast and reduced eye strain", Production = true, Staging = true, Development = true, Rollout = 50, Targeting = "All users", LastModified = "5 days ago" },
        new() { Id = "5", Name = "Export to PDF", Key = "export_pdf", Description = "Export dashboards, reports, and documents as formatted PDF files", Production = false, Staging = false, Development = true, Rollout = 0, Targeting = "Internal only", LastModified = "2 weeks ago" },
        new() { Id = "6", Name = "Usage-based Billing", Key = "usage_billing", Description = "Metered billing based on API calls, storage, and compute usage", Production = false, Staging = true, Development = true, Rollout = 5, Targeting = "Organization plan users", LastModified = "4 days ago" },
    };

    private int ActiveInProd => _flags.Count(f => f.Production);

    private void ToggleEnvironment(string id, string env)
    {
        var flag = _flags.FirstOrDefault(f => f.Id == id);
        if (flag == null) return;
        switch (env)
        {
            case "production": flag.Production = !flag.Production; break;
            case "staging": flag.Staging = !flag.Staging; break;
            case "development": flag.Development = !flag.Development; break;
        }
    }

    private void UpdateRollout(string id, int rollout)
    {
        var flag = _flags.FirstOrDefault(f => f.Id == id);
        if (flag != null) flag.Rollout = rollout;
    }

    private void KillSwitch(string id)
    {
        var flag = _flags.FirstOrDefault(f => f.Id == id);
        if (flag == null) return;
        flag.Production = false;
        flag.Staging = false;
        flag.Development = false;
        flag.Rollout = 0;
    }

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
