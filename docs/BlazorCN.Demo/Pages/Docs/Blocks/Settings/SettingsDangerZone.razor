@* ===========================================================
   Block: settings-danger-zone
   Title: Settings Danger Zone
   Description: Archive/transfer/delete workspace with confirmation
   Dependencies: ButtonCn, InputCn
   Source: original/blocks/settings/settings-danger-zone.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-red-200 bg-card dark:border-red-900/50">
        @* Header *@
        <div class="flex items-center gap-3 border-b border-red-200 px-4 py-3 dark:border-red-900/50">
            <LucideTriangleAlertCn Size="16" Class="size-4 text-red-600 dark:text-red-400" />
            <div>
                <p class="font-medium text-red-600 text-sm dark:text-red-400">Danger Zone</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Irreversible and destructive actions for this workspace</p>
            </div>
        </div>

        @* Actions *@
        @for (var i = 0; i < _dangerActions.Count; i++)
        {
            var action = _dangerActions[i];
            var isLast = i == _dangerActions.Count - 1;
            var isExpanded = _expanded == action.Id;
            <div class="@(isLast ? "" : "border-b border-red-200 dark:border-red-900/50")">
                <div class="px-4 py-4">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex min-w-0 items-start gap-3">
                            @if (action.Id == "archive")
                            {
                                <LucideArchiveCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            }
                            else if (action.Id == "transfer")
                            {
                                <LucideArrowRightLeftCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideTrashCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            }
                            <div>
                                <p class="font-medium text-sm">@action.Title</p>
                                <p class="mt-0.5 text-muted-foreground text-xs">@action.Description</p>
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                            class="h-7 shrink-0 border-red-200 text-red-600 text-xs hover:bg-red-50 dark:border-red-900/50 dark:text-red-400 dark:hover:bg-red-950/30"
                            @onclick="@(() => _expanded = isExpanded ? null : action.Id)">
                            @action.ButtonLabel
                        </ButtonCn>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="mt-3 ml-7 space-y-3">
                            <div class="rounded-md bg-red-50 p-3 dark:bg-red-950/20">
                                <p class="font-medium text-red-600 text-xs dark:text-red-400">Consequences</p>
                                <p class="mt-1 text-red-600/80 text-xs leading-relaxed dark:text-red-400/80">@action.Consequence</p>
                            </div>

                            @if (!string.IsNullOrEmpty(action.ConfirmText))
                            {
                                <div>
                                    <span class="mb-1.5 block text-muted-foreground text-xs">
                                        Type <code class="rounded bg-muted px-1 py-0.5 font-mono text-foreground">@action.ConfirmText</code> to confirm
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <InputCn @bind-Value="_confirmInput" Placeholder="@action.ConfirmText" Class="h-8 text-sm" />
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                            class="h-8 shrink-0 border-red-200 bg-red-600 text-white text-xs hover:bg-red-700 disabled:opacity-40 dark:border-red-900/50"
                                            Disabled="@(_confirmInput != action.ConfirmText)">
                                            Confirm delete
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _expanded = null)">
                                        Cancel
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 border-red-200 bg-red-600 text-white text-xs hover:bg-red-700 dark:border-red-900/50">
                                        Confirm @action.Title.ToLower()
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record DangerAction(string Id, string Title, string Description, string ButtonLabel, string Consequence, string? ConfirmText);

    private static readonly List<DangerAction> _dangerActions =
    [
        new("archive", "Archive workspace", "Make this workspace read-only and hide it from the sidebar", "Archive", "All members will lose write access. The workspace can be unarchived later by an admin.", null),
        new("transfer", "Transfer ownership", "Transfer this workspace to another team member", "Transfer", "You will lose owner-level permissions. The new owner will have full control over billing and settings.", null),
        new("delete", "Delete workspace", "Permanently delete this workspace and all its data", "Delete", "All projects, files, and data will be permanently deleted. This action cannot be undone.", "DELETE"),
    ];

    private string? _expanded = null;
    private string _confirmInput = "";
}
