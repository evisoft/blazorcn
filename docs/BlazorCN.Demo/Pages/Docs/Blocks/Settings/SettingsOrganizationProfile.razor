@* ===========================================================
   Block: settings-organization-profile
   Title: Settings Organization Profile
   Description: Company name, logo upload, industry selector, team size, business address
   Dependencies: BadgeCn, ButtonCn, InputCn, SelectCn
   Source: original/blocks/settings/settings-organization-profile.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Organization</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Manage your company profile and billing information
            </p>
        </div>

        @* Logo section *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <div class="flex size-16 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                <LucideBuildingCn Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Company logo</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    SVG, PNG, or JPG. Recommended 256x256px.
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideCameraCn Size="12" Class="size-3" />
                Upload
            </ButtonCn>
        </div>

        @* Company name *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Company name</span>
            <InputCn aria-label="Company name" @bind-Value="_name" Class="h-8 text-sm" />
        </div>

        @* Website *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Website</span>
            <div class="flex items-center gap-2">
                <LucideGlobeCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <InputCn aria-label="Website" @bind-Value="_website" Class="h-8 text-sm" Placeholder="https://example.com" />
            </div>
        </div>

        @* Industry and size *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-4">
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Industry</span>
                <SelectCn @bind-Value="_industry">
                    <SelectTriggerCn aria-label="Industry" Class="h-8 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="saas">SaaS</SelectItemCn>
                        <SelectItemCn Value="ecommerce">E-Commerce</SelectItemCn>
                        <SelectItemCn Value="fintech">Fintech</SelectItemCn>
                        <SelectItemCn Value="healthcare">Healthcare</SelectItemCn>
                        <SelectItemCn Value="education">Education</SelectItemCn>
                        <SelectItemCn Value="other">Other</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Team size</span>
                <SelectCn @bind-Value="_size">
                    <SelectTriggerCn aria-label="Team size" Class="h-8 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="1-10">1-10</SelectItemCn>
                        <SelectItemCn Value="11-50">11-50</SelectItemCn>
                        <SelectItemCn Value="51-200">51-200</SelectItemCn>
                        <SelectItemCn Value="201-1000">201-1000</SelectItemCn>
                        <SelectItemCn Value="1000+">1000+</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Address *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideMapPinCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Business address</span>
            </div>
            <div class="space-y-3">
                <div>
                    <span class="mb-1 block text-muted-foreground text-xs">Street</span>
                    <InputCn aria-label="Street" @bind-Value="_street" Class="h-8 text-sm" />
                </div>
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <span class="mb-1 block text-muted-foreground text-xs">City</span>
                        <InputCn aria-label="City" @bind-Value="_city" Class="h-8 text-sm" />
                    </div>
                    <div>
                        <span class="mb-1 block text-muted-foreground text-xs">State</span>
                        <InputCn aria-label="State" @bind-Value="_state" Class="h-8 text-sm" />
                    </div>
                    <div>
                        <span class="mb-1 block text-muted-foreground text-xs">ZIP code</span>
                        <InputCn aria-label="ZIP code" @bind-Value="_zip" Class="h-8 text-sm" />
                    </div>
                </div>
                <div>
                    <span class="mb-1 block text-muted-foreground text-xs">Country</span>
                    <SelectCn @bind-Value="_country">
                        <SelectTriggerCn aria-label="Country" Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="US">United States</SelectItemCn>
                            <SelectItemCn Value="CA">Canada</SelectItemCn>
                            <SelectItemCn Value="GB">United Kingdom</SelectItemCn>
                            <SelectItemCn Value="DE">Germany</SelectItemCn>
                            <SelectItemCn Value="FR">France</SelectItemCn>
                            <SelectItemCn Value="AU">Australia</SelectItemCn>
                            <SelectItemCn Value="JP">Japan</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Plan info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">Team plan · 12 members · 51-200 employees</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">Pro</BadgeCn>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _name = "Acme Inc.";
    private string _website = "https://acme.com";
    private string _industry = "saas";
    private string _size = "51-200";
    private string _street = "123 Innovation Drive";
    private string _city = "San Francisco";
    private string _state = "CA";
    private string _zip = "94105";
    private string _country = "US";
    private bool _saved = false;
}
