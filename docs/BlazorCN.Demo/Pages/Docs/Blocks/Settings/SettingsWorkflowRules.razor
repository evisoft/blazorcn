@* ===========================================================
   Block: settings-workflow-rules
   Title: Settings Workflow Rules
   Description: Animated React workflow automation rules settings page for Next.js with trigger configuration, condition builder, action mapping, and per-rule enabled toggle using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Branch protection and merge strategies
   Dependencies: ButtonCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-workflow-rules.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Workflow Rules</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Automate actions based on triggers and conditions
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add rule
            </ButtonCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideZapCn Size="12" Class="size-3" />
                @_rules.Count rules
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="font-medium tabular-nums text-foreground">@_rules.Count(r => r.Enabled)</span> active
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="font-medium tabular-nums text-foreground">
                    @_rules.Sum(r => r.ExecutionCount).ToString("N0")
                </span>
                total executions
            </span>
        </div>

        @* Rules *@
        <div>
            @for (var i = 0; i < _rules.Count; i++)
            {
                var rule = _rules[i];
                var ruleId = rule.Id;
                var isExpanded = _expandedRule == rule.Id;
                var isLast = i == _rules.Count - 1;
                var triggerLabel = _triggers.FirstOrDefault(t => t.Value == rule.Trigger)?.Label ?? rule.Trigger;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expandedRule = isExpanded ? null : ruleId"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", rule.Enabled ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@rule.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @triggerLabel &middot; @rule.ExecutionCount runs &middot; @rule.LastTriggered
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            @* Trigger *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Trigger
                                </span>
                                <SelectCn @bind-Value="rule.Trigger">
                                    <SelectTriggerCn Class="h-8 text-xs">
                                        <SelectValueCn />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        @foreach (var t in _triggers)
                                        {
                                            <SelectItemCn Value="@t.Value">@t.Label</SelectItemCn>
                                        }
                                    </SelectContentCn>
                                </SelectCn>
                            </div>

                            @* Conditions *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Conditions
                                </span>
                                <div class="space-y-1.5">
                                    @foreach (var condition in rule.Conditions)
                                    {
                                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                            <span class="text-xs">@condition</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Actions *@
                            <div>
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Actions
                                </span>
                                <div class="space-y-1.5">
                                    @foreach (var action in rule.Actions)
                                    {
                                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                            <LucideZapCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                            <span class="text-xs">@action</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Toggle *@
                            <div class="flex items-center justify-between pt-1">
                                <span class="font-medium text-muted-foreground text-xs">Enabled</span>
                                <SwitchCn @bind-Checked="rule.Enabled" />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expandedRule = "1";
    private bool _saved;

    private record SelectOption(string Value, string Label);

    private static readonly List<SelectOption> _triggers = new()
    {
        new("issue.created", "Issue created"), new("issue.updated", "Issue updated"),
        new("pr.opened", "PR opened"), new("pr.merged", "PR merged"),
        new("deploy.completed", "Deploy completed"), new("user.signup", "User signed up"),
        new("payment.received", "Payment received"),
    };

    private class WorkflowRule
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Trigger { get; set; } = "";
        public List<string> Conditions { get; set; } = new();
        public List<string> Actions { get; set; } = new();
        public bool Enabled { get; set; }
        public string LastTriggered { get; set; } = "";
        public int ExecutionCount { get; set; }
    }

    private readonly List<WorkflowRule> _rules = new()
    {
        new()
        {
            Id = "1", Name = "Auto-assign critical issues", Trigger = "issue.created",
            Conditions = new() { "Priority is Critical", "Label contains 'bug'" },
            Actions = new() { "Assign to on-call engineer", "Post to #incidents Slack channel" },
            Enabled = true, LastTriggered = "3 hours ago", ExecutionCount = 142,
        },
        new()
        {
            Id = "2", Name = "PR review reminder", Trigger = "pr.opened",
            Conditions = new() { "No reviewer assigned after 2 hours" },
            Actions = new() { "Send email to team lead", "Add 'needs-review' label" },
            Enabled = true, LastTriggered = "Yesterday", ExecutionCount = 89,
        },
        new()
        {
            Id = "3", Name = "Deploy notification", Trigger = "deploy.completed",
            Conditions = new() { "Environment is production" },
            Actions = new() { "Post to #releases Slack channel", "Send email to stakeholders" },
            Enabled = true, LastTriggered = "2 days ago", ExecutionCount = 34,
        },
        new()
        {
            Id = "4", Name = "Welcome new user", Trigger = "user.signup",
            Conditions = new() { "Plan is not free trial" },
            Actions = new() { "Send welcome email sequence", "Create onboarding task" },
            Enabled = false, LastTriggered = "1 week ago", ExecutionCount = 567,
        },
    };

    private void HandleSave()
    {
        _saved = true;
        _ = ResetSaved();
    }

    private async Task ResetSaved()
    {
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
