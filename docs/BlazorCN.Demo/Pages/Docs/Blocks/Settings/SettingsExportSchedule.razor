@* ===========================================================
   Block: settings-export-schedule
   Title: Settings Export Schedule
   Description: Scheduled data export settings with format selection, S3 and SFTP destination configuration, frequency controls, and column filters
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideCloudCn, LucideLoaderCircleCn, LucideServerCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-export-schedule.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Export schedule</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Configure automated data exports with format, destination, and filters
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="@($"flex items-center gap-1.5 text-xs {(_enabled ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")}")">
                    <span class="@($"size-1.5 rounded-full {(_enabled ? "bg-emerald-500" : "bg-muted-foreground/40")}")"></span>
                    @(_enabled ? "Active" : "Paused")
                </span>
                <SwitchCn aria-label="Export schedule" @bind-Checked="_enabled" />
            </div>
        </div>

        @* Format and frequency *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Format</span>
                    <SelectCn Value="@_format" ValueChanged="v => _format = v">
                        <SelectTriggerCn aria-label="Export format" Class="h-8 text-sm">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="csv">CSV</SelectItemCn>
                            <SelectItemCn Value="json">JSON</SelectItemCn>
                            <SelectItemCn Value="parquet">Parquet</SelectItemCn>
                            <SelectItemCn Value="xlsx">XLSX</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div>
                    <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Frequency</span>
                    <SelectCn Value="@_frequency" ValueChanged="v => _frequency = v">
                        <SelectTriggerCn aria-label="Export frequency" Class="h-8 text-sm">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="hourly">Hourly</SelectItemCn>
                            <SelectItemCn Value="daily">Daily</SelectItemCn>
                            <SelectItemCn Value="weekly">Weekly</SelectItemCn>
                            <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Destination *@
        <div class="border-b px-4 py-4">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Destination</span>
            <div class="mb-3 flex gap-2">
                <button type="button"
                        class="@($"flex items-center gap-2 rounded-md border px-3 py-2 text-left transition-colors {(_destination == "s3" ? "border-foreground/20 bg-muted/50" : "hover:bg-muted/30")}")"
                        @onclick="@(() => _destination = "s3")">
                    <LucideCloudCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">Amazon S3</p>
                        <p class="text-xs text-muted-foreground">Object storage</p>
                    </div>
                </button>
                <button type="button"
                        class="@($"flex items-center gap-2 rounded-md border px-3 py-2 text-left transition-colors {(_destination == "sftp" ? "border-foreground/20 bg-muted/50" : "hover:bg-muted/30")}")"
                        @onclick="@(() => _destination = "sftp")">
                    <LucideServerCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-sm font-medium">SFTP</p>
                        <p class="text-xs text-muted-foreground">Secure file transfer</p>
                    </div>
                </button>
            </div>

            @if (_destination == "s3")
            {
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Bucket</span>
                            <InputCn aria-label="Bucket" @bind-Value="_bucket" Class="h-8 font-mono text-xs" />
                        </div>
                        <div>
                            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Region</span>
                            <InputCn aria-label="Region" @bind-Value="_region" Class="h-8 font-mono text-xs" />
                        </div>
                    </div>
                    <div>
                        <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Path prefix</span>
                        <InputCn aria-label="Path prefix" @bind-Value="_pathPrefix" Placeholder="exports/" Class="h-8 font-mono text-xs" />
                    </div>
                </div>
            }

            @if (_destination == "sftp")
            {
                <div class="space-y-3">
                    <div>
                        <span class="mb-1.5 block text-xs font-medium text-muted-foreground">SFTP host</span>
                        <InputCn aria-label="SFTP host" @bind-Value="_sftpHost" Class="h-8 font-mono text-xs" />
                    </div>
                    <div>
                        <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Remote path</span>
                        <InputCn aria-label="Remote path" @bind-Value="_sftpPath" Class="h-8 font-mono text-xs" />
                    </div>
                </div>
            }
        </div>

        @* Column filters *@
        <div class="border-b">
            <button type="button"
                    class="flex w-full cursor-pointer items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _showColumns = !_showColumns)">
                <div>
                    <p class="text-sm font-medium">Column filters</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @IncludedCount of @_columns.Count columns included
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showColumns ? "rotate-90" : "")" />
            </button>
            @if (_showColumns)
            {
                @foreach (var col in _columns)
                {
                    var colId = col.Id;
                    <div class="flex items-center justify-between border-t px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm">@col.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                @col.Type
                            </BadgeCn>
                        </div>
                        <SwitchCn aria-label="@col.Name" Checked="@col.Included"
                                  CheckedChanged="@(_ => ToggleColumn(colId))" />
                    </div>
                }
            }
        </div>

        @* Export history *@
        <div>
            <button type="button"
                    class="flex w-full cursor-pointer items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _showHistory = !_showHistory)">
                <div>
                    <p class="text-sm font-medium">Export history</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_recentExports.Length recent exports
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showHistory ? "rotate-90" : "")" />
            </button>
            @if (_showHistory)
            {
                @foreach (var run in _recentExports)
                {
                    <div class="flex items-center gap-3 border-t px-4 py-3">
                        <span class="@($"size-1.5 shrink-0 rounded-full {GetStatusDot(run.Status)}")"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm">@run.Timestamp</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @run.Rows rows &middot; @run.Size
                            </p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@run.Status</span>
                    </div>
                }
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                      Class="h-7 text-xs" Disabled="@_isRunning"
                      @onclick="HandleRunNow">
                @if (_isRunning)
                {
                    <LucideLoaderCircleCn Size="16" Class="mr-1 size-3 animate-spin" />
                    <text>Exporting</text>
                }
                else
                {
                    <text>Export now</text>
                }
            </ButtonCn>
            <div class="flex items-center">
                @if (_saved)
                {
                    <span class="mr-2 flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                        <LucideCheckCn Size="16" Class="size-3" />
                        Saved
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                          @onclick="HandleSave">
                    Save schedule
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private class ExportColumn
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
        public bool Included { get; set; }
    }

    private record ExportRun(string Id, string Status, string Timestamp, string Rows, string Size);

    private bool _enabled = true;
    private string _format = "csv";
    private string _frequency = "daily";
    private string _destination = "s3";
    private string _bucket = "acme-exports-prod";
    private string _region = "us-east-1";
    private string _pathPrefix = "exports/users/";
    private string _sftpHost = "sftp.partner.com";
    private string _sftpPath = "/incoming/acme/";
    private bool _showColumns;
    private bool _showHistory;
    private bool _isRunning;
    private bool _saved;

    private List<ExportColumn> _columns = new()
    {
        new() { Id = "col1", Name = "user_id", Type = "uuid", Included = true },
        new() { Id = "col2", Name = "email", Type = "string", Included = true },
        new() { Id = "col3", Name = "created_at", Type = "timestamp", Included = true },
        new() { Id = "col4", Name = "plan", Type = "enum", Included = true },
        new() { Id = "col5", Name = "mrr", Type = "decimal", Included = true },
        new() { Id = "col6", Name = "last_login", Type = "timestamp", Included = true },
        new() { Id = "col7", Name = "country", Type = "string", Included = false },
        new() { Id = "col8", Name = "referral_source", Type = "string", Included = false },
    };

    private static readonly ExportRun[] _recentExports =
    [
        new("ex1", "success", "Today, 6:00 AM", "48,291", "12.4 MB"),
        new("ex2", "success", "Yesterday, 6:00 AM", "47,832", "12.1 MB"),
        new("ex3", "failed", "Mar 15, 6:00 AM", "\u2014", "\u2014"),
    ];

    private int IncludedCount => _columns.Count(c => c.Included);

    private static string GetStatusDot(string status) => status switch
    {
        "success" => "bg-emerald-500",
        "failed" => "bg-red-500",
        _ => "",
    };

    private void ToggleColumn(string id)
    {
        var col = _columns.FirstOrDefault(c => c.Id == id);
        if (col != null) col.Included = !col.Included;
    }

    private async Task HandleRunNow()
    {
        _isRunning = true;
        StateHasChanged();
        await Task.Delay(2000);
        _isRunning = false;
    }

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
