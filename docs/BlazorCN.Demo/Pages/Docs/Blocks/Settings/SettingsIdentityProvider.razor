@* ===========================================================
   Block: settings-identity-provider
   Title: Settings Identity Provider
   Description: Identity provider settings with OIDC and SAML configuration, issuer URL, client credentials, user attribute mapping, and JIT provisioning toggle
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideFingerprintPatternCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-identity-provider.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFingerprintPatternCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Identity Provider</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Configure enterprise SSO with OIDC or SAML
            </p>
        </div>

        @* Connection status *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-sm">Connected to Okta</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                SSO Active
            </BadgeCn>
        </div>

        @* Protocol *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Protocol</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Authentication protocol for SSO</p>
            </div>
            <SelectCn Value="@_protocol" ValueChanged="v => _protocol = v">
                <SelectTriggerCn aria-label="SSO protocol" Class="h-8 w-40 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="oidc">OpenID Connect</SelectItemCn>
                    <SelectItemCn Value="saml">SAML 2.0</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Issuer URL *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                @(_protocol == "oidc" ? "Issuer URL" : "IdP Metadata URL")
            </span>
            <InputCn aria-label="https://your-idp.com" @bind-Value="_issuerUrl" Placeholder="https://your-idp.com"
                     Class="h-8 font-mono text-sm" />
            <p class="mt-1.5 text-xs text-muted-foreground">
                @(_protocol == "oidc"
                    ? "The OpenID Connect discovery endpoint"
                    : "URL to the SAML metadata XML document")
            </p>
        </div>

        @* Client credentials *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-4">
            <div>
                <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                    Client ID
                </span>
                <InputCn aria-label="Client ID" @bind-Value="_clientId" Class="h-8 font-mono text-sm" />
            </div>
            <div>
                <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                    Client secret
                </span>
                <InputCn aria-label="Client secret" @bind-Value="_clientSecret" Type="password" Class="h-8 font-mono text-sm" />
            </div>
        </div>

        @* JIT provisioning *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Just-in-time provisioning</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Auto-create accounts on first SSO login
                </p>
            </div>
            <SwitchCn aria-label="Just-in-time provisioning" @bind-Checked="_jitProvisioning" />
        </div>

        @* Enforce SSO *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Enforce SSO</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Require SSO for all users, disable password login
                </p>
            </div>
            <SwitchCn aria-label="Enforce SSO" @bind-Checked="_enforceSSO" />
        </div>

        @* Attribute mapping section *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Attribute mapping</p>
        </div>

        @foreach (var mapping in _mappings)
        {
            var mappingId = mapping.Id;
            var isExpanded = _expandedMapping == mapping.Id;
            <div class="border-b">
                <button type="button"
                        class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expandedMapping = isExpanded ? null : mappingId)">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@mapping.AppField</span>
                            <span class="text-xs text-muted-foreground">&larr;</span>
                            <span class="font-mono text-xs text-muted-foreground">
                                @mapping.IdpClaim
                            </span>
                        </div>
                    </div>
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="px-4 pb-3">
                        <div class="rounded-md bg-muted/50 p-3">
                            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                                IdP claim name
                            </span>
                            <InputCn aria-label="IdP claim name" Value="@mapping.IdpClaim"
                                     ValueChanged="@(v => mapping.IdpClaim = v)"
                                     Class="h-8 font-mono text-sm" />
                        </div>
                    </div>
                }
            </div>
        }

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                    <LucideCheckCn Size="16" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                      @onclick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class AttributeMapping
    {
        public string Id { get; set; } = "";
        public string AppField { get; set; } = "";
        public string IdpClaim { get; set; } = "";
    }

    private string _protocol = "oidc";
    private string _issuerUrl = "https://login.acmecorp.com";
    private string _clientId = "acme-dashboard-prod";
    private string _clientSecret = "sk_live_\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022";
    private bool _jitProvisioning = true;
    private bool _enforceSSO;
    private string? _expandedMapping;
    private bool _saved;

    private List<AttributeMapping> _mappings = new()
    {
        new() { Id = "1", AppField = "email", IdpClaim = "email" },
        new() { Id = "2", AppField = "firstName", IdpClaim = "given_name" },
        new() { Id = "3", AppField = "lastName", IdpClaim = "family_name" },
        new() { Id = "4", AppField = "role", IdpClaim = "groups" },
        new() { Id = "5", AppField = "department", IdpClaim = "department" },
    };

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
