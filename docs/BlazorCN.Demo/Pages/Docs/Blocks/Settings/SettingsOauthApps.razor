@* ===========================================================
   Block: settings-oauth-apps
   Title: Settings Oauth Apps
   Description: OAuth app management with client credentials, redirect URIs, scopes, secret rotation
   Dependencies: BadgeCn, ButtonCn, InputCn, SwitchCn
   Source: original/blocks/settings/settings-oauth-apps.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideKeyCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">OAuth Applications</h2>
                        <p class="text-xs text-muted-foreground">
                            @_apps.Count registered application@(_apps.Count != 1 ? "s" : "")
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                    <LucidePlusCn Size="12" Class="size-3" />
                    New App
                </ButtonCn>
            </div>
        </div>

        @* App list *@
        <div>
            @for (var i = 0; i < _apps.Count; i++)
            {
                var app = _apps[i];
                var isLast = i == _apps.Count - 1;
                var isExpanded = _expanded == app.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : app.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", app.Active ? "bg-emerald-500" : "bg-muted-foreground")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@app.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                    @app.Scopes.Length scope@(app.Scopes.Length != 1 ? "s" : "")
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">@app.ClientId</p>
                        </div>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-9">
                                @* Status *@
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-muted-foreground">Active</span>
                                    <SwitchCn Checked="@app.Active" />
                                </div>

                                @* Client ID *@
                                <div class="rounded-md bg-muted/50 p-2.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Client ID</span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1.5 text-[10px]">
                                            @if (_copied == $"{app.Id}-client")
                                            {
                                                <LucideCheckCn Size="10" Class="size-2.5" />
                                                <span>Copied</span>
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="10" Class="size-2.5" />
                                                <span>Copy</span>
                                            }
                                        </ButtonCn>
                                    </div>
                                    <p class="mt-1 truncate font-mono text-xs">@app.ClientId</p>
                                </div>

                                @* Client Secret *@
                                <div class="rounded-md bg-muted/50 p-2.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Client Secret</span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1.5 text-[10px]">
                                            <LucideRefreshCwCn Size="10" Class="size-2.5" />
                                            <span>Rotate</span>
                                        </ButtonCn>
                                    </div>
                                    <p class="mt-1 font-mono text-xs text-muted-foreground">
                                        &bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;
                                    </p>
                                </div>

                                @* Redirect URIs *@
                                <div>
                                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">REDIRECT URIs</p>
                                    <div class="space-y-1">
                                        @foreach (var uri in app.RedirectUris)
                                        {
                                            <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                                                <span class="flex-1 truncate font-mono text-xs">@uri</span>
                                                <button type="button" class="shrink-0 text-muted-foreground/60 transition-colors hover:text-foreground">
                                                    <LucideXCn Size="12" Class="size-3" />
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <div class="mt-1.5 flex items-center gap-1.5">
                                        <InputCn @bind-Value="_newUri" Placeholder="https://example.com/callback" Class="h-7 text-xs" />
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 px-2 text-xs">
                                            Add
                                        </ButtonCn>
                                    </div>
                                </div>

                                @* Scopes *@
                                <div>
                                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">SCOPES</p>
                                    <div class="space-y-1">
                                        @foreach (var scope in _availableScopes)
                                        {
                                            <span class="flex cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-1.5 transition-colors hover:bg-muted/50">
                                                <SwitchCn Checked="@app.Scopes.Contains(scope.Id)" />
                                                <div class="min-w-0 flex-1">
                                                    <span class="font-mono text-xs font-medium">@scope.Label</span>
                                                    <p class="text-xs text-muted-foreground">@scope.Description</p>
                                                </div>
                                            </span>
                                        }
                                    </div>
                                </div>

                                @* Meta + delete *@
                                <div class="flex items-center justify-between pt-1">
                                    <span class="text-xs text-muted-foreground">Created @app.CreatedAt</span>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-xs text-red-600 hover:text-red-600">
                                        <LucideTrash2Cn Size="12" Class="size-3" />
                                        Delete
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_apps.Count == 0)
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No OAuth applications registered. Create one to get started.
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record OAuthScope(string Id, string Label, string Description);
    private record OAuthApp(string Id, string Name, string ClientId, string CreatedAt, string[] RedirectUris, string[] Scopes, bool Active);

    private static readonly List<OAuthScope> _availableScopes =
    [
        new("read:profile", "read:profile", "Read basic user information"),
        new("write:profile", "write:profile", "Modify user profile"),
        new("read:data", "read:data", "Access user content"),
        new("write:data", "write:data", "Create and modify content"),
        new("admin", "admin", "Full administrative access"),
    ];

    private static readonly List<OAuthApp> _apps =
    [
        new("app-1", "Acme Dashboard", "cli_a1b2c3d4e5f6g7h8", "Jan 15, 2026",
            ["https://dashboard.acme.com/callback", "https://staging.acme.com/callback"],
            ["read:profile", "read:data", "write:data"], true),
        new("app-2", "Mobile App", "cli_z9y8x7w6v5u4t3s2", "Feb 28, 2026",
            ["acme://oauth/callback"],
            ["read:profile", "read:data"], true),
        new("app-3", "Internal CI/CD", "cli_m1n2o3p4q5r6s7t8", "Mar 5, 2026",
            ["https://ci.internal.acme.com/auth"],
            ["read:data", "write:data", "admin"], false),
    ];

    private string? _expanded = null;
    private string? _copied = null;
    private string _newUri = "";
}
