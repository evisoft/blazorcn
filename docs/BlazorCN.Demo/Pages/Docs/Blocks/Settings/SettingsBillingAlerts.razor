@* ===========================================================
   Block: settings-billing-alerts
   Title: Settings Billing Alerts
   Description: Animated React billing alert thresholds settings page for Next.js with spend limit configuration, projected overage warnings, alert contacts, and notification preferences using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Email, push, and SMS notification preferences
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-billing-alerts.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Billing alerts</p>
            <p class="mt-0.5 text-muted-foreground text-xs">Set spend limits and configure overage warnings</p>
        </div>

        @* Current spend summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">$3,420</span>
                <span class="text-muted-foreground text-xs">/ $5,000</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">68% used</BadgeCn>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">Mar 2026</span>
            <div class="ml-auto flex items-center gap-1.5">
                <LucideTriangleAlertCn Size="12" Class="size-3 text-amber-500" />
                <span class="text-amber-600 text-xs dark:text-amber-400">+$680 projected</span>
            </div>
        </div>

        @* Projected overage alert *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Projected overage warnings</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Alert when projected spend exceeds budget before period ends</p>
            </div>
            <SwitchCn @bind-Checked="_projectedAlert" />
        </div>

        @* Thresholds *@
        <div class="border-b">
            <div class="px-4 py-3">
                <p class="font-medium text-sm">Alert thresholds</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Receive notifications when spend crosses these limits</p>
            </div>
            @for (var i = 0; i < _thresholds.Count; i++)
            {
                var threshold = _thresholds[i];
                var isLast = i == _thresholds.Count - 1;
                var crossed = 3420 >= threshold.Amount;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", threshold.Type == "critical" ? "bg-red-500" : "bg-amber-500")"></span>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@threshold.Label</span>
                                @if (crossed && threshold.Enabled)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Crossed</BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">$@threshold.Amount.ToString("N0")</p>
                        </div>
                    </div>
                    <SwitchCn Checked="threshold.Enabled" CheckedChanged="() => threshold.Enabled = !threshold.Enabled" />
                </div>
            }
        </div>

        @* Alert contacts *@
        <div>
            <button type="button" @onclick="() => _showContacts = !_showContacts"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <div>
                    <p class="font-medium text-sm">Alert contacts</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_contacts.Count(c => c.Enabled) of @_contacts.Count contacts receiving alerts
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showContacts ? "rotate-90" : "")" />
            </button>
            @if (_showContacts)
            {
                @foreach (var contact in _contacts)
                {
                    <div class="flex items-center gap-3 border-t px-4 py-3">
                        <LucideMailCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="font-medium text-sm">@contact.Name</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">@contact.Email</p>
                        </div>
                        <SwitchCn Checked="contact.Enabled" CheckedChanged="() => contact.Enabled = !contact.Enabled" />
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-1.5 text-red-600 dark:text-red-400" OnClick="() => _contacts.Remove(contact)">
                            <LucideTrashCn Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
                <div class="border-t px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucidePlusCn Size="12" Class="size-3" />
                        Add contact
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            @if (_saved)
            {
                <span class="mr-2 flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _saved = true">
                Save alerts
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _showContacts;
    private bool _projectedAlert = true;
    private bool _saved;

    private class AlertThreshold
    {
        public string Label { get; set; } = "";
        public int Amount { get; set; }
        public string Type { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class AlertContact
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private readonly List<AlertThreshold> _thresholds =
    [
        new() { Label = "50% of budget", Amount = 2500, Type = "warning", Enabled = true },
        new() { Label = "75% of budget", Amount = 3750, Type = "warning", Enabled = true },
        new() { Label = "90% of budget", Amount = 4500, Type = "critical", Enabled = true },
        new() { Label = "100% of budget", Amount = 5000, Type = "critical", Enabled = true },
        new() { Label = "Custom overage limit", Amount = 6000, Type = "critical", Enabled = false },
    ];

    private readonly List<AlertContact> _contacts =
    [
        new() { Name = "Sarah Chen", Email = "sarah@acme.com", Enabled = true },
        new() { Name = "James Rivera", Email = "james@acme.com", Enabled = true },
        new() { Name = "Billing Team", Email = "billing@acme.com", Enabled = false },
    ];
}
