@* ===========================================================
   Block: settings-account-deletion
   Title: Settings Account Deletion
   Description: React animated account deletion settings block for Next.js with multi-step confirmation, data download, cooldown period countdown, and reason selection using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Backup scheduling and restore options
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/settings/settings-account-deletion.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldAlertCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Delete Account</h2>
                    <p class="text-xs text-muted-foreground">
                        Permanently remove your account and all associated data
                    </p>
                </div>
            </div>
        </div>

        @if (_isDeleted)
        {
            @* Cooldown state *@
            <div class="px-4 py-6">
                <div class="rounded-md bg-muted/50 p-4 text-center">
                    <span class="mx-auto mb-3 flex size-8 items-center justify-center rounded-full bg-amber-500/10">
                        <LucideTriangleAlertCn Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                    </span>
                    <p class="text-sm font-medium">Deletion scheduled</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your account will be permanently deleted in @CooldownDays days. Log in during
                        this period to cancel.
                    </p>
                    <div class="mt-3 flex items-center justify-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">
                            @CooldownDays days remaining
                        </BadgeCn>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="HandleCancelDeletion">
                        Cancel deletion
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            @* Step indicators *@
            <div class="border-b px-4 py-2">
                <div class="flex items-center gap-2">
                    @for (var i = 0; i < _stepLabels.Length; i++)
                    {
                        var idx = i;
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-[10px] font-medium", idx == _step ? "bg-primary text-primary-foreground" : idx < _step ? "bg-muted text-foreground" : "bg-muted/50 text-muted-foreground")">
                                @if (idx < _step)
                                {
                                    <LucideCheckCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    @(idx + 1)
                                }
                            </span>
                            <span class="@Cn.Merge("text-xs", idx == _step ? "font-medium" : "text-muted-foreground")">
                                @_stepLabels[idx]
                            </span>
                            @if (idx < 2)
                            {
                                <LucideChevronRightCn Size="12" Class="size-3 text-muted-foreground/40" />
                            }
                        </div>
                    }
                </div>
            </div>

            @* Step 0: Reason *@
            @if (_step == 0)
            {
                <div class="px-4 py-3">
                    <p class="mb-3 text-xs font-medium text-muted-foreground">
                        WHY ARE YOU LEAVING?
                    </p>
                    <div class="space-y-1">
                        @foreach (var reason in _reasons)
                        {
                            <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50", _selectedReason == reason.Id ? "bg-muted/50" : "")">
                                <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", _selectedReason == reason.Id ? "border-primary bg-primary" : "border-muted-foreground/30")">
                                    @if (_selectedReason == reason.Id)
                                    {
                                        <span class="size-1.5 rounded-full bg-primary-foreground"></span>
                                    }
                                </span>
                                <input type="radio" name="reason" value="@reason.Id" checked="@(_selectedReason == reason.Id)" @onchange="() => _selectedReason = reason.Id" class="sr-only" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@reason.Label</span>
                                    <p class="text-xs text-muted-foreground">@reason.Description</p>
                                </div>
                            </label>
                        }
                    </div>
                    <div class="mt-4 flex justify-end">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" Disabled="@(_selectedReason == null)" OnClick="() => _step = 1">
                            Continue
                            <LucideChevronRightCn Size="12" Class="ml-1 size-3" />
                        </ButtonCn>
                    </div>
                </div>
            }

            @* Step 1: Download data *@
            @if (_step == 1)
            {
                <div class="px-4 py-3">
                    <p class="mb-3 text-xs font-medium text-muted-foreground">
                        DOWNLOAD YOUR DATA
                    </p>
                    <div class="rounded-md border p-3">
                        <div class="flex items-start gap-3">
                            <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                            <div class="flex-1">
                                <p class="text-sm font-medium">Export a copy of your data</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    Download all your posts, files, settings, and account information before
                                    deletion. The export will be available as a ZIP archive.
                                </p>
                                <div class="mt-3 flex items-center gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs" OnClick="HandleDownloadData">
                                        <LucideDownloadCn Size="12" Class="size-3" />
                                        @(_dataDownloaded ? "Requested" : "Download data")
                                    </ButtonCn>
                                    @if (_dataDownloaded)
                                    {
                                        <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                                            <LucideCheckCn Size="12" Class="size-3" />
                                            Export started
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 flex items-center justify-between">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs" OnClick="() => _step = 0">
                            Back
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="() => _step = 2">
                            Continue
                            <LucideChevronRightCn Size="12" Class="ml-1 size-3" />
                        </ButtonCn>
                    </div>
                </div>
            }

            @* Step 2: Confirm *@
            @if (_step == 2)
            {
                <div class="px-4 py-3">
                    <div class="rounded-md bg-red-500/5 p-3">
                        <div class="flex items-start gap-2">
                            <LucideTriangleAlertCn Size="16" Class="mt-0.5 size-4 shrink-0 text-red-600 dark:text-red-400" />
                            <div class="flex-1">
                                <p class="text-sm font-medium text-red-600 dark:text-red-400">
                                    This action is irreversible
                                </p>
                                <p class="mt-1 text-xs text-muted-foreground">
                                    After the @CooldownDays-day cooldown period, all your data will be
                                    permanently deleted. This includes your profile, content, settings, and
                                    billing history.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="mb-2 text-xs text-muted-foreground">
                            Type <span class="font-mono font-medium text-foreground">DELETE</span> to
                            confirm
                        </p>
                        <InputCn @bind-Value="_confirmText" placeholder="Type DELETE to confirm" Class="h-8 font-mono text-sm" />
                    </div>
                    <div class="mt-4 flex items-center justify-between">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs" OnClick="() => _step = 1">
                            Back
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs text-red-600 hover:text-red-600" Disabled="@(_confirmText != "DELETE")" OnClick="HandleConfirmDelete">
                            <LucideXCn Size="12" Class="mr-1 size-3" />
                            Delete my account
                        </ButtonCn>
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    private const int CooldownDays = 14;

    private int _step;
    private string? _selectedReason;
    private string _confirmText = "";
    private bool _isDeleted;
    private bool _dataDownloaded;

    private readonly string[] _stepLabels = ["Reason", "Download", "Confirm"];

    private record DeletionReason(string Id, string Label, string Description);

    private static readonly DeletionReason[] _reasons =
    [
        new("not-using", "Not using the product", "I no longer need this service"),
        new("too-expensive", "Too expensive", "The pricing does not fit my budget"),
        new("found-alternative", "Found an alternative", "I switched to a different product"),
        new("privacy", "Privacy concerns", "I want my data removed"),
        new("other", "Other reason", "Something else not listed here"),
    ];

    private void HandleConfirmDelete()
    {
        if (_confirmText == "DELETE")
            _isDeleted = true;
    }

    private void HandleCancelDeletion()
    {
        _isDeleted = false;
        _step = 0;
        _selectedReason = null;
        _confirmText = "";
    }

    private void HandleDownloadData() => _dataDownloaded = true;
}
