@* ===========================================================
   Block: settings-onboarding-flow
   Title: Settings Onboarding Flow
   Description: Step management, required/optional markers, completion tracking, drag-to-reorder
   Dependencies: BadgeCn, ButtonCn, SwitchCn
   Source: original/blocks/settings/settings-onboarding-flow.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Onboarding Flow</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure the steps new users see when they sign up
            </p>
        </div>

        @* Summary stats *@
        @{
            var enabledSteps = _steps.Where(s => s.Enabled).ToList();
            var requiredSteps = enabledSteps.Where(s => s.Required).ToList();
            var avgCompletion = enabledSteps.Count > 0
                ? (int)Math.Round(enabledSteps.Average(s => s.CompletionRate))
                : 0;
        }
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@enabledSteps.Count</span>
                <span class="text-muted-foreground text-xs">steps</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@requiredSteps.Count required</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@avgCompletion% avg. completion</span>
        </div>

        @* Steps list *@
        <div class="border-b">
            @for (var i = 0; i < _steps.Count; i++)
            {
                var step = _steps[i];
                var isLast = i == _steps.Count - 1;
                var isExpanded = _expanded == step.Id;
                var rateColorClass = step.CompletionRate >= 80
                    ? "text-emerald-600 dark:text-emerald-400"
                    : step.CompletionRate >= 50
                        ? "text-amber-600 dark:text-amber-400"
                        : "text-red-600 dark:text-red-400";
                var barColorClass = step.CompletionRate >= 80
                    ? "bg-emerald-500"
                    : step.CompletionRate >= 50
                        ? "bg-amber-500"
                        : "bg-red-500";
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : step.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideGripVerticalCn Class="size-4 shrink-0 cursor-grab text-muted-foreground/40" />
                        <div class="flex size-5 shrink-0 items-center justify-center">
                            @if (step.Enabled)
                            {
                                <LucideCircleCheckBigCn Size="16" Class="@Cn.Merge("size-4", step.Required ? "text-foreground" : "text-muted-foreground")" />
                            }
                            else
                            {
                                <LucideCircleDotCn Class="size-4 text-muted-foreground/40" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", !step.Enabled ? "text-muted-foreground" : "")">
                                    @step.Title
                                </span>
                                @if (step.Required && step.Enabled)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Required</BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @(step.CompletionRate)%
                        </span>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-16">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="font-medium text-sm">Completion rate</p>
                                            <p class="mt-0.5 text-muted-foreground text-xs">
                                                Percentage of users who completed this step
                                            </p>
                                        </div>
                                        <span class="@Cn.Merge("font-semibold text-lg tabular-nums", rateColorClass)">
                                            @(step.CompletionRate)%
                                        </span>
                                    </div>
                                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                                        <div class="@Cn.Merge("h-full rounded-full", barColorClass)" style="width: @(step.CompletionRate)%"></div>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideToggleLeftCn Size="16" Class="size-4 text-muted-foreground" />
                                        <span class="text-sm">Enabled</span>
                                    </div>
                                    <SwitchCn aria-label="Enabled" Checked="@step.Enabled" />
                                </div>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideCircleCheckBigCn Size="16" Class="size-4 text-muted-foreground" />
                                        <span class="text-sm">Required</span>
                                    </div>
                                    <SwitchCn aria-label="Required" Checked="@step.Required" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Add step *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add step
            </ButtonCn>
            <span class="text-muted-foreground text-xs">Drag to reorder steps</span>
        </div>

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OnboardingStep(string Id, string Title, string Description, bool Required, bool Enabled, int CompletionRate);

    private static readonly List<OnboardingStep> _steps =
    [
        new("welcome", "Welcome screen", "Introduce the product and set expectations", true, true, 98),
        new("profile", "Complete profile", "Name, avatar, and role selection", true, true, 94),
        new("workspace", "Create workspace", "Set up team workspace and invite members", true, true, 87),
        new("integrations", "Connect integrations", "Link GitHub, Slack, or Jira accounts", false, true, 62),
        new("template", "Choose a template", "Start from a pre-built project template", false, true, 71),
        new("tour", "Product tour", "Interactive walkthrough of key features", false, false, 45),
    ];

    private string? _expanded = "workspace";
    private bool _saved = false;
}
