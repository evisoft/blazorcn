@* ===========================================================
   Block: settings-git-connection
   Title: Settings Git Connection
   Description: Git connection settings with provider selection, repository URL, branch config, deploy key management, and auto-deploy toggle
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn, LucideGitBranchCn, LucideKeyCn, LucideLinkCn, SelectCn, SwitchCn
   Source: original/blocks/settings/settings-git-connection.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGitBranchCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Git Connection</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Connect your repository for automated deployments
            </p>
        </div>

        @* Provider *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Git provider</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Source code hosting platform</p>
            </div>
            <SelectCn Value="@_provider" ValueChanged="v => _provider = v">
                <SelectTriggerCn aria-label="Git provider" Class="h-8 w-40 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="github">GitHub</SelectItemCn>
                    <SelectItemCn Value="gitlab">GitLab</SelectItemCn>
                    <SelectItemCn Value="bitbucket">Bitbucket</SelectItemCn>
                    <SelectItemCn Value="azure-devops">Azure DevOps</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Repository URL *@
        <div class="border-b px-4 py-4">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                Repository URL
            </span>
            <div class="flex items-center gap-2">
                <LucideLinkCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground" />
                <InputCn aria-label="Repository URL" @bind-Value="_repoUrl" Placeholder="https://github.com/org/repo"
                         Class="h-8 font-mono text-sm" />
            </div>
        </div>

        @* Default branch *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Default branch</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Branch used for production deployments
                </p>
            </div>
            <SelectCn Value="@_branch" ValueChanged="v => _branch = v">
                <SelectTriggerCn aria-label="Default branch" Class="h-8 w-36 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="main">main</SelectItemCn>
                    <SelectItemCn Value="master">master</SelectItemCn>
                    <SelectItemCn Value="develop">develop</SelectItemCn>
                    <SelectItemCn Value="production">production</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Auto deploy *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Auto deploy</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Automatically deploy on push to the default branch
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_autoDeploy)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                        Active
                    </BadgeCn>
                }
                <SwitchCn aria-label="Auto deploy" @bind-Checked="_autoDeploy" />
            </div>
        </div>

        @* Webhook *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            <div>
                <p class="text-sm font-medium">Webhook notifications</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Receive push and PR events from your repository
                </p>
            </div>
            <SwitchCn aria-label="Webhook notifications" @bind-Checked="_webhookEnabled" />
        </div>

        @* Deploy keys section label *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs font-medium text-muted-foreground">Deploy keys</p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucideKeyCn Size="16" Class="size-3" />
                    Add key
                </ButtonCn>
            </div>
        </div>

        @* Deploy keys list *@
        @foreach (var key in _deployKeys)
        {
            var keyId = key.Id;
            var isExpanded = _expandedKey == key.Id;
            <div class="border-b">
                <button type="button"
                        class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expandedKey = isExpanded ? null : keyId)">
                    <LucideKeyCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@key.Name</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">Added @key.AddedAt</p>
                    </div>
                    @if (key.ReadOnly)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                            Read-only
                        </BadgeCn>
                    }
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="px-4 pb-3 pl-11">
                        <div class="rounded-md bg-muted/50 p-3">
                            <div class="flex items-center justify-between">
                                <span class="font-mono text-xs text-muted-foreground">
                                    @key.Fingerprint
                                </span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="h-6 gap-1 px-2 text-xs"
                                          @onclick="@(() => HandleCopy(keyId))">
                                    @if (_copied == keyId)
                                    {
                                        <LucideCheckCn Size="16" Class="size-3" />
                                        <text>Copied</text>
                                    }
                                    else
                                    {
                                        <LucideCopyCn Size="16" Class="size-3" />
                                        <text>Copy</text>
                                    }
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Save *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
                    <LucideCheckCn Size="16" Class="size-3" />
                    Saved
                </span>
            }
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                      @onclick="HandleSave">
                Save changes
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DeployKey(string Id, string Name, string Fingerprint, string AddedAt, bool ReadOnly);

    private string _provider = "github";
    private string _repoUrl = "https://github.com/acme/dashboard";
    private string _branch = "main";
    private bool _autoDeploy = true;
    private bool _webhookEnabled = true;
    private string? _expandedKey;
    private string? _copied;
    private bool _saved;

    private static readonly DeployKey[] _deployKeys =
    [
        new("1", "Production deploy", "SHA256:nThbg6kXUpJ...w0HUz", "12 days ago", true),
        new("2", "CI/CD pipeline", "SHA256:p2QAMX0sPt...k9qR1", "3 months ago", true),
    ];

    private async Task HandleCopy(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
