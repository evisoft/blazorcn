@* ========================================
   Block: dialog-quick-transfer
   Title: Dialog Quick Transfer
   Description: Quick transfer dialog with recent contacts, amount input, and instant send for banking apps
   Dependencies: AvatarCn, AvatarFallbackCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideCheckCn, LucideLoaderCn, LucideSendCn
   Source: original/blocks/dialog/dialog-quick-transfer.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideSendCn Class="mr-2 h-4 w-4" Size="16" />
                Quick Transfer
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_sent)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Transfer Sent</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    $@_amount to @(SelectedContact?.Name)
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Send Money</DialogTitleCn>
                <DialogDescriptionCn>Select a contact and enter amount</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                @* Recent contacts *@
                <div class="space-y-2">
                    <p class="text-sm text-muted-foreground">Recent</p>
                    <div class="grid grid-cols-4 gap-2">
                        @foreach (var contact in _recentContacts)
                        {
                            <button type="button"
                                    class="@Cn.Merge("flex flex-col items-center gap-1.5 p-2 rounded-md transition-colors", _selected == contact.Id ? "bg-primary/5" : "hover:bg-muted")"
                                    @onclick="@(() => _selected = contact.Id)">
                                <AvatarCn Class="@Cn.Merge("h-10 w-10 border-2 transition-colors", _selected == contact.Id ? "border-primary" : "border-transparent")">
                                    <AvatarFallbackCn Class="text-xs">@contact.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs truncate w-full text-center">@contact.Name</span>
                            </button>
                        }
                    </div>
                </div>

                @* Amount input *@
                <div class="space-y-2">
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground">$</span>
                        <InputCn Class="pl-8 text-xl h-12 text-center" Type="number" Placeholder="0.00"
                                 Value="@_amount" ValueChanged="@(v => _amount = v)" />
                    </div>
                    <div class="flex justify-center gap-2">
                        @foreach (var preset in new[] { "25", "50", "100" })
                        {
                            <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                                      @onclick="@(() => _amount = preset)">
                                $@preset
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!CanSend || _sending)" @onclick="HandleSend">
                    @if (_sending)
                    {
                        <LucideLoaderCn Class="h-4 w-4 animate-spin" Size="16" />
                    }
                    else
                    {
                        <LucideSendCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Send</span>
                    }
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record Contact(string Id, string Name, string Initials);

    private static readonly Contact[] _recentContacts =
    [
        new("1", "Alex M.", "AM"),
        new("2", "Sarah K.", "SK"),
        new("3", "Mike R.", "MR"),
        new("4", "Emma L.", "EL")
    ];

    private bool _open;
    private string? _selected;
    private string _amount = "";
    private bool _sending;
    private bool _sent;

    private Contact? SelectedContact => _recentContacts.FirstOrDefault(c => c.Id == _selected);
    private bool CanSend => _selected is not null && !string.IsNullOrEmpty(_amount);

    private async Task HandleSend()
    {
        if (!CanSend) return;
        _sending = true;
        StateHasChanged();
        await Task.Delay(1500);
        _sending = false;
        _sent = true;
    }

    private void HandleClose()
    {
        _open = false;
        _selected = null;
        _amount = "";
        _sending = false;
        _sent = false;
    }
}
