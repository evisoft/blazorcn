@* ========================================
   Block: dialog-qr-scanner
   Title: Dialog QR Scanner
   Description: QR code scanner dialog with camera viewfinder, manual code input, scan history, and action handling for URLs and text
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCameraCn, LucideCheckCn, LucideClockCn, LucideCopyCn, LucideExternalLinkCn, LucideFileTextCn, LucideKeyboardCn, LucideLinkCn, LucideQrCodeCn, LucideScanLineCn, LucideTrash2Cn, LucideXCn, ScrollAreaCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/dialog/dialog-qr-scanner.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideQrCodeCn Class="mr-2 h-4 w-4" Size="16" />
                Scan QR Code
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideQrCodeCn Class="h-5 w-5" Size="20" />
                QR Code Scanner
            </DialogTitleCn>
            <DialogDescriptionCn>Scan a QR code with your camera or enter it manually.</DialogDescriptionCn>
        </DialogHeaderCn>

        @if (_scanResult is not null)
        {
            <div class="space-y-4 py-4">
                <div class="rounded-lg border p-4">
                    <div class="flex items-start gap-3">
                        <div class="@Cn.Merge("flex h-10 w-10 items-center justify-center rounded-full shrink-0", _scanResult.Type == "url" ? "bg-primary/10" : "bg-muted")">
                            @if (_scanResult.Type == "url")
                            {
                                <LucideLinkCn Class="h-5 w-5 text-primary" Size="20" />
                            }
                            else
                            {
                                <LucideFileTextCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                    @(_scanResult.Type == "url" ? "URL" : "Text")
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">@FormatTimestamp(_scanResult.Timestamp)</span>
                            </div>
                            <p class="text-sm font-mono break-all">@_scanResult.Content</p>
                        </div>
                    </div>
                </div>

                <div class="flex gap-2">
                    <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline" @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideCheckCn Class="mr-2 h-4 w-4 text-primary" Size="16" />
                            <span>Copied!</span>
                        }
                        else
                        {
                            <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                    @if (_scanResult.Type == "url")
                    {
                        <ButtonCn Class="flex-1">
                            <LucideExternalLinkCn Class="mr-2 h-4 w-4" Size="16" />
                            Open URL
                        </ButtonCn>
                    }
                </div>

                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline" @onclick="@(() => _scanResult = null)">
                    Scan Another
                </ButtonCn>
            </div>
        }
        else
        {
            <TabsCn DefaultValue="camera" Class="w-full">
                <TabsListCn Class="grid w-full grid-cols-3">
                    <TabsTriggerCn Value="camera">
                        <LucideCameraCn Class="mr-2 h-4 w-4" Size="16" />
                        Camera
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="manual">
                        <LucideKeyboardCn Class="mr-2 h-4 w-4" Size="16" />
                        Manual
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="history">
                        <LucideClockCn Class="mr-2 h-4 w-4" Size="16" />
                        History
                    </TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Class="space-y-4 mt-4" Value="camera">
                    <div class="relative aspect-square w-full rounded-lg border-2 border-dashed bg-muted/30 overflow-hidden">
                        @if (_isScanning)
                        {
                            <div class="absolute inset-8 border-2 border-primary rounded-lg"></div>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <LucideScanLineCn Class="h-12 w-12 text-primary animate-pulse" Size="48" />
                            </div>
                            <ButtonCn Class="absolute bottom-4 right-4" Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary"
                                      @onclick="@(() => _isScanning = false)">
                                <LucideXCn Class="mr-2 h-4 w-4" Size="16" />
                                Cancel
                            </ButtonCn>
                        }
                        else
                        {
                            <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
                                <LucideQrCodeCn Class="h-12 w-12 text-muted-foreground" Size="48" />
                                <p class="text-sm text-muted-foreground text-center px-4">
                                    Position the QR code within the frame to scan
                                </p>
                                <ButtonCn @onclick="StartScanning">
                                    <LucideCameraCn Class="mr-2 h-4 w-4" Size="16" />
                                    Start Scanning
                                </ButtonCn>
                            </div>
                        }
                    </div>
                    <p class="text-xs text-center text-muted-foreground">Camera access is required for scanning</p>
                </TabsContentCn>

                <TabsContentCn Class="space-y-4 mt-4" Value="manual">
                    <div class="space-y-2">
                        <LabelCn For="manual-code">Enter code manually</LabelCn>
                        <InputCn Id="manual-code" Placeholder="Paste or type the code content..."
                                 Value="@_manualInput" ValueChanged="@(v => _manualInput = v)" />
                        <p class="text-xs text-muted-foreground">Enter the URL or text content from the QR code</p>
                    </div>
                    <ButtonCn Class="w-full" Disabled="@(string.IsNullOrWhiteSpace(_manualInput))" @onclick="HandleManualSubmit">
                        Submit Code
                    </ButtonCn>
                </TabsContentCn>

                <TabsContentCn Class="mt-4" Value="history">
                    @if (_history.Count > 0)
                    {
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium">Recent Scans</span>
                            <ButtonCn Class="h-6 text-xs text-destructive hover:text-destructive" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                      @onclick="@(() => _history.Clear())">
                                <LucideTrash2Cn Class="mr-1 h-3 w-3" Size="12" />
                                Clear
                            </ButtonCn>
                        </div>
                        <ScrollAreaCn Class="h-[200px]">
                            <div class="space-y-2">
                                @foreach (var item in _history)
                                {
                                    <button type="button"
                                            class="w-full rounded-lg border p-3 text-left hover:bg-muted/50 transition-colors"
                                            @onclick="@(() => _scanResult = item)">
                                        <div class="flex items-center gap-2 mb-1">
                                            @if (item.Type == "url")
                                            {
                                                <LucideLinkCn Class="h-3 w-3 text-primary" Size="12" />
                                            }
                                            else
                                            {
                                                <LucideFileTextCn Class="h-3 w-3 text-muted-foreground" Size="12" />
                                            }
                                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@item.Type</BadgeCn>
                                            <span class="text-xs text-muted-foreground ml-auto">@FormatTimestamp(item.Timestamp)</span>
                                        </div>
                                        <p class="text-sm truncate font-mono">@item.Content</p>
                                    </button>
                                }
                            </div>
                        </ScrollAreaCn>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-center">
                            <LucideClockCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                            <p class="text-sm font-medium">No scan history</p>
                            <p class="text-xs text-muted-foreground">Your recent scans will appear here</p>
                        </div>
                    }
                </TabsContentCn>
            </TabsCn>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record ScanResult(string Id, string Content, string Type, DateTime Timestamp);

    private bool _open;
    private bool _isScanning;
    private string _manualInput = "";
    private ScanResult? _scanResult;
    private List<ScanResult> _history =
    [
        new("1", "https://example.com/product/12345", "url", DateTime.Now.AddMinutes(-5)),
        new("2", "WIFI:T:WPA;S:MyNetwork;P:password123;;", "text", DateTime.Now.AddHours(-1)),
        new("3", "https://docs.example.com/guide", "url", DateTime.Now.AddDays(-1))
    ];
    private bool _copied;

    private static string DetectContentType(string content)
    {
        if (Uri.TryCreate(content, UriKind.Absolute, out var uri) && (uri.Scheme == "http" || uri.Scheme == "https"))
            return "url";
        return "text";
    }

    private static string FormatTimestamp(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private async Task StartScanning()
    {
        _isScanning = true;
        StateHasChanged();
        await Task.Delay(2000);
        var content = $"https://example.com/scanned-code-{Guid.NewGuid().ToString("N")[..6]}";
        HandleScanComplete(content);
    }

    private void HandleScanComplete(string content)
    {
        _isScanning = false;
        var result = new ScanResult(Guid.NewGuid().ToString("N")[..8], content, DetectContentType(content), DateTime.Now);
        _scanResult = result;
        _history.Insert(0, result);
        if (_history.Count > 10) _history.RemoveRange(10, _history.Count - 10);
    }

    private void HandleManualSubmit()
    {
        if (string.IsNullOrWhiteSpace(_manualInput)) return;
        HandleScanComplete(_manualInput.Trim());
        _manualInput = "";
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }

    private void HandleClose()
    {
        _open = false;
        _scanResult = null;
        _manualInput = "";
        _isScanning = false;
        _copied = false;
    }
}
