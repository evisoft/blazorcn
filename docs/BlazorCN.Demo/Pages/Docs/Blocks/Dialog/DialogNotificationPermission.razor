@* ========================================
   Block: dialog-notification-permission
   Title: Dialog Notification Permission
   Description: Notification permission dialog with benefit explanation, enable/skip options, and browser permission handling
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideBellCn, LucideBellRingCn, LucideCalendarCn, LucideCheckCn, LucideMessageSquareCn, LucideShieldCn, LucideTrendingUpCn, LucideXCn, SeparatorCn
   Source: original/blocks/dialog/dialog-notification-permission.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideBellCn Class="mr-2 h-4 w-4" Size="16" />
                Enable Notifications
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_permissionState == "granted")
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <h3 class="mt-4 text-lg font-semibold">Notifications Enabled</h3>
                <p class="mt-2 text-sm text-muted-foreground">You'll now receive notifications to stay up to date.</p>
                <p class="mt-4 text-xs text-muted-foreground">You can manage your notification preferences in Settings at any time.</p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Got it</ButtonCn>
            </div>
        }
        else if (_permissionState == "denied")
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border">
                    <LucideXCn Class="h-6 w-6 text-muted-foreground" Size="24" />
                </div>
                <h3 class="mt-4 text-lg font-semibold">Notifications Blocked</h3>
                <p class="mt-2 text-sm text-muted-foreground">You've blocked notifications in your browser settings.</p>
                <div class="mt-4 rounded-lg border p-4 text-left w-full">
                    <p class="text-sm font-medium">To enable notifications:</p>
                    <ol class="mt-2 text-xs text-muted-foreground space-y-1 list-decimal list-inside">
                        <li>Click the lock icon in your browser's address bar</li>
                        <li>Find "Notifications" in the permissions</li>
                        <li>Change the setting to "Allow"</li>
                        <li>Refresh this page</li>
                    </ol>
                </div>
                <ButtonCn Class="mt-6" Variant="ButtonVariant.Outline" @onclick="HandleClose">Close</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn Class="text-center">
                <div class="flex justify-center mb-2">
                    <div class="relative">
                        <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary">
                            <LucideBellRingCn Class="h-6 w-6 text-primary" Size="24" />
                        </div>
                        <span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] text-primary-foreground">
                            3
                        </span>
                    </div>
                </div>
                <DialogTitleCn>Stay in the loop</DialogTitleCn>
                <DialogDescriptionCn>Enable notifications to never miss important updates</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                @* Benefits *@
                <div class="space-y-3">
                    <div class="flex items-start gap-3 rounded-lg border p-3">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border">
                            <LucideMessageSquareCn Class="h-4 w-4" Size="16" />
                        </div>
                        <div>
                            <p class="text-sm font-medium">Instant Messages</p>
                            <p class="text-xs text-muted-foreground">Get notified when someone sends you a message</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 rounded-lg border p-3">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border">
                            <LucideCalendarCn Class="h-4 w-4" Size="16" />
                        </div>
                        <div>
                            <p class="text-sm font-medium">Reminders</p>
                            <p class="text-xs text-muted-foreground">Never miss important deadlines or events</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 rounded-lg border p-3">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border">
                            <LucideTrendingUpCn Class="h-4 w-4" Size="16" />
                        </div>
                        <div>
                            <p class="text-sm font-medium">Updates</p>
                            <p class="text-xs text-muted-foreground">Stay informed about activity that matters to you</p>
                        </div>
                    </div>
                </div>

                @* Example Notification *@
                <div class="space-y-2">
                    <p class="text-xs text-muted-foreground text-center">Example notification</p>
                    <div class="rounded-lg border p-3 flex items-start gap-3">
                        <div class="h-8 w-8 rounded-md bg-primary/10 flex items-center justify-center shrink-0">
                            <LucideBellCn Class="h-4 w-4 text-primary" Size="16" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">New Message</p>
                                <BadgeCn Class="text-[10px]" Variant="BadgeVariant.Secondary">now</BadgeCn>
                            </div>
                            <p class="text-xs text-muted-foreground truncate">Sarah commented on your post: "This looks great!"</p>
                        </div>
                    </div>
                </div>

                <SeparatorCn />

                @* Privacy Note *@
                <div class="flex items-start gap-2 text-xs text-muted-foreground">
                    <LucideShieldCn Class="h-4 w-4 shrink-0 mt-0.5" Size="16" />
                    <p>We respect your privacy. You can customize or disable notifications anytime in Settings.</p>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <ButtonCn Class="w-full" Disabled="@_isRequesting" @onclick="HandleEnableNotifications">
                    @if (_isRequesting)
                    {
                        <LucideBellCn Class="mr-2 h-4 w-4 animate-pulse" Size="16" />
                        @:Requesting...
                    }
                    else
                    {
                        <LucideBellCn Class="mr-2 h-4 w-4" Size="16" />
                        @:Enable Notifications
                    }
                </ButtonCn>
                <ButtonCn Class="w-full" Disabled="@_isRequesting" Variant="ButtonVariant.Ghost" @onclick="@(() => _open = false)">
                    Maybe later
                </ButtonCn>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isRequesting;
    private string? _permissionState;

    private async Task HandleEnableNotifications()
    {
        _isRequesting = true;
        StateHasChanged();
        await Task.Delay(1000);
        _permissionState = "granted";
        _isRequesting = false;
    }

    private void HandleClose()
    {
        _open = false;
        _permissionState = null;
    }
}
