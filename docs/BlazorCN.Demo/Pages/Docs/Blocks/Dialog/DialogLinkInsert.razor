@* ========================================
   Block: dialog-link-insert
   Title: Dialog Link Insert
   Description: Insert or edit hyperlink dialog with URL validation, link text, and target options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideAlertCircleCn, LucideCheckCn, LucideExternalLinkCn, LucideGlobeCn, LucideLinkCn, LucideLoader2Cn, LucideMousePointerClickCn, LucideTypeCn, SeparatorCn, SwitchCn
   Source: original/blocks/dialog/dialog-link-insert.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideLinkCn Class="mr-2 h-4 w-4" Size="16" />
                Insert Link
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideLinkCn Class="h-5 w-5" Size="20" />
                Insert Link
            </DialogTitleCn>
            <DialogDescriptionCn>Add a hyperlink to your content.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* URL Input *@
            <div class="space-y-2">
                <LabelCn Class="flex items-center gap-2" For="url">
                    <LucideGlobeCn Class="h-3.5 w-3.5 text-muted-foreground" Size="14" />
                    URL
                </LabelCn>
                <InputCn Class="@Cn.Merge(!string.IsNullOrEmpty(_urlError) ? "border-destructive" : "")"
                         id="url" Placeholder="https://example.com" type="url"
                         Value="@_url" ValueChanged="@(v => { _url = v; ValidateUrl(); })" />
                @if (!string.IsNullOrEmpty(_urlError))
                {
                    <p class="text-xs text-destructive flex items-center gap-1">
                        <LucideCircleAlertCn Class="h-3 w-3" Size="12" />
                        @_urlError
                    </p>
                }
            </div>

            @* Link Text *@
            <div class="space-y-2">
                <LabelCn Class="flex items-center gap-2" For="text">
                    <LucideTypeCn Class="h-3.5 w-3.5 text-muted-foreground" Size="14" />
                    Link Text
                </LabelCn>
                <InputCn id="text" Placeholder="Click here (optional)" Value="@_linkText" ValueChanged="@(v => _linkText = v)" />
                <p class="text-xs text-muted-foreground">Leave empty to use the URL as link text</p>
            </div>

            <SeparatorCn />

            @* Options *@
            <div class="space-y-3">
                <LabelCn Class="text-sm font-medium">Options</LabelCn>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideExternalLinkCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <div>
                            <p class="text-sm">Open in new tab</p>
                            <p class="text-xs text-muted-foreground">Adds target=&quot;_blank&quot;</p>
                        </div>
                    </div>
                    <SwitchCn @bind-Checked="_openInNewTab" />
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideMousePointerClickCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <div>
                            <p class="text-sm">Add nofollow</p>
                            <p class="text-xs text-muted-foreground">Adds rel=&quot;nofollow&quot;</p>
                        </div>
                    </div>
                    <SwitchCn @bind-Checked="_addNoFollow" />
                </div>
            </div>

            @* Preview *@
            @if (!string.IsNullOrEmpty(_url) && IsValidUrl)
            {
                <SeparatorCn />
                <div class="space-y-2">
                    <LabelCn Class="text-sm font-medium">Preview</LabelCn>
                    <div class="rounded-lg border p-3">
                        <a class="text-primary hover:underline inline-flex items-center gap-1" href="#"
                           @onclick:preventDefault>
                            @(string.IsNullOrEmpty(_linkText) ? DisplayUrl : _linkText)
                            @if (_openInNewTab)
                            {
                                <LucideExternalLinkCn Class="h-3 w-3" Size="12" />
                            }
                        </a>
                        <p class="text-xs text-muted-foreground mt-1 truncate">@DisplayUrl</p>
                    </div>
                </div>
            }
        </div>

        <DialogFooterCn>
            <ButtonCn Disabled="@_isInserting" Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@(string.IsNullOrEmpty(_url) || !IsValidUrl || _isInserting)" @onclick="HandleInsert">
                @if (_isInserting)
                {
                    <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    @:Inserting...
                }
                else
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    @:Insert Link
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _url = "";
    private string _linkText = "";
    private bool _openInNewTab = true;
    private bool _addNoFollow;
    private bool _isInserting;
    private string _urlError = "";

    private bool IsValidUrl =>
        System.Text.RegularExpressions.Regex.IsMatch(_url, @"^(https?:\/\/)?([\da-z.-]+)\.([a-z.]{2,6})([/\w .-]*)*\/?$") ||
        _url.StartsWith("mailto:") || _url.StartsWith("tel:");

    private string DisplayUrl
    {
        get
        {
            if (string.IsNullOrEmpty(_url)) return "";
            if (_url.StartsWith("http://") || _url.StartsWith("https://") ||
                _url.StartsWith("mailto:") || _url.StartsWith("tel:"))
                return _url;
            return $"https://{_url}";
        }
    }

    private void ValidateUrl()
    {
        _urlError = !string.IsNullOrEmpty(_url) && !IsValidUrl ? "Please enter a valid URL" : "";
    }

    private async Task HandleInsert()
    {
        if (string.IsNullOrEmpty(_url) || !IsValidUrl) return;

        _isInserting = true;
        StateHasChanged();
        await Task.Delay(800);
        _isInserting = false;
        _open = false;
        _url = "";
        _linkText = "";
        _openInNewTab = true;
        _addNoFollow = false;
    }
}
