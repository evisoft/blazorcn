@* ========================================
   Block: dialog-schedule-meeting
   Title: Dialog Schedule Meeting
   Description: Meeting scheduler dialog with date picker, time selector, attendees input, location field, and description textarea
   Dependencies: ButtonCn, CalendarCn, DialogCn, DialogCloseCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCalendarCn, PopoverCn, PopoverContentCn, PopoverTriggerCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, TextareaCn
   Source: original/blocks/dialog/dialog-schedule-meeting.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-default cn-button-size-default" data-variant="default" data-size="default">Schedule Meeting</DialogTriggerCn>
    </div>
    <DialogContentCn Class="p-0 sm:max-w-lg gap-0">
        <DialogHeaderCn Class="border-b px-6 py-4 pt-5">
            <DialogTitleCn>Schedule a Meeting</DialogTitleCn>
        </DialogHeaderCn>

        <form action="#" method="POST">
            <div class="space-y-6 p-6">
                <div class="space-y-2">
                    <LabelCn For="title">Meeting Title</LabelCn>
                    <InputCn Id="title" Placeholder="e.g., Project Kickoff" />
                </div>

                <div class="space-y-2">
                    <LabelCn For="attendees">Attendees</LabelCn>
                    <InputCn Id="attendees" Placeholder="user1@example.com, user2@example.com" />
                    <p class="text-xs text-muted-foreground">
                        Enter email addresses separated by commas.
                    </p>
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <div class="space-y-2 col-span-2">
                        <LabelCn For="date">Date</LabelCn>
                        <PopoverCn>
                            <PopoverTriggerCn
                                Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0", "cn-button-variant-outline cn-button-size-default", "w-full justify-start text-left font-normal", _date == null ? "text-muted-foreground" : "")"
                                Id="date"
                                data-variant="outline" data-size="default">
                                <LucideCalendarCn Class="mr-1 h-4 w-4 shrink-0" Size="16" />
                                @(_date?.ToString("MMMM d, yyyy") ?? "Pick a date")
                            </PopoverTriggerCn>
                            <PopoverContentCn Align="FloatingAlign.Start" Class="w-auto p-0">
                                <CalendarCn Value="@_date" ValueChanged="@((DateTime? d) => _date = d)" />
                            </PopoverContentCn>
                        </PopoverCn>
                    </div>

                    <div class="space-y-2">
                        <LabelCn For="time">Time</LabelCn>
                        <SelectCn Value="@_startTime" ValueChanged="@(v => _startTime = v)">
                            <SelectTriggerCn Class="w-full" Id="time">
                                <SelectValueCn Placeholder="Select time" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var option in _timeOptions)
                                {
                                    <SelectItemCn Value="@option.Value">@option.Label</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="location">Location / Conference Link</LabelCn>
                    <InputCn Id="location" Placeholder="e.g., Conference Room B or https://meet.example.com/..." />
                </div>

                <div class="space-y-2">
                    <LabelCn For="description">Description</LabelCn>
                    <TextareaCn Class="min-h-[100px]" Id="description" Placeholder="Optional: Add an agenda or notes..." />
                </div>
            </div>

            <div class="flex items-center justify-end border-t p-4 space-x-2">
                <DialogCloseCn>
                    <ButtonCn Type="button" Variant="ButtonVariant.Ghost">
                        Cancel
                    </ButtonCn>
                </DialogCloseCn>
                <ButtonCn Size="ButtonSize.Sm" Type="submit">
                    Schedule
                </ButtonCn>
            </div>
        </form>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private DateTime? _date = DateTime.Today;
    private string _startTime = "09:00";

    private record TimeOption(string Value, string Label);

    private static readonly TimeOption[] _timeOptions = GenerateTimeOptions();

    private static TimeOption[] GenerateTimeOptions()
    {
        var options = new List<TimeOption>();
        for (var hour = 0; hour <= 23; hour++)
        {
            for (var minute = 0; minute < 60; minute += 30)
            {
                var value = $"{hour:D2}:{minute:D2}";
                var time = new DateTime(2000, 1, 1, hour, minute, 0);
                var label = time.ToString("h:mm tt");
                options.Add(new TimeOption(value, label));
            }
        }

        if (!options.Exists(o => o.Value == "23:59"))
        {
            var endOfDay = new DateTime(2000, 1, 1, 23, 59, 0);
            options.Add(new TimeOption("23:59", endOfDay.ToString("h:mm tt")));
        }

        return options.ToArray();
    }
}
