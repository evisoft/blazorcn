@* ========================================
   Block: dialog-save-draft
   Title: Dialog Save Draft
   Description: Save draft dialog with auto-save status, manual save option, version history, and discard changes
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideLoader2Cn, LucideSaveCn
   Source: original/blocks/dialog/dialog-save-draft.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideSaveCn Class="mr-2 h-4 w-4" Size="16" />
                Save Draft
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        @if (_saved)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-semibold">Draft Saved</h3>
                <p class="mt-2 text-sm text-muted-foreground">Your changes have been saved.</p>
                <ButtonCn Class="mt-6" @onclick="HandleDone">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Save Draft</DialogTitleCn>
                <DialogDescriptionCn>You have unsaved changes.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4">
                <div class="flex items-center justify-between rounded-lg border p-3">
                    <div>
                        <p class="text-sm font-medium">Untitled Document</p>
                        <p class="text-xs text-muted-foreground">Last saved 5 min ago</p>
                    </div>
                    <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        History
                    </ButtonCn>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn @onclick="HandleDiscard" Variant="ButtonVariant.Outline">
                    Discard
                </ButtonCn>
                <ButtonCn Disabled="@_isSaving" @onclick="HandleSave">
                    @if (_isSaving)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save</span>
                    }
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _saved;
    private bool _isSaving;

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isSaving = false;
        _saved = true;
    }

    private void HandleDiscard()
    {
        _open = false;
        _saved = false;
    }

    private void HandleDone()
    {
        _open = false;
        _saved = false;
    }
}
