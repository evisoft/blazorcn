@* ========================================
   Block: dialog-language-switch
   Title: Dialog Language Switch
   Description: Language switch dialog with locale selector, flag icons, and translation progress
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideGlobeCn
   Source: original/blocks/dialog/dialog-language-switch.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideGlobeCn Class="mr-2 h-4 w-4" Size="16" />
                @(_languages.FirstOrDefault(l => l.Code == _selected)?.Native ?? "Language")
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_saved)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Language Changed</h3>
                <p class="mt-1 text-sm text-muted-foreground">Now using @(_languages.FirstOrDefault(l => l.Code == _selected)?.Native)</p>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Select Language</DialogTitleCn>
                <DialogDescriptionCn>Choose your preferred language</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 grid grid-cols-2 gap-2">
                @foreach (var lang in _languages)
                {
                    <button type="button"
                            class="@Cn.Merge("flex items-center justify-between p-3 rounded-md border text-left transition-colors", _selected == lang.Code ? "border-primary bg-primary/5" : "hover:border-muted-foreground/50")"
                            @onclick="@(() => HandleSelect(lang.Code))">
                        <div>
                            <p class="text-sm font-medium">@lang.Native</p>
                            <p class="text-xs text-muted-foreground">@lang.Name</p>
                        </div>
                        @if (_selected == lang.Code)
                        {
                            <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                        }
                    </button>
                }
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record LanguageOption(string Code, string Name, string Native);

    private static readonly LanguageOption[] _languages =
    [
        new("en", "English", "English"), new("es", "Spanish", "Espa\u00f1ol"),
        new("fr", "French", "Fran\u00e7ais"), new("de", "German", "Deutsch"),
        new("pt", "Portuguese", "Portugu\u00eas"), new("ja", "Japanese", "\u65e5\u672c\u8a9e"),
        new("zh", "Chinese", "\u4e2d\u6587"), new("ko", "Korean", "\ud55c\uad6d\uc5b4"),
    ];

    private bool _open;
    private string _selected = "en";
    private bool _saved;

    private async Task HandleSelect(string code)
    {
        _selected = code;
        _saved = true;
        StateHasChanged();
        await Task.Delay(600);
        _open = false;
        await Task.Delay(200);
        _saved = false;
    }
}
