@* ========================================
   Block: dialog-emergency-contact
   Title: Dialog Emergency Contact
   Description: Emergency contact dialog with contact details form, relationship selector, priority order, and medical information fields
   Dependencies: AlertCn, AlertDescriptionCn, ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideHeartCn, LucideMailCn, LucidePhoneCn, LucideShieldCn, LucideTriangleAlertCn, LucideUserCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, TextareaCn
   Source: original/blocks/dialog/dialog-emergency-contact.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideHeartCn Class="mr-2 h-4 w-4" Size="16" />
                Add Emergency Contact
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        @if (_saved)
        {
            <DialogHeaderCn class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Contact Added</DialogTitleCn>
                <DialogDescriptionCn>
                    @_fullName has been added as your @(GetPriorityLabel().ToLowerInvariant()) (@(GetRelationshipLabel().ToLowerInvariant())).
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="py-4">
                <div class="rounded-lg border p-4 space-y-2">
                    <div class="flex items-center gap-2">
                        <LucideUserCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="font-medium">@_fullName</span>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-muted-foreground">
                        <LucidePhoneCn Class="h-4 w-4" Size="16" />
                        <span>@_phone</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_email))
                    {
                        <div class="flex items-center gap-2 text-sm text-muted-foreground">
                            <LucideMailCn Class="h-4 w-4" Size="16" />
                            <span>@_email</span>
                        </div>
                    }
                    @if (_canMakeDecisions)
                    {
                        <div class="flex items-center gap-2 text-sm text-primary">
                            <LucideShieldCn Class="h-4 w-4" Size="16" />
                            <span>Authorized for medical decisions</span>
                        </div>
                    }
                </div>
            </div>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn class="flex items-center gap-2">
                    <LucideHeartCn Class="h-5 w-5" Size="20" />
                    Emergency Contact
                </DialogTitleCn>
                <DialogDescriptionCn>
                    Add someone who can be contacted in case of emergency.
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <AlertCn>
                    <LucideTriangleAlertCn Class="h-4 w-4" Size="16" />
                    <AlertDescriptionCn>
                        This information may be shared with emergency services if needed.
                    </AlertDescriptionCn>
                </AlertCn>

                <div class="space-y-2">
                    <LabelCn For="fullName">Full Name *</LabelCn>
                    <div class="relative">
                        <LucideUserCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9" id="fullName" Placeholder="Contact's full name" @bind-Value="_fullName" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-2">
                        <LabelCn For="relationship">Relationship *</LabelCn>
                        <SelectCn Value="@_relationship" ValueChanged="@((string v) => _relationship = v)">
                            <SelectTriggerCn id="relationship">
                                <SelectValueCn Placeholder="Select" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var rel in _relationships)
                                {
                                    <SelectItemCn Value="@rel.Value">@rel.Label</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="priority">Priority *</LabelCn>
                        <SelectCn Value="@_priority" ValueChanged="@((string v) => _priority = v)">
                            <SelectTriggerCn id="priority">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var p in _priorities)
                                {
                                    <SelectItemCn Value="@p.Value">@p.Label</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="phone">Phone Number *</LabelCn>
                    <div class="relative">
                        <LucidePhoneCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9" id="phone" Placeholder="(555) 123-4567" type="tel" @bind-Value="_phone" />
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="email">Email (optional)</LabelCn>
                    <div class="relative">
                        <LucideMailCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9" id="email" Placeholder="contact@example.com" type="email" @bind-Value="_email" />
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="medicalNotes">Medical Notes (optional)</LabelCn>
                    <TextareaCn Class="h-16 resize-none" id="medicalNotes" Placeholder="Allergies, conditions, medications..." @bind-Value="_medicalNotes" />
                </div>

                <div class="flex items-start space-x-3 pt-2">
                    <CheckboxCn Checked="_canMakeDecisions" CheckedChanged="@((bool v) => _canMakeDecisions = v)" id="canMakeDecisions" />
                    <div class="space-y-1">
                        <LabelCn Class="text-sm font-normal cursor-pointer" For="canMakeDecisions">
                            Authorize for medical decisions
                        </LabelCn>
                        <p class="text-xs text-muted-foreground">
                            This person can make medical decisions on your behalf if you're unable to.
                        </p>
                    </div>
                </div>
            </div>

            <DialogFooterCn class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">
                    Cancel
                </ButtonCn>
                <ButtonCn Disabled="@(!IsValid)" @onclick="HandleSave">
                    Save Contact
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record RelOption(string Value, string Label);
    private record PriorityOption(string Value, string Label, string Description);

    private static readonly RelOption[] _relationships =
    [
        new("spouse", "Spouse / Partner"),
        new("parent", "Parent"),
        new("sibling", "Sibling"),
        new("child", "Child"),
        new("friend", "Friend"),
        new("relative", "Other Relative"),
        new("doctor", "Doctor / Physician"),
        new("other", "Other"),
    ];

    private static readonly PriorityOption[] _priorities =
    [
        new("primary", "Primary Contact", "Called first in emergencies"),
        new("secondary", "Secondary Contact", "Called if primary unavailable"),
        new("tertiary", "Additional Contact", "Backup contact option"),
    ];

    private bool _open;
    private bool _saved;
    private string _fullName = "";
    private string _phone = "";
    private string _email = "";
    private string _relationship = "";
    private string _priority = "primary";
    private string _medicalNotes = "";
    private bool _canMakeDecisions;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_fullName) &&
        _phone.Length >= 10 &&
        !string.IsNullOrEmpty(_relationship);

    private string GetRelationshipLabel() =>
        _relationships.FirstOrDefault(r => r.Value == _relationship)?.Label ?? "";

    private string GetPriorityLabel() =>
        _priorities.FirstOrDefault(p => p.Value == _priority)?.Label ?? "";

    private void HandleSave()
    {
        _saved = true;
    }

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _fullName = "";
        _phone = "";
        _email = "";
        _relationship = "";
        _priority = "primary";
        _medicalNotes = "";
        _canMakeDecisions = false;
    }
}
