@* ========================================
   Block: dialog-team-roles
   Title: Dialog Team Roles
   Description: Team role assignment dialog with member selection, role dropdown, permission preview, and bulk assignment options
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCheckCn, LucideCrownCn, LucideEyeCn, LucidePencilLineCn, LucideShieldCn, ScrollAreaCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/dialog/dialog-team-roles.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideShieldCn Class="mr-2 h-4 w-4" Size="16" />
                Manage Roles
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_saved)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Roles Updated</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    @_selectedMembers.Count member@(_selectedMembers.Count != 1 ? "s" : "") assigned as @(CurrentRoleInfo?.Name).
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Assign Roles</DialogTitleCn>
                <DialogDescriptionCn>Select members and assign a role.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                @* Members *@
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn Class="text-sm">Members</LabelCn>
                        <button
                            type="button"
                            class="text-xs text-muted-foreground hover:text-foreground"
                            @onclick="SelectAll">
                            @(_selectedMembers.Count == _teamMembers.Length ? "Deselect all" : "Select all")
                        </button>
                    </div>
                    <ScrollAreaCn Class="h-[160px]">
                        <div class="space-y-1">
                            @foreach (var member in _teamMembers)
                            {
                                <div
                                    class="flex items-center gap-2 rounded-lg p-2 hover:bg-muted/50 cursor-pointer"
                                    @onclick="@(() => ToggleMember(member.Id))">
                                    <CheckboxCn
                                        Checked="@_selectedMembers.Contains(member.Id)"
                                        CheckedChanged="@(() => ToggleMember(member.Id))" />
                                    <AvatarCn Class="h-7 w-7">
                                        <AvatarImageCn Src="@member.Avatar" Alt="@member.Name" />
                                        <AvatarFallbackCn Class="text-xs">
                                            @GetInitials(member.Name)
                                        </AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm truncate">@member.Name</p>
                                    </div>
                                    <span class="text-xs text-muted-foreground capitalize">
                                        @member.Role
                                    </span>
                                </div>
                            }
                        </div>
                    </ScrollAreaCn>
                </div>

                @* Role Select *@
                <div class="space-y-2">
                    <LabelCn Class="text-sm">New Role</LabelCn>
                    <SelectCn Value="@_selectedRole" ValueChanged="@(v => _selectedRole = v)">
                        <SelectTriggerCn>
                            <SelectValueCn Placeholder="Select role" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var role in _roles)
                            {
                                <SelectItemCn Value="@role.Id">
                                    <div class="flex items-center gap-2">
                                        @switch (role.Icon)
                                        {
                                            case "crown":
                                                <LucideCrownCn Class="h-4 w-4" Size="16" />
                                                break;
                                            case "edit":
                                                <LucidePencilLineCn Class="h-4 w-4" Size="16" />
                                                break;
                                            case "eye":
                                                <LucideEyeCn Class="h-4 w-4" Size="16" />
                                                break;
                                        }
                                        <span>@role.Name</span>
                                        <span class="text-muted-foreground">&mdash; @role.Description</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">
                    Cancel
                </ButtonCn>
                <ButtonCn Disabled="@(_selectedMembers.Count == 0 || string.IsNullOrEmpty(_selectedRole))" @onclick="HandleSave">
                    Update @(_selectedMembers.Count > 0 ? $"({_selectedMembers.Count})" : "")
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private List<string> _selectedMembers = new();
    private string _selectedRole = "";
    private bool _saved;

    private record TeamMember(string Id, string Name, string Email, string Avatar, string Role);
    private record RoleData(string Id, string Name, string Icon, string Description, string[] Permissions);

    private static readonly TeamMember[] _teamMembers =
    [
        new("1", "Alex Morgan", "alex@company.com", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&auto=format&fit=crop", "editor"),
        new("2", "Jordan Lee", "jordan@company.com", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&auto=format&fit=crop", "viewer"),
        new("3", "Sam Taylor", "sam@company.com", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&auto=format&fit=crop", "viewer"),
        new("4", "Casey Kim", "casey@company.com", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&auto=format&fit=crop", "editor")
    ];

    private static readonly RoleData[] _roles =
    [
        new("admin", "Admin", "crown", "Full access to all features", ["Manage team", "Edit content", "View analytics", "Billing access"]),
        new("editor", "Editor", "edit", "Can edit and publish content", ["Edit content", "View analytics", "Comment"]),
        new("viewer", "Viewer", "eye", "Read-only access", ["View content", "Comment"])
    ];

    private RoleData? CurrentRoleInfo => _roles.FirstOrDefault(r => r.Id == _selectedRole);

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0]));

    private void ToggleMember(string memberId)
    {
        if (_selectedMembers.Contains(memberId))
            _selectedMembers.Remove(memberId);
        else
            _selectedMembers.Add(memberId);
    }

    private void SelectAll()
    {
        if (_selectedMembers.Count == _teamMembers.Length)
            _selectedMembers.Clear();
        else
            _selectedMembers = _teamMembers.Select(m => m.Id).ToList();
    }

    private void HandleSave() => _saved = true;

    private void HandleClose()
    {
        _open = false;
        _selectedMembers.Clear();
        _selectedRole = "";
        _saved = false;
    }
}
