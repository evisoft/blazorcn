@* ========================================
   Block: dialog-card-swipe
   Title: Dialog Card Swipe
   Description: Card swipe dialog with like/pass actions, undo option, and match notification for discovery apps
   Dependencies: AvatarCn, AvatarFallbackCn, ButtonCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideBriefcaseCn, LucideHeartCn, LucideMapPinCn, LucideRotateCcwCn, LucideXCn
   Source: original/blocks/dialog/dialog-card-swipe.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideHeartCn Class="mr-2 h-4 w-4" Size="16" />
                Discover
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="p-0 overflow-hidden gap-0" style="max-width: 320px;">
        <DialogTitleCn Class="sr-only">Discover People</DialogTitleCn>

        @if (_matched)
        {
            <div class="flex flex-col items-center justify-center py-10 px-6 text-center">
                <div class="flex -space-x-3">
                    <div class="rounded-full bg-gradient-to-br from-primary/20 to-primary/5 p-1">
                        <AvatarCn Class="h-16 w-16 border-2 border-background">
                            <AvatarFallbackCn>You</AvatarFallbackCn>
                        </AvatarCn>
                    </div>
                    <div class="rounded-full bg-gradient-to-br from-primary/20 to-primary/5 p-1">
                        <AvatarCn Class="h-16 w-16 border-2 border-background">
                            <AvatarFallbackCn>@_cards[_currentIndex].Initials</AvatarFallbackCn>
                        </AvatarCn>
                    </div>
                </div>
                <h3 class="mt-4 text-xl font-semibold">It's a Match!</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    You and @_cards[_currentIndex].Name liked each other
                </p>
                <div class="flex gap-2 mt-6 w-full">
                    <ButtonCn Class="flex-1" @onclick="@(() => { _matched = false; _history.Add(_currentIndex); _currentIndex++; })" Variant="ButtonVariant.Outline">
                        Continue
                    </ButtonCn>
                    <ButtonCn Class="flex-1" @onclick="HandleClose">Message</ButtonCn>
                </div>
            </div>
        }
        else if (HasCards)
        {
            @* Card *@
            <div class="@Cn.Merge("p-6 transition-all duration-200", _action == "like" ? "bg-primary/5" : "", _action == "pass" ? "opacity-50" : "")">
                <div class="flex flex-col items-center text-center">
                    <div class="rounded-full border-2 border-border p-1">
                        <AvatarCn Class="h-32 w-32">
                            <AvatarFallbackCn Class="text-4xl">@CurrentCard.Initials</AvatarFallbackCn>
                        </AvatarCn>
                    </div>
                    <h3 class="mt-4 text-xl font-semibold">@CurrentCard.Name, @CurrentCard.Age</h3>
                    <div class="mt-2 flex flex-col gap-1">
                        <div class="flex items-center justify-center gap-1.5 text-sm text-muted-foreground">
                            <LucideBriefcaseCn Class="h-3.5 w-3.5" Size="14" />
                            @CurrentCard.Job
                        </div>
                        <div class="flex items-center justify-center gap-1.5 text-sm text-muted-foreground">
                            <LucideMapPinCn Class="h-3.5 w-3.5" Size="14" />
                            @CurrentCard.Location
                        </div>
                    </div>
                </div>

                @* Card counter *@
                <div class="flex justify-center gap-1 mt-4">
                    @for (var i = 0; i < _cards.Length; i++)
                    {
                        <div class="@Cn.Merge("h-1 w-6 rounded-full transition-colors", i == _currentIndex ? "bg-primary" : "bg-muted")"></div>
                    }
                </div>
            </div>

            @* Actions *@
            <div class="flex items-center justify-center gap-4 p-4 border-t">
                <ButtonCn Class="h-14 w-14 rounded-full" @onclick="@(() => HandleAction("pass"))" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                    <LucideXCn Class="h-6 w-6" Size="24" />
                </ButtonCn>
                <ButtonCn Class="h-10 w-10 rounded-full" Disabled="@(_history.Count == 0)" @onclick="HandleUndo" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideRotateCcwCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
                <ButtonCn Class="h-14 w-14 rounded-full" @onclick="@(() => HandleAction("like"))" Size="ButtonSize.Icon">
                    <LucideHeartCn Class="h-6 w-6" Size="24" />
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-12 px-6 text-center">
                <LucideHeartCn Class="h-10 w-10 text-muted-foreground" Size="40" />
                <h3 class="mt-4 text-lg font-medium">No more profiles</h3>
                <p class="mt-1 text-sm text-muted-foreground">Check back later for more</p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private int _currentIndex;
    private string? _action;
    private bool _matched;
    private List<int> _history = [];

    private record CardData(int Id, string Name, int Age, string Location, string Job, string Initials);

    private static readonly CardData[] _cards =
    [
        new(1, "Alex", 28, "San Francisco", "Product Designer", "AL"),
        new(2, "Jordan", 25, "New York", "Software Engineer", "JO"),
        new(3, "Sam", 30, "Los Angeles", "Photographer", "SA"),
    ];

    private CardData CurrentCard => _cards[_currentIndex];
    private bool HasCards => _currentIndex < _cards.Length;

    private async void HandleAction(string type)
    {
        _action = type;
        StateHasChanged();
        await Task.Delay(200);

        if (type == "like" && _currentIndex == 1)
        {
            _matched = true;
        }
        else
        {
            _history.Add(_currentIndex);
            _currentIndex++;
        }
        _action = null;
        StateHasChanged();
    }

    private void HandleUndo()
    {
        if (_history.Count == 0) return;
        _currentIndex = _history[^1];
        _history.RemoveAt(_history.Count - 1);
    }

    private void HandleClose()
    {
        _open = false;
        _currentIndex = 0;
        _history.Clear();
        _matched = false;
        _action = null;
    }
}
