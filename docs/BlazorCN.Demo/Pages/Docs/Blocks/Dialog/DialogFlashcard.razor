@* ========================================
   Block: dialog-flashcard
   Title: Dialog Flashcard
   Description: Flashcard study dialog with flip animation, progress tracking, shuffle mode, and mastery marking
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideBookOpenCn, LucideBrainCn, LucideCheckCn, LucideChevronLeftCn, LucideChevronRightCn, LucideRotateCcwCn, LucideShuffleCn, LucideSparklesCn, LucideXCn, ProgressCn
   Source: original/blocks/dialog/dialog-flashcard.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideBookOpenCn Class="mr-2 h-4 w-4" Size="16" />
                Study Flashcards
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideBookOpenCn Class="h-5 w-5" Size="20" />
                    Flashcards
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" title="Shuffle" @onclick="HandleShuffle">
                        <LucideShuffleCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" title="Reset" @onclick="HandleReset">
                        <LucideRotateCcwCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </div>
            </DialogTitleCn>
            <DialogDescriptionCn>Click the card to flip. Use arrow keys to navigate.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary">
                        @(_currentIndex + 1) / @ActiveCards.Count
                    </BadgeCn>
                </div>
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <LucideSparklesCn Class="h-4 w-4" Size="16" />
                    <span>@MasteredCount mastered</span>
                </div>
            </div>

            <ProgressCn Class="h-2" Value="@Progress" />

            @if (AllMastered)
            {
                <div class="flex flex-col items-center py-8 text-center">
                    <div class="rounded-full bg-primary/10 p-4 mb-4">
                        <LucideBrainCn Class="h-8 w-8 text-primary" Size="32" />
                    </div>
                    <h3 class="text-lg font-semibold">All cards mastered!</h3>
                    <p class="text-sm text-muted-foreground mt-1">Great job! You've learned all the cards.</p>
                    <div class="flex gap-2 mt-4">
                        <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleReset">
                            <LucideRotateCcwCn Class="mr-2 h-4 w-4" Size="16" />
                            Start Over
                        </ButtonCn>
                    </div>
                </div>
            }
            else if (ActiveCards.Count == 0)
            {
                <div class="flex flex-col items-center py-8 text-center">
                    <p class="text-sm text-muted-foreground">No cards to review.</p>
                </div>
            }
            else
            {
                <div class="relative h-48 cursor-pointer" @onclick="HandleFlip" role="button" tabindex="0">
                    <div style="@($"transform-style: preserve-3d; transform: rotateY({(_isFlipped ? 180 : 0)}deg); transition: transform 0.5s;")"
                         class="absolute inset-0">
                        @* Front *@
                        <div class="absolute inset-0 rounded-lg border bg-card p-6 flex flex-col items-center justify-center text-center"
                             style="backface-visibility: hidden;">
                            <BadgeCn Class="mb-3" Variant="BadgeVariant.Outline">Question</BadgeCn>
                            <p class="text-lg font-medium">@CurrentCard?.Front</p>
                            <p class="text-xs text-muted-foreground mt-4">Click to reveal answer</p>
                        </div>

                        @* Back *@
                        <div class="absolute inset-0 rounded-lg border bg-primary/5 p-6 flex flex-col items-center justify-center text-center"
                             style="backface-visibility: hidden; transform: rotateY(180deg);">
                            <BadgeCn Class="mb-3">Answer</BadgeCn>
                            <p class="text-lg">@CurrentCard?.Back</p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <ButtonCn Disabled="@(ActiveCards.Count <= 1)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="HandlePrevious">
                        <LucideChevronLeftCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>

                    <div class="flex gap-2">
                        <ButtonCn Class="text-destructive hover:text-destructive" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="@(() => HandleMarkMastered(false))">
                            <LucideXCn Class="mr-1 h-4 w-4" Size="16" />
                            Still Learning
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" @onclick="@(() => HandleMarkMastered(true))">
                            <LucideCheckCn Class="mr-1 h-4 w-4" Size="16" />
                            Mastered
                        </ButtonCn>
                    </div>

                    <ButtonCn Disabled="@(ActiveCards.Count <= 1)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="HandleNext">
                        <LucideChevronRightCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </div>

                <p class="text-xs text-center text-muted-foreground">
                    Press Space to flip &middot; Arrow keys to navigate
                </p>
            }
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private class Flashcard
    {
        public string Id { get; set; } = "";
        public string Front { get; set; } = "";
        public string Back { get; set; } = "";
        public bool Mastered { get; set; }
    }

    private static Flashcard[] CreateInitialCards() =>
    [
        new() { Id = "1", Front = "What is React?", Back = "A JavaScript library for building user interfaces" },
        new() { Id = "2", Front = "What is JSX?", Back = "A syntax extension that allows writing HTML-like code in JavaScript" },
        new() { Id = "3", Front = "What is a Hook?", Back = "Functions that let you use state and other React features in functional components" },
        new() { Id = "4", Front = "What is useState?", Back = "A Hook that lets you add state to functional components" },
        new() { Id = "5", Front = "What is useEffect?", Back = "A Hook for performing side effects in functional components" },
        new() { Id = "6", Front = "What is a Component?", Back = "A reusable piece of UI that can have its own state and logic" },
    ];

    private bool _open;
    private List<Flashcard> _cards = new(CreateInitialCards());
    private int _currentIndex;
    private bool _isFlipped;

    private List<Flashcard> ActiveCards => _cards.Where(c => !c.Mastered).ToList();
    private Flashcard? CurrentCard => ActiveCards.Count > _currentIndex ? ActiveCards[_currentIndex] : null;
    private int MasteredCount => _cards.Count(c => c.Mastered);
    private int Progress => (int)((double)MasteredCount / _cards.Count * 100);
    private bool AllMastered => MasteredCount == _cards.Count;

    private void HandleFlip() => _isFlipped = !_isFlipped;

    private void HandleNext()
    {
        _isFlipped = false;
        _currentIndex = (_currentIndex + 1) % ActiveCards.Count;
    }

    private void HandlePrevious()
    {
        _isFlipped = false;
        _currentIndex = (_currentIndex - 1 + ActiveCards.Count) % ActiveCards.Count;
    }

    private void HandleShuffle()
    {
        var rng = new Random();
        _cards = _cards.OrderBy(_ => rng.Next()).ToList();
        _currentIndex = 0;
        _isFlipped = false;
    }

    private void HandleMarkMastered(bool mastered)
    {
        if (CurrentCard == null) return;
        CurrentCard.Mastered = mastered;

        if (ActiveCards.Count > 0)
        {
            _isFlipped = false;
            _currentIndex = Math.Min(_currentIndex, ActiveCards.Count - 1);
        }
    }

    private void HandleReset()
    {
        _cards = new List<Flashcard>(CreateInitialCards());
        _currentIndex = 0;
        _isFlipped = false;
    }
}
