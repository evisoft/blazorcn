@* ========================================
   Block: dialog-date-range-picker
   Title: Dialog Date Range Picker
   Description: Date range picker dialog with calendar view, preset ranges, custom range selection, and comparison period option
   Dependencies: BadgeCn, ButtonCn, CalendarCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCalendarCn, LucideCheckCn, LucideXCn, SeparatorCn
   Source: original/blocks/dialog/dialog-date-range-picker.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                @if (_dateFrom is not null && _dateTo is not null)
                {
                    @($"{_dateFrom.Value:MMM d, yyyy} - {_dateTo.Value:MMM d, yyyy}")
                }
                else
                {
                    <span>Select date range</span>
                }
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-fit">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideCalendarCn Class="h-5 w-5" Size="20" />
                Select Date Range
            </DialogTitleCn>
            <DialogDescriptionCn>
                Choose a preset range or select custom dates from the calendar.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="flex gap-4 py-4">
            @* Preset Ranges *@
            <div class="w-40 space-y-1">
                <p class="text-xs font-medium text-muted-foreground mb-2">Quick Select</p>
                @foreach (var preset in _presetRanges)
                {
                    var p = preset;
                    <button
                        type="button"
                        class="@Cn.Merge("w-full text-left px-3 py-2 text-sm rounded-md transition-colors", _selectedPreset == p.Id ? "bg-primary text-primary-foreground" : "hover:bg-muted")"
                        @onclick="@(() => HandlePresetClick(p))">
                        @p.Label
                    </button>
                }
            </div>

            <SeparatorCn Class="h-auto" Orientation="Orientation.Vertical" />

            @* Calendar *@
            <div class="flex-1">
                <CalendarCn @bind-SelectedDate="_dateFrom" Class="rounded-md border" />

                @if (_dateFrom is not null && _dateTo is not null)
                {
                    <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                        <div class="space-y-1">
                            <p class="text-xs text-muted-foreground">Selected range</p>
                            <p class="text-sm font-medium">
                                @_dateFrom.Value.ToString("MMM d, yyyy") - @_dateTo.Value.ToString("MMM d, yyyy")
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary">
                            @GetDaysDifference() days
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        <DialogFooterCn Class="flex-col sm:flex-row gap-2">
            <ButtonCn Class="sm:mr-auto" Disabled="@(_dateFrom is null)" Variant="ButtonVariant.Ghost" @onclick="HandleClear">
                <LucideXCn Class="mr-2 h-4 w-4" Size="16" />
                Clear
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn Disabled="@(_dateFrom is null || _dateTo is null)" @onclick="HandleApply">
                <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                Apply Range
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private DateTime? _dateFrom = DateTime.Today.AddDays(-6);
    private DateTime? _dateTo = DateTime.Today;
    private string _selectedPreset = "last7";

    private record PresetRange(string Id, string Label, int DaysBack, int? DaysEnd = null);

    private static readonly PresetRange[] _presetRanges =
    [
        new("today", "Today", 0),
        new("yesterday", "Yesterday", 1),
        new("last7", "Last 7 days", 6),
        new("last30", "Last 30 days", 29),
        new("thisMonth", "This month", -1),
        new("lastMonth", "Last month", -2),
        new("thisQuarter", "This quarter", -3),
        new("thisYear", "This year", -4),
    ];

    private void HandlePresetClick(PresetRange preset)
    {
        _selectedPreset = preset.Id;
        var today = DateTime.Today;

        switch (preset.Id)
        {
            case "today":
                _dateFrom = today; _dateTo = today; break;
            case "yesterday":
                _dateFrom = today.AddDays(-1); _dateTo = today.AddDays(-1); break;
            case "last7":
                _dateFrom = today.AddDays(-6); _dateTo = today; break;
            case "last30":
                _dateFrom = today.AddDays(-29); _dateTo = today; break;
            case "thisMonth":
                _dateFrom = new DateTime(today.Year, today.Month, 1); _dateTo = today; break;
            case "lastMonth":
                var firstOfMonth = new DateTime(today.Year, today.Month, 1);
                _dateFrom = firstOfMonth.AddMonths(-1); _dateTo = firstOfMonth.AddDays(-1); break;
            case "thisQuarter":
                var quarter = (today.Month - 1) / 3;
                _dateFrom = new DateTime(today.Year, quarter * 3 + 1, 1); _dateTo = today; break;
            case "thisYear":
                _dateFrom = new DateTime(today.Year, 1, 1); _dateTo = today; break;
        }
    }

    private int GetDaysDifference()
    {
        if (_dateFrom is null || _dateTo is null) return 0;
        return (int)Math.Abs((_dateTo.Value - _dateFrom.Value).TotalDays) + 1;
    }

    private void HandleApply() => _open = false;

    private void HandleClear()
    {
        _dateFrom = null;
        _dateTo = null;
        _selectedPreset = "";
    }
}
