@* ========================================
   Block: dialog-language-region
   Title: Dialog Language Region
   Description: Language and region selector dialog with searchable country list, language preferences, and timezone detection
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideGlobeCn, LucideSearchCn, RadioGroupCn, RadioGroupItemCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/dialog/dialog-language-region.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideGlobeCn Class="mr-2 h-4 w-4" Size="16" />
                @(_regions.FirstOrDefault(r => r.Code == _selectedRegion)?.Flag) @(_languages.FirstOrDefault(l => l.Code == _selectedLanguage)?.Native)
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn>Language &amp; Region</DialogTitleCn>
            <DialogDescriptionCn>
                Choose your preferred language and region for a personalized experience.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <TabsCn Class="w-full" DefaultValue="language">
            <TabsListCn Class="grid w-full grid-cols-2">
                <TabsTriggerCn Value="language">Language</TabsTriggerCn>
                <TabsTriggerCn Value="region">Region</TabsTriggerCn>
            </TabsListCn>

            <TabsContentCn Class="space-y-4 mt-4" Value="language">
                <div class="relative">
                    <LucideSearchCn Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" Size="16" />
                    <InputCn Class="pl-9" Placeholder="Search languages..." Value="@_languageSearch" ValueChanged="@(v => _languageSearch = v)" />
                </div>
                <div class="h-[200px] overflow-y-auto rounded-md border p-2">
                    <RadioGroupCn Value="@_selectedLanguage" ValueChanged="@(v => _selectedLanguage = v)">
                        @foreach (var lang in GetFilteredLanguages())
                        {
                            <div class="flex items-center space-x-3 rounded-md p-2 hover:bg-muted cursor-pointer"
                                 role="button" tabindex="0" @onclick="@(() => _selectedLanguage = lang.Code)">
                                <RadioGroupItemCn id="@($"lang-{lang.Code}")" Value="@lang.Code" />
                                <LabelCn Class="flex-1 cursor-pointer flex items-center justify-between" For="@($"lang-{lang.Code}")">
                                    <span>@lang.Native</span>
                                    <span class="text-sm text-muted-foreground">@lang.Name</span>
                                </LabelCn>
                            </div>
                        }
                        @if (!GetFilteredLanguages().Any())
                        {
                            <p class="text-sm text-muted-foreground text-center py-4">No languages found</p>
                        }
                    </RadioGroupCn>
                </div>
            </TabsContentCn>

            <TabsContentCn Class="space-y-4 mt-4" Value="region">
                <div class="relative">
                    <LucideSearchCn Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" Size="16" />
                    <InputCn Class="pl-9" Placeholder="Search countries..." Value="@_regionSearch" ValueChanged="@(v => _regionSearch = v)" />
                </div>
                <div class="h-[200px] overflow-y-auto rounded-md border p-2">
                    <RadioGroupCn Value="@_selectedRegion" ValueChanged="@(v => _selectedRegion = v)">
                        @foreach (var region in GetFilteredRegions())
                        {
                            <div class="flex items-center space-x-3 rounded-md p-2 hover:bg-muted cursor-pointer"
                                 role="button" tabindex="0" @onclick="@(() => _selectedRegion = region.Code)">
                                <RadioGroupItemCn id="@($"region-{region.Code}")" Value="@region.Code" />
                                <LabelCn Class="flex-1 cursor-pointer flex items-center gap-3" For="@($"region-{region.Code}")">
                                    <span class="text-xl">@region.Flag</span>
                                    <span>@region.Name</span>
                                </LabelCn>
                            </div>
                        }
                        @if (!GetFilteredRegions().Any())
                        {
                            <p class="text-sm text-muted-foreground text-center py-4">No regions found</p>
                        }
                    </RadioGroupCn>
                </div>
            </TabsContentCn>
        </TabsCn>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn @onclick="HandleSave">Save</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record LanguageOption(string Code, string Name, string Native);
    private record RegionOption(string Code, string Name, string Flag, string Timezone);

    private static readonly LanguageOption[] _languages =
    [
        new("en", "English", "English"), new("es", "Spanish", "Espa\u00f1ol"),
        new("fr", "French", "Fran\u00e7ais"), new("de", "German", "Deutsch"),
        new("pt", "Portuguese", "Portugu\u00eas"), new("it", "Italian", "Italiano"),
        new("nl", "Dutch", "Nederlands"), new("pl", "Polish", "Polski"),
        new("ru", "Russian", "\u0420\u0443\u0441\u0441\u043a\u0438\u0439"), new("ja", "Japanese", "\u65e5\u672c\u8a9e"),
        new("ko", "Korean", "\ud55c\uad6d\uc5b4"), new("zh", "Chinese", "\u4e2d\u6587"),
        new("ar", "Arabic", "\u0627\u0644\u0639\u0631\u0628\u064a\u0629"), new("hi", "Hindi", "\u0939\u093f\u0928\u094d\u0926\u0940"),
    ];

    private static readonly RegionOption[] _regions =
    [
        new("US", "United States", "\ud83c\uddfa\ud83c\uddf8", "America/New_York"),
        new("GB", "United Kingdom", "\ud83c\uddec\ud83c\udde7", "Europe/London"),
        new("CA", "Canada", "\ud83c\udde8\ud83c\udde6", "America/Toronto"),
        new("AU", "Australia", "\ud83c\udde6\ud83c\uddfa", "Australia/Sydney"),
        new("DE", "Germany", "\ud83c\udde9\ud83c\uddea", "Europe/Berlin"),
        new("FR", "France", "\ud83c\uddeb\ud83c\uddf7", "Europe/Paris"),
        new("ES", "Spain", "\ud83c\uddea\ud83c\uddf8", "Europe/Madrid"),
        new("IT", "Italy", "\ud83c\uddee\ud83c\uddf9", "Europe/Rome"),
        new("NL", "Netherlands", "\ud83c\uddf3\ud83c\uddf1", "Europe/Amsterdam"),
        new("BR", "Brazil", "\ud83c\udde7\ud83c\uddf7", "America/Sao_Paulo"),
        new("MX", "Mexico", "\ud83c\uddf2\ud83c\uddfd", "America/Mexico_City"),
        new("JP", "Japan", "\ud83c\uddef\ud83c\uddf5", "Asia/Tokyo"),
        new("KR", "South Korea", "\ud83c\uddf0\ud83c\uddf7", "Asia/Seoul"),
        new("CN", "China", "\ud83c\udde8\ud83c\uddf3", "Asia/Shanghai"),
        new("IN", "India", "\ud83c\uddee\ud83c\uddf3", "Asia/Kolkata"),
        new("SG", "Singapore", "\ud83c\uddf8\ud83c\uddec", "Asia/Singapore"),
    ];

    private bool _open;
    private string _selectedLanguage = "en";
    private string _selectedRegion = "US";
    private string _languageSearch = "";
    private string _regionSearch = "";

    private IEnumerable<LanguageOption> GetFilteredLanguages()
    {
        var search = _languageSearch.ToLowerInvariant();
        return _languages.Where(l =>
            l.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            l.Native.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            l.Code.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<RegionOption> GetFilteredRegions()
    {
        var search = _regionSearch.ToLowerInvariant();
        return _regions.Where(r =>
            r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            r.Code.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private void HandleSave() => _open = false;
}
