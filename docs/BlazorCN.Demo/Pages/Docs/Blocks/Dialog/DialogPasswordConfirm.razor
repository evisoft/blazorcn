@* ========================================
   Block: dialog-password-confirm
   Title: Dialog Password Confirm
   Description: Delete confirmation dialog with password input field and visibility toggle for high-security destructive actions
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideEyeCn, LucideEyeOffCn
   Source: original/blocks/dialog/dialog-password-confirm.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-destructive cn-button-size-default" data-variant="destructive" data-size="default">Delete Workspace</DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn>Delete workspace</DialogTitleCn>
            <DialogDescriptionCn>
                All workspace data will be permanently deleted. There is no coming back after you press delete.
            </DialogDescriptionCn>
        </DialogHeaderCn>
        <form>
            <div>
                <LabelCn Class="text-sm font-medium" For="delete-workspace">Confirm password</LabelCn>
                <div class="relative mt-2">
                    <InputCn Class="pe-9" id="delete-workspace" name="delete-workspace"
                             Placeholder="Password" type="@(_isVisible ? "text" : "password")" />
                    <ButtonCn aria-controls="delete-workspace"
                              aria-label="@(_isVisible ? "Hide password" : "Show password")"
                              aria-pressed="@_isVisible"
                              Class="absolute inset-y-0 end-0 h-full w-9 rounded-e-md"
                              Type="button"
                              Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Icon"
                              OnClick="@(() => _isVisible = !_isVisible)">
                        @if (_isVisible)
                        {
                            <LucideEyeOffCn aria-hidden="true" Size="16" />
                        }
                        else
                        {
                            <LucideEyeCn aria-hidden="true" Size="16" />
                        }
                    </ButtonCn>
                </div>
            </div>
            <DialogFooterCn Class="mt-4">
                <ButtonCn Class="w-full" type="submit" Variant="ButtonVariant.Destructive">
                    Delete workspace permanently
                </ButtonCn>
            </DialogFooterCn>
        </form>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isVisible;
}
