                }
                else
                {
                    <LucideShoppingCartCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                    <span>Add to Cart</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

