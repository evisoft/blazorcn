            </AlertCn>

            <div class=""flex items-center justify-between"">
                <div class=""flex items-center gap-2"">
                    <BadgeCn Variant=""@GetStatusBadgeVariant(_error.Code)"">@_error.Code</BadgeCn>
                    <span class=""text-sm text-muted-foreground"">
                        @(_error.Type[..1].ToUpperInvariant() + _error.Type[1..]) Error
                    </span>
