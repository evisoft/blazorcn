@code {
    private const int TotalSeconds = 120;

    private bool _open;
    private int _secondsLeft = TotalSeconds;
    private bool _isExpired;
    private bool _isExtending;
    private System.Threading.Timer? _timer;

    private int ProgressValue => (int)((double)_secondsLeft / TotalSeconds * 100);

    private static string FormatTime(int seconds)
    {
        var mins = seconds / 60;
        var secs = seconds % 60;
        return $""{mins}:{secs:D2}"";
    }

    protected override void OnParametersSet()
    {
        if (_open && !_isExpired)
            StartTimer();
        else
            StopTimer();
    }

    private void StartTimer()
    {
        StopTimer();
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (_secondsLeft <= 1)
                {
                    _isExpired = true;
                    _secondsLeft = 0;
                    StopTimer();
                }
                else
                {
                    _secondsLeft--;
                }
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    private async Task HandleExtendSession()
    {
        _isExtending = true;
        StateHasChanged();
        await Task.Delay(1000);
        _secondsLeft = TotalSeconds;
        _isExtending = false;
        _open = false;
        StopTimer();
    }

    private void HandleLogout()
    {
        _isExpired = true;
        StopTimer();
    }

    private void HandleClose()
    {
        _open = false;
        _secondsLeft = TotalSeconds;
        _isExpired = false;
        _isExtending = false;
        StopTimer();
    }

    public void Dispose()
    {
        StopTimer();
    }
}";

