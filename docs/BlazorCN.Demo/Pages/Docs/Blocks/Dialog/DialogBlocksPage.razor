@code {
    private bool _open;
    private int _seconds = 67;
    private bool _isRetrying;
    private System.Threading.Timer? _timer;

    private bool IsReady => _seconds == 0;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    if (_open && _seconds > 0)
                    {
                        _seconds = Math.Max(0, _seconds - 1);
                        StateHasChanged();
                    }
                });
            }, null, 1000, 1000);
        }
    }

    private static string FormatTime(int s)
    {
        var mins = s / 60;
        var secs = s % 60;
        return $""{mins}:{secs:D2}"";
    }

    private async Task HandleRetry()
    {
        _isRetrying = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isRetrying = false;
        _open = false;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}";

