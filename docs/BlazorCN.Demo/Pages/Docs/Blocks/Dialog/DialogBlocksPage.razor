@code {
    private const int PinLength = 4;
    private const string CorrectPin = ""1234"";

    private bool _open;
    private string _pin = """";
    private bool _error;
    private bool _success;

    private async Task HandleDigit(string digit)
    {
        if (_pin.Length >= PinLength) return;

        _pin += digit;
        _error = false;

        if (_pin.Length == PinLength)
        {
            if (_pin == CorrectPin)
            {
                _success = true;
            }
            else
            {
                _error = true;
                StateHasChanged();
                await Task.Delay(500);
                _pin = """";
            }
        }
    }

    private void HandleDelete()
    {
        if (_pin.Length > 0)
        {
            _pin = _pin[..^1];
            _error = false;
        }
    }

    private void HandleClose()
    {
        _open = false;
        _pin = """";
        _error = false;
        _success = false;
    }
}";

