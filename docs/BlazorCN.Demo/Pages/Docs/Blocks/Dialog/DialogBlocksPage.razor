@code {
    private record UnitDef(string Id, string Name, string Symbol, double Factor);
    private record CategoryDef(string Id, string Name, UnitDef[] Units);

    private bool _open;
    private string _categoryId = ""length"";
    private string _fromUnitId = ""km"";
    private string _toUnitId = ""mi"";
    private string _inputValue = ""1"";

    private static readonly CategoryDef[] _categories =
    [
        new(""length"", ""Length"",
        [
            new(""mm"", ""Millimeters"", ""mm"", 0.001),
            new(""cm"", ""Centimeters"", ""cm"", 0.01),
            new(""m"", ""Meters"", ""m"", 1.0),
            new(""km"", ""Kilometers"", ""km"", 1000.0),
            new(""in"", ""Inches"", ""in"", 0.0254),
            new(""ft"", ""Feet"", ""ft"", 0.3048),
            new(""mi"", ""Miles"", ""mi"", 1609.344),
        ]),
        new(""weight"", ""Weight"",
        [
            new(""g"", ""Grams"", ""g"", 0.001),
            new(""kg"", ""Kilograms"", ""kg"", 1.0),
            new(""lb"", ""Pounds"", ""lb"", 0.453592),
            new(""oz"", ""Ounces"", ""oz"", 0.0283495),
        ]),
        new(""temperature"", ""Temp"",
        [
            new(""c"", ""Celsius"", ""\u00b0C"", 1.0),
            new(""f"", ""Fahrenheit"", ""\u00b0F"", 1.0),
            new(""k"", ""Kelvin"", ""K"", 1.0),
        ]),
        new(""volume"", ""Volume"",
        [
            new(""ml"", ""Milliliters"", ""mL"", 0.001),
            new(""l"", ""Liters"", ""L"", 1.0),
            new(""gal"", ""Gallons"", ""gal"", 3.78541),
            new(""cup"", ""Cups"", ""cup"", 0.236588),
        ]),
    ];

    private CategoryDef CurrentCategory => _categories.FirstOrDefault(c => c.Id == _categoryId) ?? _categories[0];
    private UnitDef FromUnit => CurrentCategory.Units.FirstOrDefault(u => u.Id == _fromUnitId) ?? CurrentCategory.Units[0];
    private UnitDef ToUnit => CurrentCategory.Units.FirstOrDefault(u => u.Id == _toUnitId) ?? CurrentCategory.Units[^1];

    private string Result
    {
        get
        {
            if (!double.TryParse(_inputValue, out var value)) return """";
            var baseValue = value * FromUnit.Factor;
            var converted = baseValue / ToUnit.Factor;
            return converted.ToString(""G6"");
        }
    }

    private void HandleCategoryChange(string newCategory)
    {
        _categoryId = newCategory;
        var cat = _categories.FirstOrDefault(c => c.Id == newCategory);
        if (cat != null)
        {
            _fromUnitId = cat.Units[0].Id;
            _toUnitId = cat.Units.Length > 1 ? cat.Units[1].Id : cat.Units[0].Id;
        }
        _inputValue = ""1"";
    }

    private void HandleSwapUnits()
    {
        (_fromUnitId, _toUnitId) = (_toUnitId, _fromUnitId);
        if (!string.IsNullOrEmpty(Result))
        {
            _inputValue = Result;
        }
    }
}";
