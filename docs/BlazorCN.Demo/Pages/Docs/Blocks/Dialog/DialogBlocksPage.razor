        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isLoading = false;
        _isSent = true;
    }

    private async Task HandleResend()
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isLoading = false;
