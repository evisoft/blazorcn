@page "/docs/blocks/dialog"
@layout DocsLayout

<PageTitle>Dialog Blocks — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Dialog</h1>
        <p class="mt-2 text-lg text-muted-foreground">Modal dialogs, confirmation prompts, and overlay content blocks.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Shipping Options" Description="Shipping options dialog with delivery methods, estimated dates, prices, and carrier selection" Code="@DialogShippingOptionsCode">
        <DialogShippingOptions />
    </ComponentPreview>

    <ComponentPreview Title="Split Payment" Description="Split payment dialog with multiple payment methods, amount allocation, and balance calculation" Code="@DialogSplitPaymentCode">
        <DialogSplitPayment />
    </ComponentPreview>

    <ComponentPreview Title="Timezone Picker" Description="Timezone picker dialog with searchable list, grouped by region, current time preview, UTC offset display, and auto-detect option" Code="@DialogTimezonePickerCode">
        <DialogTimezonePicker />
    </ComponentPreview>

    <ComponentPreview Title="Tip Calculator" Description="Tip calculator dialog with preset percentages, custom tip input, bill splitting, and per-person breakdown" Code="@DialogTipCalculatorCode">
        <DialogTipCalculator />
    </ComponentPreview>

    <ComponentPreview Title="Two Actions" Description="Centered success dialog with two action buttons in stacked mobile and side-by-side desktop layout" Code="@DialogTwoActionsCode">
        <DialogTwoActions />
    </ComponentPreview>

    <ComponentPreview Title="Two Factor Setup" Description="Two-factor authentication setup wizard with QR code display, authenticator app instructions, backup codes, and verification step" Code="@DialogTwoFactorSetupCode">
        <DialogTwoFactorSetup />
    </ComponentPreview>

    <ComponentPreview Title="Unit Converter" Description="Unit converter dialog with multiple categories, bidirectional conversion, common unit presets, and instant results" Code="@DialogUnitConverterCode">
        <DialogUnitConverter />
    </ComponentPreview>

    <ComponentPreview Title="Unsaved Changes" Description="Unsaved changes dialog with change summary, save/discard options, and navigation blocking confirmation" Code="@DialogUnsavedChangesCode">
        <DialogUnsavedChanges />
    </ComponentPreview>

    <ComponentPreview Title="Upgrade Plan" Description="Upgrade plan dialog with pricing tier comparison cards, feature lists, and billing toggle between monthly and annual" Code="@DialogUpgradePlanCode">
        <DialogUpgradePlan />
    </ComponentPreview>

    <ComponentPreview Title="User Preferences" Description="User preferences dialog with theme selection, display density, default views, and personalization options" Code="@DialogUserPreferencesCode">
        <DialogUserPreferences />
    </ComponentPreview>

    <ComponentPreview Title="Version History" Description="Version history dialog with timeline of changes, diff preview, restore functionality, and author attribution" Code="@DialogVersionHistoryCode">
        <DialogVersionHistory />
    </ComponentPreview>

    <ComponentPreview Title="Voice Command" Description="Voice command dialog with listening animation, transcript display, and action confirmation for React voice apps" Code="@DialogVoiceCommandCode">
        <DialogVoiceCommand />
    </ComponentPreview>

    <ComponentPreview Title="Voice Recorder" Description="Voice recorder dialog with recording controls, waveform visualization, timer display, playback preview, and save options" Code="@DialogVoiceRecorderCode">
        <DialogVoiceRecorder />
    </ComponentPreview>

    <ComponentPreview Title="Waitlist Signup" Description="Waitlist signup dialog with email capture, position display, social sharing for priority access, and referral tracking" Code="@DialogWaitlistSignupCode">
        <DialogWaitlistSignup />
    </ComponentPreview>

    <ComponentPreview Title="Warning" Description="Destructive action warning dialog with alert icon, horizontal layout, and cancel/confirm buttons" Code="@DialogWarningCode">
        <DialogWarning />
    </ComponentPreview>

    <ComponentPreview Title="Wifi Connect" Description="WiFi connect dialog with network selection, password input, and connection status for React IoT apps" Code="@DialogWifiConnectCode">
        <DialogWifiConnect />
    </ComponentPreview>

    <ComponentPreview Title="World Clock" Description="World clock dialog with multiple timezone display, time difference calculation, current time updates, and city search" Code="@DialogWorldClockCode">
        <DialogWorldClock />
    </ComponentPreview>

</div>

@code {
    private const string DialogShippingOptionsCode = @"<DialogCn @bind-Open=""_open"">
    <div class=""flex min-h-[350px] items-center justify-center"">
        <DialogTriggerCn>
            <ButtonCn Variant=""ButtonVariant.Outline"">
                <LucideTruckCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                Shipping Options
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class=""sm:max-w-sm"">
        <DialogHeaderCn>
            <DialogTitleCn>Choose Shipping</DialogTitleCn>
            <DialogDescriptionCn>Select your preferred delivery method.</DialogDescriptionCn>
        </DialogHeaderCn>

        <RadioGroupCn Class=""space-y-2 py-4"" Value=""@_selected"" ValueChanged=""@(v => _selected = v)"">
            @foreach (var option in _shippingOptions)
            {
                <LabelCn
                    Class=""@(Cn.Merge(""flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors"", _selected == option.Id ? ""border-primary bg-primary/5"" : ""hover:bg-muted""))""
                    For=""@option.Id"">
                    <RadioGroupItemCn Id=""@option.Id"" Value=""@option.Id"" />
                    <div class=""flex-1"">
                        <div class=""flex items-center gap-2"">
                            <span class=""text-sm font-medium"">@option.Name</span>
                            @if (option.Badge is not null)
                            {
                                <BadgeCn Class=""text-xs"" Variant=""BadgeVariant.Secondary"">
                                    @option.Badge
                                </BadgeCn>
                            }
                        </div>
                        <p class=""text-xs text-muted-foreground"">
                            @option.Carrier &middot; @option.Days
                        </p>
                    </div>
                    <span class=""text-sm font-semibold"">
                        @(option.Price == 0 ? ""Free"" : $""${option.Price:F2}"")
                    </span>
                </LabelCn>
            }
        </RadioGroupCn>

        <DialogFooterCn>
            <ButtonCn @onclick=""@(() => _open = false)"" Variant=""ButtonVariant.Outline"">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled=""@_isConfirming"" @onclick=""HandleConfirm"">
                @if (_isConfirming)
                {
                    <LucideLoader2Cn Class=""mr-2 h-4 w-4 animate-spin"" Size=""16"" />
                    <span>Confirming...</span>
                }
                else
                {
                    <span>Confirm</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _selected = ""express"";
    private bool _isConfirming;

    private record ShippingOption(string Id, string Name, string Carrier, string Days, decimal Price, string? Badge);

    private static readonly ShippingOption[] _shippingOptions =
    [
        new(""standard"", ""Standard"", ""USPS"", ""5-7 business days"", 0, null),
        new(""express"", ""Express"", ""FedEx"", ""2-3 business days"", 9.99m, ""Popular""),
        new(""overnight"", ""Overnight"", ""UPS"", ""1 business day"", 24.99m, null)
    ];

    private async Task HandleConfirm()
    {
        _isConfirming = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isConfirming = false;
        _open = false;
    }
}";
    private const string DialogSplitPaymentCode = @"<DialogCn @bind-Open=""_open"">
    <div class=""flex min-h-[350px] items-center justify-center"">
        <DialogTriggerCn>
            <ButtonCn Variant=""ButtonVariant.Outline"">
                <LucideSplitCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                Split Payment
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class=""sm:max-w-sm"">
        <DialogHeaderCn>
            <DialogTitleCn>Split Payment</DialogTitleCn>
            <DialogDescriptionCn>
                Split $@(_orderTotal.ToString(""F2"")) across multiple methods.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class=""space-y-4 py-4"">
            <div class=""space-y-3"">
                @foreach (var split in _splits)
                {
                    <div class=""flex items-center gap-3 rounded-lg border p-3"">
                        @if (split.Icon == ""credit-card"")
                        {
                            <LucideCreditCardCn Class=""h-4 w-4 text-muted-foreground"" Size=""16"" />
                        }
                        else if (split.Icon == ""wallet"")
                        {
                            <LucideWalletCn Class=""h-4 w-4 text-muted-foreground"" Size=""16"" />
                        }
                        else
                        {
                            <LucideDollarSignCn Class=""h-4 w-4 text-muted-foreground"" Size=""16"" />
                        }

                        <div class=""flex-1 min-w-0"">
                            <p class=""text-sm font-medium"">@split.Label</p>
                            <p class=""text-xs text-muted-foreground"">@split.Detail</p>
                        </div>

                        <div class=""flex items-center gap-1"">
                            <div class=""relative"">
                                <span class=""absolute left-2 top-1/2 -translate-y-1/2 text-sm text-muted-foreground"">$</span>
                                <InputCn
                                    Class=""w-24 pl-6 text-right""
                                    Type=""number""
                                    Value=""@split.Amount.ToString(""F2"")""
                                    ValueChanged=""@(v => HandleAmountChange(split.Id, v))"" />
                            </div>

                            @if (_splits.Length > 1)
                            {
                                <ButtonCn
                                    Class=""h-8 w-8""
                                    @onclick=""@(() => HandleRemoveMethod(split.Id))""
                                    Size=""ButtonSize.Icon""
                                    Variant=""ButtonVariant.Ghost"">
                                    <LucideXCn Class=""h-4 w-4"" Size=""16"" />
                                </ButtonCn>
                            }
                        </div>
                    </div>
                }
            </div>

            <SeparatorCn />

            <div class=""space-y-1.5 text-sm"">
                <div class=""flex justify-between"">
                    <span class=""text-muted-foreground"">Order Total</span>
                    <span>$@(_orderTotal.ToString(""F2""))</span>
                </div>
                <div class=""flex justify-between"">
                    <span class=""text-muted-foreground"">Allocated</span>
                    <span>$@(TotalAllocated.ToString(""F2""))</span>
                </div>
                <div class=""flex justify-between pt-1.5 border-t font-medium"">
                    <span>Remaining</span>
                    <span class=""@(IsFullyPaid ? ""text-primary"" : """")"">
                        @if (IsFullyPaid)
                        {
                            <span class=""flex items-center gap-1"">
                                <LucideCheckCn Class=""h-3 w-3"" Size=""12"" />
                                Paid
                            </span>
                        }
                        else
                        {
                            <span>$@(Remaining.ToString(""F2""))</span>
                        }
                    </span>
                </div>
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Disabled=""@_isProcessing"" @onclick=""@(() => _open = false)"" Variant=""ButtonVariant.Outline"">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled=""@(!IsFullyPaid || _isProcessing)"" @onclick=""HandleProcess"">
                @if (_isProcessing)
                {
                    <LucideLoader2Cn Class=""mr-2 h-4 w-4 animate-spin"" Size=""16"" />
                    <span>Processing...</span>
                }
                else
                {
                    <span>Pay $@(_orderTotal.ToString(""F2""))</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isProcessing;
    private decimal _orderTotal = 149.99m;

    private record PaymentSplit(string Id, string Label, string Detail, string Icon, decimal Amount);

    private PaymentSplit[] _splits =
    [
        new(""card"", ""Credit Card"", ""Visa ending 4242"", ""credit-card"", 100.00m),
        new(""wallet"", ""Digital Wallet"", ""Apple Pay"", ""wallet"", 49.99m)
    ];

    private decimal TotalAllocated => _splits.Sum(s => s.Amount);
    private decimal Remaining => _orderTotal - TotalAllocated;
    private bool IsFullyPaid => Remaining <= 0;

    private void HandleAmountChange(string id, string value)
    {
        if (decimal.TryParse(value, out var amount))
        {
            _splits = _splits.Select(s => s.Id == id ? s with { Amount = amount } : s).ToArray();
        }
    }

    private void HandleRemoveMethod(string id)
    {
        _splits = _splits.Where(s => s.Id != id).ToArray();
    }

    private async Task HandleProcess()
    {
        _isProcessing = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isProcessing = false;
        _open = false;
    }
}";
    private const string DialogTimezonePickerCode = @"<DialogCn @bind-Open=""_open"">
    <div class=""flex min-h-[350px] items-center justify-center"">
        <DialogTriggerCn>
            <ButtonCn Variant=""ButtonVariant.Outline"">
                <LucideGlobeCn Size=""16"" Class=""mr-2 size-4"" />
                Select Timezone
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Style=""max-width: 384px"">
        <DialogHeaderCn>
            <DialogTitleCn>Select Timezone</DialogTitleCn>
            <DialogDescriptionCn>Choose your timezone for scheduling.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class=""space-y-3 py-4"">
            <div class=""flex gap-2"">
                <div class=""relative flex-1"">
                    <LucideSearchCn Size=""16"" Class=""absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground"" />
                    <InputCn @bind-Value=""_search""
                             Placeholder=""Search timezone...""
                             Class=""pl-9"" />
                </div>
                <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Icon"" title=""Auto-detect""
                          @onclick=""HandleAutoDetect"">
                    <LucideLocateCn Size=""16"" Class=""size-4"" />
                </ButtonCn>
            </div>

            <ScrollAreaCn Class=""h-[200px]"">
                @foreach (var region in _regions)
                {
                    var regionTimezones = FilteredTimezones.Where(tz => tz.Region == region).ToArray();
                    if (regionTimezones.Length > 0)
                    {
                        <div class=""mb-3"">
                            <p class=""text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1 px-2"">
                                @region
                            </p>
                            <div class=""space-y-0.5"">
                                @foreach (var tz in regionTimezones)
                                {
                                    <button type=""button""
                                            class=""@Cn.Merge(""w-full flex items-center justify-between px-2 py-1.5 rounded-md transition-colors text-left"", _selected == tz.Id ? ""bg-primary/10 text-primary"" : ""hover:bg-muted"")""
                                            @onclick=""@(() => _selected = tz.Id)"">
                                        <div class=""flex items-center gap-2"">
                                            <LucideCheckCn Size=""12"" Class=""@Cn.Merge(""size-3"", _selected == tz.Id ? ""opacity-100"" : ""opacity-0"")"" />
                                            <span class=""text-sm"">@tz.City</span>
                                        </div>
                                        <span class=""text-xs text-muted-foreground tabular-nums"">
                                            @GetTimeInTimezone(tz.OffsetMinutes)
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
                @if (!FilteredTimezones.Any())
                {
                    <p class=""text-sm text-muted-foreground text-center py-8"">No timezones found</p>
                }
            </ScrollAreaCn>
        </div>

        <DialogFooterCn>
            <ButtonCn Variant=""ButtonVariant.Outline"" @onclick=""HandleClose"">Cancel</ButtonCn>
            <ButtonCn @onclick=""HandleClose"">Save</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record TimezoneInfo(string Id, string Name, string City, string Region, string Offset, int OffsetMinutes);

    private static readonly string[] _regions = { ""Americas"", ""Europe"", ""Asia"", ""Pacific"" };

    private static readonly TimezoneInfo[] _timezones =
    {
        new(""Pacific/Honolulu"", ""Hawaii"", ""Honolulu"", ""Americas"", ""-10:00"", -600),
        new(""America/Anchorage"", ""Alaska"", ""Anchorage"", ""Americas"", ""-09:00"", -540),
        new(""America/Los_Angeles"", ""Pacific Time"", ""Los Angeles"", ""Americas"", ""-08:00"", -480),
        new(""America/Denver"", ""Mountain Time"", ""Denver"", ""Americas"", ""-07:00"", -420),
        new(""America/Chicago"", ""Central Time"", ""Chicago"", ""Americas"", ""-06:00"", -360),
        new(""America/New_York"", ""Eastern Time"", ""New York"", ""Americas"", ""-05:00"", -300),
        new(""America/Sao_Paulo"", ""Brasilia Time"", ""São Paulo"", ""Americas"", ""-03:00"", -180),
        new(""Europe/London"", ""Greenwich Mean Time"", ""London"", ""Europe"", ""+00:00"", 0),
        new(""Europe/Paris"", ""Central European"", ""Paris"", ""Europe"", ""+01:00"", 60),
        new(""Europe/Helsinki"", ""Eastern European"", ""Helsinki"", ""Europe"", ""+02:00"", 120),
        new(""Europe/Moscow"", ""Moscow Time"", ""Moscow"", ""Europe"", ""+03:00"", 180),
        new(""Asia/Dubai"", ""Gulf Standard"", ""Dubai"", ""Asia"", ""+04:00"", 240),
        new(""Asia/Kolkata"", ""India Standard"", ""Mumbai"", ""Asia"", ""+05:30"", 330),
        new(""Asia/Bangkok"", ""Indochina Time"", ""Bangkok"", ""Asia"", ""+07:00"", 420),
        new(""Asia/Shanghai"", ""China Standard"", ""Shanghai"", ""Asia"", ""+08:00"", 480),
        new(""Asia/Tokyo"", ""Japan Standard"", ""Tokyo"", ""Asia"", ""+09:00"", 540),
        new(""Australia/Sydney"", ""Australian Eastern"", ""Sydney"", ""Pacific"", ""+11:00"", 660),
        new(""Pacific/Auckland"", ""New Zealand"", ""Auckland"", ""Pacific"", ""+13:00"", 780)
    };

    private bool _open;
    private string _search = """";
    private string _selected = ""America/New_York"";

    private IEnumerable<TimezoneInfo> FilteredTimezones
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
                return _timezones;

            var searchLower = _search.ToLowerInvariant();
            return _timezones.Where(tz =>
                tz.Name.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ||
                tz.City.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ||
                tz.Offset.Contains(_search) ||
                tz.Id.Contains(searchLower, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static string GetTimeInTimezone(int offsetMinutes)
    {
        var utcNow = DateTimeOffset.UtcNow;
        var tzTime = utcNow.ToOffset(TimeSpan.FromMinutes(offsetMinutes));
        return tzTime.ToString(""h:mm tt"");
    }

    private void HandleAutoDetect()
    {
        _selected = ""America/New_York"";
    }

    private void HandleClose()
    {
        _open = false;
        _search = """";
    }
}";
    private const string DialogTipCalculatorCode = @"<DialogCn @bind-Open=""_open"">
    <div class=""flex min-h-[350px] items-center justify-center"">
        <DialogTriggerCn>
            <ButtonCn Variant=""ButtonVariant.Outline"">
                <LucideReceiptCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                Tip Calculator
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style=""max-width: 384px;"">
        <DialogHeaderCn>
            <DialogTitleCn>Tip Calculator</DialogTitleCn>
            <DialogDescriptionCn>Calculate tip and split the bill.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class=""space-y-4 py-4"">
            @* Bill Amount *@
            <div class=""space-y-2"">
                <LabelCn Class=""text-sm"" For=""bill"">Bill Amount</LabelCn>
                <div class=""relative"">
                    <span class=""absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"">$</span>
                    <InputCn Class=""pl-7 font-mono""
                             Id=""bill""
                             Type=""number""
                             Value=""@_billAmount""
                             ValueChanged=""@((string v) => _billAmount = v)""
                             Placeholder=""0.00"" />
                </div>
            </div>

            @* Tip Percentage *@
            <div class=""space-y-2"">
                <LabelCn Class=""text-sm"">Tip</LabelCn>
                <div class=""grid grid-cols-4 gap-2"">
                    @foreach (var preset in _tipPresets)
                    {
                        <ButtonCn Size=""ButtonSize.Sm""
                                  Variant=""@(_tipPercentage == preset ? ButtonVariant.Default : ButtonVariant.Outline)""
                                  @onclick=""@(() => _tipPercentage = preset)"">
                            @(preset)%
                        </ButtonCn>
                    }
                </div>
            </div>

            @* Split *@
            <div class=""flex items-center justify-between"">
                <LabelCn Class=""text-sm"">Split</LabelCn>
                <div class=""flex items-center gap-2"">
                    <ButtonCn Class=""h-8 w-8""
                              Disabled=""@(_splitCount <= 1)""
                              Size=""ButtonSize.Icon""
                              Variant=""ButtonVariant.Outline""
                              @onclick=""@(() => _splitCount = Math.Max(1, _splitCount - 1))"">
                        <LucideMinusCn Class=""h-4 w-4"" Size=""16"" />
                    </ButtonCn>
                    <span class=""w-6 text-center font-mono"">@_splitCount</span>
                    <ButtonCn Class=""h-8 w-8""
                              Disabled=""@(_splitCount >= 20)""
                              Size=""ButtonSize.Icon""
                              Variant=""ButtonVariant.Outline""
                              @onclick=""@(() => _splitCount = Math.Min(20, _splitCount + 1))"">
                        <LucidePlusCn Class=""h-4 w-4"" Size=""16"" />
                    </ButtonCn>
                </div>
            </div>

            <SeparatorCn />

            @* Results *@
            <div class=""space-y-2 text-sm"">
                <div class=""flex justify-between"">
                    <span class=""text-muted-foreground"">Tip (@(_tipPercentage)%)</span>
                    <span class=""font-mono"">@FormatCurrency(TipAmount)</span>
                </div>
                <div class=""flex justify-between font-medium"">
                    <span>Total</span>
                    <span class=""font-mono"">@FormatCurrency(Total)</span>
                </div>
                @if (_splitCount > 1)
                {
                    <div class=""flex justify-between pt-2 border-t text-primary font-medium"">
                        <span>Per person</span>
                        <span class=""font-mono"">@FormatCurrency(PerPerson)</span>
                    </div>
                }
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" @onclick=""HandleCopy"">
                @if (_copied)
                {
                    <LucideCheckCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                    <span>Copied</span>
                }
                else
                {
                    <LucideCopyCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                    <span>Copy</span>
                }
            </ButtonCn>
            <ButtonCn @onclick=""@(() => _open = false)"">Done</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private static readonly int[] _tipPresets = [15, 18, 20, 25];

    private bool _open;
    private string _billAmount = ""85.50"";
    private int _tipPercentage = 20;
    private int _splitCount = 1;
    private bool _copied;

    private double Bill => double.TryParse(_billAmount, out var v) ? v : 0;
    private double TipAmount => Bill * (_tipPercentage / 100.0);
    private double Total => Bill + TipAmount;
    private double PerPerson => _splitCount > 0 ? Total / _splitCount : 0;

    private static string FormatCurrency(double amount) => amount.ToString(""C2"");

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}";
