@code {
    private bool _open;
    private string _state = ""idle""; // idle, recording, recorded, playing
    private int _duration;
    private string _fileName = """";
    private bool _saved;

    // Static waveform bars for display
    private static readonly int[] _idleBars = { 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10 };
    private static readonly int[] _recordingBars = { 45, 72, 33, 88, 55, 67, 40, 90, 35, 78, 50, 65, 42, 85, 58, 70 };
    private static readonly int[] _recordedBars = { 25, 25, 25, 25, 25, 25, 25, 25, 25, 25, 25, 25, 25, 25, 25, 25 };

    private int[] _waveformBars = _idleBars;

    private static string FormatTime(int seconds)
    {
        var mins = seconds / 60;
        var secs = seconds % 60;
        return $""{mins}:{secs:D2}"";
    }

    private void StartRecording()
    {
        _state = ""recording"";
        _duration = 5; // Show a realistic static snapshot at 5 seconds
        _waveformBars = _recordingBars;
    }

    private void StopRecording()
    {
        _state = ""recorded"";
        _waveformBars = _recordedBars;
    }

    private void DiscardRecording()
    {
        _state = ""idle"";
        _duration = 0;
        _fileName = """";
        _waveformBars = _idleBars;
    }

    private void SaveRecording()
    {
        _saved = true;
    }

    private void HandleClose()
    {
        _open = false;
        _state = ""idle"";
        _duration = 0;
        _fileName = """";
        _waveformBars = _idleBars;
        _saved = false;
    }
}";
