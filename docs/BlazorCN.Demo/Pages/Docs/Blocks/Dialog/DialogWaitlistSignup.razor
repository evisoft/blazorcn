@* ========================================
   Block: dialog-waitlist-signup
   Title: Dialog Waitlist Signup
   Description: Waitlist signup dialog with email capture, position display, social sharing for priority access, and referral tracking
   Long Description: Voice recorder dialog with recording controls, waveform visualization, timer display, playback preview, and save options
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideArrowUpCn, LucideCheckCn, LucideCopyCn, LucideMailCn, LucideShare2Cn, LucideSparklesCn, LucideTrophyCn, LucideTwitterCn, LucideUsersCn, ProgressCn, SeparatorCn
   Source: original/blocks/dialog/dialog-waitlist-signup.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideSparklesCn Class="mr-2 h-4 w-4" Size="16" />
                Join Waitlist
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        @if (_joined)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-2">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>You're on the list!</DialogTitleCn>
                <DialogDescriptionCn>We'll email you when it's your turn.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="rounded-lg border bg-muted/30 p-4 text-center">
                    <p class="text-sm text-muted-foreground mb-1">Your position</p>
                    <p class="text-4xl font-bold">#@(_position.ToString("N0"))</p>
                    <div class="flex items-center justify-center gap-1 mt-1">
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                            Top @(_percentile)%
                        </BadgeCn>
                        <BadgeCn Class="text-xs bg-primary/10 text-primary hover:bg-primary/20">
                            <LucideArrowUpCn Class="h-3 w-3 mr-0.5" Size="12" />
                            @_positionGain spots
                        </BadgeCn>
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Progress to launch</span>
                        <span class="font-medium">@(_percentile)%</span>
                    </div>
                    <ProgressCn Class="h-2" Value="@_percentile" />
                </div>

                <SeparatorCn />

                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <p class="text-sm font-medium">Move up faster</p>
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideUsersCn Class="h-3 w-3" Size="12" />
                            @_referrals referrals
                        </div>
                    </div>
                    <p class="text-xs text-muted-foreground">
                        Each friend who joins moves you up 50 spots!
                    </p>

                    <div class="flex gap-2">
                        <InputCn Class="text-xs bg-muted/50" ReadOnly Value="@_referralLink" />
                        <ButtonCn Class="shrink-0" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="HandleCopyLink">
                            @if (_copied)
                            {
                                <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                            }
                            else
                            {
                                <LucideCopyCn Class="h-4 w-4" Size="16" />
                            }
                        </ButtonCn>
                    </div>

                    <div class="flex gap-2">
                        <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                            <LucideTwitterCn Class="mr-2 h-4 w-4" Size="16" />
                            Share
                        </ButtonCn>
                        <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline" @onclick="HandleCopyLink">
                            <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
                            Copy Link
                        </ButtonCn>
                    </div>
                </div>

                <div class="rounded-lg border p-3 bg-primary/5 border-primary/20">
                    <div class="flex items-start gap-2">
                        <LucideTrophyCn Class="h-4 w-4 text-primary mt-0.5" Size="16" />
                        <div>
                            <p class="text-sm font-medium">Refer 5 friends</p>
                            <p class="text-xs text-muted-foreground">
                                Get guaranteed access in the first wave
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-2">
                    <LucideSparklesCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Get Early Access</DialogTitleCn>
                <DialogDescriptionCn>
                    Join @(_totalWaiting.ToString("N0"))+ others waiting for launch.
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <div class="relative">
                        <LucideMailCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9"
                                 Type="email"
                                 Placeholder="Enter your email"
                                 Value="@_email"
                                 ValueChanged="@((string v) => _email = v)" />
                    </div>
                </div>

                <ButtonCn Class="w-full" Disabled="@(!IsValidEmail)" @onclick="HandleJoin">
                    Join the Waitlist
                </ButtonCn>

                <p class="text-xs text-center text-muted-foreground">
                    We'll notify you when it's your turn. No spam, ever.
                </p>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private const int _position = 1247;
    private const int _totalWaiting = 8500;
    private const int _referrals = 3;
    private const int _positionGain = 156;
    private const string _referralLink = "https://app.example.com/waitlist?ref=abc123";

    private int _percentile => (int)Math.Round((1.0 - (double)_position / _totalWaiting) * 100);

    private bool _open;
    private string _email = "";
    private bool _joined;
    private bool _copied;

    private bool IsValidEmail => _email.Contains("@@") && _email.Contains(".");

    private void HandleJoin()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _joined = true;
    }

    private async Task HandleCopyLink()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
