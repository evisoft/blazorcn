@* ========================================
   Block: dialog-manage-subscription
   Title: Dialog Manage Subscription
   Description: Manage subscription dialog with current plan details, usage stats, billing info, and quick actions for plan management
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideAlertCircleCn, LucideArrowUpRightCn, LucideCalendarCn, LucideCreditCardCn, LucideFileTextCn, LucideHardDriveCn, LucideRefreshCwCn, LucideSettingsCn, LucideUsersCn, LucideZapCn, ProgressCn, SeparatorCn
   Source: original/blocks/dialog/dialog-manage-subscription.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideSettingsCn Class="mr-2 h-4 w-4" Size="16" />
                Manage Subscription
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideSettingsCn Class="h-5 w-5" Size="20" />
                Subscription
            </DialogTitleCn>
            <DialogDescriptionCn>Manage your plan, usage, and billing settings.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-6 py-4">
            @* Current Plan *@
            <div class="rounded-lg border p-4">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-semibold">Pro Plan</h3>
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Active</BadgeCn>
                        </div>
                        <p class="text-2xl font-bold mt-1">
                            $29<span class="text-sm font-normal text-muted-foreground">/month</span>
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        <LucideArrowUpRightCn Class="mr-1 h-3 w-3" Size="12" />
                        Upgrade
                    </ButtonCn>
                </div>
                <SeparatorCn Class="my-4" />
                <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideCalendarCn Class="h-4 w-4" Size="16" />
                        <span>Next billing: January 15, 2025</span>
                    </div>
                    <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">Change cycle</ButtonCn>
                </div>
            </div>

            @* Usage Stats *@
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <h4 class="text-sm font-medium">Usage</h4>
                    <span class="text-xs text-muted-foreground">Resets monthly</span>
                </div>
                <div class="space-y-4">
                    @foreach (var stat in _usageStats)
                    {
                        var percentage = GetUsagePercentage(stat.Used, stat.Limit);
                        var colorClass = GetUsageColor(percentage);
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between text-sm">
                                <div class="flex items-center gap-2">
                                    @stat.IconFragment
                                    <span>@stat.Label</span>
                                </div>
                                <span class="@Cn.Merge("text-xs", colorClass)">
                                    @stat.Used@stat.Unit / @stat.Limit@stat.Unit
                                </span>
                            </div>
                            <ProgressCn Class="@Cn.Merge("h-2", percentage >= 90 ? "[&>div]:bg-destructive" : "", percentage >= 75 && percentage < 90 ? "[&>div]:bg-yellow-500" : "")"
                                        Value="@percentage" />
                        </div>
                    }
                </div>
                @if (_usageStats.Any(s => GetUsagePercentage(s.Used, s.Limit) >= 75))
                {
                    <div class="flex items-start gap-2 rounded-lg border border-yellow-500/50 p-3 text-sm">
                        <LucideCircleAlertCn Class="h-4 w-4 text-yellow-600 mt-0.5" Size="16" />
                        <div>
                            <p class="font-medium">Approaching limits</p>
                            <p class="text-xs text-muted-foreground">Consider upgrading to avoid service interruptions.</p>
                        </div>
                    </div>
                }
            </div>

            <SeparatorCn />

            @* Payment Method *@
            <div class="space-y-3">
                <h4 class="text-sm font-medium">Payment Method</h4>
                <div class="flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-14 items-center justify-center rounded border">
                            <span class="text-xs font-bold italic text-blue-600">VISA</span>
                        </div>
                        <div>
                            <p class="text-sm font-medium">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 4242</p>
                            <p class="text-xs text-muted-foreground">Expires 12/25</p>
                        </div>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideCreditCardCn Class="mr-1 h-3 w-3" Size="12" />
                        Change
                    </ButtonCn>
                </div>
            </div>

            @* Quick Actions *@
            <div class="grid grid-cols-2 gap-2">
                <ButtonCn Class="justify-start" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideFileTextCn Class="mr-2 h-4 w-4" Size="16" />
                    View Invoices
                </ButtonCn>
                <ButtonCn Class="justify-start" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideRefreshCwCn Class="mr-2 h-4 w-4" Size="16" />
                    Change Billing
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t">
            <ButtonCn Class="text-muted-foreground hover:text-destructive" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                Cancel Subscription
            </ButtonCn>
            <ButtonCn @onclick="@(() => _open = false)">Done</ButtonCn>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record UsageStat(string Id, string Label, double Used, double Limit, string Unit, RenderFragment IconFragment);

    private readonly UsageStat[] _usageStats;

    public DialogManageSubscription()
    {
        _usageStats =
        [
            new("projects", "Projects", 8, 10, "", builder => { builder.OpenComponent<LucideZapCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4 text-muted-foreground"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("members", "Team Members", 4, 5, "", builder => { builder.OpenComponent<LucideUsersCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4 text-muted-foreground"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("storage", "Storage", 12.4, 25, "GB", builder => { builder.OpenComponent<LucideHardDriveCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4 text-muted-foreground"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
        ];
    }

    private bool _open;

    private static double GetUsagePercentage(double used, double limit) => Math.Min(used / limit * 100, 100);

    private static string GetUsageColor(double percentage) => percentage switch
    {
        >= 90 => "text-destructive",
        >= 75 => "text-yellow-600",
        _ => "text-muted-foreground",
    };
}
