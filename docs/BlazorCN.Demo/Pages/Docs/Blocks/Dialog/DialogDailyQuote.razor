@* ========================================
   Block: dialog-daily-quote
   Title: Dialog Daily Quote
   Description: Daily quote dialog with inspirational message, author attribution, and share options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideCopyCn, LucideShare2Cn, LucideSparklesCn
   Source: original/blocks/dialog/dialog-daily-quote.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideSparklesCn Class="mr-2 h-4 w-4" Size="16" />
                Daily Quote
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="text-center" style="max-width: 384px;">
        <DialogTitleCn Class="sr-only">Daily Quote</DialogTitleCn>
        <div class="py-6">
            <LucideSparklesCn Class="h-6 w-6 text-primary mx-auto" Size="24" />
            <blockquote class="mt-6">
                <p class="text-lg font-medium leading-relaxed">"@_quote.Text"</p>
                <footer class="mt-4 text-sm text-muted-foreground">— @_quote.Author</footer>
            </blockquote>
        </div>

        <div class="flex gap-2">
            <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline" @onclick="HandleCopy">
                @if (_copied)
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Copied</span>
                }
                else
                {
                    <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Copy</span>
                }
            </ButtonCn>
            <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
                Share
            </ButtonCn>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _copied;

    private record Quote(string Text, string Author);
    private static readonly Quote _quote = new("The only way to do great work is to love what you do.", "Steve Jobs");

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
