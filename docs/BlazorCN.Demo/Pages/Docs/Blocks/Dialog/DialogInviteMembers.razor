@* ========================================
   Block: dialog-invite-members
   Title: Dialog Invite Members
   Description: Team member invitation dialog with email input, existing member list with avatars, and member status badges
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideUserPlusCn
   Source: original/blocks/dialog/dialog-invite-members.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn>Invite Members</ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn Class="font-semibold text-foreground">Invite members</DialogTitleCn>
            <DialogDescriptionCn Class="text-sm leading-6 text-muted-foreground">
                Add new team members to your workspace. Please consider your organization's
                policies when adding external people.
            </DialogDescriptionCn>
        </DialogHeaderCn>
        <form>
            <div class="flex w-full items-center space-x-2">
                <div class="relative flex-1">
                    <LucideUserPlusCn Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" Size="16" />
                    <InputCn Class="h-10 pl-9" id="inviteEmail" Placeholder="Add email..." type="email" />
                </div>
                <ButtonCn Class="h-10" type="submit">
                    Invite
                </ButtonCn>
            </div>
        </form>
        <h4 class="mt-4 text-sm font-medium text-foreground">People with existing access</h4>
        <ul class="divide-y">
            @foreach (var member in _members)
            {
                <li class="flex items-center justify-between py-2.5">
                    <div class="flex items-center space-x-3">
                        <AvatarCn Class="h-9 w-9">
                            <AvatarImageCn Alt="@member.Name" Src="@member.AvatarUrl" />
                            <AvatarFallbackCn>@member.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <span class="font-medium text-foreground">@member.Name</span>
                    </div>
                    <BadgeCn Class="bg-background text-xs font-medium" Variant="BadgeVariant.Outline">
                        @member.Status
                    </BadgeCn>
                </li>
            }
        </ul>
    </DialogContentCn>
</DialogCn>

@code {
    private record Member(string Name, string Email, string AvatarUrl, string Initials, string Status);

    private static readonly Member[] _members =
    [
        new("Sarah Chen", "sarah@company.com", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&auto=format&fit=crop", "SC", "member"),
        new("Alex Morgan", "alex@company.com", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&auto=format&fit=crop", "AM", "member"),
        new("David Park", "david@company.com", "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&h=100&auto=format&fit=crop", "DP", "member"),
        new("Emily Watson", "emily@company.com", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&auto=format&fit=crop", "EW", "member"),
    ];

    private bool _open;
}
