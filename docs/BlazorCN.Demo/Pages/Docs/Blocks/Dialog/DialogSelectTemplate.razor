@* ========================================
   Block: dialog-select-template
   Title: Dialog Select Template
   Description: Template selection dialog with icon grid, template types, and quick selection
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideFileCn, LucideFileTextCn, LucideLayoutTemplateCn, LucideLoader2Cn, LucideMailCn, LucidePresentationCn
   Source: original/blocks/dialog/dialog-select-template.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideLayoutTemplateCn Class="mr-2 h-4 w-4" Size="16" />
                Choose Template
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Select Template</DialogTitleCn>
            <DialogDescriptionCn>Choose a template to get started.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="grid grid-cols-2 gap-3 py-4">
            @foreach (var template in _templates)
            {
                <button
                    type="button"
                    class="@Cn.Merge("relative flex flex-col items-center rounded-lg border p-4 text-center transition-colors", _selected == template.Id ? "border-primary bg-primary/5" : "hover:bg-muted")"
                    @onclick="@(() => _selected = template.Id)">
                    @if (template.Badge is not null)
                    {
                        <BadgeCn Class="absolute -top-2 right-2 text-xs" Variant="BadgeVariant.Secondary">
                            @template.Badge
                        </BadgeCn>
                    }
                    @switch (template.Icon)
                    {
                        case "file":
                            <LucideFileCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                            break;
                        case "file-text":
                            <LucideFileTextCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                            break;
                        case "mail":
                            <LucideMailCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                            break;
                        case "presentation":
                            <LucidePresentationCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                            break;
                    }
                    <p class="text-sm font-medium">@template.Name</p>
                    <p class="text-xs text-muted-foreground">@template.Description</p>
                </button>
            }
        </div>

        <DialogFooterCn>
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@_isLoading" @onclick="HandleSelect">
                @if (_isLoading)
                {
                    <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Loading...</span>
                }
                else
                {
                    <span>Use Template</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _selected = "1";
    private bool _isLoading;

    private record TemplateData(string Id, string Name, string Description, string Icon, string? Badge = null);

    private static readonly TemplateData[] _templates =
    [
        new("1", "Blank", "Start fresh", "file"),
        new("2", "Report", "Professional layout", "file-text"),
        new("3", "Newsletter", "Email design", "mail", "Popular"),
        new("4", "Pitch Deck", "Presentations", "presentation")
    ];

    private async Task HandleSelect()
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isLoading = false;
        _open = false;
    }
}
