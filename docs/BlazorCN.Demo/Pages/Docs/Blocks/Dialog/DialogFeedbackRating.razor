@* ========================================
   Block: dialog-feedback-rating
   Title: Dialog Feedback Rating
   Description: Feedback rating dialog with emoji scale selector, optional comment textarea, and submit button
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, TextareaCn
   Source: original/blocks/dialog/dialog-feedback-rating.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Give Feedback</DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn>How was your experience?</DialogTitleCn>
            <DialogDescriptionCn>
                Your feedback helps us improve. Select a rating and optionally leave a comment.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4">
            <div class="flex justify-between gap-2">
                @foreach (var rating in _ratings)
                {
                    <button type="button"
                            class="@Cn.Merge("flex flex-col items-center gap-1 p-3 rounded-lg transition-all hover:bg-muted", _selectedRating == rating.Value ? "bg-primary/10 ring-2 ring-primary" : "bg-muted/50")"
                            @onclick="@(() => _selectedRating = rating.Value)">
                        <span class="text-2xl">@rating.Emoji</span>
                        <span class="text-xs text-muted-foreground">@rating.Label</span>
                    </button>
                }
            </div>

            <div class="mt-4 space-y-2">
                <TextareaCn Class="min-h-[100px] resize-none"
                            Placeholder="Tell us more about your experience (optional)"
                            @bind-Value="_comment" />
                <p class="text-xs text-muted-foreground text-right">@(_comment.Length)/500</p>
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Class="w-full" Disabled="@(_selectedRating == null)" @onclick="HandleSubmit">
                Submit Feedback
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record RatingOption(int Value, string Emoji, string Label);

    private static readonly RatingOption[] _ratings =
    [
        new(1, "\U0001F620", "Terrible"),
        new(2, "\U0001F615", "Poor"),
        new(3, "\U0001F610", "Okay"),
        new(4, "\U0001F60A", "Good"),
        new(5, "\U0001F60D", "Amazing"),
    ];

    private bool _open;
    private int? _selectedRating;
    private string _comment = "";

    private void HandleSubmit()
    {
        _open = false;
        _selectedRating = null;
        _comment = "";
    }
}
