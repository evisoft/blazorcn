@* ========================================
   Block: dialog-reorder-items
   Title: Dialog Reorder Items
   Description: Drag and drop reorder dialog with sortable list, handle grips, arrow buttons, and save/reset options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideArrowDownCn, LucideArrowUpCn, LucideCheckCn, LucideGripVerticalCn, LucideLoaderCn, LucideRotateCcwCn
   Source: original/blocks/dialog/dialog-reorder-items.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideGripVerticalCn Class="mr-2 h-4 w-4" Size="16" />
                Reorder Items
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideGripVerticalCn Class="h-5 w-5" Size="20" />
                Reorder Items
            </DialogTitleCn>
            <DialogDescriptionCn>Drag and drop to reorder, or use the arrow buttons.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4">
            <div class="space-y-2">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var index = i;
                    var item = _items[i];
                    <div class="flex items-center gap-3 rounded-lg border p-3 transition-all">
                        <div class="cursor-grab text-muted-foreground hover:text-foreground active:cursor-grabbing">
                            <LucideGripVerticalCn Class="h-5 w-5" Size="20" />
                        </div>

                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium truncate">@item.Label</p>
                            @if (item.Description is not null)
                            {
                                <p class="text-xs text-muted-foreground truncate">@item.Description</p>
                            }
                        </div>

                        <div class="flex items-center gap-1">
                            <ButtonCn aria-label="Move up" Class="h-8 w-8"
                                      Disabled="@(index == 0)"
                                      Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                      @onclick="@(() => MoveItem(index, "up"))">
                                <LucideArrowUpCn Class="h-4 w-4" Size="16" />
                            </ButtonCn>
                            <ButtonCn aria-label="Move down" Class="h-8 w-8"
                                      Disabled="@(index == _items.Count - 1)"
                                      Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                      @onclick="@(() => MoveItem(index, "down"))">
                                <LucideArrowDownCn Class="h-4 w-4" Size="16" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>

            @if (HasChanges)
            {
                <p class="mt-4 text-center text-sm text-muted-foreground">You have unsaved changes</p>
            }
        </div>

        <DialogFooterCn Class="flex-col sm:flex-row gap-2">
            <ButtonCn Class="sm:mr-auto" Disabled="@(!HasChanges || _isSaving)" Variant="ButtonVariant.Ghost" @onclick="HandleReset">
                <LucideRotateCcwCn Class="mr-2 h-4 w-4" Size="16" />
                Reset
            </ButtonCn>
            <ButtonCn Disabled="@_isSaving" Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn Disabled="@(!HasChanges || _isSaving)" @onclick="HandleSave">
                @if (_isSaving)
                {
                    <LucideLoaderCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Saving...</span>
                }
                else
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Save Order</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record Item(string Id, string Label, string? Description);

    private static readonly Item[] _defaultItems =
    [
        new("1", "Dashboard", "Main overview"),
        new("2", "Projects", "Your work"),
        new("3", "Tasks", "To-do items"),
        new("4", "Calendar", "Schedule"),
        new("5", "Messages", "Communications"),
        new("6", "Settings", "Preferences")
    ];

    private bool _open;
    private List<Item> _items = _defaultItems.ToList();
    private bool _isSaving;

    private bool HasChanges => !_items.SequenceEqual(_defaultItems);

    private void MoveItem(int index, string direction)
    {
        var newIndex = direction == "up" ? index - 1 : index + 1;
        if (newIndex < 0 || newIndex >= _items.Count) return;
        (_items[index], _items[newIndex]) = (_items[newIndex], _items[index]);
    }

    private void HandleReset()
    {
        _items = _defaultItems.ToList();
    }

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isSaving = false;
        _open = false;
    }
}
