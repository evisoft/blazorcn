@* ========================================
   Block: dialog-poll-create
   Title: Dialog Poll Create
   Description: Poll creation dialog with question input, multiple choice options, voting settings, duration picker, and preview
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideBarChart3Cn, LucideCheckCn, LucideClockCn, LucideEyeCn, LucideGripVerticalCn, LucidePlusCn, LucideUsersCn, LucideXCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn, SwitchCn
   Source: original/blocks/dialog/dialog-poll-create.tsx
   ======================================== *@

@* Note: BarChart3 mapped to LucideChartBarCn (lucide renamed it), Users mapped to LucideUsersCn *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideChartBarCn Class="mr-2 h-4 w-4" Size="16" />
                Create Poll
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_created)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-2">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Poll Created!</DialogTitleCn>
                <DialogDescriptionCn>Your poll is now live and ready for responses.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4">
                <div class="rounded-lg border p-4 space-y-3">
                    <p class="font-medium">@_question</p>
                    <div class="space-y-2">
                        @{ var idx = 0; }
                        @foreach (var option in FilledOptions)
                        {
                            idx++;
                            <div class="flex items-center gap-2 text-sm">
                                <div class="h-4 w-4 rounded-full border flex items-center justify-center">
                                    <span class="text-xs text-muted-foreground">@idx</span>
                                </div>
                                <span>@option.Text</span>
                            </div>
                        }
                    </div>
                    <SeparatorCn />
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span class="flex items-center gap-1">
                            <LucideClockCn Class="h-3 w-3" Size="12" />
                            @SelectedDurationLabel
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideUsersCn Class="h-3 w-3" Size="12" />
                            @(_allowMultiple ? "Multiple choice" : "Single choice")
                        </span>
                    </div>
                </div>
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Create Another</ButtonCn>
                <ButtonCn @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideChartBarCn Class="h-5 w-5" Size="20" />
                    Create Poll
                </DialogTitleCn>
                <DialogDescriptionCn>Ask a question and let people vote on options.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn For="question">Question</LabelCn>
                    <InputCn Id="question" Placeholder="What would you like to ask?" Value="@_question" ValueChanged="@(v => _question = v)" />
                    <p class="text-xs text-muted-foreground text-right">@_question.Length/280</p>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn>Options</LabelCn>
                        <span class="text-xs text-muted-foreground">@_options.Count/6</span>
                    </div>
                    <div class="space-y-2">
                        @for (var i = 0; i < _options.Count; i++)
                        {
                            var index = i;
                            var option = _options[i];
                            <div class="flex items-center gap-2">
                                <LucideGripVerticalCn Class="h-4 w-4 text-muted-foreground shrink-0 cursor-grab" Size="16" />
                                <InputCn Placeholder="@($"Option {index + 1}")"
                                         Value="@option.Text"
                                         ValueChanged="@(v => UpdateOption(option.Id, v))" />
                                @if (_options.Count > 2)
                                {
                                    <ButtonCn Class="h-8 w-8 shrink-0"
                                              Size="ButtonSize.Icon"
                                              Variant="ButtonVariant.Ghost"
                                              @onclick="@(() => RemoveOption(option.Id))">
                                        <LucideXCn Class="h-4 w-4" Size="16" />
                                    </ButtonCn>
                                }
                            </div>
                        }
                    </div>
                    @if (_options.Count < 6)
                    {
                        <ButtonCn Class="w-full" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="AddOption">
                            <LucidePlusCn Class="mr-2 h-4 w-4" Size="16" />
                            Add Option
                        </ButtonCn>
                    }
                </div>

                <SeparatorCn />

                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <LabelCn For="duration">Poll Duration</LabelCn>
                        <SelectCn Value="@_duration" ValueChanged="@(v => _duration = v)">
                            <SelectTriggerCn Class="w-[120px]">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var d in _durations)
                                {
                                    <SelectItemCn Value="@d.Value">@d.Label</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="space-y-0.5">
                            <LabelCn For="multiple">Allow multiple choices</LabelCn>
                            <p class="text-xs text-muted-foreground">Voters can select more than one option</p>
                        </div>
                        <SwitchCn Checked="_allowMultiple" CheckedChanged="@(v => _allowMultiple = v)" Id="multiple" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="space-y-0.5">
                            <LabelCn For="results">Show results</LabelCn>
                            <p class="text-xs text-muted-foreground">Display votes before poll ends</p>
                        </div>
                        <SwitchCn Checked="_showResults" CheckedChanged="@(v => _showResults = v)" Id="results" />
                    </div>
                </div>

                @if (IsValid)
                {
                    <SeparatorCn />
                    <div class="rounded-lg border bg-muted/30 p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <LucideEyeCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span class="text-sm font-medium">Preview</span>
                        </div>
                        <p class="text-sm mb-2">@_question</p>
                        <div class="space-y-1.5">
                            @foreach (var option in FilledOptions)
                            {
                                <div class="flex items-center gap-2 text-sm">
                                    <div class="@Cn.Merge("h-4 w-4 border", _allowMultiple ? "rounded" : "rounded-full")"></div>
                                    <span class="text-muted-foreground">@option.Text</span>
                                </div>
                            }
                        </div>
                        <div class="flex items-center gap-2 mt-2">
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                <LucideClockCn Class="mr-1 h-3 w-3" Size="12" />
                                @SelectedDurationLabel
                            </BadgeCn>
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                @(_allowMultiple ? "Multiple" : "Single") choice
                            </BadgeCn>
                        </div>
                    </div>
                }
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!IsValid || _isCreating)" @onclick="HandleCreate">
                    @(_isCreating ? "Creating..." : "Create Poll")
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record PollOption(string Id, string Text);
    private record DurationOption(string Value, string Label);

    private static readonly DurationOption[] _durations =
    [
        new("1h", "1 hour"), new("6h", "6 hours"), new("1d", "1 day"),
        new("3d", "3 days"), new("7d", "1 week"), new("custom", "Custom")
    ];

    private bool _open;
    private string _question = "";
    private List<PollOption> _options = [new("1", ""), new("2", "")];
    private string _duration = "1d";
    private bool _allowMultiple;
    private bool _showResults = true;
    private bool _isCreating;
    private bool _created;

    private IEnumerable<PollOption> FilledOptions => _options.Where(o => !string.IsNullOrWhiteSpace(o.Text));
    private bool IsValid => !string.IsNullOrWhiteSpace(_question) && FilledOptions.Count() >= 2;
    private string SelectedDurationLabel => _durations.FirstOrDefault(d => d.Value == _duration)?.Label ?? "";

    private void AddOption()
    {
        if (_options.Count < 6)
            _options.Add(new(Guid.NewGuid().ToString("N")[..8], ""));
    }

    private void RemoveOption(string id)
    {
        if (_options.Count > 2)
            _options.RemoveAll(o => o.Id == id);
    }

    private void UpdateOption(string id, string text)
    {
        var idx = _options.FindIndex(o => o.Id == id);
        if (idx >= 0)
            _options[idx] = _options[idx] with { Text = text };
    }

    private async Task HandleCreate()
    {
        _isCreating = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isCreating = false;
        _created = true;
    }

    private void HandleClose()
    {
        _open = false;
        _question = "";
        _options = [new("1", ""), new("2", "")];
        _duration = "1d";
        _allowMultiple = false;
        _showResults = true;
        _isCreating = false;
        _created = false;
    }
}
