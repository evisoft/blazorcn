@* ========================================
   Block: dialog-file-conflict
   Title: Dialog File Conflict
   Description: File conflict resolution dialog with side-by-side comparison, keep both/replace/skip options for sync conflicts
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCheckCn, LucideCloudCn, LucideFileCn, LucideFileWarningCn, LucideMonitorCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/dialog/dialog-file-conflict.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideFileWarningCn Class="mr-2 h-4 w-4" Size="16" />
                Resolve Conflict
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        @if (_resolved)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-semibold">Conflict Resolved</h3>
                <p class="mt-2 text-sm text-muted-foreground">
                    @(_resolution switch
                    {
                        "keep-both" => "Both versions have been saved.",
                        "keep-local" => "Your local version has been kept.",
                        _ => "The cloud version has been downloaded."
                    })
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn class="flex items-center gap-2">
                    <LucideFileWarningCn Class="h-5 w-5" Size="20" />
                    Sync Conflict
                </DialogTitleCn>
                <DialogDescriptionCn>This file was modified in two places.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                <div class="flex items-center gap-2 rounded-lg border p-3">
                    <LucideFileCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm font-medium">Q4-Report-Final.docx</span>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between rounded-lg border p-3">
                        <div class="flex items-center gap-2">
                            <LucideMonitorCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <div>
                                <p class="text-sm font-medium">Local Version</p>
                                <p class="text-xs text-muted-foreground">2.4 MB &middot; Today at 3:45 PM</p>
                            </div>
                        </div>
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Newer</BadgeCn>
                    </div>

                    <div class="flex items-center justify-between rounded-lg border p-3">
                        <div class="flex items-center gap-2">
                            <LucideCloudCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <div>
                                <p class="text-sm font-medium">Cloud Version</p>
                                <p class="text-xs text-muted-foreground">2.1 MB &middot; Today at 2:30 PM</p>
                            </div>
                        </div>
                    </div>
                </div>

                <RadioGroupCn Class="space-y-3" Value="@_resolution" ValueChanged="@((string v) => _resolution = v)">
                    <div class="flex items-center space-x-3 rounded-lg border p-3 hover:bg-muted cursor-pointer">
                        <RadioGroupItemCn Id="keep-local" Value="keep-local" />
                        <LabelCn Class="flex-1 cursor-pointer" For="keep-local">
                            <span class="font-medium">Keep local version</span>
                            <p class="text-xs text-muted-foreground">
                                Upload your local file and replace the cloud version
                            </p>
                        </LabelCn>
                    </div>
                    <div class="flex items-center space-x-3 rounded-lg border p-3 hover:bg-muted cursor-pointer">
                        <RadioGroupItemCn Id="keep-cloud" Value="keep-cloud" />
                        <LabelCn Class="flex-1 cursor-pointer" For="keep-cloud">
                            <span class="font-medium">Keep cloud version</span>
                            <p class="text-xs text-muted-foreground">
                                Download the cloud file and replace your local version
                            </p>
                        </LabelCn>
                    </div>
                    <div class="flex items-center space-x-3 rounded-lg border p-3 hover:bg-muted cursor-pointer">
                        <RadioGroupItemCn Id="keep-both" Value="keep-both" />
                        <LabelCn Class="flex-1 cursor-pointer" For="keep-both">
                            <span class="font-medium">Keep both versions</span>
                            <p class="text-xs text-muted-foreground">
                                Save local as "Q4-Report-Final (conflict).docx"
                            </p>
                        </LabelCn>
                    </div>
                </RadioGroupCn>
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">
                    Skip
                </ButtonCn>
                <ButtonCn Disabled="@(string.IsNullOrEmpty(_resolution))" @onclick="@(() => _resolved = true)">
                    Resolve
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _resolution = "";
    private bool _resolved;

    private void HandleClose()
    {
        _open = false;
        _resolution = "";
        _resolved = false;
    }
}
