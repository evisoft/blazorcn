@* ========================================
   Block: dialog-new-version
   Title: Dialog New Version
   Description: New version available dialog with changelog display, update now option, remind later, and version comparison
   Dependencies: BadgeCn, ButtonCn, CollapsibleCn, CollapsibleContentCn, CollapsibleTriggerCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideBugCn, LucideChevronRightCn, LucideClockCn, LucideDownloadCn, LucideExternalLinkCn, LucideRefreshCwCn, LucideShieldCn, LucideSparklesCn, LucideZapCn, ScrollAreaCn
   Source: original/blocks/dialog/dialog-new-version.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideRefreshCwCn Class="mr-2 h-4 w-4" Size="16" />
                Check for Updates
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideDownloadCn Class="h-5 w-5" Size="20" />
                New Version Available
            </DialogTitleCn>
            <DialogDescriptionCn>A new version of the app is ready to install.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Version Comparison *@
            <div class="flex items-center justify-center gap-4 rounded-lg border p-4">
                <div class="text-center">
                    <p class="text-xs text-muted-foreground">Current</p>
                    <p class="font-mono font-semibold">2.3.0</p>
                </div>
                <LucideChevronRightCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                <div class="text-center">
                    <p class="text-xs text-muted-foreground">New</p>
                    <p class="font-mono font-semibold text-primary">2.4.0</p>
                </div>
            </div>

            @* Changelog *@
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-medium">What's New</h3>
                    <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">
                        Full release notes
                        <LucideExternalLinkCn Class="ml-1 h-3 w-3" Size="12" />
                    </ButtonCn>
                </div>

                <ScrollAreaCn Class="h-[240px] rounded-lg border p-3">
                    <div class="space-y-4">
                        @foreach (var group in _groupedChanges)
                        {
                            <div class="space-y-2">
                                <div class="flex items-center gap-2">
                                    @group.IconFragment
                                    <span class="text-sm font-medium">@group.Label</span>
                                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@group.Changes.Length</BadgeCn>
                                </div>
                                <ul class="space-y-1 ml-6">
                                    @foreach (var change in group.Changes)
                                    {
                                        <li>
                                            @if (!string.IsNullOrEmpty(change.Description))
                                            {
                                                <CollapsibleCn>
                                                    <CollapsibleTriggerCn Class="flex items-start gap-1 text-sm hover:underline cursor-pointer text-left">
                                                        <span>&bull; @change.Title</span>
                                                    </CollapsibleTriggerCn>
                                                    <CollapsibleContentCn>
                                                        <p class="text-xs text-muted-foreground mt-1 ml-3">@change.Description</p>
                                                    </CollapsibleContentCn>
                                                </CollapsibleCn>
                                            }
                                            else
                                            {
                                                <span class="text-sm">&bull; @change.Title</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </ScrollAreaCn>
            </div>

            @* Security Notice *@
            @if (_groupedChanges.Any(g => g.Type == "security"))
            {
                <div class="flex items-start gap-2 rounded-lg border border-red-500/50 p-3">
                    <LucideShieldCn Class="h-4 w-4 text-red-500 mt-0.5" Size="16" />
                    <div>
                        <p class="text-sm font-medium">Security Update</p>
                        <p class="text-xs text-muted-foreground">This update includes important security fixes. We recommend updating soon.</p>
                    </div>
                </div>
            }
        </div>

        <DialogFooterCn Class="flex-col sm:flex-row gap-2">
            <ButtonCn Class="sm:mr-auto" Disabled="@_isUpdating" Variant="ButtonVariant.Ghost" @onclick="@(() => _open = false)">
                <LucideClockCn Class="mr-2 h-4 w-4" Size="16" />
                Remind Me Later
            </ButtonCn>
            <ButtonCn Disabled="@_isUpdating" Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                Skip This Version
            </ButtonCn>
            <ButtonCn Disabled="@_isUpdating" @onclick="HandleUpdate">
                @if (_isUpdating)
                {
                    <LucideRefreshCwCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    @:Updating...
                }
                else
                {
                    <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                    @:Update Now
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record ChangelogEntry(string Type, string Title, string? Description = null);
    private record ChangeGroup(string Type, string Label, RenderFragment IconFragment, ChangelogEntry[] Changes);

    private readonly ChangeGroup[] _groupedChanges;

    public DialogNewVersion()
    {
        var changelog = new ChangelogEntry[]
        {
            new("feature", "Dark mode support", "New dark theme option in preferences with automatic system detection."),
            new("feature", "Keyboard shortcuts", "Navigate faster with customizable keyboard shortcuts."),
            new("improvement", "50% faster load times", "Optimized performance for large datasets."),
            new("improvement", "Updated dashboard layout"),
            new("fix", "Fixed export functionality", "Resolved issue where CSV exports were missing some columns."),
            new("fix", "Notification delivery improvements"),
            new("security", "Security patches applied", "Important security updates to protect your data."),
        };

        _groupedChanges =
        [
            new("feature", "New",
                builder => { builder.OpenComponent<LucideSparklesCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4 text-primary"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); },
                changelog.Where(c => c.Type == "feature").ToArray()),
            new("improvement", "Improved",
                builder => { builder.OpenComponent<LucideZapCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4 text-blue-500"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); },
                changelog.Where(c => c.Type == "improvement").ToArray()),
            new("fix", "Fix",
                builder => { builder.OpenComponent<LucideBugCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4 text-orange-500"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); },
                changelog.Where(c => c.Type == "fix").ToArray()),
            new("security", "Security",
                builder => { builder.OpenComponent<LucideShieldCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4 text-red-500"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); },
                changelog.Where(c => c.Type == "security").ToArray()),
        ];
    }

    private bool _open;
    private bool _isUpdating;

    private async Task HandleUpdate()
    {
        _isUpdating = true;
        StateHasChanged();
        await Task.Delay(2000);
        _isUpdating = false;
        _open = false;
    }
}
