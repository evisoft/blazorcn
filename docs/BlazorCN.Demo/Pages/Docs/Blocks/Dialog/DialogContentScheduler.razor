@* ========================================
   Block: dialog-content-scheduler
   Title: Dialog Content Scheduler
   Description: Content scheduler dialog with date and time picker, timezone selector, platform toggles, and preview of scheduled posts
   Dependencies: ButtonCn, CalendarCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCalendarCn, LucideCheckCn, LucideClockCn, LucideFacebookCn, LucideGlobeCn, LucideInstagramCn, LucideLinkedinCn, LucideTwitterCn, PopoverCn, PopoverContentCn, PopoverTriggerCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn
   Source: original/blocks/dialog/dialog-content-scheduler.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                Schedule Post
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_saved)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Post Scheduled</DialogTitleCn>
                <DialogDescriptionCn>
                    Your post will be published on @(_selectedDate?.ToString("ddd, MMM d")) at @FormatTime12h(_selectedTime) to @_enabledPlatforms.Count() platform@(_enabledPlatforms.Count() > 1 ? "s" : "").
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="flex justify-center gap-2 py-2">
                @foreach (var platform in _enabledPlatforms)
                {
                    <div class="flex h-10 w-10 items-center justify-center rounded-full border bg-muted/50">
                        @platform.IconFragment
                    </div>
                }
            </div>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideCalendarCn Class="h-5 w-5" Size="20" />
                    Schedule Post
                </DialogTitleCn>
                <DialogDescriptionCn>Choose when and where to publish your content.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-2">
                        <LabelCn>Date</LabelCn>
                        <ButtonCn Class="w-full justify-start text-left font-normal" Variant="ButtonVariant.Outline" @onclick="@(() => _showCalendar = !_showCalendar)">
                            <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                            @(_selectedDate?.ToString("ddd, MMM d") ?? "Pick date")
                        </ButtonCn>
                        @if (_showCalendar)
                        {
                            <div class="border rounded-md p-2">
                                <CalendarCn @bind-SelectedDate="_selectedDate" />
                            </div>
                        }
                    </div>

                    <div class="space-y-2">
                        <LabelCn>Time</LabelCn>
                        <SelectCn Value="@_selectedTime" ValueChanged="@((string v) => _selectedTime = v)">
                            <SelectTriggerCn>
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var time in _timeSlots)
                                {
                                    <SelectItemCn Value="@time">@FormatTime12h(time)</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn>Timezone</LabelCn>
                    <SelectCn Value="@_timezone" ValueChanged="@((string v) => _timezone = v)">
                        <SelectTriggerCn>
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var tz in _timezones)
                            {
                                <SelectItemCn Value="@tz.Value">@tz.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="space-y-3">
                    <LabelCn>Publish to</LabelCn>
                    <div class="space-y-2">
                        @foreach (var platform in _platforms)
                        {
                            var p = platform;
                            <div class="@Cn.Merge("flex items-center justify-between p-3 rounded-lg border transition-colors", p.Enabled ? "border-primary bg-primary/5" : "")">
                                <div class="flex items-center gap-3">
                                    @p.IconFragment
                                    <span class="font-medium text-sm">@p.Name</span>
                                </div>
                                <SwitchCn Checked="@p.Enabled" CheckedChanged="@((bool v) => p.Enabled = v)" />
                            </div>
                        }
                    </div>
                </div>

                @if (_isValid)
                {
                    <div class="flex items-center justify-between p-3 rounded-lg border bg-muted/30">
                        <div class="space-y-0.5">
                            <p class="text-sm font-medium">
                                @(_selectedDate?.ToString("ddd, MMM d")) at @FormatTime12h(_selectedTime)
                            </p>
                            <p class="text-xs text-muted-foreground">
                                @_enabledPlatforms.Count() platform@(_enabledPlatforms.Count() > 1 ? "s" : "")
                            </p>
                        </div>
                    </div>
                }
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!_isValid)" @onclick="HandleSave">Schedule</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _saved;
    private DateTime? _selectedDate = DateTime.Today;
    private string _selectedTime = "09:00";
    private string _timezone = "America/New_York";
    private bool _showCalendar;

    private class Platform
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public RenderFragment? IconFragment { get; init; }
        public bool Enabled { get; set; }
    }

    private readonly Platform[] _platforms;
    private IEnumerable<Platform> _enabledPlatforms => _platforms.Where(p => p.Enabled);
    private bool _isValid => _selectedDate is not null && _enabledPlatforms.Any();

    public DialogContentScheduler()
    {
        _platforms =
        [
            new() { Id = "twitter", Name = "Twitter", IconFragment = @<LucideTwitterCn Class="h-5 w-5 text-sky-500" Size="20" />, Enabled = true },
            new() { Id = "linkedin", Name = "LinkedIn", IconFragment = @<LucideLinkedinCn Class="h-5 w-5 text-blue-600" Size="20" />, Enabled = true },
            new() { Id = "instagram", Name = "Instagram", IconFragment = @<LucideInstagramCn Class="h-5 w-5 text-pink-500" Size="20" />, Enabled = false },
            new() { Id = "facebook", Name = "Facebook", IconFragment = @<LucideFacebookCn Class="h-5 w-5 text-blue-500" Size="20" />, Enabled = false },
        ];
    }

    private static readonly string[] _timeSlots =
    [
        "06:00", "06:30", "07:00", "07:30", "08:00", "08:30", "09:00", "09:30",
        "10:00", "10:30", "11:00", "11:30", "12:00", "12:30", "13:00", "13:30",
        "14:00", "14:30", "15:00", "15:30", "16:00", "16:30", "17:00", "17:30",
        "18:00", "18:30", "19:00", "19:30", "20:00", "20:30", "21:00", "21:30",
    ];

    private record TimezoneInfo(string Value, string Label);
    private static readonly TimezoneInfo[] _timezones =
    [
        new("America/New_York", "Eastern Time (ET)"),
        new("America/Chicago", "Central Time (CT)"),
        new("America/Denver", "Mountain Time (MT)"),
        new("America/Los_Angeles", "Pacific Time (PT)"),
        new("Europe/London", "London (GMT)"),
        new("Europe/Paris", "Paris (CET)"),
        new("Asia/Tokyo", "Tokyo (JST)"),
    ];

    private static string FormatTime12h(string time)
    {
        var parts = time.Split(':');
        var h = int.Parse(parts[0]);
        var ampm = h >= 12 ? "PM" : "AM";
        var hour12 = h % 12 == 0 ? 12 : h % 12;
        return $"{hour12}:{parts[1]} {ampm}";
    }

    private void HandleSave()
    {
        _saved = true;
    }

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _selectedDate = DateTime.Today;
        _selectedTime = "09:00";
        _timezone = "America/New_York";
        _showCalendar = false;
    }
}
