@* ========================================
   Block: dialog-report-content
   Title: Dialog Report Content
   Description: Report content dialog with reason selection radio group, additional details textarea, and submit report button
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCheckCn, LucideFlagCn, RadioGroupCn, RadioGroupItemCn, TextareaCn
   Source: original/blocks/dialog/dialog-report-content.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideFlagCn Class="mr-2 h-4 w-4" Size="16" />
                Report
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        @if (_submitted)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-semibold">Report Submitted</h3>
                <p class="mt-2 text-sm text-muted-foreground">Thanks for helping keep our community safe.</p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Report Content</DialogTitleCn>
                <DialogDescriptionCn>Why are you reporting this?</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <RadioGroupCn Value="@_reason" ValueChanged="@(v => _reason = v)">
                    @foreach (var option in _reportReasons)
                    {
                        <div class="flex items-center space-x-3">
                            <RadioGroupItemCn Id="@option.Value" Value="@option.Value" />
                            <LabelCn Class="text-sm font-normal cursor-pointer" For="@option.Value">
                                @option.Label
                            </LabelCn>
                        </div>
                    }
                </RadioGroupCn>

                <div class="space-y-2">
                    <LabelCn For="details">Additional details (optional)</LabelCn>
                    <TextareaCn Class="min-h-[80px] resize-none" Id="details"
                                Placeholder="Provide any additional context..."
                                Value="@_details" ValueChanged="@(v => _details = v)" />
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(string.IsNullOrEmpty(_reason))" Variant="ButtonVariant.Destructive" @onclick="@(() => _submitted = true)">
                    Submit
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record ReportReason(string Value, string Label);

    private static readonly ReportReason[] _reportReasons =
    [
        new("spam", "Spam or misleading"),
        new("harassment", "Harassment or bullying"),
        new("hate", "Hate speech or symbols"),
        new("violence", "Violence or dangerous content"),
        new("inappropriate", "Nudity or sexual content"),
        new("misinformation", "False information"),
        new("other", "Other")
    ];

    private bool _open;
    private string _reason = "";
    private string _details = "";
    private bool _submitted;

    private void HandleClose()
    {
        _open = false;
        _submitted = false;
        _reason = "";
        _details = "";
    }
}
