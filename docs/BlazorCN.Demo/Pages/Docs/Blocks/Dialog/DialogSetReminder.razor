@* ========================================
   Block: dialog-set-reminder
   Title: Dialog Set Reminder
   Description: Set reminder dialog with date/time picker, recurrence options, notification preferences, and reminder title
   Dependencies: ButtonCn, CalendarCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideBellCn, LucideCalendarCn, LucideLoader2Cn, PopoverCn, PopoverContentCn, PopoverTriggerCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn
   Source: original/blocks/dialog/dialog-set-reminder.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideBellCn Class="mr-2 h-4 w-4" Size="16" />
                Set Reminder
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Set Reminder</DialogTitleCn>
            <DialogDescriptionCn>Schedule a reminder with notifications.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="space-y-2">
                <LabelCn For="reminder-title">Title</LabelCn>
                <InputCn
                    Id="reminder-title"
                    Placeholder="Remind me to..."
                    Value="@_reminderTitle"
                    ValueChanged="@(v => _reminderTitle = v)" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-2">
                    <LabelCn>Date</LabelCn>
                    <PopoverCn @bind-Open="_calendarOpen">
                        <PopoverTriggerCn>
                            <ButtonCn
                                Class="@Cn.Merge("w-full justify-start text-left font-normal", _date == null ? "text-muted-foreground" : "")"
                                Variant="ButtonVariant.Outline">
                                <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                                @(_date?.ToString("MMM d") ?? "Pick date")
                            </ButtonCn>
                        </PopoverTriggerCn>
                        <PopoverContentCn Align="FloatingAlign.Start" Class="w-auto p-0">
                            <CalendarCn Value="@_date" ValueChanged="@((DateTime? d) => { _date = d; _calendarOpen = false; })" />
                        </PopoverContentCn>
                    </PopoverCn>
                </div>

                <div class="space-y-2">
                    <LabelCn>Time</LabelCn>
                    <SelectCn Value="@_time" ValueChanged="@(v => _time = v)">
                        <SelectTriggerCn>
                            <SelectValueCn>@FormatTime(_time)</SelectValueCn>
                        </SelectTriggerCn>
                        <SelectContentCn Class="max-h-[200px]">
                            @foreach (var t in _timeOptions)
                            {
                                <SelectItemCn Value="@t">@FormatTime(t)</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn>Repeat</LabelCn>
                <SelectCn Value="@_recurrence" ValueChanged="@(v => _recurrence = v)">
                    <SelectTriggerCn>
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="none">Does not repeat</SelectItemCn>
                        <SelectItemCn Value="daily">Daily</SelectItemCn>
                        <SelectItemCn Value="weekly">Weekly</SelectItemCn>
                        <SelectItemCn Value="monthly">Monthly</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-3">
                <LabelCn>Notifications</LabelCn>
                <div class="flex items-center justify-between">
                    <span class="text-sm">Push notification</span>
                    <SwitchCn @bind-Checked="_notifyPush" />
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm">Email</span>
                    <SwitchCn @bind-Checked="_notifyEmail" />
                </div>
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@(!CanSave || _isSaving)" @onclick="HandleSave">
                @if (_isSaving)
                {
                    <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Set Reminder</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _reminderTitle = "";
    private DateTime? _date;
    private string _time = "09:00";
    private string _recurrence = "none";
    private bool _calendarOpen;
    private bool _notifyPush = true;
    private bool _notifyEmail;
    private bool _isSaving;

    private bool CanSave => !string.IsNullOrWhiteSpace(_reminderTitle) && _date != null;

    private static readonly string[] _timeOptions =
    [
        "09:00", "09:30", "10:00", "10:30", "11:00", "11:30",
        "12:00", "12:30", "13:00", "13:30", "14:00", "14:30",
        "15:00", "15:30", "16:00", "16:30", "17:00", "17:30",
        "18:00", "19:00", "20:00", "21:00"
    ];

    private static string FormatTime(string time)
    {
        if (DateTime.TryParse($"2000-01-01T{time}", out var dt))
            return dt.ToString("h:mm tt");
        return time;
    }

    private async Task HandleSave()
    {
        if (!CanSave) return;
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isSaving = false;
        _open = false;
    }
}
