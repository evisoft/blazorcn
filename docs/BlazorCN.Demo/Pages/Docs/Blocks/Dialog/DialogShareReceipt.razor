@* ========================================
   Block: dialog-share-receipt
   Title: Dialog Share Receipt
   Description: Share receipt dialog with transaction summary, copy link, and social sharing options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideCopyCn, LucideShare2Cn, SeparatorCn
   Source: original/blocks/dialog/dialog-share-receipt.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
                Share Receipt
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        <DialogHeaderCn>
            <DialogTitleCn>Share Receipt</DialogTitleCn>
            <DialogDescriptionCn>Share this payment confirmation</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4">
            @* Transaction summary *@
            <div class="rounded-md border p-4 text-center">
                <p class="text-3xl font-semibold">$@(_transaction.Amount.ToString("F2"))</p>
                <p class="text-sm text-muted-foreground mt-1">to @_transaction.To</p>
                <SeparatorCn Class="my-3" />
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Date</span>
                    <span>@_transaction.Date</span>
                </div>
                <div class="flex justify-between text-sm mt-1">
                    <span class="text-muted-foreground">ID</span>
                    <span class="font-mono">@_transaction.Id</span>
                </div>
            </div>

            @* Copy link *@
            <div class="mt-4">
                <ButtonCn Class="w-full" @onclick="HandleCopy" Variant="ButtonVariant.Outline">
                    @if (_copied)
                    {
                        <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Copy Link</span>
                    }
                </ButtonCn>
            </div>

            @* Share options *@
            <div class="mt-3 grid grid-cols-3 gap-2">
                <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Message
                </ButtonCn>
                <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Email
                </ButtonCn>
                <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    More
                </ButtonCn>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _copied;

    private record TransactionData(decimal Amount, string To, string Date, string Id);

    private static readonly TransactionData _transaction = new(150.00m, "Alex Morgan", "Dec 10, 2024", "TXN-8294");

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
