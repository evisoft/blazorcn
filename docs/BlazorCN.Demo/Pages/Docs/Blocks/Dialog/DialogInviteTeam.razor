@* ========================================
   Block: dialog-invite-team
   Title: Dialog Invite Team
   Description: Invite team members dialog with email input, role selection, bulk invite support, and pending invitations list
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideClockCn, LucideLoader2Cn, LucideMailCn, LucideRotateCcwCn, LucideSendCn, LucideUserPlusCn, LucideXCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn
   Source: original/blocks/dialog/dialog-invite-team.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideUserPlusCn Class="mr-2 h-4 w-4" Size="16" />
                Invite Team
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideUserPlusCn Class="h-5 w-5" Size="20" />
                Invite Team Members
            </DialogTitleCn>
            <DialogDescriptionCn>Invite colleagues to collaborate on this project.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="space-y-3">
                <div class="space-y-2">
                    <LabelCn for="email">Email address</LabelCn>
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <LucideMailCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                            <InputCn Class="pl-9" id="email" Placeholder="colleague@company.com" type="email"
                                     Value="@_email" ValueChanged="@(v => { _email = v; _error = ""; })" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p class="text-sm text-destructive">@_error</p>
                    }
                </div>

                <div class="space-y-2">
                    <LabelCn for="role">Role</LabelCn>
                    <SelectCn Value="@_role" ValueChanged="@(v => _role = v)">
                        <SelectTriggerCn id="role">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var r in _roles)
                            {
                                <SelectItemCn Value="@r.Id">@r.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    <p class="text-xs text-muted-foreground">
                        @(_roles.FirstOrDefault(r => r.Id == _role)?.Description)
                    </p>
                </div>

                <ButtonCn Class="w-full" Disabled="@(_isSending || string.IsNullOrEmpty(_email))" @onclick="HandleSendInvite">
                    @if (_isSending)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        @:Sending...
                    }
                    else if (_sentSuccess)
                    {
                        <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                        @:Invite Sent!
                    }
                    else
                    {
                        <LucideSendCn Class="mr-2 h-4 w-4" Size="16" />
                        @:Send Invite
                    }
                </ButtonCn>
            </div>

            @if (_pendingInvites.Count > 0)
            {
                <SeparatorCn />

                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <LabelCn Class="text-sm">Pending Invitations</LabelCn>
                        <BadgeCn Variant="BadgeVariant.Secondary">@_pendingInvites.Count</BadgeCn>
                    </div>

                    <div class="space-y-2">
                        @foreach (var invite in _pendingInvites)
                        {
                            <div class="flex items-center justify-between rounded-lg border p-3">
                                <div class="flex items-center gap-3">
                                    <AvatarCn Class="h-8 w-8">
                                        <AvatarFallbackCn Class="text-xs">@GetInitials(invite.Email)</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="space-y-1">
                                        <p class="text-sm font-medium leading-none">@invite.Email</p>
                                        <div class="flex items-center gap-2">
                                            <BadgeCn Class="text-xs" Variant="@GetRoleBadgeVariant(invite.Role)">
                                                @invite.Role
                                            </BadgeCn>
                                            <span class="flex items-center text-xs text-muted-foreground">
                                                <LucideClockCn Class="mr-1 h-3 w-3" Size="12" />
                                                @invite.SentLabel
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1">
                                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" title="Resend invite"
                                              Variant="ButtonVariant.Ghost" @onclick="@(() => HandleResendInvite(invite.Id))">
                                        <LucideRotateCcwCn Class="h-4 w-4" Size="16" />
                                    </ButtonCn>
                                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" title="Cancel invite"
                                              Variant="ButtonVariant.Ghost" @onclick="@(() => HandleCancelInvite(invite.Id))">
                                        <LucideXCn Class="h-4 w-4" Size="16" />
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                Done
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record RoleOption(string Id, string Label, string Description);
    private record PendingInvite(string Id, string Email, string Role, string SentLabel);

    private static readonly RoleOption[] _roles =
    [
        new("admin", "Admin", "Full access to all features"),
        new("member", "Member", "Can edit and create content"),
        new("viewer", "Viewer", "Read-only access"),
    ];

    private bool _open;
    private string _email = "";
    private string _role = "member";
    private List<PendingInvite> _pendingInvites = new()
    {
        new("1", "sarah@example.com", "member", "Yesterday"),
        new("2", "mike@example.com", "viewer", "2 days ago"),
    };
    private bool _isSending;
    private bool _sentSuccess;
    private string _error = "";

    private static string GetInitials(string email) => email[..2].ToUpperInvariant();

    private static BadgeVariant GetRoleBadgeVariant(string role) => role switch
    {
        "admin" => BadgeVariant.Default,
        "member" => BadgeVariant.Secondary,
        _ => BadgeVariant.Outline,
    };

    private async Task HandleSendInvite()
    {
        _error = "";

        if (string.IsNullOrEmpty(_email))
        {
            _error = "Please enter an email address";
            return;
        }

        if (_pendingInvites.Any(i => i.Email.Equals(_email, StringComparison.OrdinalIgnoreCase)))
        {
            _error = "This email has already been invited";
            return;
        }

        _isSending = true;
        StateHasChanged();
        await Task.Delay(1000);

        _pendingInvites.Insert(0, new PendingInvite(Guid.NewGuid().ToString(), _email, _role, "Today"));
        _email = "";
        _isSending = false;
        _sentSuccess = true;
        StateHasChanged();
        await Task.Delay(2000);
        _sentSuccess = false;
    }

    private void HandleResendInvite(string inviteId)
    {
        var idx = _pendingInvites.FindIndex(i => i.Id == inviteId);
        if (idx >= 0)
        {
            var invite = _pendingInvites[idx];
            _pendingInvites[idx] = invite with { SentLabel = "Today" };
        }
    }

    private void HandleCancelInvite(string inviteId)
    {
        _pendingInvites.RemoveAll(i => i.Id == inviteId);
    }
}
