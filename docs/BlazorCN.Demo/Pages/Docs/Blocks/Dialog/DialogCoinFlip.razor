@* ========================================
   Block: dialog-coin-flip
   Title: Dialog Coin Flip
   Description: Coin flip dialog with flip animation, heads or tails result, streak tracking, and flip statistics
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCoinsCn
   Source: original/blocks/dialog/dialog-coin-flip.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCoinsCn Class="mr-2 h-4 w-4" Size="16" />
                Flip Coin
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Coin Flip</DialogTitleCn>
            <DialogDescriptionCn>Tap the coin to flip</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-6 space-y-4">
            @* Coin *@
            <div class="flex justify-center">
                <button
                    type="button"
                    class="@Cn.Merge("w-32 h-32 rounded-full border-2 flex items-center justify-center transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring", _isFlipping ? "animate-pulse" : "", _result is not null ? "border-foreground" : "border-border hover:border-foreground/50")"
                    disabled="@_isFlipping"
                    @onclick="FlipCoin">
                    <span class="@Cn.Merge("text-4xl font-semibold transition-all duration-300", _isFlipping ? "opacity-0 scale-50" : "", _result is null ? "text-muted-foreground" : "")">
                        @(_result is not null ? (_result == "heads" ? "H" : "T") : "?")
                    </span>
                </button>
            </div>

            @* Result text - fixed height *@
            <div class="h-7 flex items-center justify-center">
                @if (_isFlipping)
                {
                    <p class="text-sm text-muted-foreground">Flipping...</p>
                }
                else if (_result is not null)
                {
                    <p class="text-lg font-medium capitalize">@_result</p>
                }
                else
                {
                    <p class="text-sm text-muted-foreground">Tap to flip</p>
                }
            </div>

            @* Stats - fixed height *@
            <div class="h-5 flex items-center justify-center">
                <p class="text-sm text-muted-foreground">
                    @if (_total > 0)
                    {
                        @($"{_heads} heads \u00B7 {_tails} tails")
                    }
                    else
                    {
                        @("\u00A0")
                    }
                </p>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isFlipping;
    private string? _result;
    private int _heads;
    private int _tails;
    private int _total => _heads + _tails;

    private readonly Random _random = new();

    private async Task FlipCoin()
    {
        if (_isFlipping) return;

        _isFlipping = true;
        StateHasChanged();

        await Task.Delay(800);

        var newResult = _random.Next(2) == 0 ? "heads" : "tails";
        _result = newResult;
        _isFlipping = false;

        if (newResult == "heads") _heads++;
        else _tails++;
    }
}
