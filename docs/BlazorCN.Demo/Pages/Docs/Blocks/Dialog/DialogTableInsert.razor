@* ========================================
   Block: dialog-table-insert
   Title: Dialog Table Insert
   Description: Insert table dialog with row/column selector, header options, and visual preview grid
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideLoader2Cn, LucideTableCn, SwitchCn
   Source: original/blocks/dialog/dialog-table-insert.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideTableCn Class="mr-2 h-4 w-4" Size="16" />
                Insert Table
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Insert Table</DialogTitleCn>
            <DialogDescriptionCn>Select size by hovering over the grid.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Size Display *@
            <p class="text-center text-sm text-muted-foreground">
                @DisplayRows &times; @DisplayCols
            </p>

            @* Grid Selector *@
            <div class="flex justify-center" @onmouseleave="@(() => { _hoveredRow = 0; _hoveredCol = 0; })">
                <div class="inline-grid gap-0.5">
                    @for (var rowIndex = 0; rowIndex < MaxRows; rowIndex++)
                    {
                        var row = rowIndex + 1;
                        <div class="flex gap-0.5">
                            @for (var colIndex = 0; colIndex < MaxCols; colIndex++)
                            {
                                var col = colIndex + 1;
                                var r = row;
                                var c = col;
                                var isHovered = _hoveredRow > 0 && _hoveredCol > 0 && r <= _hoveredRow && c <= _hoveredCol;
                                var isSelected = r <= _selectedRows && c <= _selectedCols;
                                var showHighlight = _hoveredRow > 0 ? isHovered : isSelected;

                                <button
                                    type="button"
                                    class="@Cn.Merge("h-5 w-5 rounded-sm border transition-colors", showHighlight ? "bg-primary border-primary" : "border-border hover:border-muted-foreground")"
                                    @onclick="@(() => HandleCellClick(r, c))"
                                    @onmouseenter="@(() => HandleCellHover(r, c))" />
                            }
                        </div>
                    }
                </div>
            </div>

            @* Header Option *@
            <div class="flex items-center justify-between">
                <LabelCn Class="text-sm" For="header">
                    Include header row
                </LabelCn>
                <SwitchCn Id="header" @bind-Checked="_hasHeader" />
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Disabled="@_isInserting" @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@_isInserting" @onclick="HandleInsert">
                @if (_isInserting)
                {
                    <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Inserting...</span>
                }
                else
                {
                    <span>Insert</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private const int MaxRows = 8;
    private const int MaxCols = 8;

    private bool _open;
    private int _hoveredRow;
    private int _hoveredCol;
    private int _selectedRows = 3;
    private int _selectedCols = 3;
    private bool _hasHeader = true;
    private bool _isInserting;

    private int DisplayRows => _hoveredRow > 0 ? _hoveredRow : _selectedRows;
    private int DisplayCols => _hoveredCol > 0 ? _hoveredCol : _selectedCols;

    private void HandleCellHover(int row, int col)
    {
        _hoveredRow = row;
        _hoveredCol = col;
    }

    private void HandleCellClick(int row, int col)
    {
        _selectedRows = row;
        _selectedCols = col;
    }

    private async Task HandleInsert()
    {
        _isInserting = true;
        StateHasChanged();
        await Task.Delay(800);
        _isInserting = false;
        _open = false;
        _selectedRows = 3;
        _selectedCols = 3;
        _hasHeader = true;
    }
}
