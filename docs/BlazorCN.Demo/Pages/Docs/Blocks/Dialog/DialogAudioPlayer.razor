@* ========================================
   Block: dialog-audio-player
   Title: Dialog Audio Player
   Description: Audio player dialog with playback controls, progress bar, and track info
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, SliderCn, LucideMusicCn, LucidePauseCn, LucidePlayCn, LucideSkipBackCn, LucideSkipForwardCn, LucideVolume2Cn
   Source: original/blocks/dialog/dialog-audio-player.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideMusicCn Class="mr-2 h-4 w-4" Size="16" />
                Now Playing
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="p-0" style="max-width: 320px;">
        <DialogTitleCn Class="sr-only">Audio Player</DialogTitleCn>

        @* Album art placeholder *@
        <div class="aspect-square bg-muted flex items-center justify-center">
            <LucideMusicCn Class="h-16 w-16 text-muted-foreground" Size="64" />
        </div>

        <div class="p-4 space-y-4">
            @* Track info *@
            <div class="text-center">
                <h3 class="font-medium">@_track.Title</h3>
                <p class="text-sm text-muted-foreground">@_track.Artist</p>
            </div>

            @* Progress *@
            <div class="space-y-2">
                <SliderCn Max="100" Value="@_progress" ValueChanged="@(v => _progress = v)" />
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>@FormatTime(CurrentTime)</span>
                    <span>@FormatTime(_track.Duration)</span>
                </div>
            </div>

            @* Controls *@
            <div class="flex items-center justify-center gap-2">
                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideSkipBackCn Class="h-5 w-5" Size="20" />
                </ButtonCn>
                <ButtonCn Class="h-12 w-12 rounded-full" @onclick="@(() => _playing = !_playing)" Size="ButtonSize.Icon">
                    @if (_playing)
                    {
                        <LucidePauseCn Class="h-5 w-5" Size="20" />
                    }
                    else
                    {
                        <LucidePlayCn Class="h-5 w-5 ml-0.5" Size="20" />
                    }
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideSkipForwardCn Class="h-5 w-5" Size="20" />
                </ButtonCn>
            </div>

            @* Volume *@
            <div class="flex items-center gap-2">
                <LucideVolume2Cn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <SliderCn Class="flex-1" Max="100" Value="@_volume" ValueChanged="@(v => _volume = v)" />
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _playing;
    private double _progress = 45;
    private double _volume = 80;

    private record Track(string Title, string Artist, int Duration);

    private static readonly Track _track = new("Summer Breeze", "The Wavelengths", 214);

    private double CurrentTime => (_progress / 100) * _track.Duration;

    private static string FormatTime(double seconds)
    {
        var mins = (int)(seconds / 60);
        var secs = (int)(seconds % 60);
        return $"{mins}:{secs:D2}";
    }
}
