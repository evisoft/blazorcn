@* ========================================
   Block: dialog-notification-preferences
   Title: Dialog Notification Preferences
   Description: Notification preferences dialog with channel toggles for email, push, and SMS notifications organized by notification type
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideBellCn, LucideMailCn, LucideMessageSquareCn, LucideSmartphoneCn, SeparatorCn, SwitchCn
   Source: original/blocks/dialog/dialog-notification-preferences.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideBellCn Class="mr-2 h-4 w-4" Size="16" />
                Notification Settings
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn>Notification Preferences</DialogTitleCn>
            <DialogDescriptionCn>Choose how you want to be notified about different activities.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4">
            @* Channel headers *@
            <div class="flex items-center justify-end gap-6 mb-4 pr-1">
                <div class="flex flex-col items-center gap-1">
                    <LucideMailCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-xs text-muted-foreground">Email</span>
                </div>
                <div class="flex flex-col items-center gap-1">
                    <LucideSmartphoneCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-xs text-muted-foreground">Push</span>
                </div>
                <div class="flex flex-col items-center gap-1">
                    <LucideMessageSquareCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-xs text-muted-foreground">SMS</span>
                </div>
            </div>

            <SeparatorCn Class="mb-4" />

            @* Notification settings *@
            <div class="space-y-4">
                @foreach (var setting in _settings)
                {
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1 space-y-1">
                            <LabelCn Class="text-sm font-medium">@setting.Label</LabelCn>
                            <p class="text-xs text-muted-foreground">@setting.Description</p>
                        </div>
                        <div class="flex items-center gap-6">
                            <SwitchCn aria-label="@($"{setting.Label} email notifications")"
                                      Checked="@setting.Email"
                                      CheckedChanged="@(v => ToggleSetting(setting.Id, "email"))" />
                            <SwitchCn aria-label="@($"{setting.Label} push notifications")"
                                      Checked="@setting.Push"
                                      CheckedChanged="@(v => ToggleSetting(setting.Id, "push"))" />
                            <SwitchCn aria-label="@($"{setting.Label} SMS notifications")"
                                      Checked="@setting.Sms"
                                      CheckedChanged="@(v => ToggleSetting(setting.Id, "sms"))" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <DialogFooterCn Class="gap-2 sm:gap-0">
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn @onclick="HandleSave">Save Preferences</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private class NotificationSetting
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Email { get; set; }
        public bool Push { get; set; }
        public bool Sms { get; set; }
    }

    private bool _open;

    private readonly List<NotificationSetting> _settings = new()
    {
        new() { Id = "security", Label = "Security Alerts", Description = "Login attempts, password changes, and suspicious activity", Email = true, Push = true, Sms = true },
        new() { Id = "updates", Label = "Product Updates", Description = "New features, improvements, and release notes", Email = true, Push = false, Sms = false },
        new() { Id = "activity", Label = "Activity Notifications", Description = "Comments, mentions, and team activity", Email = true, Push = true, Sms = false },
        new() { Id = "marketing", Label = "Marketing & Promotions", Description = "Special offers, tips, and newsletters", Email = false, Push = false, Sms = false },
    };

    private void ToggleSetting(string id, string channel)
    {
        var setting = _settings.FirstOrDefault(s => s.Id == id);
        if (setting is null) return;
        switch (channel)
        {
            case "email": setting.Email = !setting.Email; break;
            case "push": setting.Push = !setting.Push; break;
            case "sms": setting.Sms = !setting.Sms; break;
        }
    }

    private void HandleSave() => _open = false;
}
