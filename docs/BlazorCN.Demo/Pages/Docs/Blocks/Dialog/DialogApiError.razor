@* ========================================
   Block: dialog-api-error
   Title: Dialog API Error
   Description: API error dialog with error code display, message details, retry action, copy error info, and support link
   Dependencies: AlertCn, AlertDescriptionCn, BadgeCn, ButtonCn, CollapsibleCn, CollapsibleContentCn, CollapsibleTriggerCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, SeparatorCn, LucideCheckCn, LucideChevronDownCn, LucideChevronUpCn, LucideCircleAlertCn, LucideCopyCn, LucideExternalLinkCn, LucideRefreshCwCn, LucideServerCrashCn
   Source: original/blocks/dialog/dialog-api-error.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCircleAlertCn Class="mr-2 h-4 w-4" Size="16" />
                Show API Error
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideServerCrashCn Class="h-5 w-5 text-red-500" Size="20" />
                Something went wrong
            </DialogTitleCn>
            <DialogDescriptionCn>
                We encountered an error while processing your request.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <AlertCn Variant="AlertVariant.Destructive">
                <LucideCircleAlertCn Class="h-4 w-4" Size="16" />
                <AlertDescriptionCn>@_error.Message</AlertDescriptionCn>
            </AlertCn>

            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="@GetStatusBadgeVariant(_error.Code)">@_error.Code</BadgeCn>
                    <span class="text-sm text-muted-foreground">
                        @(_error.Type[..1].ToUpperInvariant() + _error.Type[1..]) Error
                    </span>
                </div>
            </div>

            <p class="text-sm text-muted-foreground">@_error.Details</p>

            <CollapsibleCn @bind-Open="_showDetails">
                <CollapsibleTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm w-full justify-between" data-variant="ghost" data-size="sm">
                        Technical Details
                        @if (_showDetails)
                        {
                            <LucideChevronUpCn Class="h-4 w-4" Size="16" />
                        }
                        else
                        {
                            <LucideChevronDownCn Class="h-4 w-4" Size="16" />
                        }
                    </CollapsibleTriggerCn>
                <CollapsibleContentCn>
                    <div class="mt-2 rounded-lg border p-3 space-y-2 text-xs font-mono">
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Request ID:</span>
                            <span>@_error.RequestId</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Endpoint:</span>
                            <span>@_error.Endpoint</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Timestamp:</span>
                            <span>@_error.Timestamp.ToString("g")</span>
                        </div>
                    </div>
                </CollapsibleContentCn>
            </CollapsibleCn>

            <SeparatorCn />

            <div class="flex items-center justify-between text-sm">
                <ButtonCn Class="h-8" @onclick="HandleCopyError" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                    @if (_copied)
                    {
                        <LucideCheckCn Class="mr-2 h-3 w-3" Size="12" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Class="mr-2 h-3 w-3" Size="12" />
                        <span>Copy Error Info</span>
                    }
                </ButtonCn>
                <ButtonCn Class="h-8" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">
                    <a href="#" target="_blank" rel="noopener noreferrer">
                        Contact Support
                        <LucideExternalLinkCn Class="ml-1 h-3 w-3" Size="12" />
                    </a>
                </ButtonCn>
            </div>
        </div>

        <DialogFooterCn Class="gap-2 sm:gap-0">
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">Dismiss</ButtonCn>
            <ButtonCn Disabled="@_isRetrying" @onclick="HandleRetry">
                @if (_isRetrying)
                {
                    <LucideRefreshCwCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Retrying...</span>
                }
                else
                {
                    <LucideRefreshCwCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Try Again</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isRetrying;
    private bool _copied;
    private bool _showDetails;

    private record ApiError(int Code, string Type, string Message, string Details, string RequestId, DateTime Timestamp, string Endpoint);

    private static readonly ApiError _error = new(
        500, "server", "Internal Server Error",
        "The server encountered an unexpected condition that prevented it from fulfilling the request.",
        "req_1234567890abcdef", DateTime.Now, "/api/users/profile"
    );

    private static BadgeVariant GetStatusBadgeVariant(int code) =>
        code >= 500 ? BadgeVariant.Destructive : code >= 400 ? BadgeVariant.Secondary : BadgeVariant.Outline;

    private async Task HandleRetry()
    {
        _isRetrying = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isRetrying = false;
    }

    private async Task HandleCopyError()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
