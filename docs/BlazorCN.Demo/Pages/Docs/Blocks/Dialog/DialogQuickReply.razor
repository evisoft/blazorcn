@* ========================================
   Block: dialog-quick-reply
   Title: Dialog Quick Reply
   Description: Quick reply template dialog with searchable template list, category filters, variable preview, and one-click insertion
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideCheckCn, LucideMessageSquareCn, LucideSearchCn
   Source: original/blocks/dialog/dialog-quick-reply.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideMessageSquareCn Class="mr-2 h-4 w-4" Size="16" />
                Quick Reply
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Quick Reply</DialogTitleCn>
            <DialogDescriptionCn>Select a template to insert.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-3 py-4">
            <div class="relative">
                <LucideSearchCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                <InputCn Class="pl-9" Placeholder="Search..." Value="@_search" ValueChanged="@(v => _search = v)" />
            </div>

            <div class="h-[200px] overflow-y-auto space-y-1">
                @foreach (var template in FilteredTemplates)
                {
                    <button type="button"
                            class="@Cn.Merge("w-full rounded-lg border p-3 text-left transition-colors", _selected == template.Id ? "border-primary bg-primary/5" : "hover:bg-muted")"
                            @onclick="@(() => _selected = template.Id)">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">@template.Title</span>
                            @if (_selected == template.Id)
                            {
                                <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                            }
                        </div>
                        <p class="text-xs text-muted-foreground mt-1 line-clamp-1">@template.Content</p>
                    </button>
                }
                @if (!FilteredTemplates.Any())
                {
                    <p class="text-sm text-muted-foreground text-center py-8">No templates found</p>
                }
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn Disabled="@(_selected is null)" @onclick="HandleInsert">Insert</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record Template(string Id, string Title, string Content);

    private static readonly Template[] _templates =
    [
        new("1", "Welcome", "Hi! Thanks for reaching out. How can I help you today?"),
        new("2", "Request info", "Could you please provide your order number and email address?"),
        new("3", "Troubleshooting", "Let me help you troubleshoot this. Could you try the following steps?"),
        new("4", "Refund processed", "I've processed your refund. Please allow 5-7 business days for it to appear."),
        new("5", "Issue resolved", "I'm glad we could resolve this! Is there anything else I can help with?"),
        new("6", "Follow-up", "I'll follow up with you via email within 24 hours. Thank you for your patience!")
    ];

    private bool _open;
    private string _search = "";
    private string? _selected;

    private IEnumerable<Template> FilteredTemplates =>
        string.IsNullOrEmpty(_search)
            ? _templates
            : _templates.Where(t =>
                t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                t.Content.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleInsert()
    {
        _open = false;
    }
}
