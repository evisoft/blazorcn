@* ========================================
   Block: dialog-password-generator
   Title: Dialog Password Generator
   Description: Password generator dialog with length slider, character type toggles, strength indicator, regenerate button, and copy functionality
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCheckCn, LucideCopyCn, LucideEyeCn, LucideEyeOffCn, LucideKeyRoundCn, LucideRefreshCwCn, LucideShieldAlertCn, LucideShieldCheckCn, LucideShieldCn, ProgressCn, SliderCn, SwitchCn
   Source: original/blocks/dialog/dialog-password-generator.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideKeyRoundCn Class="mr-2 h-4 w-4" Size="16" />
                Generate Password
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideKeyRoundCn Class="h-5 w-5" Size="20" />
                Password Generator
            </DialogTitleCn>
            <DialogDescriptionCn>Generate a secure password with custom options.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Generated Password *@
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <LabelCn>Generated Password</LabelCn>
                    <ButtonCn Class="h-8 w-8"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              @onclick="@(() => _showPassword = !_showPassword)">
                        @if (_showPassword)
                        {
                            <LucideEyeOffCn Class="h-4 w-4" Size="16" />
                        }
                        else
                        {
                            <LucideEyeCn Class="h-4 w-4" Size="16" />
                        }
                    </ButtonCn>
                </div>
                <div class="flex gap-2">
                    <div class="flex-1 rounded-md border bg-muted/50 px-3 py-2 font-mono text-sm overflow-hidden">
                        <span class="@Cn.Merge(!_showPassword ? "blur-sm select-none" : "")">@_password</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="GeneratePassword" title="Regenerate">
                        <LucideRefreshCwCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="HandleCopy" title="Copy">
                        @if (_copied)
                        {
                            <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                        }
                        else
                        {
                            <LucideCopyCn Class="h-4 w-4" Size="16" />
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Password Strength *@
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <LabelCn>Password Strength</LabelCn>
                    <BadgeCn Class="@Cn.Merge("gap-1", StrengthColor)" Variant="BadgeVariant.Outline">
                        @if (StrengthLevel is "excellent" or "strong")
                        {
                            <LucideShieldCheckCn Class="h-4 w-4" Size="16" />
                        }
                        else if (StrengthLevel == "good")
                        {
                            <LucideShieldCn Class="h-4 w-4" Size="16" />
                        }
                        else
                        {
                            <LucideShieldAlertCn Class="h-4 w-4" Size="16" />
                        }
                        <span class="capitalize">@StrengthLevel</span>
                    </BadgeCn>
                </div>
                <ProgressCn Class="h-2" Value="@StrengthScore" />
            </div>

            @* Length Slider *@
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <LabelCn>Length: @_length characters</LabelCn>
                </div>
                <SliderCn Class="w-full" Min="8" Max="32" Step="1" Value="@((double)_length)" ValueChanged="@((double v) => HandleLengthChange((int)v))" />
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>8</span>
                    <span>16</span>
                    <span>24</span>
                    <span>32</span>
                </div>
            </div>

            @* Character Types *@
            <div class="space-y-3">
                <LabelCn>Character Types</LabelCn>
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <div class="space-y-0.5">
                            <LabelCn Class="text-sm font-normal" For="uppercase">Uppercase (A-Z)</LabelCn>
                        </div>
                        <SwitchCn Checked="_uppercase"
                                  CheckedChanged="@(v => HandleOptionChange("uppercase", v))"
                                  Disabled="@(ActiveOptionsCount == 1 && _uppercase)"
                                  Id="uppercase" />
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="space-y-0.5">
                            <LabelCn Class="text-sm font-normal" For="lowercase">Lowercase (a-z)</LabelCn>
                        </div>
                        <SwitchCn Checked="_lowercase"
                                  CheckedChanged="@(v => HandleOptionChange("lowercase", v))"
                                  Disabled="@(ActiveOptionsCount == 1 && _lowercase)"
                                  Id="lowercase" />
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="space-y-0.5">
                            <LabelCn Class="text-sm font-normal" For="numbers">Numbers (0-9)</LabelCn>
                        </div>
                        <SwitchCn Checked="_numbers"
                                  CheckedChanged="@(v => HandleOptionChange("numbers", v))"
                                  Disabled="@(ActiveOptionsCount == 1 && _numbers)"
                                  Id="numbers" />
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="space-y-0.5">
                            <LabelCn Class="text-sm font-normal" For="symbols">Symbols (!@@#$%...)</LabelCn>
                        </div>
                        <SwitchCn Checked="_symbols"
                                  CheckedChanged="@(v => HandleOptionChange("symbols", v))"
                                  Disabled="@(ActiveOptionsCount == 1 && _symbols)"
                                  Id="symbols" />
                    </div>
                </div>
            </div>

            @if (_copied)
            {
                <div class="flex items-center justify-center gap-2 text-sm text-primary">
                    <LucideCheckCn Class="h-4 w-4" Size="16" />
                    <span>Password copied to clipboard!</span>
                </div>
            }
        </div>

        <DialogFooterCn Class="gap-2 sm:gap-0">
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Close</ButtonCn>
            <ButtonCn @onclick="HandleCopy">
                <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                Copy Password
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private const string Uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    private const string Lowercase = "abcdefghijklmnopqrstuvwxyz";
    private const string Numbers = "0123456789";
    private const string Symbols = "!@#$%^&*()_+-=[]{}|;:,.<>?";

    private bool _open;
    private string _password = "";
    private int _length = 16;
    private bool _uppercase = true;
    private bool _lowercase = true;
    private bool _numbers = true;
    private bool _symbols = true;
    private bool _showPassword = true;
    private bool _copied;

    private int ActiveOptionsCount =>
        (_uppercase ? 1 : 0) + (_lowercase ? 1 : 0) + (_numbers ? 1 : 0) + (_symbols ? 1 : 0);

    private int StrengthScore
    {
        get
        {
            var score = 0;
            if (_length >= 8) score += 20;
            if (_length >= 12) score += 20;
            if (_length >= 16) score += 20;
            if (_length >= 20) score += 10;
            score += ActiveOptionsCount * 10;
            return Math.Min(score, 100);
        }
    }

    private string StrengthLevel => StrengthScore switch
    {
        >= 80 => "excellent",
        >= 60 => "strong",
        >= 40 => "good",
        >= 20 => "fair",
        _ => "weak"
    };

    private string StrengthColor => StrengthLevel switch
    {
        "excellent" or "strong" => "text-primary",
        "good" => "text-primary/80",
        "fair" => "text-orange-500",
        _ => "text-destructive"
    };

    protected override void OnParametersSet()
    {
        if (_open && string.IsNullOrEmpty(_password))
            GeneratePassword();
    }

    private void GeneratePassword()
    {
        var charset = "";
        if (_uppercase) charset += Uppercase;
        if (_lowercase) charset += Lowercase;
        if (_numbers) charset += Numbers;
        if (_symbols) charset += Symbols;
        if (charset == "") charset = Lowercase;

        var random = new Random();
        _password = new string(Enumerable.Range(0, _length)
            .Select(_ => charset[random.Next(charset.Length)]).ToArray());
    }

    private void HandleLengthChange(int value)
    {
        _length = value;
        GeneratePassword();
    }

    private void HandleOptionChange(string option, bool value)
    {
        var newUppercase = option == "uppercase" ? value : _uppercase;
        var newLowercase = option == "lowercase" ? value : _lowercase;
        var newNumbers = option == "numbers" ? value : _numbers;
        var newSymbols = option == "symbols" ? value : _symbols;

        if ((newUppercase ? 1 : 0) + (newLowercase ? 1 : 0) + (newNumbers ? 1 : 0) + (newSymbols ? 1 : 0) > 0)
        {
            _uppercase = newUppercase;
            _lowercase = newLowercase;
            _numbers = newNumbers;
            _symbols = newSymbols;
            GeneratePassword();
        }
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }

    private void HandleClose()
    {
        _open = false;
        _copied = false;
    }
}
