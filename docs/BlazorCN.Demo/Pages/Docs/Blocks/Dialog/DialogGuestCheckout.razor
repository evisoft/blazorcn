@* ========================================
   Block: dialog-guest-checkout
   Title: Dialog Guest Checkout
   Description: Guest checkout dialog with email capture, account benefits preview, and continue options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideArrowRightCn, LucideCheckCn, LucideShoppingBagCn, SeparatorCn
   Source: original/blocks/dialog/dialog-guest-checkout.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideShoppingBagCn Class="mr-2 h-4 w-4" Size="16" />
                Checkout
            </DialogTriggerCn>
    </div>
    <DialogContentCn Style="max-width: 384px">
        <DialogHeaderCn>
            <DialogTitleCn>Checkout</DialogTitleCn>
            <DialogDescriptionCn>Continue as guest or sign in</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4 space-y-4">
            @* Guest checkout *@
            <div class="space-y-3">
                <LabelCn Class="text-sm" For="email">
                    Email for order updates
                </LabelCn>
                <InputCn id="email" Placeholder="you@example.com" type="email" @bind-Value="_email" />
                <ButtonCn Class="w-full" Disabled="@(string.IsNullOrEmpty(_email))" @onclick="HandleContinue">
                    Continue as Guest
                    <LucideArrowRightCn Class="ml-2 h-4 w-4" Size="16" />
                </ButtonCn>
            </div>

            <div class="relative">
                <SeparatorCn />
                <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-background px-2 text-xs text-muted-foreground">
                    or
                </span>
            </div>

            @* Sign in option *@
            <div class="space-y-3">
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    Sign In
                </ButtonCn>
                <div class="text-center">
                    <p class="text-xs text-muted-foreground mb-2">Create account for:</p>
                    <div class="flex justify-center gap-4">
                        @foreach (var benefit in _benefits)
                        {
                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideCheckCn Class="h-3 w-3" Size="12" />
                                @benefit
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private static readonly string[] _benefits = ["Order tracking", "Faster checkout", "Exclusive offers"];

    private bool _open;
    private string _email = "";

    private void HandleContinue()
    {
        _open = false;
    }
}
