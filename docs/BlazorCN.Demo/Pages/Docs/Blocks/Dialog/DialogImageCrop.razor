@* ========================================
   Block: dialog-image-crop
   Title: Dialog Image Crop
   Description: Image cropping dialog with aspect ratio selection, zoom control, rotation, and preview for avatar or thumbnail uploads
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCheckCn, LucideCropCn, LucideCircleCn, LucideRectangleHorizontalCn, LucideRectangleVerticalCn, LucideRefreshCwCn, LucideRotateCcwCn, LucideRotateCwCn, LucideSquareCn, LucideUploadCn, LucideZoomInCn, LucideZoomOutCn, SeparatorCn, SliderCn, ToggleGroupCn, ToggleGroupItemCn
   Source: original/blocks/dialog/dialog-image-crop.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCropCn Class="mr-2 h-4 w-4" Size="16" />
                Crop Image
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideCropCn Class="h-5 w-5" Size="20" />
                Crop Image
            </DialogTitleCn>
            <DialogDescriptionCn>Adjust the crop area, zoom, and rotation</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Crop Preview Area *@
            <div class="relative aspect-square w-full overflow-hidden rounded-lg border bg-muted">
                <div class="absolute inset-0 flex items-center justify-center"
                     style="transform: scale(@_zoom.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)) rotate(@(_rotation)deg); transition: transform 0.2s ease-out;">
                    <div class="h-64 w-64 bg-gradient-to-br from-blue-100 to-purple-100 flex items-center justify-center text-muted-foreground">
                        <LucideUploadCn Class="h-12 w-12" Size="48" />
                    </div>
                </div>

                <div class="absolute inset-0 pointer-events-none">
                    <div class="absolute inset-0 bg-black/50" />
                    <div class="@Cn.Merge("absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 border-2 border-white bg-transparent", _aspectRatio == "circle" ? "rounded-full" : "rounded-sm")"
                         style="@GetCropWindowStyle()">
                        @if (_aspectRatio != "circle")
                        {
                            <div class="absolute left-1/3 top-0 bottom-0 w-px bg-white/30"></div>
                            <div class="absolute left-2/3 top-0 bottom-0 w-px bg-white/30"></div>
                            <div class="absolute top-1/3 left-0 right-0 h-px bg-white/30"></div>
                            <div class="absolute top-2/3 left-0 right-0 h-px bg-white/30"></div>
                        }
                        <div class="absolute -left-1 -top-1 h-3 w-3 border-l-2 border-t-2 border-white"></div>
                        <div class="absolute -right-1 -top-1 h-3 w-3 border-r-2 border-t-2 border-white"></div>
                        <div class="absolute -left-1 -bottom-1 h-3 w-3 border-l-2 border-b-2 border-white"></div>
                        <div class="absolute -right-1 -bottom-1 h-3 w-3 border-r-2 border-b-2 border-white"></div>
                    </div>
                </div>
            </div>

            @* Aspect Ratio Selection *@
            <div class="space-y-2">
                <LabelCn>Aspect Ratio</LabelCn>
                <ToggleGroupCn Class="flex flex-wrap justify-start gap-1" Type="ToggleGroupType.Single" Value="@_aspectRatio" ValueChanged="@(v => { if (!string.IsNullOrEmpty(v)) _aspectRatio = v; })">
                    @foreach (var ratio in _aspectRatios)
                    {
                        <ToggleGroupItemCn aria-label="@ratio.Label" Class="flex items-center gap-1.5 px-3" Value="@ratio.Id">
                            @ratio.IconFragment
                            <span class="text-xs">@ratio.Label</span>
                        </ToggleGroupItemCn>
                    }
                </ToggleGroupCn>
            </div>

            <SeparatorCn />

            @* Zoom Control *@
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <LabelCn>Zoom</LabelCn>
                    <span class="text-sm text-muted-foreground">@(Math.Round(_zoom * 100))%</span>
                </div>
                <div class="flex items-center gap-3">
                    <LucideZoomOutCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <SliderCn Class="flex-1" Max="3" Min="0.5" Step="0.1" Value="@_zoom" ValueChanged="@(v => _zoom = v)" />
                    <LucideZoomInCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                </div>
            </div>

            @* Rotation Control *@
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <LabelCn>Rotation</LabelCn>
                    <span class="text-sm text-muted-foreground">@(_rotation)°</span>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="@(() => HandleRotate("ccw"))" aria-label="Undo">
                        <LucideRotateCcwCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                    <SliderCn Class="flex-1" Max="180" Min="-180" Step="1" Value="@((double)_rotation)" ValueChanged="@(v => _rotation = (int)v)" />
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="@(() => HandleRotate("cw"))" aria-label="Redo">
                        <LucideRotateCwCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <DialogFooterCn Class="flex-col sm:flex-row gap-2">
            <ButtonCn Class="sm:mr-auto" Disabled="@_isApplying" Variant="ButtonVariant.Ghost" @onclick="HandleReset">
                <LucideRefreshCwCn Class="mr-2 h-4 w-4" Size="16" />
                Reset
            </ButtonCn>
            <ButtonCn Disabled="@_isApplying" Variant="ButtonVariant.Outline" @onclick="HandleClose">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@_isApplying" @onclick="HandleApply">
                @if (_isApplying)
                {
                    <LucideRefreshCwCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    @:Applying...
                }
                else
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    @:Apply Crop
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record AspectRatioOption(string Id, string Label, double? Value, RenderFragment IconFragment);

    private readonly AspectRatioOption[] _aspectRatios;

    public DialogImageCrop()
    {
        _aspectRatios =
        [
            new("free", "Free", null, builder => { builder.OpenComponent<LucideCropCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("square", "1:1", 1, builder => { builder.OpenComponent<LucideSquareCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("portrait", "4:5", 4.0 / 5.0, builder => { builder.OpenComponent<LucideRectangleVerticalCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("landscape", "16:9", 16.0 / 9.0, builder => { builder.OpenComponent<LucideRectangleHorizontalCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("circle", "Circle", 1, builder => { builder.OpenComponent<LucideCircleCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
        ];
    }

    private bool _open;
    private double _zoom = 1;
    private int _rotation;
    private string _aspectRatio = "square";
    private bool _isApplying;

    private string GetCropWindowStyle()
    {
        var selected = _aspectRatios.FirstOrDefault(a => a.Id == _aspectRatio);
        var width = selected?.Value is not null
            ? (selected.Value >= 1 ? "60%" : $"{60 * selected.Value:F0}%")
            : "60%";
        var aspect = selected?.Value is not null
            ? selected.Value.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)
            : "auto";
        return $"width: {width}; aspect-ratio: {aspect}; box-shadow: 0 0 0 9999px rgba(0,0,0,0.5);";
    }

    private void HandleRotate(string direction)
    {
        var newRotation = direction == "cw" ? _rotation + 90 : _rotation - 90;
        _rotation = newRotation % 360;
    }

    private void HandleReset()
    {
        _zoom = 1;
        _rotation = 0;
        _aspectRatio = "square";
    }

    private async Task HandleApply()
    {
        _isApplying = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isApplying = false;
        _open = false;
    }

    private void HandleClose()
    {
        _open = false;
        HandleReset();
    }
}
