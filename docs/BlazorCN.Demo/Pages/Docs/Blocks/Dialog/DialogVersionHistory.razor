@* ========================================
   Block: dialog-version-history
   Title: Dialog Version History
   Description: Version history dialog with timeline of changes, diff preview, restore functionality, and author attribution
   Long Description: User preferences dialog with theme selection, display density, default views, and personalization options
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideHistoryCn, LucideRotateCcwCn, ScrollAreaCn
   Source: original/blocks/dialog/dialog-version-history.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideHistoryCn Class="mr-2 h-4 w-4" Size="16" />
                Version History
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_restored)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Version Restored</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    Restored to @(_versions.FirstOrDefault(v => v.Id == _selectedVersion)?.Timestamp)
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Version History</DialogTitleCn>
                <DialogDescriptionCn>Select a version to restore.</DialogDescriptionCn>
            </DialogHeaderCn>

            <ScrollAreaCn Class="h-[250px] -mx-6 px-6">
                <div class="space-y-1">
                    @foreach (var version in _versions)
                    {
                        <button type="button"
                                class="@Cn.Merge("w-full text-left rounded-md p-2 transition-colors", _selectedVersion == version.Id ? "bg-muted" : "hover:bg-muted/50")"
                                @onclick="@(() => _selectedVersion = version.Id)">
                            <div class="flex items-center gap-3">
                                <AvatarCn Class="h-7 w-7">
                                    @if (!string.IsNullOrEmpty(version.Avatar))
                                    {
                                        <AvatarImageCn Alt="@version.AuthorName" Src="@version.Avatar" />
                                    }
                                    <AvatarFallbackCn Class="text-xs">@version.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium truncate">@version.Changes</span>
                                        @if (version.Current)
                                        {
                                            <BadgeCn Class="text-xs shrink-0" Variant="BadgeVariant.Secondary">
                                                Current
                                            </BadgeCn>
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">
                                        @version.AuthorName &middot; @version.Timestamp
                                    </p>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </ScrollAreaCn>

            <DialogFooterCn>
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">
                    Cancel
                </ButtonCn>
                <ButtonCn Disabled="@(string.IsNullOrEmpty(_selectedVersion) || _selectedVersion == "v8")" @onclick="@(() => _restored = true)">
                    <LucideRotateCcwCn Class="mr-2 h-4 w-4" Size="16" />
                    Restore
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record VersionEntry(string Id, string Timestamp, string AuthorName, string Avatar, string Initials, string Changes, bool Current = false);

    private static readonly VersionEntry[] _versions =
    [
        new("v8", "2 minutes ago", "You", "", "YO", "Updated pricing section", true),
        new("v7", "1 hour ago", "Sarah Chen", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&auto=format&fit=crop", "SC", "Added new testimonial"),
        new("v6", "3 hours ago", "Alex Morgan", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&auto=format&fit=crop", "AM", "Fixed typos in header"),
        new("v5", "Yesterday", "You", "", "YO", "Rewrote introduction paragraph"),
        new("v4", "2 days ago", "Sarah Chen", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&auto=format&fit=crop", "SC", "Added feature comparison table"),
    ];

    private bool _open;
    private string? _selectedVersion;
    private bool _restored;

    private void HandleClose()
    {
        _open = false;
        _selectedVersion = null;
        _restored = false;
    }
}
