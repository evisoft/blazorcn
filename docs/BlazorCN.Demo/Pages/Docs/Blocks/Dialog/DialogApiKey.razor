@* ========================================
   Block: dialog-api-key
   Title: Dialog API Key
   Description: API key management dialog with key generation, copy functionality, permission scopes, and expiration settings
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn, LucideCheckCn, LucideCopyCn, LucideEyeCn, LucideEyeOffCn, LucideKeyCn, LucideRefreshCwCn, LucideShieldCn, LucideTriangleAlertCn
   Source: original/blocks/dialog/dialog-api-key.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideKeyCn Class="mr-2 h-4 w-4" Size="16" />
                Generate API Key
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideShieldCn Class="h-5 w-5" Size="20" />
                @(string.IsNullOrEmpty(_generatedKey) ? "Create API Key" : "API Key Generated")
            </DialogTitleCn>
            <DialogDescriptionCn>
                @(string.IsNullOrEmpty(_generatedKey)
                    ? "Generate a new API key with specific permissions and expiration."
                    : "Your new API key has been created. Copy it now\u2014you won't see it again.")
            </DialogDescriptionCn>
        </DialogHeaderCn>

        @if (!string.IsNullOrEmpty(_generatedKey))
        {
            <div class="py-4 space-y-4">
                <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 dark:border-amber-900 dark:bg-amber-950">
                    <div class="flex items-start gap-2">
                        <LucideTriangleAlertCn Class="h-4 w-4 text-amber-600 mt-0.5" Size="16" />
                        <p class="text-sm text-amber-800 dark:text-amber-200">
                            Make sure to copy your API key now. You won&apos;t be able to see it again!
                        </p>
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn>Your API Key</LabelCn>
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <InputCn Class="pr-10 font-mono text-sm"
                                     Value="@(_showKey ? _generatedKey : MaskedKey)" />
                            <ButtonCn Class="absolute right-0 top-0 h-full px-3"
                                      @onclick="@(() => _showKey = !_showKey)"
                                      Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Hide">
                                @if (_showKey)
                                {
                                    <LucideEyeOffCn Class="h-4 w-4" Size="16" />
                                }
                                else
                                {
                                    <LucideEyeCn Class="h-4 w-4" Size="16" />
                                }
                            </ButtonCn>
                        </div>
                        <ButtonCn @onclick="HandleCopy" Variant="ButtonVariant.Outline">
                            @if (_copied)
                            {
                                <LucideCheckCn Class="h-4 w-4" Size="16" />
                            }
                            else
                            {
                                <LucideCopyCn Class="h-4 w-4" Size="16" />
                            }
                        </ButtonCn>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary">@(string.IsNullOrEmpty(_keyName) ? "Unnamed key" : _keyName)</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Outline">Expires in @_expiration days</BadgeCn>
                    @foreach (var scope in _selectedScopes)
                    {
                        <BadgeCn Class="capitalize" Variant="BadgeVariant.Outline">@scope</BadgeCn>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="py-4 space-y-4">
                <div class="space-y-2">
                    <LabelCn For="key-name">Key Name</LabelCn>
                    <InputCn Id="key-name" Value="@_keyName" ValueChanged="@((string v) => _keyName = v)"
                             Placeholder="e.g., Production Backend" />
                    <p class="text-xs text-muted-foreground">A descriptive name to identify this key</p>
                </div>

                <div class="space-y-2">
                    <LabelCn For="expiration">Expiration</LabelCn>
                    <SelectCn Value="@_expiration" ValueChanged="@(v => _expiration = v)">
                        <SelectTriggerCn Id="expiration">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="30">30 days</SelectItemCn>
                            <SelectItemCn Value="90">90 days</SelectItemCn>
                            <SelectItemCn Value="365">1 year</SelectItemCn>
                            <SelectItemCn Value="never">Never expires</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <SeparatorCn />

                <div class="space-y-3">
                    <LabelCn>Permissions</LabelCn>
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var scope in _scopes)
                        {
                            var isSelected = _selectedScopes.Contains(scope.Id);
                            <label for="@scope.Id"
                                   class="@Cn.Merge("flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors", isSelected ? "border-primary bg-primary/5" : "hover:bg-muted")">
                                <CheckboxCn Checked="@isSelected" Id="@scope.Id"
                                            CheckedChanged="@(v => ToggleScope(scope.Id))" />
                                <div>
                                    <p class="text-sm font-medium">@scope.Label</p>
                                    <p class="text-xs text-muted-foreground">@scope.Description</p>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>
        }

        <DialogFooterCn>
            @if (!string.IsNullOrEmpty(_generatedKey))
            {
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            }
            else
            {
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">Cancel</ButtonCn>
                <ButtonCn Disabled="@(_selectedScopes.Count == 0)" @onclick="GenerateKey">
                    <LucideRefreshCwCn Class="mr-2 h-4 w-4" Size="16" />
                    Generate Key
                </ButtonCn>
            }
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _keyName = "";
    private string _expiration = "90";
    private HashSet<string> _selectedScopes = new(["read"]);
    private string _generatedKey = "";
    private bool _showKey;
    private bool _copied;

    private record Scope(string Id, string Label, string Description);

    private static readonly Scope[] _scopes =
    [
        new("read", "Read", "Access to read resources"),
        new("write", "Write", "Create and update resources"),
        new("delete", "Delete", "Remove resources permanently"),
        new("admin", "Admin", "Full administrative access"),
    ];

    private string MaskedKey => !string.IsNullOrEmpty(_generatedKey)
        ? $"sk_live_{new string('\u2022', 28)}{_generatedKey[^4..]}"
        : "";

    private void GenerateKey()
    {
        var chars = "abcdefghijklmnopqrstuvwxyz0123456789";
        var key = new char[32];
        for (var i = 0; i < 32; i++) key[i] = chars[Random.Shared.Next(chars.Length)];
        _generatedKey = $"sk_live_{new string(key)}";
        _showKey = true;
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private void ToggleScope(string scopeId)
    {
        if (_selectedScopes.Contains(scopeId)) _selectedScopes.Remove(scopeId);
        else _selectedScopes.Add(scopeId);
    }

    private void HandleClose()
    {
        _open = false;
        _keyName = "";
        _expiration = "90";
        _selectedScopes = new(["read"]);
        _generatedKey = "";
        _showKey = false;
    }
}
