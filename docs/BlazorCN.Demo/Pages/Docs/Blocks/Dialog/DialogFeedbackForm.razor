@* ========================================
   Block: dialog-feedback-form
   Title: Dialog Feedback Form
   Description: Quick feedback form dialog with emoji reaction selector, category selection, message input, and optional contact follow-up
   Dependencies: ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCheckCn, LucideLoader2Cn, LucideMessageSquareHeartCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, TextareaCn
   Source: original/blocks/dialog/dialog-feedback-form.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideMessageSquareHeartCn Class="mr-2 h-4 w-4" Size="16" />
                Give Feedback
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        @if (_isSubmitted)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-semibold">Thank you!</h3>
                <p class="mt-2 text-sm text-muted-foreground">Your feedback helps us improve.</p>
                @if (_allowContact)
                {
                    <p class="mt-1 text-xs text-muted-foreground">
                        We may reach out if we have questions.
                    </p>
                }
                <ButtonCn Class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn class="flex items-center gap-2">
                    <LucideMessageSquareHeartCn Class="h-5 w-5" Size="20" />
                    Share Your Feedback
                </DialogTitleCn>
                <DialogDescriptionCn>How are we doing? Let us know what you think.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-6 py-4">
                <div class="space-y-3">
                    <LabelCn>How do you feel about your experience?</LabelCn>
                    <div class="flex justify-center gap-2">
                        @foreach (var option in _emojiOptions)
                        {
                            <button type="button"
                                    class="@Cn.Merge("flex flex-col items-center gap-1.5 rounded-lg border p-3 transition-colors", _selectedEmoji == option.Value ? "border-primary bg-primary/5" : "border-transparent hover:border-border")"
                                    @onclick="@(() => _selectedEmoji = option.Value)">
                                <span class="text-3xl">@option.Emoji</span>
                                <span class="text-xs text-muted-foreground">@option.Label</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="feedback-category">
                        Category <span class="text-muted-foreground">(optional)</span>
                    </LabelCn>
                    <SelectCn Value="@_category" ValueChanged="@((string v) => _category = v)">
                        <SelectTriggerCn id="feedback-category">
                            <SelectValueCn Placeholder="Select a category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="bug">Bug Report</SelectItemCn>
                            <SelectItemCn Value="feature">Feature Request</SelectItemCn>
                            <SelectItemCn Value="improvement">Improvement</SelectItemCn>
                            <SelectItemCn Value="praise">Praise</SelectItemCn>
                            <SelectItemCn Value="other">Other</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="space-y-2">
                    <LabelCn For="feedback-message">
                        Tell us more <span class="text-muted-foreground">(optional)</span>
                    </LabelCn>
                    <TextareaCn id="feedback-message"
                                Placeholder="What's on your mind? Share your thoughts, suggestions, or report an issue..."
                                Rows="4"
                                @bind-Value="_message" />
                    <p class="text-xs text-muted-foreground">@(_message.Length)/500 characters</p>
                </div>

                <label for="allow-contact" class="flex items-center gap-2 cursor-pointer">
                    <CheckboxCn Checked="_allowContact" CheckedChanged="@((bool v) => _allowContact = v)" id="allow-contact" />
                    <span class="text-sm text-muted-foreground">
                        You can contact me about this feedback
                    </span>
                </label>
            </div>

            <div class="flex gap-2">
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline" @onclick="HandleClose">
                    Cancel
                </ButtonCn>
                <ButtonCn Class="flex-1" Disabled="@(string.IsNullOrEmpty(_selectedEmoji) || _isSubmitting)" @onclick="HandleSubmit">
                    @if (_isSubmitting)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Submit</span>
                    }
                </ButtonCn>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record EmojiOption(string Emoji, string Label, string Value);

    private static readonly EmojiOption[] _emojiOptions =
    [
        new("\U0001F621", "Terrible", "terrible"),
        new("\U0001F615", "Bad", "bad"),
        new("\U0001F60A", "Good", "good"),
        new("\U0001F60D", "Amazing", "amazing"),
    ];

    private bool _open;
    private string? _selectedEmoji;
    private string _category = "";
    private string _message = "";
    private bool _allowContact;
    private bool _isSubmitting;
    private bool _isSubmitted;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(_selectedEmoji)) return;

        _isSubmitting = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isSubmitting = false;
        _isSubmitted = true;
    }

    private void HandleClose()
    {
        _open = false;
        _selectedEmoji = null;
        _category = "";
        _message = "";
        _allowContact = false;
        _isSubmitted = false;
    }
}
