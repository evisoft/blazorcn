@* ========================================
   Block: dialog-terms-accept
   Title: Dialog Terms Accept
   Description: Terms acceptance dialog with scrollable terms content, required checkbox agreement, and legal compliance features
   Dependencies: AlertDialogActionCn, AlertDialogCancelCn, AlertDialogCn, AlertDialogContentCn, AlertDialogDescriptionCn, AlertDialogFooterCn, AlertDialogHeaderCn, AlertDialogOverlayCn, AlertDialogTitleCn, AlertDialogTriggerCn, BadgeCn, ButtonCn, CheckboxCn, LabelCn, LucideAlertTriangleCn, LucideCheckCn, LucideExternalLinkCn, LucideFileTextCn, LucideScrollTextCn, ScrollAreaCn, SeparatorCn
   Source: original/blocks/dialog/dialog-terms-accept.tsx
   ======================================== *@

<AlertDialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <AlertDialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideFileTextCn Class="mr-2 h-4 w-4" Size="16" />
                Terms &amp; Conditions
            </AlertDialogTriggerCn>
    </div>
    <AlertDialogOverlayCn />
    <AlertDialogContentCn Class="sm:max-w-lg">
        <AlertDialogHeaderCn>
            <AlertDialogTitleCn Class="flex items-center gap-2">
                <LucideScrollTextCn Class="h-5 w-5" Size="20" />
                Terms of Service
            </AlertDialogTitleCn>
            <AlertDialogDescriptionCn>
                Please review and accept our terms to continue.
            </AlertDialogDescriptionCn>
        </AlertDialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Version Info *@
            <div class="flex items-center justify-between">
                <BadgeCn Variant="BadgeVariant.Secondary">Version 2024.12</BadgeCn>
                <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">
                    View full document
                    <LucideExternalLinkCn Class="ml-1 h-3 w-3" Size="12" />
                </ButtonCn>
            </div>

            @* Scrollable Terms Content *@
            <div class="relative">
                <ScrollAreaCn Class="h-[200px] rounded-lg border p-4" @onscroll="HandleScroll">
                    <div class="text-sm text-muted-foreground whitespace-pre-line">
                        @_termsContent
                    </div>
                </ScrollAreaCn>
                @if (!_hasScrolledToBottom)
                {
                    <div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-background to-transparent pointer-events-none flex items-end justify-center pb-2">
                        <span class="text-xs text-muted-foreground">Scroll to read all terms</span>
                    </div>
                }
            </div>

            @if (_hasScrolledToBottom)
            {
                <div class="flex items-center gap-2 rounded-lg border border-primary/50 p-2">
                    <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                    <span class="text-xs text-muted-foreground">You've reviewed the terms</span>
                </div>
            }

            <SeparatorCn />

            @* Agreement Checkboxes *@
            <div class="space-y-3">
                <div class="flex items-start gap-3">
                    <CheckboxCn
                        Checked="@_termsAccepted"
                        CheckedChanged="@(v => _termsAccepted = v)"
                        Disabled="@(!_hasScrolledToBottom)"
                        Id="terms" />
                    <div class="space-y-1">
                        <LabelCn
                            Class="@Cn.Merge("text-sm cursor-pointer", !_hasScrolledToBottom ? "text-muted-foreground" : "")"
                            For="terms">
                            I agree to the Terms of Service <span class="text-destructive">*</span>
                        </LabelCn>
                        <p class="text-xs text-muted-foreground">
                            By checking this box, you acknowledge that you have read and agree to be bound by
                            our terms.
                        </p>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <CheckboxCn
                        Checked="@_privacyAccepted"
                        CheckedChanged="@(v => _privacyAccepted = v)"
                        Disabled="@(!_hasScrolledToBottom)"
                        Id="privacy" />
                    <div class="space-y-1">
                        <LabelCn
                            Class="@Cn.Merge("text-sm cursor-pointer", !_hasScrolledToBottom ? "text-muted-foreground" : "")"
                            For="privacy">
                            I agree to the Privacy Policy <span class="text-destructive">*</span>
                        </LabelCn>
                        <p class="text-xs text-muted-foreground">
                            Your data will be processed according to our
                            <ButtonCn Class="h-auto p-0 text-xs" Variant="ButtonVariant.Link">
                                Privacy Policy
                            </ButtonCn>.
                        </p>
                    </div>
                </div>
            </div>

            @* Warning for declining *@
            <div class="flex items-start gap-2 rounded-lg border p-3">
                <LucideTriangleAlertCn Class="h-4 w-4 text-muted-foreground mt-0.5" Size="16" />
                <p class="text-xs text-muted-foreground">
                    If you decline, you won't be able to use certain features of the service. You can
                    review and accept these terms later from your account settings.
                </p>
            </div>
        </div>

        <AlertDialogFooterCn>
            <AlertDialogCancelCn @onclick="HandleClose">Decline</AlertDialogCancelCn>
            <AlertDialogActionCn Disabled="@(!CanAccept)" @onclick="HandleAccept">
                <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                Accept &amp; Continue
            </AlertDialogActionCn>
        </AlertDialogFooterCn>
    </AlertDialogContentCn>
</AlertDialogCn>

@code {
    private bool _open;
    private bool _hasScrolledToBottom;
    private bool _termsAccepted;
    private bool _privacyAccepted;

    private bool CanAccept => _hasScrolledToBottom && _termsAccepted && _privacyAccepted;

    private const string _termsContent = """
        Terms of Service

        Last updated: December 2024

        1. Acceptance of Terms

        By accessing and using this service, you accept and agree to be bound by the terms and provision of this agreement.

        2. Use License

        Permission is granted to temporarily use this service for personal, non-commercial transitory viewing only. This is the grant of a license, not a transfer of title.

        3. User Account

        You are responsible for maintaining the confidentiality of your account and password. You agree to accept responsibility for all activities that occur under your account.

        4. Privacy Policy

        Your use of this service is also governed by our Privacy Policy. Please review our Privacy Policy, which also governs the site and informs users of our data collection practices.

        5. Prohibited Uses

        You may not use the service for any unlawful purpose or to solicit others to perform or participate in any unlawful acts.

        6. Intellectual Property

        The service and its original content, features, and functionality are and will remain the exclusive property of the company.

        7. Termination

        We may terminate or suspend your account immediately, without prior notice or liability, for any reason whatsoever, including without limitation if you breach the Terms.

        8. Limitation of Liability

        In no event shall the company, nor its directors, employees, partners, agents, suppliers, or affiliates, be liable for any indirect, incidental, special, consequential, or punitive damages.

        9. Changes to Terms

        We reserve the right, at our sole discretion, to modify or replace these Terms at any time. We will provide notice of any changes by posting the new Terms on this page.

        10. Contact Us

        If you have any questions about these Terms, please contact us at legal@example.com.
        """;

    private void HandleScroll()
    {
        // In a real app, JS interop would check scroll position.
        // For the demo, we enable after the first scroll interaction.
        _hasScrolledToBottom = true;
    }

    private void HandleAccept()
    {
        _open = false;
    }

    private void HandleClose()
    {
        _open = false;
        _hasScrolledToBottom = false;
        _termsAccepted = false;
        _privacyAccepted = false;
    }
}
