@* ========================================
   Block: dialog-register
   Title: Dialog Register
   Description: User registration dialog with email, password, name fields, social signup options, terms acceptance, and validation
   Dependencies: ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideEyeCn, LucideEyeOffCn, LucideLoaderCn, LucideLockCn, LucideMailCn, LucideUserCn, LucideUserPlusCn, LucideXCn, ProgressCn, SeparatorCn
   Source: original/blocks/dialog/dialog-register.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideUserPlusCn Class="mr-2 h-4 w-4" Size="16" />
                Create Account
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="text-center">Create an account</DialogTitleCn>
            <DialogDescriptionCn Class="text-center">Get started with your free account</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Social Signup Buttons *@
            <div class="grid grid-cols-2 gap-3">
                <ButtonCn Disabled="@_isLoading" Variant="ButtonVariant.Outline" @onclick="HandleSocialSignup">
                    <svg aria-label="Google" class="mr-2 h-4 w-4" role="img" viewBox="0 0 24 24">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="currentColor" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="currentColor" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="currentColor" />
                    </svg>
                    Google
                </ButtonCn>
                <ButtonCn Disabled="@_isLoading" Variant="ButtonVariant.Outline" @onclick="HandleSocialSignup">
                    <svg aria-label="GitHub" class="mr-2 h-4 w-4" fill="currentColor" role="img" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                    GitHub
                </ButtonCn>
            </div>

            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <SeparatorCn Class="w-full" />
                </div>
                <div class="relative flex justify-center text-xs uppercase">
                    <span class="bg-background px-2 text-muted-foreground">Or continue with email</span>
                </div>
            </div>

            @* Registration Form *@
            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="name">Full Name</LabelCn>
                    <div class="relative">
                        <LucideUserCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9" Disabled="@_isLoading" Id="name" Placeholder="John Doe"
                                 Value="@_name" ValueChanged="@(v => _name = v)" />
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="register-email">Email</LabelCn>
                    <div class="relative">
                        <LucideMailCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9" Disabled="@_isLoading" Id="register-email" Type="email" Placeholder="@("you@example.com")"
                                 Value="@_email" ValueChanged="@(v => _email = v)" />
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="register-password">Password</LabelCn>
                    <div class="relative">
                        <LucideLockCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9 pr-9" Disabled="@_isLoading" Id="register-password"
                                 Type="@(_showPassword ? "text" : "password")" Placeholder="Create a password"
                                 Value="@_password" ValueChanged="@(v => _password = v)" />
                        <ButtonCn Class="absolute right-0 top-0 h-full px-3 hover:bg-transparent"
                                  Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                  @onclick="@(() => _showPassword = !_showPassword)">
                            @if (_showPassword)
                            {
                                <LucideEyeOffCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }
                            else
                            {
                                <LucideEyeCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }
                        </ButtonCn>
                    </div>

                    @if (!string.IsNullOrEmpty(_password))
                    {
                        <div class="space-y-2">
                            <div class="flex items-center gap-2">
                                <ProgressCn Class="@Cn.Merge("h-1.5 flex-1", PasswordStrengthColor)" Value="@PasswordScore" />
                                <span class="text-xs text-muted-foreground">@PasswordLabel</span>
                            </div>
                            <div class="grid grid-cols-2 gap-1">
                                @foreach (var req in _passwordRequirements)
                                {
                                    var passed = req.Test(_password);
                                    <div class="flex items-center gap-1 text-xs">
                                        @if (passed)
                                        {
                                            <LucideCheckCn Class="h-3 w-3 text-green-500" Size="12" />
                                        }
                                        else
                                        {
                                            <LucideXCn Class="h-3 w-3 text-muted-foreground" Size="12" />
                                        }
                                        <span class="@(passed ? "text-foreground" : "text-muted-foreground")">@req.Label</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="flex items-start gap-2">
                    <CheckboxCn Checked="@_acceptTerms" CheckedChanged="@(v => _acceptTerms = v)"
                                Class="mt-0.5" Disabled="@_isLoading" Id="terms" />
                    <LabelCn Class="text-sm font-normal leading-tight cursor-pointer" For="terms">
                        I agree to the
                        <ButtonCn Class="h-auto p-0 text-sm" Variant="ButtonVariant.Link">Terms of Service</ButtonCn>
                        and
                        <ButtonCn Class="h-auto p-0 text-sm" Variant="ButtonVariant.Link">Privacy Policy</ButtonCn>
                    </LabelCn>
                </div>

                <ButtonCn Class="w-full" Disabled="@(!IsValid || _isLoading)" @onclick="HandleSubmit">
                    @if (_isLoading)
                    {
                        <LucideLoaderCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Creating account...</span>
                    }
                    else
                    {
                        <LucideUserPlusCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Create account</span>
                    }
                </ButtonCn>
            </div>

            <p class="text-center text-sm text-muted-foreground">
                Already have an account?
                <ButtonCn Class="h-auto p-0 text-sm" Variant="ButtonVariant.Link">Sign in</ButtonCn>
            </p>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record PasswordRequirement(string Label, Func<string, bool> Test);

    private static readonly PasswordRequirement[] _passwordRequirements =
    [
        new("At least 8 characters", p => p.Length >= 8),
        new("Uppercase letter", p => p.Any(char.IsUpper)),
        new("Lowercase letter", p => p.Any(char.IsLower)),
        new("Number", p => p.Any(char.IsDigit))
    ];

    private bool _open;
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private bool _showPassword;
    private bool _acceptTerms;
    private bool _isLoading;

    private bool IsValid => _name.Trim().Length >= 2 && _email.Contains("@") && _password.Length >= 8 && _acceptTerms;

    private int PasswordScore
    {
        get
        {
            var score = 0;
            if (_password.Length >= 8) score += 25;
            if (_password.Length >= 12) score += 15;
            if (_password.Any(char.IsLower) && _password.Any(char.IsUpper)) score += 20;
            if (_password.Any(char.IsDigit)) score += 20;
            if (_password.Any(c => !char.IsLetterOrDigit(c))) score += 20;
            return score;
        }
    }

    private string PasswordLabel => PasswordScore switch
    {
        < 40 => "Weak",
        < 70 => "Fair",
        < 90 => "Good",
        _ => "Strong"
    };

    private string PasswordStrengthColor => PasswordScore switch
    {
        < 40 => "bg-destructive",
        < 70 => "bg-yellow-500",
        < 90 => "bg-blue-500",
        _ => "bg-green-500"
    };

    private async Task HandleSubmit()
    {
        if (!IsValid) return;
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isLoading = false;
        _open = false;
    }

    private async Task HandleSocialSignup()
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isLoading = false;
    }
}
