@* ========================================
   Block: dialog-onboarding-welcome
   Title: Dialog Onboarding Welcome
   Description: Onboarding welcome dialog with multi-step introduction, feature highlights, and get started flow
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideChartBarCn, LucideBellCn, LucideChevronLeftCn, LucideChevronRightCn, LucideLayoutDashboardCn, LucideRocketCn, LucideShieldCn, LucideSparklesCn, LucideUsersCn, ProgressCn
   Source: original/blocks/dialog/dialog-onboarding-welcome.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideSparklesCn Class="mr-2 h-4 w-4" Size="16" />
                Start Tour
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn Class="text-center">
            <div class="flex justify-center mb-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary">
                    @_steps[_currentStep].IconFragment
                </div>
            </div>
            <DialogTitleCn>@_steps[_currentStep].Title</DialogTitleCn>
            <DialogDescriptionCn Class="text-center">@_steps[_currentStep].Description</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4">
            @* Feature Highlights *@
            @if (_steps[_currentStep].Features is not null)
            {
                <div class="space-y-3 mb-6">
                    @foreach (var feature in _steps[_currentStep].Features!)
                    {
                        <div class="flex items-start gap-3 rounded-lg border p-3">
                            <div class="flex h-8 w-8 items-center justify-center rounded-md border shrink-0">
                                @feature.IconFragment
                            </div>
                            <div>
                                <p class="text-sm font-medium">@feature.Title</p>
                                <p class="text-xs text-muted-foreground">@feature.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Progress Section *@
            <div class="space-y-3">
                <ProgressCn Class="h-1" Value="@Progress" aria-label="Progress" />
                <div class="flex items-center justify-center gap-1.5">
                    @for (var i = 0; i < _steps.Length; i++)
                    {
                        var index = i;
                        <button type="button" aria-label="@($"Go to step {index + 1}")"
                                class="@Cn.Merge("h-2 w-2 rounded-full transition-colors", index == _currentStep ? "bg-primary" : index < _currentStep ? "bg-primary/50" : "bg-muted")"
                                @onclick="@(() => _currentStep = index)"></button>
                    }
                </div>
                <p class="text-center text-xs text-muted-foreground">
                    Step @(_currentStep + 1) of @_steps.Length
                </p>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between pt-2 border-t">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleSkip">Skip tour</ButtonCn>
            <div class="flex gap-2">
                @if (!IsFirstStep)
                {
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="HandlePrevious">
                        <LucideChevronLeftCn Class="mr-1 h-4 w-4" Size="16" />
                        Back
                    </ButtonCn>
                }
                <ButtonCn Size="ButtonSize.Sm" @onclick="HandleNext">
                    @if (IsLastStep)
                    {
                        <LucideRocketCn Class="mr-2 h-4 w-4" Size="16" />
                        @:Get Started
                    }
                    else
                    {
                        @:Next
                        <LucideChevronRightCn Class="ml-1 h-4 w-4" Size="16" />
                    }
                </ButtonCn>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record FeatureItem(string Title, string Description, RenderFragment IconFragment);
    private record OnboardingStep(string Id, string Title, string Description, RenderFragment IconFragment, FeatureItem[]? Features = null);

    private readonly OnboardingStep[] _steps;

    public DialogOnboardingWelcome()
    {
        _steps =
        [
            new("welcome", "Welcome to the Platform",
                "We're excited to have you here! Let's take a quick tour of the key features that will help you get the most out of your experience.",
                builder => { builder.OpenComponent<LucideSparklesCn>(0); builder.AddAttribute(1, "Class", "h-6 w-6 text-primary"); builder.AddAttribute(2, "Size", 24); builder.CloseComponent(); }),
            new("dashboard", "Your Personal Dashboard",
                "Everything you need in one place. Your dashboard gives you a complete overview of your activity and quick access to all features.",
                builder => { builder.OpenComponent<LucideLayoutDashboardCn>(0); builder.AddAttribute(1, "Class", "h-6 w-6 text-primary"); builder.AddAttribute(2, "Size", 24); builder.CloseComponent(); },
                [
                    new("Analytics", "Track your progress with detailed insights",
                        builder => { builder.OpenComponent<LucideChartBarCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
                    new("Notifications", "Stay updated with real-time alerts",
                        builder => { builder.OpenComponent<LucideBellCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
                ]),
            new("collaboration", "Team Collaboration",
                "Work together seamlessly with your team. Invite members, assign roles, and collaborate in real-time.",
                builder => { builder.OpenComponent<LucideUsersCn>(0); builder.AddAttribute(1, "Class", "h-6 w-6 text-primary"); builder.AddAttribute(2, "Size", 24); builder.CloseComponent(); },
                [
                    new("Team Spaces", "Create dedicated workspaces for each team",
                        builder => { builder.OpenComponent<LucideUsersCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
                    new("Permissions", "Control access with granular permissions",
                        builder => { builder.OpenComponent<LucideShieldCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
                ]),
            new("ready", "You're All Set!",
                "You're ready to start exploring. If you ever need help, our support team is just a click away.",
                builder => { builder.OpenComponent<LucideRocketCn>(0); builder.AddAttribute(1, "Class", "h-6 w-6 text-primary"); builder.AddAttribute(2, "Size", 24); builder.CloseComponent(); }),
        ];
    }

    private bool _open;
    private int _currentStep;

    private double Progress => ((_currentStep + 1.0) / _steps.Length) * 100;
    private bool IsFirstStep => _currentStep == 0;
    private bool IsLastStep => _currentStep == _steps.Length - 1;

    private void HandleNext()
    {
        if (IsLastStep)
            HandleComplete();
        else
            _currentStep++;
    }

    private void HandlePrevious() => _currentStep = Math.Max(0, _currentStep - 1);

    private void HandleSkip()
    {
        _open = false;
        _currentStep = 0;
    }

    private void HandleComplete()
    {
        _open = false;
        _currentStep = 0;
    }
}
