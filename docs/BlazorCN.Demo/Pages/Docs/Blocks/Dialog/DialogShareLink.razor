@* ========================================
   Block: dialog-share-link
   Title: Dialog Share Link
   Description: Share and collaborate dialog with toggle switch, copyable link input, and action buttons for copying and previewing
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideCopyCn, LucideExternalLinkCn, LucideLinkCn, LucideShare2Cn, SwitchCn, TooltipCn, TooltipContentCn, TooltipTriggerCn
   Source: original/blocks/dialog/dialog-share-link.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-default cn-button-size-default" data-variant="default" data-size="default">
            <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
            Share
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn>Share &amp; Collaborate</DialogTitleCn>
            <p class="text-sm text-muted-foreground">
                Share this project with your team to collaborate on it.
            </p>
        </DialogHeaderCn>
        <div class="space-y-4 py-4">
            <div class="flex items-center justify-between space-x-2">
                <div class="flex items-center space-x-2">
                    <span>Enable comments and suggestions</span>
                </div>
                <SwitchCn Id="comments" />
            </div>

            <div class="space-y-1.5">
                <LabelCn Class="sr-only" For="share-link">
                    Share Link
                </LabelCn>
                <div class="relative">
                    <InputCn
                        Class="pe-9"
                        Id="share-link"
                        ReadOnly="true"
                        Value="https://example.com/share/abc123?token=xyz" />
                    <TooltipCn>
                        <TooltipTriggerCn Tabbable="false">
                            <button
                                type="button"
                                aria-label="@(_copied ? "Copied" : "Copy to clipboard")"
                                class="text-muted-foreground/80 hover:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 absolute inset-y-0 end-0 flex h-full w-9 items-center justify-center rounded-e-md transition-[color,box-shadow] outline-none focus:z-10 focus-visible:ring-[3px] disabled:pointer-events-none disabled:cursor-not-allowed"
                                disabled="@_copied"
                                @onclick="HandleCopy">
                                <div class="@Cn.Merge("transition-all", _copied ? "scale-100 opacity-100" : "scale-0 opacity-0")">
                                    <LucideCheckCn Class="text-primary" Size="16" />
                                </div>
                                <div class="@Cn.Merge("absolute transition-all", _copied ? "scale-0 opacity-0" : "scale-100 opacity-100")">
                                    <LucideCopyCn Size="16" />
                                </div>
                            </button>
                        </TooltipTriggerCn>
                        <TooltipContentCn Class="px-2 py-1 text-xs">
                            @(_copied ? "Copied!" : "Copy to clipboard")
                        </TooltipContentCn>
                    </TooltipCn>
                </div>
            </div>

            <div class="flex space-x-2">
                <ButtonCn Class="flex-1 gap-2" @onclick="HandleCopy">
                    <LucideLinkCn Class="h-4 w-4" Size="16" />
                    Copy Link
                </ButtonCn>
                <ButtonCn Class="flex-1 gap-2" Variant="ButtonVariant.Outline">
                    <LucideExternalLinkCn Class="h-4 w-4" Size="16" />
                    Preview
                </ButtonCn>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}
