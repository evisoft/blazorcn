@* ========================================
   Block: dialog-quick-actions
   Title: Dialog Quick Actions
   Description: Quick actions dialog with searchable action list, keyboard shortcuts, recent actions, and categorized commands
   Dependencies: BadgeCn, ButtonCn, CommandCn, CommandEmptyCn, CommandGroupCn, CommandInputCn, CommandItemCn, CommandListCn, CommandSeparatorCn, CommandShortcutCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideClockCn, LucideCommandCn, LucideDownloadCn, LucideFileTextCn, LucideFolderPlusCn, LucideKeyboardCn, LucideLogOutCn, LucideMoonCn, LucidePlusCn, LucideSearchCn, LucideSettingsCn, LucideShare2Cn, LucideUploadCn, LucideUserCn, LucideZapCn
   Source: original/blocks/dialog/dialog-quick-actions.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCommandCn Class="mr-2 h-4 w-4" Size="16" />
                Quick Actions
                <BadgeCn Class="ml-2 text-xs" Variant="BadgeVariant.Secondary">Ctrl+K</BadgeCn>
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="p-0 sm:max-w-md overflow-hidden">
        <DialogTitleCn Class="sr-only">Quick Actions</DialogTitleCn>
        <CommandCn Class="rounded-lg border-0">
            <div class="flex items-center border-b px-3">
                <LucideSearchCn Class="mr-2 h-4 w-4 shrink-0 opacity-50" Size="16" />
                <CommandInputCn Class="border-0 focus:ring-0" Placeholder="Search actions..."
                                Value="@_search" ValueChanged="@(v => _search = v)" />
            </div>
            <CommandListCn Class="max-h-[400px]">
                <CommandEmptyCn>No actions found.</CommandEmptyCn>

                @if (string.IsNullOrEmpty(_search))
                {
                    <CommandGroupCn Heading="Recent">
                        @foreach (var action in _recentActions)
                        {
                            <CommandItemCn Class="cursor-pointer" @onclick="@(() => HandleSelect(action.Id))">
                                <LucideClockCn Class="mr-2 h-4 w-4 text-muted-foreground" Size="16" />
                                @RenderIcon(action.Icon, "mr-2 h-4 w-4")
                                <span>@action.Label</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                    <CommandSeparatorCn />
                }

                @foreach (var group in _groupedActions)
                {
                    <CommandGroupCn Heading="@group.Key">
                        @foreach (var action in group.Value)
                        {
                            <CommandItemCn Class="cursor-pointer" @onclick="@(() => HandleSelect(action.Id))">
                                @RenderIcon(action.Icon, "mr-2 h-4 w-4")
                                <span>@action.Label</span>
                                @if (action.Shortcut is not null)
                                {
                                    <CommandShortcutCn>@action.Shortcut</CommandShortcutCn>
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                }
            </CommandListCn>

            <div class="flex items-center justify-between border-t px-3 py-2">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideZapCn Class="h-3 w-3" Size="12" />
                    <span>Quick Actions</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground">
                    <kbd class="rounded border px-1.5 py-0.5 text-[10px] font-medium">&#x2191;&#x2193;</kbd>
                    <span>to navigate</span>
                    <kbd class="ml-2 rounded border px-1.5 py-0.5 text-[10px] font-medium">&#x21B5;</kbd>
                    <span>to select</span>
                    <kbd class="ml-2 rounded border px-1.5 py-0.5 text-[10px] font-medium">esc</kbd>
                    <span>to close</span>
                </div>
            </div>
        </CommandCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record QuickAction(string Id, string Label, string Icon, string? Shortcut, string Category);
    private record RecentAction(string Id, string Label, string Icon);

    private static readonly QuickAction[] _quickActions =
    [
        new("new-file", "New File", "file-text", "\u2318N", "Create"),
        new("new-folder", "New Folder", "folder-plus", "\u21E7\u2318N", "Create"),
        new("new-project", "New Project", "plus", null, "Create"),
        new("upload", "Upload File", "upload", "\u2318U", "Actions"),
        new("download", "Download", "download", "\u2318D", "Actions"),
        new("share", "Share", "share", "\u2318\u21E7S", "Actions"),
        new("settings", "Settings", "settings", "\u2318,", "Navigation"),
        new("profile", "Profile", "user", null, "Navigation"),
        new("shortcuts", "Keyboard Shortcuts", "keyboard", "\u2318/", "Navigation"),
        new("dark-mode", "Toggle Dark Mode", "moon", "\u2318\u21E7D", "Preferences"),
        new("help", "Help & Support", "help", null, "Account"),
        new("logout", "Log Out", "logout", null, "Account")
    ];

    private static readonly RecentAction[] _recentActions =
    [
        new("new-file", "New File", "file-text"),
        new("upload", "Upload File", "upload"),
        new("share", "Share", "share")
    ];

    private static readonly Dictionary<string, QuickAction[]> _groupedActions =
        _quickActions.GroupBy(a => a.Category).ToDictionary(g => g.Key, g => g.ToArray());

    private bool _open;
    private string _search = "";

    private void HandleSelect(string actionId)
    {
        _open = false;
        _search = "";
    }

    private RenderFragment RenderIcon(string icon, string css) => builder =>
    {
        var size = 16;
        switch (icon)
        {
            case "file-text": builder.OpenComponent<LucideFileTextCn>(0); break;
            case "folder-plus": builder.OpenComponent<LucideFolderPlusCn>(0); break;
            case "plus": builder.OpenComponent<LucidePlusCn>(0); break;
            case "upload": builder.OpenComponent<LucideUploadCn>(0); break;
            case "download": builder.OpenComponent<LucideDownloadCn>(0); break;
            case "share": builder.OpenComponent<LucideShare2Cn>(0); break;
            case "settings": builder.OpenComponent<LucideSettingsCn>(0); break;
            case "user": builder.OpenComponent<LucideUserCn>(0); break;
            case "keyboard": builder.OpenComponent<LucideKeyboardCn>(0); break;
            case "moon": builder.OpenComponent<LucideMoonCn>(0); break;
            case "help": builder.OpenComponent<LucideCircleQuestionMarkCn>(0); break;
            case "logout": builder.OpenComponent<LucideLogOutCn>(0); break;
            default: builder.OpenComponent<LucideZapCn>(0); break;
        }
        builder.AddAttribute(1, "Class", css);
        builder.AddAttribute(2, "Size", size);
        builder.CloseComponent();
    };
}
