@* ========================================
   Block: dialog-quick-poll
   Title: Dialog Quick Poll
   Description: Quick poll dialog with voting options, live results, and participant count
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideVoteCn, ProgressCn
   Source: original/blocks/dialog/dialog-quick-poll.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideVoteCn Class="mr-2 h-4 w-4" Size="16" />
                Quick Poll
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_hasVoted)
        {
            <div class="flex flex-col items-center justify-center py-4 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Vote Submitted</h3>
            </div>
            <div class="space-y-3">
                <p class="text-sm font-medium">@PollQuestion</p>
                @foreach (var option in _options)
                {
                    var percentage = GetPercentage(option.Votes);
                    var isWinning = option.Votes == _options.Max(o => o.Votes);
                    <div class="space-y-1">
                        <div class="flex justify-between text-sm">
                            <span class="@(isWinning ? "font-medium" : "")">
                                @option.Text
                                @if (option.Id == _selected)
                                {
                                    <span class="ml-1 text-muted-foreground">&middot; You</span>
                                }
                            </span>
                            <span class="text-muted-foreground">@percentage%</span>
                        </div>
                        <ProgressCn Class="h-2" Value="percentage" aria-label="Progress" />
                    </div>
                }
                <p class="text-xs text-muted-foreground pt-1">@TotalVotes votes</p>
            </div>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>@PollQuestion</DialogTitleCn>
                <DialogDescriptionCn>@TotalVotes votes &middot; Select an option</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-2">
                @foreach (var option in _options)
                {
                    <button type="button"
                            class="@Cn.Merge("w-full text-left p-3 rounded-md border transition-colors", _selected == option.Id ? "border-primary bg-primary/5" : "hover:border-muted-foreground/50")"
                            @onclick="@(() => _selected = option.Id)">
                        <span class="text-sm">@option.Text</span>
                    </button>
                }
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(_selected is null)" @onclick="HandleVote">Vote</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record PollOption(string Id, string Text, int Votes);

    private const string PollQuestion = "When should we launch?";

    private static readonly PollOption[] _initialOptions =
    [
        new("a", "This Friday", 3),
        new("b", "Next Monday", 5),
        new("c", "Next Friday", 2)
    ];

    private bool _open;
    private PollOption[] _options = _initialOptions.ToArray();
    private string? _selected;
    private bool _hasVoted;

    private int TotalVotes => _options.Sum(o => o.Votes);

    private int GetPercentage(int votes)
    {
        var total = TotalVotes;
        return total > 0 ? (int)Math.Round((double)votes / total * 100) : 0;
    }

    private void HandleVote()
    {
        if (_selected is null) return;
        _options = _options.Select(o => o.Id == _selected ? o with { Votes = o.Votes + 1 } : o).ToArray();
        _hasVoted = true;
    }

    private void HandleClose()
    {
        _open = false;
        _options = _initialOptions.ToArray();
        _selected = null;
        _hasVoted = false;
    }
}
