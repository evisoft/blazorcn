@* ========================================
   Block: dialog-achievement-unlock
   Title: Dialog Achievement Unlock
   Description: Achievement unlock dialog with badge display, progress stats, and share options for gamification apps
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideShare2Cn, LucideSparklesCn, LucideTrophyCn
   Source: original/blocks/dialog/dialog-achievement-unlock.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideTrophyCn Class="mr-2 h-4 w-4" Size="16" />
                View Achievement
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="text-center" style="max-width: 320px;">
        <DialogTitleCn Class="sr-only">Achievement Unlocked</DialogTitleCn>

        <div class="py-6 space-y-4">
            @* Badge icon *@
            <div class="flex flex-col items-center">
                <div class="relative">
                    <div class="h-24 w-24 rounded-full bg-primary/10 flex items-center justify-center">
                        <span class="text-5xl">@_achievement.Icon</span>
                    </div>
                    <LucideSparklesCn Class="absolute -top-1 -right-1 h-6 w-6 text-primary" Size="24" />
                </div>
            </div>

            @* Title and description *@
            <div>
                <div class="flex items-center justify-center gap-2">
                    <h3 class="text-lg font-semibold">@_achievement.Title</h3>
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                        @_achievement.Rarity
                    </BadgeCn>
                </div>
                <p class="text-sm text-muted-foreground mt-1">@_achievement.Description</p>
            </div>

            @* Stats *@
            <div class="flex justify-center gap-6 py-2">
                <div class="text-center">
                    <p class="text-lg font-semibold text-primary">+@_achievement.Xp</p>
                    <p class="text-xs text-muted-foreground">XP Earned</p>
                </div>
                <div class="text-center">
                    <p class="text-lg font-semibold">@_achievement.Unlocked</p>
                    <p class="text-xs text-muted-foreground">Have This</p>
                </div>
            </div>

            @* Actions *@
            <div class="flex gap-2 pt-2">
                <ButtonCn Class="flex-1" @onclick="HandleShare" Variant="ButtonVariant.Outline">
                    @if (_shared)
                    {
                        <span>Copied!</span>
                    }
                    else
                    {
                        <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Share</span>
                    }
                </ButtonCn>
                <ButtonCn Class="flex-1" @onclick="@(() => _open = false)">
                    Awesome!
                </ButtonCn>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _shared;

    private record AchievementData(string Title, string Description, string Rarity, string Unlocked, string Icon, int Xp);

    private static readonly AchievementData _achievement = new(
        "Early Adopter",
        "Joined within the first month of launch",
        "Rare",
        "2.3%",
        "\U0001F3C6",
        500
    );

    private async Task HandleShare()
    {
        _shared = true;
        StateHasChanged();
        await Task.Delay(2000);
        _shared = false;
    }
}
