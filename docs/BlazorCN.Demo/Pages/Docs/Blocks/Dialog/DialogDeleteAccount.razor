@* ========================================
   Block: dialog-delete-account
   Title: Dialog Delete Account
   Description: Delete account dialog with multi-step confirmation, data export option, password verification, and permanent deletion warning
   Dependencies: AlertCn, AlertDescriptionCn, AlertTitleCn, ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideDownloadCn, LucideLoader2Cn, LucideShieldCn, LucideTrash2Cn, LucideTriangleAlertCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/dialog/dialog-delete-account.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Destructive">
                <LucideTrash2Cn Class="mr-2 h-4 w-4" Size="16" />
                Delete Account
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2 text-destructive">
                <LucideTrash2Cn Class="h-5 w-5" Size="20" />
                Delete Account
            </DialogTitleCn>
            <DialogDescriptionCn>
                @if (_step == 1) { <span>This action is permanent and cannot be undone.</span> }
                @if (_step == 2) { <span>Please verify your identity to continue.</span> }
                @if (_step == 3) { <span>Final confirmation required.</span> }
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4">
            @if (_step == 1)
            {
                <div class="space-y-4">
                    <AlertCn Variant="AlertVariant.Destructive">
                        <LucideTriangleAlertCn Class="h-4 w-4" Size="16" />
                        <AlertTitleCn>Warning</AlertTitleCn>
                        <AlertDescriptionCn>
                            Deleting your account will permanently remove all your data, including projects,
                            files, and settings.
                        </AlertDescriptionCn>
                    </AlertCn>

                    <div class="rounded-lg border p-4 space-y-3">
                        <div class="flex items-center gap-2">
                            <LucideDownloadCn Class="h-4 w-4" Size="16" />
                            <span class="font-medium">Export Your Data</span>
                        </div>
                        <p class="text-sm text-muted-foreground">
                            Before deleting, you can download a copy of all your data.
                        </p>
                        <ButtonCn Class="w-full" Disabled="@(_isExporting || _dataExported)" Variant="ButtonVariant.Outline" @onclick="HandleExportData">
                            @if (_isExporting)
                            {
                                <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                                <span>Preparing export...</span>
                            }
                            else if (_dataExported)
                            {
                                <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                                <span>Data exported</span>
                            }
                            else
                            {
                                <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                                <span>Export all data</span>
                            }
                        </ButtonCn>
                    </div>

                    <div class="space-y-2">
                        <LabelCn>Why are you leaving? (optional)</LabelCn>
                        <SelectCn Value="@_reason" ValueChanged="@((string v) => _reason = v)">
                            <SelectTriggerCn>
                                <SelectValueCn Placeholder="Select a reason" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="not-using">I'm not using the service anymore</SelectItemCn>
                                <SelectItemCn Value="too-expensive">It's too expensive</SelectItemCn>
                                <SelectItemCn Value="missing-features">Missing features I need</SelectItemCn>
                                <SelectItemCn Value="switching">Switching to another service</SelectItemCn>
                                <SelectItemCn Value="privacy">Privacy concerns</SelectItemCn>
                                <SelectItemCn Value="other">Other reason</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
            }
            else if (_step == 2)
            {
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-sm text-muted-foreground">
                        <LucideShieldCn Class="h-4 w-4" Size="16" />
                        <span>For your security, please verify your password.</span>
                    </div>

                    <div class="space-y-2">
                        <LabelCn For="delete-password">Password</LabelCn>
                        <InputCn Id="delete-password" Type="password" Placeholder="Enter your password" Value="@_password" ValueChanged="@((string v) => _password = v)" />
                    </div>

                    <p class="text-xs text-muted-foreground">
                        This helps us verify that you're the account owner.
                    </p>
                </div>
            }
            else if (_step == 3)
            {
                <div class="space-y-4">
                    <AlertCn Variant="AlertVariant.Destructive">
                        <LucideTriangleAlertCn Class="h-4 w-4" Size="16" />
                        <AlertDescriptionCn>
                            This is your last chance to cancel. Once deleted, your account and all associated
                            data will be permanently removed.
                        </AlertDescriptionCn>
                    </AlertCn>

                    <div class="space-y-2">
                        <LabelCn For="confirm-phrase">
                            Type <span class="font-mono font-bold">@_confirmationPhrase</span> to confirm
                        </LabelCn>
                        <InputCn
                            Class="@Cn.Merge(_isConfirmPhraseValid ? "border-destructive focus-visible:ring-destructive" : "")"
                            Id="confirm-phrase"
                            Placeholder="@_confirmationPhrase"
                            Value="@_confirmPhrase"
                            ValueChanged="@((string v) => _confirmPhrase = v)" />
                    </div>

                    <div class="flex items-start gap-2 rounded-lg border border-destructive/50 p-3">
                        <CheckboxCn Class="mt-0.5" Id="understood" Checked="@_understood" CheckedChanged="@((bool v) => _understood = v)" />
                        <LabelCn Class="text-sm font-normal cursor-pointer" For="understood">
                            I understand that this action is irreversible and all my data will be permanently deleted.
                        </LabelCn>
                    </div>
                </div>
            }

            @* Progress Indicator *@
            <div class="flex justify-center gap-1.5 mt-6">
                @for (var s = 1; s <= 3; s++)
                {
                    var step = s;
                    <div class="@Cn.Merge("h-2 w-2 rounded-full transition-colors", step == _step ? "bg-destructive" : step < _step ? "bg-destructive/50" : "bg-muted")"></div>
                }
            </div>
        </div>

        <DialogFooterCn Class="flex-col sm:flex-row gap-2">
            @if (_step > 1)
            {
                <ButtonCn Class="sm:mr-auto" Disabled="@_isDeleting" Variant="ButtonVariant.Ghost" @onclick="@(() => _step--)">
                    Back
                </ButtonCn>
            }
            <ButtonCn Disabled="@_isDeleting" Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
            @if (_step < 3)
            {
                <ButtonCn Disabled="@(_step == 2 && string.IsNullOrEmpty(_password))" Variant="ButtonVariant.Destructive" @onclick="@(() => _step++)">
                    Continue
                </ButtonCn>
            }
            else
            {
                <ButtonCn Disabled="@(!(_isConfirmPhraseValid && _understood) || _isDeleting)" Variant="ButtonVariant.Destructive" @onclick="HandleDelete">
                    @if (_isDeleting)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <LucideTrash2Cn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Delete Forever</span>
                    }
                </ButtonCn>
            }
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private int _step = 1;
    private string _reason = "";
    private bool _dataExported;
    private bool _isExporting;
    private string _password = "";
    private string _confirmPhrase = "";
    private bool _understood;
    private bool _isDeleting;

    private const string _confirmationPhrase = "delete my account";
    private bool _isConfirmPhraseValid => _confirmPhrase.Equals(_confirmationPhrase, StringComparison.OrdinalIgnoreCase);

    private async Task HandleExportData()
    {
        _isExporting = true;
        StateHasChanged();
        await Task.Delay(2000);
        _isExporting = false;
        _dataExported = true;
    }

    private async Task HandleDelete()
    {
        if (!(_isConfirmPhraseValid && _understood && !string.IsNullOrEmpty(_password))) return;
        _isDeleting = true;
        StateHasChanged();
        await Task.Delay(2000);
        _isDeleting = false;
        _open = false;
    }

    private void HandleClose()
    {
        _open = false;
        _step = 1;
        _reason = "";
        _dataExported = false;
        _password = "";
        _confirmPhrase = "";
        _understood = false;
    }
}
