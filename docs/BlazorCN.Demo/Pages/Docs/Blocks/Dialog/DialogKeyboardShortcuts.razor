@* ========================================
   Block: dialog-keyboard-shortcuts
   Title: Dialog Keyboard Shortcuts
   Description: Keyboard shortcuts reference dialog with grouped commands, key combinations displayed as badges, and search functionality
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideCommandCn, LucideSearchCn, ScrollAreaCn
   Source: original/blocks/dialog/dialog-keyboard-shortcuts.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCommandCn Class="mr-2 h-4 w-4" Size="16" />
                Keyboard Shortcuts
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg p-0 gap-0">
        <DialogHeaderCn Class="px-6 pt-6 pb-4">
            <DialogTitleCn>Keyboard Shortcuts</DialogTitleCn>
        </DialogHeaderCn>

        <div class="px-6 pb-4">
            <div class="relative">
                <LucideSearchCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                <InputCn Class="pl-9" Placeholder="Search shortcuts..." Value="@_search" ValueChanged="@(v => _search = v)" />
            </div>
        </div>

        <ScrollAreaCn Class="max-h-[400px] px-6 pb-6">
            @if (GetFilteredShortcuts().Any())
            {
                <div class="space-y-6">
                    @foreach (var (category, items) in GetFilteredShortcuts())
                    {
                        <div>
                            <h3 class="text-sm font-medium text-muted-foreground mb-3">@category</h3>
                            <div class="space-y-2">
                                @foreach (var shortcut in items)
                                {
                                    <div class="flex items-center justify-between py-2">
                                        <span class="text-sm">@shortcut.Action</span>
                                        <div class="flex items-center gap-1">
                                            @foreach (var key in shortcut.Keys)
                                            {
                                                <kbd class="inline-flex h-6 min-w-6 items-center justify-center rounded border bg-muted px-1.5 text-xs font-medium">
                                                    @key
                                                </kbd>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-8 text-center">
                    <p class="text-sm text-muted-foreground">
                        No shortcuts found for &quot;@_search&quot;
                    </p>
                </div>
            }
        </ScrollAreaCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record Shortcut(string[] Keys, string Action);

    private static readonly Dictionary<string, Shortcut[]> _shortcuts = new()
    {
        ["General"] =
        [
            new(["⌘", "K"], "Open command palette"),
            new(["⌘", "S"], "Save changes"),
            new(["⌘", "Z"], "Undo"),
            new(["⌘", "⇧", "Z"], "Redo"),
            new(["⌘", "/"], "Toggle shortcuts"),
        ],
        ["Navigation"] =
        [
            new(["⌘", "↑"], "Go to top"),
            new(["⌘", "↓"], "Go to bottom"),
            new(["⌘", "←"], "Go back"),
            new(["⌘", "→"], "Go forward"),
            new(["G", "H"], "Go to home"),
            new(["G", "S"], "Go to settings"),
        ],
        ["Editing"] =
        [
            new(["⌘", "B"], "Bold text"),
            new(["⌘", "I"], "Italic text"),
            new(["⌘", "U"], "Underline text"),
            new(["⌘", "⇧", "K"], "Delete line"),
            new(["⌘", "D"], "Duplicate line"),
            new(["⌘", "Enter"], "Submit form"),
        ],
        ["View"] =
        [
            new(["⌘", "+"], "Zoom in"),
            new(["⌘", "-"], "Zoom out"),
            new(["⌘", "0"], "Reset zoom"),
            new(["⌘", "\\"], "Toggle sidebar"),
            new(["F11"], "Toggle fullscreen"),
        ],
    };

    private bool _open;
    private string _search = "";

    private IEnumerable<KeyValuePair<string, Shortcut[]>> GetFilteredShortcuts()
    {
        if (string.IsNullOrWhiteSpace(_search))
            return _shortcuts;

        var searchLower = _search.ToLowerInvariant();
        return _shortcuts
            .Select(kvp => new KeyValuePair<string, Shortcut[]>(
                kvp.Key,
                kvp.Value.Where(s =>
                    s.Action.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ||
                    string.Join("", s.Keys).Contains(searchLower, StringComparison.OrdinalIgnoreCase)
                ).ToArray()))
            .Where(kvp => kvp.Value.Length > 0);
    }
}
