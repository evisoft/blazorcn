@* ========================================
   Block: dialog-mood-check
   Title: Dialog Mood Check
   Description: Mood check dialog with emoji scale, optional note, and tracking confirmation
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideHeartCn, TextareaCn
   Source: original/blocks/dialog/dialog-mood-check.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideHeartCn Class="mr-2 h-4 w-4" Size="16" />
                Mood Check
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_saved)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <span class="text-5xl">@(_moods.FirstOrDefault(m => m.Value == _selected)?.Emoji)</span>
                <h3 class="mt-4 text-lg font-medium">Mood Logged</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    Feeling @(_moods.FirstOrDefault(m => m.Value == _selected)?.Label.ToLowerInvariant()) today
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>How are you feeling?</DialogTitleCn>
                <DialogDescriptionCn>Track your mood to spot patterns</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                @* Mood scale *@
                <div class="flex justify-between">
                    @foreach (var mood in _moods)
                    {
                        <button type="button"
                                class="@Cn.Merge("flex flex-col items-center gap-1 p-2 rounded-md transition-colors", _selected == mood.Value ? "bg-primary/10" : "hover:bg-muted")"
                                @onclick="@(() => _selected = mood.Value)">
                            <span class="text-2xl">@mood.Emoji</span>
                            <span class="text-xs text-muted-foreground">@mood.Label</span>
                        </button>
                    }
                </div>

                @* Note *@
                <TextareaCn Class="resize-none h-20" Placeholder="Add a note (optional)"
                            Value="@_note" ValueChanged="@(v => _note = v)" />
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Skip</ButtonCn>
                <ButtonCn Disabled="@(_selected is null)" @onclick="HandleSave">Save</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record MoodOption(string Emoji, string Label, int Value);

    private static readonly MoodOption[] _moods =
    [
        new("\ud83d\ude22", "Sad", 1),
        new("\ud83d\ude15", "Down", 2),
        new("\ud83d\ude10", "Okay", 3),
        new("\ud83d\ude42", "Good", 4),
        new("\ud83d\ude04", "Great", 5),
    ];

    private bool _open;
    private int? _selected;
    private string _note = "";
    private bool _saved;

    private void HandleSave()
    {
        if (_selected is null) return;
        _saved = true;
    }

    private void HandleClose()
    {
        _open = false;
        _selected = null;
        _note = "";
        _saved = false;
    }
}
