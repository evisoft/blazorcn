@* ========================================
   Block: dialog-profile-picture
   Title: Dialog Profile Picture
   Description: Profile picture upload dialog with drag-drop zone, camera capture, gallery selection, and remove photo options
   Dependencies: AlertCn, AlertDescriptionCn, AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCameraCn, LucideCheckCn, LucideCircleAlertCn, LucideImageCn, LucideLoaderCn, LucideTrash2Cn, LucideUploadCn, LucideUserCn
   Source: original/blocks/dialog/dialog-profile-picture.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCameraCn Class="mr-2 h-4 w-4" Size="16" />
                Change Photo
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideCameraCn Class="h-5 w-5" Size="20" />
                Profile Picture
            </DialogTitleCn>
            <DialogDescriptionCn>Upload a new photo or take one with your camera.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Current/Preview Photo *@
            <div class="flex justify-center">
                <div class="relative">
                    <AvatarCn Class="h-32 w-32 border-4 border-background shadow-lg">
                        @if (!string.IsNullOrEmpty(DisplayPhoto))
                        {
                            <AvatarImageCn Alt="Profile" Src="@DisplayPhoto" />
                        }
                        <AvatarFallbackCn Class="text-4xl">
                            <LucideUserCn Class="h-16 w-16" Size="64" />
                        </AvatarFallbackCn>
                    </AvatarCn>
                    @if (!string.IsNullOrEmpty(DisplayPhoto))
                    {
                        <ButtonCn Class="absolute -bottom-1 -right-1 h-8 w-8 rounded-full"
                                  Size="ButtonSize.Icon"
                                  Variant="ButtonVariant.Destructive"
                                  @onclick="HandleRemovePhoto" aria-label="Delete">
                            <LucideTrash2Cn Class="h-4 w-4" Size="16" />
                        </ButtonCn>
                    }
                </div>
            </div>

            @* Error Alert *@
            @if (!string.IsNullOrEmpty(_error))
            {
                <AlertCn Variant="AlertVariant.Destructive">
                    <LucideCircleAlertCn Class="h-4 w-4" Size="16" />
                    <AlertDescriptionCn>@_error</AlertDescriptionCn>
                </AlertCn>
            }

            @* Drop Zone *@
            <div class="rounded-lg border-2 border-dashed p-8 text-center border-muted-foreground/25 hover:border-muted-foreground/50 transition-colors"
                 role="button"
                 tabindex="0">
                <LucideUploadCn Class="mx-auto h-8 w-8 text-muted-foreground" Size="32" />
                <p class="mt-2 text-sm font-medium">Drag and drop your photo here</p>
                <p class="mt-1 text-xs text-muted-foreground">JPEG, PNG, or WebP up to 5MB</p>
            </div>

            @* Upload Options *@
            <div class="grid grid-cols-2 gap-3">
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline" @onclick="HandleChooseFile">
                    <LucideImageCn Class="mr-2 h-4 w-4" Size="16" />
                    Choose File
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline" @onclick="HandleTakePhoto">
                    <LucideCameraCn Class="mr-2 h-4 w-4" Size="16" />
                    Take Photo
                </ButtonCn>
            </div>

            @if (_hasPreview)
            {
                <p class="text-center text-sm text-muted-foreground">
                    Preview — click Save to apply
                </p>
            }
        </div>

        <DialogFooterCn>
            <ButtonCn Disabled="@_isUploading" Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
            <ButtonCn Disabled="@(!_hasPreview || _isUploading)" @onclick="HandleSave">
                @if (_isUploading)
                {
                    <LucideLoaderCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Uploading...</span>
                }
                else
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Save Photo</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string? _currentPhoto;
    private string? _previewPhoto;
    private bool _isUploading;
    private string? _error;
    private bool _hasPreview;

    private string? DisplayPhoto => _previewPhoto ?? _currentPhoto;

    private void HandleRemovePhoto()
    {
        _previewPhoto = null;
        _currentPhoto = null;
        _hasPreview = false;
    }

    private void HandleChooseFile()
    {
        // In real app: trigger file input. For demo, simulate a preview.
        _previewPhoto = "https://api.dicebear.com/7.x/avataaars/svg?seed=demo";
        _hasPreview = true;
        _error = null;
    }

    private void HandleTakePhoto()
    {
        // In real app: access camera. For demo, simulate a preview.
        _previewPhoto = "https://api.dicebear.com/7.x/avataaars/svg?seed=camera";
        _hasPreview = true;
        _error = null;
    }

    private async Task HandleSave()
    {
        if (!_hasPreview) return;

        _isUploading = true;
        StateHasChanged();
        await Task.Delay(1500);
        _currentPhoto = _previewPhoto;
        _previewPhoto = null;
        _hasPreview = false;
        _isUploading = false;
        _open = false;
    }

    private void HandleClose()
    {
        _open = false;
        _previewPhoto = null;
        _hasPreview = false;
        _error = null;
    }
}
