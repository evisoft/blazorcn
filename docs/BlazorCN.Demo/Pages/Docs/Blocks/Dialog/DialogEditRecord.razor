@* ========================================
   Block: dialog-edit-record
   Title: Dialog Edit Record
   Description: Edit record dialog with form fields, validation, unsaved changes warning, and save/discard actions
   Dependencies: AlertDialogActionCn, AlertDialogCancelCn, AlertDialogCn, AlertDialogContentCn, AlertDialogDescriptionCn, AlertDialogFooterCn, AlertDialogHeaderCn, AlertDialogTitleCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCircleAlertCn, LucideLoader2Cn, LucidePencilCn, LucideRotateCcwCn, LucideSaveCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, TextareaCn
   Source: original/blocks/dialog/dialog-edit-record.tsx
   ======================================== *@

<DialogCn Open="_open" OpenChanged="HandleOpenChange">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucidePencilCn Class="mr-2 h-4 w-4" Size="16" />
                Edit Record
            </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucidePencilCn Class="h-5 w-5" Size="20" />
                    Edit Record
                </div>
                @if (HasChanges)
                {
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                        Unsaved changes
                    </BadgeCn>
                }
            </DialogTitleCn>
            <DialogDescriptionCn>Make changes to the record below.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="space-y-2">
                <LabelCn For="name">
                    Name <span class="text-destructive">*</span>
                </LabelCn>
                <InputCn Class="@(_errors.ContainsKey("name") ? "border-destructive" : "")"
                         id="name"
                         Placeholder="Enter name"
                         Value="@_formData.Name"
                         ValueChanged="@((string v) => HandleChange("name", v))" />
                @if (_errors.ContainsKey("name"))
                {
                    <p class="text-xs text-destructive flex items-center gap-1">
                        <LucideCircleAlertCn Class="h-3 w-3" Size="12" />
                        @_errors["name"]
                    </p>
                }
            </div>

            <div class="space-y-2">
                <LabelCn For="email">
                    Email <span class="text-destructive">*</span>
                </LabelCn>
                <InputCn Class="@(_errors.ContainsKey("email") ? "border-destructive" : "")"
                         id="email"
                         Placeholder="Enter email"
                         type="email"
                         Value="@_formData.Email"
                         ValueChanged="@((string v) => HandleChange("email", v))" />
                @if (_errors.ContainsKey("email"))
                {
                    <p class="text-xs text-destructive flex items-center gap-1">
                        <LucideCircleAlertCn Class="h-3 w-3" Size="12" />
                        @_errors["email"]
                    </p>
                }
            </div>

            <div class="space-y-2">
                <LabelCn For="dlg-edit-record-status">
                    Status <span class="text-destructive">*</span>
                </LabelCn>
                <SelectCn Value="@_formData.Status" ValueChanged="@((string v) => HandleChange("status", v))">
                    <SelectTriggerCn Class="@(_errors.ContainsKey("status") ? "border-destructive" : "")" id="dlg-edit-record-status">
                        <SelectValueCn Placeholder="Select status" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var status in _statuses)
                        {
                            <SelectItemCn Value="@status.Value">@status.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
                @if (_errors.ContainsKey("status"))
                {
                    <p class="text-xs text-destructive flex items-center gap-1">
                        <LucideCircleAlertCn Class="h-3 w-3" Size="12" />
                        @_errors["status"]
                    </p>
                }
            </div>

            <div class="space-y-2">
                <LabelCn For="description">Description</LabelCn>
                <TextareaCn id="description"
                            Placeholder="Enter description"
                            Rows="3"
                            @bind-Value="_formData.Description" />
            </div>
        </div>

        <DialogFooterCn class="flex-col sm:flex-row gap-2">
            @if (HasChanges)
            {
                <ButtonCn Class="sm:mr-auto" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleReset">
                    <LucideRotateCcwCn Class="mr-2 h-4 w-4" Size="16" />
                    Reset
                </ButtonCn>
            }
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@(_isSaving || !HasChanges)" @onclick="HandleSave">
                @if (_isSaving)
                {
                    <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Saving...</span>
                }
                else if (_saveSuccess)
                {
                    <LucideSaveCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Saved!</span>
                }
                else
                {
                    <LucideSaveCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Save Changes</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

<AlertDialogCn @bind-Open="_showDiscardAlert">
    <AlertDialogContentCn>
        <AlertDialogHeaderCn>
            <AlertDialogTitleCn>Discard changes?</AlertDialogTitleCn>
            <AlertDialogDescriptionCn>
                You have unsaved changes. Are you sure you want to discard them?
            </AlertDialogDescriptionCn>
        </AlertDialogHeaderCn>
        <AlertDialogFooterCn>
            <AlertDialogCancelCn>Keep Editing</AlertDialogCancelCn>
            <AlertDialogActionCn @onclick="HandleDiscard">Discard</AlertDialogActionCn>
        </AlertDialogFooterCn>
    </AlertDialogContentCn>
</AlertDialogCn>

@code {
    private record FormData
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Status { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private record StatusOption(string Value, string Label);

    private static readonly StatusOption[] _statuses =
    [
        new("active", "Active"),
        new("inactive", "Inactive"),
        new("pending", "Pending"),
    ];

    private static readonly FormData _initialData = new()
    {
        Name = "John Doe",
        Email = "john@example.com",
        Status = "active",
        Description = "Senior software engineer with 10 years of experience.",
    };

    private bool _open;
    private bool _showDiscardAlert;
    private FormData _formData = new()
    {
        Name = _initialData.Name,
        Email = _initialData.Email,
        Status = _initialData.Status,
        Description = _initialData.Description,
    };
    private Dictionary<string, string> _errors = new();
    private bool _isSaving;
    private bool _saveSuccess;

    private bool HasChanges =>
        _formData.Name != _initialData.Name ||
        _formData.Email != _initialData.Email ||
        _formData.Status != _initialData.Status ||
        _formData.Description != _initialData.Description;

    private bool ValidateForm()
    {
        var newErrors = new Dictionary<string, string>();

        if (string.IsNullOrWhiteSpace(_formData.Name))
            newErrors["name"] = "Name is required";

        if (string.IsNullOrWhiteSpace(_formData.Email))
            newErrors["email"] = "Email is required";
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_formData.Email, @"^[^\s@]+@[^\s@]+\.[^\s@]+$"))
            newErrors["email"] = "Invalid email format";

        if (string.IsNullOrEmpty(_formData.Status))
            newErrors["status"] = "Status is required";

        _errors = newErrors;
        return newErrors.Count == 0;
    }

    private void HandleChange(string field, string value)
    {
        switch (field)
        {
            case "name": _formData.Name = value; break;
            case "email": _formData.Email = value; break;
            case "status": _formData.Status = value; break;
            case "description": _formData.Description = value; break;
        }
        _errors.Remove(field);
    }

    private async Task HandleSave()
    {
        if (!ValidateForm()) return;

        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isSaving = false;
        _saveSuccess = true;
        StateHasChanged();
        await Task.Delay(1000);
        _saveSuccess = false;
        _open = false;
    }

    private void HandleReset()
    {
        _formData = new FormData
        {
            Name = _initialData.Name,
            Email = _initialData.Email,
            Status = _initialData.Status,
            Description = _initialData.Description,
        };
        _errors.Clear();
    }

    private void HandleClose()
    {
        if (HasChanges)
            _showDiscardAlert = true;
        else
            _open = false;
    }

    private void HandleDiscard()
    {
        _showDiscardAlert = false;
        HandleReset();
        _open = false;
    }

    private void HandleOpenChange(bool newOpen)
    {
        if (!newOpen && HasChanges)
            _showDiscardAlert = true;
        else
            _open = newOpen;
    }
}
