@* ========================================
   Block: dialog-quick-note
   Title: Dialog Quick Note
   Description: Quick note dialog with title input, text area, color labels, reminder date picker, and pin option
   Dependencies: BadgeCn, ButtonCn, CalendarCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideBellCn, LucideCheckCn, LucidePinCn, LucideStickyNoteCn, LucideXCn, PopoverCn, PopoverContentCn, PopoverTriggerCn, TextareaCn
   Source: original/blocks/dialog/dialog-quick-note.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideStickyNoteCn Class="mr-2 h-4 w-4" Size="16" />
                Quick Note
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_saved)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Note Saved</DialogTitleCn>
                <DialogDescriptionCn>
                    @(!string.IsNullOrEmpty(_title) ? $"\"{_title}\"" : "Your note") has been saved@(_isPinned ? " and pinned" : "")@(_reminderDate.HasValue ? $" with a reminder for {FormatDate(_reminderDate.Value)}" : "").
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideStickyNoteCn Class="h-5 w-5" Size="20" />
                    Quick Note
                </DialogTitleCn>
                <DialogDescriptionCn>Capture your thought quickly.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn For="note-title">Title (optional)</LabelCn>
                    <InputCn Id="note-title" Placeholder="Note title..." Value="@_title" ValueChanged="@(v => _title = v)" />
                </div>

                <div class="space-y-2">
                    <LabelCn For="note-content">Note</LabelCn>
                    <TextareaCn Class="min-h-[120px] resize-none" Id="note-content" Placeholder="Write your note here..."
                                Value="@_content" ValueChanged="@(v => _content = v)" />
                </div>

                <div class="space-y-2">
                    <LabelCn>Color Label</LabelCn>
                    <div class="flex gap-2">
                        @foreach (var color in _colorLabels)
                        {
                            <button type="button"
                                    class="@Cn.Merge("h-6 w-6 rounded-full transition-all", color.CssClass, _selectedColor == color.Id ? $"ring-2 ring-offset-2 {color.ActiveClass}" : "")"
                                    title="@color.Name"
                                    @onclick="@(() => _selectedColor = color.Id)">
                            </button>
                        }
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <PopoverCn @bind-Open="_showCalendar">
                        <PopoverTriggerCn
                            Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0", _reminderDate.HasValue ? "cn-button-variant-secondary" : "cn-button-variant-outline", "cn-button-size-sm", "gap-2")"
                            data-variant="@(_reminderDate.HasValue ? "secondary" : "outline")" data-size="sm">
                            <LucideBellCn Class="h-4 w-4" Size="16" />
                            @(_reminderDate.HasValue ? FormatDate(_reminderDate.Value) : "Add Reminder")
                            @if (_reminderDate.HasValue)
                            {
                                <span class="ml-1 rounded-full hover:bg-muted-foreground/20 p-0.5"
                                      @onclick="@(() => _reminderDate = null)"
                                      @onclick:stopPropagation="true">
                                    <LucideXCn Class="h-3 w-3" Size="12" />
                                </span>
                            }
                        </PopoverTriggerCn>
                        <PopoverContentCn Align="FloatingAlign.Start" Class="w-auto p-0">
                            <CalendarCn Mode="CalendarSelectionMode.Single"
                                        Value="@_reminderDate"
                                        ValueChanged="@((DateTime? d) => { _reminderDate = d; _showCalendar = false; })" />
                        </PopoverContentCn>
                    </PopoverCn>

                    <ButtonCn Class="gap-2" Size="ButtonSize.Sm"
                              Variant="@(_isPinned ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                              @onclick="@(() => _isPinned = !_isPinned)">
                        <LucidePinCn Class="@Cn.Merge("h-4 w-4", _isPinned ? "fill-current" : "")" Size="16" />
                        @(_isPinned ? "Pinned" : "Pin Note")
                    </ButtonCn>
                </div>

                @if (_selectedColor != "none" || _isPinned || _reminderDate.HasValue)
                {
                    <div class="flex flex-wrap gap-2 pt-2 border-t">
                        @if (_selectedColor != "none")
                        {
                            var colorData = _colorLabels.FirstOrDefault(c => c.Id == _selectedColor);
                            if (colorData is not null)
                            {
                                <BadgeCn Class="gap-1.5" Variant="BadgeVariant.Secondary">
                                    <span class="@Cn.Merge("h-2 w-2 rounded-full", colorData.CssClass)"></span>
                                    @colorData.Name
                                </BadgeCn>
                            }
                        }
                        @if (_isPinned)
                        {
                            <BadgeCn Class="gap-1" Variant="BadgeVariant.Secondary">
                                <LucidePinCn Class="h-3 w-3" Size="12" />
                                Pinned
                            </BadgeCn>
                        }
                        @if (_reminderDate.HasValue)
                        {
                            <BadgeCn Class="gap-1" Variant="BadgeVariant.Secondary">
                                <LucideBellCn Class="h-3 w-3" Size="12" />
                                @FormatDate(_reminderDate.Value)
                            </BadgeCn>
                        }
                    </div>
                }
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(string.IsNullOrWhiteSpace(_content))" @onclick="@(() => _saved = true)">Save Note</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record ColorLabel(string Id, string Name, string CssClass, string ActiveClass);

    private static readonly ColorLabel[] _colorLabels =
    [
        new("none", "None", "bg-muted", "ring-muted-foreground"),
        new("red", "Red", "bg-red-500", "ring-red-500"),
        new("orange", "Orange", "bg-orange-500", "ring-orange-500"),
        new("yellow", "Yellow", "bg-yellow-500", "ring-yellow-500"),
        new("green", "Green", "bg-green-500", "ring-green-500"),
        new("blue", "Blue", "bg-blue-500", "ring-blue-500"),
        new("purple", "Purple", "bg-purple-500", "ring-purple-500")
    ];

    private bool _open;
    private bool _saved;
    private string _title = "";
    private string _content = "";
    private string _selectedColor = "none";
    private bool _isPinned;
    private DateTime? _reminderDate;
    private bool _showCalendar;

    private static string FormatDate(DateTime date)
    {
        var format = date.Year != DateTime.Now.Year ? "MMM d, yyyy" : "MMM d";
        return date.ToString(format);
    }

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _title = "";
        _content = "";
        _selectedColor = "none";
        _isPinned = false;
        _reminderDate = null;
        _showCalendar = false;
    }
}
