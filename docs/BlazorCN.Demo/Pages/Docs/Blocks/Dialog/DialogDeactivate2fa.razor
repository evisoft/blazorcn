@* ========================================
   Block: dialog-deactivate-2fa
   Title: Dialog Deactivate 2FA
   Description: Two-factor authentication deactivation dialog with email display, password confirmation, and visibility toggle
   Dependencies: ButtonCn, DialogCn, DialogCloseCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideEyeCn, LucideEyeOffCn
   Source: original/blocks/dialog/dialog-deactivate-2fa.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-destructive cn-button-size-default" data-variant="destructive" data-size="default">Deactivate 2FA</DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn>Deactivate two-step authentication</DialogTitleCn>
            <DialogDescriptionCn>
                Enter your password to deactivate the two-step authentication login. Make sure to have
                your smartphone ready.
            </DialogDescriptionCn>
        </DialogHeaderCn>
        <form class="space-y-4">
            <div>
                <LabelCn Class="text-sm font-medium" For="email">Email</LabelCn>
                <InputCn Class="mt-2" Disabled="true" Id="email" Placeholder="user@example.com" Type="email" />
            </div>
            <div>
                <LabelCn Class="text-sm font-medium" For="password">Confirm password</LabelCn>
                <div class="relative mt-2">
                    <InputCn Class="pe-9" Id="password" Placeholder="Password" Type="@(_isVisible ? "text" : "password")" />
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Type="button"
                              Class="absolute inset-y-0 end-0 h-full w-9 rounded-e-md"
                              aria-label="@(_isVisible ? "Hide password" : "Show password")"
                              @onclick="@(() => _isVisible = !_isVisible)">
                        @if (_isVisible)
                        {
                            <LucideEyeOffCn Size="16" />
                        }
                        else
                        {
                            <LucideEyeCn Size="16" />
                        }
                    </ButtonCn>
                </div>
            </div>

            <DialogFooterCn>
                <div class="flex justify-end space-x-2">
                    <DialogCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-default" data-variant="ghost" data-size="default">Cancel</DialogCloseCn>
                    <ButtonCn Variant="ButtonVariant.Destructive">Deactivate</ButtonCn>
                </div>
            </DialogFooterCn>
        </form>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isVisible;
}
