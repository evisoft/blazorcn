@* ========================================
   Block: dialog-add-to-cart
   Title: Dialog Add To Cart
   Description: Add to cart dialog with product image, variant selection, quantity picker, and price display
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, RadioGroupCn, RadioGroupItemCn, SeparatorCn, LucideCircleAlertCn, LucideHeartCn, LucideLoader2Cn, LucideMinusCn, LucidePlusCn, LucideShoppingCartCn
   Source: original/blocks/dialog/dialog-add-to-cart.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn>
                <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                Add to Cart
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn>Add to Cart</DialogTitleCn>
            <DialogDescriptionCn>Select your options and quantity.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-6 py-4">
            @* Product Info *@
            <div class="flex gap-4">
                <div class="h-24 w-24 rounded-lg border overflow-hidden flex-shrink-0">
                    <img alt="@_product.Name" class="h-full w-full object-cover" src="@_product.Image" />
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="font-semibold truncate">@_product.Name</h3>
                    <p class="text-sm text-muted-foreground line-clamp-2">@_product.Description</p>
                    <div class="flex items-center gap-2 mt-2">
                        <span class="font-bold">$@UnitPrice.ToString("F2")</span>
                        @if (_product.OriginalPrice.HasValue)
                        {
                            <span class="text-sm text-muted-foreground line-through">
                                $@_product.OriginalPrice.Value.ToString("F2")
                            </span>
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Destructive">Sale</BadgeCn>
                        }
                    </div>
                </div>
            </div>

            <SeparatorCn />

            @* Size Selection *@
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <LabelCn>Size</LabelCn>
                    @if (string.IsNullOrEmpty(_selectedSize))
                    {
                        <span class="text-xs text-destructive">Required</span>
                    }
                </div>
                <RadioGroupCn Class="flex flex-wrap gap-2" Value="@_selectedSize" ValueChanged="@(v => _selectedSize = v)">
                    @foreach (var size in _product.Sizes)
                    {
                        <div>
                            <RadioGroupItemCn Class="peer sr-only" Disabled="@(!size.Available)" Id="@($"size-{size.Id}")" Value="@size.Id" />
                            <LabelCn Class="@Cn.Merge("flex h-10 w-12 cursor-pointer items-center justify-center rounded-md border text-sm font-medium transition-colors", "peer-data-[state=checked]:border-primary peer-data-[state=checked]:bg-primary peer-data-[state=checked]:text-primary-foreground", !size.Available ? "cursor-not-allowed opacity-50 line-through" : "")"
                                     For="@($"size-{size.Id}")">
                                @size.Name
                            </LabelCn>
                        </div>
                    }
                </RadioGroupCn>
            </div>

            @* Color Selection *@
            <div class="space-y-3">
                <LabelCn>Color: @SelectedColorVariant?.Name</LabelCn>
                <RadioGroupCn Class="flex flex-wrap gap-2" Value="@_selectedColor" ValueChanged="@(v => _selectedColor = v)">
                    @foreach (var color in _product.Colors)
                    {
                        <div>
                            <RadioGroupItemCn Class="peer sr-only" Disabled="@(!color.Available)" Id="@($"color-{color.Id}")" Value="@color.Id" />
                            <LabelCn Class="@Cn.Merge("flex h-10 px-4 cursor-pointer items-center justify-center rounded-md border text-sm font-medium transition-colors", "peer-data-[state=checked]:border-primary peer-data-[state=checked]:bg-primary peer-data-[state=checked]:text-primary-foreground", !color.Available ? "cursor-not-allowed opacity-50 line-through" : "")"
                                     For="@($"color-{color.Id}")">
                                @color.Name
                                @if (color.PriceAdjustment > 0 && color.Available)
                                {
                                    <span class="ml-1 text-xs">+$@color.PriceAdjustment</span>
                                }
                            </LabelCn>
                        </div>
                    }
                </RadioGroupCn>
            </div>

            @* Quantity *@
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <LabelCn>Quantity</LabelCn>
                    <div class="flex items-center gap-2">
                        @if (IsLowStock)
                        {
                            <BadgeCn Class="text-xs gap-1" Variant="BadgeVariant.Destructive">
                                <LucideCircleAlertCn Class="h-3 w-3" Size="12" />
                                Only @_product.Stock left
                            </BadgeCn>
                        }
                        else
                        {
                            <span class="text-xs text-muted-foreground">@_product.Stock in stock</span>
                        }
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <ButtonCn Class="h-10 w-10" Disabled="@(_quantity <= 1)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline"
                              @onclick="@(() => _quantity = Math.Max(1, _quantity - 1))">
                        <LucideMinusCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                    <span class="w-12 text-center text-lg font-semibold">@_quantity</span>
                    <ButtonCn Class="h-10 w-10" Disabled="@(_quantity >= _product.Stock)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline"
                              @onclick="@(() => _quantity = Math.Min(_product.Stock, _quantity + 1))">
                        <LucidePlusCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </div>
            </div>

            <SeparatorCn />

            @* Total *@
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-muted-foreground">Total</p>
                    <p class="text-2xl font-bold">$@TotalPrice.ToString("F2")</p>
                </div>
                <ButtonCn Class="@Cn.Merge(_isWishlisted ? "text-destructive" : "")"
                          @onclick="@(() => _isWishlisted = !_isWishlisted)"
                          Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideHeartCn Class="@Cn.Merge("h-5 w-5", _isWishlisted ? "fill-current" : "")" Size="20" />
                </ButtonCn>
            </div>
        </div>

        <DialogFooterCn Class="flex-col sm:flex-row gap-2">
            <ButtonCn Class="sm:flex-1" Disabled="@_isAdding" @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Continue Shopping
            </ButtonCn>
            <ButtonCn Class="sm:flex-1" Disabled="@(!CanAdd || _isAdding)" @onclick="HandleAddToCart">
                @if (_isAdding)
                {
                    <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Adding...</span>
                }
                else
                {
                    <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Add to Cart</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _selectedSize = "";
    private string _selectedColor = "black";
    private int _quantity = 1;
    private bool _isAdding;
    private bool _isWishlisted;

    private record Variant(string Id, string Name, bool Available, decimal PriceAdjustment = 0);

    private record Product(string Name, string Description, decimal Price, decimal? OriginalPrice, string Image, Variant[] Sizes, Variant[] Colors, int Stock);

    private static readonly Product _product = new(
        "Premium Cotton T-Shirt",
        "Soft, breathable cotton with a modern fit. Perfect for everyday wear.",
        39.99m, 49.99m,
        "https://picsum.photos/seed/product1/400/400",
        [
            new("xs", "XS", true),
            new("s", "S", true),
            new("m", "M", true),
            new("l", "L", true),
            new("xl", "XL", false),
        ],
        [
            new("black", "Black", true),
            new("white", "White", true),
            new("navy", "Navy", true, 5),
            new("gray", "Gray", false),
        ],
        12
    );

    private Variant? SelectedColorVariant => _product.Colors.FirstOrDefault(c => c.Id == _selectedColor);
    private decimal UnitPrice => _product.Price + (SelectedColorVariant?.PriceAdjustment ?? 0);
    private decimal TotalPrice => UnitPrice * _quantity;
    private bool IsLowStock => _product.Stock <= 5;
    private bool CanAdd => !string.IsNullOrEmpty(_selectedSize) && !string.IsNullOrEmpty(_selectedColor) && _quantity <= _product.Stock;

    private async Task HandleAddToCart()
    {
        if (!CanAdd) return;
        _isAdding = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isAdding = false;
        _open = false;
        _selectedSize = "";
        _quantity = 1;
    }
}
