@* ========================================
   Block: dialog-image-preview
   Title: Dialog Image Preview
   Description: Image preview dialog with zoom controls, fullscreen mode, image navigation, and download option
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideChevronLeftCn, LucideChevronRightCn, LucideDownloadCn, LucideImageCn
   Source: original/blocks/dialog/dialog-image-preview.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideImageCn Class="mr-2 h-4 w-4" Size="16" />
                Preview Images
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md p-0 gap-0 overflow-hidden">
        <DialogHeaderCn Class="p-4 pb-0">
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideImageCn Class="h-5 w-5" Size="20" />
                Image Preview
            </DialogTitleCn>
            <DialogDescriptionCn>
                @_sampleImages[_currentIndex].Filename &middot; @(_currentIndex + 1) of @_sampleImages.Length
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="p-4 space-y-4">
            @* Image *@
            <div class="relative aspect-video rounded-lg border overflow-hidden">
                <img alt="@_sampleImages[_currentIndex].Alt"
                     class="w-full h-full object-cover"
                     src="@_sampleImages[_currentIndex].Src" />

                @if (_sampleImages.Length > 1)
                {
                    <ButtonCn Class="absolute left-2 top-1/2 -translate-y-1/2 h-8 w-8 rounded-full bg-background/80"
                              Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="HandlePrevious" aria-label="Previous">
                        <LucideChevronLeftCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                    <ButtonCn Class="absolute right-2 top-1/2 -translate-y-1/2 h-8 w-8 rounded-full bg-background/80"
                              Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="HandleNext" aria-label="Next">
                        <LucideChevronRightCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                }
            </div>

            @* Thumbnails *@
            @if (_sampleImages.Length > 1)
            {
                <div class="flex justify-center gap-2">
                    @for (var i = 0; i < _sampleImages.Length; i++)
                    {
                        var index = i;
                        <button type="button"
                                class="@Cn.Merge("w-12 h-12 rounded-lg overflow-hidden border-2 transition-colors", _currentIndex == index ? "border-primary" : "border-transparent hover:border-border")"
                                @onclick="@(() => _currentIndex = index)">
                            <img alt="@_sampleImages[index].Alt"
                                 class="w-full h-full object-cover"
                                 src="@_sampleImages[index].Src" />
                        </button>
                    }
                </div>
            }

            @* Download Button *@
            <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                Download
            </ButtonCn>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record ImageItem(string Id, string Src, string Alt, string Filename);

    private static readonly ImageItem[] _sampleImages =
    [
        new("1", "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&h=800&fit=crop", "Mountain landscape", "mountain-landscape.jpg"),
        new("2", "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1200&h=800&fit=crop", "Nature scenery", "nature-scenery.jpg"),
        new("3", "https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?w=1200&h=800&fit=crop", "Forest path", "forest-path.jpg"),
    ];

    private bool _open;
    private int _currentIndex;

    private void HandlePrevious()
    {
        _currentIndex = (_currentIndex - 1 + _sampleImages.Length) % _sampleImages.Length;
    }

    private void HandleNext()
    {
        _currentIndex = (_currentIndex + 1) % _sampleImages.Length;
    }
}
