@* ========================================
   Block: dialog-project-initializer
   Title: Dialog Project Initializer
   Description: Project initialization dialog with framework selection, package manager, linter configuration, and testing tool options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideFolderPlusCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/dialog/dialog-project-initializer.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideFolderPlusCn Class="mr-2 h-4 w-4" Size="16" />
                New Project
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>New Project</DialogTitleCn>
            <DialogDescriptionCn>Configure your project settings.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-3 py-4">
            @foreach (var option in _projectOptions)
            {
                <div class="flex items-center justify-between">
                    <span class="text-sm">@option.Label</span>
                    <SelectCn Value="@option.DefaultValue">
                        <SelectTriggerCn Class="w-32" aria-label="@option.Label">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var item in option.Items)
                            {
                                <SelectItemCn Value="@item.Value">@item.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            }
        </div>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn>Create</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;

    private record SelectOption(string Value, string Label);
    private record ProjectOption(string Id, string Label, string DefaultValue, SelectOption[] Items);

    private static readonly ProjectOption[] _projectOptions =
    [
        new("framework", "Framework", "nextjs", [
            new("nextjs", "Next.js"), new("vite", "Vite"), new("remix", "Remix"), new("astro", "Astro")
        ]),
        new("manager", "Package Manager", "pnpm", [
            new("pnpm", "pnpm"), new("npm", "npm"), new("yarn", "yarn"), new("bun", "bun")
        ]),
        new("linter", "Linter", "biome", [
            new("biome", "Biome"), new("eslint", "ESLint"), new("none", "None")
        ]),
        new("testing", "Testing", "vitest", [
            new("vitest", "Vitest"), new("jest", "Jest"), new("none", "None")
        ])
    ];
}
